                "senses": [
                    {
                        "sense_id": "8f4ef3da-b172-3849-a166-0fdc6090ecbb",
                        "entry_id": "0d4ec1e4-c26d-33db-9d94-355d03ddeaec",
                        "glosses": [
                            "kleiner Wald, in dem vorwiegend junge Birken wachsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "283f688e-968b-4ba8-8297-b031e015ea4d",
                                "sense_id": "8f4ef3da-b172-3849-a166-0fdc6090ecbb",
                                "text": "„Diese Tannen zeigten einige lichte oder nur mit Tannengestrüpp und spärlichem Birkenbusch bewachsene, für Reiter zugängliche Plätze.“"
                            },
                            {
                                "example_id": "2c208368-217c-4e33-8cd8-02891d7600da",
                                "sense_id": "8f4ef3da-b172-3849-a166-0fdc6090ecbb",
                                "text": "„Wir besichtigten zusammen einen sonnigen kleinen Birkenbusch, ein entzückendes Fleckchen Erde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
