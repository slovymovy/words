                            },
                            {
                                "target_lang_word": "сквернословие",
                                "target_lang_sense_clarification": "употребление бранных слов"
                            },
                            {
                                "target_lang_word": "мат",
                                "target_lang_sense_clarification": "нецензурные выражения"
                            },
                            {
                                "target_lang_word": "присяга",
                                "target_lang_sense_clarification": "принесение торжественной клятвы"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "das Fluchen",
