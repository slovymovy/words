                    }
                ],
                "senses": [
                    {
                        "sense_id": "270f531f-e923-32e7-814a-8b374a5c39d8",
                        "entry_id": "6b46ce1e-a483-3e66-82c1-c13252ad6a00",
                        "glosses": [
                            "een korte uitbarsting van licht of een ander elektromagnetisch verschijnsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2c69619-1aa9-4103-b209-7b8dd090df6a",
                                "sense_id": "270f531f-e923-32e7-814a-8b374a5c39d8",
                                "text": "Een flits aan de horizon was de eerste aankondiging van het komende onweer."
                            },
                            {
                                "example_id": "0393fea5-d7a3-4423-bd01-52a22f877c49",
                                "sense_id": "270f531f-e923-32e7-814a-8b374a5c39d8",
                                "text": "Hier en daar een korte flits als de zon op de romp van een vliegtuig weerkaatst."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7c0ba6b-d832-3d7d-9384-90cd455f1280",
                        "entry_id": "6b46ce1e-a483-3e66-82c1-c13252ad6a00",
                        "glosses": [
                            "een kortdurend maar heftig evenement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfa262b8-8136-4962-a6f9-8f41f9e0940f",
                                "sense_id": "c7c0ba6b-d832-3d7d-9384-90cd455f1280",
                                "text": "In een flits van woede duwde ik Quicks woorden weg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98983981-f8c4-4028-ad20-0733e977cbcb",
                        "source_entry_id": "6b46ce1e-a483-3e66-82c1-c13252ad6a00",
                        "target_lang_word": "lightning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lightning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21fbb044-a1da-360e-9d03-de9784709834",
                                        "entry_id": "831232ce-772e-321e-9e61-1bc35a419d2f",
                                        "glosses": [
                                            "To produce lightning."
                                        ],
                                        "tags": [
                                            "childish",
                                            "impersonal",
                                            "intransitive",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b70f49e4-b056-42b6-ae66-aa58ed0cbc3b",
                                                "sense_id": "21fbb044-a1da-360e-9d03-de9784709834",
                                                "text": "Or if it thundered and lightninged, Aunt Frances always dropped everything she might be doing and held Elizabeth Ann tightly in her arms until it was all over."
                                            },
                                            {
                                                "example_id": "0ac99274-3c17-4a38-a578-ffd6ef985236",
                                                "sense_id": "21fbb044-a1da-360e-9d03-de9784709834",
                                                "text": "The next day, though it is not only raining but thundering and lightninging as well, antiquing is seen by three-fourths of those present as a lesser evil than free play."
                                            },
                                            {
                                                "example_id": "db2a994e-45ce-4300-ad40-fd0f27f195a3",
                                                "sense_id": "21fbb044-a1da-360e-9d03-de9784709834",
                                                "text": "\"Hey!\" yelled Reggie, pulling her back. \"Get in here! It's lightninging. I don't want a charcoal-broiled friend!\""
                                            },
                                            {
                                                "example_id": "bdf16fbe-2cc9-4155-a32d-430f6ed56de3",
                                                "sense_id": "21fbb044-a1da-360e-9d03-de9784709834",
                                                "text": "I don't know, Father, but believe me, it has been a horrible night — one that I'll never forget. It thundered and lightninged, and I was very hungry."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lightning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec7b4738-8a42-37f3-b642-e347fcdc41e6",
                                        "entry_id": "ed12ba95-4f60-39b1-8157-87b72856a6be",
                                        "glosses": [
                                            "A flash of light produced by short-duration, high-voltage discharge of electricity within a cloud, between clouds, or between a cloud and the earth."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee16f559-8b48-4508-9430-a497ee2bbc11",
                                                "sense_id": "ec7b4738-8a42-37f3-b642-e347fcdc41e6",
                                                "text": "Although we did not see the lightning, we did hear the thunder."
                                            },
                                            {
                                                "example_id": "35a9d552-df37-4c91-b759-93edacc3ce8b",
                                                "sense_id": "ec7b4738-8a42-37f3-b642-e347fcdc41e6",
                                                "text": "Canst thou send lightnings, that they may go, and say unto thee, Here we are?"
                                            },
                                            {
                                                "example_id": "14aba153-adb0-4864-965d-190da22a5643",
                                                "sense_id": "ec7b4738-8a42-37f3-b642-e347fcdc41e6",
                                                "text": "It was the thought of hot July and August days, when the clouds piled up like woolly mountains, and lightnings streaked the sky."
                                            },
                                            {
                                                "example_id": "3ac834fe-dd9a-4705-858d-2762672116b8",
                                                "sense_id": "ec7b4738-8a42-37f3-b642-e347fcdc41e6",
                                                "text": "Manny drove a few miles per hour under the speed limit, entranced by the awesome display of lightning streaking out of the clouds toward earth."
                                            },
                                            {
                                                "example_id": "f8b606a8-6245-4236-b331-da0e0ac5030b",
                                                "sense_id": "ec7b4738-8a42-37f3-b642-e347fcdc41e6",
                                                "text": "\"Ruu\": The adults in the village all said that children like me could calm the lightning and turn the storms into timely rain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "920bd610-4595-3f9f-9fb7-6496cffba27a",
                                        "entry_id": "ed12ba95-4f60-39b1-8157-87b72856a6be",
                                        "glosses": [
                                            "A discharge of this kind."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef58cf55-d37d-4065-aa70-92552d86a370",
                                                "sense_id": "920bd610-4595-3f9f-9fb7-6496cffba27a",
                                                "text": "The lightning was hot enough to melt the sand."
                                            },
                                            {
                                                "example_id": "a94710c8-c5ad-459a-b35a-cb8f48181763",
                                                "sense_id": "920bd610-4595-3f9f-9fb7-6496cffba27a",
                                                "text": "That tree was hit by lightning."
                                            },
                                            {
                                                "example_id": "f653e998-cc37-435d-8828-cae6259dea82",
                                                "sense_id": "920bd610-4595-3f9f-9fb7-6496cffba27a",
                                                "text": "Auster and Aquilon with winged Steeds\nAll ſweating, tilt about the watery heauens,\nWith ſhiuering ſpeares enforcing thunderclaps,\nAnd from their ſhields ſtrike flames of lightening"
                                            },
                                            {
                                                "example_id": "230689cc-36b1-4046-82ab-dcd736d0fa6b",
                                                "sense_id": "920bd610-4595-3f9f-9fb7-6496cffba27a",
                                                "text": "The rain at length ceased; and the lightnings, as they played along the black parapet of clouds, that lay piled in the east, shone with less dazzling fierceness, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe78ee6d-9d97-337b-88e7-28036893fb71",
                                        "entry_id": "ed12ba95-4f60-39b1-8157-87b72856a6be",
                                        "glosses": [
                                            "Anything that moves very fast."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1506626c-37a9-44f4-9a15-f36e213393dc",
                                                "sense_id": "fe78ee6d-9d97-337b-88e7-28036893fb71",
                                                "text": "Nobs, though, was lightning by comparison with the slow thinking beast and dodged his opponent's thrust with ease. Then he raced to the rear of the tremendous thing and seized it by the tail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "136d2b99-8471-36ab-bea0-857cbb64ec37",
                                        "entry_id": "ed12ba95-4f60-39b1-8157-87b72856a6be",
                                        "glosses": [
                                            "Gin."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f0a6e2d-6d36-4ea5-8c21-832ae60d93de",
                                                "sense_id": "136d2b99-8471-36ab-bea0-857cbb64ec37",
                                                "text": "I took some gin but it did little to calm my mood. […] 'Come now, Bess,' she entreated, and poured another glass of lightning. 'Tell your old mother everything.' I took a gulp of the spirit, then babbled all, showing her the loot now in my possession."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e4948e5-0ae3-3a0b-aeb1-1462aa882236",
                                        "entry_id": "ed12ba95-4f60-39b1-8157-87b72856a6be",
                                        "glosses": [
                                            "Obsolete form of lightening."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lightning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a59c59df-8236-33fc-a6d4-b55494693514",
                                        "entry_id": "5d5fef73-aa64-32c5-93b4-3b69939598a0",
                                        "glosses": [
                                            "Extremely fast or sudden; moving (as if) at the speed of lightning."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d811614e-16be-460f-8db9-f0034420ecfc",
                                                "sense_id": "a59c59df-8236-33fc-a6d4-b55494693514",
                                                "text": "The insurgents then began their lightning advance along the Euphrates in the Sunni heartland toward Baghdad."
                                            }
                                        ]
                                    }
                                ]
                            }
