        "fr-extract.jsonl": [
            {
                "entry_id": "dfa59ba1-47f4-3aa6-956e-7e89db451059",
                "word": "preste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "782fce2c-1a23-478a-9cb2-88aa575d5265",
                        "entry_id": "dfa59ba1-47f4-3aa6-956e-7e89db451059",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "prestes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "47bed6c6-d46c-3aef-913d-c86456743f53",
                        "entry_id": "dfa59ba1-47f4-3aa6-956e-7e89db451059",
                        "glosses": [
                            "Qui est prompt, leste, agile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e932785-1491-4a3e-97c6-a84f16cc5441",
                                "sense_id": "47bed6c6-d46c-3aef-913d-c86456743f53",
                                "text": "C’est un homme preste et habile."
                            },
                            {
                                "example_id": "c398e7cc-6225-44c2-9795-3aa642443b9b",
                                "sense_id": "47bed6c6-d46c-3aef-913d-c86456743f53",
                                "text": "Il a la main preste."
                            },
                            {
                                "example_id": "1dea86aa-454a-4c8f-824a-f6b48a5ef75e",
                                "sense_id": "47bed6c6-d46c-3aef-913d-c86456743f53",
                                "text": "En bambou qu’il était l’embarcadère, je m’en souviens bien. Il avait son histoire, on le refaisait chaque mois, je l’appris, à cause des mollusques agiles et prestes qui venaient par milliers le bouffer au fur et è mesure."
                            },
                            {
                                "example_id": "b7dc2c8c-a191-4c19-b00b-2af0c6c17204",
                                "sense_id": "47bed6c6-d46c-3aef-913d-c86456743f53",
                                "text": "Parfois, au-delà du halo de la lanterne, dans la demi-obscurité, Angelo voyait fuir des formes pâles, prestes comme les bêtes qui sautent dans les fourrés des bois."
                            },
                            {
                                "example_id": "c7fad07c-326c-40fc-aea9-fc651b3a8537",
                                "sense_id": "47bed6c6-d46c-3aef-913d-c86456743f53",
                                "text": "Le facteur, d’ordinaire si preste,\nPour voir ça, ne distribuait plus\nLes lettres que personne, au reste,\nN’aurait lues…"
                            }
                        ]
                    },
                    {
                        "sense_id": "2bbddda7-f4f1-347c-83b1-13141ebfea75",
                        "entry_id": "dfa59ba1-47f4-3aa6-956e-7e89db451059",
                        "glosses": [
                            "Qui est rapide en parlant des choses qui dépendent de l’esprit."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "58dd63bc-80b7-43d5-a731-bb1beefe415f",
                                "sense_id": "2bbddda7-f4f1-347c-83b1-13141ebfea75",
                                "text": "Une réponse preste."
                            },
                            {
                                "example_id": "8251b637-7295-40e4-90c4-7af79e840554",
                                "sense_id": "2bbddda7-f4f1-347c-83b1-13141ebfea75",
                                "text": "Il est preste à la réplique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "626ce921-6218-4dfa-81d9-8a63eb1aac4e",
                        "source_entry_id": "dfa59ba1-47f4-3aa6-956e-7e89db451059",
