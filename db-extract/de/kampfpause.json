                ],
                "senses": [
                    {
                        "sense_id": "97a61cf4-2030-3e49-928e-0e61ccaa4ce5",
                        "entry_id": "15e3b57a-b941-3aaa-bb07-e36cc74a11fa",
                        "glosses": [
                            "vorübergehende Einstellung von Kampfhandlungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bde2b8e-db4f-4012-afbb-8cb5fbeffbbc",
                                "sense_id": "97a61cf4-2030-3e49-928e-0e61ccaa4ce5",
                                "text": "[Afghanistan:] „Die tödliche Gewalt in dem Lande am Hindukusch geht weiter - obwohl die Taliban eine dreitägige Kampfpause angekündigt haben.“"
                            },
                            {
                                "example_id": "89e7a9b8-f49a-4227-bbfb-302375329adf",
                                "sense_id": "97a61cf4-2030-3e49-928e-0e61ccaa4ce5",
                                "text": "Während der Kampfpause trugen Sanitäter die Verwundeten vom Schlachtfeld."
                            },
                            {
                                "example_id": "939bafc1-e74e-4fec-a219-22fe9030a7ba",
                                "sense_id": "97a61cf4-2030-3e49-928e-0e61ccaa4ce5",
                                "text": "„Die für Weihnachten vereinbarte Kampfpause zwischen Regierungstruppen und prorussischen Separatisten in der Ostukraine wurde wahrscheinlich gebrochen.“"
                            },
                            {
                                "example_id": "ee7ae55f-5c76-4437-bcbe-67585ec7b694",
                                "sense_id": "97a61cf4-2030-3e49-928e-0e61ccaa4ce5",
                                "text": "„Allerdings gibt es viele Kriege und Konflikte, bei denen die Forderungen nach zivilen Korridoren und Kampfpausen vergeblich sind.“"
                            },
                            {
                                "example_id": "909eba4d-2a77-4190-9398-803035b4c689",
                                "sense_id": "97a61cf4-2030-3e49-928e-0e61ccaa4ce5",
                                "text": "[Kosovokrieg: …] „die UÇK besetzte während der Kampfpause viele Stellungen, die von den im Zuge der Vereinbarung verlegten serbischen Truppen geräumt worden waren.“"
                            },
                            {
                                "example_id": "d2d24d15-e8d5-43a2-88c8-5878763323e1",
                                "sense_id": "97a61cf4-2030-3e49-928e-0e61ccaa4ce5",
                                "text": "[100-jähriger Krieg:] „Nach einer kurzen Kampfpause setzten sich die Niederlagen der Engländer in Frankreich fort.“"
                            },
                            {
                                "example_id": "5bb6daab-2f82-4d42-8812-a12c13826a58",
                                "sense_id": "97a61cf4-2030-3e49-928e-0e61ccaa4ce5",
                                "text": "„Während der Kampfpausen im Hundertjährigen Krieg verdingten sich viele Söldner in Italien.“"
                            },
                            {
                                "example_id": "68501b90-f94b-46a6-8134-811774a80540",
                                "sense_id": "97a61cf4-2030-3e49-928e-0e61ccaa4ce5",
                                "text": "„Auch die Hisbollah-Miliz kündigte eine Kampfpause gegen den IS an.“"
                            },
                            {
                                "example_id": "2dc42d64-e371-4a46-845e-1e51e144cb45",
                                "sense_id": "97a61cf4-2030-3e49-928e-0e61ccaa4ce5",
                                "text": "„Überraschend hatten die Taliban damals einer dreitägigen Kampfpause zum Ende des islamischen Fastenmonats Ramadan zugestimmt.“"
                            },
                            {
                                "example_id": "bdc9c409-1b90-4e92-8062-da7bc29dd0bb",
                                "sense_id": "97a61cf4-2030-3e49-928e-0e61ccaa4ce5",
                                "text": "„UN-Vermittler Staffan de Mistura forderte statt der Kampfpausen erneut eine vollständige Waffenruhe.“"
                            },
                            {
                                "example_id": "1ee68e72-9f32-4c62-a8d2-0c9b8329f5c8",
                                "sense_id": "97a61cf4-2030-3e49-928e-0e61ccaa4ce5",
                                "text": "„Die sowjetische Führung nutzte die mehrmonatige Kampfpause dennoch, um den Ausbildungsstand der Soldaten zu verbessern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "59d8edfe-4cc5-3170-8dd5-3527e5e265eb",
                        "entry_id": "15e3b57a-b941-3aaa-bb07-e36cc74a11fa",
                        "glosses": [
                            "Zeit zwischen zwei Runden in einer Kampfsportart (beispielsweise Boxen), in der die Sportler/Sportlerinnen gepflegt werden und Anweisungen vom Trainer erhalten können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb3babd6-be98-4a92-98f9-741c9f33667d",
                                "sense_id": "59d8edfe-4cc5-3170-8dd5-3527e5e265eb",
                                "text": "In der Kampfpause gab der Trainer neue Anweisungen."
                            },
                            {
                                "example_id": "724dc8ab-60e0-4181-90d8-6b07e8cde4f2",
                                "sense_id": "59d8edfe-4cc5-3170-8dd5-3527e5e265eb",
                                "text": "Der Ringarzt begutachtete in der Kampfpause den Cut des Boxers an der Augenbraue."
                            },
                            {
                                "example_id": "ae4eebc0-19b2-400b-bf5c-9230c11c5e8d",
                                "sense_id": "59d8edfe-4cc5-3170-8dd5-3527e5e265eb",
                                "text": "„In den Kampfpausen wurde auf Anordnung des Schiedsgerichts versucht, die Seile zu spannen, doch Ali setzte seine Taktik unbeirrt fort, obwohl ihm sein Trainer ständig zurief, er solle unbedingt weg von den Seilen.“"
                            },
                            {
                                "example_id": "9994871a-fc8b-4d85-ae58-9992820f4576",
                                "sense_id": "59d8edfe-4cc5-3170-8dd5-3527e5e265eb",
                                "text": "„Nummerngirls tragen meistens einen Badeanzug oder einen Bikini und sollen das Publikum während der Kampfpause unterhalten.“"
                            },
                            {
                                "example_id": "d60405aa-a1a2-4b4e-90d0-3968ca486bf9",
                                "sense_id": "59d8edfe-4cc5-3170-8dd5-3527e5e265eb",
                                "text": "„Bei einer Unterbrechung eines Kampfes oder in den Kampfpausen darf ärztliche Behandlung durch den Ringarzt oder einen anderen Arzt nicht erfolgen.“"
                            },
                            {
                                "example_id": "df59d090-1dd5-480b-b1ce-c42b54ab4185",
                                "sense_id": "59d8edfe-4cc5-3170-8dd5-3527e5e265eb",
                                "text": "„Der Hüne erstarrte nach einem linken Haken Brewsters, lag bäuchlings auf dem Boden, unfähig, in der Rundenpause von einer Minute aufzustehen, so verzweifelt sein Bruder Witali und Steward auch schrien: „Get up!“ Aberwitzig: Technischer K.o. in der Kampfpause.“"
                            },
                            {
                                "example_id": "4d31e167-6b5d-43d7-a5d5-97137c218f67",
                                "sense_id": "59d8edfe-4cc5-3170-8dd5-3527e5e265eb",
                                "text": "[Ju-Jutsu:] „Die Kampfzeit eines Kampfes beträgt 1 × 3 Minuten, in den jüngeren Altersklassen 1 × 2 Minuten. Bis ins Jahr 2000 waren es noch 2 × 2 Minuten mit einer Minute Kampfpause.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e25f4e92-5ce0-31d9-bb99-f7545b34fcdf",
                        "entry_id": "15e3b57a-b941-3aaa-bb07-e36cc74a11fa",
                        "glosses": [
                            "Zeit, in der eine Person, die einen Kampfsport (beispielsweise Boxen) betreibt, für eine längere Zeit nicht im Ring steht (beispielsweise Wochen oder Monate)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87f28e1e-19e4-49f7-b315-fef823032897",
                                "sense_id": "e25f4e92-5ce0-31d9-bb99-f7545b34fcdf",
                                "text": "Der Boxer verkündete, dass er sich freue, nach langer Kampfpause wieder im Ring zu stehen."
                            },
                            {
                                "example_id": "0762ca52-7db6-4017-9376-01e4f1779411",
                                "sense_id": "e25f4e92-5ce0-31d9-bb99-f7545b34fcdf",
                                "text": "[Schlagzeile:] „Sophie Alisch kehrt nach langer Kampfpause in den Ring zurück“"
                            },
                            {
                                "example_id": "d25b422e-f33a-4852-b03a-f9645d82e780",
                                "sense_id": "e25f4e92-5ce0-31d9-bb99-f7545b34fcdf",
                                "text": "„Der 41-jährige Ex-Weltmeister Felix Sturm kehrt nach fast fünf Jahren Kampfpause in den Ring zurück.“"
                            },
                            {
                                "example_id": "b15315a5-2329-47be-bd02-e56f37740e7f",
                                "sense_id": "e25f4e92-5ce0-31d9-bb99-f7545b34fcdf",
                                "text": "„Nach fast fünfjähriger Kampfpause meldet sich Felix Sturm siegreich im Ring zurück.“"
                            },
                            {
                                "example_id": "5f2c4789-8ccc-47fa-b51c-a7a9f0d3481f",
                                "sense_id": "e25f4e92-5ce0-31d9-bb99-f7545b34fcdf",
                                "text": "„In der mit 12.600 Zuschauern ausverkauften Preussag-Arena war dem 36-jährigen Herausforderer vom ersten Gong an die lange Kampfpause anzumerken.“"
                            },
                            {
                                "example_id": "04e9b149-811d-48d5-9c29-fa590b573c15",
                                "sense_id": "e25f4e92-5ce0-31d9-bb99-f7545b34fcdf",
                                "text": "[Er] „wechselte im Dezember 2018, nach einer verletzungsbedingten Kampfpause von 15 Monaten, zu Petkos LMS Box-Promotion in München.“"
                            },
                            {
                                "example_id": "02537397-2e0f-49af-8fb8-1cb8a6168900",
                                "sense_id": "e25f4e92-5ce0-31d9-bb99-f7545b34fcdf",
                                "text": "„Nach mehrjähriger Kampfpause kämpfte sich Dalibor Medic bei der ITF-Taekwondo-Europameisterschaft im Oktober 2007 in Tallinn ins Viertelfinale durch.“"
                            },
                            {
                                "example_id": "ceb0139b-f62f-4ce2-882d-226e92e0d692",
                                "sense_id": "e25f4e92-5ce0-31d9-bb99-f7545b34fcdf",
                                "text": "[Floyd Mayweather:] „Der 40-jährige US-Amerikaner, der vor knapp zwei Jahren vom Leistungssport zurücktrat, ist in 49 Profikämpfen unbesiegt und geht trotz der langen Kampfpause als klarer Favorit in das Duell.“"
                            },
                            {
                                "example_id": "014dfd44-fea1-4f05-839d-d224ba2ad942",
                                "sense_id": "e25f4e92-5ce0-31d9-bb99-f7545b34fcdf",
                                "text": "[Verletzungen beim Boxen:] „Der Bruch muss in der Regel entweder gegipst, geschient oder bei einem offenen Bruch sogar operiert werden. Eine Kampfpause über einen Zeitraum von ca. 2 Monaten ist in der Regel ebenfalls die Folge.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
