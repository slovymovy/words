                                    {
                                        "sense_id": "2ef1be88-208c-3ce9-9991-cc5d0d8012fc",
                                        "entry_id": "bfa38e96-610f-38c8-9a77-8502cb61e6f5",
                                        "glosses": [
                                            "Demonstrating a consistent set of rules; showing order, evenness of operation or occurrence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d78e9d2-2041-44bd-bf9e-cd253174827e",
                                                "sense_id": "2ef1be88-208c-3ce9-9991-cc5d0d8012fc",
                                                "text": "April may be the cruellest month, but I am planning to render it civilised and to take my antibiotics in a regular manner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "416a7040-d8a9-370d-8d5f-6f0b82f1fa26",
                                        "entry_id": "bfa38e96-610f-38c8-9a77-8502cb61e6f5",
                                        "glosses": [
                                            "Of a moon or other satellite: following a relatively close and prograde orbit with little inclination or eccentricity."
