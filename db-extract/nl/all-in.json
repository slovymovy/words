                                    {
                                        "sense_id": "65ad9efe-0b19-33d8-b984-1b9eabb078f5",
                                        "entry_id": "09725ee7-f777-304f-accb-381e98ba7a81",
                                        "glosses": [
                                            "Providing all amenities, benefits or perquisites in a single package."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "364adf6b-2c36-4958-9410-085a95bc9561",
                                                "sense_id": "65ad9efe-0b19-33d8-b984-1b9eabb078f5",
                                                "text": "We stayed at an all-inclusive resort while we were in Bermuda, and even the golfing was free."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "all-inclusive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce482f92-57e7-3230-a0e7-303b15ed6d0b",
                                        "entry_id": "70f5e2b9-4998-329d-a9e5-4ef827d2f168",
                                        "glosses": [
                                            "A resort that provides all amenities, benefits or perquisites in a single package."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aee158f-ab08-42e9-91ac-ed1b823ba27c",
                                                "sense_id": "ce482f92-57e7-3230-a0e7-303b15ed6d0b",
                                                "text": "The development of all-inclusives may restrict the development of other forms of tourism, such as nature heritage tourism, since all-inclusive visitors are not generally consumers of these activities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
