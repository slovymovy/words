                        "entry_id": "64df9cfb-4fc0-37b6-b7bb-72e0b0d29547",
                        "glosses": [
                            "in der japanischen Zeitraum Zeitrechnung vom 8. Januar 1989 bis zum 30. April 2019, in welcher der Kaiser Akihito regierte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39753c61-9dc7-4373-8d86-84ebc6cfcedd",
                                "sense_id": "5786ba53-2e54-3180-9bb0-8ffbda10e07e",
                                "text": "„Wirklich ärgerlich aber ist das Ende: Knappe vier Druckseiten widmet der Autor des Buches mit dem Untertitel ‚von Meiji bis Heisei‘ den Jahren von 1989, dem Tode Hirohitos (Showa), bis zur Jetztzeit unter Akihito (Heisei).“"
                            },
                            {
                                "example_id": "c8396fcd-5824-4cc1-94a2-3551c05ea716",
                                "sense_id": "5786ba53-2e54-3180-9bb0-8ffbda10e07e",
                                "text": "„Mit dem Kaiserwechsel endet die seit 1989 dauernde Regentschaft unter dem Namen Heisei (Frieden schaffen).“"
                            }
                        ],
