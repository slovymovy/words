                                        "examples": [
                                            {
                                                "example_id": "bca77699-260c-4bd8-90fb-a26fe25c4d29",
                                                "sense_id": "7c376ffa-76df-3c83-baa4-f920e46b27d6",
                                                "text": "Mon beau-fils, expert en l’art de graduer ses effets, exhibe petit à petit un jeu de cravates, de casquettes plates à grande visière, de knickerbockers et de bas tyroliens, propres à fanatiser les foules."
                                            },
                                            {
                                                "example_id": "3eb8a56e-55e6-4f28-b041-8bb624b15bc2",
                                                "sense_id": "7c376ffa-76df-3c83-baa4-f920e46b27d6",
                                                "text": "Mes quatre beaux-fils ne m’appellent pas beau-père, mais “joli-papa”, et me présentent comme tel à leurs amis, raconte, par exemple, Dominique."
                                            }
                                        ]
                                    },
