                                    {
                                        "sense_id": "2ed2b48c-73a5-3d19-8901-b7c437f0dfdc",
                                        "entry_id": "9e063567-a76c-3a8a-b7fa-dec6da64d007",
                                        "glosses": [
                                            "A person, especially a man, who is socially regarded as able to marry, but has not yet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2920c411-ca9f-40cd-af96-ed00b9fc29a9",
                                                "sense_id": "2ed2b48c-73a5-3d19-8901-b7c437f0dfdc",
                                                "text": "As merry and mellow an old bachelor as ever followed a hound."
                                            },
                                            {
                                                "example_id": "f77767bd-609f-42f6-976e-8711c180dea4",
                                                "sense_id": "2ed2b48c-73a5-3d19-8901-b7c437f0dfdc",
                                                "text": "I shall die a bachelor."
                                            },
                                            {
                                                "example_id": "c6152547-101b-4396-8816-6d8830a76392",
                                                "sense_id": "2ed2b48c-73a5-3d19-8901-b7c437f0dfdc",
                                                "text": "I knew from the beginning that I would have to move fast to keep Minnie to myself. Kansas City was full of rakehell bachelors, all of whom I had to outcourt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d408441d-aa03-37d4-ac04-adcf20d30111",
                                        "entry_id": "9e063567-a76c-3a8a-b7fa-dec6da64d007",
                                        "glosses": [
                                            "The first or lowest academical degree conferred by universities and colleges; a bachelor's degree."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
