                    {
                        "sense_id": "8cc69a93-76f3-387c-ba81-21a35095bddd",
                        "entry_id": "aca721b6-3dda-38c4-8607-c78db9f43fd2",
                        "glosses": [
                            "in Afghanistan, dem Iran und Pakistan lebendes iranisches Volk"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "1e413738-c83e-4c40-b71e-9fc0351763f5",
                                "sense_id": "8cc69a93-76f3-387c-ba81-21a35095bddd",
                                "text": "„Sie wurde seitdem von den Millionen von Paschtunen und Belutschen, die auf beiden Seiten lebten, weitgehend ignoriert, ebenso von Waffen- und Drogenschmugglern, Dschihadisten und - in außerordentlich seltenen Fällen - amerikanischen Spezialeinheiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a8d454a0-87fc-3e70-9385-869b17cd4ca5",
                        "entry_id": "aca721b6-3dda-38c4-8607-c78db9f43fd2",
                        "glosses": [
                            "Angehöriger des gleichnamigen iranischen Volkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1203abd-eca2-4230-af34-08fef53c56fb",
                                "sense_id": "a8d454a0-87fc-3e70-9385-869b17cd4ca5",
                                "text": "„Nachdem er ihr Gesicht gereinigt hatte, schöpfte der Belutsche mit der rechten Hand etwas Wasser und spritzte ihr ein paar Tröpfchen auf die Lippen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
