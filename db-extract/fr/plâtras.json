        "fr-extract.jsonl": [
            {
                "entry_id": "28637d54-773a-3665-9478-b52a4751055e",
                "word": "plâtras",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "943b0012-9d72-3074-b651-fe3719050c11",
                        "entry_id": "28637d54-773a-3665-9478-b52a4751055e",
                        "glosses": [
                            "Débris d’ouvrages de plâtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6af6878-4b8c-4c67-8abf-a87c9dc6fa1d",
                                "sense_id": "943b0012-9d72-3074-b651-fe3719050c11",
                                "text": "Le bois carambole contre la paroi de la niche, retombe à terre avec fracas, entraînant il ne sait quel débris, quel plâtras."
                            },
                            {
                                "example_id": "c1ab58a0-f1ea-4409-952e-c14f79d69225",
                                "sense_id": "943b0012-9d72-3074-b651-fe3719050c11",
                                "text": "Tout à coup elle casse comme un caoutchouc trop tendu qui casse et se détend enfin, il est de nouveau lui-même, il comprend, il met les lettres dans sa poche. Il respire une odeur de poudre, de poussière froide et de plâtras. Gustave, en bas, gémit. Où est Mme Gustave ? Le café est maintenant grand ouvert sur la rue, et la rue entre dans le café, avec le froid et la poussière, et de grands pans d’ombre et de lumière blanche qui tournent sur les tables renversées. Les débris de vitre, à terre, brillent comme des toiles et des lunes."
                            },
                            {
                                "example_id": "9f63b898-021c-4d41-83e3-e4fb5d628ad0",
                                "sense_id": "943b0012-9d72-3074-b651-fe3719050c11",
                                "text": "Ainsi, dans quel océan de plâtras, de mortier, de cailloux, au milieu de quelle cohue de goujats et de tâcherons devront vivre les fonctionnaires et les courtisans."
                            },
                            {
                                "example_id": "033e03f5-4963-4d55-b3ce-6a5ab7c23e35",
                                "sense_id": "943b0012-9d72-3074-b651-fe3719050c11",
                                "text": "Il tombe de gros plâtras de cette cloison, de ce plafond, de cette cheminée."
                            }
                        ]
                    },
                    {
                        "sense_id": "658776a9-51ba-38ae-8246-1d77197731e9",
                        "entry_id": "28637d54-773a-3665-9478-b52a4751055e",
                        "glosses": [
                            "Matériaux de plâtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33f0be4e-6f0d-4306-bb62-bffd0233b729",
                                "sense_id": "658776a9-51ba-38ae-8246-1d77197731e9",
                                "text": "On emploie les plâtras dans les constructions légères."
                            },
                            {
                                "example_id": "e8d3e8b0-5010-4b3a-997a-f753e3379415",
                                "sense_id": "658776a9-51ba-38ae-8246-1d77197731e9",
                                "text": "Ce pignon est de plâtras."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5d487bb-6ad2-3907-bfa2-c24e38782cb2",
                        "entry_id": "28637d54-773a-3665-9478-b52a4751055e",
                        "glosses": [
                            "Mauvais matériaux."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "9b11392d-a559-49c1-a6fe-07a6af097ae2",
                                "sense_id": "c5d487bb-6ad2-3907-bfa2-c24e38782cb2",
                                "text": "Cette maison n’est bâtie que de plâtras."
                            },
                            {
                                "example_id": "a3435396-bd80-4b50-adc3-c2013008869b",
                                "sense_id": "c5d487bb-6ad2-3907-bfa2-c24e38782cb2",
                                "text": "Un crapaud qui vous annoncerait qu’il vient d’hériter d’un gros tas de plâtras dans lequel il pourra gîter tout à l’aise."
                            }
                        ]
                    }
                ],
