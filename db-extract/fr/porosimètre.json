                        "entry_id": "776a8f02-bf5e-387a-8ffe-c502502fd34a",
                        "glosses": [
                            "Instrument de mesure servant à déterminer la porosité d'un corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41c4fc14-7dfb-4642-9f82-df471c0c672b",
                                "sense_id": "4c3db23d-80fa-3b6a-835e-6577a6fa2987",
                                "text": "La macroporosité est déterminée au porosimètre à mercure."
                            },
                            {
                                "example_id": "968c7a25-df54-49d2-9f77-389f6b4f1f51",
                                "sense_id": "4c3db23d-80fa-3b6a-835e-6577a6fa2987",
                                "text": "Il y a donc corrélation certaine entre les mesures effectuées au porosimètre avant corrosion et les résultats de la corrosion au brouillard salin."
                            },
                            {
                                "example_id": "d2c94d4e-d3d8-4ef4-a95a-d73597aa894f",
                                "sense_id": "4c3db23d-80fa-3b6a-835e-6577a6fa2987",
                                "text": "Quelques mesures de porosité, sur site granitique altéré, ont été réalisées à l'aide d'un porosimètre à mercure, mais sur la partie la plus superficielle du réservoir"
                            }
                        ]
                    }
