    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ee64ff21-73f5-3b0b-82b0-7b01d7ba616f",
                    "sense_definition": "Easy to use or useful for a particular purpose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "adj_utility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This small tool is very <w>handy</w> for fixing loose screws around the house.",
                            "target_lang_translations": {
                                "ru": "Этот маленький инструмент очень <w>удобен</w> для починки разболтавшихся винтов в доме.",
                                "zh": "这个小工具对于修理家里松动的螺丝非常<w>方便</w>。"
                            }
                        },
                        {
                            "text": "It is <w>handy</w> to have a map on your phone when you are traveling in a new city.",
                            "target_lang_translations": {
                                "ru": "Очень <w>удобно</w> иметь карту в телефоне, когда путешествуешь по новому городу.",
                                "zh": "在一个陌生的城市旅行时，手机里有地图会很<w>方便</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "awkward"
                    ],
                    "common_phrases": [
                        "come in handy",
                        "handy tip",
                        "handy hint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удобный в использовании или полезный для определенной цели.",
                        "zh": "易于使用或对特定目的有用的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удобный",
                                "target_lang_sense_clarification": "easy to use or comfortable"
                            },
                            {
                                "target_lang_word": "полезный",
                                "target_lang_sense_clarification": "useful or beneficial"
                            },
                            {
                                "target_lang_word": "практичный",
                                "target_lang_sense_clarification": "practical"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "方便",
                                "target_lang_sense_clarification": "easy to use or convenient"
                            },
                            {
                                "target_lang_word": "实用",
                                "target_lang_sense_clarification": "practical or useful"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7913c67d-2e1d-3234-bd85-903d926812c4",
                    "sense_definition": "Located nearby or within easy reach.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "adj_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I always keep a pen and paper <w>handy</w> so I can write down notes immediately.",
                            "target_lang_translations": {
                                "ru": "Я всегда держу ручку и бумагу <w>под рукой</w>, чтобы можно было сразу делать заметки.",
                                "zh": "我总是把纸笔放在<w>手边</w>，以便能立刻记下笔记。"
                            }
                        },
                        {
                            "text": "Do you have a calculator <w>handy</w> to check these figures?",
                            "target_lang_translations": {
                                "ru": "У вас есть <w>под рукой</w> калькулятор, чтобы проверить эти цифры?",
                                "zh": "你<w>手边</w>有计算器来核对这些数字吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "at hand",
                        "on hand",
                        "to hand"
                    ],
                    "common_phrases": [
                        "keep something handy",
                        "have something handy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся поблизости или в пределах легкой досягаемости.",
                        "zh": "位于附近或触手可及的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "под рукой",
                                "target_lang_sense_clarification": "at hand / nearby"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手边",
                                "target_lang_sense_clarification": "at hand or nearby"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3c0c1b0-bd30-34f9-8769-0aaea537708a",
                    "sense_definition": "Skilful with one's hands; dexterous.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "adj_skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My uncle is very <w>handy</w> and built all the furniture in his living room himself.",
                            "target_lang_translations": {
                                "ru": "Мой дядя очень <w>рукастый</w> и сам сделал всю мебель в своей гостиной.",
                                "zh": "我叔叔非常<w>手巧</w>，他客厅里所有的家具都是自己做的。"
                            }
                        },
                        {
                            "text": "She is quite <w>handy</w> with a needle and thread, so she can fix that tear for you.",
                            "target_lang_translations": {
                                "ru": "Она весьма <w>искусна</w> в обращении с иголкой и ниткой, так что сможет зашить эту дырку для тебя.",
                                "zh": "她很<w>灵巧</w>，擅长针线活，所以她能帮你把那个破洞补好。"
                            }
                        }
                    ],
                    "antonyms": [
                        "awkward"
                    ],
                    "common_phrases": [
                        "handy with tools",
                        "handy around the house"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусный в работе руками; умелый.",
                        "zh": "擅长手工劳动；灵巧的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умелый",
                                "target_lang_sense_clarification": "skillful"
                            },
                            {
                                "target_lang_word": "рукастый",
                                "target_lang_sense_clarification": "good with hands (colloquial)"
                            },
                            {
                                "target_lang_word": "искусный",
                                "target_lang_sense_clarification": "dexterous or artful"
                            },
                            {
                                "target_lang_word": "ловкий",
                                "target_lang_sense_clarification": "adroit"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灵巧",
                                "target_lang_sense_clarification": "dexterous or skillful"
                            },
                            {
                                "target_lang_word": "手巧",
                                "target_lang_sense_clarification": "good with one's hands"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b57dccf-0714-39da-9a22-11305a7d8a0a",
                    "sense_definition": "Ready to use physical violence or fists.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "adj_violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should be careful around him because he can get a bit <w>handy</w> after a few drinks.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит быть осторожнее с ним, потому что после пары рюмок он может начать <w>распускать руки</w>.",
                                "zh": "你和他在一起时要小心，因为他喝了几杯酒后可能会变得<w>好斗</w>。"
                            }
                        },
                        {
                            "text": "The bouncer was known for being <w>handy</w> with his fists when trouble started.",
                            "target_lang_translations": {
                                "ru": "Вышибала был известен тем, что <w>ловко пускал в ход</w> кулаки, когда начинались неприятности.",
                                "zh": "那个保镖以在发生冲突时<w>好斗</w>而闻名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "a bit handy",
                        "handy with one's fists"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовый применить физическую силу или пустить в ход кулаки.",
                        "zh": "准备使用暴力或拳头。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драчливый",
                                "target_lang_sense_clarification": "pugnacious"
                            },
                            {
                                "target_lang_word": "скорый на расправу",
                                "target_lang_sense_clarification": "quick to use violence"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好斗",
                                "target_lang_sense_clarification": "pugnacious or ready to fight"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd2d0ebe-e5d0-3c72-8c24-e05cb6bf3987",
                    "sense_definition": "Relating to a freight ship with a small cargo capacity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "adj_nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The port is too shallow for large vessels, so only <w>handy</w> ships can dock there.",
                            "target_lang_translations": {
                                "ru": "Порт слишком мелководен для больших судов, поэтому там могут швартоваться только <w>малотоннажные</w> корабли.",
                                "zh": "这个港口对大型船只来说太浅了，所以只有<w>小型</w>货船才能停靠。"
                            }
                        },
                        {
                            "text": "They chartered a <w>handy</w> bulk carrier for the short coastal route.",
                            "target_lang_translations": {
                                "ru": "Они зафрахтовали <w>малотоннажный</w> балкер для короткого прибрежного маршрута.",
                                "zh": "他们租了一艘<w>小型</w>散货船用于短途沿海航线。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "nautical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к грузовому судну малой грузоподъемности.",
                        "zh": "指载货量较小的货船。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "малотоннажный",
                                "target_lang_sense_clarification": "small tonnage"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小型",
                                "target_lang_sense_clarification": "small tonnage"
                            }
                        ]
                    }
                }
            ]
