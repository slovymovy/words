                                        "glosses": [
                                            "An organism belonging to the same species as another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d3f12d2-23ac-4496-af11-e8e0bab964a5",
                                                "sense_id": "65136473-b0e4-31c9-a0d3-5c57c643dc2c",
                                                "text": "I duly laid on Adam the privilege and obligations of a conspecific."
