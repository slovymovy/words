                "senses": [
                    {
                        "sense_id": "3d365039-7d7e-3f36-9667-0c29d614a23a",
                        "entry_id": "b2ea39b3-b0fe-3414-b569-99d0c65e2324",
                        "glosses": [
                            "Clipping of daffodil."
                        ],
                        "tags": [
                            "British",
                            "abbreviation",
                            "alt-of",
                            "clipping",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "3e584678-fffe-403d-8fa8-b7084acc7cde",
                                "sense_id": "3d365039-7d7e-3f36-9667-0c29d614a23a",
                                "text": "Get your daffs here - £2 a bunch."
                            },
                            {
                                "example_id": "e453d710-85bf-4613-b73b-7824de231cc8",
                                "sense_id": "3d365039-7d7e-3f36-9667-0c29d614a23a",
                                "text": "You want a few more daffs on the decani side […]"
                            },
                            {
                                "example_id": "2c65e800-4baa-4822-80fb-517c02468d18",
                                "sense_id": "3d365039-7d7e-3f36-9667-0c29d614a23a",
                                "text": "Like spending money, it goes with the territory. So if he wants the price of the daffs and the Black Magic returned, why shouldn't we be compensated for having to put up with the less profitable side of romance?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "bf44c45c-aed5-342d-8e8d-0707fe270263",
                "word": "daff",
