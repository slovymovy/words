                {
                    "sense_id": "53607cf4-e91e-3296-b69e-e82ec066bbf0",
                    "sense_definition": "An element in a composite whole; a sequence of linked events or facts; a logical thread.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_thread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective tried to follow every <w>strand</w> of truth in the witness's story.",
                            "target_lang_translations": {
                                "ru": "Детектив пытался проследить за каждой <w>нитью</w> правды в рассказе свидетеля.",
                                "de": "Der Detektiv versuchte, jedem <w>Faden</w> der Wahrheit in der Geschichte des Zeugen zu folgen.",
                                "tr": "Dedektif, tanığın hikayesindeki gerçeğin her bir <w>bağını</w> takip etmeye çalıştı.",
                                "zh": "侦探试图理清证人叙述中每一条真相的<w>线索</w>。"
                            }
                        },
                        {
                            "text": "There is a common <w>strand</w> of thought running through all his novels.",
                            "target_lang_translations": {
                                "ru": "Через все его романы проходит общая <w>линия</w> мысли.",
                                "de": "Ein gemeinsamer <w>Strang</w> zieht sich durch alle seine Romane.",
                                "tr": "Tüm romanlarında ortak bir düşünce <w>akışı</w> var.",
                                "zh": "他的所有小说中都贯穿着一条共同的思想<w>主线</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "strand of truth",
                        "strand of the story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Элемент сложного целого; последовательность связанных событий или фактов; логическая нить.",
                        "de": "Ein Element eines Ganzen; eine Abfolge von Ereignissen oder eine logische Verbindung.",
                        "tr": "Karmaşık bir bütünün parçası; bağlantılı olaylar veya gerçekler dizisi; mantıksal bir bağ.",
                        "zh": "复合整体中的一个组成部分；一连串相互关联的事件、事实或逻辑线索。"
                    },
                    "translations": {
                        "ru": [
