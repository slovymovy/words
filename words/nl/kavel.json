{
    "word_family": [
        "kavelen",
        "verkavelen",
        "verkaveling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "817b5d77-9afc-36d1-8e23-8af67128760d",
                    "sense_definition": "Een afgebakend stuk grond.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "land",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hebben een groot <w>kavel</w> gekocht om hun droomhuis op te bouwen.",
                            "target_lang_translations": {
                                "en": "They bought a large <w>plot</w> to build their dream house on."
                            }
                        },
                        {
                            "text": "Dit <w>kavel</w> grond ligt op een uitstekende locatie nabij het centrum.",
                            "target_lang_translations": {
                                "en": "This <w>parcel</w> of land is in an excellent location near the center."
                            }
                        }
                    ],
                    "synonyms": [
                        "perceel"
                    ],
                    "common_phrases": [
                        "bouwrijp kavel"
                    ],
                    "target_lang_definitions": {
                        "en": "A demarcated piece of land."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plot",
                                "target_lang_sense_clarification": "A distinct portion or plot of land."
                            },
                            {
                                "target_lang_word": "parcel",
                                "target_lang_sense_clarification": "A division of land bought and sold as a unit."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "639ba426-53e8-3fc4-888d-2ee513231537",
                    "sense_definition": "Een voorwerp of groep voorwerpen die als één geheel worden geveild.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "veiling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het antieke servies werd als één <w>kavel</w> aangeboden tijdens de veiling.",
                            "target_lang_translations": {
                                "en": "The antique dinnerware was offered as a single <w>lot</w> during the auction."
                            }
                        },
                        {
                            "text": "De koper bood op het laatste <w>kavel</w> van de dag.",
                            "target_lang_translations": {
                                "en": "The buyer bid on the last <w>lot</w> of the day."
                            }
                        }
                    ],
                    "common_phrases": [
                        "veiling kavel"
                    ],
                    "target_lang_definitions": {
                        "en": "An item or group of items offered as a single unit at an auction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lot",
                                "target_lang_sense_clarification": "One or more items auctioned or sold as a unit."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de786e8d-b811-3070-b0d2-32e1624055c7",
                    "sense_definition": "Iets dat door loting is toegewezen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "loting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de loting bleek welk <w>kavel</w> aan iedere deelnemer was toegewezen.",
                            "target_lang_translations": {
                                "en": "After the draw, it became clear which <w>lot</w> had been assigned to each participant."
                            }
                        },
                        {
                            "text": "Het eerlijk verdelen van de goederen gebeurde via een <w>kavel</w>.",
                            "target_lang_translations": {
                                "en": "The fair distribution of the goods was done by <w>lot</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Something assigned by drawing lots."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lot",
                                "target_lang_sense_clarification": "Anything used in determining a question by chance."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "19be3df3-a986-32f8-821b-bf5718cb1a57",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>kavelen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kavel</w> de grond in kleinere stukken voor de verkoop.",
                            "target_lang_translations": {
                                "en": "I <w>parcel out</w> the land into smaller pieces for sale."
                            }
                        },
                        {
                            "text": "Elke dag <w>kavel</w> ik de goederen voor de veiling.",
                            "target_lang_translations": {
                                "en": "Every day I <w>parcel out</w> the goods for the auction."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'kavelen' (to divide into lots)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "parcel out",
                                "target_lang_sense_clarification": "To divide and distribute by parts or portions."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87509321-bfcd-34d7-a1f8-3e60bb06c412",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>kavelen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kavel</w> jij de percelen voor het nieuwe project?",
                            "target_lang_translations": {
                                "en": "Do you <w>parcel out</w> the plots for the new project?"
                            }
                        },
                        {
                            "text": "Waarom <w>kavel</w> jij die goederen niet op de juiste manier?",
                            "target_lang_translations": {
                                "en": "Why don't you <w>parcel out</w> those goods correctly?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Second person singular present tense of 'kavelen'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "parcel out",
                                "target_lang_sense_clarification": "To divide and distribute by parts or portions."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df204c81-1691-34aa-82dc-b85a751e0db8",
                    "sense_definition": "Gebiedende wijs van <w>kavelen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kavel</w> nu de grond zodat we kunnen beginnen met bouwen.",
                            "target_lang_translations": {
                                "en": "<w>Parcel out</w> the land now so we can start building."
                            }
                        },
                        {
                            "text": "<w>Kavel</w> de voorwerpen zorgvuldig voor de veiling begint.",
                            "target_lang_translations": {
                                "en": "<w>Parcel out</w> the items carefully before the auction begins."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'kavelen'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "parcel out",
                                "target_lang_sense_clarification": "To divide and distribute by parts or portions."
                            }
                        ]
                    }
                }
            ]
        }
    ]
