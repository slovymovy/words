                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "introduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dark clouds were a <w>prelude</w> to the heavy storm that followed."
                        },
                        {
                            "text": "These changes are a <w>prelude</w> to a new era of economic growth."
                        }
                    ]
                },
                {
                    "sense_id": "2dca0288-b895-3363-8349-d1580034ea17",
                    "sense_definition": "A set of default functions or modules imported into a computer program.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "introduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The language <w>prelude</w> provides essential tools for every new project."
                        },
                        {
                            "text": "You can access standard functions without importing them because they are in the <w>prelude</w>."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "753fc8e2-49a5-3955-bf5c-d4d00ebf4c79",
                    "sense_definition": "To act as an introduction to something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "introduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The short speech <w>preluded</w> the main presentation of the evening."
                        },
                        {
                            "text": "His nervous laughter <w>preluded</w> the difficult announcement he had to make."
                        }
                    ]
                },
                {
                    "sense_id": "25cfac1b-b970-38e0-b742-a27d48be937b",
                    "sense_definition": "To play or perform an introductory piece of music.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "introduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The violinist began to <w>prelude</w> softly before the orchestra joined in."
                        },
                        {
                            "text": "The organist <w>preluded</w> for several minutes to set the mood for the service."
                        }
                    ]
                }
            ]
        }
    ]
