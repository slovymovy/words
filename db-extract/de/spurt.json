                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c69f3cf5-0684-444d-97cb-944289f30e48",
                                                "sense_id": "d39df440-cf7e-344c-b450-3fa2f41ba37e",
