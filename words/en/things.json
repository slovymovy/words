                {
                    "sense_id": "cc7b5318-fa73-3ed4-8cc9-807b791bfb68",
                    "sense_definition": "Plural of <w>thing</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have so many <w>things</w> to do today.",
                            "target_lang_translations": {
                                "ru": "У меня сегодня так много <w>дел</w>.",
                                "zh": "我今天有太多的<w>事情</w>要处理。",
                                "de": "Ich habe heute so viele <w>Dinge</w> zu erledigen."
                            }
                        },
                        {
                            "text": "She likes to buy nice <w>things</w> for her house.",
                            "target_lang_translations": {
                                "ru": "Она любит покупать красивые <w>вещи</w> для своего дома.",
                                "zh": "她喜欢为家里买些漂亮的<w>东西</w>。",
                                "de": "Sie kauft gerne schöne <w>Sachen</w> für ihr Haus."
                            }
                        }
                    ],
                    "common_phrases": [
                        "things like that",
                        "how are things",
                        "all things considered"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
