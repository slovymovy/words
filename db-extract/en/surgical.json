                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f18c245-3446-446e-a3e3-021e90d9786a",
                                "sense_id": "7435272c-e2cc-3aa6-8d24-2149e1fa2131",
                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems—surgical foam, a thermal gel depot, a microcapsule or biodegradable polymer beads."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c01c272-4ea0-3fa6-bb03-8ac68d7aa5aa",
                        "entry_id": "4c7a9d3c-6ce0-3785-8477-cc6c48fd60ea",
