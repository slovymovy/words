                            },
                            {
                                "target_lang_word": "buzz cut",
                                "target_lang_sense_clarification": "very short haircut"
                            },
                            {
                                "target_lang_word": "spiky hair",
                                "target_lang_sense_clarification": "hair sticking straight up"
                            }
                        ]
                    }
                }
            ]
        }
    ]
