            {
                "entry_id": "4714bdaa-ad2b-3287-8909-3e9f9395cda3",
                "word": "assiégeant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "97b6a9cd-34bc-4b54-89ce-1fed7261cab7",
                        "entry_id": "4714bdaa-ad2b-3287-8909-3e9f9395cda3",
                        "tags": [
                            "plural"
                        ],
                        "form": "assiégeants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "543d1fa3-83ad-3537-b8d5-bbd5ed78aaa9",
                        "entry_id": "4714bdaa-ad2b-3287-8909-3e9f9395cda3",
                        "glosses": [
                            "Celui qui assiège."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a90a02b-e269-4e59-a03e-0df3af256b3c",
                                "sense_id": "543d1fa3-83ad-3537-b8d5-bbd5ed78aaa9",
                                "text": "Le prince, pour toute réponse, jeta le sien du haut de la muraille ; puis, comme la nuit s’avançait, assiégés et assiégeants firent leurs dispositions, les uns d’attaque et les autres de défense."
                            },
                            {
                                "example_id": "771dc4bf-21ff-47b0-b31b-b5a30a2094e6",
                                "sense_id": "543d1fa3-83ad-3537-b8d5-bbd5ed78aaa9",
                                "text": "D’un autre côté, les assiégeants cherchaient à mettre le feu à ces hourds de bois qui rendaient le travail des sapeurs impossible […]."
                            },
                            {
                                "example_id": "bac68ee4-73a1-4980-b274-4c3a8cdbbad0",
                                "sense_id": "543d1fa3-83ad-3537-b8d5-bbd5ed78aaa9",
                                "text": "Les assiégeants laissèrent sur le carreau 5.000 morts, dont 1.200 travailleurs. Il y en eut 800 du côté des assiégés."
                            },
                            {
                                "example_id": "d4bd5575-f132-4a8e-80b8-c755f6daef05",
                                "sense_id": "543d1fa3-83ad-3537-b8d5-bbd5ed78aaa9",
                                "text": "Ayant acquis la preuve des relations qui existaient entre Césaire et les assiégeants, les habitants décidèrent de déposer l'évêque dans une barque et de le lâcher sur le Rhône. […] et, sans doute pour éviter que le fugitif ne renseignât les assiégeants sur la situation de la ville, on dût renoncer au projet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fb94235-819f-4874-954d-98886cbb20be",
                        "source_entry_id": "4714bdaa-ad2b-3287-8909-3e9f9395cda3",
                        "source_sense_id": "543d1fa3-83ad-3537-b8d5-bbd5ed78aaa9",
                        "target_lang_word": "besieger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "besieger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aac22297-1103-3f78-8d91-adae739ca271",
                                        "entry_id": "47256dfb-88b8-384c-a524-bc9090ae6733",
                                        "glosses": [
                                            "A person who besieges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6db18b17-7be6-412a-b61b-872e8bec7818",
                                                "sense_id": "aac22297-1103-3f78-8d91-adae739ca271",
                                                "text": "For a time, it was the only Royalist stronghold between London and Exeter, but it fell at last when a member of the garrison turned traitor and admitted the Parliamentary besiegers who destroyed it with gunpowder."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
