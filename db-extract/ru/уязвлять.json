                            "participle",
                            "past"
                        ],
                        "form": "уязвля́вши"
                    },
                    {
                        "form_id": "454aa4af-a3cf-4942-9ac6-4c606609cf34",
                        "entry_id": "239daf8f-11d4-36c0-b336-1f53ea8dbeab",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… уязвля́ть"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "00baab05-ce49-3d37-9294-cb9edf2393fb",
                        "entry_id": "239daf8f-11d4-36c0-b336-1f53ea8dbeab",
                        "glosses": [
                            "устар. наносить рану, ранить, жалить, причинять физическую боль"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "735e55f8-b008-4717-b86e-39ee430ce843",
                                "sense_id": "00baab05-ce49-3d37-9294-cb9edf2393fb",
                                "text": "Выйдешь на палубу, взглянешь и ослепнешь на минуту от нестерпимого блеска неба, моря; от меди на корабле, от железа отскакивают снопы лучей; палуба и та нестерпимо блещет и уязвляет глаз своей белизной."
                            },
                            {
                                "example_id": "81d2fe1f-59cc-4ba0-ad0e-eb14a3c2d866",
                                "sense_id": "00baab05-ce49-3d37-9294-cb9edf2393fb",
                                "text": "Точно так, по наблюдениям натуралистов, скорпион, пойманный и положенный в круг из горячих угольев, сам себя уязвляет, желая спастись от мучительной агонии."
                            },
                            {
                                "example_id": "0d85ca82-6848-475a-9cd6-49f42f845e52",
                                "sense_id": "00baab05-ce49-3d37-9294-cb9edf2393fb",
                                "text": "Там растет ядовитая белая трава, туземцы варят ее и составляют яд, которым намазанное копьецо стрелы смертельно уязвляет."
                            }
                        ]
                    },
                    {
                        "sense_id": "461328be-85c1-37e2-9a09-f232701e9708",
                        "entry_id": "239daf8f-11d4-36c0-b336-1f53ea8dbeab",
                        "glosses": [
                            "перен. оскорблять, обижать, причинять нравственную боль"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99bd4465-115d-4e8f-b41e-cdcca55b915b",
                                "sense_id": "461328be-85c1-37e2-9a09-f232701e9708",
                                "text": "Просветленное выражение после телефонного звонка на лице Александрова отчего-то неприятно уязвляет Бориса."
                            },
                            {
                                "example_id": "fb00adbf-e7d2-4354-b55b-faa96815ca6e",
                                "sense_id": "461328be-85c1-37e2-9a09-f232701e9708",
                                "text": "Меня все же очень уязвляло то, что я не в старшем классе."
                            }
                        ]
                    }
                ],
                "translations": [],
