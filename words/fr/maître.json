            "senses": [
                {
                    "sense_id": "cac0ef76-674c-3e45-8f90-c6e8412531ca",
                    "sense_definition": "Enseignant qui fait la classe dans une école élémentaire ou primaire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>maître</w> demande aux enfants d'ouvrir leurs cahiers de devoirs."
                        },
                        {
                            "text": "Les enfants écoutent attentivement le <w>maître</w> pendant la leçon de lecture."
                        }
                    ],
                    "synonyms": [
                        "instituteur",
                        "enseignant",
                        "professeur"
                    ],
                    "antonyms": [
                        "élève"
                    ],
                    "common_phrases": [
