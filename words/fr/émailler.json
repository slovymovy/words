                    "sense_id": "9fe1a7de-86d9-392d-bef4-bc41977d2f50",
                    "sense_definition": "Ponctuer ou parsemer un événement ou une période de divers faits ou incidents.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fig_parsemer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La manifestation s'est déroulée dans le calme, même si quelques tensions ont <w>émaillé</w> le cortège."
                        },
                        {
                            "text": "Cette longue négociation a été <w>émaillée</w> de nombreux rebondissements inattendus."
                        }
                    ],
                    "synonyms": [
                        "ponctuer",
                        "jalonner",
                        "parsemer"
                    ],
                    "common_phrases": [
