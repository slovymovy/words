                "senses": [
                    {
                        "sense_id": "f39dd588-db7e-3df6-b303-854c5161c8c1",
                        "entry_id": "43ebbfab-9903-3b83-bce9-f546b399c394",
                        "glosses": [
                            "pierwsza kobieta, która zapoczątkowała ludzkość, dany naród lub ród; kobieta, której są one potomstwem"
                        ],
                        "tags": [
                            "elevatedly"
                        ],
                        "examples": [
                            {
                                "example_id": "429a969a-2f01-4cec-9056-4f265459694b",
                                "sense_id": "f39dd588-db7e-3df6-b303-854c5161c8c1",
                                "text": "Wenus, jako matka Eneasza, uchodziła za pramatkę całego rodu julijskiego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "19a8e4aa-bd56-340f-82a4-c3abc666ec33",
                        "entry_id": "43ebbfab-9903-3b83-bce9-f546b399c394",
                        "glosses": [
                            "początek, źródło, kolebka, miejsce powstania czegoś"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "a8532f10-1516-4e4a-8132-660a7e5d513c",
                                "sense_id": "19a8e4aa-bd56-340f-82a4-c3abc666ec33",
                                "text": "…a na piekielnej przełęczy, / nad dnem Styksowych otchłani, / siedzi pod złomem niebotycznej grani / pramatka Grzechu, jasnowłosa Ewa, / z gadziną zdrady u swych białych stóp"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
