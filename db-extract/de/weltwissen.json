                "senses": [
                    {
                        "sense_id": "8c54b44b-1a66-3e3a-bb29-69fcf4952182",
                        "entry_id": "6da2616f-7f19-3bd4-92c6-b8a3c95820fc",
                        "glosses": [
                            "das gemeinsame Wissen aller Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27fb1350-0f09-4fb5-b115-546c4f3dcc53",
                                "sense_id": "8c54b44b-1a66-3e3a-bb29-69fcf4952182",
                                "text": "Nicht einmal große Bibliotheken stellen das gesamte Weltwissen zur Verfügung."
                            },
                            {
                                "example_id": "c9f2a110-1a69-4bd9-a79c-d774aea1dbb9",
                                "sense_id": "8c54b44b-1a66-3e3a-bb29-69fcf4952182",
                                "text": "„Wikipedia hat den Zugang zum Weltwissen revolutioniert.“"
                            },
                            {
                                "example_id": "f2098a2f-91dd-4328-b8fe-6203ba76f1af",
                                "sense_id": "8c54b44b-1a66-3e3a-bb29-69fcf4952182",
                                "text": "„Seit ich ihn kenne, liest er sich in Bibliotheken das Weltwissen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4d78d69f-6a3a-37bc-b4b5-4baa0a2ee6c3",
                        "entry_id": "6da2616f-7f19-3bd4-92c6-b8a3c95820fc",
                        "glosses": [
                            "das Wissen von der Welt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d257183-92d3-4017-a15b-912680a96df3",
                                "sense_id": "4d78d69f-6a3a-37bc-b4b5-4baa0a2ee6c3",
                                "text": "„Seit ich ihn kenne, liest er sich in Bibliotheken das Weltwissen an.“"
                            },
                            {
                                "example_id": "d627cf05-07c8-4cd0-89c0-dda7f4ddc0bf",
                                "sense_id": "4d78d69f-6a3a-37bc-b4b5-4baa0a2ee6c3",
                                "text": "Das Weltwissen eines Kindes unterscheidet sich von dem der Erwachsenen."
                            },
                            {
                                "example_id": "546e086f-3b97-4cdd-a536-af14bb84293c",
                                "sense_id": "4d78d69f-6a3a-37bc-b4b5-4baa0a2ee6c3",
                                "text": "„Wir können uns auf unser Weltwissen verlassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
