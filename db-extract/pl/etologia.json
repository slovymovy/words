                                        "sense_id": "582aafac-98d3-347a-94a2-995516658867",
                                        "entry_id": "ea65bf61-a98f-316e-a907-3d03749fc407",
                                        "glosses": [
                                            "Teilbereich der Biologie, der sich mit dem Verhalten der Tiere beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "217c9a1e-556b-4834-b796-28cd07a9dbfe",
                                                "sense_id": "582aafac-98d3-347a-94a2-995516658867",
                                                "text": "Die Ethologie ist eine höchst interessante Wissenschaft."
                                            },
                                            {
                                                "example_id": "65bcc1c9-e4a1-4507-9dcf-3b0ba9196729",
                                                "sense_id": "582aafac-98d3-347a-94a2-995516658867",
                                                "text": "Als ein Teilgebiet der Biologie stellt die Ethologie oder Vergleichende Verhaltensforschung den Menschen und sein Verhalten in den universellen Kontext aller tierischen Lebewesen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "941a13be-922f-4df3-9000-30c00e35bc2e",
