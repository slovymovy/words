                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "f84902df-8185-4c72-a23e-99ec4f1fa1eb",
                                "sense_id": "c0bb1bf1-bb56-3fa9-916c-efc5e741479d",
                                "text": "Russland warnte die USA vor einem Waffengang gegen den Iran."
                            },
                            {
                                "example_id": "d8680074-9d81-4a31-8c28-637b33add962",
                                "sense_id": "c0bb1bf1-bb56-3fa9-916c-efc5e741479d",
                                "text": "„Sie haben, mein Führer, die bolschewistische Gefahr im eigenen Land gebannt und rufen nun unser Volk und die Völker Europas zum entscheidenden Waffengang gegen den Todfeind aller Ordnung und aller abendländisch-christlichen Kultur auf.“"
                            },
                            {
                                "example_id": "4285b381-6cd1-49e6-9c64-2018cdcf37f2",
                                "sense_id": "c0bb1bf1-bb56-3fa9-916c-efc5e741479d",
                                "text": "„Als der deutsche Kaiser am 1. August 1914 Russland den Krieg erklärte, hatte er sich zum Waffengang gegen seinen eigenen Cousin entschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
