                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "412fab07-d9c1-3733-b856-08c36bdc88d9",
                                        "entry_id": "17880b52-af94-3426-bf48-cd7371c5b37d",
                                        "glosses": [
                                            "獲得/贏得成功"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaf49c9b-e9ae-4283-8283-c0cf780df1b1",
                                                "sense_id": "412fab07-d9c1-3733-b856-08c36bdc88d9",
                                                "text": "付款成功。"
                                            },
                                            {
                                                "example_id": "cf970116-95e9-4307-93a5-952faea80f7e",
                                                "sense_id": "412fab07-d9c1-3733-b856-08c36bdc88d9",
                                                "text": "那次抗議沒成功。"
                                            },
                                            {
                                                "example_id": "551776e0-8235-4b06-a3c6-4f536737cf12",
                                                "sense_id": "412fab07-d9c1-3733-b856-08c36bdc88d9",
                                                "text": "那次抗议没成功。"
                                            },
                                            {
                                                "example_id": "b9069689-b471-4f9a-a9e1-36c1a9e534a8",
                                                "sense_id": "412fab07-d9c1-3733-b856-08c36bdc88d9",
                                                "text": "雖然我們不敢說你一定會成功，但是也絕對沒有人敢說你一定不會成功！"
                                            },
                                            {
                                                "example_id": "9299e23f-4522-4f96-af5b-c3a967839382",
                                                "sense_id": "412fab07-d9c1-3733-b856-08c36bdc88d9",
                                                "text": "虽然我们不敢说你一定会成功，但是也绝对没有人敢说你一定不会成功！"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90d762b6-37fd-3fe9-a611-d0aa4eb50e93",
                                        "entry_id": "17880b52-af94-3426-bf48-cd7371c5b37d",
                                        "glosses": [
                                            "完成任務"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "316d3e0f-f465-40b2-a455-9d463144521d",
                                                "sense_id": "90d762b6-37fd-3fe9-a611-d0aa4eb50e93",
                                                "text": "東漸于海，西被于流沙，朔南暨聲教訖于四海。禹錫玄圭，告厥成功。",
                                                "translation": "東方進到大海，西方進到大漠，他的名聲和影響遍及四海。禹獻上了玄圭，宣告了任務完成。"
                                            },
                                            {
                                                "example_id": "1d4b65ef-7cd5-4b54-ac8b-1d5e4a86de6b",
                                                "sense_id": "90d762b6-37fd-3fe9-a611-d0aa4eb50e93",
                                                "text": "东渐于海，西被于流沙，朔南暨声教讫于四海。禹锡玄圭，告厥成功。",
                                                "translation": "東方進到大海，西方進到大漠，他的名聲和影響遍及四海。禹獻上了玄圭，宣告了任務完成。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6776fa1c-0c20-3949-a2a8-bfe17e4de9d0",
                                        "entry_id": "17880b52-af94-3426-bf48-cd7371c5b37d",
                                        "glosses": [
                                            "收穫；收割莊稼"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0629f3da-f674-33ff-b3b8-21795f99e25f",
                                        "entry_id": "17880b52-af94-3426-bf48-cd7371c5b37d",
                                        "glosses": [
                                            "允許，准許；答應"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "成功",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "ac248609-e852-39e5-b30d-5160991ad087",
                                        "entry_id": "6753832b-8cbe-3cfb-9aa2-689be9343505",
                                        "glosses": [
                                            "成就功業"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d840fe5-6c01-4126-b88f-15626fd92050",
                                                "sense_id": "ac248609-e852-39e5-b30d-5160991ad087",
                                                "text": "取得成功"
                                            },
                                            {
                                                "example_id": "e9c9a803-00e6-43d1-8810-c25718b0af49",
                                                "sense_id": "ac248609-e852-39e5-b30d-5160991ad087",
                                                "text": "沒有成功，哪來的幸福？"
                                            },
                                            {
                                                "example_id": "f206236a-6d7e-4607-9b4b-7a64598fb156",
                                                "sense_id": "ac248609-e852-39e5-b30d-5160991ad087",
                                                "text": "没有成功，哪来的幸福？"
                                            },
                                            {
                                                "example_id": "d5eba45c-b3ff-425d-a923-cd37e3964bb5",
                                                "sense_id": "ac248609-e852-39e5-b30d-5160991ad087",
                                                "text": "失敗乃成功之母。"
                                            },
                                            {
                                                "example_id": "431e4291-1e13-4827-99b0-b638aeb1c58f",
                                                "sense_id": "ac248609-e852-39e5-b30d-5160991ad087",
                                                "text": "失败乃成功之母。"
                                            },
                                            {
                                                "example_id": "a3ece4ac-f5bb-4ede-8583-3eaa9c32346c",
                                                "sense_id": "ac248609-e852-39e5-b30d-5160991ad087",
                                                "text": "最後，預祝大會獲得圓滿成功！"
                                            },
                                            {
                                                "example_id": "663ddb1e-739e-49de-8f35-f64bb437e3a0",
                                                "sense_id": "ac248609-e852-39e5-b30d-5160991ad087",
                                                "text": "最后，预祝大会获得圆满成功！"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56e25ac6-4b04-3b1a-86db-416e07989137",
                                        "entry_id": "6753832b-8cbe-3cfb-9aa2-689be9343505",
                                        "glosses": [
                                            "成績，功績"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
