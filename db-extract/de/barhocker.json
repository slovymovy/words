                "senses": [
                    {
                        "sense_id": "09f315e4-0fa7-3666-a12c-eab8f6885270",
                        "entry_id": "6af4a581-2896-33a4-acdb-9d663ceed85e",
                        "glosses": [
                            "hoher Hocker, wie man ihn in Lokalen an der Theke (= Bar) oder hohen Tischen findet, meist mit einer Ablage für die Füße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a3dcf9e-a594-4759-acaa-e935bf2dd10c",
                                "sense_id": "09f315e4-0fa7-3666-a12c-eab8f6885270",
                                "text": "Er saß auf einem Barhocker und hatte sich auf die Theke gelehnt."
                            },
                            {
                                "example_id": "39ce0e9c-c3d8-4008-9e7c-75c20e9e0364",
                                "sense_id": "09f315e4-0fa7-3666-a12c-eab8f6885270",
                                "text": "„Wyndham kletterte auf einen Barhocker und wurde dadurch auffallend größer.“"
                            },
                            {
                                "example_id": "a96309f5-f333-41a4-9c62-df8a35dc0eed",
                                "sense_id": "09f315e4-0fa7-3666-a12c-eab8f6885270",
                                "text": "„Bruno rutschte von seinem Barhocker.“"
                            },
                            {
                                "example_id": "c5797e9a-5ec6-4f88-a120-b0eab7a6e7f0",
                                "sense_id": "09f315e4-0fa7-3666-a12c-eab8f6885270",
                                "text": "„Sie setzten sich auf einen Barhocker und bestellten zwei Gin Tonic.“"
                            },
                            {
                                "example_id": "5faddfb3-057f-4e9e-8fcb-43ea3a1cd43b",
                                "sense_id": "09f315e4-0fa7-3666-a12c-eab8f6885270",
                                "text": "„Mit einigem Elan erkletterte sie den Barhocker, faltete knotige Hände, gab die üblichen Litaneien des Alters von sich und hustete mich mit dem rußigen Lachen der Kettenraucher an, während sie Margaritas kippte.“"
                            },
                            {
                                "example_id": "d58c9013-41f0-4fdd-bd67-51c8c560b425",
                                "sense_id": "09f315e4-0fa7-3666-a12c-eab8f6885270",
                                "text": "„Die Faust, die Francesco vom Barhocker holte, gehörte dem leicht verschwitzten, durchtrainierten Kleiderschrank mit Oberarmen, die so dick waren wie Francescos Taille."
                            },
                            {
                                "example_id": "995b9c3e-525d-4507-91c5-e4975c43cb37",
                                "sense_id": "09f315e4-0fa7-3666-a12c-eab8f6885270",
                                "text": "„Janosch sah ihn öfter auf einem Barhocker sitzen und beobachtete neidisch, wie dieser beinahe jede Nacht mit einer anderen schönen Frau im Club auftauchte.“"
                            },
                            {
                                "example_id": "cbd7932c-dfb1-4631-905a-425377d8163d",
                                "sense_id": "09f315e4-0fa7-3666-a12c-eab8f6885270",
                                "text": "„Island ist für diese Art Reisen ein wichtiges Land, viele Männer und Frauen schwärmen von den Isländern, die willenlos betrunken über die Barhocker rutschen und nur darauf warten, mit in billige Hotelzimmer genommen zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d5408fa-2185-4ef4-b00d-bae63bcd4cb2",
                        "source_entry_id": "6af4a581-2896-33a4-acdb-9d663ceed85e",
                        "source_sense_id": "09f315e4-0fa7-3666-a12c-eab8f6885270",
