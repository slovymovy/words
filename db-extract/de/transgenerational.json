                ],
                "senses": [
                    {
                        "sense_id": "992194a0-2857-32a1-a325-7305d00d7dd4",
                        "entry_id": "0224bbb3-ce61-38a3-958a-8c4cad159962",
                        "glosses": [
                            "den Zeitraum einer Generation übersteigend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b07f34f-b50a-4adf-bd45-7eb89ba07c0b",
                                "sense_id": "992194a0-2857-32a1-a325-7305d00d7dd4",
                                "text": "„Ähnliche Modelle der transgenerationalen Weitergabe erkannten Psychologen später bei den Kindern der Vietnam-Krieg-Veteranen und den Kindern von Kriegsflüchtlingen, zum Beispiel aus dem Kosovo.“"
                            },
                            {
                                "example_id": "0003da62-796d-414f-a486-b82c3a6eaff7",
                                "sense_id": "992194a0-2857-32a1-a325-7305d00d7dd4",
                                "text": "Die sogenannte transgenerationale Epigenetik ist erst seit Kurzem wissenschaftlich akzeptiert. Die Epigenetik erklärt, warum beispielsweise Haar- und Muskelzellen völlig verschieden sind, obwohl sie dieselbe DNA besitzen."
                            },
                            {
                                "example_id": "ab027b04-86b4-4062-97e8-989b942ba89a",
                                "sense_id": "992194a0-2857-32a1-a325-7305d00d7dd4",
                                "text": "„In ihrem Ansatz für eine psychohistorische Friedensforschung spielt auch die transgenerationale Traumatisierung eine wesentliche Rolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
