                ],
                "translations": [
                    {
                        "translation_id": "ebff56b9-1737-49d2-94e4-dbe6d44f3874",
                        "source_entry_id": "083bba1b-0278-3218-abf1-4fed921bebe1",
                        "target_lang_word": "counterweight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "counterweight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12a8ae98-5d0b-36a7-a585-eb47b3460c27",
                                        "entry_id": "c436a1bf-3ef1-354e-bd5b-15d196aad1d4",
                                        "glosses": [
                                            "A heavy mass of often iron or concrete, mechanically linked in opposition to a load which is to be raised and lowered, with the intent of reducing the amount of work which must be done to effect the raising and lowering. Counterweights are used, for example, in cable-hauled elevators and some kinds of movable bridges (e.g. a bascule bridge)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba00f575-4d85-4d91-a7b9-cd9ac5f559b1",
                                                "sense_id": "12a8ae98-5d0b-36a7-a585-eb47b3460c27",
                                                "text": "Four 110-ton counterweights, one in each tower, make this feat possible by reducing the effective weight to be lifted to some 25 tons; but an additional 20 tons (a very heavy snow load) can be lifted if necessary."
                                            },
                                            {
                                                "example_id": "3abbd9c8-2824-4d0e-a75c-ae4204d7b87f",
                                                "sense_id": "12a8ae98-5d0b-36a7-a585-eb47b3460c27",
                                                "text": "Like other supertall towers, 432 Park relies on the counterweight system to address the forces of wind and reduce the feeling of swaying for residents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e1b704a-49ab-3b37-bcb7-13aa935ac915",
                                        "entry_id": "c436a1bf-3ef1-354e-bd5b-15d196aad1d4",
                                        "glosses": [
                                            "A counterbalance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0ee6c11-56e8-4ef9-bae6-f4d98ffbf6ed",
                                                "sense_id": "9e1b704a-49ab-3b37-bcb7-13aa935ac915",
                                                "text": "A counterweight to the anti-immigrant fear mongering of the former leader of the right-wing U.K. Independence Party, Nigel Farage, Lexiteers^([sic]) argued a left-wing, democratic and internationalist case for Brexit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "counterweight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8088abb1-9382-3d79-8d3b-d1ebb4558449",
                                        "entry_id": "535e9056-26e6-3472-9f83-1bf108221bd5",
                                        "glosses": [
                                            "To fit with a counterweight."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64f41241-0f7e-4ee0-9059-11c48e419d78",
                                                "sense_id": "8088abb1-9382-3d79-8d3b-d1ebb4558449",
                                                "text": "Everything on the grid – all the backdrops and curtains, anything that has to move up and down from the fly-tower – has to be counterweighted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b45de1bc-1911-474d-8e52-353bb87dab37",
                        "source_entry_id": "083bba1b-0278-3218-abf1-4fed921bebe1",
                        "target_lang_word": "Gegengewicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegengewicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99923402-8e17-3513-bb3b-60a4c7fc262e",
                                        "entry_id": "8b4ad7d5-7302-3fca-84f3-f797f6f0a9c5",
                                        "glosses": [
                                            "das, was auf einer Waagschale auf der anderen Seite zum Gewicht liegt; das, was ausgleicht oder aufhebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "094eb734-4a1e-4efd-befd-313d40ef21c0",
                                                "sense_id": "99923402-8e17-3513-bb3b-60a4c7fc262e",
                                                "text": "Wir hatten so eine alte Waage, links konnte man in eine Schale das Wägegut legen und rechts auf einen Halter das Gegengewicht."
                                            },
                                            {
                                                "example_id": "134904c0-6107-44b1-a8be-0bff7b7b04e5",
                                                "sense_id": "99923402-8e17-3513-bb3b-60a4c7fc262e",
                                                "text": "„Unter Gegengewicht ist hier nicht das beargwöhnte Gleichgewicht zwischen Rivalen gemeint, das mehr als einmal in Krieg geendet hat, sondern vielmehr ein Aushandeln von Interessen unter Nichtrivalen, das Extremismus verhindert.“"
                                            },
                                            {
                                                "example_id": "61ffce94-0263-463a-a047-b574907e9c27",
                                                "sense_id": "99923402-8e17-3513-bb3b-60a4c7fc262e",
                                                "text": "Ihre Äußerungen stellen immer ein erfrischendes Gegengewicht zu all den festgefahrenen Ansichten dar."
                                            },
                                            {
                                                "example_id": "d32c4402-45a2-417f-a399-2e268d231d31",
                                                "sense_id": "99923402-8e17-3513-bb3b-60a4c7fc262e",
                                                "text": "„Äußerer Flitter ist ein ausgezeichnetes Gegengewicht gegen ein so schlechtes Geschenk der Natur.“"
                                            },
                                            {
                                                "example_id": "1ae35b35-4b8f-494f-97ea-fcd3ce46eff4",
                                                "sense_id": "99923402-8e17-3513-bb3b-60a4c7fc262e",
                                                "text": "„Kameradschaft ist das erträumte Gegengewicht im Leben eines Einzelgängers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
