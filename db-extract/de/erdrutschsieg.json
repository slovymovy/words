                        "form": "den Erdrutschsieg"
                    },
                    {
                        "form_id": "626567dd-2a31-4d43-801d-8f46782e525c",
                        "entry_id": "0fab27f0-9114-3012-b023-a932e684a719",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Erdrutschsiege"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c0fd0f4-7bdb-3033-89ec-c52594d0792d",
                        "entry_id": "0fab27f0-9114-3012-b023-a932e684a719",
                        "glosses": [
                            "hoher Wahlsieg einer Partei, der durch eine unvorhergesehene, einschneidende Verschiebung von Wählerstimmen ausgelöst wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac11eea6-6bed-431e-a936-a622ca72728b",
                                "sense_id": "3c0fd0f4-7bdb-3033-89ec-c52594d0792d",
                                "text": "„Bei den Zwischenwahlen zum Kongreß am Dienstag konnten die Republikaner erhebliche Stimmgewinne buchen. Allerdings hatten die Demokraten dank des Erdrutschsieges Johnsons über Goldwater im Jahre 1964 ein so großes Reservoir von Mandaten im Repräsentantenhaus und im Senat, daß ihre Mehrheit nicht gefährdet war.“"
                            },
                            {
                                "example_id": "4bcf646c-27ec-430e-8727-b6a9b298a13a",
                                "sense_id": "3c0fd0f4-7bdb-3033-89ec-c52594d0792d",
                                "text": "„Einen Erdrutschsieg erreichten die antikommunistischen Kandidaten bei den ersten freien Wahlen in Hongkong; sie errangen 16 der 18 zu vergebenden Sitze.“"
                            },
                            {
                                "example_id": "ebf380bb-6888-4b52-b6c9-b9d4eb985c53",
                                "sense_id": "3c0fd0f4-7bdb-3033-89ec-c52594d0792d",
                                "text": "„Fünf der sechs letzten Präsidentschaftswahlen haben die Demokraten verloren. Viermal demütigten die Republikaner Nixon, Reagan und Bush sie gar mit Erdrutschsiegen.“"
                            },
                            {
                                "example_id": "b62618a0-9035-4d8a-a6d9-1c9de3b8d0aa",
                                "sense_id": "3c0fd0f4-7bdb-3033-89ec-c52594d0792d",
                                "text": "„Der Erdrutschsieg, der Labour eine enorme Unterhaus-Mehrheit verschaffte und die Konservativen unter sich begrub, machte einen solch spektakulären Start natürlich erst möglich.“"
                            },
                            {
                                "example_id": "8842d230-670c-4271-a736-ca1f4fd61369",
                                "sense_id": "3c0fd0f4-7bdb-3033-89ec-c52594d0792d",
                                "text": "„Als er am Stammtisch ankam, hatte er bereits alle Zahlen vergessen. Viele Stimmen jedenfalls, sehr viele. Ein Erdrutschsieg!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fac1ec8c-3346-4ccc-a752-e0cf101e61cd",
                        "source_entry_id": "0fab27f0-9114-3012-b023-a932e684a719",
                        "source_sense_id": "3c0fd0f4-7bdb-3033-89ec-c52594d0792d",
                        "source_sense_description": "hoher Wahlsieg einer Partei, bedingt durch eine unerwartete, immense Verschiebung von Wählerstimmen",
                        "target_lang_word": "landslide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "landslide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db886f06-e8ed-3d1f-b159-24d6790ae16f",
                                        "entry_id": "fbe831b1-5c8e-3449-b795-0554da01f247",
                                        "glosses": [
                                            "A natural disaster that involves the breakup and downhill flow of rock, mud, water and anything caught in the path."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e6698e6-5f6d-4fd6-9637-40c71622771f",
                                                "sense_id": "db886f06-e8ed-3d1f-b159-24d6790ae16f",
                                                "text": "Near-synonym: mudflow"
                                            },
                                            {
                                                "example_id": "5be8a3a5-5e10-4b06-93c1-56b30c9e210e",
                                                "sense_id": "db886f06-e8ed-3d1f-b159-24d6790ae16f",
                                                "text": "The landslides Wednesday in Zhejiang province, south of the financial hub of Shanghai, followed Typhoon Megi, which brought heavy rains and high winds to China and Taiwan this past week.[…]\nThe second landslide in Wencheng county killed five people, with one person still missing, an official at the county’s flood control office said Saturday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c87f5e32-ca26-368d-b97b-5144b6868e32",
                                        "entry_id": "fbe831b1-5c8e-3449-b795-0554da01f247",
                                        "glosses": [
                                            "A vote won by a wide or overwhelming majority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0da3486-790d-4a1a-9957-a435f0f7a8cf",
                                                "sense_id": "c87f5e32-ca26-368d-b97b-5144b6868e32",
                                                "text": "The candidate won at 61% to 39%, which most people are calling a landslide."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "landslide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f16dd6ac-3d87-36e5-8bd1-961ef83ad1ec",
                                        "entry_id": "92fca644-dc92-3422-95a2-d0d0e5fa5603",
                                        "glosses": [
                                            "To undergo a landslide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58e7989d-16f4-4589-8060-3de88f142fa0",
                                                "sense_id": "f16dd6ac-3d87-36e5-8bd1-961ef83ad1ec",
                                                "text": "So it landslid mightily, carrying off greens and fairways and all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "826c5e42-afb0-42d7-9d95-8b033abf2ea1",
                        "source_entry_id": "0fab27f0-9114-3012-b023-a932e684a719",
                        "source_sense_id": "3c0fd0f4-7bdb-3033-89ec-c52594d0792d",
