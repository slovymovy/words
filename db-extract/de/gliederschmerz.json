                "senses": [
                    {
                        "sense_id": "de5d9274-8380-328b-873f-36818463ba0f",
                        "entry_id": "76ded40a-aa60-3981-8abb-60f949a7c1e2",
                        "glosses": [
                            "Umstand, dass es in den Extremitäten (Gliedern) wehtut (schmerzt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddc8d155-58f8-4ed7-bdd4-69819ce2c4ca",
                                "sense_id": "de5d9274-8380-328b-873f-36818463ba0f",
                                "text": "„Gliederschmerzen sind ein verbreitetes Symptom – fast jeder, der schon einmal eine starke Erkältung oder eine Grippe hatte, kennt es: Dann schmerzen die Muskeln oder Gelenke der Arme und Beine.“"
                            },
                            {
                                "example_id": "7892f60e-56ad-405c-92a5-a3275241ca07",
                                "sense_id": "de5d9274-8380-328b-873f-36818463ba0f",
                                "text": "„Die Gliederschmerzen lähmten mich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
