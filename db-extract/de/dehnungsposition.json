                ],
                "senses": [
                    {
                        "sense_id": "6235c120-d5ab-3cd3-9591-adb521a17974",
                        "entry_id": "a81d9188-6147-3927-9af2-d6575e9d9cfb",
                        "glosses": [
                            "Körperhaltung, die für eine gewisse Zeit gehalten wird, um eine Dehnungswirkung (auf Muskeln, Faszien oder Gelenke) zu erzielen"
                        ],
                        "tags": [
                            "Fitness"
                        ],
                        "examples": [
                            {
                                "example_id": "dbd828c2-3912-49ad-8c2e-b02886604bf1",
                                "sense_id": "6235c120-d5ab-3cd3-9591-adb521a17974",
                                "text": "„Bis zu neunzehn Dehnungspositionen sollen bei voller Leistungsfähigkeit eingenommen werden können, auch soll der Hüftbeuge-Muskel ohne körperliche Anstrengung auf Vordermann gebracht werden können.“"
                            },
                            {
                                "example_id": "a019e246-8b34-40b3-9fd5-ad9768584e58",
                                "sense_id": "6235c120-d5ab-3cd3-9591-adb521a17974",
                                "text": "„Das ursprüngliche Yoga hatte exakt diese Aufgabe: Durch besondere Dehnungspositionen und Streckungen das gesamte myofasziale Gewebe unter mechanische Zugspannung zu setzen und dadurch die Bindegewebezellen, die Fibroblasten anzuregen, neue geordnete Kollagenfasern zu bilden.“"
                            },
                            {
                                "example_id": "a85d5245-8697-41bf-a95d-54ad188f4c76",
                                "sense_id": "6235c120-d5ab-3cd3-9591-adb521a17974",
                                "text": "„Bei dieser Technik wird eine Muskelgruppe passiv gedehnt, dann isometrisch kontrahiert, während sie in der Dehnungsposition verbleibt, und danach wird die Muskelgruppe wieder passiv in den erhöhten Beugebereich gedehnt.“"
                            },
                            {
                                "example_id": "a5426eec-8d23-4d1b-b025-c622d68a2560",
                                "sense_id": "6235c120-d5ab-3cd3-9591-adb521a17974",
                                "text": "„Die Dehnungspositionen, die wir für 3-5 Minuten einnehmen, wirken auf die tieferliegenden Bindegewebsstrukturen, wie z. b. die Faszien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
