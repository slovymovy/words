                ],
                "senses": [
                    {
                        "sense_id": "f469d4a4-d498-380f-b172-629d9c77bd16",
                        "entry_id": "7c8b8df7-d966-3025-8ebb-c32b68a8d565",
                        "glosses": [
                            "Unternehmen, das ein Mobilfunknetz betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae8c06da-e79e-4168-a6f6-a134dacb1946",
                                "sense_id": "f469d4a4-d498-380f-b172-629d9c77bd16",
                                "text": "„Die ersten Förderungen werden erst 2016 ausgezahlt, betonte Spindelegger nach dem \"runden Tisch\" mit Mobilfunkbetreibern, Gemeindebund und Verkehrsministerin Doris Bures (SPÖ).“"
                            },
                            {
                                "example_id": "eed4ed5f-252b-47a3-9f15-c9025dab00f6",
                                "sense_id": "f469d4a4-d498-380f-b172-629d9c77bd16",
                                "text": "„Österreich hat mit der Vergabe von Handyfrequenzen 2,014 Milliarden Euro in die Staatskasse gespült. An der Auktion nahmen die drei Mobilfunkbetreiber Telekom Austria, T-Mobile und Hutchison teil.“"
                            },
                            {
                                "example_id": "ede1fdf7-872f-4206-880e-6df8c7ebef21",
                                "sense_id": "f469d4a4-d498-380f-b172-629d9c77bd16",
                                "text": "„Die goldenen Zeiten für die Mobilfunkbetreiber, als es immer nur nach oben ging, sind damit lange vorbei.“"
                            },
                            {
                                "example_id": "5fb0903a-4cd2-401e-8b6e-62ab66f539e9",
                                "sense_id": "f469d4a4-d498-380f-b172-629d9c77bd16",
                                "text": "„Neben Telecel Faso, das 450 Sendemasten betreibt, haben sie sich jüngst mit Telmob, dem größten Mobilfunkbetreiber des Landes, auf ein Kooperationsabkommen verständigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
