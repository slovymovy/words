                "senses": [
                    {
                        "sense_id": "e694660f-94ff-3898-af9f-683c496c0d65",
                        "entry_id": "c9cd3b84-ce9a-357c-b9ac-07d6062b4f9e",
                        "glosses": [
                            "Terme lié à un autre de la même langue par une relation d’holonymie, c’est-à-dire de tout à partie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a0d4ff-614f-4549-a976-701057efdbe0",
                                "sense_id": "e694660f-94ff-3898-af9f-683c496c0d65",
                                "text": "Un holonyme A d’un mot B est un mot dont le signifié désigne un ensemble comprenant le signifié de B."
                            },
                            {
                                "example_id": "4c9442fe-f90f-43fd-9a60-3f2da4cd5566",
                                "sense_id": "e694660f-94ff-3898-af9f-683c496c0d65",
                                "text": "Corps est un holonyme de bras, de même que maison est un holonyme de toit."
                            },
                            {
                                "example_id": "e65c7289-7790-4679-942f-64c9f8b818a0",
                                "sense_id": "e694660f-94ff-3898-af9f-683c496c0d65",
                                "text": "Par exemple, doigt est le méronyme de main qui est son holonyme."
                            }
                        ]
                    }
                ],
