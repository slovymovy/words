                                                "sense_id": "21987ba0-021b-32c8-b733-305a7a03b42d",
                                                "text": "Seine Absenz fiel gar nicht auf, da es alle gewohnt waren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f6c21ea9-1545-3810-a80a-1d267f83452b",
                                        "entry_id": "88724a09-44e4-387c-8ca3-4d92e44e52cf",
                                        "glosses": [
