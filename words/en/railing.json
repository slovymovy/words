{
    "word_family": [
        "rail"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8135ba64-c721-3039-ba56-71f8b392d635",
                    "sense_definition": "A barrier or fence formed of one or more horizontal rails and upright posts.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "barrier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She held tightly to the metal <w>railing</w> as she walked down the icy steps.",
                            "target_lang_translations": {
                                "ru": "Она крепко держалась за металлические <w>перила</w>, спускаясь по обледенелым ступенькам."
                            }
                        },
                        {
                            "text": "The park was enclosed by a decorative iron <w>railing</w> that kept dogs off the grass.",
                            "target_lang_translations": {
                                "ru": "Парк был обнесён декоративной железной <w>оградой</w>, которая не давала собакам бегать по газону."
                            }
                        }
                    ],
                    "synonyms": [
                        "balustrade",
                        "handrail",
                        "fence",
                        "barrier"
                    ],
                    "common_phrases": [
                        "iron railing",
                        "balcony railing",
                        "stair railing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограждение или забор, состоящий из горизонтальных перекладин и вертикальных стоек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перила",
                                "target_lang_sense_clarification": "ограждение лестницы, балкона или моста"
                            },
                            {
                                "target_lang_word": "ограждение",
                                "target_lang_sense_clarification": "защитная конструкция, невысокий забор"
                            },
                            {
                                "target_lang_word": "поручень",
                                "target_lang_sense_clarification": "опора для руки вдоль лестницы или ограды"
                            },
                            {
                                "target_lang_word": "решётка",
                                "target_lang_sense_clarification": "металлическое окаймление или заборчик"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e112626c-bff4-3b0b-8842-17e44eac2abb",
                    "sense_definition": "present participle and gerund of <w>rail</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "complain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker spent the entire afternoon <w>railing</w> against the new government policy.",
                            "target_lang_translations": {
                                "ru": "Оратор провёл весь день, <w>яростно критикуя</w> новую политику правительства."
                            }
                        },
                        {
                            "text": "Instead of <w>railing</w> at his bad luck, he decided to look for a practical solution.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы <w>сетовать</w> на невезение, он решил заняться поиском практического решения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "railing against",
                        "railing at"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола rail (браниться, гневно жаловаться)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бранящийся",
                                "target_lang_sense_clarification": "выражающий резкое негодование"
                            },
                            {
                                "target_lang_word": "поносящий",
                                "target_lang_sense_clarification": "яростно критикующий"
                            },
                            {
                                "target_lang_word": "кляня",
                                "target_lang_sense_clarification": "деепричастие; осыпая упрёками"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e30078de-caa4-3c27-9ae2-44c5cfd2d06a",
                    "sense_definition": "Full of bitter invective, harsh scolding, or violent complaints.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "complain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician delivered a <w>railing</w> speech condemning all of his political rivals.",
                            "target_lang_translations": {
                                "ru": "Политик выступил с <w>полной брани</w> речью, осудив всех своих политических оппонентов."
                            }
                        },
                        {
                            "text": "He replied to the criticism with a series of angry, <w>railing</w> remarks.",
                            "target_lang_translations": {
                                "ru": "На критику он ответил чередой гневных, <w>оскорбительных</w> замечаний."
                            }
                        }
                    ],
                    "synonyms": [
                        "abusive",
                        "vituperative",
                        "invective"
                    ],
                    "antonyms": [
                        "praising",
                        "complimentary"
                    ],
                    "common_phrases": [
                        "railing words",
                        "railing speech"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary or dated usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный резкой брани, язвительных обвинений или яростных упрёков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бранный",
                                "target_lang_sense_clarification": "содержащий грубые упрёки и нападки"
                            },
                            {
                                "target_lang_word": "язвительный",
                                "target_lang_sense_clarification": "оскорбительный, едкий"
                            },
                            {
                                "target_lang_word": "ругательный",
                                "target_lang_sense_clarification": "наполненный оскорблениями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e97847c1-7ebd-32b4-8267-e96129d151fd",
                    "sense_definition": "Given to or engaged in vehement scolding or violent complaining.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "complain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>railing</w> crowd refused to listen to the mayor's calm explanations.",
                            "target_lang_translations": {
                                "ru": "<w>Бушующая</w> толпа отказалась слушать спокойные объяснения мэра."
                            }
                        },
                        {
                            "text": "She grew tired of her <w>railing</w> neighbor who constantly shouted about petty grievances.",
                            "target_lang_translations": {
                                "ru": "Ей надоел <w>сварливый</w> сосед, вечно кричавший из-за пустяковых обид."
                            }
                        }
                    ],
                    "synonyms": [
                        "scolding",
                        "clamorous"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary or dated usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный к ожесточённой брани или бурно выражающий недовольство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бранящийся",
                                "target_lang_sense_clarification": "громко ругающийся"
                            },
                            {
                                "target_lang_word": "сварливый",
                                "target_lang_sense_clarification": "склонный постоянно спорить и выражать претензии"
                            },
                            {
                                "target_lang_word": "бранчливый",
                                "target_lang_sense_clarification": "любящий браниться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11f4ebff-24e3-3d5d-b898-11f24c39ee4a",
                    "sense_definition": "Blowing fiercely or violently, like a storm or tempest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stormy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers took shelter inside the stone cottage from the <w>railing</w> wind.",
                            "target_lang_translations": {
                                "ru": "Путники укрылись в каменном коттедже от <w>бушующего</w> ветра."
                            }
                        },
                        {
                            "text": "A <w>railing</w> storm battered the coastal village throughout the night.",
                            "target_lang_translations": {
                                "ru": "<w>Свирепый</w> шторм терзал прибрежную деревню всю ночь напролёт."
                            }
                        }
                    ],
                    "synonyms": [
                        "raging",
                        "howling",
                        "blustering"
                    ],
                    "antonyms": [
                        "calm",
                        "gentle"
                    ],
                    "common_phrases": [
                        "railing wind",
                        "railing storm"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "poetic or dated usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бушующий, свирепый или неистово дующий (о ветре, буре)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бушующий",
                                "target_lang_sense_clarification": "о ветре или шторме"
                            },
                            {
                                "target_lang_word": "свирепый",
                                "target_lang_sense_clarification": "яростный, бурный"
                            },
                            {
                                "target_lang_word": "неистовый",
                                "target_lang_sense_clarification": "чрезвычайно сильный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}