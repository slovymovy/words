                    "sense_definition": "żeńskie imię",
                    "learner_level": "A1",
                    "frequency": "Middle",
                    "semantic_group_id": "imiona",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Jagoda</w> poszła dzisiaj do szkoły.",
                            "target_lang_translations": {
                                "ru": "<w>Ягода</w> пошла сегодня в школу."
                            }
                        },
                        {
                            "text": "Moja koleżanka ma na imię <w>Jagoda</w>.",
                            "target_lang_translations": {
                                "ru": "Мою подругу зовут <w>Ягода</w>."
                            }
