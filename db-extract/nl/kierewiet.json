                                                "sense_id": "18e5c197-3199-3eac-96d9-f200988400a4",
                                                "text": "The elderly patients in the hospital were going gaga."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d81b6279-bbea-36ec-a5e5-2bd39d638b0a",
                                        "entry_id": "24ec2435-032c-3733-82eb-a5198f502ae0",
                                        "glosses": [
                                            "Crazy."
