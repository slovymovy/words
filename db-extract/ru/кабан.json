                                            {
                                                "example_id": "378e0be6-8279-4d2a-bc12-b6238d75c603",
                                                "sense_id": "4ad7581d-d394-34bb-b5e3-1493af255ad2",
                                                "text": "Plötzlich brach ein Eber aus dem Unterholz hervor."
                                            },
                                            {
                                                "example_id": "f1be44f3-9ca8-48e3-856d-6aace69570e4",
                                                "sense_id": "4ad7581d-d394-34bb-b5e3-1493af255ad2",
