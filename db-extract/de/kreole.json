                    {
                        "sense_id": "2e1552f1-e34c-34ac-98b1-587e1f0d41d5",
                        "entry_id": "417b72d2-8149-3eee-899c-aecc1686e5f9",
                        "glosses": [
                            "Nachkomme der aus den romanischen Ländern stammenden Einwanderer/Eroberer in Mittel- und Südamerika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fc9d612-ada8-429c-a6bc-4ebfb0f76271",
                                "sense_id": "2e1552f1-e34c-34ac-98b1-587e1f0d41d5",
                                "text": "„Bolivar war ein charismatischer Anführer, der zur weißen Oberschicht, den Kreolen, genauso sprechen konnte wie zu seinen Soldaten.“"
                            },
                            {
                                "example_id": "f88e93e9-aeb0-49b7-9c11-18a29165a91b",
                                "sense_id": "2e1552f1-e34c-34ac-98b1-587e1f0d41d5",
                                "text": "„Der Ire war in seiner Anrede an den Kreolen natürlich im parlez-vous français steckengeblieben und hatte auf sein weiteres im rauhen irischen Dialekte vorgebrachtes Kauderwelsch ein »je n'entends pas« zur Antwort erhalten.“"
                            }
                        ],
