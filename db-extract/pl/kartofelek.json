                        ],
                        "examples": [
                            {
                                "example_id": "473faf7b-f18c-4093-b893-7f40b0614ae9",
                                "sense_id": "8f5334dc-3c51-39d0-b7b7-e9efb8b150b1",
                                "text": "Mama poszła do kuchenki • Przynieść befsztyk, kartofelki"
                            },
                            {
                                "example_id": "f66ff95c-331a-401a-ac32-2dbd1043e77d",
                                "sense_id": "8f5334dc-3c51-39d0-b7b7-e9efb8b150b1",
                                "text": "Raz wróbelek Elemelek znalazł w polu kartofelek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "790c517b-9e92-3d8a-88d8-51b3347e83d4",
                        "entry_id": "2bbe41dd-d267-35aa-9eb9-114b8b54217b",
                        "glosses": [
                            "mały kartofel"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "22bcbf11-dea4-39a0-b28e-ffbf232ec27a",
                        "entry_id": "2bbe41dd-d267-35aa-9eb9-114b8b54217b",
                        "glosses": [
                            "ciastko w kształcie kulki, wykonanym z masy z kruszonych herbatników, resztek ciast, z dodatkiem kakao, najczęściej polanym polewą czekoladową, posypanym orzeszkami ziemnymi lub wiórkami kokosowymi; także z marcepanu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e768d66-7a3a-4964-a4eb-51232f944f70",
                                "sense_id": "22bcbf11-dea4-39a0-b28e-ffbf232ec27a",
                                "text": "Byłam w cukierni i kupiłam trzy pączki i pół kilo kartofelków."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6662c1eb-d743-4c1f-8a18-f3d0464a6cb9",
                        "source_entry_id": "2bbe41dd-d267-35aa-9eb9-114b8b54217b",
                        "source_sense_id": "22bcbf11-dea4-39a0-b28e-ffbf232ec27a",
                        "target_lang_word": "rum ball",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rum ball",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11dc9c34-8b3d-3edd-b5df-54f3f5183a41",
                                        "entry_id": "74681608-9cb6-3fa5-9450-27096c2eecf5",
                                        "glosses": [
                                            "A round sweet made of dense cake or biscuit flavoured with chocolate and rum."
                                        ],
                                        "tags": [],
