        "fr-extract.jsonl": [
            {
                "entry_id": "0fa919a2-e044-3ca8-a0ae-ce93e6292238",
                "word": "whaling",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9d2823cc-f1e6-41d8-86e2-66508bc4ae69",
                        "entry_id": "0fa919a2-e044-3ca8-a0ae-ce93e6292238",
                        "tags": [
                            "plural"
                        ],
                        "form": "whalings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1770e9c9-22e8-3d27-83d0-694905a58464",
                        "entry_id": "0fa919a2-e044-3ca8-a0ae-ce93e6292238",
                        "glosses": [
                            "Chasse à la baleine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0329535-a3d4-4cc6-905d-73b7b85d4d7b",
                                "sense_id": "1770e9c9-22e8-3d27-83d0-694905a58464",
                                "text": "The IWC recognises three different types of whaling. The first of these is aboriginal subsistence whaling to support the needs of indigenous communities. This is regulated by the IWC which sets catch limits every six years.",
                                "translation": "La CBI reconnait trois différents types de chasses à la baleine. Le premier est la chasse pour la survie aborigène, pour répondre aux besoins des communautés indigènes. Elle est régulée par la CBI qui définit les quotas de pêche tous les six ans."
                            },
                            {
                                "example_id": "7c0674c5-2f3e-4f34-9f6e-2c0a97e5d525",
                                "sense_id": "1770e9c9-22e8-3d27-83d0-694905a58464",
                                "text": "Its last commercial hunt was in 1986, but Japan has never really stopped whaling - it has been conducting instead what it says are research missions which catch hundreds of whales annually.",
                                "translation": "Sa dernière chasse commerciale remonte à 1986 mais le Japon n’a jamais vraiment mis fin à la chasse à la baleine ; le pays a à la place poursuivi ce qu’il appelle des missions de recherche, qui attrapent des centaines de baleines chaque année."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1e15513-082a-38af-96b1-20da7aec298f",
                        "entry_id": "0fa919a2-e044-3ca8-a0ae-ce93e6292238",
                        "glosses": [
                            "Harponnage, sorte de phishing ciblant les cadres supérieurs d’une entreprise dans le but de récupérer des informations sur cette dernière."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "b13a9a46-2d47-4bed-8c29-034f5c9c17f6",
                                "sense_id": "e1e15513-082a-38af-96b1-20da7aec298f",
                                "text": "Whaling attacks are a form of social engineering that targets \"whales\", or business owners and C-level employees (CEO, CFO, etc.), through the use of various phishing techniques.",
                                "translation": "Les attaques de whaling sont une forme d’ingénierie sociale qui vise les « baleines », c’est-à-dire les chef·fes d’entreprise et les dirigeant·es (p.-d.g., DAF, etc.), par l’utilisation de diverses techniques de hameçonnage."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
