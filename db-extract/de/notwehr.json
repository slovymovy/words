                    {
                        "translation_id": "619c676c-224d-4960-b961-5c30921bb23b",
                        "source_entry_id": "9a9c802d-296e-31fa-8600-c7b4db3652e0",
                        "source_sense_id": "5ed8662c-f73d-368b-96e9-67bacf4c15a5",
                        "source_sense_description": "Recht: Verteidigung in Form von Gegenwehr, die aufgrund einer dazu führenden Bedrohung straffrei bleibt",
                        "target_lang_word": "autodéfense",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autodéfense",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f20a4dcc-9eb4-35b5-8e21-7aca68e96aa7",
                                        "entry_id": "862988af-ac65-38ab-95f3-ff2006bf0d27",
                                        "glosses": [
                                            "Défense personnelle, défense faite par soi-même contre une agression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d96d40e1-147c-44cc-b8da-2c9ace046f9f",
                                                "sense_id": "f20a4dcc-9eb4-35b5-8e21-7aca68e96aa7",
                                                "text": "Dans les villages, les mechtas, des volontaires issus de toutes les couches sociales, s'organisaient eux-même en groupe d’autodéfense pour repousser les attaques des tueurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e53b94f-e75f-3eab-9556-8dc66e4cdb9d",
                                        "entry_id": "862988af-ac65-38ab-95f3-ff2006bf0d27",
                                        "glosses": [
                                            "Légitime défense, autorisation légale et immédiate de se défendre, y compris en employant des moyens qui seraient interdits en d’autres circonstances."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7d2ed6b-0007-4fd8-8c2b-e822167df5d7",
                                                "sense_id": "7e53b94f-e75f-3eab-9556-8dc66e4cdb9d",
                                                "text": "Ils diraient que, même quand une arme ne sert pas à attaquer quelqu’un, c’est un instrument d’autodéfense, qui ne sert donc que l’intérêt personnel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64a9130e-7051-42ad-9fb2-890f4ec66636",
                        "source_entry_id": "9a9c802d-296e-31fa-8600-c7b4db3652e0",
                        "source_sense_id": "5ed8662c-f73d-368b-96e9-67bacf4c15a5",
                        "source_sense_description": "Recht: Verteidigung in Form von Gegenwehr, die aufgrund einer dazu führenden Bedrohung straffrei bleibt",
                        "target_lang_word": "légitime défense",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "légitime défense",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a26432ff-6450-3ef3-8e1c-3e4ed297ee3c",
                                        "entry_id": "138ca948-1951-3e8b-a82f-6b1339521356",
                                        "glosses": [
                                            "Acte accompli pour défendre sa vie par quelqu’un qui est attaqué, attiré dans un piège."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddb03e55-77a4-4501-b637-07c61187579f",
                                                "sense_id": "a26432ff-6450-3ef3-8e1c-3e4ed297ee3c",
                                                "text": "Son avocat a soutenu à bon droit le cas de légitime défense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "793a7ff0-ddf9-3402-b581-82c4b9b769dc",
                                        "entry_id": "138ca948-1951-3e8b-a82f-6b1339521356",
                                        "glosses": [
                                            "Droit qui appartient à chacun de repousser des calomnies, insinuations, accusations mensongères."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92ae01e3-e1a9-4aed-aeda-805aa504490f",
                                                "sense_id": "793a7ff0-ddf9-3402-b581-82c4b9b769dc",
                                                "text": "Depuis les années 1980, les homicides où l’excuse de la légitime défense est invoquée sont décorrectionalisés et sont jugés en tribunal d’assises ; cette modification de juridiction se traduit par une explosion des acquittements au titre de la légitime défense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "778169ff-146e-35e7-9600-d1238b95c1cf",
                                        "entry_id": "138ca948-1951-3e8b-a82f-6b1339521356",
                                        "glosses": [
                                            "Capacité d'un État à se défendre lorsqu’il fait l'objet d'une attaque de la part d'une puissance étrangère."
                                        ],
                                        "tags": [
                                            "Relations internationales"
                                        ],
                                        "note": "bien que l'article 2(4) de la Charte des Nations unies a interdit la « guerre », la légitime défense a été préservée, autorisant un État ou à un groupe d’États à prendre les mesures nécessaires, dont des mesures militaires, afin de rétablir le statu quo ante en cas d'attaque illégale",
                                        "examples": [
                                            {
                                                "example_id": "25d03af0-ab93-4aa2-951f-72118265a179",
                                                "sense_id": "778169ff-146e-35e7-9600-d1238b95c1cf",
                                                "text": "… lorsque des troupes internationales sont déployées sans pour autant soutenir l'un des camps opposés, la détermination de leur statut se fera selon les critères habituellement retenus pour évaluer l'existence d'un conflit armé non international. Ces troupes doivent être considérées comme une partie au conflit si leur niveau d'implication atteint le niveau d'intensité requis. Tel n'est pas le cas si le recours à la force se limite au cadre de la légitime défense."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
