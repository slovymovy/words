                "senses": [
                    {
                        "sense_id": "89fe4508-e17a-37f8-b2c3-b27d42594078",
                        "entry_id": "2d59f19d-fe78-3bf0-8f82-0d29d4b213bd",
                        "glosses": [
                            "Ancienne orthographe de désagréger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ae63cbd-194e-4934-9ac9-c1a21e1693b3",
                                "sense_id": "89fe4508-e17a-37f8-b2c3-b27d42594078",
                                "text": "Cette dernière coule plus épaisse, a un toucher graveleux, puis elle se pelotonne et s’agglomère dans l’eau froide et est facile à désaggréger et à émietter."
                            },
                            {
                                "example_id": "ad46b6f5-ab83-4c70-a6e6-0a85e8c79687",
                                "sense_id": "89fe4508-e17a-37f8-b2c3-b27d42594078",
                                "text": "L’érosion de cette lave est si grande que ses élémens, quoiqu’ils conservent leurs formes, sont tout près de se désaggréger, et de céder à la moindre pression."
                            }
                        ]
                    }
                ],
