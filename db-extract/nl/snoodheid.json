                "senses": [
                    {
                        "sense_id": "a94e0b81-aab1-3b0f-910b-56b31ebefa9b",
                        "entry_id": "f7b0109d-9b4f-37b4-b275-435487f2a3bc",
                        "glosses": [
                            "slechtheid, boosaardigheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8664b596-95c2-416a-a226-68c9dcd96aa2",
                                "sense_id": "a94e0b81-aab1-3b0f-910b-56b31ebefa9b",
                                "text": "Ze is nog steeds één van de meest iconische filmschurken ooit: Maleficent, de boze fee die in de klassieker Doornroosje uit 1959 de titelprinses wilde doden. Maar ook achter snoodheid zit een verhaal. Hoe deze dame zo hardvochtig werd, wordt nu verteld in het nieuwe Disney-avontuur Maleficent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f670778-57de-4702-a02e-5fddb28f4b1b",
                        "source_entry_id": "f7b0109d-9b4f-37b4-b275-435487f2a3bc",
                        "source_sense_id": "a94e0b81-aab1-3b0f-910b-56b31ebefa9b",
                        "source_sense_description": "slechtheid, boosaardigheid",
                        "target_lang_word": "meanness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meanness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f14b494-17a9-3162-a44d-cff056411adf",
                                        "entry_id": "1e3dc032-1779-33ef-b54e-2836e0faae4f",
                                        "glosses": [
                                            "The condition, or quality, of being mean (any of its definitions)"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d38fe5c9-0784-40d8-a2b3-739c0ee7c6e6",
                                                "sense_id": "3f14b494-17a9-3162-a44d-cff056411adf",
                                                "text": "This figure is of a later date, by the meanness of the workmanship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19733eb7-c502-3a0a-898b-f8853ca8cad7",
                                        "entry_id": "1e3dc032-1779-33ef-b54e-2836e0faae4f",
                                        "glosses": [
                                            "A mean act."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebbcd0a9-bf80-41f2-b9f2-5402df66b755",
                                                "sense_id": "19733eb7-c502-3a0a-898b-f8853ca8cad7",
                                                "text": "There are enough meannesses in everyone — ourselves included — to make for us a contemptible world, if we select the meannesses and let our minds dwell upon them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da285fb3-d9b0-451c-9e7b-24fc6aa294be",
                        "source_entry_id": "f7b0109d-9b4f-37b4-b275-435487f2a3bc",
                        "source_sense_id": "a94e0b81-aab1-3b0f-910b-56b31ebefa9b",
                        "source_sense_description": "slechtheid, boosaardigheid",
                        "target_lang_word": "wickedness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wickedness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a4a6669-c8be-3cd3-93bc-9ba192c52862",
                                        "entry_id": "66bc7051-0eeb-331b-ba5b-f3dab364664c",
                                        "glosses": [
                                            "The state of being wicked; evil disposition; immorality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa9c1ac6-ffd8-4c99-af75-3c0d493da64f",
                                                "sense_id": "3a4a6669-c8be-3cd3-93bc-9ba192c52862",
                                                "text": "So, if a Sonne that is by his Father ſent about Merchandize, doe ſinfully miſcarry vpon the Sea; the imputation of his vvickedneſſe, by your rule, ſhould be impoſed vpon his Father that ſent him: […]"
                                            },
                                            {
                                                "example_id": "15ced96c-b2de-4d03-82b6-f2460e267482",
                                                "sense_id": "3a4a6669-c8be-3cd3-93bc-9ba192c52862",
                                                "text": "We speak of wickedness as something in the soul different from virtue."
                                            },
                                            {
                                                "example_id": "1d4fcd5a-6fe4-4bca-8543-48fb83c2604a",
                                                "sense_id": "3a4a6669-c8be-3cd3-93bc-9ba192c52862",
                                                "text": "Derived from the Latin words \"scelero\" — which means crime or wickedness — and \"phobos\" meaning fear — scelerophobia is coined by both criminologists and psychologists as the fear of burglars, according to Ayla Faisal, a clinical psychologist and a PhD scholar at the Institute of Clinical Psychology at the University of Karachi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e161ca7-5f2d-3b43-aae6-2b4deb3ce5c6",
                                        "entry_id": "66bc7051-0eeb-331b-ba5b-f3dab364664c",
                                        "glosses": [
                                            "A wicked or sinful thing or act; morally bad or objectionable behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a981961-4474-470e-9501-167ec5a41abf",
                        "source_entry_id": "f7b0109d-9b4f-37b4-b275-435487f2a3bc",
                        "source_sense_id": "a94e0b81-aab1-3b0f-910b-56b31ebefa9b",
