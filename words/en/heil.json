                    "sense_id": "bde658fd-00ee-3dff-919c-9f87f9d72d77",
                    "sense_definition": "A Nazi salute, typically accompanied by the chant \"Sieg Heil\" or \"Heil Hitler\".",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "salute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd responded to the leader's speech with loud <w>heils</w> and raised arms.",
                            "target_lang_translations": {
                                "ru": "Толпа ответила на речь вождя громкими <w>возгласами «хайль»</w> и поднятыми руками."
                            }
                        },
                        {
                            "text": "Old documentary footage showed soldiers chanting frantic <w>heils</w> during the rally.",
                            "target_lang_translations": {
                                "ru": "Старые кадры документальной хроники показывали солдат, неистово скандировавших <w>«хайль»</w> во время митинга."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Nazi heils"
                    ],
                    "target_lang_definitions": {
                        "ru": "нацистское приветствие или возглас «хайль»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хайль",
                                "target_lang_sense_clarification": "возглас нацистского приветствия"
                            },
                            {
                                "target_lang_word": "нацистское приветствие",
                                "target_lang_sense_clarification": "жест или жест с возгласом"
                            },
                            {
                                "target_lang_word": "зига",
                                "target_lang_sense_clarification": "сленг, нацистский жест рукой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a9ea136-5a0e-35c4-988a-fe43352a11dc",
                    "sense_definition": "To salute someone using the Nazi salute or greeting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "salute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guards stood stiffly and <w>heiled</w> as the commanding officer walked past.",
                            "target_lang_translations": {
                                "ru": "Охранники замерли по стойке смирно и <w>вскинули руку в нацистском приветствии</w>, когда командир проходил мимо."
                            }
                        },
                        {
                            "text": "He refused to <w>heil</w> when ordered to show obedience to the regime.",
                            "target_lang_translations": {
                                "ru": "Он отказался <w>зиговать</w>, когда ему приказали продемонстрировать покорность режиму."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "отдавать нацистское приветствие, вскидывать руку со словами «хайль»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зиговать",
