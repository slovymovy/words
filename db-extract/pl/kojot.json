                "senses": [
                    {
                        "sense_id": "f91bd4c4-5b9c-3655-b8a5-d482bb8a1562",
                        "entry_id": "895eae32-afbe-36c9-b8d4-27b3ad3cec51",
                        "glosses": [
                            "Canis latrans, preriowy drapieżnik przypominający wilka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7229c01-7800-4f3e-a972-6b3623551e83",
                                "sense_id": "f91bd4c4-5b9c-3655-b8a5-d482bb8a1562",
                                "text": "Tam, gdzie dawniej górnicy śpiewywali wieczorami: „I crossed Mississippi”, obecnie śpiewają kojoty."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f792a32-322e-4416-a0a2-e20f739bba18",
                        "source_entry_id": "895eae32-afbe-36c9-b8d4-27b3ad3cec51",
                        "source_sense_id": "f91bd4c4-5b9c-3655-b8a5-d482bb8a1562",
                        "target_lang_word": "coyote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coyote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05c73a2f-3224-3be7-92b5-107330767c74",
                                        "entry_id": "677a51e4-137e-300a-a881-c89a16ac57fb",
                                        "glosses": [
                                            "Canis latrans, a species of canine native to North America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0306a730-cbc0-40ce-9aeb-d4f3d80dabf3",
                                                "sense_id": "05c73a2f-3224-3be7-92b5-107330767c74",
                                                "text": "Near Rio Frio we shot several handsome birds, and saw a cayjotte, or wild dog, which in size nearly approached the wolf."
                                            },
                                            {
                                                "example_id": "b3f3736e-ff61-403f-8832-a8e2eb8740bf",
                                                "sense_id": "05c73a2f-3224-3be7-92b5-107330767c74",
                                                "text": "The MWRC animal care specialists attempted to unimprint the coyotes first by limiting their human contact and putting them with other wild coyotes. The hand-raised coyotes, however, were ostracized by the wild coyotes […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16c4a191-28e6-3b31-822a-fb26017bcadb",
                                        "entry_id": "677a51e4-137e-300a-a881-c89a16ac57fb",
                                        "glosses": [
                                            "A smuggler of undocumented immigrants across the land border from Latin America into the United States of America."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a6a531e-b1a0-4b83-a8fb-6fbccd482a1a",
                                                "sense_id": "16c4a191-28e6-3b31-822a-fb26017bcadb",
                                                "text": "Jorge’s father had pawned his last four goats for $2,000 to help pay for their transit, another loan the family would have to repay at 100 percent interest. The coyote called at 10 p.m. — they would go that night."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coyote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dba2f8a-fbb7-3258-b076-8fa8805819d7",
                                        "entry_id": "754d757c-964a-31a4-b502-949bb3db5092",
                                        "glosses": [
                                            "To prospect for gold by manually digging holes into overlying earth, as into a hillside."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "724644c4-8ab6-4d23-a742-26effdb524d0",
                        "source_entry_id": "895eae32-afbe-36c9-b8d4-27b3ad3cec51",
