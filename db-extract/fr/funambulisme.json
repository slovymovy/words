                    }
                ],
                "senses": [
                    {
                        "sense_id": "64059ce3-94cd-3a6d-89e3-184784910a4b",
                        "entry_id": "f855a076-de66-3464-a427-44f14087364c",
                        "glosses": [
                            "Art du cirque, danseurs et acrobates marchant sur une corde tendue et pouvant s’aider d’un balancier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "528de47e-c93a-4803-ac1b-3ffb5694e6fb",
                                "sense_id": "64059ce3-94cd-3a6d-89e3-184784910a4b",
                                "text": "Marceau voulait apprendre l’art du funambulisme, et seul le meilleur funambule pouvait convenir au meilleur mime."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45dc3481-1866-4572-af5e-05918bf7349b",
                        "source_entry_id": "f855a076-de66-3464-a427-44f14087364c",
                        "source_sense_id": "64059ce3-94cd-3a6d-89e3-184784910a4b",
                        "target_lang_word": "tightrope walking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tightrope walking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7827de2-b0c1-3480-8c95-0764514fc825",
                                        "entry_id": "c84ad640-684f-396d-9b33-b6ba5d69b5a4",
                                        "glosses": [
                                            "The acrobatic feat of walking on a tightrope."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e4fc500-90a2-47d7-8710-0365a9ea226b",
                                                "sense_id": "b7827de2-b0c1-3480-8c95-0764514fc825",
                                                "text": "Most of the novelties, including the aerial jumpings and the tightrope walkings, had been tapering off in preparation for this exciting final event."
                                            },
                                            {
                                                "example_id": "205d30f3-b44a-42f2-8b52-5e8c4d378c69",
                                                "sense_id": "b7827de2-b0c1-3480-8c95-0764514fc825",
                                                "text": "The extant verses deal with the usual subject of love, cup-bearers, songs, dances, music; there is no shortage of tightrope walkings, virtuosity and artificiality typical of Arab poetry."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tightrope walking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5f6e5f8-0e27-3297-8c1a-c767bc1505ab",
                                        "entry_id": "5c349d12-d3af-385a-9c05-b2fbc8fd69df",
                                        "glosses": [
                                            "present participle and gerund of tightrope walk"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51cd8639-092a-49a1-ac50-a2e92c7b2383",
                                                "sense_id": "e5f6e5f8-0e27-3297-8c1a-c767bc1505ab",
                                                "text": "Mary Ann could witness the intricacies, the pitfalls, and the tightrope walkings of marriage, and even handle them, but not Michael."
                                            },
                                            {
                                                "example_id": "3884509d-f290-4562-bc98-04baad57ca93",
                                                "sense_id": "e5f6e5f8-0e27-3297-8c1a-c767bc1505ab",
                                                "text": "Each show targets some facet of adult life that richly deserves to be questioned, such as sport hunting with assault weapons. Those are hot-button topics for adults, and the show’s writing is a miracle of tightrope walking in its handling of them."
                                            },
                                            {
                                                "example_id": "ce9510a6-0ad5-4397-a55c-3b5f9da16043",
                                                "sense_id": "e5f6e5f8-0e27-3297-8c1a-c767bc1505ab",
                                                "text": "I have failed to find a single article in your newspaper about the \"tightrope walking\" that the Swiss were forced to perform between the Allies and the Nazis in order to survive as a country and avoid invasion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
