                        "entry_id": "b70fecbc-fa57-3be9-a161-e4c87baa12f2",
                        "glosses": [
                            "A youth charged by Ares to stand guard outside his door while the god indulged in illicit love with Aphrodite. He fell asleep and was transformed into a rooster as punishment."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "5a563b06-4889-4120-a200-c9878da639dd",
                                "sense_id": "620f970e-1b7a-36a1-86ee-f5662b100305",
                                "text": "And there he lingered till the crowing cock, / The Alectryon of the farmyard and the flock, / Sang his aubade with lusty voice and clear, / To tell the sleeping world that dawn was near."
                            }
                        ]
                    }
                ],
