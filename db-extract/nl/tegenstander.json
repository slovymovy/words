                        ],
                        "form": "tegenstandertjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f0f9c41-0aa6-32f9-bfa6-8193a28bdbad",
                        "entry_id": "2d5c2aee-9f7c-32fe-bd5a-e4e64a70f684",
                        "glosses": [
                            "vijand, rivaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "437f5789-f2f1-4afa-a81e-24d61fbc690b",
                                "sense_id": "1f0f9c41-0aa6-32f9-bfa6-8193a28bdbad",
                                "text": "Prominente islamitische geleerden hebben uitgesproken dat een beroemde middeleeuwse fatwa waarin de heilige oorlog wordt gepropageerd, in de moderne wereld niet meer kan worden gebruikt om het doden van tegenstanders te rechtvaardigen"
                            },
                            {
                                "example_id": "191c2d8a-bcd8-454c-8b7c-6a9c9ec9505e",
                                "sense_id": "1f0f9c41-0aa6-32f9-bfa6-8193a28bdbad",
                                "text": "Het gaat in deze zaak om een vestiging van het bedrijf Zapp, waarvan er meerdere in de stad zitten. Darkstores zijn omstreden omdat ze vaak overlast veroorzaken en met hun afgeplakte ramen volgens tegenstanders ook esthetisch geen vooruitgang betekenen."
                            },
                            {
                                "example_id": "c9c497c3-93aa-496e-84d0-de44ca7d3a85",
                                "sense_id": "1f0f9c41-0aa6-32f9-bfa6-8193a28bdbad",
                                "text": "Want de arbeidersmeerderheid had het probleem dat ze geen opgeleide mensen hadden voor alle bureaucratische en politieke posten. Dus moesten ze hun tegenstander om hulp vragen. En sindsdien werken ze in alle rust samen."
                            }
                        ]
                    },
                    {
                        "sense_id": "addfa9f8-d30c-3e71-ad9c-78b968a1100b",
                        "entry_id": "2d5c2aee-9f7c-32fe-bd5a-e4e64a70f684",
                        "glosses": [
                            "bestrijder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7a5a52c-ddba-4184-87fb-e8c7714d72a7",
                                "sense_id": "addfa9f8-d30c-3e71-ad9c-78b968a1100b",
                                "text": "Nou, en dan zou Libo in Borâs failliet gaan en dat zou tot werkloosheid leiden en de sossen waren rabiate tegenstanders van werkloosheid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e16ebd8e-d7d9-438f-8d58-838b9976e2af",
                        "source_entry_id": "2d5c2aee-9f7c-32fe-bd5a-e4e64a70f684",
                        "source_sense_id": "1f0f9c41-0aa6-32f9-bfa6-8193a28bdbad",
                        "source_sense_description": "vijand, rivaal",
                        "target_lang_word": "Gegner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                        "entry_id": "52366874-c34c-3fda-a884-d52c30d728ca",
                                        "glosses": [
                                            "Person oder Institution/Organisation, die gegenteilige Interessen verfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb35f0aa-e4e5-4431-9918-8ca4c93090e6",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "Der Gegner von Hannover 96 war diesmal der 1. FC Köln."
                                            },
                                            {
                                                "example_id": "098461f2-d727-4a52-88a3-0c743e197ce9",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "„Entgegen den Beteuerungen der romfreundlichen Autoren, die den 2. Römisch-Karthagischen Krieg als ein Ringen zwischen zwei gleich starken Gegnern darstellen, war die Disproportion zwischen den Beteiligten groß.“"
                                            },
                                            {
                                                "example_id": "3ce54634-dab5-4456-a339-9d263b8523ac",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "„Es ist für viele wahlentscheidend, auf welchen Gegner sich die präferierte Partei einlassen würde.“"
                                            },
                                            {
                                                "example_id": "2d92df93-efc7-46ed-8492-73c6f414ade7",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "„Seine Idee hatte viele Gegner, vor allem unter den Kongressabgeordneten aus dem landwirtschaftlich geprägten Süden.“"
                                            },
                                            {
                                                "example_id": "5f5ba438-bbd4-45f2-a6bd-3b65e08cf604",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "„Wenn der Analytiker sich seiner gewöhnlichen Hilfsquellen beraubt sieht, denkt er sich in den Geist seines Gegners hinein, identifiziert sich mit ihm, und dann gelingt es ihm nicht selten, auf den ersten Blick eine oft verblüffend einfache Methode zu finden, durch die er den andern irreführen oder zu einem unbesonnenen Zug veranlassen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ae6caaa-96c9-4fc2-8adc-9a0573eff673",
                        "source_entry_id": "2d5c2aee-9f7c-32fe-bd5a-e4e64a70f684",
                        "source_sense_id": "1f0f9c41-0aa6-32f9-bfa6-8193a28bdbad",
                        "source_sense_description": "vijand, rivaal",
                        "target_lang_word": "Widersacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Widersacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                                        "entry_id": "3ace7206-685d-3c91-83c2-57b980726b39",
                                        "glosses": [
                                            "Person, die engagiert gegen die Interessen einer anderen Person arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4613b1bf-2f27-4019-9c98-bc81a4fb65d3",
                                                "sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                                                "text": "„Sie kämpften 424 mit in Nordafrika für den römischen Usurpator Johannes gegen dessen Widersacher, den Feldherrn Bonifatius; …“"
                                            },
                                            {
                                                "example_id": "a63953bc-020a-4392-8080-66adc4a209cd",
                                                "sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                                                "text": "„Für das Treffen haben sich die beiden Widersacher jeweils die Gefolgschaft angesehener Bauern gesichert.“"
                                            },
                                            {
                                                "example_id": "ae9b0fab-ede4-40b3-aefe-d45849aea786",
                                                "sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                                                "text": "„Selbst die Kanzlerin hatte ja lange Zeit Gabriel als ihren potentiellen Widersacher im Wahlkampf gesehen.“"
                                            },
                                            {
                                                "example_id": "c342b4b2-70d2-4a26-a1f5-a4d9abc66605",
                                                "sense_id": "5dada62b-c933-345f-832e-99e8a94ca336",
                                                "text": "„Gerade auch diese »Volksaufklärung« wurde ihm als revolutionärer Akt von seinen Widersachern sehr übelgenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "812ed3f8-d36b-4433-a96e-b912a7852d8c",
                        "source_entry_id": "2d5c2aee-9f7c-32fe-bd5a-e4e64a70f684",
                        "source_sense_id": "1f0f9c41-0aa6-32f9-bfa6-8193a28bdbad",
                        "source_sense_description": "vijand, rivaal",
                        "target_lang_word": "opponent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opponent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75db4a88-0a1a-3e42-9425-3b3b005ecd58",
                                        "entry_id": "5e0c1e01-2fc3-3167-a1fb-03a0750a745d",
                                        "glosses": [
                                            "One who opposes another; one who works or takes a position against someone or something; one who attempts to stop the progress of someone or something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d09d9fc7-4647-4928-ad72-a94c8022e2de",
                                                "sense_id": "75db4a88-0a1a-3e42-9425-3b3b005ecd58",
                                                "text": "The person who ran against her in the last election proved to be a formidable opponent."
                                            },
                                            {
                                                "example_id": "3e88ae5e-a54a-4f9b-84c4-fe7dfd0cbf8e",
                                                "sense_id": "75db4a88-0a1a-3e42-9425-3b3b005ecd58",
                                                "text": "During the crackdown, many opponents of the regime were arrested."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ed6d2c0-3dcd-3e72-825f-9393027f85d7",
                                        "entry_id": "5e0c1e01-2fc3-3167-a1fb-03a0750a745d",
                                        "glosses": [
                                            "One who opposes another; one who works or takes a position against someone or something; one who attempts to stop the progress of someone or something.",
                                            "One who opposes another physically (in a fight, sport, game, or competition)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d283b84-20d4-4fe8-956f-988e7fab9a7f",
                                                "sense_id": "7ed6d2c0-3dcd-3e72-825f-9393027f85d7",
                                                "text": "1720, Alexander Pope, The Iliad of Homer, London: Bernard Lintott, Volume 6, “Observations on the Twenty-Third Book,” no. 39, p. 136,\nIn the Chariot-Race Achilles is represented as being able to conquer every Opponent […]"
                                            },
                                            {
                                                "example_id": "ae3e68c8-5129-4dcf-9308-07301de98fe3",
                                                "sense_id": "7ed6d2c0-3dcd-3e72-825f-9393027f85d7",
                                                "text": "[…] he slid his right hand down to his left, and with the full swing of the weapon struck his opponent on the left side of the head, who instantly measured his length upon the green sward."
                                            },
                                            {
                                                "example_id": "d2533182-cd04-4856-899d-665f0ec002fb",
                                                "sense_id": "7ed6d2c0-3dcd-3e72-825f-9393027f85d7",
                                                "text": "[…] it is possible for a good [draughts] player to defeat an opponent without capturing his pieces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "768343d6-26ff-3a86-8065-dd8e76c628e5",
                                        "entry_id": "5e0c1e01-2fc3-3167-a1fb-03a0750a745d",
                                        "glosses": [
                                            "One who opposes another; one who works or takes a position against someone or something; one who attempts to stop the progress of someone or something.",
                                            "One who opposes another in words (in a dispute, argument or controversy)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c185dfba-54a4-48af-9942-593eb9df0899",
                                                "sense_id": "768343d6-26ff-3a86-8065-dd8e76c628e5",
                                                "text": "It is easier to confound than to convince an opponent; the former may be effected by a turn that has more happiness than truth in it."
                                            },
                                            {
                                                "example_id": "6263a1ca-d83f-4933-8c42-ac2227284e47",
                                                "sense_id": "768343d6-26ff-3a86-8065-dd8e76c628e5",
                                                "text": "“What more have you to say?” she asked, rather in the tone in which a person might address an opponent of adult age than such as is ordinarily used to a child."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bb1ac9e-9c0a-3bab-b034-30971e4c493a",
                                        "entry_id": "5e0c1e01-2fc3-3167-a1fb-03a0750a745d",
                                        "glosses": [
                                            "One who opposes another; one who works or takes a position against someone or something; one who attempts to stop the progress of someone or something.",
                                            "One who is opposed or objects (to a policy, course of action or set of ideas)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97343ac8-4e8f-48b1-8a34-48b8d862b7c5",
                                                "sense_id": "0bb1ac9e-9c0a-3bab-b034-30971e4c493a",
                                                "text": "She was a dedicated opponent of the death penalty."
                                            },
                                            {
                                                "example_id": "36d95131-df5c-473d-81a8-55f098608f83",
                                                "sense_id": "0bb1ac9e-9c0a-3bab-b034-30971e4c493a",
                                                "text": "Their Oath is to maintain the Romish-Catholick Religion, and persecute all Opponents to it."
                                            },
                                            {
                                                "example_id": "69e005b2-39ff-449e-b103-9f9f3fdb69a9",
                                                "sense_id": "0bb1ac9e-9c0a-3bab-b034-30971e4c493a",
                                                "text": "My own friends had been among the bitterest opponents of any proposal to visit the Captain and his daughters, only twelve months before; and now he was even admitted in the tabooed hours before twelve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f6c517f-cc47-3f66-91e0-23a4ea67ea03",
                                        "entry_id": "5e0c1e01-2fc3-3167-a1fb-03a0750a745d",
                                        "glosses": [
                                            "One who opposes another; one who works or takes a position against someone or something; one who attempts to stop the progress of someone or something.",
                                            "The participant who opens an academic debate by putting forward objections to a theological or philosophical thesis."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62b237d3-5aff-4d56-b27a-3fae678176de",
                                                "sense_id": "9f6c517f-cc47-3f66-91e0-23a4ea67ea03",
                                                "text": "We make the argument appere slender, when we receiue it laughyngly, and declare by wordes, euen at the first, that it is nothyng to the purpose, and so abashe the opponent."
                                            },
                                            {
                                                "example_id": "f6ea1cad-afd8-4398-90a5-a2bc146e48c4",
                                                "sense_id": "9f6c517f-cc47-3f66-91e0-23a4ea67ea03",
                                                "text": "[…] diuinitie disputations, in all which those learned opponents, respondents, & moderators, quited themselues like themselues, sharplie and soundlie, besides all other solemne sermons & lectures."
                                            },
                                            {
                                                "example_id": "ca03ef77-903b-4097-ba53-ea6b40ff31c4",
                                                "sense_id": "9f6c517f-cc47-3f66-91e0-23a4ea67ea03",
                                                "text": "[…] by the many Disputes that rise from hence, Mens Wits were confounded with their matters, Truth was lost & Brotherhood destroyed: thus the Devil acted the Part both of Opponent and Defendant, and managed the Passions of both Parties to his End, which was DISCORD."
                                            },
                                            {
                                                "example_id": "80451af2-27d3-46d3-a14e-9270f7a8cfb4",
                                                "sense_id": "9f6c517f-cc47-3f66-91e0-23a4ea67ea03",
                                                "text": "[…] this untoward Method allows him who is the Respondent, to prevaricate from his Duty, and turn Opponent: Which confounds those two Offices, and perverts all the Laws of Reasoning or Discoursing."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "opponent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5baa705-0ae3-3c30-86de-48dbcdbe860f",
                                        "entry_id": "cea85cc1-72f2-370c-bdb3-c58e6753a836",
                                        "glosses": [
                                            "Opposing; adverse; antagonistic."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5d1ae4e-abf3-4d7a-884e-5816ef157822",
                                                "sense_id": "c5baa705-0ae3-3c30-86de-48dbcdbe860f",
                                                "text": "[…] we are to consider enemies as men opponent to peace and justice, and to these they are by warrs to be reduced; And no other ends in the pursuite of enemies by sword and hostile Acts are to be sought for […]"
                                            },
                                            {
                                                "example_id": "ab8d5367-c813-4f2b-8572-c53248d5ed19",
                                                "sense_id": "c5baa705-0ae3-3c30-86de-48dbcdbe860f",
                                                "text": "Young Ithacus advanc’d, defies the foe,\nPoising his lifted lance in act to throw:\nThe savage renders vain the wound decreed,\nAnd springs impetuous with opponent speed!"
                                            },
                                            {
                                                "example_id": "28ece360-8a1e-466d-a156-4a9fd97832f6",
                                                "sense_id": "c5baa705-0ae3-3c30-86de-48dbcdbe860f",
                                                "text": "The reasons you have urged are indeed weighty: yet they have never made an impression so deep upon my mind, as not to take flight, and leave their opponent arguments in some sort the victors."
                                            },
                                            {
                                                "example_id": "4951dc8c-bf8a-4e64-837a-44c1bad45c35",
                                                "sense_id": "c5baa705-0ae3-3c30-86de-48dbcdbe860f",
                                                "text": "Let it not be supposed, that by “catholic,” I mean to designate men who are lax in their principles, and alike indifferent to all religious systems. On the contrary, they are more earnestly attached to truth, and more opponent to sin than others […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df13e201-67b3-3acf-8c45-dd02f6e41740",
                                        "entry_id": "cea85cc1-72f2-370c-bdb3-c58e6753a836",
                                        "glosses": [
                                            "Situated in front; opposite."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8643bee-c6c6-4721-baf1-7f4e9dcfbd50",
                                                "sense_id": "df13e201-67b3-3acf-8c45-dd02f6e41740",
                                                "text": "Her sympathizing Lover takes his Stand\nHigh on th’ opponent Bank […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36aa223b-bb90-4495-ae59-12f59903c19a",
                        "source_entry_id": "2d5c2aee-9f7c-32fe-bd5a-e4e64a70f684",
                        "source_sense_id": "1f0f9c41-0aa6-32f9-bfa6-8193a28bdbad",
                        "source_sense_description": "vijand, rivaal",
