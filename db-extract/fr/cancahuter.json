                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c10d78e-32ec-478f-b8d5-83861792b2f3",
                                "sense_id": "4c35abfe-7ff2-3ff2-9379-e507f424c7c5",
                                "text": "Cette jeep – Géo le percevait au bruit du moteur – était en train de cancahuter sur un sol inégal."
                            },
                            {
                                "example_id": "8384afd2-9b66-44f3-9d32-cdd1237f5c31",
                                "sense_id": "4c35abfe-7ff2-3ff2-9379-e507f424c7c5",
                                "text": "Le type cancahuta en direction de Geo dès qu’il l’aperçut, et lui fit un salut militaire."
                            }
                        ]
                    }
