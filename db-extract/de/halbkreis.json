                    {
                        "translation_id": "6e43a267-8980-4461-bb0c-5e49262c9fbc",
                        "source_entry_id": "2b0dcb0a-01e9-3b6f-ba32-77bff9b47dc7",
                        "source_sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                        "source_sense_description": "Geometrie: durch den Durchmesser begrenzte Hälfte eines Kreises",
                        "target_lang_word": "demi-cercle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demi-cercle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "924f8860-ffc5-385c-ba22-ce6470760824",
                                        "entry_id": "e02a05ed-8884-3ca8-b645-cd3fb89b3e89",
                                        "glosses": [
                                            "Moitié d’un cercle, limitée par un diamètre ; forme semi-circulaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa0f955a-a833-49d3-bcd8-bd0553418df7",
                                                "sense_id": "924f8860-ffc5-385c-ba22-ce6470760824",
                                                "text": "Quand il entra dans le salon, tous se levèrent à grand bruit, on l’embrassa ; et avec les fauteuils et les chaises on fit un large demi-cercle autour de la cheminée."
                                            },
                                            {
                                                "example_id": "40c8d1fd-a15d-4651-b554-1acdd47b1a82",
                                                "sense_id": "924f8860-ffc5-385c-ba22-ce6470760824",
                                                "text": "Deux sourcils en demi-cercle couronnaient les yeux d’Alice, d’une courbe si pure et fine qu’on les aurait crus épilés puis redessinés au crayon ; ces sourcils renforçaient encore l’intensité ce ce regard, comme deux accents sur des voyelles."
                                            },
                                            {
                                                "example_id": "c5c45a22-5b0f-45ed-8faf-6bc2faea6ffb",
                                                "sense_id": "924f8860-ffc5-385c-ba22-ce6470760824",
                                                "text": "Le pic de Ternetiu élève sa crête parmi les nuages à douze cents mètres d’altitude. Ses pentes descendent autour d’un immense cratère en demi-cercle."
                                            },
                                            {
                                                "example_id": "89142d69-2f24-4098-b708-ede33a2f51f9",
                                                "sense_id": "924f8860-ffc5-385c-ba22-ce6470760824",
                                                "text": "Le prouvier aussi avait lancé son cri. Il disait ainsi que, déjà, le courant avait fait alliance avec la force des hommes. Déjà le bateau avait accompli son demi-cercle et s'était placé en direction de la descente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d192c75-5678-46b4-81d9-e7dc8bf7350d",
                        "source_entry_id": "2b0dcb0a-01e9-3b6f-ba32-77bff9b47dc7",
                        "source_sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                        "source_sense_description": "Geometrie: durch den Durchmesser begrenzte Hälfte eines Kreises",
                        "target_lang_word": "hémicycle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hémicycle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "128f248e-31c4-32f0-82a9-42eecbc9e0c2",
                                        "entry_id": "73d8c315-8a0d-395a-a1e3-33a438051025",
                                        "glosses": [
                                            "Lieu en demi-cercle, amphithéâtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "900a2e70-71c4-45a9-b474-1dec84684cce",
                                                "sense_id": "128f248e-31c4-32f0-82a9-42eecbc9e0c2",
                                                "text": "Nous nous pressions avec un battement de cœur dans l’hémicycle de l'École des Beaux-Arts, où M. Taine enseignait pendant les quatre mois d'hiver."
                                            },
                                            {
                                                "example_id": "a6c6728a-eeaa-4e0c-8bf1-fe8ecef9843e",
                                                "sense_id": "128f248e-31c4-32f0-82a9-42eecbc9e0c2",
                                                "text": "Je suis assise dans l’hémicycle désolé et j’y ai cueilli une grenade que l’insouciant été n’a pas mûrie."
                                            },
                                            {
                                                "example_id": "0c6d9ba8-3b72-47f3-9c49-4bc451a3bcf0",
                                                "sense_id": "128f248e-31c4-32f0-82a9-42eecbc9e0c2",
                                                "text": "Il entrait dans le flanc d’une avenue se terminant en une sorte d’hémicycle que meublait un maître-autel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18d402db-ba8a-389d-b6f1-f81e6a15a8f4",
                                        "entry_id": "73d8c315-8a0d-395a-a1e3-33a438051025",
                                        "glosses": [
                                            "Salle plénière de la chambre des députés de la République française."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b16b19e-9916-4db1-bbd9-f5000ee6e484",
                                                "sense_id": "18d402db-ba8a-389d-b6f1-f81e6a15a8f4",
                                                "text": "De la tribune, où je suis monté pour adresser à l'Assemblée le salut du gouvernement, je vois l’hémicycle rempli de compagnons délégués par tous les mouvements de la résistance nationale et appartenant à toutes les tendances de l'opinion."
                                            },
                                            {
                                                "example_id": "cd120324-b976-4156-bde7-7c92dee21b38",
                                                "sense_id": "18d402db-ba8a-389d-b6f1-f81e6a15a8f4",
                                                "text": "François Cormier-Bouligeon s’est adressé en anglais à l’avocate depuis l’hémicycle, lançant : « The french national Assembly supports you » (« L’Assemblée nationale française vous soutient »)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b669cc3e-9565-374b-abd2-b14ec6fc3811",
                                        "entry_id": "73d8c315-8a0d-395a-a1e3-33a438051025",
                                        "glosses": [
                                            "Dispositif en bois qui sert à soutenir les pierres d’une voûte en construction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
