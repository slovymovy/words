    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6616f543-347e-3ee0-b312-94378803bd2c",
                    "sense_definition": "verleden tijd meervoud van <w>schuiven</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "schuiven_past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij <w>schoven</w> de zware tafel naar de andere kant van de kamer.",
                            "target_lang_translations": {
                                "en": "We <w>pushed</w> the heavy table to the other side of the room."
                            }
                        },
                        {
                            "text": "Zij <w>schoven</w> langzaam naar voren in de lange rij voor de kassa.",
                            "target_lang_translations": {
                                "en": "They slowly <w>shuffled</w> forward in the long queue at the checkout."
                            }
                        }
                    ],
                    "common_phrases": [
                        "schoven naar voren",
                        "schoven opzij"
                    ],
                    "target_lang_definitions": {
                        "en": "past plural of 'schuiven' (to push, slide, or move something along a surface)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pushed",
                                "target_lang_sense_clarification": "moved something along a surface"
                            },
                            {
                                "target_lang_word": "slid",
                                "target_lang_sense_clarification": "moved smoothly along a surface"
                            },
                            {
                                "target_lang_word": "shuffled",
                                "target_lang_sense_clarification": "moved slowly or awkwardly"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fc99f355-0b8d-3282-ae5e-32f50e8fd566",
                    "sense_definition": "meervoud van <w>schoof</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "schoof_plural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boeren bonden het graan handmatig samen tot grote <w>schoven</w> op het veld.",
                            "target_lang_translations": {
                                "en": "The farmers manually bound the grain into large <w>sheaves</w> in the field."
                            }
                        },
                        {
                            "text": "Er stonden tientallen <w>schoven</w> stro te drogen in de felle zon.",
                            "target_lang_translations": {
                                "en": "There were dozens of <w>sheaves</w> of straw drying in the bright sun."
                            }
                        }
                    ],
                    "common_phrases": [
                        "schoven stro",
                        "schoven graan"
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'schoof' (sheaf); bundles of cut stalks of grain or straw bound together"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sheaves",
                                "target_lang_sense_clarification": "bundles of grain stalks or straw"
                            },
                            {
                                "target_lang_word": "bundles",
                                "target_lang_sense_clarification": "bound packages of straw or grain"
                            }
                        ]
                    }
                }
            ]
        }
    ]
