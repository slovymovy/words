    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5bfb1183-f0d7-3f34-9123-188331857871",
                    "sense_definition": "A multicolored arch in the sky, produced by the refraction of sunlight through raindrops.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "colors_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the heavy storm passed, a beautiful <w>rainbow</w> appeared over the hills.",
                            "target_lang_translations": {
                                "ru": "После сильной грозы над холмами появилась красивая <w>радуга</w>.",
                                "zh": "暴风雨过后，山丘上出现了一道美丽的<w>彩虹</w>。"
                            }
                        },
                        {
                            "text": "The children drew a bright <w>rainbow</w> with crayons on the paper.",
                            "target_lang_translations": {
                                "ru": "Дети нарисовали на бумаге яркую <w>радугу</w> цветными мелками.",
                                "zh": "孩子们用蜡笔在纸上画了一道明亮的<w>彩虹</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "over the rainbow",
                        "chase a rainbow",
                        "colors of the rainbow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разноцветная дуга на небе, образующаяся при преломлении солнечного света в дождевых каплях.",
                        "zh": "天空中由阳光折射雨滴而形成的彩色拱形。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "радуга",
                                "target_lang_sense_clarification": "атмосферное явление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "彩虹",
                                "target_lang_sense_clarification": "大气光学现象"
                            },
                            {
                                "target_lang_word": "虹",
                                "target_lang_sense_clarification": "书面语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7e8d208-1f0c-3ad0-a7ac-43f3ecaa07b0",
                    "sense_definition": "A wide variety or assortment of related things.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "variety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop offers a <w>rainbow</w> of flavors for their ice cream.",
                            "target_lang_translations": {
                                "ru": "Магазин предлагает целую <w>палитру</w> вкусов мороженого.",
                                "zh": "这家店为他们的冰淇淋提供了<w>多种</w>口味。"
                            }
                        },
                        {
                            "text": "We saw a <w>rainbow</w> of possibilities for the new project design.",
                            "target_lang_translations": {
                                "ru": "Мы увидели <w>спектр</w> возможностей для дизайна нового проекта.",
                                "zh": "我们看到了新项目设计中<w>多种</w>可能性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spectrum"
                    ],
                    "common_phrases": [
                        "rainbow of colors",
                        "rainbow of flavors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широкое разнообразие или ассортимент чего-либо.",
                        "zh": "多种相关事物的集合或种类。"
                    },
                    "translations": {
