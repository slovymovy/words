                "translations": [
                    {
                        "translation_id": "77418e69-7852-417b-af19-0968556c1cd7",
                        "source_entry_id": "b0015773-a6ff-3063-8645-070c79793baf",
                        "source_sense_description": "worker for a company that supplies gas",
                        "target_lang_word": "gazier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gazier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "adb5a8d3-3044-3135-8966-c1a3279addf6",
                                        "entry_id": "a56b2fb5-232b-350e-a9b6-6698a62c9fc2",
                                        "glosses": [
                                            "Relatif à l’industrie du gaz naturel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e02101ec-8b51-4fe9-a426-2d9f1b101128",
                                                "sense_id": "adb5a8d3-3044-3135-8966-c1a3279addf6",
                                                "text": "Le géant gazier russe Gazprom a annoncé, samedi, avoir suspendu ses livraisons de gaz à la Lettonie, sur fond de tensions russo-occidentales en raison du conflit en Ukraine et des sanctions européennes sans précédent contre la Russie."
                                            },
                                            {
                                                "example_id": "f06e95f1-5c80-45a7-bc53-2d3a45cb1c07",
                                                "sense_id": "adb5a8d3-3044-3135-8966-c1a3279addf6",
                                                "text": "Ils blâment en particulier l’entreprise pour continuer, d’une part, de mener ou de lancer des projets pétroliers et gaziers et pour refuser, d’autre part, d’aligner sa stratégie sur l’objectif de l’Accord de Paris."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gazier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c07de04a-f473-3eb6-a35d-7566766464b3",
                                        "entry_id": "1da16072-f972-3ad1-84c1-cacf2fe9f6cc",
                                        "glosses": [
                                            "Ouvrier d’une usine à gaz."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f799f74-76a9-39be-95ca-fb2fb9d055c2",
                                        "entry_id": "1da16072-f972-3ad1-84c1-cacf2fe9f6cc",
                                        "glosses": [
                                            "Personne qui pose les appareils à gaz et qui les vérifie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c05dcd6-c51e-3b38-b6e1-0f032be9498e",
                                        "entry_id": "1da16072-f972-3ad1-84c1-cacf2fe9f6cc",
                                        "glosses": [
                                            "Agent préposé à l'éclairage de la scène d'un théâtre."
                                        ],
                                        "tags": [
                                            "especially",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f84b016f-d542-4589-875c-f4851ce04074",
                                                "sense_id": "6c05dcd6-c51e-3b38-b6e1-0f032be9498e",
                                                "text": "C'est un de mes amis qui est gazier au théâtre des Délassements qui m'a enseigné ce truc. Vous allez en juger."
                                            },
                                            {
                                                "example_id": "e0649a29-7cf3-45f9-ab89-bbc601c14a0f",
                                                "sense_id": "6c05dcd6-c51e-3b38-b6e1-0f032be9498e",
                                                "text": "La marquise se trouva ainsi en évidence, au moment où une fausse manœuvre d'un gazier, posté dans les frises, envoyait jusqu'au fond de l'avant-scène un aveuglant rayon de lumière électrique qui aurait dû tomber aur ces demoiselles du corps de ballet."
                                            },
                                            {
                                                "example_id": "d1b90b28-cb8f-4791-926c-09920b86d680",
                                                "sense_id": "6c05dcd6-c51e-3b38-b6e1-0f032be9498e",
                                                "text": "Nous avions, pour ces observations, choisi un théâtre sans claque payée, et, logés dans la cabine du gazier, nous suivions le jeu des acteurs sans perdre un des moindres mouvements de la salle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b06fc88-bfce-3645-8d6b-44d5755ac757",
                                        "entry_id": "1da16072-f972-3ad1-84c1-cacf2fe9f6cc",
                                        "glosses": [
                                            "Navire servant à transporter du gaz naturel liquéfié dans ses citernes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76d10519-28e8-31d4-a316-f1da739f977f",
                                        "entry_id": "1da16072-f972-3ad1-84c1-cacf2fe9f6cc",
                                        "glosses": [
                                            "Homme, ou garçon, quelconque : quidam, type, gars, pékin, gus, mec."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79d85af7-ccf2-4fe5-8259-47f8b5a209cd",
                                                "sense_id": "76d10519-28e8-31d4-a316-f1da739f977f",
                                                "text": "Amenez-moi ces deux gaziers à l’intérieur, Maudez."
                                            },
                                            {
                                                "example_id": "23d08909-1f4a-4577-94bf-2a9544ef4786",
                                                "sense_id": "76d10519-28e8-31d4-a316-f1da739f977f",
                                                "text": "Fectivement^([sic]), quatre gaziers se radinent, en provenance de directions différentes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4ab11d5-095c-3fb7-aeab-95361ab16e78",
                                        "entry_id": "1da16072-f972-3ad1-84c1-cacf2fe9f6cc",
                                        "glosses": [
                                            "Personne victime d’aérophagie."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
