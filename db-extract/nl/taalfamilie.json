                "translations": [
                    {
                        "translation_id": "d90bac1e-0db8-420a-a13f-5fb1109f93b4",
                        "source_entry_id": "7a9c5c8d-ce91-3a96-a51e-7e62398fc537",
                        "source_sense_id": "52c07532-0c12-3cd6-9c49-6481d4c3c9a4",
                        "source_sense_description": "talengroepen die een zelfde voorgeschiedenis hebben",
                        "target_lang_word": "Sprachfamilie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachfamilie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37ad965b-5996-3f6a-9f39-129f59eccf37",
                                        "entry_id": "edf03bd5-1039-3905-bf2b-8d34219ad0b5",
                                        "glosses": [
                                            "Gruppe von Sprachen, die historisch gesehen miteinander verwandt sind, da sie sich aus derselben Ursprache heraus entwickelt haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ccec1fa-3d90-4d87-b520-5a5aa45c19e4",
                                                "sense_id": "37ad965b-5996-3f6a-9f39-129f59eccf37",
                                                "text": "Deutsch und Englisch gehören zur Sprachfamilie der germanischen Sprachen."
                                            },
                                            {
                                                "example_id": "18a2f04b-f099-4dfc-a5ed-3693e71b2c18",
                                                "sense_id": "37ad965b-5996-3f6a-9f39-129f59eccf37",
                                                "text": "„Auf diese Weise konnten sowohl Lautgesetze als auch die Beziehungen innerhalb der indoeuropäischen Sprachfamilie nachgewiesen werden.“"
                                            },
                                            {
                                                "example_id": "76e77283-a5e5-4189-ba9b-dca168811c8b",
                                                "sense_id": "37ad965b-5996-3f6a-9f39-129f59eccf37",
                                                "text": "„Sprachen, die ihrer Herkunft nach miteinander verwandt sind, von denen man also annimmt, dass sie auf eine gemeinsame »Ursprache« zurückgehen, fasst man in Sprachfamilien zusammen.“"
                                            },
                                            {
                                                "example_id": "3e27c98f-5ba0-4ce5-b20a-46ac619e66eb",
                                                "sense_id": "37ad965b-5996-3f6a-9f39-129f59eccf37",
                                                "text": "„Seit den 70er Jahren ist wieder ein zunehmendes Interesse an der Sprachgeschichte feststellbar, und die Zusammenarbeit von Indogermanisten und Archäologen erbringt laufend neue Erkenntnisse über die Vorgeschichte der indogermanischen Sprachfamilien.“"
                                            },
                                            {
                                                "example_id": "d5ceb718-2978-4aa0-9d10-5c93d0b766ff",
                                                "sense_id": "37ad965b-5996-3f6a-9f39-129f59eccf37",
                                                "text": "„Aus den gemeinsamen Anfängen der indogermanischen Sprachfamilie, zu der auch Griechisch, Persisch oder Sanskrit gehören, hat sich im Zuge der ersten oder germanischen Lautverschiebung eine Art Urgermanisch entwickelt.“"
                                            },
                                            {
                                                "example_id": "8a5bcb39-f960-4b5a-bd67-19e818c296c3",
                                                "sense_id": "37ad965b-5996-3f6a-9f39-129f59eccf37",
                                                "text": "„Das Germanische mit all seinen Einzelsprachen ist selbst nur einer von dreizehn Zweigen der indogermanischen Sprachfamilie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02a6a9c8-a9b2-477e-ba52-62fa47fa41b1",
                        "source_entry_id": "7a9c5c8d-ce91-3a96-a51e-7e62398fc537",
