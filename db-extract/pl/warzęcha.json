                        "glosses": [
                            "ptak z rodzaju Platalea"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11f83e09-3dc6-4032-a269-151d545f2cdc",
                                "sense_id": "2304102f-505d-3be2-b2c0-ea5df6c8182c",
                                "text": "Były tam bociany takie same jak nasze europejskie i bociany o wielkim grubym dzióbie zakończonym hakiem, i czarne jak aksamit ptaki o nogach czerwonych jak krew - i flamingi, i ibisy, i białe z różowymi skrzydłami warzęchy mające dzioby podobne do łyżek…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
