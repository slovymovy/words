                                        "sense_id": "6a787449-5eea-3a37-9e35-58e6f6079af2",
                                        "entry_id": "e83cadc5-2e7b-35c6-8f56-dd0fb4c3a22a",
                                        "glosses": [
                                            "een belangrijk besluit uitgevaardigd door een vorst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd8a255a-23c4-42b7-af5a-26542d623ced",
                                                "sense_id": "6a787449-5eea-3a37-9e35-58e6f6079af2",
                                                "text": "In 864 vaardigde Karel de Kale een edict uit dat de laatste succesvolle poging van een Karolingisch vorst was om sociale en monetaire hervormingen door te voeren."
                                            }
                                        ]
