                        "sense_id": "9538a680-f8e9-3016-9bec-2e767f8891f3",
                        "entry_id": "dc59df1e-5d46-3cb6-a6b9-2e84147594f7",
                        "glosses": [
                            "Geschwür der Haut oder Schleimhaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7e60c8a-0df0-4607-8363-ca64663e2380",
                                "sense_id": "9538a680-f8e9-3016-9bec-2e767f8891f3",
                                "text": "„Das am häufigsten vorkommende Unterschenkelgeschwür ist das venöse Ulkus, in der Fachsprache als Ulcus cruris venosum bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "526f80ab-6216-4137-988f-a9326e6f6f27",
