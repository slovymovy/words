                "senses": [
                    {
                        "sense_id": "798c3e3c-1d13-39c6-8d95-a4928c401703",
                        "entry_id": "5d227619-7d94-36c7-8c68-6583d1428cd6",
                        "glosses": [
                            "die Vermittlung von Wissen durch Lehrer in einer Hochschule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff4d3a17-f88b-43cd-8e4e-019c310d4275",
                                "sense_id": "798c3e3c-1d13-39c6-8d95-a4928c401703",
                                "text": "„Fach- und Berufsschulunterricht müssen allgemein verfügbar gemacht werden, und der Hochschulunterricht muß allen gleichermaßen entsprechend ihren Fähigkeiten offenstehen.“"
                            }
                        ],
