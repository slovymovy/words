                "senses": [
                    {
                        "sense_id": "cc29cd04-e472-32d6-a716-81b5f3b385a8",
                        "entry_id": "4a1e092a-4087-36ab-8281-b1e8bd080e11",
                        "glosses": [
                            "Frequenz, mit der die Atmung erfolgt; Anzahl der Atemzüge je Minute"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16bf2f5c-eaf8-4380-a41e-aea9ca552aae",
                                "sense_id": "cc29cd04-e472-32d6-a716-81b5f3b385a8",
                                "text": "„Dies gelingt ihnen, indem sie in solchen kritischen Momenten in eine Art Starre verfallen, ihren Puls von 200 auf 50 Schläge pro Minute herunterfahren und die Atemfrequenz auf ein Minimum reduzieren.“"
                            },
                            {
                                "example_id": "a1b139f8-ddd7-430d-8106-2ec41047120c",
                                "sense_id": "cc29cd04-e472-32d6-a716-81b5f3b385a8",
                                "text": "„Sie sind mit einer ganzen Reihe von Sensoren ausgestattet, die nicht nur das Herumwälzen sondern auch die Atemfrequenz des Dahinschlummernden aufzeichnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
