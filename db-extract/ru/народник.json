                "senses": [
                    {
                        "sense_id": "03d555e6-ab54-3af4-a66c-3d975e44631f",
                        "entry_id": "f482b768-c57c-3ecb-9001-5efd8b903455",
                        "glosses": [
                            "Narodnik"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "da6ffcfc-32c3-4bee-ae0a-3bdcfa5b0f3f",
                                "sense_id": "03d555e6-ab54-3af4-a66c-3d975e44631f",
                                "text": "Наро́дники да́же и не упомина́ют об уничтоже́нии това́рного хозя́йства: очеви́дно, их широ́кие идеа́лы не мо́гут ника́к вы́йти из ра́мок э́той систе́мы обще́ственного произво́дства.",
                                "translation": "The Narodniks do not even mention the destruction of commodity production: obviously, their broad ideals cannot in any way get out of the framework of this system of social production.",
                                "english": "The Narodniks do not even mention the destruction of commodity production: obviously, their broad ideals cannot in any way get out of the framework of this system of social production."
                            }
                        ]
                    }
                ],
