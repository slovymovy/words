                    {
                        "translation_id": "026b4d8e-576c-4eb8-8d65-98f3cf9b797d",
                        "source_entry_id": "5143be68-6d22-309c-9ba2-2a01c5d7d7eb",
                        "source_sense_id": "4de2847a-309b-3726-a3fc-c0d6c79077aa",
