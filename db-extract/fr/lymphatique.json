        "fr-extract.jsonl": [
            {
                "entry_id": "71526bb4-e03a-3211-aaa6-8a5db51f2201",
                "word": "lymphatique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9dab1c36-5a12-4d3a-9cb9-3ceb5e1a1f36",
                        "entry_id": "71526bb4-e03a-3211-aaa6-8a5db51f2201",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "lymphatiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "26ab5c60-de14-35cd-b9c7-f35dae629db7",
                        "entry_id": "71526bb4-e03a-3211-aaa6-8a5db51f2201",
                        "glosses": [
                            "Qui a rapport à la lymphe, où domine la lymphe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4b4b892-b04f-4ed4-a2d8-5e62de6c75e4",
                                "sense_id": "26ab5c60-de14-35cd-b9c7-f35dae629db7",
                                "text": "Les lésions de la fièvre typhoïde intéressent l'appareil lymphatique, depuis le tissu lymphoïde intestinal (follicules clos et plaques de Peyer) jusqu'aux ganglions mésentériques et à la rate."
                            },
                            {
                                "example_id": "1ba02b0b-f547-448f-8e83-1746b9ab3f99",
                                "sense_id": "26ab5c60-de14-35cd-b9c7-f35dae629db7",
                                "text": "Cette tumeur primitive libère ensuite d’autres cellules cancéreuses, qui se déplacent dans la circulation sanguine (ou lymphatique) jusqu'à un tissu ou un organe éloigné pour y former des tumeurs secondaires appelées métastases."
                            },
                            {
                                "example_id": "c56e2c7d-06c3-4a8f-9b58-c0e22f903d68",
                                "sense_id": "26ab5c60-de14-35cd-b9c7-f35dae629db7",
                                "text": "Tempérament, constitution lymphatique."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e418d49-7b5e-3b0e-bce0-613ca427f391",
                        "entry_id": "71526bb4-e03a-3211-aaa6-8a5db51f2201",
                        "glosses": [
                            "Qui a un tempérament apathique, lent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d36edf44-4dcf-4e02-82c1-a2b3eb7218aa",
                                "sense_id": "4e418d49-7b5e-3b0e-bce0-613ca427f391",
                                "text": "Un enfant lymphatique."
                            },
                            {
                                "example_id": "1b976658-2843-4777-a2fd-c1bf41d48fb7",
                                "sense_id": "4e418d49-7b5e-3b0e-bce0-613ca427f391",
                                "text": "Souvent il accompagnait au jardin les petits Homais, marmots toujours barbouillés, fort mal élevés et quelque peu lymphatiques."
                            },
                            {
                                "example_id": "dd8cce83-fc27-4ff8-a28d-00fd31adba17",
                                "sense_id": "4e418d49-7b5e-3b0e-bce0-613ca427f391",
                                "text": "…les brouillards et les gras pâturages forment les lymphatiques et grossiers chevaux du Nord."
                            },
                            {
                                "example_id": "174f49ad-3425-4e9d-b82e-9c7ff00f2cee",
                                "sense_id": "4e418d49-7b5e-3b0e-bce0-613ca427f391",
                                "text": "Cet amour heureux et non satisfait produisit dans l’être physique de Germinie un singulier phénomène physiologique. On aurait dit que la passion qui circulait en elle renouvelait et transformait son tempérament lymphatique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5ac168d-9608-49a5-a812-cff43e4970d4",
                        "source_entry_id": "71526bb4-e03a-3211-aaa6-8a5db51f2201",
                        "source_sense_description": "(Médecine) Qui a rapport à la lymphe, où domine la lymphe.",
                        "target_lang_word": "lymphatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lymphatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fafd58ed-eba2-31b7-aed0-54b14adfed6c",
                                        "entry_id": "09f4d174-5f8b-32a4-9938-f69a022fb85b",
                                        "glosses": [
                                            "Pertaining to lymph or the lymphatic system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba254a40-4030-3e78-9080-b61e45a82f1f",
                                        "entry_id": "09f4d174-5f8b-32a4-9938-f69a022fb85b",
                                        "glosses": [
                                            "Lacking energy or enthusiasm; having characteristics once associated with an excess of lymph: lack of muscle tone, paleness, sluggishness, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d71a2f3b-88d2-4eaa-af71-1603e9471798",
                                                "sense_id": "ba254a40-4030-3e78-9080-b61e45a82f1f",
                                                "text": "Eleonore Lemindre, aged 34, tailoress, of a sanguine lymphatic temperament, having suffered great depression of spirits, experienced, in the course of 1820, symptoms of what is called disease of the heart."
                                            },
                                            {
                                                "example_id": "d9ca88c7-6670-4bab-8b9f-a519a8743e42",
                                                "sense_id": "ba254a40-4030-3e78-9080-b61e45a82f1f",
                                                "text": "Streaker, the housemaid, too, had an attribute of a most discomfiting nature. I am unable to say whether she was of an unusually lymphatic temperament, or what else was the matter with her, but this young woman became a mere Distillery for the production of the largest and most transparent tears I ever met with."
                                            },
                                            {
                                                "example_id": "222eb3ee-87f0-400e-b458-5ccdd7eeb924",
                                                "sense_id": "ba254a40-4030-3e78-9080-b61e45a82f1f",
                                                "text": "Who has not marked, where the full cheek should be,\nIncipient lines of lank flaccidity,\nLymphatic pallor where the pink should glow,\nAnd where the throb of transport, pulses low?—"
                                            },
                                            {
                                                "example_id": "69272f85-1bf3-477e-80d2-12d160b3e78f",
                                                "sense_id": "ba254a40-4030-3e78-9080-b61e45a82f1f",
                                                "text": "He was a lymphatic, half-witted Hindu youth, who lived his life in almost complete silence[…]"
                                            },
                                            {
                                                "example_id": "f354d31a-ab7e-4072-8a88-4e8df9684aea",
                                                "sense_id": "ba254a40-4030-3e78-9080-b61e45a82f1f",
                                                "text": "Hari, the holy man, who was to be the pundit that day, was just as Mr Biswas remembered him, just as soft-spoken and lymphatic. His felt hat sat softly on his head. He greeted Mr Biswas without rancour, without pleasure, without interest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "883aa9d1-b5c4-3a46-8b0e-68105c0db21d",
                                        "entry_id": "09f4d174-5f8b-32a4-9938-f69a022fb85b",
                                        "glosses": [
                                            "Madly enthusiastic; frantic."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eb206bd-7566-40e6-a208-fc27f63e5b5b",
                                                "sense_id": "883aa9d1-b5c4-3a46-8b0e-68105c0db21d",
                                                "text": "A Negro stood by all the while trembling, now and then lifting up his hands and eyes, muttering his black Art to some hobgoblin, and (when we least suspected it) skips out, and in a limphatic rapture drew a long knife which he brandisht about his head 7 or 8 times, and after so many spells put it up againe; he then kisses the humid earth 3 times and rises merrily: upon a sudden, the skie cleared and no more noise affrighted us."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lymphatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a0706c7-fec3-39f8-8a91-238e2a9ce23e",
                                        "entry_id": "94983b5b-2636-3345-ac5e-d94d7c60b15d",
                                        "glosses": [
                                            "A vessel that transports lymph."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
