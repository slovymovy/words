{
    "word_family": [
        "confinement",
        "confined",
        "unconfined"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a53b7bde-98bb-3569-af38-23d9229d1ec9",
                    "sense_definition": "To restrict someone or something within a particular area, scope, or set of limits.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor advised the patient to <w>confine</w> himself to bed for at least three days to recover.",
                            "target_lang_translations": {
                                "ru": "Врач посоветовал пациенту <w>не вставать</w> с постели как минимум три дня, чтобы восстановиться."
                            }
                        },
                        {
                            "text": "Please <w>confine</w> your remarks to the topic under discussion so we can finish the meeting on time.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>ограничьте</w> свои замечания темой обсуждения, чтобы мы могли вовремя закончить собрание."
                            }
                        }
                    ],
                    "synonyms": [
                        "limit",
                        "pen",
                        "hem in"
                    ],
                    "antonyms": [
                        "release",
                        "free"
                    ],
                    "common_phrases": [
                        "confine your remarks",
                        "confine to bed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограничивать кого-либо или что-либо определенной областью, рамками или набором пределов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограничивать",
                                "target_lang_sense_clarification": "устанавливать рамки или пределы"
                            },
                            {
                                "target_lang_word": "приковывать",
                                "target_lang_sense_clarification": "вынуждать оставаться в определенном месте, например, в постели"
                            },
                            {
                                "target_lang_word": "сводить",
                                "target_lang_sense_clarification": "ограничивать обсуждение или деятельность определенной темой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a316102-da00-3ec8-a237-737fe52ea772",
                    "sense_definition": "To share a common boundary or to border on another area.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small village is located where the local forest lands <w>confine</w> with the neighboring valley.",
                            "target_lang_translations": {
                                "ru": "Маленькая деревня расположена там, где местные лесные угодья <w>граничат</w> с соседней долиной."
                            }
                        },
                        {
                            "text": "In ancient maps, it was often unclear where one kingdom would <w>confine</w> with another.",
                            "target_lang_translations": {
                                "ru": "На древних картах часто было неясно, где одно королевство <w>соприкасается</w> с другим."
                            }
                        }
                    ],
                    "synonyms": [
                        "border"
                    ],
                    "common_phrases": [
                        "confine with"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense is less common in modern usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь общую границу или граничить с другой территорией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "граничить",
                                "target_lang_sense_clarification": "иметь общую межу или предел"
                            },
                            {
                                "target_lang_word": "соприкасаться",
                                "target_lang_sense_clarification": "плотно прилегать границами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e99745e-f203-3ff1-8ee9-dffdf8a5b790",
                    "sense_definition": "A boundary, limit, or the outer edge of a specific area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to stay within the narrow <w>confines</w> of the city when you crave the open countryside.",
                            "target_lang_translations": {
                                "ru": "Трудно оставаться в узких <w>пределах</w> города, когда жаждешь просторов сельской местности."
                            }
                        },
                        {
                            "text": "The research was strictly kept within the <w>confines</w> of the laboratory for safety reasons.",
                            "target_lang_translations": {
                                "ru": "В целях безопасности исследования проводились строго в <w>рамках</w> лаборатории."
                            }
                        }
                    ],
                    "synonyms": [
                        "border",
                        "bound",
                        "limit"
                    ],
                    "common_phrases": [
                        "within the confines"
                    ],
                    "target_lang_definitions": {
                        "ru": "Граница, предел или внешний край определенной области."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пределы",
                                "target_lang_sense_clarification": "пространственные или формальные границы"
                            },
                            {
                                "target_lang_word": "рамки",
                                "target_lang_sense_clarification": "ограничения деятельности или темы"
                            },
                            {
                                "target_lang_word": "границы",
                                "target_lang_sense_clarification": "линии раздела территорий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09c6b564-6ae4-3f21-8c42-d61551606d1a",
                    "sense_definition": "The state of being imprisoned or physically restricted.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner grew weary of his close <w>confine</w> and longed for the fresh air of the fields.",
                            "target_lang_translations": {
                                "ru": "Узник устал от своего тесного <w>заточения</w> и тосковал по свежему воздуху полей."
                            }
                        },
                        {
                            "text": "After months of solitary <w>confine</w>, the light of the sun seemed almost too bright to bear.",
                            "target_lang_translations": {
                                "ru": "После нескольких месяцев одиночного <w>заключения</w> солнечный свет казался почти невыносимо ярким."
                            }
                        }
                    ],
                    "antonyms": [
                        "freedom",
                        "liberty"
                    ],
                    "common_phrases": [
                        "close confine"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in older literature or poetry."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние тюремного заключения или физического ограничения свободы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заточение",
                                "target_lang_sense_clarification": "пребывание под стражей или в неволе"
                            },
                            {
                                "target_lang_word": "неволя",
                                "target_lang_sense_clarification": "отсутствие свободы передвижения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}