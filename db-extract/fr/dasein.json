                ],
                "senses": [
                    {
                        "sense_id": "589d62d0-c2cf-31b1-8576-c21a7ca3fc3d",
                        "entry_id": "b8553952-83f3-3a10-8999-65b87beb9357",
                        "glosses": [
                            "Présence existentielle de l’homme dans le monde d’après Martin Heidegger."
                        ],
                        "tags": [
                            "Germanisme"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "badb1955-19fb-4d53-8305-35c41454c496",
                        "source_entry_id": "b8553952-83f3-3a10-8999-65b87beb9357",
                        "source_sense_id": "589d62d0-c2cf-31b1-8576-c21a7ca3fc3d",
                        "target_lang_word": "Dasein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dasein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                        "entry_id": "04e69999-17ff-3696-aada-fd205890d179",
                                        "glosses": [
                                            "das Leben eines Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85bb0262-6335-4b3e-b465-34d01db73d93",
                                                "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                                "text": "Sie freuten sich ihres Daseins."
                                            },
                                            {
                                                "example_id": "c27897d6-faed-42a1-b195-55e2757d438d",
                                                "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                                "text": "„Es sieht also ganz so aus, als ob das Schimpfen essenziell zum menschlichen Dasein dazugehören würde.“"
                                            },
                                            {
                                                "example_id": "b2cfd079-71e2-4d97-be33-1e875902fb87",
                                                "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                                "text": "„Schon in der Hafenkneipe hatte er erkannt, daß ihm John auf der weiten Fahrt in die Arktis das einsame Dasein unter den Grobianen und den ausgemachten Strolchen seiner Besatzung als guter Kamerad erträglich machen konnte.“"
                                            },
                                            {
                                                "example_id": "14247b74-0608-4e19-ba2a-46c65834c8a6",
                                                "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                                "text": "„Die Bohémiens gehen jetzt ins Romanische Café, in dessen kuppelförmiger Halle die unter Kettenhändlern von der Rennbahn und Börsenspekulanten ein ziemlich geduldetes Dasein fristen.“"
                                            },
                                            {
                                                "example_id": "531f2bd3-76b6-428a-8ef3-d79f8992da17",
                                                "sense_id": "8d8e2f1c-c3a1-3f3a-ad82-a45e1d69bf31",
                                                "text": "„In diesen drei entscheidenden Jahren meines Daseins verlor man oft die Hoffnung, daß ich weiterleben werde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "60d5cda7-ad3b-3024-a652-8e41b7ec27a4",
                                        "entry_id": "04e69999-17ff-3696-aada-fd205890d179",
                                        "glosses": [
                                            "Tatsache, anwesend/zugegen zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e49947f-d5a0-44bf-a6b0-c6787571af5e",
                        "source_entry_id": "b8553952-83f3-3a10-8999-65b87beb9357",
                        "source_sense_id": "589d62d0-c2cf-31b1-8576-c21a7ca3fc3d",
