            "senses": [
                {
                    "sense_id": "fd49d9c9-5032-3359-991b-a9eca91e42de",
                    "sense_definition": "Participe présent de <w>lanciner</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>lancinant</w> sans arrêt, cette vieille blessure lui rappelait de mauvais souvenirs."
                        },
                        {
                            "text": "Cette pensée, le <w>lancinant</w> jour et nuit, finissait par lui faire perdre la raison."
