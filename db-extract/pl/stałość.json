                        "target_lang_word": "stability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e86af7b-e2c5-3a7a-9eed-65b7cb97f103",
                                        "entry_id": "f2712c6d-5461-3e84-8c87-2a1e3b593952",
                                        "glosses": [
                                            "The condition of being stable or in equilibrium, and thus resistant to change."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "501ff07f-bbd6-4ccf-9242-6913fa03ede7",
                                                "sense_id": "6e86af7b-e2c5-3a7a-9eed-65b7cb97f103",
                                                "text": "This platform offers good stability"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7b64c81-8f4b-37a9-8ae4-d65ddfb0929f",
                                        "entry_id": "f2712c6d-5461-3e84-8c87-2a1e3b593952",
                                        "glosses": [
                                            "The tendency to recover from perturbations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28b1a7e9-fee2-4df5-b8bc-8f232a72a867",
                                                "sense_id": "c7b64c81-8f4b-37a9-8ae4-d65ddfb0929f",
                                                "text": "emotional stability"
                                            },
                                            {
                                                "example_id": "88de0018-4a11-451e-a74f-bfc0cbc17a6e",
                                                "sense_id": "c7b64c81-8f4b-37a9-8ae4-d65ddfb0929f",
                                                "text": "Globalization has re-ordered the global economy in ways that are destructive to civic stability, as decentralized, localized producers cannot compete with globalized, commoditized crops, capital, labor and goods."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e7d3d58-9242-408b-b43b-94a80d26f483",
                        "source_entry_id": "b35d256d-6d02-30cb-bb74-b75cec776321",
                        "source_sense_id": "83c5f2b6-0859-3b22-922f-46f3480352b5",
                        "target_lang_word": "constancy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "constancy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70e4cff4-6e52-3770-a401-f6a73e96e2c3",
                                        "entry_id": "c633eae1-25c4-37a3-aecd-39bac057be2f",
                                        "glosses": [
                                            "The quality of being constant; steadiness or faithfulness in action, affections, purpose, etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e1e702b-94da-44e0-9f08-51fff5bfe7ef",
                                                "sense_id": "70e4cff4-6e52-3770-a401-f6a73e96e2c3",
                                                "text": "A little Water cleares vs of this deed.\nHow eaſie is it then? your Conſtancie\nHath left you vnattended."
                                            },
                                            {
                                                "example_id": "2ecd36cf-7965-4a04-8899-1ff69cf26c6d",
                                                "sense_id": "70e4cff4-6e52-3770-a401-f6a73e96e2c3",
                                                "text": "Punctuality is a species of Constancy, a very unfashionable quality in a Lady."
                                            },
                                            {
                                                "example_id": "6e7eba9a-7b27-4fbb-b61c-74fed1564ddc",
                                                "sense_id": "70e4cff4-6e52-3770-a401-f6a73e96e2c3",
                                                "text": "And, I do not know that I should be fond of preaching often; now and then, perhaps, once or twice in the spring, after being anxiously expected for half a dozen Sundays together; but not for a constancy; it would not do for a constancy."
                                            },
                                            {
                                                "example_id": "46b43e3a-11b4-4276-a6eb-d4bb21ee53e3",
                                                "sense_id": "70e4cff4-6e52-3770-a401-f6a73e96e2c3",
                                                "text": "Constancy of character is what is chiefly valued and sought for by naturalists."
                                            },
                                            {
                                                "example_id": "b2155143-a6d2-4ad7-b74d-4abf03f54de0",
                                                "sense_id": "70e4cff4-6e52-3770-a401-f6a73e96e2c3",
                                                "text": "The overall retention rate of 68 per cent indicates a robust constancy of the linguistic features investigated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee3841a7-3890-3528-a946-a92fa464e9db",
                                        "entry_id": "c633eae1-25c4-37a3-aecd-39bac057be2f",
                                        "glosses": [
                                            "An unchanging quality or characteristic of a person or thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e77d6970-f374-4b45-b6ea-120450829719",
                                                "sense_id": "ee3841a7-3890-3528-a946-a92fa464e9db",
                                                "text": "[…] yonger ſpirits, […]\nwhoſe conſtancies\nExpire before their faſhions: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37c89211-6750-42a0-8042-4cca03968c71",
                        "source_entry_id": "b35d256d-6d02-30cb-bb74-b75cec776321",
                        "source_sense_id": "83c5f2b6-0859-3b22-922f-46f3480352b5",
