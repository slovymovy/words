                                        "entry_id": "8f95eaf2-5bf7-3be7-9519-1ff0d9addce7",
                                        "glosses": [
                                            "A point about which a person is particularly sensitive."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
