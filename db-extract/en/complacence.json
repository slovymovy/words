                                "sense_id": "2225221e-187b-3249-93d9-6d271235d499",
                                "text": "O thou, my sole complacence."
                            }
                        ]
                    },
                    {
                        "sense_id": "a98e1608-2cc6-382d-bd4a-a8f71cae988e",
                        "entry_id": "e9b1de64-e786-3ac7-a1bf-a1e76fe8fcb8",
                        "glosses": [
                            "Complaisance; a willingness to comply with others' wishes."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
