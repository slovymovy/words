                        ],
                        "tags": [
                            "inhaltlich"
                        ],
                        "examples": [
                            {
                                "example_id": "290f7e73-2102-4745-9220-9eaef4f402c9",
                                "sense_id": "a6b286c5-86ff-39df-896a-4bf95b076bd8",
                                "text": "„Mit einem Trauerbrief zu kondolieren, ist eine Art der persönlichen Anteilnahme, die Hinterbliebenen Beistand in den Trauerphasen leisten soll.“"
                            },
                            {
                                "example_id": "2044efde-e21a-43ed-b32e-e80dc126abeb",
                                "sense_id": "a6b286c5-86ff-39df-896a-4bf95b076bd8",
                                "text": "„Herr v. Fontenelle hatte einer jungen Wittwe über den Tod ihres Mannes, den sie zu heurathen gezwungen worden war, einen Trauerbrief zu schreiben.“"
                            }
                        ],
