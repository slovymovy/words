                                    {
                                        "sense_id": "f9e3bab6-0f45-3c34-ac4e-1b938acfe2c8",
                                        "entry_id": "767edf01-f777-3f91-8097-cad7dd20d72a",
                                        "glosses": [
                                            "etwas mithilfe von einem oder mehreren Schlägen entfernen"
