                                ]
                            },
                            {
                                "target_word": "scud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0c805c1-5f49-35f6-aa5f-c3761296daca",
                                        "entry_id": "86793247-8445-3346-a068-f117834a625b",
                                        "glosses": [
                                            "To race along swiftly (especially used of clouds)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ac8e461-0ca3-45b1-ab79-3800b67353dc",
                                                "sense_id": "e0c805c1-5f49-35f6-aa5f-c3761296daca",
                                                "text": "When scudding on from snare to snare I plied\nMy anxious visitation, hurrying on,\nStill hurrying hurrying onward ..."
                                            },
                                            {
                                                "example_id": "874b7e85-d5b3-4a15-a790-489bf8d10433",
                                                "sense_id": "e0c805c1-5f49-35f6-aa5f-c3761296daca",
                                                "text": "From the thick copse the roebucks bound,\nThe startled red-deer scuds the plain […]"
                                            },
                                            {
                                                "example_id": "ada57fb2-1629-4fd5-bdc4-5faacb953f4f",
                                                "sense_id": "e0c805c1-5f49-35f6-aa5f-c3761296daca",
                                                "text": "The wind was high; the vast white clouds scudded over the blue heaven […]"
                                            },
                                            {
                                                "example_id": "4ce361b2-9a70-4ba1-bef2-07726a6d99c6",
                                                "sense_id": "e0c805c1-5f49-35f6-aa5f-c3761296daca",
                                                "text": "I saw a rhinoceros, buffalo (a large herd), eland, quagga, and sable antelope, the most beautiful of all the bucks, not to mention many smaller varieties of game, and three ostriches which scudded away at our approach like white drift before a gale."
                                            },
                                            {
                                                "example_id": "bf1b414d-2d86-4101-a123-52b3b8b907c3",
                                                "sense_id": "e0c805c1-5f49-35f6-aa5f-c3761296daca",
                                                "text": "During the preceding afternoon a heavy North Pacific fog had blown in […] Scudding eastward from the ocean, it had crept up and over the redwood-studded crests of the Coast Range mountains, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22fafe5d-66d0-3bf4-bdec-e3e367957bbf",
                                        "entry_id": "86793247-8445-3346-a068-f117834a625b",
                                        "glosses": [
                                            "To run, or be driven, before a high wind with few or no sails set."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb41e607-d65d-4997-ba61-2a61a51259b1",
                                                "sense_id": "22fafe5d-66d0-3bf4-bdec-e3e367957bbf",
                                                "text": "If the Main Topsail should by any accident be split, it will be still necessary to have a lofty Sail set in such a Sea, and the close reefed Topsail singly will be the best to scud under."
                                            },
                                            {
                                                "example_id": "f5e0f9b2-d57b-4377-942a-1b3d4f6aaafb",
                                                "sense_id": "22fafe5d-66d0-3bf4-bdec-e3e367957bbf",
                                                "text": "all night they were obliged to scud under bare poles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65bc10f0-1e71-3eba-b735-cf9c3deb4fa2",
                                        "entry_id": "86793247-8445-3346-a068-f117834a625b",
                                        "glosses": [
                                            "To hit or slap."
                                        ],
                                        "tags": [
                                            "Northumbria"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "331e1dfb-2b3d-3086-972f-3234a8e55656",
                                        "entry_id": "86793247-8445-3346-a068-f117834a625b",
                                        "glosses": [
                                            "To speed."
                                        ],
                                        "tags": [
                                            "Northumbria"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6869edfb-ceec-376d-84d0-c08466acc6c7",
                                        "entry_id": "86793247-8445-3346-a068-f117834a625b",
                                        "glosses": [
                                            "To skim flat stones so they skip along the water."
                                        ],
                                        "tags": [
                                            "Northumbria"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "362f7572-fa11-3e2e-99b1-801d510483ab",
                                        "entry_id": "86793247-8445-3346-a068-f117834a625b",
                                        "glosses": [
                                            "To scrape (skins) to remove hair etc. as part of the tanning process."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "scud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f975966b-e9df-3f17-a6ed-de5944bf25e5",
                                        "entry_id": "84500e84-3466-3130-81d4-6a45a059a6bb",
                                        "glosses": [
                                            "The act of scudding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e62e4145-2e5e-3d7b-bc13-388c5555276d",
                                        "entry_id": "84500e84-3466-3130-81d4-6a45a059a6bb",
                                        "glosses": [
                                            "Clouds or rain(s) (or snow, etc) driven by the wind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be8b76c7-df50-4c44-8e7b-ad2828f3cff0",
                                                "sense_id": "e62e4145-2e5e-3d7b-bc13-388c5555276d",
                                                "text": "But high above the flying scud and dark-rolling clouds, there floated a little isle of sunlight, from which beamed forth an angel's face […]"
                                            },
                                            {
                                                "example_id": "103158f3-dcaf-4005-9b94-dcf0dc9f3c48",
                                                "sense_id": "e62e4145-2e5e-3d7b-bc13-388c5555276d",
                                                "text": "... he will have a wet journey, seeing it is apout to pe a scud.\""
                                            },
                                            {
                                                "example_id": "f2726a71-8e38-4d1d-aeed-5c4244bf52cf",
                                                "sense_id": "e62e4145-2e5e-3d7b-bc13-388c5555276d",
                                                "text": "Places near the sea have frequent scuds, that keep the atmosphere moist, yet do not reach far up into the country; making thus the maritime situations appear wet, when the rain is not considerable."
                                            },
                                            {
                                                "example_id": "0a376533-5efd-4f6b-b4ab-622c1d469023",
                                                "sense_id": "e62e4145-2e5e-3d7b-bc13-388c5555276d",
                                                "text": "She'll cure this scud o' sentimental win' Wi' something o' a mair substantial kin';"
                                            },
                                            {
                                                "example_id": "786c3748-64e1-4dd8-b426-e19cd2f7b825",
                                                "sense_id": "e62e4145-2e5e-3d7b-bc13-388c5555276d",
                                                "text": "... banks o' scud drave ragged past, And blashed upon his face, For blast on blast, frae the southwast, Did ither raging chace,[…]"
                                            },
                                            {
                                                "example_id": "f0db88b9-4f50-4a6c-83ca-eb5e00f2beb9",
                                                "sense_id": "e62e4145-2e5e-3d7b-bc13-388c5555276d",
                                                "text": "... a scud of rain splashed on the window, drowning a sentence of the First Lesson."
                                            },
                                            {
                                                "example_id": "0273817d-ead8-4454-beb9-c2cdfe7f7d97",
                                                "sense_id": "e62e4145-2e5e-3d7b-bc13-388c5555276d",
                                                "text": "Tes nothen but a scud o' snow, If you do talk about gwain, I'll lock 'ee in, same as we did pa'son."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecc923a9-8b08-338f-ae0d-d4b94d9c22a5",
                                        "entry_id": "84500e84-3466-3130-81d4-6a45a059a6bb",
                                        "glosses": [
                                            "A loose formation of small ragged cloud fragments (or fog) not attached to a larger higher cloud layer."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04839470-cfce-4e77-9a23-e7b1ae09fbcb",
                                                "sense_id": "ecc923a9-8b08-338f-ae0d-d4b94d9c22a5",
                                                "text": "Small, ragged, low cloud fragments that are unattached to a larger cloud base and often seen with and behind cold fronts and thunderstorm gust fronts. Such clouds generally are associated with cool moist air, such as thunderstorm outflow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7965542e-0367-3e32-966f-75130cd6e647",
                                        "entry_id": "84500e84-3466-3130-81d4-6a45a059a6bb",
                                        "glosses": [
                                            "A gust of wind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
