                    ],
                    "common_phrases": [
                        "école normale",
                        "école normale supérieure"
                    ]
                },
                {
                    "sense_id": "80f7cd40-081f-3b46-8830-a318420cec68",
                    "sense_definition": "En géométrie, qui est perpendiculaire ou orthogonal à une courbe ou une surface.",
