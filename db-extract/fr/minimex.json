                "translations": [
                    {
                        "translation_id": "c7ee53b8-0a46-424f-a285-dee2ddfe2ca7",
                        "source_entry_id": "01bb8361-53a7-31a8-8ffa-1c68b2335848",
                        "source_sense_id": "6482f4af-ec97-3489-a4be-96c8b3e0373a",
                        "source_sense_description": "historisch, Belgien: Sozialhilfe, Grundsicherung",
                        "target_lang_word": "Sozialhilfe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sozialhilfe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b2da232-ab2b-3c56-89b0-5700a1f60b52",
                                        "entry_id": "50e97ab7-5e18-3b94-b637-fd2e8b989314",
                                        "glosses": [
                                            "staatliche Hilfeleistung, die auf Erfüllung der Grundbedürfnisse der Menschen abzielt"
                                        ],
                                        "tags": [
                                            "Sozialpolitik",
                                            "Sozialrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ea1edde-c6e2-4e52-80af-5b7af8bc1f23",
                                                "sense_id": "4b2da232-ab2b-3c56-89b0-5700a1f60b52",
                                                "text": "„Der Anspruch auf lebenslange Sozialhilfe wurde auf fünf Jahre gekürzt, Väter wurden rigoros zum Unterhalt gezwungen.“"
                                            },
                                            {
                                                "example_id": "6a537a1c-103c-41ea-aac0-3d294ddd1471",
                                                "sense_id": "4b2da232-ab2b-3c56-89b0-5700a1f60b52",
                                                "text": "„Die Zusammenlegung von Arbeitslosenhilfe und Sozialhilfe zum Arbeitslosengeld II, auch Hartz IV genannt, hat eine Prozesslawine ausgelöst.“"
                                            },
                                            {
                                                "example_id": "acfa1c4b-5562-4acf-ad8b-d5e752dc8522",
                                                "sense_id": "4b2da232-ab2b-3c56-89b0-5700a1f60b52",
                                                "text": "„Die Sozialhilfe stockte sie mit Telefon-Heimarbeit auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de733c1b-dbc6-4e42-9fbd-0e0581e23582",
                        "source_entry_id": "01bb8361-53a7-31a8-8ffa-1c68b2335848",
                        "source_sense_id": "6482f4af-ec97-3489-a4be-96c8b3e0373a",
                        "source_sense_description": "historisch, Belgien: Sozialhilfe, Grundsicherung",
                        "target_lang_word": "Grundsicherung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grundsicherung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd49748d-6f08-3c4e-8723-fc96addf462d",
                                        "entry_id": "30969b7e-2d0c-3bf5-982c-b7e4e3ff49a6",
                                        "glosses": [
                                            "Sicherung der Grundversorgung (beispielsweise Nahrung, Kleidung, eine Wohnung) der Bevölkerung bei Bedürftigkeit (beispielsweise von Kindern, Alten, Kranken, Pflegebedürftigen, Erwerbslosen, Erwerbsgeminderten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43fdb316-71a0-4285-b80a-fd8020140141",
                                                "sense_id": "cd49748d-6f08-3c4e-8723-fc96addf462d",
                                                "text": "Zuständig für die Grundsicherung in Deutschland ist der Staat."
                                            },
                                            {
                                                "example_id": "840db791-1bfe-400c-a930-bf32539cb1c6",
                                                "sense_id": "cd49748d-6f08-3c4e-8723-fc96addf462d",
                                                "text": "„Die Grundsicherung für Kinder käme insbesondere den 2,4 Millionen in Armut lebenden Kindern in Deutschland zu Gute.“"
                                            },
                                            {
                                                "example_id": "ae251f21-65c5-4cd3-b110-6e311532f3a2",
                                                "sense_id": "cd49748d-6f08-3c4e-8723-fc96addf462d",
                                                "text": "„In vielen Familien reicht das Einkommen nicht mehr. Einige Kinder kommen ohne Frühstück in die Schule und haben kein Geld für ein Mittagessen. Die AWO fordert daher eine Grundsicherung von 500 Euro im Monat für jedes Kind.“"
                                            },
                                            {
                                                "example_id": "644d3b3c-a26b-41a1-b3c4-bdb2f0dffb20",
                                                "sense_id": "cd49748d-6f08-3c4e-8723-fc96addf462d",
                                                "text": "[Schlagzeile:] „Familienpolitik – CSU lehnt Grundsicherung für Kinder ab“"
                                            },
                                            {
                                                "example_id": "b1680a7e-ec0d-4841-98af-46a4a1955c7e",
                                                "sense_id": "cd49748d-6f08-3c4e-8723-fc96addf462d",
                                                "text": "„Der Regelsatz der Grundsicherung für Arbeitsuchende soll […] ab dem 1. Januar 2006 um 14 Euro auf 345 Euro steigen.“"
                                            },
                                            {
                                                "example_id": "98f36061-adfa-44b8-bc99-63ef7fc64800",
                                                "sense_id": "cd49748d-6f08-3c4e-8723-fc96addf462d",
                                                "text": "„Wilhelm Adamy vom DGB [zieht] den Schluss, dass die Grundsicherung für Arbeitsuchende »keinesfalls mehr nur ein Fürsorgesystem für hilfebedürftige Arbeitslose [sei], sondern in starkem Maße auch für Erwerbstätige, die von ihrem Arbeitseinkommen allein nicht leben können«.“"
                                            },
                                            {
                                                "example_id": "09555194-bf0b-4b1b-a8cf-67d83947a2e2",
                                                "sense_id": "cd49748d-6f08-3c4e-8723-fc96addf462d",
                                                "text": "„Wie viele Rücklagen, wie viel Vermögen dürfen Rentner haben, die auf die Grundsicherung angewiesen sind, wie viel aus einer Riesterrente darf anrechnungsfrei weiter bezogen werden?“"
                                            },
                                            {
                                                "example_id": "e9190413-62d8-49cd-850b-bcabaa2baa7e",
                                                "sense_id": "cd49748d-6f08-3c4e-8723-fc96addf462d",
                                                "text": "„UN kritisiert Grundsicherung in Deutschland – […] Der Ausschuss befürchtet, dass die Höhe der Grundsicherung nicht ausreicht, um den Empfängerinnen und Empfängern und ihren Familien einen ausreichenden Lebensstandard zu ermöglichen.“"
                                            },
                                            {
                                                "example_id": "82153c1e-1e04-4158-b63e-31b9514c6350",
                                                "sense_id": "cd49748d-6f08-3c4e-8723-fc96addf462d",
                                                "text": "„Durch die starke Zuwanderung von Flüchtlingen steigt die Zahl ausländischer Empfänger der Grundsicherung für Arbeitssuchende weiter an.“"
                                            },
                                            {
                                                "example_id": "ad5573cb-80c4-432a-9ae8-3d0f54777267",
                                                "sense_id": "cd49748d-6f08-3c4e-8723-fc96addf462d",
                                                "text": "„Wer wenig [verdient], staatliche Zuschüsse aus der Grundsicherung, Kinderzuschlag und Wohngeld [bezieht], dessen Nettoeinkommen [verringert] sich mit jedem hinzuverdienten Euro, weil die Sozialleistungen entsprechend abgeschmolzen [werden].“"
                                            },
                                            {
                                                "example_id": "63b0a378-0b7f-4243-a28a-84cee7a2cfdb",
                                                "sense_id": "cd49748d-6f08-3c4e-8723-fc96addf462d",
                                                "text": "„Für über 70.000 Rentnerinnen und Rentner in Bayern reicht ihr Einkommen nicht zum Leben. Sie bekommen eine Aufstockung über die Grundsicherung.“"
                                            },
                                            {
                                                "example_id": "89c7d453-d4b5-4c44-9fac-e16770881fc9",
                                                "sense_id": "cd49748d-6f08-3c4e-8723-fc96addf462d",
                                                "text": "„Seit 2003 hat sich die Zahl der Grundsicherung beziehenden Rentner verdoppelt.“"
                                            },
                                            {
                                                "example_id": "34e90a02-de8f-4683-9978-ca9380637a01",
                                                "sense_id": "cd49748d-6f08-3c4e-8723-fc96addf462d",
                                                "text": "„Laut Bundesarbeitsministerium ist ab [einem Mindestlohn von 12,63 Euro] gewährleistet, dass der Betreffende eine Rente über dem Niveau der Grundsicherung erhält.“"
                                            },
                                            {
                                                "example_id": "878a3821-29a3-4bbd-aae7-db36f198ba7d",
                                                "sense_id": "cd49748d-6f08-3c4e-8723-fc96addf462d",
                                                "text": "„Zwangsumzüge für Bezieher von Hartz IV und Grundsicherung sollen ebenso vermieden werden wie Stromsperren.“"
                                            },
                                            {
                                                "example_id": "68f2f569-d8fe-445f-ae48-da98df61b653",
                                                "sense_id": "cd49748d-6f08-3c4e-8723-fc96addf462d",
                                                "text": "„93 Prozent der jüdischen Seniorinnen und Senioren in Deutschland sind auf Grundsicherung angewiesen – im Vergleich zu 2,4 Prozent der deutschen Rentnerinnen und Rentner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
