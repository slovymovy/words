        "fr-extract.jsonl": [
            {
                "entry_id": "b64aad4a-576f-3b2d-b360-6a0cfa273c0c",
                "word": "siamois",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b6238320-3a97-478e-81f4-815bd8a47f07",
                        "entry_id": "b64aad4a-576f-3b2d-b360-6a0cfa273c0c",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "siamoise"
                    },
                    {
                        "form_id": "72afd218-ce03-42bf-845d-61155075aefe",
                        "entry_id": "b64aad4a-576f-3b2d-b360-6a0cfa273c0c",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "siamoises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d05dd360-91fd-3281-a323-e340b3bc9359",
                        "entry_id": "b64aad4a-576f-3b2d-b360-6a0cfa273c0c",
                        "glosses": [
                            "Relatif au Siam."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a16ec68-b3a8-4045-8cd4-c51202ae2255",
                                "sense_id": "d05dd360-91fd-3281-a323-e340b3bc9359",
                                "text": "Sa cathédrale a la couleur de l’abricot et dresse ses coupoles pointues comme des couronnes de princes siamois."
                            },
                            {
                                "example_id": "c369f54b-1ed0-4289-83ce-b04f8b55747a",
                                "sense_id": "d05dd360-91fd-3281-a323-e340b3bc9359",
                                "text": "Timoléon ne mentionne pas les katoï, les travestis qui se produisaient dans des épisodes du Ramakien, version siamoise du Râmâyana."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d8b949e-c9e9-3d84-b7c4-40524a2bb38f",
                        "entry_id": "b64aad4a-576f-3b2d-b360-6a0cfa273c0c",
                        "glosses": [
                            "Qualifie un chat originaire du Siam."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45b9bc47-7ee2-4c82-a604-40f29052ef1b",
                                "sense_id": "1d8b949e-c9e9-3d84-b7c4-40524a2bb38f",
                                "text": "M. du Bujadoux a une chatte siamoise qui était la meilleure affection de défunte Bélisée."
                            }
                        ]
                    },
                    {
                        "sense_id": "51d4fe01-15e8-3f12-857f-492d2dfc7e02",
                        "entry_id": "b64aad4a-576f-3b2d-b360-6a0cfa273c0c",
                        "glosses": [
                            "Qualifie des jumeaux fusionnés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1cafd36-a8a1-4c50-b958-ea519befbef7",
                                "sense_id": "51d4fe01-15e8-3f12-857f-492d2dfc7e02",
                                "text": "Des frères siamois."
                            },
                            {
                                "example_id": "df8c0ef8-ea48-46c6-8bb9-8726647ffc45",
                                "sense_id": "51d4fe01-15e8-3f12-857f-492d2dfc7e02",
                                "text": "Géants et nains, hommes troncs et femmes colosses, enfants à deux têtes et frères siamois ont été exhibés sur nos pistes, mais ils n’y ont pas de rôle actif à l’exception toutefois des nains qui font souvent fonction de clowns."
                            },
                            {
                                "example_id": "caeb424c-6c64-4206-8d95-c26eb8573dbd",
                                "sense_id": "51d4fe01-15e8-3f12-857f-492d2dfc7e02",
                                "text": "... dans d'autres ils se confondaient, devenaient siamois, inséparables."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a241c7c-fbdb-4e17-a393-8f864e5c8cfb",
                        "source_entry_id": "b64aad4a-576f-3b2d-b360-6a0cfa273c0c",
                        "source_sense_description": "Du Siam",
                        "target_lang_word": "Siamese",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Siamese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78675767-6b9f-309b-9343-0e451840cdeb",
                                        "entry_id": "00d27316-4063-373b-a7a4-60fca4bc6b13",
                                        "glosses": [
                                            "Of or relating to Siam; Thai."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
