                                    {
                                        "sense_id": "820ef7c2-4998-3faf-949f-59412b105c92",
                                        "entry_id": "f29d09f2-9853-3b5a-8cc5-f555a3a83260",
                                        "glosses": [
                                            "A small bubble between the layers of the skin that contains watery or bloody fluid and is caused by friction and pressure, burning, freezing, chemical irritation, disease, or infection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ddd8f60-fe45-4a58-9d1c-63d6a757e7cf",
                                                "sense_id": "820ef7c2-4998-3faf-949f-59412b105c92",
                                                "text": "Inspect them for rub marks and blisters; tape or bandage rub marks; clean the skin around a blister, use a sterilised needle to puncture it at its outer edge and press out the fluid, then bandage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7bc434a-e176-3196-9de8-fc9c6a8023bd",
                                        "entry_id": "f29d09f2-9853-3b5a-8cc5-f555a3a83260",
                                        "glosses": [
                                            "A swelling on a plant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d4ed0a4-daac-36ca-852e-31e0e1ff5557",
                                        "entry_id": "f29d09f2-9853-3b5a-8cc5-f555a3a83260",
                                        "glosses": [
                                            "Something applied to the skin to raise a blister; a vesicatory or other applied medicine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fc5d497-fe5a-41d7-afeb-56a8270cb600",
                                                "sense_id": "6d4ed0a4-daac-36ca-852e-31e0e1ff5557",
                                                "text": "'T is written in the Hebrew Chronicle, / How the physicians, leaving pill and potion, / Prescribed, by way of blister, a young belle, / When old King David's blood grew dull in motion, / And that the medicine answered very well […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2c03613-92d5-3243-9040-7aca267e9ca7",
                                        "entry_id": "f29d09f2-9853-3b5a-8cc5-f555a3a83260",
                                        "glosses": [
                                            "A bubble, as on a painted surface."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66ad9881-2051-373d-9c79-d78421bf8fbe",
                                        "entry_id": "f29d09f2-9853-3b5a-8cc5-f555a3a83260",
                                        "glosses": [
                                            "An enclosed pocket of air, which may be mixed with water or solvent vapor, trapped between impermeable layers of felt or between the membrane and substrate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "765d468f-4ae4-371a-abe4-0784a40514db",
                                        "entry_id": "f29d09f2-9853-3b5a-8cc5-f555a3a83260",
                                        "glosses": [
                                            "A type of pre-formed packaging made from plastic that contains cavities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7416f25c-cc28-406b-acd5-a52e79927184",
                                                "sense_id": "765d468f-4ae4-371a-abe4-0784a40514db",
                                                "text": "blister card"
                                            },
                                            {
                                                "example_id": "1ac867d0-4dc0-4114-a63f-4ca17b9e0d06",
                                                "sense_id": "765d468f-4ae4-371a-abe4-0784a40514db",
                                                "text": "blister pack"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fab47f07-c3b9-3c02-a18a-a7f8399dcdfc",
                                        "entry_id": "f29d09f2-9853-3b5a-8cc5-f555a3a83260",
                                        "glosses": [
                                            "A cause of annoyance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fc46a23-3575-4b5d-8475-4853e6ffa533",
                                                "sense_id": "fab47f07-c3b9-3c02-a18a-a7f8399dcdfc",
                                                "text": "I couldn't help thinking how dashed happy I could have contrived to be in this place if only Aunt Agatha and the other blisters had been elsewhere."
                                            },
                                            {
                                                "example_id": "4ddc7ffa-83c5-4e71-8db6-74d6cdcf61ed",
                                                "sense_id": "fab47f07-c3b9-3c02-a18a-a7f8399dcdfc",
                                                "text": "I will say, however, that we fanned her well — her and her old blister of a mother and a bewhiskered old goat named Boris."
                                            },
                                            {
                                                "example_id": "99fbb7d7-4b28-4599-8340-cbba9b32bedf",
                                                "sense_id": "fab47f07-c3b9-3c02-a18a-a7f8399dcdfc",
                                                "text": "'We mustn't laugh about it, my boy. It's no joking matter. It's very wrong to shoot Mr Baxter.'\n'But he's a blister.'\n'He is a blister,' agreed Lord Emsworth, always fairminded. 'Nevertheless. . . . Remember, he is your tutor.'"
                                            },
                                            {
                                                "example_id": "82e6eb43-5b28-41c9-afcd-680147c84d6e",
                                                "sense_id": "fab47f07-c3b9-3c02-a18a-a7f8399dcdfc",
                                                "text": "Willie suddenly realized the heat really wasn't off the criminal persons, and he sprang into action. The blonde blister also recovered surprisingly fast and threw the big wordy tome at the Klump coco ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82a3dc51-0697-36ef-b1ca-7b4d188a6a6f",
                                        "entry_id": "f29d09f2-9853-3b5a-8cc5-f555a3a83260",
                                        "glosses": [
                                            "A form of smelted copper with a blistered surface."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
