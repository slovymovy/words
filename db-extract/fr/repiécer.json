                "senses": [
                    {
                        "sense_id": "dbb1e7f9-97b9-3d6a-a121-10942e2edcba",
                        "entry_id": "c696d421-de11-3fd8-ba6f-82136f7137ec",
                        "glosses": [
                            "Remettre une pièce à, rapiécer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6b2c01b-308d-4e3f-a11b-a34fc2f0078d",
                                "sense_id": "dbb1e7f9-97b9-3d6a-a121-10942e2edcba",
                                "text": "Un bruit sec, c'est le dé, l'étui à aiguilles qui tombent, accompagnés du glissement flou du drap blanc qu'elle était en train de repiécer."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d66b060-9be7-3843-a40f-4a333e9fb2e0",
                        "entry_id": "c696d421-de11-3fd8-ba6f-82136f7137ec",
                        "glosses": [
                            "Piécer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c0f34eb-cbf0-4b53-9a9e-7b59427692d7",
                                "sense_id": "2d66b060-9be7-3843-a40f-4a333e9fb2e0",
                                "text": "On laisse sécher à fond, puis on lisse et l'on repièce de nouveau avec l'épine-vinette, et l'on finit la peau comme à l'ordinaire."
                            }
                        ]
                    }
