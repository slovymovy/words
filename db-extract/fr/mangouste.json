                    }
                ],
                "senses": [
                    {
                        "sense_id": "20231d5d-fc08-3f7a-9704-34c76d5ea095",
                        "entry_id": "7f08a1b1-c166-3195-893d-642f4e64d14e",
                        "glosses": [
                            "Fruit du mangoustan, de la grosseur d’une petite orange et d’une saveur sucrée, légèrement acide avec un parfum de framboise."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4ff46850-b6e0-4a6d-af6c-6d809e5cb0f7",
                                "sense_id": "20231d5d-fc08-3f7a-9704-34c76d5ea095",
                                "text": "Le brave garçon avait acheté quelques douzaines de mangoustes, grosses comme des pommes moyennes, d’un brun foncé au-dehors, d’un rouge éclatant au-dedans,[…]."
                            },
                            {
                                "example_id": "37fb7e74-e371-453c-8195-4fa245e2b02b",
                                "sense_id": "20231d5d-fc08-3f7a-9704-34c76d5ea095",
                                "text": "La mangouste est le fruit préféré de maman, la jambose celui de Kim."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "9074401b-0725-3248-aed2-7fe6636a8a0f",
                "word": "mangouste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2528295b-b522-48b9-a3f0-8a5051c00234",
                        "entry_id": "9074401b-0725-3248-aed2-7fe6636a8a0f",
                        "tags": [
