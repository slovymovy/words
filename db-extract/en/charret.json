                            {
                                "example_id": "747d1e3a-1d8d-4fa4-b6bb-5008a2eda3dc",
                                "sense_id": "27c71170-8119-332b-97c9-a54995650f3e",
                                "text": "The sprete sayde unto Philip: Goo neare and ioyne thysilfe to yonder charet."
                            },
                            {
                                "example_id": "b9679ea6-ed7d-4545-89bf-1f43588a54ad",
                                "sense_id": "27c71170-8119-332b-97c9-a54995650f3e",
                                "text": "His cruell wounds with cruddy bloud congealed,\n They binden vp so wisely, as they may,\n And handle softly, till they can be healed:\n So lay him in her charet, close in night concealed."
                            }
