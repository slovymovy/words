                                            {
                                                "example_id": "0111a65e-36e9-420d-b921-5a26031075f9",
                                                "sense_id": "3ff17cd5-9dd8-3e9b-b4f6-88e2e910f863",
                                                "text": "Madam, I’m gone; no wonder, for you know,\nLovers' encounters are but touch and go."
