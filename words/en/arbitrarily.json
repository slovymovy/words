    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "88523780-717d-327b-ba76-91db914ae5b0",
                    "sense_definition": "In a way that is based on random choice or personal whim rather than any reason or system.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee <w>arbitrarily</w> decided to reject all applications without reviewing them."
                        },
                        {
                            "text": "The winner of the contest was chosen <w>arbitrarily</w> by drawing a name from a hat."
                        }
                    ],
                    "synonyms": [
                        "randomly",
                        "capriciously"
                    ],
                    "antonyms": [
                        "unarbitrarily"
                    ],
                    "common_phrases": [
                        "decided arbitrarily",
                        "chosen arbitrarily"
                    ]
                },
                {
                    "sense_id": "ba530953-a8e5-3d9f-a14e-2c55f088f641",
                    "sense_definition": "To an extent or degree that is not limited or fixed by any specific rule.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can pick an <w>arbitrarily</w> large number for this mathematical calculation."
                        },
                        {
                            "text": "The system allows users to set an <w>arbitrarily</w> high limit on their monthly spending."
                        }
                    ],
                    "common_phrases": [
                        "arbitrarily large",
                        "arbitrarily high"
                    ]
                }
            ]
        }
    ]
