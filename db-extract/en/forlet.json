                        "entry_id": "a295da10-3b2b-3af1-85c2-a6248cdc08aa",
                        "glosses": [
                            "To abandon; give up; leave; leave behind; forsake; desert; neglect."
                        ],
                        "tags": [
                            "UK",
                            "archaic",
                            "dialectal",
