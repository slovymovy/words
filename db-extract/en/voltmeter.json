                "senses": [
                    {
                        "sense_id": "2fd7d33c-1f09-3d7c-952c-e9c61f850fed",
                        "entry_id": "b21f082a-2201-391a-b5a4-e068a97b2b80",
                        "glosses": [
                            "An instrument for measuring electric potential in volts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0656e05f-c993-4599-94c1-4cf14307d554",
                                "sense_id": "2fd7d33c-1f09-3d7c-952c-e9c61f850fed",
                                "text": "Because most diesel failures can be traced to electrical faults, minor in themselves but often difficult to pin-point, any unscheduled halt during a trial run is often the signal for the frenzied unfolding of wiring diagrams and the appearance of an impressive array of voltmeters and circuit testers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85f35f82-99a3-43dc-82fb-84957a2be78d",
                        "source_entry_id": "b21f082a-2201-391a-b5a4-e068a97b2b80",
                        "source_sense_id": "2fd7d33c-1f09-3d7c-952c-e9c61f850fed",
                        "source_sense_description": "instrument for measuring electric potential",
                        "target_lang_word": "voltmetr",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voltmetr",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "3df2e3ad-def9-3149-9e6f-9ae9c5feacd7",
                                        "entry_id": "b8201a1d-2c7d-3e80-b553-a1e951bfd9c4",
                                        "glosses": [
                                            "přístroj na měření elektrického napětí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acffa48a-5614-4e9c-b774-544845238fd9",
                                                "sense_id": "3df2e3ad-def9-3149-9e6f-9ae9c5feacd7",
                                                "text": "Jaký by to byl radiotelegrafista, kdyby neměl stále u sebe kapesní voltmetr, spíše by zapomněl na hodinky!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eecea986-f339-410e-8a64-36774e207a36",
                        "source_entry_id": "b21f082a-2201-391a-b5a4-e068a97b2b80",
                        "source_sense_id": "2fd7d33c-1f09-3d7c-952c-e9c61f850fed",
                        "source_sense_description": "instrument for measuring electric potential",
                        "target_lang_word": "voltmètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voltmètre",
