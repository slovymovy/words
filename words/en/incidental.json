{
    "word_family": [
        "incident",
        "incidentally",
        "incidence"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ffdc5386-11db-30ae-b95b-fe747164b21f",
                    "sense_definition": "Loosely associated or of limited relevance except indirectly; not being a main part of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relevance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The subplots in the novel are <w>incidental</w> to the main story of the protagonist.",
                            "target_lang_translations": {
                                "ru": "Побочные сюжетные линии в романе являются <w>второстепенными</w> по отношению к основной истории главного героя."
                            }
                        },
                        {
                            "text": "He provided some <w>incidental</w> information that was not strictly necessary for the report.",
                            "target_lang_translations": {
                                "ru": "Он предоставил некоторую <w>несущественную</w> информацию, которая не была строго необходима для отчета."
                            }
                        }
                    ],
                    "synonyms": [
                        "contingent"
                    ],
                    "common_phrases": [
                        "incidental information",
                        "incidental details"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабо связанный или имеющий ограниченное отношение к делу; не являющийся основной частью чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "второстепенный",
                                "target_lang_sense_clarification": "не основной"
                            },
                            {
                                "target_lang_word": "побочный",
                                "target_lang_sense_clarification": "дополнительный"
                            },
                            {
                                "target_lang_word": "несущественный",
                                "target_lang_sense_clarification": "не имеющий большого значения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91e1032d-b5eb-3462-8be7-42ccc2254f67",
                    "sense_definition": "Happening as a natural but secondary result or consequence of an activity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Minor injuries are often <w>incidental</w> to contact sports like rugby or football.",
                            "target_lang_translations": {
                                "ru": "Незначительные травмы часто <w>сопутствуют</w> контактным видам спорта, таким как регби или футбол."
                            }
                        },
                        {
                            "text": "The <w>incidental</w> costs of owning a car can add up quickly over time.",
                            "target_lang_translations": {
                                "ru": "<w>Сопутствующие</w> расходы на владение автомобилем со временем могут быстро вырасти."
                            }
                        }
                    ],
                    "antonyms": [
                        "inevitable",
                        "necessary"
                    ],
                    "common_phrases": [
                        "incidental to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий как естественный, но вторичный результат или последствие какой-либо деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сопутствующий",
                                "target_lang_sense_clarification": "возникающий вместе с чем-то"
                            },
                            {
                                "target_lang_word": "неизбежно связанный",
                                "target_lang_sense_clarification": "присущий деятельности"
                            },
                            {
                                "target_lang_word": "побочный",
                                "target_lang_sense_clarification": "о расходах или эффектах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90d8c358-2a25-39d4-8e12-a2e099d8db7b",
                    "sense_definition": "Occurring by chance rather than through intention or design.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their meeting at the airport was purely <w>incidental</w> as neither had planned the trip.",
                            "target_lang_translations": {
                                "ru": "Их встреча в аэропорту была чисто <w>случайной</w>, так как никто из них не планировал поездку."
                            }
                        },
                        {
                            "text": "The researcher noted an <w>incidental</w> finding that was unrelated to the primary hypothesis.",
                            "target_lang_translations": {
                                "ru": "Исследователь отметил <w>случайную</w> находку, которая не была связана с основной гипотезой."
                            }
                        }
                    ],
                    "synonyms": [
                        "accidental",
                        "serendipitous"
                    ],
                    "antonyms": [
                        "intentional"
                    ],
                    "common_phrases": [
                        "purely incidental"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий случайно, а не в результате намерения или замысла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайный",
                                "target_lang_sense_clarification": "непреднамеренный"
                            },
                            {
                                "target_lang_word": "эпизодический",
                                "target_lang_sense_clarification": "нерегулярный"
                            },
                            {
                                "target_lang_word": "непредвиденный",
                                "target_lang_sense_clarification": "не запланированный заранее"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c846ebd3-82d1-3bd1-8b16-e87b23902547",
                    "sense_definition": "Minor items or expenses that are not individually specified.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expenses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company budget includes a small amount for <w>incidentals</w> like office supplies.",
                            "target_lang_translations": {
                                "ru": "Бюджет компании включает небольшую сумму на <w>непредвиденные расходы</w>, такие как канцелярские товары."
                            }
                        },
                        {
                            "text": "When traveling for business, you should keep receipts for all your <w>incidentals</w>.",
                            "target_lang_translations": {
                                "ru": "При поездках в командировку следует сохранять чеки на все <w>мелкие расходы</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "incidental expenses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелкие предметы или расходы, которые не указываются отдельно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непредвиденные расходы",
                                "target_lang_sense_clarification": "мелкие траты"
                            },
                            {
                                "target_lang_word": "мелочи",
                                "target_lang_sense_clarification": "незначительные предметы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}