                "senses": [
                    {
                        "sense_id": "c0e12331-1550-3beb-ad92-18c4b3aad71c",
                        "entry_id": "a57ec9d7-8eb5-3850-b6bc-5fa3d4161e12",
                        "glosses": [
                            "Volume d’un contenant exprimé en litres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e130bfac-9a89-4b2c-9696-0c835952bc4a",
                                "sense_id": "c0e12331-1550-3beb-ad92-18c4b3aad71c",
                                "text": "Chez P. Ettori, G. Fénié & Cie : … Vins vieux de Bordeaux à 1 franc. Seuls détenteurs du VIN à VILLENAVE D’ARMON (sic, en fait Villenave-d’Ornon), garanti comme bonne qualité et dont le litrage est de 295 litres par barrique. Prix modéré en gros, au détail, le litre 70 centimes."
                            },
                            {
                                "example_id": "0b4db428-abfc-4aeb-afa1-fb62280d98b8",
                                "sense_id": "c0e12331-1550-3beb-ad92-18c4b3aad71c",
                                "text": "Le litrage est souvent indiqué dans le nom du sac, comme mon Talon 33 (= environ 33 litres, le volume varie en fonction de la taille de dos du sac, par exemple, pour un même modèle, la contenance sera différente entre une taille S et une taille L )."
                            },
                            {
                                "example_id": "adffd57a-d736-4b07-ad74-96584a519a8e",
                                "sense_id": "c0e12331-1550-3beb-ad92-18c4b3aad71c",
                                "text": "Pour les petits poissons la règle est de 1 cm de poissons par litre d’eau réel (litrage théorique moins 20 % qui correspondent à l’épaisseur du verre et au sable)."
                            },
                            {
                                "example_id": "9b0c6c69-0a32-4dcc-b21f-3e804527a280",
                                "sense_id": "c0e12331-1550-3beb-ad92-18c4b3aad71c",
                                "text": "Ce n’est pas tant le chiffrage global du litrage qui importe que la question de l’origine de l’eau : est-ce de l’eau de pluie ou est-ce qu’on a été la puiser ?"
                            }
                        ]
                    }
                ],
