{
    "word_family": [
        "callowness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d68aada2-c519-36b4-a3a9-b5479500641c",
                    "sense_definition": "Lacking life experience; immature, inexperienced, or naive.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "immature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>callow</w> youth made several mistakes during his first week at the new job.",
                            "target_lang_translations": {
                                "tr": "<w>Toy</w> genç, yeni işindeki ilk haftasında birkaç hata yaptı."
                            }
                        },
                        {
                            "text": "His <w>callow</w> remarks showed that he was still <w>wet</w> <w>behind</w> <w>the</w> <w>ears</w> regarding international politics.",
                            "target_lang_translations": {
                                "tr": "<w>Toy</w> yorumları, uluslararası siyaset konusunda henüz yolun başında olduğunu gösteriyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "immature",
                        "inexperienced",
                        "naive",
                        "green",
                        "wet behind the ears"
                    ],
                    "antonyms": [
                        "experienced"
                    ],
                    "common_phrases": [
                        "wet behind the ears"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hayat tecrübesinden yoksun; olgunlaşmamış, deneyimsiz veya saf."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "toy",
                                "target_lang_sense_clarification": "Genç ve deneyimsiz kişiler için kullanılan en yaygın ifade."
                            },
                            {
                                "target_lang_word": "deneyimsiz",
                                "target_lang_sense_clarification": "Bir konuda tecrübesi olmayan."
                            },
                            {
                                "target_lang_word": "ham",
                                "target_lang_sense_clarification": "Gelişimini tamamlamamış, olgunlaşmamış."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e3ec722-c228-3339-92ca-56879daf141d",
                    "sense_definition": "Of a young bird or animal: having not yet developed feathers, fur, or hair.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "unfledged",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother bird brought worms to her <w>callow</w> chicks in the nest.",
                            "target_lang_translations": {
                                "tr": "Anne kuş, yuvadaki <w>tüysüz</w> yavrularına solucan getirdi."
                            }
                        },
                        {
                            "text": "The <w>callow</w> young were still completely featherless and relied entirely on their parents for warmth.",
                            "target_lang_translations": {
                                "tr": "<w>Tüysüz</w> yavrular henüz tamamen çıplaktı ve ısınmak için tamamen ebeveynlerine bağımlıydılar."
                            }
                        }
                    ],
                    "synonyms": [
                        "unfledged",
                        "featherless",
                        "hairless"
                    ],
                    "target_lang_definitions": {
                        "tr": "Genç kuş veya hayvanlar için: henüz tüyleri veya kürkü çıkmamış."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tüysüz",
                                "target_lang_sense_clarification": "Henüz tüyleri çıkmamış yavru kuşlar için."
                            },
                            {
                                "target_lang_word": "yavru",
                                "target_lang_sense_clarification": "Henüz gelişmemiş, bakıma muhtaç hayvan."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1ac2179-a811-3ed4-9cfe-0cc1f6afe603",
                    "sense_definition": "A person lacking life experience; an immature or naive person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "immature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The experienced manager had little patience for the <w>callow</w> who thought they knew everything.",
                            "target_lang_translations": {
                                "tr": "Deneyimli müdür, her şeyi bildiğini sanan <w>toy</w> kişilere karşı pek sabırlı değildi."
                            }
                        },
                        {
                            "text": "He was just a <w>callow</w> who had never faced real hardship in his life.",
                            "target_lang_translations": {
                                "tr": "O, hayatında hiç gerçek zorlukla karşılaşmamış <w>toy</w> birinden ibaretti."
                            }
                        }
                    ],
                    "synonyms": [
                        "novice",
                        "greenhorn"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hayat tecrübesi olmayan kişi; olgunlaşmamış veya saf kimse."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "toy kimse",
                                "target_lang_sense_clarification": "Deneyimsiz, acemi kişi."
                            },
                            {
                                "target_lang_word": "acemi",
                                "target_lang_sense_clarification": "Bir işte yeni olan, tecrübesiz."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "670c6d32-2603-303d-aa42-dfb88345977c",
                    "sense_definition": "A low-lying meadow near a river that is regularly submerged by floodwaters.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "meadow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cattle grazed on the <w>callows</w> until the winter floods arrived.",
                            "target_lang_translations": {
                                "tr": "Sığırlar, kış selleri gelene kadar <w>taşkın ovalarında</w> otladılar."
                            }
                        },
                        {
                            "text": "The river overflowed its banks and turned the nearby <w>callows</w> into a temporary lake.",
                            "target_lang_translations": {
                                "tr": "Nehir yatağından taştı ve yakındaki <w>taşkın ovalarını</w> geçici bir göle dönüştürdü."
                            }
                        }
                    ],
                    "synonyms": [
                        "flood meadow",
                        "water meadow"
                    ],
                    "common_phrases": [
                        "river callows"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in Ireland and parts of England."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Nehir kenarında, düzenli olarak sel suları altında kalan alçak çayır."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "taşkın ovası",
                                "target_lang_sense_clarification": "Nehirlerin taşmasıyla oluşan sulak alan."
                            },
                            {
                                "target_lang_word": "sulak çayır",
                                "target_lang_sense_clarification": "Sık sık su altında kalan otlak."
                            }
                        ]
                    }
                }
            ]
        },
        {
