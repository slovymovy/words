                "senses": [
                    {
                        "sense_id": "788d2f83-c9eb-343e-b74b-871d393d8ebe",
                        "entry_id": "c3e0fd0a-a055-3bed-87c3-95ba511b4d8f",
                        "glosses": [
                            "größeres Anwesen auf dem Land, oft mit Ländereien und landwirtschaftlichem Betrieb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dc29e50-45cd-47f9-a008-898a202ebe26",
                                "sense_id": "788d2f83-c9eb-343e-b74b-871d393d8ebe",
                                "text": "Der Baron besitzt ein großes Landgut, auf dem auch Wein angebaut wird."
                            },
                            {
                                "example_id": "fcf0a811-5e3c-4538-b0f3-c36a367afc7c",
                                "sense_id": "788d2f83-c9eb-343e-b74b-871d393d8ebe",
                                "text": "„Wer ein Landgut hatte, zog dorthin.“"
                            },
                            {
                                "example_id": "2cb455de-dd86-46a2-b695-c30509aab908",
                                "sense_id": "788d2f83-c9eb-343e-b74b-871d393d8ebe",
                                "text": "„Dann gab er auf seinem Landgut allen Handwerkern, die dort arbeiteten, einen Festschmaus.“"
                            },
                            {
                                "example_id": "bf5ee9ac-c44c-4a69-9753-88e3176e4e5e",
                                "sense_id": "788d2f83-c9eb-343e-b74b-871d393d8ebe",
                                "text": "„Sie erwiderte, wenn ich sie wirklich liebe, solle ich doch ein Landgut im Königreich Neapel kaufen; dann würde sie dort mit mir wohnen, ohne zu verlangen, daß ich sie heirate, außer wenn sie mir Kinder schenke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
