                "senses": [
                    {
                        "sense_id": "f642fa18-3c86-3f1e-b1c0-8dad5f5ce993",
                        "entry_id": "5751a3c5-8cb4-3370-956c-3b7b68052880",
                        "glosses": [
                            "kleiner doppelstöckiger Wagen zum Organisieren, Abstellen oder Transportieren von Speisen oder Geschirr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2242972c-01cc-4c49-be06-7d3d7110948a",
                                "sense_id": "f642fa18-3c86-3f1e-b1c0-8dad5f5ce993",
                                "text": "Die Teewagen stehen vor dem Krankenbett."
                            },
                            {
                                "example_id": "8a9f94d3-d59d-4f75-bf8d-6239f4949be1",
                                "sense_id": "f642fa18-3c86-3f1e-b1c0-8dad5f5ce993",
                                "text": "Schieb bitte den Teewagen zur Seite."
                            },
                            {
                                "example_id": "38c5f0b5-3110-4b40-99e7-fc9ead922f45",
                                "sense_id": "f642fa18-3c86-3f1e-b1c0-8dad5f5ce993",
                                "text": "„Die paar hübschen Sachen, die wir haben, Stühle, ein paar Vasen und der Teewagen in der Ecke, hat Marie gekauft.“"
                            },
                            {
                                "example_id": "1e538aca-b260-430a-9920-d221dacc2ba0",
                                "sense_id": "f642fa18-3c86-3f1e-b1c0-8dad5f5ce993",
                                "text": "„Das Dienstmädchen kam mit dem Teewagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
