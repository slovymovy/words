                    }
                ],
                "translations": [
                    {
                        "translation_id": "3acaabce-9a82-4f46-8dbd-39834d29c9ff",
                        "source_entry_id": "9f266a38-d42c-3366-80e1-fd509fa321d0",
                        "source_sense_id": "2aae3455-beeb-3d90-a767-4053536a595b",
                        "target_lang_word": "languor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "languor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9004a1aa-0c13-3230-bdc3-73877a7e16aa",
                                        "entry_id": "b072a133-6409-3588-8abe-70fcad531b5c",
                                        "glosses": [
                                            "A state of the body or mind caused by exhaustion or disease and characterized by a languid or weary feeling; lassitude; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b28a2dc9-0695-4ad6-85ee-6a903d4598ff",
                                                "sense_id": "9004a1aa-0c13-3230-bdc3-73877a7e16aa",
                                                "text": "languor of convalescence"
                                            },
                                            {
                                                "example_id": "3f55d506-4d28-45c6-a1c0-e2f0fadb2b08",
                                                "sense_id": "9004a1aa-0c13-3230-bdc3-73877a7e16aa",
                                                "text": "Sometimes my pulse beat so quickly and hardly, that I felt the palpitation of every artery; at others, I nearly sank to the ground through languor and extreme weakness."
                                            },
                                            {
                                                "example_id": "cdb59711-824d-46e7-baf6-5df221d1bd95",
                                                "sense_id": "9004a1aa-0c13-3230-bdc3-73877a7e16aa",
                                                "text": "As the opinion announcements have stretched past the half-hour mark, some in the public gallery exhibit a bit of languor, but they perk up when [U.S. Supreme Court Justice Elena] Kagan begins discussing western gray squirrels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39cc57b4-d115-3802-9439-f1b86bc844a8",
                                        "entry_id": "b072a133-6409-3588-8abe-70fcad531b5c",
                                        "glosses": [
                                            "Melancholy caused by lovesickness, sadness, etc.; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d34105f2-92d3-30a5-ae0b-da7362901b95",
                                        "entry_id": "b072a133-6409-3588-8abe-70fcad531b5c",
                                        "glosses": [
                                            "Dullness, sluggishness; lack of vigour; stagnation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e06abb7-58d5-468d-9e72-cfa132ce7eb5",
                                                "sense_id": "d34105f2-92d3-30a5-ae0b-da7362901b95",
                                                "text": "I rushed towards her, and embraced her with ardour; but the deathly languor and coldness of the limbs told me, that what I now held in my arms had ceased to be the Elizabeth whom I had loved and cherished."
                                            },
                                            {
                                                "example_id": "53a22620-f256-470f-96f0-5140a21595b3",
                                                "sense_id": "d34105f2-92d3-30a5-ae0b-da7362901b95",
                                                "text": "From languor she passed to the lightest vivacity; her temper became merry and wild in the extreme; she was all at once a tease, a tomboy, and a witch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b20aa01-8995-3ee8-92a8-a688455c334e",
                                        "entry_id": "b072a133-6409-3588-8abe-70fcad531b5c",
                                        "glosses": [
                                            "Listless indolence or inactivity, especially if enjoyable or relaxing; dreaminess; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cee117d-203c-4266-9794-9aa1201bf481",
                                                "sense_id": "8b20aa01-8995-3ee8-92a8-a688455c334e",
                                                "text": "It is earth's brief breathing space, after the heat and hurry of her busier time; like that repose known only to the young and happy, when the nerves gradually compose themselves, the thoughts gather into some vague but delicious train, and the eyes are closed by languor before sleep."
                                            },
                                            {
                                                "example_id": "81ad8403-8c62-4f49-9e57-b562f282660b",
                                                "sense_id": "8b20aa01-8995-3ee8-92a8-a688455c334e",
                                                "text": "The languor of Youth—how unique and quintessential it is! How quickly, how irrecoverably lost! The zest, the generous affections, the illusions, the despair, all the traditional attributes of Youth—all save this—come and go with us through life; [...] but languor—the relaxation of yet unwearied sinews, the mind sequestered and self-regarding, the sun standing still in the heavens and the earth throbbing to our own pulse—that belongs to Youth alone and dies with it."
                                            },
                                            {
                                                "example_id": "65754ccb-6fce-4cf4-897b-5e0dafa7e28d",
                                                "sense_id": "8b20aa01-8995-3ee8-92a8-a688455c334e",
                                                "text": "Repose! The very word has a nostalgic ring to it, conjuring up a vanished world of pale solitude, gentle distances, summer vistas, languour, and lovely women …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a24ccf5d-1b35-3fed-aaea-c3f0259b7ca9",
                                        "entry_id": "b072a133-6409-3588-8abe-70fcad531b5c",
                                        "glosses": [
                                            "Heavy humidity and stillness of the air."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33200253-02ae-4209-87e1-0202811ff0f6",
                                                "sense_id": "a24ccf5d-1b35-3fed-aaea-c3f0259b7ca9",
                                                "text": "There is a languor in the air which encourages your own, and the poetry of memory is in every drooping flower and falling leaf."
                                            },
                                            {
                                                "example_id": "db180e1f-c4a1-4d21-91ee-e65a0c07eeda",
                                                "sense_id": "a24ccf5d-1b35-3fed-aaea-c3f0259b7ca9",
                                                "text": "[A] certain languor in the air hinted at an early summer."
                                            },
                                            {
                                                "example_id": "13e340b8-7c21-4e0d-ad73-99e030a5b630",
                                                "sense_id": "a24ccf5d-1b35-3fed-aaea-c3f0259b7ca9",
                                                "text": "The evening was mild, with a certain languor in the air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "603f3d16-0e06-34c4-a320-e1f4042d9098",
                                        "entry_id": "b072a133-6409-3588-8abe-70fcad531b5c",
                                        "glosses": [
                                            "Sorrow; suffering; also, enfeebling disease or illness; (countable, obsolete) an instance of this."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "languor",
