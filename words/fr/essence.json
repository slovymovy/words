            "senses": [
                {
                    "sense_id": "2904cd46-e08b-38a3-a9b2-1240b7305f33",
                    "sense_definition": "Carburant liquide issu du pétrole raffiné, utilisé pour alimenter les moteurs à explosion.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "combustible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'arrête à la station pour prendre de l'<w>essence</w> avant son départ."
                        },
                        {
                            "text": "Notre voiture est tombée en panne d'<w>essence</w> au milieu de la campagne."
                        }
                    ],
                    "synonyms": [
                        "carburant"
                    ],
                    "common_phrases": [
                        "panne d'essence",
                        "prix de l'essence",
                        "moteur à essence",
                        "faire le plein d'essence"
                    ]
                },
                {
                    "sense_id": "8befc2b6-ce63-3e74-b4c5-89cfe64a6268",
                    "sense_definition": "Huile aromatique et volatile extraite de végétaux, employée en parfumerie ou en pharmacie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "extrait_vegetal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quelques gouttes d'<w>essence</w> de lavande suffisent à parfumer agréablement toute la maison."
                        },
                        {
                            "text": "Ce parfumeur réputé utilise une <w>essence</w> rare venue d'Italie."
                        }
                    ],
                    "synonyms": [
                        "huile essentielle"
                    ],
                    "common_phrases": [
                        "essence de lavande",
                        "essence végétale"
                    ]
                },
                {
                    "sense_id": "9d3cfe78-a07c-3857-86fa-5fff7524eec4",
                    "sense_definition": "Ce qui constitue la nature profonde, fondamentale et invariable d'un être ou d'une chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La liberté d'expression constitue l'<w>essence</w> même d'une véritable démocratie."
                        },
                        {
                            "text": "L'être humain est par <w>essence</w> un animal social qui recherche la compagnie."
                        }
                    ],
                    "synonyms": [
                        "nature",
                        "substance"
                    ],
                    "antonyms": [
                        "accident",
                        "existence"
                    ],
                    "common_phrases": [
                        "par essence"
                    ]
                },
                {
                    "sense_id": "30fb65c5-7575-3182-98e2-50f15e444b45",
                    "sense_definition": "Espèce ou variété d'arbre forestier, notamment exploitée pour son bois.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chêne et le hêtre sont les principales <w>essences</w> de notre région."
                        },
                        {
                            "text": "Les gardes forestiers sélectionnent une <w>essence</w> bien adaptée au sol local."
                        }
                    ],
                    "synonyms": [
                        "espèce",
                        "variété"
                    ],
                    "common_phrases": [
                        "essence forestière",
                        "essence d'arbre"
                    ]
                }
            ]
        }
