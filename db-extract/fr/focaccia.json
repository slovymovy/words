                                    {
                                        "sense_id": "90cc56eb-6ff8-3315-a465-52b4dfd35c37",
                                        "entry_id": "0546e012-e0df-36ac-aa25-1f4ad93e6eda",
                                        "glosses": [
                                            "italienisches (ligurisches) Fladenbrot, das aus einem Hefeteig hergestellt wird und mit diversen Zutaten wie Kräutern, Zwiebeln, Oliven und weiteren belegt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f75ff74b-4312-4fe1-95b1-10f2ab608547",
                                                "sense_id": "90cc56eb-6ff8-3315-a465-52b4dfd35c37",
                                                "text": "Beim Grillfest steuerte Onkel August seine legendären Focaccias bei."
                                            },
                                            {
                                                "example_id": "4ffd2e40-d7e9-4774-b662-0526553f7f55",
                                                "sense_id": "90cc56eb-6ff8-3315-a465-52b4dfd35c37",
                                                "text": "Beim Grillfest im vergangenen Monat steuerte Tante Meta ihre legendären Focacce bei."
                                            },
                                            {
                                                "example_id": "007a2a64-951d-40ea-808e-9e0e4acc1070",
                                                "sense_id": "90cc56eb-6ff8-3315-a465-52b4dfd35c37",
                                                "text": "Und wie jedes Mal stritten Onkel August und Tante Meta darum, ob es nun Focaccias oder Focacce heißt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7ffbb68-3405-4c9a-93a1-865f9e3b5636",
                        "source_entry_id": "6bc1b6ef-6fea-353f-bec6-0ce0a055b56d",
                        "source_sense_id": "bf0c5764-47ec-3560-99b3-30bc21db0856",
