                    {
                        "sense_id": "c81b6094-332b-3e85-8cac-374d99fb8b68",
                        "entry_id": "1abeec50-4809-3e83-81d1-51f2dd6910c3",
                        "glosses": [
                            "ein Gebiet, das jemandem ideale Voraussetzungen und Entfaltungsmöglichkeiten für seine Lieblingsbeschäftigung bietet"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "00db06ab-8620-4932-a599-80f133193d23",
                                "sense_id": "c81b6094-332b-3e85-8cac-374d99fb8b68",
                                "text": "Südtirol ist ein Dorado für Wanderer und Bergsteiger."
                            },
                            {
                                "example_id": "b9f26fc8-19f9-445f-a832-38e0bd681ab8",
                                "sense_id": "c81b6094-332b-3e85-8cac-374d99fb8b68",
                                "text": "„Manching hingegen blieb ein Dorado für Altertumsforscher.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
