                        "examples": [
                            {
                                "example_id": "c61693e3-f8f6-4706-aac8-4ec6858e8814",
                                "sense_id": "323cb2f3-5207-3c8d-8108-b1599f5d5ff1",
                                "text": "„Er schaltete die Stereoanlage an, stellte einen Klassiksender ein und fing an, zu Schostakowitschs Symphonie Nr. 8 in c-Moll hin und her durchs Wohnzimmer zu marschieren.“"
                            },
                            {
                                "example_id": "28f41502-c60d-4c34-8ce4-025ceb3fe18f",
                                "sense_id": "323cb2f3-5207-3c8d-8108-b1599f5d5ff1",
                                "text": "„Auf dem Klavier waren die Noten eines Mozart-Stücks aufgeschlagen, und das Radio in der Küche spielte leise einen Klassiksender.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
