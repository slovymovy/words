                "senses": [
                    {
                        "sense_id": "c2ae9321-ceac-3243-b230-a87a0a080749",
                        "entry_id": "1d2ac0e3-af02-3a84-b4fa-89f1a1e62087",
                        "glosses": [
                            "Prévenir de la présence de quelque chose en avance grâce à une signalisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d0267f2-0124-4ba6-9bf6-62f186f53b23",
                                "sense_id": "c2ae9321-ceac-3243-b230-a87a0a080749",
                                "text": "La Prévention rurale vous recommande de présignaliser tous vos véhicules (camions, tracteurs, voitures de tourisme, etc..) dès l'instant où vous êtes dans dans l'obligation de vous arrêter en bordure d'une route dépourvue de bas-côté praticable."
                            },
                            {
                                "example_id": "13fc279f-9d76-4be8-90e3-5d30b8627a76",
                                "sense_id": "c2ae9321-ceac-3243-b230-a87a0a080749",
                                "text": "Ce qui est quand même un peu ridicule avec les radars automatiques, c'est qu'en France on est l'un des seuls (voir le seul) pays à présignaliser le radar !"
                            }
                        ]
                    }
                ],
