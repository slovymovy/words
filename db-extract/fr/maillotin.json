            {
                "entry_id": "5daa874f-2ef9-366f-85bd-6da5864b025c",
                "word": "maillotin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8531eedc-d659-4a81-87d5-36111069b95f",
                        "entry_id": "5daa874f-2ef9-366f-85bd-6da5864b025c",
                        "tags": [
                            "plural"
                        ],
                        "form": "maillotins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "37cb0473-771e-3af7-a80f-e427768c7529",
                        "entry_id": "5daa874f-2ef9-366f-85bd-6da5864b025c",
                        "glosses": [
                            "Arme semblable à un maillet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19fea8df-9c7b-42e4-a4d2-8b73c99cd8eb",
                                "sense_id": "37cb0473-771e-3af7-a80f-e427768c7529",
                                "text": "Amaury saisit un gong d’aluminium qu’il frappa par trois fois d’un maillotin d’iridium, produisant un son pas tout à fait cristallin qui flotta un long instant dans l’air."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b7c5acc-28fb-34c4-b3f0-df1e1598c897",
                        "entry_id": "5daa874f-2ef9-366f-85bd-6da5864b025c",
                        "glosses": [
                            "Insurgé parisien du XIVᵉ siècle, équipé de cette arme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f9c2853-b68a-4fa3-8f81-3d925c9b7289",
                                "sense_id": "2b7c5acc-28fb-34c4-b3f0-df1e1598c897",
                                "text": "Depuis l’émancipation des communes, depuis la révolte des maillotins, voilà sept siècles que vous attendez !"
                            },
                            {
                                "example_id": "3efdf811-159e-4b2a-9983-f17cd7134ad5",
                                "sense_id": "2b7c5acc-28fb-34c4-b3f0-df1e1598c897",
                                "text": "Le XIVᵉ siècle […] s’affaisse dans le sang avec les désastres de Crécy et de Poitiers, les excès furieux des Jacques et des Maillotins, les brigandages des Tard-venus, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "992feef3-f2d8-3fef-8157-178ee1cf8e13",
                        "entry_id": "5daa874f-2ef9-366f-85bd-6da5864b025c",
                        "glosses": [
                            "Sorte de pressoir à olives."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0da2bc34-4b33-42f1-841e-0f9c9272c637",
                                "sense_id": "992feef3-f2d8-3fef-8157-178ee1cf8e13",
                                "text": "Dans la partie centrale de l’édifice se dresse une tour où se trouve la maillotin avec la viga -le madrier- car au XIXème siècle, la molienda -broyage et pressage- s’effectue sur le lieu même de la récolte."
                            }
                        ]
                    }
                ],
