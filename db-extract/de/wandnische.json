                                        ]
                                    },
                                    {
                                        "sense_id": "b80da12f-9aff-3f30-b60d-852488edcfd3",
                                        "entry_id": "7ee0767a-06f7-3108-a698-76674a71e3a4",
                                        "glosses": [
