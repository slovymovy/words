                        "target_lang_word": "jokerteken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2435eaf1-c740-4c16-96cc-a4f5d7f7fb2c",
                        "source_entry_id": "9c799944-9a96-3711-be07-4692071bab07",
                        "source_sense_description": "special character",
                        "target_lang_word": "joker",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joker",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8b82b27-74bb-3333-8c13-6313de30408a",
                                        "entry_id": "a5adf3b3-6299-35f6-810d-e03322218c01",
                                        "glosses": [
                                            "Carte qui peut prendre à certains jeux n’importe quelle valeur, selon la volonté de celui qui la détient."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86360e91-b4ec-45bb-9126-a430adf20819",
                                                "sense_id": "c8b82b27-74bb-3333-8c13-6313de30408a",
                                                "text": "Ainsi du joker dans le jeu de cartes ou de l'avantage d'une pièce dans le jeu des échecs pour rétablir l'équilibre entre deux joueurs d'inégale force."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e217215b-2787-3efe-9d2d-3e0c27ec6d15",
                                        "entry_id": "a5adf3b3-6299-35f6-810d-e03322218c01",
                                        "glosses": [
                                            "Lettre blanche à laquelle on peut désigner l’identité de n’importe quelle lettre."
                                        ],
                                        "tags": [
                                            "Scrabble"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41cc7567-c5d1-3f6c-8a0d-26fb2a2550a8",
                                        "entry_id": "a5adf3b3-6299-35f6-810d-e03322218c01",
                                        "glosses": [
                                            "Avantage quelconque que l’on emploie si besoin est."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e17680e-d2eb-412f-b515-5f6013b7ae66",
                                                "sense_id": "41cc7567-c5d1-3f6c-8a0d-26fb2a2550a8",
                                                "text": "Avancer un joker, donner son joker, refuser de répondre à une question."
                                            },
                                            {
                                                "example_id": "15a661f2-a8bb-48c3-b340-7a84d7299ca4",
                                                "sense_id": "41cc7567-c5d1-3f6c-8a0d-26fb2a2550a8",
                                                "text": "Sortir son joker, se sortir d’une situation embarrassante par un moyen inattendu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "021cfe37-ca51-3e69-aee7-2f688eb8dce4",
                                        "entry_id": "a5adf3b3-6299-35f6-810d-e03322218c01",
                                        "glosses": [
                                            "Métacaractère passe-partout, utilisé pour désigner un caractère quelconque, comme le point dans /file.*/ dans les expressions rationnelles, ou un ou plusieurs caractères quelconques, comme l’astérisque dans *.txt sur un shell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "425efeae-78d2-4f41-a1e0-bfad96c733c1",
                                                "sense_id": "021cfe37-ca51-3e69-aee7-2f688eb8dce4",
                                                "text": "Dans le cadre d’une recherche par mots-clés également, les troncatures sont des signes permettant de remplacer un ou plusieurs caractères d’un mot par un astérisque ou par une lettre « joker »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "023b2d98-e187-3a20-a13d-f18ad3547f8b",
                                        "entry_id": "a5adf3b3-6299-35f6-810d-e03322218c01",
                                        "glosses": [
                                            "(Audiovisuel) Personne choisie pour en remplacer une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06482d5f-6723-44a4-8153-83621cede207",
                                                "sense_id": "023b2d98-e187-3a20-a13d-f18ad3547f8b",
                                                "text": "Après avoir fait ses armes pendant neuf ans à LCI, il devient joker à la présentation des journaux du week-end de TF1 durant l'été 2006."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "joker",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "625086a7-4625-3f77-93f7-2aa5a58fe3cb",
                                        "entry_id": "d4da65b1-127e-398f-a1b8-ccf8855fede5",
                                        "glosses": [
                                            "Plaisanter, blaguer."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a0286ee-a23d-4ebc-9526-83eab74d784b",
                                                "sense_id": "625086a7-4625-3f77-93f7-2aa5a58fe3cb",
                                                "text": "Tu jokes, là ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61aa6718-bb66-42ff-89f8-96d24661f640",
                        "source_entry_id": "9c799944-9a96-3711-be07-4692071bab07",
                        "source_sense_description": "special character",
                        "target_lang_word": "Platzhalter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Platzhalter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2415039a-9032-320d-a137-53deac50b871",
                                        "entry_id": "7054a115-2470-3f76-b62a-00d5a7d2a125",
                                        "glosses": [
                                            "allgemein: Person, die für eine andere einen Platz freihält"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1aa0e9f7-5339-3c30-af00-da13739d5d19",
                                        "entry_id": "7054a115-2470-3f76-b62a-00d5a7d2a125",
                                        "glosses": [
                                            "grammatische Einheit in einem übergeordneten Teilsatz, die auf etwas im untergeordneten Teilsatz hinweist, selbst keine eigene Bedeutung hat und in vielen Fällen auch einfach weggelassen werden kann."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e174a173-702b-4256-b049-f1ab83e6cfef",
                                                "sense_id": "1aa0e9f7-5339-3c30-af00-da13739d5d19",
                                                "text": "Der Platzhalter \"es\" in dem Satz \"Es ist richtig, dass du kommen willst\" weist auf den untergeordneten Teilsatz (= Nebensatz) \"dass du kommen willst\" hin und wird ausgelassen, wenn die Stellung der Wortgruppen verändert wird: \"Dass du kommen willst, ist richtig.\" Das \"es\" ist in diesem Fall an die erste Position gebunden."
                                            },
                                            {
                                                "example_id": "fd807076-e113-4fbe-b1eb-ee25f1c6eeff",
                                                "sense_id": "1aa0e9f7-5339-3c30-af00-da13739d5d19",
                                                "text": "Auch Pronominaladverbien werden oft als Platzhalter verwendet und können meist ausgelassen werden: \"Wir freuen uns darüber, dass du kommst.\" Der Platzhalter \"darüber\" kann problemlos ausgelassen werden."
                                            },
                                            {
                                                "example_id": "a5b5cdcf-6e65-42d0-abf2-df395880591f",
                                                "sense_id": "1aa0e9f7-5339-3c30-af00-da13739d5d19",
                                                "text": "„Man spricht dann von einen Vorfeldplatzhalter oder meist kürzer von einem Platzhalter.“"
                                            },
                                            {
                                                "example_id": "d9dbd190-d70a-4884-a8c7-eb3bfbc5e5db",
                                                "sense_id": "1aa0e9f7-5339-3c30-af00-da13739d5d19",
                                                "text": "„Wir unterscheiden zunächst nach unterordnenden und gleichordnenden Verknüpfungsmitteln und werden dann die sogenannten Vertreterelement, oft Platzhalter genannt, behandeln…“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "94e34199-519e-324a-805f-38829f70f577",
                                        "entry_id": "7054a115-2470-3f76-b62a-00d5a7d2a125",
                                        "glosses": [
                                            "ein Zeichen oder eine Zeichenkette, die stellvertretend für etwas steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff973d36-06cc-44e1-910a-ea791064e729",
                                                "sense_id": "94e34199-519e-324a-805f-38829f70f577",
                                                "text": "„Dort, wo, aus welchem Grunde auch immer, im Schriftbild Buchstaben ausgelassen sind, oder beim Lesen und Sprechen Laute, da ist – quasi als Platzhalter und zum Zeichen des Tilgens – ein Apostroph zu setzen, zu schreiben, zu drucken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b401f377-7336-37f7-a251-e62c4b13a22d",
                                        "entry_id": "7054a115-2470-3f76-b62a-00d5a7d2a125",
                                        "glosses": [
                                            "Name für eine Leerstelle in einem logischen oder mathematischen Ausdruck"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
