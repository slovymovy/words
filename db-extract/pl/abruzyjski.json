                        "entry_id": "0fcd4792-60ed-3381-8e62-cc49a5e6a86d",
                        "glosses": [
                            "związany z Abruzją"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fc056ad-aaeb-4aec-99ee-6c4ec8bb4558",
                                "sense_id": "a05e3d86-a012-34ff-b858-3027a0749f39",
                                "text": "Jedną z abruzyjskich atrakcji są festyny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
