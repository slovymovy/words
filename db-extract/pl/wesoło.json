                                            {
                                                "example_id": "eebbf82f-29c3-4fbc-85f2-019fd7dc1ab4",
                                                "sense_id": "467f0082-4944-3da5-bd6c-4c8d9d46ff31",
                                                "text": "Ze is gelukkig vaak vrolijk."
                                            },
                                            {
                                                "example_id": "b981e0b2-7681-46e7-af62-9c2ad2d82636",
                                                "sense_id": "467f0082-4944-3da5-bd6c-4c8d9d46ff31",
                                                "text": "In de jaren vijftig en zestig was de Nationale 7 ook de vrolijkste weg van Frankrijk, de route des vacances voor miljoenen Fransen die voor het eerst op vakantie naar het Zuiden konden."
                                            },
                                            {
                                                "example_id": "10df0c3d-9f2f-4c69-8661-bf89fdf88d0a",
                                                "sense_id": "467f0082-4944-3da5-bd6c-4c8d9d46ff31",
                                                "text": "‘How can I help you sir? Today’s special is the Caesar salad,’ zei een vrolijke jonge vrouw die niet helemaal in haar uniform paste."
                                            },
                                            {
                                                "example_id": "106872a9-4438-4a66-8dca-bf58e627cc46",
                                                "sense_id": "467f0082-4944-3da5-bd6c-4c8d9d46ff31",
                                                "text": "Het is nooit te laat om aan jezelf te werken en het blijft altijd een keuze of je knorrig of vrolijk door het leven wilt gaan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9577caf0-0727-4c01-a605-9a79d7513611",
                        "source_entry_id": "9ca33078-4399-3b5d-b5a2-29d7f7474d08",
                        "source_sense_id": "5beb41be-53e8-3ba6-8994-b658b34ef219",
                        "target_lang_word": "весело",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "весело",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "103ef43f-6947-30aa-aee5-43a4ba712ca5",
                                        "entry_id": "2798ffb8-6bf3-3e38-9df8-da337204361f",
                                        "glosses": [
                                            "наречие к весёлый; радостно, оживлённо, со смехом"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2409e45d-5724-4dae-95cb-9a8178e258ba",
                                                "sense_id": "103ef43f-6947-30aa-aee5-43a4ba712ca5",
                                                "text": "Путешествие продолжалось и благополучно, и весело, а по приезде в Москву и суетно, и хлопотно."
                                            },
                                            {
                                                "example_id": "3d40d4df-9a31-4a5e-9d65-8e5ca89fda63",
                                                "sense_id": "103ef43f-6947-30aa-aee5-43a4ba712ca5",
                                                "text": "Глаза́ Степана Аркадьича весело заблестели, и он задумался, улыбаясь."
                                            },
                                            {
                                                "example_id": "e15e4b3a-f6c2-4187-bf25-9fa8c19415e3",
                                                "sense_id": "103ef43f-6947-30aa-aee5-43a4ba712ca5",
                                                "text": "Народу набралось в зимовья порядком. Жили скученно, грязновато, но весело."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "весело",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "61a83c58-f173-3863-a43f-740ae0bf19b5",
                                        "entry_id": "037bb49d-d9dd-3263-a8a2-aeeacd244486",
                                        "glosses": [
                                            "о наличии веселья, радостного настроения где-либо или чувства веселья у кого-либо"
                                        ],
                                        "tags": [
                                            "в знач. сказуемого"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53478974-aa8e-4464-9c88-83598e5026f8",
                                                "sense_id": "61a83c58-f173-3863-a43f-740ae0bf19b5",
                                                "text": "Как весело теперь в уединённом сельском домике."
                                            },
                                            {
                                                "example_id": "ce74305a-5ff6-426a-88c0-43972112a896",
                                                "sense_id": "61a83c58-f173-3863-a43f-740ae0bf19b5",
                                                "text": "— Не весело, боярин, правой рукой отсекать себе левую; не радостно русскому восставать противу русского."
                                            },
                                            {
                                                "example_id": "ebdaedef-076d-4c07-8b28-c9edf58789fa",
                                                "sense_id": "61a83c58-f173-3863-a43f-740ae0bf19b5",
                                                "text": "Александр Николаевич, подхватив мою пропитанную трупным запахом одежду, спешит на балкон проветрить её на свежем воздухе. Мне весело и смешно. Но у Вертинского обострённое обоняние."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "весело",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "45c52b60-0fa5-3119-a74b-6d072690c6c6",
                                        "entry_id": "587fff40-4a42-330e-b0a0-95f7a4382ade",
                                        "glosses": [
                                            "краткая форма среднего рода единственного числа прилагательного весёлый"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
