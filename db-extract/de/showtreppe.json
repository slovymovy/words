                "senses": [
                    {
                        "sense_id": "59019808-91c7-3277-841b-aa1bc4491a35",
                        "entry_id": "fec05f71-430a-30b2-972d-fd781abda23a",
                        "glosses": [
                            "(illuminierbare, meist nicht mit einem Geländer versehene) Treppe, über die bei einer Bühnen- oder Fernsehshow die Künstler den Auftrittsbereich vor dem Publikum betreten und wieder verlassen und die sie gegebenenfalls auch in ihre Darbietung integrieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "432d382a-21da-4b55-bb18-7a8f4a732de2",
                                "sense_id": "59019808-91c7-3277-841b-aa1bc4491a35",
                                "text": "„Vermutlich ist die Fischer-Show das einzige TV-Reservat für die klassische Showtreppe und ölige Galane, die die Hauptperson des Abends von besagter Treppe auf die Bühne führen.“"
                            },
                            {
                                "example_id": "38944b49-867f-4d64-b269-e24dbc9d5193",
                                "sense_id": "59019808-91c7-3277-841b-aa1bc4491a35",
                                "text": "„Am Anfang schritt die Schlager-Queen ganz in Weiß die Showtreppe herunter.“"
                            },
                            {
                                "example_id": "b8e39462-e507-491f-89a7-7ad3feeb5ef2",
                                "sense_id": "59019808-91c7-3277-841b-aa1bc4491a35",
                                "text": "„Bunt bekleidete Tänzerinnen und Tänzer schwirren darin über eine Showtreppe, wie sie in TV-Sendungen der Siebzigerjahre beliebt waren.“"
                            },
                            {
                                "example_id": "bc6ac8e3-6584-41d0-9bac-6ec2f70b58d1",
                                "sense_id": "59019808-91c7-3277-841b-aa1bc4491a35",
                                "text": "„Markus Lanz hoppelt die Showtreppe zum Wettsofa runter und begrüßt Offenburg, Deutschland, die ganze Welt, mit großer Geste.“"
                            },
                            {
                                "example_id": "270d5b8b-8bfe-4f4b-a910-56e48a6bbb71",
                                "sense_id": "59019808-91c7-3277-841b-aa1bc4491a35",
                                "text": "„Wenn Howard Carpendale auf der Bühne steht, leuchten die Stufen der Showtreppen, da singen die Damen im Glitzerkleidchen ›Hmm‹ und ›Huuuu‹ und im Publikum wird geklatscht, geschunkelt und ein bisschen geschnieft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
