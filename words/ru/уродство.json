{
    "word_family": [
        "урод",
        "уродина",
        "уродливый",
        "уродовать",
        "изуродовать"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8411a922-9a07-3ff3-af4d-fac3bd43d6f0",
                    "sense_definition": "Внешний вид, вызывающий отвращение или неприязнь из-за отсутствия красоты.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ugliness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Её поразило <w>уродство</w> этого старого заброшенного здания.",
                            "target_lang_translations": {
                                "pl": "Zszokowała ją <w>brzydota</w> tego starego, opuszczonego budynku."
                            }
                        },
                        {
                            "text": "В детстве он стеснялся своего <w>уродства</w>, хотя друзья его совсем не замечали.",
                            "target_lang_translations": {
                                "pl": "W dzieciństwie wstydził się swojej <w>brzydoty</w>, choć przyjaciele w ogóle jej nie zauważali."
                            }
                        }
                    ],
                    "synonyms": [
                        "уродливость"
                    ],
                    "antonyms": [
                        "красота"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wygląd zewnętrzny budzący odrazę lub niechęć z powodu braku piękna."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "brzydota",
                                "target_lang_sense_clarification": "ogólny brak estetyki lub piękna"
                            },
                            {
                                "target_lang_word": "szpetota",
                                "target_lang_sense_clarification": "wysoki stopień brzydoty, często o charakterze odpychającym"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6845b95f-6a55-3510-871f-e030389eb38a",
                    "sense_definition": "Врождённое или приобретённое отклонение в строении организма.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deformity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врачи изучали редкое физическое <w>уродство</w> у новорождённого ребёнка.",
                            "target_lang_translations": {
                                "pl": "Lekarze badali rzadką fizyczną <w>deformację</w> u noworodka."
                            }
                        },
                        {
                            "text": "Это генетическое <w>уродство</w> встречается крайне редко в природе.",
                            "target_lang_translations": {
                                "pl": "Ta genetyczna <w>wada wrodzona</w> występuje w przyrodzie niezwykle rzadko."
                            }
                        }
                    ],
                    "antonyms": [
                        "норма"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wrodzone lub nabyte odchylenie w budowie organizmu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "deformacja",
                                "target_lang_sense_clarification": "zmiana kształtu lub budowy ciała"
                            },
                            {
                                "target_lang_word": "kalectwo",
                                "target_lang_sense_clarification": "trwałe uszkodzenie ciała lub narządów"
                            },
                            {
                                "target_lang_word": "wada wrodzona",
                                "target_lang_sense_clarification": "medyczne określenie nieprawidłowości rozwojowej"
                            }
                        ]
                    },
                    "common_phrases": [
                        "врождённое уродство"
                    ]
                },
                {
                    "sense_id": "abc5faa2-4e76-323c-bbd0-60c50a120147",
                    "sense_definition": "Нечто крайне неприятное, отталкивающее или неуместное.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ugliness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зачем ты купил это <w>уродство</w> вместо нормальной мебели?",
                            "target_lang_translations": {
                                "pl": "Po co kupiłeś to <w>szkaradzieństwo</w> zamiast normalnych mebli?"
                            }
                        },
                        {
                            "text": "Это архитектурное <w>уродство</w> портит весь исторический центр города.",
                            "target_lang_translations": {
                                "pl": "Ta architektoniczna <w>potworność</w> szpeci całe historyczne centrum miasta."
                            }
                        }
                    ],
                    "synonyms": [
                        "безобразие"
                    ],
                    "target_lang_definitions": {
                        "pl": "Coś skrajnie nieprzyjemnego, odpychającego lub niestosownego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "potworność",
                                "target_lang_sense_clarification": "coś rażąco brzydkiego lub odrażającego"
                            },
                            {
                                "target_lang_word": "szkaradzieństwo",
                                "target_lang_sense_clarification": "przedmiot lub obiekt wyjątkowo brzydki"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}