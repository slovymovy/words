                        "glosses": [
                            "Donner un caractère phrygien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59fa7178-c18b-4090-9455-2bfc1e3a4e69",
                                "sense_id": "2d5cec80-8457-355c-9088-34613f2c6214",
                                "text": "Ceci contribue à modaliser (phrygianiser) le mineur (au lieu de l’éolianiser)."
                            },
                            {
                                "example_id": "e87d77bc-b210-4925-81fd-005894401807",
                                "sense_id": "2d5cec80-8457-355c-9088-34613f2c6214",
                                "text": "Le grec « phrygianisé » ne constitue pas le seul grec en usage en Phrygie."
                            },
                            {
                                "example_id": "f9ec26f5-f1ae-468e-984e-32f999fe877a",
                                "sense_id": "2d5cec80-8457-355c-9088-34613f2c6214",
                                "text": "Il interprète l’établissement comme le manoir d’un prince phrygien ou « phrygianisé » régnant sur un petit territoire."
                            }
                        ]
                    }
