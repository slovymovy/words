                "senses": [
                    {
                        "sense_id": "db4f33a0-3ae3-3724-9832-817ec842a604",
                        "entry_id": "b4e39566-4dbd-30ba-89d8-31a0664277fd",
                        "glosses": [
                            "sehr großer, riesiger Spaß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ade2c88b-e1f8-4254-b50d-fea6da206406",
                                "sense_id": "db4f33a0-3ae3-3724-9832-817ec842a604",
                                "text": "„Mr. Stanley ist etwa Mitte fünfzig, und er sieht aus, als wäre das Leben für ihn ein Riesenspaß.“"
                            },
                            {
                                "example_id": "ab1c0a40-07e2-49be-b317-47706c16f58e",
                                "sense_id": "db4f33a0-3ae3-3724-9832-817ec842a604",
                                "text": "„Allie tanzte wild und abgehackt, so dass Neal fürchtete, ihr Kopf könne sich von ihrem Körper lösen. Und sie hatte einen Riesenspaß dabei.“"
                            },
                            {
                                "example_id": "978d8fe4-2e8d-49e9-afd1-43155a55ce34",
                                "sense_id": "db4f33a0-3ae3-3724-9832-817ec842a604",
                                "text": "„Ich bin sicher, Snorri hätte einen Riesenspaß an ihnen gehabt.“"
                            },
                            {
                                "example_id": "5b3eaf16-b666-4b36-9e68-15e6c1d951e0",
                                "sense_id": "db4f33a0-3ae3-3724-9832-817ec842a604",
                                "text": "„Das hat denen einen Riesenspaß gemacht, sich zu jagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
