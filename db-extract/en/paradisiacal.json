                "senses": [
                    {
                        "sense_id": "57eff6ad-8397-3a28-b087-65bd8c8a1d9b",
                        "entry_id": "1b53f422-c6b9-32aa-82cc-baeaf2787199",
                        "glosses": [
                            "Of or resembling paradise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08a6b158-2f4b-4019-b7a7-c12e543f7fc8",
                                "sense_id": "57eff6ad-8397-3a28-b087-65bd8c8a1d9b",
                                "text": "I read and re-read her letter, and some softened feelings stole into my heart, and dared to whisper paradisiacal dreams of love and joy; but the apple was already eaten, and the angel's arm bared to drive me from all hope."
                            },
                            {
                                "example_id": "8c744525-2bda-45e1-96e5-27244713ea59",
                                "sense_id": "57eff6ad-8397-3a28-b087-65bd8c8a1d9b",
                                "text": "We believe in the literal gathering of Israel and in the restoration of the Ten Tribes; that Zion (the New Jerusalem) will be built upon the American continent; that Christ will reign personally upon the earth; and, that the earth will be renewed and receive its paradisiacal glory."
                            }
                        ]
                    }
                ],
