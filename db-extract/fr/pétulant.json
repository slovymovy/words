                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petulant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e1a837d-b25f-361d-8027-b94cc449e7d9",
                                        "entry_id": "896c9912-1714-3d57-877d-d8b8ac2143e1",
                                        "glosses": [
                                            "Childishly irritable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "283bb97e-e5fb-48a2-a9cc-a47aeedb122e",
                                                "sense_id": "4e1a837d-b25f-361d-8027-b94cc449e7d9",
                                                "text": "Lack of sleep is causing Dave's recent petulant behavior."
                                            },
                                            {
                                                "example_id": "2149b17e-21c1-4a92-9fdb-164c4017f9d7",
                                                "sense_id": "4e1a837d-b25f-361d-8027-b94cc449e7d9",
                                                "text": "But when your praying has troubled the silence long it may be that some god as he strolls in Pegāna’s glades may come on one of our lost prayers, that flutters like a butterfly tossed in storm when all its wings are broken; then if the gods be merciful they may ease our fears in Sidith, or else they may crush us, being petulant gods, and so we shall see trouble in Sidith no longer, with its pestilence and dearth and fears of war."
                                            },
                                            {
                                                "example_id": "96517cd0-276a-41c4-af39-a44b6ff6063c",
                                                "sense_id": "4e1a837d-b25f-361d-8027-b94cc449e7d9",
                                                "text": "Former associates have described Musk as petty, cruel and petulant, particularly when frustrated or challenged."
                                            },
                                            {
                                                "example_id": "6a5b6c15-9bc5-49d6-a317-d247f90f06aa",
                                                "sense_id": "4e1a837d-b25f-361d-8027-b94cc449e7d9",
                                                "text": "Green Day’s petulant pop-punk album Dookie came out three years after that and moved another 10 million, as did a sweeping 1995 double album by Smashing Pumpkins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d36cd5a7-35c8-3f98-baff-26c60274b376",
                                        "entry_id": "896c9912-1714-3d57-877d-d8b8ac2143e1",
                                        "glosses": [
                                            "Forward; pert; insolent; wanton."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e85b9261-91a1-4f25-9213-3aab6be239e6",
                                                "sense_id": "d36cd5a7-35c8-3f98-baff-26c60274b376",
                                                "text": "Who hath not like cause to complain, and is not so troubled, that shall fall into the mouths of such men? for many are of so petulant a spleen"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
