                        ],
                        "examples": [
                            {
                                "example_id": "5fa278d2-6f1a-4f36-be0f-d458905b2c2e",
                                "sense_id": "674abcbf-7d04-3364-ab54-3e30528928dd",
                                "text": "W języku potocznym niezwykłą popularnością cieszy się też słowo „zajzajer” oznaczające w sensie dosłownym „kwas solny”, zaś w bardziej przenośnym „mocny, palący, niesmaczny, gorzki napój”"
                            },
                            {
                                "example_id": "8f620826-c1aa-475f-b964-862233d0683a",
                                "sense_id": "674abcbf-7d04-3364-ab54-3e30528928dd",
                                "text": "Przed sklepem od zacienionej strony siedzą mężczyźni, palą papierosy, inni raczą się likworem z napisem„Wino” na nalepce, zwanym tu zajzajerem"
                            }
