                                "example_id": "fc012de3-d1ad-4f3b-897b-97550920d796",
                                "sense_id": "11b2ace0-b6dc-3aa8-b01c-62de629b0790",
                                "text": "‘Mevrouw Jansma.’ ‘Wondinfectie en littekenbreukcorrectie.’ ‘Heropname?’ ‘Ja.’"
