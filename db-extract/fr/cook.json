                            {
                                "example_id": "a2a155f6-b064-4aeb-be1d-6991401924df",
                                "sense_id": "07ee3be0-197e-3217-853f-dae1aecb5d20",
                                "text": "Cook reçut, avant de quitter cette île, la visite de Téroe, roi d’Eiméo."
                            },
                            {
                                "example_id": "8c1c71b1-d318-4c25-8a24-1cb541399313",
                                "sense_id": "07ee3be0-197e-3217-853f-dae1aecb5d20",
                                "text": "Le reggae dub d’Hollie Cook (photo), la soul créole acoustique de la harpiste Sophye Soliveau, les performances de la Sud-Coréenne Okkyung Lee ou encore le piano fracassé du Brésilien Amaro Freitas sont à voir au festival Banlieues Bleues, du 8 mars au 5 avril, dans 13 villes d’Île-de-France."
                            }
                        ]
                    }
                ],
