                ],
                "senses": [
                    {
                        "sense_id": "aab0b8e7-b553-3ed9-9412-ba13a18a4a23",
                        "entry_id": "d7fe2b25-775d-3688-9ecf-2c92e20cd96d",
                        "glosses": [
                            "Action d’éventrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a97e34b-d0d4-4460-a750-f9f9d189ea7c",
                                "sense_id": "aab0b8e7-b553-3ed9-9412-ba13a18a4a23",
                                "text": "Des tableaux enfumés et noirâtres, représentant quelque décollation ou quelque éventrement de martyr, sujets favoris des peintres espagnols, sont pendus aux murailles, la plupart sans cadres et tout plissés sur leurs châssis."
                            },
                            {
                                "example_id": "d059619c-a81d-400c-8156-3d22c9b0c64a",
                                "sense_id": "aab0b8e7-b553-3ed9-9412-ba13a18a4a23",
                                "text": "Ils dénoncent aussi les éventrements des femmes, des incendies des villages ainsi que des déplacements des populations vers d’autres villages."
                            }
                        ]
                    },
                    {
                        "sense_id": "11f672c7-b840-3b35-b390-7c6dfe451996",
                        "entry_id": "d7fe2b25-775d-3688-9ecf-2c92e20cd96d",
                        "glosses": [
                            "Action d'ouvrir une brèche."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "f5e3ab48-52a4-4a10-a5bc-b3f034a939f0",
                                "sense_id": "11f672c7-b840-3b35-b390-7c6dfe451996",
                                "text": "L'« éventrement » d'un supertanker menace la vie d'un petit équipage, mais pollue une fraction notable de la Manche ou de la mer du Nord."
                            }
                        ]
                    },
                    {
                        "sense_id": "c74b7197-acd5-3bcf-a8b8-e80b250ea0a3",
                        "entry_id": "d7fe2b25-775d-3688-9ecf-2c92e20cd96d",
                        "glosses": [
                            "Trou béant important dans un édifice, un bâtiment."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1971d2f3-ce93-42b1-9916-6e007c6ad594",
                                "sense_id": "c74b7197-acd5-3bcf-a8b8-e80b250ea0a3",
                                "text": "Personne, aujourd'hui, n'est plus en état de comprendre que l'éventrement, l'incendie, la grillade, la canonnade, la fusillade et la mitraillade sont les suites nécessaires et prosodiques de la rigolade."
                            }
                        ]
                    }
