                "senses": [
                    {
                        "sense_id": "fdd4a815-ac21-326c-9b58-f986885f8e2e",
                        "entry_id": "5eeeb314-c0f6-309d-894b-b8e786129fdc",
                        "glosses": [
                            "Celui qui lance le harpon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86f5cca1-063a-4ed2-9533-80a996942247",
                                "sense_id": "fdd4a815-ac21-326c-9b58-f986885f8e2e",
                                "text": "Toujours à la proue, la hache à la main, le harponneur observe attentivement les progrès de l’immersion."
                            },
                            {
                                "example_id": "20bb1345-9967-4b13-9d80-6ae7f4df0b23",
                                "sense_id": "fdd4a815-ac21-326c-9b58-f986885f8e2e",
                                "text": "Le peu de travail qu’il y avait à faire m’avait fondu dans les mains, dévidé irrésistiblement de moi par une force étrangère : le peloton de corde entre les doigts du harponneur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "212065cf-3a03-477f-ade3-c3818bb71996",
                        "source_entry_id": "5eeeb314-c0f6-309d-894b-b8e786129fdc",
                        "source_sense_id": "fdd4a815-ac21-326c-9b58-f986885f8e2e",
                        "target_lang_word": "Harpunier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Harpunier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c22c4f2d-7e97-3d84-b1cc-b8750c782be1",
                                        "entry_id": "dcd9f491-171b-3367-aa32-7db5aadbbd29",
                                        "glosses": [
                                            "Person, die eine Harpune benutzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "270ba1a9-4edb-435e-9af1-19724daf1ff9",
                                                "sense_id": "c22c4f2d-7e97-3d84-b1cc-b8750c782be1",
                                                "text": "„Die Boote waren im Augenblick niedergelassen, die dazu bestimmte Mannschaft sprang hinein, und nur der erste Harpunier zögerte noch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3bf9346-7450-472a-b92f-e4ba3135ecfe",
                        "source_entry_id": "5eeeb314-c0f6-309d-894b-b8e786129fdc",
