            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f28dbc2c-ca40-3de1-9160-a386f05c9a38",
                    "sense_definition": "Een georganiseerde groepsreis die men maakt voor het plezier en de gezelligheid, vaak per fiets, auto of schaats.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reizen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wielerclub organiseert volgende week een gezellige <w>toertocht</w> door de heuvels.",
                            "target_lang_translations": {
                                "en": "The cycling club is organizing a pleasant <w>touring ride</w> through the hills next week."
                            }
                        },
                        {
                            "text": "Zij deden mee aan een <w>toertocht</w> voor oldtimers door heel Scandinavië.",
                            "target_lang_translations": {
                                "en": "They participated in a vintage car <w>tour</w> through all of Scandinavia."
                            }
                        }
                    ],
                    "synonyms": [
                        "rondrit",
                        "toer"
                    ],
                    "common_phrases": [
                        "jaarlijkse toertocht",
                        "toertocht voor wielrenners"
                    ],
                    "target_lang_definitions": {
                        "en": "An organized group trip made for pleasure and socializing, often by bicycle, car, or ice skates."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "touring ride",
                                "target_lang_sense_clarification": "recreational group ride"
                            },
                            {
                                "target_lang_word": "scenic drive",
                                "target_lang_sense_clarification": "for cars or motorbikes"
                            },
                            {
                                "target_lang_word": "tour",
                                "target_lang_sense_clarification": "organized recreational trip"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be15cdd3-e6ae-3be6-ab86-d5544ea9f9e8",
                    "sense_definition": "Een recreatieve tocht of wedstrijd georganiseerd door een sportvereniging, bijvoorbeeld bij het schaatsen of wielrennen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reizen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zodra er natuurijs ligt, schrijven duizenden mensen zich in voor een <w>toertocht</w> op de schaats.",
                            "target_lang_translations": {
                                "en": "As soon as there is natural ice, thousands of people sign up for an ice skating <w>touring event</w>."
                            }
                        },
                        {
                            "text": "Deze <w>toertocht</w> is geen officiële wedstrijd, dus plezier staat voorop.",
                            "target_lang_translations": {
                                "en": "This <w>recreational tour</w> is not an official race, so fun comes first."
                            }
                        }
                    ],
                    "synonyms": [
                        "recreatietocht"
                    ],
                    "antonyms": [
                        "wedstrijd"
                    ],
                    "common_phrases": [
                        "toertocht op natuurijs"
                    ],
                    "target_lang_definitions": {
                        "en": "A recreational tour or non-competitive event organized by a sports club, for example in ice skating or cycling."
                    },
                    "translations": {
