                "senses": [
                    {
                        "sense_id": "90acf98d-2163-3cb3-b108-63bbfeb4352a",
                        "entry_id": "4e97b111-d930-3fe9-b09a-fffe13672f3c",
                        "glosses": [
                            "A dead person."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "4fd85170-c6f2-4eca-97eb-d76cbbd697e0",
                                "sense_id": "90acf98d-2163-3cb3-b108-63bbfeb4352a",
                                "text": "“A check of the nightstands revealed large amounts of prescription medication in the decedent’s name,” the coroner’s notes said, according to TMZ.com."
                            },
                            {
                                "example_id": "fb41c31e-6ad1-4693-9484-068d865297c0",
                                "sense_id": "90acf98d-2163-3cb3-b108-63bbfeb4352a",
                                "text": "A 2020 study found that MAiD recipients in Ontario tended to be wealthier, less likely to be in institutional care, and more likely to be married than the average Ontario decedent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f227d173-c9e5-4b9f-957b-0090fa215aaf",
                        "source_entry_id": "4e97b111-d930-3fe9-b09a-fffe13672f3c",
                        "source_sense_id": "90acf98d-2163-3cb3-b108-63bbfeb4352a",
                        "source_sense_description": "dead person",
                        "target_lang_word": "overledene",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overledene",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f3cab266-3ebe-37aa-af2e-f5883e7bc899",
                                        "entry_id": "fd8b8973-3c20-38f3-9db8-11d81c4b6c04",
                                        "glosses": [
                                            "iemand die gestorven is, de dode"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef8f555e-2d75-410f-a97b-92d976a301c9",
                                                "sense_id": "f3cab266-3ebe-37aa-af2e-f5883e7bc899",
                                                "text": "Bij een begrafenis kan men afscheid nemen van de overledene."
                                            },
                                            {
                                                "example_id": "5f25b3c0-4758-440f-940d-4eb5ee483442",
                                                "sense_id": "f3cab266-3ebe-37aa-af2e-f5883e7bc899",
                                                "text": "Britse parlementsleden willen dat er een onderzoek komt naar het grootschalige seksuele misbruik van overledenen in twee Britse ziekenhuizen. Elektricien David Fuller (67) gaf deze week toe dat hij tussen 2008 en 2020 zeker honderd overledenen, merendeels vrouwen, seksueel heeft misbruikt in de ziekenhuizen waar hij werkte als elektricien, in het graafschap Kent."
                                            },
                                            {
                                                "example_id": "9ebe2583-dd93-4b51-bc40-3596db350df9",
                                                "sense_id": "f3cab266-3ebe-37aa-af2e-f5883e7bc899",
                                                "text": "De veel gepubliceerde bewering dat Homo naledi, een vroegere mensensoort met een klein brein, zijn overledenen begroef en rotskunst maakte, is volgens een groep onderzoekers volledig ongegrond. ‘Er is totaal geen bewijs voor’, zegt archeoloog en antropoloog Michael Petraglia van de Griffith-universiteit in Australië."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a5421b2-600d-456c-a44c-00d998328a83",
                        "source_entry_id": "4e97b111-d930-3fe9-b09a-fffe13672f3c",
                        "source_sense_id": "90acf98d-2163-3cb3-b108-63bbfeb4352a",
                        "source_sense_description": "dead person",
                        "target_lang_word": "défunt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "défunt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2375e8f2-d92b-32d4-a0ab-59a34ba40fd3",
                                        "entry_id": "22ad3f29-fdf3-3a8d-807e-cd683c744a9d",
                                        "glosses": [
                                            "Décédé ; mort ; feu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a97c742c-8732-4a52-8f65-2e64aa771dbf",
                                                "sense_id": "2375e8f2-d92b-32d4-a0ab-59a34ba40fd3",
                                                "text": "Cet enfant est lord Fermain Clancharlie, fils légitime unique de lord Linnœus Clancharlie, baron Clancharlie et Hunkerville, marquis de Corleone en Italie, pair du royaume d’Angleterre, défunt, et d’Ann Bradshaw, son épouse, défunte."
                                            },
                                            {
                                                "example_id": "5e2012ac-7113-484e-b69a-3fbbb6d60a00",
                                                "sense_id": "2375e8f2-d92b-32d4-a0ab-59a34ba40fd3",
                                                "text": "Le regard ankylosé par trop d’impérities, je cherchais un improbable mais tant espéré soutien au loin, partout et nulle part, peut-être vers le ciel où s'était machinalement orientée ma tête; ce ciel où avaient établi leurs pénates, mon défunt père et mes regrettées sœurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a55c194-7bf6-3c90-bd46-11eae9dec7c2",
                                        "entry_id": "22ad3f29-fdf3-3a8d-807e-cd683c744a9d",
                                        "glosses": [
                                            "Feu. (Note : se place devant un nom pour indiquer que la personne est morte, invariable dans ce cas)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b74e617b-af4d-41f4-9857-a81245461bbe",
                                                "sense_id": "9a55c194-7bf6-3c90-bd46-11eae9dec7c2",
                                                "text": "— Défunt ma mère servait un homme de justice à qui Cambremer a tout dit par ordre du prêtre qui ne lui a donné l’absolution qu’à cette condition-là, à entendre les gens du port."
                                            },
                                            {
                                                "example_id": "f9d3a060-ef86-4b83-8d9a-188f3fb00e0f",
                                                "sense_id": "9a55c194-7bf6-3c90-bd46-11eae9dec7c2",
                                                "text": "Chère enfant !… si défunt sa mère la voyait ne pas être ici la reine de la maison, elle en pleurerait dans son cercueil !"
                                            },
                                            {
                                                "example_id": "ff7d9aa9-f1cf-4a3c-93bf-afcc54f48aa8",
                                                "sense_id": "9a55c194-7bf6-3c90-bd46-11eae9dec7c2",
                                                "text": "— Barberin ! m’écriai-je.\n— Défunt, c’est défunt Barberin qu’il faut dire."
                                            },
                                            {
                                                "example_id": "4f85e5c4-7299-4c05-b5ea-48e4d2410f9b",
                                                "sense_id": "9a55c194-7bf6-3c90-bd46-11eae9dec7c2",
                                                "text": "Défunt ma grand’mère se rappelait du temps où les curés passaient dans les champs pour prendre la dîme, où les seigneurs avaient toute sorte de privilèges et de droits exorbitants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6a74174-6ba6-3c91-9e62-3ebf92bda691",
                                        "entry_id": "22ad3f29-fdf3-3a8d-807e-cd683c744a9d",
                                        "glosses": [
                                            "Détruit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "454d5b13-b829-4c3e-b351-2621fde570d6",
                                                "sense_id": "f6a74174-6ba6-3c91-9e62-3ebf92bda691",
                                                "text": "Figure mélancolique, il méditait profondément devant le monceau de ferraille et de cendres qui représentait sa défunte motocyclette."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "défunt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f7e44bd-fda9-37a3-a9d3-5a0764a985f1",
                                        "entry_id": "2131a667-1bdb-3556-ad8a-2cf80f9abe03",
                                        "glosses": [
                                            "Personne décédée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7412754-0392-4ea5-aee1-4a1db9b0e8dd",
                                                "sense_id": "5f7e44bd-fda9-37a3-a9d3-5a0764a985f1",
                                                "text": "Advienne que pourra, il doit l’assister auprès du défunt, jusqu’à la mise en fosse et monter avec elle la garde funèbre, […]."
                                            },
                                            {
                                                "example_id": "a1e79291-9cbc-425b-a1fe-3d0dad992452",
                                                "sense_id": "5f7e44bd-fda9-37a3-a9d3-5a0764a985f1",
                                                "text": "Les enfants du défunt, de la défunte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68041711-7412-492b-aa9e-2fbff5b72a80",
