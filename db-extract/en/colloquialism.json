                                                "example_id": "dabcc89a-7afc-4541-9dad-ae5c2437d4f7",
                                                "sense_id": "c01f5ce0-96f4-3424-b611-90404a00cda7",
                                                "text": "„Ebenfalls mit den Umgangssprachen, also jenen zwischen Standard und Dialekten liegenden sprachlichen Varietäten, beschäftigte sich Jürgen Eichhoff (Pennsylvania State University, USA) in seinem Vortrag »Umgangssprachen im Lichte der Wortgeographie«.“"
                                            },
                                            {
                                                "example_id": "cdefa209-4cfa-4bc0-8e07-7f8480eb6703",
                                                "sense_id": "c01f5ce0-96f4-3424-b611-90404a00cda7",
                                                "text": "„…und zwischen sie [gemeint: Mundart] und die Hochsprache schiebt sich, was heute meist als Umgangssprache bezeichnet wird.“"
                                            },
                                            {
                                                "example_id": "26b72b9e-c5c4-412e-b51b-e1784397ad2d",
                                                "sense_id": "c01f5ce0-96f4-3424-b611-90404a00cda7",
                                                "text": "„Im Deutschen verwendet man für diese Mittelstufen zwischen Mundart und Gemeinsprache den Ausdruck Umgangssprache (…).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf3318be-1876-38e0-91d4-e64d5e12a5bb",
                                        "entry_id": "23f5698e-9cb4-39fa-95bf-044fbe88092d",
                                        "glosses": [
                                            "Bezeichnung für Sprachstile, die im eher privaten, informellen Sprachgebrauch verwendet werden und sich dabei von der Standardsprache unterscheiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85d68d3a-0222-458b-bc9b-2b29fc88f0de",
                                                "sense_id": "bf3318be-1876-38e0-91d4-e64d5e12a5bb",
                                                "text": "In einem privaten Brief kann man Umgangssprache, in einem dienstlichen Schreiben nur Standard- oder Hochsprache verwenden."
                                            },
                                            {
                                                "example_id": "f92816e8-ffd9-4049-a869-2558f7b9ce3e",
                                                "sense_id": "bf3318be-1876-38e0-91d4-e64d5e12a5bb",
                                                "text": "„Oben wurde die Varietät der Umgangssprache als Stil des Alltagsverkehrs gekennzeichnet.“"
                                            },
                                            {
                                                "example_id": "98202e25-ecc5-4de8-a317-304eb3267250",
                                                "sense_id": "bf3318be-1876-38e0-91d4-e64d5e12a5bb",
                                                "text": "„Der mündliche Sprachgebrauch der Umgangssprache unterscheidet sich von der Schriftsprache.“"
                                            },
                                            {
                                                "example_id": "2d1114b3-ee46-4f2d-b821-2be799e49cab",
                                                "sense_id": "bf3318be-1876-38e0-91d4-e64d5e12a5bb",
                                                "text": "„Das Jiddische war die Umgangssprache des sogenannten Ostjudentums.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97fd2d7f-4571-4e95-a72c-1e1d5b611de0",
                        "source_entry_id": "a389bd84-96a3-3be2-a92b-fc20df91ec98",
                        "source_sense_description": "colloquial style of speaking",
                        "target_lang_word": "Alltagssprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alltagssprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                        "entry_id": "5083d426-c942-396e-ad3a-093136dca371",
                                        "glosses": [
                                            "zwischen Standard- und Umgangssprache stehende Sprachform, die für alltägliche Zwecke verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "072f2b96-7567-49a6-b125-758941b5d106",
                                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                                "text": "Bei alltäglichen Verrichtungen wie Einkaufen, Small Talk oder Unterhaltung mit Bekannten verwendet man meist die Alltagssprache."
                                            },
                                            {
                                                "example_id": "cb05cb75-bc4d-4d0e-9f2b-94b22c6def99",
                                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                                "text": "Die Alltagssprache ist weniger förmlich als zum Beispiel Fach-, Medien- oder Wissenschaftssprachen."
                                            },
                                            {
                                                "example_id": "6b9132dd-7408-46a6-a936-7dfc0ab2fd86",
                                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                                "text": "„Wie bei Alltagssprache und Literatursprache stehen ‚Wissenschafts- und Fachsprachen‘ wiederum als Oberbegriffe für eine Reihe von Varietäten.“"
                                            },
                                            {
                                                "example_id": "427e4489-03f8-4f8d-9319-6ab04785c626",
                                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                                "text": "„Das betrifft nicht allein den terminologischen Bereich und Benennungsstandards, sondern auch viele Wörter der Alltagssprache […]“"
                                            },
                                            {
                                                "example_id": "2f87885d-97bb-4cad-80e6-601a1e81b575",
                                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                                "text": "„An diesen Formulierungen bemerken Sie bereits, daß hier der Prozeß des Verstehens, der Erkenntnis, der Meinungsbildung in der Alltagssprache mit dem Bilde des Sehens geschildert wurde.“"
                                            },
                                            {
                                                "example_id": "9f1ce151-8fad-4c83-b447-136741daa929",
                                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                                "text": "„In den Duden schaffte es das Gesetz nie, weil es in der Alltagssprache nicht vorkommt.“"
                                            },
                                            {
                                                "example_id": "678d9aac-6a37-47f3-9095-1a2ce0b4ab2d",
                                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                                "text": "„Wie kommt es also, dass den Menschen im Rheinland zwar der Mischcharakter ihrer Alltagssprache bewusst ist, die jiddische Komponente dabei aber ausgeklammert bleibt?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
