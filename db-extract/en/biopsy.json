                "senses": [
                    {
                        "sense_id": "41055526-db47-3ac3-a2ab-eab79f06c8eb",
                        "entry_id": "ecae4d40-7128-3b96-8f96-c6b04607aca4",
                        "glosses": [
                            "To take a sample (a biopsy) for pathological examination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad7bb78b-55c3-48b7-aafd-1cf3536fbc6f",
                                "sense_id": "41055526-db47-3ac3-a2ab-eab79f06c8eb",
                                "text": "They biopsied the lump but it turned out to be non-cancerous."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d74bfc0b-182b-4e18-b691-585c0af8daa9",
                        "source_entry_id": "ecae4d40-7128-3b96-8f96-c6b04607aca4",
                        "source_sense_id": "41055526-db47-3ac3-a2ab-eab79f06c8eb",
                        "source_sense_description": "to take a sample for pathological examination",
                        "target_lang_word": "biopsieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biopsieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b0a02c2-efe1-31c8-9cac-fa59870ee0f0",
                                        "entry_id": "e7701cf8-25e9-3575-a889-1b6ec1b3fac5",
                                        "glosses": [
                                            "eine Biopsie vornehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3848a2f7-ffda-4af4-a47a-a017c449c396",
                                                "sense_id": "0b0a02c2-efe1-31c8-9cac-fa59870ee0f0",
                                                "text": "Dennoch raten die französischen Dermatologen, ernsthaft zu erwägen, ob nicht alle Wunden an den Beinen zu biopsieren wären, die nach dreimonatiger Therapie nicht heilen wollen."
                                            },
                                            {
                                                "example_id": "bc88bcfa-273d-4158-9cfc-2bccde42ead9",
                                                "sense_id": "0b0a02c2-efe1-31c8-9cac-fa59870ee0f0",
                                                "text": "„Um eine exakte Diagnose stellen zu können, müsste man den Patienten unter Narkose biopsieren.“"
                                            },
                                            {
                                                "example_id": "2a12df5e-a8be-4cd6-8b97-f07f2525873e",
                                                "sense_id": "0b0a02c2-efe1-31c8-9cac-fa59870ee0f0",
                                                "text": "Die Gewebeprobe selbst nennt man Biopsat, den Vorgang der Entnahme biopsieren."
                                            },
                                            {
                                                "example_id": "d5abc1c2-d482-4224-97bb-7ecd57012ce6",
                                                "sense_id": "0b0a02c2-efe1-31c8-9cac-fa59870ee0f0",
                                                "text": "Die verdächtige Stelle, die zu biopsieren ist, haben wir bei der vorangegangenen MRT-Untersuchung der Prostata ganz genau bestimmen können."
                                            },
                                            {
                                                "example_id": "dfda3594-1e7d-4b4b-832b-7bbb48dae28c",
                                                "sense_id": "0b0a02c2-efe1-31c8-9cac-fa59870ee0f0",
                                                "text": "Dafür errechnen wir den idealen Zugangsweg und können somit jedes Areal exakt treffen bzw. biopsieren."
                                            }
