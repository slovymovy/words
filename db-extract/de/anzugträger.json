                "senses": [
                    {
                        "sense_id": "0a753553-932d-3f5e-8e68-9064970ab220",
                        "entry_id": "5632aa2d-072e-36f5-8a67-2170ff395e7a",
                        "glosses": [
                            "formell gekleideter Mann; jemand, der (meist von Berufs wegen) einen Anzug trägt"
                        ],
                        "tags": [
                            "meist abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "f174b294-b9b9-4990-981b-c5968242ed2c",
                                "sense_id": "0a753553-932d-3f5e-8e68-9064970ab220",
                                "text": "„Dadurch, dass Casual Look an immer mehr Arbeitsplätzen zur Norm wird (beispielsweise bei Google oder Facebook), verliert der Anzug seine symbolische Macht. Oder sein positiver Effekt wird durch die sinkende Zahl der Anzugträger verstärkt.“"
                            },
                            {
                                "example_id": "e9701ff9-4e5c-4705-817a-46f0c2eab662",
                                "sense_id": "0a753553-932d-3f5e-8e68-9064970ab220",
                                "text": "„Als sie eines Morgens dem ebenfalls alleinstehenden Topmanager Matthias Winkelmann die Vorfahrt nimmt, fährt sie dem verblüfften Anzugträger frech über den Mund.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
