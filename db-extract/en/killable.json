                                "target_senses": [
                                    {
                                        "sense_id": "ad491894-f14f-3a01-b1e4-9d051fae1646",
                                        "entry_id": "9b4f2d12-a165-38a2-8d8b-b40b4b66507e",
                                        "glosses": [
                                            "Qui peut être tué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6a4a51-2e52-44aa-9368-72bbc6254048",
                                                "sense_id": "ad491894-f14f-3a01-b1e4-9d051fae1646",
                                                "text": "Et encore, ma Vieille possède un vieux char japonais, modèle « pas tuable » avec 200 000 km au compteur, qui consomme de l’essence « ordinaire »."
                                            },
                                            {
                                                "example_id": "f40409a3-0931-44b7-b846-829ece1e53ca",
                                                "sense_id": "ad491894-f14f-3a01-b1e4-9d051fae1646",
                                                "text": "D’habitude, au début des jeux vidéo, les ennemis sont aisément tuables pour que le joueur s’habitue et gagne du niveau facilement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d801a5e0-baa6-4566-8fc4-3b358e238b65",
