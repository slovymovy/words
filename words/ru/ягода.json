                        "en": [
                            {
                                "target_lang_word": "berry",
                                "target_lang_sense_clarification": "botanical term"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c5cf311-b1a7-3a16-b6b5-4ece603e946c",
