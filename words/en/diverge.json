{
    "word_family": [
        "divergence",
        "divergent"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "342bab4f-e629-33be-89ff-2d2a9e31fff2",
                    "sense_definition": "To separate and go in different directions from a common point.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "separation_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The main highway <w>diverges</w> into two smaller roads just past the city limits.",
                            "target_lang_translations": {
                                "ru": "Главное шоссе <w>разветвляется</w> на две дороги поменьше сразу за чертой города.",
                                "zh": "主干道在刚过城市边界处<w>分叉</w>成两条小路。"
                            }
                        },
                        {
                            "text": "We walked together for a mile before our paths <w>diverged</w> near the river.",
                            "target_lang_translations": {
                                "ru": "Мы прошли вместе милю, прежде чем наши пути <w>разошлись</w> у реки.",
                                "zh": "我们一起走了一英里，之后我们的路在河边<w>分开</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "separate",
                        "branch",
                        "fork",
                        "split",
                        "part"
                    ],
                    "antonyms": [
                        "converge"
                    ],
                    "common_phrases": [
                        "paths diverge",
                        "roads diverge",
                        "diverge from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделяться и расходиться в разные стороны из одной точки",
                        "zh": "从同一点出发，向不同方向分开或延伸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расходиться",
                                "target_lang_sense_clarification": "о путях или дорогах"
                            },
                            {
                                "target_lang_word": "разветвляться",
                                "target_lang_sense_clarification": "делиться на ветви или направления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分叉",
                                "target_lang_sense_clarification": "指道路或路径分成多条"
                            },
                            {
                                "target_lang_word": "分开",
                                "target_lang_sense_clarification": "指从一点向不同方向延伸"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80fcb171-d258-3981-bda9-96cc5350792d",
                    "sense_definition": "To become different in character, form, or opinion.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "separation_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Although they were raised together, their political views <w>diverged</w> significantly as adults.",
                            "target_lang_translations": {
                                "ru": "Хотя они выросли вместе, их политические взгляды значительно <w>разошлись</w> во взрослом возрасте.",
                                "zh": "尽管他们一起长大，但成年后他们的政治观点产生了显著<w>分歧</w>。"
                            }
                        },
                        {
                            "text": "The film adaptation <w>diverges</w> from the book in several key scenes.",
                            "target_lang_translations": {
                                "ru": "Экранизация <w>отклоняется</w> от книги в нескольких ключевых сценах.",
                                "zh": "这部电影改编在几个关键场景上与原著有所<w>偏离</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "differ",
                        "vary",
                        "deviate",
                        "disagree"
                    ],
                    "antonyms": [
                        "converge"
                    ],
                    "common_phrases": [
                        "opinions diverge",
                        "views diverge",
                        "diverge from the norm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться отличным по характеру, форме или мнению; отличаться",
                        "zh": "在性质、形式或观点上变得不同；产生分歧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расходиться",
                                "target_lang_sense_clarification": "о мнениях или взглядах"
                            },
                            {
                                "target_lang_word": "отклоняться",
                                "target_lang_sense_clarification": "от нормы, оригинала или стандарта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分歧",
                                "target_lang_sense_clarification": "指观点或意见不一致"
                            },
                            {
                                "target_lang_word": "偏离",
                                "target_lang_sense_clarification": "指与标准、原件或常态不符"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d88e644c-2548-3830-a7e7-31b194248e29",
                    "sense_definition": "To have no finite limit or to fail to approach a specific value.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor explained why the infinite series <w>diverges</w> instead of summing to a number.",
                            "target_lang_translations": {
                                "ru": "Профессор объяснил, почему бесконечный ряд <w>расходится</w>, а не суммируется в число.",
                                "zh": "教授解释了为什么这个无穷级数是<w>发散</w>的，而不是收敛于某个数值。"
                            }
                        },
                        {
                            "text": "If the sequence <w>diverges</w>, we cannot use standard methods to analyze it.",
                            "target_lang_translations": {
                                "ru": "Если последовательность <w>расходится</w>, мы не можем использовать стандартные методы для её анализа.",
                                "zh": "如果该序列<w>发散</w>，我们就不能使用标准方法来分析它。"
                            }
                        }
                    ],
                    "antonyms": [
                        "converge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не иметь конечного предела или не приближаться к конкретному значению (в математике)",
                        "zh": "指数学序列或级数没有有限极限，即不趋向于特定数值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расходиться",
                                "target_lang_sense_clarification": "о рядах или последовательностях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发散",
                                "target_lang_sense_clarification": "数学术语，指级数或序列不收敛"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab0b8dad-849b-35e2-9339-be4bfc9d62c0",
                    "sense_definition": "A point where a lane or path branches off from the main flow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Traffic often slows down near the <w>diverge</w> due to confused drivers changing lanes.",
                            "target_lang_translations": {
                                "ru": "Движение часто замедляется возле <w>развилки</w> из-за растерянных водителей, меняющих полосы.",
                                "zh": "由于司机在变道时感到困惑，交通经常在<w>分叉口</w>附近减速。"
                            }
                        },
                        {
                            "text": "The engineers inspected the pavement at the <w>diverge</w> for signs of wear.",
                            "target_lang_translations": {
                                "ru": "Инженеры осмотрели дорожное покрытие на <w>развилке</w> на предмет признаков износа.",
                                "zh": "工程师检查了<w>分叉口</w>的路面，查看是否有磨损迹象。"
                            }
                        }
                    ],
                    "synonyms": [
                        "split",
                        "fork"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где полоса движения или путь ответвляется от основного потока",
                        "zh": "道路或路径从主干道分出的位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развилка",
                                "target_lang_sense_clarification": "место разделения дорог"
                            },
                            {
                                "target_lang_word": "ответвление",
                                "target_lang_sense_clarification": "отходящая часть пути"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分叉口",
                                "target_lang_sense_clarification": "道路分开的地方"
                            },
                            {
                                "target_lang_word": "岔路",
                                "target_lang_sense_clarification": "从主路分出的支路"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}