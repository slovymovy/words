                                    },
                                    {
                                        "sense_id": "a4d721a0-0dd0-3e43-9f9a-5f6785ed7ec7",
                                        "entry_id": "4f90c44c-3863-30ab-b129-2fb7b222b7c0",
                                        "glosses": [
                                            "The practice of sitting in a circle and taking turns to speak about one's emotions or experiences while the others listen, intended to be therapeutic or to strengthen relations within the group."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52952131-1510-404a-b2a4-945deac5cc10",
                                                "sense_id": "a4d721a0-0dd0-3e43-9f9a-5f6785ed7ec7",
                                                "text": "The mentoring curriculum included feminist strategies designed to facilitate egalitarian relationships in the groups, including circling, where each person takes a turn to speak while others in the group listen in situations involving decision making or conflict, […]"
                                            }
