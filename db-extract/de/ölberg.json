                                                "example_id": "b2ea7a0c-71d1-47e4-b84e-c707006e597a",
                                                "sense_id": "4c9b2458-1e86-3c17-a1ee-e46028357046",
                                                "text": "Jezus natomiast udał się na Górę Oliwną, ale o brzasku zjawił się znów w świątyni."
                                            },
                                            {
                                                "example_id": "bcf47770-b24f-467a-b3b6-8720ecff81fb",
                                                "sense_id": "4c9b2458-1e86-3c17-a1ee-e46028357046",
                                                "text": "Zbliżał się już do zboczy Góry Oliwnej, kiedy całe mnóstwo uczniów poczęło wielbić radośnie Boga za wszystkie cuda, które widzieli."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
