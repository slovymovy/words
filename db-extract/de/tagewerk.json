                "senses": [
                    {
                        "sense_id": "4f98ae2b-5cc0-3a35-ab6c-97318c24449a",
                        "entry_id": "964af37a-c2a9-3481-888a-c8a39dadc6c4",
                        "glosses": [
                            "nur Singular, besonders regelmäßig innerhalb eines Tages anstehende Arbeit oder zu erledigende Aufgaben"
                        ],
                        "tags": [
                            "Austrian German",
                            "South-German",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "9b52d7c1-e2a5-4419-ae16-f3dc842e4933",
                                "sense_id": "4f98ae2b-5cc0-3a35-ab6c-97318c24449a",
                                "text": "„Auch die Erwachsenen gingen äußerlich ihrem normalen Tagewerk nach.“"
                            },
                            {
                                "example_id": "86655623-88af-4a7c-adc9-d3edca04ca55",
                                "sense_id": "4f98ae2b-5cc0-3a35-ab6c-97318c24449a",
                                "text": "„Mit Rührung wies sie in die Ecke hin, wo in der einzigen Stube das Pianoforte stand, an dem sie ihres verehrten Händels fromme Melodien ihrer Familie nach vollbrachtem Tagewerke vortrug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8c21b169-a460-3b0e-8d00-0fa88608473f",
                        "entry_id": "964af37a-c2a9-3481-888a-c8a39dadc6c4",
                        "glosses": [
                            "an einem Tag erledigte Arbeit"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d3578851-6c5c-3370-ab78-34953fd9636b",
                        "entry_id": "964af37a-c2a9-3481-888a-c8a39dadc6c4",
                        "glosses": [
                            "Plural unverändert, Maßeinheit für landwirtschaftlich genutzte Flächen, zirka 3000 Quadratmeter"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "c72918f8-9ab4-4f17-9564-4fd6ccb1962b",
                                "sense_id": "d3578851-6c5c-3370-ab78-34953fd9636b",
                                "text": "„Bertradis von Bettinghausen genannt die Lipperodsche übereignet dem Kloster Liesborn zehn Tagewerk Ackerland zu Bettinghausen.“"
                            },
                            {
                                "example_id": "61d2210c-d2c9-4da8-89ec-8b9f547509e8",
                                "sense_id": "d3578851-6c5c-3370-ab78-34953fd9636b",
                                "text": "„Der Altenteiler behielt sich zudem die Nutzung der Mittelwiese von vier Tagewerk […] vor.“"
                            },
                            {
                                "example_id": "3e022485-6913-48b5-ab9d-ab62c507fc26",
                                "sense_id": "d3578851-6c5c-3370-ab78-34953fd9636b",
                                "text": "„Zehn Tagewerk Acker auf dem sogenannten Hölthale belegen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
