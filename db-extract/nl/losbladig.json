                "senses": [
                    {
                        "sense_id": "1d551fcd-cc06-3b92-8319-03124dbd03aa",
                        "entry_id": "b4a26453-008d-37c1-a931-f950b69384f6",
                        "glosses": [
                            "bestaande uit losse papieren die men per stuk kan verwijderen, toevoegen of vervangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ce1bed6-2334-46e4-8e0c-d7107d07e6ce",
                                "sense_id": "1d551fcd-cc06-3b92-8319-03124dbd03aa",
                                "text": "Het originele losbladige manuscript van Paal en Perk uit 1951 met veertien losse originele tekeningen van Corneille, een van de duurste stukken van de collectie die zaterdag werd geveild, bracht 32.000 euro op. Vooraf werd uitgegaan van een geschatte waarde van 26.000 tot 30.000 euro."
                            },
                            {
                                "example_id": "47235a18-369a-4150-88ce-db9f77a52785",
                                "sense_id": "1d551fcd-cc06-3b92-8319-03124dbd03aa",
                                "text": "Al in de jaren tachtig werd er in Den Haag gedroomd van een allesomvattend medisch dossier voor elke burger. Dat zou een einde moeten maken aan onoverzichtelijke papierbergen die zich bij artsen, apothekers en ziekenhuizen opstapelden. Aan notities die zorgverleners in een onontcijferbaar handschrift in de marge van een losbladig rapportage kliederden. Aan röntgenfoto’s die op de ene afdeling lagen en gegevens over het medicijngebruik op een andere. Tussen droom en dossier bleken echter wetten in de weg te staan, en veel praktische bezwaren."
                            }
                        ]
                    },
