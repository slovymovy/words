                "senses": [
                    {
                        "sense_id": "47fd1816-adae-3022-bdd3-94fa44f20330",
                        "entry_id": "7d44be18-6fa0-325c-991a-bf6746a8441a",
                        "glosses": [
                            "To improvise one's own style; to ad-lib."
                        ],
                        "tags": [
                            "especially",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9be712c2-47b3-4891-a418-f9098567f695",
                                "sense_id": "47fd1816-adae-3022-bdd3-94fa44f20330",
                                "text": "And just hours after the famous golfer died in an airplane accident, I freestyled to a less talented rival, “Stop now before you get hurt / Your whole style should never take flight like Payne Stewart.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "13d34d59-1b99-3312-88d3-cb134b4bf0f3",
                        "entry_id": "7d44be18-6fa0-325c-991a-bf6746a8441a",
                        "glosses": [
                            "To improvise one's dance moves; dance freely."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0f4d1c72-2f9e-3163-a937-c615df30fd60",
                        "entry_id": "7d44be18-6fa0-325c-991a-bf6746a8441a",
                        "glosses": [
