                "senses": [
                    {
                        "sense_id": "747be066-be06-39ec-9009-831f70c8e02f",
                        "entry_id": "8eb193d5-db30-30b0-895f-960c34dbb544",
                        "glosses": [
                            "in einer Sprühdose abgefülltes Flüssiggas zum Abkühlen von Gegenstände oder Körperteilen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96d254a1-722a-4695-9e24-57786a53122c",
                                "sense_id": "747be066-be06-39ec-9009-831f70c8e02f",
                                "text": "In der Zahnmedizin wird Kältespray zur Sensibilitätsprüfung der Zähne eingesetzt."
                            },
                            {
                                "example_id": "88f8d581-b4cf-497c-8efe-475a079b4b16",
                                "sense_id": "747be066-be06-39ec-9009-831f70c8e02f",
                                "text": "Einsatzgebiet eines Kältesprays ist die Kälteanästhesie in der Medizin."
                            },
                            {
                                "example_id": "4af7e7a2-115c-4aa5-a3bf-45d36047a5bc",
                                "sense_id": "747be066-be06-39ec-9009-831f70c8e02f",
                                "text": "Kältesprays werden zur thermischen Fehlersuche in der Elektronik, zum Kälteschrumpfen und Schockfrieren kleiner Flächen und zur Funktionsprüfung von Temperaturfühlern eingesetzt."
                            }
                        ],
