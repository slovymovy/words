                                        "entry_id": "f5316aae-52d7-3d89-9661-eeec07603458",
                                        "glosses": [
                                            "One of a pair of wedge-heeled shoes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ec18db9-e8fa-4402-913b-29b24c8c60a2",
                                                "sense_id": "5dbfdc8a-9e81-3f15-a43d-7e18a154b22d",
                                                "text": "She was wearing wedges, and I have a horrible suspicion they were her mum's wedges left over from the last century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e47539d-c55b-3c4d-86eb-13d11e6708ad",
                                        "entry_id": "f5316aae-52d7-3d89-9661-eeec07603458",
                                        "glosses": [
                                            "An ingot."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daa7f37d-9fa4-49e1-9297-7a9d635940df",
                                                "sense_id": "9e47539d-c55b-3c4d-86eb-13d11e6708ad",
                                                "text": "Open the Males, yet guard the treaſure ſure.\nLay out our golden wedges to the view,\nThat their reflexions may amaze the Perſeans."
                                            }
                                        ]
                                    },
                                    {
