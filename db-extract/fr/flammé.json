                "senses": [
                    {
                        "sense_id": "3b840128-925b-3284-babf-9257112c41ce",
                        "entry_id": "00dec6a6-d885-3bad-a2e2-819fa1d4cf17",
                        "glosses": [
                            "Qui est d’une teinte assez vive pour donner une idée de flamme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0701de45-1389-459d-b521-c1f7b3084693",
                                "sense_id": "3b840128-925b-3284-babf-9257112c41ce",
                                "text": "Toiles unies, rayées, à carreaux, flammées ou glacées, Tabl. annexé aux lett. pat. du 30 sept. 1780, Tours."
                            },
                            {
                                "example_id": "194f8ad4-86c2-45ab-a3d6-48ab7ebcef0d",
                                "sense_id": "3b840128-925b-3284-babf-9257112c41ce",
                                "text": "Le rouge et le bleu flammé de Chine, autrement, rouge de cuivre au grand feu."
                            },
                            {
                                "example_id": "06ccb2eb-cf68-44d4-9c6e-40910bf64cfb",
                                "sense_id": "3b840128-925b-3284-babf-9257112c41ce",
                                "text": "Des teintes toutes particulières,… flammées, parfois, de tons violacés et bleus, mais avec une vigueur et une profondeur admirables."
                            }
                        ]
                    },
                    {
                        "sense_id": "42790b07-ffba-332a-a95b-6ba8cfd3de4c",
                        "entry_id": "00dec6a6-d885-3bad-a2e2-819fa1d4cf17",
                        "glosses": [
                            "Pourvu d’une flamme d’oblitération."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d6bc1e4a-208f-4133-91f7-2d5b121a21cc",
                                "sense_id": "42790b07-ffba-332a-a95b-6ba8cfd3de4c",
                                "text": "Après le tâtonnement des débuts et l’élimination de sujets mineurs, Morestel avait ainsi défini le thème de sa collection : le monde entier en couleurs; oblitéré et flammé, de préférence; aucun album, mais des étuis cartonnés, numérotés, répertoriés."
                            }
                        ]
                    }
