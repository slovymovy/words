{
    "word_family": [
        "ignorance",
        "ignare"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ec80e2b0-2c7a-332d-9c1c-b841ddb13b01",
                    "sense_definition": "Ne pas savoir quelque chose, ne pas en avoir connaissance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>ignore</w> totalement la raison pour laquelle il a quitté la réunion si tôt."
                        },
                        {
                            "text": "Les scientifiques <w>ignorent</w> encore comment ce phénomène biologique se produit dans la nature."
                        }
                    ],
                    "synonyms": [
                        "méconnaître"
                    ],
                    "antonyms": [
                        "connaître",
                        "savoir"
                    ],
                    "common_phrases": [
                        "ignorer la raison",
                        "ignorer la vérité"
                    ]
                },
                {
                    "sense_id": "85597589-d7a3-3f31-ae26-8853be4eb0f5",
                    "sense_definition": "Ne pas tenir compte de quelqu'un ou de quelque chose, feindre de ne pas le remarquer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur a <w>ignoré</w> les avertissements lumineux et a continué d'avancer malgré le danger."
                        },
                        {
                            "text": "Quand elle est en colère, elle <w>ignore</w> systématiquement les messages de ses amis."
                        }
                    ],
                    "synonyms": [
                        "dédaigner",
                        "négliger"
                    ],
                    "antonyms": [
                        "considérer",
                        "écouter"
                    ],
                    "common_phrases": [
                        "ignorer les avertissements",
                        "ignorer les conseils"
                    ]
                },
                {
                    "sense_id": "cf8885ac-d87d-36e9-a913-ed4b8772b2cb",
                    "sense_definition": "N'avoir pas conscience de sa propre valeur, de ses capacités ou de sa vraie nature.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune écrivain de grand talent s'<w>ignorait</w> encore avant la publication de son premier roman."
                        },
                        {
                            "text": "Beaucoup d'artistes s'<w>ignorent</w> pendant des années avant d'oser enfin montrer leurs créations au public."
                        }
                    ],
                    "synonyms": [
                        "se méconnaître"
                    ],
                    "antonyms": [
                        "se connaître"
                    ],
                    "common_phrases": [
                        "s'ignorer soi-même"
                    ]
                }
            ]
        }
    ]
}