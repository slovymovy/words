                ],
                "senses": [
                    {
                        "sense_id": "0e5bb8f9-c008-363c-be1e-cce34bf5f74b",
                        "entry_id": "685f9092-61f1-30ed-ad83-62137f3f87ed",
                        "glosses": [
                            "Organisation, die aus einer Gruppe von Ländern oder Städten besteht, die ihre gemeinsamen wirtschaftlichen Interessen bündeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9dfb1be-4227-44de-b767-a65ec82f2417",
                                "sense_id": "0e5bb8f9-c008-363c-be1e-cce34bf5f74b",
                                "text": "„Der europäische Status quo ist: Die EU ist hauptsächlich ein undemokratischer, technokratischer Wirtschaftsverbund.“"
                            },
                            {
                                "example_id": "a3879e26-66da-47e6-94e6-d82a194d01a0",
                                "sense_id": "0e5bb8f9-c008-363c-be1e-cce34bf5f74b",
                                "text": "„Am 23. Juli 1952 trat die Montanunion in Kraft, ein europäischer Wirtschaftsverbund, dem außer der Bundesrepublik und Frankreich Belgien, Italien, die Niederlande und Luxemburg angehörten. Alle sechs Länder schufen einen gemeinsamen Markt für Kohle und Stahl, für den der Zoll entfiel.“"
                            },
                            {
                                "example_id": "4dfe7a63-b99e-40a8-9e9a-5e8c054cec14",
                                "sense_id": "0e5bb8f9-c008-363c-be1e-cce34bf5f74b",
                                "text": "„North American Free Trade Agreement (NAFTA, Nordamerikanisches Freihandelsabkommen) ist ein ausgedehnter Wirtschaftsverbund zwischen Kanada, den USA sowie Mexiko und bildet eine Freihandelszone.“"
                            },
                            {
                                "example_id": "d8b79d2f-6f80-4c00-90eb-c296121f47fd",
                                "sense_id": "0e5bb8f9-c008-363c-be1e-cce34bf5f74b",
                                "text": "„Der 1991 gegründete \"Gemeinsame Markt des Südens\" (Mercosur) ist ein südamerikanischer Wirtschaftsverbund, zu dem Argentinien, Brasilien, Paraguay und Uruguay gehören.“"
                            },
                            {
                                "example_id": "c10c9537-fafb-4619-9593-63c5f8236a41",
                                "sense_id": "0e5bb8f9-c008-363c-be1e-cce34bf5f74b",
                                "text": "„Aus diesem Grund wird ein geplantes Freihandelsabkommen zwischen der EU und dem lateinamerikanischen Wirtschaftsverbund Mercosur abgelehnt,“ […]."
                            },
                            {
                                "example_id": "65a8386f-a079-4924-aa78-f2142314dc5b",
                                "sense_id": "0e5bb8f9-c008-363c-be1e-cce34bf5f74b",
                                "text": "„1996 - Myanmar (vormals Birma) wird trotz westlicher Proteste wegen Menschenrechtsverletzungen als Vollmitglied in den südostasiatischen Wirtschaftsverbund Asean aufgenommen.“"
                            },
                            {
                                "example_id": "3817d93d-c96b-4d73-a58d-53cc93285b7e",
                                "sense_id": "0e5bb8f9-c008-363c-be1e-cce34bf5f74b",
                                "text": "„Hat die Hanse, der europäische Wirtschaftsverbund im späten Mittelalter, tatsächlich die Globalisierung erfunden?“"
                            },
                            {
                                "example_id": "dc7cc82a-1c90-4cd0-82d6-660f93b0a24a",
                                "sense_id": "0e5bb8f9-c008-363c-be1e-cce34bf5f74b",
                                "text": "[…] „Ein Star wird gefeiert, ein Pirat, der vor gut 600 Jahren gelebt hat: Klaus Störtebeker. Einer, der mit seinen Leuten angeblich der Hanse, einem Wirtschaftsverbund mehrer Städte an der Ostsee, das Leben schwer gemacht haben soll.“"
                            },
                            {
                                "example_id": "24318e45-f6ce-42d1-b2a8-9712b7c663e9",
                                "sense_id": "0e5bb8f9-c008-363c-be1e-cce34bf5f74b",
                                "text": "„Der Stettener Oktober mit verkaufsoffenem Sonntag findet am zweiten Oktoberwochenende statt. Er wird vom Stettener Wirtschaftsverbund veranstaltet.“"
                            },
                            {
                                "example_id": "d3b0ce18-16ed-435d-a4f6-0aab822be94e",
                                "sense_id": "0e5bb8f9-c008-363c-be1e-cce34bf5f74b",
                                "text": "„Der lokale Wirtschaftsverbund Hiltrup etabliert seine Veranstaltungen inzwischen als stadtweit bekannte und feststehende Events im Veranstaltungskalender (Frühlingsfest mit Ortskern-Sperrung, Radrennen „Rund um die Marktallee“, Lichterfest etc.).“"
                            },
                            {
                                "example_id": "a83dfe8b-3dec-4178-ad1a-964dbdbb7642",
                                "sense_id": "0e5bb8f9-c008-363c-be1e-cce34bf5f74b",
                                "text": "„Übelbach gehört zum 2005 gegründeten Wirtschaftsverbund Region Übelbachtal, dem darüber hinaus die Gemeinden Deutschfeistritz, Peggau und die ehemalige Gemeinde Großstübing angehören.“"
                            },
                            {
                                "example_id": "0d69dd23-1c77-47a1-b319-dbe6909d18d5",
                                "sense_id": "0e5bb8f9-c008-363c-be1e-cce34bf5f74b",
                                "text": "„Der Wirtschaftsverbund Löffingen entwickelt sich immer mehr zu einer angesehenen Institution mit dem Ziel, den Wirtschaftsstandort Löffingen zu stärken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
