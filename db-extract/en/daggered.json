    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f37ead13-8faf-38f7-b291-3252ec34e277",
                "word": "daggered",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fe657a59-d53f-3627-af45-9f8e5e3e0217",
                        "entry_id": "f37ead13-8faf-38f7-b291-3252ec34e277",
                        "glosses": [
                            "Wearing or carrying a dagger."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c21df342-0f9e-4488-8b4a-372f543d1ce2",
                                "sense_id": "fe657a59-d53f-3627-af45-9f8e5e3e0217",
                                "text": "It is true we wear a “dagger,” but we deny ever having been in our life an aggressor upon any man; so that if we be a “daggered assassin,” we ask the Governor to produce the proofs!"
                            },
                            {
                                "example_id": "f942d942-15d6-427c-ad38-b50ffbc2e304",
                                "sense_id": "fe657a59-d53f-3627-af45-9f8e5e3e0217",
                                "text": "Yet in the plenitude of its philanthropy it allows the worse than daggered assassin to enter the home of our adopted citizens, and administer that bane which deprives them of health and life."
                            },
                            {
                                "example_id": "1b336604-ce17-4e12-aee8-56fe47b4f512",
                                "sense_id": "fe657a59-d53f-3627-af45-9f8e5e3e0217",
                                "text": "Then the dream returned to her, like some daggered thief."
                            },
                            {
                                "example_id": "f1bd49c8-2db2-4402-8285-54968ba2a71c",
                                "sense_id": "fe657a59-d53f-3627-af45-9f8e5e3e0217",
                                "text": "The would be assassin charged the woman. Omniheckren’s minion would not have caught the daggered man in time enough had the young Agnarogian woman not stilled time itself to prevent the attack."
                            },
                            {
                                "example_id": "ba5fef8d-1c8a-46fa-8c11-d4946f99236d",
                                "sense_id": "fe657a59-d53f-3627-af45-9f8e5e3e0217",
                                "text": "Had we really two or so years together, before the indulgences of her previous existence caught up with her, like a daggered assassin who treads only a step behind?"
                            }
                        ]
                    }
                ],
