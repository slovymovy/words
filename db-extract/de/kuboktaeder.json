                                        "entry_id": "e658e188-6655-3fde-8bbd-e06b72844480",
                                        "glosses": [
                                            "Tétradécaèdre intersection d’un cube et d’un octaèdre."
                                        ],
                                        "tags": [],
                                        "examples": [
