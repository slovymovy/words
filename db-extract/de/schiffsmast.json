                "senses": [
                    {
                        "sense_id": "d686a81b-455d-3916-8bb9-1dc01b78a4cc",
                        "entry_id": "ecd6624c-39bf-3390-a0da-773b0b09e8af",
                        "glosses": [
                            "Mast eines (Segel-)Schiffes"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "22d1913e-0b02-4661-b5ef-22f1384d3694",
                                "sense_id": "d686a81b-455d-3916-8bb9-1dc01b78a4cc",
                                "text": "„Augustus, erzählte man, habe Eros, seinen Prokurator in Ägypten, weil er eine in allen Kämpfen siegreich gebliebene Wachtel kaufte und braten ließ, an einen Schiffsmast nageln lassen.“"
                            },
                            {
                                "example_id": "abf17495-e498-446a-849e-41e57b65cf09",
                                "sense_id": "d686a81b-455d-3916-8bb9-1dc01b78a4cc",
                                "text": "„Als der Staub verflogen war, erkannten sie einen Schiffsmast, der unter dem Stiefel des Zöllners zerbröckelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
