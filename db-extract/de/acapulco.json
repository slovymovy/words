                    {
                        "translation_id": "2e3bc378-85b6-4ea7-8a4a-8fc8fdc849de",
                        "source_entry_id": "2e81a435-8e03-3dd5-9df1-257340daea03",
                        "source_sense_id": "769e84c6-8708-33f0-b572-9ed381d86552",
