                ],
                "senses": [
                    {
                        "sense_id": "aef9b53b-7b24-33ae-b778-bba6d5ecd080",
                        "entry_id": "c038d095-95ae-3eba-82d3-a31e610eca77",
                        "glosses": [
                            "Platz (Sitzplatz oder Stehplatz) für Zuschauer auf der Tribüne (oft in einem Stadion oder einer Sporthalle)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0aaac7b-b5fd-4d50-88c0-03eac29dc62b",
                                "sense_id": "aef9b53b-7b24-33ae-b778-bba6d5ecd080",
                                "text": "„Nördlich der Düssel wurde eine Arena mit 3600 m² Spielfläche und 4000 Tribünenplätzen für Veranstaltungen geschaffen.“"
                            },
                            {
                                "example_id": "2ea4faa6-81b9-4af4-a629-b26fd2c20d88",
                                "sense_id": "aef9b53b-7b24-33ae-b778-bba6d5ecd080",
                                "text": "[Seoul-World-Cup-Stadion:] „Das Dach überspannt 90 Prozent der Tribünenplätze.“"
                            },
                            {
                                "example_id": "a911f97b-dd66-45bd-94c4-2be76d198fc2",
                                "sense_id": "aef9b53b-7b24-33ae-b778-bba6d5ecd080",
                                "text": "„Die erste Hälfte verfolgte er noch von einem Tribünenplatz aus, nach der Pause saß Reschke auf der Bank.“"
                            },
                            {
                                "example_id": "b5526ee6-7408-4b08-aa8d-5030e0f797d5",
                                "sense_id": "aef9b53b-7b24-33ae-b778-bba6d5ecd080",
                                "text": "„Der 76-jährige Beckenbauer, der sonst nur noch sehr selten in der Öffentlichkeit präsent ist, war in der Arena in Sinsheim auf einem Tribünenplatz zu sehen.“"
                            },
                            {
                                "example_id": "cae9daaa-3c5a-4020-8014-7eb8c10469b5",
                                "sense_id": "aef9b53b-7b24-33ae-b778-bba6d5ecd080",
                                "text": "„Am 7. Oktober trifft die Schweiz im letzten Heimspiel der WM-Qualifikation auf Ungarn. Attraktive Familientickets locken mit guten Tribünenplätzen, Hotdogs und Getränken nach Wahl sowie Süssigkeiten in der Pause.“"
                            },
                            {
                                "example_id": "2aa40dd6-ddf1-490f-a8e2-17941965cb2f",
                                "sense_id": "aef9b53b-7b24-33ae-b778-bba6d5ecd080",
                                "text": "[Fußball-Europameisterschaft 2016:] „Die Preisspanne bewegte sich – abhängig vom Tribünenplatz – von 25 Euro in der Vorrunde (Kategorie 4) bis 895 Euro für das EM-Finale in der besten Kategorie.“"
                            },
                            {
                                "example_id": "45d0e16f-3fca-49b8-a1e0-89ea8719f907",
                                "sense_id": "aef9b53b-7b24-33ae-b778-bba6d5ecd080",
                                "text": "[Stadion Upton Park:] „Ein vorerst letztes Bier in den Stadionkatakomben, dann gehen die drei hinauf auf ihre Tribünenplätze. Der Stadionsprecher liest die Mannschaftsaufstellung vor.“"
                            },
                            {
                                "example_id": "37ca684a-f29f-480f-a5ff-1012c950f1f7",
                                "sense_id": "aef9b53b-7b24-33ae-b778-bba6d5ecd080",
                                "text": "„Der DFB verlangt in seinen Auflagen von den Vereinen in der vierten Liga unter anderem eine Flutlichtanlage, überdachte Tribünenplätze und einen eingezäunten Gästeblock – nichts davon ist im Friedrich-Ebert-Stadion vorhanden.“"
                            },
                            {
                                "example_id": "5edb2905-cd13-4030-a111-afc997f3e894",
                                "sense_id": "aef9b53b-7b24-33ae-b778-bba6d5ecd080",
                                "text": "„Das Stadion verfügte zu den Biathlon-Weltmeisterschaften 2015 über 15.000 Steh- und Sitzplätze sowie behindertengerechte Tribünenplätze in Schießstandnähe und weitere 6.000 Stehplätze direkt an der Strecke.“"
                            },
                            {
                                "example_id": "08b0976e-177c-44c4-a371-b57c81f064da",
                                "sense_id": "aef9b53b-7b24-33ae-b778-bba6d5ecd080",
                                "text": "[Tanz-WM in Leipzig:] „Für die Vorrunden sind noch Tickets erhältlich, für die Abendveranstaltung stehen lediglich letzte Tribünenplätze zum Verkauf.“"
                            },
                            {
                                "example_id": "563ebf1c-8889-41f3-98bb-257594d2bf47",
                                "sense_id": "aef9b53b-7b24-33ae-b778-bba6d5ecd080",
                                "text": "[Karneval in der Coronapandemie 2022:] „Zugelassen sind demnach 8800 Besucher für die Tribünenplätze im Stadion unter 2G-Plus-Regelungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
