                                                "sense_id": "0079afc3-e584-3ddb-ba4f-c59e91950ecd",
                                                "text": "This flow chart represents the assignment of tasks in our committee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81536313-1891-3429-aa97-db986ed8e5cb",
                                        "entry_id": "1a936b6d-9153-3586-9316-e2dc4be872af",
                                        "glosses": [
                                            "The categorization of something as belonging to a specific category."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feefb0b7-c9a4-46ae-b4fe-8f6ae83b4d20",
                                                "sense_id": "81536313-1891-3429-aa97-db986ed8e5cb",
                                                "text": "We should not condone the assignment of asylum seekers to that of people smugglers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "070b204a-f9c9-3ea4-97bb-f9ea3edcc649",
