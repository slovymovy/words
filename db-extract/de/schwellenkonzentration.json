                ],
                "senses": [
                    {
                        "sense_id": "8aaff6d0-63bc-30fd-b313-f5770383b818",
                        "entry_id": "95e0df25-8dbb-3944-8244-d1cbffe9ea2c",
                        "glosses": [
                            "Minimalwert einer Größe, ab der ein interessierender Effekt einsetzt (Relevanz, Wahrnehmung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c9d6917-b341-4c6a-8353-ce78fe436820",
                                "sense_id": "8aaff6d0-63bc-30fd-b313-f5770383b818",
                                "text": "„Nicht am Erbgut angreifende Gifte zeigen eine Schwellenkonzentration, unterhalb derer auch bei langer Exposition kein Effekt zu beobachten ist.“"
                            },
                            {
                                "example_id": "3701677b-72e4-447d-bc40-65b0756ad799",
                                "sense_id": "8aaff6d0-63bc-30fd-b313-f5770383b818",
                                "text": "„Die Schwellenkonzentrationen betragen hierbei 1∶4 bis 1∶1 Mill.“"
                            },
                            {
                                "example_id": "18a0eff8-fc2f-4919-bb36-c37cb72c5b66",
                                "sense_id": "8aaff6d0-63bc-30fd-b313-f5770383b818",
                                "text": "„Dafür werden stündliche Konzentrationsmittelwerte oberhalb einer Schwellenkonzentration von 80 µg/m³ für Tageslichtstunden (08.00h - 20.00h) während der Vegetationsperiode aufsummiert.“"
                            },
                            {
                                "example_id": "507e043c-5448-4556-b955-77e8ce806da1",
                                "sense_id": "8aaff6d0-63bc-30fd-b313-f5770383b818",
                                "text": "„Wird bei der Eingabe des Schwellenkonzentration 0 gesetzt, berücksichtigt das Programm diese Konzentration mit einem Vielfachen des ERPG-1 oder, falls der ERPG-1 nicht vorhanden ist, den TEEL-1 Wert. Falls weder der ERPG-1 noch der TEEL-1 Wert vorhanden sind wird der MAK als Schwellenkonzentration übernommen.“"
                            },
                            {
                                "example_id": "c0530ffc-c7b9-49f4-826e-9b598c47d3b3",
                                "sense_id": "8aaff6d0-63bc-30fd-b313-f5770383b818",
                                "text": "„Solange die Arzneimittel-Konzentration wesentlich unterhalb der toxischen Schwellenkonzentration liegt, treten keine unerwünschten Effekte auf.“"
                            },
                            {
                                "example_id": "e1b0999b-8f65-4be0-acd1-edb4d0e2cffb",
                                "sense_id": "8aaff6d0-63bc-30fd-b313-f5770383b818",
                                "text": "„Bislang konnte keine Schwellenkonzentration abgeleitet werden, unterhalb der keine Gefahr für die Gesundheit besteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
