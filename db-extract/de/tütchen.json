                ],
                "senses": [
                    {
                        "sense_id": "8d1da8e2-8c18-3dcb-b882-9beda0b9c0da",
                        "entry_id": "79be986f-1dd5-32d5-a4c4-1a5050ca3a66",
                        "glosses": [
                            "kleine Tüte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2ba8eb3-bee4-4176-88ba-513101d2c88a",
                                "sense_id": "8d1da8e2-8c18-3dcb-b882-9beda0b9c0da",
                                "text": "„Die Kinder bekommen ein mit ihrem Namen beschriftetes Tütchen, in das sie die gesammelten Süßigkeiten den Nachmittag über sammeln und mit nach Hause nehmen.“"
                            },
                            {
                                "example_id": "c42de336-ae7e-4daa-b149-0a12ea49ea07",
                                "sense_id": "8d1da8e2-8c18-3dcb-b882-9beda0b9c0da",
                                "text": "„Sie riss ein Tütchen auf und kratzte mir mit einer kleinen Metallbürste über den Arm.“"
                            },
                            {
                                "example_id": "d46f57ec-f2de-427d-8d20-6a3dd6f7091b",
                                "sense_id": "8d1da8e2-8c18-3dcb-b882-9beda0b9c0da",
                                "text": "„Meistens meide ich den verwüsteten Verkaufsraum, aber einmal ging ich doch an den Ständer mit den bunten Tütchen vorbei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
