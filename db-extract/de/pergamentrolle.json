                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6e29b0c-5ff1-4412-b326-b986bc927f7a",
                                "sense_id": "37f129b0-5fc3-35e8-9722-d1a61db5e91d",
                                "text": "„Diese Kopie stammt aus dem zwölften Jahrhundert, wie das Papier der Pergamentrolle verrät.“"
                            },
                            {
                                "example_id": "ca6eb6e1-1a7c-4f6a-8085-44c9d5cceda6",
                                "sense_id": "37f129b0-5fc3-35e8-9722-d1a61db5e91d",
                                "text": "„Er zog eine staubige, halb mit Spinnweben verklebte Pergamentrolle hervor.“"
                            },
                            {
                                "example_id": "324244f3-1b14-41f1-a827-ea3d7209095b",
                                "sense_id": "37f129b0-5fc3-35e8-9722-d1a61db5e91d",
                                "text": "„Er gab einem der besonders nervös dreinblickenden Antenauten ein Zeichen; der Mann trat vor, in der Hand eine Pergamentrolle, die er ausbreitete und Atticus zeigte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
