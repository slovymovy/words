        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a5083b22-07dd-307e-9696-6a04fdcba60f",
                    "sense_definition": "An imitation intended to be passed off fraudulently as genuine; a forgery.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_fraud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Experts quickly determined that the antique painting was merely a clever <w>counterfeit</w>.",
                            "target_lang_translations": {
                                "ru": "Эксперты быстро установили, что старинная картина была всего лишь искусной <w>подделкой</w>.",
                                "nl": "Experts stelden al snel vast dat het antieke schilderij slechts een knappe <w>vervalsing</w> was."
                            }
                        },
                        {
                            "text": "Never mistake an obvious <w>counterfeit</w> for the genuine article.",
                            "target_lang_translations": {
                                "ru": "Никогда не принимайте очевидную <w>фальшивку</w> за оригинал.",
                                "nl": "Verwar een overduidelijk <w>namaaksel</w> nooit met het origineel."
                            }
                        }
                    ],
                    "synonyms": [
                        "fake",
                        "forgery",
                        "imitation"
                    ],
                    "antonyms": [
                        "original"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имитация, выдаваемая обманным путём за оригинал; фальшивка.",
                        "nl": "Een nabootsing die bedrieglijk wordt gepresenteerd als origineel; een namaaksel."
                    },
                    "translations": {
