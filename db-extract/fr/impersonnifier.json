                ],
                "senses": [
                    {
                        "sense_id": "eaa7757b-fb12-3211-ac9a-a6628490fb9d",
                        "entry_id": "8b24ba68-f1ea-3e29-86fd-89bb11d7b238",
                        "glosses": [
                            "Représenter quelqu’un d’autre, l’imiter ou se faire passer pour lui."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bb8d9b5-8a63-4618-9dae-350194f7c5c1",
                                "sense_id": "eaa7757b-fb12-3211-ac9a-a6628490fb9d",
                                "text": "Cette capacité d’« impersonnifier » d’autres personnes était fort utile."
                            },
                            {
                                "example_id": "67ae9da9-bc9f-4dd7-aa83-a5656305e26f",
                                "sense_id": "eaa7757b-fb12-3211-ac9a-a6628490fb9d",
                                "text": "Autonomisation de la société civile, cela veut dire libération d’un pôle pratique de mouvement par rapport à un pôle transcendant de stabilité. Lequel n’existe à son tour de façon véritablement indépendante qu’une fois le pouvoir impersonnifié, désincorporé, expressément « représentativisé »."
                            }
                        ]
                    }
