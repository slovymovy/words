            "pos": "verb",
            "senses": [
                {
                    "sense_id": "29be5812-b1e9-3715-9188-9ea7c9ed1ee8",
                    "sense_definition": "Poursuivre ce qui a été commencé sans s'interrompre.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "poursuivre_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>continuer</w> notre travail pour finir avant ce soir."
                        },
                        {
                            "text": "Après une courte pause, il a décidé de <w>continuer</w> sa lecture."
                        }
                    ],
                    "antonyms": [
                        "terminer"
                    ],
                    "common_phrases": [
                        "continuer à faire",
                        "continuer son chemin"
                    ]
                },
                {
                    "sense_id": "7a25ff62-ef3b-33df-8f70-eac0cd2c0cd6",
                    "sense_definition": "Durer, persister dans le temps sans s'arrêter.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "durer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La pluie <w>continue</w> de tomber sans arrêt depuis ce matin."
                        },
                        {
                            "text": "Si cette douleur <w>continue</w>, tu devrais consulter un médecin sans attendre."
                        }
                    ],
                    "common_phrases": [
                        "continuer de plus belle"
                    ]
                },
                {
                    "sense_id": "11571001-7433-3a47-8cbc-56c0a463b1c4",
                    "sense_definition": "Prolonger un objet, une construction ou une ligne dans l'espace.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers vont <w>continuer</w> cette route jusqu'au village voisin."
                        },
                        {
                            "text": "L'architecte propose de <w>continuer</w> le mur pour mieux fermer le jardin."
                        }
                    ],
                    "synonyms": [
                        "prolonger"
                    ],
                    "common_phrases": [
                        "continuer une ligne",
                        "continuer une allée"
                    ]
                },
                {
                    "sense_id": "3dd6d0b6-3bc6-3c34-984a-cea3145c9c85",
                    "sense_definition": "S'étendre de manière ininterrompue dans l'espace.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sentier <w>continue</w> à travers la forêt jusqu'au sommet de la colline."
                        },
                        {
                            "text": "Cette chaîne de montagnes <w>continue</w> sur plusieurs centaines de kilomètres."
                        }
                    ],
                    "common_phrases": [
                        "continuer jusqu'à"
                    ]
                },
                {
                    "sense_id": "e47627d2-558d-3b35-998a-712798881929",
                    "sense_definition": "Maintenir ou renouveler l'attribution d'un avantage ou d'une pension à quelqu'un.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "maintenir_droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'université a accepté de lui <w>continuer</w> sa bourse d'études cette année."
                        },
                        {
                            "text": "Le directeur a promis de leur <w>continuer</w> son soutien financier malgré la crise."
                        }
                    ],
                    "common_phrases": [
                        "continuer une pension"
                    ]
                },
                {
                    "sense_id": "b26b05a6-e6e7-3690-803c-3fb59ba04e23",
                    "sense_definition": "Maintenir quelqu'un dans une charge ou des fonctions par réélection ou reconduction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "maintenir_droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conseil d'administration a décidé de le <w>continuer</w> dans ses fonctions de directeur."
                        },
                        {
                            "text": "Après le vote, elle fut <w>continuée</w> à la présidence du comité pour un an."
                        }
                    ],
                    "common_phrases": [
                        "continuer dans ses fonctions"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Sens vieilli, aujourd'hui remplacé par reconduire"
                        }
                    ]
                }
            ]
        }
    ]
