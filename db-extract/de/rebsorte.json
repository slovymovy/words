                ],
                "senses": [
                    {
                        "sense_id": "40be2da3-dc7b-336e-85eb-c7e8cfdfd618",
                        "entry_id": "f681a0e4-b077-32f0-99a2-23cbd253de02",
                        "glosses": [
                            "die verschiedenen Varietäten der Weinrebe, die der Mensch aus der Wildrebe herausgezüchtet hat"
                        ],
                        "tags": [
                            "verallgemeinernd"
                        ],
                        "examples": [
                            {
                                "example_id": "d7c12a1c-ba72-458f-9f98-db7571352606",
                                "sense_id": "40be2da3-dc7b-336e-85eb-c7e8cfdfd618",
                                "text": "Als Stammform aller Rebsorten gilt die im Mittelmeergebiet, aber auch am Oberrhein und an der Donau verbreitete, zweihäusige Wildrebe."
                            },
                            {
                                "example_id": "d2332af5-c8aa-40e4-9257-4fd65158b358",
                                "sense_id": "40be2da3-dc7b-336e-85eb-c7e8cfdfd618",
                                "text": "Der Mensch hat im Laufe von ca. 5000 Jahren viele hundert verschiedene Rebsorten von der Wildrebe ausgehend gezüchtet."
                            },
                            {
                                "example_id": "a92a0858-f799-436a-b1c9-81ca0b1f0ee3",
                                "sense_id": "40be2da3-dc7b-336e-85eb-c7e8cfdfd618",
                                "text": "\"Die Rebsorte ist – neben der durch Anbau bestimmten Lage und dem Boden – einer der Bausteine, die den Geschmack und Charakter eines Weines bestimmen.\""
                            },
                            {
                                "example_id": "83448104-08f2-4eea-a572-c2d48705ea69",
                                "sense_id": "40be2da3-dc7b-336e-85eb-c7e8cfdfd618",
                                "text": "\"Die Rebsorten sind die Meilensteine auf der Landkarte des Weins. … Die Rebsorte ist zwar nur ein Faktor, der den Geschmack des Weins bestimmt - neben der Weinbereitungstechnik und dem Boden, die mindestens eben so wichtig sind -, aber das Wissen über die wichtigsten Rebsorten kann doch höchst nützlich bei der Wahl des Weins sein.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
