                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66267c7c-0e0d-4b63-ae6c-1f102a7659f6",
                                                "sense_id": "60b5eb2f-ca07-381b-9324-a7979fc0bc59",
                                                "text": "Auf der Page finden sie alle wichtigen Informationen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5787a400-68c4-4f39-933e-6ea03398c76c",
                        "source_entry_id": "f81acaba-8c2e-3a09-ba66-723a458327d2",
                        "source_sense_id": "bf72b907-c49f-3bef-81d1-5d25a1e4bc6f",
                        "source_sense_description": "Page, Hotelpage",
                        "target_lang_word": "Hotelpage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hotelpage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47267a98-45cd-325d-8f01-42f78c7cc1b5",
                                        "entry_id": "f90db3f0-1000-35f4-8e0e-d8bac870834a",
                                        "glosses": [
                                            "(männliche^☆) Person, die als Diener in einem Hotel arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a23cdcec-e725-4696-a2df-47259a933009",
                                                "sense_id": "47267a98-45cd-325d-8f01-42f78c7cc1b5",
                                                "text": "„Als Max öffnete, sah er sich einem Hotelpagen und einem Mann gegenüber, der einen karierten Anzug trug und eine Melone aufhatte.“"
                                            },
                                            {
                                                "example_id": "f685835b-b418-4516-8999-2b601d22bfde",
                                                "sense_id": "47267a98-45cd-325d-8f01-42f78c7cc1b5",
                                                "text": "„Der Hotelpage schob mich durch die Drehtür hinein, ich entdeckte Ramin in einem schwarzen Sessel und blieb am Eingang stehen.“"
                                            },
                                            {
                                                "example_id": "7c9911a1-c3c8-4eda-8317-8fe3aa917da3",
                                                "sense_id": "47267a98-45cd-325d-8f01-42f78c7cc1b5",
                                                "text": "„Dann ging sie, von einem Hotelpagen und von ihrem Betreuer begleitet, zum Lift.“"
                                            },
                                            {
                                                "example_id": "d8a9e896-7933-44d6-871a-4feeb0c59cfb",
                                                "sense_id": "47267a98-45cd-325d-8f01-42f78c7cc1b5",
                                                "text": "„Jeder, der eine Lehre als Koch oder Kellner beginnen wollte, musste vorher ein Jahr Hotelpage sein, und das nur mit Kost und sehr einfacher Logis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
