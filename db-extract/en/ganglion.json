                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1b0e707-01c1-47eb-857b-64ea1a7e14f5",
                                                "sense_id": "cc33fab9-1e5d-3412-b0c8-ee83a65b1bef",
                                                "text": "Eine ganze Note besteht nur aus dem Kopf."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "0f1193af-a6f6-3212-ad9e-05608e193979",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
