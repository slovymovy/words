                                                "sense_id": "951fc14b-8b7f-3a72-8497-b83bd8e138fa",
                                                "text": "Võ thuật cao cường."
                                            },
                                            {
                                                "example_id": "0af543d2-57b2-4de8-b8cd-52f8362b4ccd",
                                                "sense_id": "951fc14b-8b7f-3a72-8497-b83bd8e138fa",
                                                "text": "Cô này võ thuật không thua ai."
                                            },
                                            {
                                                "example_id": "6c4fdbb9-925d-4120-9798-a434c5a8bad2",
                                                "sense_id": "951fc14b-8b7f-3a72-8497-b83bd8e138fa",
                                                "text": "Vị võ sư này võ thuật thuộc hàng nhất nhì trong thiên hạ."
                                            },
                                            {
                                                "example_id": "c8129cf8-d370-4895-8fa7-710962b53305",
                                                "sense_id": "951fc14b-8b7f-3a72-8497-b83bd8e138fa",
                                                "text": "Cố Võ sư Trần Tiến đã dạy võ thuật cho Đặt Công, Công An,..."
                                            }
                                        ]
