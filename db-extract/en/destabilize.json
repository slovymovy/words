                                        "examples": [
                                            {
                                                "example_id": "d2b7be59-8157-4d97-a04a-dee646c2fbf5",
                                                "sense_id": "24e17e52-2360-3a3a-b5c5-ae9973ac7729",
                                                "text": "Daarmee destabiliseerden zij het land."
