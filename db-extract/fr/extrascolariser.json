                        "glosses": [
                            "Donner un caractère extrascolaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47c21ec8-6258-4f88-9031-e03bd2db82f7",
                                "sense_id": "d4ee4116-c1e8-39b7-ab5f-7c4be43f364f",
                                "text": "Face à une conjoncture jugée défavorable visant à « extrascolariser » l’enseignement de l’EPS, l’intensité de l’action ne faiblit pas."
                            },
                            {
                                "example_id": "849781ca-540e-4cf4-8b86-1858355fdcc3",
                                "sense_id": "d4ee4116-c1e8-39b7-ab5f-7c4be43f364f",
                                "text": "En extrascolarisant la rééducation corporelle des jeunes déficients, une partie de l’éducation physique s’éloigne un peu de l’école alors qu’elle revendique par ailleurs sa place originale en matière de santé au sein de la société."
                            }
                        ]
                    }
