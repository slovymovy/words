{
    "word_family": [
        "dosage",
        "overdose"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "69e81d88-9208-30a2-a80f-899036f5a5f0",
                    "sense_definition": "A measured portion of medicine taken at any one time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor prescribed a low <w>dose</w> of antibiotics for the infection.",
                            "target_lang_translations": {
                                "ru": "Врач прописал низкую <w>дозу</w> антибиотиков от инфекции.",
                                "zh": "医生给这种感染开了低<w>剂量</w>的抗生素。",
                                "es": "El médico recetó una <w>dosis</w> baja de antibióticos para la infección."
                            }
                        },
                        {
                            "text": "You should not exceed the recommended daily <w>dose</w> of this medication.",
                            "target_lang_translations": {
                                "ru": "Не следует превышать рекомендуемую суточную <w>дозу</w> этого лекарства.",
                                "zh": "你不应该超过这种药物建议的每日<w>剂量</w>。",
                                "es": "No debes superar la <w>dosis</w> diaria recomendada de este medicamento."
                            }
                        }
                    ],
                    "synonyms": [
                        "amount",
                        "measurement"
                    ],
                    "common_phrases": [
                        "daily dose",
                        "miss a dose",
                        "recommended dose",
                        "high dose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определённое количество лекарства, принимаемое за один раз.",
                        "zh": "一次服用的、经过计量的药物分量。",
                        "es": "Cantidad medida de un medicamento que se toma o se administra en una sola ocasión."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доза",
                                "target_lang_sense_clarification": "количество лекарства"
                            },
                            {
                                "target_lang_word": "порция",
                                "target_lang_sense_clarification": "часть чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剂量",
                                "target_lang_sense_clarification": "指一次服用的药量"
                            },
                            {
                                "target_lang_word": "药量",
                                "target_lang_sense_clarification": "较口语，也可指一次的用药量"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "dosis",
                                "target_lang_sense_clarification": "cantidad de medicamento que se toma o administra cada vez"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05a2ee37-e821-30bf-ab75-1251962dedb0",
                    "sense_definition": "The quantity of a substance or radiation administered or absorbed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers were exposed to a safe <w>dose</w> of radiation during the procedure.",
                            "target_lang_translations": {
                                "ru": "Во время процедуры рабочие получили безопасную <w>дозу</w> радиации.",
                                "zh": "工人在操作过程中受到了安全<w>剂量</w>的辐射。",
                                "es": "Los trabajadores estuvieron expuestos a una <w>dosis</w> segura de radiación durante el procedimiento."
                            }
                        },
                        {
                            "text": "A small <w>dose</w> of the chemical is harmless, but a large amount is toxic.",
                            "target_lang_translations": {
                                "ru": "Малая <w>доза</w> этого химиката безвредна, но большое количество токсично.",
                                "zh": "少量<w>剂量</w>的这种化学物质无害，但大量则有毒。",
                                "es": "Una pequeña <w>dosis</w> de la sustancia química es inofensiva, pero una gran cantidad es tóxica."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lethal dose",
                        "radiation dose",
                        "safe dose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество вещества или излучения, полученное или поглощённое.",
                        "zh": "施加、摄入或吸收的某种物质或辐射的数量。",
                        "es": "Cantidad de una sustancia o de radiación que se administra, se recibe o se absorbe."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доза",
                                "target_lang_sense_clarification": "облучения или вещества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剂量",
                                "target_lang_sense_clarification": "指物质或辐射被施加或吸收的量"
                            },
                            {
                                "target_lang_word": "用量",
                                "target_lang_sense_clarification": "较宽泛，可用于化学物质等"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "dosis",
                                "target_lang_sense_clarification": "cantidad de una sustancia o de radiación recibida, administrada o absorbida"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43c05df8-348b-354d-81c5-0f861d388aea",
                    "sense_definition": "A significant amount or experience of something, often something abstract.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He needs a healthy <w>dose</w> of reality to understand the situation.",
                            "target_lang_translations": {
                                "ru": "Ему нужна здоровая <w>доза</w> реальности, чтобы понять ситуацию.",
                                "zh": "他需要一点<w>现实</w>的当头棒喝，才能理解这种情况。",
                                "es": "Necesita una buena <w>dosis</w> de realidad para entender la situación."
                            }
                        },
                        {
                            "text": "The team faced a heavy <w>dose</w> of criticism after losing the match.",
                            "target_lang_translations": {
                                "ru": "После проигрыша матча команда столкнулась с большой <w>порцией</w> критики.",
                                "zh": "比赛失利后，这支队伍遭到了大量批评。",
                                "es": "El equipo recibió una fuerte <w>dosis</w> de críticas después de perder el partido."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dose of reality",
                        "dose of skepticism",
                        "dose of luck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Значительное количество или опыт чего-либо, часто абстрактного.",
                        "zh": "相当多的某种东西或某种体验，常指抽象事物。",
                        "es": "Cantidad considerable de algo, a menudo algo abstracto o figurado."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доза",
                                "target_lang_sense_clarification": "абстрактного понятия"
                            },
                            {
                                "target_lang_word": "порция",
                                "target_lang_sense_clarification": "доля, часть (напр. критики)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一定量",
                                "target_lang_sense_clarification": "用于抽象事物，指相当多的一部分"
                            },
                            {
                                "target_lang_word": "一番",
                                "target_lang_sense_clarification": "常指某种体验、现实、运气、批评等"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "dosis",
                                "target_lang_sense_clarification": "cantidad notable de algo abstracto, como realidad, paciencia o suerte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7312f202-e3b8-334f-b031-6e5e534df6dd",
                    "sense_definition": "A cold or viral illness.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a bad <w>dose</w> going around the office this week.",
                            "target_lang_translations": {
                                "ru": "На этой неделе в офисе ходит сильная <w>простуда</w>.",
                                "zh": "这周办公室里有一阵很厉害的<w>感冒</w>在传播。",
                                "es": "Esta semana anda circulando un fuerte <w>resfriado</w> por la oficina."
                            }
                        },
                        {
                            "text": "She stayed home from work because she had a terrible <w>dose</w>.",
                            "target_lang_translations": {
                                "ru": "Она осталась дома и не пошла на работу, потому что у неё была ужасная <w>простуда</w>.",
                                "zh": "她因为得了重<w>感冒</w>，所以待在家里没有上班。",
                                "es": "Se quedó en casa sin ir a trabajar porque tenía un terrible <w>resfriado</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bad dose"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in Irish or British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Простуда или вирусное заболевание (разговорное).",
                        "zh": "感冒或病毒性疾病。",
                        "es": "Resfriado o enfermedad viral; uso coloquial, especialmente en inglés británico o irlandés."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "простуда",
                                "target_lang_sense_clarification": "заболевание"
                            },
                            {
                                "target_lang_word": "инфекция",
                                "target_lang_sense_clarification": "заражение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感冒",
                                "target_lang_sense_clarification": "口语，指感冒或病毒性小病"
                            },
                            {
                                "target_lang_word": "病毒感染",
                                "target_lang_sense_clarification": "较宽泛，指感染了病毒性疾病"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "resfriado",
                                "target_lang_sense_clarification": "enfermedad leve como un catarro o virus; uso coloquial, sobre todo británico o irlandés"
                            },
                            {
                                "target_lang_word": "virus",
                                "target_lang_sense_clarification": "infección o virus pasajero; uso coloquial"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25bab59b-b57c-3ed1-9127-eee39bd2c56c",
                    "sense_definition": "A venereal infection.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was worried that he had caught a <w>dose</w> while traveling.",
                            "target_lang_translations": {
                                "ru": "Он беспокоился, что подцепил <w>заразу</w> во время путешествия.",
                                "zh": "他担心自己在旅行时染上了<w>性病</w>。",
                                "es": "Le preocupaba haber contraído una <w>ETS</w> durante el viaje."
                            }
                        },
                        {
                            "text": "It is important to see a doctor immediately if you think you have a <w>dose</w>.",
                            "target_lang_translations": {
                                "ru": "Важно немедленно обратиться к врачу, если вы думаете, что у вас <w>инфекция</w>.",
                                "zh": "如果你觉得自己可能得了<w>性病</w>，一定要立刻去看医生。",
                                "es": "Es importante consultar a un médico de inmediato si crees que tienes una <w>ETS</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Венерическое заболевание (слэнг).",
                        "zh": "性病，俚语说法。",
                        "es": "Infección venérea o de transmisión sexual; uso de argot."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зараза",
                                "target_lang_sense_clarification": "разг. болезнь"
                            },
                            {
                                "target_lang_word": "венерическое заболевание",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "性病",
                                "target_lang_sense_clarification": "口语中常指性传播感染"
                            },
                            {
                                "target_lang_word": "性传播疾病",
                                "target_lang_sense_clarification": "较正式的说法"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ETS",
                                "target_lang_sense_clarification": "infección de transmisión sexual; equivalente moderno y general"
                            },
                            {
                                "target_lang_word": "enfermedad venérea",
                                "target_lang_sense_clarification": "término más explícito y tradicional"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67f30cc6-ea73-393e-b4a2-e9bfbbbc9170",
                    "sense_definition": "Archaic form of <w>doze</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler fell into a light <w>dose</w> by the warm fire.",
                            "target_lang_translations": {
                                "ru": "Путешественник погрузился в легкую <w>дремоту</w> у теплого огня.",
                                "zh": "旅人在温暖的火边进入了浅浅的<w>小睡</w>。",
                                "es": "El viajero cayó en una ligera <w>cabezada</w> junto al fuego cálido."
                            }
                        },
                        {
                            "text": "In old texts, you might see sleep spelled as <w>dose</w>.",
                            "target_lang_translations": {
                                "ru": "В старых текстах можно встретить написание слова \"сон\" как <w>dose</w>.",
                                "zh": "在旧文本中，你可能会看到“小睡、打盹”写作 dose。",
                                "es": "En textos antiguos, podrías encontrar <w>dose</w> como forma antigua de escribir «doze»."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": "variant spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание слова \"doze\" (дремать).",
                        "zh": "doze 的古旧写法。",
                        "es": "Forma arcaica de doze; sueño ligero o breve somnolencia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дремота",
                                "target_lang_sense_clarification": "легкий сон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小睡",
                                "target_lang_sense_clarification": "名词，指短暂的睡眠"
                            },
                            {
                                "target_lang_word": "打盹",
                                "target_lang_sense_clarification": "较口语，指轻微睡着"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cabezada",
                                "target_lang_sense_clarification": "sueño breve y ligero"
                            },
                            {
                                "target_lang_word": "modorra",
                                "target_lang_sense_clarification": "sueño ligero; equivalente aproximado"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cdb901ce-4e55-308f-9bde-5fd9ca55a316",
                    "sense_definition": "To administer medicine to someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse <w>dosed</w> the patient with painkillers to help him sleep.",
                            "target_lang_translations": {
                                "ru": "Медсестра <w>напичкала</w> пациента обезболивающими, чтобы помочь ему уснуть.",
                                "zh": "护士给病人<w>服用</w>了止痛药，帮助他入睡。",
                                "es": "La enfermera <w>medicó</w> al paciente con analgésicos para ayudarlo a dormir."
                            }
                        },
                        {
                            "text": "She <w>dosed</w> herself with vitamin C at the first sign of a cold.",
                            "target_lang_translations": {
                                "ru": "При первых признаках простуды она <w>накачалась</w> витамином С.",
                                "zh": "她一出现感冒的早期症状，就给自己<w>服用</w>了维生素C。",
                                "es": "Se <w>administró</w> vitamina C al primer síntoma de resfriado."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dose with medicine",
                        "heavily dosed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать кому-либо лекарство.",
                        "zh": "给某人用药。",
                        "es": "Administrar un medicamento a alguien."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пичкать лекарствами",
                                "target_lang_sense_clarification": "давать много лекарств"
                            },
                            {
                                "target_lang_word": "давать дозу",
                                "target_lang_sense_clarification": "лечить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "给药",
                                "target_lang_sense_clarification": "给某人用药、让其服药"
                            },
                            {
                                "target_lang_word": "服用",
                                "target_lang_sense_clarification": "较自然地用于人服药"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "administrar",
                                "target_lang_sense_clarification": "dar o aplicar un medicamento a alguien"
                            },
                            {
                                "target_lang_word": "dosificar",
                                "target_lang_sense_clarification": "dar una cantidad concreta de medicina"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08682b0c-4350-3349-8ae8-ac370007800e",
                    "sense_definition": "To surreptitiously administer an incapacitating drug to someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He suspected that someone had <w>dosed</w> his drink at the party.",
                            "target_lang_translations": {
                                "ru": "Он подозревал, что кто-то <w>подмешал что-то</w> ему в напиток на вечеринке.",
                                "zh": "他怀疑有人在聚会上往他的饮料里<w>下了药</w>。",
                                "es": "Sospechó que alguien había <w>drogado</w> su bebida en la fiesta."
                            }
                        },
                        {
                            "text": "The spy <w>dosed</w> the guard's coffee to slip past him unnoticed.",
                            "target_lang_translations": {
                                "ru": "Шпион <w>подсыпал снотворное</w> в кофе охранника, чтобы проскользнуть мимо незамеченным.",
                                "zh": "间谍在守卫的咖啡里<w>下了药</w>，好悄悄从他身边溜过去。",
                                "es": "El espía <w>drogó</w> el café del guardia para pasar sin que lo notaran."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dose a drink"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тайно подмешать одурманивающее вещество.",
                        "zh": "暗中给某人服下会使其失去行动能力的药物。",
                        "es": "Administrar en secreto a alguien una droga o sustancia incapacitante."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подмешивать",
                                "target_lang_sense_clarification": "добавлять тайно"
                            },
                            {
                                "target_lang_word": "опаивать",
                                "target_lang_sense_clarification": "давать выпить с зельем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "下药",
                                "target_lang_sense_clarification": "暗中把药物放进饮料或食物里"
                            },
                            {
                                "target_lang_word": "掺药",
                                "target_lang_sense_clarification": "较具体，指偷偷混入某物"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "drogar",
                                "target_lang_sense_clarification": "dar a alguien una sustancia incapacitante, a menudo en una bebida, sin que lo sepa"
                            },
                            {
                                "target_lang_word": "echar droga en la bebida",
                                "target_lang_sense_clarification": "poner una sustancia en una bebida o comida a escondidas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a12a6dbc-29e7-3036-bf36-526994db6b3f",
                    "sense_definition": "Archaic form of <w>doze</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man <w>dosed</w> in his chair while the storm raged outside.",
                            "target_lang_translations": {
