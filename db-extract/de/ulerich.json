                ],
                "senses": [
                    {
                        "sense_id": "af8792f9-b6bc-3ef0-bba0-c17715a94a4a",
                        "entry_id": "70f3f0b8-8144-3037-acd9-76932f81cb68",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "308ef4f0-a5df-45fa-8fef-ebf426915a78",
                                "sense_id": "af8792f9-b6bc-3ef0-bba0-c17715a94a4a",
                                "text": "Frau Ulerich ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "16112557-25a1-4696-88fa-bcce2095c38f",
                                "sense_id": "af8792f9-b6bc-3ef0-bba0-c17715a94a4a",
                                "text": "Herr Ulerich wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "05b80ea3-b067-4a3d-b0a4-cc581af9c271",
                                "sense_id": "af8792f9-b6bc-3ef0-bba0-c17715a94a4a",
                                "text": "Die Ulerichs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "238c77e3-80c9-4e88-8f91-5aafb44bda6d",
                                "sense_id": "af8792f9-b6bc-3ef0-bba0-c17715a94a4a",
                                "text": "Der Ulerich trägt nie die Schals, die die Ulerich ihm strickt."
                            },
                            {
                                "example_id": "8cf04822-0b89-48e5-9c0c-286ff933c71b",
                                "sense_id": "af8792f9-b6bc-3ef0-bba0-c17715a94a4a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ulerich kommt, geht der Herr Ulerich.“"
                            },
                            {
                                "example_id": "4aec18e2-a410-4ca0-947f-9f7aef80861d",
                                "sense_id": "af8792f9-b6bc-3ef0-bba0-c17715a94a4a",
                                "text": "Ulerich kommt und geht."
                            },
                            {
                                "example_id": "bde72b25-13c1-4693-bc5b-1e2d75b6171b",
                                "sense_id": "af8792f9-b6bc-3ef0-bba0-c17715a94a4a",
                                "text": "Ulerichs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
