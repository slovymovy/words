        "fr-extract.jsonl": [
            {
                "entry_id": "dc1e1277-299a-34e1-93f4-0d7d6cca004c",
                "word": "goret",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a6139a6c-ecc3-42e1-bb97-3c3b6021f01a",
                        "entry_id": "dc1e1277-299a-34e1-93f4-0d7d6cca004c",
                        "tags": [
                            "plural"
                        ],
                        "form": "gorets"
                    },
                    {
                        "form_id": "de9e1e2a-8ba7-4285-b5fe-2e5b03259298",
                        "entry_id": "dc1e1277-299a-34e1-93f4-0d7d6cca004c",
                        "tags": [
                            "feminine"
                        ],
                        "form": "gorette"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc750663-9428-3e43-a1b2-1da866ff9d09",
                        "entry_id": "dc1e1277-299a-34e1-93f4-0d7d6cca004c",
                        "glosses": [
                            "Jeune cochon ; porcelet."
                        ],
                        "tags": [],
                        "note": "Il est parfois employé comme synonyme de cochon",
                        "examples": [
                            {
                                "example_id": "263619e4-a83f-4267-bf46-69bbe1dfd581",
                                "sense_id": "cc750663-9428-3e43-a1b2-1da866ff9d09",
                                "text": "En quelques mois, la montanera et les quelque 700 kg de glands dévorés par tête (chaque animal disposant ici de 2 hectares de terrain) auront fait passer ces cochons âgés d’un peu plus d’un an, d’environ 90 à plus de 160 kg. Un gavage qui fait qualifier ces gorets d’« olivier sur pattes », leur graisse étant composée majoritairement de l’acide oléique contenu dans les glands, comparable à celui fourni par les olives."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c7fe963-0f3b-3e91-ab23-b9bf784166f2",
                        "entry_id": "dc1e1277-299a-34e1-93f4-0d7d6cca004c",
                        "glosses": [
                            "Enfant ou personne malpropre ; cochon ; porc ; pourceau."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9d8156e3-7cbf-4851-a5c0-63847adabeb3",
                                "sense_id": "2c7fe963-0f3b-3e91-ab23-b9bf784166f2",
                                "text": "La droiture des juges ecclésiastiques fit avorter ce dessein, mais le curé, quoique très pauvre, eut constamment à loger dix hommes triés avec soin parmi les gorets saxons ou poméraniens les plus fétides, les plus crapuleux, jusqu’au 25 septembre 1871, époque bénie du départ des derniers soldats de l’occupation."
                            },
                            {
                                "example_id": "d5853ad9-cb84-49e1-980b-b5afbb6bff1c",
                                "sense_id": "2c7fe963-0f3b-3e91-ab23-b9bf784166f2",
                                "text": "Même si vous me tabassez comme votre collègue, le gros goret puant, je pourrai rien vous dire de plus. Mais ça m’étonnerait que vous me cognassiez."
                            }
                        ]
                    },
                    {
                        "sense_id": "4cc61147-14c2-32f4-8629-6be06b53123c",
                        "entry_id": "dc1e1277-299a-34e1-93f4-0d7d6cca004c",
                        "glosses": [
                            "Brosse à long manche utilisée pour nettoyer la carène d’un bateau à flot."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ddc99c2-c231-48ed-9dde-e379c9539ded",
                        "source_entry_id": "dc1e1277-299a-34e1-93f4-0d7d6cca004c",
                        "target_lang_word": "Ferkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ferkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85457aff-d21f-319d-a513-9edb0e20c4d9",
                                        "entry_id": "bf7d7359-0852-33ea-ae5b-333660b597be",
                                        "glosses": [
                                            "Junges des Hausschweins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32969e6b-ff10-439c-a45f-360677283ee4",
                                                "sense_id": "85457aff-d21f-319d-a513-9edb0e20c4d9",
                                                "text": "Drei Ferkel des letzten Wurfs waren männlich."
                                            },
                                            {
                                                "example_id": "8db95c6e-dd8a-414d-930d-4bf2604e39f8",
                                                "sense_id": "85457aff-d21f-319d-a513-9edb0e20c4d9",
                                                "text": "„Zwischen Kakteen und Blattpflanzen ohne Blüten, wie man sie in den Schaufenstern von Schlächtern findet, um ein totes Ferkel mit einer Zitrone im Maul zu garnieren, saßen etwa fünfzehn Personen auf unbequemen Stühlen herum.“"
                                            },
                                            {
                                                "example_id": "a6a9bfc9-f91d-46d9-bead-7e8cdbb17ec6",
                                                "sense_id": "85457aff-d21f-319d-a513-9edb0e20c4d9",
                                                "text": "„Die holde Marion stand, mit einem kleinen Korb am Arm, unter einer flatternden und gackelnden Schar von Hühnern, Enten und Gänsen und streute weit hinaus in den reinlichen Hof die goldenen Maiskörner; draußen an der niedern Fenz aber stürmte ein ganzes Rudel grunzender und tobender Ferkel auf und ab und suchte vergebens in wilder Hast einen Eingang, um an dem freigebigen Mahle teilzunehmen.“"
                                            },
                                            {
                                                "example_id": "4f4bf9a4-ec76-4c84-842e-4303e1185651",
                                                "sense_id": "85457aff-d21f-319d-a513-9edb0e20c4d9",
                                                "text": "„Er lag auf einer Pritsche auf einer kleinen Erhöhung des Fußbodens, und die Tiere lagen dicht neben ihm auf der anderen Seite des Lattenzauns, ein Eber, für sich in einem Koben, im zweiten eine Sau mit zwölf Ferkeln, und einige größere junge Schweine im dritten Koben.“"
                                            },
                                            {
                                                "example_id": "3be6faec-3b82-406c-bd1a-7a8a6ae6c485",
                                                "sense_id": "85457aff-d21f-319d-a513-9edb0e20c4d9",
                                                "text": "„Bastian beobachtete das Ferkel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "11e59050-d5e0-3640-8cc4-a7227883101f",
                                        "entry_id": "bf7d7359-0852-33ea-ae5b-333660b597be",
                                        "glosses": [
                                            "Schimpfwort für eine Person (oft Kind), die sich oder ihre Umwelt physisch oder verbal beschmutzt hat"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04fff16e-3afe-4d8c-b35e-7d0453186b82",
                                                "sense_id": "11e59050-d5e0-3640-8cc4-a7227883101f",
                                                "text": "Ihr Ferkel, ihr habt den ganzen Tisch vollgekleckert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
