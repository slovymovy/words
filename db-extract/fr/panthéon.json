        "fr-extract.jsonl": [
            {
                "entry_id": "b99382d5-1ce9-379c-a341-4bdd77ab36f5",
                "word": "panthéon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c738aed4-ca7c-4b4e-9a87-eab130f62574",
                        "entry_id": "b99382d5-1ce9-379c-a341-4bdd77ab36f5",
                        "tags": [
                            "plural"
                        ],
                        "form": "panthéons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8dd44532-b742-39fc-86b6-36bb422b8584",
                        "entry_id": "b99382d5-1ce9-379c-a341-4bdd77ab36f5",
                        "glosses": [
                            "Ensemble de tous les dieux d’une mythologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcbff3c7-4354-451d-b874-d22c586ad709",
                                "sense_id": "8dd44532-b742-39fc-86b6-36bb422b8584",
                                "text": "Détentrice du premier rang dans le panthéon des dieux célestes, la planète Vénus devait également jouer un rôle primordial dans la vie de tous les jours."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffdba6eb-4e5f-3340-a03c-1ed6b29c134e",
                        "entry_id": "b99382d5-1ce9-379c-a341-4bdd77ab36f5",
                        "glosses": [
                            "Temple consacré à tous les dieux à la fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcb07ac2-87a1-4df9-8696-66dd533e4105",
                                "sense_id": "ffdba6eb-4e5f-3340-a03c-1ed6b29c134e",
                                "text": "Le panthéon le plus célèbre est celui de Rome, bâti par Agrippa, et qui subsiste encore."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbb80630-a73e-3135-9ddb-34cefbc4523c",
                        "entry_id": "b99382d5-1ce9-379c-a341-4bdd77ab36f5",
                        "glosses": [
                            "Monument consacré à l’inhumation ou au culte des grands hommes ou femmes particulièrement remarquables."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f017269b-363a-43cc-bb8c-f2c2a2be69b2",
                                "sense_id": "fbb80630-a73e-3135-9ddb-34cefbc4523c",
                                "text": "La religieuse est très connue en Asie : elle a fait son entrée, le 14 mars dernier, au panthéon des femmes de Singapour."
                            }
                        ]
                    },
                    {
                        "sense_id": "71dbdd11-06ab-3f21-b128-0d80a6ee0759",
                        "entry_id": "b99382d5-1ce9-379c-a341-4bdd77ab36f5",
                        "glosses": [
                            "Ensemble de personnes ou d’idées qui font partie de la mémoire collective."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e7e62f09-b5d4-4f65-b00e-697f62295772",
                                "sense_id": "71dbdd11-06ab-3f21-b128-0d80a6ee0759",
                                "text": "Le panthéon littéraire."
                            },
                            {
                                "example_id": "e49f5c13-cfa2-41a5-9252-a97d5d80e039",
                                "sense_id": "71dbdd11-06ab-3f21-b128-0d80a6ee0759",
                                "text": "La rhétorique, enfin, serait arrachée des mains des philosophes et des littéraires pour rejoindre le panthéon, enfin globalement triomphant, des sciences « exactes »."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1830182-b1e6-38c7-8ea0-47c929e82c33",
                        "entry_id": "b99382d5-1ce9-379c-a341-4bdd77ab36f5",
                        "glosses": [
                            "Collection, rassemblement ou liste (d'objets ou personnalités) particulièrement significatifs pour soi."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6c4cd23c-c43e-48df-8256-ea927c5306d5",
                                "sense_id": "e1830182-b1e6-38c7-8ea0-47c929e82c33",
                                "text": "Un panthéon personnel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56ae26b3-4ac7-4328-938c-698672899ff1",
                        "source_entry_id": "b99382d5-1ce9-379c-a341-4bdd77ab36f5",
                        "target_lang_word": "Pantheon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pantheon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24798b95-97c0-32ef-8877-0234bc13146b",
                                        "entry_id": "dfc8a17f-f087-3150-b1fa-8690d0869c1f",
                                        "glosses": [
                                            "ein antiker, allen Göttern geweihter Tempel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ea57d10-bf3e-4f68-af6d-3f9bb2e4e860",
                                                "sense_id": "24798b95-97c0-32ef-8877-0234bc13146b",
                                                "text": "Eine Statue wurde im Pantheon aufgestellt."
                                            },
                                            {
                                                "example_id": "6bbaabbf-05f1-45b0-b788-20c1aa452417",
                                                "sense_id": "24798b95-97c0-32ef-8877-0234bc13146b",
                                                "text": "„Der Burgberg Wawel, auf dem neben einer Kathedrale auch das ehemalige Königsschloss steht, gilt als polnischer Pantheon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af8b5e01-26da-3fd0-a585-04a919b8832d",
                                        "entry_id": "dfc8a17f-f087-3150-b1fa-8690d0869c1f",
                                        "glosses": [
                                            "die Gesamtheit der Götter einer (polytheistischen) Religion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1358d730-3924-4fa6-b371-2f8840f4a1a1",
                                                "sense_id": "af8b5e01-26da-3fd0-a585-04a919b8832d",
                                                "text": "Das Pantheon bestand aus sechs Gottheiten."
                                            },
                                            {
                                                "example_id": "514f58ab-1b58-485c-a2da-fd0a91d492be",
                                                "sense_id": "af8b5e01-26da-3fd0-a585-04a919b8832d",
                                                "text": "„Sein privates Pantheon beherbergte nun zwei Gruppen von Heroen, die einander freundlich gegenüberstanden:…“"
                                            },
                                            {
                                                "example_id": "de3b0b5b-393b-4c94-8f21-f3abde9ac1dd",
                                                "sense_id": "af8b5e01-26da-3fd0-a585-04a919b8832d",
                                                "text": "„Die Erhebung Csomas in ein buddhistisches Pantheon hat ihren Ursprung in dem Wunder der sechzehn Monate in der Zelle in Zangla.“"
                                            },
                                            {
                                                "example_id": "9ecd5307-59be-40d8-b405-4b19104b62ce",
                                                "sense_id": "af8b5e01-26da-3fd0-a585-04a919b8832d",
                                                "text": "„Nabonid hinterließ Inschriften, in denen dem Mondgott eine ungewöhnlich prominente Stellung im Pantheon zugeschrieben wird.“"
                                            },
                                            {
                                                "example_id": "6c026e05-9837-4cd1-b13e-8730a7933b02",
                                                "sense_id": "af8b5e01-26da-3fd0-a585-04a919b8832d",
                                                "text": "„Bei der Vielzahl an Göttern, die es schon in Ägypten gibt, stellen auch ausländische Götter keine Konkurrenz dar, sondern sie werden einfach in das einheimische Pantheon integriert.“"
                                            },
                                            {
                                                "example_id": "24ce460b-eb86-47c5-9122-d7cd2198a1ea",
                                                "sense_id": "af8b5e01-26da-3fd0-a585-04a919b8832d",
                                                "text": "„Trotz der Förderung des Buddhismus wurde im Kuschanreich ein Pantheon aus indischen, griechischen und orientalischen Göttern verehrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "68ca617b-8575-35d9-ba9c-804d380cd21d",
                                        "entry_id": "dfc8a17f-f087-3150-b1fa-8690d0869c1f",
                                        "glosses": [
                                            "tempelartige Grabstätte und Gedenkstätte für bekannte Persönlichkeiten einer Nation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "675c01a0-e4bd-486b-b0c4-45cfbed4e911",
                                                "sense_id": "68ca617b-8575-35d9-ba9c-804d380cd21d",
                                                "text": "Bei unserem Aufenthalt in Lissabon besuchten wir auch das Pantheon mit dem Kenotaph Vasco da Gamas."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac0bd7fa-3b51-4a0d-aa0a-831497dc47d7",
                        "source_entry_id": "b99382d5-1ce9-379c-a341-4bdd77ab36f5",
                        "target_lang_word": "pantheon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pantheon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59f71684-1b49-3497-b16a-924fc6971d8f",
                                        "entry_id": "f6843538-61b5-3953-ba4d-cacd52d85cf0",
                                        "glosses": [
                                            "A temple dedicated to all the gods."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4dd5ee47-e35c-3224-9d6a-b42fdf48ddd1",
                                        "entry_id": "f6843538-61b5-3953-ba4d-cacd52d85cf0",
                                        "glosses": [
                                            "All the gods of a particular people or religion, particularly the ancient Greek gods residing on Olympus, considered as a group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23e2ea52-1de5-4a5c-b758-2ae47a45183a",
                                                "sense_id": "4dd5ee47-e35c-3224-9d6a-b42fdf48ddd1",
                                                "text": "Every act of a Roman, from birth to death, from dawn to night, was controlled and supervised by some presiding deity. Man was thus virtually a symbolic puppet in the hands of the Roman pantheon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70119bbe-a665-31ca-b492-1f1ae290480c",
                                        "entry_id": "f6843538-61b5-3953-ba4d-cacd52d85cf0",
                                        "glosses": [
                                            "A category or classification denoting the most honored persons of a group."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5984efa-dbc3-42f4-845c-773969b21b55",
                                                "sense_id": "70119bbe-a665-31ca-b492-1f1ae290480c",
                                                "text": "Usain Bolt seals his place in the pantheon with stunning fifth gold"
                                            },
                                            {
                                                "example_id": "3dbe07b9-eecd-48c1-86e8-3d7e95159f94",
                                                "sense_id": "70119bbe-a665-31ca-b492-1f1ae290480c",
                                                "text": "Mahomes, Kelce, head coach Andy Reid and other key contributors to the Chiefs’ recent run can now put themselves alongside NFL legends in the pantheon of the sport’s greatest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23062f95-e1aa-4d2c-9db5-a2a206a8c060",
                        "source_entry_id": "b99382d5-1ce9-379c-a341-4bdd77ab36f5",
