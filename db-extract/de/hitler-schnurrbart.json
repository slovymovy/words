                        "glosses": [
                            "Schnurrbart, der vom Aussehen an Adolf Hitler erinnert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "047554ce-f592-4959-b79a-8cbb004da0d9",
                                "sense_id": "46bedae0-9e00-32d6-847a-568a1850886e",
                                "text": "„Kolumbianische Fernsehsender hielten die aufregende Szene fest, als Pablos Leiche mit dem geschwollenen, blutverschmierten Gesicht und dem eigentümlichen Hitler-Schnurrbart, auf eine Trage geschnallt, vom Dach heruntergelassen und in eine Polizei-Ambulanz geschafft wurde.“"
                            },
                            {
                                "example_id": "750d7f86-89e4-4722-8abd-c3eceec1f64b",
                                "sense_id": "46bedae0-9e00-32d6-847a-568a1850886e",
                                "text": "„Meine Stimme spricht mit der Wut des Hitler-Schnurrbarts.“"
                            }
                        ],
