                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "eefb9702-5d9e-309f-98ac-f348bcee53e0",
                                        "entry_id": "8009aacb-1afb-3d44-a680-6a5cd4f13806",
                                        "glosses": [
                                            "een punt waar twee benen of halve rechten samenkomen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2dbcd04-a039-3896-a23a-867329e146d5",
                                        "entry_id": "8009aacb-1afb-3d44-a680-6a5cd4f13806",
                                        "glosses": [
                                            "een plaats waar twee muren samenkomen in bijvoorbeeld een kamer of op straat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0b5c348-df7b-407f-ab63-684993939bc5",
                                                "sense_id": "a2dbcd04-a039-3896-a23a-867329e146d5",
                                                "text": "'Nou, behalve dat ik haar weleens in haar kont heb geknepen en haar daarna in een hoek van de werkplaats staand heb geneukt in ruil voor een promotie, kan ik niets bedenken."
                                            },
                                            {
                                                "example_id": "03408907-e43b-4a07-81f5-b2f6f3433f20",
                                                "sense_id": "a2dbcd04-a039-3896-a23a-867329e146d5",
                                                "text": "Op een sofa in de hoek van de kamer herken ik de hoofden van Gijs en Annet die net boven de rugleuning uitsteken."
                                            },
                                            {
                                                "example_id": "8eacdedc-e6c4-4cd8-a424-ce4c52de59e4",
                                                "sense_id": "a2dbcd04-a039-3896-a23a-867329e146d5",
                                                "text": "Het is Lauren die voorzichtig haar gezicht om de hoek van deur buigt, alsof ze eigenlijk niet binnen wil komen."
                                            },
                                            {
                                                "example_id": "7beefa6e-8c3e-42d8-b08c-85068bcc0121",
                                                "sense_id": "a2dbcd04-a039-3896-a23a-867329e146d5",
                                                "text": "Omdat het toen nog steeds te krap was, moest één jongen zittend in de hoek gaan slapen. Door een klein raam werden we steeds fel verlicht door de bliksem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffce497b-6440-3aec-b6c4-1b8d8b58d18d",
                                        "entry_id": "8009aacb-1afb-3d44-a680-6a5cd4f13806",
                                        "glosses": [
                                            "stoot die van opzij wordt toegediend, hoekstoot"
                                        ],
                                        "tags": [
                                            "boksen:"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9471a32-d505-3e06-87a8-96381a1b4d05",
                                        "entry_id": "8009aacb-1afb-3d44-a680-6a5cd4f13806",
                                        "glosses": [
                                            "plek, plaats (bijv. koffiehoek)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62ca1b2c-3e3d-46ec-86c9-bfee32493099",
                                                "sense_id": "e9471a32-d505-3e06-87a8-96381a1b4d05",
                                                "text": "Uitvoerig sprak hij over zijn plannen om ooit arts te worden, maar nu was hij nog vooral de ultieme vrije hippie die alle hoeken van de wereld wilde verkennen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1db8c38-deb6-3e70-a7bf-50093ec9911a",
                                        "entry_id": "8009aacb-1afb-3d44-a680-6a5cd4f13806",
                                        "glosses": [
                                            "bepaalde categorie mensen of zaken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
