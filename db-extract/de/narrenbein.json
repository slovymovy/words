                "senses": [
                    {
                        "sense_id": "26790a29-b1c4-38ef-89e6-45adc5d3c548",
                        "entry_id": "07cfe077-0994-3f4e-ba00-22f9885470bd",
                        "glosses": [
                            "höckerartige Stelle an der Innenseite des Ellenbogens, die besonders schmerzempfindlich ist, da dort der Nervus ulnaris direkt unter der Haut verläuft"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "08121e09-8438-4fdb-8898-8c651be47519",
                                "sense_id": "26790a29-b1c4-38ef-89e6-45adc5d3c548",
                                "text": "«Hierzulande kennt man den blöden Nerv (bzw. den Knochen, über den er verläuft) als Surrbein oder Narrenbein, in der Innerschweiz auch als ‹chiibig Äderli›, die streitsüchtige, mitunter sehr nervende Ader.»"
                            },
                            {
                                "example_id": "e57e2d3c-a382-4b20-b50c-20652de071d4",
                                "sense_id": "26790a29-b1c4-38ef-89e6-45adc5d3c548",
                                "text": "«In der Fachsprache ist es der Nervus ulnaris oder Ellennerv, den man sich stösst. Doch der Volksmund kennt allerlei lustige Bezeichnungen: Hierzulande schlägt man sich das ‹Narrenbein›, das ‹Surribei› oder das ‹Surrbeindli› an.»"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
