{
    "word_family": [
        "rascally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3102f4c6-5900-352f-8710-ab62c234ef52",
                    "sense_definition": "A dishonest person or a scoundrel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dishonest_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rascal</w> stole the money from the old man's wallet.",
                            "target_lang_translations": {
                                "ru": "<w>Негодник</w> украл деньги из кошелька старика."
                            }
                        },
                        {
                            "text": "He was known as a <w>rascal</w> who would cheat anyone for a profit.",
                            "target_lang_translations": {
                                "ru": "Он был известен как <w>плут</w>, который обманет любого ради выгоды."
                            }
                        }
                    ],
                    "synonyms": [
                        "villain",
                        "scoundrel"
                    ],
                    "common_phrases": [
                        "dishonest rascal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечестный человек или мошенник."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "негодник",
                                "target_lang_sense_clarification": "человек, ведущий себя плохо или нечестно"
                            },
                            {
                                "target_lang_word": "плут",
                                "target_lang_sense_clarification": "хитрый обманщик или мошенник"
                            },
                            {
                                "target_lang_word": "шельмец",
                                "target_lang_sense_clarification": "нечестный человек, интриган"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74a11f21-2358-35eb-aa85-6fe5fa486b17",
                    "sense_definition": "A cheeky or mischievous person or animal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mischievous_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That little <w>rascal</w> hid my keys again.",
                            "target_lang_translations": {
                                "ru": "Этот маленький <w>негодник</w> снова спрятал мои ключи."
                            }
                        },
                        {
                            "text": "The hungry <w>rascal</w> ate all the food from the garden.",
                            "target_lang_translations": {
                                "ru": "Этот голодный <w>плутишка</w> съел всю еду из сада."
                            }
                        }
                    ],
                    "synonyms": [
                        "imp",
                        "mischief-maker",
                        "scamp",
                        "troublemaker"
                    ],
                    "common_phrases": [
                        "little rascal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дерзкий, озорной человек или животное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "негодник",
                                "target_lang_sense_clarification": "озорной ребенок или человек"
                            },
                            {
                                "target_lang_word": "плут",
                                "target_lang_sense_clarification": "хитрый, лукавый человек (часто шутливо)"
                            },
                            {
                                "target_lang_word": "ше́льма",
                                "target_lang_sense_clarification": "ловкий, хитрый человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35bb5b80-7d40-3e04-aa65-a505b35e2cce",
                    "sense_definition": "A member of a criminal gang.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dishonest_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police finally caught the <w>rascal</w> who led the local gang.",
                            "target_lang_translations": {
                                "ru": "Полиция наконец поймала <w>мошенника</w>, который возглавлял местную банду."
                            }
                        },
                        {
                            "text": "Every <w>rascal</w> in the group was arrested for the robbery.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>бандит</w> в группе был арестован за ограбление."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Член преступной группировки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мошенник",
                                "target_lang_sense_clarification": "преступник, занимающийся обманом"
                            },
                            {
                                "target_lang_word": "бандит",
                                "target_lang_sense_clarification": "член преступной группы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e5ed836a-5e67-393b-9840-818301b472af",
                    "sense_definition": "Relating to the common rabble or being of low social status.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rascal</w> crowd gathered outside the palace gates.",
                            "target_lang_translations": {
                                "ru": "<w>Чернь</w> собралась у ворот дворца."
                            }
                        },
                        {
                            "text": "He spoke with a <w>rascal</w> tone that offended the nobility.",
                            "target_lang_translations": {
                                "ru": "Он говорил с <w>простонародным</w> оттенком, который оскорблял знать."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used to describe low social status in older texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к простонародью или низкому социальному статусу (устар.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чернь",
                                "target_lang_sense_clarification": "низшие слои общества"
                            },
                            {
                                "target_lang_word": "подлый",
                                "target_lang_sense_clarification": "низкого происхождения (устар.)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1297d239-583b-341d-b932-6ec9240e27a1",
                    "sense_definition": "A family name.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Rascal</w> is the new teacher at our school.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Раскал</w> — новый учитель в нашей школе."
                            }
                        },
                        {
                            "text": "The historical records mention a man named <w>Rascal</w>.",
                            "target_lang_translations": {
                                "ru": "В исторических записях упоминается человек по фамилии <w>Раскал</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        }
    ]
