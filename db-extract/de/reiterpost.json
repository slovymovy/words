                ],
                "senses": [
                    {
                        "sense_id": "e6fbbba0-48f7-3765-99f9-fd575256f67b",
                        "entry_id": "820d7db2-2162-3535-80f5-597859c8b25d",
                        "glosses": [
                            "Beförderung der Post durch Postreiter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "129cab11-37a9-495c-bde7-67acc2bde83e",
                                "sense_id": "e6fbbba0-48f7-3765-99f9-fd575256f67b",
                                "text": "„So geht die Estafette, eine gestaffelte Reiterpost für ausschließlich staatliche und militärische Nachrichten, auf den persischen König Kyros aus dem 6. Jahrhundert vor Christus zurück.“"
                            },
                            {
                                "example_id": "0c110a99-900a-404e-834c-82a499e972f5",
                                "sense_id": "e6fbbba0-48f7-3765-99f9-fd575256f67b",
                                "text": "„Der Postkutschenbetrieb funktionierte nach dem gleichen Prinzip wie die Reiterpost, indem an den Relaisstationen Pferde- und Kutscherwechsel vorgenommen wurden.“"
                            },
                            {
                                "example_id": "2811ab3b-af7e-45af-bb00-31b62c778f7c",
                                "sense_id": "e6fbbba0-48f7-3765-99f9-fd575256f67b",
                                "text": "„Raststätten für das Militär errichtet, die später von der zivilen Reiterpost und danach von der Kutscherpost zur Rast und zum Pferdewechsel genutzt wurden.“"
                            },
                            {
                                "example_id": "3a32fef7-2b8f-4ee1-805b-96f95527cb84",
                                "sense_id": "e6fbbba0-48f7-3765-99f9-fd575256f67b",
                                "text": "„Ende des 15. Jahrhunderts richtet Kaiser Maximilian I. eine erste Reiterpost ein, die Brüssel mit Frankreich, über Innsbruck mit Italien und über Speyer und Augsburg mit Wien verbindet und gestattet dabei auch die Mitnahme privater Post.“"
                            },
                            {
                                "example_id": "af71b962-7f1f-4178-8b17-6c2fc9e26f30",
                                "sense_id": "e6fbbba0-48f7-3765-99f9-fd575256f67b",
                                "text": "„1656 wurde eine private Reiterpost nach Bremen eröffnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
