                        "entry_id": "30ba2ac7-6332-3b69-9669-5f0ee0cad657",
                        "glosses": [
                            "Genre d’arbustes originaires d’Amérique du Sud, dont plusieurs espèces sont cultivées comme plantes ornementales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "656bd3f8-80d1-4e25-8f68-bc40baa97bcc",
                                "sense_id": "64171113-13bb-3b51-a2e5-e03d346640dd",
                                "text": "Un feuillage persistant, une éclatante floraison parfumée, un port élégant: en climat doux, l’azara (Azara dentata) habille admirablement le jardin."
                            },
                            {
                                "example_id": "799669e8-cc5a-404a-bcb8-a2c0e33e315f",
                                "sense_id": "64171113-13bb-3b51-a2e5-e03d346640dd",
                                "text": "L’Azara microphylla est l’azara le plus rustique (-12°C). Il peut cependant devenir caduc si les hivers sont froids."
                            },
                            {
                                "example_id": "89c062ba-8cb0-4762-b1f2-9355137e34f5",
                                "sense_id": "64171113-13bb-3b51-a2e5-e03d346640dd",
                                "text": "L’azara est une plante saine qui attire surtout les butineurs."
                            }
                        ]
                    }
