{
    "word_family": [
        "scraper",
        "scraping"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2e22377-67c5-367c-a9ab-dc94ef529c9a",
                    "sense_definition": "A broad, shallow injury on the skin caused by rubbing against a rough surface.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He fell on the sidewalk and got a painful <w>scrape</w> on his knee.",
                            "target_lang_translations": {
                                "cs": "Upadl na chodník a udělal si bolestivou <w>odřeninu</w> na koleni."
                            }
                        },
                        {
                            "text": "The child cried because of a small <w>scrape</w> on her arm.",
                            "target_lang_translations": {
                                "cs": "Dítě plakalo kvůli malému <w>škrábanci</w> na paži."
                            }
                        }
                    ],
                    "synonyms": [
                        "abrasion",
                        "graze"
                    ],
                    "target_lang_definitions": {
                        "cs": "Povrchové, mělké poranění kůže způsobené odřením o drsný povrch."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "odřenina",
                                "target_lang_sense_clarification": "běžné označení pro povrchové poranění kůže"
                            },
                            {
                                "target_lang_word": "škrábanec",
                                "target_lang_sense_clarification": "drobné poranění kůže"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac9343e5-1088-302d-88a5-1dbc657eed64",
                    "sense_definition": "A fight, especially a fistfight without weapons.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got into a <w>scrape</w> with the school bully after class.",
                            "target_lang_translations": {
                                "cs": "Po vyučování se dostal do <w>potyčky</w> se školním rváčem."
                            }
                        },
                        {
                            "text": "The two men ended up in a messy <w>scrape</w> outside the bar.",
                            "target_lang_translations": {
                                "cs": "Ti dva muži skončili v ošklivé <w>rvačce</w> před barem."
                            }
                        }
                    ],
                    "synonyms": [
                        "brawl",
                        "fight",
                        "scuffle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used to describe minor or informal fights."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Potyčka nebo rvačka, zejména bez použití zbraní."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "potyčka",
                                "target_lang_sense_clarification": "menší fyzický konflikt"
                            },
                            {
                                "target_lang_word": "rvačka",
                                "target_lang_sense_clarification": "fyzický střet mezi lidmi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54c16ccd-7704-3171-8d11-49594a745dff",
                    "sense_definition": "An awkward or difficult set of circumstances.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am in a bit of a <w>scrape</w> because I forgot my wallet.",
                            "target_lang_translations": {
                                "cs": "Jsem v malé <w>šlamastyce</w>, protože jsem si zapomněl peněženku."
                            }
                        },
                        {
                            "text": "He always seems to get into some kind of <w>scrape</w> when he travels.",
                            "target_lang_translations": {
                                "cs": "Vypadá to, že se vždycky při cestování dostane do nějaké <w>bryndy</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bind",
                        "fix",
                        "mess",
                        "pickle"
                    ],
                    "common_phrases": [
                        "in a scrape"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe a troublesome situation."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nepříjemná nebo obtížná situace."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "brynda",
                                "target_lang_sense_clarification": "hovorově nepříjemná situace"
                            },
                            {
                                "target_lang_word": "šlamastyka",
                                "target_lang_sense_clarification": "obtížná nebo trapná situace"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "354c6e2b-450b-3edb-a7da-843b707f82d5",
                    "sense_definition": "The harsh sound made by something being rubbed against a surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud <w>scrape</w> of the chair against the floor startled everyone.",
                            "target_lang_translations": {
                                "cs": "Hlasité <w>skřípění</w> židle o podlahu všechny vylekalo."
                            }
                        },
                        {
                            "text": "She heard the <w>scrape</w> of a key in the lock.",
                            "target_lang_translations": {
                                "cs": "Slyšela <w>škrábání</w> klíče v zámku."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Drsný zvuk vznikající třením předmětu o povrch."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "skřípění",
                                "target_lang_sense_clarification": "zvuk vznikající třením"
                            },
                            {
                                "target_lang_word": "škrábání",
                                "target_lang_sense_clarification": "zvuk při škrábání povrchu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9d74e2ed-75c6-3d8e-9043-bd006fc4ddc2",
                    "sense_definition": "To injure or damage the skin by rubbing it against a rough surface.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tripped on a rock and <w>scraped</w> her knee.",
                            "target_lang_translations": {
                                "cs": "Zakopla o kámen a <w>odřela si</w> koleno."
                            }
                        },
                        {
                            "text": "Be careful not to <w>scrape</w> your hands on the rough brick wall.",
                            "target_lang_translations": {
                                "cs": "Dávej pozor, ať si <w>neodřeš</w> ruce o tu drsnou cihlovou zeď."
                            }
                        }
                    ],
                    "synonyms": [
                        "abrade",
                        "chafe",
                        "graze"
                    ],
                    "target_lang_definitions": {
                        "cs": "Poranit nebo poškodit kůži třením o drsný povrch."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "odřít si",
                                "target_lang_sense_clarification": "způsobit si odřeninu"
                            },
                            {
                                "target_lang_word": "poškrábat si",
                                "target_lang_sense_clarification": "způsobit si škrábanec"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a68dc089-19b0-343e-8702-9a26765e6cd5",
                    "sense_definition": "To draw a hard or sharp object along a surface while applying pressure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>scraped</w> the mud off her boots with a stick.",
                            "target_lang_translations": {
                                "cs": "Klackem si <w>seškrabala</w> bláto z bot."
                            }
                        },
                        {
                            "text": "He <w>scraped</w> the ice from the car windshield.",
                            "target_lang_translations": {
                                "cs": "<w>Oškrábal</w> led z čelního skla auta."
                            }
                        }
                    ],
                    "synonyms": [
                        "grate",
                        "scratch"
                    ],
                    "target_lang_definitions": {
                        "cs": "Tlačit tvrdý nebo ostrý předmět po povrchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "škrábat",
                                "target_lang_sense_clarification": "pohybovat ostrým předmětem po povrchu"
                            },
                            {
                                "target_lang_word": "seškrabávat",
                                "target_lang_sense_clarification": "odstraňovat něco tlakem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cf26a88-081e-3f69-b8fa-18349795190a",
                    "sense_definition": "To remove something from a surface by rubbing it with a tool.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>scrape</w> the burnt food off the pan.",
                            "target_lang_translations": {
                                "cs": "Měl bys <w>seškrabat</w> připálené jídlo z pánve."
                            }
                        },
                        {
                            "text": "Please <w>scrape</w> the old paint off the wall before painting.",
                            "target_lang_translations": {
                                "cs": "Prosím, před malováním <w>oškrábej</w> ze zdi starou barvu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Odstranit něco z povrchu pomocí nástroje."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "seškrabat",
                                "target_lang_sense_clarification": "odstranit vrstvu něčeho"
                            },
                            {
                                "target_lang_word": "oškrábat",
                                "target_lang_sense_clarification": "očistit povrch škrábáním"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56851258-37ea-3236-ba21-47c886fccd37",
                    "sense_definition": "To barely manage to achieve or attain something difficult.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "achievement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I only just <w>scraped</w> a pass in my final math exam.",
                            "target_lang_translations": {
                                "cs": "U závěrečné zkoušky z matematiky jsem <w>vydřel</w> jen těsné prospění."
                            }
                        },
                        {
                            "text": "The team <w>scraped</w> a victory in the last minute of the game.",
                            "target_lang_translations": {
                                "cs": "Tým v poslední minutě zápasu <w>vydřel</w> vítězství."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scrape a pass",
                        "scrape a victory"
                    ],
                    "target_lang_definitions": {
                        "cs": "Sotva něčeho dosáhnout nebo uspět v něčem obtížném."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vydřít",
                                "target_lang_sense_clarification": "dosáhnout něčeho s velkým úsilím"
                            },
                            {
                                "target_lang_word": "proklouznout",
                                "target_lang_sense_clarification": "uspět jen těsně"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}