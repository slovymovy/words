                ],
                "senses": [
                    {
                        "sense_id": "79051948-5eab-30d9-9014-ba5fc215a7fa",
                        "entry_id": "ce1f7e81-d237-37fb-a865-3396dab167aa",
                        "glosses": [
                            "Redonner un caractère phénoménologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "735d142f-35e7-43e9-950b-12b6e7251de9",
                                "sense_id": "79051948-5eab-30d9-9014-ba5fc215a7fa",
                                "text": "Rapprochement inédit, en effet, et invitation à re-phénoménologiser et re-sémiotiser la nature de l’homme."
                            },
                            {
                                "example_id": "a53103f8-3be5-41d3-9baf-05bf93af3c0f",
                                "sense_id": "79051948-5eab-30d9-9014-ba5fc215a7fa",
                                "text": "Ajoutons qu’en insistant sur le caractère par essence arbitraire de l’institution symbolique en tant que telle, Richir s’inscrit dans une certaine filiation du structuralisme, en particulier de Lévi-Strauss, qu’il parvient par un tour de force dialectique à re-phénoménologiser en préservant sa dimension non-phénoménologique."
                            }
                        ]
                    }
