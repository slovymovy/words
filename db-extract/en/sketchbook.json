                                        "sense_id": "44ff94da-50eb-3809-9950-62429fb14851",
                                        "entry_id": "455507ff-c99c-3e75-9c0c-31c69d141450",
                                        "glosses": [
                                            "альбом или блокнот для заметок, набросков, эскизов или зарисовок с натуры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8dac331-bf04-4ac4-9e25-504e97f2c0d7",
                                                "sense_id": "44ff94da-50eb-3809-9950-62429fb14851",
                                                "text": "Художники — от Леонардо да Винчи до Марка Шагала — использовали скетчбуки, чтобы играть с идеями."
                                            }
                                        ]
                                    }
                                ]
