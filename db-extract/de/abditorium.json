                            "Archäologie"
                        ],
                        "examples": [
                            {
                                "example_id": "a54e237e-b337-4e82-ac02-043345f95ebf",
                                "sense_id": "6640e419-2cb8-310c-8993-d2546da27233",
                                "text": "In dieser Kapelle kann man ein prächtiges Abditorium betrachten, wahrscheinlich einen italienischen Reliquienkasten des Mittelalters."
                            }
                        ],
                        "sense_index_json": "\"2\""
