                    {
                        "sense_id": "63096bba-ddd8-31e7-83ae-dd649f2a5920",
                        "entry_id": "04d0299d-e282-367e-a0b7-626b3250cd98",
                        "glosses": [
                            "Incapable of being extinguished, not extinguishable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2876a4c5-d451-4a70-a5f7-a2d25ff8bd4e",
                                "sense_id": "63096bba-ddd8-31e7-83ae-dd649f2a5920",
                                "text": "These achievements were made at a bloody cost and required courage and indomitable honesty, evidence of the inextinguishable will to survive and to be self-actualized in the face of unspeakable dangers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5d2b061-5442-4e3d-b28b-1eae9ec414a7",
                        "source_entry_id": "04d0299d-e282-367e-a0b7-626b3250cd98",
                        "source_sense_id": "63096bba-ddd8-31e7-83ae-dd649f2a5920",
                        "source_sense_description": "incapable of being extinguished",
                        "target_lang_word": "inextinguible",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inextinguible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c70c1ff6-a5e9-364a-9a16-93bd505f591d",
                                        "entry_id": "1f4cb727-898b-305a-b8ff-cc40d5258c3a",
                                        "glosses": [
                                            "Qui ne peut s’éteindre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4231121-dc13-41ad-958f-9f879599eb9a",
                                                "sense_id": "c70c1ff6-a5e9-364a-9a16-93bd505f591d",
                                                "text": "Un feu inextinguible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef41ec33-9b50-3fc3-bd4c-25b1b0068730",
                                        "entry_id": "1f4cb727-898b-305a-b8ff-cc40d5258c3a",
                                        "glosses": [
                                            "Qui ne s’éteint pas, ne peut disparaître, s’oublier, cesser, se réprimer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d204ab67-da37-44b3-a093-1103c77e79b6",
                                                "sense_id": "ef41ec33-9b50-3fc3-bd4c-25b1b0068730",
                                                "text": "Le public ne s’y trompe pas, et lui offre une immense, inextinguible ovation."
                                            },
                                            {
                                                "example_id": "1334c8f6-5944-4e53-9536-e0e3c2fc293f",
                                                "sense_id": "ef41ec33-9b50-3fc3-bd4c-25b1b0068730",
                                                "text": "N’éprouvent-ils pas, comme moi, cette inextinguible soif de beauté ?"
                                            },
                                            {
                                                "example_id": "e8ce34ed-f637-427a-94b2-84890e06d2e0",
                                                "sense_id": "ef41ec33-9b50-3fc3-bd4c-25b1b0068730",
                                                "text": "Cette thèse est dédiée au souvenir de notre mère, […], envers qui nous avons une dette inextinguible et sans qui rien de tout ce qui suit n’aurait jamais été possible."
                                            },
                                            {
                                                "example_id": "29906ca6-8f2e-4531-97d8-371fc9ecd158",
                                                "sense_id": "ef41ec33-9b50-3fc3-bd4c-25b1b0068730",
                                                "text": "Soif inextinguible, soif que rien ne peut apaiser."
                                            },
                                            {
                                                "example_id": "815081e1-81ce-4965-91df-e20ed99670ba",
                                                "sense_id": "ef41ec33-9b50-3fc3-bd4c-25b1b0068730",
                                                "text": "Rire inextinguible, rire éclatant et prolongé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38cafdb1-635b-34fb-b3bc-ab7a13da1e0c",
                                        "entry_id": "1f4cb727-898b-305a-b8ff-cc40d5258c3a",
                                        "glosses": [
                                            "Qui ne s’éteint pas, ne peut disparaître, s’oublier, cesser, se réprimer.",
                                            "Éternel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2b5059c-cd2e-44a8-85ef-5d589f12c41e",
                                                "sense_id": "38cafdb1-635b-34fb-b3bc-ab7a13da1e0c",
                                                "text": "Lumière inextinguible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "151adb1a-e324-4183-bae7-d60adba4ae24",
                        "source_entry_id": "04d0299d-e282-367e-a0b7-626b3250cd98",
                        "source_sense_id": "63096bba-ddd8-31e7-83ae-dd649f2a5920",
                        "source_sense_description": "incapable of being extinguished",
                        "target_lang_word": "unlöschbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unlöschbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15ab06a9-6cf7-3021-bbdf-27c79a17cc8f",
                                        "entry_id": "85a6e0ed-cc1c-39c6-81fb-1e921afc2f1c",
                                        "glosses": [
                                            "so, dass es nicht gelöscht werden kann"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e5597bf-c0f3-42e8-8bf0-895543c1a035",
                                                "sense_id": "15ab06a9-6cf7-3021-bbdf-27c79a17cc8f",
                                                "text": "„Wohin? Wohin soll ich mich wenden? Hinter mir höre ich donnernd brennende Balken stürzen, ergriffen von dem übernatürlichen, magisch erweckten unlöschbaren Feuer ... Nur fort, nur fort von hier!“"
                                            },
                                            {
                                                "example_id": "ba2459f2-d252-4a08-8bcc-35270e87fb9b",
                                                "sense_id": "15ab06a9-6cf7-3021-bbdf-27c79a17cc8f",
                                                "text": "„Die Kranken klagen über Trockenheit des Mundes und der Lippen und haben heftigen Durst, der durch das innerlich wütende Fieber verursacht wird und zuletzt, besonders zur Nachtzeit, fast unlöschbar wird.“"
                                            },
                                            {
                                                "example_id": "026f0246-667d-4191-aa82-58581c26a87a",
                                                "sense_id": "15ab06a9-6cf7-3021-bbdf-27c79a17cc8f",
                                                "text": "„Nero mußte Rom anzünden, was eine gefährliche, kostspielige und ausgesprochen kitschige Idee war; Dante hat mit seinem Flammenpinsel eine ganze Hölle angezündet, deren Feuer unlöschbar durch die Jahrhunderte brennt.“"
                                            },
                                            {
                                                "example_id": "30e5ef62-afb2-4c68-8d6b-65e21e6e9960",
                                                "sense_id": "15ab06a9-6cf7-3021-bbdf-27c79a17cc8f",
                                                "text": "„Ganze Berge belegter Brote wurden verzehrt, und unlöschbar schien der Bierdurst zu sein, der aus hundert Tonnen gestillt wurde.“"
                                            },
                                            {
                                                "example_id": "52ac0a82-a3c8-413e-b9e7-1f60e33dc1e4",
                                                "sense_id": "15ab06a9-6cf7-3021-bbdf-27c79a17cc8f",
                                                "text": "„Und der Erfolg gab ihm – zunächst – rasch und glänzend recht. Überall, wohin der Aufruf kam, wirkte er wie ein Blitzstrahl, der auf Brandstoff trifft: er zündete augenblicklich, unwiderstehlich, unlöschbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
