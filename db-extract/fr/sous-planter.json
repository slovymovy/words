                "senses": [
                    {
                        "sense_id": "59c6a4e9-9a55-309b-a862-ceb884a0b73d",
                        "entry_id": "0716bc6d-ca43-3d7f-9f58-b46e9843b8d4",
                        "glosses": [
                            "Planter de façon insuffisante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90f5d103-3517-4985-85f8-aa82600e57ee",
                                "sense_id": "59c6a4e9-9a55-309b-a862-ceb884a0b73d",
                                "text": "Très beau nano, un peu sous-planté à mon goût, mais tes plantes devraient s'étoffer dans quelques [sic] temps"
                            },
                            {
                                "example_id": "b75ac4ae-b44f-40c0-8bb6-2ecb653fe5e3",
                                "sense_id": "59c6a4e9-9a55-309b-a862-ceb884a0b73d",
                                "text": "On a toujours tendance à sous-planter quand on débute et ce n’est pas bon pour l’équilibre de l’aquarium."
                            }
                        ]
                    },
                    {
                        "sense_id": "0cb23e7a-4d18-31ad-a889-dbb3105b96f3",
                        "entry_id": "0716bc6d-ca43-3d7f-9f58-b46e9843b8d4",
                        "glosses": [
                            "Planter sous quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "764bc2fa-fc28-403d-9c44-558cb1725e51",
                                "sense_id": "0cb23e7a-4d18-31ad-a889-dbb3105b96f3",
                                "text": "Intercalez de jonquilles tardives, ou sous-plantez de muscari ou de pensées."
                            }
                        ]
                    }
                ],
