                            },
                            {
                                "target_lang_word": "батя",
                                "target_lang_sense_clarification": "разговорное обращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爸爸",
                                "target_lang_sense_clarification": "标准称呼"
                            }
                        ]
