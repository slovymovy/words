                "senses": [
                    {
                        "sense_id": "ae9a8aed-5469-395a-8899-6e354a562abc",
                        "entry_id": "729d6f11-08b6-3186-b13d-d26cc8d5f046",
                        "glosses": [
                            "Kanalratte"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "6c379f96-11ac-447f-874d-ceb7676fea03",
                                "sense_id": "ae9a8aed-5469-395a-8899-6e354a562abc",
                                "text": "„Ich ersäufe dich wie einen Kanalratz“"
                            },
                            {
                                "example_id": "2afef788-badf-48b5-926c-c54a59911891",
                                "sense_id": "ae9a8aed-5469-395a-8899-6e354a562abc",
                                "text": "„Der püselt jeden Samstag, Sonntag wiara Kanalratz, und dann sagt er sowas zu mir. Da muaß ja aaner lachen.“"
                            },
                            {
                                "example_id": "12087bb4-af25-43df-af60-911c6d961219",
                                "sense_id": "ae9a8aed-5469-395a-8899-6e354a562abc",
                                "text": "„ja wo lebn wir denn? Bin i vielleicht a Maulwurf oder a Kanalratz?“"
                            },
                            {
                                "example_id": "dade1a03-3353-4f98-8a02-fc49c547e330",
                                "sense_id": "ae9a8aed-5469-395a-8899-6e354a562abc",
                                "text": "„Der Kanalratz ändert im Gegensatz zum Menschen einfach sein Verhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c70f4ac3-4273-3e40-870e-bc208bb51fdd",
                        "entry_id": "729d6f11-08b6-3186-b13d-d26cc8d5f046",
                        "glosses": [
                            "eine widerwärtige Person, Stadtstreicher"
                        ],
                        "tags": [
                            "Austrian German",
                            "South-German",
                            "derogatory",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "e8940973-dc66-403d-b67d-14dc0b490570",
                                "sense_id": "c70f4ac3-4273-3e40-870e-bc208bb51fdd",
                                "text": "„Häupl: Wann mir zwa irgendwas sicher net san, dann Kollegen, du Wolfsberger Amöbe! Seifried: Amöbe? Na, immer no besser als a Ottakringer Kanalratz!“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
