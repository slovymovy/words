                                "example_id": "e318f923-0550-49e6-98fd-62aeb9397d6b",
                                "sense_id": "1d6a7ff9-f62c-3077-b19c-8e73eeebf696",
                                "text": "They unmercifully bundled me and my gallant second into our own hackney coach."
                            }
