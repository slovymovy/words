                        "entry_id": "6fb9009f-d53c-35d8-b0f5-f152aa131555",
                        "glosses": [
                            "A major river that flows about 901 km (560 mi) from France through Belgium and the Netherlands to the North Sea."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7e553603-44b3-39f6-ac20-e86313c4dbb5",
                        "entry_id": "6fb9009f-d53c-35d8-b0f5-f152aa131555",
                        "glosses": [
                            "A department of Grand Est, France. Capital: Bar-le-Duc (INSEE code 55)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "793a7f61-cfea-46c6-ba69-0d5f663cbdd9",
                        "source_entry_id": "6fb9009f-d53c-35d8-b0f5-f152aa131555",
                        "source_sense_description": "river",
                        "target_lang_word": "Maas",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maas",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6e80d001-981a-32f0-992e-94416bcdbbc7",
                                        "entry_id": "c22eaa9a-0b6f-398c-92ab-8b84262092cc",
                                        "glosses": [
                                            "een rivier die ontspringt in Frankrijk en via België en Nederland opgaat in de Rijn-Schelde-delta"
                                        ],
                                        "tags": [
                                            "toponiem: rivier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bd8be54-4d04-407c-8cb3-9b18e223b7d8",
                                                "sense_id": "6e80d001-981a-32f0-992e-94416bcdbbc7",
                                                "text": "Maastricht ligt aan de Maas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c013d442-1d5d-4808-8b30-23da31aeb462",
                        "source_entry_id": "6fb9009f-d53c-35d8-b0f5-f152aa131555",
                        "source_sense_description": "river",
                        "target_lang_word": "Meuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68cb60ed-21fa-386f-98f3-d82122e0663b",
                                        "entry_id": "a8d0bb58-c864-3a7e-8a1d-485be2e5b3bf",
                                        "glosses": [
                                            "Fleuve prenant sa source en Champagne-Ardenne en France, traversant la Belgique, et se jetant dans la mer du Nord, aux Pays-Bas."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "633ce59e-8969-4508-a088-23098fecb6bd",
                                                "sense_id": "68cb60ed-21fa-386f-98f3-d82122e0663b",
                                                "text": "Mais loin de son Plateau, Arsène André étouffait. L'air résineux lui manquait, les brouillards de la Meuse lui enflammaient la gorge."
                                            },
                                            {
                                                "example_id": "2ab4c5c3-c412-45df-8425-595294335cc1",
                                                "sense_id": "68cb60ed-21fa-386f-98f3-d82122e0663b",
                                                "text": "À l'extrémité de la route que nous suivions s'ouvrait un pont qui enjambait un canal, et donnait accès dans une sorte d'île formée par une grande courbe de la Meuse, qui dessine un oméga."
                                            },
                                            {
                                                "example_id": "99c646dc-68d4-4d57-919a-96aa6f6c8870",
                                                "sense_id": "68cb60ed-21fa-386f-98f3-d82122e0663b",
                                                "text": "Dans les vallées de la Meuse et de la Chiers, il existe également de belles prairies qui sont souvent d'une étendue immense."
                                            },
                                            {
                                                "example_id": "072a7ad7-dd88-48f5-a73e-8124addbf48d",
                                                "sense_id": "68cb60ed-21fa-386f-98f3-d82122e0663b",
                                                "text": "Parmi ces observations il en est que nous ne pourrons publier que lorsque les événements en cours, sans lesquels, d'ailleurs, nous n'eussions certainement pas vu l’embâcle de la Meuse, seront terminés."
                                            },
                                            {
                                                "example_id": "561cff25-cb63-4431-a2a1-df389829eb7b",
                                                "sense_id": "68cb60ed-21fa-386f-98f3-d82122e0663b",
                                                "text": "Si par malheur les crues de l’Ourthe coïncidaient avec celles de la Meuse, des inondations catastrophiques affectaient toute la vallée en aval de Liège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ea920d2-f9a5-3ff6-b220-f3c9b1900361",
                                        "entry_id": "a8d0bb58-c864-3a7e-8a1d-485be2e5b3bf",
                                        "glosses": [
                                            "Département français du Grand Est, traversé par ce fleuve."
                                        ],
                                        "tags": [
                                            "Toponymie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b034ec14-4bf7-4ebc-aca5-62c5d6e80bf3",
                                                "sense_id": "6ea920d2-f9a5-3ff6-b220-f3c9b1900361",
                                                "text": "Dans la Meuse, l’A4 est bloquée entre Manheulles et Haudiomont, selon les Jeunes Agriculteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d50eae1e-4d84-377a-9188-d31fd0345462",
                                        "entry_id": "a8d0bb58-c864-3a7e-8a1d-485be2e5b3bf",
                                        "glosses": [
                                            "Village et ancienne commune française, située dans le département de la Haute-Marne intégrée dans la commune de Val-de-Meuse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85b88409-a873-4bc4-b62d-9719fe361729",
                        "source_entry_id": "6fb9009f-d53c-35d8-b0f5-f152aa131555",
                        "source_sense_description": "river",
                        "target_lang_word": "Maas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b46bb8b-9acd-3f9b-a98c-33fd40e33b83",
                                        "entry_id": "a1bbb0fe-eb9e-359b-b4af-bbb48ec6e992",
                                        "glosses": [
                                            "Fluss in Frankreich, Belgien und den Niederlanden"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d2f2a6d-d739-4b4f-8b8e-1ca9f8e5d2c1",
                                                "sense_id": "0b46bb8b-9acd-3f9b-a98c-33fd40e33b83",
                                                "text": "Die Maas hat eine Länge von 925 km."
                                            },
                                            {
                                                "example_id": "e4919b37-1135-4e95-ac01-a4d99798a4d8",
                                                "sense_id": "0b46bb8b-9acd-3f9b-a98c-33fd40e33b83",
                                                "text": "Wir überquerten die Maas."
                                            },
                                            {
                                                "example_id": "85316cdc-ec63-4076-891a-1e7b912b3d56",
                                                "sense_id": "0b46bb8b-9acd-3f9b-a98c-33fd40e33b83",
                                                "text": "Die Kinder versuchten, in der Maas zu baden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Maas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                        "entry_id": "27cbf0ae-954b-3fe3-9331-d86da8678e6a",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e011c146-132b-4a21-9f74-e089542a9499",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "Frau Maas ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "ae7ea15e-323b-4a16-8f7e-b8ed2d543971",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "Herr Maas wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "65f98b84-6094-4b6b-a3c6-4e8c0aab440c",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "Die Maasens kommen heute aus dem Breisgau."
                                            },
                                            {
                                                "example_id": "07805a3c-7a75-46a7-be7e-004e949de78c",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "Der Maas trägt nie die Schals, die die Maas ihm strickt."
                                            },
                                            {
                                                "example_id": "ec5f9ac6-fc8e-4c0b-9061-930e5cf79939",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Maas kommt, geht der Herr Maas.“"
                                            },
                                            {
                                                "example_id": "f5a3b6e9-26ea-4eba-a6c7-37b71e0c4774",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "Maas kommt und geht."
                                            },
                                            {
                                                "example_id": "01df8e19-535a-4eda-8053-8d3795cccf1b",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "Maasens kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "bce09a61-f0d7-4fac-93fa-39e648174f29",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "An verregneten Herbsttagen ist Familie Maas liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "05fa8acd-a0d8-4a0e-b7ea-d96da74c9391",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Maas das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
