                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "219d49a5-0f7c-4612-8140-af22359a66c2",
                        "source_entry_id": "1de38760-8850-33e8-8eec-805a32a68967",
                        "source_sense_id": "8f375ecb-e487-3c03-9d62-02c2dec26d14",
                        "target_lang_word": "wobble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wobble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44f9f960-2dff-3b67-aa23-7d40df8f8996",
                                        "entry_id": "8245af1a-506e-3e54-a9a6-59b7dd4c4967",
                                        "glosses": [
                                            "An unsteady motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7da218a8-ed15-4da6-984c-8cff892e49c3",
                                                "sense_id": "44f9f960-2dff-3b67-aa23-7d40df8f8996",
                                                "text": "The fat man walked down the street with a wobble."
                                            },
                                            {
                                                "example_id": "0200a56a-2ced-4585-aa01-3e6ab31bdac0",
                                                "sense_id": "44f9f960-2dff-3b67-aa23-7d40df8f8996",
                                                "text": "That should have been that, but Hart caught a dose of the Hennessey wobbles and spilled Adlene Guedioura's long-range shot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15acaf66-577d-3268-a7ba-94ec4e9df923",
                                        "entry_id": "8245af1a-506e-3e54-a9a6-59b7dd4c4967",
                                        "glosses": [
                                            "A tremulous sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acbb1d94-2c7d-4f28-bc68-664974fda91b",
                                                "sense_id": "15acaf66-577d-3268-a7ba-94ec4e9df923",
                                                "text": "There was a wobble on her high notes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c39784f-5860-3768-ac72-02900b5598c3",
                                        "entry_id": "8245af1a-506e-3e54-a9a6-59b7dd4c4967",
                                        "glosses": [
                                            "A low-frequency oscillation sometimes used in dubstep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d0cd4ad-780a-4505-bffd-0c94181fa1a9",
                                                "sense_id": "8c39784f-5860-3768-ac72-02900b5598c3",
                                                "text": "“I Knew You Were Trouble,” one of the year’s great pop songs, begins like a sock-hop anthem, with jaunty guitars. A dubstep wobble arrives about halfway through like a wrecking ball, changing the course not just of the song but also of Ms. Swift’s career."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fe77492-dc89-3158-ae39-2351a8171864",
                                        "entry_id": "8245af1a-506e-3e54-a9a6-59b7dd4c4967",
                                        "glosses": [
                                            "A variation in the third nucleotide of a codon that codes for a specific aminoacid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "wobble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85ce3c55-b282-3dad-a3b0-68840d844100",
                                        "entry_id": "7be7da3c-b01a-316c-bf9c-7934bc0edf30",
                                        "glosses": [
                                            "To move with an uneven or rocking motion, or unsteadily to and fro."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17201f6c-4470-424c-8ebb-ab47bdf043c0",
                                                "sense_id": "85ce3c55-b282-3dad-a3b0-68840d844100",
                                                "text": "the Earth wobbles slowly on its axis"
                                            },
                                            {
                                                "example_id": "77f309c2-6df1-4eeb-b316-10e104ca97a9",
                                                "sense_id": "85ce3c55-b282-3dad-a3b0-68840d844100",
                                                "text": "the jelly wobbled on the plate"
                                            },
                                            {
                                                "example_id": "c32a6561-a2be-48d4-a1bc-281e2d7e3735",
                                                "sense_id": "85ce3c55-b282-3dad-a3b0-68840d844100",
                                                "text": "The apparition wobbled in front of Arthur's eyes, though the truth of the matter is probably that Arthur's eyes were wobbling in front of the apparition. His mouth wobbled as well."
                                            },
                                            {
                                                "example_id": "27810e7e-6738-489d-84d5-090daddcd47d",
                                                "sense_id": "85ce3c55-b282-3dad-a3b0-68840d844100",
                                                "text": "Investors face a quandary. Cash offers a return of virtually zero in many developed countries; government-bond yields may have risen in recent weeks but they are still unattractive. Equities have suffered two big bear markets since 2000 and are wobbling again. It is hardly surprising that pension funds, insurers and endowments are searching for new sources of return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9c9714b-2331-3bc7-8b07-87f3d064ba66",
                                        "entry_id": "7be7da3c-b01a-316c-bf9c-7934bc0edf30",
                                        "glosses": [
                                            "To tremble or quaver."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6adf7b35-aa01-476a-b547-b2ecc6ee5786",
                                                "sense_id": "b9c9714b-2331-3bc7-8b07-87f3d064ba66",
                                                "text": "The soprano's voice wobbled alarmingly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "153d1eb7-2013-330f-aca8-4214abe21bfc",
                                        "entry_id": "7be7da3c-b01a-316c-bf9c-7934bc0edf30",
                                        "glosses": [
                                            "To vacillate in one's opinions."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c72e9895-5239-4e75-9800-f230da3b1c3b",
                                                "sense_id": "153d1eb7-2013-330f-aca8-4214abe21bfc",
                                                "text": "I'm wobbling between the Liberals and the Greens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcab15bf-7328-3085-bb77-58496a34638b",
                                        "entry_id": "7be7da3c-b01a-316c-bf9c-7934bc0edf30",
                                        "glosses": [
                                            "To cause to wobble."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00817b40-d2a8-42ce-82d4-f02e81f5f7a9",
                                                "sense_id": "bcab15bf-7328-3085-bb77-58496a34638b",
                                                "text": "The boy wobbled the girl's bike."
                                            },
                                            {
                                                "example_id": "dadb648c-79b5-48ac-9d27-7fdf65ca0135",
                                                "sense_id": "bcab15bf-7328-3085-bb77-58496a34638b",
                                                "text": "He said: “This front wheel wobbles.”\nI said: “It doesn’t if you don’t wobble it.” It didn’t wobble, as a matter of fact—nothing worth calling a wobble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46cc077a-6d14-4f09-a930-63b2a6cc7b89",
                        "source_entry_id": "1de38760-8850-33e8-8eec-805a32a68967",
                        "source_sense_id": "8f375ecb-e487-3c03-9d62-02c2dec26d14",
                        "target_lang_word": "shimmy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shimmy",
