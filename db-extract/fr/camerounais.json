            {
                "entry_id": "d1df3e3e-7314-3c7f-ac4d-91d71db2c581",
                "word": "Camerounais",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ca3f35a5-9775-471c-9e46-26f50c31d206",
                        "entry_id": "d1df3e3e-7314-3c7f-ac4d-91d71db2c581",
                        "tags": [
                            "feminine"
                        ],
                        "form": "Camerounaise"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c080a2f3-8ded-3779-85f6-5c944cc556bf",
                        "entry_id": "d1df3e3e-7314-3c7f-ac4d-91d71db2c581",
                        "glosses": [
                            "Habitant ou originaire du Cameroun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10c996ae-0bef-4594-b65f-a57c62f9afe8",
                                "sense_id": "c080a2f3-8ded-3779-85f6-5c944cc556bf",
                                "text": "Au premier rang de la salle d’audience, la victime Élisée Nkana, Camerounais de 21 ans, peut difficilement cacher le bandage autour de sa main handicapée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b252464-e876-4af6-99fd-56aeaf31cd45",
                        "source_entry_id": "d1df3e3e-7314-3c7f-ac4d-91d71db2c581",
                        "source_sense_id": "c080a2f3-8ded-3779-85f6-5c944cc556bf",
                        "target_lang_word": "Kameruner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kameruner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9a02bb6-18f7-3b52-b438-e33cb4ea7454",
                                        "entry_id": "bfa06241-34ee-3093-94cc-666a6535d423",
                                        "glosses": [
                                            "Staatsbürger von Kamerun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46f252af-5820-4a9a-acf3-597adcbf856d",
                                                "sense_id": "c9a02bb6-18f7-3b52-b438-e33cb4ea7454",
                                                "text": "„Durch den Handel mit fremden Handelspartnern eröffneten sich den Kamerunern Einblicke in andere Formen von Gerechtigkeit und in andere Rechtssysteme.“"
                                            },
                                            {
                                                "example_id": "3ae1a9b4-7c2c-41e2-bd25-0ee7e58da014",
                                                "sense_id": "c9a02bb6-18f7-3b52-b438-e33cb4ea7454",
                                                "text": "„Eine weitere Auswertung des anthropologischen Materials zeigt, dass monographische Berichte über Kameruner und deren Sitten und Gebräuche mit 192 von insgesamt 308 Artikeln bei der Wissensverbreitung in Deutschland an erster Stelle stehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "74bde096-24d0-35ac-9ec3-60b7d9912c8b",
                                        "entry_id": "bfa06241-34ee-3093-94cc-666a6535d423",
                                        "glosses": [
                                            "landschaftlich, besonders berlinisch: Schmalzgebäck in Form einer Acht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15186f55-14d4-4a0d-ade5-8d2f56cfc943",
                                                "sense_id": "74bde096-24d0-35ac-9ec3-60b7d9912c8b",
                                                "text": "„Berliner Pfannkuchen sind im Feingebäck-Sortiment jeder Bäckerei/Konditorei zu finden. Außerdem gibt es noch andere Siedegebäcke aus Hefefeinteig, beispielsweise Apfelkrapfen, Quarkballen, Hefeteig-Donuts und Kameruner (mit Mürbeteiganteil).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kameruner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2cf21c0-ed67-38a9-80d9-8ef602e7eee9",
                                        "entry_id": "abbce058-f448-35d5-a759-a486947c37b9",
                                        "glosses": [
                                            "Erdnuss"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5150b113-7276-49bd-b95c-c8f7325b778a",
                                                "sense_id": "b2cf21c0-ed67-38a9-80d9-8ef602e7eee9",
                                                "text": "Nach dem Fußballabend fand sich auf dem Boden noch die eine oder andere Kameruner."
                                            },
                                            {
                                                "example_id": "95b3bca5-1b34-4d55-88ee-40cd8989a47b",
                                                "sense_id": "b2cf21c0-ed67-38a9-80d9-8ef602e7eee9",
                                                "text": "Wir brauchen noch eine Dose gesalzene Kameruner."
                                            },
                                            {
                                                "example_id": "2239f0b2-7efc-4add-a0c0-7bfbd816bff2",
                                                "sense_id": "b2cf21c0-ed67-38a9-80d9-8ef602e7eee9",
                                                "text": "Wenn Susanne zu Besuch ist, dürfen wir keine einzige Kameruner anbieten. Sie ist stark allergisch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
