                        "examples": [
                            {
                                "example_id": "edf8d94a-3967-4978-a699-eb0d5b64aaac",
                                "sense_id": "56256f1c-fd98-3d10-beaf-0e5c7724a474",
                                "text": "Astronomie galactique, branche de l’astronomie qui étudie notre galaxie."
