                            "text": "Hij wilde haar bellen, maar de lijn was <w>dood</w>.",
                            "target_lang_translations": {
                                "en": "He wanted to call her, but the line was <w>dead</w>."
                            }
                        },
                        {
                            "text": "De batterij van mijn telefoon is helemaal <w>dood</w>.",
                            "target_lang_translations": {
                                "en": "My phone's battery is completely <w>dead</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "no longer working or functioning"
                    },
                    "translations": {
                        "en": [
