                "senses": [
                    {
                        "sense_id": "5004f548-425d-3a11-8434-e409b5e5fee2",
                        "entry_id": "79e618af-b291-33ad-b7b9-6515eb2c7c2e",
                        "glosses": [
                            "Abfindung der nichtregierenden Mitglieder eines Adelsgeschlechts mit Landbesitz, Einkünften aus Liegenschaften oder Geldzahlungen zur Ermöglichung eines standesgemäßen Lebenswandels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42d30d0a-95c9-4d57-b17a-b9bc754dfc08",
                                "sense_id": "5004f548-425d-3a11-8434-e409b5e5fee2",
                                "text": "„Der Baron bliebe natürlich in voller Freiheit wohnen, nur mit beschränkten Vermögensrechten und einer festen Apanage.“"
                            },
                            {
                                "example_id": "99593a94-9fa9-42d9-baf0-a3cc72946080",
                                "sense_id": "5004f548-425d-3a11-8434-e409b5e5fee2",
                                "text": "„Im Fürstentum Monaco befand sich eine französische Garnison, und der Prinz erhielt dafür eine Apanage von hunderttausend Francs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d71ef1d9-44da-308c-9a03-3e7b01c344e9",
                        "entry_id": "79e618af-b291-33ad-b7b9-6515eb2c7c2e",
                        "glosses": [
                            "regelmäßige finanzielle Zuwendung in größerem Stil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6f326d0-31f6-4cf2-ac56-b3ea159da103",
                                "sense_id": "d71ef1d9-44da-308c-9a03-3e7b01c344e9",
                                "text": "„Die willfährige Regierung hat die königliche Apanage unlängst verdreifacht auf etwa viereinhalb Millionen Euro pro Jahr.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
