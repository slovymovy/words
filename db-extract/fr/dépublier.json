                "senses": [
                    {
                        "sense_id": "d302f8a1-3565-38ba-bd57-62e014d60eb2",
                        "entry_id": "73034cb4-dbab-35aa-a129-fce380cffc71",
                        "glosses": [
                            "Mettre un contenu hors ligne sans forcément l’effacer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "270d7162-eb7c-4ba7-8ff9-54742707737a",
                                "sense_id": "d302f8a1-3565-38ba-bd57-62e014d60eb2",
                                "text": "Dépublier un article d’un site Internet."
                            },
                            {
                                "example_id": "9c552206-8f34-4c28-a974-24081f0c011b",
                                "sense_id": "d302f8a1-3565-38ba-bd57-62e014d60eb2",
                                "text": "Médiapart a dépublié un article du blog du sociologue Laurent Mucchielli parce que la rédaction estimait qu'il avait mal interprété les chiffres des morts causés par le vaccin contre le covid-19."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9b3cc3a-1699-4dd1-90bf-705cef37d919",
                        "source_entry_id": "73034cb4-dbab-35aa-a129-fce380cffc71",
                        "source_sense_id": "d302f8a1-3565-38ba-bd57-62e014d60eb2",
                        "target_lang_word": "unpublish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unpublish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa5cea48-ab92-33c6-860c-bba250d04ba7",
                                        "entry_id": "8e926102-a370-382b-a6ee-39d1ac4f1f11",
                                        "glosses": [
                                            "To remove (something previously published) from circulation; to retract."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00e65716-75cb-4755-b7e1-b536b1d5a040",
                                                "sense_id": "fa5cea48-ab92-33c6-860c-bba250d04ba7",
                                                "text": "To unpublish a calendar: 1. In the Applications folder, double-click the iCal icon to open the application. The main iCal window opens; in the Calendars section on the left, published calendars have a small mark to the right of their names […]"
                                            },
                                            {
                                                "example_id": "508ae3be-03e1-4e57-90b0-1f77f35c10f8",
                                                "sense_id": "fa5cea48-ab92-33c6-860c-bba250d04ba7",
                                                "text": "Burns' political sentiments were already clearly delineated in 'A Dream' and no amount of etiquette could unpublish that poem."
                                            },
                                            {
                                                "example_id": "b647f9fe-9a38-4343-b3d0-8d10a98b468d",
                                                "sense_id": "fa5cea48-ab92-33c6-860c-bba250d04ba7",
                                                "text": "Yes. We have a strict policy on unpublishing: We don’t."
                                            },
                                            {
                                                "example_id": "d769325c-b200-4941-a4a3-d7d689df46eb",
                                                "sense_id": "fa5cea48-ab92-33c6-860c-bba250d04ba7",
                                                "text": "You unpublish a category to hide it from display on the front end of the website."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
