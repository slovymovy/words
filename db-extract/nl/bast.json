                                    {
                                        "sense_id": "6ba07a53-865f-348c-bde1-da236936aed9",
                                        "entry_id": "5adaf720-6161-3f86-b74c-c326b64a1eab",
                                        "glosses": [
                                            "pflanzliche Faser, die in der inneren Schicht der Rinde von Bäumen oder anderen verholzten Pflanzen zu finden ist und zum Flechten und Binden von Seilen, Textilien und anderen Gegenständen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c57ba6e9-5e2e-4b6d-976f-a9304369c4e7",
                                                "sense_id": "6ba07a53-865f-348c-bde1-da236936aed9",
                                                "text": "Die Ureinwohner hatten die Taue der Schiffe aus Bast geflochten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "804ca6b2-b3eb-383c-8c53-ec6909acd77b",
                                        "entry_id": "5adaf720-6161-3f86-b74c-c326b64a1eab",
                                        "glosses": [
                                            "samtige, weiche Haut auf dem neu gewachsenen Geweih des Hirsches"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abc793fd-db41-4d01-b239-7f50023e244b",
                                                "sense_id": "804ca6b2-b3eb-383c-8c53-ec6909acd77b",
                                                "text": "Im Sommer ist bei manchen Hirschen der Bast am neuen Geweih zu sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ccb239e0-12b5-4a0b-95e7-7765919b5081",
                        "source_entry_id": "53db11ec-0855-371a-af6d-71915345218b",
                        "source_sense_id": "dffa214a-67f3-3a12-a697-db24568d878d",
                        "source_sense_description": "buitenste laag...",
                        "target_lang_word": "bast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf293e96-29a3-34ee-b27c-4ec955d9c13b",
                                        "entry_id": "eb85c8db-51a9-3594-a5d8-0240d6c327a0",
                                        "glosses": [
                                            "Inner bark of a tree from which rope is traditionally made."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ccadecb-0f5d-3f6c-ae7a-8e285097a9fe",
                                        "entry_id": "eb85c8db-51a9-3594-a5d8-0240d6c327a0",
                                        "glosses": [
                                            "Fibre made from the phloem of certain plants (particularly the lime tree) and used for making ropes, cords and matting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a696d37f-1a27-4c1e-a04a-0418507c183e",
                                                "sense_id": "4ccadecb-0f5d-3f6c-ae7a-8e285097a9fe",
                                                "text": "[T]here would be seen his face, or that of his elder brother, peering down. A guttural sound, and the tip-tap of bast slippers beating the narrow wooden stairs, and he would stand before one without coat, a little bent, in leather apron, with sleeves turned back, blinking[…]"
                                            },
                                            {
                                                "example_id": "9406a935-3b96-43ff-89cb-466f742f5b9d",
                                                "sense_id": "4ccadecb-0f5d-3f6c-ae7a-8e285097a9fe",
                                                "text": "At the far end of the houses the head gardener stood waiting for his mistress, and he gave her strips of bass to tie up her nosegay. This she did slowly and laboriously, with knuckly old fingers that shook."
                                            },
                                            {
                                                "example_id": "0a73bde1-4b8b-472f-b7f0-7b4ee68d55d2",
                                                "sense_id": "4ccadecb-0f5d-3f6c-ae7a-8e285097a9fe",
                                                "text": "I thought I saw Him in the Long Walk there, by the bed of Nelly Roche, tending a fallen flower with a wisp of bast."
                                            },
                                            {
                                                "example_id": "ca572d9b-0c58-4baf-b5cd-02efae3a36a6",
                                                "sense_id": "4ccadecb-0f5d-3f6c-ae7a-8e285097a9fe",
                                                "text": "He had taken along a long bast rope in his sleigh, since it was the custom on longer journeys to have a spare rope in case the reins needed mending."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
