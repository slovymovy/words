                    },
                    {
                        "translation_id": "6e99aca4-19ce-4bb2-962d-ba3669d4115e",
                        "source_entry_id": "2c92292b-669a-3f87-a57e-e92335fb344f",
                        "source_sense_id": "f18abacc-7b47-3519-8245-7ad00ba4898b",
