                ],
                "senses": [
                    {
                        "sense_id": "6b9fa842-1a98-383e-8185-fd2894dc9ae7",
                        "entry_id": "a0bf630b-d004-353f-8532-a4985b9768fc",
                        "glosses": [
                            "Officier ministériel titulaire d'une charge, qui garantit de la régularité des ventes aux enchères publiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34c8a4d6-3c62-42c1-ad9a-123cc2b9b782",
                                "sense_id": "6b9fa842-1a98-383e-8185-fd2894dc9ae7",
                                "text": "En 1552, un édit d'Henri II vient renforcer la notoriété des enchères. […]. Il donnera à la profession de commissaire-priseur certains traits caractéristiques encore valables aujourd'hui, notament le statut d'officier ministériel pour les commissaires-priseurs judiciaires."
                            },
                            {
                                "example_id": "c1c95444-332e-4f54-951e-a0183effff7b",
                                "sense_id": "6b9fa842-1a98-383e-8185-fd2894dc9ae7",
                                "text": "Oh ! me dit le commissaire-priseur, tout cela était bien rococo. » Mot épouvantable qui flétrissait toutes les religions de mon enfance."
                            },
                            {
                                "example_id": "da87ca9f-4503-46a9-8dca-73703b5a377d",
                                "sense_id": "6b9fa842-1a98-383e-8185-fd2894dc9ae7",
                                "text": "La société d’exercice libéral à responsabilité limitée « SELARL Boissinot, commissaire-priseur judiciaire », constituée pour l’exercice de la profession de commissaire-priseur judiciaire, est nommée commissaire-priseuse judiciaire à la résidence de Poitiers (86), en remplacement de Mᵉ Pierre Segeron. Mᵉ Bénédicte Boissinot est nommée commissaire-priseuse judiciaire associée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb188d29-ca7a-4828-b8e1-d41f9c3dd231",
                        "source_entry_id": "a0bf630b-d004-353f-8532-a4985b9768fc",
                        "source_sense_id": "6b9fa842-1a98-383e-8185-fd2894dc9ae7",
                        "target_lang_word": "auctioneer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auctioneer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87cc7dc2-329e-38f3-a446-cdff17acb32f",
                                        "entry_id": "b2bef3c2-8f30-3e20-98aa-cde91bab4d31",
                                        "glosses": [
                                            "An individual who conducts an auction on behalf of a vendor, accepting bids to find the best price for the vendor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a21b54ca-f0af-4bd4-8e83-8c118aa4021a",
                                                "sense_id": "87cc7dc2-329e-38f3-a446-cdff17acb32f",
                                                "text": "The auctioneer, with his fruity, theatrical voice and his gavel, hits a block of wood in precisely the same spot, no matter the day."
                                            },
                                            {
                                                "example_id": "25a44282-a518-44cc-bdf2-e0e7c8d1c6b6",
                                                "sense_id": "87cc7dc2-329e-38f3-a446-cdff17acb32f",
                                                "text": "But there are many items that auctioneers sell every day in various garb: industrial equipment, autos and real estate, to name a few."
                                            },
                                            {
                                                "example_id": "94112d8e-4cdc-4b09-a4be-9a8513395a7d",
                                                "sense_id": "87cc7dc2-329e-38f3-a446-cdff17acb32f",
                                                "text": "The auctioneer donated the monument to FOLHC and they got to work restoring his plot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "auctioneer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "421c770f-96b1-3abb-a903-6b731390e540",
                                        "entry_id": "b4ad55e5-e740-3152-a86b-26bd7123709d",
                                        "glosses": [
                                            "To sell at an auction; to auction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
