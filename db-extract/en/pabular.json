        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dddbc876-db97-320e-bd5a-606cc736d8b3",
                "word": "pabular",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3e793da2-6357-3252-86da-368f774f3a4f",
                        "entry_id": "dddbc876-db97-320e-bd5a-606cc736d8b3",
                        "glosses": [
                            "Edible; of or pertaining to food."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "59333bdb-8ce6-414c-95bb-5d14e86e1c6d",
                                "sense_id": "3e793da2-6357-3252-86da-368f774f3a4f",
                                "text": "We shall however delight to follow our author in those pleasing meditations wherewith, under the ingenious fiction of Hortense, he introduces some of the most important subjects of pabular interest."
                            },
                            {
                                "example_id": "095cb3b9-2c93-4827-b869-d17cb6584485",
                                "sense_id": "3e793da2-6357-3252-86da-368f774f3a4f",
                                "text": "It is a well-known fact in Indian warfare that the sepoy always fights and marches best on a full stomach. Therefore, the advisableness of this pabular preparation was unquestionable."
                            },
                            {
                                "example_id": "1c106a4b-1fd5-4db4-a473-800676185a36",
                                "sense_id": "3e793da2-6357-3252-86da-368f774f3a4f",
                                "text": "[…] and as that species feeds indiscriminately on such varied trees as hazel, beech, and sallow, an extension of its pabular range is not surprising."
                            },
                            {
                                "example_id": "c3a2e3ef-ef7a-427d-88a8-79985585f592",
                                "sense_id": "3e793da2-6357-3252-86da-368f774f3a4f",
                                "text": "This pabular vocabulary will be eagerly embraced by all those interested in and engaged in food and its preparation from whatever culture and tradition they may come."
                            }
                        ]
                    }
                ],
