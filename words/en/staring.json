                    "examples": [
                        {
                            "text": "We invited Mr. <w>Staring</w> to join the committee next month.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили мистера <w>Старинга</w> присоединиться к комитету в следующем месяце.",
                                "fr": "Nous avons invité M. Staring à rejoindre le comité le mois prochain."
                            }
                        },
                        {
                            "text": "The <w>Staring</w> family has lived in this village for over a century.",
                            "target_lang_translations": {
