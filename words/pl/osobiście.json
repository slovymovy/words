                                "ru": "Не воспринимай эту критику так <w>лично</w>.",
                                "en": "Don't take this criticism so <w>personally</w>.",
                                "nl": "Vat deze kritiek niet zo <w>persoonlijk</w> op.",
                                "de": "Nimm diese Kritik nicht so <w>persönlich</w>.",
                                "fr": "Ne prends pas cette critique si <w>personnellement</w>.",
                                "it": "Non prendere questa critica così <w>sul personale</w>.",
                                "cs": "Neber si tu kritiku tak <w>osobně</w>.",
                                "tr": "Bu eleştiriyi bu kadar <w>kişisel olarak</w> algılama.",
                                "es": "No te tomes esta crítica de manera tan <w>personal</w>."
                            }
                        },
                        {
                            "text": "<w>Osobiście</w> uważam, że to bardzo dobry pomysł.",
                            "target_lang_translations": {
                                "ru": "<w>Лично</w> я считаю, что это очень хорошая идея.",
                                "en": "<w>Personally</w>, I think it is a very good idea.",
                                "nl": "<w>Persoonlijk</w> vind ik dat een heel goed idee.",
                                "de": "<w>Persönlich</w> finde ich, dass das eine sehr gute Idee ist.",
                                "fr": "<w>Personnellement</w>, je pense que c'est une très bonne idée.",
                                "it": "<w>Personalmente</w> penso che sia un'ottima idea.",
                                "cs": "<w>Osobně</w> si myslím, že je to velmi dobrý nápad.",
                                "tr": "<w>Şahsen</w> bunun çok iyi bir fikir olduğunu düşünüyorum.",
                                "es": "<w>Personalmente</w> creo que es una muy buena idea."
                            }
                        }
                    ],
                    "common_phrases": [
                        "traktować osobiście",
                        "osobiście uważać"
