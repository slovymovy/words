                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "native_american_related",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "Linguists have documented many varieties of <w>Indian</w>.",
                            "target_lang_translations": {
                                "ru": "Лингвисты задокументировали множество разновидностей <w>индейских языков</w>.",
                                "zh": "语言学家记录了许多种<w>印第安语</w>。"
                            }
                        },
                        {
                            "text": "He speaks <w>Indian</w> as well as English.",
                            "target_lang_translations": {
                                "ru": "Он говорит на <w>индейском</w> так же хорошо, как и на английском.",
                                "zh": "他既会说英语，也会说<w>印第安语</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой из языков, на которых говорят коренные народы Америки.",
                        "zh": "美洲原住民所说的任何语言。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индейский язык",
                                "target_lang_sense_clarification": "язык коренных народов Америки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "印第安语",
