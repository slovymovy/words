                                    {
                                        "sense_id": "b7478ae8-5a4a-38e9-b312-ad10aa795ed5",
                                        "entry_id": "43676086-461b-36d8-aeab-0a0973caee95",
                                        "glosses": [
                                            "An encapsulated collection of nerve cell bodies, typically linked by synapses, and often forming a swelling on a nerve fiber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f7e48b0-f7e6-40e7-822e-7e602abcd9bd",
                                                "sense_id": "b7478ae8-5a4a-38e9-b312-ad10aa795ed5",
                                                "text": "[T]he wonderfully diversified instincts, mental powers, and affections of ants are generally known, yet their cerebral ganglia are not so large as the quarter of a small pin's head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9393dbef-e546-3bf5-9881-1c30527ed679",
                                        "entry_id": "43676086-461b-36d8-aeab-0a0973caee95",
                                        "glosses": [
                                            "Any of certain masses of gray matter in the central nervous system, as the basal ganglia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba0a4de1-3cbd-4251-a28e-13bc5c9c8d60",
                                                "sense_id": "9393dbef-e546-3bf5-9881-1c30527ed679",
                                                "text": "The yawning gap in neuroscientists’ understanding of their topic is in the intermediate scale of the brain’s anatomy. Science has a passable knowledge of how individual nerve cells, known as neurons, work. It also knows which visible lobes and ganglia of the brain do what. But how the neurons are organised in these lobes and ganglia remains obscure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9b06a0b-8404-3349-8338-9f07e177c35d",
                                        "entry_id": "43676086-461b-36d8-aeab-0a0973caee95",
                                        "glosses": [
                                            "A centre of intellectual or industrial force, activity, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
