                                "sense_id": "732f7044-6119-3069-b272-427ae784e7e0",
                                "text": "⧖ Visch, gesouten Kool-visch, Eelbut, Schellevisch, Kibbels, henner-Bakeljou, par tonne 0 [pond] - 0 [schelling] - 8 [groot]"
