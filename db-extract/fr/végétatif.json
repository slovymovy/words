        "fr-extract.jsonl": [
            {
                "entry_id": "a9a03fce-17cc-30d6-b892-48f98769a5c2",
                "word": "végétatif",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d0908b4b-eea2-4c98-bc47-47a7787bca71",
                        "entry_id": "a9a03fce-17cc-30d6-b892-48f98769a5c2",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "végétatifs"
                    },
                    {
                        "form_id": "7f092daa-b5d3-40c5-829d-125419d4cad0",
                        "entry_id": "a9a03fce-17cc-30d6-b892-48f98769a5c2",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "végétative"
                    },
                    {
                        "form_id": "faaa7343-5237-4432-9088-4cf03d387ccc",
                        "entry_id": "a9a03fce-17cc-30d6-b892-48f98769a5c2",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "végétatives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f9b8173-b26e-3aa9-a4c3-6cb6a3e4ba5b",
                        "entry_id": "a9a03fce-17cc-30d6-b892-48f98769a5c2",
                        "glosses": [
                            "Relatif au développement et à la végétation des plantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f5db497-07bc-4ca8-9cf4-738412d29265",
                                "sense_id": "6f9b8173-b26e-3aa9-a4c3-6cb6a3e4ba5b",
                                "text": "Or, il est essentiel de travailler vite dans ces pays de climat continental où la période végétative est brève, où il faut mettre la terre en culture très rapidement après la raspoutitsa pour que la récolte n'ait à souffrir ni de l’échaudage de l'été, ni des orages de fin de saison."
                            },
                            {
                                "example_id": "28fc760e-9bfb-47ce-9c6d-515ddf30dfd4",
                                "sense_id": "6f9b8173-b26e-3aa9-a4c3-6cb6a3e4ba5b",
                                "text": "Cet ouvrage présente les connaissances actuelles sur l’écophysiologie du pois protéagineux : développement végétatif et reproducteur, croissance en condition non limitante, nutrition azotée."
                            }
                        ]
                    },
                    {
                        "sense_id": "a65c703a-e863-3761-8985-ba205b13e763",
                        "entry_id": "a9a03fce-17cc-30d6-b892-48f98769a5c2",
                        "glosses": [
                            "Qualifie un mode de reproduction hors sexualité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a8a3ea1-c407-4a80-a3d7-990f6e6ffe4b",
                                "sense_id": "a65c703a-e863-3761-8985-ba205b13e763",
                                "text": "Dès lors, l’association à Limnanthemum s’appauvrit au profit d’Hélophytes pourvues d’organes de multiplication végétative […] et de certaines espèces amphibies […] dont la plasticité écologique s’accommode des conditions nouvelles."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf3e0bea-ca28-3a89-a7e5-2ad0def64175",
                        "entry_id": "a9a03fce-17cc-30d6-b892-48f98769a5c2",
                        "glosses": [
                            "Qui fait végéter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffa29c69-6d39-4df8-93bd-3548d21360f2",
                                "sense_id": "cf3e0bea-ca28-3a89-a7e5-2ad0def64175",
                                "text": "Principe végétatif. — Âme végétative."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a1bce17-faa3-38c6-ac7e-1275546dbaef",
                        "entry_id": "a9a03fce-17cc-30d6-b892-48f98769a5c2",
                        "glosses": [
                            "Qui ne s’élève pas au-dessus de l’état de végétation."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "16bb042e-35a1-44eb-899b-cc9563b781b4",
                                "sense_id": "9a1bce17-faa3-38c6-ac7e-1275546dbaef",
                                "text": "Être végétatif. — Ce malade n’a plus qu’une vie végétative."
                            },
                            {
                                "example_id": "d71b0d1b-7b0b-43c6-a239-7a2a1786e261",
                                "sense_id": "9a1bce17-faa3-38c6-ac7e-1275546dbaef",
                                "text": "Si quelques patients étaient, de fait, plongés dans un coma profond — manifestement endormis, inertes —, d’autres se trouvaient dans des états végétatifs variables."
                            }
                        ]
                    },
                    {
                        "sense_id": "75957186-3463-3ffa-a9bc-bb5735f1eb11",
                        "entry_id": "a9a03fce-17cc-30d6-b892-48f98769a5c2",
                        "glosses": [
                            "Ayant peu d'activité."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "03af7ffa-33df-4e13-8553-0e04b2896756",
                                "sense_id": "75957186-3463-3ffa-a9bc-bb5735f1eb11",
                                "text": "J’ai déjà dit qu’elle considérait l’existence végétative des sous-préfectures comme une chose extravagante, désirable et rare, qu’elle n’avait pas eu la chance de connaître, ayant passé toute sa vie, quoi qu’elle fît pour conserver sa solitude, dans la société d’excentriques, d’aventuriers, de snobs, d’esthètes, de critiques à paradoxes, d’artistes un peu loufoques, de difficiles et de raffinés."
                            }
                        ]
                    }
                ],
