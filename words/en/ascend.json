{
    "word_family": [
        "ascent",
        "ascension",
        "ascendant",
        "ascendancy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "857c5f4b-7c41-31aa-bf3c-744d0b4d2e37",
                    "sense_definition": "To go up or climb a structure or surface.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Guests must <w>ascend</w> the stairs to reach the grand ballroom.",
                            "target_lang_translations": {
                                "ru": "Гости должны <w>подняться</w> по лестнице, чтобы попасть в большой бальный зал.",
                                "pl": "Goście muszą <w>wejść</w> po schodach, aby dotrzeć do wielkiej sali balowej."
                            }
                        },
                        {
                            "text": "The hikers began to <w>ascend</w> the steep mountain trail early in the morning.",
                            "target_lang_translations": {
                                "ru": "Туристы начали <w>подниматься</w> по крутой горной тропе рано утром.",
                                "pl": "Wędrowcy zaczęli <w>wchodzić</w> stromym górskim szlakiem wcześnie rano."
                            }
                        }
                    ],
                    "synonyms": [
                        "climb",
                        "mount",
                        "scale"
                    ],
                    "antonyms": [
                        "descend"
                    ],
                    "common_phrases": [
                        "ascend the stairs",
                        "ascend the mountain",
                        "ascend a ladder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подниматься или взбираться на сооружение или поверхность",
                        "pl": "Wchodzić lub wspinać się na coś, poruszając się w górę po powierzchni lub konstrukcji."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "взбираться",
                                "target_lang_sense_clarification": "с усилием"
                            },
                            {
                                "target_lang_word": "всходить",
                                "target_lang_sense_clarification": "на возвышение или по ступеням"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wchodzić",
                                "target_lang_sense_clarification": "ogólnie: iść lub wspinać się w górę"
                            },
                            {
                                "target_lang_word": "wchodzić na",
                                "target_lang_sense_clarification": "na górę, po schodach lub na wzniesienie"
                            },
                            {
                                "target_lang_word": "wspinać się",
                                "target_lang_sense_clarification": "z wysiłkiem, na stromą powierzchnię"
                            },
                            {
                                "target_lang_word": "wstępować",
                                "target_lang_sense_clarification": "bardziej formalnie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3690afb2-e2ab-3064-b848-10c54525a15e",
                    "sense_definition": "To move upward through the air or space.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hot air balloon began to <w>ascend</w> slowly into the clouds.",
                            "target_lang_translations": {
                                "ru": "Воздушный шар начал медленно <w>подниматься</w> к облакам.",
                                "pl": "Balon na gorące powietrze zaczął powoli <w>wznosić się</w> ku chmurom."
                            }
                        },
                        {
                            "text": "Thick black smoke <w>ascended</w> from the chimney.",
                            "target_lang_translations": {
                                "ru": "Густой черный дым <w>поднимался</w> из трубы.",
                                "pl": "Gęsty czarny dym <w>unosił się</w> z komina."
                            }
                        }
                    ],
                    "synonyms": [
                        "rise",
                        "soar",
                        "float up"
                    ],
                    "antonyms": [
                        "descend"
                    ],
                    "common_phrases": [
                        "ascend to heaven",
                        "ascend into the sky"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться вверх по воздуху или в пространстве",
                        "pl": "Poruszać się ku górze w powietrzu lub przestrzeni."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "набирать высоту"
                            },
                            {
                                "target_lang_word": "взмывать",
                                "target_lang_sense_clarification": "стремительно подниматься"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wznosić się",
                                "target_lang_sense_clarification": "ogólnie poruszać się w górę w powietrzu"
                            },
                            {
                                "target_lang_word": "unosić się",
                                "target_lang_sense_clarification": "o dymie, mgle, parze"
                            },
                            {
                                "target_lang_word": "wzbijać się",
                                "target_lang_sense_clarification": "gwałtownie lub wysoko wznieść się"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5178f7bc-7a1b-370d-895d-2bb84eb569b2",
                    "sense_definition": "To take a position of power, especially as a monarch.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prince is expected to <w>ascend</w> the throne after his father's reign ends.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что принц <w>взойдет</w> на престол после окончания правления его отца.",
                                "pl": "Oczekuje się, że książę <w>wstąpi</w> na tron po zakończeniu panowania ojca."
                            }
                        },
                        {
                            "text": "She managed to <w>ascend</w> to a position of great influence within the company.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>подняться</w> до очень влиятельной должности в компании.",
                                "pl": "Udało jej się <w>awansować</w> na bardzo wpływowe stanowisko w firmie."
                            }
                        }
                    ],
                    "synonyms": [
                        "succeed"
                    ],
                    "common_phrases": [
                        "ascend the throne",
                        "ascend to power"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занять властную позицию, особенно трон",
                        "pl": "Objąć stanowisko władzy, zwłaszcza zostać monarchą lub dojść do wysokiej pozycji."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всходить",
                                "target_lang_sense_clarification": "на престол"
                            },
                            {
                                "target_lang_word": "прийти",
                                "target_lang_sense_clarification": "к власти"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wstąpić na tron",
                                "target_lang_sense_clarification": "objąć tron"
                            },
                            {
                                "target_lang_word": "dojść do władzy",
                                "target_lang_sense_clarification": "objąć władzę"
                            },
                            {
                                "target_lang_word": "awansować",
                                "target_lang_sense_clarification": "awansować do wpływowej pozycji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74d97148-8115-3ece-9325-935445f9691c",
                    "sense_definition": "To slope or lead in an upward direction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The narrow road <w>ascends</w> sharply as you leave the village.",
                            "target_lang_translations": {
                                "ru": "Узкая дорога резко <w>поднимается</w> вверх при выезде из деревни.",
                                "pl": "Wąska droga stromo <w>wznosi się</w>, gdy wyjeżdżasz ze wsi."
                            }
                        },
                        {
                            "text": "A winding path <w>ascends</w> through the dense forest.",
                            "target_lang_translations": {
                                "ru": "Извилистая тропинка <w>поднимается</w> сквозь густой лес.",
                                "pl": "Kręta ścieżka <w>prowadzi</w> w górę przez gęsty las."
                            }
                        }
                    ],
                    "synonyms": [
                        "rise",
                        "slope up"
                    ],
                    "antonyms": [
                        "descend"
                    ],
                    "common_phrases": [
                        "path ascends",
                        "road ascends"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести или уходить вверх (о дороге, тропе)",
                        "pl": "Wznosić się lub prowadzić ku górze."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "идти под уклоном вверх"
                            },
                            {
                                "target_lang_word": "идти вверх",
                                "target_lang_sense_clarification": "о дороге или пути"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wznosić się",
                                "target_lang_sense_clarification": "o drodze, ścieżce: biec ku górze"
                            },
                            {
                                "target_lang_word": "iść w górę",
                                "target_lang_sense_clarification": "o trasie lub ścieżce"
                            },
                            {
                                "target_lang_word": "prowadzić w górę",
                                "target_lang_sense_clarification": "o drodze lub szlaku prowadzącym wyżej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf69ef28-ca6c-39ab-8e49-83a17615b537",
                    "sense_definition": "To become higher in pitch.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The melody <w>ascends</w> to a high note before resolving.",
                            "target_lang_translations": {
                                "ru": "Мелодия <w>поднимается</w> к высокой ноте перед разрешением.",
                                "pl": "Melodia <w>wznosi się</w> do wysokiego dźwięku, zanim się rozwiąże."
                            }
                        },
                        {
                            "text": "Singers practice scales that <w>ascend</w> and descend to warm up their voices.",
                            "target_lang_translations": {
                                "ru": "Певцы тренируют гаммы, которые <w>идут вверх</w> и вниз, чтобы разогреть голос.",
                                "pl": "Śpiewacy ćwiczą gamy, które <w>wznoszą się</w> i opadają, aby rozgrzać głosy."
                            }
                        }
                    ],
                    "antonyms": [
                        "descend"
                    ],
                    "common_phrases": [
                        "scale ascends"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться выше по тональности",
                        "pl": "Stawać się wyższym pod względem wysokości dźwięku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повышаться",
                                "target_lang_sense_clarification": "о звуке"
                            },
                            {
                                "target_lang_word": "идти вверх",
                                "target_lang_sense_clarification": "о мелодии или гамме"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "podwyższać się",
                                "target_lang_sense_clarification": "o wysokości dźwięku"
                            },
                            {
                                "target_lang_word": "wznosić się",
                                "target_lang_sense_clarification": "o melodii, gamie"
                            },
                            {
                                "target_lang_word": "iść w górę",
                                "target_lang_sense_clarification": "o tonie lub skali"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c428fca6-e63d-3bf0-906b-05e6680579f1",
                    "sense_definition": "To trace back to an earlier time or source.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historians attempt to <w>ascend</w> to the very origins of the ancient legend.",
                            "target_lang_translations": {
                                "ru": "Историки пытаются <w>добраться</w> до самых истоков древней легенды.",
                                "pl": "Historycy próbują <w>dotrzeć</w> do samych początków starożytnej legendy."
                            }
                        },
                        {
                            "text": "The family's genealogy <w>ascends</w> to the sixteenth century.",
                            "target_lang_translations": {
                                "ru": "Родословная семьи <w>восходит</w> к шестнадцатому веку.",
                                "pl": "Genealogia tej rodziny <w>sięga</w> XVI wieku."
                            }
                        }
                    ],
                    "synonyms": [
                        "trace back"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восходить к более раннему времени или источнику",
                        "pl": "Sięgać do wcześniejszego czasu lub źródła; wywodzić się z czegoś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восходить",
                                "target_lang_sense_clarification": "брать начало в прошлом"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "sięgać",
                                "target_lang_sense_clarification": "mieć początek w dawniejszym czasie lub źródle"
                            },
                            {
                                "target_lang_word": "wywodzić się",
                                "target_lang_sense_clarification": "bardziej formalnie: mieć źródło w przeszłości"
                            },
                            {
                                "target_lang_word": "pochodzić",
                                "target_lang_sense_clarification": "zwłaszcza o pochodzeniu, tradycji, rodowodzie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8478746-95a0-3918-b2e1-b73419505fb2",
                    "sense_definition": "To improve one's social or romantic status.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He hoped to <w>ascend</w> socially by changing his lifestyle and habits.",
                            "target_lang_translations": {
                                "ru": "Он надеялся <w>подняться</w> в социальном плане, изменив свой образ жизни и привычки.",
                                "pl": "Miał nadzieję <w>awansować</w> społecznie, zmieniając swój styl życia i nawyki."
                            }
                        },
                        {
                            "text": "Users on the forum discussed various ways to <w>ascend</w> and improve their lives.",
                            "target_lang_translations": {
                                "ru": "Пользователи форума обсуждали различные способы <w>подняться</w> и улучшить свою жизнь.",
                                "pl": "Użytkownicy forum omawiali różne sposoby, by <w>się wybić</w> i poprawić swoje życie."
                            }
                        }
                    ],
                    "synonyms": [
                        "improve"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used primarily in specific internet subcultures"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшить свой социальный статус (сленг)",
                        "pl": "Poprawić swój status społeczny lub romantyczny; wybić się w górę (slangowo, w określonych subkulturach internetowych)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подняться",
                                "target_lang_sense_clarification": "добиться успеха"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "awansować społecznie",
                                "target_lang_sense_clarification": "poprawić swoją pozycję społeczną lub życiową"
                            },
                            {
                                "target_lang_word": "wybić się",
                                "target_lang_sense_clarification": "potocznie: osiągnąć wyższy status"
                            },
                            {
                                "target_lang_word": "piąć się w górę",
                                "target_lang_sense_clarification": "szerzej: poprawić swój status"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}