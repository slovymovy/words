                "senses": [
                    {
                        "sense_id": "c57ab56a-5146-301d-aeb9-c6a165acab40",
                        "entry_id": "e18ebaf9-621e-33f6-859c-184753970934",
                        "glosses": [
                            "To squat or sprawl; to duck into concealment."
                        ],
                        "tags": [
                            "Scotland",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "353774e5-d6ff-43e8-9fca-96fe243deb1c",
                                "sense_id": "c57ab56a-5146-301d-aeb9-c6a165acab40",
                                "text": "He spread his face out in such a manner that there was nothing left but mouth; as a young cuckoo in a sparrow's nest, when his stepmother cannot satisfy him, squattles his empty body down, and distends himself into one enormous gape."
                            },
                            {
                                "example_id": "b17e00bc-cf16-49a0-8ffd-88ac5491cfa5",
                                "sense_id": "c57ab56a-5146-301d-aeb9-c6a165acab40",
                                "text": "They tarried about a week among us, living in tents, with their little ones squattling among the litter[…]"
                            },
                            {
                                "example_id": "ce7e1683-7c8c-4372-92ac-3dd546ca10ef",
                                "sense_id": "c57ab56a-5146-301d-aeb9-c6a165acab40",
                                "text": "Whenever they got to the water they threw themselves down and squattled into it. The moment they were in the water they acted just as if they were fishes."
                            }
                        ]
                    }
                ],
