                                "target_senses": [
                                    {
                                        "sense_id": "23b801a1-d426-39e2-bdda-d04fcf6623cc",
                                        "entry_id": "af04994d-e42b-3058-8122-0828df84b57b",
                                        "glosses": [
                                            "Tending to repel; causing avoidance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca5bba2f-74d7-4ad4-8286-4a8d13c82973",
                                                "sense_id": "23b801a1-d426-39e2-bdda-d04fcf6623cc",
                                                "text": "If it is aversive to the animal and discourages behavior, it is a punishment. If it seems aversive to you but is not aversive to the animal, then it is not an effective punishment. In fact, technically, it's not even a punishment."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aversive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4ad61a4-8097-3ce1-b90d-c275c3171e5e",
                                        "entry_id": "3d5e66fd-4168-35de-b7d5-715b5ce38f6e",
                                        "glosses": [
                                            "A grammatical case indicating that something is avoided or feared; the evitative case."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58cb317b-5a24-319b-8d45-55b26b05a96b",
                                        "entry_id": "3d5e66fd-4168-35de-b7d5-715b5ce38f6e",
                                        "glosses": [
                                            "An unpleasant stimulus intended to induce a change in behaviour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2dfea1b-8d18-43fd-98e9-16d0a1f84b57",
                                                "sense_id": "58cb317b-5a24-319b-8d45-55b26b05a96b",
                                                "text": "For general training purposes, opportunities to engage in reproductive acts are not a practical reinforcer, and using aversives that generate fear is fraught with side effects."
                                            }
                                        ]
                                    }
