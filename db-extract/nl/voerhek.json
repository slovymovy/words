                        ],
                        "examples": [
                            {
                                "example_id": "887f40d5-d1f9-489b-94a7-ede2b0860a83",
                                "sense_id": "f0d330f1-f5e2-3907-89ba-e6c0ca9e0d0c",
                                "text": "Om een goede melkproductie te kunnen behalen moeten koeien voldoende ruwvoer opnemen. Hiervoor gaan ze tot wel 10 keer per dag richting het voerhek. Om het voor uw rundvee zo eenvoudig en veilig mogelijk te maken is een goed afgesteld voerhek van groot belang."
                            },
                            {
                                "example_id": "4f4d885f-c57c-44f7-9f90-bbcb66f320cb",
                                "sense_id": "f0d330f1-f5e2-3907-89ba-e6c0ca9e0d0c",
                                "text": "Over pakweg een jaar krijgen zijn koeien het voer elke dag vers voor het voerhek gebracht: een compleet rantsoen dat op bestelling wordt samengesteld in de ”keuken” van het voercentrum."
                            }
                        ]
                    }
