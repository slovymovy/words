    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97401079-9ae3-327f-ba77-47e156cf8b72",
                    "sense_definition": "dof geluid van iets zwaars dat valt of neerkomt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een doffe <w>plof</w> viel de zware stapel boeken op de grond.",
                            "target_lang_translations": {
                                "de": "Mit einem dumpfen <w>Plumps</w> fiel der schwere Bücherstapel auf den Boden."
                            }
                        },
                        {
                            "text": "We hoorden plotseling een luide <w>plof</w> vanuit de kelder komen.",
                            "target_lang_translations": {
                                "de": "Wir hörten plötzlich einen lauten <w>Knall</w> aus dem Keller kommen."
                            }
                        }
                    ],
                    "synonyms": [
                        "bons",
                        "smak"
                    ],
                    "common_phrases": [
                        "met een doffe plof"
                    ],
                    "target_lang_definitions": {
                        "de": "dumpfer Laut eines schweren Gegenstands, der herunterfällt oder aufschlägt"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Plumps",
                                "target_lang_sense_clarification": "dumpfes Geräusch beim Aufprall"
                            },
                            {
                                "target_lang_word": "Dumpfer Aufprall",
                                "target_lang_sense_clarification": "Schall eines schweren Aufpralls"
                            },
                            {
                                "target_lang_word": "Plopp",
                                "target_lang_sense_clarification": "leichtes dumpfes Geräusch"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "125451cd-7dfe-345b-aec2-b934fff8fc57",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>ploffen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vorm_van_ploffen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange werkdag <w>plof</w> ik altijd meteen uitgeput neer op de bank.",
                            "target_lang_translations": {
                                "de": "Nach einem langen Arbeitstag <w>lasse</w> ich mich immer sofort erschöpft auf das Sofa <w>fallen</w>."
                            }
                        },
                        {
                            "text": "Zodra ik thuiskom van school, <w>plof</w> ik in een gemakkelijke stoel.",
                            "target_lang_translations": {
                                "de": "Sobald ich von der Schule nach Hause komme, <w>plumpse</w> ich in einen bequemen Sessel."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plof neer op de bank"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "persoonsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "erste Person Singular Präsens von „ploffen“ (sich fallen lassen, hinsinken)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "plumpse",
                                "target_lang_sense_clarification": "1. Person Singular von 'plumpsen'"
                            },
                            {
                                "target_lang_word": "lasse mich fallen",
                                "target_lang_sense_clarification": "1. Person Singular von 'sich fallen lassen'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef84b4a7-20ff-3f9d-a547-81b5379c8340",
                    "sense_definition": "gebiedende wijs van <w>ploffen</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vorm_van_ploffen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Plof</w> lekker neer op de bank en ontspan een beetje na het werk.",
                            "target_lang_translations": {
                                "de": "<w>Lass dich</w> gemütlich auf die Couch <w>fallen</w> und entspanne dich nach der Arbeit ein wenig."
                            }
                        },
                        {
                            "text": "<w>Plof</w> niet zo hard neer, want de oude stoel kan breken.",
                            "target_lang_translations": {
                                "de": "<w>Plumps</w> nicht so heftig hinein, denn der alte Stuhl könnte kaputtgehen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperatief"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Imperativ Singular von „ploffen“ (sich fallen lassen, hinplumpsen)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "plumps",
                                "target_lang_sense_clarification": "Befehlsform von 'plumpsen'"
                            },
                            {
                                "target_lang_word": "lass dich fallen",
                                "target_lang_sense_clarification": "Befehlsform von 'sich fallen lassen'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f92c4290-9907-3e54-9922-4fa02421a293",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>ploffen</w> bij inversie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vorm_van_ploffen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>plof</w> je zo plotseling neer op de vloer?",
                            "target_lang_translations": {
                                "de": "Warum <w>lässt du dich</w> so plötzlich auf den Boden <w>fallen</w>?"
                            }
                        },
                        {
                            "text": "Als je zo moe bent, waarom <w>plof</w> je dan niet lekker in een stoel?",
                            "target_lang_translations": {
                                "de": "Wenn du so müde bist, warum <w>plumpst</w> du dann nicht einfach in einen Sessel?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "inversievorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "zweite Person Singular Präsens von „ploffen“ bei Inversion"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "plumpst",
                                "target_lang_sense_clarification": "2. Person Singular von 'plumpsen'"
                            },
                            {
                                "target_lang_word": "lässt dich fallen",
                                "target_lang_sense_clarification": "2. Person Singular von 'sich fallen lassen'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "755fd6ce-3d75-33c0-9023-22805415c334",
                    "sense_definition": "uitroep ter nabootsing van een doffe val of slag",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "klanknabootsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Plof</w>, daar viel opeens de dikke van Dale van de tafel.",
                            "target_lang_translations": {
                                "de": "<w>Plumps</w>, da fiel plötzlich das dicke Wörterbuch vom Tisch."
                            }
                        },
                        {
                            "text": "Hij struikelde over het speelgoed en, <w>plof</w>, daar lag hij languit.",
                            "target_lang_translations": {
                                "de": "Er stolperte über das Spielzeug und, <w>plumps</w>, lag er der Länge nach da."
                            }
                        }
                    ],
                    "synonyms": [
                        "boem",
                        "bons"
                    ],
                    "target_lang_definitions": {
                        "de": "Ausruf zur Nachahmung eines dumpfen Falls oder Aufpralls"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "plumps",
                                "target_lang_sense_clarification": "Ausruf bei dumpfem Hinfallen"
                            },
                            {
                                "target_lang_word": "patsch",
                                "target_lang_sense_clarification": "Lautmalerei für Aufprall"
                            },
                            {
                                "target_lang_word": "wumm",
                                "target_lang_sense_clarification": "Lautmalerei für dumpfen Schlag"
                            }
                        ]
                    }
                }
            ]
        }
    ]
