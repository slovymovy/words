                "senses": [
                    {
                        "sense_id": "9f99c1e3-985d-34c4-a830-70716b1f41d5",
                        "entry_id": "7ff5a4d8-c6a8-3f18-813c-ffaf4eab7917",
                        "glosses": [
                            "Position, aus der heraus Schüsse abgegeben werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "535db808-3368-4476-bc5d-d8907a76d7e8",
                                "sense_id": "9f99c1e3-985d-34c4-a830-70716b1f41d5",
                                "text": "„Raynor griff sich die Kalaschnikow und nahm eine liegende Schussposition im blutigen Heu ein.“"
                            },
                            {
                                "example_id": "b6b32cfe-f3cb-45ff-a293-d79af977b225",
                                "sense_id": "9f99c1e3-985d-34c4-a830-70716b1f41d5",
                                "text": "„Ihm schaudert bei dem Gedanken, und dann pflichtet er Hutton bei, ja, das hier war eine ausgezeichnete Schussposition.“"
                            },
                            {
                                "example_id": "b219bdb7-ef12-4886-91da-ac51d8fe2498",
                                "sense_id": "9f99c1e3-985d-34c4-a830-70716b1f41d5",
                                "text": "„Die meisten waren in Schussposition gegangen, ein Knie auf der Erde, die Gewehre im Anschlag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
