                    "sense_id": "1f1f7562-ffe4-3ee7-94bb-ba05b6357a86",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>loods</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "opslag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de <w>loodsen</w> heeft de politie de afgelopen jaren grondstoffen voor synthetische drugs gevonden.",
                            "target_lang_translations": {
                                "en": "In the <w>sheds</w>, the police have found raw materials for synthetic drugs in recent years."
                            }
                        },
                        {
                            "text": "De boer bewaart al zijn grote machines in de houten <w>loodsen</w> achter de boerderij.",
                            "target_lang_translations": {
                                "en": "The farmer keeps all his large machines in the wooden <w>sheds</w> behind the farm."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of the noun 'loods' (shed, warehouse)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sheds",
                                "target_lang_sense_clarification": "simple storage buildings"
                            },
                            {
                                "target_lang_word": "warehouses",
                                "target_lang_sense_clarification": "large buildings for storing goods"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e49b8fa-87d3-3e27-8ab5-ea656088a1e3",
                    "sense_definition": "meervoud van <w>loods</w> (iemand die schepen veilig door een bepaald gebied vaart)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beroepen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ervaren <w>loodsen</w> hielpen de grote schepen om veilig de haven binnen te varen.",
                            "target_lang_translations": {
                                "en": "The experienced <w>pilots</w> helped the large ships to enter the harbor safely."
                            }
                        },
                        {
                            "text": "Zonder de hulp van lokale <w>loodsen</w> is het erg gevaarlijk om door dit kanaal te varen.",
                            "target_lang_translations": {
                                "en": "Without the help of local <w>pilots</w>, it is very dangerous to sail through this canal."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'loods' (a person who navigates ships safely through a specific area)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pilots",
                                "target_lang_sense_clarification": "maritime experts who guide ships"
                            },
                            {
                                "target_lang_word": "maritime pilots",
                                "target_lang_sense_clarification": "professional ship navigators"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6effacc8-1295-3149-bdf6-ac1599d7018c",
                    "sense_definition": "iemand of iets zorgvuldig begeleiden naar een bestemming of door een proces",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "begeleiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bodyguards <w>loodsen</w> de filmster langs alle verzamelde media naar de auto.",
                            "target_lang_translations": {
                                "en": "The bodyguards <w>guide</w> the movie star past all the gathered media to the car."
                            }
                        },
                        {
                            "text": "De minister probeert het nieuwe wetsvoorstel veilig door de Tweede Kamer te <w>loodsen</w>.",
                            "target_lang_translations": {
                                "en": "The minister is trying to <w>steer</w> the new bill safely through the House of Representatives."
                            }
                        }
                    ],
                    "synonyms": [
                        "begeleiden",
                        "gidsen",
                        "leiden"
                    ],
                    "common_phrases": [
                        "door de senaat loodsen",
                        "veilig naar binnen loodsen"
                    ],
                    "target_lang_definitions": {
                        "en": "to carefully guide someone or something to a destination or through a process"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to guide",
                                "target_lang_sense_clarification": "to show the way or assist through a process"
                            },
                            {
                                "target_lang_word": "to usher",
                                "target_lang_sense_clarification": "to escort or lead someone somewhere"
                            },
                            {
                                "target_lang_word": "to shepherd",
                                "target_lang_sense_clarification": "to guide or direct a group or process carefully"
                            },
                            {
                                "target_lang_word": "to steer",
                                "target_lang_sense_clarification": "to direct the course of something like a bill or project"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a48bd4e-5b86-37d7-abda-779d9a574f6e",
                    "sense_definition": "een schip veilig langs lastige plekken of door een haven leiden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "navigatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Leon mag het enorme containerschip vandaag de haven binnen <w>loodsen</w>.",
                            "target_lang_translations": {
                                "en": "Leon is allowed to <w>pilot</w> the huge container ship into the harbor today."
                            }
                        },
                        {
                            "text": "Het is de taak van de expert om het schip door de smalle rivier te <w>loodsen</w>.",
                            "target_lang_translations": {
                                "en": "It is the expert's job to <w>navigate</w> the ship through the narrow river."
                            }
                        }
                    ],
                    "synonyms": [
                        "navigeren",
                        "sturen"
                    ],
                    "common_phrases": [
                        "een schip loodsen",
                        "de haven binnen loodsen"
                    ],
                    "target_lang_definitions": {
                        "en": "to lead a ship safely past difficult spots or through a harbor"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to pilot",
                                "target_lang_sense_clarification": "to navigate a ship through difficult waters"
                            },
                            {
                                "target_lang_word": "to steer",
                                "target_lang_sense_clarification": "to guide the direction of a vessel"
                            },
                            {
                                "target_lang_word": "to navigate",
                                "target_lang_sense_clarification": "to plan and direct the route of a ship"
