                ],
                "senses": [
                    {
                        "sense_id": "f2fe8876-b380-37f5-80a6-17169ae8774a",
                        "entry_id": "68294cbb-4d63-38db-9b52-eb9b73b1b8fc",
                        "glosses": [
                            "Qui s’oppose à la conscription obligeant les citoyens canadiens à s’enrôler dans l’armée pour la Première (1917) ou la Deuxième (1944) Guerres mondiales."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "1931cc62-d6ff-45ce-bd38-27cc96001508",
                                "sense_id": "f2fe8876-b380-37f5-80a6-17169ae8774a",
                                "text": "Dès le début de l’agitation anticonscriptionniste, nous avons signalé le danger des provocations à la violence."
                            },
                            {
                                "example_id": "bb308573-e122-4657-94aa-edcda6246dce",
                                "sense_id": "f2fe8876-b380-37f5-80a6-17169ae8774a",
                                "text": "Soulevée par les discours enflammés des jeunes orateurs anticonscriptionnistes, une foule de 10,000 personnes massées à l’angle des rues Garnier et Laurier a failli se porter à des excès regrettables hier soir."
                            },
                            {
                                "example_id": "76189ff8-5a69-4680-ad83-03f1888bb6a0",
                                "sense_id": "f2fe8876-b380-37f5-80a6-17169ae8774a",
                                "text": "Les libéraux ont-ils presque tous et si vite oublié la parole donnée à l’homme droit et loyal sans lequel le Québec n’aurait peut-être jamais hissé et tenu si longtemps sur le pavois de chef suprême et de premier ministre M. King, ni élu si souvent comme députés tant de gens qui devaient, à la première occasion venue, répudier ensemble leurs promesses anticonscriptionnistes, de 1917 à 1940 inclusivement?"
                            },
                            {
                                "example_id": "5ace48ee-3fa0-454e-901a-b5bea48c602b",
                                "sense_id": "f2fe8876-b380-37f5-80a6-17169ae8774a",
                                "text": "[…] l’étonnement des Français face à l’attitude anticonscriptionniste des Canadiens français […]."
                            }
                        ]
                    }
