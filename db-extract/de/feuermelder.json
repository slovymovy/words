                "senses": [
                    {
                        "sense_id": "6ecade82-77e5-3363-8f91-47f1769a148d",
                        "entry_id": "fb161ff7-75b7-31a2-a21a-f9c2862399fe",
                        "glosses": [
                            "technische Vorrichtung, mit der man bei Bedarf Feueralarm auslösen kann und die meist direkt die zuständige Feuerwache alarmiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2141fe84-9b60-440b-93f0-781fe1c86170",
                                "sense_id": "6ecade82-77e5-3363-8f91-47f1769a148d",
                                "text": "Wenn Feuer oder Rauch ausgebrochen ist, soll man die Scheibe des Feuermelders einschlagen und den Knopf bedienen, der sich dahinter befindet."
                            },
                            {
                                "example_id": "a19f64cc-ec31-43dd-9bac-213724f5ffcd",
                                "sense_id": "6ecade82-77e5-3363-8f91-47f1769a148d",
                                "text": "„Dazu zählen neben Profi-Überwachungskameras auch Thermostate, Feuermelder, Netzwerkdrucker oder Steuerungseinheiten für Solaranalagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
