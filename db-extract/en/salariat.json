                                            {
                                                "example_id": "7503f1dc-9ecb-41ac-888d-d7de41afe9a3",
                                                "sense_id": "8a7d85fc-edf4-3eef-95ed-11a8a248b938",
                                                "text": "Standing verdeelt de maatschappij in zeven groepen. De elite - het piepkleine gezelschap van absurd rijke wereldburgers zoals Carlos Slim en Bill Gates. Het salariaat- de groep mensen bij bedrijven of overheden met vaste aanstellingen, behoorlijke salarissen en betaalde vakantiedagen."
                                            }
