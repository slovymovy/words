                                        "sense_id": "5e7e67d6-3151-3fa7-bcf1-73c00036c88b",
                                        "entry_id": "997df71c-c18d-3c2e-8b73-4e257f5db825",
                                        "glosses": [
                                            "жарг. ЛГБТК+ парень, мужчина спортивного телосложения как сексуальный объект"
                                        ],
                                        "tags": [],
