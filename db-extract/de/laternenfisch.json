                    {
                        "sense_id": "0a0454d3-ae58-335d-8061-dba9640b8403",
                        "entry_id": "f96842ee-e4df-34da-8cc7-d3633931dbb9",
                        "glosses": [
                            "kleiner Tropenfisch mit zahlreichen, an den Flanken sitzenden Leuchtorganen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5bf32e2-a77b-433a-a3d0-51b711f9b586",
                                "sense_id": "0a0454d3-ae58-335d-8061-dba9640b8403",
                                "text": "„So wie sich die Spinnen ihre Netze entwickelt haben, um Fliegen zu fangen, wie Geparden schnellere Beine entwickelt haben, um Antilopen zu jagen, oder wie der Laternenfisch Licht entwickelte, das kleinere Fische in sein Maul lockt, haben wir Zuckermenschen uns auch angepasst, damit wir unsere Beute besser fangen können: Kinder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
