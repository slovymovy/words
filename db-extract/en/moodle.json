                        "sense_id": "dda1c470-6b7b-32c0-8cad-7044d41173d7",
                        "entry_id": "b5401d7a-89f5-3e8c-9d1e-0bf62acef58b",
                        "glosses": [
                            "To use a Moodle, either as a teacher or as a student."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54d15363-c4e7-485a-a498-be8c6634a6e5",
                                "sense_id": "dda1c470-6b7b-32c0-8cad-7044d41173d7",
                                "text": "One day, classroom students are accessing the Cloud as well as Skyping, and the next day they are Moodling."
                            },
                            {
                                "example_id": "f2e8c7e9-6c19-44fe-938b-397825651f55",
                                "sense_id": "dda1c470-6b7b-32c0-8cad-7044d41173d7",
                                "text": "Over the years, many teachers have developed instructional content using Moodle (anyone who Moodles is a Moodler!)."
                            },
                            {
                                "example_id": "70329663-b111-4b24-83f1-34abab058d88",
                                "sense_id": "dda1c470-6b7b-32c0-8cad-7044d41173d7",
                                "text": "Happy Moodling!"
                            }
                        ]
                    }
