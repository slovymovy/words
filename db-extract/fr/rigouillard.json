                        "entry_id": "e7d5817d-e924-3a03-a943-e8769fb00a75",
                        "glosses": [
                            "Celui qui aime s’amuser, rire, faire la fête."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "04629805-7a29-4551-ab58-ab31353f331f",
                                "sense_id": "848a6897-8c0e-3068-b7ff-992b2766a8f7",
                                "text": "Je crois bien, le père La Joie a été ouvrier chez moi, quand j’étais établi... En v’là un rigouillard !"
                            }
                        ]
                    }
