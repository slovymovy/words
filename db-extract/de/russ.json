                        "form": "die Russe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "47949dcb-fa27-393e-a4ad-cb0719dfff93",
                        "entry_id": "82cea320-6b9f-3069-8653-57e74a7b4c98",
                        "glosses": [
                            "schwarzer Rückstand (Kohlenstoff), der bei unvollständiger Verbrennung übrig bleibt"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "a10fbbdd-cdbc-436e-bcfc-70dfcce2929b",
                                "sense_id": "47949dcb-fa27-393e-a4ad-cb0719dfff93",
                                "text": "Russ besteht fast nur aus reinem Kohlenstoff (C) und entsteht bei unvollständiger Verbrennung."
                            },
                            {
                                "example_id": "01c6b65e-52cd-4188-865c-54e371cba84d",
                                "sense_id": "47949dcb-fa27-393e-a4ad-cb0719dfff93",
                                "text": "Ein besonderer Schwerpunkt ist die Bildung und Reduktion von Schadstoffen wie NOx, SO2 und Russ, die bei der Verbrennung entstehen können, sowie Messmethoden zu deren Bestimmung."
                            },
                            {
                                "example_id": "ffcdcb62-ac80-49e8-bfd9-447510fbeace",
                                "sense_id": "47949dcb-fa27-393e-a4ad-cb0719dfff93",
                                "text": "Lagert sich bei falscher Bedienung oder dem Verbrennen von nassem Holz doch Russ in den Zügen ab, sind diese leicht durch die eingebauten Reinigungsöffnungen zugängig und zu reinigen."
                            },
                            {
                                "example_id": "2b4c8442-04b2-4869-bfcf-4c11c85b921d",
                                "sense_id": "47949dcb-fa27-393e-a4ad-cb0719dfff93",
                                "text": "Seit etwa 1850 brachten Luftmassen aus den wachsenden Industriegebieten zunehmend mehr Schadstoffe wie Russ in die Arktis – das zeigen die Untersuchungen einer Wissenschaftergruppe aus den USA."
                            },
                            {
                                "example_id": "778e4689-8995-4ff6-afd6-91848e1d6082",
                                "sense_id": "47949dcb-fa27-393e-a4ad-cb0719dfff93",
                                "text": "Dieser [Rauch] enthält aggressive Gase wie Kohlenmonoxid, Stickoxide und Aldehyde sowie Russ und andere partikuläre Substanzen, die zu einer Schädigung der Atemwege führen können."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
