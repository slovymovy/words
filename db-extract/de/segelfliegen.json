                        ],
                        "form": "das Segelfliegen"
                    },
                    {
                        "form_id": "532926ff-7ada-4d40-b9e6-219f6dc43000",
                        "entry_id": "b7ac5ccb-7e22-3de7-9946-b0a6a2ed2d66",
