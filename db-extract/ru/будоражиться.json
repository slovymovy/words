                        "sense_id": "ccecf2ed-6e27-318b-b74e-0ae85045e896",
                        "entry_id": "85b856b5-57d3-386c-9dd0-82d4183090d0",
                        "glosses": [
                            "прост. волноваться, беспокоиться"
