{
    "word_family": [
        "liar",
        "lie",
        "untruthful",
        "mendacious"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a94160a9-dbfb-3d90-84e4-e9da76d2dce7",
                    "sense_definition": "The present participle and gerund of <w>lie</w>, meaning to intentionally give false information.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was caught <w>lying</w> to his parents about where he had been all night.",
                            "target_lang_translations": {
                                "ru": "Его поймали на <w>лжи</w> родителям о том, где он был всю ночь."
                            }
                        },
                        {
                            "text": "Stop <w>lying</w> to me and just tell the truth for once.",
                            "target_lang_translations": {
                                "ru": "Хватит мне <w>врать</w> и просто скажи правду хотя бы раз."
                            }
                        }
                    ],
                    "synonyms": [
                        "fibbing",
                        "prevaricating"
                    ],
                    "antonyms": [
                        "truth-telling"
                    ],
                    "common_phrases": [
                        "stop lying",
                        "caught lying"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «лгать», означающее намеренное предоставление ложной информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лгать",
                                "target_lang_sense_clarification": "говорить неправду"
                            },
                            {
                                "target_lang_word": "врать",
                                "target_lang_sense_clarification": "разговорный вариант"
                            },
                            {
                                "target_lang_word": "обманывать",
                                "target_lang_sense_clarification": "вводить в заблуждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "785f47c2-57fa-3a53-842d-fb1afca3d7f6",
                    "sense_definition": "The present participle and gerund of <w>lie</w>, meaning to rest in a horizontal position.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat is <w>lying</w> down on the sofa in the sun.",
                            "target_lang_translations": {
                                "ru": "Кошка <w>лежит</w> на диване на солнышке."
                            }
                        },
                        {
                            "text": "I spent the whole afternoon <w>lying</w> in bed reading a book.",
                            "target_lang_translations": {
                                "ru": "Я провел весь день, <w>лежа</w> в постели и читая книгу."
                            }
                        }
                    ],
                    "synonyms": [
                        "resting",
                        "reclining"
                    ],
                    "antonyms": [
                        "standing",
                        "sitting"
                    ],
                    "common_phrases": [
                        "lying down",
                        "lying in bed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «лежать», означающее нахождение в горизонтальном положении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лежать",
                                "target_lang_sense_clarification": "находиться в горизонтальном положении"
                            },
                            {
                                "target_lang_word": "валяться",
                                "target_lang_sense_clarification": "небрежно или долго лежать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43cd9194-4560-3a74-b05f-75daec3f4de7",
                    "sense_definition": "The act of telling a lie or the practice of being untruthful.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant <w>lying</w> eventually destroyed the trust in their relationship.",
                            "target_lang_translations": {
                                "ru": "Его постоянная <w>ложь</w> в конце концов разрушила доверие в их отношениях."
                            }
                        },
                        {
                            "text": "The politician was criticized for his habitual <w>lying</w> during the campaign.",
                            "target_lang_translations": {
                                "ru": "Политика критиковали за его привычное <w>вранье</w> во время кампании."
                            }
                        }
                    ],
                    "synonyms": [
                        "deceit",
                        "mendacity",
                        "falsehood"
                    ],
                    "antonyms": [
                        "honesty",
                        "truthfulness"
                    ],
                    "common_phrases": [
                        "habitual lying",
                        "pathological lying"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт произнесения лжи или практика нечестности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ложь",
                                "target_lang_sense_clarification": "как явление или действие"
                            },
                            {
                                "target_lang_word": "вранье",
                                "target_lang_sense_clarification": "разговорное обозначение процесса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d517304-51ee-31a6-b324-df7a47df7645",
                    "sense_definition": "The act of remaining low to the ground or staying in a hidden, horizontal position.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers were <w>lying</w> in wait for the enemy to pass through the valley.",
                            "target_lang_translations": {
                                "ru": "Солдаты <w>поджидали в засаде</w>, когда враг пройдет через долину."
                            }
                        },
                        {
                            "text": "The <w>lying</w> in wait required great patience and absolute silence.",
                            "target_lang_translations": {
                                "ru": "<w>Нахождение в засаде</w> требовало огромного терпения и абсолютной тишины."
                            }
                        }
                    ],
                    "synonyms": [
                        "lurking"
                    ],
                    "common_phrases": [
                        "lying in wait"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по нахождению в скрытом, горизонтальном положении или низко над землей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нахождение в засаде",
                                "target_lang_sense_clarification": "скрытое ожидание"
                            },
                            {
                                "target_lang_word": "засада",
                                "target_lang_sense_clarification": "состояние ожидания в укрытии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8d3004b2-a027-3f86-a16a-c09e449c9a10",
                    "sense_definition": "Tending to tell lies; habitually untruthful or mendacious.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>lying</w> cheat who cannot be trusted with any responsibility.",
                            "target_lang_translations": {
                                "ru": "Он <w>лживый</w> обманщик, которому нельзя доверить никакую ответственность."
                            }
                        },
                        {
                            "text": "I have never met a more <w>lying</w> person in my entire life.",
                            "target_lang_translations": {
                                "ru": "Я никогда в жизни не встречал более <w>лживого</w> человека."
                            }
                        }
                    ],
                    "synonyms": [
                        "untruthful",
                        "mendacious",
                        "dishonest"
                    ],
                    "antonyms": [
                        "truthful",
                        "honest"
                    ],
                    "common_phrases": [
                        "lying eyes",
                        "lying tongue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный говорить неправду; привычно лживый или нечестный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лживый",
                                "target_lang_sense_clarification": "склонный ко лжи"
                            },
                            {
                                "target_lang_word": "врущий",
                                "target_lang_sense_clarification": "тот, кто врет в данный момент или постоянно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}