{
    "word_family": [
        "stalemate",
        "staleness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d14a5b4e-1d8b-3e50-96d7-6dde83c6ee53",
                    "sense_definition": "No longer fresh, especially in reference to food like bread or cake.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "freshness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I forgot to close the bag, and now the bread is <w>stale</w> and hard.",
                            "target_lang_translations": {
                                "ru": "Я забыл закрыть пакет, и теперь хлеб <w>чёрствый</w> и твёрдый."
                            }
                        },
                        {
                            "text": "The bakery sells <w>stale</w> bread at a discount for people who want to make croutons.",
                            "target_lang_translations": {
                                "ru": "Пекарня продает <w>несвежий</w> хлеб со скидкой для тех, кто хочет сделать сухарики."
                            }
                        }
                    ],
                    "antonyms": [
                        "fresh"
                    ],
                    "common_phrases": [
                        "stale bread",
                        "stale food",
                        "stale air"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утративший свежесть, засохший (особенно о продуктах питания, таких как хлеб или пирог)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чёрствый",
                                "target_lang_sense_clarification": "о хлебе и выпечке"
                            },
                            {
                                "target_lang_word": "несвежий",
                                "target_lang_sense_clarification": "о еде в целом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a8f83b0-2675-3b12-886c-0089aad2db55",
                    "sense_definition": "No longer new, interesting, or exciting; having lost its original impact.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He keeps telling the same <w>stale</w> joke at every single party we attend.",
                            "target_lang_translations": {
                                "ru": "Он продолжает рассказывать одну и ту же <w>бородатую</w> шутку на каждой вечеринке, которую мы посещаем."
                            }
                        },
                        {
                            "text": "The candidate's <w>stale</w> ideas failed to inspire the younger generation of voters.",
                            "target_lang_translations": {
                                "ru": "<w>Устаревшие</w> идеи кандидата не смогли вдохновить молодое поколение избирателей."
                            }
                        }
                    ],
                    "synonyms": [
                        "hackneyed"
                    ],
                    "antonyms": [
                        "fresh"
                    ],
                    "common_phrases": [
                        "stale joke",
                        "stale news",
                        "stale ideas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утративший новизну, оригинальность или привлекательность; избитый, неоригинальный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "избитый",
                                "target_lang_sense_clarification": "о шутках, фразах, темах"
                            },
                            {
                                "target_lang_word": "банальный",
                                "target_lang_sense_clarification": "о мыслях, идеях"
                            },
                            {
                                "target_lang_word": "бородатый",
                                "target_lang_sense_clarification": "разг., о шутках или анекдотах"
                            },
                            {
                                "target_lang_word": "устаревший",
                                "target_lang_sense_clarification": "об идеях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9b5c629-9df5-357b-9113-d7e46d58c02f",
                    "sense_definition": "Of data or information: out of date or not synchronized with the latest version.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "data",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The application crashed because it was trying to process <w>stale</w> data from the cache.",
                            "target_lang_translations": {
                                "ru": "Приложение аварийно завершило работу, потому что пыталось обработать <w>устаревшие</w> данные из кэша."
                            }
                        },
                        {
                            "text": "You need to refresh the page to avoid seeing <w>stale</w> information on the dashboard.",
                            "target_lang_translations": {
                                "ru": "Вам нужно обновить страницу, чтобы не видеть <w>неактуальную</w> информацию на панели управления."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stale data",
                        "stale cache"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревший, неактуальный или несинхронизированный с последней версией (о данных или информации)."
