                                    {
                                        "sense_id": "4cfececd-c384-327c-9e2f-33baa5446dc4",
                                        "entry_id": "5f7cd7ab-48e1-3da7-a87d-8d68ac18b13a",
                                        "glosses": [
                                            "durch Druckluft ausgeübt, mit Druckluft arbeitend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97362fcb-7a04-4b98-8506-889246baf0a6",
                                                "sense_id": "4cfececd-c384-327c-9e2f-33baa5446dc4",
                                                "text": "„Die pneumatische Bremse wirkte auf alle Räder und wurde durch eine Federspeicher-Feststellbremse und eine Motorbremse ergänzt.“"
                                            },
                                            {
                                                "example_id": "34323ab2-c994-4797-8d56-66ecb9f986bb",
                                                "sense_id": "4cfececd-c384-327c-9e2f-33baa5446dc4",
                                                "text": "übertragen: „Wir schwebten im unendlichen Blau, während sich Tanya Wardanis neue pneumatische Brüste gegen meine Oberschenkel drückten, ihre Brustwarzen über meine schlüpfrige Haut auf und ab glitten, ihr Mund saugte und ihre Finger pumpten.“"
                                            },
                                            {
                                                "example_id": "79989398-10a7-4678-925d-adc561c91595",
                                                "sense_id": "4cfececd-c384-327c-9e2f-33baa5446dc4",
                                                "text": "übertragen: „»Diese Frau ist der wandelnde Beweis, dass man nicht nur pneumatische Brüste und seidene Schenkel braucht, um eine Liebesgöttin zu sein«, flüsterte Shelly gehässig, während ihr immer noch Salzwasser aus der Nase lief.“"
                                            },
                                            {
                                                "example_id": "5bdd2dc6-54ff-42db-9716-cab093490b24",
                                                "sense_id": "4cfececd-c384-327c-9e2f-33baa5446dc4",
                                                "text": "übertragen: „Mit den 1990er Jahren, als Hollywood die Ästhetik der Videospiele übernommen hat, wurde ein Wechsel vollzogen, der Frauen als pneumatischen Superheldinnen nach Comicvorlagen vorführte, als Androide mit signalstarken Busen ohne psychische Komplexität, die für eine andere Erotik steht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
