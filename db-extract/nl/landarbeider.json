                "senses": [
                    {
                        "sense_id": "80e08623-9b3a-3e2e-83da-d40c9dcc8ac2",
                        "entry_id": "bef5d36b-567f-3994-ab5d-47983df64c56",
                        "glosses": [
                            "een (ongeschoolde) boerenknecht"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "0c3f4655-6433-4e77-8458-ff5f613fcea0",
                                "sense_id": "80e08623-9b3a-3e2e-83da-d40c9dcc8ac2",
                                "text": "De bus kantelde op de rechterkant. De inzittenden waren vrijwel allemaal Roemeense vrouwen die als landarbeiders werkten bij het binnenhalen van de oogst."
                            },
                            {
                                "example_id": "4967b0e6-953c-4bfe-935f-ef985e13282c",
                                "sense_id": "80e08623-9b3a-3e2e-83da-d40c9dcc8ac2",
                                "text": "Op de boerderij Lesbury werd Smart donderdag met open armen ontvangen door zijn voormalige landarbeiders, maar ook door oorlogsveteranen en lokale politici - zijn voormalige politieke vijanden."
                            },
                            {
                                "example_id": "2f113e64-3a4e-4d9a-8798-cd3db8d48d94",
                                "sense_id": "80e08623-9b3a-3e2e-83da-d40c9dcc8ac2",
                                "text": "De collectie bleek nog veel rijker dan hij wist. Er zat een ongeopende envelop tussen, verzonden vanuit Ierland in 1843. Daarin zat een brief geschreven door een landarbeider aan zijn vrouw, Mary Walsh, die gevangen zat in de gevreesde Tasmaanse vrouwenkolonie op Van Diemensland."
                            }
                        ]
                    }
                ],
