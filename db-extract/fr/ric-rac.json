                "senses": [
                    {
                        "sense_id": "52e245e6-f19f-3d5b-9674-59b1b8c0c144",
                        "entry_id": "abc3980f-95ba-3d60-910c-47bc12a1b0fc",
                        "glosses": [
                            "Exactement, ni plus ni moins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9788169f-e0f0-43c8-a14a-c50e4161f57b",
                                "sense_id": "52e245e6-f19f-3d5b-9674-59b1b8c0c144",
                                "text": "Il m’a payé mes cent euros ric-rac."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6c3d22c-7a83-3247-9290-efb430b6b471",
                        "entry_id": "abc3980f-95ba-3d60-910c-47bc12a1b0fc",
                        "glosses": [
                            "Un peu juste, plutôt moins que plus. Particulièrement financièrement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d9f3c39-9dff-478f-bde4-f69bad5ffee1",
                                "sense_id": "f6c3d22c-7a83-3247-9290-efb430b6b471",
                                "text": "Quant à moi, je gagnais à peu près le double d’elle, mais on restait ric-rac, et j’étais obligé de travailler plus pour gagner plus, comme dirait l’autre. On n’avait pas envie de vivre comme ça, avec toujours l’inquiétude de manquer."
                            },
                            {
                                "example_id": "8c02f806-04f4-4ec8-90ca-1b7353fcd394",
                                "sense_id": "f6c3d22c-7a83-3247-9290-efb430b6b471",
                                "text": "Un peu plus et on se faisait attraper, c’était ric-rac."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7c36027-9cb0-4488-9a0c-cc9a665020a3",
                        "source_entry_id": "abc3980f-95ba-3d60-910c-47bc12a1b0fc",
                        "target_lang_word": "mit Ach und Krach",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mit Ach und Krach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1434ddfb-d742-3898-8ed7-d523527174d1",
                                        "entry_id": "3290b6e1-0a39-3bf6-98e9-4e36db851655",
                                        "glosses": [
                                            "mit großer Mühe, gerade noch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08cc09ac-1130-4b94-b053-8c6c54b9fbd3",
                                                "sense_id": "1434ddfb-d742-3898-8ed7-d523527174d1",
                                                "text": "Sie hat ihre Prüfung mit Ach und Krach bestanden."
                                            },
                                            {
                                                "example_id": "0ce9f505-0610-43f8-8f50-d628e99e98b1",
                                                "sense_id": "1434ddfb-d742-3898-8ed7-d523527174d1",
                                                "text": "„Doch wenn ich zurückblieb, dann würde ich immer derselbe sein. Langsam alternd, ein etwas mutiger, etwas schwächlicher, etwas unzuverlässiger Bursche, der höchstens mit Ach und Krach, ohne daß es die anderen auch nur gewahr würden, etwas mutiger werden könnte, etwas weniger schwächlich und ein klein wenig zuverlässiger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08004127-3d71-41e0-9ef9-c78ab627239c",
