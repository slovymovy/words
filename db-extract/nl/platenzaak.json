                "senses": [
                    {
                        "sense_id": "d6d8e13c-4876-3011-a771-bb5e436adbf9",
                        "entry_id": "023cc7f8-0f91-3007-8186-15cebdc25d4b",
                        "glosses": [
                            "winkel waar men grammofoonplaten, cd's of andere geluidsdragers kan kopen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e575002a-6bd9-4ae7-aa1f-011422a154b6",
                                "sense_id": "d6d8e13c-4876-3011-a771-bb5e436adbf9",
                                "text": "Ik snuffelde in de platenbakken van de platenzaak naar platen van de Beatles die ik nog niet in mijn verzameling heb."
                            },
                            {
                                "example_id": "28cf2c60-bb8e-40e7-ab1b-cda1b35b39a4",
                                "sense_id": "d6d8e13c-4876-3011-a771-bb5e436adbf9",
                                "text": "In de twintig jaar dat ze in Nederland woont, vond Shishani slechts één cd met Namibische muziek in een platenzaak. Dus is ze zelf de muziek van haar geboortegrond maar gaan spelen en bestuderen als musicoloog. Die analytische inslag is gelukkig niet terug te horen op haar debuut Itaala. Met een jazzy popgeluid dat continenten overstijgt, klinkt het als niets anders dat we kennen van Nederlandse bodem."
                            }
                        ]
                    }
