                ],
                "senses": [
                    {
                        "sense_id": "6f88649d-5c28-32bf-a90e-e0473bf671a2",
                        "entry_id": "a6138efd-56c1-381d-b458-9bdd66b4e6d1",
                        "glosses": [
                            "künstliche Versorgung mit Tönen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf0ebe73-c9ed-4707-b1f8-72feb0b69f1a",
                                "sense_id": "6f88649d-5c28-32bf-a90e-e0473bf671a2",
                                "text": "„Erst die Beschallung zwingt das Volk, auch innerlich anwesend zu sein und sich der Macht mit seinen Ohren zubeugen, ihr also zugehorchen.“"
                            },
                            {
                                "example_id": "13e2bf7c-647a-4464-90a3-481916b225ff",
                                "sense_id": "6f88649d-5c28-32bf-a90e-e0473bf671a2",
                                "text": "„Dabei gilt die Faustregel: Die Lärmpause sollte mindestens doppelt so lang sein wie die Beschallung zum Beispiel durch laute Musik davor.“"
                            },
                            {
                                "example_id": "a96a8997-97c6-49f3-96c8-869479056064",
                                "sense_id": "6f88649d-5c28-32bf-a90e-e0473bf671a2",
                                "text": "„Das Auftragsvolumen für die Beschallung in der Magnetschwebebahn, die in sieben Minuten direkt vom Flughafen Pudong ins Schanghaier Finanzzentrum Lujiazui führt, betrage übrigens zwei Mio. EURO.“"
                            },
                            {
                                "example_id": "ff95e504-f5a7-4797-aa0b-43d486613475",
                                "sense_id": "6f88649d-5c28-32bf-a90e-e0473bf671a2",
                                "text": "„Im Gegensatz zum Studio, in dem die Aufnahme und Wiedergabe in akustisch getrennten Räumen stattfinden, sind bei Beschallung die Lautsprecher in der gleichen akustischen Umgebung wie die zu leise Schallquelle, die verstärkt werden soll.“"
                            },
                            {
                                "example_id": "a656c13b-1902-494a-b4d3-c334163813cb",
                                "sense_id": "6f88649d-5c28-32bf-a90e-e0473bf671a2",
                                "text": "„Der öffentlichen Beschallung entnehme ich, dass wir nicht kleinmütig werden sollen, nur wegen der einen oder anderen Bedrohung, die zwischendurch kurz aufblitzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
