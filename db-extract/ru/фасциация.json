                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89d05179-f658-4027-8065-621b8a6ab219",
                                                "sense_id": "54d8b9ba-d057-369c-bb27-cdf521ec4c85",
                                                "text": "You can recognize this species of bird by the banding on the wing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f46d15f-e953-3b89-877a-127b83ab6242",
                                        "entry_id": "c436b4d9-1108-3108-a6f3-9820a6724ba8",
                                        "glosses": [
                                            "A technique used in the study of wild birds, by attaching a small, individually numbered, metal or plastic tag to their legs or wings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "298ff06d-7cca-38a6-a4e0-084273046aa5",
                                        "entry_id": "c436b4d9-1108-3108-a6f3-9820a6724ba8",
                                        "glosses": [
                                            "A division into bands or brackets."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1143598-deec-4396-9e87-de4da70637c1",
                                                "sense_id": "298ff06d-7cca-38a6-a4e0-084273046aa5",
                                                "text": "property tax banding"
                                            },
                                            {
                                                "example_id": "dbbd5e29-0f27-468e-b1f0-2c0f24f82297",
                                                "sense_id": "298ff06d-7cca-38a6-a4e0-084273046aa5",
                                                "text": "The bees’ cubital index, a method for differentiating breeds of honeybees, also confirmed they are “more of an indigenous bee” than anything else, he said, but their adaptations have made them unique and peculiar, and they have very little banding. “Supposedly, wild tree-nesting honeybees which can sustain themselves do not exist, so nobody knows what type of wild, self-sustaining honeybee is actually left in the UK.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6fb55cf-1add-3d3e-8a4e-0e0ad8f40932",
                                        "entry_id": "c436b4d9-1108-3108-a6f3-9820a6724ba8",
                                        "glosses": [
                                            "The formation of a band or brigade."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba82be57-510e-4373-a09c-6782f6e008b5",
                                                "sense_id": "a6fb55cf-1add-3d3e-8a4e-0e0ad8f40932",
                                                "text": "Was he aiding the man-redeeming movements of the day, the beautiful associations, the useful bandings together for human improvement, love and truth? No."
                                            }
                                        ]
                                    }
                                ]
                            },
