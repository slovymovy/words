                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "319791e0-2d73-3c26-a41a-7fdfbf0b3d7c",
                                        "entry_id": "bbe11ccc-4a89-3a9b-b93a-f0f90564dffb",
                                        "glosses": [
                                            "Precious metal objects that were buried or concealed by an unknown owner."
                                        ],
