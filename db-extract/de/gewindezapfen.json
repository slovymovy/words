                "senses": [
                    {
                        "sense_id": "e90c4e89-33a2-3271-8a22-1abbca0f288b",
                        "entry_id": "a5e387ac-9326-333e-a7be-d19ac31be240",
                        "glosses": [
                            "kurzer, dicker Metallstift, mit und ohne Kopf, mit teilweise durchlaufendem Gewinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b46459c-7c09-456f-aae3-e008411cf648",
                                "sense_id": "e90c4e89-33a2-3271-8a22-1abbca0f288b",
                                "text": "Es gibt unterschiedliche Normen die einen Gewindezapfen beschreiben. Laut Norm: DIN 609 Sechskant-Passschrauben mit langem Gewindezapfen.; DIN 258 - Kegelstifte mit Gewindezapfen, konstanten Kegellängen, Kegel 1:50 ; DIN 71802 - Form C mit Gewindezapfen ohne Sicherungsbügel oder DIN 7977 - Kegelstift mit Gewindezapfen, Stahl"
                            },
                            {
                                "example_id": "f145fa3f-0cc7-4c9e-aaaa-83c34dfb2fa2",
                                "sense_id": "e90c4e89-33a2-3271-8a22-1abbca0f288b",
                                "text": "„Ein dritter Aspekt sind unterschiedliche Gewindezapfen in der Abschlusskappe der Ionisationsröhre, die je nach Hersteller Metrisch M5 oder M6 sein können“"
                            },
                            {
                                "example_id": "e43a2213-1a1b-445b-8784-7674b7e6fbf7",
                                "sense_id": "e90c4e89-33a2-3271-8a22-1abbca0f288b",
                                "text": "„Flachgreifer mit Gewindebuchse (Innengewinde) oder Gewindezapfen (Außengewinde) verfügen über unterschiedliche Gewindegrößen (M3-M8).“"
                            },
                            {
                                "example_id": "f02ceb97-5f95-408f-a9a2-60fc507e97b1",
                                "sense_id": "e90c4e89-33a2-3271-8a22-1abbca0f288b",
                                "text": "„Die Norm-Entwürfe E DIN 258, Kegelstifte mit Gewindezapfen und konstanten Kegellängen, E DIN 1445, Bolzen mit Kopf und Gewindezapfen und E DIN 1469, Passkerbstifte mit Hals wurden im Rahmen einer Webkonferenz beraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
