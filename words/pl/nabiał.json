                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молочные продукты",
                                "target_lang_sense_clarification": "молоко, творог, сыры и др."
                            },
                            {
                                "target_lang_word": "молочка",
                                "target_lang_sense_clarification": "разговорное обозначение молочной продукции"
                            }
