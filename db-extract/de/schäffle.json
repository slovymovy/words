                "senses": [
                    {
                        "sense_id": "07e03a39-4ad5-3628-91ff-09d1355fccec",
                        "entry_id": "37ed99f6-75a6-3e77-9d98-fed235383201",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d28cdbbd-a62f-47e7-a3ac-0848ac1150fb",
                                "sense_id": "07e03a39-4ad5-3628-91ff-09d1355fccec",
                                "text": "Frau Schäffle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2e85df3e-6487-4bc3-850c-d188f7fe1024",
                                "sense_id": "07e03a39-4ad5-3628-91ff-09d1355fccec",
                                "text": "Herr Schäffle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1802f1ba-96b4-46c4-b61f-6dc02347938f",
                                "sense_id": "07e03a39-4ad5-3628-91ff-09d1355fccec",
                                "text": "Die Schäffles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5bf42c1b-17c1-4f7e-bb3f-a1fc09ecfb75",
                                "sense_id": "07e03a39-4ad5-3628-91ff-09d1355fccec",
                                "text": "Der Schäffle trägt nie die Schals, die die Schäffle ihm strickt."
                            },
                            {
                                "example_id": "c256d11d-17bd-4501-93b8-9e53c6c835b2",
                                "sense_id": "07e03a39-4ad5-3628-91ff-09d1355fccec",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schäffle kommt, geht der Herr Schäffle.“"
                            },
                            {
                                "example_id": "014a3c81-a9d6-40aa-9040-28661543119c",
                                "sense_id": "07e03a39-4ad5-3628-91ff-09d1355fccec",
                                "text": "Schäffle kommt und geht."
                            },
                            {
                                "example_id": "49c15b9c-2478-4737-a35f-b4acf6b0b3dd",
                                "sense_id": "07e03a39-4ad5-3628-91ff-09d1355fccec",
                                "text": "Schäffles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
