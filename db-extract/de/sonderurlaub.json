                "senses": [
                    {
                        "sense_id": "8e97ccd6-1760-3469-a636-7da8cf10ad15",
                        "entry_id": "eee4517c-588d-3a24-8484-5a3ddb741e51",
                        "glosses": [
                            "zu besonderen Anlässen gewährter Urlaub"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7b60626-3216-423b-af83-a24d9ebd3233",
                                "sense_id": "8e97ccd6-1760-3469-a636-7da8cf10ad15",
                                "text": "„Er stellte ihm baldigen Sonderurlaub in Aussicht und bot sich, wenn es sein Dienst erlaube, sogar als Trauzeuge an.“"
                            },
                            {
                                "example_id": "48e37f90-78b3-41e0-ae46-bcfcdd43cbdc",
                                "sense_id": "8e97ccd6-1760-3469-a636-7da8cf10ad15",
                                "text": "„Er wird auf Sonderurlaub geschickt, mit pommerschem Schinken und mit Würsten versehen fürs Brautkleid aus weißen Spitzen samt Schleier bringt er die schönste Friedensware mit, die sich nur denken läßt“"
                            },
                            {
                                "example_id": "ccb5b2d7-9854-4788-bc57-d26dbc8289f6",
                                "sense_id": "8e97ccd6-1760-3469-a636-7da8cf10ad15",
                                "text": "„Kiesewetter stellte uns weiter in Aussicht, daß durchaus für uns ein paar Tage Sonderurlaub herausspringen könnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
