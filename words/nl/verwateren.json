{
    "word_family": [
        "water",
        "waterig",
        "verwatering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2355082-66db-346c-9398-e5b9c63ba7a6",
                    "sense_definition": "het proces waarbij iets aan kracht, intensiteit of betekenis verliest",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verlies van kwaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kwaliteit van het onderwijs is de laatste jaren helaas flink <w>verwaterd</w>.",
                            "target_lang_translations": {
                                "en": "The quality of education has unfortunately <w>deteriorated</w> significantly in recent years."
                            }
                        },
                        {
                            "text": "Oude vriendschappen kunnen na verloop van tijd <w>verwateren</w> als je elkaar niet meer ziet.",
                            "target_lang_translations": {
                                "en": "Old friendships can <w>fade away</w> over time if you no longer see each other."
                            }
                        }
                    ],
                    "synonyms": [
                        "verflauwen",
                        "verslappen"
                    ],
                    "antonyms": [
                        "versterken",
                        "intensiveren"
                    ],
                    "common_phrases": [
                        "vriendschappen die verwateren",
                        "een verwaterd compromis"
                    ],
                    "target_lang_definitions": {
                        "en": "the process by which something loses strength, intensity, or meaning over time"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to fade",
                                "target_lang_sense_clarification": "of relationships or interest"
                            },
                            {
                                "target_lang_word": "to drift apart",
                                "target_lang_sense_clarification": "of friendships"
                            },
                            {
                                "target_lang_word": "to deteriorate",
                                "target_lang_sense_clarification": "of quality or standards"
                            },
                            {
                                "target_lang_word": "to wane",
                                "target_lang_sense_clarification": "of intensity or influence"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d58edef6-9911-301a-9da5-868afd9d54d4",
                    "sense_definition": "iets minder scherp, duidelijk of belangrijk maken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verlies van kwaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politicus probeerde de kritiek te <w>verwateren</w> door over andere onderwerpen te praten.",
                            "target_lang_translations": {
                                "en": "The politician tried to <w>water down</w> the criticism by talking about other subjects."
                            }
                        },
                        {
                            "text": "Het oorspronkelijke plan werd door alle aanpassingen volledig <w>verwaterd</w>.",
                            "target_lang_translations": {
                                "en": "The original plan was completely <w>diluted</w> by all the adjustments."
                            }
                        }
                    ],
                    "synonyms": [
                        "verflauwen",
                        "verwaarlozen"
                    ],
                    "antonyms": [
                        "aanscherpen"
                    ],
                    "common_phrases": [
                        "het vraagstuk verwateren"
                    ],
                    "target_lang_definitions": {
                        "en": "to make something less sharp, clear, or important; to dilute the impact of something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to water down",
                                "target_lang_sense_clarification": "to make a plan or statement less forceful"
                            },
                            {
                                "target_lang_word": "to dilute",
                                "target_lang_sense_clarification": "to weaken the strength or effect of something"
                            },
                            {
                                "target_lang_word": "to thin out",
                                "target_lang_sense_clarification": "to make less concentrated or intense"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e4b2007-cbeb-30a3-9b2a-f74a21035a02",
                    "sense_definition": "schelpdieren in schoon water leggen om zand en onzuiverheden te verwijderen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "visserij",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vissers moeten de mosselen eerst <w>verwateren</w> voordat ze verkocht mogen worden.",
                            "target_lang_translations": {
                                "en": "Fishermen must first <w>purge</w> the mussels before they can be sold."
                            }
                        },
                        {
                            "text": "Je mag in de Oosterschelde alleen mosselen <w>verwateren</w> die uit eenzelfde biologische omgeving komen.",
                            "target_lang_translations": {
                                "en": "In the Eastern Scheldt, you are only allowed to <w>soak</w> mussels that come from the same biological environment."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mosselen verwateren"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "visserijterm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to place shellfish in clean water to remove sand and impurities"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to purge",
                                "target_lang_sense_clarification": "removing sand/impurities from shellfish"
                            },
                            {
                                "target_lang_word": "to soak",
                                "target_lang_sense_clarification": "cleaning shellfish in water"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}