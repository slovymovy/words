                        "examples": [
                            {
                                "example_id": "c2714846-4e05-46c4-b9f9-fabc20d8820b",
                                "sense_id": "57ef25b2-e4a8-33e9-8f77-c57a9ae0ab9e",
                                "text": "And mad'st it pregnant: what in me is dark\nIllumine, what is low raise and support;"
