                "senses": [
                    {
                        "sense_id": "f6b2ead3-ea4a-3061-bfc7-799a05bf21ac",
                        "entry_id": "71c1bde6-37b5-3849-9c30-8c1ecf5fcc2c",
                        "glosses": [
                            "A house or shed for storing (chopped) wood"
                        ],
                        "tags": [
                            "Texas"
                        ],
                        "examples": [
                            {
                                "example_id": "1f1de836-6fba-4b92-91a5-24ce02fd2a4a",
                                "sense_id": "f6b2ead3-ea4a-3061-bfc7-799a05bf21ac",
                                "text": "The ceiling is covered with paintings of scriptural subjects, which still remain, notwithstanding that the building is now desecrated, and used as a woodhouse by the neighboring farmer."
                            },
                            {
                                "example_id": "b84b5d30-879f-409c-9e84-860742e872f0",
                                "sense_id": "f6b2ead3-ea4a-3061-bfc7-799a05bf21ac",
                                "text": "I felt awfully poor, and a stranger, and this was a beginning for me at any rate, so I went to work with a will and never lost a minute of daylight till I had split up all the wood and filled his woodhouse completely up."
                            },
                            {
                                "example_id": "4f157489-446d-4aa2-85df-9b8408cee3ac",
                                "sense_id": "f6b2ead3-ea4a-3061-bfc7-799a05bf21ac",
                                "text": "Now this door, which had been left ajar by Polly when she ran off, opened into a little courtyard where the fowls were shut in at night; the woodhouse and the privy also stood there."
                            }
                        ]
                    }
                ],
