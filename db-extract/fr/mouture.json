                        "sense_id": "3d01fc60-5491-3422-91e8-58201c750d5f",
                        "entry_id": "04bc565b-91d0-3022-bd52-574885a28dfd",
                        "glosses": [
                            "Action de moudre du blé, mais aussi d’autres grains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "683c4e0a-f3d3-4ceb-8b43-09c791a64f6c",
                                "sense_id": "3d01fc60-5491-3422-91e8-58201c750d5f",
                                "text": "De nos jours, on a appliqué les machines à vapeur à la mouture du blé comme à toutes les autres industries."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e518cc3-d342-3079-93de-acc60ddfecb9",
                        "entry_id": "04bc565b-91d0-3022-bd52-574885a28dfd",
                        "glosses": [
                            "Prix payé au meunier pour cette opération."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "236b3595-13e5-3e3f-b99b-ecaf4cf8deb8",
                        "entry_id": "04bc565b-91d0-3022-bd52-574885a28dfd",
                        "glosses": [
                            "Mélange du froment, du seigle et de l’orge, par tiers."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8bba92c8-4a8e-4e7d-8aea-e118d3c5250c",
                                "sense_id": "236b3595-13e5-3e3f-b99b-ecaf4cf8deb8",
                                "text": "On ne saurait tirer une bonne mouture d’un mauvais sac."
                            }
                        ]
                    },
                    {
                        "sense_id": "765bfb43-280c-3c75-833e-383c7d71b3ab",
                        "entry_id": "04bc565b-91d0-3022-bd52-574885a28dfd",
                        "glosses": [
                            "Version, en parlant d’un texte."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4479b77b-f568-477c-982f-70ddf6e24004",
                                "sense_id": "765bfb43-280c-3c75-833e-383c7d71b3ab",
                                "text": "«Donc, tant et aussi longtemps que la mouture finale de la loi avec toute la réglementation incluse à chacun des articles touchés ne sera pas disponible, les utilisateurs ne doivent pas changer leurs habitudes de pratique», de conclure M. Gagnon."
                            },
                            {
                                "example_id": "bdc0f868-f1a0-4c28-b038-df89d1d4ed4d",
                                "sense_id": "765bfb43-280c-3c75-833e-383c7d71b3ab",
                                "text": "Ce n’est pas une œuvre originale, ce n’est qu’une seconde mouture."
                            }
                        ]
                    }
