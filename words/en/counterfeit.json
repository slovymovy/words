                    "sense_definition": "That which resembles another thing; a portrait, likeness, or counterpart.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painter produced a striking <w>counterfeit</w> of the royal visage.",
                            "target_lang_translations": {
                                "ru": "Художник создал поразительно точный <w>портрет</w> королевской особы.",
                                "nl": "De schilder maakte een treffend <w>evenbeeld</w> van het koninklijke gelaat."
                            }
