                "senses": [
                    {
                        "sense_id": "dd857b2c-d712-334a-b8a9-9a2dbb0f630c",
                        "entry_id": "6f1b208e-14c4-385c-a44c-5585835a88d7",
                        "glosses": [
                            "das Bepflanzen beziehungsweise das Versehen mit Pflanzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cfad694-f193-4fa8-a10a-6cb94055a0d0",
                                "sense_id": "dd857b2c-d712-334a-b8a9-9a2dbb0f630c",
                                "text": "„[…] Überdies sind eine Bepflanzung und eine Beleuchtung des Kreisels vorgesehen.“"
                            },
                            {
                                "example_id": "41f03c62-f3e0-4965-b5b4-d1534f1c1ac7",
                                "sense_id": "dd857b2c-d712-334a-b8a9-9a2dbb0f630c",
                                "text": "„Warum wurde ausgerechnet an dieser menschenleeren und unzugänglichen Stelle der Stadt so viel in die Bepflanzung und Gestaltung eines Mittelstreifens investiert?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2b8f53c9-1e24-30dc-b130-e2266ae8b845",
                        "entry_id": "6f1b208e-14c4-385c-a44c-5585835a88d7",
                        "glosses": [
                            "die Gesamtheit von Blumen, Sträucher, Bäumen oder Ähnlichem, die an einem bestimmten Ort gepflanzt worden sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9364974-93be-4618-98d5-3d1716805463",
                                "sense_id": "2b8f53c9-1e24-30dc-b130-e2266ae8b845",
                                "text": "„Nicht nur die Straße wird saniert, neu gepflastert und in eine Kunst und Flaniermeile umgestaltet, sondern auch die Bepflanzung ändert sich.“"
                            },
                            {
                                "example_id": "27672d1c-b736-4db4-bda0-c15c4bf68b06",
                                "sense_id": "2b8f53c9-1e24-30dc-b130-e2266ae8b845",
                                "text": "„Die Abteilung wirkt sehr aufgeräumt, wahrscheinlich werden Bepflanzung und Pflege von der Kriegsgräberfürsorge bezahlt und unterhalten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
