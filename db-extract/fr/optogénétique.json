                    }
                ],
                "senses": [
                    {
                        "sense_id": "3ada225a-717e-3826-8cf4-aad3f2c3d360",
                        "entry_id": "d6f03539-0b33-399b-a935-471ebe11711c",
                        "glosses": [
                            "Relatif à l’optogénétique, ou à la fois optique et génétique."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "1cb1de5e-74ae-4f2e-9e45-c62124f6e5e4",
                                "sense_id": "3ada225a-717e-3826-8cf4-aad3f2c3d360",
                                "text": "Ce modèle sera ensuite développé pour relier le greffon neural à un pacemaker optique ex vivo afin d’imposer un rythme inspiratoire optogénétique sur le muscle du diaphragme."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a03a478c-d9db-33b8-8825-90666cf22cfb",
                "word": "optogénétique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3ea193ab-9a20-400b-b8c7-6c31a6844808",
                        "entry_id": "a03a478c-d9db-33b8-8825-90666cf22cfb",
                        "tags": [
                            "plural"
                        ],
                        "form": "optogénétiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd0fbd3d-c5ae-32b5-b6dc-35dc646e0ff3",
                        "entry_id": "a03a478c-d9db-33b8-8825-90666cf22cfb",
                        "glosses": [
                            "Technique qui consiste à rendre des cellules photosensibles par génie génétique afin d’en étudier l’activité en les exposant à une lumière de longueur d’onde appropriée."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "563a120f-f2d3-40e4-ac8d-00a399b07eb5",
                                "sense_id": "fd0fbd3d-c5ae-32b5-b6dc-35dc646e0ff3",
                                "text": "L’étude a été menée sur des souris génétiquement modifiées par une technique appelée optogénétique, de sorte qu’un groupe particulier de cellules nerveuses dans le cerveau puisse être stimulé en utilisant la lumière."
                            },
                            {
                                "example_id": "7cbccb26-ae9e-470c-b661-c8eeb6dffaee",
                                "sense_id": "fd0fbd3d-c5ae-32b5-b6dc-35dc646e0ff3",
                                "text": "Asya Rolls et son équipe, de l’université de Stanford, ont mené une étude sur des souris en utilisant l’optogénétique, une technique consistant à modifier certaines cellules de telle sorte qu’elles puissent être contrôlées par la lumière."
                            },
                            {
                                "example_id": "b57433e0-7a35-48b0-b78c-22f2d8f73ccc",
                                "sense_id": "fd0fbd3d-c5ae-32b5-b6dc-35dc646e0ff3",
                                "text": "Mais, de l’avis de tous, l’optogénétique permettra certainement de faire des avancées lumineuses vers ce rêve de scientifique."
                            },
                            {
                                "example_id": "3e59e141-46f8-46bc-b02f-3d98b16180b2",
                                "sense_id": "fd0fbd3d-c5ae-32b5-b6dc-35dc646e0ff3",
                                "text": "Mais le ver, animal transparent composé ni plus ni moins de 959 cellules dont 302 neurones, a fourni un outil parfait pour tenter de rendre l’optogénétique bien plus précise qu’elle ne l’était auparavant."
                            },
                            {
                                "example_id": "b74e3aab-41cc-4bb9-bd40-1c5837955689",
                                "sense_id": "fd0fbd3d-c5ae-32b5-b6dc-35dc646e0ff3",
                                "text": "De plus, ces résultats démontrent que la technique d’optogénétique réserve bien des applications, certainement aussi bonnes que mauvaises."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb8622ab-7e3b-4114-ba16-a39f950cd814",
                        "source_entry_id": "a03a478c-d9db-33b8-8825-90666cf22cfb",
                        "source_sense_id": "fd0fbd3d-c5ae-32b5-b6dc-35dc646e0ff3",
