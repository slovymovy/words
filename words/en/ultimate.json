                            {
                                "target_lang_word": "первоначальный",
                                "target_lang_sense_clarification": "исходный, основной"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "temel",
                                "target_lang_sense_clarification": "bir şeyin dayandığı esas"
