                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e507449a-409e-433a-8ffe-6fb7b9b83142",
                                                "sense_id": "e3e760b1-b042-3bdc-8eed-8db5c164fb3a",
                                                "text": "Chodím do deváté třídy, ale kamarády mám mezi šesťáky a páťáky."
                                            },
                                            {
                                                "example_id": "6d49b00a-e75c-4b15-a1ca-82234bdbaea1",
                                                "sense_id": "e3e760b1-b042-3bdc-8eed-8db5c164fb3a",
                                                "text": "Brácha mi byl zároveň i nejlepším kamarádem."
                                            },
                                            {
                                                "example_id": "e2df6ca7-0629-4cdc-9fca-2e2446860eb8",
                                                "sense_id": "e3e760b1-b042-3bdc-8eed-8db5c164fb3a",
                                                "text": "Vždycky jsme bývali nejlepšími kamarády."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3266c07-77b2-37df-9c24-e80048e83bc6",
