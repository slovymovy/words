                        "cross_references": [
                            {
                                "target_word": "asexual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f52ecf78-c000-3af7-8c33-25d14ef79ccb",
                                        "entry_id": "779d0876-288c-3669-b63a-68f9a017cbee",
                                        "glosses": [
                                            "Nonsexual in nature, unmarked by sexual activity."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d31e7661-99c5-49e9-9df9-ba28e007e8bc",
                                                "sense_id": "f52ecf78-c000-3af7-8c33-25d14ef79ccb",
                                                "text": "The central paradox of Linton's writing was her inability, or unwillingness, to imagine an asexual friendship between women."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a30d985-2784-3085-a58b-0e19f6d33294",
                                        "entry_id": "779d0876-288c-3669-b63a-68f9a017cbee",
                                        "glosses": [
                                            "Not experiencing sexual attraction; lacking interest in or desire for sex."
                                        ],
                                        "tags": [
                                            "especially",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09253f60-40ab-4fa3-8c9b-5bdbf371b4d9",
                                                "sense_id": "1a30d985-2784-3085-a58b-0e19f6d33294",
                                                "text": "Many asexual people experience attraction, but feel no need to act out that attraction sexually. Because they don't see a lack of sexual arousal as a problem to be corrected, asexual people focus their energy on enjoying other types of arousal and pleasure."
                                            },
                                            {
                                                "example_id": "5c111612-575a-4080-8dd6-7c572d79834e",
                                                "sense_id": "1a30d985-2784-3085-a58b-0e19f6d33294",
                                                "text": "Benoit is determined to ensure other asexual (or “ace”) people don’t feel broken or alone in a world in which lust and desire pulsate through our entire culture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edb5fbd8-c570-322c-b2b9-725b5010ccfb",
                                        "entry_id": "779d0876-288c-3669-b63a-68f9a017cbee",
                                        "glosses": [
                                            "Lacking distinct sex, lacking sexual organs."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "425e5de7-eb3a-351d-bacb-48a6ee157742",
                                        "entry_id": "779d0876-288c-3669-b63a-68f9a017cbee",
                                        "glosses": [
                                            "Without sexual action; reproducing by some other method than sex."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6484fdf8-8f8e-4cde-a0a7-890151cc4539",
                                                "sense_id": "425e5de7-eb3a-351d-bacb-48a6ee157742",
                                                "text": "asexual reproduction"
                                            },
                                            {
                                                "example_id": "780a0183-f7ed-4b6a-8f47-ba28965d49e7",
                                                "sense_id": "425e5de7-eb3a-351d-bacb-48a6ee157742",
                                                "text": "They traced the ancient lineages of two species to reveal the insects' lengthy history of asexual reproduction."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "asexual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6528e95-3a55-3c71-93e4-a2f7833b352b",
                                        "entry_id": "e3f64c18-e5b2-3e58-87dd-d3d0861b237d",
                                        "glosses": [
                                            "A species which reproduces by asexual rather than sexual reproduction, or a member of such a species."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46ad19cb-7aff-4ed8-86b7-75122a2e19fb",
                                                "sense_id": "a6528e95-3a55-3c71-93e4-a2f7833b352b",
                                                "text": "11.2 Demonstrating the Status of Long-Lived Asexuals\n… Indeed, if sex has so many advantages, then which special adaptations - if any - allow long-term survival without it? However, the main task of the research teams dealing with such putative ancient asexuals has thus far been to demonstrate that their respective groups (mainly bdelloids, darwinulids and certain lineages within orbatid mites) indeed merit the status."
                                            }
                                        ]
                                    },
                                    {
