                        "target_lang_word": "onaangenaam",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onaangenaam",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "769a4a23-4487-3c32-86ea-5c398b833c89",
                                        "entry_id": "63fddcd8-f05b-35e7-ae65-c51495c07be5",
                                        "glosses": [
                                            "een negatief gevoel oproepend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32f29cf8-a955-4a14-8c32-c5bbb520dc3a",
                                                "sense_id": "769a4a23-4487-3c32-86ea-5c398b833c89",
                                                "text": "Dit was een onaangename ervaring."
                                            },
                                            {
                                                "example_id": "e76edae8-b2b7-43c8-8096-1e9ecca03cda",
                                                "sense_id": "769a4a23-4487-3c32-86ea-5c398b833c89",
                                                "text": "Ik realiseer me dat het onaangenaam is om met iemand samen te werken of samen te leven die altijd maar haast heeft en ongeduldig is."
                                            },
                                            {
                                                "example_id": "96df9b54-2ea4-4e2f-a0ca-287fb0dbb375",
                                                "sense_id": "769a4a23-4487-3c32-86ea-5c398b833c89",
                                                "text": "Het was een mengeling van heimwee en schuldgevoel en veroorzaakte een onaangename knoop in mijn buik."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "866c922c-c7b3-4ced-b307-59f5cf4cfcd5",
                        "source_entry_id": "9714cf6a-8855-3883-a931-bd11790e028a",
                        "source_sense_description": "(by extension) unpleasant or disagreeable",
                        "target_lang_word": "désagréable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désagréable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "175281a8-dabb-342a-9270-730f7d9cd012",
                                        "entry_id": "8cfc34f5-e081-30a1-80fb-4ad3d1d03f95",
                                        "glosses": [
                                            "Qui déplaît, de quelque manière que ce soit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9b5818f-9f99-4a0f-82eb-e4c83243f860",
                                                "sense_id": "175281a8-dabb-342a-9270-730f7d9cd012",
                                                "text": "Les œuvres de l’urban fantasy se caractérisent moins par une attention aux aspects déplaisants ou désagréables de la vie urbaine qu’aux aspects immoraux de la vie contemporaine, dans le prolongement des récits du roman noir mettant en scène les personnages du vice."
                                            },
                                            {
                                                "example_id": "f925d522-d888-45c8-853c-b3c6f885cf5d",
                                                "sense_id": "175281a8-dabb-342a-9270-730f7d9cd012",
                                                "text": "L’opération de pourrissage qu’on appelle également schappage, offre le gros inconvénient de dégager une forte odeur forte, désagréable et tellement accentuée qu’elle se distingue à plus d’un kilomètre des usines."
                                            },
                                            {
                                                "example_id": "c286b977-b5db-4fe9-8a30-8469e1188312",
                                                "sense_id": "175281a8-dabb-342a-9270-730f7d9cd012",
                                                "text": "Elle ne salait les mets qu'après la cuisson, bien qu’elle sût à quel point la fadeur lui en était désagréable."
                                            }
                                        ]
                                    }
                                ]
                            }
