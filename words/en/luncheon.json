                {
                    "sense_id": "026e759f-a445-345d-a129-def33852aad6",
                    "sense_definition": "A midday meal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Have you already had your <w>luncheon</w> today?",
                            "target_lang_translations": {
                                "nl": "Heb je vandaag al <w>geluncht</w>?",
                                "pl": "Czy jadłeś już dzisiaj swój <w>lunch</w>?"
                            }
                        },
                        {
                            "text": "We decided to meet for a quick <w>luncheon</w> at the park.",
                            "target_lang_translations": {
                                "nl": "We besloten om af te spreken voor een snelle <w>lunch</w> in het park.",
                                "pl": "Zdecydowaliśmy się spotkać na szybki <w>lunch</w> w parku."
                            }
                        }
                    ],
                    "synonyms": [
