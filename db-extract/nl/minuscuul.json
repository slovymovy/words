                                "sense_id": "12861264-ce09-39ff-a1f3-d9267b3426d6",
                                "text": "Het membraan laat alleen minuscule deeltjes door."
                            },
                            {
                                "example_id": "e0812a38-9bf6-4bd8-ad52-7f827ecc2644",
                                "sense_id": "12861264-ce09-39ff-a1f3-d9267b3426d6",
                                "text": "Ze droeg een bikini met een minuscuul bovenstukje."
                            },
                            {
                                "example_id": "68e2bc17-521d-4b3b-a493-9718a42b1ab2",
                                "sense_id": "12861264-ce09-39ff-a1f3-d9267b3426d6",
                                "text": "De rest van de heilige reep knaagde ik in minuscule hapjes gedurende de dag op."
                            }
                        ]
                    }
