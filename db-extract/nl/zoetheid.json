                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "c8f72a71-6a9b-48e5-821d-4e879f468cdb",
                        "entry_id": "8f1cf16c-3597-3975-a3dd-bd577020bc27",
                        "tags": [
                            "plural"
                        ],
                        "form": "zoetheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f422af29-98c9-3b04-a016-20a616daa6fd",
                        "entry_id": "8f1cf16c-3597-3975-a3dd-bd577020bc27",
                        "glosses": [
                            "de mate waarin iets zoet is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb32e518-df93-4c58-898c-f66afa6f86d2",
                                "sense_id": "f422af29-98c9-3b04-a016-20a616daa6fd",
                                "text": "Aspartaam heeft een gemiddelde zoetheid die 150-200 keer zo sterk is als de zoetkracht van gewone suiker."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4c1c778-e0da-40bb-8257-c0a63815c8ea",
                        "source_entry_id": "8f1cf16c-3597-3975-a3dd-bd577020bc27",
                        "source_sense_id": "f422af29-98c9-3b04-a016-20a616daa6fd",
                        "target_lang_word": "Süßigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Süßigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06da1a87-01a2-300a-83b7-22fa2b7504ec",
                                        "entry_id": "087dbcef-a7a1-3ed0-bc0b-2219ef95cb35",
                                        "glosses": [
                                            "Lebensmittel, das süß ist und als Naschzeug verwendet wird"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0c2c69b-5d93-45d6-b213-a18a3cc854d8",
                                                "sense_id": "06da1a87-01a2-300a-83b7-22fa2b7504ec",
                                                "text": "Zu Süßigkeiten gehören z. B. Lutscher, Schokolade, Eis und so weiter."
                                            },
                                            {
                                                "example_id": "a6ad0504-59d9-4f6e-95f3-f0719a5c1ffb",
                                                "sense_id": "06da1a87-01a2-300a-83b7-22fa2b7504ec",
                                                "text": "Man sollte nicht zu viele Süßigkeiten essen."
                                            },
                                            {
                                                "example_id": "6ec23afc-6669-486c-bbcf-3b28bc5bd632",
                                                "sense_id": "06da1a87-01a2-300a-83b7-22fa2b7504ec",
                                                "text": "„Als die Gäste kamen, erklärte Helena, sie würden einen ganz besonderen Abend bei Kerzenlicht verbringen, ohne warmes Essen, nur mit Süßigkeiten.“"
                                            },
                                            {
                                                "example_id": "366dbd2c-e789-4f05-b0a6-c9dfd40c3d69",
                                                "sense_id": "06da1a87-01a2-300a-83b7-22fa2b7504ec",
                                                "text": "„Die fuchsiafarbene Süßigkeit versetzte ihre Geschmacksnerven in Ekstase.“"
                                            },
                                            {
                                                "example_id": "0ffcb71e-cb9a-4346-8036-5a23493902bd",
                                                "sense_id": "06da1a87-01a2-300a-83b7-22fa2b7504ec",
                                                "text": "„Er stellt die Schale mit den Süßigkeiten auf den Wohnzimmertisch aus weißem Marmor und lässt sich auf das Ledersofa fallen.“"
                                            },
                                            {
                                                "example_id": "2ed6b45e-100a-40e9-954d-e3b426f79e48",
                                                "sense_id": "06da1a87-01a2-300a-83b7-22fa2b7504ec",
                                                "text": "„Ich esse gern Süßigkeiten und sehe mich daher hin und wieder gezwungen, einen Zahnarzt aufzusuchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d4f3656e-f220-3702-81b3-6718e35952b7",
                                        "entry_id": "087dbcef-a7a1-3ed0-bc0b-2219ef95cb35",
                                        "glosses": [
                                            "der Zustand, süß zu sein, eine angenehme (liebliche) Empfindung hervorrufend"
                                        ],
                                        "tags": [
                                            "kein Plural; veraltend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff520c0f-73e0-4391-8667-b89fd4fb3af0",
                                                "sense_id": "d4f3656e-f220-3702-81b3-6718e35952b7",
                                                "text": "„Die Milch ist das Symbol des ersten Aspekts der Liebe, dem der Fürsorge und Bestätigung. Der Honig symbolisiert die Süßigkeit des Lebens, die Liebe zum Leben und das Glück zu leben.“"
                                            },
                                            {
                                                "example_id": "c2f417ea-34e7-4570-88d7-34a913978374",
                                                "sense_id": "d4f3656e-f220-3702-81b3-6718e35952b7",
                                                "text": "„Die Süßigkeit der Melodien schmeichelte sich in ihr Herz und machte sie unruhig, sie wußte selbst nicht, warum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76fbbb2f-cc3d-4b5a-8589-366f61b04de9",
                        "source_entry_id": "8f1cf16c-3597-3975-a3dd-bd577020bc27",
                        "source_sense_id": "f422af29-98c9-3b04-a016-20a616daa6fd",
                        "target_lang_word": "sweetness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sweetness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07ae1cdc-7eb4-3847-9101-25567ee51503",
                                        "entry_id": "7fca62f8-1813-305e-9031-7c93b9604f0d",
                                        "glosses": [
                                            "The condition of being sweet (all senses)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a33b1db-3bae-4f07-a3a9-a5b76b5ef2cb",
                                                "sense_id": "07ae1cdc-7eb4-3847-9101-25567ee51503",
                                                "text": "At the same time, that pain is soothed by the brain’s perception of sweetness on a totally different area of your taste buds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e13a7d5d-055f-3859-83ae-14ca5b5450fa",
                                        "entry_id": "7fca62f8-1813-305e-9031-7c93b9604f0d",
                                        "glosses": [
                                            "A pleasant disposition; kindness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44687d25-04ea-46f8-881f-5392b4a506f9",
                                                "sense_id": "e13a7d5d-055f-3859-83ae-14ca5b5450fa",
                                                "text": "Ruth's overwhelming sweetness made Robert forget about his hopelessly low school grades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5294ec1f-68fe-3419-8dd6-db0deef5a2f6",
                                        "entry_id": "7fca62f8-1813-305e-9031-7c93b9604f0d",
                                        "glosses": [
                                            "The quality of giving pleasure to the mind or senses, pleasantness, agreeableness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de912810-d17f-4b66-b619-e469207b8288",
                                                "sense_id": "5294ec1f-68fe-3419-8dd6-db0deef5a2f6",
                                                "text": "The thirſt of raigne and ſweetnes of a crowne, […] / Moou’d me to menage armes againſt thy ſtate."
                                            },
                                            {
                                                "example_id": "fa6ea26f-8a55-489a-8d27-ceb72f92ef35",
                                                "sense_id": "5294ec1f-68fe-3419-8dd6-db0deef5a2f6",
                                                "text": "Quiet people too, for I think that about this time a sort of remorseful tenderness comes over the bullies and the nagsters, so that they go about gently and deprecatingly, hoping by one day's record sweetness to outface the year's blusterings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68094988-4d92-3a2e-8e54-3bfb40020850",
                                        "entry_id": "7fca62f8-1813-305e-9031-7c93b9604f0d",
                                        "glosses": [
                                            "A term of address for one's sweetheart."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b708bfbd-9dd6-482f-b9d3-b74d67b0c30a",
                                                "sense_id": "68094988-4d92-3a2e-8e54-3bfb40020850",
                                                "text": "Sweetness, sweetness, I was only joking when I said / I'd like to smash every tooth in your head."
                                            },
                                            {
                                                "example_id": "8e5608d0-d774-4e66-a0cb-fe6c10ba2ae5",
                                                "sense_id": "68094988-4d92-3a2e-8e54-3bfb40020850",
                                                "text": "\"Hey sweetness,\" he said. \"How was practice?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3795b156-1493-4098-bdf5-d0e9afa07596",
                        "source_entry_id": "8f1cf16c-3597-3975-a3dd-bd577020bc27",
                        "source_sense_id": "f422af29-98c9-3b04-a016-20a616daa6fd",
                        "target_lang_word": "douceur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "douceur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af443dda-292d-3eff-9e23-2bdf01789a08",
                                        "entry_id": "1ed1bcea-447b-354c-8dd7-fc8694479493",
                                        "glosses": [
                                            "Qualité de ce qui est doux ; la chose même qui a cette qualité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27f27401-6bd2-4aaa-b784-c33175a6ffbd",
                                                "sense_id": "af443dda-292d-3eff-9e23-2bdf01789a08",
                                                "text": "Plus fait douceur que violence."
                                            },
                                            {
                                                "example_id": "91fa7018-220e-4980-9675-f3d5dcd94b72",
                                                "sense_id": "af443dda-292d-3eff-9e23-2bdf01789a08",
                                                "text": "C'est la vallée de la Seine, le pays royal, où les routes et les forêts semblent continuer les beaux parcs, – où des oiseaux chantent toujours. C’est le commencement de l'été : on respire ; et l'on sent jusqu'au fond du cœur la douceur de la France."
                                            },
                                            {
                                                "example_id": "fcff6743-dd93-48ea-baac-641f7b1e7539",
                                                "sense_id": "af443dda-292d-3eff-9e23-2bdf01789a08",
                                                "text": "La vigogne a une toison formée de poils laineux très fins et d'une grande douceur."
                                            },
                                            {
                                                "example_id": "5b67b465-61ec-47ce-beff-99fafeac6fee",
                                                "sense_id": "af443dda-292d-3eff-9e23-2bdf01789a08",
                                                "text": "Secteur aquitanien, qui doit à la douceur de son climat d’avoir conservé beaucoup de latéméditerranéennes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d714bb79-938f-3939-9fcd-fd1cd41eb1cc",
                                        "entry_id": "1ed1bcea-447b-354c-8dd7-fc8694479493",
                                        "glosses": [
                                            "Friandises propres à flatter le goût, sucreries."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83a81adf-1418-4d78-852e-dfc7ec6069ef",
                                                "sense_id": "d714bb79-938f-3939-9fcd-fd1cd41eb1cc",
                                                "text": "Arrivée d’une somptueuse corbeille de fruits et de « douceurs » offerte par Duke Ellington. Ô merveille, ils sont aussi bons que beaux !"
                                            },
                                            {
                                                "example_id": "59f8e505-f62c-46e0-8105-796c2484d9f3",
                                                "sense_id": "d714bb79-938f-3939-9fcd-fd1cd41eb1cc",
                                                "text": "On lui glisse toujours quelques douceurs. Elle les refuse, puis finit par les accepter pour sa vieille mère : un pot de miel, une paire de grives, une hottée de pommes."
                                            },
                                            {
                                                "example_id": "c21a69c4-ca23-44e0-b53f-af1efa04e3a2",
                                                "sense_id": "d714bb79-938f-3939-9fcd-fd1cd41eb1cc",
                                                "text": "Durant ma maladie, il m’apportait chaque jour des douceurs. — Acheter des douceurs à un enfant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53698412-2e56-397d-a666-cdcde365fddc",
                                        "entry_id": "1ed1bcea-447b-354c-8dd7-fc8694479493",
                                        "glosses": [
                                            "Choses morales qui flattent l’âme, l’esprit, comme les substances douces flattent le goût."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93c36ec2-5bf4-4cb0-bc56-e2ca7e993e64",
                                                "sense_id": "53698412-2e56-397d-a666-cdcde365fddc",
                                                "text": "Les douceurs de la fortune, du succès, de la renommée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de483e3b-2361-3499-a75e-c9fe334d56da",
                                        "entry_id": "1ed1bcea-447b-354c-8dd7-fc8694479493",
                                        "glosses": [
                                            "Façon d’agir douce et éloignée de toute sorte de violence, modération."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13360315-392e-404e-95e3-21660f846a02",
                                                "sense_id": "de483e3b-2361-3499-a75e-c9fe334d56da",
                                                "text": "On concédera aux partisans de la douceur que la violence peut gêner le progrès économique et même qu'elle peut être dangereuse pour la moralité, lorsqu'elle dépasse une certaine limite."
                                            },
                                            {
                                                "example_id": "1ebd453c-9822-4765-99c0-3ab6c8f8974c",
                                                "sense_id": "de483e3b-2361-3499-a75e-c9fe334d56da",
                                                "text": "Le coffre-fort ne veut pas être brutalisé, violenté ; il faut user de douceur avec lui, le caresser longuement. Une pince-monseigneur, un chalumeau ? Allons donc. Un petit air de flûte. Le charme opère."
                                            },
                                            {
                                                "example_id": "6d23be7b-a32e-4b34-a259-1184d4b68d84",
                                                "sense_id": "de483e3b-2361-3499-a75e-c9fe334d56da",
                                                "text": "Une lueur cynique brillait dans son regard et Isabel eut un frisson involontaire quand il ajouta avec une douceur trompeuse :\n— Un tiens vaut mieux que deux tu l'auras, c'est ce qu'on dit dans votre langue, je crois. Donc, je répète : quel est votre prix ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62639022-a78e-39f0-b0c1-ce0328ff236d",
                                        "entry_id": "1ed1bcea-447b-354c-8dd7-fc8694479493",
                                        "glosses": [
                                            "Paroles aimables et particulièrement des compliments qu’un individu adresse à une autre personne pour tâcher de lui plaire, de s’en faire aimer."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a54c50c2-9f64-4690-a0f2-7f31451d2a1c",
                                                "sense_id": "62639022-a78e-39f0-b0c1-ce0328ff236d",
                                                "text": "Conter, dire des douceurs à une femme."
                                            },
                                            {
                                                "example_id": "192862ed-ca7b-4b91-b9a5-37142a63a557",
                                                "sense_id": "62639022-a78e-39f0-b0c1-ce0328ff236d",
                                                "text": "Prêter l’oreille aux douceurs des galants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a13d8d0-e88b-328e-a73e-6fb9405ce278",
                                        "entry_id": "1ed1bcea-447b-354c-8dd7-fc8694479493",
                                        "glosses": [
                                            "Température agréable, chaleur modérée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "731daf47-2eae-4d50-b05f-b6c40177e611",
                                                "sense_id": "0a13d8d0-e88b-328e-a73e-6fb9405ce278",
                                                "text": "La douceur d’une nuit d’été."
                                            },
                                            {
                                                "example_id": "81c33c2c-b524-450b-9b67-38ee12a31ec5",
                                                "sense_id": "0a13d8d0-e88b-328e-a73e-6fb9405ce278",
                                                "text": "Je songeais à la Touraine où j'avais déjà été et qui me plaisait beaucoup, tant pour la douceur du climat que pour celle des habitants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8470ce1-1e60-3055-899c-753cb50829b9",
                                        "entry_id": "1ed1bcea-447b-354c-8dd7-fc8694479493",
                                        "glosses": [
                                            "Dédommagement qu'on donne à quelqu'un pour reconnaître sa peine."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0ded0e6-1bdb-4359-9a5a-57211bba28ac",
                                                "sense_id": "b8470ce1-1e60-3055-899c-753cb50829b9",
                                                "text": "Faites cela, il y aura quelque petite douceur pour vous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a3fca3f-c8a5-39fc-a06b-7eb9156c19fe",
                                        "entry_id": "1ed1bcea-447b-354c-8dd7-fc8694479493",
                                        "glosses": [
                                            "Qualité d'un matériau à se déformer, à se fissurer sous une contrainte mécanique. (l'inverse se nomme ténacité)"
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
