                "senses": [
                    {
                        "sense_id": "6f588f4c-8bba-3e0b-a0e3-b2f3f3a8738e",
                        "entry_id": "7f9cddc2-71d7-35c8-a845-271587259d12",
                        "glosses": [
                            "op een nuttige manier ergens gebruik van maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ead9dd43-a329-4080-b9be-68259b79bba6",
                                "sense_id": "6f588f4c-8bba-3e0b-a0e3-b2f3f3a8738e",
                                "text": "Dat is allemaal al weer lang geleden, maar de dilemma's klinken vertrouwd. De pogingen in deze tijd tot utilisering en mercantilisering van het hoger onderwijs zijn waarschijnlijk niet het einde, maar pas het begin van een nieuw conflict over het idee van de universiteit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2693d2f5-701f-4f21-b17d-b7a48d0dc117",
