    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43546b86-14f7-3879-b6d6-c3c9e00e5e2a",
                    "sense_definition": "iemand die anderen voortdurend dwarsboomt, pest of lastigvalt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd jarenlang achtervolgd door zijn <w>kwelgeest</w> op de middelbare school. ",
                            "target_lang_translations": {
                                "en": "He was pursued for years by his <w>tormentor</w> in high school."
                            }
                        },
                        {
                            "text": "De voetballer bleek opnieuw de grote <w>kwelgeest</w> te zijn van het tegenstandersteam.",
                            "target_lang_translations": {
                                "en": "The footballer once again proved to be the opponent team's great <w>nemesis</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "plaaggeest",
                        "kweller"
                    ],
                    "common_phrases": [
                        "een grote kwelgeest",
                        "de oude kwelgeest"
                    ],
                    "target_lang_definitions": {
                        "en": "someone who constantly thwarts, bullies, or harasses others"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tormentor",
                                "target_lang_sense_clarification": "someone who inflicts suffering or annoyance"
                            },
                            {
                                "target_lang_word": "nemesis",
                                "target_lang_sense_clarification": "a long-standing rival or persistent obstacle"
                            },
                            {
                                "target_lang_word": "harasser",
                                "target_lang_sense_clarification": "a person who bothers or annoys continually"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d775434d-2050-3816-a9bb-de8ede585812",
                    "sense_definition": "een bovennatuurlijk of mythisch wezen dat mensen plaagt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude volksverhalen wordt gesproken over een boosaardige <w>kwelgeest</w> die 's nachts verschijnt.",
                            "target_lang_translations": {
                                "en": "In old folk tales, there is mention of a malicious <w>fiend</w> appearing at night."
                            }
                        },
                        {
                            "text": "Het dorpsverhaal ging over een onzichtbare <w>kwelgeest</w> in de bossen.",
                            "target_lang_translations": {
                                "en": "The village story was about an invisible <w>bogie</w> in the woods."
                            }
                        }
                    ],
                    "synonyms": [
                        "kwelduivel",
                        "duivel"
                    ],
                    "target_lang_definitions": {
                        "en": "a supernatural or mythical creature that torments or teases people"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "poltergeist",
                                "target_lang_sense_clarification": "a mischievous or violent spirit"
                            },
                            {
                                "target_lang_word": "bogie",
                                "target_lang_sense_clarification": "a mythical evil spirit or goblin"
                            },
                            {
                                "target_lang_word": "fiend",
                                "target_lang_sense_clarification": "an evil spirit or demon"
                            }
                        ]
                    }
                }
            ]
        }
    ]
