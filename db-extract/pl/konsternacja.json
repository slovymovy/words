                "senses": [
                    {
                        "sense_id": "de07aef4-87be-3fa2-a49c-b6e52e4bd22d",
                        "entry_id": "01a20156-4a53-3753-9c2f-560e9a3fdf21",
                        "glosses": [
                            "stan osłupienia spowodowany nieoczekiwanym zwrotem sytuacji, w której znajduje się osoba „skonsternowana”; uczucie strachu spowodowane nieprzewidywalnością dalszego przebiegu sytuacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18d6ee0d-2e6a-4d43-a537-16feaba665be",
                                "sense_id": "de07aef4-87be-3fa2-a49c-b6e52e4bd22d",
                                "text": "Wśród dostojników nastąpiła lekka konsternacja."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5bfa77d-ccb6-4a76-a262-99adecd0976c",
                        "source_entry_id": "01a20156-4a53-3753-9c2f-560e9a3fdf21",
                        "source_sense_id": "de07aef4-87be-3fa2-a49c-b6e52e4bd22d",
                        "target_lang_word": "consternation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consternation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                        "entry_id": "c953c29d-b9c5-3f61-852f-825947492f3a",
                                        "glosses": [
                                            "Amazement or horror that confounds the faculties, and incapacitates for reflection; terror, combined with amazement; dismay."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "098bfb65-8e1b-4454-bae9-e14445728e4d",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "\"Out!\" exclaimed her husband, with something like genuine consternation in his voice."
                                            },
                                            {
                                                "example_id": "602baf81-173e-4c3e-9592-ba81593c7eac",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "Their audience had been listening in increasing consternation."
                                            },
                                            {
                                                "example_id": "48b24c20-55c4-46c7-89d5-0265fe6cc51c",
                                                "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                                                "text": "It was probably worth four millennia of consternation and regret."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f67b53b-8fb3-48cc-89d3-e96bc2b01738",
                        "source_entry_id": "01a20156-4a53-3753-9c2f-560e9a3fdf21",
                        "source_sense_id": "de07aef4-87be-3fa2-a49c-b6e52e4bd22d",
                        "target_lang_word": "consternation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consternation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af8d4691-6846-37f1-bf06-bfc41401ca3f",
                                        "entry_id": "b022619c-87e3-357d-bc22-adb3f7db5477",
                                        "glosses": [
                                            "Abattement profond à la suite de quelque accident inattendu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c104d68-03d1-4122-b35f-251562b46aa4",
                                                "sense_id": "af8d4691-6846-37f1-bf06-bfc41401ca3f",
                                                "text": "Valère regardait la planche-contact avec une certaine consternation."
                                            },
                                            {
                                                "example_id": "1bbffe2d-bba3-44a1-9e86-defe4e013b87",
                                                "sense_id": "af8d4691-6846-37f1-bf06-bfc41401ca3f",
                                                "text": "Le 10 de ce mois, un triste accident a jeté la consternation dans un des quartiers de la paroisse St.-Jacques."
                                            },
                                            {
                                                "example_id": "8d18f0ee-5f93-41f5-bfb6-275d742f87d5",
                                                "sense_id": "af8d4691-6846-37f1-bf06-bfc41401ca3f",
                                                "text": "Un soir pluvieux, Corinne laissa entendre qu'elle était amoureuse. J'allais m'en montrer consterné mais je craignis que ma consternation ne prêtât à confusion et ne fût mal interprétée : il ne fallait pas qu'elle m’imaginât épris d'elle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d803509-841b-41e1-97e8-f793ca83fb59",
                        "source_entry_id": "01a20156-4a53-3753-9c2f-560e9a3fdf21",
                        "source_sense_id": "de07aef4-87be-3fa2-a49c-b6e52e4bd22d",
                        "target_lang_word": "consternación",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consternación",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "fbe43a30-658c-3019-9055-26d7570ef533",
                                        "entry_id": "5cf4721e-54a7-3823-a748-fbd60478973a",
                                        "glosses": [
                                            "Acción y efecto de consternar."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc932a79-8bc1-4237-ae94-4c0ba91445ac",
                        "source_entry_id": "01a20156-4a53-3753-9c2f-560e9a3fdf21",
                        "source_sense_id": "de07aef4-87be-3fa2-a49c-b6e52e4bd22d",
                        "target_lang_word": "Bestürzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bestürzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                        "entry_id": "9e484c61-dcc9-3eb5-8898-64cd94be0a75",
                                        "glosses": [
                                            "Gefühl zufolge einer unerwarteten schlechten Nachricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4fec8d5-2549-40dd-8a9f-1240018e1627",
                                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                                "text": "Mit tiefer Bestürzung geben wir das Ableben unserer Großmutter bekannt."
                                            },
                                            {
                                                "example_id": "0b649006-37bd-43db-ab1e-59f879df1975",
                                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                                "text": "„Aber danach hatte sie der Frau direkt ins Gesicht und in ihre Gedanken geschaut, geübt darin, die Mimik und Gestik zu lesen, keine Bestürzung wahrgenommen oder überhaupt etwas anderes als diese normale Hausfrauenmilde.“"
                                            },
                                            {
                                                "example_id": "78cc4731-8ea6-4820-a216-b58aa94e621b",
                                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                                "text": "„Ihre Bestürzung wurde so stark, daß sie das Trommeln und den Tanz der anderen unterbrechen wollte.“"
                                            },
                                            {
                                                "example_id": "90bbe320-55bb-4af8-9241-9ae2b4e2de6a",
                                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                                "text": "„Die beiden wurden der Herrschaft gemeldet, und dann war es, als sei unter der Dienerschaft des Fürsten eine gewisse Verwirrung und Bestürzung entstanden.“"
                                            },
                                            {
                                                "example_id": "4cbf5f58-71b3-4da0-9bdd-d9e2fe9b9b69",
                                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                                "text": "„Die unnennbare Angst des Kindes hatte die Anwesenden mit Verwunderung und Bestürzung erfüllt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
