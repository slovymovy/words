                                        "sense_id": "c00416a0-49b5-3875-8c90-d2c684410f05",
                                        "entry_id": "49b5a96e-890b-38f3-95f9-cdec1258dfc1",
                                        "glosses": [
                                            "Monnaie de différents États arabes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c989442-fd2f-4bde-a7cb-1e8b61936824",
                                                "sense_id": "c00416a0-49b5-3875-8c90-d2c684410f05",
                                                "text": "Place des Changeurs, voyageurs et marchands de toutes origines, andalous, grecs ou chinois, s’affairent autour des vérificateurs de monnaies qui, dignement munis de leur balance réglementaire, grattent un dinar, de Kirman, de Nichapour ou de Séville, reniflent la tanka de Delhi, soupèsent un dirham de Bouk, font la moue devant un maigre nomisma de Constantinople, nouvellement dévalué."
                                            },
                                            {
                                                "example_id": "9bd085a7-10d7-4168-ab0e-36996e40f74b",
                                                "sense_id": "c00416a0-49b5-3875-8c90-d2c684410f05",
                                                "text": "Le seikouk est un petit-lait légèrement aigre adouci de semoule de couscous vendu 1 dirham le verre par un marchand qui a harnaché sa bicyclette comme un âne d'une marmite et de deux gros bidons."
                                            },
                                            {
                                                "example_id": "2437fa2b-8f98-48ad-9e48-8519a6dd4064",
                                                "sense_id": "c00416a0-49b5-3875-8c90-d2c684410f05",
                                                "text": "Ah, mon bonhomme ! déclare, triomphante, la sage-femme, un dirham ne te suffit pas pour sortir, il t’en faut cinq."
                                            },
                                            {
                                                "example_id": "e3b00581-2b40-4bbf-9275-9c74d1e4714e",
                                                "sense_id": "c00416a0-49b5-3875-8c90-d2c684410f05",
                                                "text": "« On a eu pas mal d’annulations. Aujourd’hui, vous pouvez avoir une nuit pour 200 dirhams (20 euros) », glisse-t-il."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1f34dd4-95e0-3bfa-83a0-28db940f4ef3",
                                        "entry_id": "49b5a96e-890b-38f3-95f9-cdec1258dfc1",
                                        "glosses": [
                                            "Unité de masse utilisée durant l'Antiquité dans le Levant, équivalent du drachme grec."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e81daaa6-77e9-3547-a1f9-d59fe6d0af61",
                                        "entry_id": "49b5a96e-890b-38f3-95f9-cdec1258dfc1",
                                        "glosses": [
                                            "Monnaie antique du Levant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
