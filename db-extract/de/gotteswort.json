                "senses": [
                    {
                        "sense_id": "fb2be52c-c5da-3621-9c4b-62173a28864d",
                        "entry_id": "479d875a-bc5a-35fa-8767-e3cf122613c8",
                        "glosses": [
                            "Text, der als von Gott geäußert verstanden wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7022ee62-ccd8-4930-ba2f-93d0512e80fb",
                                "sense_id": "fb2be52c-c5da-3621-9c4b-62173a28864d",
                                "text": "„Es hätte in meiner Jugend als eine Lästerung gegolten, wenn man das Gotteswort in einem anderen Tonfall vorgetragen hätte, als es der Brauch vorschrieb.“"
                            },
                            {
                                "example_id": "66950cd8-7327-4942-9565-a1b21739530a",
                                "sense_id": "fb2be52c-c5da-3621-9c4b-62173a28864d",
                                "text": "„Für den Sufi ist, wie für jeden Muslim, das im Koran offenbarte Gotteswort Zentrum und Grundlage seines Lebens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
