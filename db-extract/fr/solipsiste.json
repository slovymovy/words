                                        "glosses": [
                                            "Of, or pertaining to, solipsism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "solipsist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2ae3379-889e-3113-a9af-fafa9993979d",
                                        "entry_id": "f61b0e26-e9ae-3a31-b935-9399e95074c8",
                                        "glosses": [
                                            "One who adheres to self-absorption and an ignorance of the views or needs of others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6f6ffd6-85c1-4287-8fd1-b270651eb81b",
                                                "sense_id": "d2ae3379-889e-3113-a9af-fafa9993979d",
                                                "text": "Some of this grandiosity is to be expected. Innovators tend to be solipsists. They often want to cram every stray fact and experience into their new model."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
