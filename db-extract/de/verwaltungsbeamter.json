                "senses": [
                    {
                        "sense_id": "47fc4167-1a7b-3738-86d4-6ba9b0de1621",
                        "entry_id": "5ce04e5c-dce4-3f11-8f01-c4221524c96a",
                        "glosses": [
                            "Beamter, der in einer Verwaltung arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "917f9df8-6678-4bf6-8902-cc040e90023d",
                                "sense_id": "47fc4167-1a7b-3738-86d4-6ba9b0de1621",
                                "text": "„Tafari lässt das Telefon- und Telegraphennetz erweitern, dessen Verwaltungsbeamte zugleich seine Augen und Ohren in den Provinzen sind.“"
                            },
                            {
                                "example_id": "cae69950-609c-4361-8015-f2ddd880639a",
                                "sense_id": "47fc4167-1a7b-3738-86d4-6ba9b0de1621",
                                "text": "„Die sizilianischen Verwaltungsbeamten wollten aber an ihren alten Gewohnheiten festhalten.“"
                            },
                            {
                                "example_id": "0477229f-57d2-4420-a52f-dccbfb116e2b",
                                "sense_id": "47fc4167-1a7b-3738-86d4-6ba9b0de1621",
                                "text": "„Jeder höhere Verwaltungsbeamte ist in ruhigen, von keinen Stürmen erschütterten Zeiten der Meinung, die ganze ihm anvertraute Bevölkerung bewege sich nur dank seinen Bemühungen, und das dieser Meinung entspringende Gefühl eigener Unentbehrlichkeit bildet für ihn den grössten Lohn seiner Mühen und Anstrengungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
