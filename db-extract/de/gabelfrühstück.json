                ],
                "senses": [
                    {
                        "sense_id": "fefb9482-1346-3a57-8b61-c72f6c0624ba",
                        "entry_id": "63af5d2c-aa49-30e4-b0e1-69e809ad9162",
                        "glosses": [
                            "reichhaltiges (zweites) Frühstück, das am späten Vormittag (zwischen 11 und 13 Uhr) bei besonderen Anlässen eingenommen wird und bei dem pikante kalte oder warme Speisen mit alkoholischen Getränken serviert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d79bca9-7531-4488-bb59-83923b937e85",
                                "sense_id": "fefb9482-1346-3a57-8b61-c72f6c0624ba",
                                "text": "„Das Schreiben wurde Kaiser Wilhelm II. am Sonntag, dem 5. Juli, vom österreichischungarischen Botschafter beim Gabelfrühstück übergeben.“"
                            },
                            {
                                "example_id": "31678f52-3186-4f03-ae55-a167536c2c72",
                                "sense_id": "fefb9482-1346-3a57-8b61-c72f6c0624ba",
                                "text": "„Dann nahm er ein Gabelfrühstück bei der Königin, wobei auch die Prinzen, seine Kinder, anwesend waren. Das Gabelfrühstück bestand aus zwei bis drei weichen Eiern nebst gebratenem Fleisch und dauerte eine Viertelstunde. [..] Nach dem Gabelfrühstück machte er im Freien Bewegung bis längstens zwei Uhr Nachmittag, zu Wagen, zu Pferde oder zu Fuß.“"
                            },
                            {
                                "example_id": "4e0d183e-6d59-4eec-9fae-ce5858e6a879",
                                "sense_id": "fefb9482-1346-3a57-8b61-c72f6c0624ba",
                                "text": "„So blieb ich noch zu einem guten Gabelfrühstück im Spital und fuhr dann mit dem Sanitätsomnibus auf den Nordwestbahnhof.“"
                            },
                            {
                                "example_id": "32ab62dc-0080-479d-9035-292b685be1d1",
                                "sense_id": "fefb9482-1346-3a57-8b61-c72f6c0624ba",
                                "text": "„Das Gabelfrühstück war für ein Uhr angesetzt, aber ich war bereits zu Mittag in Brühl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4459e878-e134-41cd-a7a1-db39a3e3fc23",
                        "source_entry_id": "63af5d2c-aa49-30e4-b0e1-69e809ad9162",
                        "source_sense_id": "fefb9482-1346-3a57-8b61-c72f6c0624ba",
                        "target_lang_word": "brunch",
