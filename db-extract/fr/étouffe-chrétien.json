                                                "sense_id": "d071de11-98fc-3b50-bff7-3ae5ae0a0188",
                                                "text": "The meal was nothing but heavy stodge with no fresh vegetables."
                                            },
                                            {
                                                "example_id": "464458bc-d1c4-4cf4-8d71-772102a5326c",
                                                "sense_id": "d071de11-98fc-3b50-bff7-3ae5ae0a0188",
                                                "text": "After weeks of bread and porridge, he longed for something other than stodge."
                                            }
                                        ]
                                    },
                                    {
