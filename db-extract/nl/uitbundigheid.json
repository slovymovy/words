                                "target_senses": [
                                    {
                                        "sense_id": "116dbf69-0b64-3c03-a8c6-5a4de4219db5",
                                        "entry_id": "e72140f2-2872-3d04-a89d-2c6adf5c109d",
                                        "glosses": [
                                            "Intensity of feeling; excited interest or eagerness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc3c1ede-581e-4696-9dd4-6787028084e2",
                                                "sense_id": "116dbf69-0b64-3c03-a8c6-5a4de4219db5",
                                                "text": "Try to curb your enthusiasm."
                                            },
                                            {
                                                "example_id": "9121d275-aa93-4ead-ba3c-863c8ac227c2",
                                                "sense_id": "116dbf69-0b64-3c03-a8c6-5a4de4219db5",
                                                "text": "They have a great enthusiasm for country music."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "635701b2-b17d-3a32-beb9-d890e6f1cc6d",
                                        "entry_id": "e72140f2-2872-3d04-a89d-2c6adf5c109d",
                                        "glosses": [
                                            "Something in which one is keenly interested."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8663a5a-7e4f-440f-9735-a0a829b8ff6b",
                                                "sense_id": "635701b2-b17d-3a32-beb9-d890e6f1cc6d",
                                                "text": "My main enthusiasm is attending and seeing the progress and interest of collectors, to meet old friends, and hopefully to make new friends."
                                            },
                                            {
                                                "example_id": "1e4e9069-9dbc-4727-ac54-77b7fa22d071",
                                                "sense_id": "635701b2-b17d-3a32-beb9-d890e6f1cc6d",
                                                "text": "Other Adamsian enthusiasms included: fast cars; restaurants; Bach, the Beatles, Pink Floyd and Dire Straits; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79a76f8c-efc9-3393-98b4-808eeb1b6ab2",
                                        "entry_id": "e72140f2-2872-3d04-a89d-2c6adf5c109d",
                                        "glosses": [
                                            "Possession by a god; divine inspiration or frenzy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c5fd621-b902-4859-9022-64924afe13fd",
                                                "sense_id": "79a76f8c-efc9-3393-98b4-808eeb1b6ab2",
                                                "text": "The intoxication that they sought was that of ‘enthusiasm’, of union with the god."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca38745b-a077-4b6f-9c57-7e6a79c2fc14",
                        "source_entry_id": "386db8b3-0afa-317b-9ed6-550d0da4bab0",
