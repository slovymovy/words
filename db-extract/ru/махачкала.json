                "senses": [
                    {
                        "sense_id": "fc8528d6-e7d7-3892-a330-4d08ec7b77b3",
                        "entry_id": "a37f4425-52c1-3962-817b-16671d21802b",
                        "glosses": [
                            "город на юге России, столица Дагестана"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9748aab-801d-4cbb-9362-dc16ec83de70",
                                "sense_id": "fc8528d6-e7d7-3892-a330-4d08ec7b77b3",
                                "text": "Махачкала кажется городом, построенным из окаменелой морской пены."
                            },
                            {
                                "example_id": "cf792958-cc6d-4247-90ac-37b2c80851c7",
                                "sense_id": "fc8528d6-e7d7-3892-a330-4d08ec7b77b3",
                                "text": "Их надо в кратчайший срок перевезти через Каспийское море в Махачкалу, откуда они последуют на фронт."
                            },
                            {
                                "example_id": "d68b10ad-0023-40a9-8ff4-a0cb9166d578",
                                "sense_id": "fc8528d6-e7d7-3892-a330-4d08ec7b77b3",
                                "text": "На главной площади Махачкалы во всяком случае впервые поставили искусственную ёлку."
                            }
                        ]
                    }
                ],
