                {
                    "sense_id": "253114de-4dd4-3abf-826b-4f0d33903ad4",
                    "sense_definition": "A quadrangle, especially a rectangular courtyard surrounded by buildings on a college or university campus.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students often gather on the <w>quad</w> to study or relax between their afternoon lectures.",
