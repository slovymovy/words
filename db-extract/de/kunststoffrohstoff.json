                "senses": [
                    {
                        "sense_id": "77616b38-58b1-3279-819b-f84d71c5833b",
                        "entry_id": "bf5aac8c-1bd7-3b6c-9870-fb798ff722b8",
                        "glosses": [
                            "zur Verarbeitung bestimmter Ausgangsstoff zu Kunststoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43636538-cac6-4472-86dd-90dde8bdf923",
                                "sense_id": "77616b38-58b1-3279-819b-f84d71c5833b",
                                "text": "„Wir kaufen und verkaufen Kunststoffrohstoffe als Neuware mit WPZ, sowie geprüfte Regranulate und Mahlgüter aus erster Verarbeitung.“"
                            },
                            {
                                "example_id": "9fd3aa95-8fcc-4f00-b4d9-71e3e2f6be74",
                                "sense_id": "77616b38-58b1-3279-819b-f84d71c5833b",
                                "text": "„Die Kooperation mit RESINEX und Dow basiert auf einer länderübergreifenden, strategischen Partnerschaft für ganz Europa inklusive der Türkei und umfasst die Distribution nahezu aller DOW Kunststoffrohstoffe.“"
                            },
                            {
                                "example_id": "b3f7682d-b09d-499c-88d1-b6f87f6fe853",
                                "sense_id": "77616b38-58b1-3279-819b-f84d71c5833b",
                                "text": "„In jener Zeit war es üblich, dass der Chemikalienverkauf - und ab 1965 mit Einführung der Spartenorganisation bei DN - die Chemikaliensparte die zugehörigen Kunststoffrohstoffe (hier TROGAMID, aber auch Phenol-,Harnstoff- und Melaminharze und PVC-Compounds TROSIPLAST) parallel zu den Kunststoff-Halbfabrikaten als Chemikalien vermarktete.“"
                            },
                            {
                                "example_id": "4a01092b-3aec-4fdb-97a1-bbb1b5a44c27",
                                "sense_id": "77616b38-58b1-3279-819b-f84d71c5833b",
                                "text": "Hierzu halten wir für Sie ein reichhaltiges Sortiment an Kunststoffrohstoffen (Bsp. LD-PE, HD-PE, Polyamide, ABS, SAN, TPE / TPU) und eine Auswahl benötigter Additive (Bsp. Gleitmittel, Nukleierungskonzentrate, Reinigungsgranulate) bereit."
                            },
                            {
                                "example_id": "be7d6826-1bfb-4c19-904c-6c37ab1adb6a",
                                "sense_id": "77616b38-58b1-3279-819b-f84d71c5833b",
                                "text": "Die plast alger ist eine Ausstellung für die Kunststoffindustrie sowie chemische Industrie in Algerien und Nordafrika. Sie ist eine internationale Plattform, die unter einem Dach das komplette Produktspektrum der Kunststofftechnik abdeckt – von Kunststoffrohstoffen, Kunststoffverarbeitungsmaschinen und Kunststofferzeugnissen bis hin zu Kunststoffrecyclinganlagen und Verpackungsmaschinen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
