                ],
                "senses": [
                    {
                        "sense_id": "8fa1affd-7572-3341-ae05-ff5397e6fcdc",
                        "entry_id": "7ea3831f-f92f-391a-8ec9-a01f7426825d",
                        "glosses": [
                            "Orgel aus der Zeit und im Stil des Barocks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d7f9aa6-340b-4daf-a81a-1c7b9b419b55",
                                "sense_id": "8fa1affd-7572-3341-ae05-ff5397e6fcdc",
                                "text": "Die berühmteste Barockorgel dürfte die Gottfried-Silbermann-Orgel im sächsischen Freiberg sein."
                            },
                            {
                                "example_id": "a207fe38-5666-492b-a62e-0cc37c5dc80d",
                                "sense_id": "8fa1affd-7572-3341-ae05-ff5397e6fcdc",
                                "text": "„Außerdem befindet sich in Amorbach die zweitgrößte Barockorgel der Welt.“"
                            },
                            {
                                "example_id": "0952a6f3-4f0b-4888-bbb2-8cc8c7fcbce3",
                                "sense_id": "8fa1affd-7572-3341-ae05-ff5397e6fcdc",
                                "text": "„Besonders stolz ist man im Bachhaus auf die jüngste Neuerwerbung, eine thüringische Barockorgel von 1650.“"
                            },
                            {
                                "example_id": "31e8505b-77c6-4133-87e2-f09dce1fb88c",
                                "sense_id": "8fa1affd-7572-3341-ae05-ff5397e6fcdc",
                                "text": "„Es ist auch heute eine sehr schöne Orgel in dieser Kirche, aber die wunderschöne Barockorgel, auf der Beethoven gespielt hat, ist zerstört worden im letzten Krieg.“"
                            },
                            {
                                "example_id": "93867476-6f0a-4ba1-bfa9-e2e9262e91f0",
                                "sense_id": "8fa1affd-7572-3341-ae05-ff5397e6fcdc",
                                "text": "[Trondheim/Nidarosdom:] „Neben der großen Orgel hat der Dom eine Barockorgel vom Brandenburger Orgelbauer Joachim Wagner. Man nennt ihn auch den märkischen Silbermann.“"
                            },
                            {
                                "example_id": "b56f4724-5e61-4094-93d3-e7e29267a7e9",
                                "sense_id": "8fa1affd-7572-3341-ae05-ff5397e6fcdc",
                                "text": "„Aus rund 4.000 Pfeifen besteht die Orgel von Arp Schnitger in der Hamburger St. Jacobi-Kirche. Sie ist die größte in ihrem klingenden Bestand erhaltene Barockorgel norddeutschen Typs, ein Kulturdenkmal von unschätzbarem Rang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
