{
    "word_family": [
        "offender",
        "offense",
        "offensive",
        "offensiveness",
        "inoffensive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e3dfd89a-19ef-3739-9af5-9d259533fcf8",
                    "sense_definition": "To hurt the feelings of someone or make them feel angry or upset by being rude or showing no respect.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotional_hurt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry if my comments about your work <w>offend</w> you deeply.",
                            "target_lang_translations": {
                                "ru": "Прошу прощения, если мои замечания о вашей работе глубоко вас <w>обижают</w>."
                            }
                        },
                        {
                            "text": "She was afraid that her choice of clothes might <w>offend</w> her conservative relatives.",
                            "target_lang_translations": {
                                "ru": "Она боялась, что её выбор одежды может <w>оскорбить</w> её консервативных родственников."
                            }
                        }
                    ],
                    "synonyms": [
                        "affront",
                        "disrespect",
                        "hurt someone's feelings",
                        "insult",
                        "slight",
                        "wound"
                    ],
                    "antonyms": [
                        "compliment",
                        "flatter",
                        "praise"
                    ],
                    "common_phrases": [
                        "offend deeply",
                        "likely to offend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ранить чьи-либо чувства, разозлить или расстроить кого-либо грубостью или неуважением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обижать",
                                "target_lang_sense_clarification": "ранить чувства"
                            },
                            {
                                "target_lang_word": "оскорблять",
                                "target_lang_sense_clarification": "задевать честь или достоинство"
                            },
                            {
                                "target_lang_word": "задевать",
                                "target_lang_sense_clarification": "неприятно касаться какой-либо темы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd1812f7-14de-323c-8b1d-ddc675d551a3",
                    "sense_definition": "To feel or become upset or insulted by something someone else has said or done.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_hurt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not <w>offend</w> easily because he was only joking about the situation.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>обижайтесь</w> так легко, ведь он просто шутил над ситуацией."
                            }
                        },
                        {
                            "text": "Some people <w>offend</w> at the slightest criticism of their favorite sports team.",
                            "target_lang_translations": {
                                "ru": "Некоторые люди <w>обижаются</w> на малейшую критику в адрес их любимой спортивной команды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "offend easily",
                        "take offense"
                    ],
                    "target_lang_definitions": {
                        "ru": "Почувствовать себя расстроенным или оскорбленным из-за чьих-либо слов или поступков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обижаться",
                                "target_lang_sense_clarification": "чувствовать обиду"
                            },
                            {
                                "target_lang_word": "оскорбляться",
                                "target_lang_sense_clarification": "чувствовать себя оскорбленным"
                            },
                            {
                                "target_lang_word": "принимать на свой счет",
                                "target_lang_sense_clarification": "считать замечание относящимся к себе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9953a626-a0e7-3b4e-ab48-ca9429b2bbb6",
                    "sense_definition": "To break a law, rule, or moral principle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "violation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was found to <w>offend</w> against environmental regulations regarding waste disposal.",
                            "target_lang_translations": {
                                "ru": "Было установлено, что компания <w>нарушает</w> экологические нормы, касающиеся утилизации отходов."
                            }
                        },
                        {
                            "text": "Any behavior that <w>offends</w> against the club rules will result in a temporary ban.",
                            "target_lang_translations": {
                                "ru": "Любое поведение, которое <w>идет вразрез</w> с правилами клуба, приведет к временному исключению."
                            }
                        }
                    ],
                    "common_phrases": [
                        "offend against rules",
                        "offend against law"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарушать закон, правило или моральный принцип."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарушать",
                                "target_lang_sense_clarification": "преступать закон или правила"
                            },
                            {
                                "target_lang_word": "преступать",
                                "target_lang_sense_clarification": "совершать правонарушение"
                            },
                            {
                                "target_lang_word": "идти вразрез",
                                "target_lang_sense_clarification": "противоречить нормам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "643b4243-e612-35ad-a8b6-1a2aaf3f5685",
                    "sense_definition": "To cause physical discomfort or to be unpleasant to the senses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "discomfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright fluorescent lights in the office <w>offend</w> the eye after several hours.",
                            "target_lang_translations": {
                                "ru": "Яркий флуоресцентный свет в офисе через несколько часов начинает <w>раздражать</w> глаза."
                            }
                        },
                        {
                            "text": "A strong smell of chemicals began to <w>offend</w> the nostrils of everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Сильный запах химикатов начал <w>неприятно бить в нос</w> всем присутствующим в комнате."
                            }
                        }
                    ],
                    "common_phrases": [
                        "offend the eye",
                        "offend the ear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать физический дискомфорт или быть неприятным для органов чувств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражать",
                                "target_lang_sense_clarification": "вызывать неприятную реакцию органов чувств"
                            },
                            {
                                "target_lang_word": "резать",
                                "target_lang_sense_clarification": "о неприятном звуке или свете"
                            },
                            {
                                "target_lang_word": "оскорблять",
                                "target_lang_sense_clarification": "перен. быть крайне неприятным для взора или слуха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1ec7e89-504c-3acd-854d-9b512e1078f6",
                    "sense_definition": "To commit a sin or transgress a divine or moral law.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "violation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In many ancient texts, the protagonist fears they might <w>offend</w> in thought or deed.",
                            "target_lang_translations": {
                                "ru": "Во многих древних текстах главный герой боится, что может <w>согрешить</w> в мыслях или на деле."
                            }
                        },
                        {
                            "text": "The preacher warned that those who <w>offend</w> against moral laws would face consequences.",
                            "target_lang_translations": {
                                "ru": "Проповедник предупредил, что те, кто <w>преступает</w> моральные законы, столкнутся с последствиями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "offend in thought"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in religious or formal moral contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершить грех или нарушить божественный или моральный закон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согрешать",
                                "target_lang_sense_clarification": "совершать грех"
                            },
                            {
                                "target_lang_word": "грешить",
                                "target_lang_sense_clarification": "нарушать религиозные заповеди"
                            },
                            {
                                "target_lang_word": "преступать",
                                "target_lang_sense_clarification": "нарушать высший закон"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}