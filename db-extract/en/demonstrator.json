                    },
                    {
                        "translation_id": "e12c26f8-9ce5-4545-9dfd-88d03fe11503",
                        "source_entry_id": "f16234b7-f446-3878-b8fc-dcc4bee1c233",
                        "source_sense_description": "a person involved in a demonstration",
                        "target_lang_word": "manifestant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manifestant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db3a6184-0043-396f-8498-af2cb4f7257e",
                                        "entry_id": "b00b8510-9ad6-3211-9382-8e79d15df7d4",
                                        "glosses": [
                                            "Celui qui prend part à une manifestation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e881fcd4-c0c2-438d-96dc-cc9ccf62bb9c",
                                                "sense_id": "db3a6184-0043-396f-8498-af2cb4f7257e",
                                                "text": "Des soldats israéliens tirent sur un manifestant lançant une minuscule pierre."
                                            },
                                            {
                                                "example_id": "793b910a-9d80-441c-bbc6-0d5ed1127287",
                                                "sense_id": "db3a6184-0043-396f-8498-af2cb4f7257e",
                                                "text": "Au cours du procès Zola, les antisémites recrutèrent des troupes de manifestants soldés, qui étaient chargés d'exprimer les indignations patriotiques ; le gouvernement de Méline protégeait ces manœuvres […]."
                                            },
                                            {
                                                "example_id": "e3f28828-a620-4fd2-8384-9935a1052067",
                                                "sense_id": "db3a6184-0043-396f-8498-af2cb4f7257e",
                                                "text": "Écrasée par un conducteur néonazi, une manifestante a pourtant payé de sa vie son opposition à la parade de Charlottesville, qui rassemblait, le week-end dernier, suprémacistes blancs, sudistes nostalgiques de l’esclavage et du général Lee, militants de l’« alt-right » (extrême droite) et autres humanistes du Ku Klux Klan, tous unis, bras tendu, batte de base-ball en main, slogans antisémites et anti-« nègres » aux lèvres, pour hurler leur « fierté d’être blancs »."
                                            },
                                            {
                                                "example_id": "8a1846f4-75b6-4c71-85c2-2896a44c0fc8",
                                                "sense_id": "db3a6184-0043-396f-8498-af2cb4f7257e",
                                                "text": "L'hymne des hirakistes, les manifestants antirégime qui défilent pacifiquement dans les rues chaque vendredi en Algérie, est une adaptation de La Casa del Mouradia, une célèbre chanson des supporters de l'équipe de football USM Alger."
                                            },
                                            {
                                                "example_id": "9c029661-0b9e-4d8e-becc-a4dc5d11f1ec",
                                                "sense_id": "db3a6184-0043-396f-8498-af2cb4f7257e",
                                                "text": "L'armée ne se substituerait pas à la police et n'ouvrirait pas le feu sur les « hirakistes ». Dès lors, tout était possible et la convergence, temporaire, des intérêts des manifestants et des militaires a ouvert la voie à un processus de protestation largement pacifique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "manifestant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ae12697-d82f-37be-b332-627c51047f53",
                                        "entry_id": "26777374-644b-3057-9bef-bc22b9eedccb",
                                        "glosses": [
                                            "Participe présent de manifester."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15b30cc9-ba8c-409e-b36d-a549f1cc84fa",
                                                "sense_id": "9ae12697-d82f-37be-b332-627c51047f53",
                                                "text": "Mais il y avait encore un potentiel de support possible chez les groupes épars vaguement appelés \"les intellectuels\", ou plus exactement les non-analphabètes manifestant une certaine sympathie pour les choses dites \"nationales\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36aeeccc-b304-47e3-8611-35ba31f46848",
                        "source_entry_id": "f16234b7-f446-3878-b8fc-dcc4bee1c233",
                        "source_sense_description": "a person involved in a demonstration",
                        "target_lang_word": "manifestante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manifestante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6baf9636-4ee0-3658-bc49-88aa2892ccc3",
                                        "entry_id": "6d7e9a96-9284-3b40-88ab-73efa6628921",
                                        "glosses": [
                                            "Celle qui prend part à une manifestation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74b55732-d399-4cb4-b840-bad07c549848",
                                                "sense_id": "6baf9636-4ee0-3658-bc49-88aa2892ccc3",
                                                "text": "Et sur la forme, son tri revendiqué entre les journalistes et l'exclusion manu militari d'une manifestante pro-ukrainienne n'ont pas manqué de « re-diaboliser » Marine Le Pen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b74e01e-b6f5-46d1-844a-f119baa11c90",
                        "source_entry_id": "f16234b7-f446-3878-b8fc-dcc4bee1c233",
                        "source_sense_description": "a person involved in a demonstration",
                        "target_lang_word": "Demonstrant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Demonstrant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b78b9e5-e2c9-3f0b-9133-5441d0bffe46",
                                        "entry_id": "f9214a62-90d1-37fd-abae-47bb458a1420",
                                        "glosses": [
                                            "Person, die in der Öffentlichkeit, einzeln oder in einer Gruppe, meistens im Rahmen einer organisierten Kundgebung, ihre Meinung zu politischen, arbeitsrechtlichen oder gesellschaftlichen Themen sichtbar, hörbar und durch Aktionen äußert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1e930f0-21ce-473c-af15-7f3b2fed9861",
                                                "sense_id": "8b78b9e5-e2c9-3f0b-9133-5441d0bffe46",
                                                "text": "Die Sicherheitskräfte setzten am Samstag Tränengas und Schlagstöcke ein, um die Gruppe von oppositionellen Anwälten und Regierungskritikern aufzulösen, wie Augenzeugen berichteten. Zwei Demonstranten hätten am Kopf geblutet."
                                            },
                                            {
                                                "example_id": "184877df-39a2-434d-905d-47aff6b191e5",
                                                "sense_id": "8b78b9e5-e2c9-3f0b-9133-5441d0bffe46",
                                                "text": "Passanten, die den Demonstranten applaudiert haben, müssen mit einer Haftstrafe von zwei bis vier Jahren rechnen."
                                            },
                                            {
                                                "example_id": "07f6358a-59ee-40e7-b4e1-66d7e8864069",
                                                "sense_id": "8b78b9e5-e2c9-3f0b-9133-5441d0bffe46",
                                                "text": "Umstritten war diese Einladung eines Rektors für einen Holocaustleugner, selbst bei den tausenden Demonstranten war eine Spaltung zwischen „Lasst den Irren reden\"- und „Der soll gefälligst den Mund halten!\"-Fraktionen zu verspüren."
                                            },
                                            {
                                                "example_id": "e6616c0c-0cd3-48a0-b457-87370d9fb156",
                                                "sense_id": "8b78b9e5-e2c9-3f0b-9133-5441d0bffe46",
                                                "text": "Demonstranten sind während einer Debatte ins Sitzungsrund des Bundestages eingedrungen. Zwei weitere seilten sich vom Dach des Parlaments ab."
                                            },
                                            {
                                                "example_id": "56edf185-36cd-48a5-8381-f913db6169d3",
                                                "sense_id": "8b78b9e5-e2c9-3f0b-9133-5441d0bffe46",
                                                "text": "Die Verletzungen seien durch gewalttätige Demonstranten verursacht worden, die eine Rauchbombe gezündet hätten."
                                            },
                                            {
                                                "example_id": "9742b2f7-d464-4a74-81f0-d1aa7060c30a",
                                                "sense_id": "8b78b9e5-e2c9-3f0b-9133-5441d0bffe46",
                                                "text": "Es war eine kleine Minderheit der Demonstranten, die zur Gewalt griff, aber diese bestimmte ab sofort die Szenerie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "705144c7-2e06-40de-b89c-8a4fc38943f5",
                        "source_entry_id": "f16234b7-f446-3878-b8fc-dcc4bee1c233",
                        "source_sense_description": "a person involved in a demonstration",
                        "target_lang_word": "Demonstrantin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Demonstrantin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fea35cc-231a-3d1e-84e5-9f408a8b210a",
                                        "entry_id": "9d3305d6-61ef-3402-8c63-14f3bf0411ec",
                                        "glosses": [
                                            "weibliche Person, die an einer Demonstration teilnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1548c5e7-5ad4-4906-a377-bbf6eb47675f",
                                                "sense_id": "8fea35cc-231a-3d1e-84e5-9f408a8b210a",
                                                "text": "„Bei den gewalttätigen Protesten gegen den Ausgang der Parlamentswahl in Moldawien ist eine Demonstrantin ums Leben gekommen.“"
                                            },
                                            {
                                                "example_id": "a18bb45a-7fd7-4839-a950-11c29fe0e0b7",
                                                "sense_id": "8fea35cc-231a-3d1e-84e5-9f408a8b210a",
                                                "text": "„Andere Demonstrantinnen erzählen die Geschichte ganz anders: Einige hätten sich \"gejagt von der Polizei\" in der Josefstädter Straße in das Geschäft geflüchtet, beim Polizeieinsatz seien dann auch Waren zu Bruch gegangen.“"
                                            },
                                            {
                                                "example_id": "528ffc56-2b96-4669-91b5-d015b62a41dc",
                                                "sense_id": "8fea35cc-231a-3d1e-84e5-9f408a8b210a",
                                                "text": "„Die Polizei eröffnete das Feuer auf die Demonstrantinnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
