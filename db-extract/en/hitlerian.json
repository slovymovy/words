                        "form_id": "834f11bf-04d1-4fce-a039-6a8fe9448518",
                        "entry_id": "5525d266-93d1-3977-88a1-0fece8f1968d",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more Hitlerian"
                    },
                    {
                        "form_id": "ef7496b9-4c46-4b61-a8e4-5c66b2cd23e5",
                        "entry_id": "5525d266-93d1-3977-88a1-0fece8f1968d",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most Hitlerian"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b4abb047-6226-34ca-addd-04546f7f0519",
                        "entry_id": "5525d266-93d1-3977-88a1-0fece8f1968d",
                        "glosses": [
                            "Of, relating to, or resembling Hitler (the German chancellor) or his actions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55df26b1-dca1-4bdc-ac04-bc11b00e3576",
                                "sense_id": "b4abb047-6226-34ca-addd-04546f7f0519",
                                "text": "of Hitlerian proportions"
                            },
                            {
                                "example_id": "50cace55-9493-4c27-8d78-281cbdecff78",
                                "sense_id": "b4abb047-6226-34ca-addd-04546f7f0519",
                                "text": "[He had] an almost Hitlerian cowlick on his pale brow."
                            },
                            {
                                "example_id": "eb480831-8b41-4754-82e8-398cff97ad77",
                                "sense_id": "b4abb047-6226-34ca-addd-04546f7f0519",
                                "text": "Cambodia was subjected to a genocide of Hitlerian proportions."
                            },
                            {
                                "example_id": "ee63b843-8153-4459-94c4-d6357dc02466",
                                "sense_id": "b4abb047-6226-34ca-addd-04546f7f0519",
                                "text": "Unable to contain his excitement, Foyʼs voice rose two octaves and took on a Hitlerian fervor."
                            },
                            {
                                "example_id": "5e3719d9-9b0e-4909-a13f-6b8f1eb4489f",
                                "sense_id": "b4abb047-6226-34ca-addd-04546f7f0519",
                                "text": "War is war — but we need to understand how wrong it is to see the temporary triumph of fascist villainy as the destruction, once and for all, of the German people and the inauguration of an eternal kingdom of Hitlerian darkness."
                            },
                            {
                                "example_id": "3988ea48-4079-40b7-9a3d-48e58000df9c",
                                "sense_id": "b4abb047-6226-34ca-addd-04546f7f0519",
                                "text": "Hitlerian occupation authorities had been preparing action against Polish underground very carefully."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6304b87f-8167-4b6f-8fee-07a7ee43edd7",
