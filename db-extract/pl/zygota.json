                                    {
                                        "sense_id": "a446d605-305c-38cc-b311-1ad7ade41dee",
                                        "entry_id": "bf8b2017-ebae-3f77-8d04-b5d64b663883",
                                        "glosses": [
                                            "Cellule diploïde résultant de la réunion de deux gamètes haploïdes par le processus de fécondation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b5aa288-5436-4546-afc5-567443eb566a",
                                                "sense_id": "a446d605-305c-38cc-b311-1ad7ade41dee",
                                                "text": "Le zygote – point de départ d’un nouvel individu – naît de la fusion de 2 cellules singulières appelées gamètes. Ces deux gamètes proviennent chacun d’un des 2 parents : un spermatozoïde du père et un ovule de la mère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
