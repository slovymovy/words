                        "glosses": [
                            "związany z reumatyzmem, właściwy reumatyzmowi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ae38b60-3e84-4071-9728-0aa6f0354d07",
                                "sense_id": "25d79f5e-175e-3f2d-84e5-1161e89a0e8e",
                                "text": "W chorobach reumatycznych wskazania obejmują wszystkie postacie gośćca, szczególnie tkanek miękkich, w celu zmniejszenia obrzęków i bólu oraz zapobiegnięcia zanikom mięśniowym."
                            }
                        ],
