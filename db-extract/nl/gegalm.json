                        "entry_id": "342b34bd-d773-394d-9e78-92decb0a30fc",
                        "glosses": [
                            "aanhoudend een luid galmend geluid maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1cdd800-f7e8-43e8-a598-1afd82b90eac",
                                "sense_id": "781c5fd8-15d2-3cc5-85aa-16d2196bf897",
                                "text": "Het nachtelijk gegalm klinkt voor vele Capellenaren juist vertrouwd. Zij denken er anders over dan de klagende burger van de luidende klok had moeten weten.”"
                            },
                            {
                                "example_id": "68b012ae-c765-4584-8040-39fdf28cbf5f",
                                "sense_id": "781c5fd8-15d2-3cc5-85aa-16d2196bf897",
                                "text": "Als brandweermensen na een brand uitgeblust in de kantine van de kazerne aan Spaansland zaten, was daar voortdurend het gegalm van hun stemmen en andere geluiden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "382617f5-8c20-4ee2-982a-6909ffb78fd1",
