    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5d46ef28-ba18-3cf7-86f1-09423721239d",
                    "sense_definition": "in een geopende stand waardoor toegang of zicht mogelijk is; niet dicht",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "niet_gesloten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dief klom door een <w>openstaand</w> raam naar binnen.",
                            "target_lang_translations": {
                                "fr": "Le voleur est entré en grimpant par une fenêtre <w>ouverte</w>."
                            }
                        },
                        {
                            "text": "De automobilisten moesten even wachten voor de <w>openstaande</w> brug.",
                            "target_lang_translations": {
                                "fr": "Les automobilistes ont dû attendre un moment devant le pont <w>ouvert</w>."
                            }
