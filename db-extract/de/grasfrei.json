                "senses": [
                    {
                        "sense_id": "c4bc7500-1928-3b2c-af18-3350ed43a1ac",
                        "entry_id": "28a0b655-7280-3f61-91c6-b326a4e03c36",
                        "glosses": [
                            "frei von Gras, keinen Grasbewuchs aufweisend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9be58e1-d6ad-4d8e-a265-dd654d565321",
                                "sense_id": "c4bc7500-1928-3b2c-af18-3350ed43a1ac",
                                "text": "„Mitten über diese Lichtung verlief eine breite, gerade, grasfreie Schneise, begrenzt von Steinen und nackter Erde.“"
                            },
                            {
                                "example_id": "c60794fd-6709-41e9-9265-66fe4bbdbb6c",
                                "sense_id": "c4bc7500-1928-3b2c-af18-3350ed43a1ac",
                                "text": "„Ich lege die Taschenlampe so auf den Boden, dass sie die erdige, grasfreie Stelle anstrahlt, und fange an zu graben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
