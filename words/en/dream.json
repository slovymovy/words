{
    "word_family": [
        "dreamer",
        "dreamy",
        "dreamlike",
        "dreamless",
        "dreamscape",
        "daydream"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f4805bb-3b56-3738-ad93-79aed52fce9e",
                    "sense_definition": "A series of thoughts, images, and sensations occurring in a person's mind during sleep.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sleep_vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had a very strange <w>dream</w> last night about flying over the ocean.",
                            "target_lang_translations": {
                                "ru": "Прошлой ночью мне приснился очень странный <w>сон</w> о том, как я лечу над океаном."
                            }
                        },
                        {
                            "text": "She woke up suddenly from a <w>scary</w> <w>dream</w> and couldn't fall back asleep.",
                            "target_lang_translations": {
                                "ru": "Она внезапно проснулась от <w>страшного</w> <w>сна</w> и не смогла снова уснуть."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweven",
                        "vision"
                    ],
                    "common_phrases": [
                        "have a dream",
                        "scary dream",
                        "vivid dream",
                        "bad dream"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ряд мыслей, образов и ощущений, возникающих в сознании человека во время сна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сон",
                                "target_lang_sense_clarification": "видение во время сна"
                            },
                            {
                                "target_lang_word": "сновидение",
                                "target_lang_sense_clarification": "процесс или содержание сна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b46de425-9518-3d68-918e-0a3056714067",
                    "sense_definition": "A cherished aspiration, ambition, or ideal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aspiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It has always been his <w>dream</w> to travel around the world.",
                            "target_lang_translations": {
                                "ru": "Путешествие вокруг света всегда было его <w>мечтой</w>."
                            }
                        },
                        {
                            "text": "After years of hard work, she was finally able to <w>realize</w> <w>a</w> <w>dream</w> of opening her own bakery.",
                            "target_lang_translations": {
                                "ru": "После многих лет упорного труда она наконец смогла <w>осуществить</w> <w>мечту</w> об открытии собственной пекарни."
                            }
                        }
                    ],
                    "synonyms": [
                        "vision"
                    ],
                    "common_phrases": [
                        "fulfil a dream",
                        "realize a dream",
                        "childhood dream",
                        "follow your dream"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заветное стремление, амбиция или идеал."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мечта",
                                "target_lang_sense_clarification": "заветное желание"
                            },
                            {
                                "target_lang_word": "грёза",
                                "target_lang_sense_clarification": "поэтическое или возвышенное стремление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe822cb1-bf0e-309f-80a8-29941393da2c",
                    "sense_definition": "An unrealistic or visionary scheme; a wild fancy that is unlikely to happen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fancy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is chasing an <w>impossible</w> <w>dream</w> that will never come true.",
                            "target_lang_translations": {
                                "ru": "Он гонится за <w>несбыточной</w> <w>мечтой</w>, которая никогда не исполнится."
                            }
                        },
                        {
                            "text": "Stop living in a <w>dream</w> and start facing the reality of the situation.",
                            "target_lang_translations": {
                                "ru": "Перестань жить в <w>иллюзиях</w> и начни смотреть в лицо реальности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "impossible dream",
                        "live in a dream",
                        "pipe dream"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нереалистичный или призрачный план; несбыточная фантазия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иллюзия",
                                "target_lang_sense_clarification": "нечто несбыточное"
                            },
                            {
                                "target_lang_word": "несбыточная мечта",
                                "target_lang_sense_clarification": "пустые фантазии"
                            },
                            {
                                "target_lang_word": "пустые мечты",
                                "target_lang_sense_clarification": "нереальные планы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d719e7f2-f8f8-340f-92fa-576a76bd0574",
                    "sense_definition": "To experience a series of images or thoughts in the mind while sleeping.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sleep_vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I often <w>dream</w> about my childhood home when I am stressed.",
                            "target_lang_translations": {
                                "ru": "Мне часто <w>снится</w> дом моего детства, когда я нахожусь в стрессе."
                            }
                        },
                        {
                            "text": "Last night I <w>dreamed</w> that I was speaking fluent French.",
                            "target_lang_translations": {
                                "ru": "Прошлой ночью мне <w>приснилось</w>, что я свободно говорю по-французски."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dream about",
                        "dream of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Видеть образы или мысли в уме во время сна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "видеть сон",
                                "target_lang_sense_clarification": "наблюдать образы во сне"
                            },
                            {
                                "target_lang_word": "сниться",
                                "target_lang_sense_clarification": "о событиях, являющихся во сне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f297006-1792-3ad6-b5ec-2f00acf416fa",
                    "sense_definition": "To strongly desire or hope for something to happen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aspiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many young athletes <w>dream</w> <w>of</w> winning an Olympic gold medal.",
                            "target_lang_translations": {
                                "ru": "Многие молодые атлеты <w>мечтают</w> <w>о</w> завоевании олимпийской золотой медали."
                            }
                        },
                        {
                            "text": "She <w>dreams</w> of becoming a famous doctor one day.",
                            "target_lang_translations": {
                                "ru": "Она <w>мечтает</w> однажды стать известным врачом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dream of",
                        "dream big"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно желать чего-либо или надеяться на что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мечтать",
                                "target_lang_sense_clarification": "сильно желать чего-то"
                            },
                            {
                                "target_lang_word": "грезить",
                                "target_lang_sense_clarification": "страстно желать, воображать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70aceb1b-bfb0-36db-a6ca-4abf825b9ab5",
                    "sense_definition": "To consider something as a possibility, often used in the negative to mean one would never do something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I wouldn't <w>dream</w> <w>of</w> asking her for money.",
                            "target_lang_translations": {
                                "ru": "Я бы и не <w>подумал</w> просить у неё деньги."
                            }
                        },
                        {
                            "text": "He never <w>dreamt</w> that his invention would become so popular.",
                            "target_lang_translations": {
                                "ru": "Он и не <w>предполагал</w>, что его изобретение станет таким популярным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wouldn't dream of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассматривать что-либо как возможность (часто в отрицании — даже не помышлять)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помышлять",
                                "target_lang_sense_clarification": "допускать мысль о чем-либо"
                            },
                            {
                                "target_lang_word": "думать",
                                "target_lang_sense_clarification": "предполагать возможность"
                            },
                            {
                                "target_lang_word": "представлять",
                                "target_lang_sense_clarification": "воображать вероятность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c2ebd3b-bdfb-366b-a32e-d3d8926295dc",
                    "sense_definition": "To indulge in daydreams or be distracted from reality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fancy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>dreaming</w> and pay attention to what the teacher is saying.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>витать в облаках</w> и слушай внимательно, что говорит учитель."
                            }
                        },
                        {
                            "text": "He spent the whole afternoon <w>dreaming</w> at his desk instead of working.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, <w>мечтая</w> за своим столом вместо того, чтобы работать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stop dreaming"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предаваться мечтам или отвлекаться от реальности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "витать в облаках",
                                "target_lang_sense_clarification": "отвлекаться от реальности"
                            },
                            {
                                "target_lang_word": "фантазировать",
                                "target_lang_sense_clarification": "предаваться воображению"
                            },
                            {
                                "target_lang_word": "мечтать",
                                "target_lang_sense_clarification": "задумываться о чем-то постороннем"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dcbd9c9e-bf9d-3420-9224-7965d5ffb773",
                    "sense_definition": "Ideal, perfect, or exactly as one would wish.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ideal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They finally found their <w>dream</w> <w>house</w> near the countryside.",
                            "target_lang_translations": {
                                "ru": "Они наконец нашли <w>дом</w> своей <w>мечты</w> в сельской местности."
                            }
                        },
                        {
                            "text": "Meeting the famous actor was a <w>dream</w> <w>come</w> <w>true</w> for the young fan.",
                            "target_lang_translations": {
                                "ru": "Встреча с известным актером стала для юного фаната <w>исполнением</w> <w>мечты</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dream house",
                        "dream job",
                        "dream girl",
                        "dream car"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идеальный, совершенный или именно такой, как хотелось бы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мечты",
                                "target_lang_sense_clarification": "в значении «идеальный» (дом мечты)"
                            },
                            {
                                "target_lang_word": "идеальный",
                                "target_lang_sense_clarification": "совершенный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0da885ec-99c5-34ab-b6f3-c4d3c3b35c71",
                    "sense_definition": "An acronym for the Development, Relief, and Education for Alien Minors Act in the United States.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legislation",
                    "name_type": "document_or_program_name",
                    "examples": [
                        {
                            "text": "The <w>DREAM</w> Act was proposed to provide a path to citizenship for certain immigrants.",
                            "target_lang_translations": {
                                "ru": "<w>Закон DREAM</w> был предложен, чтобы предоставить путь к гражданству для определенных иммигрантов."
                            }
                        },
                        {
                            "text": "Many activists have been campaigning for the passage of the <w>DREAM</w> Act for years.",
                            "target_lang_translations": {
                                "ru": "Многие активисты годами агитировали за принятие <w>закона DREAM</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "DREAM Act"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура закона DREAM Act в США (о развитии, помощи и образовании для несовершеннолетних иностранцев)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закон DREAM",
                                "target_lang_sense_clarification": "название американского законопроекта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}