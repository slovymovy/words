                ],
                "senses": [
                    {
                        "sense_id": "798fb8e7-2d48-38c2-86dd-09e36a21eb47",
                        "entry_id": "23584108-d13f-3552-aeff-fbc9e79df2c1",
                        "glosses": [
                            "Rosacée à fleurs jaunes disposées en épis et à feuilles ailées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "930e721a-d5f4-41db-8844-95e076d2b810",
                                "sense_id": "798fb8e7-2d48-38c2-86dd-09e36a21eb47",
                                "text": "On emploie l’aigremoine en gargarisme contre les maux de gorge."
                            },
                            {
                                "example_id": "e9ab3178-f2ad-472a-979f-700d7c16de4a",
                                "sense_id": "798fb8e7-2d48-38c2-86dd-09e36a21eb47",
                                "text": "Vous verrez plus bas que l'aigremoine servait à préparer une boisson sans doute aigre."
                            },
                            {
                                "example_id": "c1f10aee-6294-4379-8ca7-325c4298db69",
                                "sense_id": "798fb8e7-2d48-38c2-86dd-09e36a21eb47",
                                "text": "Sur la planche, il y a une cruche d’eau, une bouteille de vin, trois verres, des fruits, du saucisson, du fromage, un pot de miel et du pain, et même un bouquet de trèfles dorés et d’aigremoines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32b5edbb-a186-474b-9650-831ade9f7def",
                        "source_entry_id": "23584108-d13f-3552-aeff-fbc9e79df2c1",
                        "source_sense_id": "798fb8e7-2d48-38c2-86dd-09e36a21eb47",
