                "senses": [
                    {
                        "sense_id": "e561b04d-b4ce-3d90-ac85-0cd82953f6e7",
                        "entry_id": "879f9b39-b772-3c4a-bfbe-52d79f696b33",
                        "glosses": [
                            "Geruch, der von Wasser ohne nennenswerten Salzgehalt verursacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe46ca1a-aff3-489d-8302-b7212718d694",
                                "sense_id": "e561b04d-b4ce-3d90-ac85-0cd82953f6e7",
                                "text": "„Angeboren ist dem Meeresfisch Aal, kontinentalem Süßwassergeruch entgegenzustreben.“"
                            },
                            {
                                "example_id": "da87fb88-640b-495d-a30c-bb20dc81c4ed",
                                "sense_id": "e561b04d-b4ce-3d90-ac85-0cd82953f6e7",
                                "text": "„In Wien der Süßwassergeruch der schönen blauen Donau, in Triest hingegen riechen alle Kaffeehäuser nach salzigem Meer, nach Algen, nach den von den Stößen der Bora aufgewühlten Wellen.“"
                            }
                        ],
