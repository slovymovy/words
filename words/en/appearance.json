{
    "word_family": [
        "appear",
        "apparent",
        "apparently",
        "disappear",
        "disappearance",
        "reappear",
        "reappearance"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "53db04f8-0981-33aa-91a4-11de05997d66",
                    "sense_definition": "The way that someone or something looks to other people.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visual_aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spends a lot of time and money on her personal <w>appearance</w>.",
                            "target_lang_translations": {
                                "ru": "Она тратит много времени и денег на свою <w>внешность</w>.",
                                "pl": "Ona spędza dużo czasu i wydaje wiele pieniędzy na swój <w>wygląd</w> osobisty.",
                                "zh": "她花了很多时间和金钱在个人<w>外表</w>上。"
                            }
                        },
                        {
                            "text": "The building has a very modern and clean <w>appearance</w>.",
                            "target_lang_translations": {
                                "ru": "У здания очень современный и опрятный <w>внешний вид</w>.",
                                "pl": "Budynek ma bardzo nowoczesny i schludny <w>wygląd</w>.",
                                "zh": "这座建筑有着非常现代且整洁的<w>外观</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "look",
                        "aspect",
                        "air"
                    ],
                    "common_phrases": [
                        "personal appearance",
                        "physical appearance",
                        "change one's appearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, как кто-то или что-то выглядит в глазах других; наружный вид.",
                        "pl": "Sposób, w jaki ktoś lub coś wygląda dla innych ludzi; wygląd zewnętrzny.",
                        "zh": "一个人或事物在他人眼中的样子；外表。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вне́шность",
                                "target_lang_sense_clarification": "человека"
                            },
                            {
                                "target_lang_word": "вне́шний вид",
                                "target_lang_sense_clarification": "общий вид человека или предмета"
                            },
                            {
                                "target_lang_word": "о́блик",
                                "target_lang_sense_clarification": "образ, внешний вид (книжн.)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wygląd",
                                "target_lang_sense_clarification": "ogólny wygląd osoby lub rzeczy"
                            },
                            {
                                "target_lang_word": "powierzchowność",
                                "target_lang_sense_clarification": "wygląd zewnętrzny człowieka"
                            },
                            {
                                "target_lang_word": "aparycja",
                                "target_lang_sense_clarification": "wygląd zewnętrzny, zwłaszcza miły dla oka"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外表",
                                "target_lang_sense_clarification": "人的外貌或事物的表面"
                            },
                            {
                                "target_lang_word": "外观",
                                "target_lang_sense_clarification": "事物的外部样子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d95b3bc-6402-3752-a995-1ca889a052b7",
                    "sense_definition": "The act of becoming visible or arriving in a place.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "act_of_appearing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden <w>appearance</w> in the doorway surprised everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Его внезапное <w>появление</w> в дверях удивило всех в комнате.",
                                "pl": "Jego nagłe <w>pojawienie się</w> w drzwiach zaskoczyło wszystkich w pokoju.",
                                "zh": "他突然在门口<w>出现</w>，让房间里的每个人都感到惊讶。"
                            }
                        },
                        {
                            "text": "The sun finally made an <w>appearance</w> from behind the clouds in the afternoon.",
                            "target_lang_translations": {
                                "ru": "Днем из-за облаков наконец-то <w>показалось</w> солнце.",
                                "pl": "Po południu słońce w końcu <w>ukazało się</w> zza chmur.",
                                "zh": "下午，太阳终于从云层后<w>露面</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arrival",
                        "manifestation",
                        "emergence",
                        "coming"
                    ],
                    "antonyms": [
                        "non-appearance"
                    ],
                    "common_phrases": [
                        "sudden appearance",
                        "make an appearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие становления видимым или прибытия в какое-либо место.",
                        "pl": "Akt stawania się widocznym lub przybycia w jakieś miejsce.",
                        "zh": "变得可见或到达某地的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "появле́ние",
                                "target_lang_sense_clarification": "возникновение, приход"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pojawienie się",
                                "target_lang_sense_clarification": "stanie się widocznym lub przybycie"
                            },
                            {
                                "target_lang_word": "ukazanie się",
                                "target_lang_sense_clarification": "wyłonienie się, np. słońca zza chmur"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出现",
                                "target_lang_sense_clarification": "显露出来或来到某处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32d9ed91-65b1-359a-a625-d8b79027f5ed",
                    "sense_definition": "An act of performing or being present at a public event or in a media production.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "act_of_appearing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous author made a public <w>appearance</w> to sign copies of her new book.",
                            "target_lang_translations": {
                                "ru": "Известная писательница <w>появилась</w> на публике, чтобы подписать экземпляры своей новой книги.",
                                "pl": "Sławna autorka <w>pokazała się</w> publicznie, aby podpisywać egzemplarze swojej nowej książki.",
                                "zh": "这位著名作家公开<w>露面</w>，为她的新书签名。"
                            }
                        },
                        {
                            "text": "This will be his first <w>appearance</w> on national television since the incident.",
                            "target_lang_translations": {
                                "ru": "Это будет его первое <w>появление</w> на национальном телевидении после инцидента.",
                                "pl": "To będzie jego pierwszy <w>występ</w> w telewizji ogólnokrajowej od czasu tamtego incydentu.",
                                "zh": "这将是他自事件发生以来首次在国家电视台<w>露面</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "debut"
                    ],
                    "common_phrases": [
                        "public appearance",
                        "guest appearance",
                        "TV appearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участие в публичном мероприятии, выступление на сцене или в медиа-проекте.",
                        "pl": "Wystąpienie lub obecność na wydarzeniu publicznym lub w mediach.",
                        "zh": "在公共活动或媒体节目中表演或出席的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "появле́ние",
                                "target_lang_sense_clarification": "на публике или в эфире"
                            },
                            {
                                "target_lang_word": "вы́ход",
                                "target_lang_sense_clarification": "на сцену, к публике"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "występ",
                                "target_lang_sense_clarification": "udział w programie lub na scenie"
                            },
                            {
                                "target_lang_word": "pojawienie się",
                                "target_lang_sense_clarification": "obecność publiczna"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "露面",
                                "target_lang_sense_clarification": "在公众场合出现"
                            },
                            {
                                "target_lang_word": "登场",
                                "target_lang_sense_clarification": "上台表演或出席活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "030b0ae9-2214-31be-a699-8560dd643a43",
                    "sense_definition": "An outward show or impression that may be different from reality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "visual_aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They tried to maintain an <w>appearance</w> of wealth even though they were in debt.",
                            "target_lang_translations": {
                                "ru": "Они пытались сохранять <w>видимость</w> богатства, хотя и были в долгах.",
                                "pl": "Próbowali zachować <w>pozory</w> bogactwa, mimo że byli zadłużeni.",
                                "zh": "尽管负债累累，他们仍试图维持一种富有的<w>假象</w>。"
                            }
                        },
                        {
                            "text": "To all <w>appearances</w>, the business was successful, but it was actually failing.",
                            "target_lang_translations": {
                                "ru": "Судя по <w>внешним признакам</w>, бизнес был успешным, но на самом деле он терпел крах.",
                                "pl": "Z <w>pozoru</w> interes szedł świetnie, ale w rzeczywistości bankrutował.",
                                "zh": "从<w>表面</w>上看，生意很成功，但实际上却在亏损。"
                            }
                        }
                    ],
                    "synonyms": [
                        "semblance",
                        "pretense",
                        "facade",
                        "show"
                    ],
                    "common_phrases": [
                        "keep up appearances",
                        "to all appearances"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внешнее впечатление или показная сторона, которая может не соответствовать действительности.",
                        "pl": "Zewnętrzne wrażenie lub pozory, które mogą różnić się od rzeczywistości.",
                        "zh": "可能与现实不符的外在表现或印象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ви́димость",
                                "target_lang_sense_clarification": "иллюзия, внешнее впечатление"
                            },
                            {
                                "target_lang_word": "вне́шность",
                                "target_lang_sense_clarification": "наружная сторона"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pozory",
                                "target_lang_sense_clarification": "zewnętrzne, mylące wrażenie"
                            },
                            {
                                "target_lang_word": "pozór",
                                "target_lang_sense_clarification": "stwarzanie złudzenia czegoś"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "假象",
                                "target_lang_sense_clarification": "虚假的表面现象"
                            },
                            {
                                "target_lang_word": "表面",
                                "target_lang_sense_clarification": "外在的、不深入的印象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2684645b-0ac9-33b9-9f23-1af6d8578a21",
                    "sense_definition": "An occasion when someone goes to a court of law to participate in a legal proceeding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "act_of_appearing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defendant is scheduled for a court <w>appearance</w> early next week.",
                            "target_lang_translations": {
                                "ru": "<w>Явка</w> подсудимого в суд назначена на начало следующей недели.",
                                "pl": "Oskarżony ma zaplanowane <w>stawiennictwo</w> w sądzie na początku przyszłego tygodnia.",
                                "zh": "被告定于下周初<w>出庭</w>。"
                            }
                        },
                        {
                            "text": "Her lawyer made an <w>appearance</w> on her behalf during the preliminary hearing.",
                            "target_lang_translations": {
                                "ru": "Ее адвокат <w>выступил</w> от ее имени во время предварительного слушания.",
                                "pl": "Jej prawnik <w>stawił się</w> w jej imieniu podczas wstępnego przesłuchania.",
                                "zh": "她的律师在预审期间代表她<w>出庭</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "non-appearance"
                    ],
                    "common_phrases": [
                        "court appearance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Присутствие в суде для участия в судебном разбирательстве.",
                        "pl": "Sytuacja, w której ktoś stawia się w sądzie, aby wziąć udział w postępowaniu prawnym.",
                        "zh": "为了参与法律程序而前往法院的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "я́вка",
                                "target_lang_sense_clarification": "в суд или официальное учреждение"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "stawiennictwo",
                                "target_lang_sense_clarification": "oficjalne przybycie do sądu"
                            },
                            {
                                "target_lang_word": "stawienie się",
                                "target_lang_sense_clarification": "obecność w sądzie na wezwanie"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出庭",
                                "target_lang_sense_clarification": "到法庭参加诉讼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eff7e4d2-0d68-3d31-969e-1d3d9d41abb6",
                    "sense_definition": "A strange or unexplained thing that is seen; a ghost or phantom.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "visual_aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers were terrified by the ghostly <w>appearance</w> in the old castle.",
                            "target_lang_translations": {
                                "ru": "Жители деревни были напуганы призрачным <w>явлением</w> в старом замке.",
                                "pl": "Mieszkańcy wioski byli przerażeni upiorną <w>zjawą</w> w starym zamku.",
                                "zh": "村民们被古堡中出现的鬼魂<w>幻影</w>吓坏了。"
                            }
                        },
                        {
                            "text": "Scientists could not explain the strange <w>appearance</w> observed in the night sky.",
                            "target_lang_translations": {
                                "ru": "Ученые не могли объяснить странное <w>явление</w>, замеченное в ночном небе.",
                                "pl": "Naukowcy nie potrafili wyjaśnić tego dziwnego <w>zjawiska</w> zaobserwowanego na nocnym niebie.",
                                "zh": "科学家们无法解释在夜空中观察到的奇怪<w>现象</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "apparition",
                        "phenomenon",
                        "spectacle"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Странное или необъяснимое явление, которое можно увидеть; призрак.",
                        "pl": "Dziwna lub niewyjaśniona rzecz, którą się widzi; zjawa lub duch.",
                        "zh": "所见到的奇怪或无法解释的事物；鬼魂或幻影。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "явле́ние",
                                "target_lang_sense_clarification": "феномен"
                            },
                            {
                                "target_lang_word": "при́зрак",
                                "target_lang_sense_clarification": "видение"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zjawisko",
                                "target_lang_sense_clarification": "coś niezwykłego lub nienaturalnego"
                            },
                            {
                                "target_lang_word": "zjawa",
                                "target_lang_sense_clarification": "duch, widziadło"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "现象",
                                "target_lang_sense_clarification": "可观察到的事物"
                            },
                            {
                                "target_lang_word": "幻影",
                                "target_lang_sense_clarification": "虚幻的影像"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}