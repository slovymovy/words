                        "examples": [
                            {
                                "example_id": "f69050dc-5aec-4960-85fb-f5c85ff9a941",
                                "sense_id": "416d4191-6358-38e4-a767-8a87cbd48954",
                                "text": "Papierosy. — Papieroski? A skąd papieroski? Machlojki? Handelek? — Nie. Palę skręty. Skręty z przydziałowej machorki. — A z czego skręty? — naciskał kapitan. — Z gazet. Ze starych gazet. Z marginesów, żeby było mniej druku. O, proszę!"
                            }
                        ],
