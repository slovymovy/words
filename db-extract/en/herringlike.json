                                        "examples": [
                                            {
                                                "example_id": "2d8b0388-11d5-4f73-ab45-ed3261d3dfe8",
                                                "sense_id": "b64ff0b7-c50f-39b8-88a7-fe651a8e64c6",
                                                "text": "„Bei den Fischen dominiert der heringsähnliche Milchfisch, der naturgemäß in den tropischen Küstengewässern im Stillen und Indischen Ozean verbreitet ist.“"
                                            },
                                            {
                                                "example_id": "a4d68e6e-e3cc-482e-8eda-42622a3284eb",
                                                "sense_id": "b64ff0b7-c50f-39b8-88a7-fe651a8e64c6",
                                                "text": "„Die Laube ist ein kleiner schlanker Fisch und hat ein heringsähnliches Erscheinungsbild.“"
                                            },
                                            {
                                                "example_id": "74981c64-caef-4f15-a001-f8ebfcad3d58",
                                                "sense_id": "b64ff0b7-c50f-39b8-88a7-fe651a8e64c6",
                                                "text": "„Die Kleine Maräne ist ein heringsähnlicher Schwarmfisch, der vor allem in Seen mit sauerstoffreichem Wasser vorkommt.“"
                                            },
                                            {
                                                "example_id": "18f01639-d253-464c-95fb-e06a5e930892",
                                                "sense_id": "b64ff0b7-c50f-39b8-88a7-fe651a8e64c6",
                                                "text": "„Man nimmt an das die Hechte von heringsähnlichen Fischen abstammen und sich als spezialisierte Gruppe in Nordamerika entwickelt haben und anschließend Eurasien besiedelten.“"
                                            },
                                            {
                                                "example_id": "30b88a95-01fe-45b5-954b-1ce7de3ea432",
                                                "sense_id": "b64ff0b7-c50f-39b8-88a7-fe651a8e64c6",
                                                "text": "„Eine der wichtigsten Nutzfischarten in den westafrikanischen Ästuaren und Küstengewässern ist der sogenannte „Bonga shad“ (Ethmalosa fimbriata), eine heringsähnliche Art, die vom Senegal bis Angola in den Küstengewässern vorkommt.“"
                                            }
