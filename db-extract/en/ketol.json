                        "glosses": [
                            "A hydroxyketone (e.g., an acyloin)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6368feff-50b4-4ad1-92cc-1d756b3741b4",
                                "sense_id": "1911afc7-3e7c-3b80-a004-512bbdb99b69",
                                "text": "1962, James A. Moore, Erich Heftmann, Chapter 2: Chemistry of the adrenocortical steroids, Helen Wendler Deane, The Adrenocortical Hormones, Part 1, Springer-Verlag, page 221,\nThe 21-hydroxyl group in the α-ketol side chain is very easily esterified, and in many of the synthetic routes leading to these side chains the ketol acetate is still formed."
                            },
                            {
                                "example_id": "fb6ad43e-350d-4631-919e-5c15c8907a08",
                                "sense_id": "1911afc7-3e7c-3b80-a004-512bbdb99b69",
                                "text": "Consider the enolization (Scheme 3.26) of the methyl ester of acetoacetic acid, a reaction involving ketol-enol tautomerism."
                            },
                            {
                                "example_id": "6b1d03b2-0c11-4cc3-bf1f-ad3c37f7ff96",
                                "sense_id": "1911afc7-3e7c-3b80-a004-512bbdb99b69",
                                "text": "The steroid acetates are stable derivatives, having the desirable property that the electron-capture detector (ECD) selectively responds to acetyl derivatives of α-ketols [958]."
                            }
                        ]
                    }
