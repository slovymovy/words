                        "entry_id": "64497d25-ccd2-3921-81ca-d5990945fdeb",
                        "glosses": [
                            "Sorte d’étoffe de soie et de coton, fabriquée à l’origine à Milan. Variété de futaine à deux envers."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ed8f8afd-9fcf-47db-892e-4e38f73f7eb1",
                                "sense_id": "59c70e5b-6ef6-3dfc-a158-d23169424c37",
                                "text": "Un autre s’approche en suroît et manteau de bombasin."
                            },
                            {
                                "example_id": "e2f23e53-4f65-4980-a6a9-81c6f728044f",
                                "sense_id": "59c70e5b-6ef6-3dfc-a158-d23169424c37",
                                "text": "Il nous montre la fabrication du bombasin."
                            },
                            {
                                "example_id": "50e81faa-36b0-48db-89ad-af80cd6ff6eb",
                                "sense_id": "59c70e5b-6ef6-3dfc-a158-d23169424c37",
                                "text": "En revanche, l’escalier coulissant lui opposa une vive résistance. Elle se promit de le graisser à l’occasion et gravit les degrés dans un froufrou volontaire de bombasin noir."
                            }
                        ]
                    }
