                "senses": [
                    {
                        "sense_id": "deebdaca-fa74-30af-afb8-c5b9bf266e3f",
                        "entry_id": "d892811d-0d9f-3ebf-8cf1-c27554376f5a",
                        "glosses": [
                            "Provoquer la coagulation en utilisant le froid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6257f598-fc52-4f1b-accb-794064a46782",
                                "sense_id": "deebdaca-fa74-30af-afb8-c5b9bf266e3f",
                                "text": "Ils concluent qu'il est nécessaire de cryocoaguler la choroïde et la rétine, donc de ponctionner avant de coaguler."
                            },
                            {
                                "example_id": "fd630a21-fb26-4b0d-b952-71ae6c300a6e",
                                "sense_id": "deebdaca-fa74-30af-afb8-c5b9bf266e3f",
                                "text": "La première consiste à reprendre l'incision de départ de l'invasion épithéliale et à essayer de cryocoaguler tout le voile d'invasion épithéliale situé à la face postérieure de la cornée."
                            }
                        ]
                    }
