        "fr-extract.jsonl": [
            {
                "entry_id": "723d2ec7-9844-3a60-99e7-a9db3dfc8452",
                "word": "rondache",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c6330c33-f33d-4d98-af39-de920c586bd4",
                        "entry_id": "723d2ec7-9844-3a60-99e7-a9db3dfc8452",
                        "tags": [
                            "plural"
                        ],
                        "form": "rondaches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5599743d-35f8-3af5-919a-00284300e040",
                        "entry_id": "723d2ec7-9844-3a60-99e7-a9db3dfc8452",
                        "glosses": [
                            "Sorte de grand bouclier rond."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dedd06d8-8c70-4bc9-8633-3280b107d427",
                                "sense_id": "5599743d-35f8-3af5-919a-00284300e040",
                                "text": "Apres quoy le feu se prist à vne autre rondache de deux cens fuzees à estoiles."
                            },
                            {
                                "example_id": "9326e650-7663-4810-9995-3e92b5f99054",
                                "sense_id": "5599743d-35f8-3af5-919a-00284300e040",
                                "text": "Aussi, ayant remarqué que la voix qui me disait d’entrer n’était point celle de la suivante qui, dans mon idée, devait venir à ma rencontre, me couvrant le visage d’une petite rondache que j’avais, je dis: « Qui va là? »"
                            },
                            {
                                "example_id": "d8b643cd-9c82-4851-bc92-64616e5b4193",
                                "sense_id": "5599743d-35f8-3af5-919a-00284300e040",
                                "text": "Il combattit des Scandinaves recouverts d’écailles de poisson, des Nègres munis de rondaches en cuir d’hippopotame et montés sur des ânes rouges, des Indiens couleur d’or et brandissant par-dessus leurs diadèmes de larges sabres, plus clairs que des miroirs."
                            },
                            {
                                "example_id": "64d8ccba-4924-4628-818e-9bc6343b4082",
                                "sense_id": "5599743d-35f8-3af5-919a-00284300e040",
                                "text": "Écartant le bouclier et la rondache qui le protégeaient, il les supplia en criant qu’ils cessassent de s’en prendre aux Espagnols et leur ordonna de ne pas leur faire de mal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88048c81-023a-4cc8-88e5-6c26b3ebb566",
                        "source_entry_id": "723d2ec7-9844-3a60-99e7-a9db3dfc8452",
                        "source_sense_id": "5599743d-35f8-3af5-919a-00284300e040",
