                        "entry_id": "c3738f3c-d287-3e4b-ae26-270bd48cefee",
                        "glosses": [
                            "Polyèdre ayant vingt faces triangulaires, douze faces pentagonales et trente faces carrées."
                        ],
                        "tags": [],
