                                "sense_id": "cb1ec692-345c-3648-a056-02106c2c1a14",
                                "text": "Im Sommer trinke ich gerne einen Eiskaffee."
                            },
                            {
                                "example_id": "16b53595-5b32-4d1f-9994-01d6478a767b",
                                "sense_id": "cb1ec692-345c-3648-a056-02106c2c1a14",
                                "text": "„Der freundliche Kellner serviert den Eiskaffee mit geschütteltem Schaum direkt an der Liege in vier Variationen, als wir zurück an Land sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
