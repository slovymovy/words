                    "frequency": "Low",
                    "semantic_group_id": "domination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce dictateur impitoyable a tout fait pour <w>enchaîner</w> son peuple sous son autorité."
                        },
                        {
                            "text": "L'écrivain refuse d'<w>enchaîner</w> sa pensée à des dogmes politiques stricts."
