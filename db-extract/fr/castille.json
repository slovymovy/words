                                        "entry_id": "e23b7c12-68aa-355a-b940-785a8aeefb65",
                                        "glosses": [
                                            "Landschaft auf der zentralen Hochebene Spaniens"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "258e124e-e343-3158-a7ce-58babe63210b",
                                        "entry_id": "e23b7c12-68aa-355a-b940-785a8aeefb65",
                                        "glosses": [
                                            "Königreich in dieser Region"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deec4603-479f-402c-a208-1c42b326024d",
                                                "sense_id": "258e124e-e343-3158-a7ce-58babe63210b",
                                                "text": "„Kaum jedoch hatten Philipp und Johanna mit Unterstützung des kastilischen Adels Ferdinand dazu genötigt, ihnen die alleinige Regentschaft über Kastilien zu überlassen, starb Philipp im September 1506.“"
                                            }
