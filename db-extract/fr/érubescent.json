                            {
                                "example_id": "f9baab4a-9575-4761-b2fb-dd6427783515",
                                "sense_id": "bde3c1c2-e1b9-39bf-af1e-77eb2cf2dd68",
                                "text": "La voiture filait dans les rues de la ville sous les deux érubescents du crépuscule."
                            },
                            {
                                "example_id": "098a76ef-2a10-4f6f-ae5e-77c1efe5d7e5",
                                "sense_id": "bde3c1c2-e1b9-39bf-af1e-77eb2cf2dd68",
                                "text": "Et pourtant Barbey d'Aurevilly est un écrivain; il a la fièvre, le mot, le choc, l'étincelle, l'expression attirante, la séduction du style, un style efflorescent, érubescent, tailladé, drapé, éclatant, insolent, tourbillonnant et criard."
                            }
                        ]
