                                        "entry_id": "da376f50-310a-3e0c-83fc-dadadf5005f7",
                                        "glosses": [
                                            "sofort, ohne Aufschub, ohne schuldhaftes Zögern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57351623-60b7-4c4d-b441-8298f3f59468",
                                                "sense_id": "67d161af-779c-3488-aeb3-270367c32f07",
                                                "text": "Ich erwarte eine unverzügliche Antwort."
                                            },
                                            {
                                                "example_id": "b9553f66-f143-4b6b-9b03-7ba4a78b8f27",
                                                "sense_id": "67d161af-779c-3488-aeb3-270367c32f07",
                                                "text": "Änderungen der Einkommensverhältnisse sind dem Amt unverzüglich mitzuteilen."
                                            },
                                            {
                                                "example_id": "4e323767-3293-4643-a91f-8aae31d25b59",
                                                "sense_id": "67d161af-779c-3488-aeb3-270367c32f07",
                                                "text": "Das tritt nach meiner Kenntnis… ist das sofort, unverzüglich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7748304-e84d-4a8f-8e9b-d27c36ad3f31",
                        "source_entry_id": "bd2840ac-54cf-375f-8e39-090262a5185d",
                        "source_sense_id": "e85131f0-3723-32fa-a2ea-2ed98fe6bf9c",
                        "source_sense_description": "onmiddellijk, meteen",
                        "target_lang_word": "immediately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
