                                                "sense_id": "3276d928-bf1a-3bd6-9951-c71af26af4d4",
                                                "text": "Frankfurt ist die Metropole im Rhein-Main-Gebiet."
                                            },
                                            {
                                                "example_id": "03066818-99d8-452e-8e78-fc22f96030c8",
                                                "sense_id": "3276d928-bf1a-3bd6-9951-c71af26af4d4",
                                                "text": "„Noch am gleichen Abend ging eine Postkutsche nach Frankfurt ab.“"
                                            },
