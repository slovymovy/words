                ],
                "senses": [
                    {
                        "sense_id": "2036d866-5db4-3fc9-9b55-838f88620af4",
                        "entry_id": "cddb8505-732f-3e0f-9933-91cac9327c4a",
                        "glosses": [
                            "In a sharp manner, in various senses.",
                            "So as to terminate in a sharp point or edge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "891633f5-8304-4f78-8a0e-94022309708d",
                                "sense_id": "2036d866-5db4-3fc9-9b55-838f88620af4",
                                "text": "The stick was sharply tapered at one end."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9ccc9a2-5bae-3fa6-b3fd-74b5f5de1c27",
                        "entry_id": "cddb8505-732f-3e0f-9933-91cac9327c4a",
                        "glosses": [
                            "In a sharp manner, in various senses.",
                            "Rapidly, abruptly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e69fe5f3-c1d1-44ad-9235-6d41dc0a467a",
                                "sense_id": "d9ccc9a2-5bae-3fa6-b3fd-74b5f5de1c27",
                                "text": "When I touched the snake it recoiled sharply."
                            },
                            {
                                "example_id": "7f7e8361-6809-46a1-aa35-4b119c916872",
                                "sense_id": "d9ccc9a2-5bae-3fa6-b3fd-74b5f5de1c27",
                                "text": "The economy has slowed to a pale shadow of its growth in recent years; inflation is high, the currency is declining sharply against the dollar — but the expectations of Brazilians have rarely been higher, feeding broad intolerance with corruption, bad schools and other government failings."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ad46a13-9f48-3298-85f0-a7f114d789cb",
                        "entry_id": "cddb8505-732f-3e0f-9933-91cac9327c4a",
                        "glosses": [
                            "In a sharp manner, in various senses.",
                            "Suddenly and intensely like a gasp, but typically as the result of an emotional reaction."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4d3e0472-8d20-328e-ae13-a39872dae436",
                        "entry_id": "cddb8505-732f-3e0f-9933-91cac9327c4a",
                        "glosses": [
                            "In a sharp manner, in various senses.",
                            "Precisely, accurately."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd1b3488-16a9-443c-b166-362fe8cf96c7",
                                "sense_id": "4d3e0472-8d20-328e-ae13-a39872dae436",
                                "text": "a sharply focused essay"
                            }
                        ]
                    },
                    {
                        "sense_id": "d23c7640-3011-31cb-a164-035b251d8f30",
                        "entry_id": "cddb8505-732f-3e0f-9933-91cac9327c4a",
                        "glosses": [
                            "In a sharp manner, in various senses.",
                            "Quickly and alertly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aa008cf-a561-4cae-a83e-9a69435898f5",
                                "sense_id": "d23c7640-3011-31cb-a164-035b251d8f30",
                                "text": "Jones, the centre forward, started the game sharply."
                            },
                            {
                                "example_id": "3729e675-dc63-43ac-897c-770697912fcd",
                                "sense_id": "d23c7640-3011-31cb-a164-035b251d8f30",
                                "text": "Walters tried a long range shot in the third minute as he opened the game sharply, linking well with Robbie Keane, but goalkeeper Sergei Pareiko gathered the ball with ease."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b1c2a71-25c6-305f-8052-ce1e3b5f96d5",
                        "entry_id": "cddb8505-732f-3e0f-9933-91cac9327c4a",
                        "glosses": [
                            "In a sharp manner, in various senses.",
                            "Of speech, sternly, harshly or critically."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c3df21c-3b63-4734-b843-bfea427b9471",
                                "sense_id": "6b1c2a71-25c6-305f-8052-ce1e3b5f96d5",
                                "text": "When I asked her about her husband, she replied sharply that she had not seen him for several months."
                            },
                            {
                                "example_id": "d35fbb52-a816-4e27-a2ba-625c1af3db4c",
                                "sense_id": "6b1c2a71-25c6-305f-8052-ce1e3b5f96d5",
                                "text": "Before long Tinette stuck her head round the door, and said sharply, 'You're to go to the study.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "503e2222-d9d1-3ee5-91b6-1096d58e1d10",
                        "entry_id": "cddb8505-732f-3e0f-9933-91cac9327c4a",
                        "glosses": [
                            "In a sharp manner, in various senses.",
                            "Stylishly, smartly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "427693c3-27d3-4186-893d-a50db3887f0d",
                                "sense_id": "503e2222-d9d1-3ee5-91b6-1096d58e1d10",
                                "text": "He was sharply dressed in an expensive suit."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5b115a1-4510-3713-a03f-2208ee5bec93",
                        "entry_id": "cddb8505-732f-3e0f-9933-91cac9327c4a",
                        "glosses": [
                            "In a sharp manner, in various senses.",
                            "So as to form a sharp, or tight, angle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f9214e4-a3bf-49a7-95bb-f15f865dea0c",
                                "sense_id": "e5b115a1-4510-3713-a03f-2208ee5bec93",
                                "text": "Turn sharply to the right."
                            },
                            {
                                "example_id": "c38b3bd4-3d79-478e-9652-1188600ecdba",
                                "sense_id": "e5b115a1-4510-3713-a03f-2208ee5bec93",
                                "text": "The last 61 miles of the journey, from Kongsberg to Oslo, are through much less mountainous country. The railway curves sharply away from the Lågan^([sic]), and descends steadily, and in places steeply, past the head of Lake Fiskerumvatn to Hokksund, where the connecting line to the Bergen-Oslo Railway at Hønefoss diverges."
                            }
                        ]
                    },
                    {
                        "sense_id": "62f30725-9e41-3b91-99c7-fe89b384b31d",
                        "entry_id": "cddb8505-732f-3e0f-9933-91cac9327c4a",
                        "glosses": [
                            "In a sharp manner, in various senses.",
                            "Steeply; precipitously."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "000e0391-e45f-455a-97b2-b58433e1390c",
                                "sense_id": "62f30725-9e41-3b91-99c7-fe89b384b31d",
                                "text": "The road descends sharply."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e401e2b-82db-3fe2-8be7-27c2de1ff40f",
                        "entry_id": "cddb8505-732f-3e0f-9933-91cac9327c4a",
                        "glosses": [
                            "In a sharp manner, in various senses.",
                            "Piercingly; keenly; severely; painfully."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c97685fa-7bef-4795-8ae2-945ca9629fe1",
                                "sense_id": "3e401e2b-82db-3fe2-8be7-27c2de1ff40f",
                                "text": "His old war wound twinged sharply."
                            }
                        ]
                    },
                    {
                        "sense_id": "35d11bfd-8bd5-3eb0-96bc-5656ed8a8962",
                        "entry_id": "cddb8505-732f-3e0f-9933-91cac9327c4a",
                        "glosses": [
                            "In a sharp manner, in various senses.",
                            "In an intellectually alert and penetrating manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9778a9c5-3df3-4ebd-b24c-e21450f308d4",
                                "sense_id": "35d11bfd-8bd5-3eb0-96bc-5656ed8a8962",
                                "text": "Peter, after the manner of man at the breakfast table, had allowed half his kedgeree to get cold and was sniggering over a letter. Sophia looked at him sharply. The only letter she had received was from her mother. Sophia's mother was not a humourist."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b82a3c8-db30-31f1-bbdf-082a05e4d18c",
                        "entry_id": "cddb8505-732f-3e0f-9933-91cac9327c4a",
                        "glosses": [
                            "In a sharp manner, in various senses.",
                            "In a strongly distinguishing or differentiating manner; acutely."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe43df9c-8878-4940-b657-4c9a95f4d8f4",
                                "sense_id": "4b82a3c8-db30-31f1-bbdf-082a05e4d18c",
                                "text": "The wealth of this small country contrasts sharply with that of its neighbours."
                            },
                            {
                                "example_id": "bb0098df-2cc6-48bd-9ae0-4d7c82cc8005",
                                "sense_id": "4b82a3c8-db30-31f1-bbdf-082a05e4d18c",
                                "text": "Hynes is careful to direct the credit to his paymasters in the Scottish Government, whose ambitions for rail contrast increasingly sharply with those in Westminster."
                            }
                        ]
                    }
                ],
