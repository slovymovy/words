                            {
                                "example_id": "86a43b11-ecc1-442b-a1bf-d892d789380b",
                                "sense_id": "f1978e9b-beb1-3820-a3d9-99c69025c2c3",
                                "text": "Het slachtoffer werkte in de spoelkeuken van groothandel Makro in Hengelo in het kader van een dagbestedingsproject."
                            },
                            {
                                "example_id": "cd4a478b-756e-4be2-9cf3-7181571b4897",
                                "sense_id": "f1978e9b-beb1-3820-a3d9-99c69025c2c3",
                                "text": "„Tuurlijk. Maar ik drink tegenwoordig minder biertjes tijdens het presenteren. Ik ben gedreven, heb grote plannen. Ik denk aan dagbestedingsprojecten bij Studio 074. Zodat jongeren met een beperking hier radio kunnen maken. De Voiceboys van Aveleijn zingen nu al in mijn studio. Ik zou supertrots zijn als ik nog meer jongens en meisjes met een handicap blij kan maken met muziek.”"
                            }
                        ]
                    }
