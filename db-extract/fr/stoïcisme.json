                                        "sense_id": "40b2df25-aed5-31a2-a005-d04ea5caa94f",
                                        "entry_id": "13a897c1-006c-3b33-8550-68813af399c7",
                                        "glosses": [
                                            "A school of philosophy popularized during the Roman Empire that emphasized reason as a means of understanding the natural state of things, or logos, and as a means of freeing oneself from emotional distress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b541760b-2f40-310d-839b-b16991868daf",
                                        "entry_id": "13a897c1-006c-3b33-8550-68813af399c7",
                                        "glosses": [
                                            "A real or pretended indifference to pleasure or pain; insensibility; impassiveness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf8f39ac-771a-456d-ba80-0549918a8f8c",
                                                "sense_id": "b541760b-2f40-310d-839b-b16991868daf",
                                                "text": "Jones’ sad eyes betray a pervasive pain his purposefully spare dialogue only hints at, while the perfectly cast Brolin conveys hints of playfulness and warmth while staying true to the craggy stoicism at the character’s core."
                                            },
                                            {
                                                "example_id": "39925f7d-3d2a-4f9c-b58b-eb62c652b614",
                                                "sense_id": "b541760b-2f40-310d-839b-b16991868daf",
                                                "text": "Although very distant from the lives of her subjects – she never went to school and had only the most fleeting experiences of being on equal terms with anyone – she grew into a much respected figure, admired for her stoicism and diligence"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
