                    "sense_definition": "Предупреждение об опасности.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "warning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Кто-то крикнул <w>шуба</w> и все разбежались.",
                            "target_lang_translations": {
                                "en": "Someone shouted <w>look out</w> and everyone scattered."
                            }
                        },
                        {
                            "text": "Услышав <w>шубу</w> дети сразу прекратили игру.",
                            "target_lang_translations": {
                                "en": "Hearing the warning <w>watch out</w>, the children immediately stopped playing."
