                            {
                                "example_id": "f962dc30-1057-4afd-9980-4a1fbbe66bd1",
                                "sense_id": "949c7dc5-9fe7-3f71-abbd-6fa71cc6a4aa",
                                "text": "Bring your snuggies when visiting Yellowstone Country in any season. Just because it's July doesn't mean you can leave your longjohns, sweatshirts and windbreakers at home."
                            },
                            {
                                "example_id": "84ddf386-329a-43cf-9570-edf735111ee8",
                                "sense_id": "949c7dc5-9fe7-3f71-abbd-6fa71cc6a4aa",
                                "text": "Not because of her totally fleshless legs, but because she was wearing red snuggies when it was actually pretty hot weather. Lina partly lowered the snuggies and extracted a quart of Spur."
                            },
                            {
                                "example_id": "09e92ab9-3b73-4a05-872d-9e6e6e0a5e77",
                                "sense_id": "949c7dc5-9fe7-3f71-abbd-6fa71cc6a4aa",
                                "text": "Hilda said, \"Wait, you don't mind, I want to pick up a few pairs of snuggies, it's getting miserably cold, I won't have to come back ...\""
                            }
                        ]
                    }
