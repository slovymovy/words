                        "sense_id": "208a1e6b-52a1-32c0-8da6-3f47baf6c562",
                        "entry_id": "d49aeeba-a055-3a97-8f8a-23f0ffe0361a",
                        "glosses": [
                            "Licht, wie es im Sommer vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2accf6fb-a01f-4bed-8fd0-d14220839d02",
                                "sense_id": "208a1e6b-52a1-32c0-8da6-3f47baf6c562",
                                "text": "„Jedenfalls strahlte er jetzt, seine Züge jung und unbekümmert im goldgelben Sommerlicht, sodass ich nichts anderes mehr sehen konnte.“"
                            },
                            {
                                "example_id": "7be14b53-3288-42fe-9a1f-aae6c548f886",
                                "sense_id": "208a1e6b-52a1-32c0-8da6-3f47baf6c562",
                                "text": "„Klares Wetter, Sommerlicht sickerte durch die Scheibe, und Björgvin hielt sich den Schädel, als sei er in tiefen Gedanken, dabei hatte er einen solchen Kater, dass die schrille Stimme seiner Frau ihn wie mit glühenden Nadeln ins Gehirn stach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
