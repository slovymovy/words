                                "target_senses": [
                                    {
                                        "sense_id": "9e53c630-a1d9-3d41-ad4f-ff201c622090",
                                        "entry_id": "0e06196e-843f-357e-a67a-8cd20dcbe03b",
                                        "glosses": [
                                            "плывя по воде"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "664535eb-aef6-4474-bd1f-899d197686b0",
                                                "sense_id": "9e53c630-a1d9-3d41-ad4f-ff201c622090",
                                                "text": "Переправа через широкие реки могла бы одна потребовать тома: иногда вброд по гребню камней водопада, ревущего под ногами, иногда в берестяном челне, плавя сзади коней, готовых его опрокинуть, иногда на срубленной сосне, иногда вплавь, неожиданно сорвавшись или с размытого мостика, или обманутый бродом."
                                            },
                                            {
                                                "example_id": "0ef500ea-f3e4-4198-ae35-fb4e20fab720",
                                                "sense_id": "9e53c630-a1d9-3d41-ad4f-ff201c622090",
                                                "text": "Там, где вплавь на лодке едва перебирались, ― на телегах поехали― и грунт ничего себе, держал."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
