                        "translation_id": "a218c125-905d-412c-9c7d-6dca20bc2af8",
                        "source_entry_id": "6bdf6b80-fc5e-30a0-be55-d6d55e2e431d",
                        "source_sense_id": "8b6be9e3-e61a-3d2d-8d88-2c235c8ecb71",
                        "target_lang_word": "prosody",
