                "senses": [
                    {
                        "sense_id": "4d39551b-964b-3a8f-a4c1-2eb7d0590a4d",
                        "entry_id": "5b7271e2-a014-3ffd-a112-b4dcd63d55d4",
                        "glosses": [
                            "iemand die met toestemming van de achterban beslissingen mag maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38c86496-5149-452a-b242-1e17dc6b08d8",
                                "sense_id": "4d39551b-964b-3a8f-a4c1-2eb7d0590a4d",
                                "text": "Met de 74-jarige Linard komt er een tussenpaus aan het hoofd van de KBVB, aangezien een mandataris volgens de interne reglementen niet ouder mag zijn dan 75 jaar. De kans is reëel dat er volgend jaar opnieuw een andere voorzitter verkozen moet worden. \"Dat zal afhangen van de ontwikkeling, maar ik houd me aan mijn mandaat."
                            },
                            {
                                "example_id": "a80d4c1e-9460-4060-8257-84ea3181a79c",
                                "sense_id": "4d39551b-964b-3a8f-a4c1-2eb7d0590a4d",
                                "text": "Soms zou een mens willen dat vervroegde presidentsverkiezingen ook in de VS mogelijk waren. Sinds Bush in november 2006 de verkiezingen voor het Congres verloor, is hij dagelijks machtelozer. Hoe eerder er weer een mandataris in het Witte Huis resideert, hoe beter. Feit is echter dat dit moment nog vierenhalve maand op zich laat wachten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f150a2b-68e5-4326-9e28-6f10b24cc46e",
                        "source_entry_id": "5b7271e2-a014-3ffd-a112-b4dcd63d55d4",
                        "source_sense_id": "4d39551b-964b-3a8f-a4c1-2eb7d0590a4d",
                        "source_sense_description": "(politiek) iemand die met toestemming van de achterban beslissingen mag maken",
                        "target_lang_word": "representative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "representative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62a05f84-79b1-3a9b-a8b6-3802be6f743b",
                                        "entry_id": "fbee92cf-d622-3548-b7bd-00fe447aed53",
                                        "glosses": [
                                            "Typical; having the same properties or interest as a larger group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a81a0e73-46f9-4fc4-a87a-daea278d9b48",
                                                "sense_id": "62a05f84-79b1-3a9b-a8b6-3802be6f743b",
                                                "text": "THE POCKET ENCYCLOPAEDIA OF BRITISH STEAM LOCOMOTIVES. By O. S. Nock. Blandford Press. 18s.\nMr. Nock, he remarks in his preface, was \"incredulous\" when the idea of this book of 192 colour gravure illustrations of a representative collection of British steam locomotives from Locomotion to BR's Evening Star was broached to him."
                                            },
                                            {
                                                "example_id": "8ccd0fba-d4bb-48a7-88d4-40c1b1a9de2a",
                                                "sense_id": "62a05f84-79b1-3a9b-a8b6-3802be6f743b",
                                                "text": "If you took all the fools out of the legislature, it wouldn't be a representative body anymore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cf271d3-8fbe-3868-9f8e-602fb34c7d14",
                                        "entry_id": "fbee92cf-d622-3548-b7bd-00fe447aed53",
                                        "glosses": [
                                            "Representing, showing a likeness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb42caea-004d-42be-86c0-052ad0901eab",
                                                "sense_id": "5cf271d3-8fbe-3868-9f8e-602fb34c7d14",
                                                "text": "Are you sure this paper is representative of your child's writing?"
                                            },
                                            {
                                                "example_id": "aa812649-b110-43dd-8585-cda95afc54e1",
                                                "sense_id": "5cf271d3-8fbe-3868-9f8e-602fb34c7d14",
                                                "text": "the representative faculty of the human imagination"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "representative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c6ce16b-75a1-3a33-8085-371e8cc0f1c6",
                                        "entry_id": "060bb137-e739-3c7d-8a68-685dfa0d194c",
                                        "glosses": [
                                            "A delegate.",
                                            "Someone who represents others as a member of a legislative or governing body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccfbbce3-a2f7-4d90-b6a0-7343a9adac90",
                                                "sense_id": "5c6ce16b-75a1-3a33-8085-371e8cc0f1c6",
                                                "text": "She served four terms as representative of her local at the national union convention."
                                            },
                                            {
                                                "example_id": "98c3b7af-c7f1-4362-9f9e-6bf4c2fe5b6b",
                                                "sense_id": "5c6ce16b-75a1-3a33-8085-371e8cc0f1c6",
                                                "text": "Each vessel in the Fleet has the right to send representatives to the Conclave aboard the flagship. The number of representatives is based on crew size. Larger clans, with bigger ships and more votes, form the cores of political blocs. Opposition comes from the Outriders' Coalition, with delegates from thousands of smaller ships."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "693701ef-5999-381d-ac7f-f47ff12f0449",
                                        "entry_id": "060bb137-e739-3c7d-8a68-685dfa0d194c",
                                        "glosses": [
                                            "A delegate.",
                                            "One who speaks for or acts on behalf of another in a particular (especially official) capacity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d62f3c44-785b-4753-b190-17c8fa8ef06f",
                                                "sense_id": "693701ef-5999-381d-ac7f-f47ff12f0449",
                                                "text": "I will send a representative to work out the details of the contract."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8db6edf1-2774-365d-85a0-de177cf3883f",
                                        "entry_id": "060bb137-e739-3c7d-8a68-685dfa0d194c",
                                        "glosses": [
                                            "A delegate.",
                                            "An heir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ffe5021-8388-4490-b1a7-a7cd14468e8b",
                                                "sense_id": "8db6edf1-2774-365d-85a0-de177cf3883f",
                                                "text": "This pathetic remonstrance had the desired effect upon his representative, who spared no pains to fulfill the request of the deceased […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c96b5f77-86c6-3ff0-8779-30b9916a39c6",
                                        "entry_id": "060bb137-e739-3c7d-8a68-685dfa0d194c",
                                        "glosses": [
                                            "A delegate.",
                                            "Specifically, a member of the United States House of Representatives."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4473b42c-9a73-4bfb-8952-ca09267892dc",
                                                "sense_id": "c96b5f77-86c6-3ff0-8779-30b9916a39c6",
                                                "text": "All representatives face re-election every two years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cadb020-8f62-3b73-b89f-fcacd18befbe",
                                        "entry_id": "060bb137-e739-3c7d-8a68-685dfa0d194c",
                                        "glosses": [
                                            "A delegate.",
                                            "A company agent who visits potential purchasers; a salesman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aca066e0-5338-322d-a399-2b0009b809ac",
                                        "entry_id": "060bb137-e739-3c7d-8a68-685dfa0d194c",
                                        "glosses": [
                                            "Something standing for something else.",
                                            "Something representing or standing for another; a symbol, an embodiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1debaedc-0b39-44c1-82b3-c5381f3d6737",
                                                "sense_id": "aca066e0-5338-322d-a399-2b0009b809ac",
                                                "text": "The furniture was the same when she married..[ ]..The only representatives of to-day, were two large and comfortable arm-chairs, and a few elegant-looking trifles, the work of the Misses Granard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5fa632c-3361-369b-a920-a66ec9f12729",
                                        "entry_id": "060bb137-e739-3c7d-8a68-685dfa0d194c",
                                        "glosses": [
                                            "Something standing for something else.",
                                            "A member of a particular class."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d769ca4-1d38-4b1a-b593-7a7896e972c3",
                                                "sense_id": "e5fa632c-3361-369b-a920-a66ec9f12729",
                                                "text": "The USS Manila Bay, in the next group south of Taffy 3, services aircraft from eleven different squadrons that aren't attached to her own flight group, and, at one point, has representatives from no less than four other carriers' airgroups on her flight deck at the same time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db73e271-64eb-3b6d-8aa8-5bfcf0a1bbfd",
                                        "entry_id": "060bb137-e739-3c7d-8a68-685dfa0d194c",
                                        "glosses": [
                                            "Something standing for something else.",
                                            "A member of a particular class.",
                                            "Something (especially a living organism) regarded as typical of its class; a type."
                                        ],
