                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef103634-9bdc-481c-bfc6-fba7b78eb8a6",
                                                "sense_id": "9fc9c633-4428-332c-8db0-779621abb178",
                                                "text": "Le froid était peut-être un peu moins vif, mais l’humidité de l’atmosphère fut extrême. Malgré toutes les précautions prises, cette humidité pénétrait dans la maison, et, chaque matin, les condensateurs que l’on vidait renfermaient plusieurs livres de glace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80a0d021-68c7-37bd-9a16-c1bfdebe4c4d",
                                        "entry_id": "cd183b6d-5c1f-3aca-9138-88cda720af8b",
                                        "glosses": [
                                            "Instrument disposé de manière que l’électricité s’y accumule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61f700ed-5931-4cf3-ad9f-b279b1b72d4f",
                                                "sense_id": "80a0d021-68c7-37bd-9a16-c1bfdebe4c4d",
                                                "text": "L'électricité règne tout le temps. Elle vibre jour et nuit, elle chantonne son chant d'abeilles, elle tournoie sur elle-même à l'intérieur des condensateurs grands comme des églises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb6b1c31-a03b-3779-b295-bafa9da52d65",
                                        "entry_id": "cd183b6d-5c1f-3aca-9138-88cda720af8b",
                                        "glosses": [
                                            "Appareil qui accumule les efforts successifs d’un moteur, pour les dépenser ensuite selon le besoin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f175bc2-d6ad-43bb-95c5-1ee49cd3eb95",
                                                "sense_id": "fb6b1c31-a03b-3779-b295-bafa9da52d65",
                                                "text": "Condensateur de forces."
