                ],
                "senses": [
                    {
                        "sense_id": "62d801ec-6124-3534-8d92-cdf87ca7aabf",
                        "entry_id": "0fc6b679-857e-3766-be9d-f0bf640d2fbd",
                        "glosses": [
                            "Lüftung, die dem Abführen von Wrasen aus Küchenräumen dient"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "c32af225-1511-4d56-9856-c687be6768c8",
                                "sense_id": "62d801ec-6124-3534-8d92-cdf87ca7aabf",
                                "text": "VDI 2052 - Küchenabluftanlage, bezieht sich auf Küchen die mehr als 25 KW Leistung erbringen. Diese sollen den flammen-durchschlag in angrenzende Teile der Küchenabluftanlage verhindern."
                            },
                            {
                                "example_id": "44e56341-16cb-4fe8-91df-c2383c84fbf9",
                                "sense_id": "62d801ec-6124-3534-8d92-cdf87ca7aabf",
                                "text": "„Unzulänglich gereinigte Küchenabluftanlagen sind oft die Ursache für gefährliche Fettbrände, die Unfälle mit schweren Personen- und Sachschäden zur Folge haben können.“"
                            },
                            {
                                "example_id": "caca4939-1b89-4038-8264-233beb4e56b5",
                                "sense_id": "62d801ec-6124-3534-8d92-cdf87ca7aabf",
                                "text": "„Küchenabluftanlagen müssen mit wirksamen Aerosolabscheidern ausgerüstet sein.“"
                            },
                            {
                                "example_id": "f23f7d3b-1aed-4fa4-83aa-c8c0372fb333",
                                "sense_id": "62d801ec-6124-3534-8d92-cdf87ca7aabf",
                                "text": "„Die Richtlinien VDI 2052 und die ZH 1/37 der Berufsgenossenschaft schreiben bei einer Fettbelastung mindestens eine jährliche Küchenabluftreinigung vor und zusätzlich eine halbjährige Kontrolle der Küchenabluftanlage.“"
                            },
                            {
                                "example_id": "7e096add-3cbb-4147-ac63-a337ee88e129",
                                "sense_id": "62d801ec-6124-3534-8d92-cdf87ca7aabf",
                                "text": "„Ein wichtiger Aspekt bei dem Bau einer Küchenabluftanlage ist der Brandschutz.“"
                            },
                            {
                                "example_id": "a0053eec-b91a-44e3-a920-a38d4b137aef",
                                "sense_id": "62d801ec-6124-3534-8d92-cdf87ca7aabf",
                                "text": "„Der Lüftungskanal in einer Küchenabluftanlage unterliegt ganz besonderen Anforderung.“"
                            },
                            {
                                "example_id": "bb36cbb8-3f9d-477a-86a8-c329a96f638d",
                                "sense_id": "62d801ec-6124-3534-8d92-cdf87ca7aabf",
                                "text": "„Jedoch ist trotz Kontrollen durch Kaminkehrer oder Gewerbeaufsichtsamt letztendlich immer der Betreiber für den einwandfreien Zustand seiner Küchenabluftanlage verantwortlich (Gerichtsurteil durch Bundesgerichtshof mit AZ.: VI ZR 11/87 vom 2. Feb. 1988).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
