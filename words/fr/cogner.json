    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "34792020-fc30-3b79-803c-972da73e1a06",
                    "sense_definition": "Donner des coups avec force ou violence ; heurter vivement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'homme en colère a commencé à <w>cogner</w> sur la table pour attirer notre attention."
                        },
                        {
                            "text": "Avant d'entrer dans la pièce, n'oublie pas de <w>cogner</w> à la porte."
                        }
                    ],
                    "synonyms": [
                        "frapper",
                        "battre",
                        "taper"
                    ],
                    "common_phrases": [
                        "cogner à la porte",
                        "cogner dessus"
                    ]
                },
                {
                    "sense_id": "e06c089c-d364-34be-a99c-1cfca05f84c9",
                    "sense_definition": "Heurter involontairement un obstacle ou se blesser lors d'un choc.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais attention en traversant le couloir sombre pour ne pas te <w>cogner</w> le genou."
                        },
                        {
                            "text": "L'enfant distrait s'est brutalement <w>cogné</w> contre la vitre transparente."
                        }
                    ],
                    "synonyms": [
                        "heurter",
                        "buter"
                    ],
                    "common_phrases": [
                        "se cogner la tête"
                    ]
                },
                {
                    "sense_id": "37b320b8-a8a9-3bb6-be3d-a9c1c82b7192",
                    "sense_definition": "Battre avec force et précipitation, en parlant du cœur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pulsation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette montée épuisante, son cœur <w>cognait</w> violemment dans sa poitrine."
                        },
                        {
                            "text": "Sous l'effet d'une peur soudaine, je sentais mes tempes et mon cœur <w>cogner</w> sans répit."
                        }
                    ],
                    "synonyms": [
                        "palpiter",
                        "battre"
                    ],
                    "common_phrases": [
                        "le cœur qui cogne"
                    ]
                },
                {
                    "sense_id": "bedc183e-b4aa-30a6-8350-c38195dab67e",
                    "sense_definition": "Dégager une odeur très forte, désagréable et nauséabonde.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "odeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ouvre immédiatement la fenêtre de la cuisine car cette vieille poubelle <w>cogne</w> vraiment."
                        },
                        {
                            "text": "Après la séance de sport, l'air confiné du vestiaire <w>cognait</w> de façon insupportable."
                        }
                    ],
                    "synonyms": [
                        "empester",
