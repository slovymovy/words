                        "examples": [
                            {
                                "example_id": "c3c26712-8801-4f8f-9b8a-135c713ac379",
                                "sense_id": "35115672-37d5-30f3-942c-698d72fa0e21",
                                "text": "Anglik oznajmił urzędnikowi, że sam pomówi z maharadżą i wyszedł razem z chłopcem"
