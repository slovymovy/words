                ],
                "translations": [
                    {
                        "translation_id": "ae7241af-4451-42ab-9542-bb4ae69a4628",
                        "source_entry_id": "a4310330-92b2-33c9-b89f-a870f89fd4ad",
                        "target_lang_word": "seventh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seventh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "faba3c1f-365f-37fd-84fb-2dca2dcf1667",
                                        "entry_id": "d09a1fab-88b5-3549-8b8c-038f13c891e0",
                                        "glosses": [
                                            "The ordinal form of the number seven."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c20c7c51-a5a9-499a-ac57-54f80978e0cf",
                                                "sense_id": "faba3c1f-365f-37fd-84fb-2dca2dcf1667",
                                                "text": "Sozomenus who wrote above twelve hundred years agoe, in his Seaventh Book relates from his own knowledge, that in the Churches of Cyprus and Arabia (places neer to Jeruſalem, and with the firſt frequented by Apoſtles) they had Biſhops in every Village ; and what could thoſe be more then Preſbyters?"
                                            },
                                            {
                                                "example_id": "2c495e1b-8d45-47a9-aa65-b0db415d856d",
                                                "sense_id": "faba3c1f-365f-37fd-84fb-2dca2dcf1667",
                                                "text": "[H]e, a lollard indeed over his elbovv-cuſhion, in almoſt the ſeaventh part of 40. or 50. years teaches them ſcarce half the principles of religion; and his ſheep oft-times ſit the vvhile to as little purpoſe of benifiting as the ſheep in thir pues at Smithfield; […]"
                                            },
                                            {
                                                "example_id": "eb40a4ee-0d2b-44fa-a095-0f8c83a99fe3",
                                                "sense_id": "faba3c1f-365f-37fd-84fb-2dca2dcf1667",
                                                "text": "[T]he law codes drafted in Athens in the late seventh and early sixth centuries were the work of individuals, Drakon and then Solon."
                                            },
                                            {
                                                "example_id": "7a5d10ce-1a26-4174-9e8a-74b32ef66a51",
                                                "sense_id": "faba3c1f-365f-37fd-84fb-2dca2dcf1667",
                                                "text": "Intel usually brings out a new generation of processors every 12-18 months, and the Core range is now in its seventh generation."
                                            },
                                            {
                                                "example_id": "f41aa12f-f4f6-4e67-9905-bed77eeb35d6",
                                                "sense_id": "faba3c1f-365f-37fd-84fb-2dca2dcf1667",
                                                "text": "Consequently, in the initial position the white pieces and pawns are placed on the first and second ranks; the black pieces and pawns on the eighth and seventh ranks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "seventh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bbbb09a-1f84-34d2-8b76-38840fef8222",
                                        "entry_id": "f190cc3f-405e-3847-bdd0-36a3ab8b8583",
                                        "glosses": [
                                            "The person or thing in the seventh position."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "446405dc-8a47-376a-9079-69d7b8680bcf",
                                        "entry_id": "f190cc3f-405e-3847-bdd0-36a3ab8b8583",
                                        "glosses": [
                                            "One of seven equal parts of a whole."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b68db4e0-33cb-362a-8859-e6b16e6b8f86",
