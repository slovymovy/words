                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bb8894e-236d-476a-9d3f-7a10ac1207b7",
                                "sense_id": "2aa66ec9-2c63-3ad4-b103-aea193d2c5ce",
                                "text": "„Die Straße hinter der etwas größeren Stadt am Harzrand führte in die Berge hinauf, durch ein dunkles Tal, das von steil aufragenden Fichtenwänden gesäumt war.“"
                            },
                            {
                                "example_id": "003d2cf6-36a6-490e-a98c-a6a93a1a67e3",
                                "sense_id": "2aa66ec9-2c63-3ad4-b103-aea193d2c5ce",
                                "text": "„Leider war er nicht mehr dazu gekommen, den Sold auch auszuzahlen, inzwischen hatten Vorauseinheiten der Amerikaner die Harzränder längst besetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
