                                "sense_id": "e5509864-0935-3337-aaca-539a5b4f6164",
                                "text": "Dieses Jahr ist am 21. März der Frühlingsbeginn."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a96ea762-44a5-393f-8305-74cc6fe36943",
