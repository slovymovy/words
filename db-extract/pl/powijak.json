                        "target_lang_word": "maillot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maillot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7bdf015-50b0-3916-8ebc-ea63bb249640",
                                        "entry_id": "6dd0e027-801a-3f9c-92ee-083cc29578af",
                                        "glosses": [
                                            "Lange dont on enveloppe un enfant au berceau."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d2feeec-e7fc-430f-a62a-632c636afcb9",
                                                "sense_id": "f7bdf015-50b0-3916-8ebc-ea63bb249640",
                                                "text": "Elle le serrait en le berçant entre ses bras, le calmant comme on calme les enfants au maillot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca584a83-7ef4-35bb-a5e4-fe24db7e6055",
                                        "entry_id": "6dd0e027-801a-3f9c-92ee-083cc29578af",
                                        "glosses": [
                                            "Vêtement souple qui couvre et moule le corps en totalité ou jusqu'à la taille et qui se porte à même la peau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fd522d4-cd88-46cb-8c3c-2b5031136354",
                                                "sense_id": "ca584a83-7ef4-35bb-a5e4-fe24db7e6055",
                                                "text": "Un maillot de danseuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d284b229-a42a-35ed-9159-25a6e586131a",
                                        "entry_id": "6dd0e027-801a-3f9c-92ee-083cc29578af",
                                        "glosses": [
                                            "Vêtement de bain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ecef72c-fbd8-4e21-8fdd-b42e27e95448",
                                                "sense_id": "d284b229-a42a-35ed-9159-25a6e586131a",
                                                "text": "Partout des photos d’Isabel en costume de scène ou dans des maillots hypersexys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48afea05-5151-3e12-b660-335f7352a8aa",
                                        "entry_id": "6dd0e027-801a-3f9c-92ee-083cc29578af",
                                        "glosses": [
                                            "Vêtement ne couvrant que le haut du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c81d8dba-2634-4f3e-9c5a-0cbfc296124b",
                                                "sense_id": "48afea05-5151-3e12-b660-335f7352a8aa",
                                                "text": "Dans le lot de chandails à manches courtes, il y en a un que j'ai pris expressément pour toi. Elle le présenta. C'était un maillot plus grand que les autres, de couleur noire, et en lettres colorées, le nom de la ville « Montréal » était inscrit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eb0fdf1-a16e-3ea3-b8b1-aa0a6cfc89ee",
                                        "entry_id": "6dd0e027-801a-3f9c-92ee-083cc29578af",
                                        "glosses": [
                                            "Maillot de corps : sous-vêtement couvrant le haut du corps, tricot de peau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8459e81b-0841-3287-9c26-ad7d5647df95",
                                        "entry_id": "6dd0e027-801a-3f9c-92ee-083cc29578af",
                                        "glosses": [
                                            "Poils du pubis visibles sur les cuisses."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b28af297-ddc8-445f-85fb-c4602190c2db",
                                                "sense_id": "8459e81b-0841-3287-9c26-ad7d5647df95",
                                                "text": "Se faire épiler le maillot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4ab3309-681e-4f86-a89b-d809e9f8e9ac",
                        "source_entry_id": "2b98372a-9316-36b5-bc9f-41e49786891c",
                        "source_sense_id": "2ad4de8b-29a3-32df-9d98-b110172ea684",
                        "target_lang_word": "lange",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lange",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71909b36-d389-33f3-9106-dbf9ddcda449",
                                        "entry_id": "2e4136ca-4a53-35c4-ba65-d02efa891c64",
                                        "glosses": [
                                            "Morceau d’étoffe de laine ou de coton dont on enveloppait les enfants au berceau."
                                        ],
                                        "tags": [
                                            "Puériculture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f02d02dc-80b0-4c1d-a96a-da2fd9a5f1a7",
                                                "sense_id": "71909b36-d389-33f3-9106-dbf9ddcda449",
                                                "text": "Un lange de molleton, de piqué."
                                            },
                                            {
                                                "example_id": "98844fe3-ea6f-4282-bd3c-860d4130e866",
                                                "sense_id": "71909b36-d389-33f3-9106-dbf9ddcda449",
                                                "text": "Cet enfant est trop serré dans ses langes."
                                            },
                                            {
                                                "example_id": "9ae6a0d8-2e0a-4fb6-84d8-42722ddeba26",
                                                "sense_id": "71909b36-d389-33f3-9106-dbf9ddcda449",
                                                "text": "« Mais, d’abord, il faut te dire que tu n’avais pas de langes ; si je t’ai parlé quelquefois de langes, c’est par habitude et parce que les enfants de chez nous sont emmaillotés. Toi, tu n’étais pas emmailloté ; au contraire tu étais habillé."
                                            },
                                            {
                                                "example_id": "b25b73c0-c7f8-4d48-9fa3-8725a6d37bd2",
                                                "sense_id": "71909b36-d389-33f3-9106-dbf9ddcda449",
                                                "text": "Ils se penchèrent ensemble pour voir un de ces majestueux paysages pleins de neige, de glaciers, d’ombres grises qui teignent les flancs de montagnes fantastiques ; […]; magnifiques langes dans lesquels renaît le soleil, beau linceul où il expire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54bf09dc-9ed0-3c03-905a-e7a1bc413890",
                                        "entry_id": "2e4136ca-4a53-35c4-ba65-d02efa891c64",
                                        "glosses": [
                                            "Couche. (Linge ou bande absorbante à l’usage des enfants.)"
                                        ],
                                        "tags": [
                                            "Suisse",
                                            "Belgique",
                                            "Puériculture"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32d7c064-b747-313c-9089-e9ca1c773e0d",
                                        "entry_id": "2e4136ca-4a53-35c4-ba65-d02efa891c64",
                                        "glosses": [
                                            "Dans les anciennes usines de papier, pièce de serge ou de drap sur lesquelles on versait la pâte à papier."
                                        ],
                                        "tags": [
                                            "Papeterie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
