                            }
                        },
                        {
                            "text": "Hij zocht naar manieren om zijn eigen <w>deeg</w> te vergroten binnen het bedrijf.",
                            "target_lang_translations": {
                                "en": "He looked for ways to increase his own <w>profit</w> within the company."
                            }
