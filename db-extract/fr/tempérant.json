                ],
                "senses": [
                    {
                        "sense_id": "9a7c94d8-ebb3-3aad-ac24-105af85a6659",
                        "entry_id": "88687a68-c529-3551-9afd-f08dfaaaed3a",
                        "glosses": [
                            "Qui permet de tempérer, de modérer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9821833-4ddd-43c3-84cd-930d5a2b9a9e",
                                "sense_id": "9a7c94d8-ebb3-3aad-ac24-105af85a6659",
                                "text": "C’est un homme fort tempérant."
                            },
                            {
                                "example_id": "3826b2f2-0cfb-4fb2-8bdd-e6acc3b58d4c",
                                "sense_id": "9a7c94d8-ebb3-3aad-ac24-105af85a6659",
                                "text": "L’homme tempérant est celui qui règle, qui modère ses appétits suivant la droite raison."
                            },
                            {
                                "example_id": "fb743bef-19a4-4395-a934-c948a4fa3935",
                                "sense_id": "9a7c94d8-ebb3-3aad-ac24-105af85a6659",
                                "text": "Si mon corps, cette brute ! désirait boire, au risque d’en mourir, mon esprit savait, lui, comment une simple gorgée d’alcool fauche les jambes d’un homme fatigué. Non ! tempérant jusqu’au bout… et fort… et jeune… Je vainquis la brute !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "0b5d335e-aa36-3140-99e7-da6678ea5e44",
