                                                "example_id": "ed49f119-8964-44aa-abb7-d59d44bc8035",
                                                "sense_id": "af09d260-47bd-38b7-8114-7f0ee53f063f",
                                                "text": "Morgan Freeman was the narrator of March of the Penguins."
                                            }
                                        ]
