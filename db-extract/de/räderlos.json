                ],
                "senses": [
                    {
                        "sense_id": "1aa85d93-901b-3ea9-a3f2-0fbfda19c211",
                        "entry_id": "d600f37f-03e4-3522-ab6d-f33dcdc018d4",
                        "glosses": [
                            "keine Räder (mehr) aufweisend, ohne Rad/Räder"
                        ],
                        "tags": [
                            "von Fahrzeugen"
                        ],
                        "examples": [
                            {
                                "example_id": "f158f783-221f-4c28-b1ba-1d4f09d18094",
                                "sense_id": "1aa85d93-901b-3ea9-a3f2-0fbfda19c211",
                                "text": "„Wenn der Pflug zu den Rücken hinaufgeht, so greift er kaum ein, und geht er zur Furche herab, so faßt er zu tief. Mit einem räderlosen Pfluge kann ein aufmerksamer Pflugführer mittelst der langen Sterzen, ohne erhebliche Kraftanstrengung, dies völlig vermeiden, und eine völlig gleiche Furche auspflügen.“"
                            },
                            {
                                "example_id": "c24d494a-6bcf-4328-9a95-85d268ea9e23",
                                "sense_id": "1aa85d93-901b-3ea9-a3f2-0fbfda19c211",
                                "text": "„‚Rohrbahn‘ stand auf dem Reichspatent Nr. 643316, mit dem sich Hermann Kemper im Sommer 1934 seine Erfindung schützen ließ: Ein räderloses Fahrzeug, das mittels magnetischer Felder bewegt wird. Die Rohrbahn sorgt noch heute für Furore.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3615737-bac4-4b9a-9612-b4e921d174d6",
