                                    },
                                    {
                                        "sense_id": "0ffe565f-a017-3ff3-af00-aef33cf75765",
                                        "entry_id": "4aa30fd3-99f4-3b92-86ae-06be7d7fba77",
                                        "glosses": [
                                            "The Catalan Countries: A cultural area in northeast Spain, southern France and Andorra where Catalan is or historically was spoken, including the autonomous communities of Catalonia and the Balearic Islands, part of the autonomous community of Valencia, the Aragon Strip, the Carche in Murcia and the region of Northern Catalonia in France."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afe2f83e-ed93-30d8-b672-69999ad4c7ff",
                                        "entry_id": "4aa30fd3-99f4-3b92-86ae-06be7d7fba77",
                                        "glosses": [
                                            "A former principality in modern northeast Spain, approximately coincident with the current autonomous community of Catalonia but including Northern Catalonia in modern France."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
