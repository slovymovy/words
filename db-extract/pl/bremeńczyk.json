                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bremer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df179eb7-17ae-3b3d-b6fa-56624c0c6f5e",
                                        "entry_id": "9ddf4fb8-7b67-33b5-adcf-2042bba951de",
                                        "glosses": [
                                            "ein im Bremen (Deutschland) geborener oder dort auf Dauer lebender Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d34007ed-fb8a-4d20-a547-d50bc6827ad0",
                                                "sense_id": "df179eb7-17ae-3b3d-b6fa-56624c0c6f5e",
                                                "text": "„… die ihn bei einem Frühstück zu dritt in der Böttcherstraße geradeheraus fragte: was ihn so für Bremen einnehme? Heidegger, schmunzelnd: ›Das kann Ihnen ein Bremer besser sagen. Nun, Petzet?‹“"
                                            },
                                            {
                                                "example_id": "77c947bb-15ec-46e5-a1d4-b003c2a521b3",
                                                "sense_id": "df179eb7-17ae-3b3d-b6fa-56624c0c6f5e",
                                                "text": "Was, du bist Bremer?"
                                            },
                                            {
                                                "example_id": "662ee3e5-6033-4a0e-85dd-4ffcce3545f6",
                                                "sense_id": "df179eb7-17ae-3b3d-b6fa-56624c0c6f5e",
                                                "text": "Seit 1989 ist Gerald ein Bremer."
                                            },
                                            {
                                                "example_id": "7012f4f6-729d-4909-8932-cb71cb5f775f",
                                                "sense_id": "df179eb7-17ae-3b3d-b6fa-56624c0c6f5e",
                                                "text": "Im Urlaub haben wir eine Familie aus waschechten Bremern getroffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e5aca2c1-3b8b-3e50-8517-368fc49d6fac",
                                        "entry_id": "9ddf4fb8-7b67-33b5-adcf-2042bba951de",
                                        "glosses": [
                                            "ein mit einer Fischfrikadelle, Ketchup und Röstzwiebeln belegtes Brötchen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bremer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc60d6f9-547c-37b7-b7d8-16f34c2dd854",
                                        "entry_id": "fb5dc992-1f8e-348b-b606-ca3a23307a56",
                                        "glosses": [
                                            "aus Bremen kommend, Bremen betreffend, zu Bremen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c290b99-107e-4041-9aa1-c493670fcdb2",
                                                "sense_id": "cc60d6f9-547c-37b7-b7d8-16f34c2dd854",
                                                "text": "„Von nun an getrauten sich die Räuber nicht weiter in das Haus, den vier Bremer Stadtmusikanten gefiel’s aber so wohl darin, daß sie nicht wieder herauswollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
