                "senses": [
                    {
                        "sense_id": "b7976cee-ed53-3a83-8dee-1b5f67f064ee",
                        "entry_id": "96d94bbc-7013-3e32-8f13-faf858bbebe0",
                        "glosses": [
                            "Minéral niobifère, hydrofluorooxyde naturel de sodium, calcium et niobium, à cristaux plus ou moins bruns."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f882c732-5a39-4274-9ba8-f3ae4e8c3428",
                                "sense_id": "b7976cee-ed53-3a83-8dee-1b5f67f064ee",
                                "text": "Le pyrochlore est un minéral cubique qui forme avec le microlite une solution solide du pôle niobium (pyrochlore) au pôle tantale (microlite)."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7c40232-9799-3957-8905-81437f7531d3",
                        "entry_id": "96d94bbc-7013-3e32-8f13-faf858bbebe0",
                        "glosses": [
                            "Groupe de minéraux comprenant le pyrochlore au sens strict et d’autres minéraux, comme le microlite, contenant des proportions importantes de tantale, d’uranium, de terres rares."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "95a1a54f-7189-400e-8d42-3bc19fa73997",
                                "sense_id": "f7c40232-9799-3957-8905-81437f7531d3",
                                "text": "Les pyrochlores sont à l’origine de nombreux matériaux « high tech » aux propriétés très diverses."
                            }
                        ]
                    }
                ],
                "translations": [
