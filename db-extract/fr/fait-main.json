                "word_linkages": []
            },
            {
                "entry_id": "ddd7bdfe-2d87-3435-9c93-9a2b563a03fe",
                "word": "fait-main",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b126f0ed-3a38-341e-a91f-7ea186f3d013",
                        "entry_id": "ddd7bdfe-2d87-3435-9c93-9a2b563a03fe",
                        "glosses": [
                            "Ce qui est fabriqué à la main, de façon artisanale et non industrialisée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2ebac54-732e-4c4c-8ac7-314c9cb5e390",
                                "sense_id": "b126f0ed-3a38-341e-a91f-7ea186f3d013",
                                "text": "Car « si le fait-main, c’est bien, le savoir-faire c’est mieux » défend Sophie, couturière de métier et à l’origine du lieu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30b65f53-3727-4c54-a69f-2c924710ea28",
                        "source_entry_id": "ddd7bdfe-2d87-3435-9c93-9a2b563a03fe",
                        "source_sense_id": "b126f0ed-3a38-341e-a91f-7ea186f3d013",
                        "target_lang_word": "Handarbeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handarbeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e33c99b-9339-38bf-968d-32cafa7a024c",
                                        "entry_id": "6e8f0835-22f7-3eef-8d9e-b9b244eb06f0",
                                        "glosses": [
                                            "Arbeit, die rein mit der Hand oder körperlicher Kraft, ohne Einsatz von Maschinen durchgeführt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8042e994-16a6-4ad6-8d88-85498b9a3733",
                                                "sense_id": "9e33c99b-9339-38bf-968d-32cafa7a024c",
                                                "text": "Wir fertigen hier alles in reiner Handarbeit."
                                            },
                                            {
                                                "example_id": "cbdd23dd-a371-48bd-8f99-25c75635e041",
                                                "sense_id": "9e33c99b-9339-38bf-968d-32cafa7a024c",
                                                "text": "„Der Ersatz der Handarbeit durch Maschinenarbeit auch bei der unproduktiven Güterbewegung war bestimmt durch die großartige Entwicklung von Industrie und Handel, die um die Jahrhundertwende allenthalben bei uns eingesetzt hatte.“"
                                            },
                                            {
                                                "example_id": "3b2e930c-a74c-4195-994c-502c7166de97",
                                                "sense_id": "9e33c99b-9339-38bf-968d-32cafa7a024c",
                                                "text": "„Sie saß mit ihrer Handarbeit unter dem Licht, das an einem Wandpfosten hing.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "75556a32-b8dc-3a42-abe9-2106bf911d9a",
                                        "entry_id": "6e8f0835-22f7-3eef-8d9e-b9b244eb06f0",
                                        "glosses": [
                                            "Gegenstand, der mittels Handarbeit (nach [1]) gefertigt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d99d0ebf-7104-4ece-9bde-c14f822d7c20",
                                                "sense_id": "75556a32-b8dc-3a42-abe9-2106bf911d9a",
                                                "text": "Diese Topflappen sind wirklich eine sehr schöne Handarbeit."
                                            },
                                            {
                                                "example_id": "1c8d1d3e-4556-403a-94e9-99bf9aad1a41",
                                                "sense_id": "75556a32-b8dc-3a42-abe9-2106bf911d9a",
                                                "text": "„In der 2. Hälfte des 19. Jahrhunderts war es üblich, dass die Frauen Handarbeiten mitnahmen, wenn sie einander besuchten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4bdc4d94-7670-3493-8416-392ff1b637d8",
                                        "entry_id": "6e8f0835-22f7-3eef-8d9e-b9b244eb06f0",
                                        "glosses": [
                                            "Herstellung von Gegenständen, die mit der Hand (zum Beispiel durch Stricken, Nähen, Schnitzen) angefertigt wurden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5377f4d0-687a-45b9-a989-b6b3b62a80ae",
                                                "sense_id": "4bdc4d94-7670-3493-8416-392ff1b637d8",
                                                "text": "„Musiziert Ihr? Liebt Ihr Handarbeiten, oder verfasst Ihr Gedichte?“"
                                            },
                                            {
                                                "example_id": "0cfe9f5a-8495-405e-b7d2-f49f37e4fcd5",
                                                "sense_id": "4bdc4d94-7670-3493-8416-392ff1b637d8",
                                                "text": "„Auch die Frauen der Städter beschäftigen sich in ihrer Freizeit mit Handarbeiten, die wie auf dem Land in Gemeinsamkeit mit anderen Frauen angefertigt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "251217fc-5cb6-383a-ba58-6c50bf818db2",
                                        "entry_id": "6e8f0835-22f7-3eef-8d9e-b9b244eb06f0",
                                        "glosses": [
                                            "Handarbeitsunterricht; Unterricht(-sfach), in dem man die Herstellung von Handarbeiten (nach [2]) lernt"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a08c4bda-7b55-4e64-bdf9-83f7a82183c6",
                                                "sense_id": "251217fc-5cb6-383a-ba58-6c50bf818db2",
                                                "text": "Handarbeit fällt heute leider aus."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
