                "senses": [
                    {
                        "sense_id": "51c3cc9e-a601-32f7-8237-66208ced2920",
                        "entry_id": "4eb71fa3-7416-34f5-b02b-e760dff91a13",
                        "glosses": [
                            "Grandson of Cadmus, transformed into a stag by Artemis in book III of Ovid's Metamorphoses."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "9f901e09-37c9-4302-893f-276f174eb4d0",
                                "sense_id": "51c3cc9e-a601-32f7-8237-66208ced2920",
                                "text": "Amid so much prosperity, it was one of his grandsons, Actaeon, who first brought distress to Cadmus, when antlers, foreign to his human shape, sprouted from the youth's forehead, and his hounds gorged themselves on their master's blood."
                            }
                        ]
                    }
                ],
                "translations": [
