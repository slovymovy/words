                ],
                "senses": [
                    {
                        "sense_id": "ed29d1f8-126f-34f9-aeda-c920b67a11d1",
                        "entry_id": "2b0884bb-1c0e-3810-9196-b4ac1d5a1e53",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d9284b2-d333-4576-9a0f-56aa47bb7e19",
                                "sense_id": "ed29d1f8-126f-34f9-aeda-c920b67a11d1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schleich kommt, geht der Herr Schleich.“"
                            },
                            {
                                "example_id": "3c43dfb5-18b5-409a-8045-5acc151c1566",
                                "sense_id": "ed29d1f8-126f-34f9-aeda-c920b67a11d1",
                                "text": "Schleich kommt und geht."
                            },
                            {
                                "example_id": "5823eeaa-21be-4b9b-a80a-cae53d13b2d8",
                                "sense_id": "ed29d1f8-126f-34f9-aeda-c920b67a11d1",
                                "text": "Schleichs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "d231ef1e-1f05-4b79-8d15-b4f419c016f4",
                                "sense_id": "ed29d1f8-126f-34f9-aeda-c920b67a11d1",
                                "text": "Frau Schleich ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c23b8e97-2438-4bad-909e-3d45417e8f26",
                                "sense_id": "ed29d1f8-126f-34f9-aeda-c920b67a11d1",
                                "text": "Herr Schleich wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ca0bdcbf-6be4-4ec8-847e-a67e224fe789",
                                "sense_id": "ed29d1f8-126f-34f9-aeda-c920b67a11d1",
                                "text": "Die Schleichs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "13d38696-72e1-4b04-b7c2-3c1e2a1a8b67",
                                "sense_id": "ed29d1f8-126f-34f9-aeda-c920b67a11d1",
                                "text": "Der Schleich trägt nie die Schals, die die Schleich ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
