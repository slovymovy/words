                ],
                "senses": [
                    {
                        "sense_id": "069597c0-8310-3714-bd64-12b7171e41b9",
                        "entry_id": "b3425ba8-1e35-3d21-bc7b-c44674d4e1b4",
                        "glosses": [
                            "Similarité de caractères observée chez plusieurs espèces différentes, résultant d’une acquisition indépendante, et non héritée d’un ancêtre commun, souvent par convergence évolutive ou parallélisme évolutif."
                        ],
                        "tags": [
                            "Biologie évolutive",
                            "Systématique",
                            "Anatomie comparée"
                        ],
                        "examples": [
                            {
                                "example_id": "13029605-77f9-4050-a034-2065051d3096",
                                "sense_id": "069597c0-8310-3714-bd64-12b7171e41b9",
                                "text": "Malheureusement, on remarque que l’homoplasie est forte : l’indice de cohérence est faible et le nombre de synapomorphies est très réduit."
                            },
                            {
                                "example_id": "8d6b0645-7857-411c-bbc5-1b51e8d10efb",
                                "sense_id": "069597c0-8310-3714-bd64-12b7171e41b9",
                                "text": "Les ailes de la chauve-souris et celles des oiseaux sont un exemple d’homoplasie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0741086-1e09-408f-9f1f-cd82774ef3b2",
