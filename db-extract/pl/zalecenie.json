                                    {
                                        "sense_id": "d2bacc09-ee0e-377b-9a94-adced39a5ebb",
                                        "entry_id": "a5363711-44d6-360b-bef4-dd879c2da77e",
                                        "glosses": [
                                            "τα μέλη ή τα όργανα από τα οποία αποτελείται ένα σύνθετο σύνολο"
