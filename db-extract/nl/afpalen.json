                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7873f2c6-bed5-3096-b356-d49134131b5f",
                                        "entry_id": "426ae695-d4a4-3fd8-82e1-05c06423d43a",
                                        "glosses": [
                                            "A preliminary plan for a project."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef527a8-0d1f-47d1-950d-e950b0721690",
                                                "sense_id": "7873f2c6-bed5-3096-b356-d49134131b5f",
                                                "text": "the outline of a speech"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70f8d5c2-5225-3d8f-97b4-210df59acf1a",
                                        "entry_id": "426ae695-d4a4-3fd8-82e1-05c06423d43a",
