        "fr-extract.jsonl": [
            {
                "entry_id": "b41815d2-0246-3a70-906f-c49caad28aa6",
                "word": "catholiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "339818cc-119f-3de0-9db9-149507db2876",
                        "entry_id": "b41815d2-0246-3a70-906f-c49caad28aa6",
                        "glosses": [
                            "Conformément à la foi catholique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "278803bf-a613-43aa-8a4e-44e9087d3783",
                                "sense_id": "339818cc-119f-3de0-9db9-149507db2876",
                                "text": "Elle imagina qu’en devenant irréprochable, catholiquement parlant, elle arriverait à un tel état de sainteté, que Dieu l’écouterait et accomplirait ses désirs."
                            },
                            {
                                "example_id": "7e34e1b9-3f72-423f-9a02-b348e79ea0b2",
                                "sense_id": "339818cc-119f-3de0-9db9-149507db2876",
                                "text": "Éduqué catholiquement, les interdits me furent d’abord éthiques."
                            },
                            {
                                "example_id": "f67a05e7-8603-4161-8c8e-9da90c097496",
                                "sense_id": "339818cc-119f-3de0-9db9-149507db2876",
                                "text": "Cette situation conduit à des imbroglios dans toute la France, où chacun croit être dans son bon droit en décorant catholiquement sa mairie, ou en interdisant à l’édile de le faire."
                            }
                        ]
                    }
