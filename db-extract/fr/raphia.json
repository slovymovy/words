                "senses": [
                    {
                        "sense_id": "f2fdd50b-af43-3e45-9af8-0cdc7937f34c",
                        "entry_id": "cdc4839b-ecf9-38ea-8b31-5d4504f5fdfa",
                        "glosses": [
                            "Genre de palmiers, dont certaines espèces produisent des fibres qui servent à faire des liens, des tresses, des cordages, des tissus. → voir Raphia"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ee7f7be1-708c-33c4-a7bc-faf9281e6d5c",
                        "entry_id": "cdc4839b-ecf9-38ea-8b31-5d4504f5fdfa",
                        "glosses": [
                            "Fibre ou lien tiré du palmier Raphia farinifera (Gaertn.) Hyl. originaire de Madagascar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "debadfda-6267-4aa4-af15-697958c866be",
                                "sense_id": "ee7f7be1-708c-33c4-a7bc-faf9281e6d5c",
                                "text": "Il plante des greffes, enrobées dans une feuille de plomb et ligaturées au raphia sulfaté, en pleine terre, […]."
                            },
                            {
                                "example_id": "0eee6141-d59d-4e84-a870-59941e192423",
                                "sense_id": "ee7f7be1-708c-33c4-a7bc-faf9281e6d5c",
                                "text": "— Vous ne nous devez rien, dit simplement Angélique, en secouant ses beaux cheveux couleur de raphia."
                            },
                            {
                                "example_id": "7592aa66-a757-4fa7-8499-429afb44a95f",
                                "sense_id": "ee7f7be1-708c-33c4-a7bc-faf9281e6d5c",
                                "text": "— Vous allez rester près du petit, je vais couper des fleurs, et après, il sera l’heure de partir.\n— Vous trouverez un sécateur et du raphia derrière la porte de la cave."
                            },
                            {
                                "example_id": "99197fe1-1a7e-48ee-930c-c777ee592d7d",
                                "sense_id": "ee7f7be1-708c-33c4-a7bc-faf9281e6d5c",
                                "text": "Une dizaine de mioches assis sur une natte en raphia ânonnaient en chœur l'alphabet hébraïque dessiné sur une planche en bois d’arar (thuya) sur laquelle le rabbin promenait son doigt."
                            }
                        ]
                    }
                ],
