{
    "word_family": [
        "bouncy",
        "bouncer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9beb44b-565e-3250-af98-864be79d6f79",
                    "sense_definition": "To change the direction of motion after hitting an obstacle or surface.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tennis ball <w>bounced</w> off the wall and rolled away.",
                            "target_lang_translations": {
                                "ru": "Теннисный мяч <w>отскочил</w> от стены и откатился.",
                                "tr": "Tenis topu duvardan <w>sekti</w> ve yuvarlanıp gitti.",
                                "zh": "网球撞到墙上<w>反弹</w>了回来，然后滚走了。"
                            }
                        },
                        {
                            "text": "If you drop the rubber ball, it will <w>bounce</w> back up.",
                            "target_lang_translations": {
                                "ru": "Если бросить резиновый мяч, он <w>отскочит</w> обратно вверх.",
                                "tr": "Lastik topu düşürürsen, geri <w>sekecektir</w>.",
                                "zh": "如果你把橡胶球扔在地上，它会<w>弹</w>起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rebound",
                        "bounce back"
                    ],
                    "common_phrases": [
                        "bounce off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменить направление движения после удара о препятствие или поверхность.",
                        "tr": "Bir yüzeye veya engele çarptıktan sonra hareket yönünü değiştirmek.",
                        "zh": "物体撞击表面或障碍物后改变运动方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отскакивать",
                                "target_lang_sense_clarification": "отлетать после удара"
                            },
                            {
                                "target_lang_word": "отскочить",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sekmek",
                                "target_lang_sense_clarification": "bir yüzeyden geri dönmek"
                            },
                            {
                                "target_lang_word": "geri sıçramak",
                                "target_lang_sense_clarification": "çarptıktan sonra geri dönmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "反弹",
                                "target_lang_sense_clarification": "撞击后弹回"
                            },
                            {
                                "target_lang_word": "弹起",
                                "target_lang_sense_clarification": "向上弹跳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eabf4e4f-eab9-3c4f-8733-2f30b23ba6d2",
                    "sense_definition": "To move quickly up and then down (or vice versa), once or repeatedly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The excited child <w>bounces</w> on the bed every morning.",
                            "target_lang_translations": {
                                "ru": "Взволнованный ребенок каждое утро <w>прыгает</w> на кровати.",
                                "tr": "Heyecanlı çocuk her sabah yatakta <w>zıplıyor</w>.",
                                "zh": "那个兴奋的孩子每天早上都在床上<w>蹦跳</w>。"
                            }
                        },
                        {
                            "text": "He <w>bounced</w> nervously in his chair while waiting for the interview.",
                            "target_lang_translations": {
                                "ru": "Он нервно <w>подпрыгивал</w> на стуле в ожидании собеседования.",
                                "tr": "Mülakatı beklerken koltuğunda gergin bir şekilde <w>sıçrıyordu</w>.",
                                "zh": "他在等待面试时，紧张地在椅子上<w>颠</w>着腿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bob",
                        "jump",
                        "spring"
                    ],
                    "common_phrases": [
                        "bounce up and down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро двигаться вверх и вниз (или наоборот), один раз или многократно.",
                        "tr": "Hızlıca yukarı ve aşağı (veya tam tersi) hareket etmek.",
                        "zh": "快速地上下移动，一次或多次。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подпрыгивать",
                                "target_lang_sense_clarification": "делать небольшие прыжки"
                            },
                            {
                                "target_lang_word": "скакать",
                                "target_lang_sense_clarification": "резво прыгать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zıplamak",
                                "target_lang_sense_clarification": "yukarı doğru sıçramak"
                            },
                            {
                                "target_lang_word": "sıçramak",
                                "target_lang_sense_clarification": "ani hareketle yükselmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跳跃",
                                "target_lang_sense_clarification": "身体向上跳"
                            },
                            {
                                "target_lang_word": "蹦跳",
                                "target_lang_sense_clarification": "活泼地上下跳动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40496235-7097-3296-8007-969b65a8e628",
                    "sense_definition": "To cause an object to move quickly up and down, or to hit a surface and rebound.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player <w>bounced</w> the basketball on the court before shooting.",
                            "target_lang_translations": {
                                "ru": "Игрок <w>постучал</w> баскетбольным мячом об пол перед броском.",
                                "tr": "Oyuncu atış yapmadan önce basketbol topunu sahada <w>sektirdi</w>.",
                                "zh": "球员在投篮前在场地上<w>拍</w>了拍篮球。"
                            }
                        },
                        {
                            "text": "She gently <w>bounced</w> the baby on her knee to soothe him.",
                            "target_lang_translations": {
                                "ru": "Она мягко <w>качала</w> ребенка на колене, чтобы успокоить его.",
                                "tr": "Bebeği sakinleştirmek için dizinde nazikçe <w>salladı</w>.",
                                "zh": "她轻轻地在膝盖上<w>颠</w>着婴儿来安抚他。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bounce a ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять предмет быстро двигаться вверх-вниз или ударяться о поверхность и отскакивать.",
                        "tr": "Bir nesneyi hızlıca yukarı aşağı hareket ettirmek veya bir yüzeye çarptırıp sektirmek.",
                        "zh": "使物体快速上下移动，或使其撞击表面并反弹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стучать",
                                "target_lang_sense_clarification": "мячом об пол"
                            },
                            {
                                "target_lang_word": "качать",
                                "target_lang_sense_clarification": "ребенка на коленях"
                            },
                            {
                                "target_lang_word": "чеканить",
                                "target_lang_sense_clarification": "спорт"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sektirmek",
                                "target_lang_sense_clarification": "topu yere vurarak hareket ettirmek"
                            },
                            {
                                "target_lang_word": "sallamak",
                                "target_lang_sense_clarification": "birini kucakta hafifçe yukarı aşağı hareket ettirmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拍",
                                "target_lang_sense_clarification": "拍球"
                            },
                            {
                                "target_lang_word": "颠",
                                "target_lang_sense_clarification": "轻微上下晃动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdad870a-0a02-3663-ac03-4aaa0fedad2e",
                    "sense_definition": "To suggest or introduce an idea to someone in order to gain feedback.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like to <w>bounce</w> some ideas off you regarding the new project.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы <w>обсудить</w> с тобой некоторые идеи касательно нового проекта.",
                                "tr": "Yeni proje hakkında seninle bazı fikirler <w>üzerine konuşmak</w> istiyorum.",
                                "zh": "关于新项目，我想和你<w>交流</w>一下想法。"
                            }
                        },
                        {
                            "text": "They met for coffee to <w>bounce</w> thoughts off each other.",
                            "target_lang_translations": {
                                "ru": "Они встретились за кофе, чтобы <w>обменяться</w> мыслями.",
                                "tr": "Düşüncelerini <w>paylaşmak</w> için kahve içmeye buluştular.",
                                "zh": "他们约了喝咖啡，以便互相<w>探讨</w>想法。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bounce ideas off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предложить или высказать идею кому-либо, чтобы узнать мнение.",
                        "tr": "Geri bildirim almak amacıyla birine fikir sunmak veya danışmak.",
                        "zh": "向某人提出想法以获取反馈。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обсуждать",
                                "target_lang_sense_clarification": "идеи"
                            },
                            {
                                "target_lang_word": "делиться",
                                "target_lang_sense_clarification": "мыслями"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "fikir alışverişinde bulunmak",
                                "target_lang_sense_clarification": "karşılıklı fikir paylaşmak"
                            },
                            {
                                "target_lang_word": "danışmak",
                                "target_lang_sense_clarification": "birine fikir sormak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交流",
                                "target_lang_sense_clarification": "交换意见"
                            },
                            {
                                "target_lang_word": "探讨",
                                "target_lang_sense_clarification": "讨论想法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e084dd3-0d98-3d71-833f-695324ce98d5",
                    "sense_definition": "To return undelivered (of an email or message).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "failure_return",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My email to her <w>bounced</w> because the address was incorrect.",
                            "target_lang_translations": {
                                "ru": "Мое письмо к ней <w>вернулось</w>, потому что адрес был неверен.",
                                "tr": "Ona gönderdiğim e-posta, adres yanlış olduğu için <w>geri döndü</w>.",
                                "zh": "我发给她的邮件因为地址错误被<w>退回</w>了。"
                            }
                        },
                        {
                            "text": "If the mailbox is full, the message will <w>bounce</w> back to the sender.",
                            "target_lang_translations": {
                                "ru": "Если почтовый ящик переполнен, сообщение <w>вернется</w> отправителю.",
                                "tr": "Eğer posta kutusu doluysa, mesaj göndericiye <w>geri dönecektir</w>.",
                                "zh": "如果邮箱满了，消息会<w>退回</w>给发送者。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращаться отправителю (об электронном письме или сообщении).",
                        "tr": "Bir e-postanın veya mesajın teslim edilemeyip göndericiye geri dönmesi.",
                        "zh": "指电子邮件或消息因无法送达而退回给发送者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвращаться",
                                "target_lang_sense_clarification": "о письме"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "geri dönmek",
                                "target_lang_sense_clarification": "e-postanın ulaşmayıp geri gelmesi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "退信",
                                "target_lang_sense_clarification": "邮件被退回"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "492707ca-6daa-3c15-9c7d-0a24ddd0591c",
                    "sense_definition": "To be refused by a bank because there are insufficient funds in the account.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "failure_return",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was embarrassed when his check <w>bounced</w> at the grocery store.",
                            "target_lang_translations": {
                                "ru": "Ему было стыдно, когда его чек <w>не прошел</w> в продуктовом магазине.",
                                "tr": "Markette çeki <w>karşılıksız çıkınca</w> utandı.",
                                "zh": "当他的支票在杂货店<w>跳票</w>时，他感到很尴尬。"
                            }
                        },
                        {
                            "text": "The bank will charge a fee if your payment <w>bounces</w>.",
                            "target_lang_translations": {
                                "ru": "Банк возьмет комиссию, если ваш платеж <w>будет отклонен</w>.",
                                "tr": "Ödemeniz <w>reddedilirse</w> banka ücret kesecektir.",
                                "zh": "如果你的付款<w>被拒付</w>，银行将收取手续费。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "check bounced"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть отклоненным банком из-за недостатка средств на счете.",
                        "tr": "Hesapta yeterli bakiye olmadığı için banka tarafından reddedilmek.",
                        "zh": "指支票或付款因账户余额不足而被银行拒绝。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть отклоненным",
                                "target_lang_sense_clarification": "о платеже"
                            },
                            {
                                "target_lang_word": "не проходить",
                                "target_lang_sense_clarification": "об оплате"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karşılıksız çıkmak",
                                "target_lang_sense_clarification": "çek veya ödeme için"
                            },
                            {
                                "target_lang_word": "reddedilmek",
                                "target_lang_sense_clarification": "banka işlemi onaylamamak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跳票",
                                "target_lang_sense_clarification": "支票无法兑现"
                            },
                            {
                                "target_lang_word": "拒付",
                                "target_lang_sense_clarification": "银行拒绝支付"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7240bac4-1e61-388d-8754-ed6e69b705ec",
                    "sense_definition": "To leave a place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "departure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is getting late, so I gotta <w>bounce</w>.",
                            "target_lang_translations": {
                                "ru": "Уже поздно, так что мне пора <w>сваливать</w>.",
                                "tr": "Geç oluyor, o yüzden benim <w>tüymem</w> lazım.",
                                "zh": "天色已晚，我得<w>走人</w>了。"
                            }
                        },
                        {
                            "text": "We stayed at the party for an hour and then <w>bounced</w>.",
                            "target_lang_translations": {
                                "ru": "Мы побыли на вечеринке час, а потом <w>свалили</w>.",
                                "tr": "Partide bir saat kaldık ve sonra <w>çıktık</w>.",
                                "zh": "我们在派对上待了一个小时，然后就<w>闪人</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gotta bounce"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уходить, покидать место.",
                        "tr": "Bir yerden ayrılmak.",
                        "zh": "离开某地（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сваливать",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "уходить",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tüymek",
                                "target_lang_sense_clarification": "argo, hızlıca ayrılmak"
                            },
                            {
                                "target_lang_word": "çıkmak",
                                "target_lang_sense_clarification": "bir yerden ayrılmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "走人",
                                "target_lang_sense_clarification": "离开"
                            },
                            {
                                "target_lang_word": "闪人",
                                "target_lang_sense_clarification": "快速离开"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2d8727d-58de-3046-8b21-5375420aa68b",
                    "sense_definition": "A change of direction of motion after hitting the ground or an obstacle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ball took a strange <w>bounce</w> and hit the goalpost.",
                            "target_lang_translations": {
                                "ru": "Мяч сделал странный <w>отскок</w> и ударился о штангу ворот.",
                                "tr": "Top garip bir <w>sekme</w> yaptı ve kale direğine çarptı.",
                                "zh": "球出现了一个奇怪的<w>反弹</w>，撞到了门柱上。"
                            }
                        },
                        {
                            "text": "With one lucky <w>bounce</w>, the coin landed in the cup.",
                            "target_lang_translations": {
                                "ru": "Благодаря одному удачному <w>отскоку</w> монета приземлилась в чашку.",
                                "tr": "Şanslı bir <w>sekme</w> ile madeni para bardağın içine düştü.",
                                "zh": "凭借一次幸运的<w>反弹</w>，硬币落入了杯中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rebound"
                    ],
                    "common_phrases": [
                        "lucky bounce",
                        "bad bounce"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменение направления движения после удара о землю или препятствие.",
                        "tr": "Bir yüzeye çarptıktan sonra hareket yönünün değişmesi.",
                        "zh": "撞击地面或障碍物后运动方向的改变。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отскок",
                                "target_lang_sense_clarification": "движение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sekme",
                                "target_lang_sense_clarification": "hareketin yön değiştirmesi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "反弹",
                                "target_lang_sense_clarification": "反弹的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a0b0021-9b35-3aff-bb2a-353b993deb24",
                    "sense_definition": "An increase in popularity or success.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "popularity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate received a significant <w>bounce</w> in the polls after the convention.",
                            "target_lang_translations": {
                                "ru": "Кандидат получил значительный <w>скачок</w> в опросах после съезда.",
                                "tr": "Aday, kongreden sonra anketlerde önemli bir <w>sıçrama</w> yakaladı.",
                                "zh": "大会结束后，候选人在民调中获得了显著的<w>激增</w>。"
                            }
                        },
                        {
                            "text": "The new product gave the company a temporary <w>bounce</w> in sales.",
                            "target_lang_translations": {
