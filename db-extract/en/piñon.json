                                "sense_id": "72838819-3842-3664-8143-d84b4792a873",
                                "text": "They planted a few piñons."
                            },
                            {
                                "example_id": "e68bbb33-65fb-40aa-84b1-acc30eaf15d0",
                                "sense_id": "72838819-3842-3664-8143-d84b4792a873",
                                "text": "The hills were covered with clusters of piñon."
                            },
                            {
                                "example_id": "29790a64-98c4-4cde-b690-91ad255c548f",
                                "sense_id": "72838819-3842-3664-8143-d84b4792a873",
                                "text": "On the mountains a few junipers and piñons are found, and cactuses, agave, and yuccas, low, fleshy plants with bayonets and thorns."
                            },
                            {
                                "example_id": "7d7ded49-4ea1-4c89-a66c-580c02699d93",
                                "sense_id": "72838819-3842-3664-8143-d84b4792a873",
                                "text": "Anglos call it a “kiva fireplace” and put several in every Santa Fe style building, carefully burning piñon firewood upright in the approved local manner."
                            }
                        ]
