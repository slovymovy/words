        "de-extract.jsonl": [
            {
                "entry_id": "4f4c90a7-a020-353a-9844-820316db8056",
                "word": "Greenlander",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "20057339-6e66-36ba-8a1a-c25af7fa6e98",
                        "entry_id": "4f4c90a7-a020-353a-9844-820316db8056",
                        "glosses": [
                            "Person, die in Grönland wohnt oder von dort stammt; Grönländer, Grönländerin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f26cf83-3cd0-4c7a-8d68-7357008188c3",
                                "sense_id": "20057339-6e66-36ba-8a1a-c25af7fa6e98",
                                "text": "She want to be a Greenlander.",
                                "translation": "Sie möchte eine Grönländerin sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "511443af-75d3-42ad-bef6-58c77ddd6f7e",
                        "source_entry_id": "4f4c90a7-a020-353a-9844-820316db8056",
                        "source_sense_id": "20057339-6e66-36ba-8a1a-c25af7fa6e98",
                        "source_sense_description": "Person, die in Grönland wohnt oder von dort stammt; Grönländer, Grönländerin",
                        "target_lang_word": "Grönländer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grönländer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                        "entry_id": "aef88037-629a-3abf-a88b-095240f9aad4",
                                        "glosses": [
                                            "Einwohner von Grönland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ad8af41-e1b2-4b77-a6b7-9231225c0e79",
                                                "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                                "text": "Zudem werden die Grönländer als eigenes Volk und Grönländisch als Landessprache anerkannt."
                                            },
                                            {
                                                "example_id": "a47a7908-1911-48c4-811a-9f1d1621efd7",
                                                "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                                "text": "Dem Entwurf zufolge soll Grönland pro Jahr die ersten 75 Millionen Kronen (rund 100 Millionen Euro) aus künftigen Öleinnahmen behalten dürfen. Was darüber hinaus geht, wollen sich Grönländer und Dänen je zur Hälfte teilen."
                                            },
                                            {
                                                "example_id": "5bcf8937-7919-42bf-9f15-052228217006",
                                                "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                                "text": "Doch hoffen die Grönländer immer noch auf Wohlstand durch den Fund von Öl oder Mineralien."
                                            },
                                            {
                                                "example_id": "3facfc29-ccd0-42df-9eac-5cca399360ad",
                                                "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                                "text": "„Bald nach dem Massaker stürmen Indianer auf die Grönländer zu, schwingen steinerne Tomahawks und schießen mit Pfeil und Bogen - steinzeitliche Waffen, die den eisernen Schwertern und Streitäxten der Wikinger aber kaum unterlegen sind.“"
                                            },
                                            {
                                                "example_id": "b85716b6-7851-46ce-9bc2-5f031f5c2ef9",
                                                "sense_id": "bd906c48-e3ec-3593-8060-9fc38e5810f3",
                                                "text": "„Sie waren die ersten Grönländer, die eine Universitätsausbildung erhielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3af79759-44d3-4d56-91c3-c2bc50eb3cac",
                        "source_entry_id": "4f4c90a7-a020-353a-9844-820316db8056",
                        "source_sense_id": "20057339-6e66-36ba-8a1a-c25af7fa6e98",
                        "source_sense_description": "Person, die in Grönland wohnt oder von dort stammt; Grönländer, Grönländerin",
                        "target_lang_word": "Grönländerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grönländerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad3a3f94-3814-3f45-b989-c51b1c98b992",
                                        "entry_id": "8ac81825-dd7a-3d25-bac7-55c6b4e08868",
                                        "glosses": [
                                            "Einwohnerin von Grönland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31fa3bde-c22a-4802-a336-8f787d205780",
                                                "sense_id": "ad3a3f94-3814-3f45-b989-c51b1c98b992",
                                                "text": "„Sie ist eine geborene Grönländerin, was bedeutet, dass sich einige friesische und dänische Einflüsse mit den asiatischen Ursprüngen mischen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
