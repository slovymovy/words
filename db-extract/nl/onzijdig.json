                                "sense_id": "51b2b5fc-7190-3ac9-b0f3-cfa8e8c6ae08",
                                "text": "In die ruimte staan enkele onzijdige dieren tentoongesteld."
                            }
                        ]
                    },
                    {
                        "sense_id": "9233971c-b38a-37e5-a5f3-b07644953970",
                        "entry_id": "378954e6-c993-30d5-9114-9832f269d191",
                        "glosses": [
