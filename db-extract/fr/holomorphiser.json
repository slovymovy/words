                "senses": [
                    {
                        "sense_id": "4f09aaa4-3d89-3ae7-9e43-743ffffa6225",
                        "entry_id": "f773fcaf-3ba7-3445-9a01-588025198b78",
                        "glosses": [
                            "Donner un caractère holomorphe à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e8c7c04-ae31-4695-89a3-8ff5cfa4a6ef",
                                "sense_id": "4f09aaa4-3d89-3ae7-9e43-743ffffa6225",
                                "text": "Essayons d’abord de comprendre un peu plus en détail, cette fabuleuse possibilité d’“holomorphiser” l’involution antiholomorphe donnée."
                            },
                            {
                                "example_id": "b7c900a1-b73e-45ef-adb2-45c51180b64e",
                                "sense_id": "4f09aaa4-3d89-3ae7-9e43-743ffffa6225",
                                "text": "Justement, je ne suis pas holomorphisé puisqu'en licence."
                            },
                            {
                                "example_id": "b74e7f20-c524-49df-ac8c-967fd5787a25",
                                "sense_id": "4f09aaa4-3d89-3ae7-9e43-743ffffa6225",
                                "text": "C'est vrai qu'il a une forme louche, mais, je pense que tout ce qu'il a dit c'est qu'il fusionne avec le Hogyokou (d'ailleurs juste avant de dévoiler la fusion il avait sous entendu qu'il ne s'était pas Holowifier ou holomorphiser? je sais pas). (sic)"
                            }
                        ]
                    }
