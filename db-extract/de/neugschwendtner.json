                "senses": [
                    {
                        "sense_id": "aedb8ba4-f938-35db-86e2-a1cec03b5b5d",
                        "entry_id": "107b680f-590a-35dd-9ee8-8c5bf7e25842",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa4bce26-438b-4700-ba85-3f63ab76de6c",
                                "sense_id": "aedb8ba4-f938-35db-86e2-a1cec03b5b5d",
                                "text": "Frau Neugschwendtner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6c30fafb-30f1-4af6-b4c2-5971b617276f",
                                "sense_id": "aedb8ba4-f938-35db-86e2-a1cec03b5b5d",
                                "text": "Herr Neugschwendtner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a754d8ef-1349-44a4-a661-dc85dccbeb63",
                                "sense_id": "aedb8ba4-f938-35db-86e2-a1cec03b5b5d",
                                "text": "Die Neugschwendtners fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e1f6a988-3fea-40b8-8cd8-f4f642e833cf",
                                "sense_id": "aedb8ba4-f938-35db-86e2-a1cec03b5b5d",
                                "text": "Der Neugschwendtner trägt nie die Schals, die die Neugschwendtner ihm strickt."
                            },
                            {
                                "example_id": "5afedb8b-92c7-4081-b8f1-778d2d84facb",
                                "sense_id": "aedb8ba4-f938-35db-86e2-a1cec03b5b5d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Neugschwendtner kommt, geht der Herr Neugschwendtner.“"
                            },
                            {
                                "example_id": "c51b9e4c-750a-453d-9174-89abc167de74",
                                "sense_id": "aedb8ba4-f938-35db-86e2-a1cec03b5b5d",
                                "text": "Neugschwendtner kommt und geht."
                            },
                            {
                                "example_id": "b36b906f-d367-4e58-b8f1-8559250fde7a",
                                "sense_id": "aedb8ba4-f938-35db-86e2-a1cec03b5b5d",
                                "text": "Neugschwendtners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
