                ],
                "senses": [
                    {
                        "sense_id": "59f37e53-fccc-339d-895a-64e6955af98b",
                        "entry_id": "f58b8f83-2c38-32e3-809c-84a74d78dd91",
                        "glosses": [
                            "Verlauf der Entwicklung einer Familie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4540e1af-0bdd-4614-a3d6-f33b9c202eed",
                                "sense_id": "59f37e53-fccc-339d-895a-64e6955af98b",
                                "text": "„Meine Herkunft, meine Familiengeschichte sind keine Tabuthemen.“"
                            },
                            {
                                "example_id": "92c54224-052c-430e-abd6-a26e5fa9d465",
                                "sense_id": "59f37e53-fccc-339d-895a-64e6955af98b",
                                "text": "„In diesem Seminar ging es darum, die eigene Familiengeschichte vor dem Hintergrund der deutschen Geschichte genauer zu betrachten.“"
                            },
                            {
                                "example_id": "148d6566-7d94-4510-9db7-f83170d9b156",
                                "sense_id": "59f37e53-fccc-339d-895a-64e6955af98b",
                                "text": "„Ihre Familiengeschichte und auch ihr eigenes Leben waren verwoben mit den Schicksalen Jerusalems.“"
                            },
                            {
                                "example_id": "005f2366-2509-4499-9818-f7cf26578d7b",
                                "sense_id": "59f37e53-fccc-339d-895a-64e6955af98b",
                                "text": "„Der italienische Autor Giuseppe Tomasi di Lampedusa kannte diesen Stoff aufgrund seiner Familiengeschichte aus erster Hand.“"
                            },
                            {
                                "example_id": "ade3c7c2-e43d-4614-b834-416be11ac450",
                                "sense_id": "59f37e53-fccc-339d-895a-64e6955af98b",
                                "text": "„Erst 2014 sprach Mugabe anlässlich der Beerdigung seiner jüngsten Schwester Bridgette öffentlich über seine Familiengeschichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "97df33d8-7ed7-33ce-b158-477370fe4dcd",
                        "entry_id": "f58b8f83-2c38-32e3-809c-84a74d78dd91",
                        "glosses": [
                            "Erzählung über Ereignisse in der Familie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7e981e7-b384-46a8-b391-b670384f271f",
                                "sense_id": "97df33d8-7ed7-33ce-b158-477370fe4dcd",
                                "text": "„Ich interessierte mich lebhaft für seine Familiengeschichte, die er mir mit der ganzen Aufrichtigkeit erzählte, in der der Franzose sich gefällt, wenn er von seinem eigenen Ich spricht.“"
                            },
                            {
                                "example_id": "ec421bc8-c264-4f49-bae9-950df4d553de",
                                "sense_id": "97df33d8-7ed7-33ce-b158-477370fe4dcd",
                                "text": "Die schönsten Familiengeschichten berichten über ihre Kindheit."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
