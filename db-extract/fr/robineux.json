                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a41facb6-94e2-4a68-b7df-07bcfdb0898a",
                                "sense_id": "6edf7619-8703-391b-b5c8-d22354251b4b",
                                "text": "Un robineux qui sentait le whisky à plein-nez."
                            },
                            {
                                "example_id": "26c48afd-7946-45a8-bf99-507f42923b3d",
                                "sense_id": "6edf7619-8703-391b-b5c8-d22354251b4b",
                                "text": "Des robineux endormis sur un banc de parc."
                            },
                            {
                                "example_id": "089e46ca-0916-44d8-a27f-031c593a7ca9",
                                "sense_id": "6edf7619-8703-391b-b5c8-d22354251b4b",
                                "text": "« J'ai souvenir encore de quatre jeunes garçons\n Qui avaient grand plaisir à jouer les fanfarons\n Les garçons de mon âge avaient comme voisinage\n Robineux du Viger, putains d'la Saint-Laurent. »"
                            },
                            {
                                "example_id": "fd1c143c-1faa-4b23-9483-0ac07c38b231",
                                "sense_id": "6edf7619-8703-391b-b5c8-d22354251b4b",
                                "text": "« Un robineux quête dans la rue au pied d’un grand building en verre,\nY va passer inaperçu à la sortie des actionnaires. »"
                            },
                            {
                                "example_id": "06d4cb4f-aec3-495d-9977-abbb35c1844d",
                                "sense_id": "6edf7619-8703-391b-b5c8-d22354251b4b",
                                "text": "Vous souvenez-vous de l'époque où le portrait type de l'itinérant était un vieux monsieur sympathique qui avait un « problème de boisson »?\nCe n'était pas un sans-abri, mais un clochard, un robineux."
                            }
                        ]
                    }
