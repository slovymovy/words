                "senses": [
                    {
                        "sense_id": "5572c4b5-8dc7-3066-b272-6ed602b1c866",
                        "entry_id": "33fd7aca-0d10-3717-9955-22e577b8da89",
                        "glosses": [
                            "Reiz, welche eine Reaktion hervorruft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c27d9eb-f877-44ff-8faa-76d356e69f62",
                                "sense_id": "5572c4b5-8dc7-3066-b272-6ed602b1c866",
                                "text": "Ein unkonditionierter Stimulus (UCS für unconditioned stimuli) ist ein Reiz, der eine Reaktion ohne Konditionierung, also ohne Lernen, auslöst – einen Reflex."
                            },
                            {
                                "example_id": "79df34f9-ccc0-4427-826a-73e9f1e000e2",
                                "sense_id": "5572c4b5-8dc7-3066-b272-6ed602b1c866",
                                "text": "„Zwischen einem verbalen Stimulus und einem verbalen Response kann es aber auch verbal vermittelnde Assoziationen geben, die den Lernakt beeinflussen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a55a9727-57c4-3ffd-b149-5cd5b3989bad",
                        "entry_id": "33fd7aca-0d10-3717-9955-22e577b8da89",
                        "glosses": [
                            "etwas, das eine Veranlassung/Motivation darstellt, etwas Bestimmtes zu tun oder zu lassen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "bfe3a52a-60a3-4c51-8a08-9b8281fe70fa",
                                "sense_id": "a55a9727-57c4-3ffd-b149-5cd5b3989bad",
                                "text": "Ein gutes Einkommen ist ein hervorragender Stimulus für gute Arbeit."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73b6eef8-91f6-4df1-92b2-1d5d6fb6b502",
                        "source_entry_id": "33fd7aca-0d10-3717-9955-22e577b8da89",
                        "source_sense_id": "5572c4b5-8dc7-3066-b272-6ed602b1c866",
                        "source_sense_description": "Reiz, welche eine Reaktion hervorruft",
                        "target_lang_word": "stimulus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stimulus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                        "entry_id": "15979d7b-48ef-31f3-97ca-c3c32a1348a1",
                                        "glosses": [
                                            "An external phenomenon that has an influence on a system, by triggering or modifying an internal phenomenon; for example, a spur or incentive that drives a person to take action or change behaviour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1673c75e-91ac-4454-824f-7fc119abce87",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "an economic stimulus"
                                            },
                                            {
                                                "example_id": "d5c0027f-fc3b-4f67-9864-2013335786f1",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "From the beginning of the show to the end, vanity is the sole stimulus and reward of action—vanity, that never looks beyond the present."
                                            },
                                            {
                                                "example_id": "d64d9582-1846-4e54-aa5e-dab35f68a905",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "Democrats, meanwhile, point out that Republicans seem to have made a conscious decision, beginning with the stimulus, to oppose anything the president put forward, dooming any chance of renewed cooperation between the parties."
                                            },
                                            {
                                                "example_id": "6b812202-831b-45d8-b904-b384f02a7332",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "respond to a stimulus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5427ca45-0fe6-3428-913f-9503dc3012ae",
                                        "entry_id": "15979d7b-48ef-31f3-97ca-c3c32a1348a1",
                                        "glosses": [
                                            "Something external that elicits or influences a physiological or psychological activity or response, or that affects any of the sensory apparatuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7eb9862-11e9-433b-8433-c72738f4fe1d",
                                                "sense_id": "5427ca45-0fe6-3428-913f-9503dc3012ae",
                                                "text": "Even light nonpainful stimuli can provoke or exacerbate spontaneous pain; this is not limited to tactile, thermal, or vibratory stimuli, because auditory, visual, olfactory, and visceral stimuli also may be problematic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2a781a5-e371-3aa2-a6f8-0436bc1927ff",
                                        "entry_id": "15979d7b-48ef-31f3-97ca-c3c32a1348a1",
                                        "glosses": [
                                            "A stinging part on the body of a plant or insect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "747203e2-52c2-446e-a3bb-9339dd948f48",
                                                "sense_id": "b2a781a5-e371-3aa2-a6f8-0436bc1927ff",
                                                "text": "Many plants, like many animals, are furnished with arms for their protection; these are either aculei, prickles […]; or stimuli, stings, as in the nettles, which are armed with a venomous fluid for the annoyance of naked animals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32278455-427c-4d8d-8450-774d3b723afc",
                        "source_entry_id": "33fd7aca-0d10-3717-9955-22e577b8da89",
                        "source_sense_id": "5572c4b5-8dc7-3066-b272-6ed602b1c866",
                        "source_sense_description": "Reiz, welche eine Reaktion hervorruft",
                        "target_lang_word": "excitation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67410905-0938-3de7-bf65-adf17a2fedc6",
                                        "entry_id": "90173339-811c-344d-b6c1-1a5517652f5f",
                                        "glosses": [
                                            "The act of exciting or putting in motion; the act of rousing up or awakening."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31b55be7-01ad-4e94-8e39-8c33cdc31bce",
                                                "sense_id": "67410905-0938-3de7-bf65-adf17a2fedc6",
                                                "text": "Generator excitation is obtained by a combination of the separately-excited and self-excited fields, and the output is controlled by a resistance in the separate field circuit adjusted by the load regulator under the control of the engine governor."
                                            },
                                            {
                                                "example_id": "9c530a0c-874e-4898-a825-ba8c3dca4835",
                                                "sense_id": "67410905-0938-3de7-bf65-adf17a2fedc6",
                                                "text": "Wheelslip automatically causes the main generator field excitation to be reduced; the load regulator is forced back to minimum excitation and, if operating in one of the two stages of traction motor field divert, causes reversion to full field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23b155b5-0dda-3a27-b060-bc3be0e7f708",
                                        "entry_id": "90173339-811c-344d-b6c1-1a5517652f5f",
                                        "glosses": [
                                            "The act of producing excitement (stimulation); also, the excitement produced."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ffbb3a1-b831-4068-bab2-29a8ebaff0ae",
                                                "sense_id": "23b155b5-0dda-3a27-b060-bc3be0e7f708",
                                                "text": "Baiae: An ancient Roman pleasure resort [...]. It was the focal point of all kinds fo erotic experiments, unbridled debauchery, amorous intrigues and excitations, sexual encounters and aberrations."
                                            },
                                            {
                                                "example_id": "c352e121-5ac0-4f92-8c7d-22be807ca3b9",
                                                "sense_id": "23b155b5-0dda-3a27-b060-bc3be0e7f708",
                                                "text": "I'm pickin' up good vibrations / She's giving me the excitations."
                                            },
                                            {
                                                "example_id": "85ea7e11-9fa1-476f-9fa2-43268af24465",
                                                "sense_id": "23b155b5-0dda-3a27-b060-bc3be0e7f708",
                                                "text": "The erotics of composition are essential to the process, some prereflective excitation and orientation, some sense that your own little verse-craft can dock safe and sound at the big quay of language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a003819-b22e-3285-9684-a3f308d08bdf",
                                        "entry_id": "90173339-811c-344d-b6c1-1a5517652f5f",
                                        "glosses": [
                                            "The activity produced in an organ, tissue, or part, such as a nerve cell, as a result of stimulation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3dbd18c0-b028-347c-aaef-b40cea738f2d",
                                        "entry_id": "90173339-811c-344d-b6c1-1a5517652f5f",
                                        "glosses": [
                                            "A transition of a nucleus, atom or molecule to an excited state by the absorption of a quantum of energy; the opposite of relaxation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
