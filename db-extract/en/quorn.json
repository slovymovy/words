                "senses": [
                    {
                        "sense_id": "bcbf4e21-11d5-3b7d-9261-4513db393660",
                        "entry_id": "e564e82f-fefe-3f57-b0ad-c5860024baa6",
                        "glosses": [
                            "A famous fox hunt (one of the world's oldest, established in 1696) in Leicestershire."
                        ],
                        "tags": [
                            "with-definite-article"
                        ],
                        "examples": [
                            {
                                "example_id": "70f20273-b7b2-44d7-a9b6-4fbc4cdc70bd",
                                "sense_id": "bcbf4e21-11d5-3b7d-9261-4513db393660",
                                "text": "The House of More has a pretty Georgian paneling through most of the rooms, but in the dining room the walls are level and painted a dull stone color. […] Some photographs of the Quorn hung over the mantelpiece, and five or six drab ancestors filled up the remaining space."
                            },
                            {
                                "example_id": "67e190e9-f87a-4b27-9ed9-a238f83dea39",
                                "sense_id": "bcbf4e21-11d5-3b7d-9261-4513db393660",
                                "text": "I've never hunted myself, but I understand that half the battle is being able to make noises like some jungle animal with dyspepsia, and I believe that Aunt Dahlia in her prime could lift fellow-members of the Quorn and Pytchley out of their saddles with a single yip, though separated from them by two ploughed fields and a spinney."
                            }
                        ]
                    },
                    {
                        "sense_id": "8abe9a3f-4754-399a-ac88-1d74b459878a",
                        "entry_id": "e564e82f-fefe-3f57-b0ad-c5860024baa6",
                        "glosses": [
                            "A village and civil parish (formerly Quorndon) in Charnwood district, Leicestershire, England (OS grid ref SK5616)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b0d348cb-b256-3955-a6fc-fc3fcefa0a71",
