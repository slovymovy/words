                                    {
                                        "sense_id": "e29cd73e-fe86-34ce-8568-2530c527d3ea",
                                        "entry_id": "6e8a6941-9c49-3aef-a33f-898dfa01b846",
                                        "glosses": [
                                            "Grundform, Stichwort im Lexikon; Einheit der (Langue)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0528bb8-e224-464a-b5ed-f07499201cf5",
                                                "sense_id": "e29cd73e-fe86-34ce-8568-2530c527d3ea",
                                                "text": "\"Wort\" als Stichwort im Lexikon ist ein Lexem, das für die Wortformen \"Wort\", \"Wortes\", \"Worte\", \"Wörter\" und \"Wörtern\" steht."
                                            },
                                            {
                                                "example_id": "ec376698-b7fb-4e5f-97f3-142fcdd32cb4",
                                                "sense_id": "e29cd73e-fe86-34ce-8568-2530c527d3ea",
                                                "text": "„Kohyponyme sind Lexeme, die sich gleichrangig auf das gleiche Hyperonym beziehen.“"
                                            },
                                            {
                                                "example_id": "82459c5a-fa61-48a9-92cc-7d8a788f9064",
                                                "sense_id": "e29cd73e-fe86-34ce-8568-2530c527d3ea",
                                                "text": "„Sowohl 1940 als auch 1999 sind einige Lexeme nicht anzutreffen, die heute allgemein bekannt sind, oft sogar als Modewörter bezeichnet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "280c5951-2925-322f-bdc2-c87fdb5f608a",
                                        "entry_id": "6e8a6941-9c49-3aef-a33f-898dfa01b846",
                                        "glosses": [
                                            "freies oder gebundenes Morphem mit lexikalischer Bedeutung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e843f657-2947-496e-8c2a-86a1af533282",
                                                "sense_id": "280c5951-2925-322f-bdc2-c87fdb5f608a",
                                                "text": "\"schreib-\" ist ein gebundenes lexikalisches Morphem; \"Tisch\" ist ein freies lexikalisches Morphem; beide sind Lexeme."
                                            },
                                            {
                                                "example_id": "c4437b9a-83ce-455f-808b-b3d0875fa8e2",
                                                "sense_id": "280c5951-2925-322f-bdc2-c87fdb5f608a",
                                                "text": "„Pronominaladverbien sind feste Lexeme und können nach der geltenden Norm nicht in ihre Bestandteile zerlegt werden, also Satzklammern bilden.“"
                                            },
                                            {
                                                "example_id": "0f432526-5282-458f-be88-e9edc72bc99d",
                                                "sense_id": "280c5951-2925-322f-bdc2-c87fdb5f608a",
                                                "text": "„Der jährliche Zugang an neuen Fachwörtern ist mit circa 250000 Lexemen sicher nicht zu hoch geschätzt.“"
                                            },
                                            {
                                                "example_id": "f84ef1ce-702b-4e87-8a91-a9646a0db02d",
                                                "sense_id": "280c5951-2925-322f-bdc2-c87fdb5f608a",
                                                "text": "„Durch Assoziation ruft das eine Lexem gleichsam die anderen herbei und tastet ihre Bedeutungen auf hilfreiche Merkmale ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
