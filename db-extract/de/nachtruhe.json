                                        "entry_id": "de91dd7c-d4e6-3bb9-a923-d16cda11d9e4",
                                        "glosses": [
                                            "ustalony czas w nocy, podczas którego obowiązuje zakaz hałasowania, by umożliwić innym spokojny odpoczynek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b30a45cf-aa59-48ca-ae8b-1e8b9c922b92",
                                                "sense_id": "ca744a18-4765-3b0b-9b97-0b30b42786bf",
                                                "text": "[…] grupa podpitej młodzieży szła przez osiedle kopiąc kosze, wrzaskiem i przekleństwami zakłócając ciszę nocną"
                                            },
                                            {
                                                "example_id": "17ccff7d-20f4-4b5c-a7c9-7080fd0a4f1d",
                                                "sense_id": "ca744a18-4765-3b0b-9b97-0b30b42786bf",
                                                "text": "Jeszcze tego by brakowało, żeby w ciszy nocnej rozszczekały się psy wzdłuż ulicy"
                                            }
