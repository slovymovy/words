                    {
                        "translation_id": "f45ac55b-5f70-40af-a512-3a2a08321b43",
                        "source_entry_id": "6933267a-d878-3ee8-9b3c-cc3f7685e858",
                        "target_lang_word": "pretentious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
