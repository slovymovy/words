                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geluksvogel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8af7cccf-07ec-32f2-a773-22da92aee177",
                                        "entry_id": "a75467b0-c46e-3ed4-a8fc-797a2585a41a",
                                        "glosses": [
                                            "iemand die onwaarschijnlijk veel geluk lijkt te hebben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8a96ce7-ddca-4a12-b4c1-3a138f55fdb9",
                                                "sense_id": "8af7cccf-07ec-32f2-a773-22da92aee177",
                                                "text": "Hij is altijd al een geluksvogel geweest."
                                            },
                                            {
                                                "example_id": "9d64cdd3-1939-49bd-befc-01d4e1c87310",
                                                "sense_id": "8af7cccf-07ec-32f2-a773-22da92aee177",
                                                "text": "Even achteloos als de vorige reis, deed joan den bal over de baan rollen, en wierp, even als de vorige reis, den koning om. ‘Zie mij zulk een' geluksvogel eens aan!’ riep de Jonker van scherpenzeel uit: ‘hij raakt slag op slag, zonder er eens naar om te zien.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "621a392a-e255-464d-942d-379ec5bf6bd4",
