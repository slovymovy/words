                "senses": [
                    {
                        "sense_id": "10e20adc-5017-3165-9e38-acd5009deb7b",
                        "entry_id": "c26420cd-748d-31d6-89f1-669c94fc9328",
                        "glosses": [
                            "een bijgebouw bij het huis of de boerderij om veldvruchten, landbouwproducten en -werktuigen in op te slaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e2cc198-8318-4ae5-b808-739686d71d03",
                                "sense_id": "10e20adc-5017-3165-9e38-acd5009deb7b",
                                "text": "Zet die fiets eens in de schuur."
                            },
                            {
                                "example_id": "7bb6e58e-997a-4057-8d0d-882c4cfdcc56",
                                "sense_id": "10e20adc-5017-3165-9e38-acd5009deb7b",
                                "text": "Het vergeefse geblaf van een hond in een schuur zou alle stiltes doorbreken."
                            },
                            {
                                "example_id": "380c75b1-4c4c-4302-9b0f-bdc5148a831e",
                                "sense_id": "10e20adc-5017-3165-9e38-acd5009deb7b",
                                "text": "Waarom heb ik me niet omgedraaid toen het gevloek ophield? Ik had moeten checken of alles nog wel goed met haar was! Heb ik iets gemist? Een roep om hulp misschien? Ik was degene die daarboven in de schuur de boel gek maakte en kandidaten wierf voor die riskante afdaling."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc5a88b1-db48-4084-8f68-4db7e4c41187",
                        "source_entry_id": "c26420cd-748d-31d6-89f1-669c94fc9328",
                        "source_sense_id": "10e20adc-5017-3165-9e38-acd5009deb7b",
                        "source_sense_description": "een opslagplaats voor veldvruchten en gereedschappen",
                        "target_lang_word": "Scheune",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scheune",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "745b0781-ffa5-39e8-93ec-f886beabacc3",
                                        "entry_id": "8b37bf0f-013e-3c52-bfa9-17ef5e13c6ef",
                                        "glosses": [
                                            "landwirtschaftliches Gebäude zum Aufbewahren von Gütern, insbesondere von Getreide"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef2ef813-44db-4c86-ba0a-565591b00995",
                                                "sense_id": "745b0781-ffa5-39e8-93ec-f886beabacc3",
                                                "text": "In Gebirgsgegenden gibt es Scheunen mit Hocheinfahrt."
                                            },
                                            {
                                                "example_id": "c2422e38-5a3a-4008-8557-89093fa86396",
                                                "sense_id": "745b0781-ffa5-39e8-93ec-f886beabacc3",
                                                "text": "„Über dem Hof schwebte Musik, wurde von der düsteren Wand der Scheune zurückgeworfen und kam durch das Rohr des Kanonenofens in den Hühnerstall, wo die Mutter sich auf einen langen Abend eingerichtet hatte.“"
                                            },
                                            {
                                                "example_id": "74b35e13-eefd-46ea-abb7-6fda33435f08",
                                                "sense_id": "745b0781-ffa5-39e8-93ec-f886beabacc3",
                                                "text": "„Biagio stand im Vorhof der Scheune mit nacktem Oberkörper vor einer mit Wasser gefüllten, weiß emaillierten Blechschüssel und zeigte uns, wie das ging.“"
                                            },
                                            {
                                                "example_id": "43402372-a8ec-4525-a78e-cd3d08ca5289",
                                                "sense_id": "745b0781-ffa5-39e8-93ec-f886beabacc3",
                                                "text": "„Hogan war in der Scheune bei der Arbeit.“"
                                            },
                                            {
                                                "example_id": "b9efe636-b5a4-4c62-88eb-0244fe36bd1a",
                                                "sense_id": "745b0781-ffa5-39e8-93ec-f886beabacc3",
                                                "text": "„So trugen sie den Schwerverletzten nach Walujewo, wo immer noch der kleine König von Rom vor dem Zelt seines Vaters ausharrte und in einer geräumigen Scheune eine Verbandsstelle eingerichtet worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
