                "senses": [
                    {
                        "sense_id": "862478f3-9dc7-3c74-adf2-ec4053375232",
                        "entry_id": "82c0ffc8-a794-37c7-9d1b-312eea1d2661",
                        "glosses": [
                            "Person, die etwas in die Wege leitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "195cd136-a550-4de1-8506-60590f54c7f4",
                                "sense_id": "862478f3-9dc7-3c74-adf2-ec4053375232",
                                "text": "„Wir konzentrieren uns hierbei vor allem auf dichterische Persönlichkeiten und Werke, haben aber auch die Leistungen der Begründer der Tiefenpsychologie und eines Philosophen (Karl Popper) zu würdigen versucht.“"
                            },
                            {
                                "example_id": "030ab24c-196f-4bbd-9bff-5798aeeda4d5",
                                "sense_id": "862478f3-9dc7-3c74-adf2-ec4053375232",
                                "text": "„Der deutsche Naturforscher Alexander von Humboldt (1769-1859) gilt als der Begründer der Biogeographie.“"
                            },
                            {
                                "example_id": "e15beaf9-999c-4851-9c27-a91234ca0fdd",
                                "sense_id": "862478f3-9dc7-3c74-adf2-ec4053375232",
                                "text": "„Berthold Otto ist Begründer des freien Gesamtunterrichts, den er neben dem üblichen Fachunterricht mit allen Jahrgängen seiner Schule gemeinsam in einer Stunde am Wochenende […] in Form einer familiären Unterhaltung pflegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
