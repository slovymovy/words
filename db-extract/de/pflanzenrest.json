                            {
                                "example_id": "c652e669-d357-4ddb-ae31-b1450738e63e",
                                "sense_id": "b02a88e2-dd83-3d33-b905-c0b57ade742e",
                                "text": "„Gyamfi zeigte auf einen schwarzen Lederkoffer, an dem Schlamm und Pflanzenreste klebten.“"
                            },
                            {
                                "example_id": "e8551aa4-f188-4d45-92e1-5ccc4011a749",
                                "sense_id": "b02a88e2-dd83-3d33-b905-c0b57ade742e",
                                "text": "„Selbst der abgebrochene Stängel stank einfach widerlich, eher wie ein platt gefahrenes Tier als nach verrottenden Pflanzenresten.“"
                            }
                        ],
