                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff8921e5-6a9d-30a4-9eec-637281b24be8",
                                        "entry_id": "8d060124-2c6c-3866-8f58-43ec9a858ce8",
                                        "glosses": [
                                            "Away, having left."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34b794e7-9463-436c-9a98-68f75e7ac25a",
                                                "sense_id": "ff8921e5-6a9d-30a4-9eec-637281b24be8",
                                                "text": "Are they gone already?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c4826b5-d787-31c5-be9b-daafaf526134",
                                        "entry_id": "8d060124-2c6c-3866-8f58-43ec9a858ce8",
                                        "glosses": [
                                            "No longer existing, having passed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ed01baa-b54c-4702-b2cd-4521de81e088",
                                                "sense_id": "9c4826b5-d787-31c5-be9b-daafaf526134",
                                                "text": "The days of my youth are gone."
                                            },
                                            {
                                                "example_id": "54556428-d534-4983-a7c1-0d60cc02de6e",
                                                "sense_id": "9c4826b5-d787-31c5-be9b-daafaf526134",
                                                "text": "All the little shops that used to be here are now gone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f57e5f1b-024a-302d-81d5-16cfa807a63d",
                                        "entry_id": "8d060124-2c6c-3866-8f58-43ec9a858ce8",
                                        "glosses": [
                                            "Used up."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "864af634-bb0e-4002-8cd3-32e4ce0351f1",
                                                "sense_id": "f57e5f1b-024a-302d-81d5-16cfa807a63d",
                                                "text": "I'm afraid all the coffee is gone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd46d1f2-88f4-3967-bf33-64d0fe2523ef",
                                        "entry_id": "8d060124-2c6c-3866-8f58-43ec9a858ce8",
                                        "glosses": [
                                            "Broken, failed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffbf597b-7000-4a6b-87bc-9fa0bb6fdde8",
                                                "sense_id": "dd46d1f2-88f4-3967-bf33-64d0fe2523ef",
                                                "text": "The bulb is gone. Can you put a new one in?"
                                            },
                                            {
                                                "example_id": "36d4b397-2272-4188-9153-3d2c040a3fd1",
                                                "sense_id": "dd46d1f2-88f4-3967-bf33-64d0fe2523ef",
                                                "text": "The car isn't driveable — the steering is gone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7d7b45e-2ff6-3a07-afee-a986a3eb2d14",
                                        "entry_id": "8d060124-2c6c-3866-8f58-43ec9a858ce8",
                                        "glosses": [
                                            "Dead."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ddde7af-9c6c-4936-aae0-fb8a467e6ec6",
                                                "sense_id": "f7d7b45e-2ff6-3a07-afee-a986a3eb2d14",
                                                "text": "Dust, that a breath could blow aside, yet that was once, like ourselves, animate with hope, passion, and sorrow, is below; around are the vain memorials of human grief and human pride; yet all alike dedicated to the gone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "083c9a19-d71e-30ae-9449-f14b2daf4c89",
                                        "entry_id": "8d060124-2c6c-3866-8f58-43ec9a858ce8",
                                        "glosses": [
                                            "Doomed, done for."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a69c5993-a7e2-42f8-b16d-f6d3fb8e91f2",
                                                "sense_id": "083c9a19-d71e-30ae-9449-f14b2daf4c89",
                                                "text": "Have you seen the company's revenue? It's through the floor. They're gone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff30b02c-aa8d-3981-8822-04831fbd8afc",
                                        "entry_id": "8d060124-2c6c-3866-8f58-43ec9a858ce8",
                                        "glosses": [
                                            "Not fully aware of one's surroundings, often through intoxication or mental decline."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adfbb796-5039-4bde-8654-a39713522c1e",
                                                "sense_id": "ff30b02c-aa8d-3981-8822-04831fbd8afc",
                                                "text": "Don't bother trying to understand what Grandma says; she's gone."
                                            },
                                            {
                                                "example_id": "0e49724b-011d-47dd-a4ad-3e13db64e2b0",
                                                "sense_id": "ff30b02c-aa8d-3981-8822-04831fbd8afc",
                                                "text": "[S]he put on a kind of sing-song voice whenever she was pissed, it was one of the signs that she was really gone[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b3c0b64-ba08-30c2-8a6b-c4714fb5001e",
                                        "entry_id": "8d060124-2c6c-3866-8f58-43ec9a858ce8",
                                        "glosses": [
                                            "Infatuated; in love (+ on, for, in)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b883c9e5-dc02-4dbf-ba7d-50c507e9ad55",
                                                "sense_id": "0b3c0b64-ba08-30c2-8a6b-c4714fb5001e",
                                                "text": "I am, of course, ‘gone’ for you."
                                            },
                                            {
                                                "example_id": "3e80580e-40f4-44ea-9718-c302d1f0fdc2",
                                                "sense_id": "0b3c0b64-ba08-30c2-8a6b-c4714fb5001e",
                                                "text": "But he was pleased and happy and flattered. She was evidently frightfully gone on him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f89e5229-f9ba-3f39-ba8e-99ffa912997b",
                                        "entry_id": "8d060124-2c6c-3866-8f58-43ec9a858ce8",
                                        "glosses": [
                                            "Excellent, wonderful; crazy."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76185a7e-8f2e-4190-938e-d320204ba61a",
                                                "sense_id": "f89e5229-f9ba-3f39-ba8e-99ffa912997b",
                                                "text": "It was a group of real gone cats."
                                            },
                                            {
                                                "example_id": "e243daca-52c9-4573-ad8f-0230d25f67fb",
                                                "sense_id": "f89e5229-f9ba-3f39-ba8e-99ffa912997b",
                                                "text": "“All right, all right, don’t drop your gold all over the place. I have found the gonest little girl in the world and I am going straight to the Lion’s Den with her tonight.”"
                                            },
                                            {
                                                "example_id": "4199fcc4-4795-4410-be4c-e8e40e5294bf",
                                                "sense_id": "f89e5229-f9ba-3f39-ba8e-99ffa912997b",
                                                "text": "Dad, I want to be a jock. All a jock needs is some hep patter and a real gone image. Now, they just don't teach that jazz in college."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f188ead-b002-3603-acae-228c79ee27d1",
                                        "entry_id": "8d060124-2c6c-3866-8f58-43ec9a858ce8",
                                        "glosses": [
                                            "Ago (used post-positionally)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc366caa-a07a-4b1d-8a7f-eac5c20df9cb",
                                                "sense_id": "5f188ead-b002-3603-acae-228c79ee27d1",
                                                "text": "Six nights gone, your brother fell upon my uncle Stafford, encamped with his host at a village called Oxcross not three days ride from Casterly Rock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee7f80c8-3503-37c7-a992-50589767b741",
                                        "entry_id": "8d060124-2c6c-3866-8f58-43ec9a858ce8",
                                        "glosses": [
                                            "Weak; faint; feeling a sense of goneness."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb144fad-0e8d-3279-921f-d24e3ab2e2ce",
                                        "entry_id": "8d060124-2c6c-3866-8f58-43ec9a858ce8",
                                        "glosses": [
                                            "Of an arrow: wide of the mark."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1719cdf8-c133-3394-bb03-ed80c8d5ff0a",
                                        "entry_id": "8d060124-2c6c-3866-8f58-43ec9a858ce8",
                                        "glosses": [
                                            "Used with a duration to indicate for how long a process has been developing, an action has been performed or a state has persisted; especially, pregnant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "679aa1ac-6c59-42e0-8467-8dbb19ccf74b",
                                                "sense_id": "1719cdf8-c133-3394-bb03-ed80c8d5ff0a",
                                                "text": "She’s three months gone"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f318b927-1e0b-3293-8c5c-f8e397fdabb4",
                                        "entry_id": "22ab7043-e62c-33e1-857b-50a633aa2d75",
                                        "glosses": [
                                            "Past, after, later than (a time)."
                                        ],
                                        "tags": [
                                            "British",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eafacd89-c7be-4c21-89ac-02374798f305",
                                                "sense_id": "f318b927-1e0b-3293-8c5c-f8e397fdabb4",
                                                "text": "You'd better hurry up, it's gone four o'clock."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21af81ed-a150-330d-8d33-61e35bf15c3e",
                                        "entry_id": "3af791db-483c-309c-8cc7-b74c621fd1f2",
                                        "glosses": [
                                            "Alternative spelling of gon /gon': clipping of gonna or going to."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "contraction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c771fb1f-05c9-466a-8285-f6ef8b1f8387",
                                                "sense_id": "21af81ed-a150-330d-8d33-61e35bf15c3e",
                                                "text": "Take or be taken. Get yours or get got. It was the code of the streets and I'd lived by it. The way things was looking, I was prolly gone die by it too."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
