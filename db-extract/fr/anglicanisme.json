                                        "entry_id": "fa45db1c-2c1e-3ff9-b8d9-b7205707e298",
                                        "glosses": [
                                            "Richtung des Christentums, die sich aus den Praktiken, der Liturgie und der Identität der Kirche von England nach der englischen Reformation im Kontext der Reformation in Europa entwickelt hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ce90227-22a0-4c0f-b964-96160e49dfdf",
                                                "sense_id": "c6ac96a3-d63a-34f0-b831-801e671dc421",
                                                "text": "Der Anglikanismus wird mit seinen Strukturen, seiner Theologie und seinen Gottesdienstformen gemeinhin als eine eigenständige christliche Tradition verstanden, die einen Mittelweg zwischen dem römischen Katholizismus und den lutherischen und reformierten Varianten des Protestantismus darstellt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
