{
    "word_family": [
        "простить",
        "прощение",
        "прощаться",
        "простительный"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "673a8117-3cdf-3df4-b790-c65274d45099",
                    "sense_definition": "Выражает сожаление по поводу причиняемого беспокойства, неудобства или огорчения.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "apology_politeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Простите</w>, я не хотел вас обидеть своим резким замечанием.",
                            "target_lang_translations": {
                                "en": "<w>I'm sorry</w>, I didn't mean to offend you with my harsh remark.",
                                "de": "<w>Es tut mir leid</w>, ich wollte Sie mit meiner schroffen Bemerkung nicht verletzen."
                            }
                        },
                        {
                            "text": "<w>Простите</w> за опоздание, автобус задержался в пути.",
                            "target_lang_translations": {
                                "en": "<w>Sorry</w> for being late, the bus got held up on the way.",
                                "de": "<w>Entschuldigung</w> für die Verspätung, der Bus hatte unterwegs Verspätung."
                            }
                        }
                    ],
                    "synonyms": [
                        "извините",
                        "прошу прощения"
                    ],
                    "common_phrases": [
                        "простите за беспокойство",
                        "простите за опоздание",
                        "простите великодушно"
                    ],
                    "target_lang_definitions": {
                        "en": "Expresses regret regarding caused trouble, inconvenience, or distress.",
                        "de": "Drückt Bedauern über verursachte Unannehmlichkeiten, Störungen oder Kummer aus."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sorry",
                                "target_lang_sense_clarification": "general apology"
                            },
                            {
                                "target_lang_word": "I'm sorry",
                                "target_lang_sense_clarification": "phrase expressing regret"
                            },
                            {
                                "target_lang_word": "forgive me",
                                "target_lang_sense_clarification": "request for forgiveness"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Entschuldigung",
                                "target_lang_sense_clarification": "allgemeine Entschuldigung"
                            },
                            {
                                "target_lang_word": "Es tut mir leid",
                                "target_lang_sense_clarification": "Ausdruck des Bedauerns"
                            },
                            {
                                "target_lang_word": "Verzeihen Sie",
                                "target_lang_sense_clarification": "höfliche Bitte um Verzeihung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc0ea3e3-2545-3b28-87ae-779b4d6302ae",
                    "sense_definition": "Употребляется как форма вежливости при вопросе, просьбе или обращении к кому-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "apology_politeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Простите</w>, вы не подскажете, как пройти к ближайшей станции метро?",
                            "target_lang_translations": {
                                "en": "<w>Excuse me</w>, could you tell me how to get to the nearest metro station?",
                                "de": "<w>Entschuldigen Sie</w>, können Sie mir sagen, wie ich zur nächsten U-Bahn-Station komme?"
                            }
                        },
                        {
                            "text": "<w>Простите</w>, это место свободно или здесь кто-то сидит?",
                            "target_lang_translations": {
                                "en": "<w>Excuse me</w>, is this seat free or is someone sitting here?",
                                "de": "<w>Entschuldigung</w>, ist dieser Platz frei oder sitzt hier jemand?"
                            }
                        }
                    ],
                    "synonyms": [
                        "извините"
                    ],
                    "common_phrases": [
                        "простите пожалуйста",
                        "простите меня"
                    ],
                    "target_lang_definitions": {
                        "en": "Used as a form of politeness when asking, requesting, or addressing someone.",
                        "de": "Wird als Höflichkeitsform bei einer Frage, Bitte oder Ansprache an jemanden verwendet."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "excuse me",
                                "target_lang_sense_clarification": "polite attention getter"
                            },
                            {
                                "target_lang_word": "pardon me",
                                "target_lang_sense_clarification": "formal polite address"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Entschuldigung",
                                "target_lang_sense_clarification": "höfliche Aufmerksamkeit erregen"
                            },
                            {
                                "target_lang_word": "Entschuldigen Sie",
                                "target_lang_sense_clarification": "höfliche Ansprache"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17cd9293-d0bf-33ea-8f43-61e51275ead2",
                    "sense_definition": "Выражает протест или несогласие с чем-либо.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ну уж <w>простите</w>, но я совершенно не согласен с вашими выводами.",
                            "target_lang_translations": {
                                "en": "Well, <w>excuse me</w>, but I completely disagree with your conclusions.",
                                "de": "Nun, <w>entschuldigen Sie mal</w>, aber ich stimme Ihren Schlussfolgerungen überhaupt nicht zu."
                            }
                        },
                        {
                            "text": "<w>Простите</w>, но это уже переходит всякие границы приличия.",
                            "target_lang_translations": {
                                "en": "<w>Excuse me</w>, but this crosses all boundaries of decency.",
                                "de": "<w>Verzeihung</w>, aber das überschreitet jetzt wirklich alle Grenzen des Anstands."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ну уж простите"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Expresses protest or disagreement.",
                        "de": "Drückt Protest oder Uneinigkeit mit etwas aus."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "excuse me",
                                "target_lang_sense_clarification": "indignant or sarcastic"
                            },
                            {
                                "target_lang_word": "beg your pardon",
                                "target_lang_sense_clarification": "expressing shock or disagreement"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Entschuldigung",
                                "target_lang_sense_clarification": "empört oder sarkastisch"
                            },
                            {
                                "target_lang_word": "Verzeihung",
                                "target_lang_sense_clarification": "Ausdruck des Widerspruchs"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37d50ab5-95d3-3159-b61b-ca55190aa959",
                    "sense_definition": "То же, что прощайте; используется при расставании.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Простите</w>, друзья, мне пора отправляться в дальний путь.",
                            "target_lang_translations": {
                                "en": "<w>Farewell</w>, friends, it is time for me to set off on a long journey.",
                                "de": "<w>Lebt wohl</w>, Freunde, es ist Zeit für mich, mich auf eine lange Reise zu begeben."
                            }
                        },
                        {
                            "text": "Мы больше не увидимся, так что <w>простите</w> и не поминайте лихом.",
                            "target_lang_translations": {
                                "en": "We won't see each other again, so <w>farewell</w> and don't think ill of me.",
                                "de": "Wir werden uns nicht wiedersehen, also <w>lebt wohl</w> und behaltet mich in guter Erinnerung."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Same as farewell; used when parting.",
                        "de": "Gleichbedeutend mit Lebewohl; wird beim Abschied verwendet."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "farewell",
                                "target_lang_sense_clarification": "literary or dramatic parting"
                            },
                            {
                                "target_lang_word": "goodbye",
                                "target_lang_sense_clarification": "final parting"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Lebt wohl",
                                "target_lang_sense_clarification": "literarischer oder dramatischer Abschied"
                            },
                            {
                                "target_lang_word": "Gehabt euch wohl",
                                "target_lang_sense_clarification": "veralteter Abschiedsgruß"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "338a5d7b-4388-3c27-9351-30cc7b760aa8",
                    "sense_definition": "Форма второго лица множественного числа повелительного наклонения глагола <w>простить</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Простите</w> нас за то, что мы не смогли прийти на ваш праздник.",
                            "target_lang_translations": {
                                "en": "<w>Forgive</w> us for not being able to come to your party.",
                                "de": "<w>Verzeiht</w> uns, dass wir nicht zu eurem Fest kommen konnten."
                            }
                        },
                        {
                            "text": "Пожалуйста, <w>простите</w> ему эту маленькую оплошность.",
                            "target_lang_translations": {
                                "en": "Please <w>forgive</w> him for this small oversight.",
                                "de": "Bitte <w>verzeihen Sie</w> ihm dieses kleine Versehen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Second person plural imperative form of the verb 'to forgive'.",
                        "de": "Form der zweiten Person Plural im Imperativ des Verbs 'verzeihen' oder 'entschuldigen'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forgive",
                                "target_lang_sense_clarification": "imperative command or plea"
                            },
                            {
                                "target_lang_word": "pardon",
                                "target_lang_sense_clarification": "imperative"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verzeiht",
                                "target_lang_sense_clarification": "Imperativ Plural"
                            },
                            {
                                "target_lang_word": "entschuldigt",
                                "target_lang_sense_clarification": "Imperativ Plural"
                            },
                            {
                                "target_lang_word": "verzeihen Sie",
                                "target_lang_sense_clarification": "Imperativ Höflichkeitsform"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3d24984-7411-3375-b87b-43efabf16203",
                    "sense_definition": "Форма будущего времени второго лица множественного числа изъявительного наклонения глагола <w>простить</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я надеюсь, вы <w>простите</w> меня, когда узнаете все обстоятельства дела.",
                            "target_lang_translations": {
                                "en": "I hope you <w>will forgive</w> me when you learn all the circumstances of the matter.",
                                "de": "Ich hoffe, Sie <w>werden</w> mir <w>verzeihen</w>, wenn Sie alle Umstände der Angelegenheit erfahren."
                            }
                        },
                        {
                            "text": "Вы никогда не <w>простите</w> себе, если упустите этот уникальный шанс.",
                            "target_lang_translations": {
                                "en": "You <w>will</w> never <w>forgive</w> yourself if you miss this unique chance.",
                                "de": "Sie <w>werden</w> sich selbst nie <w>verzeihen</w>, wenn Sie diese einmalige Chance verpassen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "future tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Future tense second person plural indicative form of the verb 'to forgive'.",
                        "de": "Zukunft- oder Präsensform der zweiten Person Plural im Indikativ des Verbs 'verzeihen' oder 'entschuldigen'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "will forgive",
                                "target_lang_sense_clarification": "future action"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "werdet verzeihen",
                                "target_lang_sense_clarification": "Zukunft"
                            },
                            {
                                "target_lang_word": "verzeiht",
                                "target_lang_sense_clarification": "Gegenwart"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}