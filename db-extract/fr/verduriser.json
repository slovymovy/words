                "senses": [
                    {
                        "sense_id": "06b87ce9-1a4b-3282-b02b-d113791368f2",
                        "entry_id": "97f742e7-ce27-31c9-8933-ab5337815185",
                        "glosses": [
                            "Doter de verdure, de plantations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92511723-1ca8-4259-92f7-8410d8c57ebf",
                                "sense_id": "06b87ce9-1a4b-3282-b02b-d113791368f2",
                                "text": "Il faudrait verduriser cette rue."
                            },
                            {
                                "example_id": "ed7a45ad-da98-4f37-8d0b-e3d58494a955",
                                "sense_id": "06b87ce9-1a4b-3282-b02b-d113791368f2",
                                "text": "Le plan fait la part belle à une série d’aménagements visant à sécuriser, moderniser et verduriser le réseau routier secondaire wallon."
                            },
                            {
                                "example_id": "3d937c1a-ad84-41ed-ad74-9561d0bd72dd",
                                "sense_id": "06b87ce9-1a4b-3282-b02b-d113791368f2",
                                "text": "L'occasion de ce chantier a été saisie pour améliorer l'espace public et pour verduriser un peu plus largement le lieu. […] Au total, ce seront 19 arbres qui seront plantés en novembre […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "77654271-7c2c-3e7c-9878-139b180b3f4d",
                        "entry_id": "97f742e7-ce27-31c9-8933-ab5337815185",
                        "glosses": [
                            "Remplacer des véhicules polluants par d’autres davantage respectueux de l’environnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b0b695e-14c6-44bb-8253-9bc7fdc9429a",
                                "sense_id": "77654271-7c2c-3e7c-9878-139b180b3f4d",
                                "text": "Objectif: dépolluer l’air en décourageant l’usage même de la voiture. La proposition Magnette offre l’avantage de verduriser le parc mais ne jouerait qu’indirectement sur le nombre de véhicules de société circulant sur nos routes."
                            }
                        ]
                    }
