                "senses": [
                    {
                        "sense_id": "10ae4a89-2035-358d-845a-cad838044d45",
                        "entry_id": "203463e0-c5fe-3328-877a-a0bd277df3e9",
                        "glosses": [
                            "Exemplar oder Art einer Pflanze, deren Samenanlage in ein Fruchtblatt eingeschlossen ist; aus der taxonomischen Gruppe [2]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2a9e3b4-5898-4f4a-acce-ad74b67f18ea",
                                "sense_id": "10ae4a89-2035-358d-845a-cad838044d45",
                                "text": "„Eine umstrittene frühe Angiosperme ist Nanjinganthus dendrostyla, […]. Sollte es sich dabei tatsächlich um einen Bedecktsamer handeln, so ist möglicherweise die beschriebene Rekonstruktion der ersten Angiospermen-Blüte auf dem Holzweg, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0666b2a6-dd2c-3bca-83bc-35ed1dd8a0ce",
                        "entry_id": "203463e0-c5fe-3328-877a-a0bd277df3e9",
                        "glosses": [
                            "Klasse in der Abteilung Gefäßpflanzen"
                        ],
                        "tags": [
                            "collective",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "24c051ef-039b-4c8e-aa99-34c9306c2983",
                                "sense_id": "0666b2a6-dd2c-3bca-83bc-35ed1dd8a0ce",
                                "text": "Die Magnolien mit ihrer spiraligen Anordnung der Fruchtblätter sind eine ursprüngliche Gruppe der Bedecktsamer."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "72a13cd0-4cee-3e52-9133-7331e4485581",
                        "entry_id": "203463e0-c5fe-3328-877a-a0bd277df3e9",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "755c30fc-f7a1-417a-b75e-c159658b7bab",
                                "sense_id": "72a13cd0-4cee-3e52-9133-7331e4485581",
                                "text": "Die meisten höheren Pflanzen gehören zu den Bedecktsamern."
                            }
                        ],
                        "sense_index_json": "\"1 oder 2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a222b74-a7ef-42cf-86c4-df924a0df159",
                        "source_entry_id": "203463e0-c5fe-3328-877a-a0bd277df3e9",
                        "source_sense_id": "10ae4a89-2035-358d-845a-cad838044d45",
                        "source_sense_description": "Pflanze/Art aus der Klasse Magnoliopsida",
                        "target_lang_word": "flowering plant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flowering plant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68535b0b-6551-362c-9a30-47701d75c66e",
                                        "entry_id": "7e3a619a-17dc-354f-a0dd-914cdb1b02d5",
                                        "glosses": [
                                            "Any plant that produces flowers and fruit; an angiosperm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbfd6d9d-ec65-4320-89ac-024c7f84694e",
                        "source_entry_id": "203463e0-c5fe-3328-877a-a0bd277df3e9",
                        "source_sense_id": "10ae4a89-2035-358d-845a-cad838044d45",
                        "source_sense_description": "Pflanze/Art aus der Klasse Magnoliopsida",
                        "target_lang_word": "angiosperm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "angiosperm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f92e35b-e862-33c2-b93d-5a368db02d00",
                                        "entry_id": "e6676abe-82cd-3af7-985d-546f9b8d0a4c",
                                        "glosses": [
                                            "Any plant of the clade Angiosperms, characterized by having ovules enclosed in an ovary; a flowering plant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46719e40-ffc7-4cfc-aafa-d7504c9c781d",
                                                "sense_id": "1f92e35b-e862-33c2-b93d-5a368db02d00",
                                                "text": "As with the Lejeuneaceae, this pattern of massive speciation appears to be correlated with the Cretaceous explosion of the angiosperms and the simultaneous creation of a host of new microenvironments, differing in humidity, light intensity, texture, etc."
                                            },
                                            {
                                                "example_id": "e6443aa1-8347-40c6-8a45-cd3ea4bd129b",
                                                "sense_id": "1f92e35b-e862-33c2-b93d-5a368db02d00",
                                                "text": "The notion of magnoliaceans as the most primitive living angiosperms, justified or not, does not mean that all their characters, including multilacunar nodal anatomy and the lack of tannins, are primary."
                                            },
                                            {
                                                "example_id": "7e091349-f94d-43cd-b67e-291aee060df9",
                                                "sense_id": "1f92e35b-e862-33c2-b93d-5a368db02d00",
                                                "text": "2009, Xin Wang, 3: New Fossils and New Hope for the Origin of Angiosperms, Pierre Pontarotti, Evolutionary Biology: Concept, Modeling, and Application, page 55,\nWith all these features, it is pretty easy for one to identify an angiosperm. This is a very normal and common practice for neobotanists. However, the situation becomes complicated when you go back to the early history of angiosperms."
                                            },
                                            {
                                                "example_id": "4744b417-f22b-4330-ac5b-57219ee97b10",
                                                "sense_id": "1f92e35b-e862-33c2-b93d-5a368db02d00",
                                                "text": "The palynoassemblage is rich in angiosperm taxa (45.63%) followed by gymnosperms (0.45%), pteridophytes (18.49%) and fungal remains (23.88%)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
