        "fr-extract.jsonl": [
            {
                "entry_id": "f050b8e9-41c4-3b8f-b33c-46c1d174942b",
                "word": "cardamome",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f1caa2c0-e876-4043-b17f-6b3951a336a3",
                        "entry_id": "f050b8e9-41c4-3b8f-b33c-46c1d174942b",
                        "tags": [
                            "plural"
                        ],
                        "form": "cardamomes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3e35898-4115-33fd-8751-655bd1bda52a",
                        "entry_id": "f050b8e9-41c4-3b8f-b33c-46c1d174942b",
                        "glosses": [
                            "Nom usuel de Elettaria cardamomum, plante de la famille des Zingiberaceae (Zingibéracées) dont la graine donne l’épice du même nom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90e17c85-b18c-42a3-a220-d74fdd2395e4",
                                "sense_id": "b3e35898-4115-33fd-8751-655bd1bda52a",
                                "text": "Ma préférence alla aux escalopes poêlées à la cardamome."
                            },
                            {
                                "example_id": "91091982-31d7-4036-8bd8-648af80b12a1",
                                "sense_id": "b3e35898-4115-33fd-8751-655bd1bda52a",
                                "text": "On s’y presse pour y acheter lentilles, patates douces, jalebis fraîchement cuisinés, pigments de couleur, étoffes, thé, noix de coco, cardamome ou poudre de curry."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1bc99b8-6820-3170-9313-e6a6ffa6ea13",
                        "entry_id": "f050b8e9-41c4-3b8f-b33c-46c1d174942b",
                        "glosses": [
                            "Épice extraite de la graine de cette plante, utilisée par exemple dans les currys indiens et dans l’hypocras."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "9f8caed0-4464-4d5f-b327-6de5ffbeb5a4",
                                "sense_id": "f1bc99b8-6820-3170-9313-e6a6ffa6ea13",
                                "text": "Autrefois nos ancêtres employaient […] les graines de paradis et la cardamome, autre graine à la saveur poivrée qui donnait une enivrante image des Indes d’où elle venait, […] et combien d’autres épices enocer, comme le cubèbe, ou le sumac."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1b1fb68-1043-40ed-9b38-d493980b0e5f",
                        "source_entry_id": "f050b8e9-41c4-3b8f-b33c-46c1d174942b",
                        "target_lang_word": "Kardamom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kardamom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c18314d-1ebf-3252-a0bd-433b0a17f039",
                                        "entry_id": "42d3e998-4e67-3e37-99f6-ffca5583e835",
                                        "glosses": [
                                            "Pflanze aus der Familie der Ingwergewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "078a7f4a-a8a5-4ec8-8c88-f9c888e0cadc",
                                                "sense_id": "8c18314d-1ebf-3252-a0bd-433b0a17f039",
                                                "text": "Im Orient trinkt man Kaffee gern mit den Kapseln des Kardamom gewürzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d5eb3743-947f-3382-909d-f25eaa16a198",
                                        "entry_id": "42d3e998-4e67-3e37-99f6-ffca5583e835",
                                        "glosses": [
                                            "Samen der Kardamom-Pflanze; orientalisches Gewürz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "688e0aac-02b8-436f-8de2-6619166d1bac",
                                                "sense_id": "d5eb3743-947f-3382-909d-f25eaa16a198",
                                                "text": "„Geschworene, Anwälte und Richter kauten Knoblauch, Zitronenschalen, Kardamom und Kümmelsamen, um sich nicht an der Atemluft der Sträflinge zu infizieren.“"
                                            },
                                            {
                                                "example_id": "b507c09b-3937-4bc1-9f17-be1ae4ad6641",
                                                "sense_id": "d5eb3743-947f-3382-909d-f25eaa16a198",
                                                "text": "Für Lebkuchen, Pfeffernüsse und Spekulatius ist das orientalische Gewürz Kardamom unverzichtbar."
                                            },
                                            {
                                                "example_id": "777038e3-79a2-4872-9b87-03d22f5e1a53",
                                                "sense_id": "d5eb3743-947f-3382-909d-f25eaa16a198",
                                                "text": "„Und wenn ich ganz ehrlich war, störte es mich nicht, dass wir uns dann alle aneinander festhielten, bis es vorbei war, denn es war warm und weich in Amalias Armen, und sie roch gut, nach Lavendelwaschpulver und Zitronengrasseife und nach Kaffee und Kardamom und Buchseiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af76c581-e745-49ef-9dd2-8013c872bf47",
                        "source_entry_id": "f050b8e9-41c4-3b8f-b33c-46c1d174942b",
