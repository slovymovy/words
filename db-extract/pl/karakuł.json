                                        "sense_id": "c73233f6-2f47-37b6-910f-22ae0e902378",
                                        "entry_id": "d1937e56-fa6e-3d86-9646-7a2a583b88f2",
                                        "glosses": [
                                            "A sheep of a Central Asian breed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50e48771-0259-3ae5-bd02-b560d1a7a713",
                                        "entry_id": "d1937e56-fa6e-3d86-9646-7a2a583b88f2",
                                        "glosses": [
                                            "A type of hat made from the wool of these sheep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea082132-0252-415b-918c-8c48282c9cb4",
                                                "sense_id": "50e48771-0259-3ae5-bd02-b560d1a7a713",
                                                "text": "The karakul hats took me back to a stifling summer afternoon in Kiev and the memory of a squadron of Cossack cavalry exercising down a cobbled street […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f0e89a1-30bc-4c6f-ae33-6114308ac932",
                        "source_entry_id": "f97a7a6e-2b61-33b7-ab13-787a8e61e0ca",
                        "source_sense_id": "99aa8410-598c-3600-a200-73da4086fd69",
                        "target_lang_word": "karakul",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "karakul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3c3238f-c3e7-3637-9a4b-3ae0b617f7a8",
                                        "entry_id": "c24f09e2-88d3-33f5-bfe5-426b8c0f4d76",
                                        "glosses": [
                                            "Variante de caracul."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d211c67-0280-41b0-a7b8-4a5612dc0372",
                                                "sense_id": "c3c3238f-c3e7-3637-9a4b-3ae0b617f7a8",
                                                "text": "Il s’est recouvert de son long manteau de karakul et s’est tapoté le visage devant la glace de son épouse, il a accouru auprès du défunt, feignant la surprise et la plus pesante affliction."
                                            },
                                            {
                                                "example_id": "d3aca166-7c11-4d46-b9da-14d32e0b9fbc",
                                                "sense_id": "c3c3238f-c3e7-3637-9a4b-3ae0b617f7a8",
                                                "text": "En plaine, la modernisation de la production animale a reposé sur l’élevage du mouton karakul dont la finalité était la production d’astrakan, toison fine et bouclée vendue sur le marché mondial de la fourrure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a79fdf08-6ecd-4029-acd8-9dcffbf4fe7f",
                        "source_entry_id": "f97a7a6e-2b61-33b7-ab13-787a8e61e0ca",
                        "source_sense_id": "99aa8410-598c-3600-a200-73da4086fd69",
