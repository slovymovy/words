                    "semantic_group_id": "phonétique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En fin de mot, le locuteur a tendance à <w>assourdir</w> cette consonne sonore."
                        },
                        {
                            "text": "Le contact avec une occlusive non voisée peut <w>assourdir</w> la consonne précédente."
