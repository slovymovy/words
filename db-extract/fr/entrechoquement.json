                        "examples": [
                            {
                                "example_id": "111a55ef-fcd9-4948-82b0-05d5324276c5",
                                "sense_id": "7906f9f6-aeb6-3881-af3c-9c3bb8135929",
                                "text": "Une harde de milliers de caribous fait du bruit avec l’entrechoquement de leurs grands bois et le martèlement de leurs sabots."
                            },
                            {
                                "example_id": "1115a4d7-2e63-4d7f-b41a-06ea6752aa62",
                                "sense_id": "7906f9f6-aeb6-3881-af3c-9c3bb8135929",
                                "text": "Le meilleur est peut-être cependant dans l’entrechoquement des glaçons que l’on entend sans les voir en déplaçant le gobelet."
                            },
                            {
                                "example_id": "33058b88-17ab-4b7f-9f7a-b203d5eca7fb",
                                "sense_id": "7906f9f6-aeb6-3881-af3c-9c3bb8135929",
                                "text": "Il se manifeste par des grincements ou un entrechoquement répété des dents et est souvent lié à un stress."
                            }
                        ]
