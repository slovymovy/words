                                    {
                                        "sense_id": "0eb29cbf-abb0-35e2-8768-00ffc1976780",
                                        "entry_id": "dad328f9-d63f-3716-adb5-1e797e74f32e",
                                        "glosses": [
                                            "zu Tarent gehörig, aus Tarent stammend"
                                        ],
                                        "tags": [],
