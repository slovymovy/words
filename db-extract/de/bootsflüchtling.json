                                        "glosses": [
                                            "Refugees fleeing by sea, particularly those fleeing from South Vietnam during the 1970s and '80s."
                                        ],
                                        "tags": [
                                            "historical",
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
