                "senses": [
                    {
                        "sense_id": "c50418ac-8f0e-3eac-ba86-75a666bdf735",
                        "entry_id": "71c6b835-7b82-3d58-983c-0dc8a0e37b1b",
                        "glosses": [
                            "unbemannter Kampfroboter, ursprünglich wohl nur in Star Wars, jetzt auch von anderen Autoren und Spieleerfindern verwendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a041482-5cd6-4b53-994a-11b6aea6729a",
                                "sense_id": "c50418ac-8f0e-3eac-ba86-75a666bdf735",
                                "text": "„Um den Kampfdroiden im Tal der dunklen Lords zu deaktivieren, müsst ihr folgende Systeme in dieser Reihenfolge ausschalten:…“"
                            },
                            {
                                "example_id": "d2584df5-ce0e-42f2-9f81-c8e412bbb4f9",
                                "sense_id": "c50418ac-8f0e-3eac-ba86-75a666bdf735",
                                "text": "„Der Imperator tritt um die Ecke, hinter ihm eine Armee Kampfdroiden. Im letzten Moment kann mich der Eiermann seinen tödlichen Hieben entreißen.“"
                            },
                            {
                                "example_id": "f38eca8a-a436-4783-8537-b7f8e5a9217b",
                                "sense_id": "c50418ac-8f0e-3eac-ba86-75a666bdf735",
                                "text": "„Wird es den Armouron-Rittern gelingen, den Rebellen trotz der Überzahl an Kampfdroiden zu befreien?“"
                            },
                            {
                                "example_id": "80861f4a-0e7e-4e24-9219-45ec8cb4c2d0",
                                "sense_id": "c50418ac-8f0e-3eac-ba86-75a666bdf735",
                                "text": "„Der letzte Mensch des Universums ist von bösen Killer-Robotern ausgelöscht worden. Als der letzte verbleibende humanoide Kampfdroide kämpfst du dich durch mehr als 40 Arcade-Level, um dich endlich den vier riesigen Bossbotern der Apocalypse zu stellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
