                    "frequency": "Low",
                    "semantic_group_id": "Besitz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als jüngstes Kind musste er oft die abgelegten Hosen seines älteren Bruders <w>erben</w>."
