                "senses": [
                    {
                        "sense_id": "d06b9177-1324-3e92-984e-2cf78211b962",
                        "entry_id": "f40e7d25-64ee-32b3-adee-210b390cafe1",
                        "glosses": [
                            "Herstellung der baulichen Anlagen, die zum Betrieb einer U-Bahn notwendig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa12d6ab-b385-4146-9bed-8d91599ed4a6",
                                "sense_id": "d06b9177-1324-3e92-984e-2cf78211b962",
                                "text": "Die Stadt hat die Mittel für den U-Bahn-Bau gekürzt."
                            },
                            {
                                "example_id": "ce9d10ab-9067-4c3d-a0c1-9e64181bf6b2",
                                "sense_id": "d06b9177-1324-3e92-984e-2cf78211b962",
                                "text": "Wir wollen zukünftig wieder vermehrt in den U-Bahn-Bau investieren."
                            },
                            {
                                "example_id": "087f23ad-7e0f-4660-b5cb-750ecb418798",
                                "sense_id": "d06b9177-1324-3e92-984e-2cf78211b962",
                                "text": "In vielen Städten wird der U-Bahn-Bau vorangetrieben."
                            },
                            {
                                "example_id": "bd3f2009-d378-471d-825e-38cb58becdb6",
                                "sense_id": "d06b9177-1324-3e92-984e-2cf78211b962",
                                "text": "Die Kosten des U-Bahn-Baus explodieren."
                            },
                            {
                                "example_id": "cc9bdf2d-2b28-49e7-b16a-402cabb9cde1",
                                "sense_id": "d06b9177-1324-3e92-984e-2cf78211b962",
                                "text": "Das Ausmaß, das der U-Bahn-Bau mittlerweile angenommen hat, ist unvorstellbar."
                            },
                            {
                                "example_id": "d6d06219-e3e8-41be-ba03-893af2e5655b",
                                "sense_id": "d06b9177-1324-3e92-984e-2cf78211b962",
                                "text": "Beim U-Bahn-Bau in Köln ist einiges schiefgegangen."
                            },
                            {
                                "example_id": "1256e0d7-4f3d-428e-be8c-a9b645e4919e",
                                "sense_id": "d06b9177-1324-3e92-984e-2cf78211b962",
                                "text": "Lotte hat den U-Bahn-Bau in einer südamerikanischen Metropole planerisch betreut."
                            },
                            {
                                "example_id": "fbc8fff2-da02-4269-b5cb-62d025e1f468",
                                "sense_id": "d06b9177-1324-3e92-984e-2cf78211b962",
                                "text": "„Das Geld wurde nicht für den U-Bahn-Bau, sondern zur Einrichtung von Geschäftslokalen verwendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
