                "senses": [
                    {
                        "sense_id": "f4be787a-3372-336e-8d4e-addf3e1e6d58",
                        "entry_id": "b44f35ca-cdde-344b-960f-e2fd6fd4bb9a",
                        "glosses": [
                            "Entlohnung für einen Verräter"
                        ],
                        "tags": [
                            "derogatory",
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "7dbfd061-d9a1-4232-b4b3-1f2003e82025",
                                "sense_id": "f4be787a-3372-336e-8d4e-addf3e1e6d58",
                                "text": "„1980 bekam die Berliner Sektion des DDR-Schriftstellerverbandes das Haus als Judaslohn für ein positives Abstimmungsverhalten, das den Ausschluss von neun Autoren aus dem Schriftstellerverband zur Folge hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0f4cd1a-0807-4ab1-a1a4-8031aba70f79",
                        "source_entry_id": "b44f35ca-cdde-344b-960f-e2fd6fd4bb9a",
                        "source_sense_id": "f4be787a-3372-336e-8d4e-addf3e1e6d58",
                        "source_sense_description": "bildungssprachlich, abwertend: Entlohnung für einen Verräter",
                        "target_lang_word": "thirty pieces of silver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thirty pieces of silver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f592533c-e111-3675-911c-180cc25d8c8a",
                                        "entry_id": "679e3fd3-1767-3d2d-8aae-71583d6a3993",
                                        "glosses": [
                                            "A reward for betrayal."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "096d8327-1221-477b-bb70-9656e63d8aff",
                                                "sense_id": "f592533c-e111-3675-911c-180cc25d8c8a",
                                                "text": "His corrupt inspections led to unsafe buildings, but what did he care? He'd gotten his thirty pieces of silver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "752464ea-ec68-4082-8746-9b697030f9ac",
                        "source_entry_id": "b44f35ca-cdde-344b-960f-e2fd6fd4bb9a",
                        "source_sense_id": "f4be787a-3372-336e-8d4e-addf3e1e6d58",
                        "source_sense_description": "bildungssprachlich, abwertend: Entlohnung für einen Verräter",
                        "target_lang_word": "betrayal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "betrayal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e099f56-adbe-3f18-a87f-8de1beb56c45",
                                        "entry_id": "ed007d7e-8ad3-3ce7-a0bf-be3e50f842e5",
                                        "glosses": [
                                            "The act of betraying."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11189700-7340-4b44-b318-a12d7aa58e64",
                                                "sense_id": "6e099f56-adbe-3f18-a87f-8de1beb56c45",
                                                "text": "But by the same token, an exclusive menu of betrayals is likely to be a starvation diet."
                                            },
                                            {
                                                "example_id": "347a143f-66bf-4dd6-9265-40b30c96a3e7",
                                                "sense_id": "6e099f56-adbe-3f18-a87f-8de1beb56c45",
                                                "text": "The betrayal of our friends in Taiwan began with President Carter’s decision to terminate the mutual defense treaty with Taiwan that Congress had ratified in 1954."
                                            },
                                            {
                                                "example_id": "b4b1c89f-65df-4518-b9b4-fe06c05efd79",
                                                "sense_id": "6e099f56-adbe-3f18-a87f-8de1beb56c45",
                                                "text": "One of our own has joined with the alien. If you see him, do not hesitate to let him know what the Roekaar think of this betrayal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
