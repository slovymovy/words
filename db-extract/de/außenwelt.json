                                        "glosses": [
                                            "Ensemble des choses ou des êtres que nous percevons au-dehors de nous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "009b4918-5291-4315-bdba-df00725a9d46",
                                                "sense_id": "ad8ec0eb-b0e6-30d5-b384-d75da0ccbcb5",
                                                "text": "Elle ferma les yeux, puis, l’instant d’après, ressentit une apaisante sensation, comme les caresses de sa mère quand elle était enfant. Elle eut subitement envie de s’abandonner, de s’endormir. Oublier le monde extérieur, sa vie, tout."
                                            }
                                        ]
