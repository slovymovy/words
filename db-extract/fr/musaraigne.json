                                        "sense_id": "0cb2e57b-2159-388c-ad2d-0e71b57b5351",
                                        "entry_id": "d5f6ff87-03f1-312a-b094-54efb26524db",
                                        "glosses": [
                                            "kleines, insektenfressendes Säugetier mit rüsselartigem Maul aus der Familie der Soricidae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bf49d93-a361-48ee-bfa4-8d4769a2ed27",
                                                "sense_id": "0cb2e57b-2159-388c-ad2d-0e71b57b5351",
                                                "text": "Die Spitzmaus ist auf allen Kontinenten außer Australien und Antarktika vertreten."
                                            },
                                            {
                                                "example_id": "ef03f212-24e1-43c3-b271-dd0ac3269a02",
                                                "sense_id": "0cb2e57b-2159-388c-ad2d-0e71b57b5351",
                                                "text": "„Die Spitzmaus führte übrigens eine Vielfalt von Namen: Spitzer, Spitzlein, Spitzwicht, Spitzling.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
