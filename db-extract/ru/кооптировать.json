                                        "sense_id": "eb826e54-7b1c-363e-b6db-3092cb389be5",
                                        "entry_id": "0012f755-0be6-3094-9ab7-e7739be0c02d",
                                        "glosses": [
                                            "hinzuwählen, durch Nachwahl zu einer Körperschaft durch diese selbst hinzuwählen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f47694a8-d722-4b6c-bac6-90b55d526752",
                                                "sense_id": "eb826e54-7b1c-363e-b6db-3092cb389be5",
                                                "text": "Nach dem Tod eines Mitglieds wird von den anderen durch Wahl ein Nachfolger kooptiert."
                                            },
                                            {
                                                "example_id": "55e68343-e0f6-4cea-b722-e7f68fee841f",
                                                "sense_id": "eb826e54-7b1c-363e-b6db-3092cb389be5",
                                                "text": "„Auch wenn während seiner Herrschaftszeit Paschtunen in den pakistanischen Staatsapparat kooptiert (v.a. Armee, Geheimdienst) wurden, stellte er sich einem paschtunischen Nationalismus entgegen.“"
                                            }
                                        ],
