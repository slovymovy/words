                        "entry_id": "cac43f4c-848d-33ce-8493-bfcfb1f1ac9c",
                        "glosses": [
                            "Relieving the harshness or bitterness of certain bodily humours; (loosely), soothing, emollient."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2ae3ec45-6ef0-4a92-be06-76124c7b7c27",
                                "sense_id": "c077e41b-8ecf-3b03-82e5-4bdbf1a62a7e",
                                "text": "Epicerastic medicines obtund the acrimony of the humours, and mitigate the uneasy sensation thence arising."
                            },
                            {
                                "example_id": "ea811fa8-38aa-4e2c-ad1f-d91ad396d9b2",
                                "sense_id": "c077e41b-8ecf-3b03-82e5-4bdbf1a62a7e",
                                "text": "Actually the aged dame (partly, perhaps, that she was quite tired with her own violence) listened to my various epicerastic expressions, showed herself amenable to counsel, and replied in very courteous tones."
                            }
                        ]
                    }
                ],
