                ],
                "senses": [
                    {
                        "sense_id": "7a543c21-8f7e-39e7-a3ad-2a218aeb57e7",
                        "entry_id": "4db71a56-107c-3d34-9b39-cd10716fa619",
                        "glosses": [
                            "Frozen fruit juice, sometimes mixed with egg whites, eaten as dessert or between courses of a meal."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "28a49556-1c18-4efe-ac54-68a1b4969706",
                                "sense_id": "7a543c21-8f7e-39e7-a3ad-2a218aeb57e7",
                                "text": "After dinner we had an orange sorbet that was very refreshing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d586417-88ca-4754-aa76-538ae13f536e",
                        "source_entry_id": "4db71a56-107c-3d34-9b39-cd10716fa619",
                        "source_sense_id": "7a543c21-8f7e-39e7-a3ad-2a218aeb57e7",
                        "source_sense_description": "frozen fruit juice",
                        "target_lang_word": "sorbet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorbet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a55aaf9-8b00-33a4-8b82-5ff681272669",
                                        "entry_id": "ee2422f3-0605-3a33-86cb-4d365b8a8d62",
                                        "glosses": [
                                            "Breuvage glacé en neige, parfumé aux liqueurs ou au jus de fruits. On dit aujourd’hui dans ce sens « margarita »."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42943919-bbe7-4be7-beb6-b06f824cb54f",
                                                "sense_id": "3a55aaf9-8b00-33a4-8b82-5ff681272669",
                                                "text": "La petite créole ne croyait pas à l’hiver et ne connaissait le froid que pour avoir pris des sorbets."
                                            },
                                            {
                                                "example_id": "0fd33079-3c43-4484-932c-202a0c511098",
                                                "sense_id": "3a55aaf9-8b00-33a4-8b82-5ff681272669",
                                                "text": "On entendait, de tous côtés, les carillons des vendeurs de sorbet, de pignolats et de lait caillé, les timbales des astrologues en plein vent, les chansons des guzlares aveugles, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99fa00c1-816f-391d-bbbd-306837ec3e1a",
                                        "entry_id": "ee2422f3-0605-3a33-86cb-4d365b8a8d62",
                                        "glosses": [
                                            "Glace à base d’eau, de fruits et de sucre avec parfois adjonction d'alcool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62b0c4b5-cf5b-4fc4-a558-2c96b04ceb5c",
                                                "sense_id": "99fa00c1-816f-391d-bbbd-306837ec3e1a",
                                                "text": "J’ai accompagné d’une demi-bouteille de champigny de la mousse de pintadeau au genièvre, une crépine de pied de porc aux lentilles, un sorbet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ba259d8-d00e-4fa8-b078-c3d345b58205",
                        "source_entry_id": "4db71a56-107c-3d34-9b39-cd10716fa619",
                        "source_sense_id": "7a543c21-8f7e-39e7-a3ad-2a218aeb57e7",
