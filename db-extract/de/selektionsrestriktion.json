                ],
                "senses": [
                    {
                        "sense_id": "ac6f826d-03f4-3ad3-b73e-3d47439260c5",
                        "entry_id": "b2e8da55-1ad8-3ac0-81fb-3bff1a7a7723",
                        "glosses": [
                            "Regeltyp der generativen Grammatik (Chomsky, Aspekte-Modell 1964), der dafür sorgt, dass Ausdrücke, die im Satz wegen ihrer Bedeutung nicht miteinander vorkommen können, ausgeschlossen werden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b897fa1-506e-41cf-a182-44f9606fd2f0",
                                "sense_id": "ac6f826d-03f4-3ad3-b73e-3d47439260c5",
                                "text": "Die Selektionsrestriktion müsste z.B. verhindern, dass ein Satz wie: \"Ein Hase erschießt einen Baum\" zustande kommt, da das Verb erschießen einen Menschen als Subjekt und ein Tier oder einen Menschen als Objekt fordert; beide Bedingungen sind hier verletzt."
                            },
                            {
                                "example_id": "19d95e77-2a49-45fc-bfa2-4fff6a99f044",
                                "sense_id": "ac6f826d-03f4-3ad3-b73e-3d47439260c5",
                                "text": "„Prinzipiell läßt sich sagen, daß die lexikalischen Präsuppositionen genau die Selektionsfunktion der Selektionsrestriktionen haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
