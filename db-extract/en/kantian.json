                        "source_entry_id": "3b027bfe-f55d-31b6-bcb6-e0993d9c6a36",
                        "source_sense_id": "fef7ebb9-b63c-308e-a89c-27196bc52c19",
                        "source_sense_description": "of, pertaining to, or resembling the philosophical views of Immanuel Kant",
                        "target_lang_word": "kantianisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kantianisch",
