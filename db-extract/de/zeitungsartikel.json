                "senses": [
                    {
                        "sense_id": "0abc79aa-5f64-3282-bf5c-1afba985fc2f",
                        "entry_id": "716cbb7b-69a8-37f2-933a-d8d800f7dabe",
                        "glosses": [
                            "kurzer, in sich abgeschlossener Text in einer Zeitung"
                        ],
                        "tags": [
                            "Journalistik"
                        ],
                        "examples": [
                            {
                                "example_id": "50ec3974-e89e-464d-a60e-e330ffc2b295",
                                "sense_id": "0abc79aa-5f64-3282-bf5c-1afba985fc2f",
                                "text": "„Bei meiner Durchsicht früher Zeitungsartikel zum besseren Verständnis der damaligen Situation ergaben sich allerdings mehr Fragezeichen als Fakten.“"
                            },
                            {
                                "example_id": "288332dd-796d-4196-8cd4-0eabfa42f364",
                                "sense_id": "0abc79aa-5f64-3282-bf5c-1afba985fc2f",
                                "text": "„In der Konzeptionsphase dieses Buches wurde mir daher klar, dass ich außer auf Zeitungsartikel aus deutschen und internationalen Blättern vor allem auf ausgewählte Selbstzeugnisse zurückgreifen musste.“"
                            },
                            {
                                "example_id": "6726cce2-72ed-44fc-b0f1-07b82f7ad0be",
                                "sense_id": "0abc79aa-5f64-3282-bf5c-1afba985fc2f",
                                "text": "„Davon ist in dem Zeitungsartikel aber nicht die Rede.“"
                            },
                            {
                                "example_id": "326f77af-2dd1-462e-aa6b-940947bee6b9",
                                "sense_id": "0abc79aa-5f64-3282-bf5c-1afba985fc2f",
                                "text": "„Kompliziertere Verhältnisse ergeben sich, wenn Meldungen verschiedener Agenturen für die Zeitungsartikel amalgamiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
