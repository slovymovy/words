                "senses": [
                    {
                        "sense_id": "ea8fd3c6-10d8-3a0e-bdd0-7697760d33b1",
                        "entry_id": "d4b34669-8f19-34e1-90c4-cb0c27f154f1",
                        "glosses": [
                            "die Phantasie, dass man alles und jedes realisieren kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8252ce3d-fd84-49c3-940e-c02a8a7e324e",
                                "sense_id": "ea8fd3c6-10d8-3a0e-bdd0-7697760d33b1",
                                "text": "„Wir können es uns nicht leisten, die falschen Allmachtsphantasien, die sich in der Politik breitgemacht haben, durch ebenso falsche Ohnmachtsgefühle zu ersetzen.“"
                            },
                            {
                                "example_id": "43360e46-b716-4edd-87fc-d117947f31c3",
                                "sense_id": "ea8fd3c6-10d8-3a0e-bdd0-7697760d33b1",
                                "text": "„So ist einmal mehr die Allmachtsphantasie der Regierenden erschreckend, die so gar nicht zur erfreulichen Selbstkritik in der Schlusserklärung passen will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
