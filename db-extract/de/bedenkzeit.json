                ],
                "senses": [
                    {
                        "sense_id": "da799587-94fa-322b-b530-f7f1fa8f3d32",
                        "entry_id": "662010dd-5524-3274-9aa8-f8770449dcfb",
                        "glosses": [
                            "Zeit, Frist zum Nachdenken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a15b9dcf-d020-4cfb-8099-57a8de492b20",
                                "sense_id": "da799587-94fa-322b-b530-f7f1fa8f3d32",
                                "text": "Die Wohnung, die wir gerade besichtigt haben, ist wunderschön aber sehr teuer; wir baten den Verkäufer um eine Woche Bedenkzeit."
                            },
                            {
                                "example_id": "cef60abe-dfb4-4ccd-89ae-7ec330e24a2d",
                                "sense_id": "da799587-94fa-322b-b530-f7f1fa8f3d32",
                                "text": "Beim Blitzschach hat jeder Spieler für die gesamte Partie nur fünf Minuten Bedenkzeit."
                            },
                            {
                                "example_id": "622967f8-68d0-47ff-a630-3d85c7e1cdd2",
                                "sense_id": "da799587-94fa-322b-b530-f7f1fa8f3d32",
                                "text": "„Er wird sich von Goebbels ebenso freundlich, wie er jetzt im Kaiserhof mit ihm parliert, Bedenkzeit ausbitten, um holterdiepolter den Zug nach Paris zu besteigen.“"
                            },
                            {
                                "example_id": "b2a0b371-2bd4-42f3-8e4f-51c07f29e2db",
                                "sense_id": "da799587-94fa-322b-b530-f7f1fa8f3d32",
                                "text": "„Doch die Meinung der Frauen hatte sich in den zwölf Stunden Bedenkzeit nicht geändert.“"
                            },
                            {
                                "example_id": "d580acc7-3c09-4a92-a518-4435db4b8090",
                                "sense_id": "da799587-94fa-322b-b530-f7f1fa8f3d32",
                                "text": "„Dann verteilt er Branntwein und gibt den Häuptlingen Bedenkzeit.“"
                            },
                            {
                                "example_id": "201ea0d8-3de2-49f1-b274-72c69c34939c",
                                "sense_id": "da799587-94fa-322b-b530-f7f1fa8f3d32",
                                "text": "„Er schwankt noch, aber wir haben ihm höhere Prozente angeboten als Hollmann und Klotz, und um sich während der Bedenkzeit freundlich zu erweisen, arbeitet er einstweilen für uns als Spion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40d0d2b8-2b26-4aee-b055-dec0a1b7e2b1",
                        "source_entry_id": "662010dd-5524-3274-9aa8-f8770449dcfb",
                        "source_sense_id": "da799587-94fa-322b-b530-f7f1fa8f3d32",
                        "source_sense_description": "Zeit, Frist zum Nachdenken",
                        "target_lang_word": "respite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "respite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b50f1465-2750-3848-a5b3-b6473f65b5ce",
                                        "entry_id": "d20c4b82-642c-3a8d-8985-ac17866405a4",
                                        "glosses": [
                                            "A brief interval of rest or relief."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71bf657a-82fd-4769-a39b-48c92aacd73a",
                                                "sense_id": "b50f1465-2750-3848-a5b3-b6473f65b5ce",
                                                "text": "I crave but four day's respite."
                                            },
                                            {
                                                "example_id": "411fd4ad-4a72-4fab-854d-84b67a52c825",
                                                "sense_id": "b50f1465-2750-3848-a5b3-b6473f65b5ce",
                                                "text": "Some pause and respite only I require."
                                            },
                                            {
                                                "example_id": "e3ef3e27-d17f-46d1-ae01-06c54201aef3",
                                                "sense_id": "b50f1465-2750-3848-a5b3-b6473f65b5ce",
                                                "text": "It was a joy to snatch some brief respite, and find himself in the rectory drawing–room. Listening here was as pleasant as talking; just to watch was pleasant. The young priests who lived here wore cassocks and birettas; their faces were fine and mild, yet really strong, like the rector's face; and in their intercourse with him and his wife they seemed to be brothers."
                                            },
                                            {
                                                "example_id": "d404912e-85d0-4eb1-ac46-10e92c8aa0b6",
                                                "sense_id": "b50f1465-2750-3848-a5b3-b6473f65b5ce",
                                                "text": "Mr. Cameron had a respite Thursday from the negative chatter swirling around him when he appeared outside 10 Downing Street to denounce the murder a day before of a British soldier on a London street."
                                            },
                                            {
                                                "example_id": "322e6827-bca1-4177-9749-b0c281694bfb",
                                                "sense_id": "b50f1465-2750-3848-a5b3-b6473f65b5ce",
                                                "text": "The American escort carriers reach the first in a series of rain squalls, and Japanese fire drops off significantly, as their optical systems are unable to see through the rain. At this point in time, almost any other major navy would simply have used their radar to keep spotting and firing, as Duke of York had done to Scharnhorst almost a year ago and as the battleships of the Seventh Fleet had done to the Yamashiro mere hours earlier. But, since only one ship in the Center Force has gunnery radar, the American ships gain some respite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e57883c0-3fb6-3ace-93b1-9969c4bf8a0b",
                                        "entry_id": "d20c4b82-642c-3a8d-8985-ac17866405a4",
                                        "glosses": [
                                            "A reprieve, especially from a sentence of death."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d7131ba-01eb-4155-8946-171a5b961d56",
                                                "sense_id": "e57883c0-3fb6-3ace-93b1-9969c4bf8a0b",
                                                "text": "Thenne spake sir gawayn and sayd my lord Arthur I wold counceylle yow not to be ouer hasty but that ye wold putte it in respyte this Iugement of my lady the quene for many causes.\n\"Then spake Sir Gawaine, and said: My lord Arthur, I would counsel you not to be over-hasty, but that ye would put it in respite, this judgment of my lady the queen, for many causes.\""
                                            },
                                            {
                                                "example_id": "3cb127d0-9bbe-4a3f-bf67-a3d5b2896186",
                                                "sense_id": "e57883c0-3fb6-3ace-93b1-9969c4bf8a0b",
                                                "text": "The PACC Act [Post-Appeal Applications in Capital Cases Act] also amends the CPC [Criminal Procedure Code] to provide that a capital sentence may be carried out unless:[…]The President has ordered a respite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a46467f3-132a-30fc-a4fa-b120991f8b03",
                                        "entry_id": "d20c4b82-642c-3a8d-8985-ac17866405a4",
                                        "glosses": [
                                            "The delay of appearance at court granted to a jury beyond the proper term."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d6bc729-8009-313a-b967-1b81da530d31",
                                        "entry_id": "d20c4b82-642c-3a8d-8985-ac17866405a4",
                                        "glosses": [
                                            "A short period of spoken dialogue in an otherwise sung-through musical."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "respite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "273440f6-2edd-390a-85a8-fac260cb2a62",
