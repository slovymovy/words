                ],
                "senses": [
                    {
                        "sense_id": "ea1f0883-fc82-3e2f-9712-51f4ac762d2e",
                        "entry_id": "2f7d55e4-0b5e-36d7-8f3e-ef21da47738a",
                        "glosses": [
                            "(frische) Naht, die durch Zusammennähen einer Wunde entsteht; aus einer Wundnaht wird, wenn alles gutgeht, eine Narbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6054a807-96c2-43c7-aba3-2472a6e7e9b3",
                                "sense_id": "ea1f0883-fc82-3e2f-9712-51f4ac762d2e",
                                "text": "„Eine reizlose, trockene Wundnaht muss nach 48 Std. nicht mehr verbunden werden.“"
                            },
                            {
                                "example_id": "a111601c-59f6-425e-818f-5bb09d7c7ee0",
                                "sense_id": "ea1f0883-fc82-3e2f-9712-51f4ac762d2e",
                                "text": "[Oktoberfest:] „Insgesamt versorgten die Ärzte der Wiesn-Sanitätsstation am ersten Festtag 53 Schnittwunden mit chirurgischen Wundnähten.“"
                            },
                            {
                                "example_id": "a0a644c0-22ec-4025-a76d-eae3e31fc135",
                                "sense_id": "ea1f0883-fc82-3e2f-9712-51f4ac762d2e",
                                "text": "„Das selbstklebende Material, das Natalie Artzi und ihr Team entwickelt haben, soll nach einer Operation im Darm auf die Wundnaht aufgetragen werden, um sie abzudichten und zu stabilisieren.“"
                            },
                            {
                                "example_id": "c30bd822-5a6d-4543-bab2-644ef46114df",
                                "sense_id": "ea1f0883-fc82-3e2f-9712-51f4ac762d2e",
                                "text": "„Der Erreger Mycobacterium abscessus […] breitete sich in ihrem Körper aus und sorgte unter anderem dafür, dass sich die Wundnähte […] infizierten und entzündeten.“"
                            },
                            {
                                "example_id": "788bded6-5923-42c8-82b2-eaaa239a7d19",
                                "sense_id": "ea1f0883-fc82-3e2f-9712-51f4ac762d2e",
                                "text": "„Nicht erforderlich ist eine Wundnaht bei kleinen oberflächlichen Schnitten, wenn sie mit einem Desinfektionsmittel wie Chlorhexidin oder PVP-Jod gereinigt und mit einem Klebeverband verdeckt werden.“"
                            },
                            {
                                "example_id": "84d4af65-2e01-432c-804a-017372bbf217",
                                "sense_id": "ea1f0883-fc82-3e2f-9712-51f4ac762d2e",
                                "text": "„Die 6-8-h-Grenze zur primären Wundnaht kann bei Verletzungen der großen Körperhöhlen o. der Gelenke bei Mitbeteiligung von Gefäßen, Knochen, Nerven o. Sehnen sowie bei Gesichtsverletzungen (gute Durchblutungsverhältnisse) überschritten werden.“"
                            },
                            {
                                "example_id": "65ef8566-eb03-471e-a437-e27bb4c51fe0",
                                "sense_id": "ea1f0883-fc82-3e2f-9712-51f4ac762d2e",
                                "text": "„Oberarzt Dr. Matteo Moreau und Vivienne Kling führen eine Not-OP durch, bei der Vivi ein Fehler unterläuft. Sowas darf ihr nicht mehr passieren, […]. Deswegen verdonnert Matteo sie dazu, Wundnähte an Obst zu üben […].“"
                            },
                            {
                                "example_id": "889169bb-6cdb-467d-9fc8-12417ab9e29c",
                                "sense_id": "ea1f0883-fc82-3e2f-9712-51f4ac762d2e",
                                "text": "„Die 17-jährige Schülerin Dasia Taylor aus Iowa hat eine Erfindung gemacht, mit der sich entzündete Wundnähte sofort erkennen lassen.“"
                            },
                            {
                                "example_id": "6f1ae0bf-22e7-4efd-89fd-484e9e90ab99",
                                "sense_id": "ea1f0883-fc82-3e2f-9712-51f4ac762d2e",
                                "text": "[Blutegel:] „[…] die Tiere mit ihren scharfen Zähnchen wurden […] rund um die Wundnaht gesetzt und halfen, die Durchblutung zu fördern.“"
                            },
                            {
                                "example_id": "f5483cfa-0b96-4d4b-b450-754538022dd3",
                                "sense_id": "ea1f0883-fc82-3e2f-9712-51f4ac762d2e",
                                "text": "„Die Wundrandausschneidung der Haut ist mit dem Skalpell durchzuführen, wobei eine senkrechte Schnittführung die Adaptation bei der Wundnaht erleichtert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
