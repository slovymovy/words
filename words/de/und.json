            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "b559339a-5067-3877-9579-c8b58958707b",
                    "sense_definition": "verbindet Wörter, Wortgruppen oder Teilsätze miteinander zur Angabe einer Aufzählung, Ergänzung oder Hinzufügung",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "verbindung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Sonne scheint <w>und</w> es ist heute sehr warm draußen."
                        },
                        {
                            "text": "Ich trinke gerne frischen Kaffee <w>und</w> esse dazu ein Stück Kuchen."
                        }
                    ],
                    "synonyms": [
                        "sowie"
                    ],
                    "antonyms": [
                        "weder … noch",
                        "oder"
                    ],
                    "common_phrases": [
                        "ab und zu",
                        "hin und wieder",
                        "Kaffee und Kuchen"
                    ]
                },
                {
                    "sense_id": "656d3e0f-d81f-3b28-8670-ebdcbf79a495",
                    "sense_definition": "verbindet zwei Begriffe in rhetorischen Fragen, um einen Widerspruch oder eine Unvereinbarkeit hervorzuheben",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gegensatz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>und</w> früh aufstehen passen wirklich überhaupt nicht zusammen."
                        },
                        {
                            "text": "Mein Bruder <w>und</w> kochen ist eine absolut unvorstellbare Kombination."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "drückt umgangssprachlich Skepsis oder Verwunderung aus"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "e4a5eeea-db14-35c0-bc2c-5e5bc85e582a",
                    "sense_definition": "drückt als eigenständiger Ausruf eine neugierige oder ungeduldige Nachfrage aus",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "nachfrage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Und</w>? Hast du deine wichtige Prüfung gestern bestanden?"
                        },
                        {
                            "text": "<w>Und</w>? Was hat der Chef zu deinem Vorschlag gesagt?"
                        }
                    ],
                    "traits": [
