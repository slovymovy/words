                "senses": [
                    {
                        "sense_id": "918589ce-2944-3baa-abe5-35bbb49f3405",
                        "entry_id": "b2179c6d-07d4-3116-a21e-497751e9f7ed",
                        "glosses": [
                            "illegaler Transport verbotener Drogen über Staatsgrenzen"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "c8df68dd-9ecd-45b2-9fee-4c079e567014",
                                "sense_id": "918589ce-2944-3baa-abe5-35bbb49f3405",
                                "text": "„Die bandenmäßige Tatbegehung des Suchtgiftschmuggels erfordert, daß der Täter bei seiner Mitwirkung am Transport Kenntnis davon hatte, als Mitglied einer zu fortgesetztem Rauschgiftschmuggel verbundenen Organisation (Bande) zu fungieren und mit seinem Tatbeitrag die Ziele einer hinter dem konkreten Transport stehenden Organisation zu unterstützen.“"
                            },
                            {
                                "example_id": "2d3861fe-0fe5-4e7f-ad25-91b578efd321",
                                "sense_id": "918589ce-2944-3baa-abe5-35bbb49f3405",
                                "text": "„Der Suchtgiftschmuggel von Nordseehäfen über Österreich auf den Balkan wird immer wichtiger.“"
                            },
                            {
                                "example_id": "643355ca-e9b2-43a0-b825-5dc134ad5782",
                                "sense_id": "918589ce-2944-3baa-abe5-35bbb49f3405",
                                "text": "„Die Grenze zwischen Tadschikistan und Afghanistan gilt als eine der Hauptrouten für den Suchtgiftschmuggel in Richtung Russland.“"
                            },
                            {
                                "example_id": "0b544055-278d-458a-97af-4579893754ba",
                                "sense_id": "918589ce-2944-3baa-abe5-35bbb49f3405",
                                "text": "„Polen soll darüber hinaus eine Transitfunktion für den Suchtgiftschmuggel haben.“"
                            },
                            {
                                "example_id": "1dda3e06-f00b-4661-937c-f673120aead2",
                                "sense_id": "918589ce-2944-3baa-abe5-35bbb49f3405",
                                "text": "„Dazu gehören vor allem der Suchtgiftschmuggel, die Geldwäscherei, der Fahrzeugdiebstahl, das Schlepperwesen und seit kurzem leider auch der Nuklearhandel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
