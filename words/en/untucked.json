{
    "word_family": [
        "untuck"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9291d9bb-8f19-3fbd-b954-761e47029f52",
                    "sense_definition": "Not tucked in, referring to clothing hanging loosely outside of another garment.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He walked down the street with his shirt <w>untucked</w>.",
                            "target_lang_translations": {
                                "zh": "他走在街上，衬衫下摆<w>没塞进裤子</w>里。"
                            }
                        },
                        {
                            "text": "The casual style allows for an <w>untucked</w> shirt at the office.",
                            "target_lang_translations": {
                                "zh": "这种休闲风格允许在办公室里穿<w>没塞进裤子</w>的衬衫。"
                            }
                        }
                    ],
                    "synonyms": [
                        "loose",
                        "unfastened"
                    ],
                    "antonyms": [
                        "tucked in"
                    ],
                    "common_phrases": [
                        "untucked shirt"
                    ],
                    "target_lang_definitions": {
                        "zh": "指衣服没有塞进裤子或裙子里，自然地垂在外面。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "没塞进裤子",
                                "target_lang_sense_clarification": "描述上衣下摆未束入下装的状态"
                            },
                            {
                                "target_lang_word": "外露的",
                                "target_lang_sense_clarification": "指衣物下摆自然垂下的状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c0a94c9-5fe7-38b4-9c3d-ca7679934c9e",
                    "sense_definition": "Simple past and past participle of <w>untuck</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird <w>untucked</w> its head from under its wing.",
                            "target_lang_translations": {
                                "zh": "那只鸟把头从翅膀下<w>拉出</w>来了。"
                            }
                        },
                        {
                            "text": "She <w>untucked</w> the blanket before getting out of bed.",
                            "target_lang_translations": {
                                "zh": "她下床前把毯子<w>展开</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form of the verb untuck."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "将塞入或卷入的东西拉出、展开。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拉出",
                                "target_lang_sense_clarification": "指将塞入的东西取出"
                            },
                            {
                                "target_lang_word": "展开",
                                "target_lang_sense_clarification": "指将卷起或藏起的部分弄平整"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}