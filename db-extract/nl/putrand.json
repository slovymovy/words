                            {
                                "example_id": "b84b2c54-8119-4b7e-a7b2-44e3a4b589e9",
                                "sense_id": "13001d39-83ee-34a0-937b-840a7ebcb26a",
                                "text": "Jan pakt het fotoboek van de fietstocht dat voor hem op tafel ligt. Een foto van een lage putrand: „Dat ziet Hans niet.” Ze waren twee weken onderweg toen Hans met zijn voorwiel in de put ramde en tegen de stoeprand klapte."
                            },
                            {
                                "example_id": "570be4c9-cd68-4692-bb43-eb659716fb55",
                                "sense_id": "13001d39-83ee-34a0-937b-840a7ebcb26a",
                                "text": "De werken aan de Gelrodeweg zijn gestart. Daar gaat de stad betonnen goten plaatsen en de putranden, roosters en straatkolken op hoogte brengen."
                            }
                        ]
                    }
