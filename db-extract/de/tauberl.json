                "senses": [
                    {
                        "sense_id": "9b56f7af-29dc-3221-bbf4-954f45f9ff12",
                        "entry_id": "57e2b0fc-a5bf-37b7-8dba-501902503516",
                        "glosses": [
                            "Verkleinerungs- und Verniedlichungsform zu Taube"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "775b518f-2555-4234-8508-1e28fa9ed080",
                                "sense_id": "9b56f7af-29dc-3221-bbf4-954f45f9ff12",
                                "text": "„Kreisler galt als Meister des schwarzen Humors. Zu seinen bekanntesten Stücken gehören die Songs »Gehn ma Tauberl vergiften im Park« und »Wie schön wäre Wien ohne Wiener«.“"
                            },
                            {
                                "example_id": "a6bdcf7a-319b-492f-bfd6-cde1525a77fc",
                                "sense_id": "9b56f7af-29dc-3221-bbf4-954f45f9ff12",
                                "text": "„Trotz Pensionierung will sich Borsodi aber nicht ausruhen. »Ich bin voll Energie und Ideen, weil mit Tauberl füttern will ich mich nicht zufrieden geben.«“"
                            },
                            {
                                "example_id": "d950d410-87b6-47d6-8b05-cd12c00ce53b",
                                "sense_id": "9b56f7af-29dc-3221-bbf4-954f45f9ff12",
                                "text": "„Ich will mir seidene Schnupftücheln sticken lassen, in ein' Eck' mein' Namen, in die andern Amoretteln oder Tauberln oder so was […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
