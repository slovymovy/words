                "senses": [
                    {
                        "sense_id": "652b54a2-3698-3b28-b481-6f6d57d2215d",
                        "entry_id": "87fef0ed-3aa5-3817-86a2-0c097b15a5b4",
                        "glosses": [
                            "Qui se rapporte à la sociologie du langage, à la langue dans son aspect socioculturel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21bcc012-fac6-4ffc-911a-2bd0124fd5b3",
                                "sense_id": "652b54a2-3698-3b28-b481-6f6d57d2215d",
                                "text": "Les causes de l’emprunt sont ainsi intimement liées aux conditions sociohistoriques, particulièrement politiques et économiques, qui font évoluer les situations sociolinguistiques."
                            },
                            {
                                "example_id": "bad66dde-d8b5-4253-9212-17d39150fcd9",
                                "sense_id": "652b54a2-3698-3b28-b481-6f6d57d2215d",
                                "text": "Une étude sociolinguistique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a8ac894-bbde-454e-ae3a-cbe065e92c64",
                        "source_entry_id": "87fef0ed-3aa5-3817-86a2-0c097b15a5b4",
                        "source_sense_id": "652b54a2-3698-3b28-b481-6f6d57d2215d",
