                        "glosses": [
                            "Capable of being pardoned; worthy of pardon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ab77a01-2724-44a7-a630-dc2248dff9c0",
                                "sense_id": "0e6033a0-5ed6-316c-a221-940b7fc7f941",
                                "text": "Perhaps they set out to do too much, a more pardonable offence than doing too little."
                            }
                        ]
