                "senses": [
                    {
                        "sense_id": "832d72e8-2163-31dd-9148-f3ca80e80a09",
                        "entry_id": "dcad6ae7-3afb-34af-a882-e84bb5a0c6be",
                        "glosses": [
                            "Großunternehmen, das Reisen für sehr viele Menschen organisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78fbc4a3-924c-4061-99d6-f26d65739d4d",
                                "sense_id": "832d72e8-2163-31dd-9148-f3ca80e80a09",
                                "text": "„Flugausfälle sorgten bei dem Touristikkonzern für hohe Zusatzkosten.“"
                            },
                            {
                                "example_id": "611aca53-ced5-48c1-8949-d4bb077f42ba",
                                "sense_id": "832d72e8-2163-31dd-9148-f3ca80e80a09",
                                "text": "[Coronapandemie 2020:] „Der weltgrößte Touristikkonzern TUI stellt fast den gesamten regulären Betrieb ein.“"
                            },
                            {
                                "example_id": "22fd7541-7b6d-4ee7-ba92-c69bed16c6e8",
                                "sense_id": "832d72e8-2163-31dd-9148-f3ca80e80a09",
                                "text": "[Schlagzeile:] „Coronakrise – Touristikkonzerne greifen den Reisebüros in die Kasse“"
                            },
                            {
                                "example_id": "40b55445-a95f-4db2-89c9-bea5e90f062c",
                                "sense_id": "832d72e8-2163-31dd-9148-f3ca80e80a09",
                                "text": "„Reisebüros leiden besonders stark unter der Corona-Krise, jetzt kommt noch ein Schlag: Die Touristikkonzerne holen sich die Provisionen zurück.“"
                            },
                            {
                                "example_id": "cc7b1d0b-dfef-4a74-97ad-095a102260fc",
                                "sense_id": "832d72e8-2163-31dd-9148-f3ca80e80a09",
                                "text": "„Die Eigner des schwer von der Corona-Krise getroffenen Touristikkonzerns stimmten am Dienstag mit großer Mehrheit einem entsprechenden Recht zum Umtausch von Vermögenseinlagen in Aktien zu.“"
                            },
                            {
                                "example_id": "679603e8-195e-4a52-a6a8-2af4e56b426a",
                                "sense_id": "832d72e8-2163-31dd-9148-f3ca80e80a09",
                                "text": "„Es hat nicht gereicht: Der Handels- und Touristikkonzern Arcandor ist pleite.“"
                            },
                            {
                                "example_id": "c5d4a1ca-4d31-481c-b822-4b252a1c25aa",
                                "sense_id": "832d72e8-2163-31dd-9148-f3ca80e80a09",
                                "text": "„Integrierte Touristikkonzerne sind per se international ausgerichtet.“"
                            },
                            {
                                "example_id": "10d907e5-e0b0-4bdc-a4cb-cdb27cc27bd8",
                                "sense_id": "832d72e8-2163-31dd-9148-f3ca80e80a09",
                                "text": "„Wem in Touristikkonzernen fällt es bei Millionen Kunden heute auf, wenn auf einmal die wertvollsten und besten Kunden fehlen?“"
                            },
                            {
                                "example_id": "c364eebc-696a-4106-8ff3-abd540f773ce",
                                "sense_id": "832d72e8-2163-31dd-9148-f3ca80e80a09",
                                "text": "[11. Sept. 2001:] „Die ersten Einschätzungen der großen Touristikkonzerne, das Buchungsverhalten werde sich schnell wieder normalisieren, erwiesen sich als Trugschluss.“"
                            },
                            {
                                "example_id": "dd7f9c32-2804-4ddf-b975-bf191e9e62d2",
                                "sense_id": "832d72e8-2163-31dd-9148-f3ca80e80a09",
                                "text": "„Während in Deutschland vor allem die integrierten Touristikkonzerne den Markt dominieren, haben sich im Ausland Spezialanbieter etablieren können, die einen bestimmten Bereich der Wertschöpfungskette bedienen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
