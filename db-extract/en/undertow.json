                                "target_senses": [
                                    {
                                        "sense_id": "d982149a-0e12-3b52-909b-b0aa6ddc43e6",
                                        "entry_id": "942858a7-7b9c-37a6-bf7e-4b6a2e83ea5a",
                                        "glosses": [
                                            "in die entgegengesetzte Richtung strömende Masse"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78019fce-27ae-4515-8720-810ccf18700d",
                                                "sense_id": "d982149a-0e12-3b52-909b-b0aa6ddc43e6",
                                                "text": "„Die Caledonia, eine fast achtzig Meter lange Hochseeyacht, verlor durch die Gegenströmung des Fjords schnell an Fahrt. Lawrence wartete, bis sie beinahe völlig zum Stillstand gekommen war. Dann befahl er: »Anker werfen!«“"
                                            },
                                            {
                                                "example_id": "d24b06a4-99f1-499e-9093-6f45c784c1dc",
                                                "sense_id": "d982149a-0e12-3b52-909b-b0aa6ddc43e6",
                                                "text": "„Bei großer Fahrt machten wir ohne bedeutende Gegenströmung 6,5 Knoten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2ea8a3b9-ccbb-3428-9dab-1b298a2985b3",
                                        "entry_id": "942858a7-7b9c-37a6-bf7e-4b6a2e83ea5a",
                                        "glosses": [
                                            "alternatives Konzept zu etwas, zum Beispiel zu einer Kunstrichtung oder politischen Idee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95a1a213-3066-40cb-8941-c1e39ec30ec9",
                                                "sense_id": "2ea8a3b9-ccbb-3428-9dab-1b298a2985b3",
                                                "text": "„Der Begriff ›Neue Sachlichkeit‹ stammt eigentlich aus der Malerei und bezeichnet eine Gegenströmung zum Expressionismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
