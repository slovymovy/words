                "senses": [
                    {
                        "sense_id": "2b55a033-a1b6-3afe-be1e-8f5d351bd93a",
                        "entry_id": "fe10abdc-bd77-3e67-b64a-bb519b76cd42",
                        "glosses": [
                            "Qui a rapport à la médecine légale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51dcbf2e-3743-4138-8f45-bb84e54be257",
                                "sense_id": "2b55a033-a1b6-3afe-be1e-8f5d351bd93a",
                                "text": "Un certificat médical, attestant que le corps de ma mère ne pose pas de problème médicolégal, stipulant clairement qu’elle n’est pas porteuse d’un virus mortel."
                            },
                            {
                                "example_id": "e9231f37-dd40-4e17-a789-35d53e3005d4",
                                "sense_id": "2b55a033-a1b6-3afe-be1e-8f5d351bd93a",
                                "text": "Enquête, expertise médicolégale."
                            },
                            {
                                "example_id": "8d7846ba-90eb-4ce5-9ece-4c5d4ceb0cfe",
                                "sense_id": "2b55a033-a1b6-3afe-be1e-8f5d351bd93a",
                                "text": "Institut médicolégal, la morgue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27d9f529-1c1c-49a0-bd47-c191aa9fe9bf",
                        "source_entry_id": "fe10abdc-bd77-3e67-b64a-bb519b76cd42",
                        "source_sense_id": "2b55a033-a1b6-3afe-be1e-8f5d351bd93a",
