                        "grand pingouin"
                    ]
                },
                {
                    "sense_id": "a30e1cef-1482-3b74-bed9-7bf9e86d8245",
                    "sense_definition": "Personne vêtue d'un costume noir et d'une chemise blanche, rappelant le smoking ou la tenue de soirée formelle.",
