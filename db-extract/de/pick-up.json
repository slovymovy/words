                ],
                "senses": [
                    {
                        "sense_id": "fd46ce58-d1a3-3ffe-9136-475bb9ae1e98",
                        "entry_id": "7400ea7b-2e7b-3e16-a147-4743a1240a8a",
                        "glosses": [
                            "kleiner Pritschenwagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c05601cd-d3c5-4986-b569-cddc81d65dcd",
                                "sense_id": "fd46ce58-d1a3-3ffe-9136-475bb9ae1e98",
                                "text": "Der Pick-up war ziemlich neu, stand aber auf platten Reifen und schien seit Wochen nicht mehr bewegt worden zu sein."
                            },
                            {
                                "example_id": "c8401f64-b82b-49d3-9346-9f6e7211aa04",
                                "sense_id": "fd46ce58-d1a3-3ffe-9136-475bb9ae1e98",
                                "text": "„Wir stiegen in einen Pick-up ohne Scheiben.“"
                            },
                            {
                                "example_id": "bba03ae5-426d-4ed3-a451-97d2c5e11a46",
                                "sense_id": "fd46ce58-d1a3-3ffe-9136-475bb9ae1e98",
                                "text": "„Als wir mit laut heulender Motorbremse vorsichtig ins Niltal rollen, sehen wir am rechten Straßenrand einen roten Toyota Pick-up.“"
                            },
                            {
                                "example_id": "2c9b9e7b-3c78-4e5a-8955-745b9899bab1",
                                "sense_id": "fd46ce58-d1a3-3ffe-9136-475bb9ae1e98",
                                "text": "„Etwa 15 Minuten später fuhr ein Pick-up vor, und die Männer im Wagen wiesen uns an, ihnen zu folgen.“"
                            },
                            {
                                "example_id": "d3983757-e7f6-416e-b4f7-ce8f6b45e729",
                                "sense_id": "fd46ce58-d1a3-3ffe-9136-475bb9ae1e98",
                                "text": "„Pick-ups waren mit Obst und Gemüse beladen.“"
                            },
                            {
                                "example_id": "e85c9d86-1f8a-4495-a088-dd5d5bc7e19f",
                                "sense_id": "fd46ce58-d1a3-3ffe-9136-475bb9ae1e98",
                                "text": "„Ich hab mal gesehen, wie ein Mann mit einer Schrotflinte auf seinen Pick-up geschossen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8a2d57a-b235-4e68-a0d6-d2ff8b7a7499",
                        "source_entry_id": "7400ea7b-2e7b-3e16-a147-4743a1240a8a",
