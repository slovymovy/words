                "senses": [
                    {
                        "sense_id": "f5fcc694-e8b0-31b1-97d3-b6c7b6cf24a6",
                        "entry_id": "3fc65ec8-76fa-393e-a878-a5eba3d90f21",
                        "glosses": [
                            "gehandelte Ware"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "922d5644-e2cd-4727-8d68-1cc2af9b8a48",
                                "sense_id": "f5fcc694-e8b0-31b1-97d3-b6c7b6cf24a6",
                                "text": "„Sie hatten oft aber auch große Mengen Lebensmittel in ihrem Gepäck, teils als Handelsware, teils als Reiseproviant.“"
                            },
                            {
                                "example_id": "0c22aa2f-af22-4a4e-aa65-de4ef62b28cd",
                                "sense_id": "f5fcc694-e8b0-31b1-97d3-b6c7b6cf24a6",
                                "text": "„Für die Hersteller dieser Handelswaren sind das gerade in Corona-Zeiten empfindliche Nadelstiche, die einige von ihnen – etwa die Hummer-Fischer – an den Rand des Ruins treiben.“"
                            },
                            {
                                "example_id": "a4ae748f-3df2-4684-a038-205462d6878b",
                                "sense_id": "f5fcc694-e8b0-31b1-97d3-b6c7b6cf24a6",
                                "text": "„Das Theater sei eine Handelsware wie jede andere.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
