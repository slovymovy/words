                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8475b56a-b925-4115-8508-ef8cb9d03435",
                                                "sense_id": "1c0ee441-1ad6-3de7-a994-5eb78e81fbce",
                                                "text": "Frau Zucker ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "0b869452-c9be-4bca-ae3f-9d3d3a954f15",
                                                "sense_id": "1c0ee441-1ad6-3de7-a994-5eb78e81fbce",
                                                "text": "Herr Zucker wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "17263136-54a7-439c-b5d6-9815b64a3da9",
                                                "sense_id": "1c0ee441-1ad6-3de7-a994-5eb78e81fbce",
                                                "text": "Die Zuckers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "6242a015-ead8-406f-95c0-b4683c77dd77",
                                                "sense_id": "1c0ee441-1ad6-3de7-a994-5eb78e81fbce",
                                                "text": "Der Zucker trägt nie die Schals, die die Zucker ihm strickt."
                                            },
                                            {
                                                "example_id": "d8fa4aa4-c28a-4412-bdca-0a1c4307c0dd",
                                                "sense_id": "1c0ee441-1ad6-3de7-a994-5eb78e81fbce",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zucker kommt, geht der Herr Zucker.“"
                                            },
                                            {
                                                "example_id": "cf43c78a-cfbc-4423-8ef3-11a30c3ec78d",
                                                "sense_id": "1c0ee441-1ad6-3de7-a994-5eb78e81fbce",
                                                "text": "Zucker kommt und geht."
                                            },
                                            {
                                                "example_id": "58bef3f2-be48-4feb-8cef-f707f6d761a6",
                                                "sense_id": "1c0ee441-1ad6-3de7-a994-5eb78e81fbce",
                                                "text": "Zuckers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
