                                        "glosses": [
                                            "An unstable but potentially long-lived state of a system; for example, a supersaturated solution or an excited atom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
