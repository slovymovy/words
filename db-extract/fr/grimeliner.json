                "senses": [
                    {
                        "sense_id": "8c9abecc-2cf2-3081-b96b-2fb580f0eaff",
                        "entry_id": "8394f6a2-0ef1-36ad-ae14-89c31066807e",
                        "glosses": [
                            "Jouer petit jeu et mesquinement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1051f89-d8a2-4784-a6ba-34a5ca8126c3",
                                "sense_id": "8c9abecc-2cf2-3081-b96b-2fb580f0eaff",
                                "text": "Il ne joue jamais gros jeu, il grimeline."
                            }
                        ]
                    },
                    {
                        "sense_id": "219af48b-d3de-3db8-9f68-454376d3b85b",
                        "entry_id": "8394f6a2-0ef1-36ad-ae14-89c31066807e",
                        "glosses": [
                            "Se ménager quelque petit profit dans une affaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10e6f702-0d4d-40e5-95e0-4bb977d125f6",
                                "sense_id": "219af48b-d3de-3db8-9f68-454376d3b85b",
                                "text": "Il n'est pas dans les grandes affaires, il ne fait que grimeliner."
                            },
                            {
                                "example_id": "47994286-aafa-40c1-b0bc-ca749343c3c2",
                                "sense_id": "219af48b-d3de-3db8-9f68-454376d3b85b",
                                "text": "Je vous remercierai toujours des bontés dont vous m'avez honoré auprès de cet épineux d’Espagnac ; il devrait bien plutôt songer à tirer le pays de Gex de la misère, qu’à grimeliner des lods et ventes"
                            }
                        ]
                    }
