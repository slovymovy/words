                "senses": [
                    {
                        "sense_id": "c192edd3-b4b3-3a54-96d0-372f3010fa96",
                        "entry_id": "a540f3d3-b152-3887-8874-0edee0f7a070",
                        "glosses": [
                            "is een klein draagbaar toestel dat computer-, telefonie-, fax- en netwerkfuncties combineert; de voorganger van de smartphone"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0adc2632-8701-4562-8c62-641f91387708",
                                "sense_id": "c192edd3-b4b3-3a54-96d0-372f3010fa96",
                                "text": "Rim lanceert een eerste mobiele toestel: de Blackberry 950. Het krijgt de naam Blackberry omdat de toesten doen denken aan een braambes. Verder lijkt het op veel andere ‘palmtops’, maar het bedrijf introduceert wel een belangrijke nieuwigheid: de e-mailfunctie. Andere producenten kregen dit niet voor elkaar, maar door het gebruik van eigen servers slaagt het bedrijf erin om mailverkeer van en naar het toestel in goede banen te leiden"
                            },
                            {
                                "example_id": "2a40297a-73c3-4bb7-88cf-acac58a32b21",
                                "sense_id": "c192edd3-b4b3-3a54-96d0-372f3010fa96",
                                "text": "Het aantal mensen dat via een laptop online ging bleef vrijwel gelijk op circa 21 procent. Het percentage internetters dat via de zogeheten palmtop het web opgingen nam iets af van 4 naar 3 procent."
                            },
                            {
                                "example_id": "cf7595d4-4e10-4bb6-a21d-b331d7683e31",
                                "sense_id": "c192edd3-b4b3-3a54-96d0-372f3010fa96",
                                "text": "Van oorsprong is TomTom een softwarebedrijf. Onder de naam Palmtop maakte het in de jaren '90 apps voor de eerste generatie zakcomputers. Na de eeuwwisseling sloeg het bedrijf een nieuwe koers in. Het werd omgedoopt tot TomTom en richtte zijn pijlen volledig op een nieuwe maar snel groeiende markt: gps-navigatie voor in de auto."
                            }
                        ]
                    }
                ],
                "translations": [
