                                        "glosses": [
                                            "muza tańca i pieśni chóralnej, jedna z towarzyszek Apolla; córka Zeusa i Mnemosyne"
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "221cbd58-aab9-4eb6-a2d0-bf6a00aa0261",
                                                "sense_id": "571a2f69-8b2a-375e-a19e-5c01f38ffe2b",
                                                "text": "Terpsychora i jej siostry uświetniały śpiewem biesiady bosko-ludzkie oraz uczty olimpijskie bogów."
                                            },
                                            {
                                                "example_id": "554fbcad-195c-48f5-abdd-63caaec60406",
                                                "sense_id": "571a2f69-8b2a-375e-a19e-5c01f38ffe2b",
                                                "text": "Atrybutami Terpsychory były: lira i plektron."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
