                "senses": [
                    {
                        "sense_id": "216d24fe-8f98-3c9b-bf23-05a7654dab21",
                        "entry_id": "df3c8c01-c429-3b54-9ff6-e095cb79416f",
                        "glosses": [
                            "eingefügtes/eingeschlossenes Stückchen, Teilchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0c2c283-f52c-46be-a9b1-f885cd3ca5c7",
                                "sense_id": "216d24fe-8f98-3c9b-bf23-05a7654dab21",
                                "text": "Der Stein hat kleine Einsprengsel von Quarz."
                            },
                            {
                                "example_id": "660b405a-c0cf-40e6-91ad-3a96a65981f8",
                                "sense_id": "216d24fe-8f98-3c9b-bf23-05a7654dab21",
                                "text": "„Es ist schon erstaunlich, wie viele jiddische Einsprengsel sich in allen deutschen Mundarten finden lassen.“"
                            },
                            {
                                "example_id": "3d28e6f2-f361-4cd5-b06c-54e8ae2e89cd",
                                "sense_id": "216d24fe-8f98-3c9b-bf23-05a7654dab21",
                                "text": "„Und dabei hatten die Juden ursprünglich diese semitischen Einsprengsel im deutschen Text als so fremd empfunden, daß sie sie in Anführungszeichen setzten!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
