                        "examples": [
                            {
                                "example_id": "f9ca3973-2e01-45d9-b19f-6a0a224a2efd",
                                "sense_id": "dc97715b-68b9-3795-9dc9-329bedd5cbbf",
                                "text": "1637, John Milton, Comus, London: Humphrey Robinson, p. 20,\nI found the place\nWhere that dam’d wisard hid in slie-disguise\n(For so by certain signs I knew) had met\nAlreadie, ere my best speed could praevent\nThe aidlesse innocent Ladie his wish’t prey,"
                            },
                            {
                                "example_id": "fa08ae2b-44f9-4608-ab1d-e1f1954adce0",
                                "sense_id": "dc97715b-68b9-3795-9dc9-329bedd5cbbf",
                                "text": "It is not meet, Sir King, to leave thee thus, / Aidless, alone, and smitten through the helm."
                            }
                        ]
                    },
                    {
                        "sense_id": "383bd780-a538-3a4f-8b6c-b0893c16910b",
                        "entry_id": "74465251-8d6a-38b9-843a-c3e1414b9920",
                        "glosses": [
                            "Without mechanical assistance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9387483-379b-4958-8dcf-0b4815fe938c",
                                "sense_id": "383bd780-a538-3a4f-8b6c-b0893c16910b",
                                "text": "Aidless navigation has the advantage of not requiring equipment, but is much less accurate."
                            }
                        ]
