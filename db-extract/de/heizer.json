                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b5a487e-e10c-3971-82b4-e88ae00d35b6",
                        "entry_id": "d6a51730-424a-33b8-99fa-799ed18f6d9e",
                        "glosses": [
                            "Person, die beruflich für die Beheizung von Dampfkesseln, Heizungsanlagen und Verbrennungsanlagen vorwiegend bei Dampflokomotiven und Dampfschiffen sorgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "909fcab8-31ab-4e5a-b1ae-50d38dd0539d",
                                "sense_id": "2b5a487e-e10c-3971-82b4-e88ae00d35b6",
                                "text": "„Bei ersten Versuchen benutzte man kleine, auf dem Tender aufgestellte Kolbendampfmaschinen, deren Regelung jedoch vom Heizer zu viel Aufmerksamkeit forderte.“"
                            },
                            {
                                "example_id": "76b3d0ec-ba4d-47c7-a29e-c06c78b6cfbd",
                                "sense_id": "2b5a487e-e10c-3971-82b4-e88ae00d35b6",
                                "text": "„Die Mannschaftsräume waren klein und bis zur Unerträglichkeit überfüllt, alles war da zusammengewürfelt: Matrosen, Heizer, Signalgasten und Funker.“"
                            },
                            {
                                "example_id": "b1e91ad5-d000-40cc-8f48-f80257705493",
                                "sense_id": "2b5a487e-e10c-3971-82b4-e88ae00d35b6",
                                "text": "„Wie schaffte er es nur, den schweren Beruf eines Heizers auszuüben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4045eac0-1ccf-33ae-99fa-4cb9eb841ad0",
                        "entry_id": "d6a51730-424a-33b8-99fa-799ed18f6d9e",
                        "glosses": [
                            "bis zum Jahr 1938 Dienstgrad der deutschen Marine"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "4cbdc025-1284-4322-9270-50fbed2d9fe2",
                                "sense_id": "4045eac0-1ccf-33ae-99fa-4cb9eb841ad0",
                                "text": "Sein Urgroßvater hatte in den 20er Jahren als Heizer bei der Reichswehr gedient."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b90f0106-8d8e-43a8-87c7-d0f6b2b6d133",
                        "source_entry_id": "d6a51730-424a-33b8-99fa-799ed18f6d9e",
                        "source_sense_id": "2b5a487e-e10c-3971-82b4-e88ae00d35b6",
                        "source_sense_description": "Person, die heizt",
                        "target_lang_word": "fireman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fireman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "477086d6-31a8-3ea9-af9e-28f6df39d24f",
                                        "entry_id": "9af78a70-343d-31d9-9602-c73e66182df5",
                                        "glosses": [
                                            "Someone (especially one who is male) who is skilled in the work of fighting fire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7daecca9-0d3e-46cb-900c-c2c0c19338e2",
                                                "sense_id": "477086d6-31a8-3ea9-af9e-28f6df39d24f",
                                                "text": "By February 1944 there were over two thousand women employed at the Alabama Dry Dock and Shipbuilding Company [...]. There were also female firemen on almost every shipyard crane [...]."
                                            },
                                            {
                                                "example_id": "b33c85aa-dd9d-45f0-b9f7-ba140b589f48",
                                                "sense_id": "477086d6-31a8-3ea9-af9e-28f6df39d24f",
                                                "text": "For firemen everywhere rescuing cats from trees has been as much a part of the job as tackling blazing buildings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca5d962e-4dcc-3a8c-b0a7-87b22eb9c5f4",
                                        "entry_id": "9af78a70-343d-31d9-9602-c73e66182df5",
                                        "glosses": [
                                            "A person (originally a man) who keeps the fire going underneath a steam boiler (originally, shoveling coal by hand), particularly on a railroad locomotive or steamship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6eb2258-9c5e-4457-ab9e-5a4261650ef9",
                                                "sense_id": "ca5d962e-4dcc-3a8c-b0a7-87b22eb9c5f4",
                                                "text": "He looked around his cab at his black greasy fireman, saying 'shovel on a little more coal, and when we cross that White Oak Mountain, you can watch Old 97 roll'."
                                            },
                                            {
                                                "example_id": "bba931e3-d10f-41b7-948a-64773822ccc5",
                                                "sense_id": "ca5d962e-4dcc-3a8c-b0a7-87b22eb9c5f4",
                                                "text": "No grass grew under a train when the engineer let Fireman McLash take the throttle."
                                            },
                                            {
                                                "example_id": "8eb482b2-2312-467c-a353-b78aa044e7cb",
                                                "sense_id": "ca5d962e-4dcc-3a8c-b0a7-87b22eb9c5f4",
                                                "text": "A few keen enginemen, such as Driver Rosewarne of York, could coax good work out of them when engaged in heavy East Coast express service, but to most footplate crews, especially firemen, they were rather heartbreaking and backbreaking machines, and gradually were relegated to secondary or fast goods duties."
                                            },
                                            {
                                                "example_id": "ff8bd3cf-9499-41b1-825d-e4bde4785461",
                                                "sense_id": "ca5d962e-4dcc-3a8c-b0a7-87b22eb9c5f4",
                                                "text": "I was elated to pass because there were times when I did not think I was physically capable. It is quite rare for a woman to become a fireman."
                                            },
                                            {
                                                "example_id": "ddf2339c-2ec6-4092-b88c-d8c37b7b9053",
                                                "sense_id": "ca5d962e-4dcc-3a8c-b0a7-87b22eb9c5f4",
                                                "text": "The driver remained at his post, while telling fireman Jim Nightall to get down on the track and run back to uncouple the burning wagon from the rest."
                                            },
                                            {
                                                "example_id": "d58b095c-3e92-402d-8848-d8d1219e682b",
                                                "sense_id": "ca5d962e-4dcc-3a8c-b0a7-87b22eb9c5f4",
                                                "text": "(the latter is informal)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d41a175-94ec-3a7c-b181-dee845dbc21b",
                                        "entry_id": "9af78a70-343d-31d9-9602-c73e66182df5",
                                        "glosses": [
                                            "An assistant on any locomotive, whether steam-powered or not."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b484799-7390-33b4-bfda-fe17436f7000",
                                        "entry_id": "9af78a70-343d-31d9-9602-c73e66182df5",
                                        "glosses": [
                                            "A relief pitcher (reflecting the figurative analogy of rescuing the situation)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f259ab4-aeae-3cab-9747-c35d1e366cef",
                                        "entry_id": "9af78a70-343d-31d9-9602-c73e66182df5",
                                        "glosses": [
                                            "A safety inspector in coal mines."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e916a5b-4dfb-4942-9195-767d785d4701",
                        "source_entry_id": "d6a51730-424a-33b8-99fa-799ed18f6d9e",
                        "source_sense_id": "2b5a487e-e10c-3971-82b4-e88ae00d35b6",
                        "source_sense_description": "Person, die heizt",
                        "target_lang_word": "stoker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stoker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88f4cf4b-d16e-3902-9b64-408de2a9f2db",
                                        "entry_id": "2de7b3ae-b287-3a4e-a51e-d65fb17f5e88",
                                        "glosses": [
                                            "A person who stokes, especially one on a steamship or steam train, who stokes coal in the boilers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4117660-582f-4ff4-bd19-e29f713a2732",
                                                "sense_id": "88f4cf4b-d16e-3902-9b64-408de2a9f2db",
                                                "text": "For this was a line so little frequented, especially at this hour, when the driver, the stoker, the guard and the station staffs all along the line, were anhelating towards their wives, after the long hours of continence, that the train would hardly draw up, when it would be off again, like a bouncing ball."
                                            },
                                            {
                                                "example_id": "495df430-e422-4940-a3b3-83504ffe2217",
                                                "sense_id": "88f4cf4b-d16e-3902-9b64-408de2a9f2db",
                                                "text": "He held strongly to the black-ganger's philosophy - what is the use of all the radar and guns and torpedoes if you don't have the engineers and stokers to put them in the right position?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72ce27a0-0be9-3cf1-8aab-c5392077e6d3",
                                        "entry_id": "2de7b3ae-b287-3a4e-a51e-d65fb17f5e88",
                                        "glosses": [
                                            "A device for stoking a fire; a poker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79bfb7f4-02d5-3c62-86a8-e162fe1ae1c1",
                                        "entry_id": "2de7b3ae-b287-3a4e-a51e-d65fb17f5e88",
                                        "glosses": [
                                            "A device that feeds coal into a furnace, etc., automatically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2db9a45f-2063-478b-b669-0294ca4da604",
                                                "sense_id": "79bfb7f4-02d5-3c62-86a8-e162fe1ae1c1",
                                                "text": "As we reported was to occur, two of Saltley's stoker-fitted 2-10-0s, Nos. 92165/7, have been stripped of their stokers at Crewe works."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf8eaa8d-9bb8-34e1-9b8e-19906924e0bd",
                                        "entry_id": "2de7b3ae-b287-3a4e-a51e-d65fb17f5e88",
                                        "glosses": [
                                            "A person who pedals on the back of a tandem bicycle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
