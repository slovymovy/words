    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d465d959-ac30-3a60-8adf-267a30c30e9a",
                "word": "attendee",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "485d2f07-6bbd-4c7c-9ea9-ab970673d600",
                        "entry_id": "d465d959-ac30-3a60-8adf-267a30c30e9a",
                        "tags": [
                            "plural"
                        ],
                        "form": "attendees"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2b6b3df-a5f2-3d94-990b-aed3bc94cc5a",
                        "entry_id": "d465d959-ac30-3a60-8adf-267a30c30e9a",
                        "glosses": [
                            "A person who is in attendance or in the audience of an event."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b28514a-095e-48d8-9867-5b6d3321f350",
                                "sense_id": "e2b6b3df-a5f2-3d94-990b-aed3bc94cc5a",
                                "text": "During the official performance of the National Anthem of the Russian Federation all attendees are supposed to stand and men take their hats off."
                            },
                            {
                                "example_id": "c52703e7-c936-42c4-bcba-10c4b00db447",
                                "sense_id": "e2b6b3df-a5f2-3d94-990b-aed3bc94cc5a",
                                "text": "O'Reilly, the summit host, remembers a particularly insightful comment from Torvalds, a summit attendee."
                            },
                            {
                                "example_id": "1ed0d205-8f98-46c0-9868-8f64733093f6",
                                "sense_id": "e2b6b3df-a5f2-3d94-990b-aed3bc94cc5a",
                                "text": "President Donald Trump, Vice President Mike Pence and other administration officials attended the conference, though the ACU says the attendee did not come into contact with the president or vice president, nor did they attend events in the main hall."
                            },
                            {
                                "example_id": "a301e58c-8310-41aa-9e8d-f7532e040aa9",
                                "sense_id": "e2b6b3df-a5f2-3d94-990b-aed3bc94cc5a",
                                "text": "There is also no barrier to those living outside of London, which the team quickly discovered when they started running virtual tours and found that 50% of the attendees were from overseas, joining the tour from as far away as Singapore, Toronto and Australia."
                            },
                            {
                                "example_id": "dacb0d80-184e-4f8c-9dc1-0938efc8b41f",
                                "sense_id": "e2b6b3df-a5f2-3d94-990b-aed3bc94cc5a",
                                "text": "Many of the speakers and attendees see natalism as a way of reversing these changes."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab62b3ec-e68f-3b09-873b-0e7313d7d32c",
                        "entry_id": "d465d959-ac30-3a60-8adf-267a30c30e9a",
                        "glosses": [
                            "A person who is attended."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": []
                    }
                ],
