                                        "sense_id": "002b4309-0416-3c66-88ca-c47df52f0b6b",
                                        "entry_id": "68718a51-2b00-37d6-8ab2-0ab3f27ae811",
                                        "glosses": [
                                            "An employment position in which one remains mostly seated at a desk, performing routine office work."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a88cd47-2000-4237-95f5-f49f5abf3d21",
                                                "sense_id": "002b4309-0416-3c66-88ca-c47df52f0b6b",
                                                "text": "For 13 months in 1966 and '67 Corson served as commander of 3,500 men in 114 platoons spread out in hamlets across five provinces in South Viet Nam. . . . In 1968 Corson was reassigned to a desk job at the Pentagon."
                                            },
                                            {
                                                "example_id": "afce3cee-8327-4f17-9249-e1b1f18fa85c",
                                                "sense_id": "002b4309-0416-3c66-88ca-c47df52f0b6b",
                                                "text": "\"I really like working with the clients. Things break, but I've always been handy. And it sure beats a desk job,\" he says."
                                            }
                                        ]
                                    }
