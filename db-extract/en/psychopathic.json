                        "entry_id": "8298f105-e623-3020-be3d-642fd3ee3397",
                        "glosses": [
                            "Exhibiting the behaviors and personality traits of a psychopath."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9838af6d-36cd-4d77-af55-e0554fe85ea9",
                                "sense_id": "279e7ac2-cd58-3311-b6b3-3dd528005c89",
                                "text": "A psychopathic killer is on the loose."
                            },
                            {
                                "example_id": "8ae7da51-e25f-484e-87b7-c71bbe900c12",
                                "sense_id": "279e7ac2-cd58-3311-b6b3-3dd528005c89",
                                "text": "[T]he psychopathic temperament, whatever be the intellect with which it finds itself paired, often brings with it ardor and excitability of character."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e63da03a-4758-44bb-8780-fe828ab2233d",
                        "source_entry_id": "8298f105-e623-3020-be3d-642fd3ee3397",
