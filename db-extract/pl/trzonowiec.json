                                                "example_id": "e13659f8-784b-4d01-a6e8-e21ca0a8b91a",
                                                "sense_id": "16df2e27-dc2c-308f-ada7-25c9bf7ec09e",
                                                "text": "Ik kies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "000a778a-5146-3610-ac33-36f6db6b49d4",
                                        "entry_id": "69bbd09a-3761-3a07-8cbc-3951e9416e35",
                                        "glosses": [
