    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f4bd7dcf-b66a-35d8-b129-f9555a6fd360",
                    "sense_definition": "Rechnerischer Unterschied oder Betrag, der sich beim Vergleich zweier Zahlen oder Größen ergibt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mathematik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die rechnerische <w>Differenz</w> zwischen den Einnahmen und den Ausgaben beträgt genau zweihundert Euro."
                        },
                        {
                            "text": "Wenn man die beiden Beträge vergleicht, lässt sich eine unerwartete <w>Differenz</w> feststellen."
                        }
                    ],
                    "synonyms": [
                        "Unterschied",
                        "Saldo",
                        "Fehlbetrag",
                        "Manko"
                    ],
                    "antonyms": [
                        "Gleichheit"
                    ],
                    "common_phrases": [
                        "die Differenz berechnen",
                        "eine Differenz ausgleichen"
                    ]
                },
                {
                    "sense_id": "84a9d25f-2ba3-3f73-9366-63d9e2755f98",
                    "sense_definition": "Wahrnehmbarer Unterschied, eine Abweichung oder Nichtübereinstimmung zwischen zwei Sachverhalten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zwischen der theoretischen Planung und der tatsächlichen Umsetzung besteht eine erhebliche <w>Differenz</w>."
                        },
                        {
                            "text": "Die wissenschaftliche Studie untersucht die sozialen <w>Differenzen</w> zwischen verschiedenen Bevölkerungsgruppen in Großstädten."
                        }
                    ],
                    "synonyms": [
                        "Unterschied"
                    ],
                    "antonyms": [
                        "Gleichheit"
                    ],
                    "common_phrases": [
                        "eine erhebliche Differenz",
                        "große Differenzen aufweisen"
                    ]
                },
                {
                    "sense_id": "0cf895bd-2399-3049-b423-c3809e746129",
                    "sense_definition": "Ein Streit, Konflikt oder eine Meinungsverschiedenheit zwischen zwei oder mehreren Parteien.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die beiden Geschäftspartner konnten ihre geschäftlichen <w>Differenzen</w> nach einem langen Gespräch friedlich beilegen."
                        },
                        {
                            "text": "Trotz ihrer politischen <w>Differenzen</w> verhielten sich die Abgeordneten während der gesamten Debatte respektvoll zueinander."
                        }
                    ],
                    "synonyms": [
                        "Meinungsverschiedenheit",
                        "Konflikt",
                        "Streitigkeit",
                        "Streitpunkt",
                        "Zankapfel"
                    ],
                    "antonyms": [
                        "Einigkeit",
                        "Meinungsgleichheit"
                    ],
                    "common_phrases": [
                        "Differenzen beilegen",
                        "politische Differenzen",
                        "persönliche Differenzen"
                    ]
                },
                {
                    "sense_id": "5531265a-53c0-386c-bd81-475b10307522",
                    "sense_definition": "In der Mengenlehre die Menge aller Elemente, die zu einer Ausgangsmenge, aber nicht zu einer zweiten Menge gehören.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der Mengenlehre enthält die <w>Differenz</w> A \\ B alle Elemente von A, die nicht in B liegen."
                        },
                        {
                            "text": "Die <w>Differenz</w> der Mengen {1, 2, 3} und {2, 3} ist die Menge {1}."
                        }
                    ],
                    "synonyms": [
                        "Differenzmenge",
                        "Restmenge"
                    ],
                    "common_phrases": [
                        "symmetrische Differenz"
                    ]
                }
            ]
        }
    ]
