                                            {
                                                "example_id": "982aefbb-eef3-45d3-80cf-4ef323e95c8c",
                                                "sense_id": "7a8b8087-4985-36ea-9088-0da984dfd32c",
                                                "text": "Der König belohnte die erfolgreichen Truppen mit einem Festmahl."
                                            },
                                            {
                                                "example_id": "5707430b-28fb-46fc-b185-164c141abd18",
                                                "sense_id": "7a8b8087-4985-36ea-9088-0da984dfd32c",
                                                "text": "Wer gutes Benehmen belohnt, der hofft, dass es dadurch in Zukunft häufiger auftritt."
                                            },
                                            {
                                                "example_id": "36c19f86-e9db-4a44-ab5c-9be2088cd872",
                                                "sense_id": "7a8b8087-4985-36ea-9088-0da984dfd32c",
                                                "text": "Wie? Er soll das Fahrrad behalten dürfen? Willst du sein Verhalten auch noch belohnen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
