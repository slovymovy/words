                            {
                                "example_id": "6526474d-2ccc-4662-a133-a6da81d3111e",
                                "sense_id": "2aa24fc8-4dd5-332d-aba1-999603c02ba5",
                                "text": "Connaissez-vous le dogpile ? C'est quand quelqu'un dit un truc et que plein de gens y réagissent, la submergeant de messages souvent redondants et pas toujours pertinents."
                            }
                        ]
                    }
