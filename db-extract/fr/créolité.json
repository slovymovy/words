                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a3b59e2-e8b1-47f4-a45a-e343a6f0e302",
                                "sense_id": "66813732-cbc6-34e0-940c-51761dae4577",
                                "text": "Cette quête de soi, omniprésente dans la plupart des romans susmentionnés, connaîtra dans les années 1990 une nouvelle formulation théorique avec la créolité."
                            },
                            {
                                "example_id": "3a235847-5dd3-42bf-996a-7b585debf3d3",
                                "sense_id": "66813732-cbc6-34e0-940c-51761dae4577",
                                "text": "Les symboles de la créolité tels que la langue, le madras, le conte..., rythment ce spectacle qui navigue entre tradition et modernité."
                            },
                            {
                                "example_id": "1e7eddcc-a6f8-4213-a1de-5e488e354b40",
                                "sense_id": "66813732-cbc6-34e0-940c-51761dae4577",
                                "text": "C'est Édouard Glissant, poète et penseur de la créolité, qui fait de la méduse un modèle civilisationnel."
                            }
                        ]
                    }
