                ],
                "senses": [
                    {
                        "sense_id": "39a1c6cb-ea14-3397-a806-8abc8d2cb099",
                        "entry_id": "9a144de6-8426-3ed1-9dbc-0df0b9f20a52",
                        "glosses": [
                            "abenteuerliche, dabei jedoch unglaubwürdige oder gänzlich erdachte Geschichte"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9951e2c2-1c6a-49cb-9a95-9c30de7b4ddc",
                                "sense_id": "39a1c6cb-ea14-3397-a806-8abc8d2cb099",
                                "text": "Mit einer wilden Räuberpistole hat ein angehender Ehemann versucht, seine eigene Hochzeit zu vertagen."
                            },
                            {
                                "example_id": "1177dde1-06fc-49c8-aa45-3cb24e06ac5f",
                                "sense_id": "39a1c6cb-ea14-3397-a806-8abc8d2cb099",
                                "text": "Es klingt wie eine Räuberpistole: Linken-Chef Lafontaine soll wochenlang von mehreren Sicherheitsfirmen bespitzelt worden sein."
                            },
                            {
                                "example_id": "24b9bd9c-f887-4310-8d20-abd4b7710f7c",
                                "sense_id": "39a1c6cb-ea14-3397-a806-8abc8d2cb099",
                                "text": "Doch um zu wissen, was eine unlogisch konstruierte Räuberpistole von dokumentarisch-literarischen Meisterwerken unterscheidet, sollte man nicht bei Karl Popper, sondern bei Bernard-Henri Lévy nachlesen."
                            },
                            {
                                "example_id": "686b1ba6-4565-4247-a40b-409d005a8ddc",
                                "sense_id": "39a1c6cb-ea14-3397-a806-8abc8d2cb099",
                                "text": "Doch das Buch des Bielefelder Historikers ist keine Räuberpistole, sondern ein gut recherchiertes, glänzend geschriebenes Werk."
                            },
                            {
                                "example_id": "717b4a48-6248-4bb4-8dda-ad0de4b08bfa",
                                "sense_id": "39a1c6cb-ea14-3397-a806-8abc8d2cb099",
                                "text": "„Es wurde kein Spaziergang, auch wenn das darüber geschriebene Buch so hieß, sondern ein Gewaltmarsch, ein Abenteuer mit Spelunken, Hürchen und Räuberpistolen - fingerfertig erzählten und handgreiflich auf die Brust gesetzten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
