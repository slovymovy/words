                {
                    "sense_id": "7fa87f08-3844-3779-abd2-4e22e390eff1",
                    "sense_definition": "Osoba mało inteligentna, niezdarna lub nieczuła",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie bądź takim <w>drzewem</w> i spróbuj wreszcie zrozumieć tę prostą zasadę.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>деревом</w> и попытайся наконец понять это простое правило.",
                                "en": "Don't be such a <w>blockhead</w> and finally try to understand this simple rule."
                            }
                        },
                        {
                            "text": "Tłumaczę mu to już trzeci raz, a to <w>drzewo</w> dalej nic nie rozumie.",
                            "target_lang_translations": {
                                "ru": "Объясняю ему уже в третий раз, а эта <w>дубина</w> всё равно ничего не понимает.",
                                "en": "I'm explaining it to him for the third time, and that <w>dimwit</w> still doesn't understand anything."
                            }
