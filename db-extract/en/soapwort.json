                                        "sense_id": "ef474c30-4de8-35a2-835e-4b39a9117b5f",
                                        "entry_id": "9a71b838-91d5-3686-949b-983b5e7224a0",
                                        "glosses": [
                                            "Saponaria officinalis een overblijvende, tot 70 cm hoge plant uit de anjerfamilie (Caryophyllaceae). De soortaanduiding officinalis geeft aan dat de plant medicinaal werd gebruikt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71996d67-7816-41f2-af99-a5131682ed2e",
                                                "sense_id": "ef474c30-4de8-35a2-835e-4b39a9117b5f",
                                                "text": "De Nederlandse naam zeepkruid is afgeleid van de giftige stof saponine die de plant bevat, vooral in de wortel, en die gaat schuimen bij contact met water."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7669c09-cca5-4c44-9179-d974ac330a38",
                        "source_entry_id": "ec2f4c4d-a292-3530-aec2-592d957dd04c",
                        "source_sense_id": "916dd0a6-348d-36bb-a3b7-463258e83ee7",
