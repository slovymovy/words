                        "entry_id": "dc21b904-6d70-3fae-b23d-d52d26ef3480",
                        "glosses": [
                            "wieża; wysoka budowla"
                        ],
                        "tags": [
                            "literary",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "7dd857b2-36bc-4762-8e56-1f433f8b1250",
                                "sense_id": "0281d1e1-5829-3e5a-aee5-f62f0ede32d8",
                                "text": "Kiedy na sekundę czarna opończa odrzucana została na bok, Małgorzata nie zwalniając biegu odwróciła się i zobaczyła, że nie ma już za nimi różnobarwnych wieżyc, nie ma już od dawna i miasta"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d8d57fef-f3b4-3ff0-844c-a2765b7b7cd1",
                        "entry_id": "dc21b904-6d70-3fae-b23d-d52d26ef3480",
                        "glosses": [
                            "wieża; w czołgu"
                        ],
                        "tags": [
                            "literary",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "94df55e2-86f5-4086-b826-a18d957662d2",
                                "sense_id": "d8d57fef-f3b4-3ff0-844c-a2765b7b7cd1",
                                "text": "Stacho podniósł broń i mierzył poprzez płomień do czarnej sylwetki, która zamajaczyła nad wieżycą czołgu"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
