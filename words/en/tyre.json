                    "frequency": "VeryLow",
                    "semantic_group_id": "dairy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional recipe required adding a bit of yesterday's <w>tyre</w> to the fresh milk to help it set.",
                            "target_lang_translations": {
