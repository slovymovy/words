                                        "sense_id": "ca700245-e99f-347a-bce6-a9c8312c1c13",
                                        "entry_id": "97788f71-a2ef-3b5b-b52d-91d2d6d0f049",
                                        "glosses": [
                                            "ethische stroming die de morele waarde van een handeling afmeet aan de bijdrage die deze handeling levert aan het welzijn en geluk van alle mensen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1766528-462a-4479-b4ac-12e38cc84789",
                                                "sense_id": "ca700245-e99f-347a-bce6-a9c8312c1c13",
