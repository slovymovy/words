                                            {
                                                "example_id": "62b7b6a9-7154-4392-ac96-9cf90c32ee4a",
                                                "sense_id": "c32096c3-fb75-38d1-bf5e-4a813a1d86de",
                                                "text": "I was his affair and he was a little boy toy to me... Together it was our little scandal."
                                            },
                                            {
                                                "example_id": "eaa1ca2b-f16f-4d31-be36-9a73a3015568",
                                                "sense_id": "c32096c3-fb75-38d1-bf5e-4a813a1d86de",
                                                "text": "Turns out she's married; he was her affair."
                                            },
                                            {
                                                "example_id": "410d32d7-8a29-409a-b795-b9f81b080444",
                                                "sense_id": "c32096c3-fb75-38d1-bf5e-4a813a1d86de",
                                                "text": "Even though my husband forgave me and gave me another chance, I still continue to see my affair."
                                            },
