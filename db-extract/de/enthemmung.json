                                "example_id": "e8b85ee9-6bfc-485d-a78b-10d28e0c9654",
                                "sense_id": "9ab814a5-066b-39be-88e1-3b31e1d55ac0",
                                "text": "Die zunehmende Enthemmung beim Konsumieren von Alkohol birgt nicht nur Gefahren für Leib und Leben, sondern setzt überdies die Hemmschwelle für die Begehung von Straftaten herab."
                            },
                            {
                                "example_id": "cee8d9c9-8557-4735-adb3-451863fa5073",
                                "sense_id": "9ab814a5-066b-39be-88e1-3b31e1d55ac0",
                                "text": "Therapeutische Ansätze zielen oftmals auf Enthemmung bei Phobien, insbesondere in zwischenmenschlichen Interaktionen, ab."
                            }
                        ],
                        "sense_index_json": "\"1\""
