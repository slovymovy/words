                {
                    "sense_id": "740fd841-f450-39bf-b3d7-4a9f1c09b408",
                    "sense_definition": "In een reeks door niets meer gevolgd worden.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "last_final",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>laatste</w> deelnemer had veel meer tijd nodig dan de eerste.",
                            "target_lang_translations": {
                                "ru": "<w>Последнему</w> участнику потребовалось гораздо больше времени, чем первому.",
                                "en": "The <w>last</w> participant needed much more time than the first.",
                                "pl": "<w>Ostatni</w> uczestnik potrzebował znacznie więcej czasu niż pierwszy.",
                                "de": "Der <w>letzte</w> Teilnehmer brauchte viel mehr Zeit als der erste.",
                                "fr": "Le <w>dernier</w> participant a eu besoin de beaucoup plus de temps que le premier.",
                                "it": "L'<w>ultimo</w> partecipante ha avuto bisogno di molto più tempo rispetto al primo.",
                                "cs": "<w>Poslední</w> účastník potřeboval mnohem více času než ten první.",
                                "tr": "<w>Son</w> katılımcının birinciden çok daha fazla zamana ihtiyacı vardı.",
                                "es": "El <w>último</w> participante necesitó mucho más tiempo que el primero."
                            }
                        },
                        {
                            "text": "Dit zou toch niet mijn <w>laatste</w> nacht op aarde worden?",
                            "target_lang_translations": {
                                "ru": "Неужели это будет моя <w>последняя</w> ночь на земле?",
                                "en": "Surely this wouldn't be my <w>last</w> night on earth?",
                                "pl": "To chyba nie będzie moja <w>ostatnia</w> noc na ziemi?",
                                "de": "Das würde doch nicht meine <w>letzte</w> Nacht auf Erden werden?",
                                "fr": "Ce ne serait tout de même pas ma <w>dernière</w> nuit sur terre ?",
                                "it": "Questa non sarebbe stata la mia <w>ultima</w> notte sulla terra, vero?",
                                "cs": "Tohle snad nebude moje <w>poslední</w> noc na zemi?",
                                "tr": "Bu dünyadaki <w>son</w> gecem olmayacaktı, değil mi?",
                                "es": "¿Acaso esta no iba a ser mi <w>última</w> noche en la tierra?"
                            }
                        }
                    ],
                    "antonyms": [
                        "eerste"
                    ],
                    "common_phrases": [
                        "de laatste keer",
                        "de laatste dag",
                        "de laatste loodjes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в самом конце ряда; такой, за которым больше ничего не следует.",
                        "en": "Coming at the end of a series; not followed by anything else.",
                        "pl": "Będący na końcu serii, po którym nic już nie następuje.",
                        "de": "Am Ende einer Reihe stehend; so, dass nichts mehr folgt.",
                        "fr": "Qui se trouve à la fin d'une série, après lequel il n'y a plus rien.",
                        "it": "Che si trova alla fine di una serie; non seguito da nient'altro.",
                        "cs": "Být na konci řady, za nímž už nic dalšího nenásleduje.",
                        "tr": "Bir serinin sonunda yer alan, arkasından başka hiçbir şey gelmeyen.",
                        "es": "Que en una serie no tiene otra cosa que le siga."
                    },
