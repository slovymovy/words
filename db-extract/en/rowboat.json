                    {
                        "translation_id": "37d9e68e-891d-4f28-b4f6-d01d228b358b",
                        "source_entry_id": "f7ae582d-97d1-3a2a-832d-0e24e294ab53",
                        "source_sense_id": "9b2663a6-9790-3238-91e6-64bd8abff296",
                        "source_sense_description": "small boat that is rowed",
                        "target_lang_word": "bateau à rames",
                        "target_lang_code": "fr",
