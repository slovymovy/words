                    },
                    {
                        "sense_id": "bf17086e-ab61-3623-8753-a11b156993e6",
                        "entry_id": "3f393672-af1c-325e-8928-8798c60409bd",
                        "glosses": [
                            "Machine qui réalise le travail du buttage."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4c7e866e-d715-49cf-80bf-11de4dc5944d",
                                "sense_id": "bf17086e-ab61-3623-8753-a11b156993e6",
                                "text": "Le bâti de cette charrue permet toutes les transformations : on peut y adapter notamment un corps de butteur, de tourne-oreille, de bisoc, d’arrache pommes de terre, de ratisseuse, ce qui permet au petit propriétaire de se procurer un outillage complet à peu de frais."
                            },
                            {
                                "example_id": "6d8522de-daf4-4628-ab53-cdeca93eca9f",
                                "sense_id": "bf17086e-ab61-3623-8753-a11b156993e6",
                                "text": "On doit à André Grusenmeyer l’invention de la batteuse (Dreschmaschine), du manège, de la charrue-butteur et d’autres machines."
                            }
                        ]
                    }
