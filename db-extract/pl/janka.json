                "senses": [
                    {
                        "sense_id": "98c8102a-3a4a-3cfe-9d09-9fa1fdf5778a",
                        "entry_id": "94e2a46d-94fd-3c5c-bee5-0c565dcf3b47",
                        "glosses": [
                            "imię żeńskie Janina"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "f9234113-84c9-45e1-92e3-3b4e750c48f7",
                                "sense_id": "98c8102a-3a4a-3cfe-9d09-9fa1fdf5778a",
                                "text": "Na głowie Janki było mnóstwo rzeczy: biegała na wykłady, pracowała i opiekowała się chorą sąsiadką."
                            },
                            {
                                "example_id": "27291a91-93df-4c35-aa39-74c51fc2f609",
                                "sense_id": "98c8102a-3a4a-3cfe-9d09-9fa1fdf5778a",
                                "text": "Janka wiedziała, do czego to wszystko zmierza, więc zbyt do serca nie brała drwin Meli ani pedantycznych informacji reżysera"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
