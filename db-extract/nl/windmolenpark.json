                ],
                "senses": [
                    {
                        "sense_id": "8c00b134-45be-3a05-b161-a536fedc3ecd",
                        "entry_id": "72dd24db-5930-337d-b7b3-fab53d6f17e3",
                        "glosses": [
                            "een gebied waar windenergie gewonnen wordt met behulp van een aantal molens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "103bf00e-d315-4687-ae3f-838a92afb2c0",
                                "sense_id": "8c00b134-45be-3a05-b161-a536fedc3ecd",
                                "text": "Er zijn plannen voor een groot windmolenpark op de Doggersbank."
                            },
                            {
                                "example_id": "611ccb69-497e-4988-a4c7-6ccb27c7d918",
                                "sense_id": "8c00b134-45be-3a05-b161-a536fedc3ecd",
                                "text": "Nederland en België hebben na enkele jaren overleg een akkoord bereikt over de scheepvaartroutes op de Noordzee. Commerciële schepen zullen voortaan om de windmolenparken van beide landen heen moeten varen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a02f72a-dadf-4386-ba93-d168e4ed2c7d",
                        "source_entry_id": "72dd24db-5930-337d-b7b3-fab53d6f17e3",
                        "source_sense_id": "8c00b134-45be-3a05-b161-a536fedc3ecd",
                        "source_sense_description": "een gebied waar windenergie gewonnen wordt met behulp van een aantal molens",
                        "target_lang_word": "Windpark",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Windpark",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95c3d3e7-02c8-364a-af3b-26a1eb3855a3",
                                        "entry_id": "cf7db544-7e92-34fb-9368-6c729e29b073",
                                        "glosses": [
                                            "Bereich mit mehreren Windkraftanlagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1325e1e8-1392-4e22-82f6-f58a6d8f7f45",
                                                "sense_id": "95c3d3e7-02c8-364a-af3b-26a1eb3855a3",
                                                "text": "„Um einen Windpark vor der deutschen Küste zu bauen und ans Stromnetz anzuschließen, seien 40 Genehmigungsverfahren erforderlich.“"
                                            },
                                            {
                                                "example_id": "fcde377b-dc19-4db2-8729-ccff51741be6",
                                                "sense_id": "95c3d3e7-02c8-364a-af3b-26a1eb3855a3",
                                                "text": "„Bereits heute sind in der Nordsee 28 Windparks mit etwa neun Gigawatt Leistung genehmigt.“"
                                            },
                                            {
                                                "example_id": "30e2eafb-74d2-4f9b-967e-b8f60d187824",
                                                "sense_id": "95c3d3e7-02c8-364a-af3b-26a1eb3855a3",
                                                "text": "„Sachsen […] hat nur 0,2 Prozent der Landesfläche für Windparks freigegeben, und in Bayern sind sogar nur 0,1 Prozent.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6934664c-3023-4580-ac9e-857d02731111",
                        "source_entry_id": "72dd24db-5930-337d-b7b3-fab53d6f17e3",
                        "source_sense_id": "8c00b134-45be-3a05-b161-a536fedc3ecd",
                        "source_sense_description": "een gebied waar windenergie gewonnen wordt met behulp van een aantal molens",
                        "target_lang_word": "wind farm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wind farm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00df569e-b1c3-31f5-8a98-29500069eb37",
                                        "entry_id": "645f59ca-edec-3699-a6cd-224f980c8279",
                                        "glosses": [
                                            "A collection of wind turbines, especially a large-scale array, used to generate electricity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31c9733e-a311-4cff-98f2-0136832a3294",
                                                "sense_id": "00df569e-b1c3-31f5-8a98-29500069eb37",
                                                "text": "Then roughly 176 wind generators of 1.8 megawatts each would be located at each wind farm affecting an area of 15 × 176 or 2640 acres (4.1 sq mi) but directly using only about 176 acres (0.3 sq mi)."
                                            },
                                            {
                                                "example_id": "ddce4271-c343-41a1-97ec-5b640dc5a5e6",
                                                "sense_id": "00df569e-b1c3-31f5-8a98-29500069eb37",
                                                "text": "The windy weather last weekend set a new renewable power record and resulted in some households being paid to charge their electric cars to help balance the grid. Wind farms in Britain generated more than 16 gigawatts of power for the first time on Sunday evening."
                                            },
                                            {
                                                "example_id": "eefb6f19-efb0-4c1c-8405-85ccd93934f3",
                                                "sense_id": "00df569e-b1c3-31f5-8a98-29500069eb37",
                                                "text": "\"If you measure behind a wind turbine, the wind is blowing less hard,\" say Remco Verzijlbergh from Dutch weather service Whiffle. Geography means that this phenomenon, known as wind shadow, benefits Belgian wind farms in the North Sea."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac9247b9-429f-41c4-adc9-7e6356e54758",
                        "source_entry_id": "72dd24db-5930-337d-b7b3-fab53d6f17e3",
                        "source_sense_id": "8c00b134-45be-3a05-b161-a536fedc3ecd",
                        "source_sense_description": "een gebied waar windenergie gewonnen wordt met behulp van een aantal molens",
                        "target_lang_word": "parc éolien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parc éolien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b28eea2-398f-30a4-a239-fd371f53199f",
                                        "entry_id": "e600c988-448d-344c-9a59-59e9a7c10100",
                                        "glosses": [
                                            "Site regroupant plusieurs éoliennes produisant de l’électricité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15eb1b62-eccf-4468-b0dc-90fabc15f6e6",
                                                "sense_id": "2b28eea2-398f-30a4-a239-fd371f53199f",
                                                "text": "Une fois que tous nos gisements de négawatts auront été exploités, alors allons-y avec des parcs éoliens là où les gens en voudront vraiment."
                                            },
                                            {
                                                "example_id": "029ccacf-1c9f-4059-93d8-7e7b971581fd",
                                                "sense_id": "2b28eea2-398f-30a4-a239-fd371f53199f",
                                                "text": "En réalité, rien n’a été « trouvé », car des groupes électrogènes de secours existent dans tous les parcs éoliens. L’utilisation de ces groupes de secours fonctionnant au diesel, en décembre 2022 dans trois parcs éoliens en Écosse, révélée par le Sunday Mail, est montée en épingle pour servir un discours anti-éolien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
