                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a4b1594e-e6a3-4126-9b8a-a26a12a69e1f",
                        "entry_id": "6dbe3dd8-9d7d-39d5-a6ae-7ae9823d977e",
                        "tags": [
