            "senses": [
                {
                    "sense_id": "6a0db8ec-8b5a-3cae-9b58-fa91d755ebec",
                    "sense_definition": "Tracer les premiers traits ou les grandes lignes d'un dessin, d'une peinture ou d'une sculpture.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "art_dessin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste a commencé par <w>esquisser</w> la silhouette du modèle sur sa toile avant d'ajouter les couleurs."
                        },
                        {
                            "text": "Il préférait d'abord <w>esquisser</w> un dessin au fusain pour vérifier les proportions générales."
                        }
                    ],
                    "synonyms": [
                        "ébaucher",
                        "croquer"
                    ],
                    "antonyms": [
                        "achever",
                        "peaufiner"
                    ],
                    "common_phrases": [
                        "esquisser un portrait",
                        "esquisser un dessin"
                    ]
                },
                {
                    "sense_id": "31a3f114-cf36-35b4-b31a-73cea76dc634",
                    "sense_definition": "Commencer légèrement une action, un mouvement, ou présenter les grandes lignes d'un projet sans le développer complètement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ebauche_geste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a fini par <w>esquisser</w> un sourire timide en écoutant l'histoire amusante de son ami."
                        },
                        {
                            "text": "Le ministre a rapidement <w>esquissé</w> les réformes économiques prévues pour l'année prochaine."
                        }
                    ],
                    "synonyms": [
                        "ébaucher",
                        "amorcer"
                    ],
                    "antonyms": [
                        "conclure",
                        "développer"
                    ],
                    "common_phrases": [
                        "esquisser un sourire",
                        "esquisser un geste",
                        "esquisser un mouvement"
                    ]
                }
            ]
        }
    ]
