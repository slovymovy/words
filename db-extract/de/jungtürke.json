                                        "entry_id": "46ccc855-9a02-3432-ab51-45c4da31852e",
                                        "glosses": [
                                            "A young person who agitates for political or other reform; a young person with a rebellious disposition."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "961fff11-6078-4a7b-bddf-3a8308d88888",
                                                "sense_id": "a3eba917-1c25-3138-9521-a9791d1d42ea",
                                                "text": "\"What! Roscoe?\" inquired the principal.\n\"Yes.\"\n\"Is he in any mischief?\"\n\"Mischief? I should say so! Why, he's a regular young Turk.\"\n\"A young Turk? I don't think I understand you, James.\"\n\"I mean, he's a young ruffian.\""
                                            },
                                            {
                                                "example_id": "21b9a919-82dd-4238-9f0c-e2cf43ae4483",
                                                "sense_id": "a3eba917-1c25-3138-9521-a9791d1d42ea",
                                                "text": "He arrives at a time when jazz's discontented Young Turks have disdainfully turned away from their audiences and gone off to explore the way-out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
