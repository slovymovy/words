{
    "word_family": [
        "coughing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e086a060-7082-33e5-9fee-89b3a3b45c53",
                    "sense_definition": "A sudden, noisy expulsion of air from the lungs through the mouth, often to clear the throat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "act_of_coughing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Behind me, I heard a distinct, dry <w>cough</w>.",
                            "target_lang_translations": {
                                "ru": "Позади себя я услышал отчетливый сухой <w>кашель</w>.",
                                "zh": "我身后传来一声清晰而干涩的<w>咳嗽</w>。"
                            }
                        },
                        {
                            "text": "He gave a polite <w>cough</w> to attract her attention.",
                            "target_lang_translations": {
                                "ru": "Он вежливо <w>кашлянул</w>, чтобы привлечь её внимание.",
                                "zh": "他礼貌地<w>咳</w>了一声以引起她的注意。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "loud cough",
                        "dry cough"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный, шумный выброс воздуха из легких через рот, часто для прочистки горла.",
                        "zh": "一种突然的、嘈杂的从肺部经由口腔排气的动作，通常是为了清理喉咙。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кашель",
                                "target_lang_sense_clarification": "физиологический акт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "咳嗽",
                                "target_lang_sense_clarification": "生理动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "feddaaae-b298-3a2b-a6c7-8325999d3c5b",
                    "sense_definition": "A medical condition or illness that causes a person to cough frequently.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "medical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot come to work today because I have a nasty <w>cough</w>.",
                            "target_lang_translations": {
                                "ru": "Я не могу прийти сегодня на работу, потому что у меня сильный <w>кашель</w>.",
                                "zh": "我今天不能去上班，因为我<w>咳嗽</w>得很厉害。"
                            }
                        },
                        {
                            "text": "She went to the doctor to get some medicine for her persistent <w>cough</w>.",
                            "target_lang_translations": {
                                "ru": "Она пошла к врачу за лекарством от постоянного <w>кашля</w>.",
                                "zh": "她去看医生，想为她持续不断的<w>咳嗽</w>开些药。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bad cough",
                        "nasty cough",
                        "whooping cough"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинское состояние или заболевание, вызывающее частый кашель.",
                        "zh": "一种导致人频繁咳嗽的疾病或身体状况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кашель",
                                "target_lang_sense_clarification": "болезнь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "咳嗽",
                                "target_lang_sense_clarification": "病症"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "637a2255-751e-374b-a3fd-fb7193adcf9f",
                    "sense_definition": "A noise or sound that resembles a human cough.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound_metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We heard the sudden <w>cough</w> of a distant engine starting up.",
                            "target_lang_translations": {
                                "ru": "Мы услышали внезапный <w>кашель</w> запускающегося вдалеке двигателя.",
                                "zh": "我们听见远处引擎启动时发出的突然的<w>咳嗽声</w>。"
                            }
                        },
                        {
                            "text": "The machine made a strange <w>cough</w> before it stopped working.",
                            "target_lang_translations": {
                                "ru": "Машина издала странный <w>кашель</w>, прежде чем сломалась.",
                                "zh": "机器在停止工作前发出了一声奇怪的<w>咳嗽声</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шум или звук, напоминающий человеческий кашель.",
                        "zh": "类似于人类咳嗽的噪音或声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кашель",
                                "target_lang_sense_clarification": "метафора"
                            },
                            {
                                "target_lang_word": "чихание",
                                "target_lang_sense_clarification": "о механизмах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "咳嗽声",
                                "target_lang_sense_clarification": "比喻用法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "626db2db-94e2-32d9-8506-f0b19aab05b0",
                    "sense_definition": "To push air suddenly and noisily out of the lungs through the mouth, usually to clear the throat or due to illness.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action_intransitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I breathed in some smoke by mistake and started to <w>cough</w>.",
                            "target_lang_translations": {
                                "ru": "Я случайно вдохнул дым и начал <w>кашлять</w>.",
                                "zh": "我不小心吸入了一些烟，开始<w>咳嗽</w>起来。"
                            }
                        },
                        {
                            "text": "Please cover your mouth when you <w>cough</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, прикрывайте рот, когда <w>кашляете</w>.",
                                "zh": "请在<w>咳嗽</w>时遮住嘴。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cough loudly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко и шумно выталкивать воздух из легких через рот, обычно чтобы прочистить горло или из-за болезни.",
                        "zh": "突然且嘈杂地从肺部经由口腔排出空气，通常是为了清理喉咙或因生病所致。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кашлять",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "кашлянуть",
                                "target_lang_sense_clarification": "однократно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "咳嗽",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "咳",
                                "target_lang_sense_clarification": "短促的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de94863d-038f-30e8-9c4f-4ed76a965351",
                    "sense_definition": "To force something out of the throat or lungs by coughing; often used with 'up'.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_transitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient <w>coughed</w> up blood before the doctors arrived.",
                            "target_lang_translations": {
                                "ru": "Пациент <w>откашливал</w> кровь до прибытия врачей.",
                                "zh": "医生到达之前，病人<w>咳出</w>了血。"
                            }
                        },
                        {
                            "text": "He <w>coughed</w> up a piece of food that was stuck in his throat.",
                            "target_lang_translations": {
                                "ru": "Он <w>откашлял</w> кусочек еды, застрявший в горле.",
                                "zh": "他<w>咳出</w>了一块卡在喉咙里的食物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cough up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выталкивать что-либо из горла или легких кашлем; часто используется с 'up'.",
                        "zh": "通过咳嗽将某物从喉咙或肺部排出；常与“up”连用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откашливать",
                                "target_lang_sense_clarification": "выделять кашлем"
                            },
                            {
                                "target_lang_word": "отхаркивать",
                                "target_lang_sense_clarification": "грубее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "咳出",
                                "target_lang_sense_clarification": "排出异物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a2ba935-7517-38a3-9bab-90d9d70267f5",
                    "sense_definition": "To make a sudden, harsh noise like a cough, often indicating a mechanical problem.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "machine_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old engine <w>coughed</w> and sputtered before finally starting.",
                            "target_lang_translations": {
                                "ru": "Старый двигатель <w>чихнул</w> и зафыркал, прежде чем наконец завестись.",
                                "zh": "那台旧引擎在最终启动前<w>咳嗽</w>并喷溅着火花。"
                            }
                        },
                        {
                            "text": "Our car <w>coughed</w> loudly as we drove up the steep hill.",
                            "target_lang_translations": {
                                "ru": "Наша машина громко <w>чихала</w>, пока мы взбирались на крутой холм.",
                                "zh": "当我们开车上陡坡时，我们的车大声地<w>咳嗽</w>着。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать резкий, грубый звук, похожий на кашель, часто указывающий на механическую проблему.",
                        "zh": "发出类似咳嗽的突然、刺耳的声音，通常表示机械故障。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чихать",
                                "target_lang_sense_clarification": "о моторе"
                            },
                            {
                                "target_lang_word": "кашлять",
                                "target_lang_sense_clarification": "метафора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发出咳嗽声",
                                "target_lang_sense_clarification": "形容机器声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "918415ba-c1fc-3201-b04f-23ddbd4d2901",
                    "sense_definition": "To give something, especially money, unwillingly; usually used with 'up'.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang_pay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>cough</w> up a lot of money to pay for the damages.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>отстегнуть</w> кучу денег, чтобы оплатить ущерб.",
                                "zh": "为了赔偿损失，他不得不<w>掏出</w>一大笔钱。"
                            }
                        },
                        {
                            "text": "I hope they <w>cough</w> up the cash they owe us soon.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, они скоро <w>отстегнут</w> наличные, которые нам должны.",
                                "zh": "我希望他们能尽快<w>掏出</w>欠我们的钱。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cough up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдавать что-либо, особенно деньги, неохотно; обычно используется с 'up'.",
                        "zh": "不情愿地交出某物，尤指金钱；通常与“up”连用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отстегивать",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "раскошеливаться",
                                "target_lang_sense_clarification": "тратить деньги"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掏出",
                                "target_lang_sense_clarification": "不情愿地支付"
                            },
                            {
                                "target_lang_word": "被迫支付",
                                "target_lang_sense_clarification": "口语用法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "48916752-0d4d-3b0c-9ca5-77d81ce7f552",
                    "sense_definition": "Used to represent the sound of a cough, often to get attention, express disapproval, or signal a euphemism.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "interjection_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was, <w>cough</w>, indisposed and could not attend the meeting.",
                            "target_lang_translations": {
                                "ru": "Он был, <w>кхм</w>, нездоров и не мог присутствовать на встрече.",
                                "zh": "他，<w>咳咳</w>，身体不适，无法参加会议。"
                            }
                        },
                        {
                            "text": "<w>Cough</w>, I am still waiting for an answer to my question.",
                            "target_lang_translations": {
                                "ru": "<w>Кхм</w>, я всё ещё жду ответа на свой вопрос.",
                                "zh": "<w>咳咳</w>，我还在等我的问题得到回答。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ahem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для обозначения звука кашля, часто для привлечения внимания, выражения неодобрения или как сигнал эвфемизма.",
                        "zh": "用于模拟咳嗽的声音，常用于引起注意、表达不赞同或作为委婉语的信号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кхм",
                                "target_lang_sense_clarification": "звукоподражание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "咳咳",
                                "target_lang_sense_clarification": "拟声词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}