                                "example_id": "0032cfdb-157b-4e6d-96c9-794bdd98e506",
                                "sense_id": "1e342c86-567d-3db4-8567-3373d08f973d",
                                "text": "Mount and Blade, любимый миллионами игроков, — это махровая индюшатина."
                            },
