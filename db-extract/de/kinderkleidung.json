                "senses": [
                    {
                        "sense_id": "0da25dab-cc32-360e-902e-f3d97f816ef6",
                        "entry_id": "39307bf1-590d-3296-b8cd-b14c20e14f56",
                        "glosses": [
                            "für Menschen geringen Alters geeignete Kleidung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "282ce4a9-4bdb-4c1b-bb27-17edfebf26b4",
                                "sense_id": "0da25dab-cc32-360e-902e-f3d97f816ef6",
                                "text": "„1945 boten die Tschechen meiner Mutter an, ihr die Wiedereröffnung ihres kleinen Geschäfts für Kinderkleidung zu erlauben, wenn sie ihre Kinder in die tschechische Schule schickte.“"
                            },
                            {
                                "example_id": "c1cc0102-01e5-4123-a578-80a3338dbd2d",
                                "sense_id": "0da25dab-cc32-360e-902e-f3d97f816ef6",
                                "text": "„Er enthielt die Kinderkleidung meiner Brüder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
