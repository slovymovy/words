                                                "sense_id": "d7d08262-0a0f-3604-b9e4-1894431014c5",
                                                "text": "Statt Acetylsalicylsäure wählte man als Markennamen die klangvollere Bezeichnung „Aspirin“."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a0a8cbba-5320-3005-9477-12363f0e600d",
                                        "entry_id": "ee6a82ce-07c7-33db-8172-e189c0b866e5",
                                        "glosses": [
                                            "(übertragen) von gutem Ruf, von großem Renommee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d019b52-9fbc-4b86-aeb9-3c890ffa770d",
                                                "sense_id": "a0a8cbba-5320-3005-9477-12363f0e600d",
                                                "text": "ein klangvoller Name in der Welt des Weinbaus"
                                            },
                                            {
                                                "example_id": "578a93a6-848b-419f-9880-d8f2e2355c59",
                                                "sense_id": "a0a8cbba-5320-3005-9477-12363f0e600d",
                                                "text": "„Mit klangvollen Namen will der Klub seine Ambitionen unterstreichen, die hoch sein müssen – man ist ja nicht irgendwer, sondern Fenerbahçe, 28-maliger türkischer Meister, sechsmaliger Pokalsieger.“"
                                            }
                                        ],
