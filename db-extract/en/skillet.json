                    {
                        "translation_id": "94fb4b8f-acf9-4b9b-abd0-673412c97842",
                        "source_entry_id": "212a98a2-3fe8-3ea2-91ab-612256696f16",
                        "source_sense_description": "dish or meal cooked in such a pan",
                        "target_lang_word": "Pfanne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pfanne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "770e9773-579a-3561-bf0d-867e14a3d60b",
                                        "entry_id": "ba2f62a3-b7bd-3fe8-87a8-37c1382c1483",
                                        "glosses": [
                                            "flaches Gefäß zum Braten auf dem Herd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "483ecb1b-cff6-468e-9f47-2b3b95ea1aa8",
                                                "sense_id": "770e9773-579a-3561-bf0d-867e14a3d60b",
                                                "text": "Man kann Eier in der Pfanne braten."
                                            },
                                            {
                                                "example_id": "38338a31-73c4-4396-8e96-8cd2f5fdd263",
                                                "sense_id": "770e9773-579a-3561-bf0d-867e14a3d60b",
                                                "text": "„Mit einer riesigen Pfanne in der Hand wandert er in der Küche herum.“"
                                            },
                                            {
                                                "example_id": "d154b9ec-a666-4dff-99b4-b959143f2edc",
                                                "sense_id": "770e9773-579a-3561-bf0d-867e14a3d60b",
                                                "text": "„Die Küche glänzt, Licht strahlt aus den Kochtöpfen, eine Pfanne zischt, und es riecht gut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "23e29334-d353-3812-a31a-9fe8a9c01dc8",
                                        "entry_id": "ba2f62a3-b7bd-3fe8-87a8-37c1382c1483",
                                        "glosses": [
                                            "auch Kochgeschirr mit hohem Rand (und Stiel)"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b74f86b-50bb-49e4-b841-dc52cb98c557",
                                                "sense_id": "23e29334-d353-3812-a31a-9fe8a9c01dc8",
                                                "text": "„Die Kumquats waschen, in die Pfanne geben, mit Wasser bedecken und 30 Minuten kochen lassen.“"
                                            },
                                            {
                                                "example_id": "1254dd75-d38a-4871-8e61-53030f665617",
                                                "sense_id": "23e29334-d353-3812-a31a-9fe8a9c01dc8",
                                                "text": "„Tiefgekühlte Gemüse […] direkt aus der Verpackung in die Pfanne geben […] Die Kochzeit ist etwas kürzer zu bemessen.“"
                                            },
                                            {
                                                "example_id": "c8e3f766-b281-45db-a017-c29d3dd11440",
                                                "sense_id": "23e29334-d353-3812-a31a-9fe8a9c01dc8",
                                                "text": "„Sie […] goss die Milch nicht aus der Pfanne in die Tasse, sondern wählte den Umweg über einen Krug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ec9eb09e-c870-3b28-93f7-bc43af7113ec",
                                        "entry_id": "ba2f62a3-b7bd-3fe8-87a8-37c1382c1483",
                                        "glosses": [
                                            "Transportgefäß für flüssiges Metall oder Schlacke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab8d92a2-f710-4459-b434-77fac1cd6cee",
                                                "sense_id": "ec9eb09e-c870-3b28-93f7-bc43af7113ec",
                                                "text": "Selbst die speziell für diese Zwecke entwickelte Feuerfestauskleidung der Transportpfannen hält der hohen Beanspruchung durch die Stahlschmelze nicht dauerhaft stand. Ein vollautomatisches Sicherheitssystem auf Basis von Infrarot-Bildverarbeitung ist in der Lage, die Feuerfestauskleidung der Pfannen kontinuierlich zu überwachen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8668103b-6250-3c60-8272-e808e35c21ad",
                                        "entry_id": "ba2f62a3-b7bd-3fe8-87a8-37c1382c1483",
                                        "glosses": [
                                            "Dachpfanne, gewölbtes Einzelelement einer Dachbedeckung"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c96894eb-944e-46ee-b891-8e0eb8a8cfc2",
                                                "sense_id": "8668103b-6250-3c60-8272-e808e35c21ad",
                                                "text": "Es sieht schöner aus, wenn wir das Dach mit Pfannen decken."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a9c64606-26d5-39cd-8295-483a7bc48317",
                                        "entry_id": "ba2f62a3-b7bd-3fe8-87a8-37c1382c1483",
                                        "glosses": [
                                            "Gelenkpfanne, gewölbter Knochenteil, der einen anderen gewölbten Knochen aufnimmt"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aac1b5c-88ca-4ca8-bfd1-da0468c6f108",
                                                "sense_id": "a9c64606-26d5-39cd-8295-483a7bc48317",
                                                "text": "Die Patientin hatte große Schmerzen, weil der Gelenkkopf war aus der Pfanne gesprungen war."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "018d8bc9-3505-3dfe-b146-2cf8cc6417ff",
                                        "entry_id": "ba2f62a3-b7bd-3fe8-87a8-37c1382c1483",
                                        "glosses": [
                                            "der Teil eines Gewehrschlosses, auf den man bei älteren Gewehren das Pulver legte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e2535ad-fbc5-436b-83b9-66cdbbc70187",
                                                "sense_id": "018d8bc9-3505-3dfe-b146-2cf8cc6417ff",
                                                "text": "Erst muss man Pulver auf die Pfanne schütten und danach die Lunte anbringen."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "bd701cad-cbd6-38b7-a251-1b9fe4674aae",
