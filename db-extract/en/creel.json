                    {
                        "translation_id": "6e081057-37f5-44f4-9955-d0a118819483",
                        "source_entry_id": "1e4fffba-a96d-3dc4-b4d7-ee11f895707e",
                        "source_sense_description": "bar or set of bars with skewers for holding paying-off bobbins",
                        "target_lang_word": "Gatter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gatter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e760e5b7-3024-31ae-b388-2705a6f75539",
                                        "entry_id": "b8456df9-bbff-334e-bd84-c2dead5a3053",
                                        "glosses": [
                                            "Zaun, Abgrenzung aus (Holz-)Latten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f996553-045d-4620-8f9b-da38226d933e",
                                                "sense_id": "e760e5b7-3024-31ae-b388-2705a6f75539",
                                                "text": "Die Kinder klettern immer über das Gatter zum Nachbarn in den Garten."
                                            },
                                            {
                                                "example_id": "933fe9ce-b0a7-4b06-986a-b729d9b152dc",
                                                "sense_id": "e760e5b7-3024-31ae-b388-2705a6f75539",
                                                "text": "„Sie fuhren eine weitere Meile der Grenze von Doubting Hall entlang, die eine verfallene Mauer und tropfnasse Bäume erkennbar machten, bis sie zu ein paar Hütten und einem weißen Gatter kamen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "390a2036-9152-389f-aa5b-028892dd8fe7",
                                        "entry_id": "b8456df9-bbff-334e-bd84-c2dead5a3053",
                                        "glosses": [
                                            "Tor aus (Holz-)Latten, Tor mit einem Gitter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df4b777b-0fd8-4eb2-96d0-c5b86e61d4da",
                                                "sense_id": "390a2036-9152-389f-aa5b-028892dd8fe7",
                                                "text": "„Die Straße war sehr lang, und ehe wir den Ausgang erreichen konnten, sahen wir schon, daß man Miene machte, das Gatter von obenher herabzulassen.“"
                                            },
                                            {
                                                "example_id": "55d3e039-9ed3-4709-adcb-513d15044fe6",
                                                "sense_id": "390a2036-9152-389f-aa5b-028892dd8fe7",
                                                "text": "Von dort aus watet man noch 15 Minuten über eine schlammige Wiese, überquert auf Baumstämmen drei Bachläufe, geht durch ein Gatter und steht im Kokafeld."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
