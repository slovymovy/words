                "senses": [
                    {
                        "sense_id": "59158675-48d0-3386-b1d2-37585c359166",
                        "entry_id": "7124bfb9-db5c-3dd1-9eae-083f40097403",
                        "glosses": [
                            "eerder dan gewoonlijk; eerder dan de bedoeling was"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89b260ec-28c4-4f3b-a4e2-544511f73e60",
                                "sense_id": "59158675-48d0-3386-b1d2-37585c359166",
                                "text": "Hierdoor moest hij al na een aantal dagen vroegtijdig de trail verlaten om te rusten en zijn voet te laten helen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a71e095e-a8c3-41c4-8d8d-8d6e7c537246",
                        "source_entry_id": "7124bfb9-db5c-3dd1-9eae-083f40097403",
                        "source_sense_id": "59158675-48d0-3386-b1d2-37585c359166",
                        "target_lang_word": "early",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "early",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7376da0-430a-37bf-b1b1-4d45bf502a35",
                                        "entry_id": "158048c0-db42-3cc1-b907-cfc03304054b",
                                        "glosses": [
                                            "At a time in advance of the usual or expected event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03a75f4e-ef92-43a6-805b-37a5aaddebb2",
                                                "sense_id": "e7376da0-430a-37bf-b1b1-4d45bf502a35",
                                                "text": "at eleven, we went for an early lunch; she began reading at an early age; his mother suffered an early death"
                                            },
                                            {
                                                "example_id": "8267f443-95f4-425e-9e9a-f4214f5ed925",
                                                "sense_id": "e7376da0-430a-37bf-b1b1-4d45bf502a35",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale. The early, intense onset of the monsoon on June 14th swelled rivers, washing away roads, bridges, hotels and even whole villages. Rock-filled torrents smashed vehicles and homes, burying victims under rubble and sludge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "258f5c23-54d1-3d9f-a781-df7503396be8",
                                        "entry_id": "158048c0-db42-3cc1-b907-cfc03304054b",
                                        "glosses": [
                                            "Arriving a time before expected; sooner than on time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "799db698-b2e8-4eec-b5ed-aef5e533689b",
                                                "sense_id": "258f5c23-54d1-3d9f-a781-df7503396be8",
                                                "text": "You're early today! I don't usually see you before nine o'clock."
                                            },
                                            {
                                                "example_id": "a216f350-e7ff-419c-9d8f-11e0552ff4d5",
                                                "sense_id": "258f5c23-54d1-3d9f-a781-df7503396be8",
                                                "text": "The early guests sipped their punch and avoided each other's eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47c6a076-43fe-367c-bfd8-42093909a58f",
                                        "entry_id": "158048c0-db42-3cc1-b907-cfc03304054b",
                                        "glosses": [
                                            "After but close to the start of a period of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66b63051-cb22-4b29-90d7-5ab9a62cd667",
                                                "sense_id": "47c6a076-43fe-367c-bfd8-42093909a58f",
                                                "text": "The play \"Two Gentlemen of Verona\" is one of Shakespeare's early works."
                                            },
                                            {
                                                "example_id": "63c559d4-a50a-4d48-b842-0fbd08916b93",
                                                "sense_id": "47c6a076-43fe-367c-bfd8-42093909a58f",
                                                "text": "Early results showed their winning 245 out of 300 seats in parliament. The main opponent locked up only 31 seats."
                                            },
                                            {
                                                "example_id": "c944a0f6-0dc7-40d8-a1a9-8f89699477a9",
                                                "sense_id": "47c6a076-43fe-367c-bfd8-42093909a58f",
                                                "text": "'Twas early June, the new grass was flourishing everywheres, the posies in the yard—peonies and such—in full bloom, the sun was shining, and the water of the bay was blue, with light green streaks where the shoal showed."
                                            },
                                            {
                                                "example_id": "8f801318-f310-4174-88c3-eb8cb100b6bf",
                                                "sense_id": "47c6a076-43fe-367c-bfd8-42093909a58f",
                                                "text": "Dotcom mania was slow in coming to higher education, but now it has the venerable industry firmly in its grip. Since the launch early last year of Udacity and Coursera, two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations."
                                            },
                                            {
                                                "example_id": "7079ddd5-0082-41d3-adf7-972549b6aed3",
                                                "sense_id": "47c6a076-43fe-367c-bfd8-42093909a58f",
                                                "text": "It’s one of the earliest pieces in the comprehensive collection of metronomes by the British instrument dealer Tony Bingham, which forms the bulk of the Basel exhibition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb9e180b-78f2-3534-acc1-04bda38fc816",
                                        "entry_id": "158048c0-db42-3cc1-b907-cfc03304054b",
                                        "glosses": [
                                            "In the starting hours of the day."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a292df6a-5316-4597-8e17-63b0a401f10b",
                                                "sense_id": "cb9e180b-78f2-3534-acc1-04bda38fc816",
                                                "text": "It's too early for this sort of thing. I'm not awake yet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ff672f1-feac-3e1f-ac8e-019d7e3519d1",
                                        "entry_id": "158048c0-db42-3cc1-b907-cfc03304054b",
                                        "glosses": [
                                            "Having begun to occur; in its early stages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daa00384-2951-4fa8-affe-4ba85877f928",
                                                "sense_id": "5ff672f1-feac-3e1f-ac8e-019d7e3519d1",
                                                "text": "early cancer"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aeca121-9166-3ffa-93c7-7e2fb605e7e6",
                                        "entry_id": "158048c0-db42-3cc1-b907-cfc03304054b",
                                        "glosses": [
                                            "Of a star or class of stars, hotter than the sun."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "early",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ec220a4-931b-3388-8520-decaa01d0d8a",
                                        "entry_id": "ae65a64c-5620-3c3f-8c94-608f1f44b324",
                                        "glosses": [
                                            "A shift (scheduled work period) that takes place early in the day."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4fd7816-a6b6-4965-849c-02be72119686",
                                                "sense_id": "8ec220a4-931b-3388-8520-decaa01d0d8a",
                                                "text": "On my first day on the watch after leaving the shoplifting squad I paraded on earlies but had completely forgotten to take my ear ring off."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "early",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e16bdaa8-7dc7-34a7-adc4-aa78121a89bc",
                                        "entry_id": "adc90ca7-4a27-3fdd-bad5-848a7d117e99",
                                        "glosses": [
                                            "At a time before expected; sooner than usual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85c8236f-f099-4da9-9532-b76616fea826",
                                                "sense_id": "e16bdaa8-7dc7-34a7-adc4-aa78121a89bc",
                                                "text": "We finished the project an hour sooner than scheduled, so we left early."
                                            },
                                            {
                                                "example_id": "dc5a0cf3-ac9b-4279-9062-355240dd8d5e",
                                                "sense_id": "e16bdaa8-7dc7-34a7-adc4-aa78121a89bc",
                                                "text": "I had children too early (in life), so my first baby arrived early."
                                            },
                                            {
                                                "example_id": "e5639f5e-dc35-4ebb-bbb7-e428c02fc04f",
                                                "sense_id": "e16bdaa8-7dc7-34a7-adc4-aa78121a89bc",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or otherwise his man would be there with a message to say that his master would shortly join me if I would kindly wait."
                                            },
                                            {
                                                "example_id": "e2d6d7d0-9540-4d48-8a4b-f4543cfa44c5",
                                                "sense_id": "e16bdaa8-7dc7-34a7-adc4-aa78121a89bc",
                                                "text": "While warmer springs cause the early spider orchid to flower earlier in May, climate warming is also causing female bees to emerge from hibernation even earlier – confounding the orchid’s attempts to dupe the male bees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce00d225-a250-3bd2-a731-7e4c4979db6d",
                                        "entry_id": "adc90ca7-4a27-3fdd-bad5-848a7d117e99",
                                        "glosses": [
                                            "Soon; in good time; seasonably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10acd8b1-4c30-415c-b697-ff590355a135",
                                                "sense_id": "ce00d225-a250-3bd2-a731-7e4c4979db6d",
                                                "text": "[T]thoſe that ſeeke me early, ſhall find me."
                                            },
                                            {
