                                        "examples": [
                                            {
                                                "example_id": "a0dbaff4-89bc-44fc-923f-7f8cefc50614",
                                                "sense_id": "b716f05d-c16c-3841-8361-768900ad0400",
                                                "text": "Et que serait-il arrivé si Faruk n’avait pas raté le pénalty ? Oui, ce pénalty-là, le dernier pénalty de la Yougoslavie, le rideau qui tombe sur la fin de la pièce. Ça n'aurait rien changé."
                                            },
                                            {
                                                "example_id": "7a675532-cb46-4e82-94a5-35b0e91f19c7",
                                                "sense_id": "b716f05d-c16c-3841-8361-768900ad0400",
                                                "text": "Si Christophe Colomb avait calculé sa position avec une montre à quartz, il n’aurait pas raté les Indes mais il n’aurait pas non plus découvert l’Amérique. Donc exit l’aventure ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f500ae05-eadc-3494-84c4-aba576f85b63",
                                        "entry_id": "d07edd4e-d7e0-30d6-8f15-c09c56719a39",
                                        "glosses": [
                                            "Ne pas réussir dans une entreprise, dans une démarche, etc."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "282b1c5e-d4ad-4773-baa8-10a6fbe1c019",
                                                "sense_id": "f500ae05-eadc-3494-84c4-aba576f85b63",
                                                "text": "Il a raté cette place."
                                            },
                                            {
                                                "example_id": "077c018e-acae-4652-a025-3e9ebace10f7",
                                                "sense_id": "f500ae05-eadc-3494-84c4-aba576f85b63",
                                                "text": "Il a raté son effet, il a raté son coup."
                                            },
                                            {
                                                "example_id": "1f32de10-a1a7-4883-a4e8-a9b208c63ac6",
                                                "sense_id": "f500ae05-eadc-3494-84c4-aba576f85b63",
                                                "text": "Rater un train, une occasion, sa vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
