                "senses": [
                    {
                        "sense_id": "379fd126-0624-30b6-a1bd-10af349b742b",
                        "entry_id": "335a38b2-b277-3a5f-93ab-c2790e4f161e",
                        "glosses": [
                            "Qui flageole, qui chancelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a462756b-b2d0-4070-81e3-0c09d914c89a",
                                "sense_id": "379fd126-0624-30b6-a1bd-10af349b742b",
                                "text": "J’avais vu des gens sortir du café la figure enluminée et les jambes flageolantes."
                            },
                            {
                                "example_id": "03c598e7-59af-41a0-a333-91063f616c35",
                                "sense_id": "379fd126-0624-30b6-a1bd-10af349b742b",
                                "text": "Bon Dieu de bon Dieu ! Une sueur froide le fit chanceler sur ses jambes flageolantes comme si elles eussent été bourrées de coton."
                            },
                            {
                                "example_id": "a8b9b990-0e24-4b6d-8962-77d5daae83cc",
                                "sense_id": "379fd126-0624-30b6-a1bd-10af349b742b",
                                "text": "Tous les moyens sont bons pour appâter le mâle barbare et lui faire refermer « L’Équipe » : lui acheter des livres sur le foot ou le vélo, voire des coquinades érotiques, nouveau Viagra culturel, pour raffermir sa culture flageolante."
                            }
                        ]
                    }
