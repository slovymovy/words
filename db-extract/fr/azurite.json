        "fr-extract.jsonl": [
            {
                "entry_id": "9e8f98f8-327a-3990-b13a-cfe95b5288d7",
                "word": "azurite",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "027b77cc-c247-4f1d-af7a-c838b7913055",
                        "entry_id": "9e8f98f8-327a-3990-b13a-cfe95b5288d7",
                        "tags": [
                            "plural"
                        ],
                        "form": "azurites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1eadd1b1-8a5b-3045-8840-eed090581543",
                        "entry_id": "9e8f98f8-327a-3990-b13a-cfe95b5288d7",
                        "glosses": [
                            "Minéral de couleur bleue composé à l’état naturel de carbonate de cuivre, de formule Cu₃(CO₃)₂(OH)₂, et servant de minerai de cuivre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2face427-b997-4ff0-a062-c1a907d2b0c4",
                                "sense_id": "1eadd1b1-8a5b-3045-8840-eed090581543",
                                "text": "Le bleu intense caractéristique de l’azurite se retrouve dans la majeure partie des tableaux des siècles passés. Réduits en poudre très fine et mélangés à des liants appropriés, les minéraux d’azurite étaient transformés en précieux pigments picturaux."
                            },
                            {
                                "example_id": "117eb2c1-bc89-448d-a6bc-b11f8f8aa58e",
                                "sense_id": "1eadd1b1-8a5b-3045-8840-eed090581543",
                                "text": "L’azurite peut être utilisée, comme la malachite comme pigment."
                            },
                            {
                                "example_id": "aa9cb854-221d-407d-a364-45fb5eb74455",
                                "sense_id": "1eadd1b1-8a5b-3045-8840-eed090581543",
                                "text": "Dans la collection Guyonneau, sont remarquables les azurites et les tourmalines, dont une énorme en forme de cristal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b2d48dc-e8cb-42ec-9497-4b349714b5f9",
                        "source_entry_id": "9e8f98f8-327a-3990-b13a-cfe95b5288d7",
                        "source_sense_id": "1eadd1b1-8a5b-3045-8840-eed090581543",
                        "source_sense_description": "Minéral",
                        "target_lang_word": "Azurit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Azurit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b2b50dd-e25d-3378-b00e-4f8169d4c6a0",
                                        "entry_id": "c64d75fa-7ddf-38a4-a093-8c945475165d",
                                        "glosses": [
                                            "tiefblaues Mineral"
                                        ],
                                        "tags": [
                                            "Mineralogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d4cee71-5383-418a-9e4d-347176aacff3",
                                                "sense_id": "7b2b50dd-e25d-3378-b00e-4f8169d4c6a0",
                                                "text": "„Im Altertum waren Armenien, Zypern und Spanien (Andalusien) Hauptlieferanten für Azurit.“"
                                            },
                                            {
                                                "example_id": "0d053990-0306-42a6-afbe-64667e883c18",
                                                "sense_id": "7b2b50dd-e25d-3378-b00e-4f8169d4c6a0",
                                                "text": "„In jeden Fall baute man auch in Europa, im Bergwerk von Rudna Glava in Serbien, um diese Zeit bereits in Schächten Malachit und Azurit ab, was möglicherweise in den ersten Jahrhunderten hauptsächlich zu Schmuck und Farbpigmenten verarbeitet wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
