                            {
                                "example_id": "d7e95045-11a9-4210-bff4-3a7467913b13",
                                "sense_id": "fa561544-5f1a-31b4-a3a6-d3dd16c002ce",
                                "text": "Якоб Гримм вместе с братом Вильгельмом составил знаменитое собрание немецких сказок."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f790c8e-fcc7-3ab1-897b-2140495201d9",
                        "entry_id": "9c89e76e-7140-3848-85b0-eab3f03e486d",
                        "glosses": [
                            "фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0220a9a9-0eaa-494b-abc6-aedf59150a80",
                                "sense_id": "2f790c8e-fcc7-3ab1-897b-2140495201d9",
                                "text": "В 1794 году Людвиг Генрих фон Якоб был назначен ректором Галльского университета."
                            }
                        ]
                    }
                ],
                "translations": [
