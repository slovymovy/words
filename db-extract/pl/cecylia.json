                "translations": [
                    {
                        "translation_id": "06a55217-78ee-42d2-a29a-4d88e0f31730",
                        "source_entry_id": "7d2b9959-5c36-39a7-a2d4-91ccc4d8cb4d",
                        "source_sense_id": "330f49e7-0431-37f6-a14c-1fd2fd2f6e98",
                        "target_lang_word": "Cecilia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cecilia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee6a85ac-1ff2-3abd-b2a9-805ad7a84da9",
                                        "entry_id": "da70de13-5ad9-3e02-b544-99540c72f31a",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba31879b-094f-4e20-88a0-e7d0402a2915",
                                                "sense_id": "ee6a85ac-1ff2-3abd-b2a9-805ad7a84da9",
                                                "text": "Hark how the flutes and trumpets raise / At bright Cecilia's name, their lays!"
                                            },
                                            {
                                                "example_id": "00ef947c-a9e4-4157-b88c-1c63d855a837",
                                                "sense_id": "ee6a85ac-1ff2-3abd-b2a9-805ad7a84da9",
                                                "text": "‘Sissy is not a name,’ said Mr. Gradgrind. ‘Don’t call yourself Sissy. Call yourself Cecilia.’ ‘It’s father as calls me Sissy, sir,’ returned the young girl in a trembling voice, and with another curtsey. ‘Then he has no business to do it,’ said Mr. Gradgrind. ‘Tell him he mustn’t. Cecilia Jupe. Let me see. What is your father?’"
                                            },
                                            {
                                                "example_id": "a53528c9-e2fd-4199-8625-31affd809b23",
                                                "sense_id": "ee6a85ac-1ff2-3abd-b2a9-805ad7a84da9",
                                                "text": "Because they had named her Cecilia, her parents fancied that the matter of her life and character had been fairly well settled. She would, of course, be quiet and pale and mystical, like the saint whose picture hung above the old upright piano in the Kirby living-room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1c69b37-df69-47c8-861d-1bc19245b418",
                        "source_entry_id": "7d2b9959-5c36-39a7-a2d4-91ccc4d8cb4d",
                        "source_sense_id": "330f49e7-0431-37f6-a14c-1fd2fd2f6e98",
