                        "examples": [
                            {
                                "example_id": "44fdd39e-ca21-4ab3-985d-663548b03660",
                                "sense_id": "03b099e1-40d0-3654-81f4-6c3c1637c562",
                                "text": "De politie heeft donderdag een man aangehouden die ervan wordt verdacht dat hij een politiebureau in Weesp (Noord-Holland) heeft beklad met hakenkruizen."
                            },
                            {
                                "example_id": "b5452562-0cfa-45a6-ab0c-73a8035955e0",
                                "sense_id": "03b099e1-40d0-3654-81f4-6c3c1637c562",
                                "text": "Het beeld van de Britse beeldhouwer Anish Kapoor, een stalen buis die vanwege de uitstulpingen aan het uiteinde de bijnaam Vagina van de Koningin draagt, werd afgelopen weekend beklad met antisemitische leuzen. De eerste graffiti-aanval was in juni, kort na de onthulling."
                            },
                            {
                                "example_id": "048eed13-7a90-4151-ae77-71e7162ceea0",
                                "sense_id": "03b099e1-40d0-3654-81f4-6c3c1637c562",
                                "text": "A. heeft bekend dat hij het monument afgelopen zomer twee keer met verf en een keer met purschuim heeft beklad. Ook liet hij een briefje achter. Zijn advocaat sprak van „een schreeuw om aandacht.”"
                            }
                        ]
                    }
