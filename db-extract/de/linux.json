                                    {
                                        "sense_id": "b79fe538-d31e-33b0-abe1-854323c5afc1",
                                        "entry_id": "8908da3d-45a6-3453-9fd2-98d7bed53169",
                                        "glosses": [
                                            "verzameling opensource programma's die samen het hart van het besturingssysteem voor een computer vormen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47a65c8a-4e89-4ba7-b96f-a35811859537",
                                                "sense_id": "b79fe538-d31e-33b0-abe1-854323c5afc1",
                                                "text": "Android is het mobiele besturingssysteem van Google en is gedeeltelijke gebaseerd op Linux. Veel fabrikanten van de toestellen van Android hebben licenties voor het gebruik van delen van de code van Linux. Volgens de GPLv2-licentie waaronder Linux geschreven is, moet de code altijd openbaar zijn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ce1c7bd-4fe9-3e2e-9953-4789571c1c26",
                                        "entry_id": "8908da3d-45a6-3453-9fd2-98d7bed53169",
                                        "glosses": [
                                            "opensource besturingssysteem voor computers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "216274d6-bb13-42b0-ba4d-593c4863fbbd",
                                                "sense_id": "0ce1c7bd-4fe9-3e2e-9953-4789571c1c26",
                                                "text": "Een Canadese ontwikkelaar werkt aan een goedkope tablet die niet op Android, Windows, iOS of Palm OS werkt, maar op Linux."
                                            }
                                        ]
                                    }
                                ]
                            }
