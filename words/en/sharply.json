{
    "word_family": [
        "sharp",
        "sharpen",
        "sharpener",
        "sharpness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d9ccc9a2-5bae-3fa6-b3fd-74b5f5de1c27",
                    "sense_definition": "Quickly and abruptly; by a large amount or degree.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "degree_and_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Housing prices rose <w>sharply</w> over the course of the previous year.",
                            "target_lang_translations": {
                                "it": "I prezzi delle case sono aumentati <w>notevolmente</w> nel corso dell'anno precedente."
                            }
                        },
                        {
                            "text": "The value of the currency fell <w>sharply</w> after the sudden announcement.",
                            "target_lang_translations": {
                                "it": "Il valore della valuta è sceso <w>drasticamente</w> dopo l'annuncio improvviso."
                            }
                        }
                    ],
                    "synonyms": [
                        "steeply",
                        "dramatically"
                    ],
                    "antonyms": [
                        "gradually",
                        "slowly"
                    ],
                    "common_phrases": [
                        "fall sharply",
                        "increase sharply",
                        "rise sharply"
                    ],
                    "target_lang_definitions": {
                        "it": "In modo rapido, brusco e in misura considerevole."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "bruscamente",
                                "target_lang_sense_clarification": "improvvisamente e repentinamente"
                            },
                            {
                                "target_lang_word": "notevolmente",
                                "target_lang_sense_clarification": "in misura significativa"
                            },
                            {
                                "target_lang_word": "drasticamente",
                                "target_lang_sense_clarification": "in modo radicale o pesante"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b1c2a71-25c6-305f-8052-ce1e3b5f96d5",
                    "sense_definition": "In a stern, critical, or irritable manner, especially in speech.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spoke <w>sharply</w> to the children when they refused to listen.",
                            "target_lang_translations": {
                                "it": "Ha parlato <w>aspramente</w> ai bambini quando si sono rifiutati di ascoltare."
                            }
                        },
                        {
                            "text": "He replied <w>sharply</w> that the decision was none of their business.",
                            "target_lang_translations": {
                                "it": "Ha risposto <w>seccamente</w> che la decisione non era affar loro."
                            }
                        }
                    ],
                    "synonyms": [
                        "harshly",
                        "sternly",
                        "curtly"
                    ],
                    "antonyms": [
                        "gently",
                        "politely"
                    ],
                    "common_phrases": [
                        "reply sharply",
                        "speak sharply"
                    ],
                    "target_lang_definitions": {
                        "it": "In modo severo, aspro o irritato, spec. parlando."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "bruscamente",
                                "target_lang_sense_clarification": "con modi spicci o sgarbati"
                            },
                            {
                                "target_lang_word": "aspramente",
                                "target_lang_sense_clarification": "con durezza o severità"
                            },
                            {
                                "target_lang_word": "seccamente",
                                "target_lang_sense_clarification": "in modo perentorio e freddo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5b115a1-4510-3713-a03f-2208ee5bec93",
                    "sense_definition": "At an acute or tight angle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain path turns <w>sharply</w> to the left near the summit.",
                            "target_lang_translations": {
                                "it": "Il sentiero di montagna gira <w>bruscamente</w> a sinistra vicino alla vetta."
                            }
                        },
                        {
                            "text": "The vehicle veered <w>sharply</w> to avoid an obstacle in the road.",
                            "target_lang_translations": {
                                "it": "Il veicolo ha sterzato <w>bruscamente</w> per evitare un ostacolo sulla strada."
                            }
                        }
                    ],
                    "synonyms": [
                        "abruptly"
                    ],
                    "antonyms": [
                        "gradually"
                    ],
                    "common_phrases": [
                        "turn sharply"
                    ],
                    "target_lang_definitions": {
                        "it": "Con un angolo stretto o acuto; repentinamente."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "bruscamente",
                                "target_lang_sense_clarification": "in modo repentino per un cambio di direzione"
                            },
                            {
                                "target_lang_word": "seccamente",
                                "target_lang_sense_clarification": "con una curva o deviazione decisa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b82a3c8-db30-31f1-bbdf-082a05e4d18c",
                    "sense_definition": "In a distinct, clear, or prominent way that emphasizes differences.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "degree_and_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His personal views contrast <w>sharply</w> with the official policy of his employer.",
                            "target_lang_translations": {
                                "it": "Le sue opinioni personali contrastano <w>nettamente</w> con la linea ufficiale del suo datore di lavoro."
                            }
                        },
                        {
                            "text": "The new modern buildings differ <w>sharply</w> from the historic architecture nearby.",
                            "target_lang_translations": {
                                "it": "I nuovi edifici moderni differiscono <w>marcatamente</w> dall'architettura storica circostante."
                            }
                        }
                    ],
                    "synonyms": [
                        "distinctly",
                        "markedly"
                    ],
                    "common_phrases": [
                        "contrast sharply"
                    ],
                    "target_lang_definitions": {
                        "it": "In modo chiaro, netto ed evidente, evidenziando le differenze."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "nettamente",
                                "target_lang_sense_clarification": "in modo evidente e marcato"
                            },
                            {
                                "target_lang_word": "chiaramente",
                                "target_lang_sense_clarification": "in maniera palese"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "503e2222-d9d1-3ee5-91b6-1096d58e1d10",
                    "sense_definition": "In a neat, smart, and fashionable way.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He arrived at the interview <w>sharply</w> dressed in a tailored navy suit.",
                            "target_lang_translations": {
                                "it": "Si è presentato al colloquio vestito in modo <w>impeccabile</w> con un abito blu sartoriale."
                            }
                        },
                        {
                            "text": "All of the staff members were <w>sharply</w> attired for the annual gala.",
                            "target_lang_translations": {
                                "it": "Tutti i membri dello staff erano vestiti <w>elegantemente</w> per il gala annuale."
                            }
                        }
                    ],
                    "synonyms": [
                        "smartly",
                        "stylishly"
                    ],
                    "antonyms": [
                        "shabbily"
                    ],
                    "common_phrases": [
                        "sharply dressed"
                    ],
                    "target_lang_definitions": {
                        "it": "In modo elegante, curato e alla moda."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "impeccabilmente",
                                "target_lang_sense_clarification": "in modo perfetto ed elegante"
                            },
                            {
                                "target_lang_word": "elegantemente",
                                "target_lang_sense_clarification": "con stile ed eleganza"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d3e0472-8d20-328e-ae13-a39872dae436",
                    "sense_definition": "With great clarity, precision, or clear focus.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The camera lens captured the distant mountain peak <w>sharply</w>.",
                            "target_lang_translations": {
                                "it": "L'obiettivo della fotocamera ha catturato la lontana vetta della montagna in modo <w>nitido</w>."
                            }
                        },
                        {
                            "text": "The report presented a <w>sharply</w> focused analysis of recent market trends.",
                            "target_lang_translations": {
                                "it": "Il rapporto ha presentato un'analisi <w>estremamente</w> mirata delle recenti tendenze di mercato."
                            }
                        }
                    ],
                    "synonyms": [
                        "clearly",
                        "precisely"
                    ],
                    "antonyms": [
                        "blurrily",
                        "vaguely"
                    ],
                    "common_phrases": [
                        "sharply focused",
                        "sharply defined"
                    ],
                    "target_lang_definitions": {
                        "it": "Con grande chiarezza, precisione o messa a fuoco nitida."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "nitidamente",
                                "target_lang_sense_clarification": "con estrema chiarezza visiva o concettuale"
                            },
                            {
                                "target_lang_word": "chiaramente",
                                "target_lang_sense_clarification": "in modo distinto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e401e2b-82db-3fe2-8be7-27c2de1ff40f",
                    "sense_definition": "With intense, severe, or piercing physical pain.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His knee twinged <w>sharply</w> when he tried to step down from the curb.",
                            "target_lang_translations": {
                                "it": "Il ginocchio gli ha fatto male <w>acutamente</w> quando ha provato a scendere dal marciapiede."
                            }
                        },
                        {
                            "text": "The cold wind stung her cheeks <w>sharply</w> during the walk home.",
                            "target_lang_translations": {
                                "it": "Il vento freddo le pungeva <w>fortemente</w> le guance durante la camminata verso casa."
                            }
                        }
                    ],
                    "synonyms": [
                        "keenly",
                        "piercingly",
                        "severely"
                    ],
                    "antonyms": [
                        "dully"
                    ],
                    "target_lang_definitions": {
                        "it": "Con dolore fisico intenso, acuto o pungente."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "acutamente",
                                "target_lang_sense_clarification": "con fitta o dolore pungente"
                            },
                            {
                                "target_lang_word": "fortemente",
                                "target_lang_sense_clarification": "con grande intensità di dolore"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62f30725-9e41-3b91-99c7-fe89b384b31d",
                    "sense_definition": "In a steep, almost vertical, or precipitous manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The narrow path drops <w>sharply</w> into the rocky canyon below.",
                            "target_lang_translations": {
                                "it": "Lo stretto sentiero scende <w>a picco</w> nel canyon roccioso sottostante."
                            }
                        },
                        {
                            "text": "The cliff face rises <w>sharply</w> above the churning ocean waves.",
                            "target_lang_translations": {
                                "it": "La parete rocciosa si erge <w>ripidamente</w> sopra le onde agitate dell'oceano."
                            }
                        }
                    ],
                    "synonyms": [
                        "steeply",
                        "precipitously"
                    ],
                    "antonyms": [
                        "gently"
                    ],
                    "common_phrases": [
                        "drop sharply"
                    ],
                    "target_lang_definitions": {
                        "it": "In modo molto ripido, quasi verticale o a strapiombo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "ripidamente",
                                "target_lang_sense_clarification": "con forte pendenza"
                            },
                            {
                                "target_lang_word": "a picco",
                                "target_lang_sense_clarification": "in modo verticale o precipitoso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2036d866-5db4-3fc9-9b55-838f88620af4",
                    "sense_definition": "So as to have a sharp point or cutting edge.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wooden stake was <w>sharply</w> tapered at the end so it could enter the ground easily.",
                            "target_lang_translations": {
                                "it": "Il palo di legno era tagliato <w>a punta</w> all'estremità affinché entrasse facilmente nel terreno."
                            }
                        },
                        {
                            "text": "The kitchen knife was <w>sharply</w> honed before preparing the meat.",
                            "target_lang_translations": {
                                "it": "Il coltello da cucina è stato affilato <w>finemente</w> prima di preparare la carne."
                            }
                        }
                    ],
                    "antonyms": [
                        "bluntly"
                    ],
                    "common_phrases": [
                        "sharply pointed"
                    ],
                    "target_lang_definitions": {
                        "it": "In modo da avere una punta acuta o un filo tagliente."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "a punta",
                                "target_lang_sense_clarification": "con estremità appuntita"
                            },
                            {
                                "target_lang_word": "finemente",
                                "target_lang_sense_clarification": "arrotato o affilato con precisione"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35d11bfd-8bd5-3eb0-96bc-5656ed8a8962",
                    "sense_definition": "In an observant, perceptive, or intellectually penetrating way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked <w>sharply</w> at her companion to detect any sign of deceit.",
                            "target_lang_translations": {
                                "it": "Ha guardato <w>attentamente</w> il suo compagno per cogliere qualsiasi segno di inganno."
                            }
                        },
                        {
                            "text": "The detective observed every minor detail <w>sharply</w> during the interrogation.",
                            "target_lang_translations": {
                                "it": "Il detective ha osservato ogni minimo dettaglio con fare <w>acuto</w> durante l'interrogatorio."
                            }
                        }
                    ],
                    "synonyms": [
                        "keenly",
                        "attentively",
                        "perceptively"
                    ],
                    "common_phrases": [
                        "look sharply"
                    ],
                    "target_lang_definitions": {
                        "it": "In modo attento, perspicace o penetrante."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "attentamente",
                                "target_lang_sense_clarification": "con grande attenzione"
                            },
                            {
                                "target_lang_word": "acutamente",
                                "target_lang_sense_clarification": "con sguardo penetrante"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ad46a13-9f48-3298-85f0-a7f114d789cb",
                    "sense_definition": "Suddenly and intensely, as an emotional intake of breath.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She drew her breath in <w>sharply</w> when she heard the tragic news.",
                            "target_lang_translations": {
                                "it": "Ha trattenuto il respiro <w>di colpo</w> quando ha sentito la tragica notizia."
                            }
                        },
                        {
                            "text": "He inhaled <w>sharply</w> upon seeing the unexpected damage to the structure.",
                            "target_lang_translations": {
                                "it": "Ha inspirato <w>bruscamente</w> vedendo il danno inaspettato alla struttura."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gasp sharply",
                        "inhale sharply"
                    ],
                    "target_lang_definitions": {
                        "it": "Improvvisamente e intensamente, riferito a un respiro."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "bruscamente",
                                "target_lang_sense_clarification": "con un sussulto improvviso"
                            },
                            {
                                "target_lang_word": "di colpo",
                                "target_lang_sense_clarification": "all'improvviso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d23c7640-3011-31cb-a164-035b251d8f30",
                    "sense_definition": "With swiftness, vigor, and alertness.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team moved <w>sharply</w> to regain possession of the ball.",
                            "target_lang_translations": {
                                "it": "La squadra si è mossa <w>prontamente</w> per recuperare il possesso della palla."
                            }
                        },
                        {
                            "text": "The athlete started the match <w>sharply</w> and took an early lead.",
                            "target_lang_translations": {
                                "it": "L'atleta ha iniziato la partita <w>vigorosamente</w> ed è passato subito in vantaggio."
                            }
                        }
                    ],
                    "synonyms": [
                        "briskly",
                        "alertly"
                    ],
                    "antonyms": [
                        "sluggishly"
                    ],
                    "target_lang_definitions": {
                        "it": "Con rapidità, vigore e prontezza."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "prontamente",
                                "target_lang_sense_clarification": "con reattività e prontezza"
                            },
                            {
                                "target_lang_word": "vigorosamente",
                                "target_lang_sense_clarification": "con energia e decisione"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}