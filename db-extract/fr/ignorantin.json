                "senses": [
                    {
                        "sense_id": "2d3c3a6f-eb57-34cb-91da-58b69bff22fa",
                        "entry_id": "dd7bf6f4-0982-341c-b4db-1f92622faf93",
                        "glosses": [
                            "Appartenant à l’ordre des hospitaliers de Saint-Jean-de-Dieu et portant ce nom par humilité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b215486-1530-4036-933a-5bdf3936980e",
                                "sense_id": "2d3c3a6f-eb57-34cb-91da-58b69bff22fa",
                                "text": "Il y avait à Toulon une école pour la chiourme tenue par des frères ignorantins où l’on enseignait le plus nécessaire à ceux de ces malheureux qui avaient de la bonne volonté."
                            }
                        ]
                    },
                    {
                        "sense_id": "56689390-16f3-341b-8712-8d25adb16ab2",
                        "entry_id": "dd7bf6f4-0982-341c-b4db-1f92622faf93",
                        "glosses": [
                            "Qui est ignorant, sans culture, ignorantiste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa217a6e-dcae-4bde-9b50-9f73eca0a462",
                                "sense_id": "56689390-16f3-341b-8712-8d25adb16ab2",
                                "text": "Une tradition ignorantine […] ne propose plus aujourd’hui que les œuvres les moins pures de Liszt, ses morceaux de jongleurs, ses divertissements d’acrobate."
                            }
                        ]
                    }
                ],
