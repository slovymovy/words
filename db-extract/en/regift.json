                                        "sense_id": "1a2addbd-193f-3b2e-bfe6-0f50e15ad254",
                                        "entry_id": "8f6b42d0-490c-3ff0-8439-2dc002adc03b",
                                        "glosses": [
                                            "riutilizzare rifiuti mediante operazioni di pulitura, filtraggio, ecc"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bb24227-5be5-4aa0-b692-3780d0a18430",
                                                "sense_id": "1a2addbd-193f-3b2e-bfe6-0f50e15ad254",
                                                "text": "molti elementi di prodotti industriali, però non per quelli alimentari, derivano da oggetti che sono stati riciclati"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2c1bfeb-5b5d-3876-9ef8-3d052a37341c",
                                        "entry_id": "8f6b42d0-490c-3ff0-8439-2dc002adc03b",
                                        "glosses": [
                                            "dare parvenza lecita a denaro di provenienza illecita"
                                        ],
                                        "tags": [
                                            "diritto"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89f7df35-63dc-34da-8944-26b60edae8c6",
                                        "entry_id": "8f6b42d0-490c-3ff0-8439-2dc002adc03b",
                                        "glosses": [
                                            "regalare a qualcuno un oggetto precedentemente ricevuto in dono da altra persona, talvolta perché non desiderato ma qualche volta veramente ad altri destinato"
                                        ],
                                        "tags": [
                                            "familiare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfc54294-7ae9-4a5d-a9d1-94e626ad38c2",
                                                "sense_id": "89f7df35-63dc-34da-8944-26b60edae8c6",
                                                "text": "\"Ma dai, quando non si ha confidenza non si riciclano i regali!!\""
                                            },
                                            {
                                                "example_id": "50765a7e-45a9-4b8f-96d8-07d7a131d058",
                                                "sense_id": "89f7df35-63dc-34da-8944-26b60edae8c6",
                                                "text": "Il bambino, ormai da un po' a disagio, urlò deciso ma innocentemente: \"La mia mamma a Natale mette da parte i doni da riciclare!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
