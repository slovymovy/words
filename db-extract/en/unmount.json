                    {
                        "sense_id": "7183288e-e97c-358a-8c2e-897b3dda98a2",
                        "entry_id": "b58af5ea-6759-3c1b-b297-57aa02e7d379",
                        "glosses": [
                            "To reverse a mount operation; to instruct the operating system that the file system should be disassociated from its mount point, making it no longer accessible."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "220051ef-884e-46cb-af13-449f8956dce2",
                                "sense_id": "7183288e-e97c-358a-8c2e-897b3dda98a2",
                                "text": "Please unmount the external hard drive before unplugging it."
                            },
                            {
                                "example_id": "4c626397-799a-4f17-8448-87774c850fd5",
                                "sense_id": "7183288e-e97c-358a-8c2e-897b3dda98a2",
                                "text": "You must unmount the filesystem before running the data recovery tool."
                            }
                        ]
                    }
                ],
