                {
                    "sense_id": "39c806fb-62f2-3368-8ed2-70b89e068c6d",
                    "sense_definition": "Een organisatie of overheidsdienst die belast is met het uitvoeren van controles en toezicht.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>inspectie</w> controleert of scholen zich aan de wettelijke regels houden.",
                            "target_lang_translations": {
                                "en": "The <w>inspectorate</w> checks whether schools comply with the legal rules.",
                                "ru": "<w>Инспекция</w> проверяет, соблюдают ли школы установленные законом правила.",
                                "zh": "该<w>督察机构</w>负责核查学校是否遵守法律法规。"
                            }
                        },
                        {
                            "text": "Het bedrijf kreeg vorige week onverwacht bezoek van de <w>inspectie</w>.",
                            "target_lang_translations": {
                                "en": "The company received an unexpected visit from the <w>inspectorate</w> last week.",
                                "ru": "На прошлой неделе компанию неожиданно посетила <w>инспекция</w>.",
                                "zh": "上周，该公司意外地收到了<w>检查部门</w>的到访。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inspectiedienst",
                        "toezichthouder"
                    ],
                    "common_phrases": [
                        "Inspectie van het Onderwijs",
                        "Inspectie Leefomgeving en Transport"
                    ],
                    "target_lang_definitions": {
