                                    {
                                        "sense_id": "1dfaff53-5270-394c-903d-19e472f59071",
                                        "entry_id": "04692cee-17d2-3929-9613-e66e2b034a1a",
                                        "glosses": [
                                            "To make (something) completely full."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f40f213-cb63-317f-867e-aeb374fac621",
                                        "entry_id": "04692cee-17d2-3929-9613-e66e2b034a1a",
                                        "glosses": [
                                            "To fill the tank of a vehicle with fuel."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34f70a8a-292f-4c64-800c-dcf2b9b1f6d0",
                                                "sense_id": "2f40f213-cb63-317f-867e-aeb374fac621",
                                                "text": "It costs a fortune these days to fill up."
                                            },
                                            {
                                                "example_id": "7ff73391-4133-4c3e-b7de-843cc66dba3d",
                                                "sense_id": "2f40f213-cb63-317f-867e-aeb374fac621",
                                                "text": "\"Game over,\" Waddicor warns. \"Look at the fuel gauge. Someone's forgotten to fill up.\" The heavily laden train has come from Freightliner's Maritime Terminal in Southampton's western docks. Waddicor reckons there might not be enough diesel in the tank to complete the journey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1eda4de-ed67-3663-8eff-998013ecb28c",
                                        "entry_id": "04692cee-17d2-3929-9613-e66e2b034a1a",
                                        "glosses": [
                                            "To become completely full."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39a6f6f6-ae8a-3e31-ad6f-0168c8bca71b",
                                        "entry_id": "04692cee-17d2-3929-9613-e66e2b034a1a",
                                        "glosses": [
                                            "To become tearful as a result of strong emotion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33a94a53-dde4-3329-af65-38103f0ccaef",
                                        "entry_id": "04692cee-17d2-3929-9613-e66e2b034a1a",
                                        "glosses": [
                                            "To annoy, or displease, by taunting, or by excessive nagging."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83b8b5a0-4e6d-462e-be88-96646e5a92d5",
                                                "sense_id": "33a94a53-dde4-3329-af65-38103f0ccaef",
                                                "text": "The teachers that taught me weren't cool. / You're holding me down, / Turning me 'round, / Filling me up with your rules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a49624b-288c-3a9b-aed7-d0fcd2765b10",
                                        "entry_id": "04692cee-17d2-3929-9613-e66e2b034a1a",
                                        "glosses": [
                                            "To satisfy the hunger of (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "571021b1-2206-44d3-85c7-1b84326793ef",
                                                "sense_id": "4a49624b-288c-3a9b-aed7-d0fcd2765b10",
                                                "text": "Thanks for the chocolate cake – it really filled me up!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70ac5e45-34d3-34f8-916e-2f12148ca6b3",
                                        "entry_id": "04692cee-17d2-3929-9613-e66e2b034a1a",
                                        "glosses": [
                                            "To satisfy one's hunger; to stop being hungry."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efcbfaa4-e31f-42ee-84cf-2bc9e25c4112",
                                                "sense_id": "70ac5e45-34d3-34f8-916e-2f12148ca6b3",
                                                "text": "We've scoured these science and tapped the top experts to help you learn how to do just that. Use these seven simple strategies, and you'll fill up without filling out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dea98732-dbe4-3816-a78e-6f61d406a83b",
                                        "entry_id": "04692cee-17d2-3929-9613-e66e2b034a1a",
                                        "glosses": [
                                            "To make a full house on the turn or the river."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd8e853b-8aab-3624-87d3-a06a218e8069",
                                        "entry_id": "04692cee-17d2-3929-9613-e66e2b034a1a",
                                        "glosses": [
                                            "To fill in / fill out a form etc."
                                        ],
