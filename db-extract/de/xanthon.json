                "senses": [
                    {
                        "sense_id": "42dcdbce-e765-3d14-9410-9cdec77ae478",
                        "entry_id": "fe393ec4-0826-3a79-8c3b-a8c5fc13585f",
                        "glosses": [
                            "Stoff, Substanz aus der Kohlenstoffchemie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6091d8b0-82ae-4724-a47f-4de962476976",
                                "sense_id": "42dcdbce-e765-3d14-9410-9cdec77ae478",
                                "text": "„Xanthon […] ist eine heterocyclische chemische Verbindung, die zu den Ethern und Ketonen gehört […].“"
                            },
                            {
                                "example_id": "91099d84-ae07-46b8-879f-936f4af459eb",
                                "sense_id": "42dcdbce-e765-3d14-9410-9cdec77ae478",
                                "text": "„Xanthon wird durch Oxidation von Xanthen […] erhalten.“"
                            },
                            {
                                "example_id": "62417bf7-63aa-4f6f-9de7-93be7aafd8ce",
                                "sense_id": "42dcdbce-e765-3d14-9410-9cdec77ae478",
                                "text": "„In der Natur ist Xanthon selbst nicht anzutreffen, bildet jedoch den Stammkörper verschiedener Naturfarbstoffe aus Pflanzen ([…] Enzian), Pilzen ([…] Mutterkorn) und Flechten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
