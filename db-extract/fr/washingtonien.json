                        ],
                        "form": "washingtonienne"
                    },
                    {
                        "form_id": "ce5e5917-c212-47e3-aac3-56f5e822506e",
                        "entry_id": "1cd85080-9455-3e17-8aec-3987e0224dfd",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "washingtoniennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6162c14-eac6-3192-93d4-c5d00193dfae",
                        "entry_id": "1cd85080-9455-3e17-8aec-3987e0224dfd",
                        "glosses": [
                            "Relatif à Washington, D.C. ou à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20b18e0d-3aee-4974-9556-ae20d4d920b8",
                                "sense_id": "c6162c14-eac6-3192-93d4-c5d00193dfae",
                                "text": "En plein bras de fer avec l'Iran, l'Administration américaine ne pouvait visiblement se permettre le luxe d'une longue bataille avec les Républicains pour la confirmation de la diplomate, souligne-t-on dans les cercles washingtoniens bien informés."
                            }
                        ]
                    },
                    {
                        "sense_id": "7270493f-f7a9-33e1-908e-b8116e6f4a23",
                        "entry_id": "1cd85080-9455-3e17-8aec-3987e0224dfd",
                        "glosses": [
                            "Relatif à l’État de Washington ou à ses habitants."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6ff5315-9b02-4755-9a7f-3fa38bf57b92",
                        "source_entry_id": "1cd85080-9455-3e17-8aec-3987e0224dfd",
                        "target_lang_word": "Washingtonian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Washingtonian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "432dd013-f601-3e9f-ae7a-d0d62fd53990",
                                        "entry_id": "4d07599b-0047-3b44-b10b-eb6681a5f4af",
                                        "glosses": [
                                            "Of, or pertaining to, the U.S. state of Washington or its culture."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdf4f3a1-ade0-4e10-8360-d1e160faf55d",
                                                "sense_id": "432dd013-f601-3e9f-ae7a-d0d62fd53990",
                                                "text": "His concern for the cause of environmental protection was very Washingtonian of him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17296c3a-7edc-387f-9b1f-fcf20773efb1",
                                        "entry_id": "4d07599b-0047-3b44-b10b-eb6681a5f4af",
                                        "glosses": [
                                            "Of, or pertaining to, Washington, D.C., or its culture."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "182da8b5-f435-4332-85c2-3ec8f283d331",
                                                "sense_id": "17296c3a-7edc-387f-9b1f-fcf20773efb1",
                                                "text": "Good jazz music has long been held up as a hallmark of authentic Washingtonian culture."
                                            },
                                            {
                                                "example_id": "4d3fe52d-3c56-4cf5-b599-3ce9d1ed22b5",
                                                "sense_id": "17296c3a-7edc-387f-9b1f-fcf20773efb1",
                                                "text": "I thought of the old joke: What do you call two black men trying to get a cab in Washington, D.C.? Pedestrians. I raised my arm again and this time a car stopped [...] They looked back at me after I gave them my address, one saying, ‘Are you Ethiopian?’ and the other, ‘You look Ethiopian.’ I said, ‘No, I’m just Washingtonian.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79b98471-758a-3555-bedc-ae68d2a54e70",
                                        "entry_id": "4d07599b-0047-3b44-b10b-eb6681a5f4af",
                                        "glosses": [
                                            "Of, or pertaining to, the life, values, or presidential administration of George Washington."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5f22dc6-1035-40b8-aaa9-8aaeab3064de",
                                                "sense_id": "79b98471-758a-3555-bedc-ae68d2a54e70",
                                                "text": "By appearing in uniform, Jackson was able to convey his strong character through these images. Jackson had seized on one element of the Washingtonian myth and clung to it."
                                            },
                                            {
                                                "example_id": "01393094-8128-46b2-9681-4699835985a9",
                                                "sense_id": "79b98471-758a-3555-bedc-ae68d2a54e70",
                                                "text": "Demonstrating that maritime defense, the protection of trade, and the providing of a national revenue were fundamental objectives of the Union, and directing attention to the departures which the Democrats had made from the sound Washingtonian policies in these matters, the orator went on to insist that this there must be a war, the depleted navy should be at once reconstituted..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Washingtonian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd1efb0c-fe16-3c33-a479-84f3068ce181",
                                        "entry_id": "64ec4421-9b56-3b17-99bf-35c59dbc0afe",
                                        "glosses": [
                                            "A native or resident of the state of Washington in the United States of America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd6e4631-3486-4a17-a850-9451f50ce234",
                                                "sense_id": "cd1efb0c-fe16-3c33-a479-84f3068ce181",
                                                "text": "Any real Washingtonian will be quick to tell you that \"Washington state\" is a university."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2e26a60-ec90-3a41-96bb-0bc23b139e88",
                                        "entry_id": "64ec4421-9b56-3b17-99bf-35c59dbc0afe",
                                        "glosses": [
                                            "An inhabitant or a resident of Washington, D.C."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26db79b1-a607-41b8-9478-8e59f0453074",
                                                "sense_id": "b2e26a60-ec90-3a41-96bb-0bc23b139e88",
                                                "text": "Many a hardworking Washingtonian have expressed their frustrations at the influx of rich Marylanders moving into their city."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ed4e3a5-4588-34aa-9c4c-76940bde3b46",
                                        "entry_id": "64ec4421-9b56-3b17-99bf-35c59dbc0afe",
                                        "glosses": [
                                            "A member of the Washingtonian movement, a 19th-century sobriety support group."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
