                ],
                "senses": [
                    {
                        "sense_id": "aa883a32-cf33-3adc-958e-e2266d06bdac",
                        "entry_id": "d5877f88-26f2-3560-b3ce-5d1225cbae0a",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0228bd62-1f02-4c70-9676-3c9e60e1a0d0",
                                "sense_id": "aa883a32-cf33-3adc-958e-e2266d06bdac",
                                "text": "Frau Zwirnlein ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3708e848-b6ad-4dea-81e7-95a16c32d351",
                                "sense_id": "aa883a32-cf33-3adc-958e-e2266d06bdac",
                                "text": "Herr Zwirnlein wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "632a8a78-e2ba-41fb-9a04-f415a4e9deac",
                                "sense_id": "aa883a32-cf33-3adc-958e-e2266d06bdac",
                                "text": "Die Zwirnlein fliegen heute nach Paris."
                            },
                            {
                                "example_id": "279db0ce-7442-4058-802b-fe5eaab4eada",
                                "sense_id": "aa883a32-cf33-3adc-958e-e2266d06bdac",
                                "text": "Der Zwirnlein trägt nie die Pullover, die die Marx ihm strickt."
                            },
                            {
                                "example_id": "407bbbd6-2986-4968-99d2-68847851e207",
                                "sense_id": "aa883a32-cf33-3adc-958e-e2266d06bdac",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zwirnlein kommt, geht der Herr Zwirnlein.“"
                            },
                            {
                                "example_id": "d58cf65c-2f12-4811-aefd-3a0708f872d5",
                                "sense_id": "aa883a32-cf33-3adc-958e-e2266d06bdac",
                                "text": "Zwirnlein kommt und geht."
                            },
                            {
                                "example_id": "2a1280c2-8ca6-4a4d-9f71-eb342c58a870",
                                "sense_id": "aa883a32-cf33-3adc-958e-e2266d06bdac",
                                "text": "Zwirnleins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
