                                        "examples": [
                                            {
                                                "example_id": "32fa042a-ef37-4f47-9cca-75b77c8215ec",
                                                "sense_id": "d6252bd1-4dac-305a-93bb-898f6dd97bf0",
                                                "text": "The double-heterogeneity characterising pebble-bed high temperature reactors (HTRs) makes Monte Carlo based calculation tools the most suitable for detailed core analysis."
                                            },
                                            {
                                                "example_id": "72cd2b67-f1f1-46e1-b34a-57f4ea0ecaab",
                                                "sense_id": "d6252bd1-4dac-305a-93bb-898f6dd97bf0",
                                                "text": "The penetration by light water reactors would be large even if other thermal reactors like the HTR were present, according to our preliminary evaluations, because the LWR is the best plutonium producer."
                                            },
                                            {
                                                "example_id": "3773bbc3-0c28-4fc4-a496-b2919b43edcc",
                                                "sense_id": "d6252bd1-4dac-305a-93bb-898f6dd97bf0",
                                                "text": "Of the nuclear reactors the HTR now produces heat at the highest temperature."
                                            }
