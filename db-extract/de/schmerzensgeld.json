                "senses": [
                    {
                        "sense_id": "b0a87bcc-c67b-3837-b453-470f346098ce",
                        "entry_id": "62e2a64e-19b2-3b52-b931-fd12ae5847de",
                        "glosses": [
                            "Schadensersatz für ein erlittenes physisches oder psychisches Leid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18d4a683-6496-4c36-8377-9b2b4a2358e6",
                                "sense_id": "b0a87bcc-c67b-3837-b453-470f346098ce",
                                "text": "Ihr Chef hat sie jahrelang am Arbeitsplatz belästigt, auf Grund des psychischen Schadens klagt sie nun auf Schmerzensgeld."
                            },
                            {
                                "example_id": "07060923-35c1-4fb8-818d-2f894af45f63",
                                "sense_id": "b0a87bcc-c67b-3837-b453-470f346098ce",
                                "text": "Weil sein Nachbar ihm über den Fuß gefahren ist, verlangt er Schmerzensgeld."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
