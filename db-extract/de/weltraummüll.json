                "senses": [
                    {
                        "sense_id": "9bf41555-6c2e-33ef-ad26-61bf8445c517",
                        "entry_id": "0b9f65c6-e5b4-3f43-8056-9f7b2a6beb11",
                        "glosses": [
                            "im Orbit der Erde befindliche Überreste vergangener Weltraummissionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e59f0b7-3e45-4d17-97d5-b2de9b9c1901",
                                "sense_id": "9bf41555-6c2e-33ef-ad26-61bf8445c517",
                                "text": "Die durchschnittliche Differenzgeschwindigkeit zwischen Weltraummüll und Satellit beträgt ca. 10 km/s."
                            },
                            {
                                "example_id": "70356df4-611a-4928-9422-4ab0a4d1960d",
                                "sense_id": "9bf41555-6c2e-33ef-ad26-61bf8445c517",
                                "text": "„Nach den jetzigen Regeln brauchte es die Zustimmung jedes Erzeugers von Weltraummüll, wenn man ihn beseitigen will.“"
                            },
                            {
                                "example_id": "26269587-a75a-4da3-bb14-93b942057133",
                                "sense_id": "9bf41555-6c2e-33ef-ad26-61bf8445c517",
                                "text": "„Einige für die nächsten Jahre geplante Forschungssonden und sogar bemannte Flüge rund um den Mond machen es notwendig, möglichst viele Informationen über die Gefahren durch Weltraummüll im Mondorbit zu sammeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
