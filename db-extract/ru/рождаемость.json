                        "form": "рожда́емостях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64e84dd5-1d8c-31cd-9a5e-299789a4b65b",
                        "entry_id": "7c1f6b38-f37c-35ea-9c7f-939d7ab3581f",
                        "glosses": [
                            "количество родившихся в единицу времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4209ee0a-5a45-47da-be39-d14dc1a1c958",
                                "sense_id": "64e84dd5-1d8c-31cd-9a5e-299789a4b65b",
                                "text": "Падение рождаемости является одной из долгосрочных, фундаментальных проблем для всех постиндустриальных стран, включая Россию."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "723f10b3-3e6c-4dfb-83fa-500d08b5fe7f",
                        "source_entry_id": "7c1f6b38-f37c-35ea-9c7f-939d7ab3581f",
                        "source_sense_id": "64e84dd5-1d8c-31cd-9a5e-299789a4b65b",
                        "target_lang_word": "birthrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "birthrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c095f94-e5ff-3c4b-8c27-0464d837be3b",
                                        "entry_id": "786e2695-ac69-3052-a057-64f918bb4ea3",
                                        "glosses": [
                                            "The ratio of total live births to total population for a specific community or nation in a specified period; often expressed in births per thousand per year."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39c3bcbf-fe6e-4783-9e08-071be644de07",
                                                "sense_id": "5c095f94-e5ff-3c4b-8c27-0464d837be3b",
                                                "text": "In higher education a similar transformation is being pulled forward: Colleges were expecting a grim landscape in the later 2020s, because 2010s birthrates were so low, but now a decline in foreign enrollment and an acceleration of online learning will threaten marginal state schools and possibly close small liberal-arts colleges much sooner."
                                            },
                                            {
                                                "example_id": "72786cea-63b7-4993-9b67-cca1a89d6c4d",
                                                "sense_id": "5c095f94-e5ff-3c4b-8c27-0464d837be3b",
                                                "text": "In 2023, the birthrate fell for the eighth consecutive year to 0.72, the lowest in the world, from 1.24 in 2015, raising concerns over the economic shock to society from such a rapid pace."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "045e33f7-7e9d-43c9-8730-327fdae572c5",
                        "source_entry_id": "7c1f6b38-f37c-35ea-9c7f-939d7ab3581f",
                        "source_sense_id": "64e84dd5-1d8c-31cd-9a5e-299789a4b65b",
                        "target_lang_word": "Geburtenrate",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geburtenrate",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de9847a8-75ba-3205-8726-98213d1451cc",
                                        "entry_id": "104073f4-b32b-39af-8ae2-529b001b4c4d",
                                        "glosses": [
                                            "Zahl, welche angibt, wie viele Geburten eine Frau durchschnittlich hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96c7ddce-39e4-42d1-905d-1b6bc446b681",
                                                "sense_id": "de9847a8-75ba-3205-8726-98213d1451cc",
                                                "text": "Eine hohe Geburtenrate führt zu einer im Durchschnitt jungen Bevölkerung."
                                            },
                                            {
                                                "example_id": "deaabf64-ffad-40f0-a73a-8ca6c56c0478",
                                                "sense_id": "de9847a8-75ba-3205-8726-98213d1451cc",
                                                "text": "In Deutschland beträgt die Geburtenrate 8, während in Afrika meist Werte über 40 erreicht werden."
                                            },
                                            {
                                                "example_id": "b988f444-f723-4520-9902-428249721cf7",
                                                "sense_id": "de9847a8-75ba-3205-8726-98213d1451cc",
                                                "text": "„Parallel zum säkularen Trend in Deutschland und den übrigen industrialisierten Staaten Europas war auch in Koblenz seit Ende des 19. Jahrhunderts die Geburtenrate (Lebendgeborene pro 1000 Einwohner) durchweg rückläufig.“"
                                            },
                                            {
                                                "example_id": "ff694014-9175-484d-a659-5b7d8aae3a32",
                                                "sense_id": "de9847a8-75ba-3205-8726-98213d1451cc",
                                                "text": "„Den Statistikern zufolge sank die Zahl der Schülerinnen und Schüler im Grundschulbereich wegen der sinkenden Geburtenraten in den vergangenen zehn Jahren um zwölf Prozent.“"
                                            },
                                            {
                                                "example_id": "88106710-7a86-4abd-800f-214a3d8bbd05",
                                                "sense_id": "de9847a8-75ba-3205-8726-98213d1451cc",
                                                "text": "„Die Geburtenrate wird aber erst dann steigen, wenn Eltern in ihrer Lebensplanung ein Gefühl von Sicherheit haben.“"
                                            },
                                            {
                                                "example_id": "27e168c4-a56f-44ad-981c-19f3bad92575",
                                                "sense_id": "de9847a8-75ba-3205-8726-98213d1451cc",
                                                "text": "„Die Geburtenrate je Frau beträgt 1,83.“"
                                            },
                                            {
                                                "example_id": "8ab955ea-72fa-485d-8582-7260b2f2512a",
                                                "sense_id": "de9847a8-75ba-3205-8726-98213d1451cc",
                                                "text": "„[Italien] hat die niedrigste Geburtenrate in Europa, eine Frau bringt hier im Schnitt 1,29 Kinder zur Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
