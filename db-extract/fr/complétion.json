                "senses": [
                    {
                        "sense_id": "280b99c7-72ac-35a7-92cf-6ce9fdbc981a",
                        "entry_id": "e64e632f-6a2f-35f6-9a11-827c66786539",
                        "glosses": [
                            "Action de rendre complet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae5bf9a5-e3db-4c3d-be7f-21fcc92edee4",
                                "sense_id": "280b99c7-72ac-35a7-92cf-6ce9fdbc981a",
                                "text": "À part Le Petit Prince et Pilote de guerre de Saint-Exupéry, elle retiendra peut-être un jour de cet épisode la complétion du cycle des Hommes de bonne volonté de Jules Romains."
                            }
                        ]
                    },
                    {
                        "sense_id": "68bc4b45-82f3-3289-8649-4e29957ebf2f",
                        "entry_id": "e64e632f-6a2f-35f6-9a11-827c66786539",
                        "glosses": [
                            "Achèvement, accomplissement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c9406f2-4121-4d1d-aedf-fe5432e10b4d",
                                "sense_id": "68bc4b45-82f3-3289-8649-4e29957ebf2f",
                                "text": "C’est la subsistence^([sic]) parfaite, ou la perfection de l’état de l'âme, sa complétion ou sa totalité."
                            }
                        ]
                    },
                    {
                        "sense_id": "4237eafc-099e-3570-b8e3-76cbd0f418c2",
                        "entry_id": "e64e632f-6a2f-35f6-9a11-827c66786539",
                        "glosses": [
                            "Opération d’inclusion d’une structure (notamment un espace métrique) dans une autre structure dite complète la plus petite possible."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7bfb1cc9-b3c9-3be2-af49-dd959f306ee0",
                        "entry_id": "e64e632f-6a2f-35f6-9a11-827c66786539",
                        "glosses": [
                            "En particulier, construction du complété d'un espace métrique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "718ced41-772c-31b8-905f-473e25960687",
                        "entry_id": "e64e632f-6a2f-35f6-9a11-827c66786539",
                        "glosses": [
                            "Toutes les opérations qui précèdent la mise en exploitation d’un forage pétrolier."
                        ],
                        "tags": [
                            "Industrie pétrolière"
                        ],
                        "examples": [
                            {
                                "example_id": "97b59bf5-d1b9-4715-8389-a7270ae89076",
                                "sense_id": "718ced41-772c-31b8-905f-473e25960687",
                                "text": "Autre exemple, un puits haute pression-haute température (HP/HT) nécessite des équipements de puits et de complétion plus sophistiqués donc des consommables plus coûteux. L'augmentation de coût qui en résulte peut atteindre 20%"
                            }
                        ]
                    }
