                "senses": [
                    {
                        "sense_id": "d7930f7c-7193-3427-a2e8-97573d4043f1",
                        "entry_id": "1fe76fa0-613c-3f00-87e9-8eaedffe3b08",
                        "glosses": [
                            "Donner un caractère transactionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8e5c731-d8f1-44d3-b827-4e23f9ae9bf6",
                                "sense_id": "d7930f7c-7193-3427-a2e8-97573d4043f1",
                                "text": "J'ai jamais réellement compris l'intérêt de \"transactionnaliser\" (à mes souhaits) toutes les requêtes de la page, sur FluxBB."
                            },
                            {
                                "example_id": "6919cf8a-df7d-4797-87a5-4f350c3f3e1e",
                                "sense_id": "d7930f7c-7193-3427-a2e8-97573d4043f1",
                                "text": "Donc créer aux moins deux instances, l'une avec la méthode non transactionnalisée et l'autre avec la méthode transactionnalisée appelée par la précédente."
                            },
                            {
                                "example_id": "c8b04a9c-edb0-46f3-8811-73fb274be9b6",
                                "sense_id": "d7930f7c-7193-3427-a2e8-97573d4043f1",
                                "text": "Troisième point, dans l'effectuation on va considérer qu'on ne doit pas transactionnaliser le monde, (…)"
                            }
                        ]
                    }
