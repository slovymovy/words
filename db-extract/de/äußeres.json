                ],
                "senses": [
                    {
                        "sense_id": "0a618cdf-cd12-3648-ad6f-b8943a753b1e",
                        "entry_id": "08daa5d6-b9cc-3d04-9ce5-14bea72f907f",
                        "glosses": [
                            "äußere Erscheinung, Aussehen einer Person oder Sache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30423c47-df92-4b21-93e0-15f4bc6265f6",
                                "sense_id": "0a618cdf-cd12-3648-ad6f-b8943a753b1e",
                                "text": "Manche Leute legen viel Wert auf ihr Äußeres."
                            },
                            {
                                "example_id": "d0af31c7-f6d3-4323-8e37-81f5192da22f",
                                "sense_id": "0a618cdf-cd12-3648-ad6f-b8943a753b1e",
                                "text": "„Am meisten würde natürlich nützen, wenn Frauen nicht mehr ständig nach ihrem Äußeren beurteilt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8300667-04a3-420a-bf43-20fb57e044b4",
                        "source_entry_id": "08daa5d6-b9cc-3d04-9ce5-14bea72f907f",
                        "source_sense_id": "0a618cdf-cd12-3648-ad6f-b8943a753b1e",
                        "source_sense_description": "äußere Erscheinung, Aussehen einer Person oder Sache",
                        "target_lang_word": "appearance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appearance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d95b3bc-6402-3752-a995-1ca889a052b7",
                                        "entry_id": "3db07d43-c7f1-32f9-abc3-f66921df0948",
                                        "glosses": [
                                            "The act of appearing or coming into sight; the act of becoming visible to the eye."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a77f1c73-76c1-4547-9a82-036837983fb4",
                                                "sense_id": "7d95b3bc-6402-3752-a995-1ca889a052b7",
                                                "text": "His sudden appearance surprised me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eff7e4d2-0d68-3d31-969e-1d3d9d41abb6",
                                        "entry_id": "3db07d43-c7f1-32f9-abc3-f66921df0948",
                                        "glosses": [
                                            "A thing seen; a phenomenon; an apparition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "289ef040-7074-42af-9101-22aad2eac15e",
                                                "sense_id": "eff7e4d2-0d68-3d31-969e-1d3d9d41abb6",
                                                "text": "There was a strange appearance in the sky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53db04f8-0981-33aa-91a4-11de05997d66",
                                        "entry_id": "3db07d43-c7f1-32f9-abc3-f66921df0948",
                                        "glosses": [
                                            "The way something looks; personal presence"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32d90ef6-cdfb-4cb4-8670-be7d67aeb4a3",
                                                "sense_id": "53db04f8-0981-33aa-91a4-11de05997d66",
                                                "text": "And now am come to ſee of whom ſuch noiſe\n Hath walk'd about, and each limb to ſurvey,\n If thy appearance anſwer loud report."
                                            },
                                            {
                                                "example_id": "10ffbe39-0993-4211-82b0-a8c04ad8f802",
                                                "sense_id": "53db04f8-0981-33aa-91a4-11de05997d66",
                                                "text": "The most rapid and most seductive transition in all human nature is that which attends the palliation of a ravenous appetite.[…]Can those harmless but refined fellow-diners be the selfish cads whose gluttony and personal appearance so raised your contemptuous wrath on your arrival?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "030b0ae9-2214-31be-a699-8560dd643a43",
                                        "entry_id": "3db07d43-c7f1-32f9-abc3-f66921df0948",
                                        "glosses": [
                                            "Apparent likeness; the way which something or someone appears to others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eee4a966-67a9-4679-9dba-4c0413faf4b2",
                                                "sense_id": "030b0ae9-2214-31be-a699-8560dd643a43",
                                                "text": "Some people say I'm shallow because I care so much about my appearance."
                                            },
                                            {
                                                "example_id": "b23067bd-8e42-403c-95f0-b5b1f13a6acb",
                                                "sense_id": "030b0ae9-2214-31be-a699-8560dd643a43",
                                                "text": "KAWS’s first sculptures were limited edition toys for the Japanese brand Bounty Hunter, and the stylised figures distributed around YSP in a variety of postures – shielding their eyes from the sun, seated in apparent contemplation or leading a child-sized version of themselves over the sward – have the appearance of gigantic toys, with their instant legibility and machine-honed surfaces."
                                            },
                                            {
                                                "example_id": "18da7fc8-8ddf-4ef2-a8f2-6a3573d1b858",
                                                "sense_id": "030b0ae9-2214-31be-a699-8560dd643a43",
                                                "text": "And on the day that the tabernacle was reared up the cloud covered the tabernacle, namely, the tent of the testimony: and at even there was upon the tabernacle as it were the appearance of fire, until the morning."
                                            },
                                            {
                                                "example_id": "42a6ca12-322a-4596-8fc2-3756b016e5cb",
                                                "sense_id": "030b0ae9-2214-31be-a699-8560dd643a43",
                                                "text": "Judge not according to the appearance."
                                            },
                                            {
                                                "example_id": "a2f919a9-e27b-4770-9e2a-e743eb875651",
                                                "sense_id": "030b0ae9-2214-31be-a699-8560dd643a43",
                                                "text": "'Never be taken in by false appearancesʻ was Swift's habitual satirical message. 'In most Corporeal Beings, which have fallen under my Cognizance, the Outside hath been infinitely preferable to the In,' he elsewhere proclaimed. … The sordid reality beneath the mask haunted him: was all civilisation just dirt and derangement at heart? […] Evidently man was not the homo rationalis he pretended to be but rather, at best, homo rationis capax ─ a creature capable of rationality, though by implication falling short."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f19e882a-cb06-358f-8ea4-27c80bf719b3",
                                        "entry_id": "3db07d43-c7f1-32f9-abc3-f66921df0948",
                                        "glosses": [
                                            "That which is not substance, essence, hypostasis; the outward reality as opposed to the underlying reality"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23f30912-857a-4820-a3a8-2641a26c3bf2",
                                                "sense_id": "f19e882a-cb06-358f-8ea4-27c80bf719b3",
                                                "text": "Catholicism teaches that the Eucharist, while remaining under the physical appearance of bread and wine, becomes really and truly the body and the blood of Christ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32d9ed91-65b1-359a-a625-d8b79027f5ed",
                                        "entry_id": "3db07d43-c7f1-32f9-abc3-f66921df0948",
                                        "glosses": [
                                            "The act of appearing in a particular place, or in society, a company, or any proceedings; a coming before the public in a particular character."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f209a14-6e4c-436e-984b-c2b112c578c9",
                                                "sense_id": "32d9ed91-65b1-359a-a625-d8b79027f5ed",
                                                "text": "A person makes his appearance as an historian, an artist, or an orator."
                                            },
                                            {
                                                "example_id": "308ba9e7-c547-40b8-aa76-71273224be0d",
                                                "sense_id": "32d9ed91-65b1-359a-a625-d8b79027f5ed",
                                                "text": "David Beckham's first appearance with the LA Galaxy at Giants Stadium against the New York Red Bulls last night drew a crowd of 66237."
                                            },
                                            {
                                                "example_id": "bb3b8ae1-6cbd-46f9-90c0-8d470ed77d7f",
                                                "sense_id": "32d9ed91-65b1-359a-a625-d8b79027f5ed",
                                                "text": "Will he now retire, After appearance, and again prolong Our expectation?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2684645b-0ac9-33b9-9f23-1af6d8578a21",
                                        "entry_id": "3db07d43-c7f1-32f9-abc3-f66921df0948",
                                        "glosses": [
                                            "An instance of someone coming into a court of law to be part of a trial, lawsuit or other proceeding, either in person or represented by an attorney or such like; a court appearance"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a8f203a-7ed2-3ada-9b40-8b53a44492b2",
                                        "entry_id": "3db07d43-c7f1-32f9-abc3-f66921df0948",
                                        "glosses": [
                                            "Chiefly used by nurses: the act of defecation by a patient."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9d7887c-e380-4d43-97e1-ee9d5633a379",
                                                "sense_id": "1a8f203a-7ed2-3ada-9b40-8b53a44492b2",
                                                "text": "The patient had a small bowel obstruction and there was no appearance until after the obstruction resolved."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96f0e7d6-5c29-465f-9a66-3a4114bdfe16",
                        "source_entry_id": "08daa5d6-b9cc-3d04-9ce5-14bea72f907f",
                        "source_sense_id": "0a618cdf-cd12-3648-ad6f-b8943a753b1e",
                        "source_sense_description": "äußere Erscheinung, Aussehen einer Person oder Sache",
                        "target_lang_word": "apparence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apparence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ceff633d-ff35-355f-bb3d-a7789a8f8315",
                                        "entry_id": "bb691982-929a-39ee-b33d-709559e3fdf6",
                                        "glosses": [
                                            "Ce qui paraît extérieurement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33ac7b86-a44d-4bb8-818f-d975844b6a76",
                                                "sense_id": "ceff633d-ff35-355f-bb3d-a7789a8f8315",
                                                "text": "Le lissage après peignage donne une apparence plus flatteuse à la laine."
                                            },
                                            {
                                                "example_id": "24e672d1-d09d-4af2-a5dc-f06266ac819a",
                                                "sense_id": "ceff633d-ff35-355f-bb3d-a7789a8f8315",
                                                "text": "Aussi rien n'est-il plus naturel que de voir des policiers […] prendre, pour ne pas effaroucher leur proie, l'apparence des gars qu'ils ont la mission d'appréhender."
                                            },
                                            {
                                                "example_id": "e54aecea-13a8-48e7-9a19-dd7c8a072082",
                                                "sense_id": "ceff633d-ff35-355f-bb3d-a7789a8f8315",
                                                "text": "Là les Américains vivent strictement entre eux avec […] leurs nombreuses églises qui n'ont pas l'apparence d'églises, et leurs non moins nombreuses loges maçonniques."
                                            },
                                            {
                                                "example_id": "ef2d6cfd-9ec6-4382-8d44-ded013223b9b",
                                                "sense_id": "ceff633d-ff35-355f-bb3d-a7789a8f8315",
                                                "text": "Malgré sa corpulence excessive, l'autorité de M. Hector sur ses subordonnés n'est guère contestable. Il la doit surtout […], à cette indémontrable apparence de bonhomie qui dérobe son intransigeance absolue, son despotisme maniaque, la secrète satisfaction d'être redouté."
                                            },
                                            {
                                                "example_id": "75070f6a-456c-4f14-b007-1d8ecd881f3c",
                                                "sense_id": "ceff633d-ff35-355f-bb3d-a7789a8f8315",
                                                "text": "Un campement à la bordure d'une forêt, et éclairé par quelques bougies, donne d'étranges apparences ; je crus voir une falaise et des cavernes ; je revis ce lieu plus d'une fois ; jamais je n'y pus reconnaître ma première impression ; […]."
                                            },
                                            {
                                                "example_id": "04a98f1a-dc63-47a1-8023-e0b22439fa0b",
                                                "sense_id": "ceff633d-ff35-355f-bb3d-a7789a8f8315",
                                                "text": "Ted n'avait jamais vraiment prêté attention à son apparence jusqu'à un soir de beuverie où elle avait accepté en titubant d'affronter une belle blonde du LAPD lors d'un concours de T-shirt mouillé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74a7b7f3-8565-373e-af0e-e9510483585b",
                                        "entry_id": "bb691982-929a-39ee-b33d-709559e3fdf6",
                                        "glosses": [
                                            "Marque, trace de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f41a30a-ef81-44d8-bc69-d0896a4a5cdf",
                                                "sense_id": "74a7b7f3-8565-373e-af0e-e9510483585b",
                                                "text": "Ils n’ont plus aucune apparence de liberté."
                                            },
                                            {
                                                "example_id": "a1136619-d39e-4012-b33d-a8c9b4d34086",
                                                "sense_id": "74a7b7f3-8565-373e-af0e-e9510483585b",
                                                "text": "Il ne reste à cette femme aucune apparence de beauté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93a49d0f-5b98-3610-9716-a48c9faba61b",
                                        "entry_id": "bb691982-929a-39ee-b33d-709559e3fdf6",
                                        "glosses": [
                                            "Désir de briller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "499ac4d6-ff98-4b15-9306-2247e4a0d88f",
                                                "sense_id": "93a49d0f-5b98-3610-9716-a48c9faba61b",
                                                "text": "Bien des gens se privent du nécessaire pour tout donner à l’apparence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a170bd3-073f-3340-9528-80596f81ecf0",
                                        "entry_id": "bb691982-929a-39ee-b33d-709559e3fdf6",
                                        "glosses": [
                                            "Désir de briller.",
                                            "En particulier au pluriel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6125b133-641a-4187-b86b-ce96740f09ba",
                                                "sense_id": "5a170bd3-073f-3340-9528-80596f81ecf0",
                                                "text": "Les résultats sont édifiants, indique Fast Company: ils indiquent de façon très claire que dès 3 ans, les filles accordent davantage d'intérêt à leur apparence que les garçons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ddf3003-86ef-3cca-b786-f2e54562fbf4",
                                        "entry_id": "bb691982-929a-39ee-b33d-709559e3fdf6",
                                        "glosses": [
                                            "Vraisemblance, probabilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d84a304b-dc84-4410-990f-d3826d5a23c3",
                                                "sense_id": "1ddf3003-86ef-3cca-b786-f2e54562fbf4",
                                                "text": "Selon toute apparence, la dissémination des animaux fixés est toujours due à des œufs qui, sortis du sein de la mère, vont éclore au loin, […]."
                                            },
                                            {
                                                "example_id": "d8d64204-befa-4305-a2c1-8c94cbe5207e",
                                                "sense_id": "1ddf3003-86ef-3cca-b786-f2e54562fbf4",
                                                "text": "L’intégrité journalistique repose largement sur l’absence de conflits de loyautés, et même sur l’absence d’apparence de tels conflits."
                                            },
                                            {
                                                "example_id": "cff0a4a1-2f9d-42f3-af06-71b2d486d679",
                                                "sense_id": "1ddf3003-86ef-3cca-b786-f2e54562fbf4",
                                                "text": "Il a réussi contre toute apparence. Selon toute apparence, vous recevrez bientôt de ses nouvelles."
                                            },
                                            {
                                                "example_id": "9a1494d4-49f0-448d-ac61-fe5f2b28f382",
                                                "sense_id": "1ddf3003-86ef-3cca-b786-f2e54562fbf4",
                                                "text": "Les apparences étant les mêmes de part et d’autre, on ne sait à quoi se décider."
                                            },
                                            {
                                                "example_id": "8766aeb0-db5d-4e89-8815-31dc7a13c173",
                                                "sense_id": "1ddf3003-86ef-3cca-b786-f2e54562fbf4",
                                                "text": "Il y a apparence, il y a quelque apparence, il y a grande apparence que cela arrivera."
                                            },
                                            {
                                                "example_id": "a4d34f89-e020-4472-ab80-ec2033fd2744",
                                                "sense_id": "1ddf3003-86ef-3cca-b786-f2e54562fbf4",
                                                "text": "Il y a bien de l’apparence qu’il n’en savait rien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
