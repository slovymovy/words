                        "glosses": [
                            "Toxine produite par le dinoflagellé de nom scientifique Karenia selliformis, pouvant provoquer des intoxications suite à la consommation de coquillages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b92252c0-1a5a-42d6-8808-45dc6de92293",
                                "sense_id": "ef418f0b-bffa-3aa2-a9cb-b9b785b07f30",
                                "text": "Certaines phycotoxines marines de la famille des spiroimines, comme la gymnodimine et les spirolides sont produites par des dinoflagellés et se concentrent dans les mollusques filtreurs."
                            },
                            {
                                "example_id": "7078a08e-b4c0-44e4-8577-5acf393ac168",
                                "sense_id": "ef418f0b-bffa-3aa2-a9cb-b9b785b07f30",
                                "text": "Les gymnodimines, les spirolides, les pinatoxines et les ptériatoxines constituent une famille de toxines d'origine marine de structures complexes, produites en faibles quantités par des microorganismes marins appelés dinoflagellés."
                            }
                        ]
                    }
