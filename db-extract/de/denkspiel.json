                "senses": [
                    {
                        "sense_id": "4069aab3-39ca-3665-93d1-775d99e669f8",
                        "entry_id": "0469bf40-6fbc-300a-b31c-609e8f8f311d",
                        "glosses": [
                            "spielspezifisch: Spielgeschehen, das auf das Beanspruchen intellektueller Fähigkeiten ausgerichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71a3b398-0e37-4da5-bea6-ce94fdf13498",
                                "sense_id": "4069aab3-39ca-3665-93d1-775d99e669f8",
                                "text": "„Im Rahmen von Wort- und Satzkomik bewegen sich alle Wortspiele vom einfachen geistlosen Kalauer bis hin zum geistreichen Denkspiel, […]“"
                            },
                            {
                                "example_id": "475a7271-2176-4463-be2b-c9065683ffe4",
                                "sense_id": "4069aab3-39ca-3665-93d1-775d99e669f8",
                                "text": "„Denn gänzlich neue Denk-Spiele gibt es offenbar so wenig wie eine völlig neue Art des Denkens.“"
                            },
                            {
                                "example_id": "ea71582e-95b7-4ff2-bd94-71373f96af51",
                                "sense_id": "4069aab3-39ca-3665-93d1-775d99e669f8",
                                "text": "„Um faszinieren zu können, setzen Denkspiele allerdings ein Interesse an der Mobilisierung der Verstandeskräfte und eine gewisse Verfügbarkeit von Wissen voraus.“"
                            },
                            {
                                "example_id": "69514492-44eb-4e43-b8be-963c4d135817",
                                "sense_id": "4069aab3-39ca-3665-93d1-775d99e669f8",
                                "text": "„Denkspiele sind eher beschauliche Spiele.“"
                            },
                            {
                                "example_id": "cac6f4ef-00ed-4250-b0d2-9a7653e0f444",
                                "sense_id": "4069aab3-39ca-3665-93d1-775d99e669f8",
                                "text": "„Von Nintendos Denkspiel gingen in Deutschland etwa eine halbe Millionen Exemplare über die Ladentische.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "535af86d-32df-33bd-b01d-f6d2262143c7",
                        "entry_id": "0469bf40-6fbc-300a-b31c-609e8f8f311d",
                        "glosses": [
                            "allgemein: gedankliche Vorstellung, gedankliches Abwägen von Möglichkeiten, Jonglieren mit Gedanken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e01e8ee1-524f-466d-92a1-9f625928b76c",
                                "sense_id": "535af86d-32df-33bd-b01d-f6d2262143c7",
                                "text": "„Er hat sein eigenes Maß einer Gegensätzlichkeit im Sittlichen, und das bietet er mit diesem Buch an: Denkspiel, Bildungspanorama und Ausrufen unserer Fragilität in einem.“"
                            },
                            {
                                "example_id": "813eeda8-22ee-40f1-ac91-0a0da0941875",
                                "sense_id": "535af86d-32df-33bd-b01d-f6d2262143c7",
                                "text": "„Der Roman seiner Jugend ist dagegen ein eigenartiges und konsequentes Denkspiel über die Gewalt geworden.“"
                            },
                            {
                                "example_id": "27c6292c-11a3-405e-bca1-6f0f879097aa",
                                "sense_id": "535af86d-32df-33bd-b01d-f6d2262143c7",
                                "text": "„Armer Colin Powell, der nun weltweit beschwichtigen muss: War ja nur ein Denkspiel, keine Strategie.“"
                            },
                            {
                                "example_id": "92390afc-41ce-4b04-bffd-94af7bc940f6",
                                "sense_id": "535af86d-32df-33bd-b01d-f6d2262143c7",
                                "text": "„Die vielen Denkspiele haben die Neugier der Engländer geweckt, und plötzlich taucht auf der London-Karte in ihren Köpfen auch der Süden der Hauptstadt wieder auf.“"
                            },
                            {
                                "example_id": "e66b882d-a323-4a04-9989-0df1e6ff578b",
                                "sense_id": "535af86d-32df-33bd-b01d-f6d2262143c7",
                                "text": "„Ein Kaleidoskop bildnerischer Spitzfindigkeit wird daraus, Denkspiel und Augenlust für Fortgeschrittene.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
