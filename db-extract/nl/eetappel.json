                        "glosses": [
                            "vrucht van de appelboom, Malus domestica, geteeld om door mensen te worden opgegeten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c0b5b1f-58da-437e-8dde-6ca8c862ffb4",
                                "sense_id": "37eecad2-88cf-365b-9eeb-450527ae41bc",
                                "text": "De Jonagold is een goede eetappel."
                            },
                            {
                                "example_id": "92771514-bead-433c-9045-bbd00ff50c6a",
                                "sense_id": "37eecad2-88cf-365b-9eeb-450527ae41bc",
                                "text": "'t Is een goede exportappel, een goede eetappel, een goede moesappel, een goede bewaarappel en een vruchtbare appel."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d580ad1-ef6a-317d-867f-2cd88cc2f69a",
                        "entry_id": "557a0741-8b14-3df9-acc7-c24275a1da03",
                        "glosses": [
                            "bepaald soort boom of struik, Malus domestica, vaak in boomgaarden geplant om zijn vruchten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76005de6-62c3-44cf-bbd9-4b8d79de4597",
                                "sense_id": "7d580ad1-ef6a-317d-867f-2cd88cc2f69a",
                                "text": "Veel meer dan wilde appel vindt men verwilderde vormen van eetappel, die opgeslagen zijn uit weggegooide klokhuizen en vruchten. In nogal wat gevallen hebben ze intermediaire kenmerken tussen de gekweekte eetappel en de wilde appel, maar gewoonlijk zijn ze goed te onderscheiden, zeker in de vruchtperiode."
                            }
                        ]
                    }
