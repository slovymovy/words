                                        "entry_id": "1ab8841a-3583-34e1-9b3c-1224c957e14c",
                                        "glosses": [
                                            "Désigne une personne sage, honnête, vertueuse."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "365375e8-00a3-4d3d-ba56-b0c7484fcfc7",
                                                "sense_id": "d3b994ad-e0bf-3f62-a1c0-edf3663bfa99",
                                                "text": "On n'a jamais très bien compris ce qu'on reprochait aux poses très prudes et un rien mélancolique de l'étudiante génépiste qui s'y était prêtée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b3215a7-134d-3f4e-bc53-1ecf9ff23856",
                                        "entry_id": "1ab8841a-3583-34e1-9b3c-1224c957e14c",
                                        "glosses": [
                                            "Qui a l’air et les manières de la pruderie."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fe6bd06-b163-4a1c-8ba4-ccf1a0bfe1b4",
                                                "sense_id": "5b3215a7-134d-3f4e-bc53-1ecf9ff23856",
                                                "text": "Elle a toujours passé pour prude."
                                            },
                                            {
                                                "example_id": "a615b167-f5cf-443c-9598-3ace66f6b3ff",
                                                "sense_id": "5b3215a7-134d-3f4e-bc53-1ecf9ff23856",
                                                "text": "Une mine, un extérieur prude."
                                            },
                                            {
                                                "example_id": "9d9903f8-264a-4b2b-8f1c-303c2959fa1c",
                                                "sense_id": "5b3215a7-134d-3f4e-bc53-1ecf9ff23856",
                                                "text": "Ce jeune homme a un petit air prude dont on serait la dupe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3010513e-29a3-3896-a50e-028b2b9e1f46",
                                        "entry_id": "05fe0629-4c8f-3854-aaba-61724a36d7c3",
                                        "glosses": [
                                            "Personne pleine de pudeur, de retenue. — Note d’usage : Se dit surtout pour les femmes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1494c54d-db3a-46c5-b0cd-3c104815a417",
                                                "sense_id": "3010513e-29a3-3896-a50e-028b2b9e1f46",
                                                "text": "Songeant qu'il serait ridicule de se conduire en prude, il serra vigoureusement la main du corsaire, […]."
                                            },
                                            {
                                                "example_id": "1c097892-edbc-4e4e-b4c0-634ed64f6b9e",
                                                "sense_id": "3010513e-29a3-3896-a50e-028b2b9e1f46",
                                                "text": "Solange, Dieu merci! n'est ni une prude, ni une sotte, et elle vous saura gré de votre franchise."
                                            },
                                            {
                                                "example_id": "890cdaf1-9602-4de1-a3e6-2eb53f1d8a8b",
                                                "sense_id": "3010513e-29a3-3896-a50e-028b2b9e1f46",
                                                "text": "Elmire : J’aime qu’avec douceur nous nous montrions sages ;\nEt ne suis point du tout pour ces prudes sauvages\nDont l’honneur est armé de griffes et de dents,\nEt veut au moindre mot dévisager les gens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
