                "translations": [
                    {
                        "translation_id": "01dc6422-11bc-4d0e-837d-850f6c7864ed",
                        "source_entry_id": "5d935ad5-915d-3b06-8f37-522def1a0e0c",
                        "source_sense_id": "2bd99554-9203-3571-a447-42aea27200cc",
                        "source_sense_description": "Handel mit Kindern",
                        "target_lang_word": "child trafficking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "child trafficking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a25bb09-91d4-3564-a450-4e04b11d96ed",
                                        "entry_id": "7fec83ec-81d8-32b8-a9f8-df20be68ac1e",
                                        "glosses": [
                                            "A form of human trafficking that involves the kidnapping of a child for purposes of exploitation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eb3b593-9332-4abe-9a3b-77c2b453f961",
                                                "sense_id": "2a25bb09-91d4-3564-a450-4e04b11d96ed",
                                                "text": "This would make the distinction extremely delicate in some cases between child trafficking and migration for employment of adolescents above the minimum working age."
                                            },
                                            {
                                                "example_id": "34372778-777d-4067-9efa-b532b22a8c16",
                                                "sense_id": "2a25bb09-91d4-3564-a450-4e04b11d96ed",
                                                "text": "Stressing the link between 'child trafficking' and the sex industry operates to underscore the profoundly damaging consequences of 'trafficking' and to unequivocally construct those involved as either victims or villains."
                                            },
                                            {
                                                "example_id": "1eff4074-aea1-4699-938f-0d67146a7933",
                                                "sense_id": "2a25bb09-91d4-3564-a450-4e04b11d96ed",
                                                "text": "He wants child trafficking survivors to be included in organisations fighting against the crime, and to participate in every committee that government forms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
