                            {
                                "example_id": "a0cd4e98-03ae-4dd2-8d25-3402dc5cb45a",
                                "sense_id": "b22ff4e4-8e5e-39f9-afdd-34c520518cc9",
                                "text": "Samen met zijn maat uit Buurse gold de coureur die dit jaar nationaal crosskampioen in de Twinshock-klasse werd - \"nostalgische motoren met dubbele schokbrekers, luchtgekoelde motor en ouderwetse trommelremmen\" - als een van de grote kanshebbers."
                            }
                        ]
                    },
