                        "entry_id": "caa7020f-e7e7-3c5a-bc82-88d022d56774",
                        "glosses": [
                            "abnormal ausgeprägter Wuchs, weit über den Durchschnitt hinausgehende Körpergröße (oft als Folge von Tumoren, Störungen des Hormonhaushalts und Ähnlichem)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66767d5b-cf63-42d3-b278-07c45e1a56d1",
                                "sense_id": "23aba3ed-b179-3a47-9925-6a63ede20b6c",
                                "text": "„Höchste Langlebigkeit würde ihren Körperbau und ihren Riesenwuchs erklären.“"
                            }
