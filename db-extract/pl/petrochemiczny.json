                                        "glosses": [
                                            "Any chemical derived from petroleum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e5d8e4d-7278-48c8-90e0-692490f74e85",
                                                "sense_id": "6ccb69bd-3d4f-3964-b991-31abf44edbd0",
                                                "text": "Another is a Bloomberg project we're participating in that looks beyond petrochemicals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85cf5497-03ab-30ac-8bb0-17b44a71f4e4",
                                        "entry_id": "7338b6c2-6443-3137-829a-fab0c54a4264",
                                        "glosses": [
                                            "Any chemical derived from any of the fossil fuels: petroleum, natural gas, or coal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbf52472-7f51-4ac4-89ab-ac74d75c620b",
                                                "sense_id": "85cf5497-03ab-30ac-8bb0-17b44a71f4e4",
                                                "text": "As the prices of petroleum, natural gas, and coal fluctuate over the years, the petrochemical industry can to some extent switch feedstocks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "petrochemical",
