                            {
                                "example_id": "e8d5eb56-b69d-47f4-ad5c-00388f608e94",
                                "sense_id": "f6da68d8-6ba2-391d-aa63-e5d5e752a5bd",
                                "text": "„Die Internistin und Psychotherapeutin Dr. Cora Weber spricht […] über die Auswirkungen von psychischen Erkrankung auf den Körper.“"
                            },
                            {
                                "example_id": "1da4114a-fdb7-4ee4-b2a6-2b3b3c74a550",
                                "sense_id": "f6da68d8-6ba2-391d-aa63-e5d5e752a5bd",
                                "text": "Cora und Robert haben fünf Kinder."
                            },
                            {
                                "example_id": "476d4b36-a890-473c-ab9e-14d74426a97d",
                                "sense_id": "f6da68d8-6ba2-391d-aa63-e5d5e752a5bd",
                                "text": "Cora spielt gerne Tennis."
                            },
                            {
                                "example_id": "1fd062df-356c-44fc-9cae-3e00a6ab8471",
                                "sense_id": "f6da68d8-6ba2-391d-aa63-e5d5e752a5bd",
                                "text": "Haben sie schon mal vom Vornamen Cora gehört?"
                            },
                            {
                                "example_id": "69b12ccd-07d3-41ff-9031-fc451e8e0b7b",
                                "sense_id": "f6da68d8-6ba2-391d-aa63-e5d5e752a5bd",
                                "text": "Cora Lehmann ist eine gute Lehrerin."
                            },
                            {
                                "example_id": "bd3cd114-bd15-46c4-b049-3ee4020a93ac",
                                "sense_id": "f6da68d8-6ba2-391d-aa63-e5d5e752a5bd",
                                "text": "Cora Müller wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7b22d841-4b2c-42bb-9edb-d995ee378c95",
                                "sense_id": "f6da68d8-6ba2-391d-aa63-e5d5e752a5bd",
                                "text": "„Bei Rückkehrern aus Risikogebieten habe sich nur etwa die Hälfte ordnungsgemäß bei den Gesundheitsämtern gemeldet, erklärte Cora von der Heide, Juristin der Kreisverwaltung Rendsburg-Eckernförde […]“"
                            },
                            {
                                "example_id": "a6273e0a-10ad-4ed9-aecf-27a442682bc7",
                                "sense_id": "f6da68d8-6ba2-391d-aa63-e5d5e752a5bd",
                                "text": "„»Ein mit Kuka vergleichbarer chinesischer Roboterhersteller würde nicht unter ausländische Kontrolle geraten«, schrieb Cora Jungbluth, verantwortliche Autorin der Studie.“"
                            },
                            {
                                "example_id": "d68e0398-0c2b-4235-8c2e-0f9ca9859258",
                                "sense_id": "f6da68d8-6ba2-391d-aa63-e5d5e752a5bd",
                                "text": "„«Bridge ist ein faszinierendes Kartenspiel, aber nicht ganz einfach zu lernen», sagt Cora Marina Ring.“"
                            },
                            {
                                "example_id": "26e339e0-1dc4-4a36-8c08-4297693067c5",
                                "sense_id": "f6da68d8-6ba2-391d-aa63-e5d5e752a5bd",
                                "text": "„Eine Forschergruppe um die beiden Mediziner Cora Koch von der Uniklinik Freiburg und Klaus Lieb von der Uniklinik Mainz haben nun in der renommierten US-amerikanischen Fachzeitschrift \"Plos Medicine\" eine Untersuchung unter 7000 Ärztinnen und Ärzten in Deutschland veröffentlicht.“"
                            }
                        ],
