                                ]
                            },
                            {
                                "target_word": "fanatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4da81e3-1862-3b1e-8c35-60b76c765393",
                                        "entry_id": "09a88fa9-e2be-3cb0-9783-0bf329754ddb",
                                        "glosses": [
                                            "A person who is zealously enthusiastic for some cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e79eff5-6a1f-4a51-871b-aa79ad2f5755",
                                                "sense_id": "e4da81e3-1862-3b1e-8c35-60b76c765393",
                                                "text": "The reclusive tycoon calling himself the Illusive Man is a human nationalist focused on advancing human interests, whatever the cost to non-humans. The Citadel Council regards him as a fanatic posing a serious threat to galactic security."
                                            },
                                            {
                                                "example_id": "80a0dc6f-fd15-4d3c-85b0-24dd9c7f1ce7",
                                                "sense_id": "e4da81e3-1862-3b1e-8c35-60b76c765393",
                                                "text": "A zealot can't change his mind. A fanatic can't change his mind and won't change the subject. —Winston Churchill (attributed)"
                                            },
                                            {
                                                "example_id": "52041bca-f25d-4856-badb-d05e36c8be55",
                                                "sense_id": "e4da81e3-1862-3b1e-8c35-60b76c765393",
                                                "text": "A fanatic is one who redoubles his effort when he has forgotten his aim. —George Santayana"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
