                    {
                        "sense_id": "ddb2976f-a21f-3030-9488-137d49ea333b",
                        "entry_id": "9f6b5db4-a72b-327e-bd86-c39404fc4b5f",
                        "glosses": [
                            "register waarin staat wie hoeveel aandelen van een bedrijf bezit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e27134fe-5bc1-4d48-a538-efe5d15f5e57",
                                "sense_id": "ddb2976f-a21f-3030-9488-137d49ea333b",
                                "text": "„In 1720 waren we al genoteerd in Rotterdam, toen tegen een waarde van 120 ton aan goudstaven.” In het beursgebouw overhandigde Baeten een replika van het aandelenregister van toen aan Euronext-topman Maurice van Tilburg."
                            },
                            {
                                "example_id": "7ce7c48e-b067-4a9c-b9e8-e3478fabe0bc",
                                "sense_id": "ddb2976f-a21f-3030-9488-137d49ea333b",
                                "text": "De oorzaak was eenvoudig, haar grootaandeelhouder Fujitsu was in de problemen gekomen en was als gevolg daarvan gedwongen haar belang af te bouwen. Fanuc had, op basis van haar aandeelhoudersregister, geconstateerd dat wij al lang een stabiele aandeelhouder waren en wilde graag vernemen wat wij vonden dat het bedrijf beter kon doen haar communicatie: pas toen de onderlinge verwevenheid minder werd, deed het bedrijf de luiken open en ontdekte dat er nog andere partijen waren die van belang zouden kunnen zijn."
                            }
                        ]
                    }
