                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn du die genaue Bedeutung des Begriffs nicht kennst, kannst du sie im Wörterbuch <w>nachlesen</w>."
                        },
                        {
                            "text": "Ich bin mir bei der Jahreszahl nicht sicher, deshalb <w>lese</w> ich das in meinen Notizen <w>nach</w>."
                        }
                    ],
                    "synonyms": [
                        "nachschlagen"
                    ],
