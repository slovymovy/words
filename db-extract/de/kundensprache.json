                "senses": [
                    {
                        "sense_id": "b7242348-08ab-311e-a48e-ec9be8e49b46",
                        "entry_id": "3f24db3f-e175-34f1-9e87-8e7dff12752f",
                        "glosses": [
                            "Geheimsprache von wandernden Handwerksgesellen oder Landstreichern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99515931-e12a-4a86-9850-53ced452e122",
                                "sense_id": "b7242348-08ab-311e-a48e-ec9be8e49b46",
                                "text": "„Den Jajem »Wein« kennt man überraschenderweise nur in Bad Kreuznach und in Düren-Pier; im Rheinischen Wörterbuch wird das Wort der Kundensprache, also dem Code der wandernden Handwerksgesellen zugerechnet.“"
                            },
                            {
                                "example_id": "7ae7d438-d908-4543-b0a3-9e502bfb8be3",
                                "sense_id": "b7242348-08ab-311e-a48e-ec9be8e49b46",
                                "text": "„Die letzte dieser Benennungen kommt auch in der Kundensprache vor und bedeutet dort eine gewisse Art von Gefängnissuppe aus Hülsenfruchtgemenge.“"
                            },
                            {
                                "example_id": "4f12a117-a607-45ae-adb0-8af9d42e6172",
                                "sense_id": "b7242348-08ab-311e-a48e-ec9be8e49b46",
                                "text": "„So bezeichnet etwa der Ausdruck 'Kunde' sowohl den Handwerksburschen als auch den Bettler: der Begriff \"Kundensprache“ umfaßt dementsprechend ebenso die Sprache der wandernden Gesellen wie die der Landstreicher und Gauner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
