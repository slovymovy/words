{
    "word_family": [
        "crammer",
        "cramming"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "12022503-976e-30d3-a2bf-383e1879d28f",
                    "sense_definition": "To press or force something into a space until it is completely full.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stuffing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>cram</w> their clothes into the small suitcase before leaving for the trip.",
                            "target_lang_translations": {
                                "zh": "出发旅行前，他们把衣服<w>塞</w>进了小行李箱里。"
                            }
                        },
                        {
                            "text": "The train was so busy that passengers were <w>crammed</w> into every available space.",
                            "target_lang_translations": {
                                "zh": "火车上人太多，乘客被<w>挤</w>在每一个可用的空间里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stuff",
                        "pack",
                        "jam"
                    ],
                    "common_phrases": [
                        "cram into",
                        "cram with"
                    ],
                    "target_lang_definitions": {
                        "zh": "将某物强行塞入空间，直到完全填满。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "塞",
                                "target_lang_sense_clarification": "指将物体填入狭窄空间"
                            },
                            {
                                "target_lang_word": "挤",
                                "target_lang_sense_clarification": "指在拥挤的环境中强行进入"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45a6ab8d-1778-3f81-ad91-29b0cc037571",
                    "sense_definition": "To study intensely and hastily in preparation for an upcoming examination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "studying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students often <w>cram</w> for their final exams during the last few days.",
                            "target_lang_translations": {
                                "zh": "学生们经常在最后几天为期末考试<w>突击学习</w>。"
                            }
                        },
                        {
                            "text": "It is better to study regularly than to <w>cram</w> all night before the test.",
                            "target_lang_translations": {
                                "zh": "平时规律学习比考前通宵<w>突击</w>要好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "swot"
                    ],
                    "common_phrases": [
                        "cram for"
                    ],
                    "target_lang_definitions": {
                        "zh": "为即将到来的考试进行突击式、匆忙的学习。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "突击学习",
                                "target_lang_sense_clarification": "指考前短时间内高强度复习"
                            },
                            {
                                "target_lang_word": "临时抱佛脚",
                                "target_lang_sense_clarification": "指平时不努力，临近考试才匆忙准备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "233fbace-3622-3570-9197-0d458c913591",
                    "sense_definition": "To eat until one is completely full or satisfied.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry children <w>crammed</w> themselves with snacks after school.",
                            "target_lang_translations": {
                                "zh": "放学后，饥肠辘辘的孩子们用零食把自己<w>塞</w>饱了。"
                            }
                        },
                        {
                            "text": "Do not <w>cram</w> yourself with sweets right before dinner.",
                            "target_lang_translations": {
                                "zh": "晚饭前不要<w>塞</w>太多甜食。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gorge",
                        "stuff"
                    ],
                    "target_lang_definitions": {
                        "zh": "吃得过饱或狼吞虎咽。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "塞满",
                                "target_lang_sense_clarification": "指把胃部填满"
                            },
                            {
                                "target_lang_word": "狼吞虎咽",
                                "target_lang_sense_clarification": "指吃得又快又多"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ceaeb1f3-f339-3c71-babd-f6cacaa7cfb3",
                    "sense_definition": "To tell a lie or speak untruthfully.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>cram</w> his way out of trouble by making up a story.",
                            "target_lang_translations": {
                                "zh": "他试图通过编造故事来<w>撒谎</w>以摆脱困境。"
                            }
                        },
                        {
                            "text": "It is wrong to <w>cram</w> to your friends about what happened.",
                            "target_lang_translations": {
                                "zh": "对朋友就发生的事情<w>撒谎</w>是不对的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lie"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "dated usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "说谎或言不由衷。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "撒谎",
                                "target_lang_sense_clarification": "指说假话"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b297736d-73e9-3fe1-b512-b5459b3ef0c7",
                    "sense_definition": "Information that has been memorized quickly and under pressure.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "studying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student relied on a last-minute <w>cram</w> to pass the history test.",
                            "target_lang_translations": {
                                "zh": "这名学生靠最后一刻的<w>突击复习</w>通过了历史考试。"
                            }
                        },
                        {
                            "text": "A quick <w>cram</w> is rarely as effective as long-term study.",
                            "target_lang_translations": {
                                "zh": "短时间的<w>突击复习</w>通常不如长期学习有效。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在压力下快速记忆的信息。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "突击复习",
                                "target_lang_sense_clarification": "指考前短时间的集中记忆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae7a7dfc-4010-3f4b-9ac4-f7faf5fe51c6",
                    "sense_definition": "A lie or a false statement.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop telling such <w>crams</w> and tell the truth for once.",
                            "target_lang_translations": {
                                "zh": "别再讲那些<w>谎话</w>了，说一次真话吧。"
                            }
                        },
                        {
                            "text": "Nobody believed his <w>crams</w> about winning the lottery.",
                            "target_lang_translations": {
                                "zh": "没人相信他关于中彩票的<w>谎话</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lie",
                        "falsehood"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "dated usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "谎言或虚假陈述。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "谎话",
                                "target_lang_sense_clarification": "指不真实的话"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "cc7d34c3-5922-3d13-8f23-c1020320078b",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Cram</w> is our new history teacher.",
                            "target_lang_translations": {
                                "zh": "<w>克拉姆</w>先生是我们新的历史老师。"
                            }
                        },
                        {
                            "text": "The research paper was written by Dr. <w>Cram</w>.",
                            "target_lang_translations": {
                                "zh": "这篇研究论文是由<w>克拉姆</w>博士撰写的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "克拉姆",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}