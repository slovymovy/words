                "senses": [
                    {
                        "sense_id": "389658ce-60af-3b44-b0b1-7bcc6544a53d",
                        "entry_id": "8a4ed0fc-6f15-383c-bf1e-04fb99b9f2d3",
                        "glosses": [
                            "Person, die beruflich Cartoons zeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf45226c-423f-4a49-b260-b2c9d18177af",
                                "sense_id": "389658ce-60af-3b44-b0b1-7bcc6544a53d",
                                "text": "Joscha Sauer ist ein deutscher Cartoonist."
                            },
                            {
                                "example_id": "51ed0c79-ac41-48c0-a30c-aaf613874d01",
                                "sense_id": "389658ce-60af-3b44-b0b1-7bcc6544a53d",
                                "text": "„In Wirklichkeit seien die Sagas aber ziemlich lang erzählte Witze, die keiner richtig ernst nehmen könne, meint der Cartoonist.“"
                            },
                            {
                                "example_id": "7d87be71-bc9a-48b3-b118-e1207839ffb7",
                                "sense_id": "389658ce-60af-3b44-b0b1-7bcc6544a53d",
                                "text": "„Rolf König, Cartoonist und Drehbuchautor, einer der wichtigsten deutschen Zeichner der Comic-Kunst, berühmt geworden spätestens mit »Der bewegte Mann« als Comic und als Film, kommentiert im Interview die Briefmarkenedition von Tom of Finland.“"
                            },
                            {
                                "example_id": "cafba581-0249-4d55-8c3d-fa7b70b356f6",
                                "sense_id": "389658ce-60af-3b44-b0b1-7bcc6544a53d",
                                "text": "„Daher hat die bisher ultimativste Antwort der deutsche Cartoonist Til Mette gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
