            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04d589a8-7e62-3ba7-8574-115980c9f6ee",
                    "sense_definition": "het gezicht tot een grijns vertrekken, vaak als uiting van spot, plezier of boosaardigheid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gezichtsuitdrukking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zat de hele tijd breed te <w>grijnzen</w> toen hij het goede nieuws hoorde.",
                            "target_lang_translations": {
                                "en": "He was <w>grinning</w> broadly the whole time when he heard the good news.",
                                "fr": "Il n'arrêtait pas de <w>sourire jusqu'aux oreilles</w> en apprenant la bonne nouvelle."
                            }
                        },
                        {
                            "text": "De gemene schurk begon te <w>grijnzen</w> terwijl hij zijn plan uitlegde.",
                            "target_lang_translations": {
                                "en": "The mean villain started to <w>smirk</w> while he explained his plan.",
                                "fr": "Le méchant scélérat s'est mis à <w>ricaner</w> tout en expliquant son plan."
                            }
                        }
                    ],
                    "synonyms": [
                        "lachen"
                    ],
                    "common_phrases": [
                        "breed grijnzen",
                        "gemeen grijnzen",
                        "staan te grijnzen"
                    ],
                    "target_lang_definitions": {
                        "en": "to pull one's face into a grin, often as an expression of mockery, pleasure, or malice",
                        "fr": "Afficher un large sourire, souvent par moquerie, malice ou satisfaction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to grin",
                                "target_lang_sense_clarification": "to smile broadly"
                            },
                            {
                                "target_lang_word": "to smirk",
                                "target_lang_sense_clarification": "to smile in a smug or conceited way"
                            },
                            {
                                "target_lang_word": "to sneer",
                                "target_lang_sense_clarification": "to smile mockingly or with contempt"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sourire jusqu'aux oreilles",
                                "target_lang_sense_clarification": "sourire très largement"
                            },
                            {
                                "target_lang_word": "ricaner",
                                "target_lang_sense_clarification": "sourire de manière moqueuse ou narquoise"
                            },
                            {
                                "target_lang_word": "faire un grand sourire",
                                "target_lang_sense_clarification": "sourire largement avec plaisir"
                            }
                        ]
