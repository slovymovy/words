                    }
                ],
                "senses": [
                    {
                        "sense_id": "75217363-2d06-3e03-9fd0-90ef060f65e4",
                        "entry_id": "55033f71-67b8-3789-a364-eed8a3a71465",
                        "glosses": [
                            "One of a series of wedge-shaped bricks or stones forming an arch or vault."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53fe0a63-e055-41b7-9698-1ace0524506f",
                                "sense_id": "75217363-2d06-3e03-9fd0-90ef060f65e4",
                                "text": "It is the voussoir depth in a real arch which enables the arch to carry wider ranges of loading; a large number of different idealized centre-line arches can be contained within a given practical profile. ...[T]his must be so, or no mediaeval bridge would have survived its decentering."
                            },
                            {
                                "example_id": "fda9f184-ba65-48df-a6a4-adf77e116d38",
                                "sense_id": "75217363-2d06-3e03-9fd0-90ef060f65e4",
                                "text": "Other areas have mortar joints missing, including between the voussoir blocks forming the edge of the arches on either side of the pier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb35074b-4d99-484d-bfdd-65aa2bd3231c",
                        "source_entry_id": "55033f71-67b8-3789-a364-eed8a3a71465",
                        "source_sense_id": "75217363-2d06-3e03-9fd0-90ef060f65e4",
                        "source_sense_description": "wedge-shaped brick or stone",
                        "target_lang_word": "voussoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voussoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07446d21-0a30-3e53-8562-9526ee6a2ac3",
                                        "entry_id": "ff9079dd-ea88-3ed4-9402-65999dd04cb5",
                                        "glosses": [
                                            "Chacune des pierres qui forment le cintre d’une voûte, d’un arc ou même la structure d'un tunnel construit par un tunnelier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e592752-d0e4-4d28-80cd-4f2ebc4346d1",
                                                "sense_id": "07446d21-0a30-3e53-8562-9526ee6a2ac3",
                                                "text": "Les voussoirs d’une arcade."
                                            },
                                            {
                                                "example_id": "3d4aebfe-8283-49f6-a233-84ff99f6cb2f",
                                                "sense_id": "07446d21-0a30-3e53-8562-9526ee6a2ac3",
                                                "text": "La porte plein-cintre, dont la voûte est composée de voussoirs bien agencés, est une oeuvre évidemment chrétienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e992db5-a2b9-31c6-b4a9-9a3c7988e6ac",
                                        "entry_id": "ff9079dd-ea88-3ed4-9402-65999dd04cb5",
                                        "glosses": [
                                            "Éléments préfabriqués utilisés pour la réalisation d’un tablier de pont."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c702a32-f141-45b3-a25c-fd34f75c0a3d",
                                                "sense_id": "3e992db5-a2b9-31c6-b4a9-9a3c7988e6ac",
                                                "text": "[…] il aura fallu mêler plusieurs hauteurs d’élévation du pont et la pose de longues travées (jusqu’à 180 mètres de longueur au lieu de 75 mètres pour d’autres, soit les plus grandes jamais réalisées en voussoirs préfabriqués)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
