            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3a6bdb7c-3dd8-3b6e-be2d-f99aee2d00f8",
                    "sense_definition": "Qui a une valeur, une quantité ou une intensité suffisante pour ne pas être négligé ; important, notable.",
