                                        "sense_id": "de38aac9-6d66-3389-a40d-88ea6d0482c8",
                                        "entry_id": "4143c7d0-fba7-33cd-b874-84cfa26190e9",
                                        "glosses": [
                                            "S’empiffrer, manger gloutonnement, avec excès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fb52506-6a0e-4321-8515-10dadfea9e21",
                                                "sense_id": "de38aac9-6d66-3389-a40d-88ea6d0482c8",
                                                "text": "Ceux qui se lèvent tôt\npour que se lèvent tard\net se gavent\nse dandinent\nse pommadent\nse désodorisent\nse parfument\nse lotionnent\nse maquillent\nse gargarisent\nse congratulent\nse jalousent\nse débinent\ns’enrichissent\nd’autres"
                                            },
                                            {
                                                "example_id": "3bb9f5af-1ca4-4b10-a4eb-49952caf8a68",
                                                "sense_id": "de38aac9-6d66-3389-a40d-88ea6d0482c8",
                                                "text": "Se gaver de bonbons. — Les boulimiques, après s’être gavés de nourriture, se font habituellement vomir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e90ae29f-074e-3448-9be8-2b947b4e81a3",
                                        "entry_id": "4143c7d0-fba7-33cd-b874-84cfa26190e9",
                                        "glosses": [
                                            "Remplir, combler son esprit de."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8fed955-3456-4934-b691-137c4803650e",
                                                "sense_id": "e90ae29f-074e-3448-9be8-2b947b4e81a3",
                                                "text": "Se gaver de mangas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "497d335f-e320-3df6-97ea-97dfff375d8e",
                                        "entry_id": "4143c7d0-fba7-33cd-b874-84cfa26190e9",
                                        "glosses": [
                                            "Gagner énormément d’argent, réaliser de gros profits, s’enrichir à l’excès."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c7863d6-9104-4a55-83a5-41aeb36d44e4",
                                                "sense_id": "497d335f-e320-3df6-97ea-97dfff375d8e",
                                                "text": "Avec la crise grecque, de nombreux spéculateurs se gavent."
                                            }
                                        ]
