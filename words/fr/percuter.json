    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "617d3394-6f07-3d4b-b5af-da4d3754f834",
                    "sense_definition": "Heurter ou frapper violemment un obstacle, un véhicule ou une personne.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "choc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La voiture a dérapé sur le verglas avant de <w>percuter</w> un arbre au bord de la route."
                        },
                        {
                            "text": "Deux trains de marchandises se sont <w>percutés</w> hier soir près de la petite gare."
                        }
                    ],
                    "synonyms": [
                        "heurter"
                    ],
                    "common_phrases": [
                        "percuter un arbre",
                        "percuter de plein fouet",
                        "se percuter"
                    ]
                },
                {
                    "sense_id": "bb2b7853-c79b-3902-843e-76e1286d564d",
                    "sense_definition": "Comprendre soudainement ou se rendre compte d'une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comprehension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il lui a fallu plusieurs minutes pour enfin <w>percuter</w> ce que son collègue lui expliquait."
                        },
                        {
                            "text": "J'ai mis du temps à <w>percuter</w>, mais j'ai fini par comprendre sa plaisanterie."
                        }
                    ],
                    "synonyms": [
                        "imprimer"
                    ],
                    "common_phrases": [
                        "mettre du temps à percuter",
                        "finir par percuter"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "a531115c-b0c5-394f-832e-5c6adcb71d16",
                    "sense_definition": "Déclencher un appareil ou une charge en frappant vivement un mécanisme ou une amorce.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mecanisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pompier a dû rapidement <w>percuter</w> l'extincteur afin d'éteindre le départ de flammes."
                        },
                        {
                            "text": "Il convient de retirer la goupille de sécurité avant de <w>percuter</w> la cartouche de gaz."
                        }
                    ],
                    "common_phrases": [
                        "percuter un extincteur"
                    ]
                },
                {
                    "sense_id": "4d204fb1-c915-3cbe-ab8c-3f3e1986d316",
                    "sense_definition": "Entrer en conflit ou s'opposer vivement en parlant d'idées ou de personnes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "choc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Leurs deux fortes personnalités finissaient inévitablement par se <w>percuter</w> au cours des débats."
                        },
                        {
                            "text": "Durant cette réunion tendue, des visions du monde totalement incompatibles se sont <w>percutées</w>."
                        }
                    ]
                },
                {
                    "sense_id": "c90b8932-9d87-3f51-a80a-d47189508e67",
                    "sense_definition": "Frapper avec méthode une partie du corps pour évaluer sa sonorité ou ses réflexes lors d'un examen médical.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin commença à <w>percuter</w> la cage thoracique du patient pour évaluer sa résonance."
                        },
                        {
                            "text": "Avant d'établir son diagnostic, le praticien a soigneusement <w>percuté</w> l'abdomen du malade."
                        }
                    ]
                }
            ]
        }
    ]
}