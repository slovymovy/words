                        ],
                        "form": "die Tonqualitäten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0541d5c5-34ea-388a-ae88-7f8907f3d46c",
                        "entry_id": "f65a186f-ad21-36ad-9432-bf935d028e4f",
                        "glosses": [
                            "Güte von Klängen oder Musik (meist in Bezug auf die Wiedergabe von Klängen, beispielsweise durch Lautsprecher)"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "02c42f93-197b-4e3c-8b32-98e011d83236",
                                "sense_id": "0541d5c5-34ea-388a-ae88-7f8907f3d46c",
                                "text": "„Die Tonqualität hat durch das häufige Abspielen gelitten.“"
                            },
                            {
                                "example_id": "d8818b1a-66e8-47a3-807d-6e040e0c7fe3",
                                "sense_id": "0541d5c5-34ea-388a-ae88-7f8907f3d46c",
                                "text": "„Für ihre schwache Tonqualität sind die meisten Soundbars viel zu teuer.“"
                            },
                            {
                                "example_id": "e09344d1-74ef-44da-bb53-3fecf4584034",
                                "sense_id": "0541d5c5-34ea-388a-ae88-7f8907f3d46c",
                                "text": "„Die Tonqualität ist wesentlich besser als bei VHS-Randspurton, aber oft schlechter als HiFi-VHS.“"
                            },
                            {
                                "example_id": "91a54e2e-04c4-44a9-9798-9314b859603d",
                                "sense_id": "0541d5c5-34ea-388a-ae88-7f8907f3d46c",
                                "text": "[Mitschnitt von einem Handy:] „Die Tonqualität ist schlecht.“"
                            },
                            {
                                "example_id": "4c3002e9-0598-4669-a81f-c34cda396e7b",
                                "sense_id": "0541d5c5-34ea-388a-ae88-7f8907f3d46c",
                                "text": "[Schallplatten:] „Es wurden kleinere Abtastnadeln eingesetzt und es kam zu einer deutlichen Steigerung sowohl der Tonqualität als auch der Spieldauer.“"
                            },
                            {
                                "example_id": "ef7d79b8-0496-4425-b5e2-bdccf0653519",
                                "sense_id": "0541d5c5-34ea-388a-ae88-7f8907f3d46c",
                                "text": "„Diese Platten waren aufgrund ihrer eingeschränkten Tonqualität nur für Sprachaufnahmen, etwa Hörspiele gedacht, konnten sich aber nicht durchsetzen, da nur wenige Plattenspieler die zugehörige Einstellung aufwiesen.“"
                            },
                            {
                                "example_id": "9883a795-cbbe-4c44-8535-2518896a2444",
                                "sense_id": "0541d5c5-34ea-388a-ae88-7f8907f3d46c",
                                "text": "„Ein Großteil der ABBA-Alben ist zusätzlich auf neueren Tonträgern wie Audio-CD, MiniDisc (MD), DVD oder Blu-ray in überarbeiteter Tonqualität erschienen.“"
                            },
                            {
                                "example_id": "9ed9d4a3-c82f-4e8d-a587-8c7b6dd20624",
                                "sense_id": "0541d5c5-34ea-388a-ae88-7f8907f3d46c",
                                "text": "„Da beim Audio-Streaming über das Internet noch deutlich geringere Datenraten benötigt werden“ […]„, ist also prinzipbedingt mit einer vergleichsweise schlechten Tonqualität zu rechnen.“"
                            },
                            {
                                "example_id": "ffadecdb-0ef3-4c0b-ba5d-6e86846cdc4d",
                                "sense_id": "0541d5c5-34ea-388a-ae88-7f8907f3d46c",
                                "text": "„Wenn heutzutage von CD-Qualität die Rede ist, dann gibt es zwei Kennzahlen: 44.1 Kilohertz à 16 Bit und stammt noch aus den Tagen, als die CD auf den Markt kam und zum damaligen Zeitpunkt sensationelle Tonqualität ermöglichte.“"
                            },
                            {
                                "example_id": "f7f8402b-3914-48b3-918b-a4dafbfda6bf",
                                "sense_id": "0541d5c5-34ea-388a-ae88-7f8907f3d46c",
                                "text": "[«Kassensturz» testet] „sieben Plattenspieler der neusten Generation auf Tonqualität und Ausstattung.“"
                            },
                            {
                                "example_id": "86e2f30e-cf0a-4979-9897-1483c7780d41",
                                "sense_id": "0541d5c5-34ea-388a-ae88-7f8907f3d46c",
                                "text": "„Bei den zehn DAB+-Radios im Test stechen die Unterschiede beim Klang ins Auge. 3 Radios vor allem wegen der lausigen Tonqualität «ungenügend», 3 Modelle sind «gut».“"
                            },
                            {
                                "example_id": "e1a26a50-722d-4de7-a99e-473d37364913",
                                "sense_id": "0541d5c5-34ea-388a-ae88-7f8907f3d46c",
                                "text": "„Insgesamt stritten die Autoren darüber, ob diese Tonqualitäten nun bloß Scheineindrücke repräsentierten, wie Kurth meinte, oder konkrete musikalisch-klangliche Eigenschaften zur Sprache brächten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
