                        "entry_id": "53b0c111-dc22-39c4-a62f-285d466e1d48",
                        "glosses": [
                            "Sous-traitant : fournisseur de pièces ou de sous-assemblages pour la production et le montage."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "2c48cbeb-1cae-42e9-942f-08e4f41a5000",
                                "sense_id": "5a726a29-01f9-3bf7-a34f-98ac11912db7",
                                "text": "Zulieferer, auch Zulieferant oder Unterlieferant, nennt man diejenigen Unternehmer und Betriebe, die die Teile für den Produktionsprozess liefern.",
                                "translation": "On appelle sous-traitants les entreprises et usines qui livrent des pièces pour le processus de production."
                            }
                        ]
                    }
                ],
