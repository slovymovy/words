                        "sense_id": "768c4bdc-4e01-39a9-8011-b5c8d9fcbdd7",
                        "entry_id": "b92187c6-8c5f-3906-9e4b-526b75c55949",
                        "glosses": [
                            "The state or quality of being wild."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48828016-2149-41bc-a233-a68eec1b11c5",
                        "source_entry_id": "b92187c6-8c5f-3906-9e4b-526b75c55949",
                        "source_sense_id": "768c4bdc-4e01-39a9-8011-b5c8d9fcbdd7",
                        "source_sense_description": "the quality of being wild or untamed",
                        "target_lang_word": "sauvagerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sauvagerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4469da4-31b5-37f2-9526-82c58d49d59c",
                                        "entry_id": "c2416e8f-0585-3da1-821a-7dc701a415f3",
                                        "glosses": [
                                            "État des hommes sauvages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54af16a7-90a5-3657-a64c-693a71364b2b",
                                        "entry_id": "c2416e8f-0585-3da1-821a-7dc701a415f3",
                                        "glosses": [
                                            "Manière, humeur, habitudes sauvages."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8725a1fa-aead-4aa3-8f1c-5677042b6ca2",
                                                "sense_id": "54af16a7-90a5-3657-a64c-693a71364b2b",
                                                "text": "Cette enfant, dont le père mourut fou, était une grande créature, mince, pâle, aux regards effarés, d’une singularité d’allures qu’on put prendre pour de la sauvagerie tant qu’elle resta petite fille."
                                            },
                                            {
                                                "example_id": "0c7af513-db15-4f15-9a0c-c91d8b44b329",
                                                "sense_id": "54af16a7-90a5-3657-a64c-693a71364b2b",
                                                "text": "J’avais commencé par refuser, me souciant assez peu de le revoir. … Mais Rouché revint à la charge et, devant son aimable insistance, céda ma sauvagerie."
                                            },
                                            {
                                                "example_id": "df8aaaf6-785b-40b5-ae09-f5601db74c72",
                                                "sense_id": "54af16a7-90a5-3657-a64c-693a71364b2b",
                                                "text": "Il est d’une sauvagerie peu commune."
                                            },
                                            {
                                                "example_id": "7bb92873-ed7a-47e5-93b0-4d1c7080f7d4",
                                                "sense_id": "54af16a7-90a5-3657-a64c-693a71364b2b",
                                                "text": "Je savais que Madame Linton avait une nature impérieuse et obstinée, criai-je, mais je ne savais pas que vous désiriez encourager la sauvagerie de son caractère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e200a65-9b70-3d3a-a02b-2177ce9652d5",
                                        "entry_id": "c2416e8f-0585-3da1-821a-7dc701a415f3",
                                        "glosses": [
                                            "Caractère sauvage, inhospitalier, d'un lieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4c43f4d-0814-4738-95f3-62a08d4457a7",
                                                "sense_id": "6e200a65-9b70-3d3a-a02b-2177ce9652d5",
                                                "text": "Rien n’a pu effacer le souvenir de la sauvagerie de la pointe du Raz et de la Baie des Trépassés, et l’horreur fascinante de la mer mugissant dans l’enfer de Plogoff."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec10bf38-557e-447c-bd15-aab935f9b3a6",
                        "source_entry_id": "b92187c6-8c5f-3906-9e4b-526b75c55949",
                        "source_sense_id": "768c4bdc-4e01-39a9-8011-b5c8d9fcbdd7",
                        "source_sense_description": "the quality of being wild or untamed",
                        "target_lang_word": "Wildheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wildheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4d101be-29ae-3744-a4a8-a7f8781bc11b",
                                        "entry_id": "db1bdcdb-60d7-34c7-8d2b-8179619f8efa",
                                        "glosses": [
                                            "der Zustand, in dem sich die Tier- und Pflanzenwelt befinden, die vom Menschen weitgehend unberührt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4149a8d-5f01-43f8-80f7-505cb87cf120",
                                                "sense_id": "a4d101be-29ae-3744-a4a8-a7f8781bc11b",
                                                "text": "»Ein Blick reiner, ungezähmter Wildheit, das unerbittliche Wissen des nackten Seins«."
                                            },
                                            {
                                                "example_id": "9c16a8f0-c8c1-4bed-9383-3c54cad2d8f3",
                                                "sense_id": "a4d101be-29ae-3744-a4a8-a7f8781bc11b",
                                                "text": "Die sanften Täler zwischen den Bergen sind kultiviert, die Vulkanberge allerdings haben ihre Wildheit bewahren können."
                                            },
                                            {
                                                "example_id": "1e0fd5b9-7bae-40c5-9363-0ffa24aa29cf",
                                                "sense_id": "a4d101be-29ae-3744-a4a8-a7f8781bc11b",
                                                "text": "Das Hochgebirge ist das Thema, das Friedrich anschlägt – übrigens, ohne jemals selbst in den Alpen und speziell im Berchtesgadener Land gewesen zu sein, das sich zu seiner Zeit bereits eines besonderen Rufes wegen seiner Ursprünglichkeit und Wildheit erfreute."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "752dc5d5-a586-385c-8b80-e3b29caa44c8",
                                        "entry_id": "db1bdcdb-60d7-34c7-8d2b-8179619f8efa",
                                        "glosses": [
                                            "ein Wesenszug überschäumender Lebensfreude und körperlicher Aktivität, der auch gesellschaftliche Regeln oder moralische Grenzen überschreiten lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8529d9c6-c9a8-4a76-b191-ac3c0e85542f",
                                                "sense_id": "752dc5d5-a586-385c-8b80-e3b29caa44c8",
                                                "text": "Das Subversive wird im Allgemeinen mit Lautstärke und Wildheit assoziiert."
                                            },
                                            {
                                                "example_id": "5259fa97-574f-493f-9124-b2db328dcada",
                                                "sense_id": "752dc5d5-a586-385c-8b80-e3b29caa44c8",
                                                "text": "Etwas mehr Bewegung wäre schon angebracht gewesen, als der kolumbianische Superstar bei diesem kleinen Spaziergang seine Fans zur rhythmischen Wildheit animieren wollte."
                                            },
                                            {
                                                "example_id": "d67ca71b-b743-49b3-9e1c-c24e9e4c8f33",
                                                "sense_id": "752dc5d5-a586-385c-8b80-e3b29caa44c8",
                                                "text": "Bei vielen Bands führt Erfolg ja bekanntlich dazu, dass ihre Wildheit gezähmt wird."
                                            },
                                            {
                                                "example_id": "e68fc064-7c5a-4593-81a5-bf2f6aa1f1d7",
                                                "sense_id": "752dc5d5-a586-385c-8b80-e3b29caa44c8",
                                                "text": "„Der dritte war den beiden Beschriebenen total unähnlich, und was jene an Wildheit und Lebensmut zuviel besaßen, schien dieser durch Sanftmut und Leutseligkeit wieder ausgleichen zu wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d5d165c4-8a44-3190-b924-427f4a2447d8",
                                        "entry_id": "db1bdcdb-60d7-34c7-8d2b-8179619f8efa",
                                        "glosses": [
                                            "ein Verhalten, das andere Lebewesen (Menschen) tötet oder verletzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27f9cd49-8171-45ba-ab18-7693b6a380a7",
                                                "sense_id": "d5d165c4-8a44-3190-b924-427f4a2447d8",
                                                "text": "Es soll schon vorgekommen sein, dass ein Raufer bei den Handgreiflichkeiten mit einem der höllischen Gegner Blessuren davongetragen hat. Das aber kann niemanden davon abhalten, den Brauch in seiner archaischen Wildheit zu erhalten."
                                            },
                                            {
                                                "example_id": "70b14bab-ce71-4c4f-8c24-c7d6adb2f72e",
                                                "sense_id": "d5d165c4-8a44-3190-b924-427f4a2447d8",
                                                "text": "Der Anführer des Schiiten-Aufstands kündigt an, dass beim Angriff auf seine Hochburg die Iraker \"mit unglaublicher Wildheit\" zurückschlagen werden."
                                            },
                                            {
                                                "example_id": "0c87e5df-69ae-44c8-9cac-28219c9c8394",
                                                "sense_id": "d5d165c4-8a44-3190-b924-427f4a2447d8",
                                                "text": "Wenn endlich der günstige Augenblick gekommen ist und sie meinen, daß die Zeit da sei, um den Plan auszuführen, dessen Aussicht auf Gelingen sie auf das genaueste berechnet haben, treten sie mit einer Gewalt und Wildheit auf, die häufig ihre Feinde aus der Fassung bringt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
