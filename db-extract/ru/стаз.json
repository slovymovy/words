                "senses": [
                    {
                        "sense_id": "e7c437e9-bb54-30dd-8d70-94e7d7a63a31",
                        "entry_id": "e5c4c3a0-6d86-3857-b1b6-8c8f4ec74df2",
                        "glosses": [
                            "физиол. замедление и остановка тока жидкости (крови и т. п.) в сосудах (капиллярах, мелких артериях и венах и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c99c6841-1e01-48ba-95bd-a658cf41c489",
                                "sense_id": "e7c437e9-bb54-30dd-8d70-94e7d7a63a31",
                                "text": "Стаз позволяет лейкоцитам перемещаться (двигаться) вдоль эндотелия."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b440fe4d-5649-4833-92f9-0b903db44cf3",
                        "source_entry_id": "e5c4c3a0-6d86-3857-b1b6-8c8f4ec74df2",
                        "source_sense_id": "e7c437e9-bb54-30dd-8d70-94e7d7a63a31",
                        "target_lang_word": "stasis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stasis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aeae9453-261f-34d3-8400-a4e5ae62d467",
                                        "entry_id": "d8cde244-5fc1-395e-9bcc-2f2fc17a63d7",
                                        "glosses": [
                                            "A slackening or arrest of the blood current, due not to a lessening of the heart’s beat, but to some abnormal resistance of the capillary walls."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4363f69c-62ca-36f7-bbf3-0b3d21627f2a",
                                        "entry_id": "d8cde244-5fc1-395e-9bcc-2f2fc17a63d7",
                                        "glosses": [
                                            "Inactivity; a freezing, or state of motionlessness."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deed2da5-323b-4a0e-bfef-3e6b71fecfa9",
                                                "sense_id": "4363f69c-62ca-36f7-bbf3-0b3d21627f2a",
                                                "text": "His company was sized for growth, not stasis."
                                            },
                                            {
                                                "example_id": "d2f83f2b-05aa-4168-a170-d0e2174209ca",
                                                "sense_id": "4363f69c-62ca-36f7-bbf3-0b3d21627f2a",
                                                "text": "Boredom is an instrument of social control. Power is the power to impose boredom, to command stasis, to combine this stasis with anguish."
                                            },
                                            {
                                                "example_id": "04d0915e-d89b-4741-9ace-1f640cc41124",
                                                "sense_id": "4363f69c-62ca-36f7-bbf3-0b3d21627f2a",
                                                "text": "Or will Americans remain hunkered forever—as confused and anxious and paralyzed as we were before 2020—descend into digital feudalism, and retreat back into our cocoons of nostalgia and cultural stasis, providing the illusion that nothing much is changing or ever can change?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7d4a1eb-ba53-3085-b0fd-f249da5d1465",
                                        "entry_id": "d8cde244-5fc1-395e-9bcc-2f2fc17a63d7",
                                        "glosses": [
                                            "A technology allowing something to be artificially frozen in time, so that it does not age or change."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "739ffee4-e248-4e73-b316-216baaa34cf4",
                                                "sense_id": "f7d4a1eb-ba53-3085-b0fd-f249da5d1465",
                                                "text": "I was in stasis for forty years before I woke up orbiting this poxy planet!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f88955c6-3104-3e15-ab32-21bcab8c7a4f",
                                        "entry_id": "d8cde244-5fc1-395e-9bcc-2f2fc17a63d7",
                                        "glosses": [
                                            "One of the sections of a cathisma or portion of the psalter."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
