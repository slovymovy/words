        "fr-extract.jsonl": [
            {
                "entry_id": "28324735-6307-3b27-9e2d-e6505b1fa453",
                "word": "gorgerin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "192290af-ab43-422e-bf2b-36fcce747526",
                        "entry_id": "28324735-6307-3b27-9e2d-e6505b1fa453",
                        "tags": [
                            "plural"
                        ],
                        "form": "gorgerins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "04036d69-15cb-3728-b4ae-94516ab7ffdb",
                        "entry_id": "28324735-6307-3b27-9e2d-e6505b1fa453",
                        "glosses": [
                            "Pièce de l’armure qui servait autrefois pour couvrir et défendre la gorge d’un homme d’armes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "742b1359-bff0-48c1-83f9-4fd2b513df9e",
                                "sense_id": "04036d69-15cb-3728-b4ae-94516ab7ffdb",
                                "text": "… et, du gorgerin de son casque, […], des gouttes de sang coulant sur l’armure du comte indiquaient que la pointe de l’épée avait pénétré par chaque ouverture qui lui avait été offerte."
                            },
                            {
                                "example_id": "0253eb85-9463-43ef-a21d-d997e878263d",
                                "sense_id": "04036d69-15cb-3728-b4ae-94516ab7ffdb",
                                "text": "Dès le matin, Riesencraft se vêtit de son costume d’archer. Il mit la salade à gorgerin, sans visière, et une chemise de mailles sans manches."
                            },
                            {
                                "example_id": "5f3d31bc-3dc1-427e-9232-f7cf85d47cda",
                                "sense_id": "04036d69-15cb-3728-b4ae-94516ab7ffdb",
                                "text": "… c’était un collier de cuivre ressemblant à celui d’un chien, mais sans aucune ouverture et fortement soudé à son cou, assez large pour n’apporter aucune gêne à la respiration, et cependant assez serré pour qu’on pût l’enlever sans employer la lime ; sur ce singulier gorgerin était gravée, en caractères saxons, une inscription …."
                            },
                            {
                                "example_id": "ba24451d-9689-4f23-bd14-ccb7341c1cc5",
                                "sense_id": "04036d69-15cb-3728-b4ae-94516ab7ffdb",
                                "text": "On lit dans l'article 11 de ces statuts : « Les armuriers feront tous harnais pour hommes, comme corcelets, cuirasses, haussecols, gorgerins, etc., et toutes bardes pour chevaux comme frontails, chanfreins, flanquois et collières. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "64a58032-b4be-374d-906f-30bd8b398c4e",
                        "entry_id": "28324735-6307-3b27-9e2d-e6505b1fa453",
                        "glosses": [
                            "Collier de chien hérissé de pointes de métal."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b8177385-2225-3fc7-9d89-5e6c515880f4",
                        "entry_id": "28324735-6307-3b27-9e2d-e6505b1fa453",
                        "glosses": [
                            "Sur certains chapiteaux, partie lisse ou ornée placée au-dessus de l’astragale de la colonne."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "76a2b91e-25a0-32d5-a20a-fe6101dca307",
                        "entry_id": "28324735-6307-3b27-9e2d-e6505b1fa453",
                        "glosses": [
                            "En Égypte, un bijou lourd et volumineux constitué de métal et lacé derrière la nuque."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "bf148404-f3d5-4c78-be00-5207d77041a7",
                                "sense_id": "76a2b91e-25a0-32d5-a20a-fe6101dca307",
                                "text": "Lord Evandale se sentait embarrassé de ne pas avoir la coiffe à barbes cannelées, le gorgerin d’émaux et le pagne étroit bridant sur les hanches : seul costume convenable pour se présenter à une momie royale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4428a9f-1977-4e4c-9914-ff6b75fa5a4e",
                        "source_entry_id": "28324735-6307-3b27-9e2d-e6505b1fa453",
                        "source_sense_description": "1 - Pièce d'armure",
                        "target_lang_word": "gorget",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gorget",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "880f31dd-3daa-39ca-937d-73c45a1a9af9",
                                        "entry_id": "de58de4f-17d8-3172-a4b8-ee1018f05023",
                                        "glosses": [
                                            "A piece of armour protecting the throat and/or the upper part of the chest."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09e05702-48c7-4279-a4e6-ef32bb651727",
                                                "sense_id": "880f31dd-3daa-39ca-937d-73c45a1a9af9",
                                                "text": "I heard he presented Hygd with a gorget,\nthe priceless torque that the prince's daughter\nWealhtheow, had given him."
                                            },
                                            {
                                                "example_id": "fd2056d7-290b-4a62-ba1e-8ddd5a602f94",
                                                "sense_id": "880f31dd-3daa-39ca-937d-73c45a1a9af9",
                                                "text": "Renly lifted his chin to allow Brienne to fasten his gorget in place."
                                            },
                                            {
                                                "example_id": "b53c0737-c2e1-4092-9a8c-a7bffe3e5ef2",
                                                "sense_id": "880f31dd-3daa-39ca-937d-73c45a1a9af9",
                                                "text": "About his neck a threefold gorget, / As rough as trebled leathern target"
                                            },
                                            {
                                                "example_id": "c7174791-6d91-4f4b-a7e9-a4d85c861567",
                                                "sense_id": "880f31dd-3daa-39ca-937d-73c45a1a9af9",
                                                "text": "Unfix the gorget's iron clasp."
                                            },
                                            {
                                                "example_id": "e59b6635-788e-4811-863d-e82158a4c539",
                                                "sense_id": "880f31dd-3daa-39ca-937d-73c45a1a9af9",
                                                "text": "Hawkmoon whipped his sword from the scabbard, leaped forward, and drove the blade into the throat of the warrior just below his gorget."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3e8000a-694e-3453-a3f2-ee20a500b58f",
                                        "entry_id": "de58de4f-17d8-3172-a4b8-ee1018f05023",
                                        "glosses": [
                                            "A crescent-shaped ornamental metal plate suspended around the neck from the crescent's points by a length of chain or ribbon, used to indicate rank or authority and was worn as part of a dress military uniform by officers."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b6442eb-f87c-3b9c-83fa-7fdaee2f5aa6",
                                        "entry_id": "de58de4f-17d8-3172-a4b8-ee1018f05023",
                                        "glosses": [
                                            "A type of women's clothing covering the neck and breast; a wimple."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72109a0a-b34a-316d-8c96-e617165245d5",
                                        "entry_id": "de58de4f-17d8-3172-a4b8-ee1018f05023",
                                        "glosses": [
                                            "An ornament for the neck; a necklace, ornamental collar, torque etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80577165-5651-31ad-a13e-7c8a78116a76",
                                        "entry_id": "de58de4f-17d8-3172-a4b8-ee1018f05023",
                                        "glosses": [
                                            "A cutting instrument used in lithotomy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4841cb81-096b-3eb9-afec-3f803d1fcfc9",
                                        "entry_id": "de58de4f-17d8-3172-a4b8-ee1018f05023",
                                        "glosses": [
                                            "A grooved instrument used in performing various operations; called also blunt gorget."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34a6c767-7f34-3662-bee1-3010c5963130",
                                        "entry_id": "de58de4f-17d8-3172-a4b8-ee1018f05023",
                                        "glosses": [
                                            "A crescent-shaped coloured patch on the neck of a bird or mammal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb83c8b4-7762-4f18-ad0d-b25ccf19147a",
                                                "sense_id": "34a6c767-7f34-3662-bee1-3010c5963130",
                                                "text": "There was […] the golden-winged woodpecker, with his crimson crest, his broad black gorget, and splendid plumage […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46d81daa-ea2d-3196-9443-9bc8e498cf3e",
                                        "entry_id": "de58de4f-17d8-3172-a4b8-ee1018f05023",
                                        "glosses": [
                                            "A hake caught in a net set for other fish."
                                        ],
