                        "entry_id": "f5b6275e-2b82-33cc-a143-fe8a61faff77",
                        "glosses": [
                            "Qui concerne les ambulances."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62de3666-af56-45b5-8d41-cd0a35420e64",
                                "sense_id": "eefe7af6-819d-3c1e-b9af-a70bf76ee648",
                                "text": "Le récit du service ambulancier a été un peu vague, et j’ai pensé qu’il valait mieux se préparer."
                            },
                            {
                                "example_id": "0e88c577-b183-40d0-a88a-6dfd318fcd6b",
                                "sense_id": "eefe7af6-819d-3c1e-b9af-a70bf76ee648",
                                "text": "Le 18 octobre 2022, Ann d’Angleterre quitte l’hôpital dans un carrosse ambulancier."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
