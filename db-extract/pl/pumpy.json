                    {
                        "translation_id": "e51cf763-ae1b-41b9-bd86-2b3fff9e8441",
                        "source_entry_id": "dc38b4a4-e14e-3352-aaa2-07c459e98ee7",
                        "source_sense_id": "fd4a21dc-2974-31da-9ad1-8fd903cd3ecd",
