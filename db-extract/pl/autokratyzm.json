                        "glosses": [
                            "władczość jako cecha charakteru; cecha kogoś, kto nie liczy się z nikim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57a812e6-4919-4907-9efc-935d1fb3e973",
                                "sense_id": "316d7ee1-1611-3649-a217-9bc6f4fdc072",
                                "text": "Autokratyzm twojej babki jest denerwujący."
                            }
                        ],
