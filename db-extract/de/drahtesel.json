                "senses": [
                    {
                        "sense_id": "7914acba-a11e-3581-b441-e55a455608ce",
                        "entry_id": "34fbf392-125b-3004-85bd-f5ccc8f1ad97",
                        "glosses": [
                            "Fahrrad"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "1fbd5c32-8184-4877-8f9b-69554c59a1c9",
                                "sense_id": "7914acba-a11e-3581-b441-e55a455608ce",
                                "text": "Sie nutzten den Tag, um mit dem Drahtesel an den See zu fahren."
                            },
                            {
                                "example_id": "f3f44edb-c581-4667-b9e5-a0cdc832295e",
                                "sense_id": "7914acba-a11e-3581-b441-e55a455608ce",
                                "text": "„Rote, pinke, gelbe, weiße und blaue Papierstreifen schmückten meinen Drahtesel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6761bea-5b13-4b1d-988c-89ad1da56259",
                        "source_entry_id": "34fbf392-125b-3004-85bd-f5ccc8f1ad97",
                        "source_sense_id": "7914acba-a11e-3581-b441-e55a455608ce",
                        "source_sense_description": "salopp: Fahrrad",
                        "target_lang_word": "vélo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vélo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7100ad9e-0776-3904-aeb9-fc7677f957c5",
                                        "entry_id": "b6b0f101-63a0-3947-bdbc-28ae5ef3cd4a",
                                        "glosses": [
                                            "Véhicule muni de deux roues, propulsé à la force des muscles à l’aide d’un pédalier relié à la roue arrière au moyen d’une chaîne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af9cd597-5fa8-46be-9dad-c0381174004e",
                                                "sense_id": "7100ad9e-0776-3904-aeb9-fc7677f957c5",
                                                "text": "Il a une rosette de la Légion grosse comme un cataphote de vélo hollandais, et un peu plus brillante ; et puis des lunettes sans monture […]"
                                            },
                                            {
                                                "example_id": "5bbc17d3-4fb5-462a-947e-4c956fefcb64",
                                                "sense_id": "7100ad9e-0776-3904-aeb9-fc7677f957c5",
                                                "text": "«Cela servira également pour l’aménagement de nouvelles pistes pour les débutants pour le Club Med. Il va également avoir plus de sentiers pour les vélos»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4daf16c8-2947-3159-9c5a-4c8c88f1f9c3",
                                        "entry_id": "b6b0f101-63a0-3947-bdbc-28ae5ef3cd4a",
                                        "glosses": [
                                            "Cyclisme ; pratique de la bicyclette ; sport cycliste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "588942bf-4058-45a9-a620-54c21e37b40d",
                                                "sense_id": "4daf16c8-2947-3159-9c5a-4c8c88f1f9c3",
                                                "text": "Les chevaux l’ennuyaient. — Moi, ajouta-t-il, c’est le vélo. Et ses yeux brillèrent."
                                            },
                                            {
                                                "example_id": "878fff77-9cc2-4207-b72e-dc26222d62ed",
                                                "sense_id": "4daf16c8-2947-3159-9c5a-4c8c88f1f9c3",
                                                "text": "J’ai voulu refaire du vélo, dont je n’avais pas fait depuis plus d’une année."
                                            },
                                            {
                                                "example_id": "bf784ebd-1d16-4908-affb-99a90e74370a",
                                                "sense_id": "4daf16c8-2947-3159-9c5a-4c8c88f1f9c3",
                                                "text": "Il œuvre dans le domaine du plein air (randonnée pédestre, escalade, vélo, ski de fond, etc.) depuis une quinzaine d’années et a été recherchiste pour l’émission de télévision Oxygène (1992-1993)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ce5bb1e-be26-36e7-87d6-a5375ae64944",
                                        "entry_id": "b6b0f101-63a0-3947-bdbc-28ae5ef3cd4a",
                                        "glosses": [
                                            "Vélocipède, ciseau de graveur sur bois."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5ac25a1-6a34-3a96-b79e-10c501fb5baa",
                                        "entry_id": "b6b0f101-63a0-3947-bdbc-28ae5ef3cd4a",
                                        "glosses": [
                                            "carte sans valeur (synonyme de carte basse)"
                                        ],
                                        "tags": [
                                            "Cartes à jouer",
                                            "Tarot"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
