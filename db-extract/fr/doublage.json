                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3e8acae1-986d-4156-ad79-5160b5bf86cd",
                        "entry_id": "8544d84d-2169-3ff2-81ea-eaad8c4f2726",
                        "tags": [
                            "plural"
                        ],
                        "form": "doublages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "930195c2-6d52-303c-bc48-8f3a52a08146",
                        "entry_id": "8544d84d-2169-3ff2-81ea-eaad8c4f2726",
                        "glosses": [
                            "Revêtement de feuilles de cuivre, ou de planches, qu’on applique aux navires destinés à des voyages de long cours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "640679bc-0e62-4193-a72d-f84118695e13",
                                "sense_id": "930195c2-6d52-303c-bc48-8f3a52a08146",
                                "text": "Mais le Firecrest faisait toujours un peu d’eau, et je décidai de le remettre une nouvelle fois à terre et de terminer par là où j’aurais dû commencer en enlevant complétement le doublage en cuivre et en refaisant le calfatage de la coque."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c4d38dd-a908-37e0-a96e-acb612e1f86d",
                        "entry_id": "8544d84d-2169-3ff2-81ea-eaad8c4f2726",
                        "glosses": [
                            "Action de doubler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "734690e5-0c79-48fa-bd7c-1036f75ff1c9",
                                "sense_id": "8c4d38dd-a908-37e0-a96e-acb612e1f86d",
                                "text": "Le doublage des fils dans un tissage."
                            }
                        ]
                    },
                    {
                        "sense_id": "4035fef3-7e32-3be7-bd96-41711184925a",
                        "entry_id": "8544d84d-2169-3ff2-81ea-eaad8c4f2726",
                        "glosses": [
                            "Action de pourvoir un vêtement, d’une doublure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b217499-c70e-4327-83d0-fe74a07ef34f",
                                "sense_id": "4035fef3-7e32-3be7-bd96-41711184925a",
                                "text": "Le doublage d’un vêtement."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab0b40cb-b40e-395a-8920-b4f60ea566ae",
                        "entry_id": "8544d84d-2169-3ff2-81ea-eaad8c4f2726",
                        "glosses": [
                            "Action de pourvoir un acteur, d’une doublure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8df315f1-b0f9-40af-ad44-0775dd37f182",
                                "sense_id": "ab0b40cb-b40e-395a-8920-b4f60ea566ae",
                                "text": "Le cascadeur assure le doublage de l’acteur dans les scènes dangereuses."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5b0effb-443c-3b07-bdc9-87eed112c4bb",
                        "entry_id": "8544d84d-2169-3ff2-81ea-eaad8c4f2726",
                        "glosses": [
                            "Remplacement de la bande sonore originale d’une œuvre (film, téléfilm, série…) par une nouvelle bande, en substituant aux voix des comédiens d’origine celles d’autres interprètes."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "54496a7f-94d8-4238-a7c0-4df2f5760707",
                                "sense_id": "a5b0effb-443c-3b07-bdc9-87eed112c4bb",
                                "text": "Au delà du bien, du mal et du bon goût, se côtoyaient de véritables poèmes macabres et des nanars outranciers, en VF. Sans son doublage minable en français, un nanar n'est pas totalement réussi."
                            }
                        ]
                    },
                    {
                        "sense_id": "503de3bb-cf2b-371b-9a91-2c071cf8dfb9",
                        "entry_id": "8544d84d-2169-3ff2-81ea-eaad8c4f2726",
                        "glosses": [
                            "Prestation vocale réalisée en studio pour interpréter la voix de personnages dans une œuvre audiovisuelle."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2105f32f-a601-4bc0-b0f6-2d9e81b20719",
                                "sense_id": "503de3bb-cf2b-371b-9a91-2c071cf8dfb9",
                                "text": "Cet acteur a beaucoup travaillé dans le doublage."
                            },
                            {
                                "example_id": "7a2dc936-6d0c-4da3-884c-a171ad679454",
                                "sense_id": "503de3bb-cf2b-371b-9a91-2c071cf8dfb9",
                                "text": "Les films italiens sont généralement tournés sans le son, et les acteurs assurent ensuite le doublage en studio après les prises de vue."
                            }
                        ]
                    }
                ],
