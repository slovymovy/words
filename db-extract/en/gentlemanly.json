                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c8497b2f-b145-4b5c-ac5a-4170b93fe60a",
                        "entry_id": "c9cf734b-66cc-3c0a-accf-2e9e14e5fe50",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more gentlemanly"
                    },
                    {
                        "form_id": "1784da74-467e-4455-b64f-0433c260dcc5",
                        "entry_id": "c9cf734b-66cc-3c0a-accf-2e9e14e5fe50",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most gentlemanly"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b000f519-56ae-3eb1-a165-4c2b1ab8d71c",
                        "entry_id": "c9cf734b-66cc-3c0a-accf-2e9e14e5fe50",
                        "glosses": [
                            "In the manner or with the behavior of a gentleman; with social grace, politely."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f61dbf5a-ab4d-4de0-9d9b-8a7dcd25cf29",
                                "sense_id": "b000f519-56ae-3eb1-a165-4c2b1ab8d71c",
                                "text": "He went gentlemanly dressed in East Virginia style, wore a high-top silk hat, as had lawyer Park, and sported a gold headed walking cane."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ddcbd52-7c59-4a6c-8640-f62f5758c4ae",
                        "source_entry_id": "c9cf734b-66cc-3c0a-accf-2e9e14e5fe50",
                        "source_sense_id": "b000f519-56ae-3eb1-a165-4c2b1ab8d71c",
                        "source_sense_description": "in the manner of a gentleman",
                        "target_lang_word": "vornehm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vornehm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2af7af13-ca95-3843-adba-bf8f2f8a9901",
                                        "entry_id": "0dbe4da0-ee7b-3c5e-accc-ce92f25796be",
                                        "glosses": [
                                            "dem äußeren Erscheinungsbild nach höheren, besser gestellten gesellschaftlichen Kreisen zugehörig, in der Art und Weise dieser Kreise oder sich auf diese Kreise beziehend, von besonderer Feinheit und Feinfühligkeit oder sich durch andere positive Eigenschaften auszeichnend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23eaf1ec-872c-4a66-be01-ad33ca7262c0",
                                                "sense_id": "2af7af13-ca95-3843-adba-bf8f2f8a9901",
                                                "text": "Das Aschenputtel, das sie früher einmal war, war sie nicht mehr, nun gehörte sie zu den vornehmeren Leuten."
                                            },
                                            {
                                                "example_id": "d5a7c4ec-3043-45d6-ab7c-ce99ea2275ab",
                                                "sense_id": "2af7af13-ca95-3843-adba-bf8f2f8a9901",
                                                "text": "Tu hier nicht so vornehm, wir sind unter uns."
                                            },
                                            {
                                                "example_id": "1fd974b3-1231-4c54-9e15-a27d7c2cdf72",
                                                "sense_id": "2af7af13-ca95-3843-adba-bf8f2f8a9901",
                                                "text": "Nachdem er sich etwas hatte zuschulden kommen lassen, was den Sitten eines vornehmen Hauses widersprach, musste er das Haus verlassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "806da118-a868-3543-899d-b19ea26b575f",
                                        "entry_id": "0dbe4da0-ee7b-3c5e-accc-ce92f25796be",
                                        "glosses": [
                                            "äußerst wichtig, äußerst bedeutend, äußerst dringend (als erstes vorzunehmen)"
                                        ],
                                        "tags": [
                                            "im Superlativ auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af3e53b2-b615-41ad-899f-ada5db5f1c9b",
                                                "sense_id": "806da118-a868-3543-899d-b19ea26b575f",
                                                "text": "„Weil jedes Gemeinwesen gebildete und tüchtige Leute braucht, ist es vornehmste Pflicht der Städte für entsprechende Schulen zu sorgen.“ Martin Luther"
                                            },
                                            {
                                                "example_id": "3b69564f-ca36-42e6-be7e-a0edd98a5dc6",
                                                "sense_id": "806da118-a868-3543-899d-b19ea26b575f",
                                                "text": "„Als seine vornehmste Pflicht betrachtete er deshalb seinen Einsatz bei den Manövern und Gefechten.“ (Internet-Beleg)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
