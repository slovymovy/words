                "senses": [
                    {
                        "sense_id": "fa8c9117-0fbf-3f2e-8c9c-9a6332379bf9",
                        "entry_id": "ba7b50b2-c79e-31c5-8e8f-10b99d667f92",
                        "glosses": [
                            "To capsize end over end, as in heavy surf."
                        ],
                        "tags": [
                            "of a boat"
                        ],
                        "examples": [
                            {
                                "example_id": "ad5656b0-1271-4222-9bdd-1da25892bf50",
                                "sense_id": "fa8c9117-0fbf-3f2e-8c9c-9a6332379bf9",
                                "text": "Pitchpoling is the most dangerous way a boat can capsize."
                            },
                            {
                                "example_id": "df5236f1-09dc-499c-af5a-658d98841c4b",
                                "sense_id": "fa8c9117-0fbf-3f2e-8c9c-9a6332379bf9",
                                "text": "Pitchpoling occurs when the bow buries itself in the wave ahead while the wave behind lifts the aft section up and over."
                            },
                            {
                                "example_id": "f988ae34-6dec-48bb-b7d0-07da31e10de9",
                                "sense_id": "fa8c9117-0fbf-3f2e-8c9c-9a6332379bf9",
                                "text": "The advanced design of new cats makes pitchpoling less likely."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "284e5c9e-dd22-4833-a245-f6591e78ae84",
                        "source_entry_id": "ba7b50b2-c79e-31c5-8e8f-10b99d667f92",
                        "source_sense_id": "fa8c9117-0fbf-3f2e-8c9c-9a6332379bf9",
