        "pl-extract.jsonl": [
            {
                "entry_id": "f1b63133-8479-3931-b69f-9286bab70b5e",
                "word": "Selene",
                "pos": "name",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e11cf634-bce9-3716-bdbc-dd4c46b31e95",
                        "entry_id": "f1b63133-8479-3931-b69f-9286bab70b5e",
                        "glosses": [
                            "bogini i uosobienie księżyca, utożsamiana z rzymską Luną"
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "cf1f5eb5-97f6-4adf-b5d4-e7aed19dc15f",
                                "sense_id": "e11cf634-bce9-3716-bdbc-dd4c46b31e95",
                                "text": "W połowie miesiąca boska Selene kąpie się w Oceanie i ubrana w szaty świetliste, zaprzęga jasne rumaki do wozu, z którego lecą dalekie promienie"
                            },
                            {
                                "example_id": "6829dbef-8dd6-42e0-a00e-3fa49546b6a5",
                                "sense_id": "e11cf634-bce9-3716-bdbc-dd4c46b31e95",
                                "text": "Atrybutami Selene były: półksiężyc, pochodnia, srebrny rydwan, skrzydła i dyptam jesionolistny."
                            },
                            {
                                "example_id": "548b8058-736b-4f6f-b77f-cee4946f9b98",
                                "sense_id": "e11cf634-bce9-3716-bdbc-dd4c46b31e95",
                                "text": "Srebrny rydwan Selene ciągnęły dwa rumaki, a nie cztery, jak złoty rydwan Heliosa"
                            },
                            {
                                "example_id": "f806148f-7f6a-4af5-b2d2-7c3f25252300",
                                "sense_id": "e11cf634-bce9-3716-bdbc-dd4c46b31e95",
                                "text": "Przypisywano Selene wpływ na praktyki magiczne, stan zdrowia, menstruację i połóg u kobiet."
                            },
                            {
                                "example_id": "9c87cd6a-55f7-4e39-a3b2-0164a75a37fc",
                                "sense_id": "e11cf634-bce9-3716-bdbc-dd4c46b31e95",
                                "text": "Kult bóstw uosabiających ciała niebieskie był w Grecji rzadkością, jednak Heliosa czczono na Rodos, a Selene – na Peloponezie"
                            },
                            {
                                "example_id": "0f4feaf4-7a58-4fa3-83c9-dd5891080bb2",
                                "sense_id": "e11cf634-bce9-3716-bdbc-dd4c46b31e95",
                                "text": "Urodziwy Endymion wzbudził namiętną miłość w Selene."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "142408e9-f036-3ea6-990a-bcdd7c3df95e",
                        "entry_id": "f1b63133-8479-3931-b69f-9286bab70b5e",
                        "glosses": [
                            "planetoida o numerze katalogowym 580"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c12aeed4-18f3-44ef-ab92-df9c12bfd90d",
                                "sense_id": "142408e9-f036-3ea6-990a-bcdd7c3df95e",
                                "text": "Selene porusza się w obszarze między orbitami Marsa i Jowisza, czyli w pasie głównym planetoid."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01f24501-dd76-4914-9e1d-4d5cdd174657",
                        "source_entry_id": "f1b63133-8479-3931-b69f-9286bab70b5e",
                        "source_sense_id": "e11cf634-bce9-3716-bdbc-dd4c46b31e95",
                        "target_lang_word": "Selene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df64731a-a674-3398-8925-e6024bd35a75",
                                        "entry_id": "4ce0a037-ff59-3588-a181-bd2dd9d7ff19",
                                        "glosses": [
                                            "The goddess of the Moon."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d527631b-0e29-43e1-a591-a03ec30c685b",
                                                "sense_id": "df64731a-a674-3398-8925-e6024bd35a75",
                                                "text": "Balancing Arria is the union of Selene and Endymion. In the center of the main panel Selene descends from her chariot, whose horses are held by a nymph, to join Endymion, who lies to the right."
                                            },
                                            {
                                                "example_id": "64e985ac-b65c-46ce-a0a8-04ce7282a8c7",
                                                "sense_id": "df64731a-a674-3398-8925-e6024bd35a75",
                                                "text": "In the other, more famous story, the moon goddess Selene fell in love with him^([Endymion]) while he was asleep."
                                            },
                                            {
                                                "example_id": "5fecc409-3367-4b81-8fba-9b6b5cffb7be",
                                                "sense_id": "df64731a-a674-3398-8925-e6024bd35a75",
                                                "text": "This fragmentary front panel of a sarcophagus preserves two episodes from the story of Endymion and Selene. Selene, goddess of the moon, fell in love with Endymion, a beautiful young mortal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84a02616-7987-34b5-ade0-37716504c889",
                                        "entry_id": "4ce0a037-ff59-3588-a181-bd2dd9d7ff19",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf42a344-49d8-4df8-a371-24a4416f6357",
                                                "sense_id": "84a02616-7987-34b5-ade0-37716504c889",
                                                "text": "“Selene, I am going to get you out of bed and sit you in the chair for a minute. I want to put this heavy blanket and sheet on your bed so it will keep your new bedding clean.”"
                                            },
                                            {
                                                "example_id": "5aa5f3a8-48bd-4007-8716-a7a625126eb2",
                                                "sense_id": "84a02616-7987-34b5-ade0-37716504c889",
                                                "text": "In the opening sequence of the film Underworld (2004), the beautiful vampire assassin Selene, clad in tight black rubber and leather, is perched beside gargoyles on top of a soaring Gothic tower."
                                            },
                                            {
                                                "example_id": "e342a006-32ab-4720-8a19-8280b0987e0d",
                                                "sense_id": "84a02616-7987-34b5-ade0-37716504c889",
                                                "text": "We also made arrangements with my sister Marion and brother-in-law Richard for Selene to stay with them over long school holidays, like Thanksgiving and Easter, when the campus would be closed for a few days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e45d6a16-3f92-3b25-9f03-430daeb96843",
                                        "entry_id": "4ce0a037-ff59-3588-a181-bd2dd9d7ff19",
                                        "glosses": [
                                            "The Moon."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
