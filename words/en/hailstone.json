{
    "word_family": [
        "hail",
        "hailstorm"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ca3ab7e2-fc7d-3ba6-8bbc-5ff76b4a2b67",
                    "sense_definition": "A single pellet or ball of frozen rain that falls during a storm.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A large <w>hailstone</w> hit the windshield and cracked the glass.",
                            "target_lang_translations": {
                                "zh": "一块大<w>冰雹</w>砸中了挡风玻璃，把玻璃砸裂了。"
                            }
                        },
                        {
                            "text": "The ground was completely covered in <w>hailstones</w> after the violent summer storm.",
                            "target_lang_translations": {
                                "zh": "那场强烈的夏季风暴过后，地面上全都是<w>冰雹</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "large hailstones",
                        "giant hailstones"
                    ],
                    "target_lang_definitions": {
                        "zh": "暴风雨中降落的单个冰雹粒。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "冰雹",
                                "target_lang_sense_clarification": "指冰雹粒或雹子"
                            },
                            {
                                "target_lang_word": "雹子",
                                "target_lang_sense_clarification": "口语，指冰雹块"
                            },
                            {
                                "target_lang_word": "雹块",
                                "target_lang_sense_clarification": "指单个较大的冰雹"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8e29d548-e204-3ea2-958f-2e54a3864deb",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We met Mr. <w>Hailstone</w> at the regional conference last week.",
                            "target_lang_translations": {
                                "zh": "我们上周在地区会议上见到了<w>黑尔斯通</w>先生。"
                            }
                        },
                        {
                            "text": "The <w>Hailstones</w> decided to move across the country to start a new business.",
                            "target_lang_translations": {
                                "zh": "<w>黑尔斯通</w>一家决定搬到全国另一端去开创新事业。"
                            }
                        }
                    ],
                    "traits": [
