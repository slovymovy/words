                "senses": [
                    {
                        "sense_id": "85e2d57a-f4f9-3999-9cd1-90480aab32b3",
                        "entry_id": "1782812d-3a6f-3d30-a0eb-73ec8db9d6e1",
                        "glosses": [
                            "eine möglichst genaue Vorhersage eines Wahlergebnisses mittels prognostischer Methoden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8749e52-eaef-4830-bddd-51cd6feffd9a",
                                "sense_id": "85e2d57a-f4f9-3999-9cd1-90480aab32b3",
                                "text": "Wahlvorhersagen ähneln zusehends der Wettervorhersage. Sie haben einen Vorhersagehorizont von einer Woche. (09/2005)"
                            },
                            {
                                "example_id": "230df6d3-0125-4659-ab10-883d43357ff3",
                                "sense_id": "85e2d57a-f4f9-3999-9cd1-90480aab32b3",
                                "text": "„480.000 zu 57.000 im Vergleich Obama gegen McCain, das ist natürlich keine irgendwie ernst zu nehmende Wahlvorhersage.“"
                            },
                            {
                                "example_id": "6f5f75aa-3451-4a1c-bd0a-a64a19b962e6",
                                "sense_id": "85e2d57a-f4f9-3999-9cd1-90480aab32b3",
                                "text": "„Neben den Demokraten seien das vor allem die Demoskopen des renommierten Beratungsunternehmens Gallup gewesen, die vor der Wahl die \"schlimmste Wahlvorhersage von allen jemals erstellten nationalen Umfragen\" erstellt hätten.“"
                            },
                            {
                                "example_id": "41bd3c4e-12f5-4581-ab6e-e9255c08e97e",
                                "sense_id": "85e2d57a-f4f9-3999-9cd1-90480aab32b3",
                                "text": "„Die Umfrage sei freilich eher eine \"Momentaufnahme\" der Gemütsverfassung der Bevölkerung als eine Wahlvorhersage, schreibt \"El País\" in seiner Online-Ausgabe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
