                                                "example_id": "cbe7dd85-b2ef-42d9-a206-8fc75c487c1b",
                                                "sense_id": "99f0d29c-b6ba-3535-b514-7524f77ed420",
                                                "text": "Iziwork est née en 2018, avec pour objectif de faire se rencontrer les intérimaires et les entreprises à travers le numérique, grâce à l’IA."
                                            },
                                            {
                                                "example_id": "b0ce175e-3989-4c68-8d55-ff12d9a10083",
                                                "sense_id": "99f0d29c-b6ba-3535-b514-7524f77ed420",
