                ],
                "senses": [
                    {
                        "sense_id": "ab8634c8-9318-3a3d-882f-4ec36be24ec4",
                        "entry_id": "7717c2e5-e3b0-3ff6-b4af-9c1d82441a23",
                        "glosses": [
                            "неодобр. человек, меняющий свои взгляды, привычки в зависимости от обстоятельств, к которым он приспоса́бливается; двурушник, приспособляющийся к обстоятельствам с целью замаскировать свои истинные взгляды, склонности и привычки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2d78919-9290-47ab-b991-b68b2f5cf660",
                                "sense_id": "ab8634c8-9318-3a3d-882f-4ec36be24ec4",
                                "text": "— Вчера́ в кабине́те у вас ви́дел э́того индиви́дуума ме́лько́м, но доста́точно одного́ бе́глого взгля́да на его́ лицо́, что́бы поня́ть, что он — сво́лочь, скло́чник, приспособле́нец и подхали́м."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05b16e31-600a-4f14-b2d9-310755c04a0d",
                        "source_entry_id": "7717c2e5-e3b0-3ff6-b4af-9c1d82441a23",
                        "source_sense_id": "ab8634c8-9318-3a3d-882f-4ec36be24ec4",
                        "target_lang_word": "timeserver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "timeserver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13bba992-2ebd-391f-81d8-c35889308250",
                                        "entry_id": "a11d6dc4-832b-33fa-94c0-460f32a459db",
                                        "glosses": [
                                            "A person who conforms to current opinions, especially for reasons of personal advantage; an opportunist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ba0075-0a8c-40a6-b642-74e7fc237b7f",
                                                "sense_id": "13bba992-2ebd-391f-81d8-c35889308250",
                                                "text": "Another of Lilly's confidants was the time-server, John Gauden, who was distinctly anti-Laudian in outlook, but who nevertheless became Bishop of Worcester at the Restoration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95bc40f5-ca9d-3967-ab1c-372dbfa2cab7",
                                        "entry_id": "a11d6dc4-832b-33fa-94c0-460f32a459db",
                                        "glosses": [
                                            "Someone who performs a job for the required time only, making a minimum of effort."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "313d408d-000c-3076-9fe7-02a8038501f5",
                                        "entry_id": "a11d6dc4-832b-33fa-94c0-460f32a459db",
                                        "glosses": [
                                            "A device, node or program that transmits the correct time to clients in a network."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f0907e1-d010-3458-b95f-0e3902c3a0b7",
                                        "entry_id": "a11d6dc4-832b-33fa-94c0-460f32a459db",
                                        "glosses": [
                                            "Someone who honors their commitments only when it is personally easy to do so."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8330c5f6-c149-446d-a9b8-fcaf556f5b45",
                        "source_entry_id": "7717c2e5-e3b0-3ff6-b4af-9c1d82441a23",
                        "source_sense_id": "ab8634c8-9318-3a3d-882f-4ec36be24ec4",
