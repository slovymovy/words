                    "sense_definition": "Один из рангов в биологической классификации растений и бактерий.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот вид растений относится к <w>порядку</w> розоцветных.",
                            "target_lang_translations": {
