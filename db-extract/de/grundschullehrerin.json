                        "examples": [
                            {
                                "example_id": "4b231fb3-377e-45fd-9a32-5c0195719b93",
                                "sense_id": "e931d66e-c59c-3589-89dd-3fe4c9f38f74",
                                "text": "Grundschullehrerin ist ein toller und verantwortungsvoller Beruf."
                            },
                            {
                                "example_id": "67e338e6-540c-420c-be42-6d971d19cc77",
                                "sense_id": "e931d66e-c59c-3589-89dd-3fe4c9f38f74",
                                "text": "„Meine Grundschullehrerin hieß auch Friede, denkt der Wolfram in mir, und meine finnische Liebe wurde auf den Namen Pia-Maria getauft, was nicht eben nach Jägern und Sammlern klingt.“"
                            },
                            {
                                "example_id": "3eaee4fa-aa68-4cc0-a1af-ba3de01bab9f",
                                "sense_id": "e931d66e-c59c-3589-89dd-3fe4c9f38f74",
                                "text": "„Sie sah hundertprozentig aus wie eine australische Grundschullehrerin.“"
                            }
                        ],
