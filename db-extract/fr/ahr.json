                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac673600-3440-4ee1-b531-7589e986b4b0",
                        "source_entry_id": "3095274e-315c-3751-80c0-bd8cd99cc2ec",
                        "source_sense_description": "affluent du Rhin",
                        "target_lang_word": "Ahr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ahr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "222d02c5-d295-3dde-b1f4-82893b7282e1",
                                        "entry_id": "64ee4269-cf60-3988-8e21-2d14b8eb4980",
                                        "glosses": [
                                            "Fluss im südlichen Nordrhein-Westfalen, Deutschland und im nördlichen Rheinland-Pfalz, linker Nebenfluss des Rheins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f9ece80-7f0a-4446-8b62-7eb2d11939c9",
                                                "sense_id": "222d02c5-d295-3dde-b1f4-82893b7282e1",
                                                "text": "An der Ahr wachsen vorzügliche Rotweine."
                                            },
                                            {
                                                "example_id": "b1b13bfc-e382-4e32-a3bf-97383f00827c",
                                                "sense_id": "222d02c5-d295-3dde-b1f4-82893b7282e1",
                                                "text": "„Das im südwestlichen Nordrhein-Westfalen und nördlichen Rheinland-Pfalz gelegene Ahrtal wird von der 89 km langen Ahr durchflossen.“"
                                            },
                                            {
                                                "example_id": "6f4e9b8b-1b58-4222-9c67-02ffa124fc8c",
                                                "sense_id": "222d02c5-d295-3dde-b1f4-82893b7282e1",
                                                "text": "Kurz dachten wir darüber nach, die Ahr hinab zu paddeln."
                                            },
                                            {
                                                "example_id": "bdcbfd90-faae-4a33-9b34-ca9ab397a58f",
                                                "sense_id": "222d02c5-d295-3dde-b1f4-82893b7282e1",
                                                "text": "Wir überquerten die Ahr."
                                            },
                                            {
                                                "example_id": "a9b713c0-7ea6-4f65-a3b5-46252283adea",
                                                "sense_id": "222d02c5-d295-3dde-b1f4-82893b7282e1",
                                                "text": "Die Kinder versuchten, in der Ahr zu baden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "08eb8cd1-274d-3a63-8b4b-30079ac32e5a",
                                        "entry_id": "64ee4269-cf60-3988-8e21-2d14b8eb4980",
                                        "glosses": [
