                },
                {
                    "sense_id": "2d468048-1754-3a32-b216-60a6fbdd94d8",
                    "sense_definition": "Qualité d'une personne sincère, naturelle et franche dans ses manières ou ses paroles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "naturel",
                    "name_type": "no",
                    "examples": [
