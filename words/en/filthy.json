                    "target_lang_definitions": {
                        "ru": "Сильно пачкать; делать что-либо грязным.",
                        "zh": "使变得非常脏；弄脏某物。",
                        "es": "Hacer que algo se ensucie mucho."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пачкать",
                                "target_lang_sense_clarification": "делать грязным"
                            },
                            {
                                "target_lang_word": "загрязнять",
                                "target_lang_sense_clarification": "вносить грязь или мусор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弄脏",
                                "target_lang_sense_clarification": "使物体表面沾上污垢"
                            },
                            {
