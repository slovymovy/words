{
    "word_family": [
        "vallen",
        "neerwaarts",
        "val"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3ecbd251-f06d-343a-9e08-a65cccd2c926",
                    "sense_definition": "Ineenzakken doordat je jezelf niet meer overeind kunt houden, bijvoorbeeld door uitputting of ziekte.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "instorten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vermoeide soldaten moesten blijven marcheren tot ze erbij <w>neervielen</w>.",
                            "target_lang_translations": {
                                "en": "The tired soldiers had to keep marching until they <w>dropped</w>."
                            }
                        },
                        {
                            "text": "Na de marathon zag ik verschillende lopers uitgeput op het gras <w>neervallen</w>.",
                            "target_lang_translations": {
                                "en": "After the marathon, I saw several runners <w>collapse</w> exhausted on the grass."
                            }
                        }
                    ],
                    "synonyms": [
                        "ineenzakken",
                        "flauwvallen",
                        "tuimelen"
                    ],
                    "antonyms": [
                        "opstaan"
                    ],
                    "common_phrases": [
                        "erbij neervallen",
                        "uitgeput neervallen"
                    ],
                    "target_lang_definitions": {
                        "en": "To collapse or fall over because you can no longer keep yourself upright, for example due to exhaustion or illness."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "collapse",
                                "target_lang_sense_clarification": "due to exhaustion or illness"
                            },
                            {
                                "target_lang_word": "drop",
                                "target_lang_sense_clarification": "from exhaustion"
                            },
                            {
                                "target_lang_word": "fall down",
                                "target_lang_sense_clarification": "to collapse to the ground"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ee4e113-0df3-34c6-920d-d11b47205099",
                    "sense_definition": "Op de grond vallen of neerstorten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zag de zware vaas plotseling van de tafel op de grond <w>neervallen</w>.",
                            "target_lang_translations": {
                                "en": "I suddenly saw the heavy vase <w>fall down</w> from the table onto the ground."
                            }
                        },
                        {
                            "text": "Door de harde wind liet de boom zijn bladeren snel <w>neervallen</w>.",
                            "target_lang_translations": {
                                "en": "Because of the strong wind, the tree let its leaves <w>fall</w> quickly."
                            }
                        }
                    ],
                    "synonyms": [
                        "vallen",
                        "struikelen",
                        "tuimelen"
                    ],
                    "antonyms": [
                        "opstaan"
                    ],
                    "common_phrases": [
                        "op de grond neervallen"
                    ],
                    "target_lang_definitions": {
                        "en": "To fall to the ground or tumble down."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fall down",
                                "target_lang_sense_clarification": "to the ground"
                            },
                            {
                                "target_lang_word": "fall",
                                "target_lang_sense_clarification": "downward"
                            },
                            {
                                "target_lang_word": "drop",
                                "target_lang_sense_clarification": "to the ground"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dfcee55-9d3a-3a39-a7d8-193169bd063d",
                    "sense_definition": "Snel naar beneden bewegen of naar beneden laten klappen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een harde klap liet hij het houten portretje op het spelbord <w>neervallen</w>.",
                            "target_lang_translations": {
                                "en": "With a loud bang, he let the small wooden portrait <w>drop</w> onto the game board."
                            }
                        },
                        {
                            "text": "Je kunt de fiches snel laten <w>neervallen</w> om het spel te resetten.",
                            "target_lang_translations": {
                                "en": "You can quickly let the chips <w>fall down</w> to reset the game."
                            }
                        }
                    ],
                    "synonyms": [
                        "vallen"
                    ],
                    "common_phrases": [
                        "laten neervallen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move down quickly or to let something drop or flip down rapidly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fall down",
                                "target_lang_sense_clarification": "to drop down quickly"
                            },
                            {
                                "target_lang_word": "drop",
                                "target_lang_sense_clarification": "to let something fall down"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a0ee323-b85d-3315-abdd-24d8d51e7109",
                    "sense_definition": "Plotseling sterven, vaak door een acute oorzaak.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sterven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is schokkend hoe sommige jonge atleten plotseling dood op het veld <w>neervallen</w>.",
                            "target_lang_translations": {
                                "en": "It is shocking how some young athletes suddenly <w>drop dead</w> on the field."
                            }
                        },
                        {
                            "text": "In die oude film zag je de schurk na het schot direct dood <w>neervallen</w>.",
                            "target_lang_translations": {
                                "en": "In that old movie, you saw the villain <w>fall dead</w> immediately after the shot."
                            }
                        }
                    ],
                    "synonyms": [
                        "overlijden",
                        "succumberen"
                    ],
                    "common_phrases": [
                        "dood neervallen"
                    ],
                    "target_lang_definitions": {
                        "en": "To die suddenly, often due to an acute cause."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drop dead",
                                "target_lang_sense_clarification": "to die suddenly"
                            },
                            {
                                "target_lang_word": "fall dead",
                                "target_lang_sense_clarification": "to collapse and die"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}