                "senses": [
                    {
                        "sense_id": "8242032c-bed6-3cbb-80d1-d4f91ebae22e",
                        "entry_id": "3e93c393-b471-33ac-850f-dbe3f06b2221",
                        "glosses": [
                            "A pile of rocks."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "9649d24f-4df3-4281-ade8-cd47d318a7d6",
                                "sense_id": "8242032c-bed6-3cbb-80d1-d4f91ebae22e",
                                "text": "Besides the single bason above-mention'd, I could not perceive one in all the rocks; but in a Karn below, overlooking, and it's sides almost perpendicular to the sea, I saw many furrows and clefts crossing the surface of the upper rocks; this lower-most Karn is call'd in the Cornish tongue Karn-a-wethen, that is, the Tree-Karn […]"
                            },
                            {
                                "example_id": "7786f75d-4dec-4c3d-b900-31c941793cdd",
                                "sense_id": "8242032c-bed6-3cbb-80d1-d4f91ebae22e",
                                "text": "This gorseddau lies opposite to a karn of rocks, which is called the Cheese-wring."
                            },
                            {
                                "example_id": "a971d49a-25c5-463a-9f25-32397ef4e209",
                                "sense_id": "8242032c-bed6-3cbb-80d1-d4f91ebae22e",
                                "text": "This quoit was brought from a karn about a furlong distance, near which is another cromlech, not so large."
                            }
                        ]
                    }
                ],
