                "senses": [
                    {
                        "sense_id": "341cccc4-e794-30bc-9771-08de07d97079",
                        "entry_id": "f69dc0eb-524a-30f0-b487-1bc46d5406dd",
                        "glosses": [
                            "Unterkunft für die Nacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a18d593-2605-43a1-aa66-b046597e516d",
                                "sense_id": "341cccc4-e794-30bc-9771-08de07d97079",
                                "text": "„Was wir zum Arbeiten brauchten, hatte Staszek nach Warschau vorgeschickt, und so hatten wir das Auto nur mit Westwaren vollgepackt, mit denen man Nachtquartiere bezahlen, Tür und Tor öffnen oder die man verschenken konnte.“"
                            },
                            {
                                "example_id": "ed9ede23-ed7c-4e1b-b48d-7a8721d49151",
                                "sense_id": "341cccc4-e794-30bc-9771-08de07d97079",
                                "text": "„Martins Schwadron suchte ein Nachtquartier, in dem auch die Pferde versorgt werden konnten.“"
                            },
                            {
                                "example_id": "c3d3a3f6-f98c-4fc9-adae-6a6bc683011f",
                                "sense_id": "341cccc4-e794-30bc-9771-08de07d97079",
                                "text": "„Von diesem Tage an war Natascha unentwegt um den verwundeten Bolkonskij, während der ganzen weiteren Fahrt der Rostows, immer, wenn halt gemacht oder ein Nachtquartier bezogen wurde, und der Arzt musste zugeben, dass er nie von einem jungen Mädchen so viel Energie und so viel Geschicklichkeit in der Krankenpflege erwartet hätte.“"
                            },
                            {
                                "example_id": "19d82051-ffec-4d32-ac30-0189649a9ec0",
                                "sense_id": "341cccc4-e794-30bc-9771-08de07d97079",
                                "text": "„Da schlugen sie ihr Nachtquartier auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
