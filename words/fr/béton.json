                    "frequency": "High",
                    "semantic_group_id": "materiau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers préparent le chantier pour couler le <w>béton</w> des fondations de la maison."
                        },
                        {
                            "text": "Cet immeuble moderne a été entièrement construit en <w>béton</w> armé."
                        }
                    ],
                    "common_phrases": [
