                                "target_senses": [
                                    {
                                        "sense_id": "3e9eb1d1-3229-36a2-8b51-e9dd338ef368",
                                        "entry_id": "32207a8e-cb7d-3d8f-9b3b-99962d95809d",
                                        "glosses": [
                                            "A judicial examination."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d43b87bd-d5a2-3f8c-8c9a-6a93afd448ba",
                                        "entry_id": "32207a8e-cb7d-3d8f-9b3b-99962d95809d",
                                        "glosses": [
                                            "An examination in general."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4228634-fa46-3a29-89fe-7b161f8fddd3",
                                        "entry_id": "32207a8e-cb7d-3d8f-9b3b-99962d95809d",
                                        "glosses": [
                                            "An independent review and examination of records and activities to assess the adequacy of system controls, to ensure compliance with established policies and operational procedures, and to recommend necessary changes in controls, policies, or procedures"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84d792d8-87e0-4a29-8e39-9a0ca67e6a15",
                                                "sense_id": "c4228634-fa46-3a29-89fe-7b161f8fddd3",
                                                "text": "National Assembly audit"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42d3727c-73b7-3990-a165-c13918ea3476",
                                        "entry_id": "32207a8e-cb7d-3d8f-9b3b-99962d95809d",
                                        "glosses": [
                                            "The result of such an examination, or an account as adjusted by auditors; final account."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3695635-f3e8-4baa-8b6c-9e64c9a826ec",
                                                "sense_id": "42d3727c-73b7-3990-a165-c13918ea3476",
                                                "text": "Yet I can make my audit up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "792faba4-9a40-356f-a217-a3bbe726ef04",
                                        "entry_id": "32207a8e-cb7d-3d8f-9b3b-99962d95809d",
                                        "glosses": [
                                            "Spiritual counseling, which forms the core of Dianetics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b56a8031-6fd8-43f8-a672-835c6f3ef626",
                                                "sense_id": "792faba4-9a40-356f-a217-a3bbe726ef04",
                                                "text": "[ Werner Erhard said:] I got a lot of benefit from auditing. It was the fastest and deepest way to handle situations that I had yet encountered."
                                            },
                                            {
                                                "example_id": "c4a4c360-85e5-4ecf-9d36-66a38bc59772",
                                                "sense_id": "792faba4-9a40-356f-a217-a3bbe726ef04",
                                                "text": "The trainings of Landmark, Block Training and UP Hans Schuster und Partner thus display strong similarities with the self-improvement seminars of Scientology, which are incidentally called 'auditing sessions', a term taken from the business world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ac29932-08bc-3950-ac24-dce7516468a0",
                                        "entry_id": "32207a8e-cb7d-3d8f-9b3b-99962d95809d",
                                        "glosses": [
                                            "A general receptacle or receiver."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "305bd6e6-63db-4669-b38a-86388d4ee1b9",
                                                "sense_id": "9ac29932-08bc-3950-ac24-dce7516468a0",
                                                "text": ", \"A Funeral Sermon\"\nIt [a little brook] paid to its common audit no more than the revenues of a little cloud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "695b7e4a-6c00-3173-a411-80b428a84a41",
                                        "entry_id": "32207a8e-cb7d-3d8f-9b3b-99962d95809d",
                                        "glosses": [
                                            "An audience; a hearing."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb1e18c7-997e-4ead-b927-64b675f0c45d",
                                                "sense_id": "695b7e4a-6c00-3173-a411-80b428a84a41",
                                                "text": "With his Oriſons I meddle not, for hee appeals to a high Audit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "audit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78171ad2-d5cd-3a84-9337-208e5bebd061",
                                        "entry_id": "66b6bf43-2849-36fa-a4da-636c15cf62d4",
                                        "glosses": [
                                            "To examine and adjust (e.g. an account)."
