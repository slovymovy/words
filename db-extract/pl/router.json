                    },
                    {
                        "translation_id": "e9d02781-60b9-40ec-bbd2-ecc3d25d9214",
                        "source_entry_id": "ab96d414-3194-3358-94f0-2a8673a7ca12",
                        "source_sense_id": "a49f0d34-7e6e-302b-955a-1cf17b4185c0",
                        "target_lang_word": "routeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "routeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9874070-f2cf-3dce-99ef-4f4b320e4a7c",
                                        "entry_id": "61b507cf-b3d7-3196-96a3-f227cf4850e9",
                                        "glosses": [
                                            "Ouvrier chargé de la conduite de machines spécialisées pour l’étiquetage, la mise sous pli ou l’emballage d’imprimés, journaux, prospectus… destinés à être diffusés par routage."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ceccde85-ab3b-32b5-af33-488b3c75a674",
                                        "entry_id": "61b507cf-b3d7-3196-96a3-f227cf4850e9",
                                        "glosses": [
                                            "Éclaireur qui, dans une expédition, détermine la route à suivre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "109a3479-ce95-4397-88b3-f7d33e5f3f23",
                                                "sense_id": "ceccde85-ab3b-32b5-af33-488b3c75a674",
                                                "text": "Les routeurs russes qui nous avaient annoncé quelques jours de tempête et de dérive ne se sont pas trompés. Hélas. Dans ces conditions, pas facile de se faufiler avec nos traîneaux, d’autant plus que le terrain est cassé de partout."
                                            },
                                            {
                                                "example_id": "96507e84-2dd0-458f-a027-079a3235886a",
                                                "sense_id": "ceccde85-ab3b-32b5-af33-488b3c75a674",
                                                "text": "Connaissant tous deux l’ineffable personnage, nous sommes persuadés qu’il n’entend pas la même météo que nous de la bouche de Yann, préférant écouter les prévisions plus optimistes d’autres routeurs…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c74154d-be34-3847-af7e-fc09d034ab77",
                                        "entry_id": "61b507cf-b3d7-3196-96a3-f227cf4850e9",
                                        "glosses": [
                                            "Dispositif situé en un nœud d’un réseau de données qui détermine, pour chaque trame, paquet ou cellule, la route à suivre dans le réseau."
                                        ],
                                        "tags": [
                                            "Réseaux informatiques"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc6bc51d-63ad-4e8f-8b7d-0a594306642e",
                                                "sense_id": "2c74154d-be34-3847-af7e-fc09d034ab77",
                                                "text": "Chaque utilisateur désigne le routeur par l’adresse IP de l’interface réseau qu’il connaît. On voit donc bien que l’adresse IP ne définit pas une machine mais une interface réseau."
                                            },
                                            {
                                                "example_id": "0c5c8875-0b9b-44b0-9dbf-2e88570c8ebd",
                                                "sense_id": "2c74154d-be34-3847-af7e-fc09d034ab77",
                                                "text": "Les policiers sont repartis avec l’ordinateur de la propriétaire, son routeur, son assistant virtuel Alexa et des téléphones cellulaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c0b368b-5591-3a72-b678-35963bde8edf",
                                        "entry_id": "61b507cf-b3d7-3196-96a3-f227cf4850e9",
                                        "glosses": [
                                            "Logiciel chargé de créer la carte des interconnexions métalliques entre les points d’entrée et de sortie des éléments de technothèque d’un circuit intégré électronique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d090586-2c16-3b1c-8aaf-8cf0b6793de0",
                                        "entry_id": "61b507cf-b3d7-3196-96a3-f227cf4850e9",
                                        "glosses": [
                                            "Celui qui utilise un tel logiciel."
