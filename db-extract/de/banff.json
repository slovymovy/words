                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0560f145-7ac0-4bbd-af9a-8a12aac9f685",
                                "sense_id": "108b2896-4427-38b7-afb5-15c1c37ddca3",
                                "text": "„Beim Frühstück in Banff oder Bern sagte ich: ›Wir mögen keine fettfreien, fair gehandelten Tofuwürstchen, und wir ersuchen darum, dass unso so etwas nicht mehr vorgesetzt wird.‹“"
                            },
                            {
                                "example_id": "0a88e737-f3d8-469c-ba0e-b19275da918d",
                                "sense_id": "108b2896-4427-38b7-afb5-15c1c37ddca3",
                                "text": "„Sie schlafen im Eingang eines Lagerhauses, und nicht einmal in Banff oder Hongkong haben sie sich jemals so wohl gefühlt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
