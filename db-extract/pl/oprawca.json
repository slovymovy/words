                        "sense_id": "8517b7ff-f641-3201-83ef-b9db866e4be5",
                        "entry_id": "9f90ada7-6584-3d60-8306-a3392282c014",
                        "glosses": [
                            "osoba torturująca lub mordująca z czyjegoś polecenia"
                        ],
                        "tags": [],
