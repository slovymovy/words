                "senses": [
                    {
                        "sense_id": "2f48bc54-7bc3-3000-bf17-b9725f5511ca",
                        "entry_id": "be3c113f-0fc1-3868-8507-6ace5dda51d0",
                        "glosses": [
                            "Person, die in Lehrte geboren wurde oder dort dauerhaft lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5104758b-02eb-4ff2-ae08-183972edde4d",
                                "sense_id": "2f48bc54-7bc3-3000-bf17-b9725f5511ca",
                                "text": "„Wenn es einen besseren Namen gäbe, sollten sich die Berliner nicht um die Lehrter scheren.“"
                            },
                            {
                                "example_id": "1c839526-68de-4a7d-9f78-636d4023f60e",
                                "sense_id": "2f48bc54-7bc3-3000-bf17-b9725f5511ca",
                                "text": "„Die Lehrter sind meinungsfreudig: Die sogenannte Wikimap, bei der die Bürger via Internetportal Lob und Kritik an der Stadt äußern können, ist offenbar ein Volltreffer.“"
                            },
                            {
                                "example_id": "b84f50aa-6706-4859-bf5c-ac7871225f04",
                                "sense_id": "2f48bc54-7bc3-3000-bf17-b9725f5511ca",
                                "text": "„Die Lehrter bieten handbemalte Wachtel-, Tauben-, Hühner-, Gänse- und Straußeneier an.“"
                            },
                            {
                                "example_id": "6488b938-2ac5-4200-a374-ea5a63e09dd7",
                                "sense_id": "2f48bc54-7bc3-3000-bf17-b9725f5511ca",
                                "text": "„Er habe den Eindruck, dass die Verantwortlichen der Bahn den Lehrtern bisher vorsätzlich wesentliche Daten vorenthalten hätten.“"
                            },
                            {
                                "example_id": "99494832-9425-4080-aed8-665c0a4cc4e5",
                                "sense_id": "2f48bc54-7bc3-3000-bf17-b9725f5511ca",
                                "text": "„Die Heimatstadt ohne ihr Krankenhaus? Das ist undenkbar für viele Lehrter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
