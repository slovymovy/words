                "senses": [
                    {
                        "sense_id": "52a01c26-0394-3be2-a880-008b07acd100",
                        "entry_id": "6be224fb-5e40-3a37-9e9f-9242f0b050ad",
                        "glosses": [
                            "Grad der Verfügbarkeit erwünschter oder benötigter Einrichtungen oder Gegenstände"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb624d30-5810-4861-a551-e5dc917c58e7",
                                "sense_id": "52a01c26-0394-3be2-a880-008b07acd100",
                                "text": "„Zur selben Zeit zeigte sich, dass alle Hoffnungen auf eine Entspannung der Versorgungslage durch eine gute Kartoffelernte reines Wunschdenken waren.“"
                            },
                            {
                                "example_id": "db58948a-e50c-4da1-8ede-c5bfee58f32e",
                                "sense_id": "52a01c26-0394-3be2-a880-008b07acd100",
                                "text": "„Waren die Deutschen auf dem Vormarsch, konnten sie die schlechte Versorgungslage manchmal kompensieren, indem sie zurückgelassene britische Nachschublager plünderten.“"
                            },
                            {
                                "example_id": "8d191617-9d0f-4d4b-b99a-a2ce25105778",
                                "sense_id": "52a01c26-0394-3be2-a880-008b07acd100",
                                "text": "„Der ›Fürkauf‹ von Getreide, das spekulative Aufkaufen und Horten, konnte nach schlechten Ernten eine schwierige Versorgungslage durch eine Preisexplosion zur Hungersnot verschärfen wie 1538/39 in Wittenberg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
