                        "form": "carabiniers"
                    },
                    {
                        "form_id": "de4eb397-f42c-4078-a9f7-bafaba4793d7",
                        "entry_id": "06078302-c44c-38ae-b359-db5222f74df0",
                        "tags": [
                            "feminine"
                        ],
                        "form": "carabinière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "108410af-2426-3fc0-bc74-722e955bbe32",
                        "entry_id": "06078302-c44c-38ae-b359-db5222f74df0",
                        "glosses": [
                            "Soldat de cavalerie armé d’une carabine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "190621d1-ae67-479c-b698-32ef8e0619ac",
                                "sense_id": "108410af-2426-3fc0-bc74-722e955bbe32",
                                "text": "On ne s’est pas occupé, il est vrai, de créer de la cavalerie, mais on a organisé une nuée de carabiniers, qui, à quelques cents pas, choisissent leur homme, et le frappent sur le bouton qu’ils ont désigné."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e49b820-dd79-3ac3-850a-bda0dfda9d2c",
                        "entry_id": "06078302-c44c-38ae-b359-db5222f74df0",
                        "glosses": [
                            "Sorte de gendarme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "037f399c-0c2a-4296-a901-18eeec2f4be9",
                                "sense_id": "3e49b820-dd79-3ac3-850a-bda0dfda9d2c",
                                "text": "Étant donné la nature ambivalente du Corps des carabiniers du Chili (force de police et force constituant virtuellement une quatrième Arme), c’est par un double canal que se sont développées ses relations avec les États-Unis."
                            },
                            {
                                "example_id": "5830721c-6cdf-4757-a82f-6ddd8677946e",
                                "sense_id": "3e49b820-dd79-3ac3-850a-bda0dfda9d2c",
                                "text": "À Scionzier, en août 1852, l'altercation se déroule dans l'auberge, à 22 h 30, jour de la vogue, en « fin de veillée. » Quatre jeunes gens, tous fabricants de pignons de montre, entonnent « La République en Savoie règnera » au nez des carabiniers présents dans la salle."
                            }
                        ]
                    },
                    {
                        "sense_id": "01b811c9-a6e4-3a72-9bd7-33d4cc7a4cbb",
                        "entry_id": "06078302-c44c-38ae-b359-db5222f74df0",
                        "glosses": [
                            "Garde du palais et protecteur de la famille du prince suzerain de Monaco."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "a160cac4-e951-4c58-b461-e929195273d1",
                                "sense_id": "01b811c9-a6e4-3a72-9bd7-33d4cc7a4cbb",
                                "text": "Le prince de Monaco donna une livre de tabac de gratification à chacun de ses cinquante carabiniers, et les envoya fumer sur les frontières du roi Charles-Albert."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7350675-7197-372a-89c2-4551a5c6a509",
                        "entry_id": "06078302-c44c-38ae-b359-db5222f74df0",
                        "glosses": [
                            "Pratiquant du tir sportif à la carabine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbc98239-7974-4560-92f2-e11be2a72d39",
                                "sense_id": "f7350675-7197-372a-89c2-4551a5c6a509",
                                "text": "Simple et souriant, celui qui a fait ses classes de carabinier au CREPS de Strasbourg semble imperméable à la pression, à trois mois à peine des Jeux."
                            }
                        ]
                    },
                    {
                        "sense_id": "b682a342-2343-3e73-b4e9-8494a678c52b",
                        "entry_id": "06078302-c44c-38ae-b359-db5222f74df0",
                        "glosses": [
                            "Désignation du grade d’un membre d’un régiment de carabiniers détenant le grade de soldat."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
