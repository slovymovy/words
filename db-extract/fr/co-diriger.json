                "senses": [
                    {
                        "sense_id": "ba6759a9-8b51-3e45-897b-1532629d0b3b",
                        "entry_id": "503f7bd3-28bf-3a44-ace2-5fa3e22ebd98",
                        "glosses": [
                            "Diriger conjointement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b52e5375-4562-4225-b7da-5d91ec004c49",
                                "sense_id": "ba6759a9-8b51-3e45-897b-1532629d0b3b",
                                "text": "Mais, comme elle a senti que j’étais hésitant par sentiment d’incompétence, elle m’a proposé de co-diriger le travail."
                            },
                            {
                                "example_id": "ff83c745-1ea9-4bd7-9b19-2d4036de8e4c",
                                "sense_id": "ba6759a9-8b51-3e45-897b-1532629d0b3b",
                                "text": "Je remercie vivement Monsieur le Professeur Hans Manfred Bock qui, en collaboration avec Monsieur le Professeur Michel Grunewald, a accepté de co-diriger cette thèse."
                            }
                        ]
                    }
