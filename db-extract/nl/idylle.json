                        "entry_id": "32ffff1c-58a1-3892-bcc0-f06f2d8ffd30",
                        "glosses": [
                            "toestand van eenvoudig, vreedzaam leven (zodanig dat het in een idyllisch gedicht beschreven zou kunnen worden)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15119277-d543-4fe7-8e95-c129cd763d75",
                                "sense_id": "6df1e9dd-8783-35ac-9d47-65aad54a5760",
                                "text": "De idylle werd wreed gestoord."
                            },
                            {
                                "example_id": "0190ec31-f222-4603-b2e2-11dc86f4cc03",
                                "sense_id": "6df1e9dd-8783-35ac-9d47-65aad54a5760",
                                "text": "De streek is een bosrijke idylle."
