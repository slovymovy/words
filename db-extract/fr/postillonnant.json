                        "examples": [
                            {
                                "example_id": "f20cafd5-b1e4-45b6-973e-f4082b9b1ed3",
                                "sense_id": "ae7ef342-69e1-3398-9a48-3c38432c5f82",
                                "text": "Paulo Alfonso ^([sic : Paulo Afonso]) déborde d’une eau tumultueuse, tourbillonnante et déchaînée. Tout un fleuve [le Rio São Francisco] jaillit pour rebondir dans vingt, trente, cinquante gorges taillées dans le roc et qui se renvoient des chutes ou des cascades, des roulements de tambour ou des cris aigus, des gerbes écumantes, postillonnantes ou des jets d’une seule lancée."
                            }
                        ]
                    }
