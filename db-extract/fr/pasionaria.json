                "senses": [
                    {
                        "sense_id": "4987c4bd-25d5-3b65-a925-f287b149482c",
                        "entry_id": "468dcfb7-957f-3ceb-a612-331ac46934c9",
                        "glosses": [
                            "Combattante, femme engagée dans une cause sociale (le plus souvent à gauche)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9843406-da2b-4db4-a55e-ac2e47394ec9",
                                "sense_id": "4987c4bd-25d5-3b65-a925-f287b149482c",
                                "text": "La première nuit d'amour de la taxiwoman l'avait transformée en pasionaria."
                            },
                            {
                                "example_id": "6d687152-da4c-4491-b4ce-71345345088e",
                                "sense_id": "4987c4bd-25d5-3b65-a925-f287b149482c",
                                "text": "Grâce à l’ancienne pasionaria des autoroutes, les péages vont augmenter l’année prochaine de 1,03 à 2,04 %, selon le « JDD » (19/11), bien plus que ce que prévoit la stricte application des accords de concession (0,70 %)."
                            },
                            {
                                "example_id": "feb2c2b0-b649-4d13-a40b-6493ce5ee2bd",
                                "sense_id": "4987c4bd-25d5-3b65-a925-f287b149482c",
                                "text": "Elle était plus calme et douce que prévu. Corso s’attendait à une pasionaria hystérique."
                            },
                            {
                                "example_id": "0a7e147d-da79-456f-878b-a6f92ec074aa",
                                "sense_id": "4987c4bd-25d5-3b65-a925-f287b149482c",
                                "text": "La pasionaria de la droite nationale italienne est en passe de gagner son pari. En refusant de rejoindre le gouvernement Draghi, contrairement à ses alliés conservateurs, elle a placé sa formation en tête des intentions de vote en vue des législatives de 2023."
                            }
                        ]
                    }
