                        ],
                        "form": "прожи́лке"
                    },
                    {
                        "form_id": "c26fe520-06cd-4ded-92cc-fb69d00f7f84",
                        "entry_id": "05e01ac4-6d9f-3ad4-a9e4-10c4a92ea3d2",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "прожи́лках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d4f39090-fee0-3e10-a2e5-1c7db23d50ee",
                        "entry_id": "05e01ac4-6d9f-3ad4-a9e4-10c4a92ea3d2",
                        "glosses": [
                            "тонкая цветная полоска, промежуточный узкий слой в камне, дереве, металле и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d084bc2-b57e-46e7-a5b0-c84e244a2e96",
                                "sense_id": "d4f39090-fee0-3e10-a2e5-1c7db23d50ee",
                                "text": "Синие прожилки в белом мраморе."
                            },
                            {
                                "example_id": "1b4575dd-56e8-41e2-896d-19eedeb45ecc",
                                "sense_id": "d4f39090-fee0-3e10-a2e5-1c7db23d50ee",
                                "text": "Прожилки золота в кварце."
                            },
                            {
                                "example_id": "692cd4fd-a91e-4984-be8b-82b90826595c",
                                "sense_id": "d4f39090-fee0-3e10-a2e5-1c7db23d50ee",
                                "text": "Кое-где прихотливо извилистые снежно-белые прожилки известкового шпата и кварца резко выступали на мрачном фоне."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9a42df8-0470-3288-9511-e222f8e03b2b",
                        "entry_id": "05e01ac4-6d9f-3ad4-a9e4-10c4a92ea3d2",
                        "glosses": [
                            "жилка, просвечивающаяся сквозь кожу; также о линиях на листьях, цветах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b93db4f6-87c4-49df-97d2-6b81fcec790d",
                                "sense_id": "e9a42df8-0470-3288-9511-e222f8e03b2b",
                                "text": "Голубые, иссечённые прожилками веки припухлы и тяжки."
                            },
                            {
                                "example_id": "648ffd7f-a53a-4506-9812-87c42e275283",
                                "sense_id": "e9a42df8-0470-3288-9511-e222f8e03b2b",
                                "text": "Кожа у неё была белая, сметанная, с голубенькими прожилками на бёдрах."
                            },
                            {
                                "example_id": "e37160fe-6a0c-4d4c-9246-b57909ad41d3",
                                "sense_id": "e9a42df8-0470-3288-9511-e222f8e03b2b",
                                "text": "В активе на сотню меньше, зато в руках — семь пурпурных, с розовыми прожилками гвоздик, таких больших и бодрых, что хотелось их надкусить."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aea1e7e8-1c54-4893-84c0-d4adee302178",
                        "source_entry_id": "05e01ac4-6d9f-3ad4-a9e4-10c4a92ea3d2",
                        "source_sense_description": "тонкая цветная полоска, промежуточный узкий слой в материале",
                        "target_lang_word": "nervure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nervure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "042c49c0-f296-32fd-ab0a-f0ee7985be82",
                                        "entry_id": "3ca34c95-443d-3760-acf6-2b5b5588eee2",
                                        "glosses": [
                                            "Ensemble des vaisseaux conducteurs de la sève formant un réseau à la surface d'une feuille, d'un sépale ou d'un pétale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8f97ba1-98c5-434b-80f7-fbc8c084032e",
                                                "sense_id": "042c49c0-f296-32fd-ab0a-f0ee7985be82",
                                                "text": "La principale nervure de la feuille, généralement plus épaisse que les autres, est appelée nervure médiane."
                                            },
                                            {
                                                "example_id": "ae84c0a8-d139-492b-a8fd-f425c5548be0",
                                                "sense_id": "042c49c0-f296-32fd-ab0a-f0ee7985be82",
                                                "text": "Du point de vue du physicien, les nervures des feuilles apparaissent désespérément complexes. Pour simplifier, nous nous contentons de savoir qu’une nervure se compose d’une variété de tissus, dont le xylème qui conduit la sève brute et le phloème qui fait circuler la sève élaborée, c’est-à-dire les sucres synthétisés par la plante ; par ailleurs, les fibres donnent à la nervure sa stabilité mécanique et l’ensemble est enveloppé par une gaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adc2ae0f-3d5c-3c77-85ea-1fcfb66865b5",
                                        "entry_id": "3ca34c95-443d-3760-acf6-2b5b5588eee2",
                                        "glosses": [
                                            "Sorte de structure qui renforce la membrane de l'aile des insectes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ab7bf0e-3c5a-4dab-a3ed-5ff18f8c6abb",
                                                "sense_id": "adc2ae0f-3d5c-3c77-85ea-1fcfb66865b5",
                                                "text": "Ce sont les larves des pucerons […]. Complètement développées, ces larves deviennent de jolis insectes, pourvus de quatre ailes diaphanes, presque deux fois plus longues et plus larges que le corps entier, et soutenues par quelques rares nervures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfe4b4f4-91f0-35c4-9b4c-28229dd1fa30",
                                        "entry_id": "3ca34c95-443d-3760-acf6-2b5b5588eee2",
                                        "glosses": [
                                            "Réunion des parties saillantes qui sont formées sur le dos d’un livre par les nerfs ou cordelettes qui servent à relier."
                                        ],
                                        "tags": [
                                            "Reliure"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "957679d2-f8b4-37db-9592-de3824838e1d",
                                        "entry_id": "3ca34c95-443d-3760-acf6-2b5b5588eee2",
                                        "glosses": [
                                            "Moulure saillante placée sur les arêtes d’une voûte, sur les côtés des cannelures, sur les arêtes des volutes, sur les angles des pierres, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e036675-c32d-4fd8-8e0e-d8b26681b266",
                                                "sense_id": "957679d2-f8b4-37db-9592-de3824838e1d",
                                                "text": "Le plafond était à poutrelles de hêtre relevées par des nervures dorées."
                                            },
                                            {
                                                "example_id": "e9c7cea8-2606-4ea4-b734-37813bb73d2a",
                                                "sense_id": "957679d2-f8b4-37db-9592-de3824838e1d",
                                                "text": "Chaque nervure, chaque arête sculptée, le moindre trait s'argenta."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "967cc363-d5a4-3409-a75b-68ca33ee535b",
                                        "entry_id": "3ca34c95-443d-3760-acf6-2b5b5588eee2",
                                        "glosses": [
                                            "Armature interne rigidifiant la voilure ou le fuselage tout en structurant la forme aérodynamique de l’aile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0dacb996-965b-3103-a920-da4c2c623598",
                                        "entry_id": "3ca34c95-443d-3760-acf6-2b5b5588eee2",
                                        "glosses": [
                                            "Pliures ou ondulation sur une tôle permettant de la rigidifier en augmentant son moment quadratique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "efa095c1-271e-3cde-bb2d-4bdf2230f4a1",
                                        "entry_id": "3ca34c95-443d-3760-acf6-2b5b5588eee2",
                                        "glosses": [
                                            "Marques sinueuses de certaines pierres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cf0a8e3-d26f-4eed-9802-cfd995dc819b",
                                                "sense_id": "efa095c1-271e-3cde-bb2d-4bdf2230f4a1",
                                                "text": "Partout le marbre blanc régnait. De la pierre marmoréenne émanait une douce clarté que les délicates nervures noires qui la parcouraient ne suffisaient pas à affaiblir."
                                            }
                                        ]
                                    }
                                ]
                            },
