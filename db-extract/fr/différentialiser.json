                ],
                "senses": [
                    {
                        "sense_id": "5f6f2401-d095-38d8-8799-8985ba725b51",
                        "entry_id": "4d16dec2-89c2-3ea1-b40c-dce4c3ef31f2",
                        "glosses": [
                            "Permettre aux roues de tourner à une vitesse différente lors d’une courbe, grâce à un différentiel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c0fb64b-d55f-471a-a15a-1af23b6cda01",
                                "sense_id": "5f6f2401-d095-38d8-8799-8985ba725b51",
                                "text": "Contrairement à tout ce qu'on entend dans le microcosme du modélisme, les différentiels servent à différentialiser et non pas à motricer."
                            }
                        ]
                    },
                    {
                        "sense_id": "70a4062f-77f2-32b6-a4fa-fb5617ad2c69",
                        "entry_id": "4d16dec2-89c2-3ea1-b40c-dce4c3ef31f2",
                        "glosses": [
                            "Différencier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfe8c6e2-9289-4f6d-be05-016f3284a597",
                                "sense_id": "70a4062f-77f2-32b6-a4fa-fb5617ad2c69",
                                "text": "Philosopher « à coups de marteau », c’est accidentaliser la façade ontologique illusoire de l’existant : briser, casser, fragmenter, éclater, partialiser, différentialiser, démembrer, lézarder."
                            },
                            {
                                "example_id": "564487e1-d190-48a9-8dbd-b7a717d88469",
                                "sense_id": "70a4062f-77f2-32b6-a4fa-fb5617ad2c69",
                                "text": "Nous tenons, pour nous différentialiser positivement d'autres acteurs du marché, à ne pas faire appel à des formateurs uniquement recrutés pour la durée d'un stage."
                            }
                        ]
                    }
                ],
