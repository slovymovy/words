                        "glosses": [
                            "To soothe again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "502c367e-55cb-4982-9d6c-eec834def76a",
                                "sense_id": "60a08c7b-149a-3c0c-badd-549d103f647f",
                                "text": "When the man had gone he resoothed the horse, but his hand stuck out only a few inches from his body."
                            },
                            {
                                "example_id": "0c0b038d-cdaa-4308-8f96-d3d2371a2330",
                                "sense_id": "60a08c7b-149a-3c0c-badd-549d103f647f",
                                "text": "Not remembering eats at you, but remembering soothes and resoothes."
                            },
                            {
                                "example_id": "e8b7c128-c7ff-41c2-ab61-a99ffec68f4b",
                                "sense_id": "60a08c7b-149a-3c0c-badd-549d103f647f",
                                "text": "They spent the rest of the day soothing and resoothing, sorting rhythms, and filling one another in on every facet of this crazy, ice-laden time."
                            }
                        ]
                    }
