                    {
                        "translation_id": "2d4adb09-d21e-413e-a8b0-dd63fa880cf6",
                        "source_entry_id": "c7d4e7cc-c149-35db-b1cd-f79b17054e22",
                        "source_sense_id": "b42ed35d-4352-3a7b-8500-7c89c59df397",
                        "source_sense_description": "zum Ausgleich eines Fehlers oder Mangels: wettmachend, verbessernd, positiv, ausgleichend",
                        "target_lang_word": "positiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "positiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "faf42031-4bf8-3cbf-bded-944151ac6deb",
                                        "entry_id": "30d47dec-1c37-3af0-9895-263820ae9cca",
                                        "glosses": [
                                            "erfreulich, erwünscht, wünschenswert; gut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74e9f899-10d8-4eab-9aab-2cb25e93c1d0",
                                                "sense_id": "faf42031-4bf8-3cbf-bded-944151ac6deb",
                                                "text": "Der Bewerber machte einen positiven Eindruck."
                                            },
                                            {
                                                "example_id": "93dc2e74-b033-4ac1-bdb0-2b05d2eaeea0",
                                                "sense_id": "faf42031-4bf8-3cbf-bded-944151ac6deb",
                                                "text": "Sie freut sich über die positive Bewertung ihrer Arbeit."
                                            },
                                            {
                                                "example_id": "94f5c4e9-865f-4a8d-8c73-a63242bc060e",
                                                "sense_id": "faf42031-4bf8-3cbf-bded-944151ac6deb",
                                                "text": "„In Griechenland ist die Einigung mit Brüssel im Schuldenstreit überwiegend positiv aufgenommen worden.“"
                                            },
                                            {
                                                "example_id": "b7c789ae-d3d0-4a03-a19c-466733a7e906",
                                                "sense_id": "faf42031-4bf8-3cbf-bded-944151ac6deb",
                                                "text": "„In Deutschland gebe es weiter ein ‚überwältigend positives‘ Bild von den USA. Das sagte RTL-Chefredakteur Peter Kloeppel beim Transatlantic Talk.“"
                                            },
                                            {
                                                "example_id": "8f79d866-1b3a-46f2-ac9a-d8529a47a469",
                                                "sense_id": "faf42031-4bf8-3cbf-bded-944151ac6deb",
                                                "text": "„Jeder Gleitschirmpilot und jede Pilotin kennt Momente in denen sich die Grenze zwischen positiver Aufregung und Fokussiertheit zu starken Emotionen und eingeengter Denkfähigkeit verschiebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0e9f5135-3821-34e5-9424-3d4573fdae08",
                                        "entry_id": "30d47dec-1c37-3af0-9895-263820ae9cca",
                                        "glosses": [
                                            "einen getesteten Sachverhalt bestätigend (manchmal unerfreulich, unerwünscht bis lebensbedrohlich)"
                                        ],
                                        "tags": [
                                            "Naturwissenschaften",
                                            "ohne Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "450551f3-8640-4b8b-951a-b84f84a1f987",
                                                "sense_id": "0e9f5135-3821-34e5-9424-3d4573fdae08",
                                                "text": "Das Testergebnis war positiv."
                                            },
                                            {
                                                "example_id": "2b114f37-0a97-4ede-8dd6-f9b37cd9a26a",
                                                "sense_id": "0e9f5135-3821-34e5-9424-3d4573fdae08",
                                                "text": "Mein Freund ist positiv auf HIV getestet."
                                            },
                                            {
                                                "example_id": "a7d02429-d5a8-453f-8f48-b77c255f551c",
                                                "sense_id": "0e9f5135-3821-34e5-9424-3d4573fdae08",
                                                "text": "„In Großbritannien wurden inzwischen mehr als 8000 Menschen positiv auf den Erreger Sars-CoV-2 getestet, […].“"
                                            },
                                            {
                                                "example_id": "8292f6eb-954c-445e-bce6-3dc3345e29f2",
                                                "sense_id": "0e9f5135-3821-34e5-9424-3d4573fdae08",
                                                "text": "„Die Russin Irina Starych wird nicht an den Winterspielen in Sotschi teilnehmen. Sie ist eine von drei Biathleten, die bei Dopingkontrollen in der Wettkampfpause positiv getestet wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "50c09518-07d7-3d8f-9359-13740c782fb9",
                                        "entry_id": "30d47dec-1c37-3af0-9895-263820ae9cca",
                                        "glosses": [
                                            "Zustimmung zum Ausdruck bringend; etwas bejahend"
                                        ],
                                        "tags": [
                                            "ohne Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ab39ab2-7fbe-4c3a-a529-885cf4fd6c22",
                                                "sense_id": "50c09518-07d7-3d8f-9359-13740c782fb9",
                                                "text": "Er reagierte positiv auf seinen Vorschlag."
                                            },
                                            {
                                                "example_id": "d791fda6-b198-4c02-a854-bc73391fb8d2",
                                                "sense_id": "50c09518-07d7-3d8f-9359-13740c782fb9",
                                                "text": "Denke positiv und sei nicht pessimistisch!"
                                            },
                                            {
                                                "example_id": "d2c61fe0-3661-4109-9edc-f290f4691ab5",
                                                "sense_id": "50c09518-07d7-3d8f-9359-13740c782fb9",
                                                "text": "„Wurde das Objekt vollständig zerstört?“ - „Positiv.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "da90d4c5-5020-37bc-90d5-8f9e3f4ecd72",
                                        "entry_id": "30d47dec-1c37-3af0-9895-263820ae9cca",
                                        "glosses": [
                                            "größer als Null"
                                        ],
                                        "tags": [
                                            "ohne Steigerung, von einer Zahl"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11fe2c89-41ee-4ae7-90c9-bb5b9794c7ba",
                                                "sense_id": "da90d4c5-5020-37bc-90d5-8f9e3f4ecd72",
                                                "text": "Es ist nur für positive Zahlen definiert."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "f3b7163f-e182-3a82-a680-3b4b021a451e",
                                        "entry_id": "30d47dec-1c37-3af0-9895-263820ae9cca",
                                        "glosses": [
                                            "mit Elektronenmangel oder -bedarf"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77bf39d1-c58c-43c2-9a69-ce5698d86159",
                                                "sense_id": "f3b7163f-e182-3a82-a680-3b4b021a451e",
                                                "text": "Es gibt positive und negative Ladungen; ist in einem System die Summe der positiven Ladungen gleich der Summe der negativen Ladungen, dann ist die Gesamtladung Null und das System elektrisch neutral."
                                            },
                                            {
                                                "example_id": "695b55ce-0735-453f-b5bc-fae77738b8b7",
                                                "sense_id": "f3b7163f-e182-3a82-a680-3b4b021a451e",
                                                "text": "„Nach dem Kern-Hülle-Modell von RUTHERFORD enthalten die winzigen Atomkerne die positive Ladung des Atoms und über 99,9 % der Atommasse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "5c6b31bd-42f7-333d-97ce-0ff888a1f32e",
                                        "entry_id": "30d47dec-1c37-3af0-9895-263820ae9cca",
                                        "glosses": [
                                            "im Gegensatz zum Negativ nicht seitenverkehrt und in Helligkeit und Farbton mit dem Aufgenommenen übereinstimmend"
                                        ],
                                        "tags": [
                                            "Fotografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe95584b-99fe-4db6-b084-d1846da60b0d",
                                                "sense_id": "5c6b31bd-42f7-333d-97ce-0ff888a1f32e",
                                                "text": "„Zur Belichtung der Kunstharzschicht, auf die der positive Film aufgelegt wird, eignet sich am besten kurzwelliges Licht, z. B. von einer UV- oder Bogenlampe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "540bbafa-9045-3b41-8178-c65eda5dc70c",
                                        "entry_id": "30d47dec-1c37-3af0-9895-263820ae9cca",
                                        "glosses": [
                                            "mit Sicherheit, ohne Zweifel bestehend, deutlich"
                                        ],
                                        "tags": [],
                                        "examples": [
