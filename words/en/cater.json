{
    "word_family": [
        "caterer",
        "catering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "347592e6-edf3-38e7-aa0a-b3575c0b42cf",
                    "sense_definition": "To provide food and drink, especially for a special occasion or as a professional service.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "provide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local restaurant will <w>cater</w> for our wedding reception next month.",
                            "target_lang_translations": {
                                "ru": "Местный ресторан будет <w>обслуживать</w> наш свадебный банкет в следующем месяце."
                            }
                        },
                        {
                            "text": "They decided to <w>cater</w> the event themselves to save some money.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>организовать питание</w> на мероприятии самостоятельно, чтобы сэкономить деньги."
                            }
                        }
                    ],
                    "synonyms": [
                        "caterer"
                    ],
                    "common_phrases": [
                        "cater for a wedding",
                        "cater an event"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивать едой и напитками, особенно для торжественных мероприятий или в качестве профессиональной услуги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обслуживать",
                                "target_lang_sense_clarification": "обеспечивать питанием мероприятие"
                            },
                            {
                                "target_lang_word": "организовывать питание",
                                "target_lang_sense_clarification": "профессионально поставлять еду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ae20090-56db-3ea6-b065-b39f8399d69c",
                    "sense_definition": "To tailor services, products, or information to meet the specific needs or interests of a particular group.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "provide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new clothing brand aims to <w>cater</w> for young professionals living in the city.",
                            "target_lang_translations": {
                                "ru": "Этот новый бренд одежды <w>ориентирован</w> на молодых специалистов, живущих в городе."
                            }
                        },
                        {
                            "text": "The hotel tries to <w>cater</w> to families by providing a large play area for children.",
                            "target_lang_translations": {
                                "ru": "Отель старается <w>угодить</w> семьям, предоставляя большую игровую зону для детей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cater for the needs",
                        "cater to an audience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Адаптировать услуги, продукты или информацию под конкретные нужды или интересы определенной группы людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ориентироваться",
                                "target_lang_sense_clarification": "на определенную аудиторию"
                            },
                            {
                                "target_lang_word": "обслуживать",
                                "target_lang_sense_clarification": "удовлетворять потребности группы"
                            },
                            {
                                "target_lang_word": "быть рассчитанным на",
                                "target_lang_sense_clarification": "предназначаться для кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ed6500c-4795-38a0-b637-872e7c00f272",
                    "sense_definition": "To provide exactly what is required or desired, often in a way that is considered excessive or indulgent.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "provide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The luxury resort is designed to <w>cater</w> to your every whim during your stay.",
                            "target_lang_translations": {
                                "ru": "Роскошный курорт создан для того, чтобы <w>потакать</w> любой вашей прихоти во время отдыха."
                            }
                        },
                        {
                            "text": "Some critics argue that the media tends to <w>cater</w> to the lowest common denominator.",
                            "target_lang_translations": {
                                "ru": "Некоторые критики утверждают, что СМИ склонны <w>ориентироваться</w> на самые низменные вкусы толпы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cater to every whim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять именно то, что требуется или желается, часто чрезмерно или потакая прихотям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угождать",
                                "target_lang_sense_clarification": "выполнять любые желания"
                            },
                            {
                                "target_lang_word": "потакать",
                                "target_lang_sense_clarification": "снисходительно удовлетворять прихоти"
                            },
                            {
                                "target_lang_word": "удовлетворять",
                                "target_lang_sense_clarification": "любые запросы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8401bb76-9448-384e-b02f-88a04d42d0aa",
                    "sense_definition": "To move, cut, or place something in a diagonal direction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "diagonal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener decided to <w>cater</w> the path across the lawn for a more aesthetic look.",
                            "target_lang_translations": {
                                "ru": "Садовник решил <w>проложить по диагонали</w> дорожку через газон для более эстетичного вида."
                            }
                        },
                        {
                            "text": "You must <w>cater</w> across the fabric to ensure the pattern aligns correctly.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>резать по косой</w>, чтобы рисунок на ткани совпал правильно."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "used in specific regional contexts or older texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться, резать или размещать что-либо в диагональном направлении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "располагать по диагонали",
                                "target_lang_sense_clarification": "наискосок"
                            },
                            {
                                "target_lang_word": "резать по косой",
                                "target_lang_sense_clarification": "о ткани или материале"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "10d317f1-21fa-3815-a088-ee5d1dc0911f",
                    "sense_definition": "The number four on a die or a playing card.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "four",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He rolled a <w>cater</w> and a trey to make a total of seven.",
                            "target_lang_translations": {
                                "ru": "Он выбросил <w>четверку</w> и тройку, что в сумме дало семь."
                            }
                        },
                        {
                            "text": "The gambler was hoping for a <w>cater</w> to win the final round of the game.",
                            "target_lang_translations": {
                                "ru": "Игрок надеялся на <w>четверку</w>, чтобы выиграть финальный раунд игры."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily used in the context of old games"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Число четыре на игральной кости или карте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "четверка",
                                "target_lang_sense_clarification": "в играх"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e23da97b-9f4d-3e60-be9c-a7f2980eb965",
                    "sense_definition": "A specific method of ringing nine bells where four pairs of bells change places.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ringing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The church tower was filled with the complex sound of the bells ringing <w>caters</w>.",
                            "target_lang_translations": {
                                "ru": "Церковная башня наполнилась сложным звуком колоколов, исполняющих <w>кейтерс</w>."
                            }
                        },
                        {
                            "text": "Learning to ring <w>caters</w> requires a great deal of practice and coordination among the team.",
                            "target_lang_translations": {
                                "ru": "Обучение звону <w>кейтерс</w> требует большой практики и координации внутри команды."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in campanology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Метод звона в девять колоколов, при котором четыре пары колоколов меняются местами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кейтерс",
                                "target_lang_sense_clarification": "технический термин в колокольном звоне"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3030325a-4659-3a3b-8d54-ba210d533a6d",
                    "sense_definition": "In a diagonal manner or position.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "diagonal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fabric was cut <w>cater</w> to give the dress a better drape.",
                            "target_lang_translations": {
                                "ru": "Ткань была раскроена <w>по косой</w>, чтобы платье лучше драпировалось."
                            }
                        },
                        {
                            "text": "He walked <w>cater</w> across the field to reach the gate more quickly.",
                            "target_lang_translations": {
                                "ru": "Он пошел <w>наискосок</w> через поле, чтобы быстрее добраться до ворот."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cut cater"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "found in certain English dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В диагональном положении или по диагонали."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наискосок",
                                "target_lang_sense_clarification": "по диагонали"
                            },
                            {
                                "target_lang_word": "по косой",
                                "target_lang_sense_clarification": "о крое ткани"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "fd0dbc18-dc68-3654-86a9-98b5fd275f4f",
                    "sense_definition": "An English surname that originally referred to a person who was a <w>caterer</w> or provider of food.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Cater</w> has lived in this village for over forty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Кейтер</w> живет в этой деревне уже более сорока лет."
                            }
                        },
                        {
                            "text": "The archives show that the <w>Cater</w> family owned a small bakery in the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Архивы показывают, что семья <w>Кейтер</w> владела небольшой пекарней в девятнадцатом веке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "occupational origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия, происходящая от профессии поставщика провизии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кейтер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}