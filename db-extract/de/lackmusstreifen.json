                                "target_senses": [
                                    {
                                        "sense_id": "c8d2bdf3-c664-3de1-ae09-22f9c3972f1f",
                                        "entry_id": "332d35f2-c4b8-327b-93a9-e56f73491006",
                                        "glosses": [
                                            "A simple, binary test for the acidity or alkalinity of a substance, using litmus paper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "254cfcc8-dd10-3919-8e59-5d1cdbb028eb",
                                        "entry_id": "332d35f2-c4b8-327b-93a9-e56f73491006",
                                        "glosses": [
                                            "Any test which produces a binary, decisive result (for example, determining whether to appoint someone to a job) by measuring a single indicator."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66bf5f71-2e78-452d-9ab6-f59d78208f66",
                                                "sense_id": "254cfcc8-dd10-3919-8e59-5d1cdbb028eb",
                                                "text": "Exams, not interviews, have become the litmus test for entry to university."
                                            },
                                            {
                                                "example_id": "51b50213-8e87-4ffa-8ab8-b9226815b708",
                                                "sense_id": "254cfcc8-dd10-3919-8e59-5d1cdbb028eb",
                                                "text": "Temple, under its new coach, Ray Morrison, formerly of Vanderbilt, will be put to the blue litmus test Friday night when it takes on Georgetown."
                                            },
                                            {
                                                "example_id": "0f989308-0bd2-4b2a-bbe1-8a12ca336bc9",
                                                "sense_id": "254cfcc8-dd10-3919-8e59-5d1cdbb028eb",
                                                "text": "For good reasons or bad, early membership of the currency union has become the litmus test of being a \"good European.\""
                                            },
                                            {
                                                "example_id": "65a8269d-d321-4536-a47a-bda240e02e2b",
                                                "sense_id": "254cfcc8-dd10-3919-8e59-5d1cdbb028eb",
                                                "text": "He opposes a constitutional amendment to ban same-sex marriage—a litmus test for many social conservatives"
                                            },
                                            {
                                                "example_id": "7ae89f87-ed5d-4b49-8270-1f4329a82f52",
                                                "sense_id": "254cfcc8-dd10-3919-8e59-5d1cdbb028eb",
                                                "text": "For years, quoting lines from “Manhattan” or another film by Mr. Allen on a date could be a romantic litmus test, a way to find out if a potential partner also loved E. E. Cummings, Paris, 1930s jazz and the sophisticated, cultured world the films often came to represent."
                                            },
                                            {
                                                "example_id": "85a4c9c6-8bde-474a-8494-bd6e3154282f",
                                                "sense_id": "254cfcc8-dd10-3919-8e59-5d1cdbb028eb",
                                                "text": "\"[…] I don't know National Rail numbers, but I do know that after the pandemic I used to go round a lot of the London stations, and they had far more locations shut than I did at St Pancras. That was very much my litmus test.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
