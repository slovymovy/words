                {
                    "sense_id": "68cbd2be-4a1f-3cdd-9677-8f5577f32be9",
                    "sense_definition": "The remotest hope or chance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "idiomatic_chance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without a map, we do not have a <w>prayer</w> of finding the cabin.",
                            "target_lang_translations": {
                                "ru": "Без карты у нас нет ни <w>шанса</w> найти хижину.",
                                "zh": "没有地图，我们根本没有<w>机会</w>找到那个小屋。",
                                "nl": "Zonder kaart hebben we geen <w>schijn van kans</w> om de hut te vinden.",
                                "pl": "Bez mapy nie mamy żadnych <w>szans</w> na znalezienie chaty.",
                                "de": "Ohne eine Karte haben wir nicht die geringste <w>Chance</w>, die Hütte zu finden.",
                                "fr": "Sans carte, nous n'avons aucune <w>chance</w> de trouver le chalet.",
                                "it": "Senza una mappa, non abbiamo alcuna <w>speranza</w> di trovare la baita.",
                                "cs": "Bez mapy nemáme ani <w>šanci</w> tu chatu najít.",
                                "tr": "Harita olmadan kulübeyi bulmamızın hiçbir <w>şansı</w> yok.",
                                "es": "Sin un mapa, no tenemos ninguna <w>posibilidad</w> de encontrar la cabaña."
                            }
                        },
                        {
                            "text": "That old car hasn't got a <w>prayer</w> of starting in this freezing weather.",
                            "target_lang_translations": {
                                "ru": "У этой старой машины нет ни <w>шанса</w> завестись в такую морозную погоду.",
                                "zh": "在这种冰冻天气下，那辆旧车根本没有<w>希望</w>发动起来。",
                                "nl": "Die oude auto heeft geen <w>schijn van kans</w> om te starten in dit vriesweer.",
                                "pl": "Ten stary samochód nie ma żadnych <w>szans</w> na odpalenie w tak mroźną pogodę.",
                                "de": "Das alte Auto hat bei diesem eisigen Wetter nicht die geringste <w>Chance</w> anzuspringen.",
                                "fr": "Cette vieille voiture n'a aucune <w>chance</w> de démarrer par ce temps glacial.",
                                "it": "Quella vecchia auto non ha alcuna <w>possibilità</w> di partire con questo gelo.",
                                "cs": "To staré auto nemá v tomhle mrazivém počasí ani <w>šanci</w> nastartovat.",
                                "tr": "O eski arabanın bu dondurucu havada çalışma <w>şansı</w> yok.",
                                "es": "Ese coche viejo no tiene ninguna <w>posibilidad</w> de arrancar con este clima helado."
                            }
                        }
                    ],
                    "common_phrases": [
                        "not have a prayer",
                        "without a prayer"
