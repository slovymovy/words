                        "form": "coolies"
                    },
                    {
                        "form_id": "1f392ef5-fa2e-43ce-aa69-78afa8cbdffc",
                        "entry_id": "164d5efe-8c25-36f5-a395-8a819312a7a2",
                        "tags": [],
                        "form": "coolis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c668929a-5225-33a9-ada5-ff5b87bc3939",
                        "entry_id": "164d5efe-8c25-36f5-a395-8a819312a7a2",
                        "glosses": [
                            "Indien ou Chinois embauché pour aller travailler dans les diverses colonies européennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cda2c5a-4c4c-473b-97f8-7c88cc184105",
                                "sense_id": "c668929a-5225-33a9-ada5-ff5b87bc3939",
                                "text": "M. Garcin de Tassy demande avec instance qu’on songe à supprimer celui [le commerce] des coolies : on donne ce nom à de pauvres Hindous et Chinois, qui sont censés accepter librement l'esclavage pendant un certain nombre d'années."
                            },
                            {
                                "example_id": "b8eb8dcf-0d7a-49c6-aa54-d532cd38dc5e",
                                "sense_id": "c668929a-5225-33a9-ada5-ff5b87bc3939",
                                "text": "La forme de l’esclavage était celle de l’esclavage domestique et le sort des esclaves était certainement moins dur que celui des nègres qui travaillaient dans les plantations d’Amérique ou même les coolies chinois ou canaques qui les ont remplacés."
                            },
                            {
                                "example_id": "b8409038-34c8-4d35-9d24-9505b8f29f7b",
                                "sense_id": "c668929a-5225-33a9-ada5-ff5b87bc3939",
                                "text": "Un jardin plein d'enfants bruyants, des coolies qui poussent des voiturettes, des soldats, des piaillements chinois, zig zig hi! Des brocards et miaulements."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f3e17d7-94bf-479e-b1db-121f434607b6",
                        "source_entry_id": "164d5efe-8c25-36f5-a395-8a819312a7a2",
                        "source_sense_id": "c668929a-5225-33a9-ada5-ff5b87bc3939",
                        "source_sense_description": "manouvrier asiatique employé dans les colonies",
                        "target_lang_word": "Kuli",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kuli",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee05d385-9469-3fb0-8cdb-e62ad5f306a1",
                                        "entry_id": "9bbc8517-eb14-39b0-b9e7-00d2b6ebaf63",
                                        "glosses": [
                                            "Kugelschreiber"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d2f2364-c0d8-479b-a91a-bcfc83fe244c",
                                                "sense_id": "ee05d385-9469-3fb0-8cdb-e62ad5f306a1",
                                                "text": "Reich mir mal deinen Kuli!"
                                            },
                                            {
                                                "example_id": "d3eed894-83a9-4755-8650-556e48a6319e",
                                                "sense_id": "ee05d385-9469-3fb0-8cdb-e62ad5f306a1",
                                                "text": "„Aber Big Arnie hört nicht zu, sondern zeichnet mit Schwechtersheimer Kuli auf der Speisekarte herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f383f69-11a4-38a9-89e8-36afd3006919",
                                        "entry_id": "9bbc8517-eb14-39b0-b9e7-00d2b6ebaf63",
                                        "glosses": [
                                            "Tintenkuli"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kuli",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1223932d-6f79-3e86-8f10-69c54fa4ed39",
                                        "entry_id": "f321ebd0-5ed6-3c47-9682-730096711b5f",
                                        "glosses": [
                                            "Tagelöhner in Südostasien"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28a36359-07f1-4f05-b55b-84b26102019f",
                                                "sense_id": "1223932d-6f79-3e86-8f10-69c54fa4ed39",
                                                "text": "Über die portugiesische Kolonie Macao wurden auch chinesische Kulis nach Mittel- und Südamerika verschifft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d2fb12b8-4586-31f5-995f-5446c7136265",
                                        "entry_id": "f321ebd0-5ed6-3c47-9682-730096711b5f",
                                        "glosses": [
                                            "rücksichtslos ausgenutzte Person"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c54637c9-1e99-4b93-a6c7-922fab61013e",
                                                "sense_id": "d2fb12b8-4586-31f5-995f-5446c7136265",
                                                "text": "Ich würde drüben in der Fabrik nicht arbeiten wollen, da muss man schuften wie ein Kuli."
                                            },
                                            {
                                                "example_id": "073ff21a-593e-4987-b8a7-f4be6981eb07",
                                                "sense_id": "d2fb12b8-4586-31f5-995f-5446c7136265",
                                                "text": "„In der Rue de la Mortellerie, nahe dem Fluß, kannte sie einen Gerber namens Grimal, der notorischen Bedarf an jugendlichen Arbeitskräften hatte – nicht an ordentlichen Lehrlingen oder Gesellen, sondern an billigen Kulis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4632eaec-b610-317b-9fe5-d4f9e65a7a33",
                                        "entry_id": "f321ebd0-5ed6-3c47-9682-730096711b5f",
                                        "glosses": [
                                            "Kofferkuli, Gepäckwagen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6f27afb-9e7c-408c-b69f-a5167d466c23",
                                                "sense_id": "4632eaec-b610-317b-9fe5-d4f9e65a7a33",
                                                "text": "„Findige Gauner haben jetzt die neue Abzock-Masche entwickelt: Steht ein Gepäckwagen scheinbar herrenlos herum, spurten sie hin, hetzen mit dem Kuli zur Abgabestelle, kassieren.“"
                                            },
                                            {
                                                "example_id": "a5c8398b-35ce-47f4-9cf4-3317927932c1",
                                                "sense_id": "4632eaec-b610-317b-9fe5-d4f9e65a7a33",
                                                "text": "„Mein Teekesselchen ist ein Gepäckwagen, der ausgeliehen werden kann. Mein Teekesselchen wird auch „Kugelschreiber“ genannt. Lösung: Kuli. Gepäckwagen auf Bahnhöfen, Synonym für Kugelschreiber.“"
                                            },
                                            {
                                                "example_id": "af0a8a7c-d722-417a-a7d4-1086d8ecce9c",
                                                "sense_id": "4632eaec-b610-317b-9fe5-d4f9e65a7a33",
                                                "text": "„»Ich hole einen Kuli.« Davon unbeeindruckt steuerte Patsy tänzelnd die Reihe ineinandergeschobener Gepäckwagen an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8f5e9a3-c229-4364-82c3-edeeacfffb1b",
                        "source_entry_id": "164d5efe-8c25-36f5-a395-8a819312a7a2",
                        "source_sense_id": "c668929a-5225-33a9-ada5-ff5b87bc3939",
                        "source_sense_description": "manouvrier asiatique employé dans les colonies",
                        "target_lang_word": "coolie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coolie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00768981-23b3-36c3-a7b3-1721e74ec30a",
                                        "entry_id": "b7b0a967-4f3c-3b22-aa7b-37e18d97921d",
                                        "glosses": [
                                            "An unskilled Asian worker, usually of Chinese or Indian descent; a labourer; a porter. Coolies were frequently transported to other countries in the 19th and early 20th centuries as indentured labourers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "737daadd-2d9a-43b4-b70a-9e67ed4d07c2",
                                                "sense_id": "00768981-23b3-36c3-a7b3-1721e74ec30a",
                                                "text": "One day when the Man's Wife and the Tertium Quid had just arrived in the Cemetery, they saw some coolies breaking ground."
                                            },
                                            {
                                                "example_id": "9453901a-9069-40c9-96ef-93683502bb34",
                                                "sense_id": "00768981-23b3-36c3-a7b3-1721e74ec30a",
                                                "text": "From Hui-li-chou northwards I was escorted by real soldiers, quite of the new service. They looked rather shipshape in khaki suits and puttees, and their guns were of a good model, but they handled them in careless fashion at first, belabouring laden ponies and even coolies who were slow in getting out of the way of my chair."
                                            },
                                            {
                                                "example_id": "c4e2968c-67cc-4a03-afc4-5294030ac865",
                                                "sense_id": "00768981-23b3-36c3-a7b3-1721e74ec30a",
                                                "text": "Outside, beyond the sun-baked station yard, a rice mill chugged away in the distance, and sweating coolies unloaded bags of rice from creaking bullock carts."
                                            },
                                            {
                                                "example_id": "0ad33328-9067-4f54-9b69-0f138480d11f",
                                                "sense_id": "00768981-23b3-36c3-a7b3-1721e74ec30a",
                                                "text": "Coolie-identity is as much the product of self-perception as it is the construction of a category by those who did not belong to it. It is these constructions that historically constituted a coolie in the matrix of power relations which this essay seeks to partially comprehend."
                                            },
                                            {
                                                "example_id": "ef099d80-49b9-4b66-ab11-20884a261662",
                                                "sense_id": "00768981-23b3-36c3-a7b3-1721e74ec30a",
                                                "text": "Community histories did not necessarily feature the coolie, partly due to the fact that “coolie” is a classed term. Asian coolies were regarded as lowly laborers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db4c402a-09e1-391f-b70e-3bd242d148b9",
                                        "entry_id": "b7b0a967-4f3c-3b22-aa7b-37e18d97921d",
                                        "glosses": [
                                            "An Indian or a person of Indian descent."
                                        ],
                                        "tags": [
                                            "Caribbean",
                                            "Guyana",
                                            "Jamaica",
                                            "Trinidad-and-Tobago",
                                            "ethnic",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90965ec3-26cb-479f-8fb0-7670aa318bc9",
                                                "sense_id": "db4c402a-09e1-391f-b70e-3bd242d148b9",
                                                "text": "Well, he and his troops had shown the koefietjies-the little coolies-how quickly and how easily Afrikaner explosive shells could knock it down."
                                            },
                                            {
                                                "example_id": "507463ba-3c96-45f9-8fd1-f07ecef26f3f",
                                                "sense_id": "db4c402a-09e1-391f-b70e-3bd242d148b9",
                                                "text": "Even a coolie would have been better."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95721553-a762-406d-a769-741dd61629b4",
                        "source_entry_id": "164d5efe-8c25-36f5-a395-8a819312a7a2",
                        "source_sense_id": "c668929a-5225-33a9-ada5-ff5b87bc3939",
