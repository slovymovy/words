                        "glosses": [
                            "een chirurgische ingreep die men direct, zonder uitstel moet uitvoeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0739c367-bd9a-40d9-a48d-9d649e03d59e",
                                "sense_id": "4662ce1b-3347-3436-a24a-120ced0ad9bc",
                                "text": "In draf, op mitrailleurwagens zonder vering die hoog opstuiterden en de ongelukkigen de botten nog verder braken en hun ingewanden dooreenschudden, werden daar gewonden naar de medische post gebracht, waar ze eerste hulp kregen, inderhaast verbonden werden en in sommige, bijzonder ernstige gevallen een spoedoperatie ondergingen."
                            }
                        ]
                    },
