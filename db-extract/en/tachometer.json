                                    },
                                    {
                                        "sense_id": "d706fb3b-f4e8-3254-a888-551214f91c06",
                                        "entry_id": "f362eaea-1ef3-355b-9e2a-e6ce245d0bde",
                                        "glosses": [
                                            "Instrument servant à mesurer la vitesse."
