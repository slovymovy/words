                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe568d74-a47b-3338-a519-ae033263474a",
                                        "entry_id": "77768c6f-13c9-3d94-bf2f-f39dfa3bf6a1",
                                        "glosses": [
                                            "Partie osseuse et aplatie qui s’étend du haut en bas de la partie antérieure de la poitrine et avec laquelle les côtes et les clavicules sont articulées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5387f9a3-9b12-41ce-b513-6dff14d1b653",
                                                "sense_id": "fe568d74-a47b-3338-a519-ae033263474a",
                                                "text": "[…] : sur une frégate, en 1829, deux marins s'amusaient à faire des armes ; en ferraillant, un des fleurets se déboutonne et mal paré va traverser les vêtemens, divise la peau et s'arrête dans l’épaisseur du sternum, vers son milieu."
                                            },
                                            {
                                                "example_id": "fdc6d6df-4248-4d27-aedf-47fab6c2edc5",
                                                "sense_id": "fe568d74-a47b-3338-a519-ae033263474a",
                                                "text": "Brusquement baissé et redressé avec une ondulation de reptile, il frappa Phelem-ghe-madone au sternum. Le colosse chancela."
                                            },
                                            {
                                                "example_id": "0aae4c36-ee7e-43d4-bed0-16491deda1c4",
                                                "sense_id": "fe568d74-a47b-3338-a519-ae033263474a",
                                                "text": "26 février 1941 – Rencontré Jean, rue de l’École-de-Médecine, alors que je ne le cherchais pas. Ça fait mal au sternum, ces surprises."
                                            },
                                            {
                                                "example_id": "98f981a0-0cb0-4451-8d17-60c14317e9d9",
                                                "sense_id": "fe568d74-a47b-3338-a519-ae033263474a",
                                                "text": "Oui, Joss regrettait toujours de ne pas avoir achevé ce type, le lendemain du naufrage, au lieu de s’être contenté de lui rompre un membre et défoncer le sternum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6182fee-11d1-45e2-8534-6aafdb4abe26",
                        "source_entry_id": "5917f5da-31c8-325e-9ff0-08d39d60901d",
                        "source_sense_id": "1afcec09-6b1e-38f1-ab6c-4da8ed981d6b",
