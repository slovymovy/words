                    {
                        "translation_id": "75b4a451-3cb1-4b4f-b13b-64978bceefc8",
                        "source_entry_id": "72011fdd-4b44-3ce0-b080-b94cd029d46f",
                        "source_sense_description": "To wrap around, surround",
                        "target_lang_word": "einhüllen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
