                "senses": [
                    {
                        "sense_id": "55dfdb0c-c366-39d1-9491-8b94817ce5f3",
                        "entry_id": "4d1a2e28-1485-37b7-b06e-8237caed58d4",
                        "glosses": [
                            "pot waarin men de overblijfselen van een gecremeerd persoon bewaart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "736e7ae4-c7fc-4934-b073-03dbd955be6c",
                                "sense_id": "55dfdb0c-c366-39d1-9491-8b94817ce5f3",
                                "text": "„Wim van de boekenafdeling vond ’m en zei meteen dat het een asurn was. Dat bleek ook wel toen we erin keken”, vervolgt hij. „Mij was het anders waarschijnlijk niet eens opgevallen. Er zat relatief weinig as in, zag ik.”"
                            },
                            {
                                "example_id": "8f8d2807-b993-4556-ad18-e92b2f9f241f",
                                "sense_id": "55dfdb0c-c366-39d1-9491-8b94817ce5f3",
                                "text": "Het urnenbos is van oorsprong een Belgisch idee. Voor zover bekend is het begraven van een asurn op een volledig zelfgekozen plek verder alleen mogelijk in het bos van de Heilig Land Stichting bij Nijmegen. As verstrooien gebeurt op tal van zelfgekozen plekken, maar is formeel verboden."
                            }
                        ]
                    }
                ],
