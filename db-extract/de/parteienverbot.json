                ],
                "senses": [
                    {
                        "sense_id": "d9761e7f-fbf4-3dfc-bd90-284deb5d3159",
                        "entry_id": "f42e4f26-8cb3-322e-a386-468182d367d0",
                        "glosses": [
                            "durch das Bundesverfassungsgericht ausgesprochenes Untersagen jeglicher politischer Aktivität einer parteipolitischen Vereinigung"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "874ea0b6-1342-4b73-971d-a7fb149166f3",
                                "sense_id": "d9761e7f-fbf4-3dfc-bd90-284deb5d3159",
                                "text": "Das Grundgesetz sieht für ein Parteienverbot hohe Hürden vor."
                            },
                            {
                                "example_id": "ac87381c-0ea8-488b-9d6d-fab33ed2736a",
                                "sense_id": "d9761e7f-fbf4-3dfc-bd90-284deb5d3159",
                                "text": "Die Voraussetzungen für ein Parteienverbot sind in Artikel 21, Absatz 2, des Grundgesetzes geregelt."
                            },
                            {
                                "example_id": "ce3bad59-f6c9-4ca7-997f-1dd2f2b59bea",
                                "sense_id": "d9761e7f-fbf4-3dfc-bd90-284deb5d3159",
                                "text": "Um ein Parteienverbot zu erreichen, muss sich eine Zweidrittelmehrheit der Richter des Bundesverfassungsgerichts dafür aussprechen."
                            },
                            {
                                "example_id": "7bebb51d-48ba-4b05-a18c-3b903be4ff1b",
                                "sense_id": "d9761e7f-fbf4-3dfc-bd90-284deb5d3159",
                                "text": "So kommt es sehr selten zu Parteiverbotsverfahren vor dem Bundesverfassungsgericht. Dennoch kam es bereits zweimal vor, dass ein Parteienverbot ausgesprochen werden musste."
                            },
                            {
                                "example_id": "aa7a4816-5037-4585-b695-bcc3edc12226",
                                "sense_id": "d9761e7f-fbf4-3dfc-bd90-284deb5d3159",
                                "text": "Nachdem die offen neonazistische Sozialistische Reichspartei (SRP) 1952 verboten wurde, war das KPD-Verbot vom 17. August 1956 das zweite Parteienverbot in der Geschichte der Bundesrepublik Deutschland."
                            },
                            {
                                "example_id": "704fc418-40b9-4ad9-b713-8ed2a5bdd772",
                                "sense_id": "d9761e7f-fbf4-3dfc-bd90-284deb5d3159",
                                "text": "„Überdies ist sie die einzige Partei, die vor 2011 trotz des Parteienverbots in den FATA über eine flächendeckende politische Basis verfügte - vor allem aufgrund ihres weitreichenden Medresen-Netzwerks.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
