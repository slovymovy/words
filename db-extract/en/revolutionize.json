                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "révolutionner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25d9abf3-2b51-3d34-afdf-f0f1041c9720",
                                        "entry_id": "3c80a71d-afef-3fc7-8492-88c6c712f8ac",
                                        "glosses": [
                                            "Bouleverser."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a71a6c76-9922-4aea-ba0e-5551fe21bf42",
                                                "sense_id": "25d9abf3-2b51-3d34-afdf-f0f1041c9720",
                                                "text": "La kalashnikov a révolutionné l’art de la guerre comme les nouveaux paquebots ont révolutionné l’art de la croisière."
                                            },
                                            {
                                                "example_id": "981e284b-2734-46a3-b3e8-ea7d011d9396",
                                                "sense_id": "25d9abf3-2b51-3d34-afdf-f0f1041c9720",
                                                "text": "La règle d'aujourd'hui va révolutionner ton apprentissage."
                                            },
                                            {
                                                "example_id": "6e6d1633-35f2-4e4c-9223-a1388e7cd39c",
                                                "sense_id": "25d9abf3-2b51-3d34-afdf-f0f1041c9720",
                                                "text": "Ses idées avaient révolutionné la vie sur la planète. Ulfète était une cité des merveilles, comme l'étaient aussi Ixrid, Poltum et Pranfar."
                                            },
                                            {
                                                "example_id": "9ed30833-cc4d-4b9c-bb1e-e8684a9f99a8",
                                                "sense_id": "25d9abf3-2b51-3d34-afdf-f0f1041c9720",
                                                "text": "Il ne se sentit pas d’aise en révolutionnant un quartier endormi où les chiens de garde aboyaient."
                                            },
                                            {
                                                "example_id": "bac530d8-933d-430f-ac9c-956f3b9b9ccf",
                                                "sense_id": "25d9abf3-2b51-3d34-afdf-f0f1041c9720",
                                                "text": "Rinus Michels est l’homme qui a inventé le football total et a ainsi révolutionné le football mondial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f69b5c40-5cfc-31f8-b785-a158f52496aa",
                                        "entry_id": "3c80a71d-afef-3fc7-8492-88c6c712f8ac",
                                        "glosses": [
                                            "Agiter un pays à l’aide de principes révolutionnaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8591e3d3-ed2c-48bb-8933-063cf29d660d",
                                                "sense_id": "f69b5c40-5cfc-31f8-b785-a158f52496aa",
                                                "text": "La Convention envoya des commissaires pour révolutionner la Belgique."
                                            },
                                            {
                                                "example_id": "390e75a8-7d63-424b-b603-9f802aec73a8",
                                                "sense_id": "f69b5c40-5cfc-31f8-b785-a158f52496aa",
                                                "text": "Une seule idée les habite : libérer la république du « joug » stadhouderien et révolutionner le gouvernement afin d’instaurer une démocratie représentative."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0913333b-b431-4585-86f1-839e424b29a7",
                        "source_entry_id": "ebf3f90c-d6a6-3892-822c-00fa43dca560",
