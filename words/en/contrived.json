{
    "word_family": [
        "contrive",
        "contrivance",
        "contriver"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4d6dc70f-3eff-3e7e-9869-ac8fab70528b",
                    "sense_definition": "Created in a deliberate, rather than natural or spontaneous, way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "artificiality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plot of the movie felt <w>contrived</w> and lacked any real emotional depth.",
                            "target_lang_translations": {
                                "nl": "De verhaallijn van de film voelde <w>gekunsteld</w> aan en miste enige echte emotionele diepgang."
                            }
                        },
                        {
                            "text": "Every photograph in the album looked <w>contrived</w>, with each pose carefully arranged in advance.",
                            "target_lang_translations": {
                                "nl": "Elke foto in het album zag er <w>in scène gezet</w> uit, met elke pose zorgvuldig van tevoren gepland."
                            }
                        }
                    ],
                    "synonyms": [
                        "staged"
                    ],
                    "antonyms": [
                        "spontaneous"
                    ],
                    "common_phrases": [
                        "contrived plot",
                        "contrived situation"
                    ],
                    "target_lang_definitions": {
                        "nl": "Op een opzettelijke en geënsceneerde wijze gemaakt in plaats van natuurlijk of spontaan."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gekunsteld",
                                "target_lang_sense_clarification": "niet spontaan, opzettelijk gecreëerd"
                            },
                            {
                                "target_lang_word": "in scène gezet",
                                "target_lang_sense_clarification": "bewust gearrangeerd"
                            },
                            {
                                "target_lang_word": "geforceerd",
                                "target_lang_sense_clarification": "opzettelijk afgedwongen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb7abddd-8e08-3060-b141-4cb0a296eb4d",
                    "sense_definition": "Unnatural, forced; artificial, or unrealistic.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "artificiality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dialogue in the play sounded <w>contrived</w> and awkward to the listeners.",
                            "target_lang_translations": {
                                "nl": "De dialoog in het toneelstuk klonk <w>gekunsteld</w> en ongemakkelijk voor het publiek."
                            }
                        },
                        {
                            "text": "She gave a <w>contrived</w> smile that did not reach her eyes at all.",
                            "target_lang_translations": {
                                "nl": "Ze gaf een <w>gemaakte</w> glimlach die haar ogen helemaal niet bereikte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "contrived smile",
                        "contrived dialogue"
                    ],
                    "target_lang_definitions": {
                        "nl": "Onnatuurlijk, gemaakt, onecht of geforceerd."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gekunsteld",
                                "target_lang_sense_clarification": "onnatuurlijk, gemaakt"
                            },
                            {
                                "target_lang_word": "gemaakt",
                                "target_lang_sense_clarification": "onoprecht, niet spontaan"
                            },
                            {
                                "target_lang_word": "bij de haren getrokken",
                                "target_lang_sense_clarification": "zeer onnatuurlijk of onwaarschijnlijk"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b738609a-6405-32f1-8adc-fc8a2e149bbc",
                    "sense_definition": "Simple past and past participle of <w>contrive</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>contrived</w> a clever plan to escape the locked room.",
                            "target_lang_translations": {
                                "nl": "Hij <w>verzon</w> een slim plan om uit de afgesloten kamer te ontsnappen."
                            }
                        },
                        {
                            "text": "They have <w>contrived</w> a way to solve the difficult problem together.",
                            "target_lang_translations": {
                                "nl": "Ze hebben samen een manier <w>bedacht</w> om het moeilijke probleem op te lossen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form of the verb contrive."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van 'contrive' (verzinnen, beramen)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bekokstoofde",
                                "target_lang_sense_clarification": "verleden tijd van beramen of verzinnen"
                            },
                            {
                                "target_lang_word": "verzon",
                                "target_lang_sense_clarification": "verleden tijd van een plan bedenken"
                            },
                            {
                                "target_lang_word": "beraamde",
                                "target_lang_sense_clarification": "verleden tijd van beramen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}