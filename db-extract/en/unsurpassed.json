                                        "examples": [
                                            {
                                                "example_id": "cff59b88-4702-44b1-93c8-513b76662aa5",
                                                "sense_id": "bd3f7b6e-85cc-3d4d-bb0d-3570c02816c6",
                                                "text": "Mon fils est un pêcheur hors pair, il obtient toujours le premier prix au concours de pêche."
                                            },
                                            {
                                                "example_id": "edcefb28-33fb-4e86-9796-49ec70e01932",
                                                "sense_id": "bd3f7b6e-85cc-3d4d-bb0d-3570c02816c6",
                                                "text": "Si nous trouvons qu’un camarade a réussi à écrire une page hors pair, nous lui disons : « Tu as écrit – ou vous avez écrit – une page hors pair. »"
                                            },
                                            {
                                                "example_id": "0a9d097c-4ec6-47b2-83ff-441adcded4a1",
                                                "sense_id": "bd3f7b6e-85cc-3d4d-bb0d-3570c02816c6",
                                                "text": "Pédagogue hors pair, il montrait comment le respect des règles de procédure, principe fondamental pour un magistrat, ne devait pas empêcher la recherche de la vérité qui devait demeurer au centre des préoccupations."
                                            }
                                        ]
                                    }
                                ]
                            }
