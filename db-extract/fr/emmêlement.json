                "senses": [
                    {
                        "sense_id": "8b279e8e-ec46-36ae-9c6b-dabfc8f32541",
                        "entry_id": "a2ac02f0-a914-32dd-8510-1baf47b85059",
                        "glosses": [
                            "Action d’emmêler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b92c498-7b34-4b1d-9c84-427353ac4902",
                                "sense_id": "8b279e8e-ec46-36ae-9c6b-dabfc8f32541",
                                "text": "Et c’était le corps de Concha, notre ancienne façon de nous rapprocher l’un de l’autre, l’emmêlement de nos jambes, son odeur (fraîche à la nuque, acide des tempes, chaude de la bouche), ses cheveux longs qui, toujours, se trouvaient pris sous un bras, une épaule, et, désordonnés, passaient entre nos deux visages comme un dernier refus (il fallait les écarter de la main pour saisir sa bouche) ; et, surtout, son indulgence d’autrefois."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b62fc04-2c46-30ea-996d-eefebc84c94d",
                        "entry_id": "a2ac02f0-a914-32dd-8510-1baf47b85059",
                        "glosses": [
                            "Résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd0f74ce-42bf-4847-b4a5-c382480d1e72",
                                "sense_id": "5b62fc04-2c46-30ea-996d-eefebc84c94d",
                                "text": "Elle contempla sa pèlerine, comme pour lire dans l’emmêlement des franges, ainsi qu’en un grimoire, la réponse qu’elle devait rendre."
                            },
                            {
                                "example_id": "ca828cb3-916e-4468-b895-6374c7e2e929",
                                "sense_id": "5b62fc04-2c46-30ea-996d-eefebc84c94d",
                                "text": "L’emmêlement de poissons dans des cordages cause des étranglements et des noyades."
                            }
                        ]
                    }
                ],
