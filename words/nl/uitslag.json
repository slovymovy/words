            "senses": [
                {
                    "sense_id": "15150eb3-f657-3864-b652-520178b24534",
                    "sense_definition": "de uiteindelijke score of uitkomst van een wedstrijd, examen of onderzoek",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "resultaat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>uitslag</w> van de voetbalwedstrijd was een gelijkspel tussen beide teams.",
                            "target_lang_translations": {
                                "en": "The <w>result</w> of the football match was a draw between both teams."
                            }
                        },
                        {
                            "text": "Zij wachtte vol spanning op de <w>uitslag</w> van haar medisch onderzoek.",
                            "target_lang_translations": {
                                "en": "She waited anxiously for the <w>results</w> of her medical examination."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uitslag van de wedstrijd",
                        "voorlopige uitslag"
                    ],
                    "target_lang_definitions": {
                        "en": "the final score or outcome of a match, exam, or investigation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "result",
                                "target_lang_sense_clarification": "general outcome or score"
                            },
                            {
                                "target_lang_word": "outcome",
                                "target_lang_sense_clarification": "the way something ends"
                            },
                            {
                                "target_lang_word": "score",
                                "target_lang_sense_clarification": "points in a game or test"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce88117b-2495-3664-abc9-0f2666e5a841",
                    "sense_definition": "zichtbare vlekken of bultjes op de huid als gevolg van een allergie of ziekte",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het eten van aardbeien kreeg het kind last van rode <w>uitslag</w> op zijn armen.",
                            "target_lang_translations": {
                                "en": "After eating strawberries, the child suffered from a red <w>rash</w> on his arms."
                            }
                        },
                        {
                            "text": "De dokter zei dat de <w>uitslag</w> op de huid vanzelf weer zou verdwijnen.",
                            "target_lang_translations": {
                                "en": "The doctor said the <w>rash</w> on the skin would disappear on its own."
                            }
                        }
                    ],
                    "synonyms": [
                        "huiduitslag",
                        "uitbarsting"
                    ],
                    "common_phrases": [
                        "last van uitslag",
                        "rode uitslag"
                    ],
                    "target_lang_definitions": {
                        "en": "visible spots or bumps on the skin resulting from an allergy or illness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rash",
                                "target_lang_sense_clarification": "skin irritation"
                            },
                            {
                                "target_lang_word": "breakout",
                                "target_lang_sense_clarification": "sudden appearance of spots"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "240f3735-c6e3-3de7-a2b3-9c8c5da7788a",
                    "sense_definition": "een laagje of aanslag op een oppervlak, vaak veroorzaakt door vocht of chemische processen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "oppervlakte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zit witte <w>uitslag</w> op de bakstenen muur door het zout in het metselwerk.",
                            "target_lang_translations": {
                                "en": "There is white <w>efflorescence</w> on the brick wall due to the salt in the masonry."
                            }
                        },
                        {
                            "text": "Door de condensatie ontstond er een vreemde <w>uitslag</w> op de oude ramen.",
                            "target_lang_translations": {
                                "en": "Due to condensation, a strange <w>deposit</w> formed on the old windows."
                            }
                        }
                    ],
                    "common_phrases": [
                        "witte uitslag"
                    ],
                    "target_lang_definitions": {
                        "en": "a layer or deposit on a surface, often caused by moisture or chemical processes"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "efflorescence",
                                "target_lang_sense_clarification": "salt deposits on masonry"
                            },
                            {
                                "target_lang_word": "deposit",
                                "target_lang_sense_clarification": "layer of accumulated matter"
                            },
                            {
                                "target_lang_word": "residue",
                                "target_lang_sense_clarification": "substance left on a surface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "037f7975-a54f-3953-9a21-acbd1b639e8d",
                    "sense_definition": "een stuk land dat na een overstroming niet meer door dijken wordt beschermd",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De Oude <w>Uitslag</w> van Putten is een historisch gebied dat herinnert aan vroegere overstromingen.",
                            "target_lang_translations": {
                                "en": "The Oude <w>Uitslag</w> of Putten is a historical area that recalls earlier floods."
                            }
                        },
                        {
                            "text": "In dit deel van de polder zie je nog goed waar de <w>uitslag</w> vroeger lag.",
                            "target_lang_translations": {
                                "en": "In this part of the polder, you can still clearly see where the <w>floodplain</w> used to be."
                            }
                        }
