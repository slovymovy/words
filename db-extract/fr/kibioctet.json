                                        "glosses": [
                                            "Strictly, 2¹⁰ (1,024) bytes, as opposed to a kilobyte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96bbee81-12cd-4ecf-ae8b-188aacb85459",
                                                "sense_id": "4bc80fc5-65b7-3ce6-a0c9-2b3550a92327",
                                                "text": "The computer's operating system and applications all fit with within 32 kibibytes of read-only memory (ROM); much of the code in the ROM was personally written by Bill Gates."
                                            }
