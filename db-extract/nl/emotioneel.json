                                                "example_id": "29f4a744-f895-4419-a4e5-16b0bd0edc33",
                                                "sense_id": "b7c47b5e-fca3-33e9-939c-178979272876",
                                                "text": "Avec les mains, le fasciathérapeute lit ces tensions et remonte ainsi à l’origine du problème, qu’il soit physiologique ou émotionnel."
                                            },
                                            {
                                                "example_id": "b364046d-c3aa-45b1-b356-cc6d02c36848",
                                                "sense_id": "b7c47b5e-fca3-33e9-939c-178979272876",
                                                "text": "Acte de justice –\nSuite au délit de violence\npsychologique et émotionnelle\nen parole,\nvous allez verser\nun dédommagement\nà votre\n…\nassistant personnel virtuel."
                                            },
                                            {
                                                "example_id": "a08bb4d0-4cab-4087-aa30-7912a4f60ab9",
                                                "sense_id": "b7c47b5e-fca3-33e9-939c-178979272876",
                                                "text": "« L’expertise et l’engagement de ces deux associations ont garanti la capacité de donner aux appelants une écoute et des réponses adaptées à leurs besoins, notamment sur le plan émotionnel eu égard à l’intensité du moment du témoignage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a8a1911-8387-3061-abd5-fc9b4eff2bdd",
                                        "entry_id": "5902f3ff-3016-347c-9068-99b34aa0f308",
                                        "glosses": [
                                            "Générateur d’émotions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
