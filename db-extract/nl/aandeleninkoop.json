                                "example_id": "83b084ae-cf73-4d62-a1a1-f3de7cd5743e",
                                "sense_id": "f4d6872d-d039-3ab2-817c-fc090877c0c1",
                                "text": "Dertig andere banken die aan de testen werden onderwerpen, kregen wel het vereiste fiat voor hun voorstellen wat betreft aandeleninkoop- en dividend."
                            },
                            {
                                "example_id": "b6e6c8fd-3542-4d0d-8329-a265062b04ed",
                                "sense_id": "f4d6872d-d039-3ab2-817c-fc090877c0c1",
                                "text": "In de handel nabeurs in New York ging het aandeel Apple wel bijna 4 procent omhoog. Beleggers reageerden tevreden met de uitgebreide aandeleninkoop en het hogere dividend."
                            },
                            {
                                "example_id": "ee5cbaca-7b57-47a2-a100-1b978654dddf",
                                "sense_id": "f4d6872d-d039-3ab2-817c-fc090877c0c1",
                                "text": "De nieuwe aandeleninkoop volgt op een eerder programma van eveneens 40 miljard dollar, dat in 2008 werd aangekondigd en deze maand afloopt."
                            }
                        ]
                    }
