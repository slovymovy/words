                "senses": [
                    {
                        "sense_id": "169527ab-2b9a-3fa9-bcfd-796684d30f54",
                        "entry_id": "609ed6c4-c7b1-3c1f-b14f-d5b16cf4b45b",
                        "glosses": [
                            "fairy-tale monster, bizarre creature"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea4acd0b-96ea-4180-8a21-4bd9f0695ca5",
                                "sense_id": "169527ab-2b9a-3fa9-bcfd-796684d30f54",
                                "text": "Нагада́ла себе́ несча́стье,\nЗакрыва́ла глаза́ напра́сно,\nВсё вокру́г бы́ло жё́лто-кра́сным,\nВдруг приви́делось чу́до-ю́до.",
                                "translation": "Vyacheslav Butusov",
                                "english": "Vyacheslav Butusov"
                            }
                        ]
                    }
                ],
