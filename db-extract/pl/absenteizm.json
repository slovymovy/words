                        "sense_id": "406e50ca-d7dd-3dc4-85db-a76e63349286",
                        "entry_id": "b0891179-eb7b-3a07-a13a-aca25bf135ad",
                        "glosses": [
                            "Nichterscheinen, meist um seine Pflichten nicht erfüllen zu müssen; häufiges Fehlen, Fernbleiben, Absentismus"
                        ],
                        "tags": [],
