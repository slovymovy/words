                    {
                        "translation_id": "1455b587-4674-473b-8080-34197b700d39",
                        "source_entry_id": "b282fc23-c6c8-35f9-baee-81b929c41e50",
                        "source_sense_id": "2bd8fef3-991f-3014-9943-f1a212e81d17",
                        "source_sense_description": "dialektal, drückt Zustimmung aus: ja, gewiss, selbstredend",
                        "target_lang_word": "gewiss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
