                    {
                        "sense_id": "28255d80-9e04-3a64-a4f3-0a6114aaf966",
                        "entry_id": "94f836d2-4dfa-362d-bf35-cd3db76bed4e",
                        "glosses": [
                            "Bett, das man je nach Bedarf hoch- oder herunterklappen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7d9e47e-812a-4127-94a1-e2c1d8168fac",
                                "sense_id": "28255d80-9e04-3a64-a4f3-0a6114aaf966",
                                "text": "„Bei Renates Klappbett konnte man die Vorhänge zuziehen und sich vorstellen, daß man in einem Indianerzelt wohnt.“"
                            },
                            {
                                "example_id": "1a4a7cb3-9191-4387-bc4b-cb0364789ba5",
                                "sense_id": "28255d80-9e04-3a64-a4f3-0a6114aaf966",
                                "text": "„Ich mußte in den Saal zurückkehren und fand dort auf Brettern ein Klappbett vor, das sauber aussah.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
