        "de-extract.jsonl": [
            {
                "entry_id": "aee4576c-51ca-39dc-aa58-ca06b7f52430",
                "word": "IP",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "927914da-e159-35e4-b160-be5a0b3ffb70",
                        "entry_id": "aee4576c-51ca-39dc-aa58-ca06b7f52430",
                        "glosses": [
                            "Internet Protocol"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84cb32f9-537b-45da-9764-e5046b93c966",
                                "sense_id": "927914da-e159-35e4-b160-be5a0b3ffb70",
                                "text": "„In der Praxis ist IP fast ausschließlich in der Version IPv4 im Einsatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "744deab5-07d6-331c-9e12-613cda02a9b3",
                        "entry_id": "aee4576c-51ca-39dc-aa58-ca06b7f52430",
                        "glosses": [
                            "IP-Adresse"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b5c2a7bf-1810-4b80-a053-785cd5df6f89",
                                "sense_id": "744deab5-07d6-331c-9e12-613cda02a9b3",
                                "text": "„Geben Sie dazu in der Adresszeile des Internetbrowsers die IP des Routers […] ein.“"
                            },
                            {
                                "example_id": "ff3a6483-2b5f-4123-ae27-735212bfd5e6",
                                "sense_id": "744deab5-07d6-331c-9e12-613cda02a9b3",
                                "text": "„Hör zu, wir brauchen die IP des Computers, von dem die E-Mail abgeschickt wurde, […]“"
                            },
                            {
                                "example_id": "3caf8432-c598-4295-839d-303fd0c228b2",
                                "sense_id": "744deab5-07d6-331c-9e12-613cda02a9b3",
                                "text": "„Jetzt bekommen wir wiederum die Adresse angezeigt von der der letzte Login erfolgte und wie Sie sehen, ist dies nicht meine IP.“"
                            },
                            {
                                "example_id": "9e1635eb-4dce-4067-9f6b-5e22a8940786",
                                "sense_id": "744deab5-07d6-331c-9e12-613cda02a9b3",
                                "text": "„Es ist dann nicht mehr möglich seine IP zu ändern, ohne alle Verbindungen zu unterbrechen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
