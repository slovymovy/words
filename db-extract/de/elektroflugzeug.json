                "senses": [
                    {
                        "sense_id": "4b224abe-d482-3b3d-913e-3c93d7937f39",
                        "entry_id": "4f33cca8-ff66-38d3-ba45-df4530194f35",
                        "glosses": [
                            "Flugzeug, das mit Elektromotoren angetrieben wird"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "ed61b9d5-c067-4b4a-8b76-bea9f97faf9e",
                                "sense_id": "4b224abe-d482-3b3d-913e-3c93d7937f39",
                                "text": "„Das Elektroflugzeug \"e-Genius\", entwickelt vom Institut für Flugzeugbau (IFB) der Universität Stuttgart, legte zwischen dem Flugplatz Hahnweide bei Stuttgart und dem norditalienischen Landeplatz \"Calcinate del Pesce\" in gut zwei Stunden rund 320 Kilometer zurück.“"
                            },
                            {
                                "example_id": "32e91fdc-7c46-4c34-8e7a-abb8b26c7a7d",
                                "sense_id": "4b224abe-d482-3b3d-913e-3c93d7937f39",
                                "text": "„Ein Propeller am Heck treibt das Elektroflugzeug an. Energie dafür soll ein leiser Elektromotor liefern.“"
                            },
                            {
                                "example_id": "b1199287-f4fd-4c5f-8b0b-8d54e4826528",
                                "sense_id": "4b224abe-d482-3b3d-913e-3c93d7937f39",
                                "text": "„Airbus will sein kleines Elektroflugzeug in Serie bauen und bastelt schon am Nachfolger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
