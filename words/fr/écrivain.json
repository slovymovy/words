                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "litterature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Victor Hugo est reconnu dans le monde entier comme un grand <w>écrivain</w>."
                        },
                        {
                            "text": "Il possède une maîtrise de la langue qui fait de lui un véritable <w>écrivain</w>."
