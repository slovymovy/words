                        "examples": [
                            {
                                "example_id": "1040ba36-56d3-4475-83ce-d64b7d70bbec",
                                "sense_id": "cfea16e3-91c1-30d6-ad05-bb5556a78500",
                                "text": "Dieses Werkzeug muss möglichst rechtwinklig zur Oberfläche des Werkstücks angesetzt werden.",
                                "translation": "Cet outil doit être appliqué le plus perpendiculairement possible à la surface de la pièce à travailler."
                            },
                            {
                                "example_id": "7b56bb40-6e28-4482-8395-a570abe1dbf6",
                                "sense_id": "cfea16e3-91c1-30d6-ad05-bb5556a78500",
                                "text": "Die Legionärskrankheit muss frühzeitig mit Antibiotika behandelt werden, um lebensbedrohliche Komplikationen möglichst zu vermeiden.",
                                "translation": "La légionellose doit être traitée précocement par des antibiotiques afin d’éviter autant que possible les complications potentiellement mortelles."
                            },
                            {
                                "example_id": "c4f056b1-fd9b-40ec-b14a-66fbdb66804b",
                                "sense_id": "cfea16e3-91c1-30d6-ad05-bb5556a78500",
                                "text": "Um eine Verwechslung möglichst auszuschließen, sollte man Bärlauch nicht in größeren Büscheln rupfen, sondern Blatt für Blatt pflücken und einzeln waschen.",
                                "translation": "Pour éviter autant que possible toute confusion, il ne faut pas arracher l’ail des ours en grosses touffes, mais le cueillir feuille par feuille et le laver individuellement."
                            }
                        ]
                    }
                ],
