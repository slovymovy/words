                        "glosses": [
                            "straatrover die in het begin van de 20ste eeuw actief was in de grote steden (vooral Parijs)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a0c568c-b293-453d-b98f-8d34f2c1003c",
                                "sense_id": "a2579809-a4f0-362e-9a7d-b56ca73efd60",
                                "text": "Er is mij iets vreeslijks overkomen! Stel je voor, toen ik je gisteren verliet, ben ik, vlak bij huis, in de Avenue Dubouchage door apachen overrompeld! (Louis Couperus, Modern toerisme)"
                            }
                        ]
                    }
                ],
