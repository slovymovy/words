                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05669406-9d02-4a21-ac0d-94dceb68b6aa",
                                "sense_id": "5322bb39-f20c-31ec-95be-37171f07ed7c",
                                "text": "Zu spät merkte Susanne, dass sie den 200-Euro-Schein ihres Mannes in den Schredder statt in den Münzwechselautomaten schob."
                            },
                            {
                                "example_id": "67b259d4-5aa7-4f8b-9b22-7cc51abda620",
                                "sense_id": "5322bb39-f20c-31ec-95be-37171f07ed7c",
                                "text": "Neben den Bahnhofstoiletten hängt ein Münzwechselautomat."
                            },
                            {
                                "example_id": "f55b5fc5-26b2-44d9-8a11-838f59ce9ef4",
                                "sense_id": "5322bb39-f20c-31ec-95be-37171f07ed7c",
                                "text": "In der Vorhalle rechts an der Wand haben wir einen Münzwechselautomaten aufgestellt, mit dem Sie 2.-, 1.-, 0,50 und 0,20 €-Stücke in kleinere Münzeinheiten wechseln können."
                            }
