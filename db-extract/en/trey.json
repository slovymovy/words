                "senses": [
                    {
                        "sense_id": "9a912631-ea71-3664-949d-dd8989326d3d",
                        "entry_id": "1d3e5310-82c0-3fe1-8352-af005a9c2937",
                        "glosses": [
                            "A playing card or die with the rank of three."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3dc1c6c-defd-4cc8-9320-91eb66dc922a",
                                "sense_id": "9a912631-ea71-3664-949d-dd8989326d3d",
                                "text": "Before you begin the Game at Picket, you must throw out of the Pack the Deuces, Treys, Fours and Fives, and play with the rest of the Cards, which are in number thirty and six."
                            },
                            {
                                "example_id": "a7770eab-0a07-4702-985f-30a50c65d633",
                                "sense_id": "9a912631-ea71-3664-949d-dd8989326d3d",
                                "text": "He had been a pretty good guy, straight as ace-deuce-trey-four-five, till he got on the force."
                            },
                            {
                                "example_id": "e2ebcd75-c0d6-4ea3-bb75-bd69d69869ca",
                                "sense_id": "9a912631-ea71-3664-949d-dd8989326d3d",
                                "text": "You see, Sir, when I look at the Ace it reminds me that there is but one God. The deuce reminds me that the bible is divided into two parts; the Old and New Testaments. And when I see the trey I think of the Father, Son and Holy Ghost."
                            },
                            {
                                "example_id": "51cc53e8-cc39-4d1c-8f11-a79b8785d904",
                                "sense_id": "9a912631-ea71-3664-949d-dd8989326d3d",
                                "text": "Davidson had caught a trey which did not seem to improve his hand, yet he threw three dollars into the pot."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8c360a5-7dc3-33e9-a4d0-44dccfd86896",
                        "entry_id": "1d3e5310-82c0-3fe1-8352-af005a9c2937",
                        "glosses": [
