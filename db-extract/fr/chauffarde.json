                                        "entry_id": "4f1981e5-be11-3ef9-b932-01bc3af6f4b2",
                                        "glosses": [
                                            "weibliche Person, die für die Beheizung von Dampfkesseln, Heizungsanlagen und Verbrennungsanlagen vorwiegend bei Dampflokomotiven und Dampfschiffen sorgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e7b7d6d-71a5-47d6-8b13-eb5bd2048cda",
                                                "sense_id": "0f560085-4fff-3275-a6a5-44be500679c9",
                                                "text": "Sie heuerte auf dem alten Pott als Heizerin an und würde nun endlich, endlich, die Welt sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
