                        "examples": [
                            {
                                "example_id": "f3dc7817-df8b-4fb8-8db6-504f483aa0fe",
                                "sense_id": "4329440a-dd4d-3ca7-8b62-60e414a6e34a",
                                "text": "Hij vindt Hirsi Ali \"een buitengewoon boeiend denkster in een debat dat nog maar net begonnen is\"."
                            },
                            {
                                "example_id": "ec115b4e-7d09-4938-a712-3274e11aee3a",
                                "sense_id": "4329440a-dd4d-3ca7-8b62-60e414a6e34a",
                                "text": "Over Bloem krijgen we te horen dat \"zelfreflectie niet haar sterkste kant is\", dat ze \"ongearticuleerd\" is en een \"luie denkster\". \"Zij die Bloems gestamel alleen schriftelijk tot zich kunnen nemen, verkeren hoe dan ook in het nadeel\", schrijft Pruis."
                            },
                            {
                                "example_id": "682e731a-f976-44d3-b0e2-86cd8b7761ce",
                                "sense_id": "4329440a-dd4d-3ca7-8b62-60e414a6e34a",
                                "text": "Roy is een romancier, ze schreef een prachtig boek, \"De god van de kleine dingen\". Maar als denkster of essayiste, daarover heb ik mijn twijfels. Op de vraag waarom ze Delhi niet verlaat zegt ze: \"Als ik wegga en als iedereen en alles elke vriend, elke boom, elk huis, elke hond, eekhoorn en vogel die ik ken en waarvan ik hou wordt verast, hoe leef ik dan verder?\""
                            }
                        ]
                    }
