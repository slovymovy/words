                        "sense_id": "cbbfc04e-0907-3033-aaf8-93ea3fb351f4",
                        "entry_id": "58b1c2dd-d0df-3e3c-aa91-8c271245b4e3",
                        "glosses": [
                            "Teilstück eines Knochens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30e00ba2-471d-4a65-b8db-e857ec761842",
                                "sense_id": "cbbfc04e-0907-3033-aaf8-93ea3fb351f4",
                                "text": "„Der Bruch seines linken Wangenknochens war zwar vollständig verheilt, aber die Knochenteile waren schlecht zusammengewachsen.“"
                            },
                            {
                                "example_id": "bb41e8b9-50ed-4dc9-b51c-d9f369856dca",
                                "sense_id": "cbbfc04e-0907-3033-aaf8-93ea3fb351f4",
                                "text": "„Die Holzknochen der Oberarme beispielsweise enthalten Vertiefungen, in die echte Knochenteile eingesetzt sind, und zwar Knochen von einigen der 11000 Jungfrauen aus dem Märtyrergefolge der heiligen Ursula.“"
                            }
                        ],
