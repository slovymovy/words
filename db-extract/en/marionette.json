                    {
                        "translation_id": "b1f8fdf0-4345-47d0-be79-d9be5ed4f02c",
                        "source_entry_id": "b6edb0df-5394-3ea0-a3b7-6a611acdd4d2",
                        "source_sense_description": "string puppet",
                        "target_lang_word": "marionet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marionet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6f225c1a-06d9-39e7-98d0-72c131930855",
                                        "entry_id": "04ad76a2-106b-3f63-8721-ceb841ca8391",
                                        "glosses": [
                                            "een pop die hangt aan een aantal draden en daarmee bespeeld kan worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef7800bd-ae68-410f-a247-addd7b039339",
                                                "sense_id": "6f225c1a-06d9-39e7-98d0-72c131930855",
                                                "text": "De kinderen zaten ademloos te kijken naar een spel met marionetten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccfefed2-b827-33e9-adb3-a43f1c6d4fcb",
                                        "entry_id": "04ad76a2-106b-3f63-8721-ceb841ca8391",
                                        "glosses": [
                                            "iemand in een belangrijke functie die klakkeloos doet wat machthebbers van hem verlangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1607bd37-bec8-400d-bd08-dea4028fb9fa",
                                                "sense_id": "ccfefed2-b827-33e9-adb3-a43f1c6d4fcb",
                                                "text": "Na de inval in Tsjechoslowakije in '68 werd de regering daar vervangen door een stel marionetten van het Kremlin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d577342e-5b16-4780-8426-3f811aabdf96",
                        "source_entry_id": "b6edb0df-5394-3ea0-a3b7-6a611acdd4d2",
                        "source_sense_description": "string puppet",
                        "target_lang_word": "marionnette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marionnette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b6bf97f-a496-3cba-a98e-1b062c1ff2a3",
                                        "entry_id": "e89b6fc1-45ea-33f8-abc2-911e24dedb36",
                                        "glosses": [
                                            "Figurine que l’on fait bouger avec la main ou par des fils, quelquefois par des ressorts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca5aef7d-452d-404f-beb3-6041c10ae7e1",
                                                "sense_id": "6b6bf97f-a496-3cba-a98e-1b062c1ff2a3",
                                                "text": "« Artiste, on donne sa propre vie à ses créations ou bien l’on taille des marionnettes et l’on habille des poupées. »"
                                            },
                                            {
                                                "example_id": "22edb082-9c9c-4b0e-a1d2-3b2e7f21c823",
                                                "sense_id": "6b6bf97f-a496-3cba-a98e-1b062c1ff2a3",
                                                "text": "C’est un de nos collaborateurs qui nous donne une séance de marionnettes…"
                                            },
                                            {
                                                "example_id": "35077243-a573-4423-be34-4e592c9ea089",
                                                "sense_id": "6b6bf97f-a496-3cba-a98e-1b062c1ff2a3",
                                                "text": "Mais de la silhouette en carton au masque et à la marionnette, l’évolution n’est que normale et toute interne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a1fa4de-9cd1-30ba-9f9e-18917c391407",
                                        "entry_id": "e89b6fc1-45ea-33f8-abc2-911e24dedb36",
                                        "glosses": [
                                            "Quelqu’un qui est manipulé par quelqu’un d’autre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73176095-a918-4081-93aa-4a46542f12c5",
                                                "sense_id": "8a1fa4de-9cd1-30ba-9f9e-18917c391407",
                                                "text": "Pendant un quart d’heure, il prodigua ses consolations à cette malheureuse marionnette ; il fut éloquent, il pleura presque, et finalement il s’en débarrassa en l’envoyant à Paris."
                                            },
                                            {
                                                "example_id": "7346d831-6040-4083-8644-88273a8d6721",
                                                "sense_id": "8a1fa4de-9cd1-30ba-9f9e-18917c391407",
                                                "text": "Toutes les institutions de la société dans lesquelles s’épuise l’existence humaine ne sont dès lors que jeux de simulacres, tout homme social est une marionnette qui s’ignore."
                                            },
                                            {
                                                "example_id": "7e5c62ff-52ab-472d-b7ad-7824897e5323",
                                                "sense_id": "8a1fa4de-9cd1-30ba-9f9e-18917c391407",
                                                "text": "Sous influence d'un gourou arabe, Chakib Khalil qui vivait à Genève, Messali issu d'un milieu fétichiste, tomba totalement sous l'influence de ce sbire du nationalisme arabe alors en gestation, jusqu'à devenir une marionnette entre ses mains […]."
                                            },
                                            {
                                                "example_id": "abdefa10-1c7d-45e5-bc4f-d8af495298db",
                                                "sense_id": "8a1fa4de-9cd1-30ba-9f9e-18917c391407",
                                                "text": "Depuis son enlèvement, une femme politique locale a pris sa place à la mairie. Considérée comme une marionnette des Russes, Galina Danilchenko aurait pris ce poste « par conviction » et « pour gagner de l’argent »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0064a6f0-0360-4ba7-8b42-a16ce1fd7c92",
                        "source_entry_id": "b6edb0df-5394-3ea0-a3b7-6a611acdd4d2",
                        "source_sense_description": "string puppet",
                        "target_lang_word": "Marionette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marionette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd8bc7c2-e774-339c-85a7-6b21a1b5b349",
                                        "entry_id": "d2461112-c970-3c64-a9ce-ae5b567ab67b",
                                        "glosses": [
                                            "Gliederpuppe, die an Fäden bewegt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47d712da-7120-411d-8246-3e326195798f",
                                                "sense_id": "bd8bc7c2-e774-339c-85a7-6b21a1b5b349",
                                                "text": "Die Herstellung von Marionetten ist Teil der sizilianischen Volkskunst."
                                            },
                                            {
                                                "example_id": "ab93fc22-0da3-42c0-8179-81737c9a7cd7",
                                                "sense_id": "bd8bc7c2-e774-339c-85a7-6b21a1b5b349",
                                                "text": "„In einem anderen Raum, den ein großer Ohrensessel beherrscht, schauen Marionetten den Besucher von den Wänden herab an.“"
                                            },
                                            {
                                                "example_id": "174c53f6-c689-4c04-84e7-64c44ac657c9",
                                                "sense_id": "bd8bc7c2-e774-339c-85a7-6b21a1b5b349",
                                                "text": "„Ich sah ihn nur an, mit ›leeren Augen‹, wie eine Kleistsche Marionette.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "04889fb7-8d9e-3cc1-8f58-58d9c43a3d9e",
                                        "entry_id": "d2461112-c970-3c64-a9ce-ae5b567ab67b",
                                        "glosses": [
                                            "Mensch (insbesondere Politiker), der von anderen kontrolliert wird"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "876d4592-b866-4ae0-9800-2aa174b78816",
                                                "sense_id": "04889fb7-8d9e-3cc1-8f58-58d9c43a3d9e",
                                                "text": "Pétain war eine Marionette der deutschen Besatzer."
                                            },
                                            {
                                                "example_id": "a4697c60-dfa2-4d29-b6cb-4d85f35a1b6b",
                                                "sense_id": "04889fb7-8d9e-3cc1-8f58-58d9c43a3d9e",
                                                "text": "„So attackierten nationalistische Politiker ihre jeweiligen Gegner in der Öffentlichkeit als Marionetten der Imperialisten, nur um dann selbst die Amerikaner zu umwerben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
