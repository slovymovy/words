    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "21148365-f2d9-3c7b-83c8-c8ebe12fe61e",
                    "sense_definition": "At or towards the front; in the direction one is facing or moving.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spatial_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small island was directly <w>ahead</w> of the ship.",
                            "target_lang_translations": {
                                "ru": "Небольшой остров был прямо <w>впереди</w> корабля.",
                                "pl": "Mała wyspa znajdowała się bezpośrednio <w>przed</w> statkiem."
                            }
                        },
                        {
                            "text": "Keep going straight <w>ahead</w> until you reach the traffic lights.",
                            "target_lang_translations": {
                                "ru": "Продолжайте двигаться <w>прямо</w>, пока не дойдете до светофора.",
                                "pl": "Idź cały czas prosto <w>przed siebie</w>, aż dojdziesz do sygnalizacji świetlnej."
                            }
                        }
                    ],
                    "synonyms": [
                        "forward",
                        "onwards",
                        "in front"
                    ],
                    "antonyms": [
                        "behind"
                    ],
                    "common_phrases": [
                        "straight ahead",
                        "go ahead",
                        "look ahead",
                        "dead ahead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Впереди или по направлению движения; там, куда обращен взгляд.",
                        "pl": "Z przodu lub w kierunku przodu; w kierunku, w którym ktoś jest zwrócony lub się porusza."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впереди",
                                "target_lang_sense_clarification": "местоположение"
                            },
                            {
                                "target_lang_word": "вперёд",
                                "target_lang_sense_clarification": "направление движения"
                            },
                            {
                                "target_lang_word": "прямо",
                                "target_lang_sense_clarification": "прямо по курсу"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "z przodu",
                                "target_lang_sense_clarification": "lokalizacja przed kimś/czymś"
                            },
                            {
                                "target_lang_word": "przed siebie",
                                "target_lang_sense_clarification": "kierunek patrzenia lub ruchu"
                            },
                            {
                                "target_lang_word": "prosto",
                                "target_lang_sense_clarification": "w kierunku na wprost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6398712-3690-3e2c-bd19-fdac77002f20",
                    "sense_definition": "Further advanced in position, progress, or skill; superior to others.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "status_progress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He finished the race two laps <w>ahead</w> of me.",
                            "target_lang_translations": {
                                "ru": "Он финишировал на два круга <w>впереди</w> меня.",
                                "pl": "Ukończył wyścig dwa okrążenia <w>przede</w> mną."
                            }
                        },
                        {
                            "text": "She worked hard to get <w>ahead</w> in her career.",
                            "target_lang_translations": {
                                "ru": "Она усердно работала, чтобы вырваться <w>вперёд</w> в своей карьере.",
                                "pl": "Ciężko pracowała, aby posunąć się <w>do przodu</w> w swojej karierze."
                            }
                        }
                    ],
                    "synonyms": [
                        "leading",
                        "winning",
                        "advanced",
                        "in front",
                        "before"
                    ],
                    "antonyms": [
                        "behind"
                    ],
                    "common_phrases": [
                        "ahead of",
                        "get ahead",
                        "stay ahead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продвинувшийся дальше в положении, прогрессе или навыках; опережающий других.",
                        "pl": "Bardziej zaawansowany pod względem pozycji, postępu lub umiejętności; lepszy od innych."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впереди",
                                "target_lang_sense_clarification": "опережая кого-либо"
                            },
                            {
                                "target_lang_word": "вперёд",
                                "target_lang_sense_clarification": "о прогрессе"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przed",
                                "target_lang_sense_clarification": "będąc z przodu przed kimś w wyścigu lub rankingu"
                            },
                            {
                                "target_lang_word": "do przodu",
                                "target_lang_sense_clarification": "o rozwoju kariery lub postępie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4edbb497-f69e-3c3a-a595-a7daa8a2fb7d",
                    "sense_definition": "In or for the future.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "future_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There may be some very tough times <w>ahead</w> for the company.",
                            "target_lang_translations": {
                                "ru": "Компанию могут ждать очень трудные времена <w>впереди</w>.",
                                "pl": "Firmę mogą czekać bardzo trudne czasy <w>w przyszłości</w>."
                            }
                        },
                        {
                            "text": "You have to think <w>ahead</w> so you are not unprepared.",
                            "target_lang_translations": {
                                "ru": "Вы должны думать <w>наперёд</w>, чтобы не оказаться неподготовленными.",
                                "pl": "Musisz myśleć <w>z wyprzedzeniem</w>, aby nie dać się zaskoczyć."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plan ahead",
                        "think ahead",
                        "years ahead",
                        "days ahead"
                    ],
                    "target_lang_definitions": {
                        "ru": "В будущем; предстоящий.",
                        "pl": "W przyszłości lub na przyszłość."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впереди",
                                "target_lang_sense_clarification": "о предстоящих событиях"
                            },
                            {
                                "target_lang_word": "в будущем",
                                "target_lang_sense_clarification": "о времени"
                            },
                            {
                                "target_lang_word": "на будущее",
                                "target_lang_sense_clarification": "на перспективу"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przed nami",
                                "target_lang_sense_clarification": "o nadchodzących wydarzeniach"
                            },
                            {
                                "target_lang_word": "w przyszłości",
                                "target_lang_sense_clarification": "o czasie, który nadejdzie"
                            },
                            {
                                "target_lang_word": "z wyprzedzeniem",
                                "target_lang_sense_clarification": "myślenie lub planowanie na przyszłość"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc51b604-1ede-3960-8246-855aeb87fc2f",
                    "sense_definition": "At an earlier time; beforehand or in advance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "in_advance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He paid his rent <w>ahead</w> for the next three months.",
                            "target_lang_translations": {
                                "ru": "Он заплатил за аренду <w>вперёд</w> за следующие три месяца.",
                                "pl": "Zapłacił czynsz <w>z góry</w> za kolejne trzy miesiące."
                            }
                        },
                        {
                            "text": "I decided to read <w>ahead</w> to see what happens next.",
                            "target_lang_translations": {
                                "ru": "Я решил прочитать <w>наперёд</w>, чтобы узнать, что будет дальше.",
                                "pl": "Postanowiłem poczytać trochę <w>naprzód</w>, żeby zobaczyć, co wydarzy się dalej."
                            }
                        }
                    ],
                    "synonyms": [
                        "beforehand"
                    ],
                    "common_phrases": [
                        "pay ahead",
                        "read ahead"
                    ],
                    "target_lang_definitions": {
                        "ru": "В более раннее время; заранее или авансом.",
                        "pl": "Wcześniej; z góry lub z wyprzedzeniem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заранее",
                                "target_lang_sense_clarification": "заблаговременно"
                            },
                            {
                                "target_lang_word": "вперёд",
                                "target_lang_sense_clarification": "авансом"
                            },
                            {
                                "target_lang_word": "наперёд",
                                "target_lang_sense_clarification": "предварительно"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "z góry",
                                "target_lang_sense_clarification": "płatność lub działanie z wyprzedzeniem"
                            },
                            {
                                "target_lang_word": "naprzód",
                                "target_lang_sense_clarification": "czytanie lub robienie czegoś wcześniej niż planowano"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e3acb30-7d3f-327f-a033-37d0feb8f40b",
                    "sense_definition": "To a later time on a clock or schedule.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "time_adjustment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't forget to set the clock <w>ahead</w> one hour tonight.",
                            "target_lang_translations": {
                                "ru": "Не забудьте перевести часы на час <w>вперёд</w> сегодня вечером.",
                                "pl": "Nie zapomnij dziś w nocy przestawić zegara o jedną godzinę <w>do przodu</w>."
                            }
                        },
                        {
                            "text": "We moved the meeting <w>ahead</w> to allow more time for preparation.",
                            "target_lang_translations": {
                                "ru": "Мы перенесли встречу <w>вперёд</w>, чтобы дать больше времени на подготовку.",
                                "pl": "Przesunęliśmy spotkanie <w>do przodu</w>, aby dać więcej czasu na przygotowanie."
                            }
                        }
                    ],
                    "synonyms": [
                        "forward"
                    ],
                    "common_phrases": [
                        "set ahead",
                        "move ahead"
                    ],
                    "target_lang_definitions": {
                        "ru": "На более позднее время по часам или расписанию.",
                        "pl": "Na późniejszą godzinę na zegarze lub w harmonogramie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вперёд",
                                "target_lang_sense_clarification": "о переводе стрелок или времени"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "do przodu",
                                "target_lang_sense_clarification": "o przesunięciu wskazówek zegara lub terminu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}