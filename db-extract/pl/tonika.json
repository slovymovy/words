                                                "example_id": "44d68ab1-1ca6-4194-9902-a1a0543497ff",
                                                "sense_id": "f1e3a458-be77-313b-8f23-a871652e3854",
                                                "text": "Syllabe tonique."
                                            },
                                            {
                                                "example_id": "5a2a4adf-87ca-46f5-80bf-737526340179",
                                                "sense_id": "f1e3a458-be77-313b-8f23-a871652e3854",
                                                "text": "Voyelle tonique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc377965-083a-30e5-8d15-f36cfacdceda",
                                        "entry_id": "5f21b19a-ff37-33e4-b915-3d78dfbf7f13",
                                        "glosses": [
                                            "Qualifie la première note d’un ton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2755b942-cdab-4507-9155-515d2bc74bc1",
                                                "sense_id": "cc377965-083a-30e5-8d15-f36cfacdceda",
                                                "text": "Ut est la note tonique dans le ton d’ut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb87d874-d87a-3efa-9498-a05e64b29596",
                                        "entry_id": "5f21b19a-ff37-33e4-b915-3d78dfbf7f13",
                                        "glosses": [
                                            "Qui a une tension élastique, en parlant des tissus, des muscles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c8eb0b9-86dd-380a-8de7-03717d86b30e",
                                        "entry_id": "5f21b19a-ff37-33e4-b915-3d78dfbf7f13",
                                        "glosses": [
                                            "Qui excite la tonicité, qui fortifie l’organisme, le rend plus ferme, plus alerte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tonique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d02356b0-1bb5-3e4d-b444-58c7d92d2beb",
                                        "entry_id": "ff204bc3-192f-3352-ad0a-ba88d32ec886",
                                        "glosses": [
                                            "Première note d’un ton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc2c9fff-69b0-4f98-bdce-9c8097b0bb34",
                                                "sense_id": "d02356b0-1bb5-3e4d-b444-58c7d92d2beb",
                                                "text": "Le premier tapait sur une longue caisse faite d'un tronc d'arbre, et fermée d’un côté seulement. Le second frappait avec deux baguettes sur le bois de cette même caisse en s’évertuant à découvrir des rhythmes contrariés. Le troisième répétait sans cesse les accords de tonique et de dominante sur un tiplé : petite guitare faite avec une peau de tatoue. = Alexis de Gabriac (1811-1890), \"Promenade à travers l'Amérique-du-Sud\" (1868)."
                                            },
                                            {
                                                "example_id": "04217ba2-9360-44aa-8fca-8e9a842d0f07",
                                                "sense_id": "d02356b0-1bb5-3e4d-b444-58c7d92d2beb",
                                                "text": "Avec mon violoncelle, je faisais office plutôt de contrebasse : poum… poum… Tonique et dominante, tonique et dominante…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tonique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "abda2b78-5844-35ce-9697-3398857f21f8",
                                        "entry_id": "fbb8d3b6-1564-3da2-8369-05fb904b52fa",
                                        "glosses": [
                                            "Substance qui tonifie l’organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62d7b1c0-5e62-4415-a4d3-6d38790a454c",
                                                "sense_id": "abda2b78-5844-35ce-9697-3398857f21f8",
                                                "text": "[…] on avait ajouté deux écriteaux réclames, dont l’un recommandait une montre à 3 fr. 95 et l’autre un tonique pour le système nerveux."
                                            },
                                            {
                                                "example_id": "61704ad7-0b2c-4713-a46b-78fb67b5c4b8",
                                                "sense_id": "abda2b78-5844-35ce-9697-3398857f21f8",
                                                "text": "À la fin du XIXᵉ siècle, la liqueur de Fowler, solution d'arsenic dans du bicarbonate de potassium, occupe une place de choix comme tonique, une indication qui n'est plus réservée aujourd'hui qu'aux chevaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8230b23a-fcd4-3e29-9e3e-aca7139be466",
                                        "entry_id": "fbb8d3b6-1564-3da2-8369-05fb904b52fa",
                                        "glosses": [
                                            "Fortifiant intellectuel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "289a3c0f-566e-494b-89fc-852cb0937e97",
                                                "sense_id": "8230b23a-fcd4-3e29-9e3e-aca7139be466",
                                                "text": "Le premier ouvrage d’Octave a pour épigraphe un texte en grec de Marc Aurèle, dont les Pensées resteront toujours pour lui un tonique spirituel avec les Confessions de saint Augustin et L’Imitation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74742977-375b-3aad-894e-5b152017deeb",
                                        "entry_id": "fbb8d3b6-1564-3da2-8369-05fb904b52fa",
                                        "glosses": [
                                            "Facteur renforçant le moral."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8033fb04-17be-471c-be8f-e071483f8a40",
                                                "sense_id": "74742977-375b-3aad-894e-5b152017deeb",
                                                "text": "Si pour beaucoup d’hommes la misère est un tonique, il en est d’autres pour qui elle est un dissolvant et le comte fut de ceux-ci."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
