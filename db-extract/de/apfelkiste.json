                "senses": [
                    {
                        "sense_id": "c60fccbe-c7f4-330b-824b-b0170eaca4a9",
                        "entry_id": "1608ad16-4415-3275-b562-046c22c4a6cc",
                        "glosses": [
                            "Kiste, in der Äpfel gelagert und transportiert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e6c36f1-07a1-4400-a03e-a046eca57c86",
                                "sense_id": "c60fccbe-c7f4-330b-824b-b0170eaca4a9",
                                "text": "„Ich suchte kaputte Apfelkisten heraus und zimmerte daran herum.“"
                            },
                            {
                                "example_id": "0ed9974b-571a-4e1d-83bc-ed806344a221",
                                "sense_id": "c60fccbe-c7f4-330b-824b-b0170eaca4a9",
                                "text": "„Suttree beugte sich über die auf der Apfelkiste ausgebreiteten Blätter.“"
                            },
                            {
                                "example_id": "ce167497-c498-4c9a-abf2-b4ead0fbc645",
                                "sense_id": "c60fccbe-c7f4-330b-824b-b0170eaca4a9",
                                "text": "„Er will den Wagen nur als eine Art ‚vierrädrige Apfelkiste‘ benutzt und die Äpfel darin zwischengelagert haben.“"
                            },
                            {
                                "example_id": "cbdf0d26-6eef-4784-822a-0f15ee22ebf7",
                                "sense_id": "c60fccbe-c7f4-330b-824b-b0170eaca4a9",
                                "text": "„Als Option auf eine fidelere Zukunft trägt sie eine leere Apfelkiste mit sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
