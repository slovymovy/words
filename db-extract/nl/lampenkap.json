                    {
                        "sense_id": "5d74925a-74ee-30fd-b89c-a7781a0d0a44",
                        "entry_id": "dab4f47e-34d3-3e9f-a386-4b9366e6ad96",
                        "glosses": [
                            "kap over een lamp om het licht af te schermen"
                        ],
