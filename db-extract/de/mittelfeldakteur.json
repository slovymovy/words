                                    {
                                        "sense_id": "bc383fab-e932-342b-a0dd-05aaaf73fbe7",
                                        "entry_id": "69d5c2e4-a910-36b9-b79b-125e405236ac",
                                        "glosses": [
                                            "A player who operates behind the attackers and in front of the defence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "835537b0-c7f8-42ff-ac02-63265fc3ec97",
                                                "sense_id": "bc383fab-e932-342b-a0dd-05aaaf73fbe7",
                                                "text": "The game was engulfed in controversy when Rodwell appeared to win the ball cleanly in a midfield challenge with Suarez. The tackle drew an angry response from Liverpool's players- Lucas in particular as Suarez writhed in agony - but it was an obvious injustice when the England Under-21 midfielder was shown the red card."
                                            },
                                            {
                                                "example_id": "9490e263-06cb-440c-80fc-9369ea0a3317",
                                                "sense_id": "bc383fab-e932-342b-a0dd-05aaaf73fbe7",
                                                "text": "Serie A club Inter Milan – whom Eriksen had been contracted to at the time of the incident – let the midfielder move abroad as he was unable to play in Italy unless the ICD device was removed."
                                            },
                                            {
                                                "example_id": "0f39e6cc-9a7e-44c3-bb5b-4e61c7d09d20",
                                                "sense_id": "bc383fab-e932-342b-a0dd-05aaaf73fbe7",
                                                "text": "Defensive midfielders have to see things before they happen in and out of possession."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52f6b5b5-9204-4fc1-8dd0-c7bbc47afc05",
                        "source_entry_id": "7698ee1c-d3c4-3cd3-aa65-bbad6924e9b8",
                        "source_sense_id": "5da259e8-6650-395c-b03a-1aeed3963885",
                        "source_sense_description": "Sport, Fußball: Spieler mit einer Position zwischen Abwehr und Sturm",
                        "target_lang_word": "milieu de terrain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "milieu de terrain",
