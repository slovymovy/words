                    {
                        "translation_id": "a3095980-b8ba-4d40-91cf-8f5f25487316",
                        "source_entry_id": "1119a44a-c850-3ea5-8637-7d6b44120fdb",
                        "source_sense_id": "317d179c-eeb8-360d-9462-ea4cbdc2bc2a",
                        "target_lang_word": "Entomologie",
                        "target_lang_code": "de",
