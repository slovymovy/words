                    {
                        "translation_id": "84049528-b22a-4c1e-978a-a7a4240ab3a5",
                        "source_entry_id": "e219ce3e-cad4-3dea-acb7-03ed64406500",
                        "source_sense_id": "ace7ccc6-ea6a-316b-86ba-4b7680c7afdf",
                        "source_sense_description": "Möbelstück mit Spiegel zum Frisieren",
                        "target_lang_word": "coiffeuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coiffeuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a17ba12-84f3-3d53-8ba6-3843a4d0975e",
                                        "entry_id": "dfeb6d41-15b5-3702-b55c-411c97736b49",
                                        "glosses": [
                                            "Artisane, salariée ou même jadis employée de maison, dont le métier est de couper et coiffer les cheveux."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f725d04d-a133-4e8c-bebd-454b72a3e288",
                                                "sense_id": "5a17ba12-84f3-3d53-8ba6-3843a4d0975e",
                                                "text": "Cette détermination ne lui donnait pas l’air tendre lorsqu’il frappa à la porte de la Catalane.\nCe fut la coiffeuse qui vint lui ouvrir."
                                            },
                                            {
                                                "example_id": "218b333a-b4e7-46c8-9b4b-78bc237adf81",
                                                "sense_id": "5a17ba12-84f3-3d53-8ba6-3843a4d0975e",
                                                "text": "Autrefois, dans les villages, la coiffeuse appelée aussi tresseuse, était le plus souvent la femme d’un forgeron, d’un griot, d’un artisan ou une descendance de ces castes."
                                            },
                                            {
                                                "example_id": "ac38fae4-5b5f-4232-a077-e409f50cb060",
                                                "sense_id": "5a17ba12-84f3-3d53-8ba6-3843a4d0975e",
                                                "text": "Cependant, la mode des coiffeuses pour dames ne naît qu’au xviiᵉ siècle, avec l’apparition de coiffeuses parisiennes réputées telles la Baransay ou la Jeanneton, bien que ce soit seulement en 1772 que les femmes aient été officiellement autorisées à exercer ce métier."
                                            },
                                            {
                                                "example_id": "59ef27e6-c8a9-431b-8d95-596431207443",
                                                "sense_id": "5a17ba12-84f3-3d53-8ba6-3843a4d0975e",
                                                "text": "Pendant qu’elles discutent, le blond pisseux disparaît progressivement sous le produit que la coiffeuse étale sur la chevelure à l’aide d’un pinceau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bb0c59a-e218-3973-93bb-e82e20808191",
                                        "entry_id": "dfeb6d41-15b5-3702-b55c-411c97736b49",
                                        "glosses": [
                                            "Meuble disposant d’un miroir et d’endroits destinés à ranger son matériel, utilisé pour se coiffer, se maquiller, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22d589f9-541b-4514-a48d-53a6b3628948",
                                                "sense_id": "9bb0c59a-e218-3973-93bb-e82e20808191",
                                                "text": "Ma femme de chambre vient de trouver mes boucles d’oreilles accrochées aux volants de ma coiffeuse."
                                            },
                                            {
                                                "example_id": "0a1695dd-4d8d-4a2f-b6d4-b69ad1ae16e9",
                                                "sense_id": "9bb0c59a-e218-3973-93bb-e82e20808191",
                                                "text": "Arrivée dans la ladies-room qui se constituait, comme c’est souvent le cas dans cette région, d’un petit salon meublé d’une coiffeuse avec son pouf, et des toilettes elles-mêmes séparées du boudoir par une porte aux motifs fleuris, Elizabeth put s’asseoir sans mon soutien."
                                            },
                                            {
                                                "example_id": "2f9bb9e3-e5fa-475a-97cd-977ad8dddacc",
                                                "sense_id": "9bb0c59a-e218-3973-93bb-e82e20808191",
                                                "text": "Le duc de Richelieu, ardent ennemi de Maurepas qu’il savait hostile à ses maraudes militaires, saisit l’occasion d’écrire quelques vers et de les placer sur la glace de la coiffeuse de la marquise, en faisant croire que Maurepas en était l’auteur."
                                            },
                                            {
                                                "example_id": "5f7d9c90-5c19-46b3-bf88-39cadf3f0851",
                                                "sense_id": "9bb0c59a-e218-3973-93bb-e82e20808191",
                                                "text": "Elle ouvre le premier tiroir de sa coiffeuse pour s’emparer de l’original de son travail. Elle va le détruire, le réduire en cendres dans la jolie cheminée du salon."
                                            },
                                            {
                                                "example_id": "50975a46-900c-4e29-8676-e248bab6d1d3",
                                                "sense_id": "9bb0c59a-e218-3973-93bb-e82e20808191",
                                                "text": "Je me suis dirigée vers le miroir de la coiffeuse et je me suis penchée en avant, les mains posées entre les produits de maquillage. Mon reflet m’a retourné mon regard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
