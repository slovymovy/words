                        "entry_id": "231c7762-f85c-3097-a32f-6170eed39f5c",
                        "glosses": [
                            "een kleed dat over een tafel ligt ter bescherming van de tafel, of omdat het modieus is, of voor de gezelligheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d96b3c49-fc29-4862-af56-d60c926625d3",
                                "sense_id": "d183ee2c-3956-39dc-b148-4469bd545e04",
                                "text": "Bij een vriend werden er krassen gekerfd in zijn auto nadat hij als beheerder stookolie had aangekocht, bij een collega kloppen kouwelijke bovenburen tapijten en tafeldoeken uit over zijn terras en droogrek na een negatieve oliestemming."
                            },
                            {
                                "example_id": "114b5ab7-1eea-45b5-a6c3-73b64d8b07f6",
                                "sense_id": "d183ee2c-3956-39dc-b148-4469bd545e04",
                                "text": "Haar modelboeken liggen dan weer keurig op een lange rij schraagtafels, bekleed met tafeldoeken in afwisselende kleuren."
                            }
                        ]
                    }
