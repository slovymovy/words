                    },
                    {
                        "form_id": "2f8186ae-2218-42c2-b891-e005a2241703",
                        "entry_id": "20d8e1a4-37af-33d8-ac4d-e51c5bd689b7",
                        "tags": [
                            "orthographe traditionnelle"
                        ],
                        "form": "sacro-saint"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2a512b7-610c-37d8-b06f-3c8a45f60a6a",
                        "entry_id": "20d8e1a4-37af-33d8-ac4d-e51c5bd689b7",
                        "glosses": [
                            "Qui est très saint, doublement sacré et révéré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d66f8c0-dded-4cb5-9157-ad9d25a32873",
                                "sense_id": "b2a512b7-610c-37d8-b06f-3c8a45f60a6a",
                                "text": "Dans les basiliques majeures, appelées aussi patriarchales ou sacrosaintes, le maître-autel est dit autel papal, parce que le pape seul peut y célébrer."
                            }
                        ]
                    },
                    {
                        "sense_id": "065807a1-73c2-312a-8b04-e9f83c817573",
                        "entry_id": "20d8e1a4-37af-33d8-ac4d-e51c5bd689b7",
                        "glosses": [
                            "S’emploie le plus souvent sans sens particulier, pour indiquer une nuance d’ironie."
                        ],
                        "tags": [
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "79a8df84-19f0-4b9c-9e69-b04b432393ea",
                                "sense_id": "065807a1-73c2-312a-8b04-e9f83c817573",
                                "text": "La sacrosainte libre concurrence au sein des pays de la Communauté s’est ainsi heurtée au monopole des architectes en chef des monuments historiques (ACMH), automatiquement chargés de la maîtrise d’œuvre pour les immeubles classés dès lors que les travaux entrepris étaient subventionnés par le ministère de la culture ou réalisés sous sa maîtrise d’ouvrage."
                            },
                            {
                                "example_id": "23db86e7-4580-48f5-b222-58de4591b007",
                                "sense_id": "065807a1-73c2-312a-8b04-e9f83c817573",
                                "text": "Cet artiste est comme un glaçon au fond d'un sacrosaint verre de pastis, froid et fondant, mais sa musique est aussi chaude que sa personnalité réservée."
                            },
                            {
                                "example_id": "d609622d-f84d-41da-9f7e-8e78eed3828a",
                                "sense_id": "065807a1-73c2-312a-8b04-e9f83c817573",
                                "text": "Le samedi, on fait les sacrosaintes courses !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d879ba2e-2e0d-4a5b-af4c-189168584eb3",
                        "source_entry_id": "20d8e1a4-37af-33d8-ac4d-e51c5bd689b7",
                        "target_lang_word": "sacrosanct",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacrosanct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e600f9c-af23-3241-98bc-94d5c666128f",
                                        "entry_id": "034b3f7f-e369-3145-8512-91c9eaf108cc",
                                        "glosses": [
                                            "Beyond alteration, criticism, or interference, especially due to religious sanction; inviolable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd3438e1-c07f-4e07-be54-c04b1ba8558e",
                                                "sense_id": "6e600f9c-af23-3241-98bc-94d5c666128f",
                                                "text": "It will be noted that pre-grouping routes between London and Scotland are no longer sacrosanct—for example, Glasgow St. Enoch trains no longer run necessarily to St. Pancras."
                                            },
                                            {
                                                "example_id": "69c837f6-14b6-4f6f-8684-b6421677696d",
                                                "sense_id": "6e600f9c-af23-3241-98bc-94d5c666128f",
                                                "text": "Closer investigation revealed these as millions of elaborate crypts a few meters below the surface, left by a long-extinct spacefaring species called the zeioph. Many human universities wish to perform archeological excavations. Council law holds grave sites as sacrosanct, however, and the matter has been tied up in court for a decade."
                                            },
                                            {
                                                "example_id": "537180b0-60cc-440c-9491-1960176daff3",
                                                "sense_id": "6e600f9c-af23-3241-98bc-94d5c666128f",
                                                "text": "After decades of being considered politically sacrosanct, why are homeowner mortgage write-offs suddenly on the chopping block?"
                                            },
                                            {
                                                "example_id": "667bc504-adfa-472d-9915-1430d03df295",
                                                "sense_id": "6e600f9c-af23-3241-98bc-94d5c666128f",
                                                "text": "The impeachment crisis is also a symptom of a country caught in a massive political estrangement that is tearing apart any sense of common patriotic purpose. It has exposed a political culture in which the facts – in this case, of the President’s actions – are no longer sacrosanct and that has been laced with a fog of misinformation by his allies."
                                            },
                                            {
                                                "example_id": "3679bbd7-cf39-4848-a0bd-951e6d9b24d9",
                                                "sense_id": "6e600f9c-af23-3241-98bc-94d5c666128f",
                                                "text": "For me, it is sacrosanct. It’s our history, it’s our cultural heritage. I do not believe in censorship in that way."
                                            },
                                            {
                                                "example_id": "7491a5b6-69c6-4bf9-9bbf-7f9b451a52a4",
                                                "sense_id": "6e600f9c-af23-3241-98bc-94d5c666128f",
                                                "text": "As Parisians deserted the capital in August for their sacrosanct summer holidays, French Prime Minister François Bayrou remained stationed at this desk in an otherwise hushed Hôtel de Matignon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cf5aed7-7c29-3302-929c-400636befc77",
                                        "entry_id": "034b3f7f-e369-3145-8512-91c9eaf108cc",
                                        "glosses": [
                                            "Sacred, very holy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
