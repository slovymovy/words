                                        "sense_id": "11299066-b871-3a31-a5fe-308938c41c57",
                                        "entry_id": "6eed3b5b-5763-33fe-bb3b-9bc83abd2abd",
                                        "glosses": [
                                            "A blog on which one posts brief, frequent updates on one's activities."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ae08ae8-9f63-4fed-80f2-c121511ce4d2",
                                                "sense_id": "11299066-b871-3a31-a5fe-308938c41c57",
                                                "text": "For Dorsey, creating this community of linked microblogs has been \"endearing, because you know what everyone you know is doing\" […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "microblog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "101b694d-fc24-37e8-b4c1-976d76e44aed",
                                        "entry_id": "2a668a68-4d44-3235-a61d-7443218a1d2e",
                                        "glosses": [
                                            "To post on a microblog."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88ef692e-1cf6-46cc-94f0-9d4d9941eaa2",
                                                "sense_id": "101b694d-fc24-37e8-b4c1-976d76e44aed",
                                                "text": "I started microblogging last week."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85abdcab-c576-4129-a4d6-d8efab6be1e0",
                        "source_entry_id": "a06cd1f6-064b-3dd6-91bd-22a4ea7135af",
                        "source_sense_id": "63c29f89-c036-3d64-9eea-d89503f7166d",
