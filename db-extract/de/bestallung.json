                    {
                        "sense_id": "53985007-c363-3cc0-bff4-05b78cedfcb1",
                        "entry_id": "0f9538bb-dee0-38de-828b-ef17e0be41c1",
                        "glosses": [
                            "Versehen mit einer besonderen Stellung, zum Beispiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d757c5f9-b472-480c-9648-cfb5f5a136db",
                                "sense_id": "53985007-c363-3cc0-bff4-05b78cedfcb1",
                                "text": "Er musste seine Bestallungsurkunde zurückgeben, nachdem die Bestallung eines anderen Insolvenzverwalters rechtskräftig geworden war."
                            },
                            {
                                "example_id": "08fdec58-0712-40c8-adbb-5a4d7debd8df",
                                "sense_id": "53985007-c363-3cc0-bff4-05b78cedfcb1",
                                "text": "„Bewusst hielten sie sich bei der Bestallung von Bürgermeister und Dezernenten zurück, wobei sie jedoch sorgsam darauf achteten, dass Person, Polizei und Volksbildung »zuverlässigen Genossen« anvertraut wurden.“"
                            },
                            {
                                "example_id": "9e7ab6c4-a570-4f84-9cb9-775eb493c3fc",
                                "sense_id": "53985007-c363-3cc0-bff4-05b78cedfcb1",
                                "text": "Im Verwaltungsrecht ist die Bestallung die öffentlichrechtliche Zulassung als Arzt oder Apotheker."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "142a731d-7c83-3c62-beb4-75085d2833b9",
