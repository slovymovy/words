                    {
                        "sense_id": "794ee28f-838f-393a-8b77-f8fd9c9eee40",
                        "entry_id": "160370e3-fc1c-379e-856b-5b446e225417",
                        "glosses": [
                            "The mechanism on a bicycle used to move the chain from one sprocket (gear) to another."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c458597-b58e-4f9b-947c-4b3302b6de5c",
                                "sense_id": "794ee28f-838f-393a-8b77-f8fd9c9eee40",
                                "text": "The common rear derailleur designs all operate on the same principle. A moveable cage receives the chain returning from the chainwheel and directs it onto one sprocket of the cluster."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e311387-c7ff-3df4-b9b5-c5a1f51f560b",
                        "entry_id": "160370e3-fc1c-379e-856b-5b446e225417",
                        "glosses": [
                            "The entire gearset on a bicycle with such a mechanism."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
