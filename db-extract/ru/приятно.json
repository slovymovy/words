        "ru-extract.jsonl": [
            {
                "entry_id": "3d2b04e9-3634-3583-b28c-1ad27ccfd555",
                "word": "приятно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9797b248-7c3b-3f78-837b-e6d21c206925",
                        "entry_id": "3d2b04e9-3634-3583-b28c-1ad27ccfd555",
                        "glosses": [
                            "наречие к приятный; доставляя удовольствие, вызывая положительные эмоции"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "9ceda976-32e7-425d-915e-580a230d8d2a",
                                "sense_id": "9797b248-7c3b-3f78-837b-e6d21c206925",
                                "text": "И в оранжерее тоже приятно пахнет ― да жить в ней нельзя."
                            },
                            {
                                "example_id": "78c4cd85-091d-4d87-8d2b-c3b004f85193",
                                "sense_id": "9797b248-7c3b-3f78-837b-e6d21c206925",
                                "text": "Как человек, император был приятно удивлён."
                            },
                            {
                                "example_id": "5f2f3ac5-7cca-4575-853f-c11af572b6b1",
                                "sense_id": "9797b248-7c3b-3f78-837b-e6d21c206925",
                                "text": "Босые ноги приятно холодила влажная земля, а оголенные полные икры и шею ищущими горячими губами целовал суховей."
                            }
                        ]
                    },
                    {
                        "sense_id": "8afa47ed-f49b-3884-a024-29526fd95ee6",
                        "entry_id": "3d2b04e9-3634-3583-b28c-1ad27ccfd555",
                        "glosses": [
                            "предик. о чувстве удовольствия, испытываемом кем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25c5f8cd-e0b4-4d11-af1f-4deb39400720",
                                "sense_id": "8afa47ed-f49b-3884-a024-29526fd95ee6",
                                "text": "Очень приятно, что довелось познакомиться с таким выдающимся человеком."
                            },
                            {
                                "example_id": "b976a212-9fcc-4d74-a605-e9051c9eeeca",
                                "sense_id": "8afa47ed-f49b-3884-a024-29526fd95ee6",
                                "text": "Приятно бродить по зимнему лесу, вдыхать чистый, свежий, морозный воздух."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b2c39d0-b317-4625-ae50-98d7a1c23f9e",
                        "source_entry_id": "3d2b04e9-3634-3583-b28c-1ad27ccfd555",
                        "source_sense_description": "наречие",
                        "target_lang_word": "pleasantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleasantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52ce259f-d7a6-3efc-94c2-fe1053b4b91d",
                                        "entry_id": "7318edcd-9e1b-3c5b-b281-80c8b1f9d583",
                                        "glosses": [
                                            "In a pleasant manner; so as to achieve a pleasant result."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "046fc853-fe0c-4053-a0c9-a1bc30964366",
                                                "sense_id": "52ce259f-d7a6-3efc-94c2-fe1053b4b91d",
                                                "text": "He smiled pleasantly at passersby."
                                            },
                                            {
                                                "example_id": "490f1d8d-bd48-46ec-8701-881bbdf95b55",
                                                "sense_id": "52ce259f-d7a6-3efc-94c2-fe1053b4b91d",
                                                "text": "They were pleasantly surprised at the result."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f90d169c-2574-3dc9-90b0-9c86da04dff9",
                                        "entry_id": "7318edcd-9e1b-3c5b-b281-80c8b1f9d583",
                                        "glosses": [
                                            "Lightly"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10b01372-9dca-3f7c-be15-e731c1c5172f",
                                        "entry_id": "7318edcd-9e1b-3c5b-b281-80c8b1f9d583",
                                        "glosses": [
                                            "Ludicrously; facetiously."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37e76f5c-1a0f-407d-b67a-7c5a8538377b",
                                                "sense_id": "10b01372-9dca-3f7c-be15-e731c1c5172f",
                                                "text": "In workhouses, pleasantly so named, because work cannot be done in them."
                                            },
                                            {
                                                "example_id": "389bf3c6-5c3e-417a-86c0-97c7326d6681",
                                                "sense_id": "10b01372-9dca-3f7c-be15-e731c1c5172f",
                                                "text": "Mr Venus, reminded of the duties of hospitality, produced some rum. In answer to the inquiry, 'Will you mix it, Mr Wegg?' that gentleman pleasantly rejoined, 'I think not, sir. On so auspicious an occasion, I prefer to take it in the form of a Gum-Tickler.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5abe8370-d911-4fbb-ae11-f31398f93f42",
                        "source_entry_id": "3d2b04e9-3634-3583-b28c-1ad27ccfd555",
                        "source_sense_description": "наречие",
                        "target_lang_word": "agreeably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agreeably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e74e01f6-b802-3afd-a294-9fc6936b972b",
                                        "entry_id": "ec0e2af1-a27b-3527-88aa-dbc2636bab30",
                                        "glosses": [
                                            "In an agreeable or pleasing manner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fc57b79-aac2-4aeb-8b17-ec5c468195b2",
                                                "sense_id": "e74e01f6-b802-3afd-a294-9fc6936b972b",
                                                "text": "What a game this was in those early minutes. Germany were also agreeably fluid, with a fine natural width. But they also looked like a champion team short-handed heading back towards their own goal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5f4e080-c3a5-3b88-8598-b0c5ce142e37",
                                        "entry_id": "ec0e2af1-a27b-3527-88aa-dbc2636bab30",
                                        "glosses": [
                                            "In accordance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55af5b5e-6e1c-4aa9-a5b5-a02cb8902f99",
                                                "sense_id": "e5f4e080-c3a5-3b88-8598-b0c5ce142e37",
                                                "text": "Walter was not a little surprised when he came back in the course of the forenoon, agreeably to his promise, to find Mr Brogley sitting in the back parlour with his hands in his pockets, and his hat hanging up behind the door."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad8d6c57-2e0f-3c45-991b-6cfcf4ec4129",
                                        "entry_id": "ec0e2af1-a27b-3527-88aa-dbc2636bab30",
                                        "glosses": [
                                            "Alike; similarly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
