    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "5c43c479-4b93-3e5a-a5c2-079188c6f545",
                    "sense_definition": "To some extent; somewhat; moderately.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was <w>kinda</w> tired after the long walk, so I decided to take a short nap.",
                            "target_lang_translations": {
                                "ru": "Я <w>немного</w> устал после долгой прогулки, поэтому решил немного вздремнуть."
                            }
                        },
                        {
                            "text": "That movie was <w>kinda</w> funny, but the ending did not make much sense.",
                            "target_lang_translations": {
                                "ru": "Этот фильм был <w>вроде как</w> забавным, но концовка не имела особого смысла."
                            }
                        }
                    ],
                    "synonyms": [
                        "sorta"
                    ],
                    "common_phrases": [
                        "kinda funny",
                        "kinda weird",
                        "kinda busy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Spelling pronunciation of 'kind of'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В некоторой степени; отчасти; немного; довольно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "типа",
                                "target_lang_sense_clarification": "разговорное, в значении «вроде как»"
                            },
                            {
                                "target_lang_word": "как бы",
                                "target_lang_sense_clarification": "для выражения неточности или смягчения"
                            },
                            {
                                "target_lang_word": "немного",
                                "target_lang_sense_clarification": "в некоторой степени"
                            },
                            {
                                "target_lang_word": "вроде",
                                "target_lang_sense_clarification": "в значении «вроде как»"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "9ccd030e-bb8c-3e80-b998-ec473b2952e3",
                    "sense_definition": "Used to express a hesitant or partial agreement; in a way.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "response",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"Are you afraid of a little bit of rain?\" \"<w>Kinda</w>, yeah, I don't want to get my new shoes wet.\"",
                            "target_lang_translations": {
                                "ru": "«Ты боишься небольшого дождя?» — «<w>Типа того</w>, да, не хочу промочить новые туфли»."
                            }
                        },
                        {
                            "text": "\"Do you understand what he is trying to say?\" \"<w>Kinda</w>, but he is still being very vague.\"",
                            "target_lang_translations": {
                                "ru": "«Ты понимаешь, что он пытается сказать?» — «<w>Вроде как</w>, но он всё равно выражается очень туманно»."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kinda yeah"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a standalone response or hedge"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения нерешительного или частичного согласия; в каком-то смысле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "типа того",
                                "target_lang_sense_clarification": "разговорный ответ, выражающий частичное согласие"
                            },
                            {
                                "target_lang_word": "в каком-то смысле",
                                "target_lang_sense_clarification": "частичное согласие"
                            },
                            {
                                "target_lang_word": "вроде того",
                                "target_lang_sense_clarification": "неуверенное согласие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c433779e-1844-3d23-a01e-397f6e1757fe",
                    "sense_definition": "A subspecies of baboon, Papio cynocephalus kindae, primarily found in Angola, the Democratic Republic of the Congo, Zambia, and possibly western Tanzania.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Researchers are studying the social behavior of the <w>kinda</w> baboon in Zambia.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучают социальное поведение бабуина <w>кинда</w> в Замбии."
                            }
                        },
                        {
                            "text": "The <w>kinda</w> is smaller than other baboon subspecies and has a distinctive coat.",
                            "target_lang_translations": {
                                "ru": "Бабуин <w>кинда</w> меньше других подвидов бабуинов и имеет характерную шерсть."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kinda baboon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвид бабуина (Papio cynocephalus kindae), обитающий в основном в Анголе, Демократической Республике Конго, Замбии и, возможно, на западе Танзании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кинда",
                                "target_lang_sense_clarification": "название подвида бабуинов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
