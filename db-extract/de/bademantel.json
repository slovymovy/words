                    }
                ],
                "senses": [
                    {
                        "sense_id": "6667aa75-22dd-344b-b63b-6a12ad0e647e",
                        "entry_id": "f89d2f99-ddb5-3db7-8ba2-64ec42af4d16",
                        "glosses": [
                            "Mantel, meist aus dem gleichen Material wie Handtücher oder einem anderen weichen Stoff, den man nach dem Duschen oder Baden anzieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9f8dd22-80c4-435f-97b7-87740f237d87",
                                "sense_id": "6667aa75-22dd-344b-b63b-6a12ad0e647e",
                                "text": "Nach dem Baden zieh ich mir immer meinen Bademantel an, setze mich auf den Balkon und lese ein Buch."
                            },
                            {
                                "example_id": "187ea659-f125-4324-ab2a-962e53e6e6d4",
                                "sense_id": "6667aa75-22dd-344b-b63b-6a12ad0e647e",
                                "text": "„Ein schlicht sportlicher, einfarbiger Bademantel aus herzhaftem Frotté, das war hier das richtige.“"
                            },
                            {
                                "example_id": "45785aaf-984c-4f85-be87-d9ad4c5afe39",
                                "sense_id": "6667aa75-22dd-344b-b63b-6a12ad0e647e",
                                "text": "„Er hatte einen kastanienbraunen Bademantel an.“"
                            },
                            {
                                "example_id": "9ff53e18-2f9e-4f65-ac68-1da519f3a3d4",
                                "sense_id": "6667aa75-22dd-344b-b63b-6a12ad0e647e",
                                "text": "„Sie hatte ihren Bademantel ausgezogen und stand am Beckenrand.“"
                            },
                            {
                                "example_id": "fbaf4847-b8fb-43b1-a892-e176af49faf3",
                                "sense_id": "6667aa75-22dd-344b-b63b-6a12ad0e647e",
                                "text": "„Durch die Lobby schlurfte ein dicker Mann im Bademantel an die Rezeption und verlangte den Saunaschlüssel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b04bc74d-0025-4ac6-8ab1-5b382550ef11",
                        "source_entry_id": "f89d2f99-ddb5-3db7-8ba2-64ec42af4d16",
                        "source_sense_id": "6667aa75-22dd-344b-b63b-6a12ad0e647e",
                        "source_sense_description": "Mantel, den man nach dem Duschen oder Baden anzieht",
                        "target_lang_word": "bathrobe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bathrobe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19637175-d3f7-3e41-bdd0-1c93f69482e8",
                                        "entry_id": "6a54bf38-2e71-343f-a850-f35aaaa42811",
                                        "glosses": [
                                            "A robe usually made of terrycloth intended to be worn when one is still damp from bathing or when there is no immediate need to dress fully."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "042c7ae5-6d7c-42a4-b484-a6c0685b6fab",
                        "source_entry_id": "f89d2f99-ddb5-3db7-8ba2-64ec42af4d16",
                        "source_sense_id": "6667aa75-22dd-344b-b63b-6a12ad0e647e",
                        "source_sense_description": "Mantel, den man nach dem Duschen oder Baden anzieht",
                        "target_lang_word": "peignoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peignoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c592086-b407-32c5-a9ae-00dbe7e57928",
                                        "entry_id": "c599c968-eaa1-35be-82ef-4d36fcdfc442",
                                        "glosses": [
                                            "Sorte de vêtement de dessus que l’on jette sur ses épaules, quand on fait sa toilette, quand on se peigne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b5d4651-e233-4e79-b04d-e3c0e3cc2c2b",
                                                "sense_id": "8c592086-b407-32c5-a9ae-00dbe7e57928",
                                                "text": "Liane s’était contentée d’un simple peignoir de mérinos grisâtre avec devantiau (tablier) noir, fichu à grands ramages, et ce gracieux petit bonnet rond qui s’appelle une canipette."
                                            },
                                            {
                                                "example_id": "f94020f8-3601-4738-80b1-356ad5080177",
                                                "sense_id": "8c592086-b407-32c5-a9ae-00dbe7e57928",
                                                "text": "Arlette a promis de décorer la table avec des fleurs. Aussi, le lendemain, dès l’aube, est-elle dans le jardin, en peignoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d007961-bee7-3ce3-aac7-8ba046766dab",
                                        "entry_id": "c599c968-eaa1-35be-82ef-4d36fcdfc442",
                                        "glosses": [
                                            "Vêtement à peu près semblable qu’on met en sortant du bain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "492cd3ba-48df-45f4-9f73-4374d6e34c0a",
                                                "sense_id": "7d007961-bee7-3ce3-aac7-8ba046766dab",
                                                "text": "J’attrapai un peignoir et décrochai le combiné fixé au mur, à côté des W-C."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20722737-402c-3850-877c-26672e755c40",
                                        "entry_id": "c599c968-eaa1-35be-82ef-4d36fcdfc442",
                                        "glosses": [
                                            "Vêtement d’intérieur ; déshabillé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "492ffe98-6b5b-4192-affa-d10375e828fc",
                                                "sense_id": "20722737-402c-3850-877c-26672e755c40",
                                                "text": "Une Liménienne déjeûne le matin, avec son mari en petit peignoir à la française, ses cheveux retroussés absolument comme nos dames de Paris."
                                            },
                                            {
                                                "example_id": "497a42e8-d545-448d-b9ef-8553e6aea31e",
                                                "sense_id": "20722737-402c-3850-877c-26672e755c40",
                                                "text": "Quand elle achetait soit des corsets, soit des peignoirs, soit des pantalons, elle voulait toujours que ce fût moi qui passasse avec elle dans la chambre au fond et qui les lui essayasse."
                                            },
                                            {
                                                "example_id": "0e0f74eb-dd6c-4d5d-8c39-d440ff18764c",
                                                "sense_id": "20722737-402c-3850-877c-26672e755c40",
                                                "text": "[…] : pour peu qu’il y eût de l’électricité dans l’air ou que Och eût joué des parties du Vaisseau Fantôme, les Teutes s’assombrissaient, d’autres tentaient de s’aller coucher et chassées par l’insomnie revenaient en peignoir dans le petit salon des veillées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
