                "senses": [
                    {
                        "sense_id": "ebf38804-93a2-328b-a6ca-cdfe7ecc6a40",
                        "entry_id": "828571a9-2eac-35c3-b08c-07bc7c2a9e7c",
                        "glosses": [
                            "eine Taste auf der Computertastatur, meistens in der linken oberen Ecke zu finden, die beim Drücken ein Escape-Zeichen auslöst und zum Abrechen eines Vorgangs oder Computerprogramms dienen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11739da2-d8b6-4f50-a222-911c81ea3799",
                                "sense_id": "ebf38804-93a2-328b-a6ca-cdfe7ecc6a40",
                                "text": "Wo ist denn hier die Escapetaste?"
                            },
                            {
                                "example_id": "bb93b233-6b43-4e90-85dc-ff45bfbe871c",
                                "sense_id": "ebf38804-93a2-328b-a6ca-cdfe7ecc6a40",
                                "text": "„Halten wir uns an die Escapetaste, sie dient zum Abbrechen von angefangenen oder eingeleiteten Arbeiten des Rechners.“"
                            },
                            {
                                "example_id": "db10cd99-b6a5-4bb9-b2df-92f564ec478e",
                                "sense_id": "ebf38804-93a2-328b-a6ca-cdfe7ecc6a40",
                                "text": "„Sie können Ihre Bestellung jederzeit löschen, indem Sie die Escapetaste drücken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
