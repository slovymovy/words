                ],
                "translations": [
                    {
                        "translation_id": "b76eb4a6-7c84-41db-b16f-ed190dd178bc",
                        "source_entry_id": "ea32a514-c897-3fd2-a1cb-52f72db7be14",
                        "source_sense_id": "7ec5bf89-9083-3ff5-8475-3385b95f4275",
                        "source_sense_description": "aggressiv, rüpelhaft",
                        "target_lang_word": "aggressiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aggressiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e3558a7-8c84-38fa-9773-97ce27736377",
                                        "entry_id": "5584cebe-911b-3e30-80ed-24be0884744a",
                                        "glosses": [
                                            "angriffslustig und gewaltbereit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48ffa577-5ac5-4416-a964-c548960fb5b7",
                                                "sense_id": "4e3558a7-8c84-38fa-9773-97ce27736377",
                                                "text": "Ihr aggressives Verhalten war auffällig."
                                            },
                                            {
                                                "example_id": "78e070b7-d669-4f08-b234-f82859b2fe5f",
                                                "sense_id": "4e3558a7-8c84-38fa-9773-97ce27736377",
                                                "text": "„Er wurde in dieser Zeit noch einsamer und er wurde immer aggressiver, denn seine Angst wuchs.“"
                                            },
                                            {
                                                "example_id": "23a05382-8ca7-4bb0-a4fc-7e9e242a3c3e",
                                                "sense_id": "4e3558a7-8c84-38fa-9773-97ce27736377",
                                                "text": "„Er war noch aggressiver als sonst.“"
                                            },
                                            {
                                                "example_id": "6ef95f44-b650-4bf8-bb95-7079fd0ef5ae",
                                                "sense_id": "4e3558a7-8c84-38fa-9773-97ce27736377",
                                                "text": "„Durch sein aggressives Auftreten hatte er sich den Zorn der englischen Regierung zugezogen.“"
                                            },
                                            {
                                                "example_id": "44f983ef-da92-4c43-af0f-e8f151ab1b26",
                                                "sense_id": "4e3558a7-8c84-38fa-9773-97ce27736377",
                                                "text": "Das ist ein altes Seuchengesetz: eine Seuche, sage ich mal allgemein, wird schwächer, weniger aggressiv, sie wird aber dummerweise ersetzt durch eine andere, durch eine Virusseuche zum Beispiel, und das ist genau das Problem."
                                            },
                                            {
                                                "example_id": "1ce4cc3f-b035-425a-8c85-50b30d7dbf3f",
                                                "sense_id": "4e3558a7-8c84-38fa-9773-97ce27736377",
                                                "text": "„Es war ein ziemlich aggressives Spiel[, a]ber so sind Spiele gegen die Deutschen nun mal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bcb3e87-616b-48c5-8742-447af78067ef",
                        "source_entry_id": "ea32a514-c897-3fd2-a1cb-52f72db7be14",
                        "source_sense_id": "7ec5bf89-9083-3ff5-8475-3385b95f4275",
                        "source_sense_description": "aggressiv, rüpelhaft",
                        "target_lang_word": "rüpelhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rüpelhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df424201-fbbe-3b25-b07a-b4956763d015",
                                        "entry_id": "d4e303bc-27c1-3aed-a73c-e7f8dcd7d1a1",
                                        "glosses": [
                                            "ohne Benehmen, ohne Manieren, frech, wie ein Rüpel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "689171be-9cab-4f10-a93c-062775df6e05",
                                                "sense_id": "df424201-fbbe-3b25-b07a-b4956763d015",
                                                "text": "Lehrer: „Dein rüpelhaftes Benehmen wird an dieser Schule keinesfalls akzeptiert. Entweder Du änderst Dich oder Du fliegst!“"
                                            },
                                            {
                                                "example_id": "e04b8d27-69be-47b4-bf89-2d8ea87fabe6",
                                                "sense_id": "df424201-fbbe-3b25-b07a-b4956763d015",
                                                "text": "Viele Autofahrer in Deutschland sehen Radfahrer, die auf der falschen Seite des Radfahrweges fahren, als rüpelhaft an."
                                            },
                                            {
                                                "example_id": "0aa01f47-4ed5-4490-8653-06b7a56f4469",
                                                "sense_id": "df424201-fbbe-3b25-b07a-b4956763d015",
                                                "text": "\"Chinesische Touristen genießen allerdings einen zweifelhaften Ruf: Sie gelten als laut und rüpelhaft."
                                            },
                                            {
                                                "example_id": "00963f02-e742-4274-84b7-964d10488285",
                                                "sense_id": "df424201-fbbe-3b25-b07a-b4956763d015",
                                                "text": "Der junge Herr legt allerdings seltsam rüpelhafte Manieren an den Tag, die die Einwohner von Grünwiesel für \"vornehm und modern\" halten. Der Höhepunkt der Flegeleien ist ein Stadt-Konzert, das zum Desaster ausartet: Der Neffe wird als Orang-Utan enttarnt, die Bürger haben sich zum Affen machen lassen."
                                            },
                                            {
                                                "example_id": "d85e15b0-2727-4376-8749-d2ec2dc2ab92",
                                                "sense_id": "df424201-fbbe-3b25-b07a-b4956763d015",
                                                "text": "[Der österreichische Künstler] Alfred Hrdlicka war ein ungemütlicher Zeitgenosse, gerne rüpelhaft und barsch, oft unausstehlich selbstgerecht. Sein Größenwahn schien keine Grenzen zu kennen, allenfalls Michelangelo ließ er neben sich gelten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
