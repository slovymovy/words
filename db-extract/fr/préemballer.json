                ],
                "senses": [
                    {
                        "sense_id": "c1bdff92-39b6-303e-b7d9-061ac3e4fc5e",
                        "entry_id": "ebfc0ad9-8b39-38b9-8a5b-9061e794ec31",
                        "glosses": [
                            "Emballer dans un emballage préalable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0221aa26-0cbc-465a-9ddc-f56e7eb564ba",
                                "sense_id": "c1bdff92-39b6-303e-b7d9-061ac3e4fc5e",
                                "text": "Idéal pour les magasins qui veulent préemballer leurs produits dans la maison."
                            },
                            {
                                "example_id": "464dcc0e-d917-429d-9e96-a2a6b2bf2e24",
                                "sense_id": "c1bdff92-39b6-303e-b7d9-061ac3e4fc5e",
                                "text": "Vous ne devez en aucun cas préemballer ces œufs à l'avance. Un présentoir/étiquette visible par le client doit indiquer les informations suivantes..."
                            },
                            {
                                "example_id": "55ea52bd-32ea-4ba1-be43-2b56b2a212a1",
                                "sense_id": "c1bdff92-39b6-303e-b7d9-061ac3e4fc5e",
                                "text": "Le personnel chargé de traiter et de préemballer les fromages doit se laver les mains chaque fois qu'il reprend le travail et qu'il y a contamination."
                            }
                        ]
                    }
