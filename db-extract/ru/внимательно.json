        "ru-extract.jsonl": [
            {
                "entry_id": "0465b57a-d4b3-39a9-be6f-adc9e6ed166c",
                "word": "внимательно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3e1cb977-edb9-37a6-8968-6beb7e91b196",
                        "entry_id": "0465b57a-d4b3-39a9-be6f-adc9e6ed166c",
                        "glosses": [
                            "наречие к внимательный; с вниманием, с интересом, сосредоточенно, чутко"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "2a322808-3371-4907-8a56-934bf4c9b74e",
                                "sense_id": "3e1cb977-edb9-37a6-8968-6beb7e91b196",
                                "text": "Он меня внимательно выслушал. Внимательно изучите карту, там много интересного."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b832ec4a-01cd-47a7-8117-03b5e753ca29",
                        "source_entry_id": "0465b57a-d4b3-39a9-be6f-adc9e6ed166c",
                        "source_sense_id": "3e1cb977-edb9-37a6-8968-6beb7e91b196",
                        "target_lang_word": "attentively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attentively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad43067e-dec7-33a7-8275-bcf343303507",
                                        "entry_id": "728e9a2a-80b9-3b40-9366-a9701afac49a",
                                        "glosses": [
                                            "In an attentive manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "928a5b32-809d-4201-9d44-6521d98dbffd",
                                                "sense_id": "ad43067e-dec7-33a7-8275-bcf343303507",
                                                "text": "'It's a very clean cut,' said the Rat, examining it again attentively."
                                            },
                                            {
                                                "example_id": "22cc0d96-4ec8-457f-a9b5-0a1c3bef19b8",
                                                "sense_id": "ad43067e-dec7-33a7-8275-bcf343303507",
                                                "text": "When Major saw that they had all made themselves comfortable and were waiting attentively, he cleared his throat and began"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07bfe1b4-f1cc-4a14-a6b4-4c7b69a61b2b",
                        "source_entry_id": "0465b57a-d4b3-39a9-be6f-adc9e6ed166c",
                        "source_sense_id": "3e1cb977-edb9-37a6-8968-6beb7e91b196",
                        "target_lang_word": "closely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "closely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "544e8394-bdcb-3847-bc29-3f1aae2cde1a",
                                        "entry_id": "c70e4704-5134-32d1-b499-1ffe2d6f19b7",
                                        "glosses": [
                                            "In a close manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccd53b06-2e83-4be3-9990-3b9552f2ab03",
                                                "sense_id": "544e8394-bdcb-3847-bc29-3f1aae2cde1a",
                                                "text": "Test large, cylindrical, early portion closely coiled and always completely involute, later and larger portion uncoiled[…]"
                                            },
                                            {
                                                "example_id": "edc4b529-5e4b-408b-b80e-c21e932f1fc6",
                                                "sense_id": "544e8394-bdcb-3847-bc29-3f1aae2cde1a",
                                                "text": "Finnish and Estonian are closely related languages."
                                            },
                                            {
                                                "example_id": "d8b7f569-46bd-483a-a726-74897bd49a9a",
                                                "sense_id": "544e8394-bdcb-3847-bc29-3f1aae2cde1a",
                                                "text": "The borderline between East and West Berlin was very closely guarded."
                                            },
                                            {
                                                "example_id": "70396121-2814-495e-aa37-1684e6aee1d2",
                                                "sense_id": "544e8394-bdcb-3847-bc29-3f1aae2cde1a",
                                                "text": "The chairs are too closely spaced; could you move them apart?"
                                            },
                                            {
                                                "example_id": "61312d73-ba7c-4ab5-b7cc-34f97ae6b795",
                                                "sense_id": "544e8394-bdcb-3847-bc29-3f1aae2cde1a",
                                                "text": "“King Homer” follows the story of King Kong closely, with Mr. Burns taking the freakishly over-sized King Homer from his native Africa, where he lives proud as a simian god, to the United States, where he is an initially impressive but ultimately rather limited Broadway attraction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fba577f-d454-3c71-b7b9-957d172fd65d",
                                        "entry_id": "c70e4704-5134-32d1-b499-1ffe2d6f19b7",
                                        "glosses": [
                                            "secretly; privately"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16a51ae5-4e42-41a0-a39f-bc19e75528e1",
                                                "sense_id": "1fba577f-d454-3c71-b7b9-957d172fd65d",
                                                "text": "That nought she did but wayle, and often steepe / Her dainty couch with tears which closely she did weepe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea144bb8-b6b3-42f2-b5e1-78980b5ae6ff",
                        "source_entry_id": "0465b57a-d4b3-39a9-be6f-adc9e6ed166c",
                        "source_sense_id": "3e1cb977-edb9-37a6-8968-6beb7e91b196",
                        "target_lang_word": "carefully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carefully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f203a39-4e20-3abc-862c-ed791224790b",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "Sorrowfully."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d576e34d-ceea-469a-92fe-9644ec612b52",
                                                "sense_id": "1f203a39-4e20-3abc-862c-ed791224790b",
                                                "text": "[…] there was she faine / To call them all in order to her ayde, / And them conjure, upon eternall paine, / To counsell her, so carefully dismayd, / How she might heale her sonne […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "With care; attentively, circumspectly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12f86b6-398b-4efc-8ec2-a7c8fde00a7b",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "As he was a politician, he discussed all subjects carefully, not offending anyone."
                                            },
                                            {
                                                "example_id": "44d6896b-126b-4311-8dd1-6153bab77d62",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "He carefully studied the papers, while planning his next move."
                                            },
                                            {
                                                "example_id": "e910d059-3f2c-4dd6-9a4a-871e8e7a1de1",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "He carefully avoided the subject all evening."
                                            },
                                            {
                                                "example_id": "6a2cba9f-d721-4c60-9a4e-db2d04a144f6",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "Then his sallow face brightened, for the hall had been carefully furnished, and was very clean. ¶ There was a neat hat-and-umbrella stand, and the stranger's weary feet fell soft on a good, serviceable dark-red drugget, which matched in colour the flock-paper on the walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aae99e69-97d0-3703-bec2-85db2d0e75a0",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "Conscientiously, painstakingly, fastidiously, meticulously"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
