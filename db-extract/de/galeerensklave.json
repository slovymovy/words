                "senses": [
                    {
                        "sense_id": "f8bb3edc-817b-3211-a5c2-d3a50f75d74c",
                        "entry_id": "65a27f6c-6c71-3efd-ac00-b13f2fcea80f",
                        "glosses": [
                            "Mensch, der zum Rudern auf einer Galeere gezwungen wurde, zum Beispiel durch ein Urteil oder in seiner Eigenschaft als Gefangener/Sklave"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beedb0fa-c47e-4395-8fd1-c91e6c022895",
                                "sense_id": "f8bb3edc-817b-3211-a5c2-d3a50f75d74c",
                                "text": "„Andere Alternativen waren, sie als Galeerensklaven in Frankreich, als Leibeigene, wie in den deutschen Staaten üblich, oder wie in Schweden und Dänemark als Bergarbeiter einzusetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58b71855-dc85-4314-b8e2-3b6d080bb0ff",
                        "source_entry_id": "65a27f6c-6c71-3efd-ac00-b13f2fcea80f",
                        "source_sense_id": "f8bb3edc-817b-3211-a5c2-d3a50f75d74c",
                        "target_lang_word": "galley slave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "galley slave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a17745fb-88b3-3122-b764-882e0b2de62d",
                                        "entry_id": "0ff0c9c4-6430-31ba-94e2-0bcff2cb05e2",
                                        "glosses": [
                                            "A slave who rows in a galley (type of ship)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1be3a8dd-30cb-49d3-a4f7-d79beeb740b9",
                                                "sense_id": "a17745fb-88b3-3122-b764-882e0b2de62d",
                                                "text": "\"That is a chain of galley slaves, on the way to the galleys by force of the king's orders.\" \"How by force?\" asked Don Quixote; \"is it possible that the king uses force against anyone?\" \"I do not say that,\" answered Sancho, \"but that these are people condemned for their crimes to serve by force in the king's galleys.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f55c912e-37a4-3248-a4a1-a1135d4f1206",
                                        "entry_id": "0ff0c9c4-6430-31ba-94e2-0bcff2cb05e2",
                                        "glosses": [
                                            "A typesetter (person who arranged type in a galley for printing)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e147f04b-6a23-4b75-b6a0-98c684ad260f",
                                                "sense_id": "f55c912e-37a4-3248-a4a1-a1135d4f1206",
                                                "text": "The \"galley slaves\" in those days were the genuine article, and by the \"chains that bound them\" were no doubt the original members of the union."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
