                "senses": [
                    {
                        "sense_id": "93224573-0efe-34bd-9ff9-582a698fd13f",
                        "entry_id": "806c04aa-2c2d-314e-ad5a-5b7d30404aaa",
                        "glosses": [
                            "Relatif aux Olmèques, ancien peuple mexicain de l'époque précolombienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0acf77b9-3b4f-4f79-b4dc-b53d7808c5eb",
                                "sense_id": "93224573-0efe-34bd-9ff9-582a698fd13f",
                                "text": "Le sculpteur Chavis Marmol, a décidé de se moquer du fabricant de voitures Tesla, en écrasant une Model 3 avec une tête d’inspiration olmèque de neuf tonnes."
                            },
                            {
                                "example_id": "a8df13d5-49ee-4e27-92ac-875c8aa033e1",
                                "sense_id": "93224573-0efe-34bd-9ff9-582a698fd13f",
                                "text": "Au Mexique, au 1ᵉʳ siècle, la civilisation olmèque dispose d'une écriture hiéroglyphique et pictographique mais les documents sont rares et indéchiffrables."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
