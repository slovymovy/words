                    },
                    {
                        "translation_id": "6aaba43e-3f73-4abc-8c3b-e3b4f34cb908",
                        "source_entry_id": "b57fe7c7-a187-3e67-8406-9a56756d9c27",
                        "source_sense_id": "1ec4dda5-b4ab-3635-bfb3-02627ac519ce",
