                "senses": [
                    {
                        "sense_id": "62ac4f20-cb28-3c11-a610-5142b56c6b2d",
                        "entry_id": "d4610687-7b8b-36ff-9b63-9a54e2c9a6aa",
                        "glosses": [
                            "Betrieb, der Tierhäute zu Leder verarbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c34792c-09b1-4350-bc6f-273548ca3832",
                                "sense_id": "62ac4f20-cb28-3c11-a610-5142b56c6b2d",
                                "text": "Mein Nachbar hat früher in einer Gerberei gearbeitet."
                            },
                            {
                                "example_id": "e4c3ad20-5978-4a53-ac49-4aa49a9e5822",
                                "sense_id": "62ac4f20-cb28-3c11-a610-5142b56c6b2d",
                                "text": "„…, während die Gerberei vor der Stadt am Donauarm und an dem Wienfluss betrieben wurde.“"
                            },
                            {
                                "example_id": "76c09b61-dc3a-4f03-a400-321a0c74b87f",
                                "sense_id": "62ac4f20-cb28-3c11-a610-5142b56c6b2d",
                                "text": "„In dem Mittelgebirge boomten einst im 19. Jahrhundert Gerbereien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12b74961-58e2-4db4-af6a-add092e0b92b",
                        "source_entry_id": "d4610687-7b8b-36ff-9b63-9a54e2c9a6aa",
                        "source_sense_id": "62ac4f20-cb28-3c11-a610-5142b56c6b2d",
                        "source_sense_description": "Betrieb, der Tierhäute zu Leder verarbeitet",
                        "target_lang_word": "tannery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tannery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c23d819c-2a22-3e9d-a328-4bff5a5dbce8",
                                        "entry_id": "2784139c-ff07-37d3-9625-55a21c68d13a",
                                        "glosses": [
                                            "A place where people tan hides to make leather."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71fa32f0-6eb9-440c-9c9d-8a3b92dec580",
                                                "sense_id": "c23d819c-2a22-3e9d-a328-4bff5a5dbce8",
                                                "text": "The River Avon divides the village in two, and at its centre is a tannery, built in 1918 and still in use, with its frontage on the river bank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d10a262-3967-336c-a068-66f4b6f429a8",
                                        "entry_id": "2784139c-ff07-37d3-9625-55a21c68d13a",
                                        "glosses": [
                                            "The business of a tanner."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff1fc63d-6315-4245-a513-e62b6abb2988",
                        "source_entry_id": "d4610687-7b8b-36ff-9b63-9a54e2c9a6aa",
                        "source_sense_id": "62ac4f20-cb28-3c11-a610-5142b56c6b2d",
                        "source_sense_description": "Betrieb, der Tierhäute zu Leder verarbeitet",
                        "target_lang_word": "tannerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tannerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bfa30c1-4940-3332-b794-4649485f2838",
                                        "entry_id": "61c631b3-17c9-39be-9f35-63347429d441",
                                        "glosses": [
                                            "Endroit où l’on tanne les peaux principalement de bovins ou d’équidés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db645ff0-cb27-4dc1-b8e9-d60325f0b1cd",
                                                "sense_id": "2bfa30c1-4940-3332-b794-4649485f2838",
                                                "text": "Établir une tannerie."
                                            },
                                            {
                                                "example_id": "f378afa4-d05e-443a-b5b3-bd8c73198296",
                                                "sense_id": "2bfa30c1-4940-3332-b794-4649485f2838",
                                                "text": "Il y avait jadis plusieurs tanneries dans ce faubourg."
                                            },
                                            {
                                                "example_id": "a1fa2023-2a0a-4b48-926a-cae3b0492614",
                                                "sense_id": "2bfa30c1-4940-3332-b794-4649485f2838",
                                                "text": "À la vérité, Plassans est loin d’être un centre de commerce ; on y trafique juste assez pour se débarrasser des productions du pays, les huiles, les vins, les amandes. Quant à l’industrie, elle n’y est guère représentée que par trois ou quatre tanneries qui empestent une des rues du vieux quartier, des manufactures de chapeaux de feutre et une fabrique de savon reléguée dans un coin du faubourg."
                                            },
                                            {
                                                "example_id": "788fa56f-ee4f-4244-835d-2c4d49daf7b7",
                                                "sense_id": "2bfa30c1-4940-3332-b794-4649485f2838",
                                                "text": "Au fond du Breuil est la tannerie avec ses pains de tourbe, ses peaux qui sèchent, son odeur aigre.\nJe l’adore, cette odeur montante, moutardeuse, verte — si l’on peut dire verte, — comme les cuirs qui faisandent dans l’humidité ou qui font sécher leur sueur au soleil.\nDu plus loin que j’arrivais dans la ville du Puy, quand j’y revins plus tard, je devinais et je sentais la tannerie du Breuil. — Chaque fois qu’une de ces fabriques s’est trouvée sur mon chemin, à deux lieues à la ronde, je l’ai flairée, et j’ai tourné de ce côté mon nez reconnaissant…"
                                            },
                                            {
                                                "example_id": "ca016ecc-3c6b-479b-8e34-d607cbd0773f",
                                                "sense_id": "2bfa30c1-4940-3332-b794-4649485f2838",
                                                "text": "Après avoir longuement sondé le marché potentiel de cette activité qui avait disparu en France, elle est allée se former en Finlande ou la tannerie de peaux de poissons est une tradition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "921a2dbe-2831-49c8-a830-d2c97cb980d0",
                        "source_entry_id": "d4610687-7b8b-36ff-9b63-9a54e2c9a6aa",
                        "source_sense_id": "62ac4f20-cb28-3c11-a610-5142b56c6b2d",
                        "source_sense_description": "Betrieb, der Tierhäute zu Leder verarbeitet",
                        "target_lang_word": "mégisserie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mégisserie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef07a9bf-09d3-306c-b8b3-b7220136b7a0",
                                        "entry_id": "7988d96a-9145-3860-b1b1-1febc680f3ab",
                                        "glosses": [
                                            "Métier et commerce des peaux principalement d’ovins et de caprins à l’exclusion des grosses peaux de bovins."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1441dc0f-cf5b-47a0-abd4-0c4802991372",
                                                "sense_id": "ef07a9bf-09d3-306c-b8b3-b7220136b7a0",
                                                "text": "Il est un bourg de station pour les voyageurs qui viennent de Calais ou qui s’y rendent. La seule branche de commerce qui s’y fasse est la tannerie et la mégisserie : le surplus des habitants travaille pour les passants et pour les communes environnantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe174bdd-2b2d-3fe5-9bc5-e8e512d0ffac",
                                        "entry_id": "7988d96a-9145-3860-b1b1-1febc680f3ab",
                                        "glosses": [
                                            "Lieu où se pratiquait le commerce et la vente de peaux d’ovins et de caprins."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "472f5fcc-014c-4f4e-a338-176dd3993eec",
                                                "sense_id": "fe174bdd-2b2d-3fe5-9bc5-e8e512d0ffac",
                                                "text": "Le département possède 20 tanneries occupant une centaine d’ouvriers, et 5 chamoiseries ou mégisseries (45 ouvriers)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
