                                "sense_id": "1317c4de-caa0-38da-aa70-87bc1db01d62",
                                "text": "der Feind ist in der Überzahl",
                                "translation": "the enemy is in the majority (the enemy outnumbers us)",
                                "english": "the enemy is in the majority (the enemy outnumbers us)"
                            },
                            {
                                "example_id": "496e12f0-87e2-44a6-aa08-bf027138cd00",
                                "sense_id": "1317c4de-caa0-38da-aa70-87bc1db01d62",
                                "text": "Wir haben gewonnen, weil wir in der zweiten Halbzeit in der Überzahl waren.",
                                "translation": "We won because we were in the majority in the second half.",
                                "english": "We won because we were in the majority in the second half."
                            }
                        ]
