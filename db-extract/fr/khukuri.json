                        "glosses": [
                            "Long couteau en usage au Népal."
                        ],
                        "tags": [
                            "Coutellerie"
                        ],
                        "examples": [
                            {
                                "example_id": "31a9b441-5c32-40d7-9e80-e5f0a727477c",
                                "sense_id": "1a74ece0-0b99-3ccb-a3db-a52c3760510c",
                                "text": "Le khukuri est le couteau national du Népal. C’est l’arme symbolique du soldat népalais, le Gurkha."
                            },
                            {
                                "example_id": "45401c33-3e2e-4112-ad94-c8c0983eced3",
                                "sense_id": "1a74ece0-0b99-3ccb-a3db-a52c3760510c",
                                "text": "Ils ont un couteau, le khukuri, qui est si long et si vicieusement affûté que leurs victimes ont le temps de voir le sang jaillir de leur cou avant de mourir."
                            }
                        ]
                    }
