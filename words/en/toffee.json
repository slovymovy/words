{
    "word_family": [
        "toffee"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1aa3ab27-d433-367b-81ea-776989fb5b04",
                    "sense_definition": "A hard candy made by boiling sugar with butter or milk.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "confectionery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baker made a batch of rich <w>toffee</w> for the holiday season.",
                            "target_lang_translations": {
                                "ru": "Пекарь приготовил партию насыщенного <w>ириса</w> к праздничному сезону."
                            }
                        },
                        {
                            "text": "She loves the taste of buttery <w>toffee</w> on her ice cream.",
                            "target_lang_translations": {
                                "ru": "Она обожает вкус сливочного <w>ириса</w> с мороженым."
                            }
                        }
                    ],
                    "common_phrases": [
                        "buttery toffee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твёрдая конфета, приготовленная путём уваривания сахара с маслом или молоком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ири́с",
                                "target_lang_sense_clarification": "сорт конфет, приготовляемых из молока, сахара и патоки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "169819ad-4739-3650-b920-5f1e347a511b",
                    "sense_definition": "A single small piece of toffee candy.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "confectionery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He unwrapped a small <w>toffee</w> and popped it into his mouth.",
                            "target_lang_translations": {
                                "ru": "Он развернул маленькую <w>ириску</w> и положил её в рот."
                            }
                        },
                        {
                            "text": "The children were each given a single <w>toffee</w> as a treat.",
                            "target_lang_translations": {
                                "ru": "Детям дали по одной <w>ириске</w> в качестве угощения."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная небольшая конфета из ириса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ири́ска",
                                "target_lang_sense_clarification": "разговорное название одной конфеты сорта ирис"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f482eede-ec61-3a04-8d07-a808c8f8669a",
                    "sense_definition": "General term for various types of sweets or candy.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "confectionery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop sells a wide variety of <w>toffee</w> and other sugary snacks.",
                            "target_lang_translations": {
                                "ru": "В магазине продаётся широкий ассортимент <w>ириса</w> и других сладких закусок."
                            }
                        },
                        {
                            "text": "He grew up calling all kinds of candy <w>toffee</w>.",
                            "target_lang_translations": {
                                "ru": "Он вырос, называя все виды <w>конфет</w> ирисом."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее название для различных видов сладостей или конфет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сла́дости",
                                "target_lang_sense_clarification": "общее название кондитерских изделий"
                            },
                            {
                                "target_lang_word": "конфе́ты",
                                "target_lang_sense_clarification": "общее название сахаристых кондитерских изделий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d2d266eb-ceaa-3a03-baca-2ea22b1cefb2",
                    "sense_definition": "A supporter or member of the Everton Football Club.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports_fan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every loyal <w>Toffee</w> cheered loudly when the team scored a goal.",
                            "target_lang_translations": {
                                "ru": "Каждый преданный <w>болельщик «Эвертона»</w> громко ликовал, когда команда забила гол."
                            }
                        },
                        {
                            "text": "The local pub was filled with <w>Toffees</w> watching the match on television.",
                            "target_lang_translations": {
                                "ru": "Местный паб был полон <w>болельщиков «Эвертона»</w>, смотревших матч по телевизору."
                            }
                        }
                    ],
                    "synonyms": [
                        "Toffeeman"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in Liverpool, England."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Болельщик или член футбольного клуба «Эвертон»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боле́льщик «Э́вертона»",
                                "target_lang_sense_clarification": "фанат футбольного клуба «Эвертон»"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c9bc596f-c68e-34a0-ae61-dfd81c02b680",
                    "sense_definition": "To cover or coat something with toffee.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef decided to <w>toffee</w> the apples for the dessert display.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар решил <w>покрыть яблоки ирисом</w> для десертной витрины."
                            }
                        },
                        {
                            "text": "They spent the afternoon <w>toffeeing</w> fresh fruit for the party.",
                            "target_lang_translations": {
                                "ru": "Они провели день, <w>покрывая ирисом</w> свежие фрукты для вечеринки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
