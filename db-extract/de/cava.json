                "senses": [
                    {
                        "sense_id": "2ba63ccd-3156-3250-85a4-b658d1a7484e",
                        "entry_id": "ecf5c00c-5a48-3ce1-835d-c07453eb5e25",
                        "glosses": [
                            "katalanischer Sekt, der im traditionellen Flaschengärungsverfahren hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f775917-e49c-4a96-bab4-b5f305896eb6",
                                "sense_id": "2ba63ccd-3156-3250-85a4-b658d1a7484e",
                                "text": "„Cava, ein hervorragender Wein aus Spanien, hergestellt nach dem traditionellen Flaschengärungsverfahren, bei dem sich auf natürliche Weise eine feine Perlage entwickelt.“ Dieser Cava „reift mindestens 9 Monate auf der Flasche. Codorníu hat sich seit 1551 mit Passion der Weinbereitung verschrieben und stellte 1872 den ersten Cava in Spanien her.“"
                            },
                            {
                                "example_id": "58ce7ec8-974e-43db-b678-74e233945742",
                                "sense_id": "2ba63ccd-3156-3250-85a4-b658d1a7484e",
                                "text": "„Dieser Cava ist das Ergebnis sorgfältigen Kelterns. In ihm vereinen sich die drei Rebsorten der Weinregion Penedés: Xarel·lo, Parellada & Macabeo.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
