                    },
                    {
                        "sense_id": "a257bbe0-9779-35ed-9f9e-13fe65b33748",
                        "entry_id": "c5c46735-898b-3c2f-88ef-5b6714eae957",
                        "glosses": [
                            "Salir avec du caca."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
