                        "cross_references": [
                            {
                                "target_word": "vorangehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff533a27-4ba8-3b58-b355-98c9994518ed",
                                        "entry_id": "d508e7b0-f5b7-3bc1-9f0e-bc1e06b00a1c",
                                        "glosses": [
                                            "als erster (alleine oder die anderen anführend) unterwegs sein"
                                        ],
                                        "tags": [
                                            "räumlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfffd514-bb5b-42a7-a0c6-0c717ecde840",
                                                "sense_id": "ff533a27-4ba8-3b58-b355-98c9994518ed",
                                                "text": "Unser Pilzguide ging immer voran, und wir folgten langsam nach."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5511057a-c3be-3134-8df6-d6f7bfc3398d",
                                        "entry_id": "d508e7b0-f5b7-3bc1-9f0e-bc1e06b00a1c",
                                        "glosses": [
                                            "als erstes (vorher) geschehen, vor einem Ereignis stattfinden"
                                        ],
                                        "tags": [
                                            "impersonal",
                                            "temporal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "355932f1-c9b1-415d-861b-c201a2bb877b",
                                                "sense_id": "5511057a-c3be-3134-8df6-d6f7bfc3398d",
                                                "text": "Dem Entschluss sollte eine gründliche Untersuchung vorangegangen sein."
                                            },
                                            {
                                                "example_id": "16c558f6-a77d-465b-97ed-52a0eeb19196",
                                                "sense_id": "5511057a-c3be-3134-8df6-d6f7bfc3398d",
                                                "text": "In solchen Fällen hat immer eine Aufklärung im persönlichen Gespräch voranzugehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bd6284bf-bc73-308c-ad52-c6e034c91e02",
                                        "entry_id": "d508e7b0-f5b7-3bc1-9f0e-bc1e06b00a1c",
                                        "glosses": [
                                            "einen begonnenen Prozess weiterführen"
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aefe7100-131a-4816-b68e-4393d62d2720",
                                                "sense_id": "bd6284bf-bc73-308c-ad52-c6e034c91e02",
                                                "text": "Wann geht es denn hier mal weiter voran?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbbe902e-19e0-435e-807a-eb2e3040e5ed",
                        "source_entry_id": "c95ad8f0-ddd8-37d6-97e7-4499f81bc1c6",
                        "source_sense_id": "5ac90ebe-3424-3ec6-b50c-63fd4a375242",
                        "source_sense_description": "(zeitlich) vorhergehen",
                        "target_lang_word": "vorhergehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorhergehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6bef52e6-8706-30e7-bae2-749fea133dbc",
                                        "entry_id": "75803b1a-cd98-3cb4-b9a8-99a99b4aff4d",
                                        "glosses": [
                                            "sich vorher ereignen, sich davor befinden"
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfc0c4f6-44e9-4599-8d56-dbde6896f5be",
                                                "sense_id": "6bef52e6-8706-30e7-bae2-749fea133dbc",
                                                "text": "„Der Roman ist mit neunhundert Seiten so lang wie die beiden vorhergegangenen Bücher zusammen.“"
                                            },
                                            {
                                                "example_id": "3bc7d22b-917c-4582-a9d1-8215d77ecb9b",
                                                "sense_id": "6bef52e6-8706-30e7-bae2-749fea133dbc",
                                                "text": "„‚[…] Auch glaubt sie, daß die Vögel sich genau organisiert haben und von dem Führer über das, was sie zu tun haben, verständigt werden; bestimmte Schreie, denen eine lange Pause vorhergeht, sind, meint sie, Befehle, die von allen befolgt werden.‘“"
                                            },
                                            {
                                                "example_id": "0e79c58a-909b-48ea-b71a-71cf9374969a",
                                                "sense_id": "6bef52e6-8706-30e7-bae2-749fea133dbc",
                                                "text": "„Erdstöße, die dem eigentlichen Beben vorhergehen, mißt auch ein Warnsystem, das Einzelpersonen warnt und Häuser vor Folgeschäden schützen soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
