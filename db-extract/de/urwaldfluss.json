                "senses": [
                    {
                        "sense_id": "32dd3299-4e5b-30c0-9e40-71150e2316f2",
                        "entry_id": "a346b49f-7fe9-3410-80d3-4521fea2b8d5",
                        "glosses": [
                            "Fluss, der durch einen Urwald fließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ac66a2c-9f97-4eb3-b6a3-22e7f96f7564",
                                "sense_id": "32dd3299-4e5b-30c0-9e40-71150e2316f2",
                                "text": "„Dies war sonderbar, denn die verstreuten eiförmigen Sphäroide fanden sich meist in Urwaldflüssen, wie man sie hier auf diesem baumlosen Hochland nicht antraf.“"
                            },
                            {
                                "example_id": "87137256-5af9-4039-8ebc-a40d8dff0ec0",
                                "sense_id": "32dd3299-4e5b-30c0-9e40-71150e2316f2",
                                "text": "„Paritosh Shah kam un neun, setzte sich aufs Bett und schaute mir zu, wie ein anderer Held und seine Männer, bis zur Brust im Wasser, in einem Urwaldfluss vorwärts wateten, die Gesichter geschwärzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
