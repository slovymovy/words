    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b4194e92-b1cf-38dd-86da-fc24e3340311",
                    "sense_definition": "The act, ability, or subject of forming words with the correct letters.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "writing_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>spelling</w> has improved significantly since she started reading more books.",
                            "target_lang_translations": {
                                "ru": "Её <w>правописание</w> значительно улучшилось с тех пор, как она начала читать больше книг.",
                                "zh": "自从她开始读更多的书，她的<w>拼写</w>水平有了显著提高。"
                            }
                        },
                        {
                            "text": "You should use a dictionary to check your <w>spelling</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе следует использовать словарь, чтобы проверить <w>правописание</w>.",
                                "zh": "你应该用字典检查一下你的<w>拼写</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "orthography"
                    ],
                    "common_phrases": [
                        "correct spelling",
                        "spelling mistake",
                        "bad spelling",
                        "spelling checker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Навык, способность или предмет, связанные с правильным написанием слов.",
                        "zh": "指正确书写单词的技能、能力或学科。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правописание",
                                "target_lang_sense_clarification": "система правил"
                            },
                            {
                                "target_lang_word": "орфография",
                                "target_lang_sense_clarification": "научная дисциплина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拼写",
                                "target_lang_sense_clarification": "书写单词的技能"
                            },
                            {
                                "target_lang_word": "正字法",
                                "target_lang_sense_clarification": "关于正确拼写的规则"
                            }
                        ]
