                "senses": [
                    {
                        "sense_id": "8c26017a-5dc3-38a1-b841-8c4c98a08e1b",
                        "entry_id": "8aa7d886-52dc-3ebf-975d-5ad6b8d8c243",
                        "glosses": [
                            "промежуток времени, равный половине века; пятьдесять лет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1346603d-db1e-43ab-a6f8-3c791115b626",
                                "sense_id": "8c26017a-5dc3-38a1-b841-8c4c98a08e1b",
                                "text": "Для среднестатистического человека простое выполнение борцовского моста уже является сложным, но Гакеншмидт был настолько силён, что смог выполнить его с весом в 141 кг, поставив тем самым мировой рекорд, продержавшийся полвека."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ed38dc4-9581-48a2-969d-37d057f9f505",
                        "source_entry_id": "8aa7d886-52dc-3ebf-975d-5ad6b8d8c243",
                        "source_sense_id": "8c26017a-5dc3-38a1-b841-8c4c98a08e1b",
                        "target_lang_word": "half a century",
