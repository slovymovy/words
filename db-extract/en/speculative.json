                                                "example_id": "8dedced5-52dc-4ff4-9fde-3c391b6c0663",
                                                "sense_id": "7780cae2-5eb8-334b-be5d-0d305449b9ec",
                                                "text": "Les hommes d’action et les spéculatifs."
                                            }
