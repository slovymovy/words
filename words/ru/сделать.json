            "senses": [
                {
                    "sense_id": "cf1d5ddc-70a2-3b3d-9e8a-97fc9e78d96f",
                    "sense_definition": "Совершить какое-либо действие, выполнить работу или поступить определённым образом.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты должен <сделать> это домашнее задание сегодня вечером.",
                            "target_lang_translations": {
                                "en": "You must <do> this homework tonight.",
                                "cs": "Dnes večer musíš <udělat> tento domácí úkol."
                            }
                        },
                        {
                            "text": "Мы <сделали> всё возможное, чтобы помочь ему в этой ситуации.",
                            "target_lang_translations": {
                                "en": "We <did> everything possible to help him in this situation.",
                                "cs": "Udělali jsme vše, co bylo v našich silách, abychom mu v této situaci pomohli."
                            }
                        }
                    ],
                    "synonyms": [
