        "fr-extract.jsonl": [
            {
                "entry_id": "669f5b74-1314-3bcc-9811-b99eef3c6afc",
                "word": "lapis-lazuli",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "75070b04-6d8f-357d-8b7e-05a4396ee23e",
                        "entry_id": "669f5b74-1314-3bcc-9811-b99eef3c6afc",
                        "glosses": [
                            "De la couleur bleu azur profond de la pierre du même nom. #26619C"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3667576f-5a94-4d3c-91ca-f6710e89e9eb",
                                "sense_id": "75070b04-6d8f-357d-8b7e-05a4396ee23e",
                                "text": "D’un ample mouvement du bras, il désigna l’interminable plage de sable fin et l’Océan dont la surface lapis-lazuli se confondait à l’horizon avec l’azur du ciel."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "54f4262d-0574-36f0-8f0d-516c0c788b93",
                "word": "lapis-lazuli",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "96ac8fa3-c2c2-3086-8868-c6bd04a61a49",
                        "entry_id": "54f4262d-0574-36f0-8f0d-516c0c788b93",
                        "glosses": [
                            "Roche métamorphique, contenant des silicates du groupe des feldspathoïdes, utilisée comme pierre ornementale ou pour la confection de bijoux, qui est dure et raye le verre, opaque, de couleur bleue, entre l’azur et l’outremer et ordinairement parsemée de petites veines de pyrite semblables à de l’or."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cefac0a3-dc14-4342-993c-e8689972b630",
                                "sense_id": "96ac8fa3-c2c2-3086-8868-c6bd04a61a49",
                                "text": "Sur sa tête, une coiffe aux larges plis retombant sur les épaules, le némès, est d’or incrusté de lapis-lazuli."
                            },
                            {
                                "example_id": "3cddad17-6e36-4b4e-a388-6860ef87b236",
                                "sense_id": "96ac8fa3-c2c2-3086-8868-c6bd04a61a49",
                                "text": "[…] ; le médaillon de lapis-lazuli, attaché par une chaînette d’or à son poignet, de temps à autre sonnait contre son assiette."
                            },
                            {
                                "example_id": "61e7ecf2-2565-4be9-9a23-c62a45f13967",
                                "sense_id": "96ac8fa3-c2c2-3086-8868-c6bd04a61a49",
                                "text": "Le lac, maintenant, semblait en lapis-lazuli."
                            },
                            {
                                "example_id": "2567dc53-e93e-4c8c-9253-4b4e5f5a73bd",
                                "sense_id": "96ac8fa3-c2c2-3086-8868-c6bd04a61a49",
                                "text": "Seul son regard de lapis-lazuli (j’ai eu un bijoutier dans mes relations) anime sa figure émouvante."
                            },
                            {
                                "example_id": "af4bd48f-0436-4bf9-ad58-b4f31dd713c2",
                                "sense_id": "96ac8fa3-c2c2-3086-8868-c6bd04a61a49",
                                "text": "L’outremer naturel, qu’on obtient à partir du lapis-lazuli, et la laque, dont les qualités les plus recherchées proviennent de la cochenille ou du kermès, étaient en effet les pigments les plus précieux de la palette des peintres de l’époque, en raison de leur intensité et des effets qu’ils permettaient d’obtenir, notamment dans les glacis."
                            },
                            {
                                "example_id": "9c65debd-0a69-4380-a9a0-e805587ca038",
                                "sense_id": "96ac8fa3-c2c2-3086-8868-c6bd04a61a49",
                                "text": "Quant au bleu à droite de la tête du Christ (10460), les analyses MEB/EDS révèlent de fortes proportions de sodium, aluminium, silicium et soufre qui sont quatre éléments composant la lazurite (Na₈₋₁₀Al₆O₂₄S₂₋₈), un des constituants du lapis-lazuli (Plesters, 1966)."
                            }
                        ]
                    }
                ],
