                ],
                "senses": [
                    {
                        "sense_id": "47cce5e6-7538-3943-af50-155013ef5de7",
                        "entry_id": "a29c2718-7207-3172-b8da-5ce169f2fb9c",
                        "glosses": [
                            "Gefühl des Glücks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c1115a4-a116-4f48-845a-5d9145bdd9e7",
                                "sense_id": "47cce5e6-7538-3943-af50-155013ef5de7",
                                "text": "„Je nach Umgebung und Stimmungslage des Konsumenten kann Haschisch ganz unterschiedliche Rauschzustände hervorrufen: Glücksgefühle oder Niedergeschlagenheit, Entspanntheit, Gereiztheit, Unruhe.“"
                            },
                            {
                                "example_id": "cecd8444-98a4-4b2e-849c-a8c4d5124cfa",
                                "sense_id": "47cce5e6-7538-3943-af50-155013ef5de7",
                                "text": "„Macomber war von einem wilden ungestümen Glücksgefühl erfüllt, das er nie zuvor gekannt hatte.“"
                            },
                            {
                                "example_id": "c12e07d9-4792-4adb-8ca0-542425396f42",
                                "sense_id": "47cce5e6-7538-3943-af50-155013ef5de7",
                                "text": "„Allerdings traute sich Eigil nicht zu sagen, dass er tief in seinem Inneren ein Glücksgefühl fürchtete.“"
                            },
                            {
                                "example_id": "fa6f9c2c-5033-4108-91df-b47ac79f3604",
                                "sense_id": "47cce5e6-7538-3943-af50-155013ef5de7",
                                "text": "„Ein Glücksgefühl verspürt der Troll nun, er hat alle Utensilien, er wird seine Frau glücklich stimmen.“"
                            },
                            {
                                "example_id": "4f2fa095-d053-4965-9a43-14528b8728a2",
                                "sense_id": "47cce5e6-7538-3943-af50-155013ef5de7",
                                "text": "„Diese Befindlichkeit ist von Glücksgefühlen begleitet. Kletterer ‚tanzen’ in dieser Gefühlslage in der Wand, Gleitschirmpiloten in der Luft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
