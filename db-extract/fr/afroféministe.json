                        "glosses": [
                            "Celle, celui, qui est activiste de l’afroféminisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb6f5a17-b092-4e71-a627-b9388e33b6ee",
                                "sense_id": "c5690cc6-0698-3acd-9923-3fbb6ba2ade8",
                                "text": "Est-ce pour cela qu’Anaconda, le dernier clip de Nicki Minaj, dans lequel elle joue allègrement de son postérieur, a fait l’unanimité chez les afroféministes ?"
                            },
                            {
                                "example_id": "aed62395-23f0-4911-92ff-6415be3fdf9e",
                                "sense_id": "c5690cc6-0698-3acd-9923-3fbb6ba2ade8",
                                "text": "Et tous deux sont portés par des femmes qui incarnent une nouvelle génération d’afroféministes, bien décidées à parler par et pour elles."
                            }
                        ]
                    }
