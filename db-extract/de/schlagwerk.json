                "senses": [
                    {
                        "sense_id": "7d93f508-4be2-329e-93d2-1b449d09e93c",
                        "entry_id": "95ed4c01-1232-36d9-a8a2-c1e7ebb5cd59",
                        "glosses": [
                            "im Orchester: Das Schlagzeug, die Gesamtheit aller Schlaginstrumente"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f039694a-0ba1-406a-b686-4e9f508cb4d1",
                                "sense_id": "7d93f508-4be2-329e-93d2-1b449d09e93c",
                                "text": "Annas Freund spielt das Schlagwerk im Orchester."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7cdac326-c91e-31d6-bda4-f577b3f056dc",
                        "entry_id": "95ed4c01-1232-36d9-a8a2-c1e7ebb5cd59",
                        "glosses": [
                            "mechanisch: Mechanismus in einer Räderuhr, durch den der Uhrschlag zusätzlich zur optischen Anzeige mitgeteilt wird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b76a635c-bac5-45f4-bf7f-0fe7c8522208",
                                "sense_id": "7cdac326-c91e-31d6-bda4-f577b3f056dc",
                                "text": "Das Schlagwerk schlägt die vollen Stunden in der Uhr."
                            },
                            {
                                "example_id": "1cc907a9-775a-45fb-9131-a50f619ec050",
                                "sense_id": "7cdac326-c91e-31d6-bda4-f577b3f056dc",
                                "text": "„Silberhell kündigte ein eingebautes Schlagwerk die Zeit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "32c7988b-18a4-3d03-8a56-98acc235f7a2",
                        "entry_id": "95ed4c01-1232-36d9-a8a2-c1e7ebb5cd59",
                        "glosses": [
                            "für Werkzeuge: aktives Bestandteil eines schlagenden Elektrowerkzeugs (z. B. Meißelhammer, Bohrhammer)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a47a8d3a-75ec-4460-9241-db7875a3019f",
                                "sense_id": "32c7988b-18a4-3d03-8a56-98acc235f7a2",
                                "text": "Das Schlagwerk wandelt die vom Trägergerät (Bagger) über Hochdruckschläuche in Form von Hydrauliköldruck und -fluss geleistete Arbeit in kinetische Energie um und überträgt diese auf den Meißel."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
