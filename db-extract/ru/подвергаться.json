                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd8dd35f-ec81-334c-a3b6-33a7a9b0f938",
                        "entry_id": "4d054a8a-957a-3f09-883b-db284d5d9af7",
                        "glosses": [
                            "становиться объектом какого-либо действия или воздействия, испытывать на себе действие чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08ed6f31-ba26-4980-b2ed-8c941df88eab",
                                "sense_id": "fd8dd35f-ec81-334c-a3b6-33a7a9b0f938",
                                "text": "В России он подвергался гонениям, находился в заключении и был причислен к лику преподобных только после своей смерти."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea35c613-6580-3d91-b9fe-4e8b2dea12c8",
                        "entry_id": "4d054a8a-957a-3f09-883b-db284d5d9af7",
                        "glosses": [
                            "попадать в сферу действия чего-либо, как правило, нежелательного, неприятного"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bdcc0ff-890e-42f5-b715-0edccf5e8302",
                                "sense_id": "ea35c613-6580-3d91-b9fe-4e8b2dea12c8",
                                "text": "Пока эти бомбы не обезврежены, жители Косово и войска альянса подвергаются опасности."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cef76f1c-0caa-4a54-8bf3-8b15c1a53848",
                        "source_entry_id": "4d054a8a-957a-3f09-883b-db284d5d9af7",
                        "source_sense_description": "становиться объектом какого-либо действия",
                        "target_lang_word": "subir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                        "entry_id": "cd32648f-a21c-37b0-9afa-b755ec18e234",
                                        "glosses": [
                                            "Souffrir, supporter ou être soumis à quelque chose de pénible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b3fbb86-4bb6-4939-a8c4-f79dc0503633",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Cette torture par laquelle vous venez de passer, vous me l'avez fait subir, il y a une heure à peine : il était juste que vous fissiez connaissance avec elle."
                                            },
                                            {
                                                "example_id": "221430c3-3f8b-42b5-b1ed-a91bca4b428e",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "J'ai fait subir à ma famille une épreuve qu'elle commence tout juste à accepter."
                                            },
                                            {
                                                "example_id": "b55683b8-4231-44c7-ac09-2b6aa999d64f",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "La masse croit qu’elle souffre parce qu’elle subit une inique conséquence d’un passé qui était plein de violences, d’ignorance et de méchanceté."
                                            },
                                            {
                                                "example_id": "82622e2c-454f-4e7c-9b62-16c224341d36",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Rivaux comme tous bons chasseurs, c’était à qui raserait à l’autre le lièvre indiqué, et le roulé subissait naturellement les quolibets du vainqueur."
                                            },
                                            {
                                                "example_id": "652bab98-ce14-409f-9b1e-5e81907d0ac7",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Sa nuit de noce n’avait pas été pour elle une nuit d'amour. Elle avait subi son époux sans ardeur et sans répugnance."
                                            },
                                            {
                                                "example_id": "ec1531e8-7afc-4fbf-a64b-a2ce0e0681a4",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Les étudiants savent qu'ils risquent de devoir y subir un bizutage, mais en vertu de la loi du silence qui les accompagne, ils ne savent rien des brimades qu'ils auront à subir."
                                            },
                                            {
                                                "example_id": "16486778-4cb9-45fc-b398-6b6b45a6f1ea",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Mais la plupart subissent des métamorphoses qui définissent les insectes hétéromorphes ; elles sont progressives dans le type hétérométabole, et se font par étapes dans le type holométabole qui est le plus fréquent et le plus important."
                                            },
                                            {
                                                "example_id": "43e7ee9e-02ec-4a11-91f3-ad40a9086300",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Si Hostrup faisait marche arrière aujourd'hui, toutes les mésaventures qu'il avait subies pour faire plier Mørk n'auraient plus aucun sens et rimeraient tout au plus avec fiasco. Hostrup ne pouvait plus faire marche arrière."
                                            },
                                            {
                                                "example_id": "8e7d2270-a159-4fd3-bde3-24d0240026f8",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Subir un examen, être examiné au sujet de certaines aptitudes, être interrogé sur certaines matières pour obtenir un grade ou un emploi."
                                            },
                                            {
                                                "example_id": "b0dce064-e5d6-4fd8-ab2c-f742ccc31f1e",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Subir un interrogatoire, comparaître devant le juge et répondre à ses interrogations."
                                            },
                                            {
                                                "example_id": "0837a38e-ed33-4652-9b83-b8e8d3f4f427",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Subir une influence, se prêter plus ou moins volontairement à l'influence d'autrui."
                                            },
                                            {
                                                "example_id": "215e1c8c-edcd-4e1b-bacd-d8db5f1bf7e9",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Subir des changements, subir des modifications, subir une réforme, etc., se dit des choses qui viennent à être changées, modifiées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
