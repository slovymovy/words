                "senses": [
                    {
                        "sense_id": "344d1c00-ee26-3839-8830-ca0e11ab62fe",
                        "entry_id": "f70276f7-2f5a-3b83-873c-47c0cccb28cd",
                        "glosses": [
                            "Person mit viel Erfahrung beim Klettern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ff1f13a-cc3b-44ef-b081-c6975731338f",
                                "sense_id": "344d1c00-ee26-3839-8830-ca0e11ab62fe",
                                "text": "„Der Berg zieht Profikletterer genauso an wie Hobbyalpinisten, er ist zum Mekka von Sinnsuchern geworden.“"
                            },
                            {
                                "example_id": "df2ac58b-2ade-4101-a1af-b05b93fe360b",
                                "sense_id": "344d1c00-ee26-3839-8830-ca0e11ab62fe",
                                "text": "„Nördlich des Amazonasgebiets schlagen sich drei Profikletterer 14 Tage lang durch den Urwald, um die 600 Meter hohe, extrem steile Felswand des Roraima zu erreichen.“"
                            },
                            {
                                "example_id": "1042ef00-d02d-45ad-a9e5-fd5890befcf6",
                                "sense_id": "344d1c00-ee26-3839-8830-ca0e11ab62fe",
                                "text": "„Seit mehr als drei Wochen werkeln Holger Blume und seine Profikletterer in luftiger Höhe an der Sperrmauer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
