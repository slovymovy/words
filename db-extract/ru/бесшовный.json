                    {
                        "translation_id": "692f7089-019d-42e8-b90a-b7a961864e06",
                        "source_entry_id": "80d4d78d-d359-3231-95d1-655ebd78a94d",
                        "source_sense_id": "64fb9977-c4dd-3235-bfb9-c568246e990d",
                        "target_lang_word": "fugenlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fugenlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8aa4730e-2100-342c-b8b1-5c87cf4c02c1",
                                        "entry_id": "0d18aaea-6892-3c64-b7dd-e55ddbc38ce6",
                                        "glosses": [
                                            "ohne sichtbare Fuge; keine Fuge aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad8aee23-d64b-4c40-9b9e-bf51c9fd6c57",
                                                "sense_id": "8aa4730e-2100-342c-b8b1-5c87cf4c02c1",
                                                "text": "„24 Millionen Leuchtdioden versammelt der Bildschirm-Gigant auf einer Fläche von über 50 Quadratmetern, fugenlos zusammengesetzt aus 96 rund 14 Kilogramm schweren Panels, die einzeln ausgetauscht werden können.“"
                                            },
                                            {
                                                "example_id": "ca9db718-0b8f-4168-be0b-73eae82c0182",
                                                "sense_id": "8aa4730e-2100-342c-b8b1-5c87cf4c02c1",
                                                "text": "„Die 60 auf 60 Zentimeter großen Quarantäne-Boxen sind nun fugenlos, leicht zu reinigen für die Pfleger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b19f151-d211-47c3-a3f0-d1b908a35e3d",
                        "source_entry_id": "80d4d78d-d359-3231-95d1-655ebd78a94d",
                        "source_sense_id": "64fb9977-c4dd-3235-bfb9-c568246e990d",
                        "target_lang_word": "nahtfrei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0dfd0d1b-5959-478b-b6fd-6f0251247941",
                        "source_entry_id": "80d4d78d-d359-3231-95d1-655ebd78a94d",
                        "source_sense_id": "64fb9977-c4dd-3235-bfb9-c568246e990d",
                        "target_lang_word": "nahtlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nahtlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c453ed48-0db2-3fd3-bd1d-8e78af4e3ae6",
                                        "entry_id": "00015f2f-93b6-3dd6-afae-2cfb31f0c545",
                                        "glosses": [
                                            "eine Verbindung ohne genähte, geklebte oder geschweißte Naht"
                                        ],
                                        "tags": [
                                            "ohne Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2197359a-d843-4531-9ae8-359b01815608",
                                                "sense_id": "c453ed48-0db2-3fd3-bd1d-8e78af4e3ae6",
                                                "text": "Ab 1955 bis 1965 gewann dann [der] nahtlose Strumpf langsam die Oberhand [gegenüber den vorher produzierten Strümpfen mit Naht]."
                                            },
                                            {
                                                "example_id": "8caf0423-314e-4c41-97a9-28e97326c3ad",
                                                "sense_id": "c453ed48-0db2-3fd3-bd1d-8e78af4e3ae6",
                                                "text": "Rohre bis zu einem Durchmesser von etwa 200 mm bei großen Wanddicken werden üblicherweise nahtlos hergestellt."
                                            },
                                            {
                                                "example_id": "b34ac121-0c97-4454-ae54-27b9d6a55688",
                                                "sense_id": "c453ed48-0db2-3fd3-bd1d-8e78af4e3ae6",
                                                "text": "[…] die Glasfasern [werden] mit einem Lichtbogen-Schweißgerät sehr heiß gemacht und dann nahtlos aneinandergeklebt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6145f781-3343-38b5-90af-ef04de45f07b",
                                        "entry_id": "00015f2f-93b6-3dd6-afae-2cfb31f0c545",
                                        "glosses": [
                                            "sich anpassend / übergehend ohne geringste Schwierigkeit; ohne fühlbaren Übergang von einer Person an die Nächste"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "704035ae-6a91-4103-a14f-b15415668e99",
                                                "sense_id": "6145f781-3343-38b5-90af-ef04de45f07b",
                                                "text": "Sein Vortrag und die sich anschließende Diskussion gingen nahtlos ineinander über. (= ohne Pause)"
                                            },
                                            {
                                                "example_id": "560ffa6e-280f-4b6d-af8d-6f72fa96a13f",
                                                "sense_id": "6145f781-3343-38b5-90af-ef04de45f07b",
                                                "text": "Trotz eines Hustenanfalls konnte er den Satz nahtlos fortsetzen und zu Ende bringen."
                                            },
                                            {
                                                "example_id": "9538becb-d182-40f1-8c21-df8359ff9a75",
                                                "sense_id": "6145f781-3343-38b5-90af-ef04de45f07b",
                                                "text": "Nach seiner Einwechslung integrierte sich der Mittelfeldspieler nahtlos in die Mannschaft."
                                            },
                                            {
                                                "example_id": "1502cf0e-674e-4999-80fa-7520a876ab10",
                                                "sense_id": "6145f781-3343-38b5-90af-ef04de45f07b",
                                                "text": "Unsere einjährige Ausbildung ist so gestaltet, dass sich ein zehnwöchiger Kurs nahtlos an den anderen anschließt. (= ohne Unterbrechung oder Ferien)"
                                            },
                                            {
                                                "example_id": "f19c9293-2865-4231-9d65-f281dc36c24e",
                                                "sense_id": "6145f781-3343-38b5-90af-ef04de45f07b",
                                                "text": "SS- und Gestapo-Leute bekamen eine neue Identität und machten nahtlos Karriere im BND [= BundesNachrichtenDienst] ."
                                            },
                                            {
                                                "example_id": "64c350bd-e979-43f8-b1d9-d5bf69a9b49a",
                                                "sense_id": "6145f781-3343-38b5-90af-ef04de45f07b",
                                                "text": "[Bei der 'Bundesagentur für Arbeit' BA] gebe es Personal mit befristeten Arbeitsverträgen, die nahtlos vom BAMF [dem im Jahr 2015 unter erheblicher Personalknappheit leidenden 'Bundesamt für Migration und Flüchtlinge'] als Sachbearbeiter übernommen werden könnten [so BA- und BAMF-Chef Frank-Jürgen Weise]."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
