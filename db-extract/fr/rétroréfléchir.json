                "senses": [
                    {
                        "sense_id": "b2988dee-4d68-3ce4-9524-63a2faacded7",
                        "entry_id": "ec652120-74c1-3945-9f17-615b7687cc6a",
                        "glosses": [
                            "Réfléchir (un faisceau lumineux) vers la direction d'où il provient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0e8120c-171e-4590-9cba-523e268882d5",
                                "sense_id": "b2988dee-4d68-3ce4-9524-63a2faacded7",
                                "text": "On sait que les systèmes optiques grossissants (tels que les lunettes de visée et les yeux) présentent la propriété de rétroréfléchir la Iumière."
                            },
                            {
                                "example_id": "5720c36d-c8ff-46d7-a99b-3fbfa6ff6bbc",
                                "sense_id": "b2988dee-4d68-3ce4-9524-63a2faacded7",
                                "text": "Pour ce faire, on ajoute un miroir externe de façon à rétroréfléchir l'émission vers la face émettrice."
                            }
                        ]
                    },
                    {
                        "sense_id": "78624f65-f01e-35cf-8027-66465f2f4905",
                        "entry_id": "ec652120-74c1-3945-9f17-615b7687cc6a",
                        "glosses": [
                            "Rendre rétroréfléchissant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4695f408-23f8-4dab-b695-8a12a5bafb9f",
                                "sense_id": "78624f65-f01e-35cf-8027-66465f2f4905",
                                "text": "D'autre part, il n'est pas prévu par les réglements de sécurité de rétroréfléchir les passages pour piétons."
                            }
                        ]
                    }
                ],
