                "senses": [
                    {
                        "sense_id": "64984629-2d07-3d30-9c67-553ed8086fe7",
                        "entry_id": "55320e0d-641b-3930-a727-112da0736d96",
                        "glosses": [
                            "Résine amère extraite de l’arnica (Arnica montana), elle possède une action cardiotoxique. Sa découverte serait l'œuvre d'un pharmacien italien nommé Pavesi."
                        ],
                        "tags": [
                            "information à préciser ou à vérifier"
                        ],
                        "examples": [
                            {
                                "example_id": "3aa23e29-c22a-4aea-b8b3-5385449a26ba",
                                "sense_id": "64984629-2d07-3d30-9c67-553ed8086fe7",
                                "text": "M. Pavesi croit pouvoir en déduire que l’arnicine a des propriétés acides, ou celles de former avec les bases des sels, dont elle est précipitée, non altérée, par les acides énergiques."
                            },
                            {
                                "example_id": "276cb0e8-4bf9-49bf-93af-ff878708d40d",
                                "sense_id": "64984629-2d07-3d30-9c67-553ed8086fe7",
                                "text": "Les fleurs contiennent de l'arnicine, du tanin, du glucose, de la phytostérine ou arnidol, des traces d'acide malique, de l'arnistérine (ou arnidiol) des matières grasses, aucune saponine."
                            }
                        ]
                    }
