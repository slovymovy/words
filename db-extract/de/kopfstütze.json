                    {
                        "sense_id": "27a65d47-f8d2-3a99-8ff8-c4f1034f9351",
                        "entry_id": "474de666-1955-316e-8603-3449c8deedc9",
                        "glosses": [
                            "Gegenstand oder Vorrichtung, die geeignet sind, dem Kopf Halt zu geben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ad0769f-d78b-4af2-b6ca-a56c84bc0a83",
                                "sense_id": "27a65d47-f8d2-3a99-8ff8-c4f1034f9351",
                                "text": "„Er ließ sich auf der hölzernen Kopfstütze nieder und hielt sich mit seinen ledernen Prothesen den Kopf.“"
                            },
                            {
                                "example_id": "992c9219-9ced-4d11-95fc-1f620b96a599",
                                "sense_id": "27a65d47-f8d2-3a99-8ff8-c4f1034f9351",
                                "text": "„Ramin lässt den Kopf nach hinten auf die Kopfstütze mit Fellüberzug fallen und schließt die Augen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
