                    }
                ],
                "senses": [
                    {
                        "sense_id": "9b7756ff-1470-312c-a0f3-69760e2496eb",
                        "entry_id": "498d09ab-77c6-3f37-9bd7-80704a838c8d",
                        "glosses": [
                            "In a blunt manner; without delicacy, or the usual forms of civility."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c948693-1f19-478c-84d3-c40f0ab41782",
                                "sense_id": "9b7756ff-1470-312c-a0f3-69760e2496eb",
                                "text": "Note the preſumption of this Scythian ſlaue:\nI tel thee villaine, thoſe that lead my horſe\nHaue to their names tytles of dignitie,\nAnd dar’ſt thou bluntly cal me Baiazeth?"
                            },
                            {
                                "example_id": "8e8f4e80-d6d8-4612-9df6-f4a278baded9",
                                "sense_id": "9b7756ff-1470-312c-a0f3-69760e2496eb",
                                "text": "To put it bluntly, they are going to have to start defending a heck of a lot better than they have been, otherwise their season - and top-flight status - could well be over before they know it."
                            },
                            {
                                "example_id": "26f6ec1f-eaee-4e3b-8752-d5a5eca50a61",
                                "sense_id": "9b7756ff-1470-312c-a0f3-69760e2496eb",
                                "text": "Drivers' union ASLEF bluntly rebuffed the claim of unofficial action, calling it a lie. And Avanti West Coast was unable to provide any proof for its assertion, when questioned by RAIL."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab92a3fb-139d-4136-b890-52fbcb525696",
                        "source_entry_id": "498d09ab-77c6-3f37-9bd7-80704a838c8d",
                        "source_sense_id": "9b7756ff-1470-312c-a0f3-69760e2496eb",
                        "source_sense_description": "In a blunt manner",
                        "target_lang_word": "abruptement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abruptement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                                        "entry_id": "cac8c586-2247-3031-a76f-f5f582a6e3aa",
                                        "glosses": [
                                            "De façon brutale, et non graduelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa97ea87-cb12-4cd4-ac7d-71fd8d95b30d",
                                                "sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                                                "text": "Ne pas annoncer abruptement un diagnostic de mort imminente peut être assimilé à une forme d'hypocrisie."
                                            },
                                            {
                                                "example_id": "e39a6e8b-de2a-4b7a-91e7-15ce641fa4ab",
                                                "sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                                                "text": "Hier, il a prononcé un discours hallucinant – tellement truffé de mensonges que de grands médias américains ont même dû mettre fin abruptement à sa diffusion, du jamais-vu."
                                            },
                                            {
                                                "example_id": "683c01d4-26d0-4ab5-bc87-f4aaf1f7e7d5",
                                                "sense_id": "0a4a8174-7653-389c-86c7-9a52f050eee6",
                                                "text": "L’aveu tombe abruptement lorsque la présidente, Aurore Pecquet, l’interroge sur ses loisirs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4b4bbd8-c887-4380-8e4d-a8b353797c4c",
                        "source_entry_id": "498d09ab-77c6-3f37-9bd7-80704a838c8d",
                        "source_sense_id": "9b7756ff-1470-312c-a0f3-69760e2496eb",
                        "source_sense_description": "In a blunt manner",
                        "target_lang_word": "à brûle-pourpoint",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à brûle-pourpoint",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c920664-9127-3810-94b8-0b3e9d7719d6",
                                        "entry_id": "18fe32d0-15ac-30e3-8b68-ae4aa027bddc",
                                        "glosses": [
                                            "À bout portant ou de très près, en tirant."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36f06071-9137-427b-8048-de8f0e3e7f86",
                                                "sense_id": "5c920664-9127-3810-94b8-0b3e9d7719d6",
                                                "text": "Et [l’Amour] la tire à brûle-pourpoint\n D’un petit arc qu’on ne voit point."
                                            },
                                            {
                                                "example_id": "bfbf0665-df4e-4195-9f8d-569fa5d9a74d",
                                                "sense_id": "5c920664-9127-3810-94b8-0b3e9d7719d6",
                                                "text": "Mais les coups éloignés ne vous émeuvent point. Il faut vous les tirer plus à brûle-pourpoint."
                                            },
                                            {
                                                "example_id": "2c5d4691-a79c-4786-9cbb-1e437693e309",
                                                "sense_id": "5c920664-9127-3810-94b8-0b3e9d7719d6",
                                                "text": "Mais si ces applications sont si populaires, c'est en partie parce qu'elles nous permettent d'éviter cette situation embarrassante d'aborder quelqu'un à brûle pourpoint dans la vraie vie. Pourtant, cette démarche présente des bénéfices notables pour notre vie personnelle, en élargissant notre cercle de connaissances et en encourageant des rencontres spontanées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "925024fe-7de2-331e-947f-5dcbe843a90d",
                                        "entry_id": "18fe32d0-15ac-30e3-8b68-ae4aa027bddc",
                                        "glosses": [
                                            "Brusquement, sans préparation, sans ménagement, sans détour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7998db0-ce0e-4567-96a3-a5926f87cf85",
                                                "sense_id": "925024fe-7de2-331e-947f-5dcbe843a90d",
                                                "text": "Et puis, c’était à brûle-pourpoint mille serments, des « la Caille, mon jésus », « ma chérie », « ma jolie », c’était des rires, c’était, dans le lit en désordre, des agaceries."
                                            },
                                            {
                                                "example_id": "b0178443-a6ba-49a9-a24f-ca8a520ed877",
                                                "sense_id": "925024fe-7de2-331e-947f-5dcbe843a90d",
                                                "text": "Il me déconcerta en me déclarant à brûle-pourpoint : « Il faut rendre libre la polygamie. »"
                                            },
                                            {
                                                "example_id": "a975e896-3019-4730-8d69-757486bc9870",
                                                "sense_id": "925024fe-7de2-331e-947f-5dcbe843a90d",
                                                "text": "[…] quand tout à coup je pose la main sur la main de Véra qui tient légèrement soulevée sa longue jupe et je lui demande ce qui s’appelle à brûle-pourpoint : « Dis-moi, est-ce que tu me détestes ? »"
                                            },
                                            {
                                                "example_id": "d06c83a7-75ef-4ab6-a1d8-18f44cae7ff8",
                                                "sense_id": "925024fe-7de2-331e-947f-5dcbe843a90d",
                                                "text": "Aussi sera-t-il sensible à l’appel de Pierre-Henri Teitgen, lorsque celui-ci lui demandera à brûle-pourpoint en 1945 à Lille, voulez-vous être des nôtres ?"
                                            },
                                            {
                                                "example_id": "32bd914e-045b-455f-8ee9-ae2fcda8d7d9",
                                                "sense_id": "925024fe-7de2-331e-947f-5dcbe843a90d",
                                                "text": "Tu pourrais lui dire que tu es désolé, suggéra Harry à brûle-pourpoint."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77483178-73d4-4d02-b4d2-6d6b691ffcf8",
                        "source_entry_id": "498d09ab-77c6-3f37-9bd7-80704a838c8d",
                        "source_sense_id": "9b7756ff-1470-312c-a0f3-69760e2496eb",
                        "source_sense_description": "In a blunt manner",
                        "target_lang_word": "sans ménagement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans ménagement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "216f248e-740a-307c-bac0-c6d403dce60f",
                                        "entry_id": "adc03c3b-a3d0-3f52-ae9b-9ec8be3270e4",
                                        "glosses": [
                                            "De manière abrupte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b135f673-ffb8-4054-bd0c-0ff13298fbaf",
                                                "sense_id": "216f248e-740a-307c-bac0-c6d403dce60f",
                                                "text": "Nous parlons sans ménagement de cette paix qui fut jusque-là la seule dangereuse, des deux ou trois camarades communs qu’elle a fait périr."
                                            },
                                            {
                                                "example_id": "a8982b06-ea6a-496d-9e3c-26eac358a73a",
                                                "sense_id": "216f248e-740a-307c-bac0-c6d403dce60f",
                                                "text": "Les deux fêlés le jetèrent alors de sa bagnole sans ménagement, lui laissant le casson d’Omitov en le remerciant de ses bonnes manières."
                                            },
                                            {
                                                "example_id": "af5d01c4-5539-46bc-8149-dac423bb7acc",
                                                "sense_id": "216f248e-740a-307c-bac0-c6d403dce60f",
                                                "text": "Le sang de Samuel se mit à bouillir et il se jeta sur son frère. L’assemblée fut prise de court, trop occupée à ranimer Pierre Esterhuizen. Les Hugo s’empoignèrent sans ménagement, avec la férocité dont seuls deux frères étaient capables l’un envers l’autre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4898965-0dfb-4e68-9654-e3d7e3d6f5c8",
                        "source_entry_id": "498d09ab-77c6-3f37-9bd7-80704a838c8d",
