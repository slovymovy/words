                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In stressigen Prüfungen muss man unbedingt <w>cool</w> bleiben.",
                            "target_lang_translations": {
                                "en": "In stressful exams, you definitely have to keep <w>cool</w>.",
                                "ru": "На стрессовых экзаменах обязательно нужно оставаться <w>хладнокровным</w>.",
                                "nl": "Bij stressvolle examens moet je absoluut <w>cool</w> blijven.",
                                "pl": "Na stresujących egzaminach trzeba koniecznie zachować <w>spokój</w>.",
                                "fr": "Pendant les examens stressants, il faut absolument rester <w>calme</w>.",
                                "it": "Durante gli esami stressanti bisogna assolutamente rimanere <w>calmi</w>.",
                                "cs": "Při stresujících zkouškách musí člověk bezpodmínečně zůstat <w>v klidu</w>.",
                                "tr": "Stresli sınavlarda kesinlikle <w>sakin</w> kalmak gerekir.",
                                "es": "En exámenes estresantes, uno tiene que mantenerse obligatoriamente <w>tranquilo</w>.",
                                "zh": "在压力很大的考试中，必须一定要保持<w>冷静</w>。"
                            }
                        },
                        {
                            "text": "Trotz des unerwarteten Unfalls reagierte der erfahrene Fahrer erstaunlich <w>cool</w>.",
                            "target_lang_translations": {
                                "en": "Despite the unexpected accident, the experienced driver reacted remarkably <w>coolly</w>.",
                                "ru": "Несмотря на неожиданную аварию, опытный водитель отреагировал поразительно <w>хладнокровно</w>.",
                                "nl": "Ondanks het onverwachte ongeluk reageerde de ervaren bestuurder verbazingwekkend <w>cool</w>.",
                                "pl": "Mimo niespodziewanego wypadku doświadczony kierowca zareagował zdumiewająco <w>opanowanie</w>.",
                                "fr": "Malgré l'accident inattendu, le conducteur expérimenté a réagi de façon étonnamment <w>calme</w>.",
                                "it": "Nonostante l'incidente inaspettato, il guidatore esperto ha reagito in modo sorprendentemente <w>calmo</w>.",
                                "cs": "I přes nečekanou nehodu reagoval zkušený řidič překvapivě <w>chladnokrevně</w>.",
                                "tr": "Beklenmedik kazaya rağmen tecrübeli sürücü şaşırtıcı derecede <w>soğukkanlı</w> tepki verdi.",
                                "es": "A pesar del accidente inesperado, el conductor experimentado reaccionó sorprendentemente <w>sereno</w>.",
                                "zh": "尽管发生了突发事故，那位经验丰富的司机反应却出奇地<w>沉着</w>。"
                            }
                        }
