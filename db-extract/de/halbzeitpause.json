                                    {
                                        "sense_id": "41dcef2a-1606-3a09-94db-a728e988180d",
                                        "entry_id": "6cf54c4b-455d-3c16-9f45-9fbec5e6aeb8",
                                        "glosses": [
                                            "The interval between the two halves of a sports match."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1745841-b3e8-4b4a-9815-83d95e7e05f1",
                                                "sense_id": "41dcef2a-1606-3a09-94db-a728e988180d",
                                                "text": "Let's get some pizza at half-time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28c7d59f-9b55-3e02-8cb0-a8b2a0670738",
                                        "entry_id": "6cf54c4b-455d-3c16-9f45-9fbec5e6aeb8",
                                        "glosses": [
                                            "Half or approximately half the number of hours usually worked in a specified period."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62dc6c54-fba9-4038-934e-ad697843126b",
                                                "sense_id": "28c7d59f-9b55-3e02-8cb0-a8b2a0670738",
                                                "text": "I'm following a half-time schedule this month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "838113a9-bfd6-31a8-9b93-2dbdbeffbbd2",
                                        "entry_id": "6cf54c4b-455d-3c16-9f45-9fbec5e6aeb8",
                                        "glosses": [
                                            "A tempo in which the rhythm is emphasized so that it seems to have half as many metric divisions (e.g. emphasizing the start of every other bar rather than every bar)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "985d587e-0bb5-3f1a-a1b3-0c8072f10f08",
                                        "entry_id": "6cf54c4b-455d-3c16-9f45-9fbec5e6aeb8",
                                        "glosses": [
                                            "The time taken for a physical quantity to halve the difference between its present value and its final value."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "half-time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78f1b77c-c261-3544-937a-7e40114aa437",
                                        "entry_id": "447d1358-17c1-3ccc-beca-152912094177",
                                        "glosses": [
                                            "Pertaining to or characterized by half the usual duration."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1523a8b-9caa-4425-88cc-576a160f902e",
                                                "sense_id": "78f1b77c-c261-3544-937a-7e40114aa437",
                                                "text": "The remedy proposed is half-time schools. The teachers are to be engaged for a school year's service, but the pupils belonging to each school are to be divided into two sections. Each section is to spend half the time in school and the remainder at home."
                                            },
                                            {
                                                "example_id": "6c1a5881-feff-4b07-bec3-063c1d84ac3e",
                                                "sense_id": "78f1b77c-c261-3544-937a-7e40114aa437",
                                                "text": "The remaining federal and State programs provide aid to part-time students only if attendance is half-time or more (at least six credit-hours)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "half-time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5689b20e-e1e8-3211-83c8-5973181e262e",
                                        "entry_id": "2c0ca8f7-69f1-3845-b715-52939cba0527",
                                        "glosses": [
                                            "In a half time manner."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5fad9e1-c7cd-4b6f-afeb-8a95048f6c71",
                                                "sense_id": "5689b20e-e1e8-3211-83c8-5973181e262e",
                                                "text": "I'm working half-time this month (two and a half days per week) before my maternity leave."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
