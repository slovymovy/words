                "senses": [
                    {
                        "sense_id": "df719a5b-ccc0-3777-a1d7-eb1b64569f03",
                        "entry_id": "285cf5dd-63d6-309d-82a6-0e24b426e047",
                        "glosses": [
                            "gewählter Vertreter im Bundestag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c5e307c-5796-466d-8e48-31c2d93cd051",
                                "sense_id": "df719a5b-ccc0-3777-a1d7-eb1b64569f03",
                                "text": "„49,3 Jahre betrug das Durchschnittsalter der Bundestagsabgeordneten in der vergangenen Legislaturperiode.“"
                            },
                            {
                                "example_id": "9360df21-3ab7-4e73-bdb0-a6d7ac098ec3",
                                "sense_id": "df719a5b-ccc0-3777-a1d7-eb1b64569f03",
                                "text": "„Für Oliver Krischer, Bundestagsabgeordneter von Bündnis 90/Die Grünen, sind die Ergebnisse ein deutlicher Hinweis darauf, dass in der Fischzucht Medikamente, im Falle von Malachitgrün sogar illegal, ins Futter gemischt werden.“"
                            },
                            {
                                "example_id": "7b4544d2-3cf4-4f8e-9ada-b31ca5bb80f4",
                                "sense_id": "df719a5b-ccc0-3777-a1d7-eb1b64569f03",
                                "text": "„Die Hälfte aller Bundestagsabgeordneten ist in ihrem eigenen Wahlkreis durchgefallen und sitzt trotzdem drin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
