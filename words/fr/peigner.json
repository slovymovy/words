                },
                {
                    "sense_id": "a5e3460d-33a8-36d9-855d-5389f830eca6",
                    "sense_definition": "Arranger avec un soin méticuleux ou excessif, en parlant d'un style, d'un texte ou d'un jardin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arrangement_figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce parc ressemble à un jardin ordonné où chaque buisson est taillé et <w>peigné</w> avec minutie."
                        },
                        {
                            "text": "L'orateur a tellement voulu <w>peigner</w> son discours qu'il en a perdu toute spontanéité."
