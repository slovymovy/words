                        "glosses": [
                            "Relatif à Pierre Carlet de Chamblain de Marivaux ou à ses œuvres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a2dbba5-2256-481d-9178-5444cd110a38",
                                "sense_id": "b126ef2a-3196-398f-a519-ef6d557f827c",
                                "text": "Encore faut-il ne pas fuir le système dramatique marivaudien."
                            },
                            {
                                "example_id": "dcced4e7-3097-4d79-a8a8-7bb071b03f8f",
                                "sense_id": "b126ef2a-3196-398f-a519-ef6d557f827c",
                                "text": "C’est surtout merveilleusement joué, par une troupe où se mêlent de jeunes « acteurs de bonne foi », vifs et frais, et trois maîtresses femmes, maîtresses actrices, qui se régalent littéralement de ce festin marivaudien, et nous avec elles : Laurence Roy (Madame Hamelin), Annie Mercier (Madame Argante) et Anne Guégan (Araminte)."
                            }
                        ]
                    }
