                        ],
                        "examples": [
                            {
                                "example_id": "780461cf-4fb0-4184-8dc0-0fa2391a1fb1",
                                "sense_id": "4becc1ee-e145-3263-a99e-7de6196ae02c",
                                "text": "I found her closely locked in the arms of a handsome lad, one of my kitmuddars, with the infant by her side, all three being in a deep sleep, from which I awakened the two elders."
                            },
                            {
                                "example_id": "57382fcb-7a2c-4c27-86fc-e657aa3d7e2c",
                                "sense_id": "4becc1ee-e145-3263-a99e-7de6196ae02c",
                                "text": "He did not know then that his khitmatgar had stopped by the roadside to get drunk, and would come on the next day saying that he had sprained his ankle."
                            },
                            {
                                "example_id": "688c1a24-7f95-47a1-b459-e11b230ecf6c",
                                "sense_id": "4becc1ee-e145-3263-a99e-7de6196ae02c",
                                "text": "‘The Ambassador to Bangalore appeared before me dressed in the robes of a khitmagar or majordomo.’"
                            }
                        ]
                    }
