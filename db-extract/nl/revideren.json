                        "source_sense_id": "68485806-fd5c-351f-8237-92778b31f923",
                        "source_sense_description": "nakijken en herstellen",
                        "target_lang_word": "revise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d60e2b22-57fe-3f56-9b23-4e3c2bd078c5",
                                        "entry_id": "e99a608c-638c-3614-91cc-bf12cbf627d7",
                                        "glosses": [
                                            "To review, alter and amend, especially of written material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "554b4003-16dc-4e21-b759-1cc6ab206b71",
                                                "sense_id": "d60e2b22-57fe-3f56-9b23-4e3c2bd078c5",
                                                "text": "This statute should be revised."
                                            },
                                            {
                                                "example_id": "f6030afb-8dda-4771-ad97-bf67ae24e815",
                                                "sense_id": "d60e2b22-57fe-3f56-9b23-4e3c2bd078c5",
                                                "text": "There has been a demand for a revised edition of my English Translation and Commentary of the Holy Qur′an since the end of the Second World War."
                                            },
                                            {
                                                "example_id": "2582029b-721f-4b1b-94e8-e7aa3fc7ddce",
                                                "sense_id": "d60e2b22-57fe-3f56-9b23-4e3c2bd078c5",
                                                "text": "1983, Willard Scott Thompson, Chapter 1: The Third World Revisited, Willard Scott Thompson (editor), The Third World: Premises of U.S. Policy, Revised edition, page 15,\nThe chapter that deals specifically with singular examples is Daniel Pipes′ revised study of the Third World peoples of Soviet Central Asia."
                                            },
                                            {
                                                "example_id": "d3d773dd-a8ef-448b-87b9-5cd5b36535d5",
                                                "sense_id": "d60e2b22-57fe-3f56-9b23-4e3c2bd078c5",
                                                "text": "The best writers know better. They write a first draft not to show readers, but to discover what case they can make for their point and whether it stands up to their own scrutiny. Then they revise and revise until they think their readers will think so too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13625858-50ba-3c0c-8cfb-4c8414252900",
                                        "entry_id": "e99a608c-638c-3614-91cc-bf12cbf627d7",
                                        "glosses": [
                                            "To look over again (something previously written or learned), especially in preparation for an examination."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61ddce8c-2c94-4b54-8f7a-dc031136ef15",
                                                "sense_id": "13625858-50ba-3c0c-8cfb-4c8414252900",
                                                "text": "I've only just begun to revise for my exams."
                                            },
                                            {
                                                "example_id": "811ea6b7-7fef-4f88-92e6-a3fb491e4ed2",
                                                "sense_id": "13625858-50ba-3c0c-8cfb-4c8414252900",
                                                "text": "In revising your notes, you can also reorganize them so that they are more legible, better arranged, and in a more useful condition for subsequent reviews."
                                            },
                                            {
                                                "example_id": "575764d0-be71-410c-8339-5634c5682984",
                                                "sense_id": "13625858-50ba-3c0c-8cfb-4c8414252900",
                                                "text": "4 Is it necessary to revise vocabulary (= study it again for a second or third time)?\n5 Is it better to revise vocabulary occasionally for long periods of time, or is it better to revise regularly for short periods of time?"
                                            },
                                            {
                                                "example_id": "0a06993a-f2cd-46b1-a84f-cce834c83d96",
                                                "sense_id": "13625858-50ba-3c0c-8cfb-4c8414252900",
                                                "text": "2008, Tom Burns, Sandra Sinfield, Chapter 19: How to build your memory and revise effectively, Essential Study Skills: The Complete Guide to Success at University, SAGE Publications, UK, page 273."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "236c9fce-c007-3720-b352-0440091056ae",
                                        "entry_id": "e99a608c-638c-3614-91cc-bf12cbf627d7",
                                        "glosses": [
                                            "To look at again, to reflect on."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "revise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12f198ee-83db-3c3c-b3e4-0b994d19c05e",
                                        "entry_id": "5ddfa515-7afa-301f-8bc7-edd665403b85",
                                        "glosses": [
                                            "A review or a revision."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "369a9e31-be73-38ac-96d8-00165e85bb14",
                                        "entry_id": "5ddfa515-7afa-301f-8bc7-edd665403b85",
                                        "glosses": [
                                            "A second proof sheet; a proof sheet taken after the first or a subsequent correction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ec909ba-cea8-4014-a303-3796c892adf4",
                                                "sense_id": "369a9e31-be73-38ac-96d8-00165e85bb14",
                                                "text": "The question is, not whether the revises of the Catalogue, which I was obliged to circulate prematurely, were faultless, but whether the alterations which I was desired to make would not render them worse."
                                            },
                                            {
                                                "example_id": "25c61586-145b-40e4-baf7-f9f78bc585ff",
                                                "sense_id": "369a9e31-be73-38ac-96d8-00165e85bb14",
                                                "text": "1869 August 16, Anthony Trollope, letter to W. H. Bradbury, 1983, N. John Hall (editor), The Letters of Anthony Trollope, Volume 1: 1835-1870, page 479,\nLooking back at the revises of Bullhampton it seems to me that the printers have fallen into some error as to the numbering of Chapters XXXIV—XXXV—XXXVI—which should have been XXXV—XXXVI— and XXXVII."
                                            },
                                            {
                                                "example_id": "292536e7-5f4e-4012-ab6d-9dd4dfe226c7",
                                                "sense_id": "369a9e31-be73-38ac-96d8-00165e85bb14",
                                                "text": "1917, United States Congress: House Committee on Rules, Alleged Divulgence of President′s note to Belligerent Powers, page 1440,\nI still held the revises; kept them until the type was made up and went to the press, for final page proof."
                                            },
                                            {
                                                "example_id": "6e3b8780-0dbe-4e87-9b21-88c6ad45e256",
                                                "sense_id": "369a9e31-be73-38ac-96d8-00165e85bb14",
                                                "text": "[…]until I had corrected the proofs of the novel and seen the revises, so that the text was irrevocably fixed, before beginning the screenplay."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4ed7c16-8bd6-4fac-8b20-807f7a613294",
                        "source_entry_id": "46b98297-12aa-3712-aec9-218a7ab8a087",
