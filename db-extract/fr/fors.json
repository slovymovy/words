            {
                "entry_id": "94493d14-4eaa-345a-ac9f-a481113f577f",
                "word": "fors",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "238cab55-0b2e-4984-9d6b-e92ec9aefda4",
                        "entry_id": "94493d14-4eaa-345a-ac9f-a481113f577f",
