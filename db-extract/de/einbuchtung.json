                        "source_sense_id": "7a774d95-793d-30d7-8a84-ebd630e339b3",
                        "source_sense_description": "umgangssprachlich: Handlung, jemanden festzusetzen, und Ergebnis dieser Handlung",
                        "target_lang_word": "arrestation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrestation",
