            {
                "entry_id": "24c4421d-74ab-3c84-a6f6-d62ddba4d1dc",
                "word": "misopédie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2aecc2ba-1cd7-4d71-9924-5fffbddaefa9",
                        "entry_id": "24c4421d-74ab-3c84-a6f6-d62ddba4d1dc",
                        "tags": [
                            "plural"
                        ],
                        "form": "misopédies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd5bfb13-25c3-3dc5-b355-0a3761626972",
                        "entry_id": "24c4421d-74ab-3c84-a6f6-d62ddba4d1dc",
                        "glosses": [
                            "Haine et mépris des enfants, en particulier envers son propre enfant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d75adaf-f635-42cf-ad70-32f5f07f7dfb",
                                "sense_id": "fd5bfb13-25c3-3dc5-b355-0a3761626972",
                                "text": "Je ne puis passer sous silence une façon d’aimer les enfants qui les tue. Je veux te parler de la pédophilie, et de sa relation avec ce que j’appelle la misopédie, la haine et le mépris pour les enfants."
                            },
                            {
                                "example_id": "f5e2797b-e31a-44e6-ac3b-15bb4a49c638",
                                "sense_id": "fd5bfb13-25c3-3dc5-b355-0a3761626972",
                                "text": "La misopédie, haine envers les enfants — classiquement envers ses propres enfants — se traduit par des mauvais traitements (maltraitance), des sévices."
                            },
                            {
                                "example_id": "84ae03a9-a3e6-429a-ad2a-1dab964edd07",
                                "sense_id": "fd5bfb13-25c3-3dc5-b355-0a3761626972",
                                "text": "Les manifestations de la misopédie ont en commun de ne pas tenir compte de la souffrance des enfants, soit parce qu’on suppose qu’ils ne souffrent pas, parce que l’on estime qu’ils doivent maîtriser leur souffrance."
                            }
                        ]
                    }
                ],
