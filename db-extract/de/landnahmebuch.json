                    {
                        "sense_id": "2fda1236-201d-3a24-b0ac-e1417df6633f",
                        "entry_id": "73cba404-1384-399c-b7c4-679767de0dd5",
                        "glosses": [
                            "Buch der altisländischen Literatur (in mehreren Fassungen) über die Erstbesiedelung Islands vom 9. Jahrhundert an"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6f4c998-b13c-4443-bc83-aa68e339137a",
                                "sense_id": "2fda1236-201d-3a24-b0ac-e1417df6633f",
                                "text": "„Bereits die älteste Version des Landnahmebuchs nennt rund 400 Pioniere mit Namen, beschreibt bei manchen sogar, woher sie stammen, wer ihre Vorfahren waren und wo genau sie sich auf Island ansiedeln.“"
                            },
                            {
                                "example_id": "e03196ad-3e46-46be-b9c7-2592f1d8dac8",
                                "sense_id": "2fda1236-201d-3a24-b0ac-e1417df6633f",
                                "text": "„Das Landnahmebuch ist hauptsächlich in drei Versionen aus dem späten 13. und frühen 14. Jh. überliefert, wobei es sich auf Quellen aus der Zeit bis ungefähr ins Jahr 1130 stützt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
