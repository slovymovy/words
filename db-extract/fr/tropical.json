                    },
                    {
                        "form_id": "de4297d6-d45a-4cf6-ae3a-bc3044d561f2",
                        "entry_id": "338048b0-7d83-3c27-9eba-bf803883f10c",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "tropicales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d2c723d-8520-3d16-99d9-2d54b07a3b6e",
                        "entry_id": "338048b0-7d83-3c27-9eba-bf803883f10c",
                        "glosses": [
                            "Relatif aux tropiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ab2b1b7-e4a3-4a40-a86a-0212c82bf778",
                                "sense_id": "8d2c723d-8520-3d16-99d9-2d54b07a3b6e",
                                "text": "Structure des Fougères. — Ces sont des plantes aflores, aux tiges généralement souterraines (rhizomes) pour les espèces des régions tempérées, parfois ligneuses chez celles des zones tropicales."
                            },
                            {
                                "example_id": "31a54734-cda2-4ee3-b49f-a6634dd84dc7",
                                "sense_id": "8d2c723d-8520-3d16-99d9-2d54b07a3b6e",
                                "text": "Beaucoup d’observateurs admettent l’existence de plusieurs espèces d’hématozoaires du paludisme : hématozoaires des fièvres tropicales, de la tierce et de la quarte. Je pense qu’il s’agit de simples variétés d’une même espèce polymorphe."
                            },
                            {
                                "example_id": "aa5c344a-39d9-49cd-ac6a-7a28811799d0",
                                "sense_id": "8d2c723d-8520-3d16-99d9-2d54b07a3b6e",
                                "text": "Nous nous élevons rapidement et ne tardons pas à quitter la zone des cultures tropicales et subtropicales des terres basses. Les plantations de bananes, de canne à sucre, de tabac, de patates, les nopaleries et la vigne sont remplacées par des champs de céréales, de légumineuses et de pommes de terre ; […]."
                            },
                            {
                                "example_id": "09556891-3c93-4cfd-bd0e-19f7331f25a4",
                                "sense_id": "8d2c723d-8520-3d16-99d9-2d54b07a3b6e",
                                "text": "Le 12 mars, par 20 degrés de latitude Nord, je rencontrai les vents alizés, je pouvais compter dorénavant sur un plus faible et agréable navigation dans les mers tropicales."
                            }
                        ]
                    },
                    {
                        "sense_id": "b88e5139-0400-3dea-8c04-2185389b00f3",
                        "entry_id": "338048b0-7d83-3c27-9eba-bf803883f10c",
                        "glosses": [
                            "Qui a le caractère des tropiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3479f33-ac6e-4775-8870-80beba7d015a",
                                "sense_id": "b88e5139-0400-3dea-8c04-2185389b00f3",
                                "text": "Chaleur tropicale, température très élevée."
                            },
                            {
                                "example_id": "6a946026-4581-46d7-bb73-947a01521d1e",
                                "sense_id": "b88e5139-0400-3dea-8c04-2185389b00f3",
                                "text": "Il fait ici depuis quelques jours une chaleur tropicale."
                            },
                            {
                                "example_id": "3b478541-a4db-4240-a4da-63668d075f85",
                                "sense_id": "b88e5139-0400-3dea-8c04-2185389b00f3",
                                "text": "« Il me semble, dit Jeanne, que la chaleur augmente encore.\n— En effet... Elle est trop... trop... tropicale... » ajoute Telcide, qui s’exprime difficilement tant elle a la gorge sèche..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01be6230-e279-4372-9f1e-4e3b0ca1351c",
                        "source_entry_id": "338048b0-7d83-3c27-9eba-bf803883f10c",
                        "target_lang_word": "tropical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tropical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17fce9be-6d10-367a-8b9b-7f329d305b1a",
                                        "entry_id": "ad8b1eaf-8c8f-38b4-b951-7434c7a647d3",
                                        "glosses": [
                                            "A tropical plant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "256dedb4-17d0-4d32-9d56-8c542263cb01",
                                                "sense_id": "17fce9be-6d10-367a-8b9b-7f329d305b1a",
                                                "text": "The potato, as a mountain tropical plant, is capable of growing in cooler weather than any other tropical except the Nasturtian."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tropical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ea3ce65-e9de-3590-bbda-d1ed97d324d5",
                                        "entry_id": "8aac00b9-62d9-37f0-92e1-48493f069d02",
                                        "glosses": [
                                            "Of or pertaining to the tropics, the equatorial region between 23 degrees north and 23 degrees south."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce984e90-cce6-324f-bf75-c6283609aea3",
                                        "entry_id": "8aac00b9-62d9-37f0-92e1-48493f069d02",
                                        "glosses": [
                                            "From, or similar to, a hot, humid climate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5076d4b-711b-4861-987b-8f548c65da5f",
                                                "sense_id": "ce984e90-cce6-324f-bf75-c6283609aea3",
                                                "text": "We've had a lot of tropical nights this summer."
                                            },
                                            {
                                                "example_id": "3c1c8c2c-efaf-4f4d-8822-0cf4a4f407cb",
                                                "sense_id": "ce984e90-cce6-324f-bf75-c6283609aea3",
                                                "text": "My favorite tropical fruits are pineapples and coconuts."
                                            },
                                            {
                                                "example_id": "d22e9dce-9855-4304-aea0-53f34af19687",
                                                "sense_id": "ce984e90-cce6-324f-bf75-c6283609aea3",
                                                "text": "Whale sharks are found in all the tropical waters of the world. As with many tropical species, an occasional stray wanders into colder waters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76b91e2a-4562-3382-9c00-91abaaa479a1",
                                        "entry_id": "8aac00b9-62d9-37f0-92e1-48493f069d02",
                                        "glosses": [
                                            "Pertaining to, involving, or of the nature of a trope or tropes; figurative, metaphorical."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2fcdb43-9aba-42a2-91d9-c88f2281c229",
                                                "sense_id": "76b91e2a-4562-3382-9c00-91abaaa479a1",
                                                "text": "But we, by the real spiritual presence of Christ, do understand Christ to be present, as the Spirit of God is present in the hearts of the faithful, by blessing and grace; and this is all which we mean besides the tropical and figurative presence."
                                            },
                                            {
                                                "example_id": "73c384eb-0b6a-4d93-8e98-e873960eb691",
                                                "sense_id": "76b91e2a-4562-3382-9c00-91abaaa479a1",
                                                "text": "The foundation of all parables is some analogy or similitude between the tropical or allusive part of the parable and the thing intended by it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca508e1e-ff7b-3344-bfbc-1f28f4facaf0",
                                        "entry_id": "8aac00b9-62d9-37f0-92e1-48493f069d02",
                                        "glosses": [
                                            "Pertaining to tropical geometry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
