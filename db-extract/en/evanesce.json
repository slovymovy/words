                    {
                        "sense_id": "93f99dfd-adf6-3a38-b473-63a0aa1ce6ef",
                        "entry_id": "26b27d48-a499-3bcf-ae2f-5e070d5238a8",
                        "glosses": [
                            "To disappear into a mist or dissipate in vapor"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a3b28f54-3502-3664-a7b7-edf48c8841de",
                        "entry_id": "26b27d48-a499-3bcf-ae2f-5e070d5238a8",
                        "glosses": [
                            "To transition from the solid state to gaseous state without ever becoming a liquid"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76ea440d-14a4-44ff-bfbb-dbeb8a7b6dbd",
                        "source_entry_id": "26b27d48-a499-3bcf-ae2f-5e070d5238a8",
                        "source_sense_description": "To disappear into a mist",
                        "target_lang_word": "испари́ться",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "испари́ться",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5d915f72-d8b6-3212-838b-a59217ee32dc",
                                        "entry_id": "723eb228-9744-338b-9ef9-9ed1bd15a8d3",
                                        "glosses": [
                                            "превратиться в пар, перейти в газообразное состояние"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4145c162-476e-4bcf-8d24-90a4afceecf0",
                                                "sense_id": "5d915f72-d8b6-3212-838b-a59217ee32dc",
                                                "text": "Утвердительно могу сказать, что зыбкие болота иногда превращаются в обыкновенные: вероятно, верхний пласт, год от году делаясь толще и тяжеле, наконец сядет на дно, а вода просочится наружу и испарится."
                                            },
                                            {
                                                "example_id": "cbb39bf3-cd13-4d34-be8a-1c9385093bb0",
                                                "sense_id": "5d915f72-d8b6-3212-838b-a59217ee32dc",
                                                "text": "Перещелочение раствора нашатырным спиртом не страшно потому, что со временем аммиак из раствора испарится и нейтрализация будет полная."
                                            },
                                            {
                                                "example_id": "1fe203a6-a16a-47cd-8d17-d8389de30de2",
                                                "sense_id": "5d915f72-d8b6-3212-838b-a59217ee32dc",
                                                "text": "Но скажут: как можно обойтись без тяжести — испарятся океаны, разлетится атмосфера, и планета останется без того, без чего невозможна жизнь."
                                            },
                                            {
                                                "example_id": "44a4f83a-09e6-4d28-a086-c58aa885cad2",
                                                "sense_id": "5d915f72-d8b6-3212-838b-a59217ee32dc",
                                                "text": "Влить 1 стакан вина и кипятить около 20 минут, пока жидкость не испарится."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f551ce4-eef7-32b0-a1fc-9ce81e3931d4",
                                        "entry_id": "723eb228-9744-338b-9ef9-9ed1bd15a8d3",
                                        "glosses": [
                                            "перен. исчезнуть, пропасть"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a75f5833-4152-48db-a165-3949d9f6209f",
                                                "sense_id": "2f551ce4-eef7-32b0-a1fc-9ce81e3931d4",
                                                "text": "Князь уже не возражал против визита и следовал послушно за генералом, чтобы не раздражить его, в твёрдой надежде, что генерал Соколович и всё семейство его мало-по-малу испарится как мираж и окажутся несуществующими, так что они преспокойно спустятся обратно с лестницы."
                                            },
                                            {
                                                "example_id": "bb5a097e-d506-4ace-857e-c7349bcc6c7f",
                                                "sense_id": "2f551ce4-eef7-32b0-a1fc-9ce81e3931d4",
                                                "text": "Один только старичок покачал укоризненно на каждого из нас головою и безмолвно испарился в темноте."
                                            },
                                            {
                                                "example_id": "0acc097a-4f0a-4388-85e5-f5428a279770",
                                                "sense_id": "2f551ce4-eef7-32b0-a1fc-9ce81e3931d4",
                                                "text": "Сейчас вернусь, устрою вас, а затем испарюсь, как дым."
                                            },
                                            {
                                                "example_id": "72c33b1e-3075-4053-859c-d78db663a40f",
                                                "sense_id": "2f551ce4-eef7-32b0-a1fc-9ce81e3931d4",
                                                "text": "Но только он лёг на диван и закрыл глаза, — сон моментально испарился."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71b412d0-781e-3bfd-a84c-0ab83f0122c2",
                                        "entry_id": "723eb228-9744-338b-9ef9-9ed1bd15a8d3",
                                        "glosses": [
                                            "перен. выйти"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72a093f2-b0d5-4efb-9c23-e95c72362bf9",
                                                "sense_id": "71b412d0-781e-3bfd-a84c-0ab83f0122c2",
                                                "text": "Из груди его испарился вздох."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
