                "entry_id": "67805011-5044-3f85-ab7f-7ea67e127e7a",
                "word": "kankeraar",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "3783b9d1-0ea4-4c63-9fb7-1812ac0781fa",
                        "entry_id": "67805011-5044-3f85-ab7f-7ea67e127e7a",
