                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b9feba1-7a8a-3e7d-9a88-59082291f636",
                        "entry_id": "1ee26be5-81d1-30eb-ade3-ca6e734c2b69",
                        "glosses": [
                            "Petite croûte."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "48628e4a-4aba-4518-82ab-ac3550f2b0dd",
                                "sense_id": "1b9feba1-7a8a-3e7d-9a88-59082291f636",
                                "text": "Manger une croustille de pain."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc023faa-f3bf-32ec-b216-4d7621edbf29",
                        "entry_id": "1ee26be5-81d1-30eb-ade3-ca6e734c2b69",
                        "glosses": [
                            "Petit repas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "476ecd9b-f043-415c-ab3e-391c15828936",
                                "sense_id": "cc023faa-f3bf-32ec-b216-4d7621edbf29",
                                "text": "je trouve cette vision fort plaisante de faire quelqu'un le maître du temps, du lieu et des mets de vos croustilles"
                            },
                            {
                                "example_id": "db576a41-84de-408e-b6f4-efdfb2e74a99",
                                "sense_id": "cc023faa-f3bf-32ec-b216-4d7621edbf29",
                                "text": "Il avait gardé des relations, trouvait de ci, de là ; quelques cachets à faire, en banlieue, un camarade pour lui payer la bleue, chaque soir, au « Café Français », et le crédit pour la croustille, chez nombre de marchands de vins[…]"
                            },
                            {
                                "example_id": "68b10eda-e6ac-4e77-956d-ad4519221a79",
                                "sense_id": "cc023faa-f3bf-32ec-b216-4d7621edbf29",
                                "text": "Tout leur fait envie, ça va donc être une « croustille » meilleure que tout !"
                            }
                        ]
                    },
                    {
                        "sense_id": "8556f421-c93e-32db-895a-120c9abf63b1",
                        "entry_id": "1ee26be5-81d1-30eb-ade3-ca6e734c2b69",
                        "glosses": [
                            "Chips."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e74590cc-0226-46aa-821d-0257ddc900ac",
                                "sense_id": "8556f421-c93e-32db-895a-120c9abf63b1",
                                "text": "Pour cette chronique, on m’a donné le mandat de mettre la main sur les pires choix de croustilles."
                            },
                            {
                                "example_id": "7f601087-f4e9-4134-900d-2d5c539ec6b2",
                                "sense_id": "8556f421-c93e-32db-895a-120c9abf63b1",
                                "text": "Les Québécois pourront bientôt se régaler de croustilles à base d’insectes produites localement et dont la saveur a été mise au point par le chef Daniel Vézina."
                            }
                        ]
                    }
                ],
