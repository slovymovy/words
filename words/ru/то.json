{
    "word_family": [
        "тот",
        "зато",
        "потому",
        "оттого",
        "притом",
        "поэтому",
        "то-то"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "ad7eded3-baea-35e8-b67c-049bf367c299",
                    "sense_definition": "Форма именительного или винительного падежа единственного числа среднего рода местоимения <w>тот</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "grammatical_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В <то> время мы жили в маленькой деревне.",
                            "target_lang_translations": {
                                "en": "At <that> time we lived in a small village.",
                                "cs": "V <té> době jsme žili v malé vesnici."
                            }
                        },
                        {
                            "text": "Подай мне, пожалуйста, <то> полотенце.",
                            "target_lang_translations": {
                                "en": "Please pass me <that> towel.",
                                "cs": "Podej mi, prosím, <ten> ručník."
                            }
                        }
                    ],
                    "common_phrases": [
                        "в то время",
                        "то есть",
                        "ни то ни сё"
                    ],
                    "target_lang_definitions": {
                        "en": "Form of the demonstrative pronoun \"that\" (neuter singular).",
                        "cs": "Tvar ukazovacího zájmena „ten“ ve středním rodě jednotného čísla."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "that",
                                "target_lang_sense_clarification": "demonstrative pronoun"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "ukazovací zájmeno středního rodu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "377d3d59-65a9-3db3-904d-d3e37baa3e15",
                    "sense_definition": "Указательное слово в главном предложении, соединяющее его с придаточным (часто используется перед союзами «что», «как», «чтобы»).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "correlative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я благодарен тебе за <то>, что ты мне помог.",
                            "target_lang_translations": {
                                "en": "I am grateful to you for <the fact> that you helped me.",
                                "cs": "Jsem ti vděčný za <to>, že jsi mi pomohl."
                            }
                        },
                        {
                            "text": "Всё зависит от <того>, как мы решим эту задачу.",
                            "target_lang_translations": {
                                "en": "Everything depends on <the way> we solve this problem.",
                                "cs": "Vše závisí na <tom>, jak tuto úlohu vyřešíme."
                            }
                        }
                    ],
                    "common_phrases": [
                        "то что",
                        "после того как",
                        "дело в том",
                        "несмотря на то"
                    ],
                    "target_lang_definitions": {
                        "en": "Correlative word in the main clause connecting it to a subordinate clause (often used before \"that\", \"how\", etc.).",
                        "cs": "Korelační výraz v hlavní větě, který ji spojuje s větou vedlejší (často před spojkami jako „že“, „jak“, „aby“)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "the fact",
                                "target_lang_sense_clarification": "used in phrases like 'the fact that'"
                            },
                            {
                                "target_lang_word": "that",
                                "target_lang_sense_clarification": "correlative pronoun"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "odkazovací zájmeno v hlavní větě"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fb1aff9-9012-3f11-85b5-02e4167acd02",
                    "sense_definition": "Употребляется для указания на ранее упомянутые обстоятельства, предметы или для противопоставления в устойчивых конструкциях.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне нужно и <то>, и другое, чтобы закончить работу.",
                            "target_lang_translations": {
                                "en": "I need both <that> and the other to finish the work.",
                                "cs": "Potřebuji <to> i ono, abych dokončil práci."
                            }
                        },
                        {
                            "text": "Более <того>, он даже не предупредил нас об опоздании.",
                            "target_lang_translations": {
                                "en": "More than <that>, he didn't even warn us about being late.",
                                "cs": "Navíc <toho>, ani nás nevaroval, že přijde pozdě."
                            }
                        }
                    ],
                    "common_phrases": [
                        "более того",
                        "кроме того",
                        "и то и другое"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to refer to previously mentioned circumstances or for contrast in set phrases.",
                        "cs": "Používá se k odkazu na dříve zmíněné okolnosti nebo k vyjádření kontrastu ve ustálených spojeních."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "that",
                                "target_lang_sense_clarification": "reference to previous topic"
                            },
                            {
                                "target_lang_word": "this",
                                "target_lang_sense_clarification": "in phrases like 'this and that'"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "odkaz na předmět nebo situaci"
                            },
                            {
                                "target_lang_word": "navíc",
                                "target_lang_sense_clarification": "ve smyslu 'kromě toho'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "89083b05-9588-3596-8c2c-4f8f3e34ed37",
                    "sense_definition": "Вторая часть составного союза (обычно «если…, то…»), вводящая главную часть предложения и обозначающая следствие или вывод.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "conditional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Если завтра будет хорошая погода, <то> мы поедем на дачу.",
                            "target_lang_translations": {
                                "en": "If the weather is good tomorrow, <then> we will go to the dacha.",
                                "cs": "Pokud bude zítra hezké počasí, <tak> pojedeme na chatu."
                            }
                        },
                        {
                            "text": "Раз ты дал обещание, <то> должен его выполнить.",
                            "target_lang_translations": {
                                "en": "Since you made a promise, <then> you must keep it.",
                                "cs": "Když jsi dal slib, <tak> ho musíš splnit."
                            }
                        }
                    ],
                    "common_phrases": [
                        "если не то",
                        "если так то"
                    ],
                    "target_lang_definitions": {
                        "en": "The second part of a conditional conjunction (usually \"if..., then...\"), introducing the consequence.",
                        "cs": "Druhá část podmiňovací spojky (obvykle „jestliže…, pak…“), uvádějící hlavní větu a označující důsledek."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "introduces the result in a conditional sentence"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "tak",
                                "target_lang_sense_clarification": "uvádí důsledek v podmínkové větě"
                            },
                            {
                                "target_lang_word": "pak",
                                "target_lang_sense_clarification": "uvádí důsledek v podmínkové větě"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e165acb-3295-33c3-99a6-0e09c7d973f1",
                    "sense_definition": "Повторяющийся союз, указывающий на смену или чередование действий, событий или состояний.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "alternation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На улице <то> светило яркое солнце, <то> лил сильный дождь.",
                            "target_lang_translations": {
                                "en": "Outside, <now> the bright sun was shining, <now> heavy rain was pouring.",
                                "cs": "Venku <jednou> svítilo jasné slunce, <podruhé> lilo jako z konve."
                            }
                        },
                        {
                            "text": "Он <то> смеялся над шуткой, <то> снова становился серьёзным.",
                            "target_lang_translations": {
                                "en": "He would <sometimes> laugh at the joke, <sometimes> become serious again.",
                                "cs": "On se <hned> smál vtipu, <hned> byl zase vážný."
                            }
                        }
                    ],
                    "common_phrases": [
                        "то одно то другое",
                        "то тут то там"
                    ],
                    "target_lang_definitions": {
                        "en": "Repeating conjunction indicating alternating actions, events, or states.",
                        "cs": "Opakovací spojka vyjadřující střídání dějů, událostí nebo stavů."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "now",
                                "target_lang_sense_clarification": "in 'now... now...' sequence"
                            },
                            {
                                "target_lang_word": "sometimes",
                                "target_lang_sense_clarification": "in 'sometimes... sometimes...' sequence"
                            },
                            {
                                "target_lang_word": "first",
                                "target_lang_sense_clarification": "in 'first... then...' sequence"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "jednou",
                                "target_lang_sense_clarification": "v konstrukci 'jednou... podruhé...'"
                            },
                            {
                                "target_lang_word": "hned",
                                "target_lang_sense_clarification": "v konstrukci 'hned... hned...'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf191e06-54c1-31e2-8639-5abb98a754d4",
                    "sense_definition": "Комплекс операций по поддержанию работоспособности транспортного средства (техническое обслуживание или осмотр).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Владелец автомобиля обязан регулярно проходить плановое <ТО>.",
                            "target_lang_translations": {
                                "en": "A car owner is obliged to undergo scheduled <maintenance> regularly.",
                                "cs": "Majitel automobilu je povinen pravidelně absolvovat plánovaný <servis>."
                            }
                        },
                        {
                            "text": "Стоимость <ТО> в этом году значительно выросла.",
                            "target_lang_translations": {
                                "en": "The cost of <servicing> has increased significantly this year.",
                                "cs": "Cena <technické prohlídky> letos výrazně vzrostla."
                            }
                        }
                    ],
                    "synonyms": [
                        "техобслуживание",
                        "техосмотр"
                    ],
                    "common_phrases": [
                        "пройти ТО",
                        "плановое ТО",
                        "талон ТО"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "аббревиатура"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Operations to maintain a vehicle's working condition (technical maintenance or inspection).",
                        "cs": "Soubor operací pro udržení provozuschopnosti vozidla (technická údržba nebo prohlídka)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "maintenance",
                                "target_lang_sense_clarification": "vehicle upkeep"
                            },
                            {
                                "target_lang_word": "service",
                                "target_lang_sense_clarification": "scheduled vehicle check-up"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "servis",
                                "target_lang_sense_clarification": "údržba vozidla"
                            },
                            {
                                "target_lang_word": "technická prohlídka",
                                "target_lang_sense_clarification": "povinná kontrola vozidla"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}