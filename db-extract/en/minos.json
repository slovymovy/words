    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2097dc18-039d-3301-96f5-a197bfef20f2",
                "word": "Minos",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "16f0f9c3-4a52-3ba0-8caf-f64cb7934ef7",
                        "entry_id": "2097dc18-039d-3301-96f5-a197bfef20f2",
                        "glosses": [
                            "The mythological first king of Crete, a son of Zeus by Europa, who imprisoned the Minotaur in a labyrinth and after death was made a judge of the dead in Hades; a putative corresponding historical person."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "5f0900d9-1091-4f8b-8293-9950f058a6d5",
                                "sense_id": "16f0f9c3-4a52-3ba0-8caf-f64cb7934ef7",
                                "text": "At length we arrived at the gate of Elysium. Here was a prodigious crowd of spirits waiting for admittance, some of whom were admitted, and some were rejected; for all were strictly examined by the porter, whom I soon discovered to be the celebrated judge Minos."
                            },
                            {
                                "example_id": "6c28437a-8969-4d02-a5fb-078bf188ca7a",
                                "sense_id": "16f0f9c3-4a52-3ba0-8caf-f64cb7934ef7",
                                "text": "That the Cyclades were subject to Minos, is confirmed by numerous traces; and the general belief of the ancients was, that he founded colonies even in Lemnos and Thrace."
                            },
                            {
                                "example_id": "0ea4b93c-b45c-4800-a5db-05553672c736",
                                "sense_id": "16f0f9c3-4a52-3ba0-8caf-f64cb7934ef7",
                                "text": "Whether or not Minos really existed and ruled at Knossos, the ruins on Kephala hill today are known by the name Evans gave them."
                            }
                        ]
                    }
                ],
                "translations": [
