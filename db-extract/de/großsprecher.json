                "senses": [
                    {
                        "sense_id": "f364df5c-353e-3dc6-b086-f564c121e639",
                        "entry_id": "dd01158d-afcb-3f5f-a0b5-4df9864e55cb",
                        "glosses": [
                            "Angeber; jemand, der mehr verspricht als er halten kann"
                        ],
                        "tags": [
                            "pejorativ"
                        ],
                        "examples": [
                            {
                                "example_id": "8789983b-27df-4255-a36d-68f1a4e62ecc",
                                "sense_id": "f364df5c-353e-3dc6-b086-f564c121e639",
                                "text": "Kurt ist ein wahrer Großsprecher, der den lieben, langen Tag schwadroniert, wenn man ihn nicht aufhält."
                            },
                            {
                                "example_id": "b41e22de-2075-4bb8-905e-958f1b8ee65b",
                                "sense_id": "f364df5c-353e-3dc6-b086-f564c121e639",
                                "text": "„Der Großsprecher hatte alle einschlägigen Vokabeln zur Verfügung.“"
                            },
                            {
                                "example_id": "0f59af4d-ec4c-4073-b946-9b9439378f16",
                                "sense_id": "f364df5c-353e-3dc6-b086-f564c121e639",
                                "text": "„Schmit steckte das Geld mit größter Ruhe in seine Börse und stellte sich, ohne dem Großsprecher zu antworten, zwischen zwei Bäume, die ungefähr vier Schritt auseinanderstanden.“"
                            },
                            {
                                "example_id": "eb2ec5d2-2edb-4487-b836-cd4fce9ba588",
                                "sense_id": "f364df5c-353e-3dc6-b086-f564c121e639",
                                "text": "„So sank ein Popanz der Macht, ein Großsprecher nach dem andern hin, während ein teuflischer Gestank aufstieg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddc70aca-e419-4f82-8c57-11bad21099f4",
                        "source_entry_id": "dd01158d-afcb-3f5f-a0b5-4df9864e55cb",
                        "source_sense_id": "f364df5c-353e-3dc6-b086-f564c121e639",
                        "source_sense_description": "pejorativ: Angeber; jemand, der mehr verspricht als er halten kann",
                        "target_lang_word": "show-off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "show-off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d348d115-a0f4-37d0-a2d2-23b617372f21",
                                        "entry_id": "ba9cab3a-d8fe-3b35-8956-0349f2eed8c4",
                                        "glosses": [
                                            "One who shows off; a person given to egotistically demonstrating their prowess or ability."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28745b27-9973-467a-ae25-1882516dce7b",
                                                "sense_id": "d348d115-a0f4-37d0-a2d2-23b617372f21",
                                                "text": "Quit being such a show-off, before someone gets hurt."
                                            },
                                            {
                                                "example_id": "a8055650-3827-445a-b20b-cacf944fff6f",
                                                "sense_id": "d348d115-a0f4-37d0-a2d2-23b617372f21",
                                                "text": "“Don’t tell me what to do, you double-crossing little show-off!” he grated. “Here, stand aside there, and let a man pass.”"
                                            },
                                            {
                                                "example_id": "8ffda4ea-a9fb-4f2c-8c57-7142f540c7fb",
                                                "sense_id": "d348d115-a0f4-37d0-a2d2-23b617372f21",
                                                "text": "He was still a tad disgruntled about being used as a work-horse, but he allowed this feeling to be repressed in favor of the pomp and circumstance of the parade. He was, after all, a bit of a show-off when he could get away with it. And that is a real understatement!"
                                            },
                                            {
                                                "example_id": "2127bd20-1a9a-415c-930f-5524634742ec",
                                                "sense_id": "d348d115-a0f4-37d0-a2d2-23b617372f21",
                                                "text": "Totally obsessive fans are a good measure of a ride’s popularity, but they’re kind of a pain in the ass, too. They lipsynch the soundtrack, cadge souvenirs and pester you with smarmy, show-off questions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a29ca88-224e-4813-8b7d-398e9b2c96c2",
                        "source_entry_id": "dd01158d-afcb-3f5f-a0b5-4df9864e55cb",
                        "source_sense_id": "f364df5c-353e-3dc6-b086-f564c121e639",
