            "senses": [
                {
                    "sense_id": "aa3b88d1-3ac7-3adf-85ed-cb47e3ee1fbc",
                    "sense_definition": "Quitter les rails, en parlant d'un train ou d'un convoi ferroviaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heureusement, aucun passager n'a été blessé lorsque le train a <w>déraillé</w> près de la gare."
                        },
                        {
                            "text": "Un obstacle tombé sur la voie a fait <w>dérailler</w> la locomotive à grande vitesse."
                        }
                    ],
                    "common_phrases": [
                        "train qui déraille",
                        "faire dérailler un train"
                    ]
                },
                {
                    "sense_id": "78ed0fd7-b65f-329a-a1b0-15c99b2b9683",
                    "sense_definition": "Sauter des pignons ou des plateaux, en parlant de la chaîne d'une bicyclette.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cyclisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a dû s'arrêter au bord de la route car sa chaîne de vélo venait de <w>dérailler</w>."
                        },
                        {
                            "text": "En changeant brusquement de vitesse dans la montée, j'ai souvent peur de faire <w>dérailler</w> mon vélo."
                        }
                    ],
                    "common_phrases": [
                        "chaîne qui déraille"
                    ]
                },
                {
                    "sense_id": "7834644b-f735-3e05-9906-ef438d4ef1c1",
                    "sense_definition": "Cesser de fonctionner normalement ou échouer, en parlant d'un mécanisme ou d'un processus.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fonctionnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette décision inattendue risque de faire <w>dérailler</w> l'ensemble des négociations de paix."
                        },
                        {
                            "text": "Depuis la mise à jour logicielle, l'horloge interne de mon ordinateur <w>déraille</w> complètement."
                        }
                    ],
                    "common_phrases": [
                        "faire dérailler les négociations",
                        "machine qui déraille"
                    ]
                },
                {
                    "sense_id": "be50fa07-e4ba-32dd-aa01-67d8a18bd4c5",
                    "sense_definition": "Perdre la raison, tenir des propos incohérents ou divaguer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne prête pas attention à ses propos bizarres, il commence un peu à <w>dérailler</w> avec l'âge."
                        },
                        {
                            "text": "Tu racontes n'importe quoi aujourd'hui, tu <w>dérailles</w> complètement !"
