                        "examples": [
                            {
                                "example_id": "234a2313-6b26-44e1-8b6f-2d98480729a8",
                                "sense_id": "8e971be4-6056-3624-ba86-bd0beaef3eac",
                                "text": "Only two pages of the Pushkin are given to the lyric, and these to such relatively Englishable items as a ballad (\"The Upas Tree\") and the \"Exegi Monumentum,\" which has had its hundreds of English predecessors."
                            },
                            {
                                "example_id": "140e145e-4298-47a2-b969-6c51e2380009",
                                "sense_id": "8e971be4-6056-3624-ba86-bd0beaef3eac",
                                "text": "The term is gemes, and the vehicle it provides for metaphoring is Englishable as 'pinching a plump baby in affection'."
                            },
                            {
                                "example_id": "032bc36e-602c-4fdc-a44d-8ea7f4c0942b",
                                "sense_id": "8e971be4-6056-3624-ba86-bd0beaef3eac",
                                "text": "But this isn't an askable question. It isn't Englishable."
                            }
                        ]
