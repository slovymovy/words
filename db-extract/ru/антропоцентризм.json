                    {
                        "translation_id": "9f8be7f4-ef1e-4a24-9cb0-d6b5e3801237",
                        "source_entry_id": "9163b2f5-df36-3732-aaa8-8715193f8d7f",
                        "source_sense_id": "d0d066e8-619b-377e-bed6-122137d7b368",
                        "target_lang_word": "Anthropozentrismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anthropozentrismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5dccb30b-2568-3ad0-b9fb-ab215969c142",
                                        "entry_id": "c5138818-93b1-38a8-9cc5-878a8ee6af1c",
                                        "glosses": [
                                            "Position, nach der sich der Mensch selbst als Mittelpunkt der weltlichen Realität versteht"
                                        ],
                                        "tags": [
                                            "Weltanschauung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4827523f-c3d4-4940-bd6c-f3c5df97312f",
                                                "sense_id": "5dccb30b-2568-3ad0-b9fb-ab215969c142",
                                                "text": "„Der Anthropozentrismus ist ein mehrdeutiger Begriff. Zum einen bezeichnet er eine epistemische Tatsache, und zwar, dass jedes ethische Modell von Menschen gemacht wurde und insofern ein menschliches System darstellt, welches nur ausgehend vom Menschen zu verstehen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4da1ae94-1959-49ab-ba5d-26e5274f71f5",
                        "source_entry_id": "9163b2f5-df36-3732-aaa8-8715193f8d7f",
                        "source_sense_id": "d0d066e8-619b-377e-bed6-122137d7b368",
                        "target_lang_word": "Anthropozentrizität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anthropozentrizität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5106c2e7-6ab2-3cdc-be01-966318d87cd4",
                                        "entry_id": "a8f4b8a7-317d-3b9e-acd4-17f47391ace7",
                                        "glosses": [
                                            "Betrachtungsweise vom menschlichen Standpunkt aus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4574a2d-3f7f-455d-bc8a-222c3b6d9dbe",
                                                "sense_id": "5106c2e7-6ab2-3cdc-be01-966318d87cd4",
                                                "text": "Will man mit Nietzsche die Überwindung der Anthropozentrizität denken und will man ihr gegen Nietzsche eine andere Ausgestaltung geben, hat man, wie er es in den genannten Worten Zarathustras gesagt hat, ein Seher – man könnte auch sagen ‚Visionär‘ – zu sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e95e0cb-1d6c-4ee3-bfdd-a4ee644f61d3",
                        "source_entry_id": "9163b2f5-df36-3732-aaa8-8715193f8d7f",
                        "source_sense_id": "d0d066e8-619b-377e-bed6-122137d7b368",
                        "target_lang_word": "antropocentrisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antropocentrisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "68360b2d-379c-319b-9aef-e997c248f9cb",
                                        "entry_id": "cdd4b05c-6b16-34b1-a73e-cc45ffeaabcd",
                                        "glosses": [
                                            "visie waarin de mens het middelpunt van het bestaan is en de mens de maat is waar al het andere aan afgemeten wordt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16be4c14-0af0-4785-8fe7-dae973b3d55b",
                                                "sense_id": "68360b2d-379c-319b-9aef-e997c248f9cb",
                                                "text": "⧖ Met dit drietal voor oogen onderzoekt nu Fezer verder de konsekwente theorie van het darstellendes Handeln. Ook hier het verkeerde antropocentrisme naar het oordeel van Schaeder."
                                            }
                                        ]
