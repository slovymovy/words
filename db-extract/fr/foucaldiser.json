                "senses": [
                    {
                        "sense_id": "3e6ac022-768a-38ff-8f28-b84867c505e4",
                        "entry_id": "147f3dc9-3dae-3e6e-b817-a6e738bc008c",
                        "glosses": [
                            "Donner un caractère foucaldien (faisant penser au philosophe Michel Foucault) à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37759588-a73d-40c0-a969-4efa6373c380",
                                "sense_id": "3e6ac022-768a-38ff-8f28-b84867c505e4",
                                "text": "Elle n’est en fait ni l’une ni l'autre —Heidegger ne répond pas à Foucault, Foucault ne questionne pas Heidegger : je n’entends ni foucaldiser l’un ni heideggérianiser l’autre."
                            },
                            {
                                "example_id": "1fb08249-2139-44be-9a7a-cebd753e763c",
                                "sense_id": "3e6ac022-768a-38ff-8f28-b84867c505e4",
                                "text": "Il aurait été sans doute plus simple de « foucaldiser » ma recherche, de ne mettre en avant que ce qui peut se lire en termes foucaldiens et d’y ajouter les citations du « maître »."
                            }
                        ]
                    }
                ],
