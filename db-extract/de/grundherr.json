                    {
                        "form_id": "176ea396-f634-4373-8783-4679aa879903",
                        "entry_id": "035a573a-0043-3554-a2e2-71d2f58fa270",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Grundherren"
                    },
                    {
                        "form_id": "cddc68af-c945-46ca-ae0f-fabcfb256c86",
                        "entry_id": "035a573a-0043-3554-a2e2-71d2f58fa270",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Grundherren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50f31a8b-b46d-3dce-92e0-033e28f84b62",
                        "entry_id": "035a573a-0043-3554-a2e2-71d2f58fa270",
                        "glosses": [
                            "Grundbesitzer mit weitreichenden Verwaltungs- und Gerichts-, und Polizeifunktionen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "8c6ce5c7-bc17-47e8-bd91-befcdcd7a852",
                                "sense_id": "50f31a8b-b46d-3dce-92e0-033e28f84b62",
                                "text": "„Für die Sicherung des wirtschaftlichen Erfolges hatten die Grundherren auch zu sorgen, indem sie ihren Bauern ertragreiches Saatgut, bestes Zugvieh und die erforderlichen Gerätschaften zur Verfügung stellten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ad9b9199-ac80-3e33-ae43-eacbdfb59988",
                        "entry_id": "035a573a-0043-3554-a2e2-71d2f58fa270",
                        "glosses": [
                            "Person, die Grundbesitz hat"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8903803b-b489-4a06-b066-a0f8a38aab1d",
                                "sense_id": "ad9b9199-ac80-3e33-ae43-eacbdfb59988",
                                "text": "„Doch vom August letzten Jahres an mußte der arabische Grundherr zusehen, wie auf seinem Boden eine israelische Siedlung entstand.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a464a37e-678a-43fd-aee3-5ac70f9e9c5d",
                        "source_entry_id": "035a573a-0043-3554-a2e2-71d2f58fa270",
                        "source_sense_id": "50f31a8b-b46d-3dce-92e0-033e28f84b62",
                        "target_lang_word": "seigneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seigneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e339452-fb4b-3e01-8119-19fd1bfa9763",
                                        "entry_id": "327bd2a8-91e6-3fb2-9e92-c0173df22113",
                                        "glosses": [
                                            "Maître, possesseur d’un pays, d’un État, d’une terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce0c157d-43ce-43b0-96b2-d1d5056daa89",
                                                "sense_id": "4e339452-fb4b-3e01-8119-19fd1bfa9763",
                                                "text": "N’est-il pas nécessaire de faire en sorte que les seigneurs s’occupent avec plus de vigilance dans leurs terres de l’administration de la justice civile, criminelle, et des règlements de police ?"
                                            },
                                            {
                                                "example_id": "034d173f-c0e1-4c65-89eb-a5ac3eafcf75",
                                                "sense_id": "4e339452-fb4b-3e01-8119-19fd1bfa9763",
                                                "text": "Écoutez bien, je dis pour changer : O bon peuple de Paris ! vous êtes un tas de niais, et vos seigneurs, vos nobles de robe et d’épée, ne sont que d’hypocrites fraudeurs et de fieffés escogriffes !"
                                            },
                                            {
                                                "example_id": "c64c921d-769b-4029-9cf0-019d43b153dc",
                                                "sense_id": "4e339452-fb4b-3e01-8119-19fd1bfa9763",
                                                "text": "D’une unité et d’une simplicité plus larges que celles de l’Empire romain, le monde passa, d’un seul coup, à une fragmentation aussi complète que celle du moyen–âge, à la période des seigneurs féodaux, brigands et pillards."
                                            },
                                            {
                                                "example_id": "866e1ee6-d6df-4795-8629-c43b1c062f41",
                                                "sense_id": "4e339452-fb4b-3e01-8119-19fd1bfa9763",
                                                "text": "Il était difficile aux juifs d’échapper à leur sort, car, étant serfs de leurs seigneurs, ils n’avaient pas le droit de se déplacer comme ils l’auraient voulu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16dfec43-44b8-3c0f-ba10-b2bc4ca9141c",
                                        "entry_id": "327bd2a8-91e6-3fb2-9e92-c0173df22113",
                                        "glosses": [
                                            "Titre que l’on donne à quelques personnes distinguées par leur dignité ou par leur rang, pour leur faire plus d’honneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20522a3e-8256-44b3-8463-7ac635a61359",
                                                "sense_id": "16dfec43-44b8-3c0f-ba10-b2bc4ca9141c",
                                                "text": "C’est un petit seigneur, se dit d’un homme qui affecte de l’importance et qui n’en a pas."
                                            },
                                            {
                                                "example_id": "b4a0f05a-0728-414e-8d3a-5dca963e55a8",
                                                "sense_id": "16dfec43-44b8-3c0f-ba10-b2bc4ca9141c",
                                                "text": "Haut et puissant seigneur."
                                            },
                                            {
                                                "example_id": "a109cff5-3977-48be-b7ba-4b3d368feb58",
                                                "sense_id": "16dfec43-44b8-3c0f-ba10-b2bc4ca9141c",
                                                "text": "Un grand seigneur."
                                            },
                                            {
                                                "example_id": "02026506-061f-4d38-8eef-bfdf85f43fb7",
                                                "sense_id": "16dfec43-44b8-3c0f-ba10-b2bc4ca9141c",
                                                "text": "Il fait le grand seigneur."
                                            },
                                            {
                                                "example_id": "75bc66ed-51fd-4f7a-a2ee-903dc6165548",
                                                "sense_id": "16dfec43-44b8-3c0f-ba10-b2bc4ca9141c",
                                                "text": "Se donner des airs de grand seigneur."
                                            },
                                            {
                                                "example_id": "4a699659-bd6c-4513-8e95-7af7c2042598",
                                                "sense_id": "16dfec43-44b8-3c0f-ba10-b2bc4ca9141c",
                                                "text": "Le Grand seigneur : se disait du Sultan."
                                            },
                                            {
                                                "example_id": "320cc75b-a3c7-448b-b466-3af685b40faf",
                                                "sense_id": "16dfec43-44b8-3c0f-ba10-b2bc4ca9141c",
                                                "text": "Vivre en grand seigneur : vivre sans rien faire et magnifiquement."
                                            },
                                            {
                                                "example_id": "934be1d3-1733-4ea4-8551-64dcfe57ff11",
                                                "sense_id": "16dfec43-44b8-3c0f-ba10-b2bc4ca9141c",
                                                "text": "Vêtu, logé comme un grand seigneur : très bien vêtu, très bien logé."
                                            },
                                            {
                                                "example_id": "a586b266-8f84-413f-b820-36cd1d7ed2c0",
                                                "sense_id": "16dfec43-44b8-3c0f-ba10-b2bc4ca9141c",
                                                "text": "« Vous verrez des choses, avait-il dit alors, que bien peu de gens ont vues. » Il tint parole grandement, en seigneur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f9f253a-8bf5-349e-84dd-2ecdcfcf9a2c",
                                        "entry_id": "327bd2a8-91e6-3fb2-9e92-c0173df22113",
                                        "glosses": [
                                            "Par plaisanterie, une femme dit de son mari :"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
