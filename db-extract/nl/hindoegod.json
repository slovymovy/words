                        "examples": [
                            {
                                "example_id": "138f3273-b5ed-4c95-b2eb-9d4eeb24d1f9",
                                "sense_id": "46480c80-d0b3-35d1-8b51-f84bb1904eb8",
                                "text": "De optocht volgde een route langs vele tempels in het district Satna, in de centrale deelstaat Madhya Pradesh. Ongeveer vijftigduizend mensen namen deel aan de processie voor Somvati Amavasya, een feestdag ter ere van de hindoegod Ram."
                            },
                            {
                                "example_id": "ed97223d-3b5b-4760-a001-48b130b67ccb",
                                "sense_id": "46480c80-d0b3-35d1-8b51-f84bb1904eb8",
                                "text": "Van de god Aiyanar zijn uit die tijd slechts enkele bronzen tempelbeelden bekend. De hindoegod wordt vooral vereerd op het Zuid-Indiase platteland. Aiyanar zit op een lotustroon in een yogahouding, de haren staan wijd uit en hij draagt een hoofdtooi met sieraden."
                            },
                            {
                                "example_id": "5f1e7906-48a2-4fab-b457-aa1448852590",
                                "sense_id": "46480c80-d0b3-35d1-8b51-f84bb1904eb8",
                                "text": "Twee beelden van de hindoegod Shiva keren uit Australië naar India terug. Premier Tony Abbott zal beide kunstwerken meenemen tijdens een bezoek aan het land, meldden Australische en Indiase media vrijdag."
                            }
                        ]
