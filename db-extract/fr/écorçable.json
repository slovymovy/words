                        "examples": [
                            {
                                "example_id": "f38be63b-288f-4ec0-83ca-8f63cf8c2fd6",
                                "sense_id": "0a1aa4be-578e-3dd5-8aad-a35eefbb831b",
                                "text": "Aussi est-il rare que tout le bois écorçable d’une coupe en exploitation puisse être décortiqué, et arrive-t-il souvent que la production générale en écorce soit inférieure aux besoins de la tannerie."
                            },
                            {
                                "example_id": "ed47bdb4-c30e-4d90-b9d2-f179616ab57f",
                                "sense_id": "0a1aa4be-578e-3dd5-8aad-a35eefbb831b",
                                "text": "L’espèce est écorçable à partir de la sixième ou huitième année, et jusqu’à la vingtième, après laquelle le tronc commence à se détériorer et est attaqué par les insectes."
                            },
                            {
                                "example_id": "a6461c6e-e575-44f0-8998-8f835a092165",
                                "sense_id": "0a1aa4be-578e-3dd5-8aad-a35eefbb831b",
                                "text": "Ces faits conjugués font qu’un taillis écorçable - dans les seules contrées, d’ailleurs, qui prévoiraient cet écorçage - ne serait guère majoré de valeur ; …."
                            }
