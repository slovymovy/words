                                                "sense_id": "28cb0a73-67c9-3619-8fea-e9af9849c4c3",
                                                "text": "Harvey saw with disgust that there were no sheets on his bed-place. He was lying on a piece of dingy ticking full of lumps and nubbles."
                                            }
