            },
            {
                "entry_id": "56717198-b88f-3c74-bc79-5cd0281c4508",
                "word": "Maximalist",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "77aa33b6-72f6-4680-b52b-9eb421d48306",
                        "entry_id": "56717198-b88f-3c74-bc79-5cd0281c4508",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more Maximalist"
                    },
                    {
                        "form_id": "e2baf6c1-2c7e-4d67-8582-058c77665b21",
                        "entry_id": "56717198-b88f-3c74-bc79-5cd0281c4508",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most Maximalist"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea818e01-df7c-34b2-8805-7ac8dee75fae",
                        "entry_id": "56717198-b88f-3c74-bc79-5cd0281c4508",
