                                "target_senses": [
                                    {
                                        "sense_id": "f214ddd5-4fce-34e5-a1c8-ae6503b5e64b",
                                        "entry_id": "55046576-32f8-3308-90b9-a5b18ffffa7d",
                                        "glosses": [
                                            "begin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8b3ce44-386a-4c58-a08a-2283550b329d",
                                                "sense_id": "f214ddd5-4fce-34e5-a1c8-ae6503b5e64b",
                                                "text": "De aanvang van het concert is om 20.00 uur."
                                            },
                                            {
                                                "example_id": "88f202ab-e336-4514-b2c7-3d868e1e751d",
                                                "sense_id": "f214ddd5-4fce-34e5-a1c8-ae6503b5e64b",
                                                "text": "Tante Sophie, attent als altijd en beseffend dat het goed voor me zou zijn om voor de aanvang van de lessen iets over mijn medeleerlingen te weten, nodigde de twee meisjes uit om op Rowans House thee te komen drinken."
                                            },
                                            {
                                                "example_id": "50a0a694-fb37-481a-a535-0d33df6e9a29",
                                                "sense_id": "f214ddd5-4fce-34e5-a1c8-ae6503b5e64b",
                                                "text": "Daarom sloop hij een kwartier voor aanvang naar de keuken van het paleis en dronk daar, staand voor de ijskast, binnen drie minuten twee ijskoude blikjes Heineken helemaal leeg."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aanvang",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d24375ba-0daa-303a-81e4-8edabd89823a",
                                        "entry_id": "ca6aeef4-e7af-3bc3-8df9-5a4da4b32df9",
                                        "glosses": [
                                            "eerste persoon enkelvoud tegenwoordige tijd van aanvangen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "with-subordinate-clause"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0547ddce-d38f-4a74-b8f9-4d66fda801c6",
                                                "sense_id": "d24375ba-0daa-303a-81e4-8edabd89823a",
                                                "text": "... dat ik aanvang."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
