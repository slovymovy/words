                "senses": [
                    {
                        "sense_id": "fc56dd97-805f-31e7-bd56-3d288ae2ba76",
                        "entry_id": "24562f8f-06c8-34f3-9924-6ac5d7c0d39b",
                        "glosses": [
                            "etwas, dessen Besitz als unbedingt notwendig oder sehr erstrebenswert angesehen wird"
                        ],
                        "tags": [
                            "oft in Bezug auf modisches Zubehör und Ähnliches"
                        ],
                        "examples": [
                            {
                                "example_id": "86922679-b809-43c0-bf49-33c43225f8e0",
                                "sense_id": "fc56dd97-805f-31e7-bd56-3d288ae2ba76",
                                "text": "„Das neue Must-have des Sommers ist alles andere als langweilig. Bunt, verziert und in unterschiedlichen Materialien. Der Blazer gehört in jeden Kleiderschrank.“"
                            },
                            {
                                "example_id": "f7151ca2-9d1d-4b6b-9f56-c9f7196b02b7",
                                "sense_id": "fc56dd97-805f-31e7-bd56-3d288ae2ba76",
                                "text": "„Tattoos tragen heute nicht mehr nur Menschen mit einer Vorliebe für Körperkult, sondern werden immer mehr zu einem Must-have.“"
                            },
                            {
                                "example_id": "3954e0f7-d40b-447e-b0a0-0d4841d4dd5f",
                                "sense_id": "fc56dd97-805f-31e7-bd56-3d288ae2ba76",
                                "text": "„Die Bauherren-Haftpflichtversicherung ist ein Must-have.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc6abe0a-13fd-4c32-945b-bff832cde30f",
                        "source_entry_id": "24562f8f-06c8-34f3-9924-6ac5d7c0d39b",
                        "source_sense_id": "fc56dd97-805f-31e7-bd56-3d288ae2ba76",
                        "target_lang_word": "must-have",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "must-have",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "695d21ad-20b1-3438-b4f7-73809fe914b2",
                                        "entry_id": "56215c8f-a49d-3d1a-bc0b-75afd64845f7",
                                        "glosses": [
                                            "Essential to own."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6512cf49-f4ff-48f7-b535-693506575d0a",
                                                "sense_id": "695d21ad-20b1-3438-b4f7-73809fe914b2",
                                                "text": "The must-have toy is the apotheosis of the marketing of toys as fashion accessories."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "must-have",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e920858-0da2-359b-9544-dcfaac0d11ad",
                                        "entry_id": "af60dcf2-d2b5-3b74-b4d2-370a7ce83774",
                                        "glosses": [
                                            "An item that one must own, or a feature that is essential to a service, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ee9dfb-46f8-4553-a34c-8601d905bf03",
                                                "sense_id": "6e920858-0da2-359b-9544-dcfaac0d11ad",
                                                "text": "The selfie-stick is this year's must-have."
                                            },
                                            {
                                                "example_id": "0fe14326-417d-4e32-8d31-1eec2b90c4b4",
                                                "sense_id": "6e920858-0da2-359b-9544-dcfaac0d11ad",
                                                "text": "There's a huge gulf between “must-have” and “nice-to-have” products. If you sell a nice-to-have product, no one, not even your best friends, will use it long term. We all focus on must-haves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7415dec-52df-4578-8434-77e6b901f476",
                        "source_entry_id": "24562f8f-06c8-34f3-9924-6ac5d7c0d39b",
                        "source_sense_id": "fc56dd97-805f-31e7-bd56-3d288ae2ba76",
                        "target_lang_word": "must",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "must",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06e9e414-8ca3-3aed-8321-47dc3f255820",
                                        "entry_id": "3be23fba-1a08-32a2-836d-31d07cd632be",
                                        "glosses": [
                                            "Devoir incontournable ; obligation sociale."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "267e3179-475e-464c-a09e-0854233dcd43",
                                                "sense_id": "06e9e414-8ca3-3aed-8321-47dc3f255820",
                                                "text": "Sommets de l’érotisme à l’époque, le film Emmanuelle et son affiche firent de Sylvia Kristel une star, et du fauteuil, un must."
                                            },
                                            {
                                                "example_id": "166d4f10-0796-4608-8a7b-5ea176bf7631",
                                                "sense_id": "06e9e414-8ca3-3aed-8321-47dc3f255820",
                                                "text": "Être ou connaître un Belge, aller à Bruxelles ou à Gand en Thalys, s’y retrouver dans nos bières d’abbaye, fait dorénavant partie des musts. Même l’humour, sur les ondes des radios françaises, est aux mains des Belges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f58dd7b6-4b1c-3f7b-81fd-dc3ff608c48c",
                                        "entry_id": "3be23fba-1a08-32a2-836d-31d07cd632be",
                                        "glosses": [
                                            "Chose superficielle mais plaisante."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "169b68d9-21c0-4fab-a88e-9335a28ed9a8",
                                                "sense_id": "f58dd7b6-4b1c-3f7b-81fd-dc3ff608c48c",
                                                "text": "En revanche, il s’agit d’une des seules voitures [la Citroen AX] comportant des porte-bouteilles dans les portières avant : un must !"
                                            },
                                            {
                                                "example_id": "89280fe7-79cd-46fd-983b-ed51ab783e8b",
                                                "sense_id": "f58dd7b6-4b1c-3f7b-81fd-dc3ff608c48c",
                                                "text": "La fête des Mères s’affiche partout dans le centre commercial. À Auchan, un espace lui est réservé, rempli de robots, d’aspirateurs, de machines à café – le must apparemment – parfums, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce39a627-2e4a-32ad-a452-eebbe5859210",
                                        "entry_id": "3be23fba-1a08-32a2-836d-31d07cd632be",
                                        "glosses": [
                                            "Ce qu’il y a de mieux."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
