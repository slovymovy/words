                    {
                        "translation_id": "cb6e274b-fa3c-433c-a77d-f3a04ff38a2d",
                        "source_entry_id": "df1b1f5d-1ecd-3d03-a53a-06fde88d730b",
                        "source_sense_id": "649c13e9-7a3f-3f14-a373-12af8f2754a7",
                        "target_lang_word": "microplastic",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microplastic",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7c5fd297-8164-35e7-9f29-96ac5ddf46fa",
                                        "entry_id": "7e54997e-ce7c-3901-a233-f17e1ee3ff59",
                                        "glosses": [
                                            "kleine deeltjes plastic die in het milieu met name in zeeën en oceanen voor problemen leiden doordat ze in de voedselketen terecht komen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65231574-8da6-43d8-8360-a29977b12818",
                                                "sense_id": "7c5fd297-8164-35e7-9f29-96ac5ddf46fa",
                                                "text": "De microplastics zitten onder andere in tandpasta en cosmetica en zullen in het milieu terecht komen omdat waterzuiveringsinstallaties deze er niet uit filteren."
                                            },
                                            {
                                                "example_id": "d9d20ee0-135a-4a1a-891f-9f26e28bce0d",
                                                "sense_id": "7c5fd297-8164-35e7-9f29-96ac5ddf46fa",
                                                "text": "Er was al langer bekend dat microplastics uit cosmetica in ons water terechtkomen. Maar uit dit onderzoek komt naar voren dat de vervuiling door kledingvezels nog vele malen groter is\", aldus PSF. Het gebruik van synthetische vezels in kleding is de afgelopen dertig jaar sterk gestegen."
                                            },
                                            {
                                                "example_id": "11bd9ebd-ab79-4815-beea-84c9aff750ec",
                                                "sense_id": "7c5fd297-8164-35e7-9f29-96ac5ddf46fa",
                                                "text": "De vrees is ook dat elektrische auto’s door bandenslijtage meer microplastics in het milieu brengen. Klimaatwetenschappers stellen daarbij wel dat een elektrische auto in zijn gehele levenscyclus zuiniger is, en dus klimaatvriendelijker, dan een benzineauto."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
