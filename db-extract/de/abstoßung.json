                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b5d1592-9ee7-4b81-a671-73b6c0cf3ce6",
                                "sense_id": "ecdb5653-892f-3f2d-9d1e-2c230953b8fa",
                                "text": "Die Abstoßung von Transplantaten kommt häufiger vor als allgemein bekannt ist.",
                                "translation": "De afstoting van transplantaten komt meer voor dan algemeen bekend is."
                            }
                        ]
                    },
                    {
                        "sense_id": "e462081c-dbb2-3ead-bbf2-4a0a797ec581",
                        "entry_id": "eaecc4a9-2b06-354f-97db-c1cdc4fd3183",
                        "glosses": [
                            "afstoting (van aandelen, enz.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7de3909-9b3d-4049-9074-7410f575fb81",
                                "sense_id": "e462081c-dbb2-3ead-bbf2-4a0a797ec581",
                                "text": "Sie drohten dem Unternehmen mit der Abstoßung von Aktien.",
                                "translation": "Ze dreigden de onderneming met de afstoting van aandelen."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd28edcb-5b79-3dcd-a083-c609648d88b1",
                        "entry_id": "eaecc4a9-2b06-354f-97db-c1cdc4fd3183",
                        "glosses": [
                            "eliminatie (van schulden, enz.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9b10819-6aea-4e67-9ca9-9d45caa1aa3b",
                                "sense_id": "dd28edcb-5b79-3dcd-a083-c609648d88b1",
                                "text": "Der Bund beschloss einen Teil der Steuereinnahmen für die Abstoßung von Schulden zu verwenden.",
                                "translation": "De bond besloot een deel van de belastingsinnames te gebruiken voor de eliminatie van schulden."
                            }
                        ]
