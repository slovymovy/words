                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0979017-9904-4721-a4ce-ce132b67a960",
                                                "sense_id": "8df65769-acde-3a17-a6ca-a9e78bbd92b0",
                                                "text": "Kleinere Reparaturen führe ich eigenhändig durch."
                                            },
                                            {
                                                "example_id": "70556559-0897-4383-bf13-bdafbb35e174",
                                                "sense_id": "8df65769-acde-3a17-a6ca-a9e78bbd92b0",
                                                "text": "Ein Testament muss immer eigenhändig geschrieben sein."
                                            }
