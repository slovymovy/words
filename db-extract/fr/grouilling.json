                        "examples": [
                            {
                                "example_id": "7ec1745d-8c65-485c-aa7f-99c808c439c4",
                                "sense_id": "1731d568-b472-38a9-a5db-28cfd04fa771",
                                "text": "Dans mes grouillings, j’ai pu économiser l’argent du billet de voyage. Tu pourras voyager pour les obsèques de tes parents."
                            },
                            {
                                "example_id": "f19f5767-fff8-4910-a242-7e1f2dc88cb0",
                                "sense_id": "1731d568-b472-38a9-a5db-28cfd04fa771",
                                "text": "L’état exige trop des citoyens et nous manquons de plus en plus d’argent pour payer nos impôts. Je propose que le Président de la république revoit sa politique de gestion. Nous ne pouvons pas vivre dans notre propre pays et mourir de faim. Moi par exemple, c’est mon grouilling qui me fait vivre."
                            }
                        ]
                    }
