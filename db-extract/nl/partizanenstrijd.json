                        "examples": [
                            {
                                "example_id": "d6a71969-ee8c-4008-a567-a96cd23f9052",
                                "sense_id": "f547fecd-26ff-3ec9-ac3e-a21ba8d4ea0d",
                                "text": "Op 22 oktober bevond Denisov, die een van de partizanen was, zich met zijn groep in het heetst van de partizanenstrijd."
                            },
                            {
                                "example_id": "bd5863f7-a8f5-4805-88fe-b77becd79874",
                                "sense_id": "f547fecd-26ff-3ec9-ac3e-a21ba8d4ea0d",
                                "text": "Het gaat om militaire onderscheidingen die Jovanka Broz kreeg voor haar rol in de partizanenstrijd tegen de nazi's. Zij waren voor het publiek te zien tijdens de rouwplechtigheid, waarvoor vele honderden Serviërs zaterdag naar het complex waren getogen. Wanneer de onderscheidingen precies zijn ontvreemd, is niet duidelijk."
                            }
                        ]
