                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8e6bc226-1295-477c-b466-1577d3492148",
                        "entry_id": "0fb4472e-9a36-3a67-afff-7eeb47bcac99",
                        "tags": [
