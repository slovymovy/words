                "senses": [
                    {
                        "sense_id": "3e4f52b4-3961-377a-a1b3-06fc24607a46",
                        "entry_id": "7671b287-3c0f-33d3-923d-852af9da4624",
                        "glosses": [
                            "moralisches Bewusstsein, verantwortungsbewusste Einstellung einer Berufsgruppe hinsichtlich der einzuhaltenden Pflichten, Normen bei der Ausübung des Berufs"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "db8bbe6f-36ff-44b9-9f44-ec332916a539",
                                "sense_id": "3e4f52b4-3961-377a-a1b3-06fc24607a46",
                                "text": "„Wer an deutschen Schulen nicht mitkommt, wird eben abgehängt. Finnischen Lehrern geht das heftig gegen ihr Berufsethos: Dort hat jedes Kind ein Recht auf Förderung – und bekommt sie auch, in der neunjährigen Gemeinschaftsschule.“"
                            },
                            {
                                "example_id": "34d0bb47-41dd-4779-929d-21168f319584",
                                "sense_id": "3e4f52b4-3961-377a-a1b3-06fc24607a46",
                                "text": "„Konstruiert und gebaut wurden solche Aufschnittmaschinen zu Beginn des letzten Jahrhunderts für den Gebrauch in Metzgereien. Auch heute noch werden sie zum Beispiel in Italien gebraucht, wo hauchdünne und exakt geschnittene Wurst- und Schinkenscheiben Ausdruck eines Berufsethos sind.“"
                            },
                            {
                                "example_id": "134afe38-797a-4a45-8776-b958ed1c99c4",
                                "sense_id": "3e4f52b4-3961-377a-a1b3-06fc24607a46",
                                "text": "„Nicht dass Amalia und ich diese Praxis verfolgten, das hätte gegen unser Berufsethos verstoßen, aber es war nicht so, dass wir es nicht manchmal mitbekamen – und bei mehr als einer Gelegenheit aus professioneller Solidarität heraus darüber geschwiegen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
