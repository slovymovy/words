                        "examples": [
                            {
                                "example_id": "db23318c-1920-4805-a526-afb0baba528e",
                                "sense_id": "3d1de0f7-47e5-3380-bfd5-9cffe3504d55",
                                "text": "Saja Pal (74) wandelt over de binnenplaats van een bejaardencentrum in Noord-Delhi. „Ik ben nooit getrouwd, heb geen kinderen en mijn familie is overleden. Ik wilde niet vereenzamen. Ik vind het hier heerlijk. De dokter komt elke twee weken op bezoek. We krijgen yoga en er wordt voor me gekookt.” Als het over zijn medebewoners gaat, zucht hij. „Er wordt veel geklaagd over harteloze kinderen.”"
                            }
                        ]
                    }
