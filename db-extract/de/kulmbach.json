                ],
                "senses": [
                    {
                        "sense_id": "08f4b236-9e88-3c5e-b882-37d804b28081",
                        "entry_id": "60a01f07-c61c-34f5-99c0-aa33079a23c1",
                        "glosses": [
                            "eine Stadt in Bayern, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6edfd000-5bd3-4788-a000-259738103996",
                                "sense_id": "08f4b236-9e88-3c5e-b882-37d804b28081",
                                "text": "Kulmbach liegt im Südosten von Deutschland."
                            },
                            {
                                "example_id": "181e955a-d592-41cd-8ce3-8b565a452beb",
                                "sense_id": "08f4b236-9e88-3c5e-b882-37d804b28081",
                                "text": "Die Kulmbacher bestehen darauf, dass Kulmbach in Franken, genauer in Oberfranken, liegt (und nicht etwa in Bayern)."
                            },
                            {
                                "example_id": "770560a5-eb29-49c1-b0a0-d1242c5368d0",
                                "sense_id": "08f4b236-9e88-3c5e-b882-37d804b28081",
                                "text": "„Durch die Stadt fließt der Weiße Main, der sich kurz hinter Kulmbach mit dem Roten Main vereinigt.“"
                            },
                            {
                                "example_id": "03287f37-5140-4f57-b8e0-52e96bb3c780",
                                "sense_id": "08f4b236-9e88-3c5e-b882-37d804b28081",
                                "text": "„Mit der Kirche \"Zu unserer lieben Frau\" schuf der Schweinfurter Architekt Bruno Specht 1892 bis 1894 die erste katholische Kirche im evangelisch geprägten Kulmbach.“"
                            },
                            {
                                "example_id": "7835ec0f-b3d3-42ce-b37e-d9c8b5ff81e8",
                                "sense_id": "08f4b236-9e88-3c5e-b882-37d804b28081",
                                "text": "Kulmbach hat eine lange Tadition des Bierbrauens. Früher gab es in diesem Städtchen gleich vier große Brauereien!"
                            },
                            {
                                "example_id": "6d08e819-8495-4258-bfca-1de59a0e5219",
                                "sense_id": "08f4b236-9e88-3c5e-b882-37d804b28081",
                                "text": "„Wirtshaustester Wolfgang Schneider ist diesmal in Oberfranken unterwegs, genauer gesagt in Kulmbach. Dort besucht er das Brauerei-Wirtshaus 'Kommunbräu'.“"
                            },
                            {
                                "example_id": "1d542b35-8251-45f3-a7c5-4bd0dae785c7",
                                "sense_id": "08f4b236-9e88-3c5e-b882-37d804b28081",
                                "text": "„Kulmbach gehört zu den Gebieten in Bayern, deren Bevölkerung laut dem Bayerischen Landesamt für Statistik bis 2034 am meisten abnimmt.“"
                            },
                            {
                                "example_id": "fb0a8160-51f3-4531-a0c6-f97f8ba8e622",
                                "sense_id": "08f4b236-9e88-3c5e-b882-37d804b28081",
                                "text": "„In Kulmbach ist der Corona-Grenzwert der 7-Tages-Inzidenz von 50 Neuinfektionen pro 100.000 Einwohner überschritten worden.“"
                            },
                            {
                                "example_id": "add82c73-96a9-4235-bf90-b1ef76459c3b",
                                "sense_id": "08f4b236-9e88-3c5e-b882-37d804b28081",
                                "text": "„Dass es sich in Kulmbach gut leben lässt, liegt nicht nur am berühmten Bier und den guten fränkischen Bratwürsten.“"
                            },
                            {
                                "example_id": "054bfc14-8a1b-4bec-bb5e-43bc6a34c8a7",
                                "sense_id": "08f4b236-9e88-3c5e-b882-37d804b28081",
                                "text": "„Schwerer Unfall auf der A 9 – vier Tote: […] Einer der beiden Beifahrer im Kleinbus wurde schwer verletzt und mit einem Rettungshubschrauber in ein Krankenhaus in Kulmbach gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
