                "senses": [
                    {
                        "sense_id": "500b746a-342f-3f07-8865-aa4c809b339e",
                        "entry_id": "adfca10e-6bef-38f4-9644-7d03db160204",
                        "glosses": [
                            "Vorgang, bei dem Krankheitserreger (oder Tumore) eine Abwehrreaktion des (menschlichen) Immunsystems (durch Mutation oder besondere Strategien) umgehen"
                        ],
                        "tags": [
                            "Virologie"
                        ],
                        "examples": [
                            {
                                "example_id": "b66a4ab7-c85e-4e4e-8798-55ce26f8d0c6",
                                "sense_id": "500b746a-342f-3f07-8865-aa4c809b339e",
                                "text": "„\"Momentan\", sagt Björn Meyer, virologischer Postdoc am Institut Pasteur in Paris, \"ist das die große Frage: Inwiefern überlappen die erhöhte Bindungsfähigkeit und der Immunescape?\", also die Fähigkeit des Virus, dem Zugriff des Immunsystems zu entgehen.“"
                            },
                            {
                                "example_id": "e0963e33-2d05-49c7-9b97-9cf2dbcca647",
                                "sense_id": "500b746a-342f-3f07-8865-aa4c809b339e",
                                "text": "„In der darauf folgenden dritten Phase erfolgt der Immunescape, der maligne Zellklon mit akquirierter Resistenz gegen das Immunsystem hat sich etabliert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
