                ],
                "translations": [
                    {
                        "translation_id": "65f44dd7-8fc3-49f5-b20d-e9a32047d95e",
                        "source_entry_id": "d71f0ab0-bd85-3e55-a98d-f48759811ca1",
                        "source_sense_id": "e1609594-bc33-3614-b37e-c41ccbbe598e",
                        "target_lang_word": "irokesisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irokesisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2d8b5dd-4f9e-3367-961c-9db5433e65f0",
                                        "entry_id": "9374ef66-0fd3-3280-9a25-aeb6a9f83c21",
                                        "glosses": [
                                            "die Irokesen betreffend, von ihnen stammend, zu den Irokesen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29287753-6dff-419f-ab8b-ee8f8380b364",
                                                "sense_id": "e2d8b5dd-4f9e-3367-961c-9db5433e65f0",
                                                "text": "Das Cherokee und das Mohawk gehören zur Familie der irokesischen Sprachen."
                                            },
                                            {
                                                "example_id": "4987a0e0-ebe2-4a29-91fc-6ea81ee66aeb",
                                                "sense_id": "e2d8b5dd-4f9e-3367-961c-9db5433e65f0",
                                                "text": "Nach zweihundert Jahren des Kontakts übernahmen die aufstrebenden amerikanischen Siedler viele irokesische Ideen und Gebräuche, um in deren Land zu überleben."
                                            },
                                            {
                                                "example_id": "7ec55f72-8ba8-4612-bd98-13f44b1ecfa1",
                                                "sense_id": "e2d8b5dd-4f9e-3367-961c-9db5433e65f0",
                                                "text": "Mehr im Süden trifft man noch weitere irokesische Gruppen, wie die Cherokee und Tuscarora, an kleinen Stämmen unter anderem die Nottoway und Meherrin."
                                            },
                                            {
                                                "example_id": "439a0d11-7018-45aa-a81e-88b64d8ad5b6",
                                                "sense_id": "e2d8b5dd-4f9e-3367-961c-9db5433e65f0",
                                                "text": "Um 1560 schlossen sich die fünf damals in New York lebenden irokesischen Völker zu einer Föderation zusammen: Mohawk, Oneida, Onondaga, Cayuga und Seneca."
                                            },
                                            {
                                                "example_id": "7fdb4193-d05a-41ad-8427-e9e758c24b9b",
                                                "sense_id": "e2d8b5dd-4f9e-3367-961c-9db5433e65f0",
                                                "text": "Die Jungs von Orson sehen ganz anders aus, als ich aus ihrer Musik geschlossen hatte. Groß, schwarz gekleidet, tätowiert, irokesisch rasiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
