                        "examples": [
                            {
                                "example_id": "05a5f25b-14b9-40cd-8938-99949b8edee7",
                                "sense_id": "b05fba51-8e51-34ac-b17e-faff29422d7a",
                                "text": "\"Ik heb allerlei Europese landen bezocht en nergens zag ik dat het een probleem was\", aldus een Hongaarse taalleraar. \"Het stoort alleen de Hongaren.\""
                            },
                            {
                                "example_id": "42b9048a-b80e-4a90-836f-1810f11952d3",
                                "sense_id": "b05fba51-8e51-34ac-b17e-faff29422d7a",
                                "text": "Het kan voorlopig niet op in creatief Amsterdam. De online taalleraar Myngle heeft nieuw kapitaal op. Twee Amsterdamse gamebedrijven deden dat onlangs ook al. Myngle biedt online taalcursussen aan. Het bedrijf is gevestigd in de Parooltoren aan de Wibautstraat."
                            }
                        ]
