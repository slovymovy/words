                    {
                        "translation_id": "95fce872-2512-47fa-a6bc-992ff3a9478f",
                        "source_entry_id": "41de5dc8-5e6d-3f72-ba94-459c3b57f348",
                        "source_sense_id": "db77eec7-f141-3ebf-8c11-e11afcf8ac4e",
                        "source_sense_description": "water dat mineralen bevat die de smaak veranderen of het water een (vermeende) therapeutische waarde geven",
                        "target_lang_word": "Mineralwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mineralwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ea7cae6-774c-3e84-9322-3125731fc0b4",
                                        "entry_id": "2c293f1c-9bab-34c7-b199-810b0109681d",
                                        "glosses": [
                                            "Trinkwasser, das mit Mineralien und teilweise mit Kohlensäure versetzt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b94ba4d9-b85a-4db9-8020-94b8658552d3",
                                                "sense_id": "4ea7cae6-774c-3e84-9322-3125731fc0b4",
                                                "text": "Mineralwasser ist ein beliebtes Lebensmittel."
                                            },
                                            {
                                                "example_id": "bb034d13-4a75-4a8f-a092-f59952e36894",
                                                "sense_id": "4ea7cae6-774c-3e84-9322-3125731fc0b4",
                                                "text": "„Die Concierge brachte Kaffee und Mineralwasser.“"
                                            },
                                            {
                                                "example_id": "02b0b1cb-d93a-4193-a2d3-a599ab8ac105",
                                                "sense_id": "4ea7cae6-774c-3e84-9322-3125731fc0b4",
                                                "text": "„Der Papa übersetzt der Mama, sie würden ein Glas Mineralwasser trinken.“"
                                            },
                                            {
                                                "example_id": "1bf40a1b-14ca-47ec-8466-ce736512c58c",
                                                "sense_id": "4ea7cae6-774c-3e84-9322-3125731fc0b4",
                                                "text": "„Die Klimabelastung durch Mineralwasser, das in Einwegflaschen abgefüllt ist, ist in Deutschland fast 600-mal höher als bei Leitungswasser.“"
                                            },
                                            {
                                                "example_id": "46ddb5c8-b17c-41d3-8f12-7a44914d5692",
                                                "sense_id": "4ea7cae6-774c-3e84-9322-3125731fc0b4",
                                                "text": "„Das Mineralwasser konnte den Buttergeschmack nicht wegspülen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "934ea235-e9f5-4f6b-a8b9-205683a4951d",
                        "source_entry_id": "41de5dc8-5e6d-3f72-ba94-459c3b57f348",
                        "source_sense_id": "db77eec7-f141-3ebf-8c11-e11afcf8ac4e",
