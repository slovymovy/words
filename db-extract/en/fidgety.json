                                    {
                                        "sense_id": "8d326350-fa34-32e1-b25a-53a05a965006",
                                        "entry_id": "4de27f77-eef1-3fb6-9e12-c94e2e81d5e3",
                                        "glosses": [
                                            "rusteloos, ongeduldig en nerveus bewegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ea55675-4cfd-4c9f-a8e0-f6ce70bd77f8",
                                                "sense_id": "8d326350-fa34-32e1-b25a-53a05a965006",
                                                "text": "De jongen zat ongedurig op zijn stoel te wippen, want hij moest nodig naar de wc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70acb5ad-e3f8-4251-9129-ba585ebddb94",
                        "source_entry_id": "eb3bc89e-1c3d-3427-b3b6-57a65a05d450",
                        "source_sense_id": "16f021d9-7962-3e4a-bd0a-b144ae9bde88",
                        "source_sense_description": "having, or pertaining to, a tendency to fidget",
                        "target_lang_word": "priegelig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "priegelig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1f10f0c4-4b93-382c-8a3d-f8be5bfa2afe",
                                        "entry_id": "eb6becb0-d4de-3c76-b43a-156c3bb7f990",
                                        "glosses": [
                                            "van iets dat heel erg klein is, met name als het gaat om een handschrift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17031261-7c05-468a-8984-aaa10153178e",
                                                "sense_id": "1f10f0c4-4b93-382c-8a3d-f8be5bfa2afe",
                                                "text": "Ik begin vandaag aan het 50 kilometer lange rondje Enschede. Want die brengt je door mooie stukken in het buitengebied. Kom je tot rust. Al moet ik niet vergeten een goede bril mee te nemen om de priegelig kleine routebordjes te lezen."
                                            },
                                            {
                                                "example_id": "17b45d36-eae1-4ebb-b570-0b66188e314a",
                                                "sense_id": "1f10f0c4-4b93-382c-8a3d-f8be5bfa2afe",
                                                "text": "Eerlijk gezegd dacht ik dat ze gepest werd, omdat ze ietwat mollig is en ze zich daarvoor schaamde. Ik had het onderwerp al eens opgeworpen, maar dan reageerde ze steeds als door een adder gebeten. Dus liet ik het maar zo. Pubers zijn sowieso al zo gevoelig. Ik keek naar de laatste pagina die ze had geschreven in haar priegelige handschrift. Mijn oog viel er meteen op. ‘Was ik maar dood,’ stond er. Het angstzweet brak me uit."
                                            },
                                            {
                                                "example_id": "83385555-98d4-435c-8794-f8444b3d61fe",
                                                "sense_id": "1f10f0c4-4b93-382c-8a3d-f8be5bfa2afe",
                                                "text": "Bij de internationaal toonaangevende uitgevers Peters en Bärenreiter is het watertanden voor de liefhebber van klassieke muziek. Koor, solo, instrumentaal: de rekken staan vol met muziek van de bovenste plank. De facsimile-uitgave van Bachs ”Hohe Messe” maakt indruk. Zó schreef de grootmeester dus. Beetje priegelig, maar toch!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e91e15f7-3763-40db-85f0-f25cb6db9136",
                        "source_entry_id": "eb3bc89e-1c3d-3427-b3b6-57a65a05d450",
                        "source_sense_id": "16f021d9-7962-3e4a-bd0a-b144ae9bde88",
                        "source_sense_description": "having, or pertaining to, a tendency to fidget",
                        "target_lang_word": "agité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd860c81-9251-38c5-aa37-3fbacae0ff2d",
                                        "entry_id": "f521b6b4-2cc7-307e-8fb4-8fa5cc0c640f",
                                        "glosses": [
                                            "Qui est animé d’un mouvement vif et irrégulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75f39bd9-8bb8-457e-9a8c-7f2da9b88c68",
                                                "sense_id": "cd860c81-9251-38c5-aa37-3fbacae0ff2d",
                                                "text": "Une mer agitée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43141f90-104b-305f-9b52-f1d272603f61",
                                        "entry_id": "f521b6b4-2cc7-307e-8fb4-8fa5cc0c640f",
                                        "glosses": [
                                            "Qui manifeste de l’agitation ; troublé par une agitation quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29214453-4df4-44df-b670-c3f64a7ca06d",
                                                "sense_id": "43141f90-104b-305f-9b52-f1d272603f61",
                                                "text": "Dès qu’il fut descendu de voiture, celui-ci, contrairement à toutes ses habitudes, ne monta pas directement à sa chambre, il entra dans le salon et s’y promena, le visage à l’orage, très agité, très nerveux, s’impatientant de ce qu'on ne servît pas."
                                            },
                                            {
                                                "example_id": "a3364df7-d5e2-4f8d-be1a-000194990d73",
                                                "sense_id": "43141f90-104b-305f-9b52-f1d272603f61",
                                                "text": "Elle était si agitée, que je me suis demandé si elle était folle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "agité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1310ea2b-8b16-3101-a376-7cc734d3d0b9",
                                        "entry_id": "c59e83b8-394e-308e-b0b1-97db9f894b7b",
                                        "glosses": [
                                            "Malade mental dont le comportement est instable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "131e84ec-ca64-429b-9533-9706047a0f9b",
                                                "sense_id": "1310ea2b-8b16-3101-a376-7cc734d3d0b9",
                                                "text": "Fréquent et insupportable à l'urgence, un agité, saoul, méchant et sale, hurle des grossièretés. […]. Les gendarmes refusent de s'en occuper. L'ivresse qui est une infraction sur la voie publique devient une maladie à l'hôpital."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "agité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9e25955-910a-3c03-8cb7-185ef4cfb77f",
                                        "entry_id": "54eb475c-8c7f-3cd1-befc-0f10f0f948bb",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe agiter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e4bdd09-e59c-4cc3-a44f-ca85312a21d4",
                                                "sense_id": "a9e25955-910a-3c03-8cb7-185ef4cfb77f",
                                                "text": "Un sondage paru lundi a agité le parti lepéniste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
