                ],
                "senses": [
                    {
                        "sense_id": "c8705800-33dc-37af-b42e-8c3eedba5d72",
                        "entry_id": "043cf7e3-809d-3f59-b500-6c9e9e1b5ae4",
                        "glosses": [
                            "een klontje ijs dat als neerslag uit de lucht komt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07fc33ae-f762-4627-a7ea-f40fafab71d1",
                                "sense_id": "c8705800-33dc-37af-b42e-8c3eedba5d72",
                                "text": "Eén hagelsteen is niet zo erg maar ik hoop niet dat het zo echt gaat hagelen!"
                            },
                            {
                                "example_id": "7bb13bd4-f8a3-4ed3-861b-07d9c68458e9",
                                "sense_id": "c8705800-33dc-37af-b42e-8c3eedba5d72",
                                "text": "Vanwege zware regen- en onweersbuien geldt voor Noord-Brabant, Limburg en Gelderland code tot 16.00 uur oranje. Het KNMI zegt dat er hier kans is op zware windstoten tussen de 75 en 100 kilometer per uur en hagelstenen van twee centimeter."
                            },
                            {
                                "example_id": "f677c2a2-3c1e-412a-82c3-e417985b61a9",
                                "sense_id": "c8705800-33dc-37af-b42e-8c3eedba5d72",
                                "text": "Het KNMI heeft voor morgenmiddag en -avond code oranje afgegeven voor het oosten en zuidoosten van het land. In Overijssel, Gelderland, Noord-Brabant en Limburg verwacht het weerinstituut in de middag zware onweersbuien. Daarbij is kans op zware windstoten van 75 tot 100 kilometer per uur en grote hagelstenen van 2 centimeter of groter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22148415-c943-4405-b705-824baf271bcf",
                        "source_entry_id": "043cf7e3-809d-3f59-b500-6c9e9e1b5ae4",
                        "source_sense_id": "c8705800-33dc-37af-b42e-8c3eedba5d72",
                        "source_sense_description": "een klontje ijs dat als neerslag uit de lucht komt",
                        "target_lang_word": "Hagelkorn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hagelkorn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70658319-ae8e-315c-bb1f-923a6433399a",
                                        "entry_id": "6d728736-ead7-3ac4-b599-1de2a18f7412",
                                        "glosses": [
                                            "einzelnes Eisklümpchen des Hagels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3c3ca86-021c-44d1-ab1d-71842d6d4630",
                                                "sense_id": "70658319-ae8e-315c-bb1f-923a6433399a",
                                                "text": "Die Hagelkörner waren fast so groß wie Golfbälle."
                                            },
                                            {
                                                "example_id": "c5d8b404-9552-4dd9-9ec0-aade6e123726",
                                                "sense_id": "70658319-ae8e-315c-bb1f-923a6433399a",
                                                "text": "„Die Hagelkörner sind sehr groß und springen nach dem Aufschlag hoch vom Boden empor.“"
                                            },
                                            {
                                                "example_id": "a77dfdd9-9811-40a3-b23f-93d4050e7acd",
                                                "sense_id": "70658319-ae8e-315c-bb1f-923a6433399a",
                                                "text": "„Am 2. März begann der Donner zu rollen, der Wind kam aus Osten und ließ die Hagelkörner an die Außenwand des Granithauses prallen, als würde sie mit leichten Geschützen beschossen.“"
                                            },
                                            {
                                                "example_id": "1a6affb0-d10b-4b7d-9e7f-2a781c9d4c25",
                                                "sense_id": "70658319-ae8e-315c-bb1f-923a6433399a",
                                                "text": "„Hagelkörner, groß wie Nüsse, zerschlugen das Korn auf den Feldern.“"
                                            },
                                            {
                                                "example_id": "f8c6bb17-54a2-4250-b4ee-608e118348a1",
                                                "sense_id": "70658319-ae8e-315c-bb1f-923a6433399a",
                                                "text": "„Kirschen und Pflaumen bedeckten das Gras zwischen den schmelzenden Hagelkörnern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "18b9a96a-e529-396c-b330-51ef447a1a4c",
                                        "entry_id": "6d728736-ead7-3ac4-b599-1de2a18f7412",
                                        "glosses": [
                                            "Entzündung, Geschwulst am Augenlid (etwa in der Größe eines Hagelkorns^([1]))"
                                        ],
                                        "tags": [
                                            "Augenheilkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dd608b7-a6ea-4895-a316-715950a08e7f",
                                                "sense_id": "18b9a96a-e529-396c-b330-51ef447a1a4c",
                                                "text": "„Meist wird das Hagelkorn, nachdem der Arzt das Augenlid umgeklappt hat, unter örtlicher Betäubung operativ entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
