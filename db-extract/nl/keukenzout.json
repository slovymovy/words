        "nl-extract.jsonl": [
            {
                "entry_id": "842c4523-4cf5-3b63-918b-fc18eaa08304",
                "word": "keukenzout",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3ec8c7eb-2133-3fe7-949f-cf21f828bafa",
                        "entry_id": "842c4523-4cf5-3b63-918b-fc18eaa08304",
                        "glosses": [
                            "kleurloze of witte kristallijne vaste stof, voornamelijk natriumchloride, die veelvuldig in gemalen of korrelige vorm wordt gebruikt als smaakmaker en conserveringsmiddel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e3e2c16-74b9-4fc8-9350-a9f3c60f6c9a",
                                "sense_id": "3ec8c7eb-2133-3fe7-949f-cf21f828bafa",
                                "text": "Het mooiste en meest informatieve verhaal over zout - gek genoeg groot geïllustreerd met een vage pepermolen - is van kookjournalist Joël Broekaert, Hij onthult het echte keukenzoutgeheim. Toevoeging kan leiden tot fermentatie en daarbij kan in het voedsel een ánder zout ontstaan: mononatriumglutamaat. Ve-tsin dus, de grote smaakmaker van de menselijke keuken. En totaal niet écht oosters: ‘in moedermelk zit bijna evenveel van het spul als in ichi-ban dashi’."
                            },
                            {
                                "example_id": "522391c4-f1e5-4f97-a88d-4e2955739c9e",
                                "sense_id": "3ec8c7eb-2133-3fe7-949f-cf21f828bafa",
                                "text": "Bekijk hier voor meer dan duizend supermarktproducten hoeveel suiker, keukenzout en verzadigd vet ze bevatten. En ontdek dat een lekker kroketje met mosterd nog lang zo slecht niet is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4c9c710-5be4-40a9-a26e-339e7742a819",
                        "source_entry_id": "842c4523-4cf5-3b63-918b-fc18eaa08304",
                        "source_sense_id": "3ec8c7eb-2133-3fe7-949f-cf21f828bafa",
                        "source_sense_description": "uit natriumchloride bestaand voedingszout",
                        "target_lang_word": "Kochsalz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
