                        "glosses": [
                            "Donner un caractère laryngal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "032d541f-9e2f-4abc-90db-cc3b1a63df39",
                                "sense_id": "48636685-4815-3340-a24d-19c915bf54ca",
                                "text": "Dans une suite consonantique, en frontière morphémique ou lexémique, la première consonne (voire la coda syllabique) s'affaiblit et se laryngalise ou se nasalise, comme le résume le tableau."
                            },
                            {
                                "example_id": "0b5ef260-9980-41b1-8244-e467e8393104",
                                "sense_id": "48636685-4815-3340-a24d-19c915bf54ca",
                                "text": "Dans ce contexte, l'occlusive finale du ton B s'est affaiblie en voix laryngalisée, entrainant la confusion avec le ton C, lui-même laryngalisé."
                            }
                        ]
                    }
