                                        ]
                                    },
                                    {
                                        "sense_id": "92719487-ce6c-367c-b40e-6cc5f9e0b4dc",
                                        "entry_id": "e1a11a81-095d-309c-9974-741b9a123f1d",
                                        "glosses": [
