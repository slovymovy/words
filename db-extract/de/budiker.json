                ],
                "senses": [
                    {
                        "sense_id": "af997ef6-60eb-31c7-9818-6cf116a99d7a",
                        "entry_id": "7e604f86-8e5c-358a-bf7d-abf0456a2d90",
                        "glosses": [
                            "Inhaber eines kleinen Ladens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e90bc7b8-cd1a-4ebc-b5a9-fda877e10e77",
                                "sense_id": "af997ef6-60eb-31c7-9818-6cf116a99d7a",
                                "text": "„[…] Als Schrippen, Eier, Lichte, Salz, Torf, saure Jurken, Seefe, Schmalz, Und Käse - ganz antiker, Ich bin man ein Budiker! Auch die weiteren Coupletstrophen umreißen das Budikerdasein; am Ende ist ein mit seinem Leben zufriedener Vertreter dieses Standes gezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6ea7cafd-c930-3a76-86ee-8a230c1cc3d8",
                        "entry_id": "7e604f86-8e5c-358a-bf7d-abf0456a2d90",
                        "glosses": [
                            "Inhaber eines kleinen Lokals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4c9da5f-1866-418b-a026-ede86da285b8",
                                "sense_id": "6ea7cafd-c930-3a76-86ee-8a230c1cc3d8",
                                "text": "„Sie wohnten schon zehn Jahre im gleichen Haus, aber Quangel hatte von jeher alles Zusammentreffen mit den Persickes ganz besonders zu vermeiden gesucht, schon damals, als der noch ein kleiner, ziemlich verkrachter Budiker gewesen war.“"
                            },
                            {
                                "example_id": "ab3bf470-0a7b-4b9a-b370-c4fed5eaaaf9",
                                "sense_id": "6ea7cafd-c930-3a76-86ee-8a230c1cc3d8",
                                "text": "„Sie ging von Tisch zu Tisch, begrüßte die Gäste, erzählte handfeste Witze und soff wie ein Budiker.“"
                            },
                            {
                                "example_id": "f4b233ea-6e42-48fe-b58e-0a84e0b71a1c",
                                "sense_id": "6ea7cafd-c930-3a76-86ee-8a230c1cc3d8",
                                "text": "„Doch wer schützt eigentlich Kneiper, Köche und Budiker vor Freibeutern?“"
                            },
                            {
                                "example_id": "6e31f734-8d56-406b-8792-7885c1ca2c3b",
                                "sense_id": "6ea7cafd-c930-3a76-86ee-8a230c1cc3d8",
                                "text": "„Am nächsten Morgen, bevor er sich mit Lüders trifft, gibt ihm der Budiker einen Brief.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
