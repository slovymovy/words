                ],
                "senses": [
                    {
                        "sense_id": "0aa2476d-876e-3999-b962-d2642e032ab4",
                        "entry_id": "5b248203-e31d-36a9-a23e-0afa59cd0cf3",
                        "glosses": [
                            "kurzer Mittagsschlaf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99692da0-3183-4baa-adbe-f756f19a8aca",
                                "sense_id": "0aa2476d-876e-3999-b962-d2642e032ab4",
                                "text": "„Gestern – nach dem Mittagessen – lag ich auf dem Sofa im Wohnzimmer, wollte mein gewohntes Mittagsschläfchen halten, konnte aber nicht einschlafen, lag bloß so da, mit halb geschlossenen Augen.“"
                            },
                            {
                                "example_id": "c8507d46-8b9d-48b0-a529-8b487a96cca5",
                                "sense_id": "0aa2476d-876e-3999-b962-d2642e032ab4",
                                "text": "„Die Mutter des Mädchens weckt eilig den Mann des Hauses, der sich gerade zu einem Mittagsschläfchen hingelegt hat, während die Tochter Wasser für Tee aufsetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
