                    }
                ],
                "senses": [
                    {
                        "sense_id": "08795211-aac5-3340-a8b2-0779258ab5a3",
                        "entry_id": "93da8eb0-8a27-32b1-a403-a90cdd9de831",
                        "glosses": [
                            "Bezeichnung für alle Teilchen, die aus Quarks bestehen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "62fd6c7e-2524-4ab2-bdca-172e6bd8e7d8",
                                "sense_id": "08795211-aac5-3340-a8b2-0779258ab5a3",
                                "text": "Hadronen unterliegen der starken Wechselwirkung."
                            },
                            {
                                "example_id": "c54868da-7819-480f-9d20-bcc576a5b284",
                                "sense_id": "08795211-aac5-3340-a8b2-0779258ab5a3",
                                "text": "„Der künftige Teilchenbeschleuniger ist als Nachfolger des LHC gedacht und soll es ermöglichen, Hadronen (etwa Protonen) mit einer Energie von bis zu 100 TeV (Tera-Elektronenvolt) kollidieren zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9254b325-e6f0-4cc7-addb-75e3bfde5906",
                        "source_entry_id": "93da8eb0-8a27-32b1-a403-a90cdd9de831",
                        "source_sense_id": "08795211-aac5-3340-a8b2-0779258ab5a3",
                        "source_sense_description": "Bezeichnung für alle Teilchen, die aus Quarks bestehen",
                        "target_lang_word": "hadron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hadron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8dc8d811-dddc-326d-b771-8d757bc6d63d",
                                        "entry_id": "148bb643-d7dd-3062-bf14-124e15e35301",
                                        "glosses": [
                                            "A composite particle that comprises two or more quarks held together by the strong force and (consequently) can interact with other particles via said force; a meson or a baryon."
                                        ],
                                        "tags": [
                                            "particle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f6f8488-b7e6-42f1-985f-551596ef27b9",
                                                "sense_id": "8dc8d811-dddc-326d-b771-8d757bc6d63d",
                                                "text": "The weak decays of b hadrons are dominated by the spectator model process whereby the b quark decays to a c quark (or occasionally a u quark) with the emission of an external W, while the non-b antiquark or diquark acts simply as a passive spectator to the decay."
                                            },
                                            {
                                                "example_id": "3e278d13-660b-4c6a-a40e-7caf13de051c",
                                                "sense_id": "8dc8d811-dddc-326d-b771-8d757bc6d63d",
                                                "text": "One can use the lattice simulations, which do represent the rigorous consequences of non-perturbative QCD, as guidance for models of hadron structure."
                                            },
                                            {
                                                "example_id": "d5a7769d-826f-44ed-9435-cb55eda075d3",
                                                "sense_id": "8dc8d811-dddc-326d-b771-8d757bc6d63d",
                                                "text": "And hence colour, which was initially an ad hoc concept, later turned out to be an empirically confirmed reality of hadrons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "978a167f-276e-42c4-a115-501275add27b",
                        "source_entry_id": "93da8eb0-8a27-32b1-a403-a90cdd9de831",
                        "source_sense_id": "08795211-aac5-3340-a8b2-0779258ab5a3",
                        "source_sense_description": "Bezeichnung für alle Teilchen, die aus Quarks bestehen",
                        "target_lang_word": "hadron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hadron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "074473be-7988-32dc-b3d3-5d4d3c63459f",
                                        "entry_id": "82f3f2d8-43cf-3ed8-8f06-5fc5ae011bd0",
                                        "glosses": [
                                            "Particule sensible à l’interaction forte."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6faeecca-f786-4bf4-b476-b3ad4a358c4b",
                                                "sense_id": "074473be-7988-32dc-b3d3-5d4d3c63459f",
                                                "text": "Les protons sont des hadrons."
                                            },
                                            {
                                                "example_id": "8104eea1-2c20-466a-9a60-2be8902af8ee",
                                                "sense_id": "074473be-7988-32dc-b3d3-5d4d3c63459f",
                                                "text": "Les raisons des fins du monde étaient diverses […] la Terre disparaissait dans un trou noir créé par le collisionneur de hadrons ; la fin abrupte du champ magnétique faisait pénétrer le vent solaire dans l’atmosphère ; l’atmosphère terrestre fuyait brutalement vers l’espace et les océans s’asséchaient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
