                                "target_senses": [
                                    {
                                        "sense_id": "b3ecb2f5-a6b9-3593-93e0-acc28554673d",
                                        "entry_id": "b3eb0270-b5f6-302a-ab08-1643093f20af",
                                        "glosses": [
                                            "A single-image stereogram, designed to trick the human eye and brain into seeing a three-dimensional scene in a two-dimensional image."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae5bf210-3e09-498a-a0ea-f5f535159f6c",
                                                "sense_id": "b3ecb2f5-a6b9-3593-93e0-acc28554673d",
                                                "text": "To help see a random dot autostereogram correctly, pull the eyes (and face) towards, say, within one inch of the random dot autostereogram, and then slowly pull away, until the central 3D shape coalesces into view."
                                            },
                                            {
                                                "example_id": "faf9f547-b93a-4f2c-9c73-cdf4fae19f59",
                                                "sense_id": "b3ecb2f5-a6b9-3593-93e0-acc28554673d",
                                                "text": "If you stared at the pattern long enough, your brain would trick itself into seeing a hidden 3D image. It was called an autostereogram, and it was easy to make one if you were a moderately skilled programmer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
