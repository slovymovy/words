            "senses": [
                {
                    "sense_id": "ddae3053-4f31-3637-8582-fe05ec39c286",
                    "sense_definition": "то, что было утрачено или не может быть найдено",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "lost",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я долго искал свой <w>потерянный</w> ключ.",
                            "target_lang_translations": {
                                "en": "I looked for my <w>lost</w> key for a long time."
                            }
                        },
                        {
                            "text": "На столе лежал <w>потерянный</w> кошелек.",
                            "target_lang_translations": {
                                "en": "A <w>lost</w> wallet was lying on the table."
                            }
                        }
                    ],
                    "antonyms": [
                        "найденный"
                    ],
                    "common_phrases": [
                        "потерянный ключ",
                        "потерянный багаж"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that has been misplaced or cannot be found."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lost",
                                "target_lang_sense_clarification": "misplaced or missing object"
                            },
                            {
                                "target_lang_word": "missing",
                                "target_lang_sense_clarification": "not present or not found"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6df17daa-0bd0-361f-a0fc-1e717788d5a7",
                    "sense_definition": "находящийся в состоянии растерянности, смущения или душевного расстройства",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confused",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У неё был <w>потерянный</w> вид после этого разговора.",
                            "target_lang_translations": {
                                "en": "She had a <w>lost</w> look after that conversation."
                            }
                        },
                        {
                            "text": "Он стоял посреди улицы с <w>потерянным</w> выражением лица.",
                            "target_lang_translations": {
                                "en": "He stood in the middle of the street with a <w>lost</w> expression on his face."
                            }
                        }
                    ],
                    "synonyms": [
                        "растерянный",
                        "смущенный"
                    ],
                    "common_phrases": [
                        "потерянный вид"
                    ],
                    "target_lang_definitions": {
                        "en": "Being in a state of confusion, bewilderment, or emotional distress."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lost",
                                "target_lang_sense_clarification": "feeling confused or lacking direction"
                            },
                            {
                                "target_lang_word": "bewildered",
                                "target_lang_sense_clarification": "perplexed or confused"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be3b26b2-d30b-3d2a-a56f-53bd872dce52",
                    "sense_definition": "безнадежный, опустившийся человек, у которого нет будущего",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hopeless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для общества он был уже <w>потерянный</w> человек.",
                            "target_lang_translations": {
                                "en": "To society, he was already a <w>lost</w> person."
                            }
                        },
                        {
                            "text": "Не пытайся его спасти, он <w>потерянный</w> для нас.",
                            "target_lang_translations": {
                                "en": "Don't try to save him, he is <w>lost</w> to us."
                            }
                        }
                    ],
                    "synonyms": [
                        "конченый",
                        "безнадежный"
                    ],
                    "common_phrases": [
                        "потерянный человек"
                    ],
                    "target_lang_definitions": {
                        "en": "A hopeless person who has no future or has given up on life."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lost",
                                "target_lang_sense_clarification": "beyond help or redemption"
                            },
                            {
                                "target_lang_word": "hopeless",
                                "target_lang_sense_clarification": "having no possibility of improvement"
                            }
                        ]
                    }
                }
            ]
        },
        {
