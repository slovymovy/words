                                "target_senses": [
                                    {
                                        "sense_id": "ba7c5bc0-b7f7-36ac-924d-e290bfed39fa",
                                        "entry_id": "77d6b4d0-9292-3ee5-84d3-f47167ccb09d",
                                        "glosses": [
                                            "Action d’exterminer ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e46f0c94-67f6-4457-922d-7399ea1d8f32",
                                                "sense_id": "ba7c5bc0-b7f7-36ac-924d-e290bfed39fa",
                                                "text": "Cette sanglante extermination, qui semblait devoir anéantir le bouddhisme, fut ce qui lui livra presque toute la haute Asie. Repoussé de l'Inde, il se répandit sur tous les pays environnans^([sic]), …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8c67b90-007c-3b8e-a706-5d0eedd70b16",
                                        "entry_id": "77d6b4d0-9292-3ee5-84d3-f47167ccb09d",
