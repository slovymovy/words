                ],
                "senses": [
                    {
                        "sense_id": "0a5d693b-1eaa-3e20-839e-a4cc7463fc2f",
                        "entry_id": "2d97f243-1d4e-362c-9a5e-0d410ae2953e",
                        "glosses": [
                            "Erdgas, das in Tonstein gespeichert vorliegt und mit einer Fracking genannten Technik gefördert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f82c4fe8-6c20-4d1a-b244-a35b220e80ad",
                                "sense_id": "0a5d693b-1eaa-3e20-839e-a4cc7463fc2f",
                                "text": "„Trotz aller Beteuerungen laufen große Bemühungen der Energiekonzerne, Schiefergas in Europa salonfähig zu machen.“"
                            },
                            {
                                "example_id": "7556ca71-95b8-4fe1-b9ae-a36a9b60a42d",
                                "sense_id": "0a5d693b-1eaa-3e20-839e-a4cc7463fc2f",
                                "text": "„Der französische Konzern will künftig in Großbritannien Schiefergas fördern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80eb9253-544a-4310-b732-dd67712d971d",
                        "source_entry_id": "2d97f243-1d4e-362c-9a5e-0d410ae2953e",
                        "source_sense_id": "0a5d693b-1eaa-3e20-839e-a4cc7463fc2f",
                        "source_sense_description": "Erdgas, das in Tonstein gespeichert vorliegt und mit einer Fracking genannten Technik gefördert wird",
                        "target_lang_word": "shale gas",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shale gas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bee7eb00-45fe-36ca-a470-b3479748271b",
                                        "entry_id": "d4300830-df84-3160-a85f-d942670ebe51",
                                        "glosses": [
                                            "Natural gas extracted from shale."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71cbe51b-4654-4a32-81e4-925c3eba9560",
                                                "sense_id": "bee7eb00-45fe-36ca-a470-b3479748271b",
                                                "text": "In a report released on Monday, the world's foremost energy watchdog, the International Energy Agency (IEA), said the US would benefit from so-called unconventional sources of oil and gas, including shale gas and shale oil, derived from fracking – blasting dense rocks apart to release the fossil fuels trapped within."
                                            },
                                            {
                                                "example_id": "31181ae3-f1e7-462a-962b-b69059b34cb8",
                                                "sense_id": "bee7eb00-45fe-36ca-a470-b3479748271b",
                                                "text": "The shale gas boom of the past five years took the US by surprise. Gas prices there have plunged and electricity production is shifting fast from coal to gas-fired power stations. This has had a huge effect on all parts of the US economy, and is changing politics globally."
                                            },
                                            {
                                                "example_id": "c0580441-f73e-4a1b-a204-ea824a023944",
                                                "sense_id": "bee7eb00-45fe-36ca-a470-b3479748271b",
                                                "text": "The UK’s underground shale gas reserves may deliver only a fraction of the gas promised by fracking firms and government ministers, according to a study."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8871630-e31c-4ea5-9cf9-afc5a6bc8a2a",
                        "source_entry_id": "2d97f243-1d4e-362c-9a5e-0d410ae2953e",
                        "source_sense_id": "0a5d693b-1eaa-3e20-839e-a4cc7463fc2f",
                        "source_sense_description": "Erdgas, das in Tonstein gespeichert vorliegt und mit einer Fracking genannten Technik gefördert wird",
                        "target_lang_word": "gaz de schiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaz de schiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06bf5695-a62a-3618-99ea-9e1e05c24ada",
                                        "entry_id": "2054c566-de33-32bc-96c2-f78800699f7e",
                                        "glosses": [
                                            "Gaz naturel présent dans des formations de schistes argileux."
                                        ],
                                        "tags": [
                                            "Industrie pétrolière",
                                            "Production"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e810011d-c754-4068-bbd6-c1e74e9800c9",
                                                "sense_id": "06bf5695-a62a-3618-99ea-9e1e05c24ada",
                                                "text": "La fracturation hydraulique est aujourd’hui la seule technique d’exploitation possible pour le gaz de schiste."
                                            },
                                            {
                                                "example_id": "75d54589-17fb-4902-af4c-b13ba8c8535d",
                                                "sense_id": "06bf5695-a62a-3618-99ea-9e1e05c24ada",
                                                "text": "Les trois quarts des Français sont contre le gaz de schiste alors même que plus de la moitié d’entre eux reconnaissent ne pas savoir de quoi il s’agit !"
                                            },
                                            {
                                                "example_id": "6dbe4426-5c6b-4cdb-93d6-80833ce81154",
                                                "sense_id": "06bf5695-a62a-3618-99ea-9e1e05c24ada",
                                                "text": "Et pourquoi tant d’attention et de désir pour le joli village de Lassay-sur-Croisne, aurait-on détecté du gaz de schiste dans son sous-sol ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7854252-ea31-43cd-b59b-05d6480b18c1",
                        "source_entry_id": "2d97f243-1d4e-362c-9a5e-0d410ae2953e",
                        "source_sense_id": "0a5d693b-1eaa-3e20-839e-a4cc7463fc2f",
