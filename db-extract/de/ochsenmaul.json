                "senses": [
                    {
                        "sense_id": "f0af3df8-6e7a-3d5d-ac75-7edfb2ddb15f",
                        "entry_id": "a290bbd3-5fc0-308b-890b-745ea1999908",
                        "glosses": [
                            "das Maul eines kastrierten, männlichen Rinds"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f787c58d-bbdd-4786-8274-9c79ef216f48",
                                "sense_id": "f0af3df8-6e7a-3d5d-ac75-7edfb2ddb15f",
                                "text": "Das Rind Schlang mit der Zunge ganze Büschel aus Gras in sein Ochsenmaul."
                            },
                            {
                                "example_id": "1d8fc879-9211-4085-b794-de08175cc926",
                                "sense_id": "f0af3df8-6e7a-3d5d-ac75-7edfb2ddb15f",
                                "text": "Nach dem Pökeln wird das Ochsenmaul überbrüht, mehrere Stunden gekocht und schließlich in feine Streifen geschnitten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8ba44753-3d4d-3896-8cd4-7f385c135fd6",
                        "entry_id": "a290bbd3-5fc0-308b-890b-745ea1999908",
