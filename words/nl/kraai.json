                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beroepen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>kraai</w> liep statig voor de rouwstoet uit naar het graf.",
                            "target_lang_translations": {
                                "en": "The <w>undertaker</w> walked stately ahead of the funeral procession to the grave."
                            }
                        },
                        {
                            "text": "Vroeger noemden mensen een begrafenisondernemer vaak gekscherend een <w>kraai</w>.",
                            "target_lang_translations": {
                                "en": "In the past, people often jokingly called an undertaker a <w>crow</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak informeel of licht spottend gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
