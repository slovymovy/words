{
    "word_family": [
        "provincial",
        "provincialism",
        "provincially"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c3c5992-809a-3ecd-878e-a51401da359b",
                    "sense_definition": "An administrative subdivision of certain countries, functioning like a state or region.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "administrative_region",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was born in the <w>province</w> of Alberta.",
                            "target_lang_translations": {
                                "ru": "Она родилась в <w>провинции</w> Альберта.",
                                "zh": "她出生在阿尔伯塔<w>省</w>。"
                            }
                        },
                        {
                            "text": "The governor visited every <w>province</w> in the country to meet the people.",
                            "target_lang_translations": {
                                "ru": "Губернатор посетил каждую <w>провинцию</w> страны, чтобы встретиться с людьми.",
                                "zh": "州长走访了全国每一个<w>省</w>以会见民众。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Canadian province",
                        "province of",
                        "northern province",
                        "coastal province"
                    ],
                    "target_lang_definitions": {
                        "ru": "Административно-территориальная единица в некоторых странах, аналогичная штату или области.",
                        "zh": "某些国家的一种行政区划，类似于州或地区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прови́нция",
                                "target_lang_sense_clarification": "административная единица"
                            },
                            {
                                "target_lang_word": "о́бласть",
                                "target_lang_sense_clarification": "регион"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "省",
                                "target_lang_sense_clarification": "行政区划"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4895bd76-7031-3ab8-a9b1-bfb9a41fe0c2",
                    "sense_definition": "The parts of a country located away from the capital city or major cultural centers.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fashion trends often take a long time to reach the <w>provinces</w>.",
                            "target_lang_translations": {
                                "ru": "Модные тенденции часто долго доходят до <w>провинции</w>.",
                                "zh": "时尚潮流往往需要很长时间才能传到<w>外地</w>。"
                            }
                        },
                        {
                            "text": "After living in London for years, he found life in the <w>provinces</w> too quiet.",
                            "target_lang_translations": {
                                "ru": "Прожив много лет в Лондоне, он находил жизнь в <w>провинции</w> слишком тихой.",
                                "zh": "在伦敦住了多年后，他觉得<w>地方</w>上的生活太安静了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "countryside"
                    ],
                    "common_phrases": [
                        "in the provinces",
                        "tour the provinces"
                    ],
                    "target_lang_definitions": {
                        "ru": "Части страны, удаленные от столицы или крупных культурных центров.",
                        "zh": "远离首都或主要文化中心的地区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прови́нция",
                                "target_lang_sense_clarification": "периферия"
                            },
                            {
                                "target_lang_word": "глуби́нка",
                                "target_lang_sense_clarification": "разговорное, отдаленная местность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外地",
                                "target_lang_sense_clarification": "非首都或中心地区"
                            },
                            {
                                "target_lang_word": "地方",
                                "target_lang_sense_clarification": "相对于中心而言的区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c38b44bf-09fc-3d33-b68a-0296a192f780",
                    "sense_definition": "A specific area of activity, knowledge, or responsibility assigned to a person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marketing is not really my <w>province</w>; you should ask the sales team.",
                            "target_lang_translations": {
                                "ru": "Маркетинг — это не совсем моя <w>сфера</w>; вам следует спросить у отдела продаж.",
                                "zh": "市场营销并不是我的<w>领域</w>，你应该去问销售团队。"
                            }
                        },
                        {
                            "text": "Art has always been the <w>province</w> of the creative department.",
                            "target_lang_translations": {
                                "ru": "Искусство всегда было <w>областью</w> творческого отдела.",
                                "zh": "艺术一直以来都是创意部门的<w>职权范围</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "within one's province",
                        "outside my province"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфическая сфера деятельности, знаний или ответственности, закрепленная за кем-либо.",
                        "zh": "某人负责的特定活动、知识或责任领域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сфе́ра",
                                "target_lang_sense_clarification": "деятельности"
                            },
                            {
                                "target_lang_word": "о́бласть",
                                "target_lang_sense_clarification": "знаний"
                            },
                            {
                                "target_lang_word": "компете́нция",
                                "target_lang_sense_clarification": "круг полномочий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "领域",
                                "target_lang_sense_clarification": "活动范围"
                            },
                            {
                                "target_lang_word": "职权范围",
                                "target_lang_sense_clarification": "责任领域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb537131-891a-3a43-a9da-a6fda28774ce",
                    "sense_definition": "An area outside Italy that was controlled by the ancient Roman government.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "administrative_region",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gaul was a major Roman <w>province</w> conquered by Julius Caesar.",
                            "target_lang_translations": {
                                "ru": "Галлия была крупной римской <w>провинцией</w>, завоеванной Юлием Цезарем.",
                                "zh": "高卢是尤利乌斯·凯撒征服的一个主要罗马<w>行省</w>。"
                            }
                        },
                        {
                            "text": "The emperor appointed a new governor to manage the distant <w>province</w>.",
                            "target_lang_translations": {
                                "ru": "Император назначил нового наместника для управления отдаленной <w>провинцией</w>.",
                                "zh": "皇帝任命了一位新总督来管理这个遥远的<w>行省</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Roman province"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context referring to Ancient Rome"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Территория за пределами Италии, находившаяся под управлением правительства Древнего Рима.",
                        "zh": "古罗马政府控制的意大利以外的领土。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прови́нция",
                                "target_lang_sense_clarification": "историческое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "行省",
                                "target_lang_sense_clarification": "古罗马行政区"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4263279-1eb9-3e1a-9260-d87318bcb2ba",
                    "sense_definition": "An administrative district within a church, usually under the authority of an archbishop.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "administrative_region",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archbishop oversees the entire ecclesiastical <w>province</w>.",
                            "target_lang_translations": {
                                "ru": "Архиепископ осуществляет надзор за всей церковной <w>провинцией</w>.",
                                "zh": "大主教负责监管整个<w>教省</w>。"
                            }
                        },
                        {
                            "text": "Bishops from the <w>province</w> gathered for an important meeting.",
                            "target_lang_translations": {
                                "ru": "Епископы из <w>провинции</w> собрались на важное совещание.",
                                "zh": "来自该<w>教省</w>的主教们聚集在一起参加了一次重要会议。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Административный округ в церкви, обычно находящийся в ведении архиепископа.",
                        "zh": "教会内部的行政区，通常由大主教管辖。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "церко́вная прови́нция",
                                "target_lang_sense_clarification": "территориальный округ"
                            },
                            {
                                "target_lang_word": "митропо́лия",
                                "target_lang_sense_clarification": "церковный округ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "教省",
                                "target_lang_sense_clarification": "教会行政区"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "722d0a9c-d33e-3e7e-88c5-c8714f75bf37",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Provinces</w> is listed in the directory.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Провинс</w> указан в справочнике.",
                                "zh": "名录中列出了<w>普罗文斯</w>先生。"
                            }
                        },
                        {
                            "text": "We met a family with the last name <w>Province</w>.",
                            "target_lang_translations": {
                                "ru": "Мы встретили семью с фамилией <w>Провинс</w>.",
                                "zh": "我们遇到了一户姓<w>普罗文斯</w>的人家。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Про́винс",
                                "target_lang_sense_clarification": "транслитерация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "普罗文斯",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}