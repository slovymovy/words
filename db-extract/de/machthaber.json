                        "examples": [
                            {
                                "example_id": "3f5e9313-eb0a-4b5d-99b2-c30647da315e",
                                "sense_id": "1c8c8d26-c51a-3669-bd41-7dc4cfe4f5da",
                                "text": "Seit vielen Jahren aber hat Zhang sich mit den Machthabern arrangiert. Er drehte pompöse Kampfkunstfilme wie Hero und beschönigende Dramen wie Coming Home und inszenierte 2008 die Eröffnungs- und Schlussfeier der Olympischen Spiele in Peking."
                            }
                        ]
                    },
                    {
                        "sense_id": "02c1363e-1c55-3365-b27b-05ceafb024ba",
                        "entry_id": "ca4a5d48-3175-3ca1-8f89-6c3af008b3fa",
                        "glosses": [
                            "potentate"
                        ],
                        "tags": [
