                "senses": [
                    {
                        "sense_id": "9af36837-4aaa-3086-ba24-00ca4105e4d5",
                        "entry_id": "d27ead9a-b45d-3074-8152-cedd74cec1cb",
                        "glosses": [
                            "benaming voor schildluizen uit het geslacht Kermes en in het bijzonder de soorten waaruit een rode kleurstof wordt gewonnen\\nOorspronkelijk werden deze schildluizen niet als diertjes, maar ook wel als planten (besjes) gezien."
                        ],
                        "tags": [
                            "halfvleugeligen"
                        ],
                        "examples": [
                            {
                                "example_id": "9ccbc78f-482b-4d04-8c63-29e5c3a7ad21",
                                "sense_id": "9af36837-4aaa-3086-ba24-00ca4105e4d5",
                                "text": "Trouwens, de kleur die bij ons karmijn of ook wel karmozijn heet (zo genoemd naar een insekt, de kermes), heet in het Spaans granate."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea2def73-17fc-3987-a01d-b305eee9b303",
                        "entry_id": "d27ead9a-b45d-3074-8152-cedd74cec1cb",
                        "glosses": [
                            "rode kleurstof die wordt gewonnen uit de vrouwtjes van bepaalde soorten schildluis als Kermes ilicis en Kermes vermilio) die leven op de kermeseik Quercus coccifera"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "017cce98-fc6e-4e99-ab9d-dd80b8762e73",
                                "sense_id": "ea2def73-17fc-3987-a01d-b305eee9b303",
                                "text": "Andere luxeartikelen waren zilver, goud, pelzen, metalen en kostbare verfstoffen zoals kermes, gewonnen uit de schaal van vrouwelijke insecten van het genus Kermes vermilio en de grondstof voor scharlaken."
                            }
                        ]
                    },
                    {
                        "sense_id": "966b3169-57ec-3324-91d5-59c049d0c2e4",
                        "entry_id": "d27ead9a-b45d-3074-8152-cedd74cec1cb",
                        "glosses": [
                            "bepaalde rode kleur"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
