                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reset",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecbc11d9-be7e-3af4-9dda-734312d13da4",
                                        "entry_id": "65465999-2afc-3a4c-9e4f-225625683f2c",
                                        "glosses": [
                                            "To set back to the initial state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94c34d29-de88-466f-9672-1d80b1459eaf",
                                                "sense_id": "ecbc11d9-be7e-3af4-9dda-734312d13da4",
                                                "text": "The next section explains how to reset the administrator password with the help of this challenge question."
                                            },
                                            {
                                                "example_id": "2b66d15c-cc64-41b5-911b-4d2c1613a5d1",
                                                "sense_id": "ecbc11d9-be7e-3af4-9dda-734312d13da4",
                                                "text": "With the Hormone Reset you'll learn how to reset your weight, nutrition, hormones, and habitual patterns, from cell to soul; […]"
                                            },
                                            {
                                                "example_id": "adc8e166-b94f-4eb7-a0aa-2ba18c5234b1",
                                                "sense_id": "ecbc11d9-be7e-3af4-9dda-734312d13da4",
                                                "text": "Then there came a reg'lar terror of a sou'wester same as you don't get one summer in a thousand, and blowed the shanty flat and ripped about half of the weir poles out of the sand. We spent consider'ble money getting 'em reset, and then a swordfish got into the pound and tore the nets all to slathers, right in the middle of the squiteague season."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d9df8d4-fadb-38a0-84a3-12ac905b8596",
                                        "entry_id": "65465999-2afc-3a4c-9e4f-225625683f2c",
                                        "glosses": [
                                            "To set to zero."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a904f903-5af3-37a5-8c58-87ab160533c7",
                                        "entry_id": "65465999-2afc-3a4c-9e4f-225625683f2c",
                                        "glosses": [
                                            "To adjust; to set or position differently."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e705a42f-bfba-4882-a49f-0bc37b1482ec",
                                                "sense_id": "a904f903-5af3-37a5-8c58-87ab160533c7",
                                                "text": "He turned and steered his course toward some lights clustered at the end of the street. They proved farther away than he had anticipated, and after a long quest he came to the conclusion that his eyes had been mysteriously removed from their proper places and had been reset on either side of his head like those of a bird."
                                            },
                                            {
                                                "example_id": "17823407-0d44-4943-94fa-79732f182d4f",
                                                "sense_id": "a904f903-5af3-37a5-8c58-87ab160533c7",
                                                "text": "The advantage of the Monotype machine over the Linotype one was that corrections could be made using precast sorts. This was especially useful for book production. With the Linotype method, the whole line had to be reset and replaced."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reset",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9972cbad-3bcc-3bb6-962a-38f3de078641",
                                        "entry_id": "63dae545-f581-3522-9371-1ccb1bb0df3b",
                                        "glosses": [
                                            "The act of resetting to the initial state."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7411d977-cae8-4049-a55e-c7846cf00176",
                                                "sense_id": "9972cbad-3bcc-3bb6-962a-38f3de078641",
                                                "text": "A reset halts whatever is taking place on the bus and prepares devices for the beginning of a new communication cycle. A reset begins when the master pulls the bus low for a period greater than 480 μs."
                                            },
                                            {
                                                "example_id": "dfaa2658-b07d-4845-9cc6-ac827a283e0b",
                                                "sense_id": "9972cbad-3bcc-3bb6-962a-38f3de078641",
                                                "text": "That is why I have called for a ‘reset’ in relations between the United States and Russia. This must be more than a fresh start between the Kremlin and the White House, though that is important."
                                            },
                                            {
                                                "example_id": "517627bc-0531-4e57-9d28-59762c0906f2",
                                                "sense_id": "9972cbad-3bcc-3bb6-962a-38f3de078641",
                                                "text": "On older PCs, a BIOS reset can set the default video output to the motherboard when your monitor is plugged into a PCIe graphics card."
                                            },
                                            {
                                                "example_id": "29764156-3988-40f1-9748-7f7ed11de9d8",
                                                "sense_id": "9972cbad-3bcc-3bb6-962a-38f3de078641",
                                                "text": "Music streaming needs a “complete reset”, according to a damning parliamentary report that calls on the UK competition watchdog to investigate the commercial power wielded by major record labels."
                                            },
                                            {
                                                "example_id": "8d6e2023-3a01-4149-8b82-d1a0d397312a",
                                                "sense_id": "9972cbad-3bcc-3bb6-962a-38f3de078641",
                                                "text": "The planned changes at the Centers for Disease Control and Prevention – CDC leaders call it a “reset” – come amid ongoing criticism of the agency’s response to Covid-19, monkeypox and other public health threats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "855d8a92-e5e3-3f78-b1f3-cd70325038a3",
                                        "entry_id": "63dae545-f581-3522-9371-1ccb1bb0df3b",
                                        "glosses": [
                                            "The act of setting to zero."
                                        ],
