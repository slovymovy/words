    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19654a91-47eb-341d-b9a5-f893bf0bf797",
                    "sense_definition": "A mother.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mother_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>mum</w> cooks the best dinner on Sundays.",
                            "target_lang_translations": {
                                "ru": "Моя <w>мама</w> готовит лучший ужин по воскресеньям.",
                                "zh": "我<w>妈妈</w>周日做的晚饭最好吃。"
                            }
                        },
                        {
                            "text": "I am going to the shops with my <w>mum</w> and dad.",
                            "target_lang_translations": {
                                "ru": "Я иду по магазинам с <w>мамой</w> и папой.",
                                "zh": "我要和我的<w>妈妈</w>还有爸爸去商店。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Mother",
                        "Mom",
                        "Mommy",
                        "Mummy",
                        "mama"
                    ],
                    "antonyms": [
                        "Dad"
                    ],
                    "common_phrases": [
                        "my mum",
                        "mum and dad",
                        "single mum"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK, Australia, New Zealand"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мать (разговорное).",
                        "zh": "母亲（口语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мама",
                                "target_lang_sense_clarification": "общеупотребительное"
                            },
                            {
                                "target_lang_word": "мамочка",
                                "target_lang_sense_clarification": "ласкательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "妈妈",
                                "target_lang_sense_clarification": "通用称呼"
                            },
                            {
                                "target_lang_word": "妈",
                                "target_lang_sense_clarification": "口语简写"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e365ddc6-205b-3122-9c6d-d489a639d5ea",
                    "sense_definition": "A <w>chrysanthemum</w> flower.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She planted some yellow <w>mums</w> in the front garden.",
                            "target_lang_translations": {
                                "ru": "Она посадила жёлтые <w>хризантемы</w> в палисаднике.",
                                "zh": "她在前花园里种了一些黄色的<w>菊花</w>。"
                            }
                        },
                        {
                            "text": "The pot of <w>mums</w> looked beautiful on the porch.",
                            "target_lang_translations": {
                                "ru": "Горшок с <w>хризантемами</w> красиво смотрелся на крыльце.",
                                "zh": "门廊上的那盆<w>菊花</w>看起来很美。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "shortening"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Цветок хризантема (сокращение).",
                        "zh": "菊花（缩写）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хризантема",
                                "target_lang_sense_clarification": "полное название цветка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "菊花",
                                "target_lang_sense_clarification": "花卉名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90ba18d1-7209-3c10-9cdd-2b3ea4c3db71",
                    "sense_definition": "A polite form of address for a woman; a dialectal form of <w>ma'am</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can I get you a cup of tea, <w>mum</w>?",
                            "target_lang_translations": {
                                "ru": "Принести вам чашку чая, <w>мэм</w>?",
                                "zh": "我可以为您倒杯茶吗，<w>女士</w>？"
                            }
                        },
                        {
                            "text": "Yes, <w>mum</w>, I will finish the cleaning immediately.",
                            "target_lang_translations": {
                                "ru": "Да, <w>мэм</w>, я немедленно закончу уборку.",
                                "zh": "好的，<w>女士</w>，我会立刻完成打扫。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "yes mum"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "British"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "often used by servants"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливое обращение к женщине; диалектная форма от ma'am.",
                        "zh": "对女性的礼貌称呼；ma'am 的方言形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мэм",
                                "target_lang_sense_clarification": "заимствование, вежливое обращение"
                            },
                            {
                                "target_lang_word": "госпожа",
                                "target_lang_sense_clarification": "устаревшее, почтительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "女士",
                                "target_lang_sense_clarification": "礼貌称呼"
                            },
                            {
                                "target_lang_word": "夫人",
                                "target_lang_sense_clarification": "尊称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db2f3dc5-cd65-3c53-9ebf-42616c0c9430",
                    "sense_definition": "A type of strong beer, originally made in Brunswick, Germany.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tavern served a dark, strong <w>mum</w> to the travelers.",
                            "target_lang_translations": {
                                "ru": "В таверне путешественникам подавали тёмный крепкий <w>мум</w>.",
                                "zh": "酒馆为旅客们供应了一种深色的烈性<w>啤酒</w>。"
                            }
                        },
                        {
                            "text": "He ordered a pint of <w>mum</w> to warm himself up.",
                            "target_lang_translations": {
                                "ru": "Он заказал пинту <w>мума</w>, чтобы согреться.",
                                "zh": "他点了一品脱<w>啤酒</w>来暖暖身子。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сорт крепкого пива, первоначально производившийся в Брауншвейге, Германия.",
                        "zh": "一种源自德国不伦瑞克的烈性啤酒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мум",
                                "target_lang_sense_clarification": "историческое название напитка"
                            },
                            {
                                "target_lang_word": "крепкое пиво",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烈性啤酒",
                                "target_lang_sense_clarification": "描述性翻译"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f68acde4-8521-32d4-b3d5-80ee4384daa0",
                    "sense_definition": "One's mother (used as a proper name to address her).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "mother_concept",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Happy birthday, <w>Mum</w>!",
                            "target_lang_translations": {
                                "ru": "С днём рождения, <w>Мама</w>!",
                                "zh": "生日快乐，<w>妈妈</w>！"
                            }
                        },
                        {
                            "text": "I asked <w>Mum</w> if I could go to the cinema.",
                            "target_lang_translations": {
                                "ru": "Я спросил <w>Маму</w>, можно ли мне пойти в кино.",
                                "zh": "我问<w>妈妈</w>我能不能去看电影。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Mom",
                        "Mother",
                        "Mommy",
                        "Mummy",
                        "Mama"
                    ],
                    "antonyms": [
                        "Dad"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK, Australia, New Zealand"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мать (используется как имя собственное при обращении).",
                        "zh": "母亲（用作称呼语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мама",
                                "target_lang_sense_clarification": "обращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "妈妈",
                                "target_lang_sense_clarification": "称呼语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4fa1f8e2-a0b8-38a2-b3ac-ed418282f597",
                    "sense_definition": "Silent; not speaking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "silence_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to keep <w>mum</w> about the surprise party.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>помалкивать</w> о вечеринке-сюрпризе.",
                                "zh": "关于惊喜派对的事，他决定<w>守口如瓶</w>。"
                            }
                        },
                        {
                            "text": "The witness remained <w>mum</w> when asked about the incident.",
                            "target_lang_translations": {
                                "ru": "Свидетель оставался <w>безмолвным</w>, когда его спросили об инциденте.",
                                "zh": "当被问及那起事件时，证人保持<w>沉默</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "keep mum",
                        "stay mum"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "idiomatic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Молчаливый; не говорящий ни слова.",
                        "zh": "沉默的；不说话的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молчаливый",
                                "target_lang_sense_clarification": "прилагательное"
                            },
                            {
                                "target_lang_word": "безмолвный",
                                "target_lang_sense_clarification": "книжное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沉默",
                                "target_lang_sense_clarification": "形容词"
                            },
                            {
                                "target_lang_word": "守口如瓶",
                                "target_lang_sense_clarification": "习语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "70a00b49-52a0-3de9-b3e1-e40e5d7358d9",
                    "sense_definition": "To act in a pantomime or disguise oneself for entertainment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers went out to <w>mum</w> during the winter festival.",
                            "target_lang_translations": {
                                "ru": "Деревенские жители вышли <w>рядиться</w> во время зимнего праздника.",
                                "zh": "村民们在冬日庆典期间出去<w>乔装</w>游行。"
                            }
                        },
                        {
                            "text": "They <w>mummed</w> in colorful costumes and masks.",
                            "target_lang_translations": {
                                "ru": "Они <w>разыгрывали пантомиму</w> в красочных костюмах и масках.",
                                "zh": "他们穿着五颜六色的服装、戴着面具进行<w>哑剧表演</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть в пантомиме или переодеваться для развлечения (рядиться).",
                        "zh": "表演哑剧或为娱乐而乔装打扮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рядиться",
                                "target_lang_sense_clarification": "надевать маскарадные костюмы"
                            },
                            {
                                "target_lang_word": "играть в пантомиме",
                                "target_lang_sense_clarification": "выступать без слов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乔装",
                                "target_lang_sense_clarification": "化装表演"
                            },
                            {
                                "target_lang_word": "演哑剧",
                                "target_lang_sense_clarification": "表演形式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "341289ff-bfe0-3560-9a04-c9c61c7eb611",
                    "sense_definition": "Stop speaking! Hush!",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "silence_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Mum</w>! Someone is coming down the hall.",
                            "target_lang_translations": {
                                "ru": "<w>Тсс</w>! Кто-то идёт по коридору.",
                                "zh": "<w>嘘</w>！有人正顺着走廊走过来。"
                            }
                        },
                        {
                            "text": "You must be quiet now, so <w>mum</w>!",
                            "target_lang_translations": {
                                "ru": "Ты должен вести себя тихо, так что <w>молчок</w>!",
                                "zh": "你现在必须安静，所以<w>闭嘴</w>！"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перестань говорить! Тсс!",
                        "zh": "停止说话！嘘！"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тсс",
                                "target_lang_sense_clarification": "призыв к тишине"
                            },
                            {
                                "target_lang_word": "молчок",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嘘",
                                "target_lang_sense_clarification": "表示安静"
                            },
                            {
                                "target_lang_word": "闭嘴",
                                "target_lang_sense_clarification": "口语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}