                        "examples": [
                            {
                                "example_id": "f3f822da-bdf0-43f0-82a9-5bb18f0c3de2",
                                "sense_id": "bd114685-36c7-3f19-a3b2-a1a09ccff65a",
                                "text": "\"Als je zijn hele oeuvre bekijkt, zie je dat hij bij bloemstillevens continu voorwerpen neemt die helemaal niet eens bedoeld zijn als vaas. Een likeurkannetje, een melkkan en een klein bloesemtakje in een jampot. Hij grijpt gewoon wat om hem heen is en dat gebruikt hij. Dat geeft een verrassend andere blik op zijn werk.\""
                            },
                            {
                                "example_id": "26214686-8741-4cc4-aa37-315ac5cef54c",
                                "sense_id": "bd114685-36c7-3f19-a3b2-a1a09ccff65a",
                                "text": "De schilder van het schilderij 'Bloemstilleven met akkerbloemen en rozen' werd jarenlang met 'anoniem' aangeschreven. Maar nu blijkt het niemand minder dan Vincent van Gogh te zijn die het geschilderd heeft."
                            },
                            {
                                "example_id": "467c53ad-15f8-4004-b7fe-11bb1b2f01ab",
                                "sense_id": "bd114685-36c7-3f19-a3b2-a1a09ccff65a",
                                "text": "Zo is het doek uitzonderlijk groot voor een Van Gogh; 1 meter bij 80 centimeter. Ook was er twijfel omdat het een voor Van Gogh ongebruikelijk uitbundig bloemstilleven was."
                            }
                        ]
                    }
