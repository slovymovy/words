                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43970407-0bca-4158-a53c-48594048ef4d",
                        "source_entry_id": "3ce304b8-4886-30d6-b206-8878bba20ccc",
