                        "glosses": [
                            "in die periode, meestal een omstandigheid aanduidend die in de huidige tijd niet meer geldt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92105d33-fe5e-4595-86ba-4b01af048bdd",
                                "sense_id": "a2f44215-c209-3d40-a538-b816439cef71",
                                "text": "Indertijd was het niet mogelijk televisiebeelden van de andere kant van de oceaan rechtstreeks te laten zien, maar alleen op film."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cac54194-7bc8-4899-a015-a013e84c2da1",
                        "source_entry_id": "48d3ac18-d786-3cb6-82bb-bcf418aacca3",
