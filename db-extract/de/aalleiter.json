                "senses": [
                    {
                        "sense_id": "03dbaa1e-32cf-35f3-81b8-2581974f4e2b",
                        "entry_id": "35f43bda-a78b-38b4-84dd-2ee42ab40d23",
                        "glosses": [
                            "Vorrichtung an Wehren oder anderen für Fische normalerweise unüberwindlichen Hindernissen, die es speziell den Aalen ermöglicht, diese zu passieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "522cc232-ce0f-4ef1-9d9b-15e352621687",
                                "sense_id": "03dbaa1e-32cf-35f3-81b8-2581974f4e2b",
                                "text": "In der Nähe wurde eine neue Aalleiter angelegt."
                            },
                            {
                                "example_id": "135fa621-f87e-415f-b032-96b8b5010f16",
                                "sense_id": "03dbaa1e-32cf-35f3-81b8-2581974f4e2b",
                                "text": "„In jedem Wehrpfeiler sind besondere Aalleitern eingebaut, das sind mit Faschinen umkleidete Ketten, an denen sich die Jungaale beim Aufstieg in die Mosel ‚hochturnen‘ können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
