    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fad24b3a-482d-396d-9d16-fbb4c048e37b",
                    "sense_definition": "Not yet settled or decided.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exact date of the meeting remains <w>undetermined</w> at this time.",
                            "target_lang_translations": {
                                "ru": "Точная дата встречи в настоящее время остается <w>неопределенной</w>."
                            }
                        },
                        {
                            "text": "The cause of the fire is still <w>undetermined</w> according to the investigators.",
                            "target_lang_translations": {
                                "ru": "По словам следователей, причина пожара до сих пор <w>не установлена</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "unsettled",
                        "undecided",
                        "uncertain"
                    ],
                    "antonyms": [
                        "determined",
                        "settled"
                    ],
                    "common_phrases": [
                        "remain undetermined"
                    ],
                    "target_lang_definitions": {
                        "ru": "Еще не решенный или не установленный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неопределенный",
                                "target_lang_sense_clarification": "общий термин для чего-то, что еще не имеет четкого статуса"
                            },
                            {
                                "target_lang_word": "неустановленный",
                                "target_lang_sense_clarification": "часто используется в официальных или юридических контекстах"
                            },
                            {
                                "target_lang_word": "нерешенный",
                                "target_lang_sense_clarification": "подчеркивает отсутствие окончательного решения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "820186e1-2d6e-36f5-a9cb-5fb2f08c1c0c",
                    "sense_definition": "Not limited or clearly defined.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project has an <w>undetermined</w> scope that makes planning difficult.",
                            "target_lang_translations": {
                                "ru": "У проекта <w>неопределенный</w> масштаб, что затрудняет планирование."
                            }
                        },
                        {
                            "text": "The substance had an <w>undetermined</w> chemical structure.",
                            "target_lang_translations": {
                                "ru": "Вещество имело <w>неопределенную</w> химическую структуру."
                            }
                        }
                    ],
                    "synonyms": [
                        "vague",
                        "undefined",
                        "indeterminate"
                    ],
                    "antonyms": [
                        "defined",
                        "limited"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не ограниченный или не имеющий четких границ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неопределенный",
                                "target_lang_sense_clarification": "отсутствие четких границ или характеристик"
                            },
                            {
                                "target_lang_word": "неясный",
                                "target_lang_sense_clarification": "размытый, нечеткий по своей природе"
                            }
                        ]
                    }
                }
            ]
        },
        {
