                                "example_id": "778cb39e-0ece-4e42-b102-ea0f1798f4c5",
                                "sense_id": "db04c8cc-f359-3a92-a262-55fb8359e4a5",
                                "text": "„Der Aralsee hatte nach diversen Umweltsünden 90 Prozent seiner Wassermenge verloren.“"
