                "senses": [
                    {
                        "sense_id": "f5df910a-4932-3f1b-9bd7-f85694230b11",
                        "entry_id": "f31900f8-81b7-3a83-b44d-13a9ac7ace5e",
                        "glosses": [
                            "La résistance aux antibiotiques est la capacité d'un micro-organisme à résister aux effets des antibiotiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1efb964d-8d3a-4656-a4a3-7ea35182f615",
                                "sense_id": "f5df910a-4932-3f1b-9bd7-f85694230b11",
                                "text": "L’antibiorésistance résulte souvent d’un traitement antibiotique mal conduit, avec une dose ou une durée trop faibles."
                            },
                            {
                                "example_id": "0f5ed31b-a242-42a4-9c2a-e1cb7e73567e",
                                "sense_id": "f5df910a-4932-3f1b-9bd7-f85694230b11",
                                "text": "Lorsqu’elle n’est pas naturelle, l’antibiorésistance peut s’acquérir par des mécanismes de transmission des caractères génétiques extrachromosomiques ou chromosomiques."
                            },
                            {
                                "example_id": "45b5113e-800f-4eba-a270-4c5ebd6e84e7",
                                "sense_id": "f5df910a-4932-3f1b-9bd7-f85694230b11",
                                "text": "L’antibiorésistance du type streptomycine est dangereuse, lorsqu’elle touche le bacille tuberculeux."
                            }
                        ]
                    }
                ],
