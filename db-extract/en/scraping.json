                    }
                ],
                "senses": [
                    {
                        "sense_id": "982e9c12-5b64-32de-b026-80670ba8982c",
                        "entry_id": "9503f7d7-4189-3320-8cac-0e432a6f43c9",
                        "glosses": [
                            "The sound or action of something being scraped."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e67aced7-85f6-4859-9e7b-61b8cea09ff7",
                                "sense_id": "982e9c12-5b64-32de-b026-80670ba8982c",
                                "text": "We explored the basement, wherein she had so often heard heavy footsteps, thuddings, and scrapings."
                            }
                        ]
                    },
                    {
                        "sense_id": "52c3b0f7-3091-374e-b2b6-d9fe081f680f",
                        "entry_id": "9503f7d7-4189-3320-8cac-0e432a6f43c9",
                        "glosses": [
                            "Something removed by being scraped."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eba55b4-3d90-42d2-a34d-dd715bb7c4b5",
                                "sense_id": "52c3b0f7-3091-374e-b2b6-d9fe081f680f",
                                "text": "the scrapings of roads and ditches"
                            },
                            {
                                "example_id": "8b6b5fa4-e270-41cf-97dd-a53e52e601de",
                                "sense_id": "52c3b0f7-3091-374e-b2b6-d9fe081f680f",
                                "text": "[…] the tables in the refectory would be laid out with plates of bread and scrapings of butter, with bowls ready for the saltless and slightly burned porridge, with the dark wells of golden syrup that served a universal purpose in early Australian cookery."
                            }
                        ]
                    },
                    {
                        "sense_id": "1850dcde-8ec0-3603-a691-439185273ccb",
                        "entry_id": "9503f7d7-4189-3320-8cac-0e432a6f43c9",
                        "glosses": [
                            "Automated collection of data, data scraping."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b08fbfd-f2d7-4bfc-bbcb-0c42a3c4679d",
                                "sense_id": "1850dcde-8ec0-3603-a691-439185273ccb",
                                "text": "The practice of scraping the internet is longstanding and was largely disclosed by the companies and nonprofit organizations that did it. But it was not well understood or seen as especially problematic by the companies that owned the data."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88c5e4b3-91fd-469c-a9af-6424c6b2eb4b",
                        "source_entry_id": "9503f7d7-4189-3320-8cac-0e432a6f43c9",
                        "source_sense_description": "material removed when something has been scraped",
                        "target_lang_word": "raclement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raclement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94ab3615-1f14-3f79-a7f2-d0be42928208",
                                        "entry_id": "f4390e78-4435-322b-8812-32bbef47b759",
                                        "glosses": [
                                            "Action de racler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "470d4a9b-d08e-4feb-a47a-a9492605d4f2",
                                                "sense_id": "94ab3615-1f14-3f79-a7f2-d0be42928208",
                                                "text": "Ce que nous faisons en quelques discrets raclements de chaise."
                                            },
                                            {
                                                "example_id": "3a4a7fdb-84b2-476e-9265-c0509ff1cae6",
                                                "sense_id": "94ab3615-1f14-3f79-a7f2-d0be42928208",
                                                "text": "[…] il n’est pas bien sûr que Fabienne ait entendu son raclement de gorge."
                                            },
                                            {
                                                "example_id": "3a2ee0b6-ec90-44a0-ae75-933f02181388",
                                                "sense_id": "94ab3615-1f14-3f79-a7f2-d0be42928208",
                                                "text": "Dans le silence de la salle, le raclement de la petite cuillère contre la tasse produisait un son épouvantable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e342aa85-75c2-3df7-a358-fea461fe2c90",
                                        "entry_id": "f4390e78-4435-322b-8812-32bbef47b759",
                                        "glosses": [
                                            "Bruit d’une chose qui en racle une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35ed1fba-2f19-435f-8962-af2ac6a636ef",
                                                "sense_id": "e342aa85-75c2-3df7-a358-fea461fe2c90",
                                                "text": "Ils s’arrêtèrent. On distinguait des raclements réguliers et rapides, un peu le bruit que font, dans les montées, certains tramways à vapeur."
                                            },
                                            {
                                                "example_id": "ed462ee5-6e9d-44c6-b4b6-27c1d16256ea",
                                                "sense_id": "e342aa85-75c2-3df7-a358-fea461fe2c90",
                                                "text": "Mais les uns après les autres ils se levaient, et lorsque j’avais entendu le dernier raclement de chaise sur le trottoir, […]."
                                            },
                                            {
                                                "example_id": "60f9f9e3-db86-4b01-8aa7-e8f824290212",
                                                "sense_id": "e342aa85-75c2-3df7-a358-fea461fe2c90",
                                                "text": "La conversation s’arrêta aussitôt, il y eut un raclement de chaise et Mélanie apparût devant lui; elle avait les traits extraordinairement tirés; cela la vieillissait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
