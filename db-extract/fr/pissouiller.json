                "senses": [
                    {
                        "sense_id": "cbda9eb3-33c8-3a2f-99a9-fd9f597274e4",
                        "entry_id": "cabb6eec-b04c-39ea-b511-d6cde456a371",
                        "glosses": [
                            "Pisser un peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "220ae6c5-8b0b-4479-a8b6-a87d44944ad0",
                                "sense_id": "cbda9eb3-33c8-3a2f-99a9-fd9f597274e4",
                                "text": "Je ne sais pas, je pissouille comme un chiot, quand je fais trois à quatre gouttes, ça relève de l'exploit !..."
                            },
                            {
                                "example_id": "1335da01-1f95-4750-8768-d563228d6548",
                                "sense_id": "cbda9eb3-33c8-3a2f-99a9-fd9f597274e4",
                                "text": "Voilà, je me soulage, je lansquine, je pissouille, je compisse, je fais couler la bonbonne, je me verse une mousse, l'ouvre l'écluse, je détartre le robinet…"
                            },
                            {
                                "example_id": "f9eaed0e-8d88-45d1-b293-0092e9a6c194",
                                "sense_id": "cbda9eb3-33c8-3a2f-99a9-fd9f597274e4",
                                "text": "Ils le léchouillent, ils mordouillent, bavouillent, pissouillent."
                            }
                        ]
                    }
                ],
