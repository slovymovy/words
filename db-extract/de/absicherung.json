                    {
                        "sense_id": "828c8392-a40f-38c9-878f-0d130e8fd56a",
                        "entry_id": "0c8ee642-d495-3b6c-92db-97564b5934b4",
                        "glosses": [
                            "Maßnahme, die persönliche Risiken mindert oder im Schadensfall den Schaden ausgleicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "102f031e-5a03-4dc8-a1fa-6054f029cc13",
                                "sense_id": "828c8392-a40f-38c9-878f-0d130e8fd56a",
                                "text": "Ich habe den Vertrag zu meiner Absicherung unterschrieben."
                            },
                            {
                                "example_id": "a09c1fe1-f340-40f7-bca6-26fc595b3320",
                                "sense_id": "828c8392-a40f-38c9-878f-0d130e8fd56a",
                                "text": "Eine Rentenversicherung ist eine Absicherung gegen Armut im Alter."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "332ac5b6-1cd9-3885-8ecf-5f610bc68c54",
                        "entry_id": "0c8ee642-d495-3b6c-92db-97564b5934b4",
                        "glosses": [
                            "Maßnahme, die einen gefährlichen Ort, zum Beispiel eine Gefahrenstelle oder einen Unfallort, für hinzukommende Personen sicherer macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cd4580b-9628-46eb-9119-e4b830a4c251",
                                "sense_id": "332ac5b6-1cd9-3885-8ecf-5f610bc68c54",
                                "text": "„Hierzu kann aus der Erfahrung mehrjähriger Tätigkeit bei der Autobahnpolizei empfohlen werden, Berufsanfänger zunächst zur Absicherung der Unfallstelle sowie zum Fertigen der Unfallskizze einzusetzen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
