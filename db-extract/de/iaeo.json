                                "target_senses": [
                                    {
                                        "sense_id": "92d8d685-212a-38e6-98b7-67f783a7eaaa",
                                        "entry_id": "189083a2-b160-33a2-a7ff-bdbc85478311",
                                        "glosses": [
                                            "Initialism of International Atomic Energy Agency."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "478d5659-fb26-4d4e-ae6b-cea026f05ff3",
                                                "sense_id": "92d8d685-212a-38e6-98b7-67f783a7eaaa",
                                                "text": "“We have achieved something very important today and the important thing is the IAEA is staying here – let the world know that the IAEA is staying at Zaporizhzhia,” Grossi said in a video from Russia’s RIA Novosti news agency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed359926-4f10-4815-9b29-059cf69c5e89",
                        "source_entry_id": "8a58b834-863e-3f0f-a284-1e9d6b19d0cc",
                        "source_sense_id": "05471334-c18f-3102-9e96-3f2cd5f6c2d4",
