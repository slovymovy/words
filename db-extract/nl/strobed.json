                        "glosses": [
                            "een bed van stro waarop men kan slapen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68bca4a0-5f0f-41b6-8a22-6cff5c42ce4b",
                                "sense_id": "71c0097d-ed6a-36ef-96d6-d0e7c8f77115",
                                "text": ",,Vijf jaar geleden begonnen we een Bed & Breakfast met een groot strobed op de hooizolder. Dat was zo'n hit dat we er een strokasteel bijbouwden in de schuur ernaast. Ook dat liep als een trein."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a7195b5-7348-3311-ab35-ff719d8dcef1",
                        "entry_id": "8821dfe6-4da0-32a0-a218-ffe8feb20d7f",
                        "glosses": [
                            "een laag stro in een stal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c6ccc3b-f8e9-4daa-a761-c997a0ceacbd",
                                "sense_id": "4a7195b5-7348-3311-ab35-ff719d8dcef1",
                                "text": "Veehouders moeten dit jaar veel meer geld neerleggen voor het strobed van hun dieren. Door het slechte zomerweer is de helft minder stro geoogst. Waar normaal 6 ton van een hectare komt, is dat nu zo'n 3 ton. Stro is schaars en daardoor duur."
                            }
                        ]
                    }
