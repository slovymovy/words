                "senses": [
                    {
                        "sense_id": "3dfb8af7-0e81-3314-8785-5af5e00b30b2",
                        "entry_id": "670e74c0-1097-31c5-b3e8-b9b78d9bedd4",
                        "glosses": [
                            "tekst die in de rand van een munt is gedrukt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0c14a18-0494-40d3-9c6a-0cf79c851c9e",
                                "sense_id": "3dfb8af7-0e81-3314-8785-5af5e00b30b2",
                                "text": "Het randschrift wordt gedrukt op een blanco munt (een rondel), waaruit vervolgens de buitenste ring van de munt wordt gestanst. Die moet dan worden samengevoegd met de anderskleurige kern van de munt."
                            },
                            {
                                "example_id": "0772438a-a077-43b3-b232-3f9ea0b46689",
                                "sense_id": "3dfb8af7-0e81-3314-8785-5af5e00b30b2",
                                "text": "Indertijd bij de besluitvorming over de euro hadden alle landen hun specifieke wensen Nederland bijvoorbeeld het randschrift en daar hoorde onder meer de handhaving van één- en twee-centsmunten bij."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b8ee19d-0191-4498-a46a-af4aacd85acf",
                        "source_entry_id": "670e74c0-1097-31c5-b3e8-b9b78d9bedd4",
                        "source_sense_id": "3dfb8af7-0e81-3314-8785-5af5e00b30b2",
