                    "frequency": "High",
                    "semantic_group_id": "aleatoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons choisi un livre complètement au <w>hasard</w> sur l'étagère de la bibliothèque."
                        },
                        {
                            "text": "Je l'ai rencontré tout à fait par <w>hasard</w> ce matin dans les rues du quartier."
                        }
                    ],
                    "common_phrases": [
