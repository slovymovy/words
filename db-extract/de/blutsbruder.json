                "senses": [
                    {
                        "sense_id": "067b1967-c00e-37d6-8539-879db492cae6",
                        "entry_id": "e992a79a-6023-3fd8-a627-cc4be0fe5fb0",
                        "glosses": [
                            "Person, mit der man stark befreundet ist und der man seine tiefe Verbundenheit durch Vermischung von Blut ausdrückt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5da47e8e-7a71-4bec-806c-dce59347b687",
                                "sense_id": "067b1967-c00e-37d6-8539-879db492cae6",
                                "text": "„Sie stammen aus einer Familie und sind Blutsbrüder oder Cousins.“"
                            },
                            {
                                "example_id": "77a2c16e-4005-4d9b-96c0-1f11540ac8bd",
                                "sense_id": "067b1967-c00e-37d6-8539-879db492cae6",
                                "text": "„Aber der Holzinger ist ein Verräter, obwohl er doch eigentlich mein Blutsbruder ist, denn wir haben uns einmal die Hand aufgeschnitten und unser Blut mit Wasser vermischt und haben es getrunken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
