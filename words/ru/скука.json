                {
                    "sense_id": "57c529da-fab6-34c0-93a9-8a97860abbc8",
                    "sense_definition": "Отсутствие веселья и занимательности; обстановка, вызывающая уныние.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом маленьком городе зимой сплошная <скука>.",
                            "target_lang_translations": {
                                "en": "In this small town, winter is sheer <w>boredom</w>.",
                                "nl": "In dit kleine stadje is het in de winter één en al <w>verveling</w>.",
                                "pl": "W tym małym miasteczku zimą panuje kompletna <w>nuda</w>.",
                                "fr": "Dans cette petite ville, l'hiver est un <w>ennui</w> total.",
                                "de": "In dieser kleinen Stadt herrscht im Winter die reine <w>Langeweile</w>.",
                                "es": "En esta pequeña ciudad, el invierno es un puro <w>aburrimiento</w>.",
                                "it": "In questa piccola città d'inverno c'è solo una gran <w>noia</w>.",
                                "tr": "Bu küçük kasabada kışın tam bir can <w>sıkıntısı</w> hakimdir.",
                                "cs": "V tomhle malém městě je v zimě naprostá <w>nuda</w>."
                            }
                        },
                        {
                            "text": "Какая <скука> сидеть дома весь день!",
                            "target_lang_translations": {
                                "en": "What a <w>bore</w> to sit at home all day!",
                                "nl": "Wat een <w>saaiheid</w> om de hele dag thuis te zitten!",
                                "pl": "Co za <w>nuda</w> siedzieć w domu cały dzień!",
                                "fr": "Quelle <w>barbe</w> de rester assis à la maison toute la journée !",
                                "de": "Was für eine <w>Langeweile</w>, den ganzen Tag zu Hause zu sitzen!",
                                "es": "¡Qué <w>rollo</w> quedarse en casa todo el día!",
                                "it": "Che <w>noia</w> stare a casa tutto il giorno!",
                                "tr": "Bütün gün evde oturmak ne büyük <w>sıkıcılık</w>!",
                                "cs": "To je ale <w>nuda</w> sedět celý den doma!"
                            }
                        }
                    ],
