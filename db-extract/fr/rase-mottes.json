                ],
                "senses": [
                    {
                        "sense_id": "1028a4ea-2c49-3dda-8c3b-9a819ad7df1c",
                        "entry_id": "df1fd650-b71e-3f93-95df-c60195ea9cff",
                        "glosses": [
                            "Vol à très basse altitude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b957708-8c26-48e8-9cc1-65d77a593888",
                                "sense_id": "1028a4ea-2c49-3dda-8c3b-9a819ad7df1c",
                                "text": "Les habitants se plaignent des nuisances sonores causées par les vols d’avions en rase-mottes."
                            },
                            {
                                "example_id": "39d5e844-88e8-479a-b1b4-f98fd74a2b15",
                                "sense_id": "1028a4ea-2c49-3dda-8c3b-9a819ad7df1c",
                                "text": "La démonstration de voltige a supprimé tous les vols en rase-mottes de son programme, car le public craint un accident comparable à celui qui avait fait de nombreuses victimes l’an passé."
                            },
                            {
                                "example_id": "4f77a13e-f0a3-456f-8175-5346d3269ff3",
                                "sense_id": "1028a4ea-2c49-3dda-8c3b-9a819ad7df1c",
                                "text": "Graux … lui fit signe de regarder par le hublot et elle y resta cramponnée tandis qu'on volait en rase-mottes au-dessus d'un troupeau de girafes et d'antilopes."
                            },
                            {
                                "example_id": "eac93c93-f175-4753-80bc-5ecf5d19b2be",
                                "sense_id": "1028a4ea-2c49-3dda-8c3b-9a819ad7df1c",
                                "text": "Les mouettes surfaient sur les courants d’air. Elles planaient, affranchies de toute gravité, ou repliaient les ailes et se lançaient en rase-mottes sur la crête des vagues grises."
                            }
                        ]
                    }
                ],
