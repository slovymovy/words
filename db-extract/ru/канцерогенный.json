                                        "entry_id": "07b3ea26-8c7c-314d-b0c8-e5f583d2e225",
                                        "glosses": [
                                            "Causing the formation of tumors."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd1dd60c-8dc4-4532-9dc3-9c233752e55e",
                                                "sense_id": "eb472e4f-4fe9-36da-97bc-126a8e77f836",
                                                "text": "oncogenic viruses"
                                            },
                                            {
                                                "example_id": "cd7ce2b1-91f3-45df-a999-681d6e84ad07",
                                                "sense_id": "eb472e4f-4fe9-36da-97bc-126a8e77f836",
                                                "text": "From the late 1960s research into oncogenic viruses was particularly advanced by David Baltimore (b. 1938) and Howard Tenin (1934–94), who simultaneously published a report of the discovery of an enzyme reverse transcriptase."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a88c36f-2f03-3a8a-9ca1-ba01912de4ef",
                                        "entry_id": "07b3ea26-8c7c-314d-b0c8-e5f583d2e225",
                                        "glosses": [
                                            "Arising from or caused by a tumor: tumor-induced."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bbd10d3-66b6-4c48-9f65-1df409509a2a",
