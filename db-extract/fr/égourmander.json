                "senses": [
                    {
                        "sense_id": "eb63b2d4-00da-3043-9934-6795bdf699ee",
                        "entry_id": "38c9fda9-c0da-3ff1-a965-15ebc66ab770",
                        "glosses": [
                            "Enlever les pousses gourmandes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e77b8d8d-41c0-48df-9bb7-0a36de47ed70",
                                "sense_id": "eb63b2d4-00da-3043-9934-6795bdf699ee",
                                "text": "Tous ces soins, Bounthan ne les regrette pas et il continue, trois ou quatre fois par an, à nettoyer, égourmander et fumer sa plantation."
                            },
                            {
                                "example_id": "c70b48ea-8b6d-430a-a056-a139aa9aa307",
                                "sense_id": "eb63b2d4-00da-3043-9934-6795bdf699ee",
                                "text": "Petites faucilles à « égourmander dans les sentiers de fraisiers »"
                            },
                            {
                                "example_id": "388464fe-a13a-4f4c-8454-aa9264d9bcfe",
                                "sense_id": "eb63b2d4-00da-3043-9934-6795bdf699ee",
                                "text": "Marcher et se baisser pour égourmander, ou enlever ces jeunes pousses superflues aux pieds des vignes."
                            }
                        ]
                    }
