                {
                    "sense_id": "3173e6ff-5e69-35d1-837e-1047cfd056d1",
                    "sense_definition": "An agricultural machine used to plant seeds in rows and cover them with soil.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer attached the seed <w>drill</w> to the tractor before heading to the field.",
                            "target_lang_translations": {
                                "ru": "Фермер прицепил зерновую <w>сеялку</w> к трактору перед тем, как отправиться в поле.",
                                "tr": "Çiftçi, tarlaya gitmeden önce tohum <w>mibzerini</w> traktöre bağladı."
                            }
                        },
                        {
                            "text": "Using a modern <w>drill</w> ensures that the crops are spaced evenly.",
                            "target_lang_translations": {
                                "ru": "Использование современной <w>сеялки</w> гарантирует, что посевы будут расположены равномерно.",
                                "tr": "Modern bir <w>ekim makinesi</w> kullanmak, ürünlerin eşit aralıklarla dikilmesini sağlar."
                            }
                        }
