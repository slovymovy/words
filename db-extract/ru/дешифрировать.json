                                "target_senses": [
                                    {
                                        "sense_id": "6ca75288-9145-33fc-89ad-e094e3db55a8",
                                        "entry_id": "dec1df1f-f91d-3017-a015-eac149071e89",
                                        "glosses": [
                                            "A decoded communication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5de0d50e-2e4d-4643-99aa-5c400cf6e944",
                                                "sense_id": "6ca75288-9145-33fc-89ad-e094e3db55a8",
                                                "text": "The decrypts were being obtained from the traffic of 78 German stations by the end of 1941, and of 147 stations by the end of 1942."
                                            }
