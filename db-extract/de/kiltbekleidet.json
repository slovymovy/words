                        "examples": [
                            {
                                "example_id": "bd1dcc9c-b098-41f1-8db2-aadddd71115a",
                                "sense_id": "b2c93c93-249b-37a1-bbf4-c6e1d9757ede",
                                "text": "Die Dudelsäcke schrillen und quietschen ihre eigenartigen Märsche und Volkslieder, bei deren Melodien man unwillkürlich die alten Clans, kiltbekleidet, die haarbesetzten „Sporrans“, die Beutel, vor dem Leib.",
                                "translation": "The bagpipes skirl and squeal their peculiar marches and folk songs, in their melodies instinctively the old clans, bekilted, the fur-trimmed \"sporran\", the pouch in front of the body.",
                                "english": "The bagpipes skirl and squeal their peculiar marches and folk songs, in their melodies instinctively the old clans, bekilted, the fur-trimmed \"sporran\", the pouch in front of the body."
                            },
                            {
                                "example_id": "ed450db7-ea0d-4b6d-930b-55d9eb370da7",
                                "sense_id": "b2c93c93-249b-37a1-bbf4-c6e1d9757ede",
                                "text": "So schwer hatte sie es nicht ihre phantastischen Geschichten zu erfinden, denn jeder kiltbekleidete schottische Großvater sofern er noch einigermaßen diesseits der Demenz ist, hat ähnliche Geschichten für seine rotwangigen, sommersprossigen Enkel zuhauf parat.",
                                "translation": "It wasn't too hard for her to invent her fantastic stories because every bekilted Scottish grandfather, so long as he is still on the right side of dementia, has similar tales galore at hand for his rosy-cheeked, freckled grandchildren.",
                                "english": "It wasn't too hard for her to invent her fantastic stories because every bekilted Scottish grandfather, so long as he is still on the right side of dementia, has similar tales galore at hand for his rosy-cheeked, freckled grandchildren."
                            },
                            {
                                "example_id": "85fee43e-c3d1-4311-b864-8dba47df9038",
                                "sense_id": "b2c93c93-249b-37a1-bbf4-c6e1d9757ede",
                                "text": "Seconds later he was asleep on Will's bekilted lap."
                            }
                        ]
                    }
