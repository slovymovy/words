                    {
                        "sense_id": "8b18f00d-f40d-3869-b9e4-eed6d556be8c",
                        "entry_id": "dba83862-995a-3736-be0a-7a1252e293b3",
                        "glosses": [
                            "Cas grammatical fondamental dans une langue ergative, marquant le sujet d’un verbe intransitif et le COD d’un verbe transitif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae879a92-b3cb-4946-be10-0a2995924751",
                                "sense_id": "8b18f00d-f40d-3869-b9e4-eed6d556be8c",
                                "text": "Généralement, l’absolutif est formé à partir des verbes perfectifs et le gérondif à partir des verbes imperfectifs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3ee8189-d6d6-47d5-acbb-04d743e74dc9",
