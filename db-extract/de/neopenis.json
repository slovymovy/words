                "senses": [
                    {
                        "sense_id": "38d41a0f-e8f1-3d22-ba23-c89973cb257f",
                        "entry_id": "12eb2db5-8726-3bf7-9e36-5bc9b3670c5f",
                        "glosses": [
                            "künstlicher beziehungsweise operativ angelegter Penis, zum Beispiel bei angeborener Fehlbildung oder im Rahmen einer Geschlechtsumwandlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61a22c13-ba01-4788-a2fc-88e9979210cd",
                                "sense_id": "38d41a0f-e8f1-3d22-ba23-c89973cb257f",
                                "text": "Zur besseren Durchblutung des Neopenis und zur Versteifung setzten einige Operateure darauf, ein Stück Knochen zu verwenden."
                            },
                            {
                                "example_id": "52b803e6-25d3-4234-9fd4-5d601901eb58",
                                "sense_id": "38d41a0f-e8f1-3d22-ba23-c89973cb257f",
                                "text": "Es wurde die Möglichkeit der Anlage eines Neopenis aus einem radialen Unterarmlappen diskutiert."
                            },
                            {
                                "example_id": "fd6a865e-ed46-4f97-8d61-5a58e275d825",
                                "sense_id": "38d41a0f-e8f1-3d22-ba23-c89973cb257f",
                                "text": "Gegenwärtig sind Chirurgen, Urologen und Gynäkologen vor allem damit befasst, einen Neo-Penis und eine Neo-Klitoris zu konstruieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99a6dca7-62bb-4e3a-8760-3f77ec9bdc8d",
