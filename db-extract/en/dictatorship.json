                        "entry_id": "ebbc96b6-426c-3a1c-9a07-6df5803d4cbb",
                        "glosses": [
                            "A type of government where absolute sovereignty is allotted to an individual or a small clique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1685caa4-5db9-3a7c-86e1-7638295d159a",
                        "entry_id": "ebbc96b6-426c-3a1c-9a07-6df5803d4cbb",
                        "glosses": [
                            "A government which exercises autocratic rule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f8aecde-f3fb-4895-8e23-e865667edf6e",
                                "sense_id": "1685caa4-5db9-3a7c-86e1-7638295d159a",
                                "text": "There were no elections during Franco's dictatorship."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ecabfc7-a93f-3a83-bdc7-7702e9816290",
                        "entry_id": "ebbc96b6-426c-3a1c-9a07-6df5803d4cbb",
                        "glosses": [
                            "Any household, institution, or other organization that is run under such sovereignty or autocracy."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd5a00dc-7f08-4ffd-8f07-b2bcd1530c6b",
                        "source_entry_id": "ebbc96b6-426c-3a1c-9a07-6df5803d4cbb",
                        "source_sense_description": "a government led by a dictator",
                        "target_lang_word": "diktatura",
                        "target_lang_code": "cs",
