            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9825c78c-d06a-3750-9766-95d509b3a3a1",
                    "sense_definition": "Cuire ou faire dorer un aliment sur un gril, au four ou dans un grille-pain.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous allons <w>griller</w> de la viande pour le dîner ce soir."
                        },
                        {
                            "text": "Il aime faire <w>griller</w> du pain frais tous les matins au petit-déjeuner."
                        }
                    ],
                    "synonyms": [
                        "rôtir"
                    ],
                    "common_phrases": [
                        "faire griller du pain",
                        "griller des saucisses"
                    ]
                },
                {
                    "sense_id": "737972eb-0c32-3561-9d2a-d29c3bba5a6a",
                    "sense_definition": "Franchir un arrêt, un signal ou ignorer une priorité sans marquer l'arrêt obligatoire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "infraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur imprudent a été arrêté après avoir <w>grillé</w> un feu rouge en plein centre-ville."
                        },
                        {
                            "text": "Tu risques une amende et des points en moins si tu <w>grilles</w> cette priorité."
                        }
                    ],
                    "common_phrases": [
                        "griller un feu rouge",
                        "griller une priorité",
                        "griller les étapes"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
