                                "target_senses": [
                                    {
                                        "sense_id": "8ae71cd1-43dd-34bd-9044-fbc22f64a6ca",
                                        "entry_id": "dfb53237-6cb5-3f8d-aab5-0a65a8036a24",
                                        "glosses": [
                                            "Concerning the relationships between the governments of countries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25f519e5-1f79-4c84-8811-f108246308d2",
                                                "sense_id": "8ae71cd1-43dd-34bd-9044-fbc22f64a6ca",
                                                "text": "She spent thirty years working for Canada's diplomatic service."
                                            },
                                            {
                                                "example_id": "c99ce689-a295-4e39-8e79-a76e43e66c11",
                                                "sense_id": "8ae71cd1-43dd-34bd-9044-fbc22f64a6ca",
                                                "text": "Albania immediately severed diplomatic relations with Zimbabwe."
                                            },
                                            {
                                                "example_id": "4422b854-2e4d-44b2-8744-eaa0aaadebed",
                                                "sense_id": "8ae71cd1-43dd-34bd-9044-fbc22f64a6ca",
                                                "text": "Born in 1950 towards the end of the Stalin era to diplomatic parents, he was educated at the elite Russian Institute of International Relations before ascending to become Russia’s envoy at the UN, where for a decade he lived through the trauma of the collapse of the Soviet Union."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e3b57c6-5014-3238-84f8-14c70b357f8c",
                                        "entry_id": "dfb53237-6cb5-3f8d-aab5-0a65a8036a24",
                                        "glosses": [
                                            "Exhibiting diplomacy; exercising tact or courtesy; using discussion to avoid hard feelings, fights or arguments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6055ca18-6394-4113-a08e-fbb85e1f56dd",
                                                "sense_id": "1e3b57c6-5014-3238-84f8-14c70b357f8c",
                                                "text": "Thoughtful corrections can be diplomatic as well as instructional."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3031596f-adbd-30a0-8868-646464434cfe",
                                        "entry_id": "dfb53237-6cb5-3f8d-aab5-0a65a8036a24",
                                        "glosses": [
                                            "Describing a publication of a text which follows a single basic manuscript, but with variants in other manuscripts noted in the critical apparatus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "881efb20-80b8-32a6-b940-589bb4ca8077",
                                        "entry_id": "dfb53237-6cb5-3f8d-aab5-0a65a8036a24",
                                        "glosses": [
                                            "Relating to diplomatics, or the study of old texts; paleographic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
