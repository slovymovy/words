                "senses": [
                    {
                        "sense_id": "23db5c52-f954-3e5d-8712-f51975bcea00",
                        "entry_id": "18148bdd-4403-34d7-b81a-b757045a5394",
                        "glosses": [
                            "To deprive of a sheath; to draw from the sheath or scabbard, as a sword."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bb6d629-7738-4bc0-96ee-7ce8d4a23121",
                                "sense_id": "23db5c52-f954-3e5d-8712-f51975bcea00",
                                "text": "When I unsheathe the blade, it makes such a satisfying sound that I do it again."
                            },
                            {
                                "example_id": "ca9449e6-55f5-459a-824d-6dac5fa3b5d4",
                                "sense_id": "23db5c52-f954-3e5d-8712-f51975bcea00",
                                "text": "Yes, Europe shared many of the concerns that had prompted U.S. President Donald Trump to unsheathe the tariff sword and seek to reshape trade with China."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66774ce5-b846-44a3-b1ba-8d0ce4dbd6b0",
                        "source_entry_id": "18148bdd-4403-34d7-b81a-b757045a5394",
                        "source_sense_id": "23db5c52-f954-3e5d-8712-f51975bcea00",
                        "source_sense_description": "to pull a sword from a sheath",
                        "target_lang_word": "dégainer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dégainer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ada1db2-8293-3eae-9fc9-9f0e87d09fd6",
                                        "entry_id": "2609f5d7-0ab5-3c67-a000-53c7ca346a89",
                                        "glosses": [
                                            "Tirer un instrument perçant ou tranchant de sa gaine, de son fourreau."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b20a4e6-5901-3c54-ab09-f2c6be59475f",
                                        "entry_id": "2609f5d7-0ab5-3c67-a000-53c7ca346a89",
                                        "glosses": [
                                            "Mettre l’épée à la main pour se battre."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d19431ae-9f40-4e92-a781-c1131f23846c",
                                                "sense_id": "4b20a4e6-5901-3c54-ab09-f2c6be59475f",
                                                "text": "Les deux adversaires avaient hâte de dégainer."
                                            },
                                            {
                                                "example_id": "6da5d204-d60f-48a4-99c3-5b92e2f86a80",
                                                "sense_id": "4b20a4e6-5901-3c54-ab09-f2c6be59475f",
                                                "text": "Quand on en vint à dégainer."
                                            },
                                            {
                                                "example_id": "5ac2ddc2-3b65-4360-8969-7447c3c12036",
                                                "sense_id": "4b20a4e6-5901-3c54-ab09-f2c6be59475f",
                                                "text": "Il en résulta que, lorsque d’Artagnan voulut en effet dégainer, il se trouva purement et simplement armé d’un tronçon d’épée de huit ou dix pouces à peu près."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d3f17ea-c5c1-320d-ab6b-5e497b96a510",
                                        "entry_id": "2609f5d7-0ab5-3c67-a000-53c7ca346a89",
                                        "glosses": [
                                            "Sortir une arme de poing de l’étui où elle est serrée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c819737-ae8d-4316-b0e3-ab2f4860d846",
                                                "sense_id": "4d3f17ea-c5c1-320d-ab6b-5e497b96a510",
                                                "text": "Lula prit un chickenburger, moi un cheeseburger, Cal et Junior, rien. Je suppose qu'ils ne mangent jamais pendant le service. Ils ne veulent pas avoir les mains prises par un hamburger au cas où ils devraient dégainer leur arme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c63408e3-ee97-3c81-9bbd-4c12657ff53e",
                                        "entry_id": "2609f5d7-0ab5-3c67-a000-53c7ca346a89",
                                        "glosses": [
                                            "Sortir de son chapeau, proposer comme solution originale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "423d8311-b838-46d8-80c1-8fe3f5d14b5b",
                                                "sense_id": "c63408e3-ee97-3c81-9bbd-4c12657ff53e",
                                                "text": "Là, ils dégainent le sirop de Bissap, un classique africain à base de feuilles d’hibiscus, associé à de l’eau de fleur d’oranger, et shaké avec un blanc d’œuf…"
                                            },
                                            {
                                                "example_id": "a7daa658-d5de-43db-a945-ba887d13544e",
                                                "sense_id": "c63408e3-ee97-3c81-9bbd-4c12657ff53e",
                                                "text": "Aussi, le gouvernement n'étant autorisé à dégainer le 49.3 que sur un seul texte par session, hors budgets, il a profité de cette session extraordinaire pour l'utiliser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e4f7c35-a11c-391d-954e-ed5e12f7d1f6",
                                        "entry_id": "2609f5d7-0ab5-3c67-a000-53c7ca346a89",
                                        "glosses": [
                                            "Pour un homme, montrer son pénis, ou le retirer de l’orifice sexuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16d4c185-158d-43aa-ba2d-cd0ec1221587",
                                                "sense_id": "3e4f7c35-a11c-391d-954e-ed5e12f7d1f6",
                                                "text": "Après quoi le juge n’eut plus qu’à bondir, tout nu et honteusement dégainé, jusqu’à sa cabine en compagnie du jeune homme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
