                        "form": "dem Populismus"
                    },
                    {
                        "form_id": "9676eac7-e8ab-45c6-bad7-0323fa3c09b3",
                        "entry_id": "99c6de59-6278-39e1-8369-b1596a66893a",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Populismus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "542a19bb-9d76-3b21-b9bc-7b349d184f74",
                        "entry_id": "99c6de59-6278-39e1-8369-b1596a66893a",
                        "glosses": [
                            "volksnahe, oft demagogische Politik mit dem Ziel, vor allem den Massen zu gefallen"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "32af1aa2-09e8-4210-82d6-5af4436f292b",
                                "sense_id": "542a19bb-9d76-3b21-b9bc-7b349d184f74",
                                "text": "Durch Populismus erhoffte sich die Opposition mehr Stimmen bei der nächsten Wahl."
                            },
                            {
                                "example_id": "9ac9f088-4064-4375-b2a2-e1feba62f9fa",
                                "sense_id": "542a19bb-9d76-3b21-b9bc-7b349d184f74",
                                "text": "„Wie kein anderer Herrscher machte Tiberius wenig Aufhebens von seiner Person und verzichtete auf Populismus und übertriebene Selbstdarstellung.“"
                            },
                            {
                                "example_id": "e26f4f53-d8e0-40e3-a2e9-55e3e08e5a0e",
                                "sense_id": "542a19bb-9d76-3b21-b9bc-7b349d184f74",
                                "text": "„Es ist nicht das erste Mal, dass die CSU kurz vor ihrer Kreuther Klausurtagung durch Populismus auffällt.“"
                            },
                            {
                                "example_id": "52314bfd-81f4-49a4-9b6b-202452ce6020",
                                "sense_id": "542a19bb-9d76-3b21-b9bc-7b349d184f74",
                                "text": "„Aus diesem Grund fällt der Populismus in jener Region auf fruchtbaren Boden, und als in Deutschland Hitlers Regime aufkommt, rekrutieren sich unter den Bewohnern Hindenburgs zahlreiche Kollaborateure.“"
                            },
                            {
                                "example_id": "d14f703f-7914-44b8-815c-b54c3a4c0fa8",
                                "sense_id": "542a19bb-9d76-3b21-b9bc-7b349d184f74",
                                "text": "„In Zeiten des triumphierenden Populismus und der Angriffe auf das politische Establishment macht man sich lieber ganz klein, wenn es ums Essen geht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8920712e-0b4c-3eea-87e2-ea4a0919e480",
                        "entry_id": "99c6de59-6278-39e1-8369-b1596a66893a",
                        "glosses": [
                            "literarischer Stil mit realistischen, naturalistischen Alltagsthemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94a06911-3d62-4119-80ae-7cfc22b6dc63",
                                "sense_id": "8920712e-0b4c-3eea-87e2-ea4a0919e480",
                                "text": "Das bürgerliche Schauspiel ist dem Populismus zuzurechnen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
