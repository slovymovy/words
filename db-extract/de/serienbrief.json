                "senses": [
                    {
                        "sense_id": "e2c9623f-0f66-39dc-b7da-bfc35622329a",
                        "entry_id": "974c5fce-876d-33ab-a4cb-f75e44912b42",
                        "glosses": [
                            "Brief, der mit gleichlautendem Inhalt an viele Empfänger versendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcb2b610-b6d0-4324-aab6-2f80e7adb1ab",
                                "sense_id": "e2c9623f-0f66-39dc-b7da-bfc35622329a",
                                "text": "„Harz wollte an die verdächtigten Ärzte einen Serienbrief schicken - er durfte aber nicht.“"
                            },
                            {
                                "example_id": "aa942a4b-7614-4690-9d3d-2b700c93aa92",
                                "sense_id": "e2c9623f-0f66-39dc-b7da-bfc35622329a",
                                "text": "„Für viele Aufgaben reichen die neuen WebApps völlig aus, etwa um einen Brief zu schreiben (und zu drucken), nicht jedoch, um einen Serienbrief zu Papier zu bringen, das ist der Vollversion vorbehalten.“"
                            }
                        ],
