                        "glosses": [
                            "A renowned Old English alliterative poem, preserved in a single manuscript within the Nowell Codex, composed sometime between 975 and 1025 AD."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f05ad68c-0b6e-4478-9046-e67e5c5f2758",
                                "sense_id": "00c0e876-67ee-3cb0-a7b1-13e073d45004",
                                "text": "John Gardner’s retelling of Beowulf is titled Grendel."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae6392da-4408-3777-9589-94daa5c844f5",
                        "entry_id": "2acb78d2-a3be-36a5-8742-7b9e5c18ee7c",
                        "glosses": [
                            "An Anglo-Saxon personal name, usually with reference to the hero of the poem, or to the poem itself."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "1328d045-a970-4a86-8736-862f7d36bec4",
                                "sense_id": "ae6392da-4408-3777-9589-94daa5c844f5",
                                "text": "Beowulf is as great a hero as Sigmund."
                            },
                            {
                                "example_id": "7a5381a3-8850-4dbb-952b-5c7b2a329c35",
                                "sense_id": "ae6392da-4408-3777-9589-94daa5c844f5",
                                "text": "The highest rank attainable is yokozuna, or grand champion. They are the heroes of the Japanese, the Rolands, the Beowulfs, the Siegfrieds of the Cherry Blossom Empire."
                            }
                        ]
                    }
