    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dae67d37-e29a-316a-91c3-fcbcbabc282b",
                "word": "vermicelli",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "551cca33-a477-4352-ab13-27e9c6d17d0b",
