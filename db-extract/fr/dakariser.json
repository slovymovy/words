                "senses": [
                    {
                        "sense_id": "3611b145-d350-3a83-a3fd-d554882c5c53",
                        "entry_id": "22d4502c-6be8-3ba1-92f5-94be61b66c76",
                        "glosses": [
                            "Donner un caractère dakarois à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "283da17e-12ae-4028-83f7-11bbc0767209",
                                "sense_id": "3611b145-d350-3a83-a3fd-d554882c5c53",
                                "text": "Ce qui a pu faire dire à notre ami Talla SYLLA que, Dakar ayant « dakarisé » le Sénégal, l’heure serait désormais à sa «dédakarisation», en vue notamment de lui redonner à la fois sa vraie nature et son vrai visage."
                            },
                            {
                                "example_id": "fdfe30ce-d979-4770-8d3b-1448b1f10966",
                                "sense_id": "3611b145-d350-3a83-a3fd-d554882c5c53",
                                "text": "Perso, je vois pas en quoi avoir dit que Brest était un port de pêche est pire que de dire que Rennes commence à se Dakariser."
                            }
                        ]
                    },
                    {
                        "sense_id": "a28bf1a9-94e1-3031-bebb-db11cece6702",
                        "entry_id": "22d4502c-6be8-3ba1-92f5-94be61b66c76",
                        "glosses": [
                            "Donner un caractère rappelant la compétition Paris-Dakar à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f847faab-ed4a-48c7-92c8-192581fcbc22",
                                "sense_id": "a28bf1a9-94e1-3031-bebb-db11cece6702",
                                "text": "Peut-être devriez-vous faire une sélection Pro et Amateurs, faute de quoi, Ménigoute risque fort de Dakariser son épreuve..."
                            },
                            {
                                "example_id": "af872a48-9d4a-4fb1-8723-6f830538ee8c",
                                "sense_id": "a28bf1a9-94e1-3031-bebb-db11cece6702",
                                "text": "T'es sur que tu veux la Dakariser ?"
                            }
                        ]
                    }
