                        "sur les instances de",
                        "avec instances"
                    ]
                },
                {
                    "sense_id": "96175932-b739-3c7f-8177-65aa54d0373a",
                    "sense_definition": "Chacune des structures composant l'appareil psychique selon la théorie psychanalytique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "psychanalyse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon Sigmund Freud, le moi représente l'<w>instance</w> consciente qui régule les pulsions."
                        },
                        {
                            "text": "Le conflit intérieur se manifeste entre les différentes <w>instances</w> de la personnalité."
