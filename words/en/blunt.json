{
    "word_family": [
        "bluntly",
        "bluntness",
        "blunten"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d8e94ccc-5c12-31f1-8083-01630b1df53a",
                    "sense_definition": "Having a thick edge or point; not sharp.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_edge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knife was too <w>blunt</w> to cut the tough meat.",
                            "target_lang_translations": {
                                "ru": "Нож был слишком <w>тупым</w>, чтобы разрезать жесткое мясо.",
                                "zh": "这把刀太<w>钝</w>了，切不开这块硬肉。"
                            }
                        },
                        {
                            "text": "He was struck on the head by a heavy, <w>blunt</w> object.",
                            "target_lang_translations": {
                                "ru": "Его ударили по голове тяжелым <w>тупым</w> предметом.",
                                "zh": "他的头部被一个沉重的<w>钝</w>器击中了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dull"
                    ],
                    "antonyms": [
                        "sharp"
                    ],
                    "common_phrases": [
                        "blunt object",
                        "blunt instrument",
                        "blunt knife",
                        "blunt edge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий толстый край или острие; неострый.",
                        "zh": "边缘或尖端厚而不利；不锋利的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тупой",
                                "target_lang_sense_clarification": "о лезвии или предмете"
                            },
                            {
                                "target_lang_word": "неострый",
                                "target_lang_sense_clarification": "о режущей кромке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钝的",
                                "target_lang_sense_clarification": "形容刀刃、尖端等不锋利"
                            },
                            {
                                "target_lang_word": "不锋利的",
                                "target_lang_sense_clarification": "常用于刀、剪刀等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9390cfc0-cd71-3d44-8078-a89ff2bdc476",
                    "sense_definition": "Abrupt in address; plain and direct, often to the point of being rude.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To be <w>blunt</w>, I do not think you are qualified for this job.",
                            "target_lang_translations": {
                                "ru": "Буду <w>прямолинеен</w>, я не думаю, что вы подходите для этой работы.",
                                "zh": "说<w>直白</w>一点，我觉得你不胜任这份工作。"
                            }
                        },
                        {
                            "text": "She gave a <w>blunt</w> refusal to his request for a loan.",
                            "target_lang_translations": {
                                "ru": "Она ответила <w>резким</w> отказом на его просьбу о займе.",
                                "zh": "对于他借钱的请求，她给了一个<w>生硬</w>的拒绝。"
                            }
                        }
                    ],
                    "synonyms": [
                        "curt",
                        "brusque",
                        "direct",
                        "frank",
                        "rude"
                    ],
                    "antonyms": [
                        "polite",
                        "tactful",
                        "subtle"
                    ],
                    "common_phrases": [
                        "to be blunt",
                        "blunt refusal",
                        "blunt truth",
                        "blunt admission"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкий в обращении; прямой и откровенный, часто до грубости.",
                        "zh": "说话或表达方式唐突直接；直来直去，常常到了显得粗鲁的程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямолинейный",
                                "target_lang_sense_clarification": "откровенный"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "грубоватый"
                            },
                            {
                                "target_lang_word": "грубый",
                                "target_lang_sense_clarification": "невежливый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "直率的",
                                "target_lang_sense_clarification": "说话方式直接，不拐弯"
                            },
                            {
                                "target_lang_word": "生硬的",
                                "target_lang_sense_clarification": "直接到可能显得不礼貌"
                            },
                            {
                                "target_lang_word": "直白的",
                                "target_lang_sense_clarification": "强调坦白直说"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce5b22b1-485a-3fbc-b135-095d0655052b",
                    "sense_definition": "Dull in understanding; slow to perceive or discern.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His senses had become <w>blunt</w> with age and fatigue.",
                            "target_lang_translations": {
                                "ru": "Его чувства <w>притупились</w> от возраста и усталости.",
                                "zh": "由于年老和疲劳，他的感觉变得<w>迟钝</w>了。"
                            }
                        },
                        {
                            "text": "Despite his <w>blunt</w> wits, he understood the danger immediately.",
                            "target_lang_translations": {
                                "ru": "Несмотря на свой <w>тупой</w> ум, он сразу понял опасность.",
                                "zh": "尽管他头脑有些<w>迟钝</w>，但还是立刻明白了危险。"
                            }
                        }
                    ],
                    "synonyms": [
                        "obtuse",
                        "stupid",
                        "slow"
                    ],
                    "antonyms": [
                        "acute",
                        "sharp",
                        "keen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленно соображающий; лишенный проницательности.",
                        "zh": "理解力差；感知或辨别能力迟缓、不敏锐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тупой",
                                "target_lang_sense_clarification": "об уме"
                            },
                            {
                                "target_lang_word": "несообразительный",
                                "target_lang_sense_clarification": "медленный в понимании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迟钝的",
                                "target_lang_sense_clarification": "形容感觉、思维等不敏锐"
                            },
                            {
                                "target_lang_word": "愚钝的",
                                "target_lang_sense_clarification": "形容理解慢、辨别力差"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "61d4c330-cadb-3ef4-b8c3-dc809c2f5618",
                    "sense_definition": "To repress, weaken, or reduce the force and effectiveness of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "weaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medication helped to <w>blunt</w> the pain in his leg.",
                            "target_lang_translations": {
                                "ru": "Лекарство помогло <w>притупить</w> боль в его ноге.",
                                "zh": "这种药有助于<w>减轻</w>他腿部的疼痛。"
                            }
                        },
                        {
                            "text": "Recent scandals have <w>blunted</w> the impact of the campaign.",
                            "target_lang_translations": {
                                "ru": "Недавние скандалы <w>сгладили</w> эффект от кампании.",
                                "zh": "最近的丑闻<w>削弱</w>了这场运动的影响力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "weaken",
                        "dampen",
                        "dull"
                    ],
                    "antonyms": [
                        "intensify",
                        "sharpen"
                    ],
                    "common_phrases": [
                        "blunt the impact",
                        "blunt the effect",
                        "blunt the pain",
                        "blunt the appetite"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подавлять, ослаблять или снижать силу и эффективность чего-либо.",
                        "zh": "压制、减弱或降低某事物的力量、效果或作用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притуплять",
                                "target_lang_sense_clarification": "ослаблять чувство или боль"
                            },
                            {
                                "target_lang_word": "сглаживать",
                                "target_lang_sense_clarification": "уменьшать эффект"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "减轻",
                                "target_lang_sense_clarification": "使疼痛、感觉等减弱"
                            },
                            {
                                "target_lang_word": "削弱",
                                "target_lang_sense_clarification": "使影响、效果、冲击力变弱"
                            },
                            {
                                "target_lang_word": "钝化",
                                "target_lang_sense_clarification": "较书面，可用于感觉或作用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5edf0f0-1fb1-340a-a64f-65914a509b28",
                    "sense_definition": "To make an edge or point less sharp.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_edge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cutting through wire will quickly <w>blunt</w> your scissors.",
                            "target_lang_translations": {
                                "ru": "Резка проволоки быстро <w>затупит</w> ваши ножницы.",
                                "zh": "剪铁丝会很快把你的剪刀<w>弄钝</w>。"
                            }
                        },
                        {
                            "text": "The rocks <w>blunted</w> the blade of the shovel.",
                            "target_lang_translations": {
                                "ru": "Камни <w>затупили</w> лезвие лопаты.",
                                "zh": "那些石头把铲子的刀刃<w>磨钝</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dull"
                    ],
                    "antonyms": [
                        "sharpen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать край или острие менее острым.",
                        "zh": "使边缘或尖端变得不那么锋利。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затуплять",
                                "target_lang_sense_clarification": "делать тупым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使变钝",
                                "target_lang_sense_clarification": "使刀刃或尖端变得不锋利"
                            },
                            {
                                "target_lang_word": "磨钝",
                                "target_lang_sense_clarification": "常用于刀刃、工具等"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "776983c0-eb92-325a-9d80-6bb863341a49",
                    "sense_definition": "A cigar that has been hollowed out and filled with marijuana.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "drug",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was seen smoking a <w>blunt</w> outside the concert venue.",
                            "target_lang_translations": {
                                "ru": "Его видели курящим <w>блант</w> возле концертного зала.",
                                "zh": "有人看见他在演出场馆外面抽一支<w>大麻雪茄</w>。"
                            }
                        },
                        {
                            "text": "The group passed a <w>blunt</w> around the circle.",
                            "target_lang_translations": {
                                "ru": "Группа передавала <w>блант</w> по кругу.",
                                "zh": "那群人围成一圈传着抽一支<w>大麻雪茄</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "joint",
                        "spliff"
                    ],
                    "common_phrases": [
                        "smoke a blunt",
                        "roll a blunt"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in drug culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сигара, очищенная от табака и наполненная марихуаной.",
                        "zh": "一种把雪茄掏空后填入大麻制成的烟，属俚语用法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блант",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "косяк",
                                "target_lang_sense_clarification": "общий сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大麻雪茄",
                                "target_lang_sense_clarification": "指掏空雪茄后填入大麻制成的卷烟，俚语"
                            },
                            {
                                "target_lang_word": "布朗特",
                                "target_lang_sense_clarification": "音译用法，见于口语或次文化语境"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9c156ccd-da28-38d3-8ae7-72d69120e155",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Emily <w>Blunt</w> is a famous actress known for her versatile roles.",
                            "target_lang_translations": {
                                "ru": "Эмили <w>Блант</w> — известная актриса, прославившаяся своими разноплановыми ролями.",
                                "zh": "艾米莉·<w>布朗特</w>是一位以戏路广而闻名的著名女演员。"
                            }
                        },
                        {
                            "text": "Mr. <w>Blunt</w> arrived at the office early this morning.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Блант</w> прибыл в офис сегодня рано утром.",
                                "zh": "<w>布朗特</w>先生今天一大早就到了办公室。"
                            }
                        }
                    ],
                    "traits": [
                        {
