                        "entry_id": "55a2fec5-26a6-3d96-ac37-429cb875bea5",
                        "glosses": [
                            "36,5 Kilometer langer Fluss in der Oblast Kyjiw und linker Nebenfluss des Irpin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5885a97-7782-49c0-a798-51e773dc2277",
                                "sense_id": "bcd845b2-adf0-3ae5-8559-24801d27e43e",
                                "text": "„Die Nebenflüsse de[s] Irpin sind:"
                            },
                            {
                                "example_id": "a2767907-3189-47f8-9e1a-d05dd00135cc",
                                "sense_id": "bcd845b2-adf0-3ae5-8559-24801d27e43e",
                                "text": "„Die Ortschaft liegt auf einer Höhe von 184 m am Ufer der Butscha (Буча), einem 34 km langen, linken Nebenfluss des Irpin und grenzt im Norden an das Dorf Kopyliw.“"
                            },
                            {
                                "example_id": "272f41f2-8e05-40f8-a301-199740aa67e1",
                                "sense_id": "bcd845b2-adf0-3ae5-8559-24801d27e43e",
                                "text": "„Butscha liegt etwa 25 Kilometer nordwestlich der ukrainischen Hauptstadt Kiew zwischen dem namengebenden Fluss Butscha und dem Fluss Rokach.“"
                            },
                            {
                                "example_id": "83e00005-9795-4646-8ca9-3f86779c7dd2",
                                "sense_id": "bcd845b2-adf0-3ae5-8559-24801d27e43e",
                                "text": "„Das 1600 erstmals erwähnte Dorf liegt an der Butscha (Буча), einem Nebenfluss des Irpin und deren Nebenfluss, dem Myslin (Мислін) im Rajon Butscha.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
