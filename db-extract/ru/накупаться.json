                "senses": [
                    {
                        "sense_id": "dda9a929-9308-34b1-852b-dee01675724c",
                        "entry_id": "6d5a190b-db07-3241-9611-205fb6f68131",
                        "glosses": [
                            "вдоволь покупаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04e0f1bc-c057-49ef-8b61-6402cfddcf27",
                                "sense_id": "dda9a929-9308-34b1-852b-dee01675724c",
                                "text": "Ребята накупались вдоволь и теперь просили есть."
                            },
                            {
                                "example_id": "34fc618e-f399-4ce2-9dc2-ec61c4e76fc3",
                                "sense_id": "dda9a929-9308-34b1-852b-dee01675724c",
                                "text": "За́ день ребята так накупаются, что пото́м умыться не могут: отвращение к воде́."
                            }
                        ]
                    }
                ],
