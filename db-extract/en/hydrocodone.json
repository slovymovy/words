                        "examples": [
                            {
                                "example_id": "bb75168d-45a8-47b1-a4b8-0130aed4babc",
                                "sense_id": "edc95ba9-b793-3536-a3d5-aca7174a4552",
                                "text": "Before taking acetaminophen and hydrocodone, // — tell your doctor and pharmacist if you are allergic to acetaminophen, codeine, hydrocodone, sulfite, or any other drugs. … // — If you become pregnant while taking acetaminophen and hydrocodone, call your doctor. // — if you are having surgery, including dental surgery, tell the doctor or dentist that you are taking acetaminophen and hydrocodone. // — you should know that this drug may make you drowsy and dizzy; do not drive a car or operate heavy machinery until you know how acetaminophen and hydrocodone affects you. // — talk to your doctor about the safe use of alcohol. Alcohol may alter the effectiveness of acetaminophen and hydrocodone."
                            }
                        ]
                    }
