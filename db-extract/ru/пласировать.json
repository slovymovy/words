                ],
                "senses": [
                    {
                        "sense_id": "032057ca-24b1-3f2b-bde7-3313d83299ad",
                        "entry_id": "7db873a5-df35-379b-af56-2af52306d7b9",
                        "glosses": [
                            "спорт. в футболе, теннисе и т. п. — при ударе прицельно направлять (направить) мяч туда, где противнику будет трудно принять или отбить его"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c03b069-8d9f-4355-b047-2fbc2dc85749",
                                "sense_id": "032057ca-24b1-3f2b-bde7-3313d83299ad",
                                "text": "На 14-й минуте из кучи у ворот «Трёхгорки» мяч попадает к Блинкову, и тот спокойно пласирует его в дальний угол."
                            },
                            {
                                "example_id": "57197f7b-d5ac-4dd5-804e-4d941e1719c9",
                                "sense_id": "032057ca-24b1-3f2b-bde7-3313d83299ad",
                                "text": "Она не так сильно бьёт по мячу, но зато хорошо гасит его скорость и пласирует. Поэтому мяч порой после её ударов от травы практически не отскакивает."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73557ea9-9e12-4c4f-8804-c4903a65c84a",
                        "source_entry_id": "7db873a5-df35-379b-af56-2af52306d7b9",
                        "source_sense_id": "032057ca-24b1-3f2b-bde7-3313d83299ad",
                        "target_lang_word": "placieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "placieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e91c2bdb-e25a-3ed5-9d8b-fc0c9d95aa6d",
                                        "entry_id": "a34d99eb-cb3a-3f6e-b8d9-0b4fd4869f3d",
                                        "glosses": [
                                            "jemanden oder etwas an eine bestimmte Stelle setzen"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "063c24f2-4180-4406-8b72-3058b3966213",
                                                "sense_id": "e91c2bdb-e25a-3ed5-9d8b-fc0c9d95aa6d",
                                                "text": "„Sie nimmt ihre Brille ab und placiert sie rechts neben der Tastatur ihres Rechners.“"
                                            },
                                            {
                                                "example_id": "c6c92fd9-4036-4394-aa4e-1ea722cfe8a5",
                                                "sense_id": "e91c2bdb-e25a-3ed5-9d8b-fc0c9d95aa6d",
                                                "text": "„Schuhe wirst du in einen Plastbeutel stecken und gut an den Kofferseiten placieren können.“"
                                            },
                                            {
                                                "example_id": "01601c78-7c27-4c17-828b-fa037af4bc9d",
                                                "sense_id": "e91c2bdb-e25a-3ed5-9d8b-fc0c9d95aa6d",
                                                "text": "„Genau das ist auch in Peter Westenthalers Redebeitrag hervorragend zum Ausdruck gekommen: Niemand in diesem Saal ist keusch, niemand ist vor der Versuchung gefeit, auf der größten Medienorgel zu spielen und natürlich seine Botschaft placieren zu wollen.“"
                                            },
                                            {
                                                "example_id": "4ca47733-9e98-48c0-b7f1-eef3a2bd69b3",
                                                "sense_id": "e91c2bdb-e25a-3ed5-9d8b-fc0c9d95aa6d",
                                                "text": "„Zum jetzigen Zeitpunkt können wir fast 100 Leute placieren, aber sobald wir die Bänke fertig haben, sollten wir das verdoppeln können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
