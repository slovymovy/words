                        "glosses": [
                            "Linguistik, Grammatik: Adverb, dessen Bedeutung auf Grund oder Ursache für einen Vorgang oder Zustand hinweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ada51fc5-4219-4517-a065-482631154e73",
                                "sense_id": "a798bca6-9370-322e-8aca-6a4e90bf480d",
                                "text": "In dem Satz: \"Es war schlechtes Wetter; also kamen wir zu spät an\" ist \"also\" ein Kausaladverb."
                            },
                            {
                                "example_id": "3fbb8cf4-c850-421f-ba8d-96072fa7e07b",
                                "sense_id": "a798bca6-9370-322e-8aca-6a4e90bf480d",
                                "text": "„Kausaladverbien geben den Grund für einen Sachverhalt oder eine Handlung an.“"
                            }
                        ],
