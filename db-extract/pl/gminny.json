                                "example_id": "31e09765-6449-4901-905e-2673eafe58eb",
                                "sense_id": "e33efe8f-b616-3b22-9ae1-666cde92bf8a",
                                "text": "Zebranie miało się odbyć w lokalu gminnej spółdzielni wiejskiej."
                            }
