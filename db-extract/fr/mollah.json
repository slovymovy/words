                                                "sense_id": "6141915a-0c32-33b5-a6be-7a8353c75e76",
                                                "text": "„Es ist ein Mulla, der sogenannte Muezzin, der Gebetsrufer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
