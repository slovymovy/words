                        "translation_id": "df5cd25d-6b32-4d03-9eae-7babb56edaff",
                        "source_entry_id": "727d7aff-f969-3ceb-aa57-566912b74e68",
                        "source_sense_description": "Bateau à voile de transport à formes rondes dont se servaient les Hollandais.",
                        "target_lang_word": "galliot",
