                "senses": [
                    {
                        "sense_id": "17cb3d3f-24ce-3587-b2ba-c7def68d71bb",
                        "entry_id": "fc2cdb7b-efaf-3173-97ef-7c4c20f4a018",
                        "glosses": [
                            "iperyt siarkowy, bojowy środek trujący"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "255b9b54-8fa6-40e7-9f0b-9ed23d5731bb",
                                "sense_id": "17cb3d3f-24ce-3587-b2ba-c7def68d71bb",
                                "text": "Iperyt powoduje powstawanie pęcherzy i trudno gojących się ran."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "56804c86-ea37-305f-ba20-089c7443c821",
                        "entry_id": "fc2cdb7b-efaf-3173-97ef-7c4c20f4a018",
                        "glosses": [
                            "każdy związek organiczny mający budowę zbliżoną do iperytu (1.1) będący bojowym środkiem trującym i wykazujący podobne do niego działanie parzące i trujące lub też mieszanina takich związków"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "990ef81f-543a-4456-98b8-b056ae04495e",
                                "sense_id": "56804c86-ea37-305f-ba20-089c7443c821",
                                "text": "Wśród iperytów wyróżniamy iperyty siarkowe i iperyty azotowe."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e55b912-4602-4779-90fe-3318de0edc07",
                        "source_entry_id": "fc2cdb7b-efaf-3173-97ef-7c4c20f4a018",
                        "source_sense_id": "17cb3d3f-24ce-3587-b2ba-c7def68d71bb",
                        "target_lang_word": "yperite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yperite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f6ce763-275b-3e7c-910c-887dd299af0d",
                                        "entry_id": "89606681-2d0d-3942-8a75-5096ef2e9b42",
                                        "glosses": [
                                            "Synonym of mustard gas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a68f17e4-304f-4cd7-82a0-20bf3de1d8a5",
                                                "sense_id": "3f6ce763-275b-3e7c-910c-887dd299af0d",
                                                "text": "In the pre-war years the production of yperite was prepared at 6 plants in Moscow, Chapaevsk, Stalingrad, Dzerzhinsk, Berezniki and Stalinogorsk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d02f60a-ec3c-41ae-a81a-95afc29d6fad",
                        "source_entry_id": "fc2cdb7b-efaf-3173-97ef-7c4c20f4a018",
                        "source_sense_id": "17cb3d3f-24ce-3587-b2ba-c7def68d71bb",
                        "target_lang_word": "иприт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "иприт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "986e576f-b349-386e-8d52-98b3f557f764",
                                        "entry_id": "f551d43c-2195-39db-b9a7-966f7a28d3ab",
                                        "glosses": [
                                            "хим., воен. химическое соединение с формулой S(CH₂CH₂Cl)₂, боевое отравляющее вещество кожно-нарывного действия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4ff4dd2-6a5a-48f4-9c63-46441cb4e8ea",
                                                "sense_id": "986e576f-b349-386e-8d52-98b3f557f764",
                                                "text": "В мае 1915 года армия кайзеровской Германии применила против русских войск отравляющие газы. Отравляющими веществами были начинены и снаряды, обрушившиеся на английскую пехоту в сражении под Ипром. В историю первой мировой войны это отравляющее вещество вошло под названием иприта."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc58b7b0-2739-485c-acbf-27d9da28dd50",
                        "source_entry_id": "fc2cdb7b-efaf-3173-97ef-7c4c20f4a018",
                        "source_sense_id": "56804c86-ea37-305f-ba20-089c7443c821",
                        "target_lang_word": "mustard gas",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mustard gas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2175a93-1a0c-398f-8585-662ecf54604b",
                                        "entry_id": "4da23ec2-724b-3a4e-8ec6-3a1b3d209ea1",
                                        "glosses": [
                                            "A highly cytotoxic vesicant, C₄H₈Cl₂S, used in World War I that is known to cause skin burns, blisters, inflammation, edema, and potentially other respiratory effects."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b613d834-375c-4cbf-95cc-d042704baabd",
                                                "sense_id": "a2175a93-1a0c-398f-8585-662ecf54604b",
                                                "text": "The man who survived mustard gas and pepper spray is now a seasoned veteran."
                                            },
                                            {
                                                "example_id": "05164b8b-f60f-4d5b-ba37-492f6d14cd2b",
                                                "sense_id": "a2175a93-1a0c-398f-8585-662ecf54604b",
                                                "text": "The necessarily elaborate precautions taken to decontaminate vehicles and trains which have been in contact with mustard gas were shown, and examples of the board's breakdown and ambulance vehicles were available for inspection."
                                            },
                                            {
                                                "example_id": "ede77d7f-23af-4060-b42b-430d88437eef",
                                                "sense_id": "a2175a93-1a0c-398f-8585-662ecf54604b",
                                                "text": "With the cessation of hostilities, the military traffic declined considerably, although at least two years will be required to remove the many thousands of tons of explosives still stored at the depot. The supplies of mustard gas have already been despatched to Stranraer to be dumped in the sea, and the disposal of ¾-million land mines has called for the provision of 17 special trains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bedd5a2b-1962-4f0a-ae12-748255428166",
                        "source_entry_id": "fc2cdb7b-efaf-3173-97ef-7c4c20f4a018",
                        "source_sense_id": "56804c86-ea37-305f-ba20-089c7443c821",
                        "target_lang_word": "mustard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mustard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a563fe94-bfe4-3845-bd34-d191c14258fc",
                                        "entry_id": "3d860c79-0eb9-306f-852c-5dc7952ae467",
                                        "glosses": [
                                            "A plant of certain species of the genus Brassica, or of related genera (especially Sinapis alba, in the family Brassicaceae, with yellow flowers, and linear seed pods)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4ad15cc-bf84-36a8-8eb1-69e188185d40",
                                        "entry_id": "3d860c79-0eb9-306f-852c-5dc7952ae467",
                                        "glosses": [
                                            "Powder or paste made from seeds of the mustard plant, and used as a condiment or a spice."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20b751f8-b06d-4e18-ab51-153ccab8fc52",
                                                "sense_id": "d4ad15cc-bf84-36a8-8eb1-69e188185d40",
                                                "text": "When the waitress brought the food, I asked whether she had any Dijon mustard."
                                            },
                                            {
                                                "example_id": "ab64acbf-9007-472c-a0f8-78b366582466",
                                                "sense_id": "d4ad15cc-bf84-36a8-8eb1-69e188185d40",
                                                "text": "He loved having mustard and toast for breakfast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef36922f-c5f5-3a8f-8999-ec335433156b",
                                        "entry_id": "3d860c79-0eb9-306f-852c-5dc7952ae467",
                                        "glosses": [
                                            "The leaves of the mustard plant, used as a salad."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd3f8b69-d487-4a13-b340-6eb3ab8fd498",
                                                "sense_id": "ef36922f-c5f5-3a8f-8999-ec335433156b",
                                                "text": "Mustard and cress sandwiches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "690fab03-3355-387d-b72b-46f03d882d79",
                                        "entry_id": "3d860c79-0eb9-306f-852c-5dc7952ae467",
                                        "glosses": [
                                            "Dark yellow colour, the colour of mustard."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c71bafe-5aa9-33e0-97c1-6d6d3095cd1d",
                                        "entry_id": "3d860c79-0eb9-306f-852c-5dc7952ae467",
                                        "glosses": [
                                            "One of a family of vesicants containing one or more 2-chloroethyl (C₂H₄Cl) groups, commonly used in chemical warfare and cancer chemotherapy."
                                        ],
                                        "tags": [
