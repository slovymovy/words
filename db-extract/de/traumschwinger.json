                ],
                "senses": [
                    {
                        "sense_id": "a26a7569-6185-3410-b66b-5ab6d7244c82",
                        "entry_id": "5cff29da-1bdf-31b2-9c32-a0a72a0e0c00",
                        "glosses": [
                            "hängende Sitzgelegenheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a57b0815-bdfd-4cd7-b145-140b2e23c1da",
                                "sense_id": "a26a7569-6185-3410-b66b-5ab6d7244c82",
                                "text": "„Besonders für gesundheitlich eingeschränkte Kinder sind die Hängestühle ideal, die inzwischen von Schulen und Therapeuten eingesetzt werden. Aber auch für Kinder, die unter spastischen Bewegungsstörungen leiden, ist das Schaukeln eine geeignete Therapie. Sie fühlen sich im Traumschwinger sofort wohl und geborgen.“"
                            },
                            {
                                "example_id": "cf5e6f3c-fa34-46e8-9300-e9e901f5522d",
                                "sense_id": "a26a7569-6185-3410-b66b-5ab6d7244c82",
                                "text": "„Wer sich also gesund entspannen will, sollte sich einen Traumschwinger zulegen.“"
                            },
                            {
                                "example_id": "3e2efca9-4367-4806-a7ad-d8d960437708",
                                "sense_id": "a26a7569-6185-3410-b66b-5ab6d7244c82",
                                "text": "„Die Traumschwinger sind nicht nur federleicht, sie schaukeln den Gartenfreund auch sanft in das erste Sonnenbad des Jahres, in das Nickerchen in der Frühlingsluft, oder eben in eine wunderbare Gedankenwelt, die einem beim gemütlichen hineinlümmeln eben so einfällt.“"
                            },
                            {
                                "example_id": "a7ad3ffb-e244-4c2b-aa2e-241299e86460",
                                "sense_id": "a26a7569-6185-3410-b66b-5ab6d7244c82",
                                "text": "„So stimuliert ein Barfußpfad aus Naturmaterialien Fußreflexzonen, ein sogenannter Traumschwinger bietet einen Platz für Tagträume, und mit asiatischen Gongs und Klangschalen werden auch gestresste Ohren beruhigt.“"
                            },
                            {
                                "example_id": "4f54fbd6-1f5b-4476-89a1-e8e42317dc08",
                                "sense_id": "a26a7569-6185-3410-b66b-5ab6d7244c82",
                                "text": "„Da schaukle ich dann im Traumschwinger und lese oder mache ein Nickerchen.“"
                            },
                            {
                                "example_id": "18233345-3cb6-4e7d-bab8-a422f7c7aa7d",
                                "sense_id": "a26a7569-6185-3410-b66b-5ab6d7244c82",
                                "text": "„‚Den abgedunkelten Ruheraum werden wir mit einem großen Wasserbett und mit Wassersäulen ausstatten, es wird leise Musik geben, eventuell auch einen Traumschwinger‘, erklären Vereinsvorsitzender Alfons Müller und Diplom-Sozialpädagogin Sandra Schunk.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
