                "senses": [
                    {
                        "sense_id": "095aa1b4-761f-3b93-bf6a-39ba165e4457",
                        "entry_id": "8a282759-5e75-339d-8642-ab3a0d82937e",
                        "glosses": [
                            "als Kriegsschiff vor allem für logistische Aufgaben verwendetes Handelsschiff"
                        ],
                        "tags": [
                            "Militärwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "9e158aa8-ed1f-4e50-ad8d-d5ff2f029708",
                                "sense_id": "095aa1b4-761f-3b93-bf6a-39ba165e4457",
                                "text": "\"Dies ist der Flugzeugträger USS Lincoln, das zweitgrößte Schiff der Atlantikflotte der Vereinigten Staaten. Wir werden von drei Zerstörern, drei Kreuzern und mehreren Hilfsschiffen begleitet. …\""
                            },
                            {
                                "example_id": "f2acd962-543b-4c38-97bd-944e06fa36cb",
                                "sense_id": "095aa1b4-761f-3b93-bf6a-39ba165e4457",
                                "text": "Getroffen wurde ein italienisches Hilfsschiff - sechs Offiziere kamen dabei ums Leben."
                            },
                            {
                                "example_id": "c3ea028e-b9ed-4567-aef3-5838696a85e4",
                                "sense_id": "095aa1b4-761f-3b93-bf6a-39ba165e4457",
                                "text": "Wie eine Sprecherin des Havariekommandos Cuxhaven mitteilte, sind zwölf Hilfsschiffe im Einsatz, darunter ein Feuerwehr- und zwei Gewässerschutzschiffe, zwei Notschlepper und mehrere Seenotrettungskreuzer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
