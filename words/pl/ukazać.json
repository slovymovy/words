    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c1ca288-bac7-30e9-b42b-925aea0471a3",
                    "sense_definition": "Stać się widocznym dla obserwatora lub pojawić się w określonym miejscu (używane z zaimkiem „się”).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po długim deszczu na niebie w końcu <w>ukazało</w> się słońce.",
                            "target_lang_translations": {
                                "ru": "После долгого дождя на небе наконец <w>показалось</w> солнце.",
                                "en": "After a long rain, the sun finally <w>appeared</w> in the sky."
                            }
                        },
                        {
                            "text": "W drzwiach wejściowych nagle <w>ukazał</w> się tajemniczy gość.",
                            "target_lang_translations": {
                                "ru": "Во входной двери внезапно <w>появился</w> таинственный гость.",
                                "en": "A mysterious guest suddenly <w>appeared</w> in the doorway."
                            }
                        },
                        {
                            "text": "Za zakrętem naszym oczom <w>ukazało</w> się piękne górskie jezioro.",
                            "target_lang_translations": {
                                "ru": "За поворотом перед нами <w>показалось</w> красивое горное озеро.",
                                "en": "Around the bend, a beautiful mountain lake <w>came into view</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pojawić się",
                        "wyłonić się"
                    ],
                    "antonyms": [
                        "zniknąć",
                        "przepaść",
                        "schować się"
                    ],
                    "common_phrases": [
                        "ukazać się oczom",
                        "ukazać się drukiem",
                        "nagle się ukazać"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать видимым для наблюдателя или появиться в определенном месте (используется с возвратным местоимением).",
                        "en": "To become visible to an observer or appear in a particular place (used reflexively with 'się')."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "показаться",
                                "target_lang_sense_clarification": "стать видимым"
                            },
                            {
                                "target_lang_word": "появиться",
                                "target_lang_sense_clarification": "возникнуть"
                            },
                            {
                                "target_lang_word": "выйти",
                                "target_lang_sense_clarification": "об издании книг или журналов"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "appear",
                                "target_lang_sense_clarification": "become visible or show up"
                            },
                            {
                                "target_lang_word": "emerge",
                                "target_lang_sense_clarification": "come into view"
                            },
                            {
                                "target_lang_word": "reveal oneself",
                                "target_lang_sense_clarification": "become manifest"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "638de684-55db-3aed-bdb7-647570d3f913",
                    "sense_definition": "Przedstawić lub zaprezentować kogoś lub coś w określony sposób, czyniąc to widocznym lub zrozumiałym (często w sztuce lub opisie).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "show",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Autor powieści chciał <w>ukazać</w> trudne życie mieszkańców wsi.",
                            "target_lang_translations": {
                                "ru": "Автор романа хотел <w>изобразить</w> трудную жизнь сельских жителей.",
                                "en": "The author of the novel wanted to <w>depict</w> the difficult life of the villagers."
                            }
                        },
                        {
                            "text": "To wydarzenie pozwoliło <w>ukazać</w> problem w zupełnie nowym świetle.",
                            "target_lang_translations": {
                                "ru": "Это событие позволило <w>показать</w> проблему в совершенно новом свете.",
                                "en": "This event allowed the problem to be <w>shown</w> in a completely new light."
                            }
                        }
                    ],
                    "synonyms": [
                        "przedstawić",
                        "zaprezentować",
                        "uwidocznić",
                        "odmalować"
                    ],
                    "antonyms": [
                        "ukryć",
                        "zataić"
                    ],
                    "common_phrases": [
                        "ukazać prawdę",
                        "ukazać w świetle",
                        "ukazać oblicze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представить или изобразить кого-то или что-то определенным образом (часто в искусстве или описании).",
                        "en": "To depict, present, or show someone or something in a specific way, making it visible or understandable (often in art or literature)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изобразить",
                                "target_lang_sense_clarification": "описать в художественном произведении"
                            },
                            {
                                "target_lang_word": "показать",
                                "target_lang_sense_clarification": "продемонстрировать"
                            },
                            {
                                "target_lang_word": "представить",
                                "target_lang_sense_clarification": "описать в определенном свете"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "depict",
                                "target_lang_sense_clarification": "represent in art or literature"
                            },
                            {
                                "target_lang_word": "portray",
                                "target_lang_sense_clarification": "describe or present in a certain way"
                            },
                            {
                                "target_lang_word": "show",
                                "target_lang_sense_clarification": "reveal or demonstrate"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}