                        "form": "dem Morphium"
                    },
                    {
                        "form_id": "80baa679-bf01-446b-b0a9-9f2d6a4add8b",
                        "entry_id": "be6c9c18-cffa-3033-9bbf-d60fa23296da",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Morphium"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d45fe9a4-9ed1-3fdb-9801-749433bb2d82",
                        "entry_id": "be6c9c18-cffa-3033-9bbf-d60fa23296da",
                        "glosses": [
                            "Betäubungsmittel, das aus Opium gewonnen wird und hauptsächlich in der Medizin als starkes Schmerzmittel eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b20fe3c-37a3-491e-9e3c-3aedaa2d2230",
                                "sense_id": "d45fe9a4-9ed1-3fdb-9801-749433bb2d82",
                                "text": "Seine Schmerzen durch den schweren Autounfall linderten die Ärzte mit Morphium."
                            },
                            {
                                "example_id": "7248835c-6bdd-41ad-b9b6-8c9ced20cf16",
                                "sense_id": "d45fe9a4-9ed1-3fdb-9801-749433bb2d82",
                                "text": "„Er ist noch kein Morphinist, weit entfernt, er kommt manchmal fünf, sechs Tage ohne Morphium aus, aber wenn Schwierigkeiten auf seinem Lebenswege auftauchen, und diese Schwierigkeiten häufen sich jetzt während des Krieges immer mehr, so nimmt er Morphium.“"
                            },
                            {
                                "example_id": "59858904-036d-44be-9119-d7554accefd0",
                                "sense_id": "d45fe9a4-9ed1-3fdb-9801-749433bb2d82",
                                "text": "„Die Damen spritzen sich Morphium.“"
                            },
                            {
                                "example_id": "d5f0a469-a322-40c5-bcd2-326e75ecbf4f",
                                "sense_id": "d45fe9a4-9ed1-3fdb-9801-749433bb2d82",
                                "text": "„Normalerweise kam er auch zu Pole, um Morphium für seine Frau zu besorgen.“"
                            },
                            {
                                "example_id": "b2a2ddb2-ba86-4e52-a578-b1cf41add354",
                                "sense_id": "d45fe9a4-9ed1-3fdb-9801-749433bb2d82",
                                "text": "„Er starb 1928 am Magenkrebs; Morphium und Veronal waren die Nothelfer, die ihm auf seinem schweren Weg aus dem Leben ein wenig Linderung verschafften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eace387a-b2cd-4266-ba01-099fb2a941ed",
                        "source_entry_id": "be6c9c18-cffa-3033-9bbf-d60fa23296da",
                        "source_sense_id": "d45fe9a4-9ed1-3fdb-9801-749433bb2d82",
