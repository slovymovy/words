            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a824034d-961a-36e2-8a68-b1ca124117b6",
                    "sense_definition": "A person who rescues someone or something from danger, harm, or destruction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rescuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The firefighter was hailed as a <w>saviour</w> after pulling the child from the burning building.",
                            "target_lang_translations": {
                                "ru": "Пожарного провозгласили <w>спасителем</w> после того, как он вытащил ребенка из горящего здания."
                            }
                        },
                        {
                            "text": "Many people consider the new policy to be the economic <w>saviour</w> of the struggling town.",
                            "target_lang_translations": {
                                "ru": "Многие считают новую политику экономическим <w>спасителем</w> этого бедствующего города."
                            }
                        }
                    ],
                    "synonyms": [
                        "rescuer",
                        "deliverer",
                        "liberator"
                    ],
                    "common_phrases": [
                        "unexpected saviour",
                        "potential saviour"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British and Canadian spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который спасает кого-либо или что-либо от опасности, вреда или гибели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спаситель",
                                "target_lang_sense_clarification": "тот, кто спасает от беды или опасности"
                            },
                            {
                                "target_lang_word": "избавитель",
                                "target_lang_sense_clarification": "тот, кто освобождает от страданий или гнета"
                            }
                        ]
                    }
                }
            ]
        },
