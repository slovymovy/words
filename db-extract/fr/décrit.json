                "senses": [
                    {
                        "sense_id": "1ab89deb-bc81-35bd-b79b-d43cf11e25df",
                        "entry_id": "8516e8f2-feb0-3e78-809b-8af30343ff00",
                        "glosses": [
                            "Participe passé masculin singulier de décrire."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "267d241a-5856-4563-9d57-dd359dd37fae",
                                "sense_id": "1ab89deb-bc81-35bd-b79b-d43cf11e25df",
                                "text": "Pour obtenir ce résultat, je me sers du même appareil que j’ai décrit pour traiter la fécule; seulement j’enlève le tissu intérieur, que j’appelle velours-taupe, et je le remplace par un autre plus grossier, tel qu’une toile d’emballage épaisse ou tous autres tissus analogues, soit en chanvre, coton, laine, feutre ou clayons en paille, qui puissent, sans se ressorer, permettre au liquide de s’échapper."
                            }
                        ]
                    },
                    {
                        "sense_id": "07479460-0bdc-3b25-a638-97d4d3d249ed",
                        "entry_id": "8516e8f2-feb0-3e78-809b-8af30343ff00",
                        "glosses": [
                            "Troisième personne du singulier de l’indicatif présent du verbe décrire."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "7f6b97bb-c4bf-499e-b0bd-bf8be0676549",
                                "sense_id": "07479460-0bdc-3b25-a638-97d4d3d249ed",
                                "text": "Dans l’entre-deux-guerres, le prosateur se fait volontiers reporter : il mène l’enquête et décrit les faits, en usant de son art de la narration."
                            }
                        ]
                    }
