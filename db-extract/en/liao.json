    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "706c3e08-4979-3030-bb75-8564ee23bd8d",
                "word": "Liao",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "26939268-b002-309f-a9c8-6813707c8914",
                        "entry_id": "706c3e08-4979-3030-bb75-8564ee23bd8d",
                        "glosses": [
                            "A river of Manchuria (northeastern China)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aef38ad6-ebdf-41ad-b263-f6b67848fce5",
                                "sense_id": "26939268-b002-309f-a9c8-6813707c8914",
                                "text": "The centre of Chinese influence in Manchuria was mainly Liaotung peninsula and along the Liao River valley."
                            },
                            {
                                "example_id": "5964bc71-8eb8-4e77-86b2-0f9d329d2049",
                                "sense_id": "26939268-b002-309f-a9c8-6813707c8914",
                                "text": "Naturally the Japanese destroyed or captured the greater part of the obsolete Chinese Navy, drove the Chinese armies out of Korea, occupied Southern Manchuria as far west as the Liao River, and invaded Shantung."
                            },
                            {
                                "example_id": "816336b8-84d9-4d36-bb07-2a582290279b",
                                "sense_id": "26939268-b002-309f-a9c8-6813707c8914",
                                "text": "To the Han people, the Khitan were not much more than barbarians. Interlopers from the Mongolian steppes, they moved into the northern provinces of China in the 10th century and established the Liao empire (named for the Liao River), one of the wealthiest and most powerful dynasties of its time."
                            },
                            {
                                "example_id": "83da440b-4245-481e-b5f3-488d722d487d",
                                "sense_id": "26939268-b002-309f-a9c8-6813707c8914",
                                "text": "After proceeding south-east to Yung-Ping (on the Bohai Sea), he then struck north-east to the Liao River, following Jebe’s route a year earlier, and penetrated deep into Manchuria, following, first, the north-easterly course of the Sunggari (Songhua) River, the largest tributary of the mighty Amur."
                            },
                            {
                                "example_id": "120dae77-f1c2-42c0-ac16-751f44ae0bf2",
                                "sense_id": "26939268-b002-309f-a9c8-6813707c8914",
                                "text": "This language family's beginnings were traced to Neolithic millet farmers in the Liao River valley, an area encompassing parts of the Chinese provinces of Liaoning and Jilin and the region of Inner Mongolia.[…]\nThe origins of modern Chinese languages arose independently, though in a similar fashion with millet also involved. While the progenitors of the Transeurasian languages grew broomcorn millet in the Liao River valley, the originators of the Sino-Tibetan language family farmed foxtail millet at roughly the same time in China's Yellow River region, paving the way for a separate language dispersal, Robbeets said."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d0b553c-fdee-3cbc-bec3-47c857f94c60",
                        "entry_id": "706c3e08-4979-3030-bb75-8564ee23bd8d",
                        "glosses": [
                            "One of various medieval dynasties of Khitan rulers in Chinese history originally from its watershed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "226f3694-3049-4f36-9b0b-61cb1028a669",
                                "sense_id": "2d0b553c-fdee-3cbc-bec3-47c857f94c60",
                                "text": "To the Han people, the Khitan were not much more than barbarians. Interlopers from the Mongolian steppes, they moved into the northern provinces of China in the 10th century and established the Liao empire (named for the Liao River), one of the wealthiest and most powerful dynasties of its time. The short-lived Liao reign lasted from 907 until 1125, but at its height stretched from Manchuria to Inner Asia."
                            }
                        ]
                    },
                    {
                        "sense_id": "f13ae6d6-ca9d-3529-8ace-8e93e47b090c",
                        "entry_id": "706c3e08-4979-3030-bb75-8564ee23bd8d",
                        "glosses": [
                            "Liaoning, a Chinese province surrounding and named for the Liao watershed"
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": []
                    }
