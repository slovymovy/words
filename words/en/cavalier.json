                        {
                            "text": "In the play, the protagonist is a dashing <w>cavalier</w> fighting for the royalist cause.",
                            "target_lang_translations": {
                                "ru": "В пьесе главный герой — лихой <w>кавалер</w>, сражающийся за дело роялистов."
                            }
