{
    "word_family": [
        "appeasement",
        "appeaser"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c97d2c35-7b13-3b6c-a892-4f69af763e94",
                    "sense_definition": "To make someone less angry or upset by giving them what they want.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "calm_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government tried to <w>appease</w> the protesters by promising new reforms.",
                            "target_lang_translations": {
                                "it": "Il governo ha cercato di <w>placare</w> i manifestanti promettendo nuove riforme."
                            }
                        },
                        {
                            "text": "She gave the child a toy to <w>appease</w> him after he started crying.",
                            "target_lang_translations": {
                                "it": "Ha dato un giocattolo al bambino per <w>calmarlo</w> dopo che ha iniziato a piangere."
                            }
                        }
                    ],
                    "synonyms": [
                        "pacify",
                        "placate",
                        "mollify"
                    ],
                    "antonyms": [
                        "antagonize"
                    ],
                    "common_phrases": [
                        "appease the crowd",
                        "appease the critics"
                    ],
                    "target_lang_definitions": {
                        "it": "Rendere qualcuno meno arrabbiato o turbato dandogli ciò che desidera."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "placare",
                                "target_lang_sense_clarification": "calmare la rabbia concedendo qualcosa"
                            },
                            {
                                "target_lang_word": "calmare",
                                "target_lang_sense_clarification": "tranquillizzare o placare una persona"
                            },
                            {
                                "target_lang_word": "pacificare",
                                "target_lang_sense_clarification": "riportare la pace facendo concessioni"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f72dfef-7688-3a5f-b8a8-845d5c47598c",
                    "sense_definition": "To satisfy a demand or feeling, often by making concessions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "calm_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They offered a small payment to <w>appease</w> the angry customers.",
                            "target_lang_translations": {
                                "it": "Hanno offerto un piccolo risarcimento per <w>placare</w> i clienti arrabbiati."
                            }
                        },
                        {
                            "text": "The company made changes to <w>appease</w> the demands of the labor union.",
                            "target_lang_translations": {
                                "it": "L'azienda ha apportato modifiche per <w>soddisfare</w> le richieste del sindacato."
                            }
                        }
                    ],
                    "synonyms": [
                        "propitiate"
                    ],
                    "common_phrases": [
                        "appease the demands"
                    ],
                    "target_lang_definitions": {
                        "it": "Soddisfare una richiesta, un bisogno o un sentimento, spesso facendo concessioni."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "placare",
                                "target_lang_sense_clarification": "acquietare richieste, proteste o desideri"
                            },
                            {
                                "target_lang_word": "accontentare",
                                "target_lang_sense_clarification": "cedere a richieste o pretese per evitare conflitti"
                            },
                            {
                                "target_lang_word": "soddisfare",
                                "target_lang_sense_clarification": "appagare una richiesta o esigenza"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}