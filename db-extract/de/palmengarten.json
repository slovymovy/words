                ],
                "senses": [
                    {
                        "sense_id": "9b99e8fe-bbd6-3f04-9980-ea0fd3873e04",
                        "entry_id": "88cee1b6-7ec8-30ff-98c1-68da8d82d311",
                        "glosses": [
                            "Garten (oder Park), dessen Bepflanzung vor allem aus Palmenbäumen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d74f6a84-c299-4c05-90c6-e1b3aa2cdeca",
                                "sense_id": "9b99e8fe-bbd6-3f04-9980-ea0fd3873e04",
                                "text": "„Der [Frankfurter] Palmengarten lebt von Bürgerstolz, Achtsamkeit und dem festlichen Willen aller Beteiligten, so zu tun, als sei hier immer Sonntag.“"
                            },
                            {
                                "example_id": "4ea712d8-882a-4ac6-a9d0-b07dce398e10",
                                "sense_id": "9b99e8fe-bbd6-3f04-9980-ea0fd3873e04",
                                "text": "„Knjäs Boris Wladimirowitsch Manuchin saß schwer, bärtig, den Rauch der Papyros durch die breiten Nüstern stoßend, gleich einem mächtigen, in Londoner Kleidung gesteckten Muschik, im Palmengarten seines Palastes in der Mitte zahlreicher Freunde und Anhänger.“"
                            },
                            {
                                "example_id": "f7639e88-e58e-4b53-ba1c-2f66439a9c9a",
                                "sense_id": "9b99e8fe-bbd6-3f04-9980-ea0fd3873e04",
                                "text": "„In einem Palmengarten stand die komfortable Villa des britischen Nachrichtenchefs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
