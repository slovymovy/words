                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lion gave a <w>fierce</w> roar to warn the intruders away.",
                            "target_lang_translations": {
                                "ru": "Лев издал <w>свирепый</w> рык, чтобы отогнать незваных гостей."
                            }
                        },
                        {
                            "text": "He had a <w>fierce</w> look in his eyes that made everyone nervous.",
                            "target_lang_translations": {
                                "ru": "У него был <w>грозный</w> взгляд, который заставлял всех нервничать."
                            }
