                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and potentially offensive."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Ubriaco; in stato di ebbrezza.",
                        "fr": "Ivre, éméché."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "ubriaco",
                                "target_lang_sense_clarification": "in stato di alterazione dovuto all'alcol"
                            },
                            {
                                "target_lang_word": "alticcio",
                                "target_lang_sense_clarification": "leggermente ubriaco"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "bourré",
                                "target_lang_sense_clarification": "très familier pour ivre"
                            },
                            {
                                "target_lang_word": "ivre",
                                "target_lang_sense_clarification": "en état d'ébriété"
                            },
                            {
                                "target_lang_word": "pompette",
                                "target_lang_sense_clarification": "légèrement éméché"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f008a672-1544-35a0-936f-389e942c404a",
                    "sense_definition": "A person who drinks alcohol to excess.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>lush</w> was always found sleeping on the park bench.",
                            "target_lang_translations": {
                                "it": "L' <w>ubriacone</w> del quartiere si trovava sempre a dormire sulla panchina del parco.",
                                "fr": "L'<w>ivrogne</w> du quartier était toujours retrouvé endormi sur le banc du parc."
                            }
                        },
                        {
                            "text": "He became a total <w>lush</w> after losing his job.",
                            "target_lang_translations": {
                                "it": "È diventato un <w>alcolizzato</w> dopo aver perso il lavoro.",
                                "fr": "Il est devenu un véritable <w>alcoolique</w> après avoir perdu son travail."
                            }
