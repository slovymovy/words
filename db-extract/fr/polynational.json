                        "glosses": [
                            "Composé de plusieurs nations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19432004-f0b9-4a8d-b640-a5f1389dcfc6",
                                "sense_id": "61f70f03-812e-3b1e-93a8-fc625ab46087",
                                "text": "La Russie est encore en pleine transformation. Alors qu'elle était, avant le 15 mars 1917, un Etat simple et unitaire, la constitution du 10 juillet 1918 en fit une « union libre des nations libres », sorte de République soviétique polynationale."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a8c7594-620e-3650-a6db-d7e513b767e4",
                        "entry_id": "a9312060-87cd-3812-97e0-52e133134404",
