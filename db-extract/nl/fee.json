                        "cross_references": [
                            {
                                "target_word": "Fee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "efec07da-0e50-3395-ab66-adc540ad87c3",
                                        "entry_id": "f6c5ecc9-bd2d-34d4-b1ec-4d52f72baa24",
                                        "glosses": [
                                            "schöne, meist gute, liebe weibliche Märchengestalt"
                                        ],
                                        "tags": [
                                            "Märchen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d7feab6-fac8-4f8b-9101-dd2ee26b272a",
                                                "sense_id": "efec07da-0e50-3395-ab66-adc540ad87c3",
                                                "text": "Im Wald erschien ihm eine gute Fee und gewährte ihm drei Wünsche."
                                            },
                                            {
                                                "example_id": "74c7c52a-8630-4464-811d-0e6282f38211",
                                                "sense_id": "efec07da-0e50-3395-ab66-adc540ad87c3",
                                                "text": "„Elfen und Feen besuchen die Oberwelt und einige Menschen die Unterwelt.“"
                                            },
                                            {
                                                "example_id": "e4c4765c-a0f1-4519-8973-5f42bb786654",
                                                "sense_id": "efec07da-0e50-3395-ab66-adc540ad87c3",
                                                "text": "„Ich hatte noch nicht angefangen zu essen, da vernahm ich in der Quelle ein Plätschern, die Fee trat hervor und bespritzte mich lachend mit Wasser.“"
                                            },
                                            {
                                                "example_id": "65f7fcee-b791-4fb4-bafe-90f47e79f433",
                                                "sense_id": "efec07da-0e50-3395-ab66-adc540ad87c3",
                                                "text": "„Eine Peri ist die orientalische Schwester unserer Feen.“"
                                            },
                                            {
                                                "example_id": "ad0997c5-32b5-4b82-913e-628b4a513058",
                                                "sense_id": "efec07da-0e50-3395-ab66-adc540ad87c3",
                                                "text": "„Die Feen drehten sich zu den Klängen einer Flöte, ihre Arme verwandelten sich in Schmetterlingsflügel, sie tauschten ihre Plätze, wieder und wieder, Wunderkerzen sprühten Funken in ihrer rechten Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d8ae630-c950-4f4d-b27b-76271578a114",
                        "source_entry_id": "e0560023-4574-3fc9-82fd-c1a317defee5",
                        "source_sense_id": "a168f0d4-1f4c-351c-9d40-0a20bcc3f69a",
                        "target_lang_word": "fairy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fairy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9fe8f9b4-d820-3633-8a35-74f46b6d37d4",
                                        "entry_id": "2704d39a-f7ff-3b83-9cd4-0c40d93a3ec1",
                                        "glosses": [
                                            "The realm of faerie; enchantment, illusion."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "733ab922-6d85-384a-bf6c-838ff27a949d",
                                        "entry_id": "2704d39a-f7ff-3b83-9cd4-0c40d93a3ec1",
                                        "glosses": [
                                            "A mythical being of human form with magical powers, known in many sizes and descriptions, although often depicted in modern illustrations only as a small sprite with gauze-like wings, especially one that is female. Fairies are revered in some modern forms of paganism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbc949d5-f15b-4380-ba44-438a30a35876",
                                                "sense_id": "733ab922-6d85-384a-bf6c-838ff27a949d",
                                                "text": "\"They used to say there were fairies in that hill, I must tell you!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ebe5be0-098c-38a0-9274-de78e1cdf718",
                                        "entry_id": "2704d39a-f7ff-3b83-9cd4-0c40d93a3ec1",
                                        "glosses": [
                                            "An enchantress, or creature of overpowering charm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27e9ac2a-120e-3a2f-a6ae-dd33dc298bc4",
                                        "entry_id": "2704d39a-f7ff-3b83-9cd4-0c40d93a3ec1",
                                        "glosses": [
                                            "An attractive young woman."
                                        ],
                                        "tags": [
                                            "British",
                                            "colloquial",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57ddd7c6-81b2-4409-a3bf-85e0f3ee8048",
                                                "sense_id": "27e9ac2a-120e-3a2f-a6ae-dd33dc298bc4",
                                                "text": "\"When are we going to see this fairy?\" demanded Algy.\n\"You, personally, never. You're far too immoral. I might let the others look at her from a distance in a year or two.\""
                                            },
                                            {
                                                "example_id": "c6e0379f-5a35-4f50-8457-15fa962c60e8",
                                                "sense_id": "27e9ac2a-120e-3a2f-a6ae-dd33dc298bc4",
                                                "text": "As she took out her key she was quite unaware that three pairs of eyes were watching her with interest from across the street. [...]\n‘Strewth–’e ain’t ‘arf got a fairy this time,’ remarked the husky Mr. Clegg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dc4a70a-332a-3d03-b935-2467ddf8ade1",
                                        "entry_id": "2704d39a-f7ff-3b83-9cd4-0c40d93a3ec1",
                                        "glosses": [
                                            "A male homosexual, especially one who is effeminate."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "US",
                                            "colloquial",
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "846bd94b-faac-3ada-ae64-4629d58987dd",
                                        "entry_id": "2704d39a-f7ff-3b83-9cd4-0c40d93a3ec1",
                                        "glosses": [
                                            "An effeminate man or boy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3443ae58-80ec-4bc3-8b0f-e5f3236dacc4",
                                                "sense_id": "846bd94b-faac-3ada-ae64-4629d58987dd",
                                                "text": "The cripple returned the smile and stuck out his hand. Miss Lonelyhearts clasped it, and they stood this way, smiling and holding hands, until Mrs. Doyle reëntered the room.\n\"What a sweet pair of fairies you guys are,\" she said.\nThe cripple pulled his hand away and made as though to strike his wife."
                                            },
                                            {
                                                "example_id": "9608a7c1-a35e-4dd0-ad36-a8192b029f33",
                                                "sense_id": "846bd94b-faac-3ada-ae64-4629d58987dd",
                                                "text": "We saw a horrible sight in the bar: a white hipster fairy had come in wearing a Hawaiian shirt and was asking the big drummer if he could sit in."
                                            },
                                            {
                                                "example_id": "72f2223e-cded-48f7-b0e2-2e1cd8f9a6f7",
                                                "sense_id": "846bd94b-faac-3ada-ae64-4629d58987dd",
                                                "text": "Wimpy names—e.g., Cecil, Clarence, and Wendell—also seem to carry homosexual overtones, because we all know that fairies are meek and wimpy, just as we know that all wimps are ‘fags’ in one sense or the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ede48543-0f85-3d35-a0cc-6d27b5df332d",
                                        "entry_id": "2704d39a-f7ff-3b83-9cd4-0c40d93a3ec1",
                                        "glosses": [
                                            "A member of two species of hummingbird in the genus Heliothryx."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e801bb70-2676-3748-8871-da65127a5066",
                                        "entry_id": "2704d39a-f7ff-3b83-9cd4-0c40d93a3ec1",
                                        "glosses": [
                                            "A legendary Chinese immortal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
