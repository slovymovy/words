                        "glosses": [
                            "An Arab frontier outpost or garrison town, chiefly in the period of early Islamic expansion."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "0baa86a3-76c8-469f-9955-b802fd0fd210",
                                "sense_id": "0f4f1186-63c7-3952-bf8f-0edf8570eedf",
                                "text": "Some of the amsar grew into great cities and eventually became the centers in which a new Islamic culture was elaborated […]."
                            },
                            {
                                "example_id": "b56494c9-3cab-42b9-b48d-4df5f0cadc7a",
                                "sense_id": "0f4f1186-63c7-3952-bf8f-0edf8570eedf",
                                "text": "Each misr was divided into quarters that hosted different tribes – not only the fighting men, but also their women and children."
                            },
                            {
                                "example_id": "b0c04fc8-e17a-4224-a6d1-894b45248c21",
                                "sense_id": "0f4f1186-63c7-3952-bf8f-0edf8570eedf",
                                "text": "The amsar may have been golden, but they were gilded garrisons."
                            }
                        ]
                    }
