                        "form": "die Fachrichtungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ada822ed-151e-3675-8810-c11809e2b263",
                        "entry_id": "122ecde7-6a38-35a2-b05e-1b0fa3061fb6",
                        "glosses": [
                            "ein bestimmtes, fachliches Themengebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56403826-1606-4808-84b3-ada81e9e7736",
                                "sense_id": "ada822ed-151e-3675-8810-c11809e2b263",
                                "text": "„Je nach Fachrichtung aber gibt es große Unterschiede: Wer etwa mit Informatik angefangen hat, erhält womöglich noch während des Studiums ein lukratives Stellenangebot.“"
                            },
                            {
                                "example_id": "1970d79a-837e-4f29-a344-c380bdbc4920",
                                "sense_id": "ada822ed-151e-3675-8810-c11809e2b263",
                                "text": "„Ähnliche Mischkalkulationen gelten für die meisten niedergelassenen Ärzte, Die Höhe der Privateinnahmen kann freilich je nach Fachrichtung und Praxissitz sehr unterschiedlich sein.“"
                            },
                            {
                                "example_id": "9eccce61-1710-427f-95ca-66854b4597b0",
                                "sense_id": "ada822ed-151e-3675-8810-c11809e2b263",
                                "text": "„Es könne nicht jedem Patienten ‚sanktionsfrei gestattet bleiben, jeden Arzt jeder Fachrichtung beliebig oft aufzusuchen‘.“"
                            },
                            {
                                "example_id": "cd34fffd-8da3-496d-9201-1069935e4ba4",
                                "sense_id": "ada822ed-151e-3675-8810-c11809e2b263",
                                "text": "„In den Fachrichtungen Schiffbau und Meerestechnik ist der Bedarf an Fachkräften doppelt so hoch wie das Angebot, klagt ein Branchenverband.“"
                            },
                            {
                                "example_id": "758bc8e5-1643-4041-b650-13028141e315",
                                "sense_id": "ada822ed-151e-3675-8810-c11809e2b263",
                                "text": "„Laut Arbeitsagentur hatten Arbeitgeber vor allem im Süden und Westen Deutschlands Schwierigkeiten, ihre offenen Stellen in einigen Fachrichtungen mit den gesuchten Ingenieuren zu besetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
