                    "sense_id": "c06fc02b-e939-3bb3-8426-3f22b0f24116",
                    "sense_definition": "als Wind mehr oder weniger heftig wehen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "luftbewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Draußen <w>windet</w> es heute so stark, dass die Fenster im Zimmer klirren."
                        },
                        {
                            "text": "Im späten Herbst <w>windet</w> es oft über den weiten Feldern des Dorfes."
                        }
                    ],
                    "synonyms": [
                        "blasen",
                        "wehen",
                        "luften"
                    ],
                    "antonyms": [],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vor allem süddeutsch und schweizerisch für wehen"
                        }
                    ]
                },
                {
                    "sense_id": "6326d480-6dda-3b35-85f1-f6eb569c2046",
                    "sense_definition": "etwas Biegsames im Kreis oder spiralförmig um etwas wickeln oder flechten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drehen_wickeln",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Frühling wollen wir aus frischen Blumen einen festlichen Kranz <w>winden</w>."
                        },
                        {
                            "text": "Er <w>wand</w> das dicke Seil mehrmals um den hölzernen Pfosten am Ufer."
                        }
                    ],
                    "synonyms": [
                        "wickeln"
                    ],
                    "common_phrases": [
                        "einen Kranz winden"
                    ]
                },
                {
                    "sense_id": "396176d8-8de7-3ea0-bd2f-10162d10f569",
                    "sense_definition": "sich in Kurven oder Schlangenlinien fortbewegen oder erstrecken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drehen_wickeln",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die schmale Bergstraße <w>windet</w> sich in engen Kurven durch das steile Tal hinauf."
                        },
                        {
                            "text": "Der Fluss <w>windet</w> sich in vielen Schleifen durch die flache Landschaft."
                        }
                    ],
                    "synonyms": [
                        "sich schlängeln"
                    ],
                    "common_phrases": [
                        "sich vor Schmerzen winden",
                        "sich durch das Tal winden"
                    ]
                },
                {
                    "sense_id": "a613bb08-721b-36ac-bd0b-93adc5343a99",
                    "sense_definition": "versuchen, einer unangenehmen Frage oder klaren Antwort geschickt auszuweichen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drehen_wickeln",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf die Frage nach den Kosten <w>wand</w> sich der Politiker und gab keine klare Antwort."
                        },
                        {
                            "text": "Sie <w>wand</w> sich eine ganze Weile, bevor sie ihren schweren Fehler endlich offen zugab."
                        }
                    ],
                    "common_phrases": [
                        "sich um eine Antwort winden"
                    ]
                },
                {
                    "sense_id": "c0f6c981-2acb-3643-ad70-28435534d2af",
                    "sense_definition": "jemandem einen Gegenstand durch eine kräftige Drehbewegung aus der Hand reißen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drehen_wickeln",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit einer schnellen Drehung <w>wand</w> sie dem überraschten Angreifer die Waffe aus den Händen."
                        },
                        {
                            "text": "Er versuchte vergeblich, dem Dieb die Tasche aus der Hand zu <w>winden</w>."
                        }
                    ],
                    "common_phrases": [
                        "jemandem etwas aus der Hand winden"
                    ]
                }
            ]
        },
