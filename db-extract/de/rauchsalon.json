                    {
                        "sense_id": "4da92408-599b-31fa-ab43-8a008396791d",
                        "entry_id": "99337b47-1ee3-3a11-a4d4-b1208759fff1",
                        "glosses": [
                            "Zimmer, in dem geraucht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71830696-555d-4fe1-9d1b-63aafece62a9",
                                "sense_id": "4da92408-599b-31fa-ab43-8a008396791d",
                                "text": "„Kleebusch, von seinen Tischnachbarn in eine Ecke des Rauchsalons geführt, war stets von einigen der schwarzuniformierten Männer umringt.“"
                            },
                            {
                                "example_id": "4bb777a5-db98-4910-a649-514c92bcb016",
                                "sense_id": "4da92408-599b-31fa-ab43-8a008396791d",
                                "text": "„Nach dem Essen zogen wir uns ins Wohnzimmer zurück, da wir keinen Rauchsalon haben.“"
                            },
                            {
                                "example_id": "d8703501-7421-45bc-b3d3-20e03ec3aabf",
                                "sense_id": "4da92408-599b-31fa-ab43-8a008396791d",
                                "text": "„Adam Fenwick-Symes saß unter den »Seefesten« im Rauchsalon, trank seinen dritten Irish Whisky und berechnete, wann ihm wohl ganz schlecht werden würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
