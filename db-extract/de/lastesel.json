                        "source_sense_id": "3b75cc9c-4e64-36d2-99a5-1a492d7cfb75",
                        "source_sense_description": "übertragen: Person, der schwere Lasten aufgebürdet werden",
                        "target_lang_word": "packhorse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
