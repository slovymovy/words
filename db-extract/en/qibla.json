                ],
                "senses": [
                    {
                        "sense_id": "eacef58c-5ecf-3e89-94d3-71fa69b54fe2",
                        "entry_id": "43977f7a-3af1-3f36-a580-ed5afb0690a2",
                        "glosses": [
                            "The direction in which Muslims face while praying, currently determined as the direction of the Kaaba in Mecca."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6b7f9b33-e7fc-4ec4-9e6d-38ae0a708606",
                                "sense_id": "eacef58c-5ecf-3e89-94d3-71fa69b54fe2",
                                "text": "The other mosques' qiblas are also in the 150°'s range, except for the Andalusian Mosque which has a qibla of 148° (table 7, fig. 17)."
                            },
                            {
                                "example_id": "88f230a9-db70-42bf-9839-60d9087fba8a",
                                "sense_id": "eacef58c-5ecf-3e89-94d3-71fa69b54fe2",
                                "text": "Muslim astronomers from the 8th century onwards concerned themselves with the determination of the qibla as a problem of mathematical geography."
                            },
                            {
                                "example_id": "b6b7c035-a243-40be-84ef-e368d4a41137",
                                "sense_id": "eacef58c-5ecf-3e89-94d3-71fa69b54fe2",
                                "text": "The original portico was on the west side (i.e. at right angles to the qibla) and consisted of three bays resting on two marble columns."
                            }
                        ]
                    }
                ],
