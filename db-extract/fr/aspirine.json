        "fr-extract.jsonl": [
            {
                "entry_id": "dd9eb96c-5fac-3f61-bc04-30a33e474720",
                "word": "aspirine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a90f8d15-b39c-491b-af1a-e2b9e00ac6bb",
                        "entry_id": "dd9eb96c-5fac-3f61-bc04-30a33e474720",
                        "tags": [
                            "plural"
                        ],
                        "form": "aspirines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6faed0d-afbd-3615-9237-d2a196907359",
                        "entry_id": "dd9eb96c-5fac-3f61-bc04-30a33e474720",
                        "glosses": [
                            "Nom courant de l’acide acétylsalicylique, anti-inflammatoire (AINS) agissant par inhibition de la cyclooxygénase-1, antipyrétique, anti douleur, anti antiagrégant plaquettaire."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "1a77c4cc-b0d6-4581-ac6a-f17e0c986a78",
                                "sense_id": "e6faed0d-afbd-3615-9237-d2a196907359",
                                "text": "Je laisse à la garde d’un lieutenant d’artillerie quatre droguistes à bicyclette, d’allure allemande, qui prétendent aller à Mulhouse, leurs communes manquant d’aspirine."
                            },
                            {
                                "example_id": "a0eb53cd-4cde-4f0b-aa60-be627fde7236",
                                "sense_id": "e6faed0d-afbd-3615-9237-d2a196907359",
                                "text": "Fernand, cette fois, n’y coupa pas d’une gifle, et hurla qu’il avait la migraine et qu’il lui fallait de la Véganine ou de l’Optalidon, l’aspirine lui donnant des aigreurs d’estomac, auquel cas, par parenthèse, la Tétrasodine était tout indiquée."
                            },
                            {
                                "example_id": "02cd59d9-e10c-4c20-82f7-07b9eb1c3fda",
                                "sense_id": "e6faed0d-afbd-3615-9237-d2a196907359",
                                "text": "Tout en faisant fondre son comprimé d’aspirine dans un demi-verre d’eau, le père suivait chacun de ses gestes."
                            },
                            {
                                "example_id": "c466acda-622f-46d5-af6f-dddc4dc75758",
                                "sense_id": "e6faed0d-afbd-3615-9237-d2a196907359",
                                "text": "Au ministère, tout le monde déplorait qu’un chirurgien de son envergure en fût réduit à prescrire des cachets d’aspirine dans un dispensaire de banlieue."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e6c4e7b-8f6f-3694-82af-323718944462",
                        "entry_id": "dd9eb96c-5fac-3f61-bc04-30a33e474720",
                        "glosses": [
                            "Une dose de ce médicament."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ef8b2724-cb93-4671-887b-95f42b287734",
                                "sense_id": "0e6c4e7b-8f6f-3694-82af-323718944462",
                                "text": "J’ai un sacré mal de tête, je vais prendre deux aspirines."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea1fc037-9b20-3d9c-81ae-391cba0124d3",
                        "entry_id": "dd9eb96c-5fac-3f61-bc04-30a33e474720",
                        "glosses": [
                            "N’importe quel calmant."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4fd493e4-e0de-4172-9220-27c5da98926e",
                                "sense_id": "ea1fc037-9b20-3d9c-81ae-391cba0124d3",
                                "text": "Peut-être avez-vous entendu dire que Transports Canada embauche des inspecteurs? C'est un pas dans la bonne direction, mais ce n’est qu’une aspirine quand une intervention majeure est requise pour restaurer la supervision conventionnelle, et la tant vantée couche de sécurité supplémentaire pour le public voyageur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c99335b-3933-4451-ac7b-4b53fb92c94b",
                        "source_entry_id": "dd9eb96c-5fac-3f61-bc04-30a33e474720",
                        "target_lang_word": "Aspirin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aspirin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "431fe144-8cc6-39d6-b80c-813a25a21e30",
                                        "entry_id": "82cd25e2-52a2-3f96-b2e7-ccf902772ab2",
                                        "glosses": [
                                            "Fertigpräparat – synthetisch hergestellter Wirkstoff mit schmerzlindernden, fiebersenkenden und entzündungshemmenden Eigenschaften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dedc64e9-71b1-46de-a7bb-b70a12a8c7f8",
                                                "sense_id": "431fe144-8cc6-39d6-b80c-813a25a21e30",
                                                "text": "Im letzten Drittel der Schwangerschaft darf Aspirin nicht eingenommen werden."
                                            },
                                            {
                                                "example_id": "c82c9169-4f46-4295-99b6-bf8e56841316",
                                                "sense_id": "431fe144-8cc6-39d6-b80c-813a25a21e30",
                                                "text": "Die schmerzhemmende Wirkung von Aspirin beruht auf der Hemmung der Bildung von Botenstoffen."
                                            },
                                            {
                                                "example_id": "1c58ce8e-70cc-455e-b948-83e86b27aec5",
                                                "sense_id": "431fe144-8cc6-39d6-b80c-813a25a21e30",
                                                "text": "„Er untersucht mich, man müsse alle Pazifisten an die Wand stellen, sagt er, dann verschreibt er Aspirin und verweigert dem Fiebernden eine zweite Decke.“"
                                            },
                                            {
                                                "example_id": "40532fc4-015e-4827-ae5f-2d79227cd053",
                                                "sense_id": "431fe144-8cc6-39d6-b80c-813a25a21e30",
                                                "text": "„Mein Vater hatte in Deutschland mit Ende vierzig angefangen, täglich eine Aspirin zu schlucken, weil er zu dickflüssiges Blut hatte, es zu zäh, breiig durch die Adern floss, es nicht bis in die letzten Winkel seines Körpers schaffte.“"
                                            },
                                            {
                                                "example_id": "2cb3eb58-46a6-4c85-8522-487b8330729b",
                                                "sense_id": "431fe144-8cc6-39d6-b80c-813a25a21e30",
                                                "text": "„Gehorsam nahm sie das Wasser und das Aspirin.“"
                                            },
                                            {
                                                "example_id": "2bf67855-a832-4ec2-8db6-ef0936d7de4d",
                                                "sense_id": "431fe144-8cc6-39d6-b80c-813a25a21e30",
                                                "text": "„Ich halte mir die Ohren zu, flüchte in die Küche und schlucke zwei Aspirin und ein Valium.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45f0b03c-7dc3-4a51-9995-04d7a399f088",
                        "source_entry_id": "dd9eb96c-5fac-3f61-bc04-30a33e474720",
                        "target_lang_word": "Acetylsalicylsäure",
                        "target_lang_code": "de",
