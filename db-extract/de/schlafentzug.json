                "senses": [
                    {
                        "sense_id": "3123f4f9-6c2a-3a50-8f40-66cb684b1acb",
                        "entry_id": "a3f1debf-1cc1-33e3-94e9-d47d6cfc68d9",
                        "glosses": [
                            "das Wachhalten, Abhalten einer Person vom Schlafen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b110b6b-6355-470a-8b59-59dc1149c5e9",
                                "sense_id": "3123f4f9-6c2a-3a50-8f40-66cb684b1acb",
                                "text": "„Verhörtechniken wie Schlafentzug, das Entkleiden der Gefangenen oder der einschüchternde Einsatz von Hunden seien Phänomene, die erst nach ihrem genehmigten Einsatz in Afghanistan und Guantanamo dann auch woanders angewendet worden seien.“"
                            },
                            {
                                "example_id": "6290cb76-18b5-4642-bb51-a05470158924",
                                "sense_id": "3123f4f9-6c2a-3a50-8f40-66cb684b1acb",
                                "text": "„Durch viele Versuche konnte aber bewiesen werden, dass diese Stimmungsaufhellung auch bei depressiven Menschen sehr gut funktioniert. Deshalb wird bei ihnen der Schlafentzug als Therapie angewandt.“"
                            },
                            {
                                "example_id": "c110a3fb-99a8-478e-8089-a19673d20417",
                                "sense_id": "3123f4f9-6c2a-3a50-8f40-66cb684b1acb",
                                "text": "„Schlafentzug für eine Nacht oder auch nur eine halbe Nacht (bevorzugt der zweiten Nachthälfte) wirkt eindeutig antidepressiv, wenn auch oft nur kurze Zeit, so dass Wiederholungen angezeigt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2c8a0bb-ada4-4afb-8be7-dfadb5816314",
                        "source_entry_id": "a3f1debf-1cc1-33e3-94e9-d47d6cfc68d9",
                        "source_sense_id": "3123f4f9-6c2a-3a50-8f40-66cb684b1acb",
                        "source_sense_description": "das Wachhalten, Abhalten einer Person vom Schlafen",
                        "target_lang_word": "sleep deprivation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sleep deprivation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d07d9a9-061b-3cde-a824-e784dca2da1a",
                                        "entry_id": "b9e4d356-4f70-3afe-bb58-f6f63bff9d79",
                                        "glosses": [
                                            "The condition of being kept awake and not getting enough sleep (as forcibly by someone else, or by a disorder), to the point of noticeably lower alertness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "911c2f42-e2ce-45b1-a527-b349c66714fc",
                                                "sense_id": "6d07d9a9-061b-3cde-a824-e784dca2da1a",
                                                "text": "Sleep deprivation can lead to fatal vehicular accidents."
                                            },
                                            {
                                                "example_id": "5061cca3-7d56-482a-a575-e05ef4f20496",
                                                "sense_id": "6d07d9a9-061b-3cde-a824-e784dca2da1a",
                                                "text": "Growing evidence has accumulated over the last two decades and revealed that a number of sleep traits in humans are heritable, such as timing of sleep, total daily sleep requirement, response to sleep deprivation, and various EEG measurements/patterns."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f361d5a2-3bc4-4361-a374-c0f0bdff874f",
                        "source_entry_id": "a3f1debf-1cc1-33e3-94e9-d47d6cfc68d9",
                        "source_sense_id": "3123f4f9-6c2a-3a50-8f40-66cb684b1acb",
                        "source_sense_description": "das Wachhalten, Abhalten einer Person vom Schlafen",
                        "target_lang_word": "privation de sommeil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "privation de sommeil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3576f2b-ec91-3de6-a53b-eb0e3594deb8",
                                        "entry_id": "1e430753-258b-3d43-a3c6-01f63dec1122",
                                        "glosses": [
                                            "Fait de provoquer un manque de sommeil, d’empêcher de dormir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4a8ee54-74ed-4ac1-9d36-c66348dd6a9d",
                                                "sense_id": "c3576f2b-ec91-3de6-a53b-eb0e3594deb8",
                                                "text": "Il a été prouvé que la privation de sommeil entraîne une baisse de la résistance aux distractibilités visuelle et auditive (Harrison et Horne, 2000b)."
                                            },
                                            {
                                                "example_id": "e39c2efd-f8a9-4e44-aa33-877458cc2850",
                                                "sense_id": "c3576f2b-ec91-3de6-a53b-eb0e3594deb8",
                                                "text": "Dans une plainte adressée aux autorités et publiée, jeudi 25 mars, sur son site, l’opposant russe a expliqué être réveillé « huit fois par nuit » par ses geôliers. « Il s’agit de facto d’un recours à la torture par privation de sommeil », a-t-il écrit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
