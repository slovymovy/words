                        "glosses": [
                            "Syringa L., rodzaj krzewów lub drzew z rodziny oliwkowatych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cceab94-5e12-4b70-b067-f74c8151cd17",
                                "sense_id": "814cac43-3c1f-3cb1-8805-d7e26f3ae6cd",
                                "text": "To dekoracyjne kwiatostany sprawiają, że lilak należy do najbardziej lubianych i rozpoznawalnych roślin ozdobnych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
