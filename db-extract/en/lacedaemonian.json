                    {
                        "translation_id": "9fcd4641-7c18-4f3f-ba14-ecea6549002c",
                        "source_entry_id": "3e28144e-4ece-3045-a9c7-25f35bf23a32",
                        "source_sense_description": "of, from or pertaining to Lacedaemonia",
                        "target_lang_word": "lacédémonien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lacédémonien",
