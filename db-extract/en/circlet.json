                                "target_senses": [
                                    {
                                        "sense_id": "7e7af3cb-0e61-3762-8f00-be84e94fefa6",
                                        "entry_id": "715f5e1d-bc52-396f-b77f-2634fafc1be8",
                                        "glosses": [
                                            "Sorte de bandeau qui était la marque de la royauté chez les Anciens et dont les rois et les reines se ceignaient le front."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ca07b2e-6421-4a99-a56f-db848ad7df50",
                                                "sense_id": "7e7af3cb-0e61-3762-8f00-be84e94fefa6",
                                                "text": "Porter un diadème."
                                            },
                                            {
                                                "example_id": "513df97f-dbb0-4121-b8c6-2ac9a3a6ab8b",
                                                "sense_id": "7e7af3cb-0e61-3762-8f00-be84e94fefa6",
                                                "text": "Ceindre sa tête, son front d’un diadème."
                                            },
                                            {
                                                "example_id": "5d4f76dc-f1cc-4cc2-823a-bba8221d80b7",
                                                "sense_id": "7e7af3cb-0e61-3762-8f00-be84e94fefa6",
                                                "text": "Orné d’un diadème."
                                            },
                                            {
                                                "example_id": "814e0765-bd92-49fb-ba49-bf9eaca29f92",
                                                "sense_id": "7e7af3cb-0e61-3762-8f00-be84e94fefa6",
                                                "text": "Le plus célèbre est un diadème de trois cent vingt-quatre brillants de toutes les couleurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aa1c8be-3672-38fe-9cb2-cdd1631aa697",
                                        "entry_id": "715f5e1d-bc52-396f-b77f-2634fafc1be8",
                                        "glosses": [
                                            "Il se dit souvent, en parlant de la royauté même, dans certaines phrases figurées du style élevé ou poétique."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58c5d2cd-0156-4f46-99f0-e2df863ca562",
                                                "sense_id": "5aa1c8be-3672-38fe-9cb2-cdd1631aa697",
                                                "text": "L’éclat du diadème."
                                            },
                                            {
                                                "example_id": "6a9a7fc7-43a8-498e-9790-8c17af243af0",
                                                "sense_id": "5aa1c8be-3672-38fe-9cb2-cdd1631aa697",
                                                "text": "Ceindre le diadème, devenir roi ou reine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d22aa97-70ad-38ea-87d6-8de536458993",
                                        "entry_id": "715f5e1d-bc52-396f-b77f-2634fafc1be8",
                                        "glosses": [
                                            "Parure féminine qui se place sur la tête et qui a la forme du bandeau royal."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2789c4c6-6381-401e-9424-637b2e5b4644",
                                                "sense_id": "5d22aa97-70ad-38ea-87d6-8de536458993",
                                                "text": "Elle portait un diadème de cauris dans ses cheveux et un collier prolongé d’un pectoral qui irriguait sa poitrine d’une pluie de perles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d501f32-c38f-399e-b56f-9a443afae3eb",
                                        "entry_id": "715f5e1d-bc52-396f-b77f-2634fafc1be8",
                                        "glosses": [
                                            "Nom commun d'un genre de papillons diurnes, originaire des régions chaudes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d288fa6-2822-3313-ba65-f00abc44450d",
                                        "entry_id": "715f5e1d-bc52-396f-b77f-2634fafc1be8",
                                        "glosses": [
                                            "Meuble représentant le bijou du même nom dans les armoiries. À rapprocher de couronne, couronne comtale, couronne de laurier, couronne d’épines, couronne de reine, couronne fleuronnée, couronne murale, couronne navale, couronne royale, cancerlin, crancelin, crantzelin et tiare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5089ac97-35f4-4ae6-8f8f-16e4a26783ef",
                                                "sense_id": "2d288fa6-2822-3313-ba65-f00abc44450d",
                                                "text": "Écartelé en sautoir : au 1ᵉʳ de sinople à l’oie volant d’argent allumée, becquée et membrée d’or posée en bande, au 2ᵉ de gueules à la noix d’or, au 3ᵉ de gueules au besant d’or chargé d’un masque de renard de gueules tenant un fromage d’argent, au 4ᵉ de sinople au diadème d’or, qui est de la commune de Noyers-Auzécourt de la Meuse → voir illustration « armoiries avec un diadème »"
                                            }
                                        ]
                                    }
                                ]
