                                        "glosses": [
                                            "Excessively or tiresomely talkative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "316875c7-97a8-4ee6-a546-6e964ae43d84",
                                                "sense_id": "38e81b67-1b81-36b8-a4f5-2e49314d5879",
                                                "text": "She lingered for a few moments, and was garrulous over some detail of the household."
                                            },
                                            {
                                                "example_id": "b491fd27-b9ad-41bb-a333-2eb00755bd31",
                                                "sense_id": "38e81b67-1b81-36b8-a4f5-2e49314d5879",
                                                "text": "Crammed with gossip, anecdotes, and confessions . . ., his garrulous, untidy narratives read like a good novel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "021047d7-9329-3a30-ad87-cafb810c9405",
                                        "entry_id": "d4c451e4-ae8c-3468-9dd6-0dbc77ddf86d",
                                        "glosses": [
                                            "Excessively wordy and rambling."
                                        ],
                                        "tags": [
                                            "of something written or performed"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
