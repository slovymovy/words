                        "glosses": [
                            "Slow in manner; taking more time than is necessary; lagging behind."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60d8be1e-4952-4743-9e6b-1e60a0177c95",
                                "sense_id": "3eb394fa-c04a-34c2-98a7-dad058e9f6d8",
                                "text": "For the most part the early adopters, early majority, and later majority can function in either an innovative system, laggardly system, or a system that has a combination of both."
                            },
                            {
                                "example_id": "d166ed6b-eed9-4554-8bd2-ba2a63d050eb",
                                "sense_id": "3eb394fa-c04a-34c2-98a7-dad058e9f6d8",
                                "text": "It is extremely important to discover why a county such as West Glamorgan, which is still home to a great number of native Welsh speakers, is more laggardly in its provision of Welsh language teaching than South Glamorgan ..."
                            },
                            {
                                "example_id": "c1c6ef2f-1ace-4e80-99d7-86a516c7d707",
                                "sense_id": "3eb394fa-c04a-34c2-98a7-dad058e9f6d8",
                                "text": "Britain has considerable interest in completing the Single Market in services that has made much more laggardly progress than the free movement of persons and visible goods."
                            }
                        ]
                    }
