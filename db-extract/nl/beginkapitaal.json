                "senses": [
                    {
                        "sense_id": "40036f59-3cd9-3814-ab98-5829b4996389",
                        "entry_id": "53d08422-d2d6-36d0-a52f-f41fb0e9eade",
                        "glosses": [
                            "hoeveelheid geld dat men heeft bij het begin van een project"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67bd136b-521b-4e9d-b08d-bbba7993913a",
                                "sense_id": "40036f59-3cd9-3814-ab98-5829b4996389",
                                "text": "Er was dus, zogezegd, een beginkapitaal, waarmee ik de benedenmaatse productie van de mindere dagen zou kunnen aanzuiveren."
                            },
                            {
                                "example_id": "dfee94e2-229d-42f9-bdfb-d5a67cb33e22",
                                "sense_id": "40036f59-3cd9-3814-ab98-5829b4996389",
                                "text": "Een modernere vorm van crowdfunding is de startende ondernemer die een beginkapitaal bij elkaar sprokkelt om zo –zonder financiering van een bank– het gewenste product in de markt te kunnen zetten. Ook hier wacht de belegger bij succes een rendement. Soms in geld, soms in natura (bijvoorbeeld exemplaren van het nieuwe product)."
                            }
                        ]
                    },
                    {
                        "sense_id": "26de8f17-b13a-3016-8bd1-d11a5658a8c2",
                        "entry_id": "53d08422-d2d6-36d0-a52f-f41fb0e9eade",
                        "glosses": [
                            "de hoofdletter die het begin van een zin vormt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03572d87-4dc4-45e5-9802-8d060fbb21c4",
                                "sense_id": "26de8f17-b13a-3016-8bd1-d11a5658a8c2",
                                "text": "Juryvoorzitter Gerard Haverkort wijst er op dat de dichtregel Er is zoveel gebeurd, maar niets veranderd wel een beginkapitaal heeft, maar maar geen eind-leesteken (punt / vraag- of uitroepteken) kent."
                            }
                        ]
                    }
