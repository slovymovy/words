                                        "sense_id": "c89c0531-bbdf-3b82-bb62-55f08284ab97",
                                        "entry_id": "a4c915aa-338c-39a5-877e-f7c6e246c6eb",
                                        "glosses": [
                                            "A person between thirteen and nineteen years old."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adda98f9-d1db-4697-8927-3df5c84350e3",
                                                "sense_id": "c89c0531-bbdf-3b82-bb62-55f08284ab97",
                                                "text": "Most teenagers will undergo lots of changes before reaching adulthood."
                                            },
                                            {
                                                "example_id": "b8e85fc6-d7ea-497e-9ce0-1cc8d9677a39",
                                                "sense_id": "c89c0531-bbdf-3b82-bb62-55f08284ab97",
                                                "text": "Marco's main target market are late teenagers."
                                            },
                                            {
                                                "example_id": "8e4438cf-ecd3-4d5e-aca3-40ca98444ff7",
                                                "sense_id": "c89c0531-bbdf-3b82-bb62-55f08284ab97",
                                                "text": "A British teenager who killed three young girls at a Taylor Swift-themed dance event was jailed for at least 52 years on Thursday, for an attack Prime Minister Keir Starmer called one of the most harrowing moments in Britain’s history."
                                            },
                                            {
                                                "example_id": "6a19e47c-2f2a-407e-8d07-8fe2396ec655",
                                                "sense_id": "c89c0531-bbdf-3b82-bb62-55f08284ab97",
                                                "text": "Many of the rulings against such limits, including the 5th Circuit opinion issued Wednesday, cite the participation of older teenagers in militias around the time of the Second Amendment’s framing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
