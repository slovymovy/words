                    },
                    {
                        "sense_id": "26787d50-286b-3836-b34c-b765779f0539",
                        "entry_id": "9746e7e0-91f0-3a23-860d-c39444da2302",
                        "glosses": [
                            "размывая текущей, льющейся жидкостью почву, удалять, уносить из нее что-либо"
                        ],
                        "tags": [],
