                ],
                "senses": [
                    {
                        "sense_id": "836f9728-9373-36d5-b7cb-bd9703b7163d",
                        "entry_id": "22caca2f-b6bc-39b2-bcda-48334a88ba02",
                        "glosses": [
                            "langer Hals der Giraffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b43c3cc-53ef-49ae-931f-ff1aaaf4025f",
                                "sense_id": "836f9728-9373-36d5-b7cb-bd9703b7163d",
                                "text": "„Trotz seiner Länge hat der Giraffenhals auch nur sieben Halswirbel, wie bei uns Menschen.“"
                            },
                            {
                                "example_id": "28bfe896-a950-47d4-9c2f-07a5ebc7079a",
                                "sense_id": "836f9728-9373-36d5-b7cb-bd9703b7163d",
                                "text": "„Im Biologieunterricht haben wir gelernt, dass der lange Giraffenhals nicht lamarckistisch entstanden sei, also lang wurde, weil die Vorfahren der Giraffen kräftig den Hals gereckt haben.“"
                            },
                            {
                                "example_id": "563de14c-582a-4297-9137-7826ade2fd97",
                                "sense_id": "836f9728-9373-36d5-b7cb-bd9703b7163d",
                                "text": "„Giraffenhälse sind über Generationen hinweg deshalb gewachsen, weil Elterntiere mit besonders langen Hälsen einen evolutionären Vorteil hatten (mehr Nahrung fanden und folglich mehr Nachwuchs bekamen) und die Halslänge von Giraffen erblich ist, das heißt, zwischen Eltern und Kindern korreliert.“"
                            },
                            {
                                "example_id": "85b93154-df38-4c41-901c-0391e6dae11c",
                                "sense_id": "836f9728-9373-36d5-b7cb-bd9703b7163d",
                                "text": "[übertragen:] „In meinem Traum hatte ich einen langen Giraffenhals, dadurch konnte ich sehr weit sehen.“"
                            },
                            {
                                "example_id": "eb46bfe3-4c96-45f9-a2cc-285f9d04397f",
                                "sense_id": "836f9728-9373-36d5-b7cb-bd9703b7163d",
                                "text": "[übertragen:] „Der Mann hinter dem Schreibtisch war groß und hatte einen langen Giraffenhals, kleine Augen, eine lange Nase und buschige Augenbrauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
