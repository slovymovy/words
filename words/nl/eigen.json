                    "frequency": "Middle",
                    "semantic_group_id": "kenmerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het maken van fouten is <w>eigen</w> aan het leerproces van een nieuwe taal.",
                            "target_lang_translations": {
                                "en": "Making mistakes is <w>inherent</w> to the process of learning a new language.",
                                "ru": "Совершение ошибок <w>свойственно</w> процессу изучения нового языка."
                            }
                        },
                        {
                            "text": "Iedere streek in dit land heeft iets <w>eigens</w> wat toeristen aantrekt.",
                            "target_lang_translations": {
                                "en": "Every region in this country has something <w>unique</w> that attracts tourists.",
                                "ru": "В каждом регионе этой страны есть что-то <w>своеобразное</w>, что привлекает туристов."
                            }
                        }
