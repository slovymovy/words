                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Le Pirée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f6332fa-0dc6-3dfb-a89b-cb1a5756cf77",
                                        "entry_id": "ddffbbfa-18e5-3df6-80a9-b9293c314e7d",
                                        "glosses": [
                                            "Port maritime d’Athènes, ouvert sur la mer Égée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f8bb966-0685-4e85-99fd-27b08d2de722",
                                                "sense_id": "8f6332fa-0dc6-3dfb-a89b-cb1a5756cf77",
                                                "text": "Prendre le Pirée pour un homme."
                                            },
                                            {
                                                "example_id": "0795b18f-c42b-4148-9e15-969d5bdf5fbf",
                                                "sense_id": "8f6332fa-0dc6-3dfb-a89b-cb1a5756cf77",
                                                "text": "Je doute qu’il se trouve aucun lecteur de l’Encyclopédie qui prenne avec le singe de la Fontaine, le Pirée pour un nom d’homme ; personne n’ignore que c’étoit le port de la ville d’Athenes."
                                            },
                                            {
                                                "example_id": "85192f8b-d67c-41f1-aa26-b755d0a5145b",
                                                "sense_id": "8f6332fa-0dc6-3dfb-a89b-cb1a5756cf77",
                                                "text": "Le Pirée a eu la gloire d’avoir vu dans l’enceinte de ses murailles quelques-unes des premieres écoles de philosophie qui aient été dans l’univers. Ce fut au Pirée qu’Antisthene forma la secte des Cyniques. On leur donna ce nom à cause du fauxbourg d’Athènes appellé Cynosarges, où les Cyniques vinrent s’établir en quittant le Pirée."
                                            },
                                            {
                                                "example_id": "67df9780-fb27-4cd6-ae50-2dbe989bb034",
                                                "sense_id": "8f6332fa-0dc6-3dfb-a89b-cb1a5756cf77",
                                                "text": "On peut prendre Le Pirée pour un homme, mais on n’a pas le droit de prendre l’Acropole pour une filiale de la Standard Oil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
