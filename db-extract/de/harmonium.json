                    {
                        "form_id": "50e9f6b6-e44e-4794-b569-460932c6f86d",
                        "entry_id": "b748b944-e06c-37d0-ae1c-b59a57b44089",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Harmonien"
                    },
                    {
                        "form_id": "ae3f1820-21dc-40d2-a390-d3eb26a875c6",
                        "entry_id": "b748b944-e06c-37d0-ae1c-b59a57b44089",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Harmoniums"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bec1eed1-0786-372d-b351-98cddef0f5c7",
                        "entry_id": "b748b944-e06c-37d0-ae1c-b59a57b44089",
                        "glosses": [
                            "Tasteninstrument, bei dem der Ton durch verschieden lange Durchschlagzungen erzeugt wird, die von Luft umströmt in Schwingung versetzt werden"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "249c0477-2158-4d2c-b32e-267d798761c2",
                                "sense_id": "bec1eed1-0786-372d-b351-98cddef0f5c7",
                                "text": "„Das Harmonium begann zu spielen, andächtig und feierlich.“"
                            },
                            {
                                "example_id": "d7dab38a-eb1a-406c-99ac-d42d526ce469",
                                "sense_id": "bec1eed1-0786-372d-b351-98cddef0f5c7",
                                "text": "„Vielleicht kann er ja auch auf einem Drahtseil ohne Netz mit acht Bällen jonglieren oder mit einem Floß den Atlantik überqueren und dabei Harmonium spielen.“"
                            },
                            {
                                "example_id": "3c72640e-edff-4684-be2b-cc81e4b11ed0",
                                "sense_id": "bec1eed1-0786-372d-b351-98cddef0f5c7",
                                "text": "„Ich wollte gerade auch was dazu sagen, da kam der Organist und legte seinen Arm um meine Schulter und führte mich aus der Küche in die Stube, schloß hinter uns die Tür und sagte, ich sollte mich ans Harmonium setzen.“"
                            },
                            {
                                "example_id": "52bfc9f1-968b-4b47-b609-8f5102e4ea18",
                                "sense_id": "bec1eed1-0786-372d-b351-98cddef0f5c7",
                                "text": "„Ich werde mein Bestes geben, aber beurteilt mich nicht zu harsch, bisher habe ich es nur auf dem alten, ausgetretenen Harmonium in der Kirche gespielt, das so falsch klingt, dass die Toten unruhig werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae1799dc-2ca3-42d9-b707-ad1eb44f4d64",
                        "source_entry_id": "b748b944-e06c-37d0-ae1c-b59a57b44089",
                        "source_sense_id": "bec1eed1-0786-372d-b351-98cddef0f5c7",
                        "source_sense_description": "Tasteninstrument, bei dem der Ton durch verschieden lange Durchschlagzungen erzeugt wird",
                        "target_lang_word": "harmonium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harmonium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48253a98-b480-36c8-a56b-c7759921ac9d",
                                        "entry_id": "25f2b547-37ac-3a72-98f9-bf117a5fd65f",
                                        "glosses": [
                                            "A small keyboard instrument that consists of a series of reed pipes, which sound when one of the keys is pressed to open a valve that allows air to pass through."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fff5dd4d-7133-48c5-8d76-0fa50d889be3",
                                                "sense_id": "48253a98-b480-36c8-a56b-c7759921ac9d",
                                                "text": "The only other man was a little grey-headed fellow with a pleasant face and quick, twinkling eyes, who sat at a harmonium in the corner."
                                            },
                                            {
                                                "example_id": "9b812c86-473a-4d4a-b362-8454fe41b270",
                                                "sense_id": "48253a98-b480-36c8-a56b-c7759921ac9d",
                                                "text": "They were a grave and reverend seignior in a frock coat, a lady sitting at a portable harmonium, and a chinless youth toying with a crucifix."
                                            },
                                            {
                                                "example_id": "4705aa69-cbb4-485d-a966-092eb28ac17f",
                                                "sense_id": "48253a98-b480-36c8-a56b-c7759921ac9d",
                                                "text": "It [Troutbeck] has religious isolation also, for it is several miles—and very strenuous miles in winter—from the parish church at Mungrisdale, and the introduction of the harmonium to the waiting room was due to the zeal of a vicar of many years ago who, in the absence of any other room in the village, obtained permission to use the premises for services, including Sunday School. Most of his successors have continued this self-sacrificing duty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "539f48ae-7c9f-3b50-aad1-25fde993c086",
                                        "entry_id": "25f2b547-37ac-3a72-98f9-bf117a5fd65f",
                                        "glosses": [
                                            "Synonym of Hooke's atom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44bce763-53ea-49f8-b80b-5e57ed0462c6",
                        "source_entry_id": "b748b944-e06c-37d0-ae1c-b59a57b44089",
