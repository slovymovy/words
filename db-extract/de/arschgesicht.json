                "senses": [
                    {
                        "sense_id": "f3d22646-a7a1-3260-8385-6c913f62d76b",
                        "entry_id": "a6094ac5-52b4-3a6a-8b42-516a28977fca",
                        "glosses": [
                            "unsympathische Person"
                        ],
                        "tags": [
                            "derogatory",
                            "impolite",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "3fe62ec7-7c82-4156-8b36-2e8220ecf67b",
                                "sense_id": "f3d22646-a7a1-3260-8385-6c913f62d76b",
                                "text": "„Als das Arschgesicht sich noch einmal mit Frau Groß anlegen wollte, bekam er Zunder.“"
                            },
                            {
                                "example_id": "c978380d-dc75-4528-adfc-ca827b66be4d",
                                "sense_id": "f3d22646-a7a1-3260-8385-6c913f62d76b",
                                "text": "„Die und Niveau! Ausgerechnet Lobig, das rote Arschgesicht.“"
                            },
                            {
                                "example_id": "23f5b4e4-ccf0-4ad9-912b-4e31575dbf02",
                                "sense_id": "f3d22646-a7a1-3260-8385-6c913f62d76b",
                                "text": "„Sollte ein Herr, der sich von einer Dame belästigt fühlt, wirklich sagen: ›Verpiss dich, du Fotze‹, oder wirkt das weniger drastische ›Fick dich ins Knie, du Arschgesicht‹ sympathischer?“"
                            },
                            {
                                "example_id": "1c626fd8-4d44-40a8-b29c-2a9fdfc3efad",
                                "sense_id": "f3d22646-a7a1-3260-8385-6c913f62d76b",
                                "text": "„Im reiferen Alter laufen sie dann alle mit Arschgesichtern rum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a11c0119-e46a-4798-9542-3a96a8dae824",
