                                    {
                                        "sense_id": "52116cbe-9816-36b1-b35a-94343dfa8cc7",
                                        "entry_id": "a475e561-63b2-3353-ae87-1b995682686e",
                                        "glosses": [
                                            "Someone who lives in a city or similar urban area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3e5b312-5b34-4b8d-9da4-0be70b902286",
                                                "sense_id": "52116cbe-9816-36b1-b35a-94343dfa8cc7",
                                                "text": "But an electric car doesn’t make sense for individual urbanites. Few of them drive enough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13572c39-0e71-3ed3-a84b-28ef8b5317f3",
                                        "entry_id": "a475e561-63b2-3353-ae87-1b995682686e",
                                        "glosses": [
                                            "One of a demographic class of young, socially-conscious, urban professionals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "urbanite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d085191d-15eb-3a22-9422-91041d296b1f",
                                        "entry_id": "29a03ff9-bc40-3e70-83c0-d6448656860f",
                                        "glosses": [
                                            "Rock-like recycled building material from man-made sources."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "769017ad-034e-437d-9c3e-d1f466ca9523",
                                                "sense_id": "d085191d-15eb-3a22-9422-91041d296b1f",
                                                "text": "In Eugene, Oregon, Rob Bolman received a building permit for a straw bale house with a foundation made of stacked urbanite with a cement-sand mortar and a poured concrete bond beam on top."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92edca2f-21ef-4c83-8b6a-fc744253bdf3",
                        "source_entry_id": "6002ade7-b095-3218-ac60-743ebb5242c0",
                        "source_sense_id": "afb3716b-66f6-394a-9a2e-9640f6979bea",
                        "source_sense_description": "jemand, der durch das Stadtleben geprägt ist",
                        "target_lang_word": "citadin",
