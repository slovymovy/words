                ],
                "senses": [
                    {
                        "sense_id": "fba93d57-d669-3f3a-a31e-059a6f945461",
                        "entry_id": "547ee2c9-7f8c-3bea-b059-e1857a4778a1",
                        "glosses": [
                            "Form der Raserei und Gewaltausübung, bei der eine Person (genannt: Amokläufer) in blindem Vorwärtsstürmen jede ihm begegnende Person niedermetzelt oder niederschießt"
                        ],
                        "tags": [
                            "Gewaltverbrechen"
                        ],
                        "examples": [
                            {
                                "example_id": "b3da8a73-2210-4a92-9b79-5d28f32382c8",
                                "sense_id": "fba93d57-d669-3f3a-a31e-059a6f945461",
                                "text": "„Die Amoktat in Hamburg-Alsterdorf 2023 wurde am Abend des 9. März in einem Königreichssaal der Zeugen Jehovas in der Straße Deelböge in Hamburg-Alsterdorf verübt.“"
                            },
                            {
                                "example_id": "22f83766-bbca-4d07-853f-22f707cca2f4",
                                "sense_id": "fba93d57-d669-3f3a-a31e-059a6f945461",
                                "text": "„Wir haben großen Respekt vor der Tapferkeit der örtlichen Polizeibeamten, die hier in Winnenden mit hohem persönlichem Risiko noch Schlimmeres verhindert haben. Das rasche Eingreifen sei auch eine Konsequenz aus früheren Amoktaten gewesen.“"
                            },
                            {
                                "example_id": "9bb0181a-2cbd-4a9f-97f6-c418a4c498ae",
                                "sense_id": "fba93d57-d669-3f3a-a31e-059a6f945461",
                                "text": "„Nach der Amoktat in der Grundschule in Nashville hat die Polizei Tagebücher der Schützin ausgewertet. Offenbar wurde die Tat über Monate vorbereitet.“"
                            },
                            {
                                "example_id": "4af916d4-16d4-4974-b07a-f001eca0bcb3",
                                "sense_id": "fba93d57-d669-3f3a-a31e-059a6f945461",
                                "text": "„Zwei Wochen nach der Amoktat in den Räumen der Zeugen Jehovas in Hamburg reißt die Debatte über ein schärferes Waffenrecht und mögliche Versäumnisse im Vorfeld des Verbrechens nicht ab.“"
                            },
                            {
                                "example_id": "9f4858b1-a4ea-404e-bfcc-be9bf74c5087",
                                "sense_id": "fba93d57-d669-3f3a-a31e-059a6f945461",
                                "text": "„Bundespräsident Frank-Walter Steinmeier hat für die Trauerfeier zum Gedenken an die Opfer der Amoktat in Hamburg ein Grußwort übermittelt, das Hamburgs Erster Bürgermeister Peter Tschentscher zum Abschluss der Veranstaltung am 25. März verlesen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
