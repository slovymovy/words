                            },
                            {
                                "target_word": "primal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9382ccdd-8caf-32c4-91fe-7a2200f3f43f",
                                        "entry_id": "ce772f8b-4efd-37c8-9373-967e0a47278c",
                                        "glosses": [
                                            "To take part in primal therapy."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fae51a04-1a02-4f08-acea-f9d56ea1f8a1",
                                                "sense_id": "9382ccdd-8caf-32c4-91fe-7a2200f3f43f",
                                                "text": "One of my patients told me of an acquaintance who primaled in the shopping center. Janov described a patient who primaled on the tennis court. Apparently, once initiated, patients primal in any place at any time for the rest of their lives."
                                            },
                                            {
                                                "example_id": "c58bae1e-7a8a-49ee-ab62-7dc76fcd9df1",
                                                "sense_id": "9382ccdd-8caf-32c4-91fe-7a2200f3f43f",
                                                "text": "Primaling on the infant level seems so genuinely babyish that the unsophisticated observer may mistake it for psychotic behavior."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
