        "fr-extract.jsonl": [
            {
                "entry_id": "0f56a4bf-39bc-350a-9623-0f8c49c597c1",
                "word": "fermement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c3b8e61b-9efd-3fa9-9314-285f7a82a078",
                        "entry_id": "0f56a4bf-39bc-350a-9623-0f8c49c597c1",
                        "glosses": [
                            "D’une manière ferme, avec force, avec vigueur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5fe66c1-87b3-493a-97a9-2dd486d32d7d",
                                "sense_id": "c3b8e61b-9efd-3fa9-9314-285f7a82a078",
                                "text": "Mis en cause dans son intelligence en tant que doctrine révolutionnaire, le néomalthusianisme ne s'en est pas moins ancré fermement en milieu ouvrier, et cela en dépit d’équivoques à l'égard de l’avortement, déconseillé, justifié à regret, ou encouragé."
                            },
                            {
                                "example_id": "1d8bb541-b278-4490-b2f3-8c26a47beedb",
                                "sense_id": "c3b8e61b-9efd-3fa9-9314-285f7a82a078",
                                "text": "A la main, il tenait fermement une fraise dentaire de bonne taille. Il l'activa d'un geste et le ronronnement inquiétant envahit la pièce, fort comme le bruit d'un réacteur d'avion. Il tendit sa main armée vers Raphaël et agita son instrument."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0c5255c-a7a8-3c95-b554-3e6b55958047",
                        "entry_id": "0f56a4bf-39bc-350a-9623-0f8c49c597c1",
                        "glosses": [
                            "Avec assurance, autorité, constance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b04a569d-0c54-4f95-892b-57ba49aeb766",
                                "sense_id": "a0c5255c-a7a8-3c95-b554-3e6b55958047",
                                "text": "Parler fermement."
                            },
                            {
                                "example_id": "821cb87a-dcea-4562-a7be-785e16c81e84",
                                "sense_id": "a0c5255c-a7a8-3c95-b554-3e6b55958047",
                                "text": "Persister fermement dans sa résolution, dans son opinion."
                            },
                            {
                                "example_id": "808bef7b-5480-4dd9-a0da-1f98d64c0fb0",
                                "sense_id": "a0c5255c-a7a8-3c95-b554-3e6b55958047",
                                "text": "Croire fermement une chose."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bbd53ce-0247-43df-8fe0-b433f7c8859d",
                        "source_entry_id": "0f56a4bf-39bc-350a-9623-0f8c49c597c1",
                        "source_sense_id": "c3b8e61b-9efd-3fa9-9314-285f7a82a078",
                        "source_sense_description": "Avec vigueur",
                        "target_lang_word": "firmly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "firmly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01838417-3af3-3d3e-ad25-c74b00daaee7",
                                        "entry_id": "3d498b6a-e625-3f28-9a67-b90a04e8ae52",
                                        "glosses": [
                                            "In a firm or definite or strong manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28e91e9d-304a-4fbf-88fe-0acefd77e1cf",
                                                "sense_id": "01838417-3af3-3d3e-ad25-c74b00daaee7",
                                                "text": "She corrected him firmly but gently."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                        "entry_id": "3d498b6a-e625-3f28-9a67-b90a04e8ae52",
                                        "glosses": [
                                            "Securely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46849664-bfc4-4be4-af8f-602b744cba26",
                                                "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                                "text": "Tie the rope firmly to the post."
                                            },
                                            {
                                                "example_id": "b40f2ecb-4ba9-4b6d-9282-c0a0ae1b9d40",
                                                "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            },
                                            {
                                                "example_id": "9b1f9270-ea84-438c-987f-e614989333a1",
                                                "sense_id": "ba197f15-40e4-3490-a11b-908b5f1309d8",
                                                "text": "Dotcom mania was slow in coming to higher education, but now it has the venerable industry firmly in its grip. Since the launch early last year of Udacity and Coursera, two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f22b492f-6798-37ad-bb54-df9f0890975f",
                                        "entry_id": "3d498b6a-e625-3f28-9a67-b90a04e8ae52",
                                        "glosses": [
                                            "Definitively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "929ac0a1-6140-4b1c-b26b-a42debd1d9c4",
                                                "sense_id": "f22b492f-6798-37ad-bb54-df9f0890975f",
                                                "text": "This was widely interpreted to mean that slavery was once more firmly illegal in England."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93faa704-b2a1-49c4-8e6a-41de46ee3b67",
                        "source_entry_id": "0f56a4bf-39bc-350a-9623-0f8c49c597c1",
                        "source_sense_id": "c3b8e61b-9efd-3fa9-9314-285f7a82a078",
                        "source_sense_description": "Avec vigueur",
                        "target_lang_word": "forcibly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forcibly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a97a0e63-0d6c-3162-a072-24ad87312387",
                                        "entry_id": "4c8de312-391b-3753-9411-fbe961eb997e",
                                        "glosses": [
                                            "In a forcible manner, by force, against one's will."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2cbd237-300c-481c-8f90-5e8d326d022b",
                                                "sense_id": "a97a0e63-0d6c-3162-a072-24ad87312387",
                                                "text": "And suddenly; where injury of chance / Puts back leave-taking, justles roughly by / All time of pause, rudely beguiles our lips / Of all rejoindure, forcibly prevents / Our lock'd embrasures […]"
                                            },
                                            {
                                                "example_id": "4f7a22bc-afce-43f4-a4ba-b9147f928fe2",
                                                "sense_id": "a97a0e63-0d6c-3162-a072-24ad87312387",
                                                "text": "“Now get out of here,” and he grabbed Rokoff and Paulvitch each by the scruff of the neck and thrust them forcibly through the doorway, giving each an added impetus down the corridor with the toe of his boot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb3b4d1a-9312-38ea-a7b5-faa544d54f9f",
                                        "entry_id": "4c8de312-391b-3753-9411-fbe961eb997e",
                                        "glosses": [
                                            "In a forcible manner, with force, with powerful effect, powerfully, strongly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1152af4e-1bc5-4baf-9a3d-7e1a1e9a58f9",
                                                "sense_id": "eb3b4d1a-9312-38ea-a7b5-faa544d54f9f",
                                                "text": "It was now cold, winter weather: forcibly recalling to his mind under what circumstances he had first travelled that road, and how many vicissitudes and changes he had since undergone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b278e47c-ee85-418f-8e41-b4d316fe515e",
                        "source_entry_id": "0f56a4bf-39bc-350a-9623-0f8c49c597c1",
