                            {
                                "example_id": "f08d314b-e241-42c3-9f6a-14e061787aed",
                                "sense_id": "181c5f33-4f9e-38b9-b350-701921865029",
                                "text": "„Apertur oder Öffnungsweite einer Optik oder einer Antenne bezeichnet die freie Öffnung oder deren Durchmesser, durch welche die Lichtstrahlen oder Radiowellen ausgesendet oder empfangen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c6913b83-3d56-3baf-b056-de8de3d5b718",
                        "entry_id": "ecc569ec-5720-3e1b-93eb-ba4ca757931e",
                        "glosses": [
