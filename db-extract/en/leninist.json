                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edd30eaa-44f9-4308-8758-cad7f28878b2",
                        "source_entry_id": "f336f226-ac4f-3974-8129-815a3848703e",
                        "source_sense_id": "cccc53bb-a050-33ae-bf5b-17bb5c631206",
                        "source_sense_description": "an adherent of Lenin or Leninism",
                        "target_lang_word": "leninist",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leninist",
