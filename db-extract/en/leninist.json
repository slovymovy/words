                                "target_senses": [
                                    {
                                        "sense_id": "f3620e38-df17-3dab-9f34-4abd197a4dee",
                                        "entry_id": "df884197-0526-3a50-8d62-17fb27e8839d",
                                        "glosses": [
                                            "aanhanger van de leer van Lenin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2976e6f0-8f1b-4001-9138-5b591e36407c",
                                                "sense_id": "f3620e38-df17-3dab-9f34-4abd197a4dee",
                                                "text": "Maar Gorbatsjov kon de door hem in het leven geroepen krachten niet beheersen en ging eraan te gronde. Hij wilde een revitalisering van het socialisme, hij bleef tot zijn laatste politieke snik ook een leninist."
                                            },
                                            {
                                                "example_id": "7e45bd41-35ff-4216-b124-0b12fef9ca39",
                                                "sense_id": "f3620e38-df17-3dab-9f34-4abd197a4dee",
                                                "text": "Bannon heeft zichzelf omschreven als een leninist. \"Lenin wilde de staat vernietigen en dat wil ik ook. Ik wil dat alles in elkaar stort, ik wil het huidige establishment vernietigen.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
