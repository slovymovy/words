        "fr-extract.jsonl": [
            {
                "entry_id": "a18c866b-9211-38d8-8b68-b118e94f05c3",
                "word": "dextérité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a7c39801-de9f-464d-b80b-d719bb1785a3",
                        "entry_id": "a18c866b-9211-38d8-8b68-b118e94f05c3",
                        "tags": [
                            "plural"
                        ],
                        "form": "dextérités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a8df8f4-bb82-33a5-ac27-ec55cc12587a",
                        "entry_id": "a18c866b-9211-38d8-8b68-b118e94f05c3",
                        "glosses": [
                            "Adresse de la main."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "744012c0-5623-4fe9-8646-8a653d1ac7bd",
                                "sense_id": "6a8df8f4-bb82-33a5-ac27-ec55cc12587a",
                                "text": "Les filous à Paris sont d'une dextérité sans égale, mais ils emploient leur adresse à vider les poches et non pas à les emplir."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ab663aa-d031-3b61-a542-0fa278fdcbc2",
                        "entry_id": "a18c866b-9211-38d8-8b68-b118e94f05c3",
                        "glosses": [
                            "Habileté, adresse et précision des mouvements manuels dans l’accomplissement d'une tâche."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2a3dd524-8308-43b3-a2f4-d578af5d8ce9",
                                "sense_id": "4ab663aa-d031-3b61-a542-0fa278fdcbc2",
                                "text": "Cette manœuvre hardie fut exécutée avec une dextérité si grande que les chasseurs, bons connaisseurs en équitation, réprimèrent difficilement un cri d’admiration."
                            },
                            {
                                "example_id": "41ccc550-4fec-4dd8-bd9b-3db56d1ae6fb",
                                "sense_id": "4ab663aa-d031-3b61-a542-0fa278fdcbc2",
                                "text": "Le prolétariat de Thiers, très fermé, vivant en quelque sorte en vase clos, constitue d'ailleurs un monde d'exception doué corporativement, croirait-on, de certaines dextérités manuelles transmises par ses ancêtres."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ee81fd7-b2d2-3c03-85b8-4f5ab022bc19",
                        "entry_id": "a18c866b-9211-38d8-8b68-b118e94f05c3",
                        "glosses": [
                            "Adresse de l’esprit."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "725f9029-6c50-4227-ad44-0ec48f47497c",
                                "sense_id": "5ee81fd7-b2d2-3c03-85b8-4f5ab022bc19",
                                "text": "Avoir de la dextérité à manier les affaires. Il a conduit cette intrigue avec beaucoup de dextérité."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b7f74db-99de-3dc4-92cc-cd8e2fc249cd",
                        "entry_id": "a18c866b-9211-38d8-8b68-b118e94f05c3",
                        "glosses": [
                            "À Donjons & Dragons, et d’autres jeux de rôle, caractéristique (valeur chiffrée) représentant la maîtrise des mouvements d’un personnage, sa capacité à garder son équilibre, sa motricité fine."
                        ],
                        "tags": [
                            "Jeux de rôle"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "feb297f0-9d93-4504-b6f0-1908d9c898be",
                        "source_entry_id": "a18c866b-9211-38d8-8b68-b118e94f05c3",
                        "target_lang_word": "Fingerfertigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fingerfertigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                        "entry_id": "a17a9036-bc9a-3e46-8a03-5f8c4aee7aeb",
                                        "glosses": [
                                            "(besondere) Geschicklichkeit, (schwierige) Arbeiten mit den Fingern und Händen machen zu können; sie ist relevant bei motorisch anspruchsvollen Aufgaben, wie Spielen eines Instruments oder Nähen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfc86b74-f00d-424e-bb27-4d07938f8fb1",
                                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                                "text": "„Um den traditionellen Hutschmuck herzustellen, benötigen die Binder viel Zeit und Fingerfertigkeit.“"
                                            },
                                            {
                                                "example_id": "7a63b9f8-e93b-42a9-afb3-1c82a2ca16d2",
                                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                                "text": "Taschendiebe verfügen über die Fähigkeit, jemanden abzulenken und meist über eine besondere Fingerfertigkeit."
                                            },
                                            {
                                                "example_id": "5693e529-db77-46a9-8b1e-e0262846bc41",
                                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                                "text": "„Michael demonstriert Briar seine Fingerfertigkeit und gelangt dabei auch an ein Messer, das ihm die Flucht ermöglicht.“"
                                            },
                                            {
                                                "example_id": "e0a72470-f618-4d7c-b6db-6f5f7698dde6",
                                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                                "text": "„Aufgrund ihrer Fingerfertigkeit schmückte sie Hüte und Hauben mit Federn, Blumen und Vögeln.“"
                                            },
                                            {
                                                "example_id": "4e4f242e-b306-4e12-8e7f-5e1082c978dc",
                                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                                "text": "„Um eine Tür ohne Beschädigung zu öffnen, benötigt man neben dem passenden Werkzeug auch Fingerfertigkeit und Übung.“"
                                            },
                                            {
                                                "example_id": "4190e9d4-1994-4b8b-b6df-b1a637338467",
                                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                                "text": "Die Fingerfertigkeit des Gitarristen erlaubte ihm, komplizierte Soli mühelos zu spielen."
                                            },
                                            {
                                                "example_id": "05b31ebb-f3a5-49b6-b557-932f4dfd12cc",
                                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                                "text": "[Über den amerikanischen Pianisten Art Tatum:] „Seine Fingerfertigkeit trainierte er ständig, indem er eine Haselnuss schnell durch seine Finger gleiten ließ, bis sie glänzend und glatt wurde.“"
                                            },
                                            {
                                                "example_id": "fdea327b-c8af-4618-9715-1bb8175a2c3f",
                                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                                "text": "[Niccolò Paganini] „spielte hinreißend Geige, war ein Faszinosum allein durch seine Fingerfertigkeit, für die er offenbar nicht üben musste,“ […]."
                                            },
                                            {
                                                "example_id": "802107cb-773a-40fa-bfa1-218f63033b6c",
                                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                                "text": "[Über Etüden:] „Im Verlauf der Zeit entfernte sich diese Musikform von ihrem ursprünglichen Sinn, dem Erlangen einer größeren Fingerfertigkeit.“"
                                            },
                                            {
                                                "example_id": "bdab58b5-9030-4d23-ac22-c10a317e297e",
                                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                                "text": "„Hinter der eleganten Leichtigkeit des Konzerts verstecken sich nämlich hochanspruchsvolle Passagen, die dem Solisten einiges an Fingerfertigkeit abverlangen.“"
                                            },
                                            {
                                                "example_id": "012165c2-950d-4271-ae65-fc0ad4aa3bed",
                                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                                "text": "„»Es kommt auch auf die musikalische Flexibilität und das Einfühlungsvermögen an«, so Otto, »nicht nur auf die Fingerfertigkeit.«“"
                                            },
                                            {
                                                "example_id": "7714f4d5-2a2b-4dc6-b67d-3b52939aea7b",
                                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                                "text": "[Die türkischen Gastarbeiterinnen] „schliefen in Wohnheimen, arbeiteten häufig hart im Drei-Schicht-Betrieb in Elektro-, Konserven- oder Fischfabriken. Ihre Fingerfertigkeit und ihre Ausdauer waren sehr gefragt.“"
                                            },
                                            {
                                                "example_id": "a909120a-b8dc-4887-849d-26e47e2aa643",
                                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                                "text": "[Kräuterkissen:] „Mit ein bisschen Fingerfertigkeit lassen sich wunderschöne duftende Kissen selbst nähen.“"
                                            },
                                            {
                                                "example_id": "bf3c6dd2-43b3-4cda-bf65-b6676aa42fbe",
                                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                                "text": "„Neben der herkömmlichen Funktion als Schreibgerät werden Stifte beim Penspinning auch zum Training der Fingerfertigkeit benutzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96509a4d-6e71-4338-a9e9-f421f5d2f81a",
                        "source_entry_id": "a18c866b-9211-38d8-8b68-b118e94f05c3",
                        "target_lang_word": "Geschicklichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschicklichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c20fa53-fb1b-350e-b7a1-96e85f12c8c9",
                                        "entry_id": "42a5585e-4bdf-3fa7-a9ca-6c076e50d92e",
                                        "glosses": [
                                            "die Fähigkeit, eine Sache schnell und ohne großen Aufwand zu erledigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2b5ce98-19fb-42e7-82d3-8e9bba12791f",
                                                "sense_id": "4c20fa53-fb1b-350e-b7a1-96e85f12c8c9",
                                                "text": "Ständig den Hammer fallen zu lassen, zeugt nicht von hoher Geschicklichkeit."
                                            },
                                            {
                                                "example_id": "c18ca3f7-1469-432d-805c-bd6a560a272b",
                                                "sense_id": "4c20fa53-fb1b-350e-b7a1-96e85f12c8c9",
                                                "text": "„Eines Tages sah Mr. Marchinton mich fast ganz oben am Flaggenknopf des Großmastes, und nachdem er mir befohlen hatte, herunterzukommen, erhielt ich für meine Geschicklichkeit und Unternehmungslust eine ordentliche Tracht Prügel.“"
                                            },
                                            {
                                                "example_id": "426c0ad9-d23e-4545-a242-3402c97a0e66",
                                                "sense_id": "4c20fa53-fb1b-350e-b7a1-96e85f12c8c9",
                                                "text": "„Der Gleitschirmflieger benötigt Geschicklichkeit für das Aufziehen seines Segels, Sensibilität für das Schirmverhalten im Fluge und die Auf- und Abwindströmungen.“"
                                            },
                                            {
                                                "example_id": "4a00de79-14a1-4d1f-b7a2-cc0156ceac43",
                                                "sense_id": "4c20fa53-fb1b-350e-b7a1-96e85f12c8c9",
                                                "text": "„Von diesem Tage an war Natascha unentwegt um den verwundeten Bolkonskij, während der ganzen weiteren Fahrt der Rostows, immer, wenn halt gemacht oder ein Nachtquartier bezogen wurde, und der Arzt musste zugeben, dass er nie von einem jungen Mädchen so viel Energie und so viel Geschicklichkeit in der Krankenpflege erwartet hätte.“"
                                            },
                                            {
                                                "example_id": "38c8f3bd-331b-476e-b811-a1362a781b58",
                                                "sense_id": "4c20fa53-fb1b-350e-b7a1-96e85f12c8c9",
                                                "text": "„Er wollte dabei seine Geschicklichkeit proben und und die Zeit mit guter Manier hinter sich bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4005ed5b-bd18-4a9a-b8d0-23108a913311",
                        "source_entry_id": "a18c866b-9211-38d8-8b68-b118e94f05c3",
