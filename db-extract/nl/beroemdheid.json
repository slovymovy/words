                    {
                        "sense_id": "3106a93b-6041-3c44-b950-98ff377ebf36",
                        "entry_id": "aa1844fc-abc7-36fe-af80-7c1785576240",
                        "glosses": [
                            "iemand die bekend is bij een groot publiek, celebrity"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "838dad68-45ea-4bb6-bf15-d0e42b2a7bfa",
                                "sense_id": "3106a93b-6041-3c44-b950-98ff377ebf36",
                                "text": "Een beroemdheid in Nederland noemen we een BN'er en een beroemdheid in Vlaanderen is een BV'er."
                            },
                            {
                                "example_id": "e321e4f8-7c64-480a-94ac-004238041622",
                                "sense_id": "3106a93b-6041-3c44-b950-98ff377ebf36",
                                "text": "De beroemdheden komen nog altijd. Henriroux: 'Een paar dagen geleden hadden we Stevie Wonder nog, na zijn optreden op het jazzfestival van Vienne.'"
                            },
                            {
                                "example_id": "15c9f9a1-72f0-4003-aef0-6e1d7d17f3f2",
                                "sense_id": "3106a93b-6041-3c44-b950-98ff377ebf36",
                                "text": "'Heb je nog een beetje kunnen slapen zonder deze beroemdheid?' zeg ik grappend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b5a84a0-fb03-4e1e-bd0c-1f047fd7e8c4",
                        "source_entry_id": "aa1844fc-abc7-36fe-af80-7c1785576240",
                        "source_sense_id": "3106a93b-6041-3c44-b950-98ff377ebf36",
                        "source_sense_description": "iemand die bekend is bij een groot publiek",
                        "target_lang_word": "Zelebrität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zelebrität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dcb9f700-e042-3ae0-b197-3780689f9b8d",
                                        "entry_id": "a539d299-76b3-3403-8752-86994473b3f3",
                                        "glosses": [
                                            "berühmte Person; Berühmtheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9543baa6-4b0c-4aff-8576-e80f58c209e6",
                                                "sense_id": "dcb9f700-e042-3ae0-b197-3780689f9b8d",
                                                "text": "„In ihrem [Katharina Bagration] Haus in der Rue St. Honoré führte sie einen erfolgreichen Literarischen Salon, der von den literarischen und politischen Zelebritäten besucht wurde.“"
                                            },
                                            {
                                                "example_id": "41192a31-4538-40bb-a0b4-56fe6ac68426",
                                                "sense_id": "dcb9f700-e042-3ae0-b197-3780689f9b8d",
                                                "text": "„Auch Pückler hat während seiner ersten größeren Reise bei einer ganzen Reihe von Zelebritäten angeklopft.“"
                                            },
                                            {
                                                "example_id": "ef3b6411-df89-444f-8c6e-001317960605",
                                                "sense_id": "dcb9f700-e042-3ae0-b197-3780689f9b8d",
                                                "text": "„Er sprach über Zelebritäten, denen er in seinem langen Leben begegnet war.“"
                                            },
                                            {
                                                "example_id": "c698a26f-80cc-4ffb-9e1f-0b88910dd3c6",
                                                "sense_id": "dcb9f700-e042-3ae0-b197-3780689f9b8d",
                                                "text": "„So kam es, dass Wallace zu einer indirekt beleuchteten Zelebrität wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8125c086-82d7-3786-af18-3cf887233af4",
                                        "entry_id": "a539d299-76b3-3403-8752-86994473b3f3",
