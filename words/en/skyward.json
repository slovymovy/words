{
    "word_family": [
        "sky"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "6b82aa3b-2fa1-329b-9724-e8088cacf3eb",
                    "sense_definition": "In the direction of the sky.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rocket shot <w>skyward</w> and exploded in a burst of glittering stars.",
                            "target_lang_translations": {
                                "cs": "Raketa vystřelila <w>k obloze</w> a explodovala v záři třpytivých hvězd.",
                                "it": "Il razzo è schizzato <w>verso il cielo</w> ed è esploso in un'esplosione di stelle scintillanti."
                            }
                        },
                        {
                            "text": "Gaze <w>skyward</w> to appreciate this rare triple feature of the brightest planets.",
                            "target_lang_translations": {
                                "cs": "Pohleďte <w>vzhůru</w>, abyste ocenili tento vzácný úkaz tří nejjasnějších planet.",
                                "it": "Guardate <w>verso il cielo</w> per ammirare questo raro allineamento dei pianeti più luminosi."
                            }
                        }
                    ],
                    "synonyms": [
                        "upwards"
                    ],
                    "antonyms": [
                        "downwards"
                    ],
                    "target_lang_definitions": {
                        "cs": "Směrem k obloze nebo vzhůru.",
                        "it": "Verso il cielo; in direzione del cielo o verso l'alto."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "k obloze",
                                "target_lang_sense_clarification": "vyjadřuje směr pohybu nebo pohledu vzhůru"
                            },
                            {
                                "target_lang_word": "vzhůru",
                                "target_lang_sense_clarification": "obecnější vyjádření směru nahoru"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "verso il cielo",
                                "target_lang_sense_clarification": "moto o direzione verso l'alto"
                            },
                            {
                                "target_lang_word": "verso l'alto",
                                "target_lang_sense_clarification": "in su"
                            },
                            {
                                "target_lang_word": "al cielo",
                                "target_lang_sense_clarification": "riferito allo sguardo o a un movimento"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e8a9da70-6728-36f9-a7cb-e9f544847ca5",
                    "sense_definition": "Directed or moving toward the sky.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers noticed a <w>skyward</w> movement of the birds before the storm.",
                            "target_lang_translations": {
                                "cs": "Turisté si před bouřkou všimli pohybu ptáků <w>směřujícího k obloze</w>.",
                                "it": "Gli escursionisti notarono un movimento <w>verso l'alto</w> degli uccelli prima della tempesta."
                            }
                        },
                        {
                            "text": "She made a <w>skyward</w> gesture to point out the passing airplane.",
                            "target_lang_translations": {
                                "cs": "Udělala gesto <w>směrem k obloze</w>, aby ukázala na prolétající letadlo.",
                                "it": "Fece un gesto <w>rivolto al cielo</w> per indicare l'aereo che passava."
                            }
                        }
                    ],
                    "synonyms": [
                        "upward"
                    ],
                    "antonyms": [
                        "downward"
                    ],
                    "target_lang_definitions": {
                        "cs": "Směřující k obloze nebo pohybující se směrem k ní.",
                        "it": "Rivolto o diretto verso il cielo o verso l'alto."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "směřující k obloze",
                                "target_lang_sense_clarification": "popisuje orientaci nebo směr pohybu"
                            },
                            {
                                "target_lang_word": "vzhůru směřující",
                                "target_lang_sense_clarification": "formálnější vyjádření směru nahoru"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "rivolto al cielo",
                                "target_lang_sense_clarification": "orientato in alto"
                            },
                            {
                                "target_lang_word": "diretto verso il cielo",
                                "target_lang_sense_clarification": "che va verso l'alto"
                            },
                            {
                                "target_lang_word": "verso l'alto",
                                "target_lang_sense_clarification": "orientato verso l'alto"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}