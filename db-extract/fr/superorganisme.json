                    {
                        "translation_id": "1dfe1f9e-c261-4ebe-a2f2-349cd0ee26e0",
                        "source_entry_id": "942fc869-e05a-3e1e-853b-961c4b249bcf",
                        "target_lang_word": "superorganism",
