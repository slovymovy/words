                    "sense_id": "8d8eb258-5389-3a5a-88d5-fb59ec846c54",
                    "sense_definition": "met de intentie om kwaad te doen of schade aan te richten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kwaadwillend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>boosaardige</w> crimineel kon gelukkig snel door de politie worden ingerekend.",
                            "target_lang_translations": {
                                "en": "Fortunately, the <w>vicious</w> criminal was quickly apprehended by the police.",
                                "fr": "Heureusement, le <w>malveillant</w> criminel a rapidement pu être appréhendé par la police."
                            }
                        },
                        {
                            "text": "Zijn gezicht kreeg plotseling een <w>boosaardige</w> blik toen hij het slechte nieuws hoorde.",
                            "target_lang_translations": {
                                "en": "His face suddenly took on a <w>malicious</w> look when he heard the bad news.",
                                "fr": "Son visage a soudainement pris un regard <w>méchant</w> lorsqu'il a appris la mauvaise nouvelle."
                            }
