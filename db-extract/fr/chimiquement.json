                        "sense_id": "dc3a2fc8-5617-365e-af30-a3923e9885b4",
                        "entry_id": "c9a0f014-7423-35e6-a986-2a12b7f5674c",
                        "glosses": [
                            "D’après les lois de la chimie ; d’une manière chimique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2adecfed-5725-4df5-a076-d19d4159ce00",
                                "sense_id": "dc3a2fc8-5617-365e-af30-a3923e9885b4",
                                "text": "C’est un produit composite, chimiquement mal défini, et les détails de sa formation sont encore imparfaitement connus."
                            },
                            {
                                "example_id": "6310ca22-00eb-4ad7-9bea-22dffb60472e",
                                "sense_id": "dc3a2fc8-5617-365e-af30-a3923e9885b4",
                                "text": "Roberto Saviano pour Crie-le !, Irène Frachon pour Mediator, un crime chimiquement pur, Richard Malka pour Traité sur l’intolérance, Pauline Hillier pour Les Contemplées."
                            },
                            {
                                "example_id": "900cbbfb-c53c-4034-bdf9-208a5a73e815",
                                "sense_id": "dc3a2fc8-5617-365e-af30-a3923e9885b4",
                                "text": "Outre le GHB, de nombreuses substances sont utilisées pour soumettre chimiquement une personne."
                            }
                        ]
