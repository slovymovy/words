{
    "word_family": [
        "quintuple",
        "quintuplet"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4a411fc-ab8d-3d50-826b-ebde0b2b3eac",
                    "sense_definition": "A musical group or ensemble consisting of five musicians or singers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jazz <w>quintet</w> entertained the guests with smooth melodies all evening.",
                            "target_lang_translations": {
                                "zh": "那支爵士<w>五重奏乐团</w>整晚都用悠扬的旋律招待宾客。"
                            }
                        },
                        {
                            "text": "A brass <w>quintet</w> performed several classical pieces during the graduation ceremony.",
                            "target_lang_translations": {
                                "zh": "一支铜管<w>五重奏组</w>在毕业典礼上演奏了几首古典乐曲。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "brass quintet",
                        "string quintet",
                        "jazz quintet"
                    ],
                    "target_lang_definitions": {
                        "zh": "由五名乐手或歌手组成的五重奏乐团或五重唱组合。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "五重奏乐团",
                                "target_lang_sense_clarification": "五名乐手组成的器乐演奏组"
                            },
                            {
                                "target_lang_word": "五重唱组合",
                                "target_lang_sense_clarification": "五名歌手组成的声乐演唱组"
                            },
                            {
                                "target_lang_word": "五重奏组",
                                "target_lang_sense_clarification": "器乐五人组合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19361c40-2b38-32af-bb66-04e9a00b7a26",
                    "sense_definition": "Any group, set, or team consisting of five people or things.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The starting <w>quintet</w> took the basketball court just before the buzzer sounded.",
                            "target_lang_translations": {
                                "zh": "就在鸣笛声响起前，首发<w>五人阵容</w>步入了篮球场。"
                            }
                        },
                        {
                            "text": "This <w>quintet</w> of researchers made a breakthrough discovery in renewable energy.",
                            "target_lang_translations": {
                                "zh": "这个由五人组成的研究<w>五人组</w>在可再生能源领域取得了突破性发现。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fivesome",
                        "pentad"
                    ],
                    "common_phrases": [
                        "starting quintet"
                    ],
                    "target_lang_definitions": {
                        "zh": "由五个人或五件事物组成的小组、团队或一组事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "五人组",
                                "target_lang_sense_clarification": "由五人组成的集体或小组"
                            },
                            {
                                "target_lang_word": "五人阵容",
                                "target_lang_sense_clarification": "体育等活动中的五名队员组合"
                            },
                            {
                                "target_lang_word": "五件套",
                                "target_lang_sense_clarification": "由五件物品组成的成套事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04aa595a-7998-30d7-b703-a235bd28394f",
                    "sense_definition": "A musical composition written for five voices or five instruments.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer wrote a piano <w>quintet</w> that received critical acclaim.",
                            "target_lang_translations": {
                                "zh": "这位作曲家创作了一首深受好评的钢琴<w>五重奏</w>。"
                            }
                        },
                        {
                            "text": "They rehearsed the challenging <w>quintet</w> for weeks before their public recital.",
                            "target_lang_translations": {
                                "zh": "在公开独奏音乐会开始前，他们排练了数周那首极具挑战性的<w>五重奏曲</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "piano quintet"
                    ],
                    "target_lang_definitions": {
                        "zh": "为五件乐器或五个声部创作的五重奏曲或五重唱曲。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "五重奏",
                                "target_lang_sense_clarification": "器乐乐曲"
                            },
                            {
                                "target_lang_word": "五重唱",
                                "target_lang_sense_clarification": "声乐乐曲"
                            },
                            {
                                "target_lang_word": "五重奏曲",
                                "target_lang_sense_clarification": "完整的五重奏器乐作品"
                            }
                        ]
                    }
                }
            ]
        }
    ]
