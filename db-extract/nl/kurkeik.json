                    {
                        "translation_id": "41284151-b2e3-43ca-92ef-6539143b9588",
                        "source_entry_id": "c9198531-7321-3d37-bbf2-4a9711875e4a",
                        "source_sense_id": "8453492f-7cec-3f75-9a73-e18dae8d7a5a",
                        "source_sense_description": "Quercus suber; een boom uit de napjesdragersfamilie",
                        "target_lang_word": "chêne-liège",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chêne-liège",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e16c7fb3-cfde-3547-a8e4-761ce4d7f9b6",
                                        "entry_id": "291e82e8-5c27-3d9c-8906-1ebecc98e407",
                                        "glosses": [
                                            "Nom usuel de Quercus suber, arbre de la famille des Fagaceae à feuillage persistant originaire du pourtour méditerranéen occidental et exploité pour son écorce qui fournit le liège."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16c6b4ec-6446-402a-84f2-1761d88cfda1",
                                                "sense_id": "e16c7fb3-cfde-3547-a8e4-761ce4d7f9b6",
                                                "text": "Ils se dressèrent comme deux fantômes le long d’un énorme chêne-liège, […] et embrassant le tronc noueux de l’arbre, ils se cachèrent dans ses branches touffues."
                                            },
                                            {
                                                "example_id": "3b0d5e54-5a57-47f2-87cd-0ace79296cb8",
                                                "sense_id": "e16c7fb3-cfde-3547-a8e4-761ce4d7f9b6",
                                                "text": "Cette voie littorale, bénéficiant d'un climat océanique chaud et humide, paraît surtout convenir aux espèces méditerranéennes « hygrophiles », Chêne vert, Chêne-liège, Arbousier, Laurier, Filaire, etc., c'est-à-dire à la flore laurifoliée.— (Bulletin de la Société d'histoire naturelle de Toulouse, Volume 100, 1965, p.14)"
                                            },
                                            {
                                                "example_id": "7944efa9-6628-450d-b9c1-2cbcb6e15eeb",
                                                "sense_id": "e16c7fb3-cfde-3547-a8e4-761ce4d7f9b6",
                                                "text": "Le chêne-liège est une essence forestière rare à l’échelle mondiale puisque cantonnée au Maghreb, à la Péninsule ibérique ainsi qu’à l’Italie et la France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
