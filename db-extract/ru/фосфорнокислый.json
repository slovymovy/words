                    },
                    {
                        "translation_id": "109bc723-b320-44da-99c9-84f9b15baee7",
                        "source_entry_id": "4aae8fb8-2f00-321c-a984-43c202506d00",
                        "source_sense_id": "c5722671-e67e-3d9e-b331-d64d2afa2f86",
                        "target_lang_word": "phosphaté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phosphaté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ddeda851-2b6b-3cde-bdb3-b8e127e3d892",
                                        "entry_id": "0bca53d9-78e3-3e76-a9ee-615878805c44",
                                        "glosses": [
                                            "Qui contient du phosphate ; qui tient du phosphate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1b6e0b7-200d-4120-9432-3f3217f169a5",
                                                "sense_id": "ddeda851-2b6b-3cde-bdb3-b8e127e3d892",
                                                "text": "Ce gravier se compose de galets de calcaire, de gaize, de roche siliceuse oxfordienne, de nodules phosphatés, etc. ; on l'observe surtout près de Provizy, où il forme une couche de 0 m. 80 sur la marne."
                                            },
                                            {
                                                "example_id": "291a1af8-512e-4da0-85ac-ac05616adff8",
                                                "sense_id": "ddeda851-2b6b-3cde-bdb3-b8e127e3d892",
                                                "text": "Les phosphates arénacés, ou sables phosphatés, se rencontrent dans des poches à la partie supérieure de la craie à bélemnites, sur la limite des départements de la Somme et du Pas-de-Calais."
                                            },
                                            {
                                                "example_id": "8359263d-65a6-4e4b-8ed0-90429695b451",
                                                "sense_id": "ddeda851-2b6b-3cde-bdb3-b8e127e3d892",
                                                "text": "« Les engrais phosphatés utilisés en agriculture conventionnelle contiennent du cadmium. C’est le cas notamment de ceux provenant du Maroc, qui en sont riches tout en respectant les normes, et qui sont particulièrement utilisés en France», souligne-t-il."
                                            },
                                            {
                                                "example_id": "5e816ffd-0918-42ee-ad33-0c23a8e4ed7e",
                                                "sense_id": "ddeda851-2b6b-3cde-bdb3-b8e127e3d892",
                                                "text": "Prismatique et cylindroïde, gris-bleuâtre, cristaux entièrement recouverts de plomb phosphaté brun mamelonné ; Poullaouen, département des Côtes-du-Nord."
                                            }
                                        ]
                                    }
                                ]
                            },
