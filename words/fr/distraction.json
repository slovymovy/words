    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "39b8cf89-fc6f-326a-88dd-20360e2932df",
                    "sense_definition": "Manque d'attention ou de concentration envers ce dont on devrait s'occuper.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un court moment de <w>distraction</w> au volant peut provoquer un grave accident.",
                            "target_lang_translations": {
                                "en": "A brief moment of <w>inattention</w> while driving can cause a serious accident.",
                                "ru": "Короткий момент <w>невнимательности</w> за рулём может привести к серьёзной аварии.",
                                "de": "Ein kurzer Moment der <w>Unaufmerksamkeit</w> am Steuer kann einen schweren Unfall verursachen.",
                                "es": "Un breve momento de <w>distracción</w> al volante puede provocar un grave accidente.",
                                "zh": "开车时片刻的<w>分心</w>就可能引发严重事故。"
                            }
                        },
                        {
                            "text": "Il a oublié son parapluie dans le train par pure <w>distraction</w> ce matin.",
                            "target_lang_translations": {
                                "en": "He forgot his umbrella on the train out of pure <w>absent-mindedness</w> this morning.",
                                "ru": "Сегодня утром он по чистой <w>рассеянности</w> забыл зонт в поезде.",
                                "de": "Er hat heute Morgen seinen Regenschirm aus purer <w>Zerstreutheit</w> im Zug vergessen.",
                                "es": "Esta mañana olvidó su paraguas en el tren por pura <w>distracción</w>.",
                                "zh": "他今天早上纯粹是一时<w>分心</w>，把伞忘在了火车上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inattention"
                    ],
                    "antonyms": [
                        "attention",
                        "concentration"
                    ],
                    "common_phrases": [
                        "par distraction",
                        "moment de distraction",
                        "source de distraction"
                    ],
                    "target_lang_definitions": {
                        "en": "A lack of attention or concentration on something that needs to be dealt with.",
                        "ru": "Недостаток внимания или сосредоточенности на том, чем нужно заниматься.",
                        "de": "Mangel an Aufmerksamkeit oder Konzentration bei Dingen, um die man sich kümmern müsste.",
                        "es": "Falta de atención o concentración en algo que requiere cuidado.",
                        "zh": "注意力不集中，没有专心于应该处理的事情。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inattention",
                                "target_lang_sense_clarification": "lack of focus on tasks"
                            },
                            {
