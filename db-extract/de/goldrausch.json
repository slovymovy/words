                ],
                "senses": [
                    {
                        "sense_id": "ec96df7c-a16a-3803-97b7-090ef028e593",
                        "entry_id": "221ccdc8-ee71-3463-b6b7-a0dc83f027e7",
                        "glosses": [
                            "eine Zeit, in der viele Menschen an einen Ort ziehen, um dort nach Gold zu suchen, meist in gegenseitiger Konkurrenz und mit großer Gier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a012ede-bf60-41ae-a13b-841f6e554936",
                                "sense_id": "ec96df7c-a16a-3803-97b7-090ef028e593",
                                "text": "Der Wilde Westen zeichnete sich unter anderem durch den Goldrausch aus."
                            },
                            {
                                "example_id": "5d8f4233-5791-40b2-b618-ad3079335db5",
                                "sense_id": "ec96df7c-a16a-3803-97b7-090ef028e593",
                                "text": "„Der Goldrausch war ausgebrochen und zog ganze Karawanen an Planwagen in die Ferne der Sierra Nevada und nach Alaska.“"
                            },
                            {
                                "example_id": "a91a151f-a35b-4445-9136-d82dc22cdc0e",
                                "sense_id": "ec96df7c-a16a-3803-97b7-090ef028e593",
                                "text": "„Der Goldrausch am Lemmenjoki begann zwischen 1945 und 1950 mit zeitweise über 100 Claims.“"
                            },
                            {
                                "example_id": "0593cee0-7e75-41c3-8305-4b52e38a115a",
                                "sense_id": "ec96df7c-a16a-3803-97b7-090ef028e593",
                                "text": "„Überflutet wurden dafür die Flussniederungen des Chagres, des bis dato schnellsten Verkehrsweges durch Panama, hochfrequentiert besonders in der Mitte des 19. Jahrhunderts, als in Kalifornien der Goldrausch begann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0bb7776-3671-41dd-abf5-9b6eb7687c42",
                        "source_entry_id": "221ccdc8-ee71-3463-b6b7-a0dc83f027e7",
                        "source_sense_id": "ec96df7c-a16a-3803-97b7-090ef028e593",
                        "source_sense_description": "Zeit, in der viele Menschen an einen Ort ziehen, um dort nach Gold zu suchen",
                        "target_lang_word": "淘金潮",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1519b40c-a9bc-41a5-a892-10434613bdb7",
                        "source_entry_id": "221ccdc8-ee71-3463-b6b7-a0dc83f027e7",
                        "source_sense_id": "ec96df7c-a16a-3803-97b7-090ef028e593",
                        "source_sense_description": "Zeit, in der viele Menschen an einen Ort ziehen, um dort nach Gold zu suchen",
                        "target_lang_word": "gold rush",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gold rush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94f32f9b-770a-3124-9645-13502ed6c22f",
                                        "entry_id": "ba471d08-c804-3e95-85b7-95d884302fb9",
                                        "glosses": [
                                            "Any period of feverish migration into an area in which gold has been discovered."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2ea5d35-6339-4e46-abb6-e196fb527f76",
                                                "sense_id": "94f32f9b-770a-3124-9645-13502ed6c22f",
                                                "text": "Here Grey Beaver stopped. A whisper of the gold-rush had reached his ears, and he had come with several bales of furs, and another of gut-sewn mittens and moccasins. He would not have ventured so long a trip had he not expected generous profits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19227aee-735f-3cce-8974-bf44e2fe08c9",
                                        "entry_id": "ba471d08-c804-3e95-85b7-95d884302fb9",
                                        "glosses": [
                                            "A feverish obsession with seeking profits, especially in new markets."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65178bd8-6796-4297-981d-72ab7c19a18a",
                                                "sense_id": "19227aee-735f-3cce-8974-bf44e2fe08c9",
                                                "text": "That’s because I’ve decided to enter the freewheeling world of nonfungible tokens, or NFTs, the newest frontier in the cryptocurrency gold rush."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e2be861-48d7-3c6d-8500-b3a3223e4677",
                                        "entry_id": "ba471d08-c804-3e95-85b7-95d884302fb9",
                                        "glosses": [
                                            "A cocktail made from bourbon, honey, and lemon juice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15ec654c-281b-4150-98fe-3b311bf2c0c1",
                                                "sense_id": "2e2be861-48d7-3c6d-8500-b3a3223e4677",
                                                "text": "The Gold Rush is one of my favorite cocktails, invented at Sasha Petraske's famed Milk & Honey bar and now served all over the world. Basically a cold toddy, it's a shaken drink with bourbon, fresh lemon, and honey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89e5f7bc-b858-37bb-8834-8bd967c45f6a",
                                        "entry_id": "ba471d08-c804-3e95-85b7-95d884302fb9",
                                        "glosses": [
                                            "The urge to win gold medals, as in the Olympic Games."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
