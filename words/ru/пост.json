                    "common_phrases": [
                        "Великий пост",
                        "соблюдать пост",
                        "держать пост"
                    ],
                    "target_lang_definitions": {
                        "en": "A period of abstinence from certain foods and entertainment according to religious rules.",
                        "zh": "按照宗教规定，在一段时间内禁食某些食物并减少娱乐活动的时期。"
