                            "target_lang_translations": {
                                "ru": "У нас назначена встреча с мистером <w>Спирсом</w> завтра утром.",
                                "zh": "我们明天早上和<w>斯皮尔斯</w>先生有约。",
                                "es": "Tenemos una cita con el Sr. <w>Spears</w> mañana por la mañana."
                            }
                        },
                        {
                            "text": "The famous singer Britney <w>Spears</w> released a new album.",
                            "target_lang_translations": {
                                "ru": "Знаменитая певица Бритни <w>Спирс</w> выпустила новый альбом.",
                                "zh": "著名歌手布兰妮·<w>斯皮尔斯</w>发行了一张新专辑。",
                                "es": "La famosa cantante Britney <w>Spears</w> lanzó un nuevo álbum."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English"
                        }
