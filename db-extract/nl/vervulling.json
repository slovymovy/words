                "forms": [
                    {
                        "form_id": "c442450b-f7c4-496a-8615-a34fb3ecb867",
                        "entry_id": "e1c2ebe1-dd09-3919-b689-fa2acf4267ae",
                        "tags": [
                            "plural"
                        ],
                        "form": "vervullingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6f2adf9-dddc-35dc-b095-cfd163746a89",
                        "entry_id": "e1c2ebe1-dd09-3919-b689-fa2acf4267ae",
                        "glosses": [
                            "handeling of ontwikkeling waardoor een verwachting werkelijkheid wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c200d312-fbad-485b-948b-2f3749d1f8d8",
                                "sense_id": "d6f2adf9-dddc-35dc-b095-cfd163746a89",
                                "text": "Het is Poetins oorlog. De potentaat wordt geadviseerd door een claque van louter mannen en hij blijft in de oorlog opvallend populair in eigen land. Maar de inval is ook de vervulling van een persoonlijke missie. Rusland wordt er niet bepaald beter van."
                            },
                            {
                                "example_id": "6ce6ce27-a41a-422a-81d1-343c3b9352a6",
                                "sense_id": "d6f2adf9-dddc-35dc-b095-cfd163746a89",
                                "text": "Op de missie naar Mali gaan ook elf deeltijdmilitairen mee, reservisten. Wat beweegt hen? Voor sommigen is het een vervulling van een jongensdroom, anderen willen een completer mens worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "864d6658-df64-32f0-bcab-68e9572aba81",
                        "entry_id": "e1c2ebe1-dd09-3919-b689-fa2acf4267ae",
                        "glosses": [
                            "handeling of ontwikkeling waardoor een verwachting werkelijkheid wordt",
                            "benoeming van personen in een positie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d703250-09bc-4b06-bba8-d37ec523f413",
                                "sense_id": "864d6658-df64-32f0-bcab-68e9572aba81",
                                "text": "Het is Poetins oorlog. De potentaat wordt geadviseerd door een claque van louter mannen en hij blijft in de oorlog opvallend populair in eigen land. Maar de inval is ook de vervulling van een persoonlijke missie. Rusland wordt er niet bepaald beter van."
                            },
                            {
                                "example_id": "acf84675-36f8-497e-aeaf-e494e3267ce7",
                                "sense_id": "864d6658-df64-32f0-bcab-68e9572aba81",
                                "text": "Op de missie naar Mali gaan ook elf deeltijdmilitairen mee, reservisten. Wat beweegt hen? Voor sommigen is het een vervulling van een jongensdroom, anderen willen een completer mens worden."
                            },
                            {
                                "example_id": "9e26cd22-8898-4d4d-b9ed-c2e5239a00c2",
                                "sense_id": "864d6658-df64-32f0-bcab-68e9572aba81",
                                "text": "Een tijdige vervulling van de komende vacatures maakt het mogelijk dat een nieuw team goed ingewerkt de taken op zich kan nemen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9cace5f-7d8d-33a3-b719-17bd3edbc7a8",
                        "entry_id": "e1c2ebe1-dd09-3919-b689-fa2acf4267ae",
                        "glosses": [
                            "handeling of ontwikkeling waardoor een verwachting werkelijkheid wordt",
                            "uitoefening van een functie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4ba744f-6224-4a4f-846e-5f39ac9d97e7",
                                "sense_id": "e9cace5f-7d8d-33a3-b719-17bd3edbc7a8",
                                "text": "Het is Poetins oorlog. De potentaat wordt geadviseerd door een claque van louter mannen en hij blijft in de oorlog opvallend populair in eigen land. Maar de inval is ook de vervulling van een persoonlijke missie. Rusland wordt er niet bepaald beter van."
                            },
                            {
                                "example_id": "f00c50ee-852f-4f07-8cfd-e7878b10f183",
                                "sense_id": "e9cace5f-7d8d-33a3-b719-17bd3edbc7a8",
                                "text": "Op de missie naar Mali gaan ook elf deeltijdmilitairen mee, reservisten. Wat beweegt hen? Voor sommigen is het een vervulling van een jongensdroom, anderen willen een completer mens worden."
                            },
                            {
                                "example_id": "559646de-bbd2-4a8e-b319-abc2dcac73b2",
                                "sense_id": "e9cace5f-7d8d-33a3-b719-17bd3edbc7a8",
                                "text": "De vacante positie ontstaat eind 2022, omdat de voorzitter na vervulling van twee termijnen zal terugtreden."
                            },
                            {
                                "example_id": "539cd234-e3de-4e1b-9517-ba838bfca2d8",
                                "sense_id": "e9cace5f-7d8d-33a3-b719-17bd3edbc7a8",
                                "text": "De Autoriteit Persoonsgegevens noemt het handelen van de Belastingdienst „discriminerend” en „niet noodzakelijk voor de vervulling van een publieke taak”."
                            },
                            {
                                "example_id": "b124dfd9-515e-4c34-8954-9521784b6f75",
                                "sense_id": "e9cace5f-7d8d-33a3-b719-17bd3edbc7a8",
                                "text": "De toezichthouders richten zich bij de vervulling van hun taak naar het belang van de rechtspersoon en de daaraan verbonden organisatie."
                            }
                        ]
                    },
                    {
                        "sense_id": "23a7094a-6893-3c79-ad5f-796c9d5ba136",
                        "entry_id": "e1c2ebe1-dd09-3919-b689-fa2acf4267ae",
                        "glosses": [
                            "toestand die voldoet aan al de diepste verlangens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c5cd06e-ba88-464c-ada4-4341bc5c4937",
                                "sense_id": "23a7094a-6893-3c79-ad5f-796c9d5ba136",
                                "text": "Het huwelijk is immers allang niet meer de economische basiseenheid met de productie van kinderen als voornaamste oogmerk. Het moet ruimte bieden aan de ontplooiing van de beste vermogens van de echtelieden. Het moet hen troosten en koesteren, geluk en vervulling beloven – en dan ook nog eeuwige trouw."
                            },
                            {
                                "example_id": "57ea82f6-c071-430a-a540-4d852c7340ae",
                                "sense_id": "23a7094a-6893-3c79-ad5f-796c9d5ba136",
                                "text": "De moderne westerse mens verwacht alles wat hij vroeger uit verschillende levensdomeinen haalde nu uit twee dingen te halen: relatie en werk, zegt de Belgisch-Amerikaanse psychotherapeut Esther Perel in een interview naar aanleiding van haar podcast How’s work?. Vervulling, zingeving, erkenning, eigenwaarde: het zijn niet de minste zaken die we hopen te vinden in beide."
                            }
                        ]
                    }
                ],
