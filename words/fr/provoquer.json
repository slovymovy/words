{
    "word_family": [
        "provocation",
        "provocateur",
        "provocatrice",
        "provocant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "916cca6e-0408-361c-9f24-5b89691ee423",
                    "sense_definition": "Être la cause directe d'un événement, d'une réaction ou d'un phénomène.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "causer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La violente tempête d'hier a <w>provoqué</w> des coupures d'électricité dans toute la ville."
                        },
                        {
                            "text": "Ses propos maladroits risquent de <w>provoquer</w> un scandale lors de la réunion."
                        }
                    ],
                    "common_phrases": [
                        "provoquer un accident",
                        "provoquer une réaction",
                        "provoquer un scandale"
                    ]
                },
                {
                    "sense_id": "d00574aa-fc47-3108-9f4a-560546a4c824",
                    "sense_definition": "Pousser quelqu'un à s'énerver ou à réagir violemment par des insultes ou une attitude agressive.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "incitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il essaye constamment de me <w>provoquer</w>, mais je préfère garder mon calme."
                        },
                        {
                            "text": "Les supporters adverses ont commencé à <w>provoquer</w> les joueurs dès le début du match."
                        }
                    ],
                    "common_phrases": [
                        "chercher à provoquer"
                    ]
                },
                {
                    "sense_id": "c2a488ed-1078-3666-a7aa-f9d3b38c765b",
                    "sense_definition": "Chercher à susciter le désir amoureux ou sexuel chez autrui de façon audacieuse ou aguicheuse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "seduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle aimait le <w>provoquer</w> par des regards langoureux et des sourires enjôleurs."
                        },
                        {
                            "text": "Par ses allusions suggestives, il cherchait visiblement à la <w>provoquer</w> tout au long du dîner."
                        }
                    ],
                    "common_phrases": [
                        "aimer provoquer"
                    ]
                },
                {
                    "sense_id": "f6d42025-6986-39d5-85e9-057edd76ae95",
                    "sense_definition": "Inviter formellement quelqu'un à un duel, un combat ou une épreuve.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "defi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'officier offensé a aussitôt décidé de <w>provoquer</w> son rival en duel pour laver son honneur."
                        },
                        {
                            "text": "Le jeune champion a osé <w>provoquer</w> au combat le vieux maître d'armes."
                        }
                    ],
                    "synonyms": [
                        "défier"
                    ],
                    "common_phrases": [
                        "provoquer en duel",
                        "provoquer au combat"
                    ]
                }
            ]
        }
    ]
}