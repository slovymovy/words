    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "42f95e9e-89b8-3714-9248-93a04461af56",
                "word": "wapper",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "315af837-8db0-4878-9761-bd6653653cfd",
                        "entry_id": "42f95e9e-89b8-3714-9248-93a04461af56",
                        "tags": [
                            "plural"
                        ],
                        "form": "wappers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3ce276b-80c3-3af8-9c2c-d8bbd62e5259",
                        "entry_id": "42f95e9e-89b8-3714-9248-93a04461af56",
                        "glosses": [
                            "A mischievous sprite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5b929ec-ec0e-425c-b952-d3aa477cf5a5",
                                "sense_id": "f3ce276b-80c3-3af8-9c2c-d8bbd62e5259",
                                "text": "\"And a wapper, too; when I first saw it I thought it was a rabbit, and now it's bigger than a deer, and still a mile or two off,\" said Joe."
                            },
                            {
                                "example_id": "6f61d647-6eff-4b56-bf92-215446784524",
                                "sense_id": "f3ce276b-80c3-3af8-9c2c-d8bbd62e5259",
                                "text": "The Wapper had, just for the fun of it, put an iron pot under the hat."
                            },
                            {
                                "example_id": "e7a05876-e9be-40c1-a9f7-d0e220a81257",
                                "sense_id": "f3ce276b-80c3-3af8-9c2c-d8bbd62e5259",
                                "text": "Presently the good woman discovered to her horror that the foundling was swelling and becoming heavy, and when she put it down the Wapper assumed his own shape and ran off shrieking."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "447819d1-d946-337f-9e79-f01b73df1006",
                "word": "wapper",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4208e219-a67b-4e1e-9b4d-9c96bab85127",
