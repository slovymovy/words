                                        "sense_id": "88d30f09-3280-340c-a85c-23d0b878c825",
                                        "entry_id": "2af110a8-0cb5-336c-a490-f2dbf1ec0dc2",
                                        "glosses": [
                                            "bemoeienis, het zich inlaten met kwesties waar men eigenlijk geen zeggenschap over heeft of waar dat niet vanzelfsprekend is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8d6fdcc-6448-45f3-8b56-aa0b0e2e2e9d",
                                                "sense_id": "88d30f09-3280-340c-a85c-23d0b878c825",
                                                "text": "Vergeef mij deze inmenging in een aangelegenheid, waar ik slechts zijdelings bij betrokken ben en die mij eigenlijk niet aan gaat."
                                            }
                                        ]
                                    }
