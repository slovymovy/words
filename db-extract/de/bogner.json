                                    {
                                        "sense_id": "ff366f8d-fee1-3f2f-9501-4442afec8e5b",
                                        "entry_id": "196eb14a-cbb8-3f75-92eb-000758dec59d",
                                        "glosses": [
                                            "A person who makes or sells bows (for use with arrows)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5803f581-3e7e-49d5-86e3-aba82e2b6c0a",
                                                "sense_id": "ff366f8d-fee1-3f2f-9501-4442afec8e5b",
                                                "text": "A clause of a former act directing the bowyers of London and Westminster to make four bows of different wood for one of yew, was repealed on their representation that the citizens of London would use none but yew bows, and in its place they were ordered always to have by them at least fifty bows of elm, witch-hasel, or ash."
                                            }
                                        ]
