                        "source_entry_id": "8cae5b14-5605-3829-807f-e6d289833792",
                        "source_sense_id": "1072733d-3ea5-38f1-8ec0-b410696f5d38",
                        "source_sense_description": "of, relating to, or being an approximation",
                        "target_lang_word": "approximatif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "approximatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef674f14-e3a9-35f3-8b71-1a66f5f2a061",
                                        "entry_id": "e320b7ca-f1a6-3639-9f12-f237c010d2d0",
                                        "glosses": [
                                            "Qui est fait par approximation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac88be4d-f580-4f60-964b-a4e6cdf78975",
                                                "sense_id": "ef674f14-e3a9-35f3-8b71-1a66f5f2a061",
                                                "text": "Ma route pour y parvenir, me faisait passer entre les atolls de Nihiru et de Taenga, distants seulement de vingt milles, et dont la position marquée sur la carte était approximative."
                                            },
                                            {
                                                "example_id": "c2812907-ad95-489f-b582-220101c90f55",
                                                "sense_id": "ef674f14-e3a9-35f3-8b71-1a66f5f2a061",
                                                "text": "Calcul approximatif. — Estimation approximative."
                                            },
                                            {
                                                "example_id": "0914cf1c-91ac-458d-83a1-527463347a7f",
                                                "sense_id": "ef674f14-e3a9-35f3-8b71-1a66f5f2a061",
                                                "text": "État approximatif des dépenses, des dettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccb42634-967f-335b-97fd-a3102ffd6fe6",
                                        "entry_id": "e320b7ca-f1a6-3639-9f12-f237c010d2d0",
                                        "glosses": [
                                            "Qui n'est pas absolu ou exact."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8dbee7d-ab9a-452c-8ec2-382d5e454a88",
                                                "sense_id": "ccb42634-967f-335b-97fd-a3102ffd6fe6",
                                                "text": "Là, sur un charpoy, était recroquevillé un vieil homme décharné, vêtu d'un costume en coton d'une blancheur approximative, et enveloppé dans des châles et des razais [couvertures] élimés."
                                            },
                                            {
                                                "example_id": "a16c9a14-5bad-4a6e-920a-6ae1f70872fa",
                                                "sense_id": "ccb42634-967f-335b-97fd-a3102ffd6fe6",
                                                "text": "[…], j'ai entendu une voix féminine qui chantait d'une justesse plus qu’approximative, deux chansons d'une ringardise affligeante, à cent mille lieues de tes goûts musicaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
