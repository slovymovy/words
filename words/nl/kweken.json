                    "synonyms": [
                        "kwaken"
                    ],
                    "target_lang_definitions": {
                        "en": "the making of a specific sound by a bird, such as a duck",
                        "ru": "издание специфического звука птицей, например уткой"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quack",
