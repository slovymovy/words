                        "glosses": [
                            "Passage de l’état de sommeil à l’état d’éveil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28c8f995-f6e8-462f-b982-068f3e293771",
                                "sense_id": "3e29c90d-c73c-34a7-b631-cb3af1f735e1",
                                "text": "Toute manifestation de la gloire de Dieu entraîne l’émerveillement, qui est premier éveillement à la Réalité suprême, vestibule de la stupeur et du ravissement extatique."
                            },
                            {
                                "example_id": "5e8c2e5f-e19e-4a43-8e93-5d6773aadbb0",
                                "sense_id": "3e29c90d-c73c-34a7-b631-cb3af1f735e1",
                                "text": "Gambu passait souvent du sommeil normal à celui d’éveillement et ses sentientations étaient de grande valeur pour moi, parce qu’à l’ordinaire elles étaient relatives aux degrés de l’état physique et aussi à cause de leur exactitude"
                            }
                        ]
                    }
