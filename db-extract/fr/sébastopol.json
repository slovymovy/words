                    {
                        "sense_id": "b7d0152f-3fc9-3628-aea5-d600b98b06fb",
                        "entry_id": "83be62fa-81ed-3165-8d1d-43c792db0f20",
                        "glosses": [
                            "Ville située dans le sud-ouest de la péninsule de Crimée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbced48a-101b-469a-ae05-e964e6ac2356",
                                "sense_id": "b7d0152f-3fc9-3628-aea5-d600b98b06fb",
                                "text": "Dans la nuit du 13 au 14 novembre 1854, les signes précurseurs d’une tempête vinrent éveiller les justes appréhensions des amiraux commandant les escadres alliées devant Sébastopol."
                            },
                            {
                                "example_id": "709c1c71-6845-4b35-8dc6-b3bd27d0df69",
                                "sense_id": "b7d0152f-3fc9-3628-aea5-d600b98b06fb",
                                "text": "Jamais ils ne revirent le corps d’Antoine, probablement enfoui à la hâte dans une fosse sordide, du côté de Sébastopol."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "081d1a38-0d8e-413d-bb5f-be5e33ef67f7",
                        "source_entry_id": "83be62fa-81ed-3165-8d1d-43c792db0f20",
                        "source_sense_id": "b7d0152f-3fc9-3628-aea5-d600b98b06fb",
