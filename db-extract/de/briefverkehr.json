                        "examples": [
                            {
                                "example_id": "77ac55df-88fd-4799-b0dd-fd7075882e6b",
                                "sense_id": "9dc0a33f-10f8-3c32-99ca-0d1b75518ca0",
                                "text": "„Dies barg das Risiko, dass die im Brief niedergeschriebenen Informationen nicht sicher waren, denn, wie die oben schon genannten schwarzen Kabinette belegen, gab es immer ein staatliches Interesse daran, Informationen aus dem privaten Briefverkehr von Seiten des Staates abzuschöpfen.“"
                            },
                            {
                                "example_id": "f97fc12f-1085-4a4b-ae5d-30677e138746",
                                "sense_id": "9dc0a33f-10f8-3c32-99ca-0d1b75518ca0",
                                "text": "„Eigentümlich war Buschs intensiver Briefverkehr mit der Holländerin Maria Anderson.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
