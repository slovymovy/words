                                            {
                                                "example_id": "6a9d6c13-4b2c-4a5c-bf9a-4d197f3c041c",
                                                "sense_id": "6c9eb8ac-18e2-3e7c-a1b0-9c6e5a4dfa2b",
                                                "text": "Tentou envolver o amigo nos seus negócios escusos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02bb6342-be06-3213-a7dc-a80b156fb6a4",
                                        "entry_id": "f715d2bf-c70b-3c52-9430-344672d18141",
                                        "glosses": [
                                            "engajar interesses em algo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d403430d-5c0a-4b22-901d-4060a6fc314a",
                                                "sense_id": "02bb6342-be06-3213-a7dc-a80b156fb6a4",
                                                "text": "O jovem envolveu-se no movimento ecológico."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f241092-e515-371d-b4b4-01a788e9a89d",
                                        "entry_id": "f715d2bf-c70b-3c52-9430-344672d18141",
                                        "glosses": [
                                            "preocupar-se com ou dedicar-se a algo"
                                        ],
                                        "tags": [],
