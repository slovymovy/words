    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c90bad73-f80d-34b7-aed2-f5297410ddb7",
                    "sense_definition": "Personne qui a reçu un mandat ou une procuration pour agir au nom et pour le compte d'une autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit_representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a signé les actes officiels en tant que <w>mandataire</w> de sa cliente."
                        },
                        {
                            "text": "Le <w>mandataire</w> social est responsable des décisions prises au nom de l'entreprise."
                        }
                    ],
                    "synonyms": [
                        "agent"
                    ],
                    "antonyms": [
                        "mandant"
                    ],
                    "common_phrases": [
                        "mandataire social",
                        "mandataire judiciaire",
                        "désigner un mandataire"
                    ]
                },
                {
                    "sense_id": "65fadd88-3af3-3a84-9516-8f2e8e04771e",
                    "sense_definition": "Intermédiaire commercial chargé de vendre ou d'acheter des marchandises pour le compte d'un tiers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce <w>mandataire</w> automobile négocie les véhicules directement auprès des constructeurs européens."
                        },
                        {
                            "text": "Les producteurs confient l'écoulement de leurs récoltes à un <w>mandataire</w> du marché de gros."
                        }
                    ],
                    "synonyms": [
                        "commissionnaire"
                    ],
                    "antonyms": [
                        "mandant"
                    ],
                    "common_phrases": [
                        "mandataire automobile"
                    ]
                },
                {
                    "sense_id": "9f0fa91e-c408-345b-a29b-a910bcdb2f67",
                    "sense_definition": "Personne désignée par un candidat à une élection pour gérer officiellement les aspects financiers ou juridiques de sa campagne.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>mandataire</w> financier doit recueillir les dons et régler les dépenses électorales."
                        },
                        {
                            "text": "Chaque candidat aux élections a nommé un <w>mandataire</w> pour superviser le scrutin."
