    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "56a6025d-db97-3640-8a01-6b0891b19413",
                "word": "quietus",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a86979e8-3ad6-4bf5-9ae9-c4c6ab496bed",
                        "entry_id": "56a6025d-db97-3640-8a01-6b0891b19413",
                        "tags": [
                            "plural"
                        ],
                        "form": "quietuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "92719f7d-0c97-33c3-927b-0a5f1f75c203",
                        "entry_id": "56a6025d-db97-3640-8a01-6b0891b19413",
                        "glosses": [
                            "A stillness or pause; something that quiets or represses; removal from activity."
                        ],
                        "tags": [
                            "dated",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ae8b79dd-328b-4c8b-b9ac-3c88b17fb8c3",
                                "sense_id": "92719f7d-0c97-33c3-927b-0a5f1f75c203",
                                "text": "Olive's specific terrors and dangers had by this time very much blown over; Basil Ransom had given no sign of life for ages, and Henry Burrage had certainly got his quietus before they went to Europe."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a95029f-40c5-3702-b828-36593e96b3ec",
                        "entry_id": "56a6025d-db97-3640-8a01-6b0891b19413",
                        "glosses": [
                            "Death."
                        ],
                        "tags": [
                            "dated",
                            "figuratively",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "8dcae7f5-e5a8-40b9-8e52-43d62a2eaa7b",
                                "sense_id": "3a95029f-40c5-3702-b828-36593e96b3ec",
                                "text": "When he himſelfe might his Quietus make / With a bare Bodkin?"
                            },
                            {
                                "example_id": "6556f9a2-7f6d-4ea6-b7bd-cff765210b60",
                                "sense_id": "3a95029f-40c5-3702-b828-36593e96b3ec",
                                "text": "After a good deal of firing, and lying in wait - for every time he heard a shot down he'd go, and on coming to the surface, would only expose about two or three inches of his nose to fire at - we managed to give him his quietus."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ef73d6d-1dd9-3842-89f1-e7f983b1d6f7",
                        "entry_id": "56a6025d-db97-3640-8a01-6b0891b19413",
                        "glosses": [
                            "Final settlement (e.g., of a debt)."
                        ],
                        "tags": [
                            "dated",
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
