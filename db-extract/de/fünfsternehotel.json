                "senses": [
                    {
                        "sense_id": "db32442e-48f1-30b1-9305-5cb46265eb5a",
                        "entry_id": "de501183-514e-3d07-91d3-f240165754ed",
                        "glosses": [
                            "Hotel, das aufgrund seiner Qualität mit fünf Sternen als Luxushotel ausgezeichnet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e3ab70-3f2d-45ed-996a-4ab1e9987be7",
                                "sense_id": "db32442e-48f1-30b1-9305-5cb46265eb5a",
                                "text": "„Beim Tourismus galt seit jeher, schon seit der Kavalierstour, dass Hunger und Elend nie weit von den Fünfsternehotels entfernt sind.“"
                            },
                            {
                                "example_id": "a92bfc26-2efe-4664-9a97-baacc4b3af61",
                                "sense_id": "db32442e-48f1-30b1-9305-5cb46265eb5a",
                                "text": "„Moderne Umweltgurus übernachten in klimaneutralen Fünfsternehotels, tragen Designeranzüge aus gentechnikfreier Biobaumwolle und rahmengenähte Schuhe von totgestreichelten Kobe-Rindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
