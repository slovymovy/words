                                        "entry_id": "6bbef49f-6752-32d8-bf29-973d093e0da9",
                                        "glosses": [
                                            "pultartiges Möbel zum Beten mit einem Brett zum Knien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97ac0741-c54c-4064-afc1-d2a37e6a2306",
                                                "sense_id": "6343af66-6e85-38c5-aa4a-52a194a65744",
                                                "text": "„Aus dem unteren Teil eines Schrankes stellte Gorju ein Betpult her, das unter dem Fenster stehen sollte, denn er schmeichelte ihrem Wahn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
