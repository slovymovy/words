                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3046b01-1fc1-3e5d-b434-aa3ac18371ac",
                    "sense_definition": "An input variable of a function definition that receives a value when the function is executed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The function requires a string <w>parameter</w> to specify the file path.",
                            "target_lang_translations": {
                                "ru": "Функция требует строковый <w>параметр</w> для указания пути к файлу."
                            }
                        },
                        {
                            "text": "You must pass a valid <w>parameter</w> to the method for it to work.",
                            "target_lang_translations": {
                                "ru": "Вы должны передать методу корректный <w>параметр</w>, чтобы он заработал."
