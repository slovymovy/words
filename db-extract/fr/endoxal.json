                        "glosses": [
                            "Qui est admis par tous, qui n'est pas paradoxal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "519f72d0-ee3a-411b-8e0d-9a6a44fda8cc",
                                "sense_id": "30530c8f-9453-340f-a430-83b4706d1c8f",
                                "text": "Il n'est pas nécessaire qu'une opinion soit partagée par une multitude pour être endoxale, puisque l'opinion d'un homme réputé sage peut être endoxale."
                            },
                            {
                                "example_id": "0bafb331-babd-4715-b767-301504e29246",
                                "sense_id": "30530c8f-9453-340f-a430-83b4706d1c8f",
                                "text": "De fait, les éleveurs, dans le discours indirect libre qui reprend la parole endoxale, se considèrent eux comme les « natifs » et dès le début, se déclarent prêts à « leur régler les comptes »."
                            }
                        ]
                    }
