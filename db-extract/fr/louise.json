                "entry_id": "f461466b-4ef0-3273-bc26-b87c9dce99cb",
                "word": "louise",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b58fd960-c880-4d37-b1d7-54f1bb73a2fc",
                        "entry_id": "f461466b-4ef0-3273-bc26-b87c9dce99cb",
