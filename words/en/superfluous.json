            "senses": [
                {
                    "sense_id": "4913de38-778a-3e25-a37c-5ee8282c39c4",
                    "sense_definition": "In excess of what is required or sufficient.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "excess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a full rain suit, carrying an umbrella may be <w>superfluous</w>.",
                            "target_lang_translations": {
                                "nl": "Met een volledig regenpak is het meenemen van een paraplu wellicht <w>overbodig</w>."
                            }
                        },
                        {
                            "text": "The extra paragraph in the report was <w>superfluous</w> and did not add any value.",
                            "target_lang_translations": {
                                "nl": "De extra alinea in het rapport was <w>overbodig</w> en voegde geen waarde toe."
                            }
                        }
                    ],
                    "synonyms": [
                        "excessive",
                        "extra",
                        "extraneous",
                        "surplus",
                        "unnecessary",
                        "needless",
                        "redundant"
                    ],
                    "common_phrases": [
                        "entirely superfluous",
                        "wholly superfluous"
                    ],
                    "target_lang_definitions": {
                        "nl": "Meer dan nodig of voldoende; niet langer vereist."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "overbodig",
                                "target_lang_sense_clarification": "Niet of niet langer nodig; nutteloos in de huidige context."
                            },
                            {
                                "target_lang_word": "overtollig",
                                "target_lang_sense_clarification": "Wat in te ruime mate aanwezig is; overtollig in aantal of hoeveelheid."
                            }
                        ]
                    }
                }
            ]
        }
