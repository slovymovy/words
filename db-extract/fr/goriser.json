                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f4412a6-6394-4208-9f4c-61b75a2da7e1",
                                "sense_id": "43725f7f-734d-3a53-a365-be4861e27e21",
                                "text": "On aurait dit le début d’un film porno, ou gore, et je ne tenais pas à me faire pornoiser, ni goriser mais j’avais plus de cent cinquante kilomètres à parcourir à l’ouest de ce parking et la nuit tombait presque et c’était la seule voiture à se proposer, et j’ai toujours été incapable de refuser la moindre proposition."
                            },
                            {
                                "example_id": "f60ecfa5-60c0-4239-a76d-250d66759154",
                                "sense_id": "43725f7f-734d-3a53-a365-be4861e27e21",
                                "text": "Elea avait choisi un magnifique costume de princesse qu'elle avait gorisé (oui rendu gore, nouveau verbe !)."
                            },
                            {
                                "example_id": "90b2fe2f-e2cb-43cd-9a3c-f439501a8214",
                                "sense_id": "43725f7f-734d-3a53-a365-be4861e27e21",
                                "text": "On insolitise, gorise (mais en propre), overgroundise...."
                            }
                        ]
