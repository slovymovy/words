            {
                "entry_id": "af5d3fe2-f4bc-30f3-bb17-c449329a3d80",
                "word": "Rusyn",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "841a36c2-8d7b-4b46-92c2-4e260826fdf4",
                        "entry_id": "af5d3fe2-f4bc-30f3-bb17-c449329a3d80",
                        "tags": [],
                        "form": "Rusin"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "feb37229-5432-3db8-81e1-77fbfc2d0933",
                        "entry_id": "af5d3fe2-f4bc-30f3-bb17-c449329a3d80",
                        "glosses": [
                            "Peuple slave orientale des Carpates orientales, habitant la Slovaquie, l’Ukraine et la Hongrie, ou de Pannonie habitant la Serbie et la Croatie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dbb5b31-642d-4eeb-8030-0fffca0638ec",
                                "sense_id": "feb37229-5432-3db8-81e1-77fbfc2d0933",
                                "text": "La population officielle de la région en 2001 était de 1 258 000 personnes (Law 20 juin 2003); les Rusyns constitueraient donc le groupe ethnique dominant en Transcarpathie (CER 20 nov. 2000; RIMC 2003c)."
                            },
                            {
                                "example_id": "38af0476-bc98-42fa-8f97-c2ac658dd03a",
                                "sense_id": "feb37229-5432-3db8-81e1-77fbfc2d0933",
                                "text": "Le Comité consultatif se réjouit, en particulier, que, contrairement au recensement de 1989, les Rusyns et les autres « groupes sousethniques » figurent en tant que catégorie distincte sous la rubrique « origine ethnique » dans le recensement de décembre 2001."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb837328-1f40-4bd3-9b69-e5d8b5ba8395",
                        "source_entry_id": "af5d3fe2-f4bc-30f3-bb17-c449329a3d80",
                        "source_sense_id": "feb37229-5432-3db8-81e1-77fbfc2d0933",
                        "target_lang_word": "Rusine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rusine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "118db4b9-8037-3499-942c-6911b55d25f4",
                                        "entry_id": "027455fd-8e26-3fcb-8f0f-aa154e9a3583",
                                        "glosses": [
                                            "Angehöriger eines ursprünglich in den Karpaten beheimateten, ostslawischen Stamms; Angehöriger des slawischen Volks der Rusinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e3ecd9d-8676-4d19-aaa8-107d6a31d10b",
                                                "sense_id": "118db4b9-8037-3499-942c-6911b55d25f4",
                                                "text": "„Hartnäckig wie ein Rusine, lautet ein polnisches Sprichwort.“ Eduard Taaffe (1833–1895)"
                                            },
                                            {
                                                "example_id": "0b66902a-a74e-4bd6-a546-195a423ab36e",
                                                "sense_id": "118db4b9-8037-3499-942c-6911b55d25f4",
                                                "text": "„Der Schwabe miethet andere Leute zur Aushülfe bei der Arbeit […]; der Rusine aber arbeitet selbst.“ Das Ausland (1842)"
                                            },
                                            {
                                                "example_id": "37c5b5b0-699b-4b70-b766-2cb361ebcf58",
                                                "sense_id": "118db4b9-8037-3499-942c-6911b55d25f4",
                                                "text": "„Er war ein Rusine aus der Verchovina.“"
                                            },
                                            {
                                                "example_id": "aaad8aac-9906-430b-9ff2-830858dae920",
                                                "sense_id": "118db4b9-8037-3499-942c-6911b55d25f4",
                                                "text": "„Von 1950–1989 war es nicht erlaubt, sich als Rusine oder Ruthene zu bezeichnen; nur Ukrainer durfte man sich nennen.“"
                                            },
                                            {
                                                "example_id": "aee11422-0316-4c28-ae08-82e4e8516e74",
                                                "sense_id": "118db4b9-8037-3499-942c-6911b55d25f4",
                                                "text": "„Bezüglich der Rusinen wird schon seit den 1840er Jahren häufig darauf aufmerksam gemacht, daß es sich um eine den Polen zwar nah verwandte, doch andere Ethnie handelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
