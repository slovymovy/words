                ],
                "senses": [
                    {
                        "sense_id": "abc6579a-65c7-3389-ad5d-fe0f8941846b",
                        "entry_id": "4999700c-0610-361c-88e5-343601d818d2",
                        "glosses": [
                            "Anhängerin des islamischen Glaubens"
                        ],
                        "tags": [
                            "Islam"
                        ],
                        "examples": [
                            {
                                "example_id": "4f181bbd-c0f5-4225-895d-d759c6080439",
                                "sense_id": "abc6579a-65c7-3389-ad5d-fe0f8941846b",
                                "text": "Abdel-Razzak heiratete dann eine deutsche Muslima. (eine muslimische Deutsche)"
                            },
                            {
                                "example_id": "148784f9-3e6e-4781-a813-781728530793",
                                "sense_id": "abc6579a-65c7-3389-ad5d-fe0f8941846b",
                                "text": "„Die Max-Overalls waren nicht nur warm, es wirkte, als spielten sie eine ähnliche Rolle wie die Burka bei strenggläubigen Muslimas.“"
                            },
                            {
                                "example_id": "2db8121a-523e-49bb-885e-17f9147f7dd5",
                                "sense_id": "abc6579a-65c7-3389-ad5d-fe0f8941846b",
                                "text": "„Wenn ich es nun geschafft haben sollte, Sie emotional aufzuwärmen, können Sie vielleicht verstehen, was für eine Muslima das Wort Bayram bedeutet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "279884e9-75f4-4297-b8d4-f0b9591ee1f3",
                        "source_entry_id": "4999700c-0610-361c-88e5-343601d818d2",
                        "source_sense_id": "abc6579a-65c7-3389-ad5d-fe0f8941846b",
                        "source_sense_description": "Islam, Religion: Anhängerin des islamischen Glaubens",
                        "target_lang_word": "Muslim",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muslim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2ef67c0-92b0-38fa-99e8-e18c5b439151",
                                        "entry_id": "75a49b57-cb12-3a33-8d61-660d69333e20",
                                        "glosses": [
                                            "A person who is a follower and believer of Islam."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eaba674-32ce-49a5-bb11-d35b9c4615a4",
                                                "sense_id": "d2ef67c0-92b0-38fa-99e8-e18c5b439151",
                                                "text": "It was gouerned by Macuac, which conditioned with Amrus that euery Egyptian should pay an Egyptian peece of Gold, and to entertaine three dayes euery Muslim which passed that way."
                                            },
                                            {
                                                "example_id": "f54537a5-fc79-4bcc-820a-a47b9404dc03",
                                                "sense_id": "d2ef67c0-92b0-38fa-99e8-e18c5b439151",
                                                "text": "Muslims invented the concept of zero, which is a foundation for the numbering system used throughout the world."
                                            },
                                            {
                                                "example_id": "3d68a910-c601-47c4-b48c-1a252948d569",
                                                "sense_id": "d2ef67c0-92b0-38fa-99e8-e18c5b439151",
                                                "text": "“At the end of the day, Jews and Muslims are cousins,” Alhomsi said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Muslim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16524950-ec6c-3740-9b13-bc15d3b6244e",
                                        "entry_id": "43b2a4e8-8e9b-3d18-bd1e-f9058e8dee03",
                                        "glosses": [
                                            "Being or relating to a believer of Islam."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f5cd4cc-317e-434c-99ce-57a2d56ec3e3",
                                                "sense_id": "16524950-ec6c-3740-9b13-bc15d3b6244e",
                                                "text": "The notion of blood purity was first elaborated in Europe, where it was used to separate Old Christians from Spain’s New Christians—women and men of Jewish and Muslim origin whose ancestors had converted to Christianity."
                                            },
                                            {
                                                "example_id": "c8bc5261-3abc-407a-8fd6-f917890969ac",
                                                "sense_id": "16524950-ec6c-3740-9b13-bc15d3b6244e",
                                                "text": "Kaplan-Miller said she first joined the Sisterhood of Salaam Shalom, an interfaith organization that was founded by a Muslim and a Jewish woman in suburban New Jersey, shortly after the 2016 election."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Muslim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3f68db2-4092-381a-bbed-c1d3581c0552",
                                        "entry_id": "df2e09a8-bafa-35ef-817d-954a2539432e",
                                        "glosses": [
                                            "A barangay of Guindulungan, Maguindanao del Sur, Philippines."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
