                "word": "superstrat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4c4e72e6-4aec-49dd-be6f-9fa3b67ecd5a",
                        "entry_id": "0f1c6e21-d21d-3195-80cf-0bf9d1d4c74f",
                        "tags": [
