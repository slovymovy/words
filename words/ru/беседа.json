                {
                    "sense_id": "9c5d9617-8401-3ccd-a0ff-9433af3c911e",
                    "sense_definition": "Собрание, общество людей для отдыха и развлечения (в старой народной культуре).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старину деревенская молодёжь часто собиралась на вечернюю <w>беседу</w>.",
                            "target_lang_translations": {
                                "en": "In olden times, village youth often gathered for an evening <w>gathering</w>.",
                                "de": "Früher traf sich die Dorfjugend oft zu einem abendlichen <w>Beisammensein</w>."
                            }
                        },
                        {
                            "text": "Вся шумная <w>беседа</w> замолчала, когда в комнату вошёл незнакомец.",
                            "target_lang_translations": {
                                "en": "The whole noisy <w>gathering</w> fell silent when a stranger entered the room.",
                                "de": "Die ganze laute <w>Gesellschaft</w> verstummte, als ein Fremder den Raum betrat."
                            }
                        }
                    ],
