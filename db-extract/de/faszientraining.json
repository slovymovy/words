                "senses": [
                    {
                        "sense_id": "ada842ff-fa11-34db-87f3-c3b112e23d9d",
                        "entry_id": "9a534dd5-217b-3e81-8fa3-a20e294637a5",
                        "glosses": [
                            "Therapiemethode zum Training der Faszien (bindegewebige Umhüllung von Muskeln)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a682b782-8ed0-4535-a137-e1d975049df8",
                                "sense_id": "ada842ff-fa11-34db-87f3-c3b112e23d9d",
                                "text": "„Wegen der Schmerzempfindlichkeit seien Gerätetraining im Studio oder Kontaktsportarten eher nicht zu empfehlen, dafür aber Übungen mit dem eigenen Körpergewicht, Faszientraining, -massagen oder Yoga.“"
                            },
                            {
                                "example_id": "d4bb22b9-22f2-41c4-94e6-2190b502e108",
                                "sense_id": "ada842ff-fa11-34db-87f3-c3b112e23d9d",
                                "text": "„Mit dynamischen Faszientraining ohne Rollen werden Verspannungen gelöst, Lymphfluss und Blutzirkulation angeregt und alle Gelenke schonend durchbewegt.“"
                            },
                            {
                                "example_id": "4dea4c1c-2dcb-4ce4-8686-e4121dfa948e",
                                "sense_id": "ada842ff-fa11-34db-87f3-c3b112e23d9d",
                                "text": "„So werden neben der großen Halle auch im Judo- und Gymnastikraum der Wiedigsburghalle interessante Kurse wie Faszientraining und Yin-Yoga oder Kanga Burn abgehalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
