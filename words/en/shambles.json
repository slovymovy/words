    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b93d77da-c729-3ff9-9141-cd6308a90347",
                    "sense_definition": "A state of great mess or clutter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The living room was a complete <w>shambles</w> after the children finished playing.",
                            "target_lang_translations": {
                                "nl": "De woonkamer was een complete <w>puinhoop</w> nadat de kinderen klaar waren met spelen."
                            }
                        },
                        {
                            "text": "Please clean up this <w>shambles</w> before our guests arrive for dinner.",
                            "target_lang_translations": {
                                "nl": "Ruim alsjeblieft deze <w>bende</w> op voordat onze gasten voor het diner arriveren."
                            }
                        }
                    ],
                    "synonyms": [
                        "mess",
                        "clutter",
                        "disarray"
                    ],
                    "antonyms": [
                        "order"
                    ],
                    "common_phrases": [
                        "a total shambles"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een toestand van grote rommel of wanorde."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "puinhoop",
                                "target_lang_sense_clarification": "algemene term voor een grote rommel"
                            },
                            {
                                "target_lang_word": "bende",
                                "target_lang_sense_clarification": "informele term voor een rommelige situatie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "179da249-ad79-3250-be1e-425ceb247f7c",
                    "sense_definition": "A situation or event characterized by total failure or confusion.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire project turned into a <w>shambles</w> due to poor planning.",
                            "target_lang_translations": {
                                "nl": "Het hele project werd een <w>fiasco</w> door een slechte planning."
                            }
                        },
                        {
                            "text": "His career is in <w>shambles</w> after the recent scandal.",
                            "target_lang_translations": {
                                "nl": "Zijn carrière ligt in <w>duigen</w> na het recente schandaal."
                            }
