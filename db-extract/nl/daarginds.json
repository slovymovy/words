                "translations": [
                    {
                        "translation_id": "a1ed07cc-49c4-4427-b8af-9a83f4845f7d",
                        "source_entry_id": "0a90852b-a5ae-37f6-8afa-1632a49f9f28",
                        "source_sense_id": "61dd8ed7-23e0-3793-8560-8eb2510116ca",
                        "source_sense_description": "op een plaats in de verte",
                        "target_lang_word": "drüben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drüben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50509c90-4ed0-39b0-8105-2b3b198f83d2",
                                        "entry_id": "2d46c57b-c03d-3790-a88e-9cfd5ee7bd9d",
                                        "glosses": [
                                            "auf der anderen Seite"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22b53340-bebe-484e-9afb-fbfee67b8601",
                                                "sense_id": "50509c90-4ed0-39b0-8105-2b3b198f83d2",
                                                "text": "„Hüben wird auf der roten und drüben auf der blauen Seite der Kontrakt eingezeichnet, der eben seinen Besitzer gewechselt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8ad2a19-ff9b-4e00-96d3-31c9bf081390",
                        "source_entry_id": "0a90852b-a5ae-37f6-8afa-1632a49f9f28",
                        "source_sense_id": "61dd8ed7-23e0-3793-8560-8eb2510116ca",
                        "source_sense_description": "op een plaats in de verte",
                        "target_lang_word": "dort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a9ec7b0-18e8-3068-9086-e0f84f4b3018",
                                        "entry_id": "7e67e534-094a-3134-8139-544ee768b852",
                                        "glosses": [
                                            "Hinweis auf einen Ort, stärker als da"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c96cd286-8044-4485-84ec-903751098ea0",
                                                "sense_id": "3a9ec7b0-18e8-3068-9086-e0f84f4b3018",
                                                "text": "Den Tisch dort möchten wir kaufen."
                                            },
                                            {
                                                "example_id": "ff2ebd66-1ee1-4c98-9374-5a7c8d5d92cf",
                                                "sense_id": "3a9ec7b0-18e8-3068-9086-e0f84f4b3018",
                                                "text": "Wir haben uns dort sehr wohl gefühlt."
                                            },
                                            {
                                                "example_id": "479e6a3d-7c38-49ed-adb0-b973704ce200",
                                                "sense_id": "3a9ec7b0-18e8-3068-9086-e0f84f4b3018",
                                                "text": "„Die meisten Menschen fühlen sich dort wohl, wo sie sich auskennen.“"
                                            },
                                            {
                                                "example_id": "5f002d45-cbdd-4837-accf-c856c70750a5",
                                                "sense_id": "3a9ec7b0-18e8-3068-9086-e0f84f4b3018",
                                                "text": "„In Jena gibt es eine der wenigen Spezialkliniken für Kinder. Der 10-jährige Jason wird dort untersucht.“"
                                            },
                                            {
                                                "example_id": "26a1fbf9-6434-4c00-b540-65568bfcb319",
                                                "sense_id": "3a9ec7b0-18e8-3068-9086-e0f84f4b3018",
                                                "text": "„Geboren wurde ich 1987 in der kleinen nordhessischen Stadt Eschwege. Dort wuchs ich auf, bis meine Eltern das Fernweh überkam, sie mich und das Nötigste einpackten und nach Spanien zogen.“"
                                            },
                                            {
                                                "example_id": "c155ca12-dd46-4445-ba39-9ba407e6ab8b",
                                                "sense_id": "3a9ec7b0-18e8-3068-9086-e0f84f4b3018",
                                                "text": "„Großstädte in Dunkelheit? Unvorstellbar. Starke Beleuchtung sorgt dafür, dass es dort auch nachts nicht wirklich dunkel wird.“"
                                            },
                                            {
                                                "example_id": "e7ab40b9-f40d-4458-82d3-0e79a8322ce1",
                                                "sense_id": "3a9ec7b0-18e8-3068-9086-e0f84f4b3018",
                                                "text": "„Nach seiner Rückkehr nach München habilitierte er an der LMU in Physik und nahm dort den Ruf einer Professur für Experimentalphysik an. Er leitete dort eine Arbeitsgruppe im Bereich Nanowissenschaften.“"
                                            },
                                            {
                                                "example_id": "224f8ae2-8c4b-4f30-8d2c-bf198c5e0321",
                                                "sense_id": "3a9ec7b0-18e8-3068-9086-e0f84f4b3018",
                                                "text": "„Egal ob Corona-, Grippe und Erkältungsviren – meist findet eine Infektion über die Nasenschleimhaut statt. Von dort aus gelangen die Krankheitserreger dann in die Lunge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e04048a-d78c-4d9b-95c1-a3520cbde4f4",
                        "source_entry_id": "0a90852b-a5ae-37f6-8afa-1632a49f9f28",
                        "source_sense_id": "61dd8ed7-23e0-3793-8560-8eb2510116ca",
                        "source_sense_description": "op een plaats in de verte",
                        "target_lang_word": "yonder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yonder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc1dca88-93d1-351b-8f6d-47c35b110c91",
                                        "entry_id": "2a231997-fdc2-3676-a4d7-fb1ea350816b",
                                        "glosses": [
                                            "At or in a distant but indicated place."
                                        ],
                                        "tags": [
                                            "Southern-US",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cc0680f-bd81-4e75-a41c-09184738ca73",
                                                "sense_id": "bc1dca88-93d1-351b-8f6d-47c35b110c91",
                                                "text": "See who yonder is."
                                            },
                                            {
                                                "example_id": "c2a1a606-00d7-4521-b190-0e00df64e8dc",
                                                "sense_id": "bc1dca88-93d1-351b-8f6d-47c35b110c91",
                                                "text": "\"A fine man, that Dunwody, yonder,\" commented the young captain, as they parted, and as he turned to his prisoner. \"We'll see him on in Washington some day. He is strengthening his forces now against Mr. Benton out there.\""
                                            },
                                            {
                                                "example_id": "229353c4-3d20-4bb0-b73b-482859f8eaed",
                                                "sense_id": "bc1dca88-93d1-351b-8f6d-47c35b110c91",
                                                "text": "Whose doublewide is that over yonder?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac48acac-399e-3bb8-9711-e57d677e0a52",
                                        "entry_id": "2a231997-fdc2-3676-a4d7-fb1ea350816b",
                                        "glosses": [
                                            "Synonym of thither: to a distant but indicated place."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5bef7ae-897f-4d18-aa0e-f92e51db5b12",
                                                "sense_id": "ac48acac-399e-3bb8-9711-e57d677e0a52",
                                                "text": "As for me and the childe, we wyl go yonder."
                                            },
                                            {
                                                "example_id": "755e2bee-2f75-49f1-9e9a-6e5136b20a25",
                                                "sense_id": "ac48acac-399e-3bb8-9711-e57d677e0a52",
                                                "text": "They headed on over yonder."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yonder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47a252b0-55d4-3d79-b3b4-cb1bbf150c64",
                                        "entry_id": "6cb9aca6-f708-326a-85ab-9438c2af9ecb",
                                        "glosses": [
                                            "The farther, the more distant of two choices."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d1c2422-5f15-4238-851c-41fed99878ee",
                                                "sense_id": "47a252b0-55d4-3d79-b3b4-cb1bbf150c64",
                                                "text": "\"You have all necessary proofs in your possession, though you may not be aware of their existence,\" replied Arden; \"will you allow me to open yonder box?\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yonder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b771773-bdfe-3fa1-b5c2-1ad58d44044a",
                                        "entry_id": "1b466650-3799-352e-bed7-a2a134076242",
                                        "glosses": [
                                            "Who or which is over yonder, usually distant but within sight."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "764724ec-face-4865-a72c-ddf8b344f74e",
                                                "sense_id": "4b771773-bdfe-3fa1-b5c2-1ad58d44044a",
                                                "text": "Yonder lass, who be she?"
                                            },
                                            {
                                                "example_id": "a0b194cc-9681-4a05-8bd0-cd183359846d",
                                                "sense_id": "4b771773-bdfe-3fa1-b5c2-1ad58d44044a",
                                                "text": "But ſoft, what light through yonder window breaks?\nIt is the Eaſt, and Iuliet is the Sunne[…]"
                                            },
                                            {
                                                "example_id": "458ba5dd-a278-40a5-87e7-cef9f0ef1799",
                                                "sense_id": "4b771773-bdfe-3fa1-b5c2-1ad58d44044a",
                                                "text": "Fire, the Sword, and Plagueǃ They may all be found in the yonder city; on my head alone may they fallǃ"
                                            },
                                            {
                                                "example_id": "e7e30dba-3120-43c3-9807-3f3dc43835b4",
                                                "sense_id": "4b771773-bdfe-3fa1-b5c2-1ad58d44044a",
                                                "text": "\"You have all necessary proofs in your possession, though you may not be aware of their existence,\" replied Arden; \"will you allow me to open yonder box?\""
                                            },
                                            {
                                                "example_id": "dd05578e-f0b4-4197-a3bf-639f3fd154ec",
                                                "sense_id": "4b771773-bdfe-3fa1-b5c2-1ad58d44044a",
                                                "text": "I wish I were on yonder hill\nand there I’d sit and I’d cry my fill,\nand ev’ry tear would turn a mill,\nAnd a blessing walk with you, my love"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a9cdfde-ffed-34a8-9a24-8b03a6c512a7",
                                        "entry_id": "1b466650-3799-352e-bed7-a2a134076242",
                                        "glosses": [
                                            "One who or which is over yonder, usually distant but within sight."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "495c0695-d597-4d24-8d33-c56d51eef5a3",
                                                "sense_id": "2a9cdfde-ffed-34a8-9a24-8b03a6c512a7",
                                                "text": "The yonder is Queen Niobe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yonder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e94f23f5-fc5d-3264-87e1-f58a1281ce94",
                                        "entry_id": "5aa345dc-f63c-3cd2-a156-dece28961c52",
                                        "glosses": [
                                            "The vast distance, particularly the sky or trackless forest."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58c128eb-61b2-48b5-82d0-00db49487ce6",
                                                "sense_id": "e94f23f5-fc5d-3264-87e1-f58a1281ce94",
                                                "text": "Off we go in to the wild blue yonder,\nClimbing high into the sun..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e88dabb9-2ec6-46e1-8550-74bbf5a92712",
                        "source_entry_id": "0a90852b-a5ae-37f6-8afa-1632a49f9f28",
                        "source_sense_id": "61dd8ed7-23e0-3793-8560-8eb2510116ca",
                        "source_sense_description": "op een plaats in de verte",
                        "target_lang_word": "là-bas",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "là-bas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4826729-354b-3e1a-854b-bfae3c2525d8",
                                        "entry_id": "f101b28b-f5b3-35d4-82c5-a54455c3663e",
                                        "glosses": [
                                            "En ce lieu éloigné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01a692b8-c471-4ab9-b3fa-a1c94b01af5c",
                                                "sense_id": "f4826729-354b-3e1a-854b-bfae3c2525d8",
                                                "text": "— Nous sommes sous le fort de Montrouge, dit-il ; là-bas, c'est le fort de Vanves, et là-bas, tout là-bas sur une hauteur, c'est le fort d’Issy... juste devant Clamart."
                                            },
                                            {
                                                "example_id": "446fcb3a-6d74-41bc-8c18-c7dfe5a25d11",
                                                "sense_id": "f4826729-354b-3e1a-854b-bfae3c2525d8",
                                                "text": "Mais toujours une pensée venait l’arrêter ; il y avait là-bas, dans les Ardennes, un vieux père et une mère aux cheveux blancs qui mourraient certainement de chagrin si leur fils, […], faisait toutes ces choses qui passaient par son cerveau embrasé, aux heures lentes des nuits mauvaises."
                                            },
                                            {
                                                "example_id": "63c9764b-c8ec-4e50-b1a2-dc080a3f4b09",
                                                "sense_id": "f4826729-354b-3e1a-854b-bfae3c2525d8",
                                                "text": "À Dallas ! C’était si magique, si là-bas, si mystérieux… J’en fus transporté de joie et de fierté."
                                            },
                                            {
                                                "example_id": "b00ad6a0-3018-4832-83b7-d5aa46c2a21c",
                                                "sense_id": "f4826729-354b-3e1a-854b-bfae3c2525d8",
                                                "text": "– Dans les ports de l’est, les Blancs débarquent par bateaux entiers. Là-bas, en Europe, d’autres vont suivre par milliers…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb92b63f-2ce6-30f8-baf8-1895367ab5c7",
                                        "entry_id": "f101b28b-f5b3-35d4-82c5-a54455c3663e",
                                        "glosses": [
                                            "S'adresse à une personne éloignée qu'on interpelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a985b1a6-4dc0-4441-ad11-79e96741c45a",
                                                "sense_id": "eb92b63f-2ce6-30f8-baf8-1895367ab5c7",
                                                "text": "— Hé ! là-bas… lui crie Maigret qui cherche son revolver dans sa poche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
