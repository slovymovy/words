                "senses": [
                    {
                        "sense_id": "773fe191-88e4-30a0-af5a-275f53978099",
                        "entry_id": "93a3fe30-2e11-3e28-b8dd-7bd8586528ce",
                        "glosses": [
                            "diejenige am Krieg beteiligte Partei, die ihn am Ende verloren hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "692a62e3-0304-40c4-b594-3fbd01aa570b",
                                "sense_id": "773fe191-88e4-30a0-af5a-275f53978099",
                                "text": "„Die Isolation auf der internationalen Bühne brachte die Kriegsverlierer und ehemaligen Kriegsgegner Deutschland und Russland einander näher.“"
                            },
                            {
                                "example_id": "0d1064f4-9389-430d-ab02-60bb11d56a99",
                                "sense_id": "773fe191-88e4-30a0-af5a-275f53978099",
                                "text": "„Deutschland als Kriegsverlierer führte einen vergeblichen Kampf darum, seine Kolonien zu behalten.“"
                            },
                            {
                                "example_id": "956468c6-1fdc-421d-977e-9349bc8800ca",
                                "sense_id": "773fe191-88e4-30a0-af5a-275f53978099",
                                "text": "„Zunächst konnte die Regierung entspannt vorgehen, da die Wirtschaft zum größten Teil in den Händen der Weißen lag, die sich als zu den Kriegsverlierern gehörend ohnehin von staatlichem Wohlwollen abhängig glaubten und Forderungen aus der Politik oft gehorchten, auch wenn diese ökonomisch nicht immer sinnvoll waren.“"
                            },
                            {
                                "example_id": "59c3a561-0040-48fa-9720-96aae8bd336a",
                                "sense_id": "773fe191-88e4-30a0-af5a-275f53978099",
                                "text": "[1. Weltkrieg:] „Im Weltkrieg hatten Frankreich und Großbritannien Lebensmittel und Waffen von den USA erhalten und sich dafür hoch verschuldet. Nach dem Sieg versuchten die Alliierten, das nötige Geld vom Kriegsverlierer Deutschland zu erhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
