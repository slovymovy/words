    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "354f558d-184f-367a-b7fc-d62556f08011",
                    "sense_definition": "Шершавый, загрубелый, покрытый мозолями или ороговевший.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Погрузив лицо в <w>заскорузлые</w> ладони, он долго смотрел на огонь."
                        },
                        {
                            "text": "На столе лежал <w>заскорузлый</w> пирожок, который явно пролежал там несколько дней."
                        }
                    ],
                    "synonyms": [
                        "загрубелый",
                        "задубелый"
                    ],
                    "antonyms": [
                        "мягкий"
                    ],
                    "common_phrases": [
                        "заскорузлые ладони",
                        "заскорузлая кожа"
                    ]
                },
                {
                    "sense_id": "e2ced692-3d72-315e-849f-1939b1c0d3b6",
                    "sense_definition": "Ставший жёстким от высохшей грязи, пота или других веществ.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На его старой куртке остались <w>заскорузлые</w> пятна от засохшей краски."
                        },
                        {
                            "text": "Рабочие носили <w>заскорузлые</w> фартуки, пропитанные машинным маслом и пылью."
                        }
                    ],
                    "synonyms": [
                        "задубелый"
                    ],
                    "common_phrases": [
                        "заскорузлый фартук"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи"
                        }
                    ]
                },
                {
                    "sense_id": "99555739-2140-39ed-b43b-42b60482c3e1",
                    "sense_definition": "Грубый, чёрствый, лишённый чуткости и сострадания.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "character_traits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Даже самая <w>заскорузлая</w> душа может оттаять от искреннего проявления доброты."
                        },
                        {
                            "text": "Он был человеком <w>заскорузлым</w> и никогда не понимал чужих страданий."
                        }
                    ],
                    "synonyms": [
                        "чёрствый"
                    ]
                },
                {
                    "sense_id": "53e43968-496a-3906-b83c-f75b22e7c095",
                    "sense_definition": "Косный, невосприимчивый к новым идеям или переменам.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "character_traits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Молодежь часто считает старшее поколение <w>заскорузлыми</w> консерваторами."
                        },
                        {
                            "text": "Его <w>заскорузлый</w> взгляд на мир мешал ему принять современные технологии."
                        }
                    ]
                }
            ]
        }
    ]
