                    {
                        "translation_id": "7385c8a2-18c7-4d20-a02e-59b4607860e2",
                        "source_entry_id": "4afe4975-3087-3350-a3b0-bb901a4219f6",
                        "source_sense_id": "cc05cf2e-d6f6-3049-88e0-25a47357a797",
