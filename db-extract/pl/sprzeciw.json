                    {
                        "translation_id": "21789ad6-9e0a-43b6-9cd3-56a123fd5687",
                        "source_entry_id": "f2ef837a-ad7f-3d9d-8253-f55768f27820",
                        "source_sense_id": "5a555111-5ead-3581-87b6-fce62f853f0b",
                        "target_lang_word": "protesta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protesta",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "ce40b015-5125-35c6-8cf8-82099a5d1132",
                                        "entry_id": "b7ca2d3f-4816-3edc-adf7-a33642debb06",
                                        "glosses": [
                                            "Manifestación exhibición pública (o marcha) de la opinión de un grupo activista (económica, política o social, sobre todo), mediante una congregación en las calles, a menudo en un lugar o una fecha simbólicos y asociados con esa opinión."
                                        ],
                                        "tags": [],
