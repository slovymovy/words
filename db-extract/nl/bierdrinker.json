                            {
                                "example_id": "61ddb184-a879-4bf1-8dfd-d31fe917533b",
                                "sense_id": "1ad2e477-f20f-3613-abe6-f8b9483cdd68",
                                "text": "Hij is geblessseerd en daarnaast ook nog eens geschorst. Maar niets kan de Denen stoppen. John Jensen, die zichzelf omschrijft als gepassioneerd bierdrinker, zet de Denen op voorsprong. Kim Vilfort zet twaalf minuten voor het einde de 2-0 op het scorebord."
                            },
                            {
                                "example_id": "da5c59bd-3bc7-48e2-9737-4b43363adc3b",
                                "sense_id": "1ad2e477-f20f-3613-abe6-f8b9483cdd68",
                                "text": "Obama staat bekend als een bierdrinker. Hij wordt graag op de foto gezet met een biertje in zijn hand. Het wordt ook in de verkiezingscampagne gebruikt, omdat zijn Republikeinse tegenstander Mitt Romney geheelonthouder is."
                            },
