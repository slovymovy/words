                        "source_sense_id": "33acd903-df23-3974-84f6-7c20611e9bb3",
                        "source_sense_description": "burning; especially the act or practice of cremating the dead, burning a corpse",
                        "target_lang_word": "crémation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
