        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "38b5788f-6939-38ac-ba2b-87ca1d578707",
                    "sense_definition": "Команда на съёмочной площадке для начала записи звука и изображения.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "cinema_command",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Режиссёр громко крикнул: «<w>Мотор</w>!», и съёмка началась.",
                            "target_lang_translations": {
                                "en": "The director shouted: \"<w>Action</w>!\", and filming began.",
                                "fr": "Le réalisateur a crié d'une voix forte : « <w>Moteur !</w> », et le tournage a commencé."
                            }
                        },
                        {
                            "text": "После команды «<w>Мотор</w>!» на площадке воцарилась полная тишина.",
                            "target_lang_translations": {
                                "en": "After the command \"<w>Action</w>!\", complete silence reigned on the set.",
                                "fr": "Après l'ordre « <w>Moteur !</w> », un silence complet s'est installé sur le plateau."
                            }
                        }
                    ],
                    "synonyms": [
                        "камера"
                    ],
                    "antonyms": [
                        "стоп",
                        "снято"
                    ],
                    "target_lang_definitions": {
                        "en": "A command used on a film set to start recording.",
                        "fr": "Ordre donné sur un plateau de tournage pour lancer l'enregistrement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Action!",
                                "target_lang_sense_clarification": "command to start filming"
                            },
                            {
                                "target_lang_word": "Roll camera",
                                "target_lang_sense_clarification": "technical command"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "moteur !",
                                "target_lang_sense_clarification": "interjection sur un plateau de tournage pour lancer les prises"
                            },
