                ],
                "senses": [
                    {
                        "sense_id": "2e6775ed-e963-342d-9666-17378789640c",
                        "entry_id": "98fbae47-b9f3-382e-9e2e-066281edb73b",
                        "glosses": [
                            "Femme qui spécialement était chargée de remuer l’enfant d’un prince, d’un grand seigneur, c’est-à-dire de le nettoyer et de le changer de langes."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8d9924ba-cb67-4a58-b077-962060065afa",
                                "sense_id": "2e6775ed-e963-342d-9666-17378789640c",
                                "text": "La remueuse, elle, couchait dans la chambre du prince pendant trois ans, puis elle laissait sa place à la première femme de chambre."
                            },
                            {
                                "example_id": "459cae9d-edee-4521-ae2c-abcdbdae1ee6",
                                "sense_id": "2e6775ed-e963-342d-9666-17378789640c",
                                "text": "[…] ; cette succession de grands noms de duchesses, de marquises et de belles dames, les gouvernantes et les sous-gouvernantes, et les dames pour accompagner, les femmes de chambre, les dames d’atours, les habilleuses, les berceuses, les feutières, les remueuses, tout un monde de femmes qu’on se représente si élégamment délicates, si pleines de respectueuses attentions pour l’enfant qui leur est confié."
                            },
                            {
                                "example_id": "52882340-5b78-467b-bc04-370274503fa1",
                                "sense_id": "2e6775ed-e963-342d-9666-17378789640c",
                                "text": "Philippe (fils de François Joachim de Pierre de Bernis) fut élevé au château, confié aux soins d'une nourrice et d’une remueuse choisies avec minutie."
                            }
                        ]
                    },
                    {
                        "sense_id": "32fbecf8-e26c-3270-96c1-483abca7c098",
                        "entry_id": "98fbae47-b9f3-382e-9e2e-066281edb73b",
                        "glosses": [
                            "Ouvrière chargée du remuage des bouteilles de champagne."
                        ],
