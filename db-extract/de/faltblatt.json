                                    {
                                        "sense_id": "fb80c0f6-c594-31f8-9b7d-f2e1f015d405",
                                        "entry_id": "6ab2992e-421b-3e98-8f06-c5d93280d828",
                                        "glosses": [
                                            "Qui peut être déplié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed29abda-c019-4114-8ce8-3c3980067270",
                                                "sense_id": "fb80c0f6-c594-31f8-9b7d-f2e1f015d405",
                                                "text": "Le grand art en livres de poche, pages non foliotées, nombreuses planches couleurs dont plusieurs dépliantes."
                                            },
                                            {
                                                "example_id": "4108737a-b869-4641-9788-df4e1ba3c563",
                                                "sense_id": "fb80c0f6-c594-31f8-9b7d-f2e1f015d405",
                                                "text": "L'intégrale du texte et des illustrations a habilement été disposée de manière à créer six grandes scènes dépliantes et une multitude de fenêtres animées."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
