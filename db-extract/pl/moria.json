                ],
                "senses": [
                    {
                        "sense_id": "afcaf0d4-89ef-3456-8baf-d8c26a3c2d4a",
                        "entry_id": "82c46f8a-ed2b-3ee5-bba8-8c7815e4e304",
                        "glosses": [
                            "dawna nazwa Wzgórza Świątynnego w Jerozolimie, występującego w Starym Testamencie jako miejsce ofiary Abrahama"
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
                            {
                                "example_id": "961da878-bd28-4eac-825d-84f211c4a0e6",
                                "sense_id": "afcaf0d4-89ef-3456-8baf-d8c26a3c2d4a",
                                "text": "Weź twego syna jedynego, którego miłujesz, Izaaka, idź do kraju Moria i tam złóż go w ofierze na jednym z pagórków, jakie ci wskażę"
                            },
                            {
                                "example_id": "ef6040f7-40cb-4497-a141-2968f092d801",
                                "sense_id": "afcaf0d4-89ef-3456-8baf-d8c26a3c2d4a",
                                "text": "A gdy powstanie olbrzym Goliath, / by złamać młodość mą – / Błagają ciebie Syjon, Moria: / ku wspomożeniu zstąp!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "035f4704-9223-362c-b3ad-afe0130ab501",
                        "entry_id": "82c46f8a-ed2b-3ee5-bba8-8c7815e4e304",
                        "glosses": [
                            "wieś i obóz dla uchodźców w Grecji, na wyspie Lesbos, na północ od Mityleny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd028527-bccc-4d9f-b140-c484c40bceed",
                                "sense_id": "035f4704-9223-362c-b3ad-afe0130ab501",
                                "text": "W obozie dla uchodźców Moria, na greckiej wyspie Lesbos, przebywa obecnie 19 tysięcy osób, choć sam obóz może przyjąć tylko trzy tysiące"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "a9e6e55d-8f83-3113-b3c1-910c2cb0b1b8",
                        "entry_id": "82c46f8a-ed2b-3ee5-bba8-8c7815e4e304",
                        "glosses": [
                            "fikcyjne podziemne miasto w powieści Johna Ronalda Reuela Tolkiena"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "973dba41-bd62-37ee-9645-64d7fff7c680",
                        "entry_id": "82c46f8a-ed2b-3ee5-bba8-8c7815e4e304",
                        "glosses": [
                            "nimfa z mitologii greckiej, jedna z Najad"
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.4\""
                    }
