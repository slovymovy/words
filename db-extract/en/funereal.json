                    },
                    {
                        "translation_id": "5e3634e7-58ba-49eb-8af7-d32d9a5ff2c2",
                        "source_entry_id": "64303538-0185-3365-a70f-9bfdc9a92d04",
                        "source_sense_description": "relating to a funeral",
                        "target_lang_word": "funéraire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "funéraire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f79b5f84-3a48-3ba4-94ef-2536d1a6cdb9",
                                        "entry_id": "a271f1ff-c97b-3299-bc2a-e72d7b6a1b70",
                                        "glosses": [
                                            "Qui a rapport aux funérailles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2ec9e5a-2b36-4788-bb53-44698c200196",
                                                "sense_id": "f79b5f84-3a48-3ba4-94ef-2536d1a6cdb9",
                                                "text": "Le Circo Giacomo quitta cette froide ville de l’est sans Troppo qui, parti sur ses deux pieds, allait revenir où il était né dans un fourgon funéraire."
                                            },
                                            {
                                                "example_id": "d6ec9889-8dd8-48d7-a115-e469ab08b035",
                                                "sense_id": "f79b5f84-3a48-3ba4-94ef-2536d1a6cdb9",
                                                "text": "Frais funéraires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37389fe7-115e-33f8-9c27-cfb051578e63",
                                        "entry_id": "a271f1ff-c97b-3299-bc2a-e72d7b6a1b70",
                                        "glosses": [
                                            "Qui a rapport à la mort, aux restes ou au souvenir d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7727cf2-641e-43a8-9871-74ae7dc194c4",
                                                "sense_id": "37389fe7-115e-33f8-9c27-cfb051578e63",
                                                "text": "L’archéologie funéraire livre également des informations d’ordre cultuel avec, par exemple, la nature des dépôts végétaux contenus dans la tombe : litières d’herbes, de fougères, ou offrandes végétales dans des vases qui accompagnent le défunt."
                                            },
                                            {
                                                "example_id": "99f9a804-0ead-4f92-92d9-b41ed98328cb",
                                                "sense_id": "37389fe7-115e-33f8-9c27-cfb051578e63",
                                                "text": "Souvent, histoire de passer le temps, les paléopathologistes entrent dans les églises dans l’espoir d’y repérer une tombe atypique, une relique extravagante, une inscription funéraire plus ou moins attirante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8afef216-d8b1-4b65-a826-3995a8a09b26",
                        "source_entry_id": "64303538-0185-3365-a70f-9bfdc9a92d04",
                        "source_sense_description": "relating to a funeral",
                        "target_lang_word": "funèbre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "funèbre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                                        "entry_id": "baa450f2-43d8-3c10-8d09-966cc66951b0",
                                        "glosses": [
                                            "Qui a rapport aux funérailles."
                                        ],
                                        "tags": [
                                            "Funéraire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c79f50a6-fd18-4041-b0ee-609b727ee9d3",
                                                "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                                                "text": "Les convois funèbres se succédaient, avec leurs escortes de sous-officiers boueux et de rosses efflanquées."
                                            },
                                            {
                                                "example_id": "136b5733-0f6f-45cb-b2d4-bb6bc7df5a4f",
                                                "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                                                "text": "L'Erèbe les eût pris pour ses coursiers funèbres,\nS'ils pouvaient au servage incliner leur fierté. – Charles Baudelaire [1821-1867], \"Les chats\", in Les Fleurs du mal (1857)."
                                            },
                                            {
                                                "example_id": "330af68a-8614-46b4-8093-2776271dbc4f",
                                                "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                                                "text": "Sois donc le crieur du devoir\nÔ notre funèbre oiseau noir ! – Arthur Rimbaud [1854-1891], \"Les corbeaux\" (1872)"
                                            },
                                            {
                                                "example_id": "4397997e-0fc2-4472-9ae1-1a04f7335f0d",
                                                "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                                                "text": "Enfin, sur l’ordre du docteur, on transporta dans la salle de mairie le funèbre colis que deux hommes dévoués dévêtirent et fouillèrent."
                                            },
                                            {
                                                "example_id": "5ceb63f8-93a6-49b5-aa30-9bb19afc4840",
                                                "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                                                "text": "[…] les convives d'un repas funèbre devant bientôt s'attabler en cette maison, il importe que je prépare consciencieusement la tête de veau dont ils m'ont passé commande."
                                            },
                                            {
                                                "example_id": "a6bbf696-71bb-49ea-aa17-0226ac5f8e09",
                                                "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                                                "text": "Advienne que pourra, il doit l'assister auprès du défunt, jusqu'à la mise en fosse et monter avec elle la garde funèbre."
                                            },
                                            {
                                                "example_id": "2c32cdc9-ee54-451e-b0d3-0d5946691aaf",
                                                "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                                                "text": "Il était affreux de songer que le déroulement correct d’une cérémonie funèbre pouvait apporter aux proches du défunt une sorte de soulagement et comme le sentiment d’une réussite mondaine dans le malheur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb5cfc2c-ea8b-3127-a72e-bc98d2b258f8",
                                        "entry_id": "baa450f2-43d8-3c10-8d09-966cc66951b0",
                                        "glosses": [
                                            "Qui est lugubre ; qui éveille l’idée de la mort."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "037ecf39-4bc7-4506-a2aa-68aaf93dcec2",
                                                "sense_id": "fb5cfc2c-ea8b-3127-a72e-bc98d2b258f8",
                                                "text": "[…]; tous tenaient à la main droite ou des épées, ou des piques, ou des arquebuses, et quelques-uns, à la main gauche, des flambeaux qui répandaient sur cette scène un jour funèbre et vacillant, […]."
                                            },
                                            {
                                                "example_id": "f3bc22bf-f6f6-4158-9dae-1e173654a3a6",
                                                "sense_id": "fb5cfc2c-ea8b-3127-a72e-bc98d2b258f8",
                                                "text": "Le bruit, les allées et venues des gens m'alertèrent. J'accourus avec un funèbre pressentiment, sans toutefois penser à un malheur aussi terrible."
                                            },
                                            {
                                                "example_id": "5350b011-f095-49b7-ad73-9ff580fcd8b0",
                                                "sense_id": "fb5cfc2c-ea8b-3127-a72e-bc98d2b258f8",
                                                "text": "Au bout d'un couloir funèbre et saugrenu dont la disposition avait je ne sais quoi de caligaresque, l'entrée de La Java ne fait guère impression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60663094-22d0-3db3-8250-f0a2a3e4bffc",
                                        "entry_id": "baa450f2-43d8-3c10-8d09-966cc66951b0",
                                        "glosses": [
                                            "Qualifie certains oiseaux nocturnes, dont le cri a quelque chose de sinistre."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54f89b74-e656-482f-8ec2-47cbc1a9d468",
                                                "sense_id": "60663094-22d0-3db3-8250-f0a2a3e4bffc",
                                                "text": "Oiseaux funèbres, se dit de certains oiseaux nocturnes. – Dictionnaire de l'Académie française, 9e éd. (1992)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "funèbre",
                                "target_lang_code": "fr",
                                "target_senses": [
