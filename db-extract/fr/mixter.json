                "senses": [
                    {
                        "sense_id": "dc29bfbe-f04b-3217-84c9-03622e3eb5bc",
                        "entry_id": "b506234d-09fd-305c-8030-3a4919e24bb4",
                        "glosses": [
                            "Rendre mixte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52b0c59f-26be-4ca4-b806-3936cd9a4767",
                                "sense_id": "dc29bfbe-f04b-3217-84c9-03622e3eb5bc",
                                "text": "Reprenant le travail après 3 mois et demi j'ai commencé à \"mixter\" l'allaitement, en remplaçant progressivement les tétées par un biberon."
                            },
                            {
                                "example_id": "70585bf6-4adf-4201-be84-aa0936e5544f",
                                "sense_id": "dc29bfbe-f04b-3217-84c9-03622e3eb5bc",
                                "text": "Je répondrai simplement en disant que Nathalie donne la réponse sur la mixité : tous les FM peuvent choisir leurs loges et donc s'ils veulent se \"mixter\" ou pas..."
                            },
                            {
                                "example_id": "b6be64a2-98d1-4e0a-baf0-14edb958715e",
                                "sense_id": "dc29bfbe-f04b-3217-84c9-03622e3eb5bc",
                                "text": "Sans aucune loi, décret, circulaire ou recommandation officielle les écoles vont peu à peu se \"mixter\" progressivement jusque dans les années 70."
                            },
                            {
                                "example_id": "a1e5a937-02ec-4fac-a559-e7f8203cf9ea",
                                "sense_id": "dc29bfbe-f04b-3217-84c9-03622e3eb5bc",
                                "text": "J'arrive un jour à St Urbain où la direction diocésaine avait décidé de \"mixter\" l'école privée des garçons et celle des filles."
                            }
                        ]
                    }
                ],
