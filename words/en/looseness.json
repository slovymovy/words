                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic noticed excessive <w>looseness</w> in the steering wheel and recommended immediate repairs."
                        },
                        {
                            "text": "See if that nut has too much <w>looseness</w> and tighten it if it does."
                        }
                    ],
                    "synonyms": [
                        "slackness",
                        "play"
                    ],
                    "antonyms": [
