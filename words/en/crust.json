{
    "word_family": [
        "crusty",
        "encrust",
        "crustal",
        "decrust"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03c5430f-627f-3402-9542-cee07088e4ab",
                    "sense_definition": "The hard, dry outer layer of a loaf of bread or similar food.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She cut the <w>crusts</w> off the sandwich because the children preferred soft bread.",
                            "target_lang_translations": {
                                "ru": "Она срезала <w>ко́рки</w> с сэндвича, потому что дети предпочитали мягкий хлеб.",
                                "zh": "她把三明治的<w>面包皮</w>切掉了，因为孩子们更喜欢吃软的面包。"
                            }
                        },
                        {
                            "text": "I enjoy eating fresh bread with a thick, crunchy <w>crust</w>.",
                            "target_lang_translations": {
                                "ru": "Мне нравится есть свежий хлеб с толстой, хрустящей <w>ко́рочкой</w>.",
                                "zh": "我喜欢吃那种带有厚实、酥脆<w>面包皮</w>的新鲜面包。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cut the crusts off",
                        "bread crust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твёрдый, сухой наружный слой буханки хлеба или подобной еды.",
                        "zh": "面包等食物表面坚硬干燥的外层。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ко́рка",
                                "target_lang_sense_clarification": "твёрдый слой хлеба"
                            },
                            {
                                "target_lang_word": "ко́рочка",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное, часто о хрустящей части"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "面包皮",
                                "target_lang_sense_clarification": "面包外层的硬皮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "491f4d9c-e55a-3fa6-892b-e53b1ac6ae0f",
                    "sense_definition": "The bread-like base of a pizza, especially the raised outer edge.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered a large pepperoni pizza with a cheese-stuffed <w>crust</w>.",
                            "target_lang_translations": {
                                "ru": "Мы заказали большую пиццу пепперони с сырным <w>бо́ртиком</w>.",
                                "zh": "我们点了一个大号意大利辣香肠披萨，配的是芝心<w>饼边</w>。"
                            }
                        },
                        {
                            "text": "He ate all the toppings but left the hard <w>crust</w> on the plate.",
                            "target_lang_translations": {
                                "ru": "Он съел всю начинку, но оставил твёрдую <w>ко́рочку</w> на тарелке.",
                                "zh": "他吃光了上面的馅料，却把坚硬的<w>饼边</w>留在了盘子里。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "thin crust",
                        "thick crust",
                        "stuffed crust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хлебная основа пиццы, особенно её приподнятый внешний край.",
                        "zh": "披萨的饼底，尤指其隆起的边缘部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ко́рочка",
                                "target_lang_sense_clarification": "хрустящий край пиццы"
                            },
                            {
                                "target_lang_word": "бо́ртик",
                                "target_lang_sense_clarification": "край пиццы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "饼边",
                                "target_lang_sense_clarification": "披萨外圈的饼皮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c394cb94-00f2-35a3-81cb-d3a891bb69c5",
                    "sense_definition": "The pastry shell that covers or forms the base of a pie or tart.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The apple pie had a golden, flaky <w>crust</w> that tasted delicious.",
                            "target_lang_translations": {
                                "ru": "У яблочного пирога была золотистая слоистая <w>ко́рочка</w>, очень вкусная.",
                                "zh": "这个苹果派有着金黄酥脆的<w>酥皮</w>，味道好极了。"
                            }
                        },
                        {
                            "text": "You must keep the butter cold to make a perfect pastry <w>crust</w>.",
                            "target_lang_translations": {
                                "ru": "Нужно держать масло холодным, чтобы сделать идеальное <w>те́сто</w> для пирога.",
                                "zh": "你必须保持黄油低温，才能做出完美的点心<w>酥皮</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pie crust",
                        "pastry crust",
                        "flaky crust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оболочка из теста, покрывающая пирог или образующая его основу.",
                        "zh": "包裹或构成馅饼、塔类点心的酥皮外壳。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ко́рочка",
                                "target_lang_sense_clarification": "запечённое тесто"
                            },
                            {
                                "target_lang_word": "те́сто",
                                "target_lang_sense_clarification": "мучная основа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酥皮",
                                "target_lang_sense_clarification": "点心的外壳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f860721d-5a7a-379b-9b8c-809c32ee6542",
                    "sense_definition": "The solid, outermost layer of the Earth or another planet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geologists study the movement of tectonic plates within the Earth's <w>crust</w>.",
                            "target_lang_translations": {
                                "ru": "Геологи изучают движение тектонических плит внутри земной <w>коры́</w>.",
                                "zh": "地质学家研究<w>地壳</w>内构造板块的运动。"
                            }
                        },
                        {
                            "text": "The oceanic <w>crust</w> is generally thinner and denser than the continental one.",
                            "target_lang_translations": {
                                "ru": "Океаническая <w>кора́</w> обычно тоньше и плотнее континентальной.",
                                "zh": "大洋<w>地壳</w>通常比大陆地壳更薄、密度更大。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Earth's crust",
                        "continental crust",
                        "oceanic crust"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Твёрдая внешняя оболочка Земли или другой планеты.",
                        "zh": "地球或其他行星最外层的固体壳层。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кора́",
                                "target_lang_sense_clarification": "геологическая оболочка"
                            },
                            {
                                "target_lang_word": "земна́я кора́",
                                "target_lang_sense_clarification": "устойчивое словосочетание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地壳",
                                "target_lang_sense_clarification": "地球的岩石外壳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3adb151-e6b7-32d1-9ca8-f9400ca49502",
                    "sense_definition": "A hard, dry layer that forms on the surface of something soft or liquid.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "general_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the rain froze, a thin <w>crust</w> of ice covered the snow.",
                            "target_lang_translations": {
                                "ru": "После того как дождь замёрз, тонкая ледяная <w>ко́рка</w> покрыла снег.",
                                "zh": "雨水结冰后，雪面上覆盖了一层薄薄的冰<w>硬壳</w>。"
                            }
                        },
                        {
                            "text": "The mud had dried in the sun, forming a hard <w>crust</w> on top.",
                            "target_lang_translations": {
                                "ru": "Грязь высохла на солнце, образовав сверху твёрдую <w>ко́рку</w>.",
                                "zh": "泥土在阳光下晒干，表面形成了一层坚硬的<w>硬壳</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "form a crust",
                        "surface crust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твёрдый слой, образующийся на поверхности чего-либо мягкого или жидкого.",
                        "zh": "在柔软或液体物质表面形成的坚硬干燥层。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ко́рка",
                                "target_lang_sense_clarification": "затвердевший слой (льда, грязи)"
                            },
                            {
                                "target_lang_word": "наст",
                                "target_lang_sense_clarification": "твёрдая корка на снегу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "硬壳",
                                "target_lang_sense_clarification": "表面形成的坚硬覆盖物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdc31fd3-47bf-3fdd-a3da-334e92786334",
                    "sense_definition": "Money earned to support oneself; a means of living.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "livelihood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He works two jobs just to earn a <w>crust</w> for his family.",
                            "target_lang_translations": {
                                "ru": "Он работает на двух работах, просто чтобы заработать на <w>кусо́к хле́ба</w> для своей семьи.",
                                "zh": "他打两份工，只是为了能养家<w>糊口</w>。"
                            }
                        },
                        {
                            "text": "It is difficult for artists to make a decent <w>crust</w> in this economy.",
                            "target_lang_translations": {
                                "ru": "Художникам трудно заработать достойный <w>кусо́к хле́ба</w> в нынешней экономике.",
                                "zh": "在当前的经济环境下，艺术家很难赚到足够的钱来<w>糊口</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "livelihood",
                        "income"
                    ],
                    "common_phrases": [
                        "earn a crust",
                        "make a crust"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деньги, заработанные на жизнь; средства к существованию.",
                        "zh": "维持生计的收入或谋生手段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кусо́к хле́ба",
                                "target_lang_sense_clarification": "идиома: средства к существованию"
                            },
                            {
                                "target_lang_word": "хлеб",
                                "target_lang_sense_clarification": "метафорически: заработок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "糊口",
                                "target_lang_sense_clarification": "维持基本生活"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ec9fc9f-dff1-3871-8031-a5be360709b2",
                    "sense_definition": "Impudence, nerve, or audacity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot believe he had the <w>crust</w> to ask for a raise after missing work.",
                            "target_lang_translations": {
                                "ru": "Не могу поверить, что ему хватило <w>на́глости</w> просить о повышении после прогула.",
                                "zh": "真不敢相信，他旷工之后竟然还有<w>厚脸皮</w>要求加薪。"
                            }
                        },
                        {
                            "text": "She showed a lot of <w>crust</w> by standing there and lying to my face.",
                            "target_lang_translations": {
                                "ru": "Она проявила неслыханную <w>на́глость</w>, стоя там и лгя мне в лицо.",
                                "zh": "她站在那儿当面撒谎，真是太<w>厚脸皮</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "dated"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наглость, дерзость или бесцеремонность.",
                        "zh": "厚颜无耻或胆大妄为的态度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на́глость",
                                "target_lang_sense_clarification": "дерзкое поведение"
                            },
                            {
                                "target_lang_word": "де́рзость",
                                "target_lang_sense_clarification": "грубость, непочтительность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "厚脸皮",
                                "target_lang_sense_clarification": "形容人不知羞耻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20cc8e83-ea01-3196-ab23-268fa8a9d7bb",
                    "sense_definition": "The first or last slice of a loaf of bread.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nobody wanted to eat the <w>crust</w>, so we used it to make breadcrumbs.",
                            "target_lang_translations": {
                                "ru": "Никто не хотел есть <w>горбу́шку</w>, поэтому мы пустили её на панировочные сухари.",
                                "zh": "没人想吃<w>面包头</w>，所以我们把它做成了面包屑。"
                            }
                        },
                        {
                            "text": "He prefers the <w>crust</w> because it is thicker and chewier than the other slices.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает <w>горбу́шку</w>, потому что она толще и жестче других ломтиков.",
                                "zh": "他更喜欢吃<w>面包头</w>，因为它比其他切片更厚、更有嚼劲。"
                            }
                        }
                    ],
                    "synonyms": [
                        "heel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Первый или последний ломоть буханки хлеба.",
                        "zh": "整块面包的第一片或最后一片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горбу́шка",
                                "target_lang_sense_clarification": "край буханки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "面包头",
                                "target_lang_sense_clarification": "面包两端的切片"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d35a5f7-016b-359e-a135-538e82e54370",
                    "sense_definition": "To form a hard outer layer or become covered with a hard layer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The snow began to <w>crust</w> over as the temperature dropped below freezing.",
                            "target_lang_translations": {
                                "ru": "Снег начал <w>покрыва́ться ко́ркой</w>, когда температура опустилась ниже нуля.",
                                "zh": "随着气温降至冰点以下，雪面开始<w>结壳</w>。"
                            }
                        },
                        {
                            "text": "You should let the wound <w>crust</w> naturally to protect it while it heals.",
                            "target_lang_translations": {
                                "ru": "Вам следует дать ране <w>покры́ться ко́ркой</w> естественным образом, чтобы защитить её во время заживления.",
                                "zh": "你应该让伤口自然<w>结壳</w>，以便在愈合过程中起到保护作用。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crust over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образовывать твёрдый внешний слой или покрываться им.",
                        "zh": "在表面形成坚硬的外壳或被硬壳覆盖。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрыва́ться ко́ркой",
                                "target_lang_sense_clarification": "затвердевать снаружи"
                            },
                            {
                                "target_lang_word": "затвердева́ть",
                                "target_lang_sense_clarification": "становиться твёрдым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结壳",
                                "target_lang_sense_clarification": "表面变硬"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}