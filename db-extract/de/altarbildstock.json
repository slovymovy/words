                "senses": [
                    {
                        "sense_id": "05eab042-8c12-33fb-8215-b1eef4d6674d",
                        "entry_id": "d07b3814-84ba-3d83-8650-cfec5cc151dc",
                        "glosses": [
                            "Bildstock mit aufgesetztem kleinem Altar oder Bildelementen davon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "070c3e9c-984a-4a9f-96e4-0bdc3f67c1cc",
                                "sense_id": "05eab042-8c12-33fb-8215-b1eef4d6674d",
                                "text": "„Der Altarbildstock \"Heilige Dreifaltigkeit\" besitzt die Inschrift \"Gelobt Sey Jesus Christus\" (Anno 1797)"
                            },
                            {
                                "example_id": "5863e358-4537-49e2-9cb1-515430d7c136",
                                "sense_id": "05eab042-8c12-33fb-8215-b1eef4d6674d",
                                "text": "„Der Altarbildstock bei Strick liegt in freier Feldlage und ist jetzt restauriert und mit einem schmiedeeisernen Zaun versehen worden“"
                            },
                            {
                                "example_id": "331babbc-2811-4346-b5fb-b48d63524276",
                                "sense_id": "05eab042-8c12-33fb-8215-b1eef4d6674d",
                                "text": "„Daß das Fünfwundenmotiv nicht ausschließlich auf Holzkreuzen angebracht wurde, beweist ein steinerner Altarbildstock aus dem 18.Jahrhundert in Seckach (Krs. Buchen).“"
                            },
                            {
                                "example_id": "414da29e-0199-4123-ab01-8fda092cb491",
                                "sense_id": "05eab042-8c12-33fb-8215-b1eef4d6674d",
                                "text": "„Für die Restaurierung des so genannten Altarbildstocks aus dem Jahre 1856 machte sich der Kulturverein Lindach stark.“"
                            },
                            {
                                "example_id": "688bda4e-2b65-45f1-8a1c-1473909adfa6",
                                "sense_id": "05eab042-8c12-33fb-8215-b1eef4d6674d",
                                "text": "„Der Altarbildstock wird als religiöses Wahrzeichen und Ausdruck einer tiefen Frömmigkeit nach wie vor von vielen Gläubigen aufgesucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
