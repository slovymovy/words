                                    {
                                        "sense_id": "4aabbc61-6ffc-3307-b88b-9e2a92b07875",
                                        "entry_id": "39d81711-cad5-39bb-8154-842e8aad594e",
                                        "glosses": [
                                            "van een persoon dat deze aarzelt of twijfelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8d24134-6040-4905-bf3b-e34c37336181",
                                                "sense_id": "4aabbc61-6ffc-3307-b88b-9e2a92b07875",
                                                "text": "Dembélé brak eindelijk door vanaf links en gaf voor op Suárez, die de weifelende Ramos te snel af was."
                                            },
                                            {
                                                "example_id": "8b34c457-9083-49dd-b9cb-ebf0a63ee4f1",
                                                "sense_id": "4aabbc61-6ffc-3307-b88b-9e2a92b07875",
                                                "text": "Willem II-reservekeeper Michael Woud had een heel wat mindere middag. Hij kreeg een 3,5 voor zijn weifelende optreden tegen FC Emmen."
                                            },
                                            {
                                                "example_id": "a863bfd4-6574-461f-a99b-6038c6d7e2a3",
                                                "sense_id": "4aabbc61-6ffc-3307-b88b-9e2a92b07875",
                                                "text": "Gisterenavond werd bekend dat de opening van regionaal vliegveld Lelystad opnieuw is uitgesteld - deze keer voor onbepaalde tijd. Stikstof en een weifelende Europese Commissie halen volgens luchtvaartminister Cora van Nieuwenhuizen een streep door de ‘keiharde’ openingsdatum van april 2020."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc0709ae-7f62-4ab7-91e9-43bb3108ddc3",
                        "source_entry_id": "471de537-3be8-3dbd-9e8c-bd0de6b8903e",
                        "source_sense_id": "eff1be40-46e8-3fc9-abc6-b9752785e790",
