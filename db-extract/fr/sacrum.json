                                                "example_id": "122301a4-9fd8-4617-90ef-82eb99cba814",
                                                "sense_id": "006b4351-4ac5-350e-87a4-0c23fd4c5349",
                                                "text": "Das Kreuzbein ist ein Teil des menschlichen Körpers."
                                            }
