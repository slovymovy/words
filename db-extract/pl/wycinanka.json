                "senses": [
                    {
                        "sense_id": "2879f505-bd35-357b-962c-685ffe44c628",
                        "entry_id": "3527f3a4-6818-3939-8413-68a7eb553f80",
                        "glosses": [
                            "praca plastyczna wykonana z kawałków papieru"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0c8ae18c-ecc3-3caa-b41a-d14cf51722ef",
                        "entry_id": "3527f3a4-6818-3939-8413-68a7eb553f80",
                        "glosses": [
                            "ludowa ozdoba wycięta z papieru (często barwnego lub różnokolorowego) wykorzystująca motywy figuralne, różne rodzaje symetrii oraz łączenie i rytmiczne powtarzanie motywów w układach poziomych lub pionowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46144dc4-f375-4d29-b7d8-ab51d749445d",
                                "sense_id": "0c8ae18c-ecc3-3caa-b41a-d14cf51722ef",
                                "text": "Żeby mówić o historii decoupage'u, musimy się cofnąć na początek XII w., kiedy to chińscy wieśniacy tworzyli papierowe wycinanki w żywych kolorach, aby zdobić nimi okna, latarnie, pudełka z prezentami i inne przedmioty."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9182ebe1-3f07-4ceb-876e-61432066c501",
                        "source_entry_id": "3527f3a4-6818-3939-8413-68a7eb553f80",
                        "source_sense_id": "2879f505-bd35-357b-962c-685ffe44c628",
                        "target_lang_word": "cut-out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cut-out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f616700-f30d-3a37-a631-93380d2fd85a",
                                        "entry_id": "07ae02ec-b263-3c7b-99f3-c594e91dee1a",
                                        "glosses": [
                                            "A hole or space produced when something is removed by cutting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55aa8407-cc04-4d84-bd6c-b7c94cdc0f81",
                                                "sense_id": "4f616700-f30d-3a37-a631-93380d2fd85a",
                                                "text": "a dress with cut-out sides"
                                            },
                                            {
                                                "example_id": "dd1c7858-b33d-4f87-b645-dd106ad9edc4",
                                                "sense_id": "4f616700-f30d-3a37-a631-93380d2fd85a",
                                                "text": "Mr. John L[awrence] Gihon, a well-known photographer, knowing the difficulty which many have experienced in the making and use of the medallions, has made for the trade some very fine medallions and masks or cut-outs of different sizes."
                                            },
                                            {
                                                "example_id": "f7a9ec9f-a92c-44ef-8f30-6798cd54e9c6",
                                                "sense_id": "4f616700-f30d-3a37-a631-93380d2fd85a",
                                                "text": "A basic characteristic of compression-loaded square isotropic plates with large cut-outs, that is somewhat counter-intuitive at first glance, is that under certain circumstances they exhibit higher buckling loads than corresponding plates without cut-outs."
                                            },
                                            {
                                                "example_id": "4bd54cde-683c-47b8-a32a-3a708081eb37",
                                                "sense_id": "4f616700-f30d-3a37-a631-93380d2fd85a",
                                                "text": "When you pass the ball out along the line and deliberately skip the receiver next to you, it's called a cut-out pass[…]. The pass travels right in front of the adjacent player, but instead of reaching out and taking the ball, he fakes grabbing it and lets it fly by to the next player in the line. The phrase two-man cut-out means that the ball-carrier has thrown the ball past the first two players next to him in the attacking line, sending it instead to the third man in the line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8261d4a-dc0f-35df-9a24-93395caff530",
                                        "entry_id": "07ae02ec-b263-3c7b-99f3-c594e91dee1a",
                                        "glosses": [
                                            "A piece cut out of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ad3865d-c33f-4745-8647-d6ad171c5036",
                                                "sense_id": "b8261d4a-dc0f-35df-9a24-93395caff530",
                                                "text": "Unless a boy is a very good carpenter, and has great patience and plenty of time at his command, I cannot advise him to attempt making a built model,—at all events, not until he has formed several cut-outs first. One of these \"cut-outs\" will serve as a model or form from which he may frame his \"built vessel,\" with such modifications as he may deem necessary."
                                            },
                                            {
                                                "example_id": "019ea7b3-fe9a-441f-933f-144e253076ab",
                                                "sense_id": "b8261d4a-dc0f-35df-9a24-93395caff530",
                                                "text": "When preparing an activity, simply copy the activity cards, cut them apart, and attach them to the cut-outs. If desired, laminate and cut out the assembled cut-outs for extra durability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88e73b07-1e5e-3f4a-aec4-a2fd8d4a16cc",
                                        "entry_id": "07ae02ec-b263-3c7b-99f3-c594e91dee1a",
                                        "glosses": [
                                            "A piece cut out of something.",
                                            "A free-standing, rigid print (usually life-sized), often displayed for promotional purposes; a standee."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7b79f53-d921-40e8-baef-678581472371",
                                                "sense_id": "88e73b07-1e5e-3f4a-aec4-a2fd8d4a16cc",
                                                "text": "The sentry didn't answer. Taking a closer look at him I realised he wasn't a real sentry but a cut-out sentry, guarding not a real but a cut-out border."
                                            },
                                            {
                                                "example_id": "50fe2538-142e-44e7-997c-7f19c33e6d43",
                                                "sense_id": "88e73b07-1e5e-3f4a-aec4-a2fd8d4a16cc",
                                                "text": "The best of friends become the worst of enemies when Barney makes a hilarious attack ad where he viciously pummels a cardboard cut-out of Homer before special guest star Linda Ronstadt joins the fun to both continue the attack on the helpless Homer stand-in and croon a slanderously accurate, insanely catchy jingle about how \"Mr. Plow is a loser/And I think he is a boozer.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "008638f5-abf5-30e8-95a9-cbd5f689424a",
                                        "entry_id": "07ae02ec-b263-3c7b-99f3-c594e91dee1a",
                                        "glosses": [
                                            "A piece cut out of something.",
                                            "A kind of cookie produced in a certain shape by use of a cookie cutter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd847697-453f-47ba-867a-8501d3cd24d5",
                                                "sense_id": "008638f5-abf5-30e8-95a9-cbd5f689424a",
                                                "text": "Use a 1½-inch (4 cm) cutter to remove the center of twelve cookies; the cookie centers need the same baking time. Bake all the cookies (including the center cut-outs) for 12 minutes, or until the bottoms are light golden brown."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ad88caa-30eb-35c8-a2bd-e92ee32a4c39",
                                        "entry_id": "07ae02ec-b263-3c7b-99f3-c594e91dee1a",
                                        "glosses": [
                                            "An item of clothing, such as a dress or shoe, designed with portions cut away."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96be9b3c-7dfc-33ff-8a1c-1db2b69f7e45",
                                        "entry_id": "07ae02ec-b263-3c7b-99f3-c594e91dee1a",
                                        "glosses": [
                                            "A trusted middleman or intermediary, especially in espionage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74f7c0fc-cc30-47df-b8fb-bbb914ec1f5c",
                                                "sense_id": "96be9b3c-7dfc-33ff-8a1c-1db2b69f7e45",
                                                "text": "A cut-out, or intermediary, forms the link between two agents or between an agent and the outside world. He may know very little about the organization and just carry messages, or he may be a liaison officer who is able to answer questions and take decisions; but the important thing is that he should not undertake any other subversive activity. […] A cut-out should be able to contact inconspicuously each of the two agents between whom he is the link."
                                            },
                                            {
                                                "example_id": "66f5503c-9e57-48e8-8e0d-e1f0b7e726e7",
                                                "sense_id": "96be9b3c-7dfc-33ff-8a1c-1db2b69f7e45",
                                                "text": "In alias, I recruited a fellow who worked for a foreign Communist installation (I thought this was a nice touch) to serve as our go-between, or cutout as it is called in the trade, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a284fd0f-33df-3076-9f01-dc46f798a596",
                                        "entry_id": "07ae02ec-b263-3c7b-99f3-c594e91dee1a",
                                        "glosses": [
                                            "A piece of clip art."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d85026b-b25e-346d-b590-1df5de851647",
                                        "entry_id": "07ae02ec-b263-3c7b-99f3-c594e91dee1a",
                                        "glosses": [
                                            "Any of several devices that halt the flow of a current, especially an electric current; a trip-switch or trip."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20e74648-96de-4ee1-864f-4491b37e73d7",
                                                "sense_id": "2d85026b-b25e-346d-b590-1df5de851647",
                                                "text": "The automatic magnetic cut out, opens the circuit between battery and generator when the generator is running slow or engine is stopped, also referred to as the \"vibrator type\" of cut out."
                                            },
                                            {
                                                "example_id": "a5015706-ac12-46d8-ba61-c18a4bf8fe3e",
                                                "sense_id": "2d85026b-b25e-346d-b590-1df5de851647",
                                                "text": "The semiconductor also enhances regulation of the charging system, the older dynamo being controlled by two or three relay-like devices: 1. a cut-out that disconnects the dynamo from the battery when the generated voltage drops below that of the battery, as is the case when the engine is not running."
                                            },
                                            {
                                                "example_id": "abae60e1-ea2c-4084-9433-6bda0ee4b468",
                                                "sense_id": "2d85026b-b25e-346d-b590-1df5de851647",
                                                "text": "[T]he cut-out of a control interrupts or opens the electric circuit. The cut-in closes the electric circuit, and the differential is the difference between the cut-in and the cut-out points. […] As you can see, the differential controls the pressure or temperature difference between the cut-in and cut-out settings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d5b7c53-9ac9-3d1b-bc43-e6bc4f5effd4",
                                        "entry_id": "07ae02ec-b263-3c7b-99f3-c594e91dee1a",
                                        "glosses": [
                                            "A switch that changes the current from one circuit to another, or for shortening a circuit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65c9257c-4235-3f9f-9404-921791ec73d1",
                                        "entry_id": "07ae02ec-b263-3c7b-99f3-c594e91dee1a",
                                        "glosses": [
                                            "A railway cutting."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b04ee21e-b531-387f-837a-5e07f71beaf6",
                                        "entry_id": "07ae02ec-b263-3c7b-99f3-c594e91dee1a",
                                        "glosses": [
                                            "The separation of a group of cattle from a herd; the place where they are collected."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "123e5c48-2c55-4fd6-b322-9a96e941ec09",
                                                "sense_id": "b04ee21e-b531-387f-837a-5e07f71beaf6",
                                                "text": "When the stray men have worked the herd, it is drove off a ways and turned loose. The calves in the cut-out groups are then branded and turned loose with their mothers; the strays are thrown into the stray herd or day herd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dea802c4-de1a-4ab5-8929-12bd12422515",
                        "source_entry_id": "3527f3a4-6818-3939-8413-68a7eb553f80",
                        "source_sense_id": "2879f505-bd35-357b-962c-685ffe44c628",
                        "target_lang_word": "découpage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "découpage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0bd7aa1d-603e-3291-ae7a-402891e10742",
                                        "entry_id": "b950339d-cc11-3bc5-93bc-d475c9933c23",
                                        "glosses": [
                                            "Action de découper, de faire des morceaux avec un objet coupant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acdcabac-2a5d-4894-a045-bd21e70502c3",
                                                "sense_id": "0bd7aa1d-603e-3291-ae7a-402891e10742",
                                                "text": "Le dispositif de découpage le plus répandu est l’oxycoupage toujours employé pour les brames et les blooms, et de plus en plus fréquemment pour les machines à billettes."
                                            },
                                            {
                                                "example_id": "2b932457-76bc-4f04-92da-3eb7f55937c7",
                                                "sense_id": "0bd7aa1d-603e-3291-ae7a-402891e10742",
                                                "text": "Elle comprend, attenant à un paddock, un abattoir à 6 compartiments, une salle de ressuyage, désossage et découpage, des atteliers pour la cuisson des viandes, la préparation des boîtes et la fabrication des graisses, des cuves pour dégélatiniser les os, des appareils pour la concentration des bouillons et des gélatines, des ateliers d’emballage, de peinture et de vernissage, des ateliers de construction et de réparation, des maisons d'habitation pour le personnel, composé d’une vingtaine de familles de contre-maitres et employés et de 150 condamnés aux travaux forcés, placés sous la garde de surveillants militaires et d'indigènes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd98b713-00a6-35aa-8ec9-c7427a1e90ab",
                                        "entry_id": "b950339d-cc11-3bc5-93bc-d475c9933c23",
                                        "glosses": [
                                            "Morceaux ; résultat d’un découpage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "366cf54b-dea9-3fe2-b469-ed84905ce167",
                                        "entry_id": "b950339d-cc11-3bc5-93bc-d475c9933c23",
                                        "glosses": [
                                            "Séparation d’une narration en séquences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19971979-3adc-4a34-9950-8e1e1afe3237",
                                                "sense_id": "366cf54b-dea9-3fe2-b469-ed84905ce167",
                                                "text": "Maintenant, si vous voulez vous perfectionner dans le découpage, je peux vous présenter à Tourette… Il est en train de bricoler sur un scénario que je tournerai peut-être, et il ne refusera pas de vous donner des leçons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "034668bc-f74e-3f33-ae59-d7614597c61c",
                                        "entry_id": "b950339d-cc11-3bc5-93bc-d475c9933c23",
                                        "glosses": [
                                            "Action de sérier, de séparer des choses semblables."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0d57c20-6f36-4704-8762-94f465fb3a6f",
                                                "sense_id": "034668bc-f74e-3f33-ae59-d7614597c61c",
                                                "text": "Ce découpage géographique n'a pas la prétention de définir exactement et sur le plan strictement scientifique les différents domaines chorologiques en particulier entre les domaines atlantique et médioeuropéen qui disposent, notamment en France, de larges zones de transition."
                                            },
                                            {
                                                "example_id": "476c50bf-cefd-4f8a-877e-acbf48e3deba",
                                                "sense_id": "034668bc-f74e-3f33-ae59-d7614597c61c",
                                                "text": "Le premier correspond à l’intrigue, dans laquelle on se laisse entraîner d'autant plus facilement que la feuilletonisation du récit est parfaitement maîtrisée grâce à un découpage et un rythme qui ménagent suspense, dévoilements et rebondissements."
                                            },
                                            {
                                                "example_id": "e461ed5c-565f-44d6-bbca-0d9b844e158b",
                                                "sense_id": "034668bc-f74e-3f33-ae59-d7614597c61c",
                                                "text": "Les sociétés humaines ont maîtrisé l’espace terrestre par le biais de son découpage en territoires. À l’heure actuelle, seuls les espaces centraux des mers et océans échappent à cette emprise en demeurant res communis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3e060dc-929e-36dc-bae3-67be9815dd9f",
                                        "entry_id": "b950339d-cc11-3bc5-93bc-d475c9933c23",
                                        "glosses": [
                                            "Fractionnement en unités de champ plus petit, d’une carte trop grande pour être éditée sur une seule feuille."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5d6dc29-3007-335d-a460-5769032a5d57",
                                        "entry_id": "b950339d-cc11-3bc5-93bc-d475c9933c23",
                                        "glosses": [
                                            "Fractionnement, en unités de champ défini, de tout ou partie de la surface terrestre, en vue de sa représentation cartographique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd69625e-48ec-4ed0-a865-a65d6f0ce11d",
                        "source_entry_id": "3527f3a4-6818-3939-8413-68a7eb553f80",
                        "source_sense_id": "2879f505-bd35-357b-962c-685ffe44c628",
                        "target_lang_word": "Scherenschnitt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scherenschnitt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3871cd5e-0776-3609-9744-d00e36d31c8d",
                                        "entry_id": "5973f52a-6220-3088-a63b-01538d43208d",
                                        "glosses": [
                                            "figuratives, aus Papier herausgeschnittenes, gegenständliches oder ornamentales Bild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5b039e4-2910-4f32-82a4-c026513918f6",
                                                "sense_id": "3871cd5e-0776-3609-9744-d00e36d31c8d",
                                                "text": "Es gibt Scherenschnitte im Miniaturformat, die eine ganze Szene darstellen, aber auch Silhouetten in Lebensgröße."
                                            },
                                            {
                                                "example_id": "ddf8f077-73b1-49db-8670-e7fc87ab893b",
                                                "sense_id": "3871cd5e-0776-3609-9744-d00e36d31c8d",
                                                "text": "Über diese weit verbreitete Volkskunst des Scherenschnitts sind nach 1949 zahlreiche Bücher geschrieben worden. Fast jede zweite Frau auf dem Lande konnte Scherenschnitte schneiden, aber nur wenige davon werden bekannt."
                                            },
                                            {
                                                "example_id": "24bb5da8-2f32-451b-baac-d8deb484416e",
                                                "sense_id": "3871cd5e-0776-3609-9744-d00e36d31c8d",
                                                "text": "Vor rund 15 Jahren stöberte Roberts durch Pariser Papeterien, in denen er eine große Vielfalt an farbigem Karton fand - und durch sie zurück zu den alten Künsten von Scherenschnitt und Collage."
                                            },
                                            {
                                                "example_id": "a417c810-c992-474b-afa1-a79408e79bd3",
                                                "sense_id": "3871cd5e-0776-3609-9744-d00e36d31c8d",
                                                "text": "Wie durch ein Wunder erfüllen die Schüler ihren Auftrag dennoch: sich einen Begriff aus der Geschichte merken, ihn in einen Scherenschnitt umsetzen und beim wiederholten Vorlesen des Textes die Scherenschnitte in der richtigen Reihenfolge auf dem Fußboden plazieren."
                                            },
                                            {
                                                "example_id": "0cf95fb3-bd8a-4694-b40d-66257a7e368d",
                                                "sense_id": "3871cd5e-0776-3609-9744-d00e36d31c8d",
                                                "text": "Man entdeckt an der Wand einen Scherenschnitt, auf dem ein weibliches Wesen auf einer Schaukel sitzt. Unter ihr steht ein kleiner Mann, der mit ängstlich vorgestreckten Händen die Dame in Schwung bringt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
