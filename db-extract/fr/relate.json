                                                "example_id": "0f96f065-92cd-4971-9330-05cf68921b62",
                                                "sense_id": "9801ed8b-ed76-3486-b343-af4fdf0a34dd",
                                                "text": "Please relate the circumstances of your journey here today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa07542f-760b-3e23-9f9b-bf5a3b1448e2",
                                        "entry_id": "ba8b4985-3083-36f1-8fd3-905aaaaf8978",
                                        "glosses": [
                                            "To bring into a relation, association, or connection (between one thing and another)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c79deb4-3f40-4519-84bf-ead5d4ec71cd",
                                                "sense_id": "aa07542f-760b-3e23-9f9b-bf5a3b1448e2",
                                                "text": "The use of video made it possible to relate the talk to the answers given to particular problems in the test. With this research design it was possible to relate changes in test score measures to changes in linguistic features[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25806ebc-0312-353e-9fc5-271b3fc1b382",
