                    "sense_id": "babdb066-a6da-3cea-8620-1686ae121dc1",
                    "sense_definition": "eine Prüfung, einen Test oder eine Leistungskontrolle nicht bestehen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "Misserfolg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hatte große Angst davor, dass er in der praktischen Fahrprüfung <w>durchfällt</w>."
                        },
                        {
                            "text": "Trotz intensiver Vorbereitung <w>fiel</w> der Student bei der schweren Prüfung leider <w>durch</w>."
                        }
                    ],
                    "synonyms": [
