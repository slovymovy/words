                                            {
                                                "example_id": "90d390c6-0508-4451-bd7b-9d3ad7de2330",
                                                "sense_id": "faab2b0e-1f11-367f-8a62-f835761b600f",
                                                "text": "Se zajatci i s ukořistěnou výstrojí, výzbrojí a především s koňmi se vítězové asi ještě týž den vrátili na Tábor. Byla to kořist nesmírně cenná, protože kvalitních zbraní a jezdeckých koní se táboritům zoufale nedostávalo."
                                            }
                                        ]
                                    },
