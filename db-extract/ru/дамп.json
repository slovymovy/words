                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d460fc49-6521-43d4-bfed-f72bfa0f571a",
                                                "sense_id": "a39ff46f-a240-339d-b275-a097e4ef0c3a",
                                                "text": "[…] doleful dumps the mind oppress […]"
                                            },
                                            {
                                                "example_id": "0e64bcdb-7a1f-46d6-a895-17b725378241",
                                                "sense_id": "a39ff46f-a240-339d-b275-a097e4ef0c3a",
                                                "text": "[…] I was musing in the midst of my dumps […]"
                                            },
                                            {
                                                "example_id": "beea5952-84fe-44b9-8b9c-dac69655207d",
                                                "sense_id": "a39ff46f-a240-339d-b275-a097e4ef0c3a",
                                                "text": "March slowly on in solemn dump […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a3166ed-d172-3acf-947a-3a72856d4bd8",
                                        "entry_id": "e60a67c8-90e6-3b9d-a45f-fc31854a8e28",
                                        "glosses": [
                                            "Absence of mind; reverie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbfacb72-b917-4beb-8ffc-08acc54e2a31",
                                                "sense_id": "9a3166ed-d172-3acf-947a-3a72856d4bd8",
                                                "text": "They see not what passes before their eyes; hear not the audible discourse of the company; and when by any strong application to them they are roused a little, they are like men brought to themselves from some remote region […]. The shame that such dumps cause to well-bred people, when it carries them away from the company, where they should bear a part of the conversation, is a sufficient argument that it is a fault in the conduct of our understanding, not to have that power over it as to make use of it to those purposes, and on those occasions, wherein we have need of its assistance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98131e23-4ae8-335c-9634-35d589e9a6bf",
                                        "entry_id": "e60a67c8-90e6-3b9d-a45f-fc31854a8e28",
                                        "glosses": [
                                            "A pile of ore or rock."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45abd059-f5f7-33d3-ac92-ee2cece6f131",
                                        "entry_id": "e60a67c8-90e6-3b9d-a45f-fc31854a8e28",
                                        "glosses": [
                                            "A melancholy strain or tune in music; any tune."
