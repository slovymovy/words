                        "source_sense_id": "85f13dce-faa4-31f6-bab4-db91d198cbe7",
                        "target_lang_word": "slowness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slowness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eeaf54f5-8f19-3e55-851c-8e8f7438de9e",
                                        "entry_id": "bbceb62f-5ec9-35c6-92f3-4e573580d5d2",
                                        "glosses": [
                                            "The quality or state of being slow."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c90a03c3-d4dd-4ed0-84a4-5895c4ab0600",
                                                "sense_id": "eeaf54f5-8f19-3e55-851c-8e8f7438de9e",
                                                "text": "Impatience with the intellectual slowness of others, narcissism and passion for one's mission in life might combine to make such individuals isolative and difficult."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cbef6e1-8a55-31a0-a0c9-d39af57515b3",
                                        "entry_id": "bbceb62f-5ec9-35c6-92f3-4e573580d5d2",
                                        "glosses": [
                                            "A unit, the reciprocal of velocity, that delineates the amount of time required for an object to travel a given distance."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eeacf6fa-efaa-417e-a357-59927fe6f0ea",
                        "source_entry_id": "c1eb9d6a-a678-3d83-b946-138b030419f9",
                        "source_sense_id": "85f13dce-faa4-31f6-bab4-db91d198cbe7",
                        "target_lang_word": "Langsamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Langsamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92528af8-8f14-3af7-8598-421cb8e61ec9",
                                        "entry_id": "61c4014c-3f8c-38ad-8cab-23393b4cd8cf",
                                        "glosses": [
                                            "das Langsamsein, die langsame Art und Weise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97f19b91-c3e0-419f-90c7-f48b03ea74b2",
                                                "sense_id": "92528af8-8f14-3af7-8598-421cb8e61ec9",
                                                "text": "Er hatte seine Rede für ein ausgesuchtes, sich womöglich überlegen dünkendes Westpublikum mit der Absicht verfasst, »Verständnis für die Langsamkeit eines wirklichen Mentalitätswandels (in der ehemaligen DDR) zu wecken«."
                                            },
                                            {
                                                "example_id": "24df08b1-c4ed-4a3e-b756-66d77d3b68dd",
                                                "sense_id": "92528af8-8f14-3af7-8598-421cb8e61ec9",
                                                "text": "Die Geschäftswelt solle die Vorteile der Demokratie nicht aus dem Auge verlieren – und \"den Nachteil der Langsamkeit dann auch demutsvoll hinzunehmen.\""
                                            },
                                            {
                                                "example_id": "1217f7ee-0c13-42f9-bc07-96334223394d",
                                                "sense_id": "92528af8-8f14-3af7-8598-421cb8e61ec9",
                                                "text": "Sie wirbt also um Verständnis für die – wie sie es offenbar sieht – Mängel der Demokratie, also deren Langsamkeit."
                                            },
                                            {
                                                "example_id": "b4114678-21c3-4919-a0ca-3571daee0579",
                                                "sense_id": "92528af8-8f14-3af7-8598-421cb8e61ec9",
                                                "text": "Man fordert deshalb von der Gesellschaft eine „Kultur der Sorgsamkeit und Langsamkeit“ und vonseiten der Politik Ethikunterricht für jene, die von Religion abgemeldet sind."
                                            },
                                            {
                                                "example_id": "ae88dae2-9e1d-4d9f-becc-7e4227ff5838",
                                                "sense_id": "92528af8-8f14-3af7-8598-421cb8e61ec9",
                                                "text": "Weniger Probleme hatte sie mit der Umstellung auf die afrikanische Langsamkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
