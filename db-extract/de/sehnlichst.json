                        "examples": [
                            {
                                "example_id": "121d5b80-70f2-433d-8c5b-5f7bbb7e1c02",
                                "sense_id": "42e47789-de6d-379e-8a9f-402d7d944b7a",
                                "text": "Sein Kommen habe ich sehnlichst erwartet."
                            },
                            {
                                "example_id": "a8ab3972-21c1-4cee-8d52-783595f5a5d0",
                                "sense_id": "42e47789-de6d-379e-8a9f-402d7d944b7a",
                                "text": "Ich hoffte sehnlichst, dass er mir entgegenkommen würde."
                            },
                            {
                                "example_id": "8b3127b2-36d3-4335-8eb3-f54c940bc6a1",
                                "sense_id": "42e47789-de6d-379e-8a9f-402d7d944b7a",
                                "text": "Wir erreichten Kanada, unser sehnlichst angestrebtes Ziel, mit Verspätung."
                            },
                            {
                                "example_id": "0276a4b4-7bc3-48e8-9ccd-57b1e075fc24",
                                "sense_id": "42e47789-de6d-379e-8a9f-402d7d944b7a",
                                "text": "„George Bernhard Shaw: ‚Es gibt im Leben zwei tragische Erfahrungen: Die eine ist, daß man nicht bekommt, was man sich sehnlichst wünscht, die andere ist, daß man es bekommt.‘“"
                            },
                            {
                                "example_id": "fa9e0795-d92f-491f-9294-c173a07313af",
                                "sense_id": "42e47789-de6d-379e-8a9f-402d7d944b7a",
                                "text": "„Der Absender der Sendung verrät mir, dass es die von mir sehnlichst erwartete Antwort aus London ist.“"
                            }
                        ],
