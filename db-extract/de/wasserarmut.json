                "translations": [
                    {
                        "translation_id": "ab7e72fc-03c4-42a8-9e08-3cb9abab27d5",
                        "source_entry_id": "8caa17ba-434c-3342-b7f2-3d3ae47d2de2",
                        "source_sense_id": "a071e0ae-57a4-3b07-a816-3617e62f818d",
                        "source_sense_description": "das fast vollständige Fehlen von Wasser",
                        "target_lang_word": "aridité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aridité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "275b5eaf-1250-3689-a9b0-4ab40ea3d503",
                                        "entry_id": "b919816f-2c8b-3688-94e8-639c2bec9050",
                                        "glosses": [
                                            "État de ce qui est aride."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "995d8f11-57e7-4168-b44d-c4db0bc08385",
                                                "sense_id": "275b5eaf-1250-3689-a9b0-4ab40ea3d503",
                                                "text": "Ce ne sont plus les plaines du Sahara, comme on serait tenté de le croire, plaines sablonneuses, dépourvues de végétation, que leur aridité rend à peu près infranchissables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce0a3bf1-0499-3410-bbc1-0dcbcaa52388",
                                        "entry_id": "b919816f-2c8b-3688-94e8-639c2bec9050",
                                        "glosses": [
                                            "État de ce qui est stérile, au propre et au figuré."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cd28731-40d4-41a8-b184-e330cb2502e1",
                                                "sense_id": "ce0a3bf1-0499-3410-bbc1-0dcbcaa52388",
                                                "text": "L’aridité d’un terroir. L’aridité de la saison. L’aridité de l’herbe brûlée par le soleil."
                                            },
                                            {
                                                "example_id": "31c7f878-efe5-471c-b930-1eba625b64f5",
                                                "sense_id": "ce0a3bf1-0499-3410-bbc1-0dcbcaa52388",
                                                "text": "Il se plongeait dans l’aridité des études financières, le jargon des affaires, la jonglerie des chiffres et, lentement, ces choses, hier hermétiques, lui devenaient familières."
                                            },
                                            {
                                                "example_id": "9c2544a9-ce5c-426e-a39c-917e08ea13dc",
                                                "sense_id": "ce0a3bf1-0499-3410-bbc1-0dcbcaa52388",
                                                "text": "— L’aridité d’un sujet. Une grande aridité de style. Il y a dans tous ses ouvrages une sécheresse, une aridité étrange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a4555c1-bcd9-368b-a0f2-46c173e1722e",
                                        "entry_id": "b919816f-2c8b-3688-94e8-639c2bec9050",
                                        "glosses": [
                                            "État d’une âme qui ne sent pas de consolation dans les exercices de piété."
                                        ],
                                        "tags": [
                                            "Dévotion religieuse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eb93b41-651c-44a4-82e3-6c702fe78564",
                                                "sense_id": "6a4555c1-bcd9-368b-a0f2-46c173e1722e",
                                                "text": "Elle prend l’habit, […] ; puis vient une aridité désolante qui dure trois ans et elle tient bon, éprouve les douleurs de la substitution mystique, subit les plus pénibles, les plus répugnantes des maladies pour sauver les âmes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
