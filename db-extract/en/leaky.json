                    {
                        "sense_id": "0af2b3c8-3a08-391e-9090-11aa7467d4f6",
                        "entry_id": "bb6d8148-d9d5-383e-a9e2-ec3f16e1cc83",
                        "glosses": [
                            "Having leaks; not fully sealed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff49364b-ab12-4dd3-85c9-e953e6676f40",
                                "sense_id": "0af2b3c8-3a08-391e-9090-11aa7467d4f6",
                                "text": "The leaky bucket dripped only one drop at a time, but by the time I got back to the house it was half empty."
                            },
                            {
                                "example_id": "4a2632d9-1cc9-49fd-bb13-1416b6653d15",
                                "sense_id": "0af2b3c8-3a08-391e-9090-11aa7467d4f6",
                                "text": "The ceiling was so leaky that someone had to fix it."
                            },
                            {
                                "example_id": "b34a6721-bf9f-420a-af3e-379a09266474",
                                "sense_id": "0af2b3c8-3a08-391e-9090-11aa7467d4f6",
                                "text": "Nuclear reactors in Russian submarines are said to be so leaky that crews are often paid \"sterility money\"."
                            }
                        ]
                    }
                ],
