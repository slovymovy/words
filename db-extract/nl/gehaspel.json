                            {
                                "example_id": "9f7ec485-7afd-4eed-babe-8b516434422e",
                                "sense_id": "4eb4059f-2bb9-3916-afbe-2ad64f9cf7b3",
                                "text": "Geestig: zijn vers Aan de vrouwtjes. \"Toe, bespaar mij het gehaspel/ van het voorspel en het naspel.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "9be772a1-5a55-3dd8-ac65-f6baa5dffc97",
                        "entry_id": "0ace3216-ce8e-349e-ac87-0f4787f8a5a3",
                        "glosses": [
                            "onhandig gepraat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f004764-bc34-4804-84a0-afd7c45e0b92",
                                "sense_id": "9be772a1-5a55-3dd8-ac65-f6baa5dffc97",
                                "text": "„Ik koester niet de verwachting dat hij alle woorden uit zijn hoofd leert: het is moeilijk en Spaans is niet zijn moedertaal”, zegt de 39-jarige Fonsi over het gehaspel in het Spaans van Bieber. „Wees een beetje aardig voor hem”, voegde de latinozanger toe."
                            },
                            {
                                "example_id": "abcb0d9e-8f84-4572-a1bc-3e79114f1299",
                                "sense_id": "9be772a1-5a55-3dd8-ac65-f6baa5dffc97",
                                "text": "Na het gehaspel op de trappen van het Capitool, waar opperrechter John Roberts zich vergiste in de volgorde van de woorden van de eed en Obama hem foutief nazei, kozen de adviseurs van de president ervoor de beëdiging toch maar direct over te doen. Klachten of zelfs beroepsprocedures in een later stadium zouden heel onaangenaam zijn."
                            }
                        ]
                    }
