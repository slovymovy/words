                "senses": [
                    {
                        "sense_id": "71d911d4-9e29-3c75-a803-eaafb60871a6",
                        "entry_id": "2a8a31dd-0234-37f6-8304-6019cb24b5ce",
                        "glosses": [
                            "meist jüngere, männliche Person, die einen Aufzug bedient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50654a72-ace5-4022-af88-60483e8ffc05",
                                "sense_id": "71d911d4-9e29-3c75-a803-eaafb60871a6",
                                "text": "„Er verläßt [die Schule] ein Jahr vor dem Abschluß, kurz vor dem Ende der Depression und nimmt eine Stellung als Liftboy an.“"
                            },
                            {
                                "example_id": "bad0893a-a358-452b-a758-b58695007784",
                                "sense_id": "71d911d4-9e29-3c75-a803-eaafb60871a6",
                                "text": "„Bond nahm seinen Schlüssel, sagte »Gute Nacht«, sah den Liftboy mit einem abwehrenden Kopfschütteln an und ging zur Treppe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
