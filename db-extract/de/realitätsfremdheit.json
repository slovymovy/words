                "senses": [
                    {
                        "sense_id": "beb06c94-a1c4-3acf-a035-b9d02897b5a0",
                        "entry_id": "bd8882e2-c78e-3364-b596-5c9a426b5f4b",
                        "glosses": [
                            "mangelnde Berücksichtigung oder Wahrnehmung der Wirklichkeit, von wahren Gegebenheiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d25f0e0-245e-425e-a060-090fd4117fa2",
                                "sense_id": "beb06c94-a1c4-3acf-a035-b9d02897b5a0",
                                "text": "„Die Urkirche ist wie das Paradies auch nur eine Legende: unerträgliche Zustände wurden bis zur Realitätsfremdheit verklärt.“"
                            },
                            {
                                "example_id": "a385e601-a810-4819-a9fb-f9ce4e01dfce",
                                "sense_id": "beb06c94-a1c4-3acf-a035-b9d02897b5a0",
                                "text": "„Eine gewagte Parallele soll die Realitätsfremdheit hinsichtlich einer umfassenden Föderalismusreform bei der Wiedervereinigung verdeutlichen.“"
                            },
                            {
                                "example_id": "e2702b49-8fc2-46bb-9ac4-ef253d165125",
                                "sense_id": "beb06c94-a1c4-3acf-a035-b9d02897b5a0",
                                "text": "„Diese Erklärung ist zwar unverbindlich und geht mit keinerlei neuen Strategien einher, aber verdeutlicht die allgemeine Realitätsfremdheit.“"
                            },
                            {
                                "example_id": "c4ce4a54-531a-44ff-afec-ff270c8141f0",
                                "sense_id": "beb06c94-a1c4-3acf-a035-b9d02897b5a0",
                                "text": "„Ihr gemeinsamer Ausgangspunkt ist eine Kritik der Theorien rationaler Wahl, die insbesondere die ‚Realitätsfremdheit‘ dieser Auffassungen hervorhebt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
