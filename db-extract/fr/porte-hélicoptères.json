                        "sense_id": "87e8240f-7757-3d64-b090-2dc1ce33ee5e",
                        "entry_id": "8a97ae90-91b4-37bb-8e6c-f67cd8a4dec0",
                        "glosses": [
                            "Navire de guerre doté d’hélisurfaces et capable de transporter des hélicoptères."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "441117a9-36d7-4b70-afa3-dee0f620bafb",
                                "sense_id": "87e8240f-7757-3d64-b090-2dc1ce33ee5e",
                                "text": "Deux postes sanitaires mobiles et 10 tonnes de fret médical seront envoyés en début de semaine, et le porte-hélicoptères Dixmude, conçu pour le soutien hospitalier, appareillera bientôt pour l’Égypte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f47da37d-5698-4482-b826-948bedb41e4f",
                        "source_entry_id": "8a97ae90-91b4-37bb-8e6c-f67cd8a4dec0",
                        "source_sense_id": "87e8240f-7757-3d64-b090-2dc1ce33ee5e",
                        "target_lang_word": "Hubschrauberträger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hubschrauberträger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ed8e8d3-e85d-3ef3-85a5-a75cc480a2af",
                                        "entry_id": "7aaeae42-d356-30ca-b824-c74b93d16c50",
                                        "glosses": [
                                            "Kriegsschiff, schwimmende Basis für Hubschrauber"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9d09633-c266-4b7a-82cd-5493a0e0febd",
                                                "sense_id": "5ed8e8d3-e85d-3ef3-85a5-a75cc480a2af",
                                                "text": "Die Jeanne d'Arc war ein Hubschrauberträger."
                                            },
                                            {
                                                "example_id": "8994c0e8-01ff-4e5a-98cb-b862c85e71ae",
                                                "sense_id": "5ed8e8d3-e85d-3ef3-85a5-a75cc480a2af",
                                                "text": "„Die Vorstellung des neuen Hubschrauberträgers steht auch in Zusammenhang mit Plänen der konservativen Liberaldemokraten von Regierungschef Shinzo Abe, die sogenannten Selbstverteidigungskräfte Japans zu einer normalen Armee umwandeln.“"
                                            },
                                            {
                                                "example_id": "db8c4371-ea98-4038-9a0c-55acf12662ba",
                                                "sense_id": "5ed8e8d3-e85d-3ef3-85a5-a75cc480a2af",
                                                "text": "„Die für 2015 geplante Übergabe des zweiten Hubschrauberträgers wollte Hollande bisher vom künftigen Verhalten Russlands abhängig machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
