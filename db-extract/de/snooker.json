                        "form": "den Snooker"
                    },
                    {
                        "form_id": "00da78e1-cd47-47ad-8f91-77420333cd98",
                        "entry_id": "79681bba-edaa-3e3d-81ee-3cf75a16fd88",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
