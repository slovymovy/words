                    {
                        "sense_id": "1928e416-889d-3f43-8006-f82924a1ad0e",
                        "entry_id": "b81b7793-139f-3a1c-b394-9cb7623e2dac",
                        "glosses": [
                            "eine nordfriesische Insel vor der Westküste Schleswig-Holsteins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af1f9450-564a-4afd-9832-1fc93353bf82",
                                "sense_id": "1928e416-889d-3f43-8006-f82924a1ad0e",
                                "text": "Wir machen dieses Jahr Urlaub auf Föhr."
                            },
                            {
                                "example_id": "2780b874-6a75-4553-94d1-8e79faf7edf7",
                                "sense_id": "1928e416-889d-3f43-8006-f82924a1ad0e",
                                "text": "Unseren letzten Urlaub verbrachten wir auf Föhr."
                            },
                            {
                                "example_id": "91d2280e-70e2-473e-860d-f6a34a615504",
                                "sense_id": "1928e416-889d-3f43-8006-f82924a1ad0e",
                                "text": "Föhr liegt in der Nordsee."
                            },
                            {
                                "example_id": "b98759ea-b8cc-4eef-a9d5-6516d1ebd087",
                                "sense_id": "1928e416-889d-3f43-8006-f82924a1ad0e",
                                "text": "Das Lagerfeuer auf Föhr erlosch erst am frühen Morgen."
                            },
                            {
                                "example_id": "de44beba-185a-4009-b400-d7ca2dd7c148",
                                "sense_id": "1928e416-889d-3f43-8006-f82924a1ad0e",
                                "text": "„Rettungskräfte haben fünf Wattwanderer zwischen den Inseln Amrum und Föhr aus akuter Lebensgefahr gerettet.“"
                            }
                        ],
