                                        "entry_id": "229848b6-c794-37c6-842d-2437540a1143",
                                        "glosses": [
                                            "An Indian trader, merchant, cashier, or money changer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "433016c5-e608-3898-a7e3-93bc151477e4",
                                        "entry_id": "229848b6-c794-37c6-842d-2437540a1143",
                                        "glosses": [
                                            "A tropical Indian fig tree, Ficus benghalensis, that has many aerial roots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b43da00d-a74d-42ea-8fd3-ab30c6211b21",
                                                "sense_id": "433016c5-e608-3898-a7e3-93bc151477e4",
                                                "text": "We climb and then descend; we pass by the great banyan which, like Atlas, settling himself powerfully on his contorted haunches, seems awaiting with knee and shoulder the burden of the sky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba330677-a0a6-36fc-936d-7a0ab6aa6d9b",
                                        "entry_id": "229848b6-c794-37c6-842d-2437540a1143",
                                        "glosses": [
                                            "Various other trees of the Ficus subgenus Urostigma, especially Ficus pertusa (Central American banyan) and Ficus microcarpa (Chinese banyan or Malayan banyan)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a669bae-93fa-368c-9e38-32919d845354",
                                        "entry_id": "229848b6-c794-37c6-842d-2437540a1143",
                                        "glosses": [
                                            "A type of loose gown worn in India."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b634584-1e16-3595-9c97-c871a988bea2",
                                        "entry_id": "229848b6-c794-37c6-842d-2437540a1143",
                                        "glosses": [
                                            "A vest; an undershirt; a singlet."
                                        ],
                                        "tags": [
                                            "India",
                                            "Pakistan"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b501ec56-4e8f-4125-bc84-8330fd161447",
                                                "sense_id": "8b634584-1e16-3595-9c97-c871a988bea2",
                                                "text": "It was an honest letter, written by an honest man, then stewing in the Plains on two hundred rupees a month (for he allowed his wife eight hundred and fifty), and in a silk banian and cotton trousers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c4fe3f5-1840-361e-a340-b0a33a9fd822",
