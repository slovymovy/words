        "fr-extract.jsonl": [
            {
                "entry_id": "46836fc0-c970-360a-b124-b346a9fdbcd8",
                "word": "impudemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4af421fe-73fa-3f02-9e07-c077385cf650",
                        "entry_id": "46836fc0-c970-360a-b124-b346a9fdbcd8",
                        "glosses": [
                            "Avec impudence ; audacieusement ; effrontément ; éhontément."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44c71173-74de-42a7-8f93-7c6b6232a6bd",
                                "sense_id": "4af421fe-73fa-3f02-9e07-c077385cf650",
                                "text": "Ensuite je pense avec joie que quelque mauvais poète la ramassera et s’encoiffera impudemment."
                            },
                            {
                                "example_id": "bf44817b-fe92-409f-bc3c-a429979d6ecc",
                                "sense_id": "4af421fe-73fa-3f02-9e07-c077385cf650",
                                "text": "Elle s’occupait de son bien encore moins que de ses enfants. L’enclos des Fouque, pendant les longues années que dura cette singulière existence, serait devenu un terrain vague si la jeune femme n’avait eu la bonne chance de confier la culture de ses légumes à un habile maraîcher. Cet homme, qui devait partager les bénéfices avec elle, la volait impudemment, ce dont elle ne s’aperçut jamais."
                            },
                            {
                                "example_id": "5c8cea47-e167-4dc6-8c4d-8dc79084d6a6",
                                "sense_id": "4af421fe-73fa-3f02-9e07-c077385cf650",
                                "text": "Un regard noir au nain, et le jeune chevalier claquait impudemment la porte derrière lui."
                            },
                            {
                                "example_id": "c52c80c3-d3da-44d9-a375-a8192ed9d8a4",
                                "sense_id": "4af421fe-73fa-3f02-9e07-c077385cf650",
                                "text": "Un homme de mon âge a cru légèrement Ce qu’un homme du tien débite impudemment."
                            },
                            {
                                "example_id": "cd440a8f-7e23-4c6d-8918-1cae1a52dfd3",
                                "sense_id": "4af421fe-73fa-3f02-9e07-c077385cf650",
                                "text": "Je déclare qu’ils ont menti très impudemment."
                            },
                            {
                                "example_id": "2b7f15a9-26f6-4357-92eb-0747e6788b41",
                                "sense_id": "4af421fe-73fa-3f02-9e07-c077385cf650",
                                "text": "Il me nia impudemment que les Caraïbes fussent nés rouges ; je fus obligé de lui envoyer une attestation d’un ancien procureur du roi de la Guadeloupe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2683ce51-4186-49e4-9771-50e533ac157c",
                        "source_entry_id": "46836fc0-c970-360a-b124-b346a9fdbcd8",
                        "source_sense_id": "4af421fe-73fa-3f02-9e07-c077385cf650",
                        "target_lang_word": "impudently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impudently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eafc0cb0-761c-3dfe-abd4-00b72c5f9afe",
                                        "entry_id": "11e2042a-e734-35b4-b252-a8e6e81963c8",
                                        "glosses": [
                                            "In an impudent manner; with unblushing effrontery; insolently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01f095b7-b160-4bda-8a26-8175c7709d31",
                                                "sense_id": "eafc0cb0-761c-3dfe-abd4-00b72c5f9afe",
                                                "text": "Tuc[ca]. […] Can thy Author doe it impudently enough? / Hiſt[rio]. O, I warrant you, Captaine: and ſpitefully inough too; he ha's one of the moſt ouerflowing villanous wits, in Rome. He will ſlander any man that breathes; If he diſguſt him. / Tucca. I'le know the poor, egregious, nitty Raſcall; and he haue ſuch commendable Qualities, I'le cheriſh him: […]"
                                            },
                                            {
                                                "example_id": "3823bad4-23c2-454d-bc61-f29ba31b98bb",
                                                "sense_id": "eafc0cb0-761c-3dfe-abd4-00b72c5f9afe",
                                                "text": "'Oh certainly,' retorted Tinette impudently, as she flounced out of the room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
