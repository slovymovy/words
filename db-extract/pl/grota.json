                "senses": [
                    {
                        "sense_id": "34e33532-6fb5-3e44-8aaf-b525b62d7d69",
                        "entry_id": "1cc4ad68-8083-3c4f-8422-c9e0b3c267ad",
                        "glosses": [
                            "naturalne zagłębienie w skale, zwykle niezbyt głębokie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eee6f8db-975a-4005-9bec-6639f7104a36",
                                "sense_id": "34e33532-6fb5-3e44-8aaf-b525b62d7d69",
                                "text": "Podczas wycieczki zwiedziliśmy grotę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d613fd48-f467-334e-938c-4e68a32ec4a2",
                        "entry_id": "1cc4ad68-8083-3c4f-8422-c9e0b3c267ad",
                        "glosses": [
                            "rodzaj kapliczki lub budowli z figurą umieszczoną w kamiennej niszy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2359e6d2-4790-4113-b328-2ebfe9906623",
                                "sense_id": "d613fd48-f467-334e-938c-4e68a32ec4a2",
                                "text": "Nabożeństwa w grocie lourdzkiej odbywają się w miesiącach letnich."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0547ca4b-d8d8-479d-8617-a5212543e62a",
                        "source_entry_id": "1cc4ad68-8083-3c4f-8422-c9e0b3c267ad",
                        "source_sense_id": "34e33532-6fb5-3e44-8aaf-b525b62d7d69",
                        "target_lang_word": "grotto",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grotto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97f51b5c-2159-3c36-b843-a1c12669be1a",
                                        "entry_id": "941d0e09-66a8-3bbd-a116-68641177c46f",
                                        "glosses": [
                                            "A small cave."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "446c0090-e7d3-3c6a-81b5-e9cb720cd080",
                                        "entry_id": "941d0e09-66a8-3bbd-a116-68641177c46f",
                                        "glosses": [
                                            "An artificial cavern-like retreat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f9be32c-75d6-4e0d-ac80-9ee63d0baa24",
                                                "sense_id": "446c0090-e7d3-3c6a-81b5-e9cb720cd080",
                                                "text": "...But, while we are waiting for the temple, can you not show us the altar?—we want to see your grotto.\"\nPope desired nothing better than to show his new toy, and led the way to the pretty and fanciful cave, which was but just finished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba6665b8-de3b-37d0-bd21-e4c101279339",
                                        "entry_id": "941d0e09-66a8-3bbd-a116-68641177c46f",
                                        "glosses": [
                                            "A Marian shrine, usually built in a cavern-like structure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb02966d-811e-3900-88d0-14aa2bb5673c",
                                        "entry_id": "941d0e09-66a8-3bbd-a116-68641177c46f",
                                        "glosses": [
                                            "A local organization of cavers that typically organizes trips to caves and provides information and training for caving; a caving club."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bcfd647-0e92-49ed-8ce1-bfb312e818c0",
                                                "sense_id": "fb02966d-811e-3900-88d0-14aa2bb5673c",
                                                "text": "An earlier attempt to organize a grotto in the Indiana, PA, area in the mid-1970s failed to succeed, but from it developed the informal Chestnut Ridge Explorers Association."
                                            },
                                            {
                                                "example_id": "82034ab0-1a76-4a94-b398-10f1317d8beb",
                                                "sense_id": "fb02966d-811e-3900-88d0-14aa2bb5673c",
                                                "text": "By the mid-1940s members of local grottos (regional clubs of cavers within the National Speleological Society) were exploring Porcupine Cave (Bloch, 1946)."
                                            },
                                            {
                                                "example_id": "9ec6968a-1d14-4fb8-a9e1-9c41f2813e3a",
                                                "sense_id": "fb02966d-811e-3900-88d0-14aa2bb5673c",
                                                "text": "The answer to the question, “Are there any caves in Arizona?” was always the laconic “None to speak of,” with emphasis on the “to speak of.” This secrecy dovetailed with the cave conservation ethic promoted by the local caving grotto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7e29b18-d970-3cbc-bd21-c716d0fdecdb",
                                        "entry_id": "941d0e09-66a8-3bbd-a116-68641177c46f",
                                        "glosses": [
                                            "A secretive name for a local group of underground Satanists."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b5c08f0-c162-3db3-bd91-f7a16da5f4ee",
                                        "entry_id": "941d0e09-66a8-3bbd-a116-68641177c46f",
                                        "glosses": [
                                            "A garden or roadside shrine with a small cave containing a statue of the Blessed Virgin Mary (usually Our Lady of Lourdes and sometimes paired with a water feature)"
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac37a27e-2653-4578-8620-7d866787aada",
                        "source_entry_id": "1cc4ad68-8083-3c4f-8422-c9e0b3c267ad",
                        "source_sense_id": "34e33532-6fb5-3e44-8aaf-b525b62d7d69",
                        "target_lang_word": "grotte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grotte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82304059-e1b8-3f51-91cb-d76c8dfafa08",
                                        "entry_id": "3204b848-c357-3324-a18b-1f4198bf5fb6",
                                        "glosses": [
                                            "Cavité plus ou moins profonde, dans un rocher ou dans une montagne, naturelle ou faite de main d’homme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2942519-c104-47a7-b8c0-38b1ef13a1fc",
                                                "sense_id": "82304059-e1b8-3f51-91cb-d76c8dfafa08",
                                                "text": "Ce que, dans l’obscurité, ils avaient pris pour une simple excavation, était une grotte naturelle, comme on en rencontre tant dans ces contrées."
                                            },
                                            {
                                                "example_id": "ea947691-9f0f-4c65-a3be-be513a4fac76",
                                                "sense_id": "82304059-e1b8-3f51-91cb-d76c8dfafa08",
                                                "text": "A peu de distance de Dinant, en Belgique, dans la vallée de la Lesse, il existe un assez grand nombre de ces grottes qui ont dû servir d’habitation ou de refuge à nos ancêtres ; […]"
                                            },
                                            {
                                                "example_id": "46a820d0-2d6a-4cb5-84ad-6b5bce95c63b",
                                                "sense_id": "82304059-e1b8-3f51-91cb-d76c8dfafa08",
                                                "text": "Pendant qu’on décharge mes bêtes, je me précipite vers la grotte fraîche et ombreuse où jaillit la source et j’en prends possession pour le reste de la journée."
                                            },
                                            {
                                                "example_id": "7a928e4f-29a0-4b8e-a075-5eb3a0cb83b0",
                                                "sense_id": "82304059-e1b8-3f51-91cb-d76c8dfafa08",
                                                "text": "Le parc du Mont-Noir contenait une de ces grottes que les propriétaires de la fin du XIXᵉ siècle se faisaient volontiers creuser, influencés par Lourdes, un peu comme leurs ancêtres s’étaient fait construire des ruines d’après Piranèse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32fb60e6-86e3-45f1-9454-76edd397dc72",
                        "source_entry_id": "1cc4ad68-8083-3c4f-8422-c9e0b3c267ad",
                        "source_sense_id": "34e33532-6fb5-3e44-8aaf-b525b62d7d69",
                        "target_lang_word": "gruta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gruta",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f21dff9e-6ea8-374d-9656-04282550b385",
                                        "entry_id": "b01b5b7f-1b6f-325c-a0e9-09cfae476c03",
                                        "glosses": [
                                            "Cavidad amplia, pero convencionalmente más pequeña que una cueva, que se encuentra en una roca, montaña o bajo la superficie de la tierra, de origen natural o construcción humana."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a5f4d69-09f3-4961-8e39-8b2f12d2a2d6",
                        "source_entry_id": "1cc4ad68-8083-3c4f-8422-c9e0b3c267ad",
                        "source_sense_id": "34e33532-6fb5-3e44-8aaf-b525b62d7d69",
                        "target_lang_word": "Grotte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grotte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d316292-21b1-3526-afa7-e2c3da0470f2",
                                        "entry_id": "7f214b34-5cbe-33b9-b3fd-615810873ea5",
                                        "glosses": [
                                            "Höhle, die nur eine relativ kurze Strecke in den Felsen reicht, oftmals auch eine künstlich angelegte Höhle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce85ee70-5e8e-4b41-ab69-6ef8c2d2d9dc",
                                                "sense_id": "9d316292-21b1-3526-afa7-e2c3da0470f2",
                                                "text": "Als Kinder spielten wir immer in der Grotte."
                                            },
                                            {
                                                "example_id": "47c06aa6-0437-462d-a185-7d6fcf3b4490",
                                                "sense_id": "9d316292-21b1-3526-afa7-e2c3da0470f2",
                                                "text": "Der Besuch einer Salzgrotte soll sehr gesund sein. Man bleibt circa eine Dreiviertelstunde in der Grotte."
                                            },
                                            {
                                                "example_id": "2d844964-f9b3-4ea3-a538-8e31299202b4",
                                                "sense_id": "9d316292-21b1-3526-afa7-e2c3da0470f2",
                                                "text": "„Auf dem Hohleberg hatte er mit seiner Wünschelrute aus Weidenholz mehrere Kraftlinien lokalisiert, die sich in der Mitte der Grotte kreuzten.“"
                                            },
                                            {
                                                "example_id": "75184b89-7eb8-4dcd-929d-4a182710de2f",
                                                "sense_id": "9d316292-21b1-3526-afa7-e2c3da0470f2",
                                                "text": "„Dann bereiteten die Negerinnen für meine Cousinen in einer Art Grotte ein recht gutes Bett.“"
                                            },
                                            {
                                                "example_id": "4e15b95a-2e00-4d2f-992b-536d5976b1a6",
                                                "sense_id": "9d316292-21b1-3526-afa7-e2c3da0470f2",
                                                "text": "„Er hatte sie nackt gesehen, als sie in ihrer Grotte im Wald badete, und es war ein Gesetz der Götter, jeden Sterblichen, der eine jungfräuliche Göttin unbekleidet sah, egal wie lange, mit dem Tod zu bestrafen.“"
                                            },
                                            {
                                                "example_id": "59fae0c7-e83d-4620-8eff-2ea99d461915",
                                                "sense_id": "9d316292-21b1-3526-afa7-e2c3da0470f2",
                                                "text": "„An dem runden Mondfenster der Grotte Zum Frühlingsversteck machte sie Halt, um zu lauschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a5f63dc1-ad58-33c0-a390-8707b826aab2",
                                        "entry_id": "7f214b34-5cbe-33b9-b3fd-615810873ea5",
                                        "glosses": [
                                            "Nische mit christlichen Symbolen zur Andacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "751414b9-36bb-4697-bbcc-287207ea0f6b",
                                                "sense_id": "a5f63dc1-ad58-33c0-a390-8707b826aab2",
                                                "text": "„Aufzunehmen sind alle Grotten, die sich im Freien befinden, auch jene im Umgebungsbereich der Kirchen, nicht aber jene innerhalb von Kirchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "116d3f07-a8dc-4f50-93ab-e110bf7594a8",
                        "source_entry_id": "1cc4ad68-8083-3c4f-8422-c9e0b3c267ad",
                        "source_sense_id": "34e33532-6fb5-3e44-8aaf-b525b62d7d69",
                        "target_lang_word": "грот",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "грот",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a6eff69e-862a-3569-923d-88164c10acbe",
                                        "entry_id": "b727342f-c0a5-350b-a4ae-8d57e65e6045",
                                        "glosses": [
                                            "искусственная или естественная неглубокая пещера с широким входом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "401e03e0-ea9a-4cf7-8fc7-0bdfc0437d50",
                                                "sense_id": "a6eff69e-862a-3569-923d-88164c10acbe",
                                                "text": "Иду я: где беседка тлеет, \\\\ И в прахе перед ней лежат её столпы, \\\\ Где остов мостика дряхлеет. \\\\ И ты, величественный грот, \\\\ Тяжёло-каменный, постигнут разрушеньем \\\\ И угрожаешь уж паденьем, \\\\ Бывало, в летний зной прохлады полный свод!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "грот",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f3c68de0-1e2a-34b7-8c6f-abfada8332df",
                                        "entry_id": "9dafed86-f9fc-3abc-9b41-b010ced6beb9",
                                        "glosses": [
                                            "морск. нижний прямой парус на второй от носа мачте (грот-мачте)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f083c0ce-7bc1-4879-9163-103ef834fa58",
                                                "sense_id": "f3c68de0-1e2a-34b7-8c6f-abfada8332df",
                                                "text": "Например: марсовые к вантам, на фок и грот!"
                                            },
                                            {
                                                "example_id": "954ed51d-14e7-48a3-93ba-998468c1851f",
                                                "sense_id": "f3c68de0-1e2a-34b7-8c6f-abfada8332df",
                                                "text": "…25 октября в 2 часа по полудни, имея марсели, фок, грот и брамсели, с расхода 7 узлов стал на подводный, тогда неизвестный камень…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "грот",
                                "target_lang_code": "ru",
