                "senses": [
                    {
                        "sense_id": "75202f28-bbd1-35e6-a0e0-71274b4d9567",
                        "entry_id": "e91ed7bd-6e69-31a9-a9f5-d323a99eb3f9",
                        "glosses": [
                            "мол. челюсть"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4f0a0fa8-2ddb-3a0f-bef0-82348dea4a2a",
                        "entry_id": "e91ed7bd-6e69-31a9-a9f5-d323a99eb3f9",
                        "glosses": [
                            "мол. полное лицо толстого человека"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b6cbfb65-4f65-3e08-83ea-521ed7d06696",
                        "entry_id": "e91ed7bd-6e69-31a9-a9f5-d323a99eb3f9",
                        "glosses": [
                            "крим. жарг., воен. жарг. помещение или специально выделенное место в помещении, где нарезают хлеб на порционные кусочки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eefacf8-474a-47d3-b3ef-0bd26ef12e1c",
                                "sense_id": "b6cbfb65-4f65-3e08-83ea-521ed7d06696",
                                "text": "Линда работала в хлеборезке и опекала Юлика прямо-таки по-матерински."
                            },
                            {
                                "example_id": "c4019c25-4182-432a-b23c-b0433b1beeec",
                                "sense_id": "b6cbfb65-4f65-3e08-83ea-521ed7d06696",
                                "text": "И сказал, что сам рассы́пал сухари ― думал хлеборезка, хлеб обещанный искал."
                            }
                        ]
                    },
                    {
                        "sense_id": "a18b427b-e89c-3fbf-9825-58142a124e9f",
                        "entry_id": "e91ed7bd-6e69-31a9-a9f5-d323a99eb3f9",
                        "glosses": [
                            "крим. жарг. и мол. рот"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb16895c-33c4-4d30-8840-c76eab4a29a1",
                                "sense_id": "a18b427b-e89c-3fbf-9825-58142a124e9f",
                                "text": "Говорили же: чего, мол, хлеборезку раззявил, если у тебя у самого потянули!"
                            }
                        ]
                    }
