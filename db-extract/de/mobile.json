                "senses": [
                    {
                        "sense_id": "ed1b4ae2-61cf-33d7-8c10-9aa440a40e4f",
                        "entry_id": "32b8dcc6-7d5c-3470-b931-da54bdd61a44",
                        "glosses": [
                            "Ort im US-Bundesstaat Alabama"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7726657d-5b55-4eca-b6a7-c25c786a9f3e",
                                "sense_id": "ed1b4ae2-61cf-33d7-8c10-9aa440a40e4f",
                                "text": "„Das Boot der Küstenwache, das hundert Meter entfernt beigedreht hatte, wiegte sich mit eingeschalteten Positionslichtern in der Dünung, und fünfzehn Kilometer weiter im Norden konnte man die Scheinwerfer von Lkws sehen, die, aus New Orleans kommend, in östlicher Richtung auf der US 90 über den Fahrdamm nach Pass Christian, Biloxi und Mobile fuhren.“"
                            },
                            {
                                "example_id": "828bcc67-c43b-45b5-adf6-36b27c1b0913",
                                "sense_id": "ed1b4ae2-61cf-33d7-8c10-9aa440a40e4f",
                                "text": "„Bestätigte telefonische Information: Ehemaliger Lieutenant des Air Corps J. G. Fickling rief aus Mobile, Alabama, an, nachdem er E. Shorts Namen und Bild in Mobile Zeitungen gesehen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
