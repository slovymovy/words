                                            {
                                                "example_id": "b701614d-2f66-4ac1-bf6b-6827f82a6d1f",
                                                "sense_id": "40ef2d83-8a5c-356a-8efb-5011f2e194f2",
                                                "text": "The police arrested the ringleaders of the smuggling operation."
                                            },
                                            {
                                                "example_id": "2d00bc88-b6b4-4944-9862-c483cad45045",
                                                "sense_id": "40ef2d83-8a5c-356a-8efb-5011f2e194f2",
                                                "text": "A sort of naughty persons, lewdly bent, / Under the countenance and confederacy / Of Lady Eleanor, the protector's wife, / The ringleader and head of all this rout, / Have practis'd dangerously against your state..."
                                            },
                                            {
                                                "example_id": "2fce41d5-0d13-4abf-8a2a-f44a069588c7",
                                                "sense_id": "40ef2d83-8a5c-356a-8efb-5011f2e194f2",
                                                "text": "The ringleaders of the gang were eventually hanged at Tyburn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
