                                            {
                                                "example_id": "536aa87a-9e77-4d3d-8f26-34745b023194",
                                                "sense_id": "b8bec015-f9cc-3205-b5ad-31692f778b05",
                                                "text": "Der Sechsjährige besucht die erste Klasse."
                                            },
                                            {
                                                "example_id": "f234b6b7-7eee-4e51-ac70-c99cf8946d71",
                                                "sense_id": "b8bec015-f9cc-3205-b5ad-31692f778b05",
                                                "text": "„Ich gehe gern in diese Filme für Sechsjährige, weil darin von dem Erwachsenenkitsch mit Ehebruch und Ehescheidung nichts vorkommt.“"
                                            },
                                            {
                                                "example_id": "7ff5f08b-f0a4-4b6e-9d4f-e7bec535d292",
                                                "sense_id": "b8bec015-f9cc-3205-b5ad-31692f778b05",
                                                "text": "„Als Sechsjähriger lernte er das Tiefschneefahren.“"
                                            }
