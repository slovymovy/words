                "senses": [
                    {
                        "sense_id": "6d48f521-77fe-3e4c-a276-dc469fd727f6",
                        "entry_id": "d06c752a-6f1e-311d-8697-a2f5f11565f1",
                        "glosses": [
                            "Am Rand eines Meeres (= Küste) verlaufender Weg zum Wandern (= Wanderweg)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2e4502a-d8b5-441e-b766-af83afcc34d0",
                                "sense_id": "6d48f521-77fe-3e4c-a276-dc469fd727f6",
                                "text": "Auf dem Kyststi, dem Küstenwanderweg rund um Bornholm, kommt man durch Allinge."
                            },
                            {
                                "example_id": "42d71ba4-d23f-43e1-978d-7b1bc9c66df4",
                                "sense_id": "6d48f521-77fe-3e4c-a276-dc469fd727f6",
                                "text": "Der Küstenwanderweg GR34 verbindet die Pointe du Raz mit der Baie des Trépasses und der Pointe du Van mit einer Länge von ca. 6 km."
                            },
                            {
                                "example_id": "de463130-88e6-4f25-a447-ce2694859fd0",
                                "sense_id": "6d48f521-77fe-3e4c-a276-dc469fd727f6",
                                "text": "Wer die gesamte Insel auf dem Küstenwanderweg zu Fuß umrundet, kommt zwangsläufig auch direkt am Strand von Dueodde vorbei."
                            },
                            {
                                "example_id": "43b367e8-733e-44a4-8b91-f9e29fdb4462",
                                "sense_id": "6d48f521-77fe-3e4c-a276-dc469fd727f6",
                                "text": "Für Wanderer führt der europäische Küstenwanderweg E9 aus dem niederländischen Bad Nieuweschans über Weener nach Leer."
                            },
                            {
                                "example_id": "8a96d577-1ab4-44cf-b540-5335e83ec770",
                                "sense_id": "6d48f521-77fe-3e4c-a276-dc469fd727f6",
                                "text": "Auf dem menorcinischen Küstenwanderweg Camí de Cavalls kann man rund um die Insel die unterschiedlichsten Landschaften erleben."
                            },
                            {
                                "example_id": "640136ab-7aca-43d7-aa2a-cfba780bd807",
                                "sense_id": "6d48f521-77fe-3e4c-a276-dc469fd727f6",
                                "text": "Eine, die sich hier gut auskennt ist Kathrin Thomas, als Parkranger kümmert sie sich im Auftrag des National Trust um die Instandhaltung des Küstenwanderwegs."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
