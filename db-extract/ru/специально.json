                                        "entry_id": "646d5756-faa7-3933-a1c6-9d413814dd64",
                                        "glosses": [
                                            "For a special purpose, person, or occasion."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a531381-ff2f-440e-9094-23715c478e28",
                                                "sense_id": "21eb9376-8027-3afb-bb9d-6fd814b75ea0",
                                                "text": "We had this cake made specially for your birthday."
                                            },
                                            {
                                                "example_id": "83436d6e-88b2-43bf-be7c-ec8fac1d7ce2",
                                                "sense_id": "21eb9376-8027-3afb-bb9d-6fd814b75ea0",
                                                "text": "The train is waiting specially for a high-ranking diplomat."
                                            },
                                            {
                                                "example_id": "7b291f68-7d8b-434a-8c98-7c5d0e33d621",
                                                "sense_id": "21eb9376-8027-3afb-bb9d-6fd814b75ea0",
                                                "text": "The school is specially for any child whose schooling was disrupted by illness."
                                            },
                                            {
                                                "example_id": "2ce6d8d2-afd8-4425-af94-506bf4e278d4",
                                                "sense_id": "21eb9376-8027-3afb-bb9d-6fd814b75ea0",
                                                "text": "I had my insoles specially made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54d34a8a-8b68-3cc3-981d-7dc3b28dc6a0",
                                        "entry_id": "646d5756-faa7-3933-a1c6-9d413814dd64",
                                        "glosses": [
                                            "extremely"
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
