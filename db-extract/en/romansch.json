                                "target_senses": [
                                    {
                                        "sense_id": "ab0be463-7d66-38cc-a481-4d1351d1aa6b",
                                        "entry_id": "cfb3c135-1650-315d-af6f-b7a55675486a",
                                        "glosses": [
                                            "rätoromanische Sprache, die in Graubünden (Schweiz) gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cbf7b4a-7e1c-471b-95a4-a401e75303f8",
                                                "sense_id": "ab0be463-7d66-38cc-a481-4d1351d1aa6b",
                                                "text": "Noch rund 60.000 Schweizer sprechen Rätoromanisch."
                                            },
                                            {
                                                "example_id": "47559017-d169-483e-96db-5394aeb68840",
                                                "sense_id": "ab0be463-7d66-38cc-a481-4d1351d1aa6b",
                                                "text": "„Rätoromanisch hört sich im ersten Moment vielleicht wie Italienisch oder wie ein italienischer Dialekt an.“"
                                            },
                                            {
                                                "example_id": "ce9c263b-088d-427a-a3c4-f0f1af9fb3ca",
                                                "sense_id": "ab0be463-7d66-38cc-a481-4d1351d1aa6b",
                                                "text": "Die Schweiz „ist offiziell mehrsprachig; Französisch, Italienisch und Rätoromanisch stehen im Prinzip gleichberechtigt neben dem Deutschen.“"
                                            },
                                            {
                                                "example_id": "b36f3609-73e8-43ac-97e4-640a55f74d26",
                                                "sense_id": "ab0be463-7d66-38cc-a481-4d1351d1aa6b",
                                                "text": "„Dieser Titel hat seinen Weg von den Langobarden ins Rätoromanische und weiter nordwärts nach Bayern und ins Fränkische genommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff526467-5117-3015-9174-8eb7a188bf73",
                                        "entry_id": "cfb3c135-1650-315d-af6f-b7a55675486a",
                                        "glosses": [
                                            "eine Untergruppe der romanischen Sprachen, die in Italien und der Schweiz gesprochen werden"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
