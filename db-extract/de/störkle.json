                "senses": [
                    {
                        "sense_id": "1ae6e8ae-3122-37be-96b2-dfd6f67f7b90",
                        "entry_id": "5c2eb2b3-b898-30f8-8408-ad9cdae76343",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0933ab8-d74f-4edf-a3b0-f4c7cb294a90",
                                "sense_id": "1ae6e8ae-3122-37be-96b2-dfd6f67f7b90",
                                "text": "Frau Störkle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "67a035e4-3118-4e98-8169-01ce2949e80e",
                                "sense_id": "1ae6e8ae-3122-37be-96b2-dfd6f67f7b90",
                                "text": "Herr Störkle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fb203354-b2a0-4974-8807-a6844caefc42",
                                "sense_id": "1ae6e8ae-3122-37be-96b2-dfd6f67f7b90",
                                "text": "Die Störkles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "08e1f88d-c875-4a79-a391-b7ec287dbc90",
                                "sense_id": "1ae6e8ae-3122-37be-96b2-dfd6f67f7b90",
                                "text": "Der Störkle trägt nie die Pullover, die die Störkle ihm strickt."
                            },
                            {
                                "example_id": "568387b0-ec9a-491c-a020-5a175ded5424",
                                "sense_id": "1ae6e8ae-3122-37be-96b2-dfd6f67f7b90",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Störkle kommt, geht der Herr Störkle.“"
                            },
                            {
                                "example_id": "cd03aeb5-beae-4474-a752-39e6d3dbb22a",
                                "sense_id": "1ae6e8ae-3122-37be-96b2-dfd6f67f7b90",
                                "text": "Störkle kommt und geht."
                            },
                            {
                                "example_id": "f95cd4f7-8181-4e6e-9d76-987de8227da5",
                                "sense_id": "1ae6e8ae-3122-37be-96b2-dfd6f67f7b90",
                                "text": "Störkles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
