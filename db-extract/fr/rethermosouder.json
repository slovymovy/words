                "senses": [
                    {
                        "sense_id": "187c2d1d-8604-3008-a8ac-117a634d8d88",
                        "entry_id": "6adf7bc4-7142-3a88-a575-6f7d10e9d5ee",
                        "glosses": [
                            "Thermosouder à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e205641-3f20-4b6c-8d4d-7697c47612f7",
                                "sense_id": "187c2d1d-8604-3008-a8ac-117a634d8d88",
                                "text": "En cas de décision ultérieure de changement de type de bassin, avec ce type d'aménagement, la baignade naturelle peut se transformer en piscine traditionnelle (le mur mis à niveau plus bas est remonté de façon à atteindre la hauteur du niveau d'eau final et un lé d'étanchéité est alors rethermosoudé sur l'étanchéité existante)."
                            },
                            {
                                "example_id": "63ad5f29-2ea8-4ce6-9985-f2fa3b077193",
                                "sense_id": "187c2d1d-8604-3008-a8ac-117a634d8d88",
                                "text": "(…) tu peux rethermosouder avec une spatule brulante (chauffée à la flamme) en t'inspirant du thermosoudage des rails par les shapers."
                            }
                        ]
                    }
