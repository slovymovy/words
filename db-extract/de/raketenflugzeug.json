                ],
                "senses": [
                    {
                        "sense_id": "71046432-fad5-3cf9-ad0e-2f8dbfa7a5ff",
                        "entry_id": "2befab2b-37a1-372b-be1e-938c18ced2b1",
                        "glosses": [
                            "Flugzeug, bei dem ein Raketentriebwerk für den Vortrieb sorgt; das über einen Raketenantrieb verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "607cc470-553b-4e3c-b257-5b26f4683b74",
                                "sense_id": "71046432-fad5-3cf9-ad0e-2f8dbfa7a5ff",
                                "text": "„Zwei Jahre später, am 20. Juni 1939, manövrierte Warsitz als erster Mensch den funktionstüchtigen Vorläufer des Düsenflugzeugs Heinkel He 178, das Raketenflugzeug Heinkel He 176, durch die Lüfte.“"
                            },
                            {
                                "example_id": "1b0060fb-0ef2-4a1b-a6f6-908a2d4133eb",
                                "sense_id": "71046432-fad5-3cf9-ad0e-2f8dbfa7a5ff",
                                "text": "„Mit Hyperschallgeschwindigkeit nach Australien gleiten: Das DLR entwickelt ein Raketenflugzeug für Interkontinentalflüge.“"
                            },
                            {
                                "example_id": "c0262647-4572-4f13-bc06-8d63026d3117",
                                "sense_id": "71046432-fad5-3cf9-ad0e-2f8dbfa7a5ff",
                                "text": "„Der europäische Luftfahrtkonzern EADS hat am Sonntag Pläne für ein neues Raketenflugzeug präsentiert, das in einigen Jahrzehnten in nur zweieinhalb Stunden von Paris nach Tokio fliegen soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eebd0bc7-6231-4e4b-8b74-8d016cdf6d36",
                        "source_entry_id": "2befab2b-37a1-372b-be1e-938c18ced2b1",
                        "source_sense_id": "71046432-fad5-3cf9-ad0e-2f8dbfa7a5ff",
                        "target_lang_word": "avion-fusée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avion-fusée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2251541f-8f8a-35f7-8dfc-c6a10345be05",
                                        "entry_id": "a5a25bf1-5fa4-3cc3-a9f4-b234c9c970b8",
                                        "glosses": [
                                            "Avion propulsé par un moteur-fusée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2268020b-ee59-4b70-ad22-5b53fe1b9ab7",
                                                "sense_id": "2251541f-8f8a-35f7-8dfc-c6a10345be05",
                                                "text": "Dans vingt minutes exactement, l’avion-fusée se poserait sur l’aire de Kwass, en Australie centrale, et quitterait la zone contrôlée par le satellite."
                                            },
                                            {
                                                "example_id": "133e7484-2d44-4286-8b12-0367c2caba6e",
                                                "sense_id": "2251541f-8f8a-35f7-8dfc-c6a10345be05",
                                                "text": "Si ça n’est déjà pas très facile de présenter un avion relativement classique, que dire des difficultés à surmonter lorsqu’il s’agit d’avions-fusées."
                                            },
                                            {
                                                "example_id": "d0474553-9068-43a2-a661-4d2e956bcc11",
                                                "sense_id": "2251541f-8f8a-35f7-8dfc-c6a10345be05",
                                                "text": "Le lendemain, à huit heures du matin, une vive animation régnait dans l’immense salle des avions-fusées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
