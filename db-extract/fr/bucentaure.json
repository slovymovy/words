                "senses": [
                    {
                        "sense_id": "ee3fa74d-a003-3043-ad1a-32f5c9b5fc5c",
                        "entry_id": "2b3f7619-0584-348c-8890-024abe0fe596",
                        "glosses": [
                            "Bateau de parade utilisé par le doge pour célébrer son mariage avec la mer, le jour de l’Ascension."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebb1a922-a843-479a-8427-fe5877ca53b8",
                                "sense_id": "ee3fa74d-a003-3043-ad1a-32f5c9b5fc5c",
                                "text": "Les enfants, grands et petits, contemplent religieusement avant de se pencher sur la maquette toute dorée du Bucentaure, la nef sur laquelle le doge allait rituellement chaque année renouveler ses noces avec la mer."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "916f82a2-f2cd-39fc-a7a6-fecf6c0903cb",
                "word": "bucentaure",
