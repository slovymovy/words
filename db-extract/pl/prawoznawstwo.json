                                        "sense_id": "de5d89fc-897d-3939-9754-a513aa4c518b",
                                        "entry_id": "c9c472c9-882f-38c8-9191-e98dbcb7e650",
                                        "glosses": [
                                            "Wissenschaft, die sich mit der Auslegung, der systematischen und begrifflichen Durchdringung gegenwärtiger und geschichtlicher juristischer Texte und sonstiger rechtlicher Quellen befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d4af7a1-34d7-415b-a0e5-4fed317cc881",
                                                "sense_id": "de5d89fc-897d-3939-9754-a513aa4c518b",
                                                "text": "Die Rechtswissenschaft ist an vielen Universitäten ein eigenes Studienfach."
                                            },
                                            {
                                                "example_id": "eb34314c-e2f9-4bf3-898e-7b8bcaa1af82",
                                                "sense_id": "de5d89fc-897d-3939-9754-a513aa4c518b",
                                                "text": "„Er hatte in Conakry Rechtswissenschaft studiert, jedoch keine Arbeit gefunden und war auf Umwegen in Faranah gelandet.“"
                                            },
                                            {
                                                "example_id": "3684936d-941b-4c4b-9f3a-2faa9fec0bf5",
                                                "sense_id": "de5d89fc-897d-3939-9754-a513aa4c518b",
                                                "text": "„Man wünschte, daß ich mich weiterhin der Rechtswissenschaft widmen solle, gegen die ich eine unüberwindliche Abneigung empfand.“"
                                            },
                                            {
                                                "example_id": "429e65f7-4d51-4266-ab49-ef76de8487a2",
                                                "sense_id": "de5d89fc-897d-3939-9754-a513aa4c518b",
                                                "text": "„Seinen Doktor der Rechtswissenschaft machte er kurz vor Kriegsbeginn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
