                                        "entry_id": "ce93d50b-d555-357d-8338-6f1075079919",
                                        "glosses": [
                                            "vragend: door+wat? door+welk?:"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cae2cf9a-e299-4138-9f2c-bd59e6697523",
                                                "sense_id": "3c2c2545-4ffa-34cc-b8bd-2a237361d4cb",
                                                "text": "Waardoor kwam dat?"
                                            },
                                            {
                                                "example_id": "30914750-074e-4bdf-b663-f6621da2c058",
                                                "sense_id": "3c2c2545-4ffa-34cc-b8bd-2a237361d4cb",
                                                "text": "Waar zijn ze door in de problemen gekomen?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee6dae3b-86cb-369d-9d07-d6dba319ad36",
                                        "entry_id": "ce93d50b-d555-357d-8338-6f1075079919",
                                        "glosses": [
                                            "betrekkelijk: door+wat, door+hetwelk:"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed73a8c4-565a-468d-8918-d701f81769a5",
                                                "sense_id": "ee6dae3b-86cb-369d-9d07-d6dba319ad36",
                                                "text": "Is dit de poort waardoor je het plein bereikt."
                                            },
                                            {
                                                "example_id": "85cd13cf-d02e-4b2f-8c9b-9b7865415c58",
                                                "sense_id": "ee6dae3b-86cb-369d-9d07-d6dba319ad36",
                                                "text": "Dat is het team waar zij door verslagen zijn."
                                            },
                                            {
                                                "example_id": "96f1ec14-f2e2-4d41-8248-2400c6e5f7d4",
                                                "sense_id": "ee6dae3b-86cb-369d-9d07-d6dba319ad36",
                                                "text": "De jongen naast me deed zijn koplamp aan waardoor de in de muur gekraste namen zichtbaar werden: hier waren al eerder mensen gestrand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73905d2c-276d-40b6-973e-3bd9bdf02020",
                        "source_entry_id": "e29d1d38-4a4c-32f5-9fdd-1f743b44e2b6",
                        "source_sense_description": "in consequence of which",
                        "target_lang_word": "waarna",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
