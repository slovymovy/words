{
    "word_family": [
        "inevitability",
        "inevitably",
        "inevitableness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e434a2c4-1f13-30db-a9e2-3d81430c44fe",
                    "sense_definition": "Impossible to avoid or prevent.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "unavoidable_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were going so fast that the collision was <w>inevitable</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ехали так быстро, что столкновение было <w>неизбежным</w>.",
                                "de": "Wir waren so schnell unterwegs, dass der Zusammenstoß <w>unvermeidlich</w> war."
                            }
                        },
                        {
                            "text": "It is <w>inevitable</w> that changes will happen over time.",
                            "target_lang_translations": {
                                "ru": "<w>Неизбежно</w>, что со временем произойдут перемены.",
                                "de": "Es ist <w>unvermeidlich</w>, dass mit der Zeit Veränderungen eintreten."
                            }
                        }
                    ],
                    "synonyms": [
                        "unavoidable",
                        "inescapable",
                        "unpreventable",
                        "certain"
                    ],
                    "antonyms": [
                        "avoidable",
                        "preventable",
                        "escapable"
                    ],
                    "common_phrases": [
                        "inevitable consequence",
                        "inevitable result",
                        "inevitable conclusion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Невозможно избежать или предотвратить.",
                        "de": "Etwas, das nicht verhindert oder abgewendet werden kann."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неизбежный",
                                "target_lang_sense_clarification": "общий смысл"
                            },
                            {
                                "target_lang_word": "неминуемый",
                                "target_lang_sense_clarification": "о беде или опасности"
                            },
                            {
                                "target_lang_word": "неотвратимый",
                                "target_lang_sense_clarification": "о судьбе или роке"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "unvermeidlich",
                                "target_lang_sense_clarification": "allgemeiner Begriff für etwas, das nicht abzuwenden ist"
                            },
                            {
                                "target_lang_word": "unabwendbar",
                                "target_lang_sense_clarification": "betont die Unmöglichkeit, ein Ereignis oder Schicksal zu verhindern"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b03b02d-756d-388f-b034-87fe5bcfc67f",
                    "sense_definition": "Predictable or always happening.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "predictable_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My outburst met with the <w>inevitable</w> punishment.",
                            "target_lang_translations": {
                                "ru": "За моей вспышкой последовало <w>неизбежное</w> наказание.",
                                "de": "Auf meinen Ausbruch folgte die <w>zwangsläufige</w> Strafe."
                            }
                        },
                        {
                            "text": "He made the <w>inevitable</w> joke about my height when we met.",
                            "target_lang_translations": {
                                "ru": "При встрече он отпустил <w>неизбежную</w> шутку о моем росте.",
                                "de": "Als wir uns trafen, machte er den <w>vorhersehbaren</w> Witz über meine Körpergröße."
                            }
                        }
                    ],
                    "synonyms": [
                        "predictable",
                        "certain"
                    ],
                    "antonyms": [
                        "incidental"
                    ],
                    "common_phrases": [
                        "the inevitable question",
                        "inevitable detail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предсказуемый, ожидаемый или всегда происходящий.",
                        "de": "Vorhersehbar, erwartet oder zwangsläufig eintretend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неизбежный",
                                "target_lang_sense_clarification": "предсказуемый, привычный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zwangsläufig",
                                "target_lang_sense_clarification": "beschreibt eine logische oder natürliche Folge"
                            },
                            {
                                "target_lang_word": "vorhersehbar",
                                "target_lang_sense_clarification": "etwas, das man erwarten konnte"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "75d0d8f9-96b6-3a41-a087-64e3c0b96457",
                    "sense_definition": "Something that is predictable, necessary, or cannot be avoided.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unavoidable_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must learn to accept the <w>inevitable</w> with courage.",
                            "target_lang_translations": {
                                "ru": "Мы должны научиться смело принимать <w>неизбежное</w>.",
                                "de": "Wir müssen lernen, das <w>Unvermeidliche</w> mit Mut zu akzeptieren."
                            }
                        },
                        {
                            "text": "Death is one of the <w>inevitables</w> that every living being faces.",
                            "target_lang_translations": {
                                "ru": "Смерть — это одна из <w>неизбежностей</w>, с которыми сталкивается каждое живое существо.",
                                "de": "Der Tod ist eine der <w>Unvermeidbarkeiten</w>, denen sich jedes Lebewesen stellen muss."
                            }
                        }
                    ],
                    "common_phrases": [
                        "accept the inevitable",
                        "bow to the inevitable"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что предсказуемо, необходимо или чего нельзя избежать.",
                        "de": "Etwas, das vorhersehbar oder notwendig ist und nicht vermieden werden kann."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неизбежное",
                                "target_lang_sense_clarification": "субстантивированное прилагательное"
                            },
                            {
                                "target_lang_word": "неизбежность",
                                "target_lang_sense_clarification": "существительное"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "das Unvermeidliche",
                                "target_lang_sense_clarification": "substantiviertes Adjektiv für ein Ereignis, das eintreten muss"
                            },
                            {
                                "target_lang_word": "die Unvermeidbarkeit",
                                "target_lang_sense_clarification": "das abstrakte Konzept der Unausweichlichkeit"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7893e4e7-91e4-31df-a271-ff8dd957b002",
                    "sense_definition": "The fifty-sixth sura (chapter) of the Qur'an.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "document_or_program_name",
                    "examples": [
                        {
                            "text": "The Imam recited the <w>Inevitable</w> during the evening prayer.",
                            "target_lang_translations": {
                                "ru": "Имам читал суру <w>Неизбежное</w> во время вечерней молитвы.",
                                "de": "Der Imam rezitierte die <w>Al-Wāqiʿa</w> während des Abendgebets."
                            }
                        },
                        {
                            "text": "Scholars study the <w>Inevitable</w> to understand its verses deeply.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают <w>Неизбежное</w>, чтобы глубоко понять её стихи.",
                                "de": "Gelehrte studieren die <w>Al-Wāqiʿa</w>, um ihre Verse tiefgreifend zu verstehen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пятьдесят шестая сура Корана.",
                        "de": "Die 56. Sure des Korans."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Неизбежное",
                                "target_lang_sense_clarification": "название суры"
                            },
                            {
                                "target_lang_word": "Аль-Вакиа",
                                "target_lang_sense_clarification": "транслитерация арабского названия"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Al-Wāqiʿa",
                                "target_lang_sense_clarification": "der arabische Name der Sure"
                            },
                            {
                                "target_lang_word": "Die Unausweichliche",
                                "target_lang_sense_clarification": "deutsche Übersetzung des Titels"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}