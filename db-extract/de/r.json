                "senses": [
                    {
                        "sense_id": "2d44982d-a4f3-35de-9374-741e71edfa40",
                        "entry_id": "eed38caa-bc90-3c9d-972b-51c5a0bd4d0d",
                        "glosses": [
                            "achtzehnter Buchstabe des lateinischen Alphabets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21f2481b-0e68-4f20-a16e-2a5d1ce86c9c",
                                "sense_id": "2d44982d-a4f3-35de-9374-741e71edfa40",
                                "text": "Am Telefon sagt man R wie Richard, aber Funker und Flieger sagen R wie Romeo."
                            },
                            {
                                "example_id": "686b3d76-1019-4f64-b015-f6ec1e3253ba",
                                "sense_id": "2d44982d-a4f3-35de-9374-741e71edfa40",
                                "text": "„Manchmal sehne ich mich danach, rheinisch zu hören, so sehr, daß ich von irgendeinem Hotel aus eine Bonner Telefondienststelle anrufe, um diese vollkommen unmartialische Sprache zu hören, der das R fehlt, genau der Laut, auf dem die militärische Disziplin hauptsächlich beruht.“"
                            },
                            {
                                "example_id": "541fb4f0-e59d-4295-abdb-418541d5dd29",
                                "sense_id": "2d44982d-a4f3-35de-9374-741e71edfa40",
                                "text": "„Hörst du das, murmelte Pétur zu Hölderlin, als er ihren Brief las, in dem einzelne Buchstaben wie das F, das R und auch das P bellen konnten wie Hunde; daher kam Skúli mit der Post, darum sank sein Sarg in die offene Wunde des Friedhofs auf Nes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
