                "senses": [
                    {
                        "sense_id": "18b68417-f66a-3caf-abba-dc0dc150f7ee",
                        "entry_id": "b68bba84-31f0-3853-8587-9d752d783e29",
                        "glosses": [
                            "kazanie pogrzebowe lub rocznicowe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87e7fa3c-a5f0-41f2-be7f-9c9e6ddca0ff",
                                "sense_id": "18b68417-f66a-3caf-abba-dc0dc150f7ee",
                                "text": "Kapelan strażaków wygłosił wspaniałą pogrzebową egzortę, w której nawiązał do żywotu św. Floriana."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1e25229c-cfc8-3023-8272-41483cbbe8ab",
                        "entry_id": "b68bba84-31f0-3853-8587-9d752d783e29",
                        "glosses": [
                            "krótka zachęta w formie kazania wygłaszana przed spowiedzią"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02946fef-c8ad-4cd8-848d-a8f16f551bc8",
                                "sense_id": "1e25229c-cfc8-3023-8272-41483cbbe8ab",
                                "text": "W egzorcie spowiednik przypomniał warunki dobrej spowiedzi."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "6580822d-1ad8-3166-8041-5da585233389",
                        "entry_id": "b68bba84-31f0-3853-8587-9d752d783e29",
                        "glosses": [
                            "moralizująca przemowa"
                        ],
                        "tags": [
                            "humorous",
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "33543bc9-25f4-4603-ae66-0529f449fe98",
                                "sense_id": "6580822d-1ad8-3166-8041-5da585233389",
                                "text": "Nie trawił tych jej egzort, którymi darzyła go podczas śniadania."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "896569de-b135-4507-8880-20ccda8ca45c",
                        "source_entry_id": "b68bba84-31f0-3853-8587-9d752d783e29",
                        "source_sense_id": "18b68417-f66a-3caf-abba-dc0dc150f7ee",
                        "target_lang_word": "exhortation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exhortation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8d2daf2-ba15-3fe7-8f92-99af2af11834",
                                        "entry_id": "c8b4191e-85e8-3d0c-98ab-c670cd1ee183",
                                        "glosses": [
                                            "The act or practice of exhorting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09a869ff-68cf-40ab-8d71-3fee334bcee2",
                                                "sense_id": "d8d2daf2-ba15-3fe7-8f92-99af2af11834",
                                                "text": "All gladly drew round the table, and Mrs. Palmer's exhortation of “Poor dears, do enjoy yourselves,” was fulfilled, even to her own satisfaction."
                                            },
                                            {
                                                "example_id": "7d5b15f3-51c9-40fd-87f5-76a79bb6f70b",
                                                "sense_id": "d8d2daf2-ba15-3fe7-8f92-99af2af11834",
                                                "text": "Earlier on the Other stage on Friday afternoon, Charli XCX took a more straightforward, rabble-rousing approach, a flurry of confetti cannon, inflatables and exhortations to wild hedonism: “I hope everyone gets really fucked up this weekend!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52d95a4b-6348-321c-9b2c-0843c9c08bfa",
                                        "entry_id": "c8b4191e-85e8-3d0c-98ab-c670cd1ee183",
                                        "glosses": [
                                            "Language intended to give advice or to urge or encourage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a26ab0ec-0519-400c-8050-39808cc559f3",
                                                "sense_id": "52d95a4b-6348-321c-9b2c-0843c9c08bfa",
                                                "text": "Come good Lorenzo, faryewell a while,\nIle end my exhortation after dinner."
                                            },
                                            {
                                                "example_id": "9e1f2547-8931-4e34-aead-24d6d01eb943",
                                                "sense_id": "52d95a4b-6348-321c-9b2c-0843c9c08bfa",
                                                "text": "And ye haue forgotten the exhortation which speaketh vnto you as vnto children, My sonne, despise not thou the chastening of the Lord, nor faint when thou art rebuked of him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
