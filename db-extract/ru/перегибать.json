                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d0ecd1f-09d8-4241-a0db-970a92daa8ae",
                                "sense_id": "af3934e5-0f2e-3022-bf53-3240b7f7920c",
                                "text": "Эту бумажку ты аккуратно перегибаешь... вот так... и закладываешь вот сюда."
