                        ],
                        "form": "шизо́иднее"
                    },
                    {
                        "form_id": "13d316e1-4c88-4dc0-a846-6aec0c5c79d7",
                        "entry_id": "a13017cf-df8a-385b-a15c-8e4c9a5feb0a",
