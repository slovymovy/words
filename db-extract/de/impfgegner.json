                            {
                                "example_id": "7d90ec98-2d9a-41c0-9198-934a3c2d6d81",
                                "sense_id": "4efbb1f1-8107-3174-8b60-81cc1088e03d",
                                "text": "„Die Impfgegner kritisieren, dass der Staat in die Entscheidungsfreiheit der Eltern eingreife.“"
                            }
