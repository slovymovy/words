                                "target_senses": [
                                    {
                                        "sense_id": "5ef97134-7c98-3dac-9d32-54a587391889",
                                        "entry_id": "8172d12c-9e5e-3d5e-92ec-68bacedb2634",
                                        "glosses": [
                                            "die Zahl 10³⁰, also eine Eins mit 30 Nullen (Wahrig: „fünfte Potenz einer Million“)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "331d797c-be28-46e5-bea5-92a89b8f7bc2",
                                                "sense_id": "5ef97134-7c98-3dac-9d32-54a587391889",
                                                "text": "Eine Quintillion sind tausend Quadrilliarden."
                                            },
                                            {
                                                "example_id": "df93f3ac-82a2-408a-b77f-cb852d89e2a6",
                                                "sense_id": "5ef97134-7c98-3dac-9d32-54a587391889",
                                                "text": "„Mit erwachender Energie und dem unüberwindlichen Drang nach Zärtlichkeit stürzen wir uns frohlockend in die köstlich brodelnde Menge, erfüllt von Quintillionen gleichgesinnter Grippebazillen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
