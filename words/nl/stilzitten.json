{
    "word_family": [
        "stilzitter",
        "stilzitterij"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "42b254ae-38f2-3407-92a4-3025ed6fadde",
                    "sense_definition": "Fysiek onbeweeglijk of rustig op een stoel of plaats blijven zitten zonder te bewegen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysiek-zitten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar vroeg aan de kinderen om een paar minuten <w>stil</w> te <w>zitten</w> tijdens de toets.",
                            "target_lang_translations": {
                                "en": "The teacher asked the children to <w>sit still</w> for a few minutes during the test."
                            }
                        },
                        {
                            "text": "Het is voor jonge kinderen erg moeilijk om lang <w>stil</w> te <w>zitten</w>.",
                            "target_lang_translations": {
                                "en": "It is very difficult for young children to <w>sit still</w> for a long time."
                            }
                        }
                    ],
                    "synonyms": [
                        "stilzitten"
                    ],
                    "antonyms": [
                        "bewegen",
                        "wiebelen"
                    ],
                    "common_phrases": [
                        "moeilijk stilzitten",
                        "stilzitten in de klas"
                    ],
                    "target_lang_definitions": {
                        "en": "To sit still, remain motionless, or stay quiet without moving."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sit still",
                                "target_lang_sense_clarification": "remaining physically motionless while seated"
                            },
                            {
                                "target_lang_word": "keep still",
                                "target_lang_sense_clarification": "not moving or making noise"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b76bf3e-bd05-3ca7-9abe-f181b6dd1252",
                    "sense_definition": "Geen actie ondernemen of passief afwachten in een bepaalde situatie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "passief-zijn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Terwijl de concurrentie hard werkte, konden wij niet zomaar <w>stilzitten</w>.",
                            "target_lang_translations": {
                                "en": "While the competition was working hard, we couldn't just <w>sit idly by</w>."
                            }
                        },
                        {
                            "text": "In tijden van crisis is het belangrijk om actief te blijven en niet <w>stil</w> te <w>zitten</w>.",
                            "target_lang_translations": {
                                "en": "In times of crisis, it is important to remain active and not <w>sit back</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "afwachten",
                        "luieren"
                    ],
                    "antonyms": [
                        "aanpakken",
                        "handelen",
                        "optreden"
                    ],
                    "common_phrases": [
                        "niet stilzitten"
                    ],
                    "target_lang_definitions": {
                        "en": "To do nothing, remain passive, or fail to take action in a situation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sit idly by",
                                "target_lang_sense_clarification": "failing to take action when needed"
                            },
                            {
                                "target_lang_word": "do nothing",
                                "target_lang_sense_clarification": "remaining passive or inactive"
                            },
                            {
                                "target_lang_word": "sit back",
                                "target_lang_sense_clarification": "refraining from taking action"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}