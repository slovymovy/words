        "fr-extract.jsonl": [
            {
                "entry_id": "7aead8ad-e5a0-3925-8a66-a8f5165f81be",
                "word": "brio",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2afe3aff-c1bd-37e3-9154-9d6bc24d57b4",
                        "entry_id": "7aead8ad-e5a0-3925-8a66-a8f5165f81be",
                        "glosses": [
                            "Caractère brillant et résolu d’une composition ou d’une exécution musicale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b083a65b-8bbe-4a6f-8fff-c0577cc2c969",
                                "sense_id": "2afe3aff-c1bd-37e3-9154-9d6bc24d57b4",
                                "text": "Les cinq femmes jouèrent avec brio l’ouverture de Guillaume Tell."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0bd3967-328c-3906-b1fb-3618e9af87dd",
                        "entry_id": "7aead8ad-e5a0-3925-8a66-a8f5165f81be",
                        "glosses": [
                            "Talent facile et brillant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46d8cbcc-32db-44f7-9298-e59bd59b29a8",
                                "sense_id": "b0bd3967-328c-3906-b1fb-3618e9af87dd",
                                "text": "Parler avec brio."
                            },
                            {
                                "example_id": "d21a4232-abd1-40c5-8682-8ddaf8fb26ed",
                                "sense_id": "b0bd3967-328c-3906-b1fb-3618e9af87dd",
                                "text": "Ce brio, mot italien intraduisible et que nous commençons à employer, est le caractère des premières œuvres. C’est le fruit de la pétulance et de la fougue intrépide du talent jeune, pétulance qui se retrouve plus tard dans certaines heures heureuses ; mais ce brio ne sort plus alors du cœur de l’artiste ; et, au lieu de le jeter dans ses œuvres comme un volcan lance ses feux, il le subit, il le doit à des circonstances, à l’amour, à la rivalité, souvent à la haine, et plus encore aux commandements d’une gloire à soutenir."
                            },
                            {
                                "example_id": "888fcdee-aa27-4233-918e-824a544c2358",
                                "sense_id": "b0bd3967-328c-3906-b1fb-3618e9af87dd",
                                "text": "Brio des gardiennes"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8f9891a-b865-42cd-a840-17fb1d7e0afd",
                        "source_entry_id": "7aead8ad-e5a0-3925-8a66-a8f5165f81be",
                        "target_lang_word": "Schwung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b045da03-5fb7-3656-9a6d-a7f4cc1e73d5",
                                        "entry_id": "bed9c19a-21b3-3794-b47c-6ee39e36cf18",
                                        "glosses": [
                                            "heftige, starke, zügige Bewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bd14103-2958-4f46-8cc6-65102e626266",
                                                "sense_id": "b045da03-5fb7-3656-9a6d-a7f4cc1e73d5",
                                                "text": "Trotz Vollbremsung donnerte das Auto mit Schwung gegen die Wand."
                                            },
                                            {
                                                "example_id": "60623c30-ac22-4e2e-bf18-57ab3ab2efd0",
                                                "sense_id": "b045da03-5fb7-3656-9a6d-a7f4cc1e73d5",
                                                "text": "Wenn du das Seil auf die andere Seite werfen willst, musst du das mit Schwung machen."
                                            },
                                            {
                                                "example_id": "68623deb-2b84-48f6-9fae-61d3e6977c3f",
                                                "sense_id": "b045da03-5fb7-3656-9a6d-a7f4cc1e73d5",
                                                "text": "Dieser Tänzer hat einen wunderbaren Schwung in den Hüften."
                                            },
                                            {
                                                "example_id": "c7e0dc3f-db6d-427b-a820-59f10f96ccb2",
                                                "sense_id": "b045da03-5fb7-3656-9a6d-a7f4cc1e73d5",
                                                "text": "„Er rief den Kosaken, der sein Pferd hielt, befahl ihm, die Tasche und die Flasche an sich zu nehmen, und warf seinen schweren Körper mit einem leichten Schwung in den Sattel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2a46b6b7-e4fc-3181-bcb1-22e0207f9bc9",
                                        "entry_id": "bed9c19a-21b3-3794-b47c-6ee39e36cf18",
                                        "glosses": [
                                            "einen Bogen beschreibende Bewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21e04d1b-8c1f-4be6-9845-0c3f778f6115",
                                                "sense_id": "2a46b6b7-e4fc-3181-bcb1-22e0207f9bc9",
                                                "text": "Mit einem eleganten Schwung bremste sie vor der Skihütte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "368880a8-0079-31b8-8bf1-cd7e741f02bb",
                                        "entry_id": "bed9c19a-21b3-3794-b47c-6ee39e36cf18",
                                        "glosses": [
                                            "Energie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4490a51a-5c37-4f16-8364-9acf5e54942b",
                                                "sense_id": "368880a8-0079-31b8-8bf1-cd7e741f02bb",
                                                "text": "Jetzt bringen wir mal Schwung in den Laden."
                                            },
                                            {
                                                "example_id": "3f6f86c5-9b90-4972-b402-19e80fd17faa",
                                                "sense_id": "368880a8-0079-31b8-8bf1-cd7e741f02bb",
                                                "text": "Mit Schwung ins Neue Jahr!"
                                            },
                                            {
                                                "example_id": "3a0bb2d1-6348-4267-9d84-528827a179b0",
                                                "sense_id": "368880a8-0079-31b8-8bf1-cd7e741f02bb",
                                                "text": "Ich fühle mich schlapp und ohne jeden Schwung."
                                            },
                                            {
                                                "example_id": "b66d9b36-5526-41ef-8bbb-167960eedcf2",
                                                "sense_id": "368880a8-0079-31b8-8bf1-cd7e741f02bb",
                                                "text": "Der Einzelhandel ist im Januar noch ohne Schwung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8afbc030-d5de-356e-831f-4adecac88f0f",
                                        "entry_id": "bed9c19a-21b3-3794-b47c-6ee39e36cf18",
                                        "glosses": [
                                            "eine große Anzahl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81f744bd-38b1-44d3-8f20-4c4bd0c6e188",
                                                "sense_id": "8afbc030-d5de-356e-831f-4adecac88f0f",
                                                "text": "Und dann haben sie auch recht schnell einen ganzen Schwung Kinder gekriegt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19e7b714-2d74-4a9a-873e-461b79343d44",
                        "source_entry_id": "7aead8ad-e5a0-3925-8a66-a8f5165f81be",
                        "target_lang_word": "brio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
