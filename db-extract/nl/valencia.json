                                        "entry_id": "47ed832f-5ebb-30f2-b4ff-2254582ca8e7",
                                        "glosses": [
                                            "Commune, ville et chef-lieu de département français, située dans le département de la Drôme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49af1d59-bc6b-4164-bd0e-b999df3a7502",
                                                "sense_id": "8b36654c-2cf3-3e5a-a675-de069f509fcb",
                                                "text": "[…] et je possède encore dans le tiroir d'un meuble une photographie que mon ami Jean-Marc Bernard m'envoya lors de l’exécution capitale à Valence des chauffeurs de la Drôme."
                                            },
                                            {
                                                "example_id": "a1071ddc-050a-4f3d-bfab-822036c7e0b0",
                                                "sense_id": "8b36654c-2cf3-3e5a-a675-de069f509fcb",
                                                "text": "Jeanne est née à Valence, en France. Une ville de la Drôme souvent confondue avec Valencia, en Espagne."
                                            }
