{
    "word_family": [
        "coziness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c66e7047-0f30-3ecf-ae33-4116a2e8d2c1",
                    "sense_definition": "Giving a feeling of comfort, warmth, and relaxation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent a <w>cozy</w> evening by the fireplace reading books.",
                            "target_lang_translations": {
                                "ru": "Мы провели <w>уютный</w> вечер у камина за чтением книг."
                            }
                        },
                        {
                            "text": "The small cottage felt very <w>cozy</w> during the winter storm.",
                            "target_lang_translations": {
                                "ru": "Маленький домик казался очень <w>уютным</w> во время зимней бури."
                            }
                        }
                    ],
                    "synonyms": [
                        "comfortable",
                        "snug",
                        "warm"
                    ],
                    "antonyms": [
                        "uncomfortable"
                    ],
                    "common_phrases": [
                        "cozy home",
                        "cozy atmosphere",
                        "cozy corner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создающий ощущение комфорта, тепла и уюта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уютный",
                                "target_lang_sense_clarification": "о месте или обстановке, вызывающей чувство комфорта"
                            },
                            {
                                "target_lang_word": "комфортный",
                                "target_lang_sense_clarification": "о физическом удобстве"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "75dbae57-64fd-3e52-ab7f-9683344ce2fc",
                    "sense_definition": "A cover, usually made of fabric or wool, placed over an object like a teapot to keep it warm.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She knitted a colorful tea <w>cozy</w> to keep the pot warm.",
                            "target_lang_translations": {
                                "ru": "Она связала яркую <w>грелку</w> для чайника, чтобы он дольше оставался теплым."
                            }
                        },
                        {
                            "text": "The vintage teapot looked lovely with its matching <w>cozy</w>.",
                            "target_lang_translations": {
                                "ru": "Винтажный чайник выглядел прелестно со своим подходящим <w>чехлом</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tea cozy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чехол (обычно из ткани или шерсти), надеваемый на предмет, например чайник, для сохранения тепла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чехол",
                                "target_lang_sense_clarification": "общий термин для защитного покрытия"
                            },
                            {
                                "target_lang_word": "грелка",
                                "target_lang_sense_clarification": "специальный чехол для чайника"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ee4da5b-5b7c-3e5e-a031-ed6e0a24b28a",
                    "sense_definition": "To become or make something become comfortable or intimate, often used with 'up to'.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat likes to <w>cozy</w> up to me on the sofa.",
                            "target_lang_translations": {
                                "ru": "Кошка любит <w>устраиваться поудобнее</w> рядом со мной на диване."
                            }
                        },
                        {
                            "text": "They tried to <w>cozy</w> up to the new manager to get a promotion.",
                            "target_lang_translations": {
                                "ru": "Они пытались <w>подлизаться</w> к новому менеджеру, чтобы получить повышение."
                            }
                        }
                    ],
                    "synonyms": [
                        "snuggle",
                        "nestle"
                    ],
                    "common_phrases": [
                        "cozy up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устраиваться поудобнее или сближаться с кем-либо, часто используется в выражении 'cozy up to'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устраиваться поудобнее",
                                "target_lang_sense_clarification": "о физическом комфорте"
                            },
                            {
                                "target_lang_word": "подлизываться",
                                "target_lang_sense_clarification": "о попытке добиться расположения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}