                "senses": [
                    {
                        "sense_id": "2ecfa8c7-8c6f-35eb-8c78-1d8a3658a52c",
                        "entry_id": "61c4177c-5e93-38f0-b147-217406307cdc",
                        "glosses": [
                            "To do matchmaking: to set up a date between two people or to arrange a marriage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "084da486-56f2-4054-9c27-1bb4faa9a6d0",
                                "sense_id": "2ecfa8c7-8c6f-35eb-8c78-1d8a3658a52c",
                                "text": "Why then Foible’s a Bawd, an Errant, Rank, Match-making Bawd."
                            },
                            {
                                "example_id": "675ae5df-fc56-4c0d-a85a-b99b19e3d7c9",
                                "sense_id": "2ecfa8c7-8c6f-35eb-8c78-1d8a3658a52c",
                                "text": "And pray remember, I am the last person in the world to match-make."
                            },
                            {
                                "example_id": "992b1e6d-d127-4ca6-ba48-d0d7281efa56",
                                "sense_id": "2ecfa8c7-8c6f-35eb-8c78-1d8a3658a52c",
                                "text": "We are a couple of old fools to be matchmaking so soon ..."
                            },
                            {
                                "example_id": "951693e4-eb2f-4b98-ab58-25a68c7e769a",
                                "sense_id": "2ecfa8c7-8c6f-35eb-8c78-1d8a3658a52c",
                                "text": "Not to brag, but I'm kind of responsible for matchmaking you and Irina."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "548c7941-5901-4d98-ae24-0f583ac51533",
                        "source_entry_id": "61c4177c-5e93-38f0-b147-217406307cdc",
                        "source_sense_id": "2ecfa8c7-8c6f-35eb-8c78-1d8a3658a52c",
