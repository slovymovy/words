                "senses": [
                    {
                        "sense_id": "b5b257ec-881a-3d2a-806f-624f43d7c139",
                        "entry_id": "e91ff5ea-f2ec-352d-8d84-cb53a7564fdc",
                        "glosses": [
                            "Commettre une ou plusieurs malversations."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "683357bd-99c1-434f-abde-b8e6ef65af38",
                                "sense_id": "b5b257ec-881a-3d2a-806f-624f43d7c139",
                                "text": "Il est accusé d’avoir malversé dans sa gestion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df3ae4f8-3866-4e9b-910e-78c43d6eecd7",
                        "source_entry_id": "e91ff5ea-f2ec-352d-8d84-cb53a7564fdc",
                        "source_sense_id": "b5b257ec-881a-3d2a-806f-624f43d7c139",
                        "target_lang_word": "embezzle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embezzle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51a0f939-2d66-3bb5-bffb-518e0eb8c66a",
                                        "entry_id": "e928350c-c601-3174-bd2d-8163daa7f69a",
                                        "glosses": [
                                            "To steal or misappropriate money that one has been trusted with, especially to steal money from the organisation for which one works."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3213bf4d-149b-4b1e-b65f-4de6fc9e4dc6",
                                                "sense_id": "51a0f939-2d66-3bb5-bffb-518e0eb8c66a",
                                                "text": "You waste your education in burglary. You should do one of two things. Either you should forge or you should embezzle. For my own part, I embezzle."
                                            },
                                            {
                                                "example_id": "00b05851-e403-4aa2-97ee-df9dc4b089e9",
                                                "sense_id": "51a0f939-2d66-3bb5-bffb-518e0eb8c66a",
                                                "text": "You let Dunsey have it, sir? And how long have you been so thick with Dunsey that you must collogue with him to embezzle my money?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
