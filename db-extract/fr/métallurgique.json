                                            {
                                                "example_id": "3a4a35fa-b7f8-416f-bcd4-0d80871c8eac",
                                                "sense_id": "ccf848cc-c747-318e-9117-2aa6b173783d",
                                                "text": "„Die Eigenschaften solcher metallischen Schichten unterscheiden sich in der Regel von denen der metallurgisch hergestellten Metalle und Legierungen.“"
                                            },
                                            {
                                                "example_id": "78f0bb68-2687-42b4-9f03-502b87b67929",
                                                "sense_id": "ccf848cc-c747-318e-9117-2aa6b173783d",
                                                "text": "„Die Wärmevorgänge eines metallurgischen Prozesses können in wärmeverbrauchende und in wärmeliefernde eingeteilt werden.“"
                                            }
