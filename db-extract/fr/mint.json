                    {
                        "sense_id": "d7317cfb-4db9-3786-96ba-f88fe6b47c68",
                        "entry_id": "c47827cb-9f01-35d3-8fd2-f55a69d76489",
                        "glosses": [
                            "Groupe de pays formé par le Mexique, l’Indonésie, le Nigeria et la Turquie, dont les économies ont un fort potentiel de croissance au début du XXIᵉ siècle."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "72326de5-cd86-4faa-97b3-f28e956f6e71",
                                "sense_id": "d7317cfb-4db9-3786-96ba-f88fe6b47c68",
                                "text": "Un autre groupe de pays, les MINT, rassemblant le Mexique, l’Indonésie, le Nigeria et la Turquie, a expérimenté le même inaboutissement."
                            }
                        ]
                    }
                ],
