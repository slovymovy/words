                "senses": [
                    {
                        "sense_id": "dccd6462-09de-3c37-89fc-078ed1e3fcd7",
                        "entry_id": "bf4bc6cf-42d6-3beb-8d30-c9782fd506d3",
                        "glosses": [
                            "истор., полит. приверженец или представитель бабувизма; последователь идей Г. Бабёфа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c80cc5a0-4db1-4366-82ec-f8b75434c055",
                                "sense_id": "dccd6462-09de-3c37-89fc-078ed1e3fcd7",
                                "text": "После тяжёлой семейной катастрофы Александр Тургенев в качестве скитальца искал самых разнообразных европейских встреч — он записывал анекдоты Проспера Мериме, любезничал с Виктором Гюго, спорил с Бальзаком о Сведенборге, дружил с карбонарием Андрианом, часами беседовал с бабувистом Буонарроти, путешествовал со знаменитым Стендалем, вместе с Лерминье посещал беседы сенсимонистов."
                            }
                        ]
                    }
                ],
