                ],
                "senses": [
                    {
                        "sense_id": "cd31c309-1edd-34c5-ace2-c45f3bad138b",
                        "entry_id": "6d082c90-89c1-369c-ba31-899940051032",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aabd5fa-9378-4267-b695-09a47ac379de",
                                "sense_id": "cd31c309-1edd-34c5-ace2-c45f3bad138b",
                                "text": "Frau Feistle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2b1445e5-6cdc-46d6-bd6e-2a7ed8ea5b3a",
                                "sense_id": "cd31c309-1edd-34c5-ace2-c45f3bad138b",
                                "text": "Herr Feistle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bacb3df6-bb2a-4f44-ba83-8d8c8fdeb6e2",
                                "sense_id": "cd31c309-1edd-34c5-ace2-c45f3bad138b",
                                "text": "Die Feistles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a9a10186-9cf1-46c0-9c27-fc4c5042a97c",
                                "sense_id": "cd31c309-1edd-34c5-ace2-c45f3bad138b",
                                "text": "Der Feistle trägt nie die Schals, die die Feistle ihm strickt."
                            },
                            {
                                "example_id": "0a76e7b3-7bb8-41b3-95ee-5a2f1a06d675",
                                "sense_id": "cd31c309-1edd-34c5-ace2-c45f3bad138b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Feistle kommt, geht der Herr Feistle.“"
                            },
                            {
                                "example_id": "de6c84aa-9ec1-4554-8b2d-db5bcb6e79d3",
                                "sense_id": "cd31c309-1edd-34c5-ace2-c45f3bad138b",
                                "text": "Feistle kommt und geht."
                            },
                            {
                                "example_id": "931d0ee8-772d-47f6-ae7e-699ceb727d71",
                                "sense_id": "cd31c309-1edd-34c5-ace2-c45f3bad138b",
                                "text": "Feistles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
