                "senses": [
                    {
                        "sense_id": "a1f8419e-bc0b-34c6-940a-554308f40c16",
                        "entry_id": "b88048e5-65c7-3883-8432-18de12d6d246",
                        "glosses": [
                            "To discover again; especially something previously lost or forgotten."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8b336723-fa30-4c2e-852c-4d284d621abc",
                                "sense_id": "a1f8419e-bc0b-34c6-940a-554308f40c16",
                                "text": "She rediscovered her faith in religion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b32b7827-9d7b-46ee-88a0-5e003f14cf81",
                        "source_entry_id": "b88048e5-65c7-3883-8432-18de12d6d246",
                        "source_sense_id": "a1f8419e-bc0b-34c6-940a-554308f40c16",
                        "source_sense_description": "to discover again",
                        "target_lang_word": "herontdekken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herontdekken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "21483153-4e38-3d55-b4aa-5af55dfa3283",
                                        "entry_id": "0084d9c7-5c9f-3db1-bd20-61301ebd60e1",
                                        "glosses": [
                                            "opnieuw ontdekken, weer populair worden van iets wat in de vergetelheid was geraakt"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0abba6bb-786b-4965-9d24-83e3ebc8a42d",
                                                "sense_id": "21483153-4e38-3d55-b4aa-5af55dfa3283",
                                                "text": "Aan het eind van de vijftiende eeuw herontdekte men de oude Griekse en Romeinse cultuur."
                                            },
                                            {
                                                "example_id": "45641057-bda9-4f05-a581-b984d48429ed",
                                                "sense_id": "21483153-4e38-3d55-b4aa-5af55dfa3283",
                                                "text": "Er was nog maar 67 kilo van me over en ik moest thuis een hoop gaan eten om mezelf op te spekken. Verder had ik niet echt het gevoel dat ik veranderd was, ik had eerder het gevoel dat ik mezelf had herontdekt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa86a796-f814-43b2-b735-558e2bf31a1d",
                        "source_entry_id": "b88048e5-65c7-3883-8432-18de12d6d246",
                        "source_sense_id": "a1f8419e-bc0b-34c6-940a-554308f40c16",
                        "source_sense_description": "to discover again",
                        "target_lang_word": "redécouvrir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "redécouvrir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "740b763b-0ffe-3056-9300-d0f3076ab4ef",
                                        "entry_id": "a5364438-4b48-370d-ac94-7dc3ad5be423",
                                        "glosses": [
                                            "Découvrir à nouveau ce qui a été couvert."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46b4bcd9-8bf4-3c33-89a6-eab4f693fd62",
                                        "entry_id": "a5364438-4b48-370d-ac94-7dc3ad5be423",
                                        "glosses": [
                                            "Connaître à nouveau quelque chose que l'on connaissait déjà ; reprendre conscience de quelque chose jadis connu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5cebdcc-e9d1-4289-806d-40294953f694",
                                                "sense_id": "46b4bcd9-8bf4-3c33-89a6-eab4f693fd62",
                                                "text": "On a mis 200 ans à redécouvrir Shakespeare, qu'on avait complètement oublié!"
                                            },
                                            {
                                                "example_id": "3b848648-d7d4-47b1-bd6f-3d4db607f646",
                                                "sense_id": "46b4bcd9-8bf4-3c33-89a6-eab4f693fd62",
                                                "text": "Nous redécouvrîmes le monde extérieur, les premiers rayons de soleil se posaient sur les pins détrempés, la brume enveloppait la terrasse humide et luisante."
                                            },
                                            {
                                                "example_id": "4f9aad39-220c-4493-ab9d-0b90aad1bf2a",
                                                "sense_id": "46b4bcd9-8bf4-3c33-89a6-eab4f693fd62",
                                                "text": "220 convives ont découvert ou redécouvert ce plat régional, préparé par Stéphane Philip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a518e2f1-c988-324c-bf42-a65f482b0437",
                                        "entry_id": "a5364438-4b48-370d-ac94-7dc3ad5be423",
                                        "glosses": [
                                            "Saisir une réalité sous un angle nouveau, ou voir amenée à notre conscience une réalité subconsciente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5570624-5a9d-42d6-aff0-00133c85fcad",
                                                "sense_id": "a518e2f1-c988-324c-bf42-a65f482b0437",
                                                "text": "Dans le Ménon, Platon suggère de la vérité qu’on ne peut pas la découvrir, mais seulement la redécouvrir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e42d18bc-2022-420a-962d-51307a04f49a",
                        "source_entry_id": "b88048e5-65c7-3883-8432-18de12d6d246",
                        "source_sense_id": "a1f8419e-bc0b-34c6-940a-554308f40c16",
                        "source_sense_description": "to discover again",
                        "target_lang_word": "retrouver",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retrouver",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7adfc8f7-e450-3197-b731-346385c71b6a",
                                        "entry_id": "dd2d8818-f482-394e-ad70-838212375679",
                                        "glosses": [
                                            "Revenir en contact avec quelqu'un ou quelque chose dont on avait été séparé, qu'on avait perdu ou qu'on avait oublié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcc17e27-b7af-4776-a803-cafc56a41748",
                                                "sense_id": "7adfc8f7-e450-3197-b731-346385c71b6a",
                                                "text": "Souvent, il prenait l’envie au chef cuisinier du restaurant de prendre sa trial et de sauter les bosses et les fossés pour aller retrouver Gladys."
                                            },
                                            {
                                                "example_id": "296ec01b-30c0-4a87-8bf4-a02e992db5c7",
                                                "sense_id": "7adfc8f7-e450-3197-b731-346385c71b6a",
                                                "text": "Mon père dit toujours que mon sens de l’orientation en forêt est troublant – tout comme mon aptitude à retrouver mon chemin jusqu'au point de départ – mais je ne m'y fiais pas à cet instant. Je m'arrêtai sous un arbre gigantesque."
                                            },
                                            {
                                                "example_id": "068cffb1-b389-4bb5-98bb-0ec45eaccf1d",
                                                "sense_id": "7adfc8f7-e450-3197-b731-346385c71b6a",
                                                "text": "Ils se cherchèrent longtemps les uns les autres, mais ils ne purent se retrouver."
                                            },
                                            {
                                                "example_id": "367c49ec-146a-43f8-8524-2cd15f8a9996",
                                                "sense_id": "7adfc8f7-e450-3197-b731-346385c71b6a",
                                                "text": "Elle n'était pas rassurée. « On n'a pas de liens ensemble, comment tu m'as retrouvée? »\nJ'allais pleurer, lui sauter dans les bras et l'embrasser, lui chuchoter que tout était correct, qu'il n'y avait plus rien de grave. C'était ma mère. Elle le reconnaissait enfin : je l'avais retrouvée. La puissance du verbe. Mes années de lecture me le confirmaient. Une seule phrase, un seul mot peut tout changer. Le cœur gros du mot retrouvée, j'ai balbutié, une boule dans la gorge : « On a encore du du du temps, on va va apprendre à se connaître. Tu as raison, on on s'est retrouvés. C'est l'essentiel."
                                            },
                                            {
                                                "example_id": "8ac7c144-1fc1-4b74-b8d0-73b3ecefc658",
                                                "sense_id": "7adfc8f7-e450-3197-b731-346385c71b6a",
                                                "text": "D'autres seront déportés pour fait de résistance : Benoît Jean, Bombardier Gabriel, Vouaux Jean. Souvent, dans un état de délabrement physique à leur retour, ils retrouveront leur village meurtri, par l’occupation et les luttes qui y eurent lieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9c3a356-eb22-3267-aa81-e3f087807c89",
                                        "entry_id": "dd2d8818-f482-394e-ad70-838212375679",
                                        "glosses": [
                                            "Revenir en contact avec quelque chose qui avait été perdu, voire oublié, par quelqu'un d'autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bab7e7fb-240a-499d-a5ec-16f92b90cc2c",
                                                "sense_id": "f9c3a356-eb22-3267-aa81-e3f087807c89",
                                                "text": "[…] ; enfin Thorwaldsen comptait parmi ses ancêtres un certain Snorre Thorfinnson, qui naquit en Amérique en 1008 , plusieurs siècles avant que Christophe Colomb eût retrouvé ce continent, depuis longtemps connu des Islandais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c31f1676-7e86-36d1-a385-295069be0b7e",
                                        "entry_id": "dd2d8818-f482-394e-ad70-838212375679",
                                        "glosses": [
                                            "Récupérer, rentrer en possession de quelque chose qu'on avait perdu ou oublié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d336517-f0ab-4a55-9009-5700bfd2f59c",
                                                "sense_id": "c31f1676-7e86-36d1-a385-295069be0b7e",
                                                "text": "Les cuisiniers avaient retrouvé intacts leurs appareils de chauffage sans feu et ils avaient préparé du cacao pour les officiers et de la soupe pour les hommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd997f4e-b13a-33e7-99c9-cc61d77640f8",
                                        "entry_id": "dd2d8818-f482-394e-ad70-838212375679",
                                        "glosses": [
                                            "Rejoindre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "009da3cc-44a6-48d7-9382-daf2bb2066fe",
                                                "sense_id": "dd997f4e-b13a-33e7-99c9-cc61d77640f8",
                                                "text": "Plus d’un jeune instituteur stagiaire a retrouvé dans le siècle celle pour qui s’échafaudaient ses odes et ses sonnets."
                                            },
                                            {
                                                "example_id": "a67aaa9f-fd7a-47e8-908d-c336e9fb51c1",
                                                "sense_id": "dd997f4e-b13a-33e7-99c9-cc61d77640f8",
                                                "text": "Jeudi 5 juin, on va chez toi ou chez moi ? Calmez-vous il ne s'agit que du nom du bar où tous les Parisiens qui cherchent une coloc’ pourront se retrouver autour d'une binche pour faire connaissance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b66c4fd9-3747-3019-9d8a-905483a1ba77",
                                        "entry_id": "dd2d8818-f482-394e-ad70-838212375679",
                                        "glosses": [
                                            "Reconnaître."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fae7fd71-5021-48e9-83ac-3c38649b4ff9",
                                                "sense_id": "b66c4fd9-3747-3019-9d8a-905483a1ba77",
                                                "text": "J’ai retrouvé ici la coutume américaine de ne boire aux repas que de l'eau ou du lait."
                                            },
                                            {
                                                "example_id": "0f96f482-8fb1-4f91-89a1-685e9ae9f72c",
                                                "sense_id": "b66c4fd9-3747-3019-9d8a-905483a1ba77",
                                                "text": "Je ne le retrouve pas dans cette occasion."
                                            },
                                            {
                                                "example_id": "3e7c520e-8217-445b-bb48-27e89bb1cd64",
                                                "sense_id": "b66c4fd9-3747-3019-9d8a-905483a1ba77",
                                                "text": "On ne retrouve presque plus ce poète dans les ouvrages de sa vieillesse."
                                            },
                                            {
                                                "example_id": "b336a20e-2b95-440d-938d-0002646dd62f",
                                                "sense_id": "b66c4fd9-3747-3019-9d8a-905483a1ba77",
                                                "text": "On le retrouve toutes les fois qu’il s’agit d’honneur, d’humanité."
                                            },
                                            {
                                                "example_id": "b88c6580-370d-4a64-92ee-b083a1bf9a50",
                                                "sense_id": "b66c4fd9-3747-3019-9d8a-905483a1ba77",
                                                "text": "Il se cherche lui-même et ne se retrouve plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b55f526-b885-3570-beaf-8f4bbac88f1f",
                                        "entry_id": "dd2d8818-f482-394e-ad70-838212375679",
                                        "glosses": [
                                            "Reconnaître son chemin, s’orienter, se repérer."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ba615df-085f-4683-ad6b-529c20089deb",
                                                "sense_id": "3b55f526-b885-3570-beaf-8f4bbac88f1f",
                                                "text": "Je connais mal le chemin et je ne suis pas sûr de me retrouver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bc4a90c-8b52-3cc3-a89f-e0b4f377c08f",
                                        "entry_id": "dd2d8818-f482-394e-ad70-838212375679",
                                        "glosses": [
                                            "Prendre ou reprendre une position ou une situation."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3696c92-f041-427c-bac7-77f1e30620a2",
                                                "sense_id": "1bc4a90c-8b52-3cc3-a89f-e0b4f377c08f",
                                                "text": "Si vous vous retrouvez pris dans la baïne, ne tentez pas de rejoindre la terre ferme en nageant à contre-courant."
                                            },
                                            {
                                                "example_id": "c407eaf7-10f8-4869-bd98-035426b32b54",
                                                "sense_id": "1bc4a90c-8b52-3cc3-a89f-e0b4f377c08f",
                                                "text": "Enfin elle se retrouva en position assise, un peu avachie, adossée à la tête de lit, les bras écartés en l'air, les reins calés contre l’oreiller trempé de sueur dans sa taie de coton froissée."
                                            },
                                            {
                                                "example_id": "a9c31536-3e88-4006-b527-3c9c600ebfe5",
                                                "sense_id": "1bc4a90c-8b52-3cc3-a89f-e0b4f377c08f",
                                                "text": "Le capitaine Zondi préparait mentalement sa riposte. Il ne voulait surtout pas se retrouver avec cette casse-burnes dans les pattes."
                                            },
                                            {
                                                "example_id": "283df10d-a689-4b7d-b502-f2e246d6cd5f",
                                                "sense_id": "1bc4a90c-8b52-3cc3-a89f-e0b4f377c08f",
                                                "text": "Un invité, pensant pouvoir parler dorénavant librement, s'est retrouvé à Oukacha, la prison voisine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a17b6ba9-0439-4ca1-8120-a6e5a872f227",
                        "source_entry_id": "b88048e5-65c7-3883-8432-18de12d6d246",
