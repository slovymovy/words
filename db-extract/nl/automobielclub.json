                        "examples": [
                            {
                                "example_id": "32ba914e-fc6b-4e7a-94c0-38f6b34ecf3a",
                                "sense_id": "f3debe83-3867-3988-98c5-8b083905047c",
                                "text": "De Duitse automobielclub ADAC waarschuwt automobilisten tegen het dragen van dikke winterjassen onder de autogordel. Vooral kinderen kunnen daar bij een noodstop zware en zelfs dodelijke verwondingen door oplopen."
                            },
                            {
                                "example_id": "70fc3521-cb04-4c83-b500-b3e1e175d5bf",
                                "sense_id": "f3debe83-3867-3988-98c5-8b083905047c",
                                "text": "De Duitse automobielclub ACE wil weten hoe VW de uitstoot test. Bovendien is ACE benieuwd hoe andere merken daarmee omgaan. \"Het is zeer waarschijnlijk dat ook andere fabrikanten bij het testen software gebruiken, waarvan de resultaten niets te maken hebben met de feitelijke uitstoot\", zegt een woordvoerder van ACE."
                            }
                        ]
