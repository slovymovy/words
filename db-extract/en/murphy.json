                        "sense_id": "4a5a577b-5d0f-3840-8491-bb48fc9c0a4d",
                        "entry_id": "0240dad2-5e16-31ff-ae9a-b29f7a984998",
                        "glosses": [
                            "A common surname from Irish, the anglicized form of Irish Ó Murchadha"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b17bbf3-8eff-4d74-abdf-af950938509f",
                                "sense_id": "4a5a577b-5d0f-3840-8491-bb48fc9c0a4d",
                                "text": "After a long talk between these two, and a little broken English from the Frenchmen, our visitors took leave; but Father Murphy had hardly gone a dozen rods when back he came, inquiring whether we were in want of anything."
                            }
                        ]
                    },
                    {
                        "sense_id": "66786d2f-9d6b-3d61-abd2-6bd82c53aab2",
                        "entry_id": "0240dad2-5e16-31ff-ae9a-b29f7a984998",
                        "glosses": [
                            "A unisex given name transferred from the surname, of occasional usage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "558ea2e8-bc1f-4497-991c-9df8b5b993e9",
                                "sense_id": "66786d2f-9d6b-3d61-abd2-6bd82c53aab2",
                                "text": "Sonja made me promise I would go to college. She said she'd wanted her daughter, Murphy, to go. She'd named her baby Murphy because it could never be a stripper name. But her daughter had changed her name to London."
                            }
                        ]
                    },
