                "senses": [
                    {
                        "sense_id": "03de462b-b7ab-3d2a-a351-6fa10c6ebbd8",
                        "entry_id": "43fb0b05-2e53-3334-9861-fbb356857b2e",
                        "glosses": [
                            "komplexe (militärische) Auseinandersetzung, Streitpunkt zwischen vielen verschiedenen Interessengruppen, unter Einbeziehung zahlreicher Akteure"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d2e1713-75e0-4a8c-b214-a53fe13de6a1",
                                "sense_id": "03de462b-b7ab-3d2a-a351-6fa10c6ebbd8",
                                "text": "„Der Kern der Ukraine-Krise ist ein kulturell-moralischer Großkonflikt: Sollen Europas Grenzen territorialem Raubrittertum anheimfallen dürfen?“"
                            },
                            {
                                "example_id": "b254c716-8358-451c-adfb-161ef7b946f2",
                                "sense_id": "03de462b-b7ab-3d2a-a351-6fa10c6ebbd8",
                                "text": "„1979 löste eine Computerpanne im Kontrollraum von Norad – der nordamerikanischen Luftabwehr – fast einen Großkonflikt aus (…). Das System meldete, sowjetische Raketen seien Richtung Amerika unterwegs. Wie sich noch rechtzeitig herausstellte, hatte ein Techniker versehentlich ein Programm abgespielt, das einen Angriff simulierte.“"
                            }
                        ],
