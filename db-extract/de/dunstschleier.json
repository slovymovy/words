                        "examples": [
                            {
                                "example_id": "23709216-79d7-4e50-bdde-f1e81c05555f",
                                "sense_id": "367b7fba-4ec7-3713-96dd-7b54b7ef9df1",
                                "text": "„Ein leiser Dunstschleier lag vor ihnen im Himmel und machte ihr Licht gedämpfter und nicht so kalt.“"
                            },
                            {
                                "example_id": "3d427666-2c67-4410-89b0-5547c74eebb1",
                                "sense_id": "367b7fba-4ec7-3713-96dd-7b54b7ef9df1",
                                "text": "„Am nachmittäglichen Himmel hing ein milchiger Dunstschleier, der am Horizont hellrosa war und mit zunehmender Höhe in ein zartes Blassblau überging.“"
                            }
                        ],
