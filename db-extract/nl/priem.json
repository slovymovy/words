                        "target_lang_word": "awl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "awl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5617caf-9e65-377b-a039-069908393e61",
                                        "entry_id": "b1b52191-8f9c-3a67-a142-aa86d72d2f33",
                                        "glosses": [
                                            "A pointed instrument for piercing small holes, as in leather or wood; used by shoemakers, saddlers, cabinetmakers, etc. The blade is differently shaped and pointed for different uses, as in the brad awl, saddler's awl, shoemaker's awl, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba5f5f56-5780-4ec2-99e1-b000c2696f1f",
                                                "sense_id": "d5617caf-9e65-377b-a039-069908393e61",
                                                "text": "He dressed himself in some old ragged clothes, and took a tame white bear, which he had, with him, as well as an awl, some pitch, and twine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7ff332f-8f17-3568-a462-1f92031c49d8",
                                        "entry_id": "b1b52191-8f9c-3a67-a142-aa86d72d2f33",
                                        "glosses": [
                                            "Any of various hesperiid butterflies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93c787c8-70d4-4cc7-af1c-2ca08abdaf7d",
                        "source_entry_id": "df4151b7-e570-3b61-93f1-0c6e32585b21",
