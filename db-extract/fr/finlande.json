        "fr-extract.jsonl": [
            {
                "entry_id": "b733851b-65c7-39c5-8697-be4e350b9544",
                "word": "Finlande",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2012ce1d-ba49-34b9-9049-596100d052f7",
                        "entry_id": "b733851b-65c7-39c5-8697-be4e350b9544",
                        "glosses": [
                            "Pays de l’Europe du Nord, bordé à l’est par la Russie, au nord par la Norvège, au nord-ouest par la Suède et à l’ouest et au sud par la mer Baltique. Sa capitale est Helsinki."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "e52678c3-3cdf-43ac-ae1e-53fb9aef6305",
                                "sense_id": "2012ce1d-ba49-34b9-9049-596100d052f7",
                                "text": "Mais il a laissé son kantele mélodieux à la Finlande, c’est-à-dire des runes sublimes aux fils de sa race, une joie éternelle à son peuple."
                            },
                            {
                                "example_id": "860af4a0-aa18-45a4-b333-25f6cf367d3f",
                                "sense_id": "2012ce1d-ba49-34b9-9049-596100d052f7",
                                "text": "La Finlande a été désignée vendredi « pays le plus heureux du monde » pour la quatrième année de suite, devançant le Danemark, la Suisse et l'Islande dans un classement du bonheur où l'impact de la COVID-19 a été étonnamment contrasté."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15e52bf9-e700-4024-99f0-7c44a6d3f367",
                        "source_entry_id": "b733851b-65c7-39c5-8697-be4e350b9544",
                        "source_sense_id": "2012ce1d-ba49-34b9-9049-596100d052f7",
                        "target_lang_word": "Finnland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Finnland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f41bec4-56b9-3a06-8e65-b092d743b7d6",
                                        "entry_id": "d5633512-23a1-3805-a745-1aa64667cf8c",
                                        "glosses": [
                                            "Land in Nordeuropa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfff3b8c-8b25-44f1-982d-d3ad00968ca5",
                                                "sense_id": "8f41bec4-56b9-3a06-8e65-b092d743b7d6",
                                                "text": "Finnland ist reich an Seen und Wäldern."
                                            },
                                            {
                                                "example_id": "ce912205-7565-470c-88ae-c0cc85656b76",
                                                "sense_id": "8f41bec4-56b9-3a06-8e65-b092d743b7d6",
                                                "text": "Helsinki ist die Hauptstadt von Finnland."
                                            },
                                            {
                                                "example_id": "95077237-ad20-483c-b3b9-198510239de6",
                                                "sense_id": "8f41bec4-56b9-3a06-8e65-b092d743b7d6",
                                                "text": "Meine Freundin möchte unbedingt wieder nach Finnland."
                                            },
                                            {
                                                "example_id": "69509c38-69a7-485d-ab5a-64447b642215",
                                                "sense_id": "8f41bec4-56b9-3a06-8e65-b092d743b7d6",
                                                "text": "„Finnland hat die Welt gerettet.“"
                                            },
                                            {
                                                "example_id": "5a5c5f33-4dd5-46c7-ab74-0cf86d001701",
                                                "sense_id": "8f41bec4-56b9-3a06-8e65-b092d743b7d6",
                                                "text": "„Es gibt drei Millionen Saunas in Finnland, mehr als es Autos im Lande gibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea286409-c5d5-46bb-b2cc-d829f04f6188",
                        "source_entry_id": "b733851b-65c7-39c5-8697-be4e350b9544",
                        "source_sense_id": "2012ce1d-ba49-34b9-9049-596100d052f7",
                        "target_lang_word": "Finland",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
