                                                "sense_id": "b4c49e93-5afe-3d4e-aa5d-7efb541d9c0f",
                                                "text": "Some of the stadiums being built for the World Cup soccer tournament, scheduled for next year, have also been criticized for delays and cost overruns, and have become subjects of derision as protesters question whether they will become white elephants."
                                            },
                                            {
                                                "example_id": "e08725ef-55ce-422e-a01f-55110a08a8f3",
                                                "sense_id": "b4c49e93-5afe-3d4e-aa5d-7efb541d9c0f",
                                                "text": "Tesla’s first decade was plagued by unmet deadlines, technical snafus and cost overruns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6a8c785-57c1-392a-b6a4-5a3eb4580f01",
                                        "entry_id": "d465eb7a-93d4-3e8b-88c6-d3a701b6e698",
                                        "glosses": [
                                            "The amount by which something overruns."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da21f39f-709c-4586-addb-2d3d806da7f0",
                                                "sense_id": "f6a8c785-57c1-392a-b6a4-5a3eb4580f01",
                                                "text": "At least this year's overrun isn't as unmanageable as last year!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecdb1c99-42cd-3530-98ae-11359b9af36f",
                                        "entry_id": "d465eb7a-93d4-3e8b-88c6-d3a701b6e698",
                                        "glosses": [
                                            "An area of terrain beyond the end of a runway that is kept flat and unobstructed to allow an aircraft that runs off the end of the runway to stop safely."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "149b0f8b-92db-4f52-8a89-e0cb9870c13d",
                                                "sense_id": "ecdb1c99-42cd-3530-98ae-11359b9af36f",
                                                "text": "The runway has 7,000 feet of paved surface, plus a 2,000-foot grass overrun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcfdc3d9-bb9b-370f-b7e6-240b073ca427",
                                        "entry_id": "d465eb7a-93d4-3e8b-88c6-d3a701b6e698",
                                        "glosses": [
                                            "Air that is whipped into a frozen dessert to make it easier to serve and eat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
