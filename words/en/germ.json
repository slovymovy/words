                    "sense_id": "04cc6fba-012f-3779-97e5-bbc5635b0404",
                    "sense_definition": "A person from Germany.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nationality",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "In some old texts, the word <w>Germ</w> was used as a shorthand for a German national.",
                            "target_lang_translations": {
                                "ru": "В некоторых старых текстах слово <w>германец</w> использовалось как сокращение для обозначения гражданина Германии."
                            }
