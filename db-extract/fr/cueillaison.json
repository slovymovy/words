                    }
                ],
                "senses": [
                    {
                        "sense_id": "b6a11dca-4c89-344f-a76e-5be34829133a",
                        "entry_id": "1b8f333f-f7d5-3b93-b53c-696ccc383637",
                        "glosses": [
                            "Époque où l’on cueille les fruits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "721619fa-c070-4dac-8c3b-695c5e9df48a",
                                "sense_id": "b6a11dca-4c89-344f-a76e-5be34829133a",
                                "text": "C’est la cueillaison des pêches, des poires, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "108b809b-f754-395d-ab0c-806584f7c3e1",
                        "entry_id": "1b8f333f-f7d5-3b93-b53c-696ccc383637",
                        "glosses": [
                            "Cueillette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ecb8442-30fd-4c33-88a0-dab9c847f6cf",
                                "sense_id": "108b809b-f754-395d-ab0c-806584f7c3e1",
                                "text": "Notre grand jardin nous fournissait les fruits et les légumes en abondance. Le moment de la cueillaison ne voyait que des volontaires. C’était surtout les cerises que nous aimions rechercher sous les feuilles."
                            },
                            {
                                "example_id": "a2248158-a99e-4599-925e-665c7c7931d7",
                                "sense_id": "108b809b-f754-395d-ab0c-806584f7c3e1",
                                "text": "Ma songerie aimant à me martyriser\nS’enivrait savamment du parfum de tristesse\nQue même sans regret et sans déboire laisse\nLa cueillaison d’un Rêve au cœur qui l’a cueilli."
                            },
                            {
                                "example_id": "9398a34a-e96d-409e-9192-aa248bb0a2eb",
                                "sense_id": "108b809b-f754-395d-ab0c-806584f7c3e1",
                                "text": "Le geste de la cueillaison, où plutôt l’invitation à la cueillaison sera la représentation symbolique par excellence de la jouissance de cet instant, où le bonheur est saisi dans son instantanéité, comme on cueille une rose."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8cd7054-3bfe-4beb-8f6b-a1c19ac3476e",
