                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b95eb6ae-88e2-394c-8e2e-779d4b76f823",
                                        "entry_id": "4ff3dabb-09c0-366c-aef4-d210af3ca8d2",
                                        "glosses": [
                                            "che cerca di raggiungere quanto presume esemplare, spesso senza una reale conoscenza, pur mancandovi in attitudine o natura e soprattutto per avere posizioni sociali di rilievo poi non sempre riconosciute dai più"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36b912a2-9791-49d8-8404-52605e2d9b23",
                                                "sense_id": "b95eb6ae-88e2-394c-8e2e-779d4b76f823",
                                                "text": "quell'individuo arrogante perse la leadership perché senza appoggio politico"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc107a28-9642-35e3-9c24-d764324f99c0",
                                        "entry_id": "4ff3dabb-09c0-366c-aef4-d210af3ca8d2",
                                        "glosses": [
                                            "che cerca di \\\"mettersi al centro dell'attenzione\\\" malgrado non sia apprezzato né stimato"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
