                                "target_word": "plébiscite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b52add7-b0bc-3a2f-81df-a7a28921effb",
                                        "entry_id": "9156cf40-58c9-319e-befa-e8bc66c18f4f",
