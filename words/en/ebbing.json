    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1aa4893f-03d7-3a58-b329-fc3b7a9232ee",
                    "sense_definition": "Present participle of <w>ebb</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ocean tide was gradually <w>ebbing</w> away from the sandy shore.",
                            "target_lang_translations": {
                                "ru": "Океанский прилив постепенно <w>отступал</w> от песчаного берега."
                            }
                        },
                        {
                            "text": "He felt his energy and confidence <w>ebbing</w> as the meeting dragged on.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, как его энергия и уверенность <w>иссякают</w> по мере того, как собрание затягивалось."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ebbing tide",
                        "ebbing away"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола ebb; убывающий, отступающий (о воде), угасающий или слабеющий (о силах, чувствах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отступающий",
                                "target_lang_sense_clarification": "о приливе или воде"
                            },
                            {
                                "target_lang_word": "убывающий",
                                "target_lang_sense_clarification": "о воде или уровне чего-либо"
                            },
                            {
                                "target_lang_word": "угасающий",
                                "target_lang_sense_clarification": "о силах, энергии или чувствах"
                            },
                            {
                                "target_lang_word": "иссякающий",
                                "target_lang_sense_clarification": "о силе, терпении или уверенности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f85b066-c03b-3cea-84ab-d0654d8bcf54",
                    "sense_definition": "The action, process, or an instance of flowing back or receding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The continuous <w>ebbing</w> of the waters revealed ancient stones along the shore.",
                            "target_lang_translations": {
                                "ru": "Непрерывный <w>отлив</w> вод обнажил древние камни вдоль берега."
                            }
                        },
                        {
                            "text": "She watched the <w>ebbing</w> and flowing of the political tides over many decades.",
                            "target_lang_translations": {
                                "ru": "Она наблюдала за <w>приливами и отливами</w> на политической арене на протяжении многих десятилетий."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ebbing and flowing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс отступления (воды при отливе), спад, угасание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отлив",
                                "target_lang_sense_clarification": "отход морской воды"
                            },
                            {
                                "target_lang_word": "спад",
                                "target_lang_sense_clarification": "уменьшение уровня, активности или влияния"
                            },
                            {
                                "target_lang_word": "угасание",
                                "target_lang_sense_clarification": "постепенное исчезновение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
