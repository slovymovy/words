                        "glosses": [
                            "To creep in; to make a furtive entrance."
                        ],
                        "tags": [
                            "intransitive",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "efdf7fe4-4655-4d79-82f5-5453cd868f96",
                                "sense_id": "4fed71c3-50e5-39ed-9abd-21002382b642",
                                "text": "1849, Henoch Clapham, quoted in Jane Eliza Leeson, Chapters on Deacons\nFirst, order gone, and doores not being kept, / By baptisme heaps of prophane do rush. / With them, at length, a ministry incrept, / That with the horn God's ordinance did push."
                            },
                            {
                                "example_id": "d9d3e055-abde-4a93-99fa-ebb2981711d3",
                                "sense_id": "4fed71c3-50e5-39ed-9abd-21002382b642",
                                "text": "It seemed a thing for weeping / To find, at slumber's wane / And morning's sly increeping, / That Now, not Then, held reign."
                            }
                        ]
                    }
