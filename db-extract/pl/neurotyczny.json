                        ],
                        "form": "neurotyczne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe8afdd1-f65c-3ca1-aae7-d902ee121565",
                        "entry_id": "daba44c3-727a-3ac0-92cc-dba914a07995",
                        "glosses": [
                            "mający skłonność do nerwicowych reakcji lub cierpiący na nerwicę"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "30b5c5fb-891e-3e73-b5d9-c54bbc176977",
                        "entry_id": "daba44c3-727a-3ac0-92cc-dba914a07995",
                        "glosses": [
                            "będący skutkiem zaburzeń nerwicowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bca5a5fb-d29f-4181-aa45-3d079bfc98c3",
                                "sense_id": "30b5c5fb-891e-3e73-b5d9-c54bbc176977",
                                "text": "Psychologowie różnych szkół są zgodni, że takie odkrycie przyczyny, czy \"freudowskie odreagowanie\", może uwolnić człowieka od neurotycznych reakcji lękowych"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "7289139e-31f6-3bb8-aefb-56b1d415c551",
                        "entry_id": "daba44c3-727a-3ac0-92cc-dba914a07995",
                        "glosses": [
                            "wywołujący niepokój"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dca26d6e-99c7-45ca-909c-2371eb4a6e15",
                                "sense_id": "7289139e-31f6-3bb8-aefb-56b1d415c551",
                                "text": "Oczekiwanie na powszechny kryzys przybrało już rozmiary niemal neurotyczne"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b969812-c7a1-4089-969b-8ca34c75b45f",
                        "source_entry_id": "daba44c3-727a-3ac0-92cc-dba914a07995",
                        "source_sense_id": "fe8afdd1-f65c-3ca1-aae7-d902ee121565",
                        "target_lang_word": "neurotic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neurotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e14399c-ad90-32ef-a1ac-5a1b3cc85228",
                                        "entry_id": "f0d06d75-9359-3cb5-b08e-910bb3777edc",
                                        "glosses": [
                                            "Affected with a neurosis."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45d3370b-5c11-40f3-8e8e-1405fa95cb7d",
                                                "sense_id": "0e14399c-ad90-32ef-a1ac-5a1b3cc85228",
                                                "text": "If there were such a thing as inspiration from a higher realm, it might well be that the neurotic temperament would furnish the chief condition of the requisite receptivity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cee4b3af-b6d6-3924-b9a3-a3c4f3d1fc81",
                                        "entry_id": "f0d06d75-9359-3cb5-b08e-910bb3777edc",
                                        "glosses": [
                                            "Overly anxious."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f1edc2a-2160-4e5e-a3e2-55a840e06159",
                                                "sense_id": "cee4b3af-b6d6-3924-b9a3-a3c4f3d1fc81",
                                                "text": "He is getting neurotic about time-keeping."
                                            },
                                            {
                                                "example_id": "e7ada65e-4d13-4587-b2da-cb9c64394a06",
                                                "sense_id": "cee4b3af-b6d6-3924-b9a3-a3c4f3d1fc81",
                                                "text": "“I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera, the gorged dowagers, the worn-out, passionless men,[…], the speed-mad fugitives from the furies of ennui, the neurotic victims of mental cirrhosis,[…]!”"
                                            },
                                            {
                                                "example_id": "1a2a1df2-f3ff-4d01-87b3-20bd0d962dd0",
                                                "sense_id": "cee4b3af-b6d6-3924-b9a3-a3c4f3d1fc81",
                                                "text": "“You did come down a wallop, didn't you? How art thou fallen from heaven, oh Lucifer, son of the morning, I said to myself. You're so terribly neurotic, Bertie. You must try to be less jumpy. What you need is a good nerve tonic.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4809abb0-05c2-3289-89b2-c6566f7a0210",
                                        "entry_id": "f0d06d75-9359-3cb5-b08e-910bb3777edc",
                                        "glosses": [
                                            "Useful in disorders of, or affecting, the nerves."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "neurotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf7508b-6506-32fa-b185-85a68db4be36",
                                        "entry_id": "85fe07bd-c171-3ba1-a4a3-5093133ab952",
                                        "glosses": [
                                            "A person who has a neurosis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17723cb8-4a60-3bde-9b84-7480b0636291",
                                        "entry_id": "85fe07bd-c171-3ba1-a4a3-5093133ab952",
                                        "glosses": [
                                            "A crazy person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9706d1a-63fc-450e-8983-8723c31c8c7c",
                                                "sense_id": "17723cb8-4a60-3bde-9b84-7480b0636291",
                                                "text": "Drag this neurotic to hysterics, leave him balked and unfulfilled;\nholding inside, outwardly patient 'til the time he'll call it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17382078-328d-4273-a2f4-e462adbf1657",
                        "source_entry_id": "daba44c3-727a-3ac0-92cc-dba914a07995",
                        "source_sense_id": "fe8afdd1-f65c-3ca1-aae7-d902ee121565",
                        "target_lang_word": "névrotique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "névrotique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20d4fcb1-216d-38f6-9e0a-9a38770dfebf",
                                        "entry_id": "906536fa-18dd-3ef2-a476-e1259ea4a18f",
                                        "glosses": [
                                            "Qui relève de la névrose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c710595-f19d-4e6a-8f60-3c9f759cefcd",
                                                "sense_id": "20d4fcb1-216d-38f6-9e0a-9a38770dfebf",
                                                "text": "Les troubles névrotiques sont imprégnés d’une tonalité dépressive qui domine le tableau clinique."
                                            },
                                            {
                                                "example_id": "91ac3a7e-ffe5-4b52-b0e1-cc1b51c199a2",
                                                "sense_id": "20d4fcb1-216d-38f6-9e0a-9a38770dfebf",
                                                "text": "Nous ferons ensuite apparaître des analogies étonnantes entre le fonctionnement névrotique et la « personnalité moderne », ainsi qu’entre le fonctionnement limite et la « personnalité contemporaine »."
                                            },
                                            {
                                                "example_id": "619e9637-5083-42d5-8dc7-7ff9edcf6bd5",
                                                "sense_id": "20d4fcb1-216d-38f6-9e0a-9a38770dfebf",
                                                "text": "Elle consiste simplement à créer un espace où il est possible de déployer et défaire nos jeux névrotiques, nos auto-illusions, nos peurs et nos espoirs cachés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "névrotique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99d8629b-db46-3e66-b145-7d682033319a",
                                        "entry_id": "436b8563-8d32-32b9-8d35-029da0619045",
                                        "glosses": [
                                            "Personne atteinte de névrose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8eb3f92-19d4-4aed-9cc8-09c316055b79",
                                                "sense_id": "99d8629b-db46-3e66-b145-7d682033319a",
                                                "text": "On peut dire d’une façon un peu paradoxale que lorsqu’un enfant, de niveau sensiblement normal, est inadapté à la fois au groupe et au travail il y a plus de chance pour qu’il s’agisse d’un névrotique que d’un schizophrène."
                                            },
                                            {
                                                "example_id": "9f0dd458-ff73-46f5-9989-6993f9caa43e",
                                                "sense_id": "99d8629b-db46-3e66-b145-7d682033319a",
                                                "text": "Il s’agit d’une névrotique grave, déprimée et obsédée par la culpabilité liée à l’avortement. Traitée successivement par des électrochocs et des narco-analyses elle ne révèle pendant son sommeil que le seul désir d’avoir un enfant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6690fca2-6bc2-4ea3-87e9-c439a43c36ca",
                        "source_entry_id": "daba44c3-727a-3ac0-92cc-dba914a07995",
                        "source_sense_id": "fe8afdd1-f65c-3ca1-aae7-d902ee121565",
                        "target_lang_word": "невротический",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "невротический",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1e4cdf96-e5bc-3ec3-8d77-ad123d59e8be",
                                        "entry_id": "352ee745-0186-3f99-85d2-f4cfa5498dbb",
                                        "glosses": [
                                            "мед. связанный, соотносящийся по значению с существительными невроз, невротизм"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5da346a9-4873-459a-a3f5-77128c47fdfa",
                                                "sense_id": "1e4cdf96-e5bc-3ec3-8d77-ad123d59e8be",
                                                "text": "Если по характеру желания мы часто в состоянии судить об источнике его, если по содержанию фантазии не трудно узнать породившее его влечение, то, переходя через сновидение и невротический симптом, связь которых с определенными функциями организма может быть выяснена методом Фрейда, к содержанию галлюцинаторных и бредовых явлений в некоторых случаях, можно поставить себе задачей выяснить эндогенный момент, обусловливающий данное содержание."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e2065dd-f2d3-41af-93a5-4de7d0cb7a3b",
                        "source_entry_id": "daba44c3-727a-3ac0-92cc-dba914a07995",
                        "source_sense_id": "30b5c5fb-891e-3e73-b5d9-c54bbc176977",
                        "target_lang_word": "невротический",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
