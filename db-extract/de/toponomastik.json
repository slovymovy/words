                                        "sense_id": "8cada07f-1748-3ab9-93ef-8527b66911ec",
                                        "entry_id": "1b8b7fc9-5f5f-3869-b2e8-6cb9608e1ca4",
                                        "glosses": [
                                            "de studie van geografische namen"
                                        ],
                                        "tags": [
                                            "onomastiek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "def99e4c-7ea6-43ef-9ebe-961449d9c1a7",
                                                "sense_id": "8cada07f-1748-3ab9-93ef-8527b66911ec",
                                                "text": "Hoewel plaatsen met ‘hel’ erin tot de verbeelding spreken, hebben ze niets met het religieuze concept van ‘de hel.’ De naam Hellegat kort uitgelegd: in de toponymie betekent ‘helle’ laagte of poel, en ‘gat’ staat voor waterdiepte of warterkom."
                                            },
                                            {
                                                "example_id": "e5236635-fca5-46ce-a436-e8880dc9b323",
                                                "sense_id": "8cada07f-1748-3ab9-93ef-8527b66911ec",
                                                "text": "In het kader van het openbaar onderzoek rond de naamswijziging liepen vele bezwaren binnen. Organisaties als Leuvens Historisch Genootschap protesteerden heftig, maar hun argumenten werden door de meerderheid verworpen. Ook de commissie toponymie, de cultuurkoepel en de deelraad erfgoed stelden zich negatief op."
                                            }
                                        ]
                                    }
                                ]
                            }
