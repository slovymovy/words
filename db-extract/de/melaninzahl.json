                "senses": [
                    {
                        "sense_id": "e17c245e-36ff-3a1f-8c7a-ec1ad9fc0998",
                        "entry_id": "3b247abb-394a-3dea-95ec-f306f2269536",
                        "glosses": [
                            "numerischer Wert, der die Menge des Pigments Melanin angibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe7bb234-4b3b-42f2-85de-ca67b9bf0d33",
                                "sense_id": "e17c245e-36ff-3a1f-8c7a-ec1ad9fc0998",
                                "text": "„Die Melaninzahl der Kartoffel untersuchte H. Haehn […].“"
                            },
                            {
                                "example_id": "f04f0311-c1ec-4f81-99cb-388c5ac6f1b4",
                                "sense_id": "e17c245e-36ff-3a1f-8c7a-ec1ad9fc0998",
                                "text": "„Als autolytischer Wert soll nun die Differenz der beiden Melaninzahlen bezeichnet werden, da die Zunahme an Melanin der eingetretenen Autolyse zu danken ist.“"
                            },
                            {
                                "example_id": "7746e643-59c2-4946-b1f9-a43ff3ab0e0c",
                                "sense_id": "e17c245e-36ff-3a1f-8c7a-ec1ad9fc0998",
                                "text": "„Haehn bezeichnet nun die Differenz der beiden Melaninzahlen eines Saftes innerhalb 24 Stunden als ‚autolytischen Wert‘, weil dieser der Autolyse seine Entstehung verdankt.“"
                            },
                            {
                                "example_id": "44d37719-a25b-4fb5-808d-93e59e6b425e",
                                "sense_id": "e17c245e-36ff-3a1f-8c7a-ec1ad9fc0998",
                                "text": "„Die Melaninzahl gibt die Anzahl Kubikzentimeter 0,002 n-Kaliumpermanganatlösung an, die nötig sind, um 1 ccm unverdünnten aufgekochten und filtrierten Kartoffelsaftes zu entfärben.“"
                            },
                            {
                                "example_id": "e4aac2fe-26ca-4688-8b48-eb09085aa042",
                                "sense_id": "e17c245e-36ff-3a1f-8c7a-ec1ad9fc0998",
                                "text": "„Die Melaninzahl hiervon fällt naturgemäß bedeutend höher aus als vom frischen Saft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
