                        "examples": [
                            {
                                "example_id": "4999ea3b-f1e9-426d-971d-895df56eb88b",
                                "sense_id": "10fd3df6-08c2-3c8b-8630-a4596d79dd2c",
                                "text": "John O'Mill (Johan van der Meulen), \"Guichelheil en guldenroede\", appeared in 1979, August 18, in De Stem, page 7.\nDies drentel ik maar blatend verder / in 't vage voetspoor van de Dood: / De Heer is lekker toch mijn herder / en ik een mal- maar geen zeloot!",
                                "translation": "Thus I stroll ahead while bleating / in the vague trails of Death: / the Lord's my shepherd anyhoo / and I'm an idi- but no zealot!",
                                "english": "Thus I stroll ahead while bleating / in the vague trails of Death: / the Lord's my shepherd anyhoo / and I'm an idi- but no zealot!"
                            }
                        ]
