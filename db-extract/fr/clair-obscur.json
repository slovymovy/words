        "fr-extract.jsonl": [
            {
                "entry_id": "83c78ed6-e009-3e94-85ac-572dd36cdc08",
                "word": "clair-obscur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b8e9b0f6-7ac4-4da3-a99d-37b981f5ce9f",
                        "entry_id": "83c78ed6-e009-3e94-85ac-572dd36cdc08",
                        "tags": [
                            "plural"
                        ],
                        "form": "clairs-obscurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9085d21-4a1d-390a-8570-ebd732c9b540",
                        "entry_id": "83c78ed6-e009-3e94-85ac-572dd36cdc08",
                        "glosses": [
                            "Imitation de l’effet que produit la lumière en éclairant les surfaces qu’elle frappe et en laissant dans l’ombre celles qu’elle ne frappe pas."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": [
                            {
                                "example_id": "5d47957e-0309-47f7-aafc-acb1a3a23b5a",
                                "sense_id": "c9085d21-4a1d-390a-8570-ebd732c9b540",
                                "text": "L’art, la science du clair-obscur. Les clairs-obscurs sont bien traités dans ce tableau."
                            }
                        ]
                    },
                    {
                        "sense_id": "327acd92-dc02-3979-9791-0b8b9570ee23",
                        "entry_id": "83c78ed6-e009-3e94-85ac-572dd36cdc08",
                        "glosses": [
                            "Les effets mêmes de la lumière sur les corps qu’elle frappe."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6b196bdd-2522-452b-b6d7-27ae6e01ec9d",
                                "sense_id": "327acd92-dc02-3979-9791-0b8b9570ee23",
                                "text": "Le cercle de lumière projeté par la lanterne l’éclairait faiblement, et il ressemblait, dans cette zone de clair-obscur, à ces sombres statues de chevaliers, toujours debout à l’encoignure de quelque tombe noire sous les chapelles gothiques."
                            },
                            {
                                "example_id": "0267033c-d6b7-4be6-9dd8-f622c71f2abb",
                                "sense_id": "327acd92-dc02-3979-9791-0b8b9570ee23",
                                "text": "Le soleil décline à toute vitesse, laissant bientôt place à une lumière crépusculaire semblable à un voile délicat imprégné de fraîcheur, un clair-obscur qui leur épargne la peine d’allumer les lampes."
                            }
                        ]
                    },
                    {
                        "sense_id": "e46e6e98-324e-3ac0-b9cb-820bff9fec1f",
                        "entry_id": "83c78ed6-e009-3e94-85ac-572dd36cdc08",
                        "glosses": [
                            "Parties d’un dessin, d’une peinture où l’on voit à travers l’ombre les formes et les couleurs."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "329b0658-df3a-47a8-9d83-25bc2d592514",
                        "source_entry_id": "83c78ed6-e009-3e94-85ac-572dd36cdc08",
                        "source_sense_id": "c9085d21-4a1d-390a-8570-ebd732c9b540",
                        "source_sense_description": "Peinture : Imitation de l’effet que produit la lumière...",
                        "target_lang_word": "Chiaroscuro",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chiaroscuro",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4615ae0-66ef-3099-b623-6d047395f798",
                                        "entry_id": "c7c3e555-730b-321a-8b79-236cc343577d",
                                        "glosses": [
                                            "Gestaltungsmittel der Grafik und Malerei, das sich durch starke Hell-Dunkel-Kontraste auszeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78cec50c-5792-47bc-ab55-c18535ab13de",
                                                "sense_id": "a4615ae0-66ef-3099-b623-6d047395f798",
                                                "text": "„Libby steht mit Avi, Penny und Regina am Fenster, ein Tableau mit Licht und Schatten wie in Gemälden von Correggio, jenem Meister des Chiaroscuro aus dem 16. Jahrhundert, der heilige Gestalten zugleich so zart und so geheimnisvoll darzustellen wusste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6d48e65-619c-41c2-9307-b3f44374753f",
                        "source_entry_id": "83c78ed6-e009-3e94-85ac-572dd36cdc08",
                        "source_sense_id": "c9085d21-4a1d-390a-8570-ebd732c9b540",
                        "source_sense_description": "Peinture : Imitation de l’effet que produit la lumière...",
                        "target_lang_word": "chiaroscuro",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiaroscuro",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecd4a977-cd04-3bda-86da-37130cb60db9",
                                        "entry_id": "4ef2896a-ba37-30cf-958a-dc213aa16af8",
                                        "glosses": [
                                            "An artistic technique developed during the Renaissance, referring to the use of strong contrasts between light and dark in order to create the illusion of volume."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "708ccc21-c0bc-368f-94f8-2373b33c8319",
                                        "entry_id": "4ef2896a-ba37-30cf-958a-dc213aa16af8",
                                        "glosses": [
                                            "A monochrome picture made by using several different shades of the same color."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "748e24f1-2047-3bef-ad33-06ebc5069815",
                                        "entry_id": "4ef2896a-ba37-30cf-958a-dc213aa16af8",
                                        "glosses": [
                                            "A woodcut technique in which several woodcut blocks are used to print different shades of a color, or a woodcut print made by this technique."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ffde648-d7f6-3ddc-8ad7-8bc234410e8f",
                                        "entry_id": "4ef2896a-ba37-30cf-958a-dc213aa16af8",
                                        "glosses": [
                                            "A photographic technique in which one side of the subject, for example a face, is well lit and the other is in shadow."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chiaroscuro",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2bc54e0-705a-3042-a3e7-9095d9e4aa2b",
                                        "entry_id": "513ee0bc-e73b-37ec-84e5-7bfa39e0d081",
                                        "glosses": [
                                            "Possessing the qualities of a work of chiaroscuro."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbb20685-835c-448a-98a8-7b63ff7907c9",
                                                "sense_id": "c2bc54e0-705a-3042-a3e7-9095d9e4aa2b",
                                                "text": "It has been a very chiaroscuro day—lots of sunlight and shadow."
                                            },
                                            {
                                                "example_id": "fc374a90-dd4b-4fdc-bd33-21b6fb71df5c",
                                                "sense_id": "c2bc54e0-705a-3042-a3e7-9095d9e4aa2b",
                                                "text": "It is cruder than the others, more graphic, less chiaroscuro."
                                            },
                                            {
                                                "example_id": "f49b1870-15e0-4a65-87ff-e06707568827",
                                                "sense_id": "c2bc54e0-705a-3042-a3e7-9095d9e4aa2b",
                                                "text": "A somewhat \" chiaroscuro \" effect, which imparts a strong feeling of rotundity to the bronze helmet, is achieved by the artist's bold use of broad hatching along its upper contours."
                                            },
                                            {
                                                "example_id": "9e726089-5986-4efb-a2b6-c424cc6c9dba",
                                                "sense_id": "c2bc54e0-705a-3042-a3e7-9095d9e4aa2b",
                                                "text": "'Rome's a very chiaroscuro city, I've always thought,' said Tom Richardson eventually, sensing that the lull in the conversation was going to be a protracted one."
                                            },
                                            {
                                                "example_id": "05fc10a1-836a-44fb-8439-78ae1eef2695",
                                                "sense_id": "c2bc54e0-705a-3042-a3e7-9095d9e4aa2b",
                                                "text": "I heard them discussing painting, and the two pictures Veronique had purchased from Allegra's sale: a haunting nude, very chiaroscuro, and another — more colorful and enigmatic — of a woman before a screen, holding an Oriental mask."
                                            },
                                            {
                                                "example_id": "172d2e64-2182-4a95-8df5-644da5a54cbf",
                                                "sense_id": "c2bc54e0-705a-3042-a3e7-9095d9e4aa2b",
                                                "text": "To minimize the problem, we used dark skies, very chiaroscuro lighting, and decided that the whole film would take place at night.\""
                                            },
                                            {
                                                "example_id": "9c6c4d18-5060-4152-a059-e3ec1882fda5",
                                                "sense_id": "c2bc54e0-705a-3042-a3e7-9095d9e4aa2b",
                                                "text": "HP, however, preferred the more chiaroscuro quality of the original CD."
                                            },
                                            {
                                                "example_id": "5610596c-d386-40db-9148-891fbfe20429",
                                                "sense_id": "c2bc54e0-705a-3042-a3e7-9095d9e4aa2b",
                                                "text": "A very chiaroscuro sort of man he was, arm on balcony, staring down into the dusty street below."
                                            },
                                            {
                                                "example_id": "d858d827-90d9-43e9-ac6c-8de2f570a4c6",
                                                "sense_id": "c2bc54e0-705a-3042-a3e7-9095d9e4aa2b",
                                                "text": "At times the image is so chiaroscuro as to be nearly illegible, such that one can only imagine the discussions between Lang and the Technicolor advisors."
                                            },
                                            {
                                                "example_id": "03511c55-2eb3-4251-a27f-02ddeb2d59f3",
                                                "sense_id": "c2bc54e0-705a-3042-a3e7-9095d9e4aa2b",
                                                "text": "The shooting bright light from the outside contrasted sharply from the coal black shadows of the interior giving the compound a very chiaroscuro quality."
                                            },
                                            {
                                                "example_id": "b29916a6-7c37-4a2b-b596-3263d31f1108",
                                                "sense_id": "c2bc54e0-705a-3042-a3e7-9095d9e4aa2b",
                                                "text": "Overhead lights swung wildly around the hole that it had burned through the ceiling. The very walls were warping from heat near the craft, metal panels peeling apart and some of the exposed wiring smoldering or outright aflame. Heat-waves rippled around the room’s camera array, and the white-hot gas that curled up from underneath the shuttle made shadows in the darkened, fiery chamber flicker in stark chiaroscuro."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
