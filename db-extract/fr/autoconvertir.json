                "senses": [
                    {
                        "sense_id": "43d3042f-0740-343f-b425-4c0d4ff2c041",
                        "entry_id": "f0e89ef7-169c-3b5c-a78e-cc3d9877dbd0",
                        "glosses": [
                            "Convertir automatiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d6eaa7c-132d-4ae3-a829-c8a50af780b0",
                                "sense_id": "43d3042f-0740-343f-b425-4c0d4ff2c041",
                                "text": "Besoin d'un soft pour autoconvertir du texte en code HTML"
                            }
                        ]
                    },
                    {
                        "sense_id": "835c2db1-40db-390c-824e-64c455e7455e",
                        "entry_id": "f0e89ef7-169c-3b5c-a78e-cc3d9877dbd0",
                        "glosses": [
                            "Se convertir soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "b8531e38-f8bf-45df-8e95-3d3774f4f34a",
                                "sense_id": "835c2db1-40db-390c-824e-64c455e7455e",
                                "text": "Certains remarqueront qu'auto_ptr (ou unique_ptr en C++0x) peut s'avérer plus efficace et s'autoconvertit sans risques en shared_ptr."
                            },
                            {
                                "example_id": "86102aa6-c3b8-437f-8527-7e790cd8537a",
                                "sense_id": "835c2db1-40db-390c-824e-64c455e7455e",
                                "text": "Grâce à la modernisation de l'informatique, vous pouvez vous autoconvertir en un format au choix parmi un liste assez simple, et quand les gens ouvrent le mail, vous être reconverti dans votre version intégrale pour pouvoir accéder directement à votre destinataire !"
                            }
                        ]
                    }
