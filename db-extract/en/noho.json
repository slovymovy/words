                    {
                        "sense_id": "29d90e35-78a4-3e62-87aa-8297b543baca",
                        "entry_id": "514d9956-303b-3087-9869-f9becf09b6ff",
                        "glosses": [
                            "A neighborhood of the San Fernando Valley, Los Angeles, California; in full, North Hollywood."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "52ebd076-b75d-348b-87a2-fe711addccd8",
                        "entry_id": "514d9956-303b-3087-9869-f9becf09b6ff",
                        "glosses": [
                            "A neighbourhood of Central and Western district, Hong Kong Island, Hong Kong; along Gough Street."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d368b2eb-0e3e-4e3b-bf7f-dff8a71d80a0",
                                "sense_id": "52ebd076-b75d-348b-87a2-fe711addccd8",
                                "text": "Just a few minutes away from Hong Kong’s buzzing SoHo district is NoHo, its hipper, more laid-back younger cousin. Lying (as you might guess from its acronymic name) north of Hollywood Road, and occupying the length of Gough Street between Aberdeen and Shing Wong Streets, it was once mainly home to family-run shops and small printing presses. These days, though, NoHo is an enclave of independent boutiques and contemporary-art galleries, chichi cafés and old-school dai pai dong or cooked-food stalls. Here are 10 reasons to visit."
                            },
                            {
                                "example_id": "63e76ca8-5c41-4066-900a-f0b39e4b0544",
                                "sense_id": "52ebd076-b75d-348b-87a2-fe711addccd8",
                                "text": "Gough Street, in newly trendy NoHo, is now home to Ralph Lauren and other top brands.[…]\nAs part of the larger \"NoHo\" area, Gough Street has attracted tenants priced out of its larger neighbour SoHo. Once home to family-run stores and printers and now known locally for its casual Cantonese restaurants and art galleries, the Gough Street area's tenant mix was \"internationalised\" one or two years ago."
                            }
                        ]
                    }
