                        ]
                    },
                    {
                        "translation_id": "6d70859c-cc07-4992-84ff-b0a585614bf9",
                        "source_entry_id": "af47f0ea-fb06-3e82-b3ea-8543fa48871f",
                        "source_sense_id": "047a4dba-c4d6-3feb-a4b1-441c6d6568c4",
                        "source_sense_description": "unconvinced",
                        "target_lang_word": "unbeeindruckt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbeeindruckt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f510b8b-fb3b-3031-b2e6-4bd351924465",
                                        "entry_id": "25abd428-17e3-3ff3-a362-a378566ea541",
                                        "glosses": [
                                            "trotz äußerer Einflüsse keine starke (auch emotionale) Reaktion zeigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7576b79f-1938-4c04-97b1-cdf3f05311af",
                                                "sense_id": "8f510b8b-fb3b-3031-b2e6-4bd351924465",
                                                "text": "„Harsche Kritik des Bundesrechnungshofs, der für das Monopolunternehmen bald dicke Verluste befürchtete, ließen Schwarz-Schilling und seine Kabinettskollegen ebenso unbeeindruckt wie der Vorwurf, daß die eigentlich zur Neutralität verpflichtete Bundespost damit massiv in die Medienpolitik eingriff, die ausschließlich – so will es die Verfassung – Sache der Bundesländer ist.“"
                                            },
                                            {
                                                "example_id": "a750c748-1ef9-40d8-abcf-5e62596f150b",
                                                "sense_id": "8f510b8b-fb3b-3031-b2e6-4bd351924465",
                                                "text": "„Jetzt stand er da, über und über voller Kratzer und Erde, und wirkte sogar noch unbeeindruckter von ihrem Flehen als Lady Melora.“"
                                            },
                                            {
                                                "example_id": "96b2d77e-ed5a-4c18-ab36-20a7a183f97b",
                                                "sense_id": "8f510b8b-fb3b-3031-b2e6-4bd351924465",
                                                "text": "„Die Protest-Routine auf Sachsens Straßen ist von all dem aktuell noch unbeeindruckt.“"
                                            },
                                            {
                                                "example_id": "da6cc0e8-1225-4815-92de-bd00f47ec4c7",
                                                "sense_id": "8f510b8b-fb3b-3031-b2e6-4bd351924465",
                                                "text": "„Schon bei einer Betriebsversammlung im vergangenen Herbst hätte sich der Geschäftsführer von Schildern mit Forderungen nach einem Tarifvertrag unbeeindruckt gezeigt.“"
                                            },
                                            {
                                                "example_id": "dd7ea205-b2d3-4c63-84a1-118db5ef7e71",
                                                "sense_id": "8f510b8b-fb3b-3031-b2e6-4bd351924465",
                                                "text": "„Die Mannschaft zeigte sich von den finanziellen Schwierigkeiten weitestgehend unbeeindruckt, stand während der gesamten Saison 2017/18 nie schlechter als auf Rang 10 und beendete die Spielzeit auf dem vierten Tabellenplatz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
