                                "target_senses": [
                                    {
                                        "sense_id": "9e5e51b3-b6c1-3bfc-b6bf-3dfe71c19e21",
                                        "entry_id": "b3e57e4d-91ad-3598-b99d-a4a2ef8a4128",
                                        "glosses": [
                                            "Capable of receiving something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "364b9816-3b63-31f3-b1b6-d7d4502082a6",
                                        "entry_id": "b3e57e4d-91ad-3598-b99d-a4a2ef8a4128",
                                        "glosses": [
                                            "Ready to receive something, especially new concepts or ideas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ad74050-6d4b-4cd8-8a26-056b7f548c39",
                                                "sense_id": "364b9816-3b63-31f3-b1b6-d7d4502082a6",
                                                "text": "receptive to the idea"
                                            },
                                            {
                                                "example_id": "5028674b-e7ea-4c77-8405-577e374c8dce",
                                                "sense_id": "364b9816-3b63-31f3-b1b6-d7d4502082a6",
                                                "text": "The patient was receptive to her treatment"
                                            },
                                            {
                                                "example_id": "a2722059-de2d-4706-b7ca-f72a16386d97",
                                                "sense_id": "364b9816-3b63-31f3-b1b6-d7d4502082a6",
                                                "text": "The owner drank cider at the Spotted Woodpigeon and talked pleasantly with the villagers, who, on learning that he had never even heard of the Surrey cattle-maimings, were at great pains to pour information and theories into his receptive ear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b3a16dc-cb36-3d9e-9843-313f77a69d59",
                                        "entry_id": "b3e57e4d-91ad-3598-b99d-a4a2ef8a4128",
                                        "glosses": [
                                            "Of a female flower or gynoecium: ready for reproduction; fertile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cf0ae9b-9c17-4279-b1dc-e0c9d34154d2",
                                                "sense_id": "2b3a16dc-cb36-3d9e-9843-313f77a69d59",
                                                "text": "When the delightful draught is quaffed and the winged beggar turns to leave, it is confronted with a straight and narrow way out, and before the open can be reached our bee must squeeze under a receptive stigma covered with sticky hairs which comb the pollen grains from the fuzzy back of the visitor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da9d8f48-7d25-3f4e-b4de-3b0e63c76271",
                                        "entry_id": "b3e57e4d-91ad-3598-b99d-a4a2ef8a4128",
                                        "glosses": [
                                            "Of, affecting, or pertaining to the understanding of language rather than its expression."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8e23c8f-4ccf-354a-a7b3-35a25612bc8e",
                                        "entry_id": "b3e57e4d-91ad-3598-b99d-a4a2ef8a4128",
                                        "glosses": [
                                            "Of a female animal (especially a mammal): prepared to mate; in heat, in oestrus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6712a96-ee8b-4ba9-9c04-1250b5333033",
                        "source_entry_id": "4c45566a-3009-39ab-80c5-168f24452672",
                        "target_lang_word": "accessible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accessible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b37af978-4d58-367b-b274-02a3e8d951ed",
                                        "entry_id": "58157cb0-32db-3a4d-a4d2-7a035d7699bc",
                                        "glosses": [
                                            "Easy of access or approach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "122062e7-1377-4e25-8c90-a6128fb7a804",
                                                "sense_id": "b37af978-4d58-367b-b274-02a3e8d951ed",
                                                "text": "an accessible town or mountain"
                                            },
                                            {
                                                "example_id": "94c1b9da-246c-430c-b58c-d4a419413b1b",
                                                "sense_id": "b37af978-4d58-367b-b274-02a3e8d951ed",
                                                "text": "At first sight it would seem that the deep interior of the sun and stars is less accessible to scientific investigation than any other region of the universe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e41c0ef-89dd-3aba-97ca-4a8d08179844",
                                        "entry_id": "58157cb0-32db-3a4d-a4d2-7a035d7699bc",
                                        "glosses": [
                                            "Built or designed as to be usable by people with disabilities."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29d86291-6094-4f48-b26d-788c6055ff91",
                                                "sense_id": "2e41c0ef-89dd-3aba-97ca-4a8d08179844",
                                                "text": "an accessible website"
                                            },
                                            {
                                                "example_id": "67d15d29-cc8e-4c13-b38f-98381d13e291",
                                                "sense_id": "2e41c0ef-89dd-3aba-97ca-4a8d08179844",
                                                "text": "accessible public transport"
                                            },
                                            {
                                                "example_id": "e0ab111a-2174-4c72-82d9-3220c70b7c5c",
                                                "sense_id": "2e41c0ef-89dd-3aba-97ca-4a8d08179844",
                                                "text": "As well as the boom in off-peak leisure numbers, \"there has been a big spike in passenger assistance - that's really taken off as well\", he continues. \"We're probably victims of our own success because we promote this more than we ever used to. We promote how accessible the railways are. I think that this area has more than doubled from pre-COVID levels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd386699-cff1-39e0-a49c-eae6211536e6",
                                        "entry_id": "58157cb0-32db-3a4d-a4d2-7a035d7699bc",
                                        "glosses": [
                                            "Easy to get along with."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "858c93ec-0518-3203-9e54-83262ecaf48f",
                                        "entry_id": "58157cb0-32db-3a4d-a4d2-7a035d7699bc",
                                        "glosses": [
                                            "Open to the influence of."
                                        ],
                                        "tags": [
                                            "with-to"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "631a2be2-d8e6-4f26-aca6-f2979558d006",
                                                "sense_id": "858c93ec-0518-3203-9e54-83262ecaf48f",
                                                "text": "Minds accessible to reason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "930526b8-6b3c-3552-88f2-416e8cbac1f0",
                                        "entry_id": "58157cb0-32db-3a4d-a4d2-7a035d7699bc",
                                        "glosses": [
                                            "Obtainable; to be got at."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8273e848-6a4c-4a13-b84d-61a2d0e0fb38",
                                                "sense_id": "930526b8-6b3c-3552-88f2-416e8cbac1f0",
                                                "text": "The materials, however, which are at present accessible, are sufficient for the construction of a narrative not to be read without shame and loathing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66de9cae-1bb2-321b-b471-0e8910eea171",
                                        "entry_id": "58157cb0-32db-3a4d-a4d2-7a035d7699bc",
                                        "glosses": [
                                            "Easily understood or appreciated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0053a778-facb-434a-9186-b7441c906585",
                                                "sense_id": "66de9cae-1bb2-321b-b471-0e8910eea171",
                                                "text": "But something new was rippling through a million MySpace profiles. The sound was electro, and bass-laced synthetic dance pop would soon start streaming in from producers in Paris, dizzying the twenteens of Britain with its accessible, anthemic funk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e553168-a5bf-326e-a0c5-0903336a0f1a",
                                        "entry_id": "58157cb0-32db-3a4d-a4d2-7a035d7699bc",
                                        "glosses": [
                                            "Capable of being used or seen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e606ca9d-1a1e-48a7-a8d2-b4153bed851b",
