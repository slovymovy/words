                "senses": [
                    {
                        "sense_id": "617a4265-a970-3dd4-a5b2-306601251b48",
                        "entry_id": "66c821cd-b743-3e53-b456-8f3515154cd6",
                        "glosses": [
                            "Relatif à la région ou au département des Landes ou à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d408d796-7ef3-4533-b047-27ce02c4cb55",
                                "sense_id": "617a4265-a970-3dd4-a5b2-306601251b48",
                                "text": "Les sols landais sont des sols sableux de type podzosol, avec une proportion en argile très faible (< 5 %) et une grande quantité de matière organique, […]."
                            },
                            {
                                "example_id": "9f349a7b-4560-43f5-a24e-bb74f916969c",
                                "sense_id": "617a4265-a970-3dd4-a5b2-306601251b48",
                                "text": "Si vous êtes en vacances sur la côte landaise, n’hésitez pas à faire une escale festive à Saint-Vincent-de-Tyrosse. De nombreuses animations sont proposées : marché traditionnel, initiation et tournoi de pelote basque, bodega, course landaise, etc."
                            },
                            {
                                "example_id": "95f4ef51-f936-4b4a-bc31-bead126831bc",
                                "sense_id": "617a4265-a970-3dd4-a5b2-306601251b48",
                                "text": "La reprise, la garden-party, le prime time du vendredi soir, la première pena baïona, Antoine Dupont et Anthony Jelonch en touristes landais sur le banc…"
                            }
                        ]
                    },
