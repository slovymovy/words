                                        "glosses": [
                                            "The commissioned officers of a ship, excluding the captain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8db75326-8eb2-4fa8-b3a3-fe4aa23bc740",
                                                "sense_id": "4d5799cb-6cc2-352f-ad6e-cde1bc05f443",
                                                "text": "The captain rarely referred to his wardroom for advice, and this resulted in their discontent."
                                            },
