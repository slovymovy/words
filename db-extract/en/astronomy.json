                                        "sense_id": "1916e3cb-9483-322f-934f-40d7a6ad4a01",
                                        "entry_id": "fdb65752-a071-37b6-a448-3e80a1e64901",
                                        "glosses": [
                                            "Science ayant pour objet l'observation et l’étude des corps célestes dans leur position, leur mouvement et leur constitution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea4771a8-e8e8-4163-afe7-30c8e4167851",
                                                "sense_id": "1916e3cb-9483-322f-934f-40d7a6ad4a01",
                                                "text": "Parce que l’astronomie parvenait à calculer les tables de la lune, on a cru que le but de toute science était de prévoir avec exactitude l’avenir ; […]."
                                            }
                                        ]
