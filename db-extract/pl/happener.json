                "senses": [
                    {
                        "sense_id": "4f1899ba-09d2-314a-9c1d-4d99c84e0e63",
                        "entry_id": "8a9136fb-b175-37aa-9a28-71c14e6d9ad3",
                        "glosses": [
                            "artysta, który zajmuje się happeningiem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11829be5-965f-43c4-abc8-a3b8aac11f0d",
                                "sense_id": "4f1899ba-09d2-314a-9c1d-4d99c84e0e63",
                                "text": "Happening w czystej formie – nie jest to cyrk ani groteska, happenerzy uporczywie identyfikują go z życiem, mimo że nikt w życiu nie przepiłowuje na przykład fortepianu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83bd3cba-996f-4642-9a31-cace8f29438f",
                        "source_entry_id": "8a9136fb-b175-37aa-9a28-71c14e6d9ad3",
                        "source_sense_id": "4f1899ba-09d2-314a-9c1d-4d99c84e0e63",
                        "target_lang_word": "happener",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "happener",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83a52a1b-5e46-379b-a730-021e3e1a9673",
                                        "entry_id": "26fbd667-52d9-3f84-8481-2cdcba2d3f74",
                                        "glosses": [
                                            "One who participates in a happening."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "081e8b83-e4e4-3156-86d2-f10533de07a0",
                                        "entry_id": "26fbd667-52d9-3f84-8481-2cdcba2d3f74",
                                        "glosses": [
                                            "A person who makes things happen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94fac3a5-dd70-4ad3-b145-d06bcc6cc7dc",
                                                "sense_id": "081e8b83-e4e4-3156-86d2-f10533de07a0",
                                                "text": "Goodparley says, 'O no and in deed he aint hes bettern clevver hes a mover hes a happener. […]'"
                                            },
                                            {
                                                "example_id": "df53c8dc-5287-4f28-a64b-c6f3708decc5",
                                                "sense_id": "081e8b83-e4e4-3156-86d2-f10533de07a0",
                                                "text": "How does (to take an extreme example) me saying to myself that somebody deserves what happens give any support to the happener?"
                                            },
                                            {
                                                "example_id": "a71627eb-b983-4f6e-8961-5a0d2e6079ed",
                                                "sense_id": "081e8b83-e4e4-3156-86d2-f10533de07a0",
                                                "text": "Just as we who believe in God know that there can be no creation without a Creator, we also know that whenever something happens, there is always a happener."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afb101dc-c6fd-339b-abf5-b8b7d7b86bae",
                                        "entry_id": "26fbd667-52d9-3f84-8481-2cdcba2d3f74",
                                        "glosses": [
                                            "A person to whom things happen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3245f1d2-5a61-4b34-8e8d-d6d00098bd73",
                                                "sense_id": "afb101dc-c6fd-339b-abf5-b8b7d7b86bae",
                                                "text": "\"No way! He's not one of these people that do things. There's two kinds of people—the doers and the happeners. He's a happener. You know, things happen to him instead.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd200936-4de4-3cf0-91f4-11de24edfde4",
                                        "entry_id": "26fbd667-52d9-3f84-8481-2cdcba2d3f74",
                                        "glosses": [
                                            "An event that is expected to happen; a plan that is likely to succeed."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40c9d809-cac5-48dc-b1d0-3a8c8992148a",
                                                "sense_id": "fd200936-4de4-3cf0-91f4-11de24edfde4",
                                                "text": "The planned access via Netizen appears not to be a happener."
                                            },
                                            {
                                                "example_id": "ced47ecf-0d8b-400e-bb0c-628e567afed5",
                                                "sense_id": "fd200936-4de4-3cf0-91f4-11de24edfde4",
                                                "text": "It's a happener. All systems are go."
                                            },
                                            {
                                                "example_id": "de4617de-2941-4aba-90e0-1e0639f034d6",
                                                "sense_id": "fd200936-4de4-3cf0-91f4-11de24edfde4",
                                                "text": "You should be able to get your passport renewed at the embassy in London. If that's not a happener, try to get a temporary passport."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
