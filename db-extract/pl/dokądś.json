                                "target_senses": [
                                    {
                                        "sense_id": "24da1ce5-24d9-31a1-b4d2-2602bc3d0c9a",
                                        "entry_id": "08ba5784-f1fb-32b4-a513-4ef81459d023",
                                        "glosses": [
                                            "na nějaké místo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97c3c997-3dac-485c-8f88-8a627a8f1419",
                                                "sense_id": "24da1ce5-24d9-31a1-b4d2-2602bc3d0c9a",
                                                "text": "Někam jsem si tu knihu položil, ale nemůžu ji najít."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c72a9dd0-a57e-4de7-9c21-8518bb26e2a6",
                        "source_entry_id": "cedbf382-0eb3-327d-b785-256635432ec7",
                        "source_sense_id": "96db9b1f-e920-3c46-9f85-0a4e0d9bcc3e",
