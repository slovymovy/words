                        "glosses": [
                            "door te wrijven iets verwijderen; schoonmaken door te wrijven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09ecb258-a50f-40b6-99b0-98e09c0575b0",
                                "sense_id": "9dd0bc93-18cd-3446-8c84-6887c5e7e000",
                                "text": "Weet je, als je alle hobbeltjes uit muziek wegschuurt en de krassen wegpoetst. Dan haal je toch alle gevoel eruit?"
                            },
                            {
                                "example_id": "3ee5fc67-a569-4e38-b0c5-2976a742893d",
                                "sense_id": "9dd0bc93-18cd-3446-8c84-6887c5e7e000",
                                "text": "Aan evacueren denkt Jansen zelf nog niet. \"Zolang de wind niet draait, blijft de schade voor mij beperkt tot het wegpoetsen van de aslaag uit het zwembad. Ik wil nog niet denken aan evacueren omdat ik mijn kippen, vier honden en twee katten niet wil achterlaten. Maar als het vuur toch komt, dan laad ik mijn dieren in de auto en rijd ik naar een veilige plek.\""
                            }
                        ]
                    }
