                    {
                        "sense_id": "4df93fa4-3a30-35b1-83d4-830c00f1d89e",
                        "entry_id": "11bbc179-efb8-3b5b-9e45-4b92a6fce7e4",
                        "glosses": [
                            "beeldhouwkunstig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13cc79d0-ebef-451a-a0ac-2117e42a2c6e",
                                "sense_id": "4df93fa4-3a30-35b1-83d4-830c00f1d89e",
                                "text": "Zijn vroegste sculpturale werk werd in 1968 geëxposeerd in het belangrijkste kunstmuseum van Caracas (waar hij al vroeg was gaan wonen) en bracht hem erkenning."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c99b4d7-623d-372e-beda-c8aa89661587",
                        "entry_id": "11bbc179-efb8-3b5b-9e45-4b92a6fce7e4",
                        "glosses": [
                            "op een beeldhouwwerk lijkend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc53c540-91d2-419e-a2bb-b0a2409de987",
                                "sense_id": "0c99b4d7-623d-372e-beda-c8aa89661587",
                                "text": "Natuurlijk waren er zwarte lange broeken met nauwsluitende pijpen, een kledingstuk dat Raf tijdens zijn eerste haute couture in juli vorig jaar introduceerde. Maar ook het Bar-jasje waar de oude Dior bekend om stond was er. Net als een beeldschoon tailleurtje van grijze tweed met een sculpturale crèmekleurige kraag."
                            }
                        ]
                    }
