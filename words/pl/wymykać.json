                    "sense_definition": "unikać schwytania, uciekać przed kimś lub czymś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ucieczka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Złodziejowi udało się <w>wymykać</w> policji przez wiele miesięcy.",
