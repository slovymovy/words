                    },
                    {
                        "form_id": "c1d4bae6-d654-4a30-800f-27374779522a",
                        "entry_id": "d3537429-5502-37b0-948c-a1ae77ad8fc3",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… дати́роваться"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "266d59ad-6b67-33bf-9454-fdb1db7a41cd",
                        "entry_id": "d3537429-5502-37b0-948c-a1ae77ad8fc3",
                        "glosses": [
                            "относиться к какому-либо времени, отмечаться какой-либо датой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3c12398-9bed-4d0d-a059-1c8d98b80ac7",
                                "sense_id": "266d59ad-6b67-33bf-9454-fdb1db7a41cd",
                                "text": "Верейский кремль, как город и крепость, датируется почти одним временем; его вал был сооружён не позже конца XIV в."
                            }
                        ]
                    },
                    {
                        "sense_id": "9424b54f-daf0-3ded-8b8f-4c31e318b9f5",
                        "entry_id": "d3537429-5502-37b0-948c-a1ae77ad8fc3",
                        "glosses": [
                            "страд. к датировать"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "031b23f7-16c0-4408-a054-87b87c729761",
                                "sense_id": "9424b54f-daf0-3ded-8b8f-4c31e318b9f5",
                                "text": "А этот ярус средствами дендрохронологии датируется теперь временем с 1409 по 1422 год."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f384294e-ed50-438d-ad1b-a97db5856213",
                        "source_entry_id": "d3537429-5502-37b0-948c-a1ae77ad8fc3",
                        "target_lang_word": "datieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "datieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3911a65b-63da-371b-80e4-8af0cbbc16b8",
                                        "entry_id": "3ba9ebfc-8dc6-3a7a-9ac2-d1bf40393d8e",
                                        "glosses": [
                                            "etwas, insbesondere ein Schriftstück, mit einem Datum versehen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9234d708-0d63-46cc-9146-9286627307d2",
                                                "sense_id": "3911a65b-63da-371b-80e4-8af0cbbc16b8",
                                                "text": "Am 30. August 1979, mit welchem Tag der Kreditvertrag datiert wurde, verpflichteten sich die Ehegatten O*** und die Zweitbeklagte als Bürge und Zahler für den Kredit des Erstbeklagten."
                                            },
                                            {
                                                "example_id": "db9f2d86-29b7-4e82-bb7a-a6bf8228a0ce",
                                                "sense_id": "3911a65b-63da-371b-80e4-8af0cbbc16b8",
                                                "text": "Da ein Scheingeschäft voraussetzt, daß ein nicht vorhandener Geschäftswille vorgetäuscht wird, genügt die Vorspiegelung bloß äußerer Tatsachen oder eines unrichtigen Motives oder Beweggrundes nicht, so z. B. wenn ein Vertrag falsch datiert wurde (…)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "587702cf-75a5-3eeb-9f29-5994e4901e49",
                                        "entry_id": "3ba9ebfc-8dc6-3a7a-9ac2-d1bf40393d8e",
                                        "glosses": [
                                            "den Entstehungszeitpunkt von etwas bestimmen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "092f213f-8f19-468c-87af-802addd702ee",
                                                "sense_id": "587702cf-75a5-3eeb-9f29-5994e4901e49",
                                                "text": "Teil eines menschlichen Unterkiefers, den Forscher 1927 im Süden der englichscne Grafschaft Devon ausgegraben haben. Neue Analysen datieren die Überreste auf ein Alter zwischen 41.500 bis 44.200 Jahre."
                                            },
                                            {
                                                "example_id": "f9cfbfb5-c841-4c7d-b8e3-d7c0d98fca66",
                                                "sense_id": "587702cf-75a5-3eeb-9f29-5994e4901e49",
                                                "text": "Die bithynische Synode (…) datierte Williams erst nach dem Synodenverbot des Licinius (324 n. Chr.)."
                                            },
                                            {
                                                "example_id": "2d2d23df-8fd4-4ccc-aed4-d95edd010ca4",
                                                "sense_id": "587702cf-75a5-3eeb-9f29-5994e4901e49",
                                                "text": "Frührömische Keramikscherben aus den ältesten gallorömischen Straten wurden an der unteren Hochstraße, in der Schaarstraße sowie in der Agrippastraße geborgen und datieren in die Jahre um die Zeitenwende."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ea099376-cc8f-3397-8407-cab658f920f5",
                                        "entry_id": "3ba9ebfc-8dc6-3a7a-9ac2-d1bf40393d8e",
                                        "glosses": [
                                            "von einem bestimmten Zeitpunkt an bestehen, herrühren, stammen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84e55c34-6891-45e6-91d8-93c1ab709ad6",
                                                "sense_id": "ea099376-cc8f-3397-8407-cab658f920f5",
                                                "text": "Haben Menschen viel Seefisch gegessen, datieren ihre Knochen bei der C14-Messung um Jahrhunderte älter, als sie tatsächlich sind."
                                            },
                                            {
                                                "example_id": "52c899f1-9cc9-4e40-9ff7-4995315364b3",
                                                "sense_id": "ea099376-cc8f-3397-8407-cab658f920f5",
                                                "text": "Seit dieser Zeit datiert der Besitzanteil der benachbarten Großstadt an unserer Insel, wohl der einzige geographisch wertvolle Wendepunkt in der politischen Geschichte Finkenwerders."
                                            },
                                            {
