{
    "word_family": [
        "amaze",
        "amazement",
        "amazing",
        "amazingly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "28cd33d2-9e5a-30e5-91e3-9da6d227c5bd",
                    "sense_definition": "Greatly surprised or filled with wonder.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "surprise_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was <w>amazed</w> at how quickly the children learned the new game.",
                            "target_lang_translations": {
                                "ru": "Я был <w>поражён</w> тем, как быстро дети освоили новую игру.",
                                "zh": "孩子们学新游戏学得这么快，我感到很<w>惊讶</w>。",
                                "es": "Me quedé <w>asombrado</w> de lo rápido que los niños aprendieron el nuevo juego."
                            }
                        },
                        {
                            "text": "She was <w>amazed</w> by the beautiful view from the top of the mountain.",
                            "target_lang_translations": {
                                "ru": "Она была <w>изумлена</w> прекрасным видом с вершины горы.",
                                "zh": "山顶的美景让她感到<w>惊叹</w>。",
                                "es": "Ella estaba <w>atónita</w> ante la hermosa vista desde la cima de la montaña."
                            }
                        }
                    ],
                    "synonyms": [
                        "astonished",
                        "astounded",
                        "surprised",
                        "stunned"
                    ],
                    "antonyms": [
                        "unimpressed",
                        "indifferent"
                    ],
                    "common_phrases": [
                        "amazed at",
                        "amazed by",
                        "amazed to see"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно удивлённый или восхищённый чем-либо.",
                        "zh": "感到非常惊讶或惊叹。",
                        "es": "Muy sorprendido o lleno de asombro."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изумлённый",
                                "target_lang_sense_clarification": "испытывающий крайнее удивление"
                            },
                            {
                                "target_lang_word": "поражённый",
                                "target_lang_sense_clarification": "сильно впечатлённый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惊讶",
                                "target_lang_sense_clarification": "感到意外或惊奇"
                            },
                            {
                                "target_lang_word": "惊叹",
                                "target_lang_sense_clarification": "因惊奇而赞叹"
                            },
                            {
                                "target_lang_word": "吃惊",
                                "target_lang_sense_clarification": "受到意外刺激而感到惊奇"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "asombrado",
                                "target_lang_sense_clarification": "que siente gran sorpresa o admiración"
                            },
                            {
                                "target_lang_word": "atónito",
                                "target_lang_sense_clarification": "impactado por algo fuera de lo común"
                            },
                            {
                                "target_lang_word": "estupefacto",
                                "target_lang_sense_clarification": "pasmado y sin habla por la sorpresa"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6fc4f1da-b392-3016-ab1f-791885b8a1f3",
                    "sense_definition": "Simple past and past participle of <w>amaze</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician's tricks <w>amazed</w> the audience during the show.",
                            "target_lang_translations": {
                                "ru": "Фокусы иллюзиониста <w>изумили</w> зрителей во время шоу.",
                                "zh": "演出期间，魔术师的戏法<w>惊艳</w>了全场观众。",
                                "es": "Los trucos del mago <w>asombraron</w> a la audiencia durante el espectáculo."
                            }
                        },
                        {
                            "text": "It <w>amazed</w> me that he could solve the puzzle so easily.",
                            "target_lang_translations": {
                                "ru": "Меня <w>поразило</w>, что он смог так легко решить эту головоломку.",
                                "zh": "他能如此轻松地解开这个谜题，这让我感到很<w>吃惊</w>。",
                                "es": "Me <w>sorprendió</w> que pudiera resolver el rompecabezas tan fácilmente."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола 'amaze' (изумлять, поражать).",
                        "zh": "使人感到非常惊讶或惊叹（动词 amaze 的过去式）。",
                        "es": "Pasado del verbo 'asombrar' o 'sorprender'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изумил",
                                "target_lang_sense_clarification": "вызвал сильное удивление (прош. вр.)"
                            },
                            {
                                "target_lang_word": "поразил",
                                "target_lang_sense_clarification": "произвёл сильное впечатление (прош. вр.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……惊讶",
                                "target_lang_sense_clarification": "令某人感到意外"
                            },
                            {
                                "target_lang_word": "使……惊叹",
                                "target_lang_sense_clarification": "令某人感到惊奇赞叹"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "asombró",
                                "target_lang_sense_clarification": "causó gran sorpresa (pasado)"
                            },
                            {
                                "target_lang_word": "sorprendió",
                                "target_lang_sense_clarification": "causó extrañeza o admiración (pasado)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}