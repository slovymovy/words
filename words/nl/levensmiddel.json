            "senses": [
                {
                    "sense_id": "b72efaa9-6c21-3a34-b4bd-41fe2bbaffad",
                    "sense_definition": "Producten die bedoeld zijn voor menselijke consumptie, zoals eten en drinken, om in het levensonderhoud te voorzien.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De supermarkt heeft een zeer ruim assortiment aan <w>levensmiddelen</w>.",
                            "target_lang_translations": {
                                "en": "The supermarket has a very wide range of <w>groceries</w>."
                            }
                        },
                        {
                            "text": "Tijdens de crisis was er een groot tekort aan dagelijkse <w>levensmiddelen</w> in de winkels.",
                            "target_lang_translations": {
                                "en": "During the crisis, there was a major shortage of daily <w>foodstuffs</w> in the shops."
                            }
                        }
                    ],
                    "synonyms": [
                        "voeding",
                        "voedsel"
                    ],
                    "common_phrases": [
                        "dagelijkse levensmiddelen",
                        "assortiment aan levensmiddelen"
                    ],
                    "target_lang_definitions": {
                        "en": "Products intended for human consumption, such as food and drink, to sustain life."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "groceries",
                                "target_lang_sense_clarification": "food and other household items bought at a store"
                            },
                            {
                                "target_lang_word": "foodstuffs",
                                "target_lang_sense_clarification": "substances used as food"
                            },
                            {
                                "target_lang_word": "provisions",
                                "target_lang_sense_clarification": "supplies of food and drink, especially for a journey or emergency"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "501c8dc3-d473-3833-b7ed-b691d97b05e5",
                    "sense_definition": "Een voedingsstof of eetwaar die dient om het lichaam te voeden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Melk is een belangrijk <w>levensmiddel</w> dat veel calcium bevat.",
                            "target_lang_translations": {
