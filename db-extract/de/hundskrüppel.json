                "senses": [
                    {
                        "sense_id": "37d91753-a04c-363c-9d1a-00b3cf56c211",
                        "entry_id": "e68e817f-ebeb-3239-a1ed-c83e03d15766",
                        "glosses": [
                            "boshafter, hinterhältiger Kerl"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "98ab7f30-2da5-401f-918e-e4e5705ab316",
                                "sense_id": "37d91753-a04c-363c-9d1a-00b3cf56c211",
                                "text": "„»Hundskrüppel!« schimpfte der Mesner und schaute auf seine dreckigen Hände.“"
                            },
                            {
                                "example_id": "89e2779d-6820-491c-8e3d-c38d0aa78356",
                                "sense_id": "37d91753-a04c-363c-9d1a-00b3cf56c211",
                                "text": "„Sie will auch nicht, daß ihre Ehe zugrund geht wegen einem Hundskrüppel.“"
                            },
                            {
                                "example_id": "aed194f1-f601-40ae-8ade-0ebcdcf37b15",
                                "sense_id": "37d91753-a04c-363c-9d1a-00b3cf56c211",
                                "text": "„Umso schöner, wenn den erwachsenen Grantlern auch noch ein »Du Hundskrüppel, du verreckter!« entlockt werden kann.“"
                            },
                            {
                                "example_id": "35a8f793-71e8-4687-9c0a-347921f96abb",
                                "sense_id": "37d91753-a04c-363c-9d1a-00b3cf56c211",
                                "text": "„Wenn Sie meine Meinung hören wollen, sollte dieser Hundskrüppel von einem Fahrradflicker unseren Dialekt lernen oder sich dorthin verpissen, wo er hergekommen ist.“"
                            },
                            {
                                "example_id": "4855483a-5515-4955-bc87-d0de304b52ba",
                                "sense_id": "37d91753-a04c-363c-9d1a-00b3cf56c211",
                                "text": "„Er sei ganz schlecht beieinander, seit sein Hamburger Bankert, der Hundskrüppel, auf und davon sei.“"
                            },
                            {
                                "example_id": "049b5425-b256-4174-a7d2-086332034f5b",
                                "sense_id": "37d91753-a04c-363c-9d1a-00b3cf56c211",
                                "text": "„»Also schaug hoid nacha, daß d' weitakimmst, du Hundsgribbe!«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
