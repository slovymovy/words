                ],
                "senses": [
                    {
                        "sense_id": "b44247fe-6b4c-30cc-9b7a-267e1283d882",
                        "entry_id": "58f2dbd3-29e9-30ad-bd85-e702790d924c",
                        "glosses": [
                            "in der Regel für Kinder aufgeführtes Bühnenstück mit Spielpuppen, benannt nach der Hauptfigur des Kasperle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4b638cc-a1fb-4d87-bc4b-cebe4f1a2e6e",
                                "sense_id": "b44247fe-6b4c-30cc-9b7a-267e1283d882",
                                "text": "„1962 erschien der erste Band vom Räuber Hotzenplotz, in dem Otfried Preußler die Struktur des Personals der alten Kasperlespiele aufgriff, den Kindern zur Freude, den Kritikern der 68er-Zeit ein Ärgernis, weil mit Autorität und Obrigkeit nicht im Sinne der damals neuen Pädagogik umgegangen wird.“"
                            },
                            {
                                "example_id": "171782f7-56ac-451b-bc4f-974bd240a6ff",
                                "sense_id": "b44247fe-6b4c-30cc-9b7a-267e1283d882",
                                "text": "„Und wie in einem Kasperlespiel lässt die politische Führung in Paris den Guten seit Wochen auf den Bösen eindreschen, auf dass dem Publikum Hören und Sehen vergehe.“"
                            },
                            {
                                "example_id": "64e2b68e-fcf3-4885-9f2e-e03f68e693f2",
                                "sense_id": "b44247fe-6b4c-30cc-9b7a-267e1283d882",
                                "text": "„Der Darstellungstrieb will die spielerische Selbstpräsentation. Dieser Wunsch lässt sich z.B. über das Verkleidungsspiel, das Rollenspiel, das Kasperlespiel, das Marionettenspiel, das Theaterspiel, über Pantomimen, Sketsche oder Clownerien einlösen.“"
                            },
                            {
                                "example_id": "98e284c0-258d-45d4-8ba6-e67fef7073e0",
                                "sense_id": "b44247fe-6b4c-30cc-9b7a-267e1283d882",
                                "text": "„Hinzu kommt das Kasperlespiel mit Kindern – frei nach Peter Weiss.“"
                            },
                            {
                                "example_id": "cdd9a9a1-4b85-4f53-abeb-681c573d3847",
                                "sense_id": "b44247fe-6b4c-30cc-9b7a-267e1283d882",
                                "text": "„Jedoch: man könnte seine Kasperlespiele, von denen es noch ein drittes (auch gedruckt) gibt, ruhig als Kindervorstellung geben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
