                "senses": [
                    {
                        "sense_id": "399d6f48-6d53-358a-a400-230989f7d07e",
                        "entry_id": "cc8c827e-1cb9-3935-a975-68a1707831da",
                        "glosses": [
                            "Ancien nom des filous qui enlevaient subtilement la bourse et autres objets."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "610fd588-f951-40b3-8f05-42b5a51bece7",
                                "sense_id": "399d6f48-6d53-358a-a400-230989f7d07e",
                                "text": "Le coupe-bourse qui vous vole en cachette, vous fait tort ; mais en ce qu’il se cache, il tesmoigne quelque reste d’apprehesion & de respect qu’il a encore pour vous."
                            },
                            {
                                "example_id": "e62f6b5b-5c9d-4c33-bf70-d4a5f973cbec",
                                "sense_id": "399d6f48-6d53-358a-a400-230989f7d07e",
                                "text": "Je ne vole même plus, je suis au-dessus de cela, je tue. Coupe-gorge, oui ; coupe-bourse, non."
                            },
                            {
                                "example_id": "19ba2802-2388-45fb-9579-4ad452c0b971",
                                "sense_id": "399d6f48-6d53-358a-a400-230989f7d07e",
                                "text": "Cette feinte querelle avait pour but de produire un rassemblement pour que, parmi la foule, les coupe-bourses et les tire-laines pussent faire leurs coups tout à l’aise."
                            }
                        ]
                    }
                ],
