                ],
                "senses": [
                    {
                        "sense_id": "3f667bb0-f9cc-3f5f-827e-d4898b7e583f",
                        "entry_id": "d91b4ed5-e658-3a1b-bcd4-e3a08cdbd7c4",
                        "glosses": [
                            "Person, die bei einer Wahl für die Österreichische Volkspartei (ÖVP) gestimmt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29eaf483-7fc0-4e60-99ba-9ebd75c2aff3",
                                "sense_id": "3f667bb0-f9cc-3f5f-827e-d4898b7e583f",
                                "text": "„Bei den ÖVP-Wählern gab nur knapp die Hälfte ein innenpolitisches Wahlmotiv an (49 Prozent).“"
                            },
                            {
                                "example_id": "aacbe298-de21-40c3-b0e7-64d2626151a7",
                                "sense_id": "3f667bb0-f9cc-3f5f-827e-d4898b7e583f",
                                "text": "[Werner Schneider, Kabarettist und Publizist:] „Die Sozialdemokraten haben nur deshalb in Wien ihr Fell gerettet, weil ja die Bürgerlichen, die ÖVP-Wähler diesmal gesagt haben, wir wählen den Häupl.“"
                            },
                            {
                                "example_id": "91e5b02c-1bca-4186-9ac6-a079562797b8",
                                "sense_id": "3f667bb0-f9cc-3f5f-827e-d4898b7e583f",
                                "text": "„Nur wenige ÖVP-Wähler von 2017 entschieden sich bei dieser Wahl für eine andere Partei – stattdessen führt der größte Strom weg von der ÖVP zu den Nichtwählern […].“"
                            },
                            {
                                "example_id": "4c443815-7c7c-4472-92ae-2b7898b560ae",
                                "sense_id": "3f667bb0-f9cc-3f5f-827e-d4898b7e583f",
                                "text": "„Wähler verloren hat die Volkspartei in der Steiermark dagegen so gut wie keine: Drei Prozent der ÖVP-Wähler von 2017 wählten heuer die SPÖ, ein Prozent die FPÖ, die meisten Stimmen verlor die Volkspartei mit sieben Prozent an die Grünen.“"
                            },
                            {
                                "example_id": "ea6e737d-3a2a-4f04-b3ec-c839d23bc85e",
                                "sense_id": "3f667bb0-f9cc-3f5f-827e-d4898b7e583f",
                                "text": "„Während fast ein Drittel aller ÖVP-Wähler angab, die Person Sebastian Kurz sei für ihre Wahl ausschlaggebend gewesen, kommt die Person Kogler bei den Motiven der Grünwähler fast gar nicht vor.“"
                            },
                            {
                                "example_id": "00fee1f7-3c9f-4726-baf2-8946e2bfd441",
                                "sense_id": "3f667bb0-f9cc-3f5f-827e-d4898b7e583f",
                                "text": "„Beim Verhältnis von Stadt und Land galt in Österreich bisher: Während auf dem Land viele ÖVP-Wähler wohnen, punkten in den Städten, vor allem in Wien, die Sozialdemokraten und die Grünen.“"
                            },
                            {
                                "example_id": "7147ee8d-9b81-4e97-b2e9-7b1da7514039",
                                "sense_id": "3f667bb0-f9cc-3f5f-827e-d4898b7e583f",
                                "text": "„Die Initiative \"Es bleibt dabei\" […] lanciert seit Freitag früh über die sozialen Netzwerke Botschaften von früheren ÖVP-Wählern – die diesmal das Kreuz nicht bei der Partei von Sebastian Kurz machen werden.“"
                            },
                            {
                                "example_id": "65d634f3-55ef-44b5-bf74-b7d3224171bb",
                                "sense_id": "3f667bb0-f9cc-3f5f-827e-d4898b7e583f",
                                "text": "„Mit dieser Personalie zwang Kurz den ungeliebten [EU-Politiker Otmar] Karas, auch ÖVP-Wähler zu mobilisieren, die den derzeitigen Kurs der Partei nicht goutieren.“"
                            },
                            {
                                "example_id": "c5ebf7a1-712e-423c-96ea-59dd8ae305b0",
                                "sense_id": "3f667bb0-f9cc-3f5f-827e-d4898b7e583f",
                                "text": "„Am zufriedensten sind ÖVP-Wähler mit der Arbeit der Bundesregierung.“"
                            },
                            {
                                "example_id": "945917ce-cea3-4767-83f5-be02c8e97d88",
                                "sense_id": "3f667bb0-f9cc-3f5f-827e-d4898b7e583f",
                                "text": "„81 Prozent der Österreicher sind demnach der Meinung, dass Kanzler Sebastian Kurz zurücktreten sollte, wenn er der Falschaussage im Untersuchungsausschuss überführt wird. Und auch 62 Prozent der ÖVP-Wähler sehen das so.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
