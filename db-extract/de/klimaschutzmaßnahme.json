                "senses": [
                    {
                        "sense_id": "5979192d-b346-3c79-a8d9-68990b658d33",
                        "entry_id": "40da1167-e742-3426-88d8-a9d6ed9fe431",
                        "glosses": [
                            "Maßnahme zum Klimaschutz; Maßnahme gegen die menschengemachte Erderwärmung"
                        ],
                        "tags": [
                            "oft im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "538b7d25-6507-4415-964f-e36895aef50e",
                                "sense_id": "5979192d-b346-3c79-a8d9-68990b658d33",
                                "text": "„Die sieben führenden Industriestaaten G7 wollen ihre Klimaschutzmaßnahmen verstärken. Das geht aus dem Abschluss-Kommuniqué der Energie- und Umweltminister hervor, die zwei Tage lang in Berlin beraten haben.“"
                            },
                            {
                                "example_id": "90980ead-a321-4e5f-a00b-fbe3ef89225b",
                                "sense_id": "5979192d-b346-3c79-a8d9-68990b658d33",
                                "text": "„[…] Wird die Erderwärmung nicht durch rigorose Klimaschutzmaßnahmen begrenzt, könnten bis zur Mitte des Jahrtausends nur noch knapp sechs Prozent der heutigen Fläche der sibirischen Tundra im Nordosten Russlands übrig sein […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
