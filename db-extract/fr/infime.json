                "senses": [
                    {
                        "sense_id": "02b63d5a-cdfd-3420-82fb-06e6e94a6a0a",
                        "entry_id": "fe09bea5-3984-3042-b0cf-8823a1f1898a",
                        "glosses": [
                            "Qui est placé le plus bas."
                        ],
                        "tags": [],
                        "note": "Il se dit surtout au figuré",
                        "examples": [
                            {
                                "example_id": "e1ff4918-79ad-4d36-aadd-df0d5e623f42",
                                "sense_id": "02b63d5a-cdfd-3420-82fb-06e6e94a6a0a",
                                "text": "Les rangs infimes de la société."
                            }
                        ]
                    },
                    {
                        "sense_id": "4009737d-885c-327d-ae25-5b3f785dd52b",
                        "entry_id": "fe09bea5-3984-3042-b0cf-8823a1f1898a",
                        "glosses": [
                            "Tout petit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d26d3332-75c7-46d4-b372-aac9ce7bc65f",
                                "sense_id": "4009737d-885c-327d-ae25-5b3f785dd52b",
                                "text": "L’acquiescence active ou passive d'un vaste nombre d’Allemands au nazisme, la facile soumission de tous, sauf d'une brave et infime minorité, sont des faits d'une profonde signification historique."
                            },
                            {
                                "example_id": "11616d52-8e22-45c4-8b4c-f21dbe1df193",
                                "sense_id": "4009737d-885c-327d-ae25-5b3f785dd52b",
                                "text": "J’éduquais mon oreille à traduire des multitudes de sons infimes, petits trots de souris et grincements de bois, […]."
                            },
                            {
                                "example_id": "2e6208f7-9a97-43ff-90d2-0e04a323407b",
                                "sense_id": "4009737d-885c-327d-ae25-5b3f785dd52b",
                                "text": "Il en est de même pour les étoiles. […]. Les infimes oscillations visibles en surface offrent aux astronomes un aperçu de leur structure interne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5966d117-abb3-4fdc-afe0-eb3ac24bc684",
                        "source_entry_id": "fe09bea5-3984-3042-b0cf-8823a1f1898a",
                        "source_sense_description": "Placé le plus bas",
                        "target_lang_word": "lowest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lowest",
