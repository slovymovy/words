                    "frequency": "VeryLow",
                    "semantic_group_id": "headdress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional dancer wore a porcupine hair <w>roach</w> adorned with two eagle feathers.",
                            "target_lang_translations": {
                                "ru": "Традиционный танцор носил <w>роуч</w> из шерсти дикобраза, украшенный двумя орлиными перьями."
