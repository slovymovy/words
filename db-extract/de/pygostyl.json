                "senses": [
                    {
                        "sense_id": "5c4073da-9eb9-386c-8346-fa65e5f9ce4e",
                        "entry_id": "7d53cd7a-6a75-3e3c-990c-f7ef9a2e0f3c",
                        "glosses": [
                            "Skelettelement aus verwachsenen Schwanzwirbel am Skelett der Vögel, an denen die Schwanzfedern sitzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25949958-95dc-44ef-9dc3-681b3bf70ac6",
                                "sense_id": "5c4073da-9eb9-386c-8346-fa65e5f9ce4e",
                                "text": "„Das Pygostyl dient als stabile Unterlage für die Schwanzfedern, die durch das Hochklappen des Pygostyls aufgestellt werden können.“"
                            },
                            {
                                "example_id": "9bba23a2-0d5e-4270-aeff-ebd5497d1848",
                                "sense_id": "5c4073da-9eb9-386c-8346-fa65e5f9ce4e",
                                "text": "„Die Pygostylia lassen sich in zwei Gruppen in Bezug auf das Pygostyl aufteilen. Das Pygostyl der Ornithothoraces hatte ein pflugscharförmiges Ende, während die primitiveren Arten eine eher längliches, stabförmiges Pygostyl besaßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
