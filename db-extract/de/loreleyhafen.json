                "senses": [
                    {
                        "sense_id": "c2a84255-7706-3a64-9581-ee31ab514a34",
                        "entry_id": "8398e500-977c-3542-acfe-2e323306e206",
                        "glosses": [
                            "Hafen am Fuß der Loreley bei Sankt Goarshausen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7220c2c3-c145-4050-85f0-7f72cd54f33d",
                                "sense_id": "c2a84255-7706-3a64-9581-ee31ab514a34",
                                "text": "„Als sie den dichten Eichen- und Elsbeerenwald verlassen hatten, überquerten sie die B 42 und kamen zum Loreleyhafen.“"
                            },
                            {
                                "example_id": "75546169-40ec-406d-9def-d4ad6577ea56",
                                "sense_id": "c2a84255-7706-3a64-9581-ee31ab514a34",
                                "text": "„Der neue Loreleyhafen, den die Kleinbahn im Gefolge hatte, hat sich im Winter, wenn der Rhein mit Eis geht, wohl als nützlich erwiesen, wie schließlich alle Häfen. “"
                            },
                            {
                                "example_id": "48952a3a-ae99-4495-be8d-de985a89a7e8",
                                "sense_id": "c2a84255-7706-3a64-9581-ee31ab514a34",
                                "text": "„der gekenterte Säuretanker „Waldhof“ ist am Montagmorgen von Bergungsmannschaften in den Loreleyhafen geschleppt worden. “"
                            },
                            {
                                "example_id": "ed1a6b1e-97bb-45df-9b26-a961f677bb78",
                                "sense_id": "c2a84255-7706-3a64-9581-ee31ab514a34",
                                "text": "„Hingegen weichen die beiden Flussufer direkt stromabwärts, am Loreleyhafen, für eine kurze Strecke wannenartig wieder bis 400 Meter weit auseinander.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
