                        "sense_id": "2d57caea-13ba-3f55-a774-68d1067bdbc1",
                        "entry_id": "9e6d6b2d-1a2a-3bfa-afdf-f5a862decd0d",
                        "glosses": [
                            "a mangaka"
                        ],
                        "tags": [
                            "by-personal-gender",
