                                    {
                                        "sense_id": "715b651e-3473-3922-99df-b66592b535ea",
                                        "entry_id": "92d4bf25-c69e-3bc9-8199-2353d67ef34b",
                                        "glosses": [
                                            "Act of electing to office one previously elected to and serving in office."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "565f79a7-b275-457a-8450-05b23373e431",
                                                "sense_id": "715b651e-3473-3922-99df-b66592b535ea",
                                                "text": "In November 2024, Kiley won reelection in the district where Folsom is located by about 11 points, though Trumps' victory was closer to 3 points, according to data compiled by analyst Drew Savicki and cited by the Center for Politics at the University of Virginia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "333cd8aa-1611-3610-91cc-f062e9c9f672",
                                        "entry_id": "92d4bf25-c69e-3bc9-8199-2353d67ef34b",
                                        "glosses": [
                                            "The fact of being reelected."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c43ad3e0-8f09-4b43-b2a5-77de10a78373",
                        "source_entry_id": "bd676421-0327-3fdd-b46f-04f185e584d1",
                        "source_sense_id": "fa8a7100-e518-3f3c-8d55-1b7103c78585",
                        "target_lang_word": "re-election",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "re-election",
