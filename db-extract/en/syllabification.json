                    {
                        "translation_id": "2d64f069-0d93-48fa-b0db-8c0bc82b160a",
                        "source_entry_id": "de1cb51a-e561-3db3-85b4-5a10f68915c5",
                        "source_sense_id": "c464946e-97b2-3fee-9622-9a1b81a631ec",
                        "source_sense_description": "division of a word into syllables",
                        "target_lang_word": "Worttrennung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Worttrennung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb0cd2be-1ff9-34cc-ad9f-3237bc8b8b14",
                                        "entry_id": "ae52499f-e39a-3426-ab5f-da66ab851b61",
                                        "glosses": [
                                            "Aufspaltung, Trennung eines Wortes in Silben zum Zwecke der Verteilung auf eine weitere Zeile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf77ff39-f6b3-49fd-96c7-06078e7ca3f3",
                                                "sense_id": "fb0cd2be-1ff9-34cc-ad9f-3237bc8b8b14",
                                                "text": "Die Angaben zur Worttrennung sind für Schreibanfänger sehr hilfreich."
                                            },
                                            {
                                                "example_id": "ee7ae9b6-82d7-4907-a9e8-8a2571766eac",
                                                "sense_id": "fb0cd2be-1ff9-34cc-ad9f-3237bc8b8b14",
                                                "text": "Die Worttrennung orientiert sich oft an den Silben des Wortes, hält sich aber keineswegs immer an sie: Das Wort \"Atom\" z.B. ist zweisilbig, soll aber nicht getrennt werden."
                                            },
                                            {
                                                "example_id": "b46fd308-5c82-437b-a277-d8aef82f6f2a",
                                                "sense_id": "fb0cd2be-1ff9-34cc-ad9f-3237bc8b8b14",
                                                "text": "„Die Worttrennungen am Zeilenende konnten dann auch nach grammatischen Regeln durchgeführt werden.“"
                                            },
                                            {
                                                "example_id": "732ca975-61e8-467a-a5ce-ed5bd1256d07",
                                                "sense_id": "fb0cd2be-1ff9-34cc-ad9f-3237bc8b8b14",
                                                "text": "„Die geltenden Regeln zur Worttrennung lassen – besonders bei Fremdwörtern – häufig mehrere Trennmöglichkeiten zu.“"
                                            },
                                            {
                                                "example_id": "a2f47f67-d3d7-4519-be03-33b6cef7b92a",
                                                "sense_id": "fb0cd2be-1ff9-34cc-ad9f-3237bc8b8b14",
                                                "text": "„Nach der neuen Regelung der Worttrennung am Zeilenende ergeben sich bei vielen Fremdwörtern mehrere Trennvarianten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0efea0f8-3d53-4d13-97f5-6b89cec17247",
                        "source_entry_id": "de1cb51a-e561-3db3-85b4-5a10f68915c5",
                        "source_sense_id": "c464946e-97b2-3fee-9622-9a1b81a631ec",
                        "source_sense_description": "division of a word into syllables",
                        "target_lang_word": "Silbentrennung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Silbentrennung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01150ebc-404b-3ca8-983d-7665bca0b8e8",
                                        "entry_id": "bb71c44f-e277-3502-91db-7617b40ce29f",
                                        "glosses": [
                                            "Möglichkeit der Abtrennung einer oder mehrerer Silben eines Wortes durch Divise, um den Raum einer Zeile möglichst gut zu nutzen. Die Trennung orientiert sich weitgehend, aber keineswegs immer an den Silben."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6e1d4bc-5e91-4d08-aec0-e5ae3854daba",
                                                "sense_id": "01150ebc-404b-3ca8-983d-7665bca0b8e8",
                                                "text": "Ein Beispiel für eine Silbentrennung wäre: \"Häu-ser-fluch-ten\"."
                                            },
                                            {
                                                "example_id": "a93c1452-b169-49b6-8276-f68ba1623454",
                                                "sense_id": "01150ebc-404b-3ca8-983d-7665bca0b8e8",
                                                "text": "Die Trennungsregeln ergeben aber nicht immer wirklich eine Silbentrennung, so etwa bei einzelnen Vokalen, die nicht abgetrennt werden sollen, obwohl sie allein eine Silbe sind: Das Wort \"Atom\" soll nach der alten und nach der überarbeiteten neuen Rechtschreibung nicht getrennt werden."
                                            },
                                            {
                                                "example_id": "3be68ff1-8248-4e4b-bc72-9e13dc0e312e",
                                                "sense_id": "01150ebc-404b-3ca8-983d-7665bca0b8e8",
                                                "text": "„In erster Linie ist dabei an die Silbentrennung mehrsilbiger Wörter zu denken.“"
                                            },
                                            {
                                                "example_id": "554bc02b-6795-44a1-871e-f377424ecf79",
                                                "sense_id": "01150ebc-404b-3ca8-983d-7665bca0b8e8",
                                                "text": "„Sie hing ein Poster vom schwimmenden Markttreiben im Delta des Mekong an dieselbe Tafel, von der sein Sohn morgens die Silbentrennung lernte.“"
                                            },
                                            {
                                                "example_id": "9c710e4c-5b93-4b04-8bcf-e1b7c584e39f",
                                                "sense_id": "01150ebc-404b-3ca8-983d-7665bca0b8e8",
                                                "text": "„In den Bereich des Wortwitzes gehört vor allem die scherzhafte, absichtlich fehlerhafte Silbentrennung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
