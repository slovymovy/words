                                "zh": "这本书的主角名叫<w>库达</w>。"
                            }
                        },
                        {
                            "text": "Моего иностранного друга зовут <w>Куда</w>.",
                            "target_lang_translations": {
                                "en": "My foreign friend's name is <w>Kuda</w>.",
                                "zh": "我的外国朋友名叫<w>库达</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
