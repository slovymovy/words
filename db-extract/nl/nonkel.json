                                        "entry_id": "f0f343b4-3b5b-3568-a971-0bd29e7ce2e1",
                                        "glosses": [
                                            "Bruder von Mutter oder Vater einer Person"
                                        ],
                                        "tags": [
                                            "in einer Verwandtschaftsbeziehung ersten Grades"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47ffaa09-93b4-4e45-bd3c-acebcf5660e3",
                                                "sense_id": "fed4f4b8-bfb3-3875-b7b7-f941d88516dd",
                                                "text": "„Oma und Opa waren da, meine Eltern, mein Bruder Sebastian und Onkel Hugo.“"
                                            },
                                            {
                                                "example_id": "b003ebe3-66ec-41b4-b0cc-4351427883d8",
                                                "sense_id": "fed4f4b8-bfb3-3875-b7b7-f941d88516dd",
                                                "text": "„Ich stellte mir Onkel Louis vor, mit seiner Mütze auf dem Kopf, wie er am Steuer seines Citroëns saß und in den sonnigen Süden aufbrach.“"
                                            },
                                            {
                                                "example_id": "ae5de4d6-b345-465c-addc-6bee1c941ef5",
                                                "sense_id": "fed4f4b8-bfb3-3875-b7b7-f941d88516dd",
                                                "text": "Mein Onkel Richard wohnt in Amsterdam."
                                            },
                                            {
                                                "example_id": "56c94a72-0475-4d27-bd05-d0f0da3650c8",
                                                "sense_id": "fed4f4b8-bfb3-3875-b7b7-f941d88516dd",
                                                "text": "„So gesehen ist hier Onkel Gerhard der Außenseiter.“"
                                            },
                                            {
                                                "example_id": "2bf86344-1bfe-45c7-9ff6-ab0a3556c7cb",
                                                "sense_id": "fed4f4b8-bfb3-3875-b7b7-f941d88516dd",
                                                "text": "„Mein Onkel sprach weiter.“"
                                            }
                                        ],
