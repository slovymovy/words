{
    "word_family": [
        "over"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "23338a33-ef7d-3ace-a627-a7dc75bb3dc4",
                    "sense_definition": "To extend over and partly cover something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "overlap_verb_cover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tiles on the roof <w>overlap</w> to keep the rain out.",
                            "target_lang_translations": {
                                "ru": "Черепица на крыше <w>накладывается</w> друг на друга, чтобы не пропускать дождь.",
                                "zh": "屋顶的瓦片相互<w>重叠</w>以防止雨水渗入。"
                            }
                        },
                        {
                            "text": "Make sure the two sheets of paper <w>overlap</w> slightly at the edge.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что два листа бумаги слегка <w>перекрывают</w> друг друга по краю.",
                                "zh": "确保两张纸的边缘稍微<w>重叠</w>在一起。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cover",
                        "overlay"
                    ],
                    "common_phrases": [
                        "overlap slightly",
                        "overlap the edge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Частично накрывать или заходить краем на что-то другое.",
                        "zh": "指物体边缘延伸并部分覆盖在另一物体之上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перекрывать",
                                "target_lang_sense_clarification": "частично закрывать собой"
                            },
                            {
                                "target_lang_word": "накладываться",
                                "target_lang_sense_clarification": "ложиться поверх чего-то, частично закрывая"
                            },
                            {
                                "target_lang_word": "заходить",
                                "target_lang_sense_clarification": "выступать за пределы, накрывая край другого объекта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重叠",
                                "target_lang_sense_clarification": "指物体部分覆盖在一起"
                            },
                            {
                                "target_lang_word": "覆盖",
                                "target_lang_sense_clarification": "指遮盖或叠在上面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18d225c0-b413-38ab-9c3b-9ee75359efae",
                    "sense_definition": "To happen at the same time or during the same period.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "overlap_verb_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our holidays <w>overlap</w> by just two days.",
                            "target_lang_translations": {
                                "ru": "Наши отпуска <w>совпадают</w> всего на два дня.",
                                "zh": "我们的假期仅有两天<w>重合</w>。"
                            }
                        },
                        {
                            "text": "The two historical periods <w>overlap</w> significantly in this region.",
                            "target_lang_translations": {
                                "ru": "Два исторических периода значительно <w>пересекаются</w> в этом регионе.",
                                "zh": "这两个历史时期在该地区有显著的<w>交叉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coincide",
                        "concur"
                    ],
                    "common_phrases": [
                        "overlap in time",
                        "schedules overlap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходить одновременно или в один и тот же период времени.",
                        "zh": "指事件或时间段在同一时期内发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совпадать",
                                "target_lang_sense_clarification": "происходить в то же время"
                            },
                            {
                                "target_lang_word": "пересекаться",
                                "target_lang_sense_clarification": "иметь общий временной промежуток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重合",
                                "target_lang_sense_clarification": "指时间上的部分一致"
                            },
                            {
                                "target_lang_word": "交叉",
                                "target_lang_sense_clarification": "指时间段有共同部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "134fd331-f027-3111-b1e1-9ab2e2e747b9",
                    "sense_definition": "To share common features, areas, responsibilities, or ideas.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "overlap_verb_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their responsibilities <w>overlap</w> in several key areas of the project.",
                            "target_lang_translations": {
                                "ru": "Их обязанности <w>пересекаются</w> в нескольких ключевых областях проекта.",
                                "zh": "他们的职责在项目的几个关键领域存在<w>重合</w>。"
                            }
                        },
                        {
                            "text": "Psychology and biology often <w>overlap</w> in the study of the brain.",
                            "target_lang_translations": {
                                "ru": "Психология и биология часто <w>пересекаются</w> в изучении мозга.",
                                "zh": "心理学和生物学在脑科学研究中经常<w>交叉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intersect",
                        "share"
                    ],
                    "antonyms": [
                        "diverge"
                    ],
                    "common_phrases": [
                        "interests overlap",
                        "functions overlap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь общие черты, области, обязанности или идеи.",
                        "zh": "指在特征、领域、职责或观点上存在共同之处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересекаться",
                                "target_lang_sense_clarification": "иметь что-то общее (об интересах, темах)"
                            },
                            {
                                "target_lang_word": "иметь общие черты",
                                "target_lang_sense_clarification": "быть схожим в некоторых аспектах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重合",
                                "target_lang_sense_clarification": "指内容或范围上的共同点"
                            },
                            {
                                "target_lang_word": "交叉",
                                "target_lang_sense_clarification": "指领域或职责的相互交集"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "740debc0-0c8b-346c-96ec-878a14edc91c",
                    "sense_definition": "A part, amount, or period of time that covers or coincides with something else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overlap_noun_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a slight <w>overlap</w> between the two carpets.",
                            "target_lang_translations": {
                                "ru": "Между двумя коврами есть небольшой <w>нахлёст</w>.",
                                "zh": "两块地毯之间有一点<w>重叠部分</w>。"
                            }
                        },
                        {
                            "text": "The <w>overlap</w> in our schedules allowed us to have a quick meeting.",
                            "target_lang_translations": {
                                "ru": "<w>Совпадение</w> в наших расписаниях позволило нам провести быструю встречу.",
                                "zh": "我们日程安排上的<w>重合</w>让我们得以进行了一次简短的会议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intersection",
                        "commonality"
                    ],
                    "common_phrases": [
                        "significant overlap",
                        "degree of overlap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть, количество или период времени, которые накладываются или совпадают с чем-то другим.",
                        "zh": "指事物之间相互覆盖或在时间、空间上重合的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нахлёст",
                                "target_lang_sense_clarification": "наложение одного края на другой"
                            },
                            {
                                "target_lang_word": "пересечение",
                                "target_lang_sense_clarification": "общая часть или область"
                            },
                            {
                                "target_lang_word": "совпадение",
                                "target_lang_sense_clarification": "частичное наложение во времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重叠部分",
                                "target_lang_sense_clarification": "指相互覆盖的区域或范围"
                            },
                            {
                                "target_lang_word": "重合",
                                "target_lang_sense_clarification": "指时间或范围上的共同点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d09d258f-6455-33da-b51e-2a34f1a010dc",
                    "sense_definition": "A situation in a team sport where the attacking side has more players in a specific area than the defending side.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "overlap_noun_sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team exploited the <w>overlap</w> on the wing to score a try.",
                            "target_lang_translations": {
                                "ru": "Команда использовала <w>численное преимущество</w> на фланге, чтобы занести попытку.",
                                "zh": "球队利用边路的<w>人数优势</w>成功达阵得分。"
                            }
                        },
                        {
                            "text": "A quick pass created a two-man <w>overlap</w> that the defense could not stop.",
                            "target_lang_translations": {
                                "ru": "Быстрый пас создал <w>численное преимущество</w> в два игрока, которое защита не смогла остановить.",
                                "zh": "一次快速传球创造了防守方无法阻挡的两人<w>人数优势</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "create an overlap",
                        "waste an overlap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация в командном спорте, когда атакующая сторона имеет больше игроков в определенной зоне, чем защищающаяся.",
                        "zh": "在团队运动中，指进攻方在特定区域内的人数多于防守方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "численное преимущество",
                                "target_lang_sense_clarification": "превосходство в количестве игроков на участке поля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人数优势",
                                "target_lang_sense_clarification": "指在局部区域内进攻人数多于防守人数"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}