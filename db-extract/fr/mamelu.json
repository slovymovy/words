                ],
                "senses": [
                    {
                        "sense_id": "db77f330-6127-33ca-8e8e-3ff182908d20",
                        "entry_id": "12f6c8f1-35c2-3b24-816d-89bf17ac3eee",
                        "glosses": [
                            "Qui a de grosses mamelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff1adae1-6e2d-4c0e-bfc9-111aec85f4bf",
                                "sense_id": "db77f330-6127-33ca-8e8e-3ff182908d20",
                                "text": "Babette Manapoux devint en quelques années une énorme commère, démesurément hanchue et mamelue, aux bras craquelés par les lessives."
                            },
                            {
                                "example_id": "d66eda9b-93a1-46e4-bbf5-7b9f6240e01c",
                                "sense_id": "db77f330-6127-33ca-8e8e-3ff182908d20",
                                "text": "L’image d’un café pour hommes seuls, où des messieurs à moustaches courtes, chauves et mamelus, qui ressemblaient tous au général Franco, ruminaient en vitrine devant un verre d’eau glacée, couronna mes explorations."
                            },
                            {
                                "example_id": "89f8717a-97e6-4ad8-8cd2-bba37f9726e2",
                                "sense_id": "db77f330-6127-33ca-8e8e-3ff182908d20",
                                "text": "J'avoue l'ennui sans fond éprouvé devant ce conclave de mémères fessues, hanchues, cuissues et mamelues."
                            }
                        ]
                    },
                    {
                        "sense_id": "55fee625-9bc3-389f-a810-f5857bf1402b",
                        "entry_id": "12f6c8f1-35c2-3b24-816d-89bf17ac3eee",
                        "glosses": [
                            "Qui ressemble à de grosses mamelles."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "99ff756e-3520-444a-bfea-fddc7c05d3bc",
                                "sense_id": "55fee625-9bc3-389f-a810-f5857bf1402b",
                                "text": "Vin bu, tirons-en d’autre de nos coteaux mamelus !"
                            },
                            {
                                "example_id": "2a4b45e0-9d86-4dda-86ef-60b3d06dddcc",
                                "sense_id": "55fee625-9bc3-389f-a810-f5857bf1402b",
                                "text": "Elle vit les dundees à la voilure mamelue fondre dans la brume des horizons, les cotres de pêche fuir sous le vent."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
