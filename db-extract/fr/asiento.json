                        "glosses": [
                            "Traités signés successivement entre l’Espagne et différents pays pour la traite des esclaves noirs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "243db56e-2b04-4ba3-93bd-a5cc1dfcd594",
                                "sense_id": "9b3d99d0-79f6-3d06-b24c-f4c8189624e2",
                                "text": "La France abandonna l’asiento en 1713, le Royaume-Uni en 1750."
                            },
                            {
                                "example_id": "32a9bd3d-45a6-404d-a686-1e6e1384411e",
                                "sense_id": "9b3d99d0-79f6-3d06-b24c-f4c8189624e2",
                                "text": "L’asiento est accordé d’abord à l’Espagnol Garcia qui sous-traite à la Compagnie hollandaise et Guinée, puis au Hollandais Coymans, ensuite à la Compagnie de Cacheu (portugaise)."
