                        "source_sense_id": "fedc3cf9-a38f-31ac-aae9-7e320f300dd9",
                        "source_sense_description": "seafloor — see also seabed",
                        "target_lang_word": "fond marin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fond marin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b47e5e67-47af-3eae-a0f3-47f703602bf7",
                                        "entry_id": "9cc7b816-2c57-31e9-b245-dfd1f9951d04",
                                        "glosses": [
                                            "Sol ou surface immergée sous les océans et les mers de la Terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b257462c-b87b-4ef3-ab1c-1eee8fd26439",
                                                "sense_id": "b47e5e67-47af-3eae-a0f3-47f703602bf7",
                                                "text": "Le sous-marin, brisé en trois parties et qui avait disparu mercredi, a été retrouvé dans le fond marin au large de Bali."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80ca29a9-3fee-4fff-af53-c9c29542db7a",
                        "source_entry_id": "cec088e5-c659-32b6-8a09-73342d1876d7",
                        "source_sense_id": "fedc3cf9-a38f-31ac-aae9-7e320f300dd9",
                        "source_sense_description": "seafloor — see also seabed",
                        "target_lang_word": "Meeresgrund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meeresgrund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c923a3f-b202-3099-b6f9-d6cdf1298c1b",
                                        "entry_id": "a175cec7-3c08-37d3-b0c9-d486ed4d7701",
                                        "glosses": [
                                            "Boden des Meeres, der von Meerwasser bedeckt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f66a0502-04d5-4c1b-a26e-b26a34dcdb20",
                                                "sense_id": "3c923a3f-b202-3099-b6f9-d6cdf1298c1b",
                                                "text": "„Im Azorian-Projekt (auch bekannt als Jennifer-Projekt) versuchte die Central Intelligence Agency (CIA) unter strikter Geheimhaltung, das gesunkene sowjetische U-Boot K-129 vom Meeresgrund zu bergen.“"
                                            },
                                            {
                                                "example_id": "158e8036-fa44-497b-8db5-aae3de80c974",
                                                "sense_id": "3c923a3f-b202-3099-b6f9-d6cdf1298c1b",
                                                "text": "„Im offenen Meer vermischen sich chemische Stoffe gut, doch für das Überleben komplexer Moleküle ist es nicht ideal. Viele Wissenschaftler glauben, dass die Chancen auf dem Meeresgrund oder in Gesteinshöhlen besser waren.“"
                                            },
                                            {
                                                "example_id": "f906848f-b852-4819-953e-935176063490",
                                                "sense_id": "3c923a3f-b202-3099-b6f9-d6cdf1298c1b",
                                                "text": "„Marine Bodengemeinschaften benötigten aber nach der Bodenschatzgewinnung eine lange Zeit zur Regeneration. «Sandaale lieben Meeresgründe. Schweinswale lieben Sandaale», schilderte Benke.“"
                                            },
                                            {
                                                "example_id": "9d0e26f5-194a-4719-8ca1-7b7a631bc054",
                                                "sense_id": "3c923a3f-b202-3099-b6f9-d6cdf1298c1b",
                                                "text": "„[…] Was den Russen indes übel aufstößt, ist das Verhalten der russischen Führung im weiteren Sinne während der Tragödie der \"Kursk\", in den Tagen, da auf dem Meeresgrunde 118 Menschen qualvoll starben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
