                "senses": [
                    {
                        "sense_id": "2962caf1-5234-33b3-ab61-b0f34b9e7495",
                        "entry_id": "88dd2c52-6bc6-3566-a6a0-aa485257e7cd",
                        "glosses": [
                            "das, wovon ein Text handelt; zentraler Inhalt eines Textes"
                        ],
                        "tags": [
                            "speziell Textlinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "b1e93365-b7f2-4f47-879d-296d6574a09a",
                                "sense_id": "2962caf1-5234-33b3-ab61-b0f34b9e7495",
                                "text": "Ein Text kann mehrere Textthemen haben; eines davon wird aber das bestimmende, überragende Textthema, das Hauptthema, sein."
                            },
                            {
                                "example_id": "1cbc0b4b-a1a5-44b8-9446-328c44f7bb85",
                                "sense_id": "2962caf1-5234-33b3-ab61-b0f34b9e7495",
                                "text": "Bei manchen Texten wird das Textthema bereits in der Überschrift genannt."
                            },
                            {
                                "example_id": "532c3983-853d-4608-8dfb-a0a9e2ddffd9",
                                "sense_id": "2962caf1-5234-33b3-ab61-b0f34b9e7495",
                                "text": "Das Textthema kann man sich über Kohärenz und Kohäsion des Textes erschließen."
                            },
                            {
                                "example_id": "504ba0f6-8e5d-43a6-875e-d4248b93e7e3",
                                "sense_id": "2962caf1-5234-33b3-ab61-b0f34b9e7495",
                                "text": "Die thematische Entfaltung eines Textthemas kann je nach Absicht des Autors verschieden gestaltet werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
