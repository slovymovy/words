                "senses": [
                    {
                        "sense_id": "e850fec4-4447-3ba0-9cca-0872640871ec",
                        "entry_id": "6f9778c1-ff79-3dc7-9aee-8aa0c8895c5c",
                        "glosses": [
                            "Versammlung von Bischöfen; speziell Gremium, das sich aus allen Bischöfen eines Gebiets zusammensetzt, um diese zu koordinieren"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "9dd575df-8683-45b1-b379-a8ed39b17abb",
                                "sense_id": "e850fec4-4447-3ba0-9cca-0872640871ec",
                                "text": "„Gemäß can. 753 CIC besitzt die Bischofskonferenz Lehrautorität im Konferenzgebiet.“"
                            },
                            {
                                "example_id": "d41a9543-839a-4c4a-b700-17d3000f0270",
                                "sense_id": "e850fec4-4447-3ba0-9cca-0872640871ec",
                                "text": "„Im Vatikan bahnt sich ein Showdown zwischen dem Bischof von Limburg Franz-Peter Tebartz-van Elst und dem Vorsitzenden der Deutschen Bischofskonferenz Erzbischof Robert Zollitsch an.“"
                            },
                            {
                                "example_id": "96eae040-b218-46d0-8e60-d03f18392040",
                                "sense_id": "e850fec4-4447-3ba0-9cca-0872640871ec",
                                "text": "„Papst Benedikt XVI. hat die Deutsche Bischofskonferenz angewiesen, die deutsche Übersetzung der Messworte in einem theologisch zentralen Punkt zu ändern. So soll es in den Wandlungsworten der Eucharistie nicht mehr heißen, dass Jesus ›für alle‹ Menschen gestorben ist, sondern ›für viele‹.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
