                "senses": [
                    {
                        "sense_id": "f65d0951-12ae-38ed-9a23-aec95be0838e",
                        "entry_id": "b0901005-402c-3017-b122-7508141a30ed",
                        "glosses": [
                            "sogenannter Konzern, der im Deutschen Aktienindex gelistet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e785606-28f6-4824-acce-8ab5b612a71e",
                                "sense_id": "f65d0951-12ae-38ed-9a23-aec95be0838e",
                                "text": "„Zumwinkel, der 18 Jahre an der Spitze des DAX-Konzerns gestanden hatte, hatte am Freitag seinen Rücktritt eingereicht, nachdem am Donnerstag Steuerfahnder sein Wohnhaus und sein Büro durchsucht hatten.“"
                            },
                            {
                                "example_id": "50b93377-1e50-436e-bf28-b115d50c2fea",
                                "sense_id": "f65d0951-12ae-38ed-9a23-aec95be0838e",
                                "text": "„Die Bosse der DAX-Konzerne verdienen jedes Jahr Millionen - aber sie könnten noch viel mehr verdienen.“"
                            },
                            {
                                "example_id": "08b79040-a53b-41fd-b2b0-73d1dc27aa89",
                                "sense_id": "f65d0951-12ae-38ed-9a23-aec95be0838e",
                                "text": "„Ein Vorstand eines DAX-Konzernes in Untersuchungshaft, das kommt nicht alle Tage vor.“"
                            },
                            {
                                "example_id": "a8776bc6-fc83-46ca-becc-0cad5f2b9d24",
                                "sense_id": "f65d0951-12ae-38ed-9a23-aec95be0838e",
                                "text": "„Das fränkische Familienunternehmen Schaeffler kündigt an, den dreimal so großen DAX-Konzern Continental aus Hannover übernehmen zu wollen und hat sich dafür mit Hilfe von Banken bereits Zugriff auf mindestens 30 % der Aktien gesichert.“"
                            },
                            {
                                "example_id": "467f2473-ae05-4c8a-8ba9-934b6f30c783",
                                "sense_id": "f65d0951-12ae-38ed-9a23-aec95be0838e",
                                "text": "„In 21 DAX-Konzernen verdienten die Top-Manager im Schnitt mehr als 2 Millionen Euro.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
