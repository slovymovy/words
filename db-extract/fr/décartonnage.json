                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3e96252-d083-4753-bf81-7ad69730eae4",
                                "sense_id": "7e78a348-6d97-3223-b539-0eecbea1bdab",
                                "text": "Toutes les denrées sont décartonnées avant stockage. Dans le cas des produits surgelés, le stockage en carton est toléré mais le décartonnage devra toujours être réalisé en « zone sale » avant son acheminement en cuisine."
                            },
                            {
                                "example_id": "59f8343a-9f54-4ce5-86bf-fbec486e9970",
                                "sense_id": "7e78a348-6d97-3223-b539-0eecbea1bdab",
                                "text": "Ne pas introduire de carton, bois, palette dans le local de fabrication alimentaire ou prévoir un lieu séparé pour le décartonnage/décaissage et/ou une table spécifique à l’entrée de la salle de fabrication."
                            }
                        ]
