                "senses": [
                    {
                        "sense_id": "1c2c23da-e7c8-3bc9-b94e-4b8c43f97242",
                        "entry_id": "cbec2a7c-fc5b-34ce-b2da-4837e3e72a7c",
                        "glosses": [
                            "niederösterreichische Marktgemeinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85dd64d6-f9d9-4a98-9937-a445c9b38947",
                                "sense_id": "1c2c23da-e7c8-3bc9-b94e-4b8c43f97242",
                                "text": "Kaltenleutgeben war lange Jahre ein beliebter Schiort in der Nähe von Wien. Bis vor wenigen jahren gab es auf der Norwegerwiese noch einen kleinen Schlepplift, der jedoch 2011 endgültig eingestellt wurde."
                            },
                            {
                                "example_id": "82f66676-974a-44b5-bf91-b83b9b3cfcd9",
                                "sense_id": "1c2c23da-e7c8-3bc9-b94e-4b8c43f97242",
                                "text": "In den fünfziger Jahren kommt es hier, im „Schidorf der Wiener“, zu zwei Wintersportereignissen, die in die Annalen Kaltenleutgebens eingehen sollen."
                            },
                            {
                                "example_id": "f24730b4-fc4c-46b8-b8c4-b4c1e4fc8836",
                                "sense_id": "1c2c23da-e7c8-3bc9-b94e-4b8c43f97242",
                                "text": "Graue Turmruinen, verfallene, mit Graffiti besprühte Lagerhallen und Silos, von denen der Putz abbröckelt, erinnern in Kaltenleutgeben im Bezirk Mödling in Niederösterreich an die ehemalige Blütezeit der Perlmooser-Zementfabrik."
                            },
                            {
                                "example_id": "a8348533-b939-4ed6-9590-19df2e2ad3ab",
                                "sense_id": "1c2c23da-e7c8-3bc9-b94e-4b8c43f97242",
                                "text": "Die Bemühungen Kaltenleutgebens, für den Ernstfall gerüstet zu sein, wurden bereits des Öfteren von Vertretern des Landes Niederösterreich und in der medialen Berichterstattung gewürdigt und als beispielhaft für gemeindepolitisches Engagement erwähnt."
                            },
                            {
                                "example_id": "33e1b1c1-e2bf-4261-9758-0c239d3f249a",
                                "sense_id": "1c2c23da-e7c8-3bc9-b94e-4b8c43f97242",
                                "text": "Er war am 15. Juni 2017 am Glitzersee bei Kaltenleutgeben gegen eine nur spärlich bekleidete Frau und ihren Begleiter verbal vorgegangen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
