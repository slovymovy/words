                        "glosses": [
                            "steenslag waarin de dwarsliggers van een spoorweg liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65eaf82b-2bb6-471a-b127-6987296fc004",
                                "sense_id": "164261ac-e310-3b60-9da8-ab68c2ce29d6",
                                "text": "In de buurt van Dannenberg, waar de treinrit eindigt en de 123 ton kernafval op vrachtwagens wordt geladen, proberen activisten bij het spoor te komen om stenen uit het zogeheten ballastbed van het spoor te halen. Dat moet de stabiliteit onder de rails wegnemen en het transport doen stoppen."
                            },
                            {
                                "example_id": "4424a4eb-55f6-4b10-81b1-4716dde92c96",
                                "sense_id": "164261ac-e310-3b60-9da8-ab68c2ce29d6",
                                "text": "Door werkzaamheden aan het spoor was een kier in het viaduct ontstaan, waardoor grint uit het ballastbed liep. Volgens de politie was een grote hoeveelheid stenen op het wegdek terechtgekomen."
                            }
                        ]
                    }
