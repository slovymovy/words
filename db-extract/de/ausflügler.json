                "senses": [
                    {
                        "sense_id": "7430f2dc-ac44-310b-9cc6-66da352572c9",
                        "entry_id": "c313308d-2bfe-313d-9466-2c0a306d7afd",
                        "glosses": [
                            "Person, die einen Ausflug unternimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01e4512f-6eca-4f2f-a624-83229c6cc703",
                                "sense_id": "7430f2dc-ac44-310b-9cc6-66da352572c9",
                                "text": "„Den Ausflüglern geht es ausschließlich ums Vergnügen, und das heißt Bier, Korn und Mädchen.“"
                            },
                            {
                                "example_id": "16ae63af-a699-4995-8f79-d4290f4df90b",
                                "sense_id": "7430f2dc-ac44-310b-9cc6-66da352572c9",
                                "text": "„Erst waren sie mit anderen Ausflüglern unterwegs gewesen, aber die hatten sich nach und nach in alle Richtungen zerstreut.“"
                            },
                            {
                                "example_id": "b8742f03-fd3a-478b-b116-4a0c1acd8d35",
                                "sense_id": "7430f2dc-ac44-310b-9cc6-66da352572c9",
                                "text": "„Wir hielten an, stiegen aus; die Ausflügler verteilten sich auf den wenigen Quadratmetern Asphalt und zückten die Apparate.“"
                            },
                            {
                                "example_id": "fa7a82e4-018e-4719-a089-0ad2c987f746",
                                "sense_id": "7430f2dc-ac44-310b-9cc6-66da352572c9",
                                "text": "„Die Ausflügler aus der Stadt waren in vergnügter Stimmung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e82cbae-05f4-4fd0-967f-a2efc1be2235",
                        "source_entry_id": "c313308d-2bfe-313d-9466-2c0a306d7afd",
                        "source_sense_id": "7430f2dc-ac44-310b-9cc6-66da352572c9",
                        "source_sense_description": "Person, die einen Ausflug unternimmt",
                        "target_lang_word": "day-tripper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "day-tripper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1706b064-f9b5-3133-b44f-f5c0547a3f42",
                                        "entry_id": "572df1e2-6e1c-3790-87a0-cf576a39230b",
                                        "glosses": [
                                            "Someone who takes a day trip."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0132b4b7-a18e-4f32-bb7a-9034412996df",
                                                "sense_id": "1706b064-f9b5-3133-b44f-f5c0547a3f42",
                                                "text": "The Northern coastal districts of Kent, from Whitstable to Ramsgate, are one of the distressed areas of England. Their main industry – in fact almost the only one – is the summer holidaymakers, both day-trippers and fortnightly boarders. In these changing times, the habits of holidaymakers are altering also."
                                            },
                                            {
                                                "example_id": "2e13180d-1135-4747-b93f-010a1ff8d08a",
                                                "sense_id": "1706b064-f9b5-3133-b44f-f5c0547a3f42",
                                                "text": "After stopping at these stations, my train has become busy. Returning day-trippers make up a goodly number, along with young people heading for a night out in Bristol, which is where I change once again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24af651b-7b72-4c34-be55-6d3711266fb1",
                        "source_entry_id": "c313308d-2bfe-313d-9466-2c0a306d7afd",
                        "source_sense_id": "7430f2dc-ac44-310b-9cc6-66da352572c9",
                        "source_sense_description": "Person, die einen Ausflug unternimmt",
                        "target_lang_word": "tripper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
