    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "732fb679-05da-30f9-ae63-34a91df99db5",
                    "sense_definition": "The part of the body at the end of the arm, including the fingers and thumb.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "body_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She held the small bird gently in her <w>hand</w>.",
                            "target_lang_translations": {
                                "ru": "Она осторожно держала маленькую птичку в <w>руке</w>."
                            }
                        },
                        {
                            "text": "Please wash your <w>hands</w> before you sit down to eat dinner.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, вымой <w>руки</w>, прежде чем садиться ужинать."
                            }
                        }
                    ],
                    "synonyms": [
                        "manus",
                        "paw"
                    ],
                    "common_phrases": [
                        "shake hands",
                        "hold hands",
                        "wash hands",
                        "left hand",
                        "right hand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть тела на конце руки, включающая пальцы и большой палец."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рука́",
                                "target_lang_sense_clarification": "конечность в целом"
                            },
                            {
                                "target_lang_word": "кисть руки́",
                                "target_lang_sense_clarification": "анатомическая часть от запястья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b684b882-54ea-3512-8369-37953a7266c6",
                    "sense_definition": "A pointer on a dial, such as those on a clock that show the hours and minutes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "indicators",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The minute <w>hand</w> of the clock moved slowly toward twelve.",
                            "target_lang_translations": {
                                "ru": "Минутная <w>стрелка</w> часов медленно двигалась к двенадцати."
                            }
                        },
                        {
                            "text": "I noticed the second <w>hand</w> was ticking very loudly in the quiet room.",
                            "target_lang_translations": {
                                "ru": "Я заметил, что секундная <w>стрелка</w> очень громко тикала в тихой комнате."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hour hand",
                        "minute hand",
                        "second hand",
                        "clock hand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Указатель на циферблате, например, на часах, показывающий часы и минуты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стре́лка",
                                "target_lang_sense_clarification": "указатель на часах или приборах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b74307a-491c-3092-9b69-73ede802dcdd",
                    "sense_definition": "An act of helping or assisting someone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "assistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Could you give me a <w>hand</w> with these heavy grocery bags?",
                            "target_lang_translations": {
                                "ru": "Не могли бы вы мне <w>помочь</w> с этими тяжелыми сумками с продуктами?"
                            }
                        },
                        {
                            "text": "He was always willing to lend a <w>hand</w> to his neighbors.",
                            "target_lang_translations": {
                                "ru": "Он всегда был готов <w>протянуть руку помощи</w> своим соседям."
                            }
                        }
                    ],
                    "common_phrases": [
                        "give a hand",
                        "lend a hand",
                        "need a hand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт помощи или содействия кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по́мощь",
                                "target_lang_sense_clarification": "содействие"
                            },
                            {
                                "target_lang_word": "подсо́бная рука́",
                                "target_lang_sense_clarification": "в выражении «помочь»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b476e47-9501-3d73-a981-3e2422c22f4b",
                    "sense_definition": "The set of cards that a player is holding during a game.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked at his <w>hand</w> and realized he had a winning set of cards.",
                            "target_lang_translations": {
                                "ru": "Он посмотрел на свои <w>карты</w> и понял, что у него выигрышная комбинация."
                            }
                        },
                        {
                            "text": "It is important not to let the other players see your <w>hand</w>.",
                            "target_lang_translations": {
                                "ru": "Важно не давать другим игрокам видеть ваши <w>карты</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "winning hand",
                        "poker hand",
                        "play your hand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор карт, который игрок держит во время игры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рука́",
                                "target_lang_sense_clarification": "набор карт игрока"
                            },
                            {
                                "target_lang_word": "карты на рука́х",
                                "target_lang_sense_clarification": "игровой набор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b02f981-8b2d-3e89-ba4b-7e0a560a601a",
                    "sense_definition": "A round of applause or clapping to show approval.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "applause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let's give a big <w>hand</w> for our next performer tonight.",
                            "target_lang_translations": {
                                "ru": "Давайте искупаем в <w>аплодисментах</w> нашего следующего исполнителя."
                            }
                        },
                        {
                            "text": "The singer received a huge <w>hand</w> after finishing her final song.",
                            "target_lang_translations": {
                                "ru": "Певица удостоилась бурных <w>оваций</w> после завершения своей последней песни."
                            }
                        }
                    ],
                    "common_phrases": [
                        "big hand",
                        "huge hand"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the phrase 'give someone a hand'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Раунд аплодисментов или хлопанье в ладоши для выражения одобрения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аплодисме́нты",
                                "target_lang_sense_clarification": "одобрение хлопаньем"
                            },
                            {
                                "target_lang_word": "рукоплеска́ния",
                                "target_lang_sense_clarification": "торжественные аплодисменты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3554112b-03a5-3d3a-ad53-86be2e55d631",
                    "sense_definition": "Control, management, or care of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project is in good <w>hands</w> with the new manager.",
                            "target_lang_translations": {
                                "ru": "Проект в надежных <w>руках</w> у нового менеджера."
                            }
                        },
                        {
                            "text": "The company changed <w>hands</w> after the merger was finalized.",
                            "target_lang_translations": {
                                "ru": "Компания <w>перешла к другим владельцам</w> после завершения слияния."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in good hands",
                        "in safe hands",
                        "change hands"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контроль, управление или забота о чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ру́ки",
                                "target_lang_sense_clarification": "контроль или владение"
                            },
                            {
                                "target_lang_word": "веде́ние",
                                "target_lang_sense_clarification": "управление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15fbd84a-c8f3-3526-b071-63b4b104a07c",
                    "sense_definition": "A person who performs manual labor, especially on a farm or ship.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "workers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer hired several extra <w>hands</w> to help with the harvest.",
                            "target_lang_translations": {
                                "ru": "Фермер нанял несколько дополнительных <w>рабочих</w>, чтобы помочь с урожаем."
                            }
                        },
                        {
                            "text": "All <w>hands</w> on deck were needed to secure the ship during the storm.",
                            "target_lang_translations": {
                                "ru": "Все <w>матросы</w> были вызваны на палубу, чтобы закрепить судно во время шторма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "farm hand",
                        "deck hand",
                        "all hands"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, выполняющий физический труд, особенно на ферме или корабле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рабо́чий",
                                "target_lang_sense_clarification": "наемный работник"
                            },
                            {
                                "target_lang_word": "рабо́чие ру́ки",
                                "target_lang_sense_clarification": "персонал, рабочая сила"
                            },
                            {
                                "target_lang_word": "матро́с",
                                "target_lang_sense_clarification": "член экипажа судна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b55cc1b-d17f-3dfa-a143-32c32f3a315a",
                    "sense_definition": "A person's particular style of writing by hand.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wrote the invitation in a very elegant, flowing <w>hand</w>.",
                            "target_lang_translations": {
                                "ru": "Она написала приглашение очень элегантным, беглым <w>почерком</w>."
                            }
                        },
                        {
                            "text": "I recognized his <w>hand</w> immediately from the signature on the letter.",
                            "target_lang_translations": {
                                "ru": "Я сразу узнал его <w>руку</w> по подписи на письме."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clear hand",
                        "good hand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особый стиль письма человека от руки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по́черк",
                                "target_lang_sense_clarification": "манера письма"
                            },
                            {
                                "target_lang_word": "рука́",
                                "target_lang_sense_clarification": "авторский стиль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8aecb346-a930-39a8-b17a-9f0988c1db05",
                    "sense_definition": "A unit of measurement equal to four inches, used especially for the height of horses.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stallion stood nearly sixteen <w>hands</w> high at the shoulder.",
                            "target_lang_translations": {
                                "ru": "Жеребец был высотой почти шестнадцать <w>ладоней</w> в холке."
                            }
                        },
                        {
                            "text": "He preferred riding a horse that was at least fifteen <w>hands</w>.",
                            "target_lang_translations": {
                                "ru": "Он предпочитал ездить на лошади ростом не менее пятнадцати <w>хэндов</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hands high"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Technical measurement in equestrian contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица измерения, равная четырем дюймам, используемая в основном для измерения роста лошадей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хэнд",
                                "target_lang_sense_clarification": "единица измерения (4 дюйма)"
                            },
                            {
                                "target_lang_word": "ладо́нь",
                                "target_lang_sense_clarification": "мера длины в коневодстве"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1a4a66e6-9849-38d1-98c3-cd910f0008fd",
                    "sense_definition": "To give or pass something to someone using your hands.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>hand</w> me that book on the table.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>передай</w> мне ту книгу на столе."
                            }
                        },
                        {
                            "text": "He <w>handed</w> over the keys to the new owner of the house.",
                            "target_lang_translations": {
                                "ru": "Он <w>вручил</w> ключи новому владельцу дома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hand over",
                        "hand out",
                        "hand in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дать или передать что-либо кому-либо, используя руки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передава́ть",
                                "target_lang_sense_clarification": "отдавать в руки"
                            },
                            {
                                "target_lang_word": "вруча́ть",
                                "target_lang_sense_clarification": "передавать лично"
                            },
                            {
                                "target_lang_word": "подава́ть",
                                "target_lang_sense_clarification": "протягивать предмет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29762bc3-acb3-3f03-9017-74b25b09c8aa",
                    "sense_definition": "To lead or assist someone by taking their hand.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "assistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gentleman <w>handed</w> the lady into the carriage with great care.",
                            "target_lang_translations": {
                                "ru": "Джентльмен очень осторожно <w>помог</w> даме сесть в карету."
                            }
                        },
                        {
                            "text": "He <w>handed</w> his grandmother down the steep stairs.",
                            "target_lang_translations": {
                                "ru": "Он <w>свел</w> свою бабушку вниз по крутой лестнице, поддерживая за руку."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in formal or older contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести или помогать кому-либо, взяв его за руку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддерживать за руку",
                                "target_lang_sense_clarification": "помогать идти"
                            },
                            {
                                "target_lang_word": "вести под руку",
                                "target_lang_sense_clarification": "сопровождать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
