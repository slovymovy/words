                        "entry_id": "681119ca-3877-36d5-b7af-284d94581133",
                        "glosses": [
                            "Auteur, autrice de scénarios."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb77adbc-eb3d-4bbe-b54c-0fe47a44e426",
                                "sense_id": "3ec9e515-9652-39c6-b6c5-38f726b84549",
                                "text": "Â 17 ans, j’ai rencontré une personne qui réalisait, au même âge, qu’elle était en situation d’intersexuation, racontait Yaël Langmann, la créatrice, scénariste et coréalisatrice de Chair tendre, lors d’un entretien à Séries Mania."
                            },
                            {
                                "example_id": "4f0ea592-12b8-437d-a9d2-f070a7e653b3",
                                "sense_id": "3ec9e515-9652-39c6-b6c5-38f726b84549",
                                "text": "Créée par Adam Price, qui reste le scénariste de cette suite, la série retrouve tous ses personnages ou presque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21c22db9-3dec-42d6-9b11-bee3529a9377",
                        "source_entry_id": "681119ca-3877-36d5-b7af-284d94581133",
                        "source_sense_id": "3ec9e515-9652-39c6-b6c5-38f726b84549",
                        "target_lang_word": "Drehbuchautor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drehbuchautor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a05210b-8e76-3fe2-bf46-1ca827de7b91",
                                        "entry_id": "8c5cd11e-6291-3906-8aa2-fd032239b3f0",
                                        "glosses": [
                                            "Verfasser eines Drehbuchs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ac002c5-fb10-4ef2-bf5a-7d4acb3e6578",
                                                "sense_id": "0a05210b-8e76-3fe2-bf46-1ca827de7b91",
                                                "text": "Nachdem für den Film ein neuer Drehbuchautor gefunden wurde, konnte das Filmprojekt fortgesetzt werden."
                                            },
                                            {
                                                "example_id": "d10cbf15-040e-47a2-856e-5b75e092cb23",
                                                "sense_id": "0a05210b-8e76-3fe2-bf46-1ca827de7b91",
                                                "text": "„Und bei einem der langen Gespräche, die wir erst über Wochen, später über Monate führten, erzählte er mir eine Geschichte aus der Zeit, als er noch Drehbuchautor in Hollywood war.“"
                                            },
                                            {
                                                "example_id": "5ebab4f6-9bca-4531-8015-5c1b79914100",
                                                "sense_id": "0a05210b-8e76-3fe2-bf46-1ca827de7b91",
                                                "text": "„In diesem Land sprießen die Schauspieler, Regisseure, Drehbuchautoren und Produzenten mit großen Ideen im Kopf wie Pilze aus der Erde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
