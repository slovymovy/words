                ],
                "senses": [
                    {
                        "sense_id": "3ada1c1c-0119-3136-9584-2921fa8d23ec",
                        "entry_id": "ba1940d9-4700-3034-8ea4-cd7330830dbf",
                        "glosses": [
                            "разг.-сниж. усилие, сильное напряжение или волнение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51bda375-2a60-4010-9203-b4bed4dfb614",
                                "sense_id": "3ada1c1c-0119-3136-9584-2921fa8d23ec",
                                "text": "Гостья моя, за которую я и глотка не отпил, сидит в напряге."
                            },
                            {
                                "example_id": "a994061b-4f1d-4a7d-b5a7-cec3d3615032",
                                "sense_id": "3ada1c1c-0119-3136-9584-2921fa8d23ec",
                                "text": "Упирается ногой, тянет. Стонет от напряга. Едва повернув петли, протискивается внутрь."
                            },
                            {
                                "example_id": "6a88a086-cab0-42e3-8d76-5f62ba65e84e",
                                "sense_id": "3ada1c1c-0119-3136-9584-2921fa8d23ec",
                                "text": "Поэтому людям хочется всего и сразу, без какого-либо напряга…"
                            }
                        ]
                    },
                    {
                        "sense_id": "3a2548dd-34af-330b-b674-cb956d0d1bf1",
                        "entry_id": "ba1940d9-4700-3034-8ea4-cd7330830dbf",
                        "glosses": [
                            "разг.-сниж. затруднительное положение, неприятность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5e8f26a-01ad-4535-88d8-8704315e4c3e",
                                "sense_id": "3a2548dd-34af-330b-b674-cb956d0d1bf1",
                                "text": "Кстати, с дочкой напрягов поменьше было."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2d47a93-7fc5-35d8-aa76-ba527d748a1b",
                        "entry_id": "ba1940d9-4700-3034-8ea4-cd7330830dbf",
                        "glosses": [
                            "разг.-сниж. предик. отсутствие, нехватка чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "946d91f4-4716-4ba4-8766-669029e6a7a1",
                                "sense_id": "b2d47a93-7fc5-35d8-aa76-ba527d748a1b",
                                "text": "У мну со временем напряг конкретный для этого дела"
                            },
                            {
                                "example_id": "8b5b419c-3611-4979-a539-57b2c3bc6c45",
                                "sense_id": "b2d47a93-7fc5-35d8-aa76-ba527d748a1b",
                                "text": "У меня есть в избытке первого и третьего, а вот со вторым — конкретный напряг, как оказалось"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a0a63ec-ae34-4285-97e3-6b1decb07e8a",
                        "source_entry_id": "ba1940d9-4700-3034-8ea4-cd7330830dbf",
                        "source_sense_description": "неприятность",
                        "target_lang_word": "trouble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trouble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1148f4d6-1ea3-3fb7-b297-b60a877b8abf",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "A distressing or dangerous situation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1e14807-2bc0-4dcd-8034-e819c4c92c03",
                                                "sense_id": "1148f4d6-1ea3-3fb7-b297-b60a877b8abf",
                                                "text": "He was in trouble when the rain started."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e9d6a9c-6132-31bd-98d0-ad7d918b8cf9",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "A difficulty, problem, condition, or action contributing to such a situation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e26cb915-64aa-427c-831a-25256c2f2db5",
                                                "sense_id": "0e9d6a9c-6132-31bd-98d0-ad7d918b8cf9",
                                                "text": "The trouble was a leaking brake line."
                                            },
                                            {
                                                "example_id": "34c66b71-3813-43c4-85d3-fc0efd5db363",
                                                "sense_id": "0e9d6a9c-6132-31bd-98d0-ad7d918b8cf9",
                                                "text": "The bridge column magnified the trouble with a slight tilt in the wrong direction."
                                            },
                                            {
                                                "example_id": "1b379515-2be1-44e9-889c-09c9b214b862",
                                                "sense_id": "0e9d6a9c-6132-31bd-98d0-ad7d918b8cf9",
                                                "text": "Lest the fiend […] some new trouble raise."
                                            },
                                            {
                                                "example_id": "2a704036-ad79-4750-9c30-58233e0b0e77",
                                                "sense_id": "0e9d6a9c-6132-31bd-98d0-ad7d918b8cf9",
                                                "text": "Foul whisperings are abroad; unnatural deeds / Do breed unnatural troubles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1556e72c-a9d9-3d4e-bc43-bf7941536724",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "A person liable to place others or themselves in such a situation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "251d154a-dc1c-4f9e-9fd3-f92e1821240c",
                                                "sense_id": "1556e72c-a9d9-3d4e-bc43-bf7941536724",
                                                "text": "’Cause I knew you were trouble when you walked in\nSo shame on me no-ow"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2611545-76f8-3f8e-a168-d1717ecccad5",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "The state of being troubled, disturbed, or distressed mentally; unease, disquiet."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21cabb79-9ad6-4ad5-8c6b-59f2942395ae",
                                                "sense_id": "d2611545-76f8-3f8e-a168-d1717ecccad5",
                                                "text": "Yet oft when sundown skirts the moor\n⁠An inner trouble I behold,\n⁠A spectral doubt which makes me cold,\nThat I shall be thy mate no more, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35538dbe-02e1-3c5a-a884-216a6d170270",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "Objectionable feature of something or someone; problem, drawback, weakness, failing, or shortcoming."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df34105b-616c-4814-8961-d3efdce03655",
                                                "sense_id": "35538dbe-02e1-3c5a-a884-216a6d170270",
                                                "text": "Your trouble is that you quit too readily."
                                            },
                                            {
                                                "example_id": "7c01496b-28c1-4a36-8bbc-e69faba5fd63",
                                                "sense_id": "35538dbe-02e1-3c5a-a884-216a6d170270",
                                                "text": "The trouble with that suggestion is that we lack the funds to put it in motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf0a52de-c4be-33b0-b5ea-ac7a1b4ea674",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "Violent or turbulent occurrence or event; unrest, disturbance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "116dea0c-70c6-4e55-b95a-50f636a0c4c6",
                                                "sense_id": "cf0a52de-c4be-33b0-b5ea-ac7a1b4ea674",
                                                "text": "the troubles in Northern Ireland"
                                            },
                                            {
                                                "example_id": "7dc29a1e-daee-4dd2-99db-2387464997b0",
                                                "sense_id": "cf0a52de-c4be-33b0-b5ea-ac7a1b4ea674",
                                                "text": "“I don’t know how you and the ‘head,’ as you call him, will get on, but I do know that if you call my duds a ‘livery’ again there’ll be trouble. It’s bad enough to go around togged out like a life saver on a drill day, but I can stand that ’cause I'm paid for it. What I won’t stand is to have them togs called a livery. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d05f5fde-0d96-3302-b4b9-43f73624fbeb",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "Efforts taken or expended, typically beyond the normal required."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffc34156-d002-4560-839f-05b44c182d5d",
                                                "sense_id": "d05f5fde-0d96-3302-b4b9-43f73624fbeb",
                                                "text": "It’s no trouble for me to edit it."
                                            },
                                            {
                                                "example_id": "fda9f9d6-3d1f-45f1-a0b8-5436cbd77db1",
                                                "sense_id": "d05f5fde-0d96-3302-b4b9-43f73624fbeb",
                                                "text": "She never took the trouble to close them."
                                            },
                                            {
                                                "example_id": "970406ab-a0ce-47df-b37a-e895f4f2b862",
                                                "sense_id": "d05f5fde-0d96-3302-b4b9-43f73624fbeb",
                                                "text": "Indeed, by the report of our elders, this nervous preparation for old age is only trouble thrown away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a6763fa-d6e4-3df4-8f49-bdd0e69c8ff0",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "Difficulty in doing something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63486427-ebb3-42f9-928c-5ec62f773158",
                                                "sense_id": "1a6763fa-d6e4-3df4-8f49-bdd0e69c8ff0",
                                                "text": "She has trouble eating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24d3be10-abfc-3ffe-ab7d-7b9fc7bea13a",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "Health problems, ailment, generally of some particular part of the body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4334b51f-6892-43a8-a391-e899a18206d5",
                                                "sense_id": "24d3be10-abfc-3ffe-ab7d-7b9fc7bea13a",
                                                "text": "He’s been in hospital with some heart trouble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b818d024-7106-3a93-baac-c912d18ec989",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "A malfunction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8923cddf-cd22-4667-9393-40d5d1969366",
                                                "sense_id": "b818d024-7106-3a93-baac-c912d18ec989",
                                                "text": "My old car has engine trouble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e5dae39-c44d-3500-8f29-eb479be399ab",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "Liability to punishment; conflict with authority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b314e84a-29f4-4447-b272-adbce489482f",
                                                "sense_id": "2e5dae39-c44d-3500-8f29-eb479be399ab",
                                                "text": "He had some trouble with the law."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75082684-150a-3a24-b4ff-a6a7a8055f57",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "A fault or interruption in a stratum."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71d0510b-b99b-3c2b-b510-6b9d54939824",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "Wife. Clipping of trouble and strife."
                                        ],
                                        "tags": [
                                            "Cockney",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64ababde-7d25-33ca-a24a-fdc968d39a58",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "An unplanned, unwanted or undesired pregnancy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06a59960-b179-4f8f-9268-9af15c11fd5b",
                                                "sense_id": "64ababde-7d25-33ca-a24a-fdc968d39a58",
                                                "text": "I never had schoolin’ but he taught me well / With his smooth southern style / Three months later I’m a gal in trouble / And I haven’t seen him for a while."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trouble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06f2ff48-1a7f-31ca-9e4c-168248eb2ec6",
                                        "entry_id": "b00b633b-9353-3e9a-ae9c-b09b930c9b93",
                                        "glosses": [
                                            "To disturb, stir up, agitate (a medium, especially water)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b67239e6-c5a0-454e-87ea-e84ef37f2dc8",
                                                "sense_id": "06f2ff48-1a7f-31ca-9e4c-168248eb2ec6",
                                                "text": "For an Angel went downe at a certaine season into the poole, and troubled the water:"
                                            },
                                            {
                                                "example_id": "46893886-b506-4544-b4a3-a626f05786bf",
                                                "sense_id": "06f2ff48-1a7f-31ca-9e4c-168248eb2ec6",
                                                "text": "God looking forth will trouble all his Hoſt"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "642d4867-c917-3d69-aa7d-7449a0558087",
                                        "entry_id": "b00b633b-9353-3e9a-ae9c-b09b930c9b93",
                                        "glosses": [
                                            "To mentally distress; to cause (someone) to be anxious or perplexed."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2165064-ea82-4050-87ed-19d4ed379afe",
                                                "sense_id": "642d4867-c917-3d69-aa7d-7449a0558087",
                                                "text": "What she said about narcissism is troubling me."
                                            },
                                            {
                                                "example_id": "e5e81e96-ecfa-4dea-a6fe-5e4ca4c02e26",
                                                "sense_id": "642d4867-c917-3d69-aa7d-7449a0558087",
                                                "text": "Now is my soule troubled, and what shall I say? Father, saue me from this houre, but for this cause came I vnto this houre."
                                            },
                                            {
                                                "example_id": "7cbb1db7-5d1d-41da-ad9a-72a66ab9396d",
                                                "sense_id": "642d4867-c917-3d69-aa7d-7449a0558087",
                                                "text": "Take the Boy to you: he ſo troubles me, / ’Tis paſt enduring."
                                            },
                                            {
                                                "example_id": "710c1080-3697-43e1-9c75-80a0c56cab06",
                                                "sense_id": "642d4867-c917-3d69-aa7d-7449a0558087",
                                                "text": "Never trouble your ſelf about thoſe Faults in them, which you know Age will cure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8e913cd-4459-379f-998a-a382bd2d068f",
                                        "entry_id": "b00b633b-9353-3e9a-ae9c-b09b930c9b93",
                                        "glosses": [
                                            "In weaker sense: to bother or inconvenience."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17b411be-c2d4-47f3-9a3e-99419ff0f8b1",
                                                "sense_id": "c8e913cd-4459-379f-998a-a382bd2d068f",
                                                "text": "I will not trouble you to deliver the letter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faf8e2bf-8d97-3dcb-9ad7-fa8520c7eff8",
                                        "entry_id": "b00b633b-9353-3e9a-ae9c-b09b930c9b93",
                                        "glosses": [
                                            "To physically afflict."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "075c77cc-b7ee-46b5-8154-2ed76a349ad1",
                                                "sense_id": "faf8e2bf-8d97-3dcb-9ad7-fa8520c7eff8",
                                                "text": "My bad knee is troubling me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3819e1fe-2a80-3370-975c-63fc5ef6adcc",
                                        "entry_id": "b00b633b-9353-3e9a-ae9c-b09b930c9b93",
                                        "glosses": [
                                            "To take pains (to do something); to bother."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e7f3359-4a3c-4c3f-a32c-e81eae9f1738",
                                                "sense_id": "3819e1fe-2a80-3370-975c-63fc5ef6adcc",
                                                "text": "I won’t trouble to post the letter today; I can do it tomorrow."
                                            },
                                            {
                                                "example_id": "f982c625-8573-49a6-b933-cc10d9deda35",
                                                "sense_id": "3819e1fe-2a80-3370-975c-63fc5ef6adcc",
                                                "text": "« The hut’s not very tidy, if you don’t mind, » he said. « I cleared it what I could. » / « But I didn’t want you to trouble! » she said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd2d46d2-2168-3d86-8501-f682cabac42c",
                                        "entry_id": "b00b633b-9353-3e9a-ae9c-b09b930c9b93",
                                        "glosses": [
                                            "To worry; to be anxious."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "621cb181-502d-4f35-b609-86cfb8ce9f07",
                                                "sense_id": "bd2d46d2-2168-3d86-8501-f682cabac42c",
                                                "text": "Why trouble about the future? It is wholly uncertain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
