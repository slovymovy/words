        "de-extract.jsonl": [
            {
                "entry_id": "6515175c-b2a8-3c20-83dc-f83ff8ea6620",
                "word": "öfters",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "944178e5-449c-3efa-912c-4910e1808b3c",
                        "entry_id": "6515175c-b2a8-3c20-83dc-f83ff8ea6620",
                        "glosses": [
                            "zu mehreren unbestimmten, regelmäßigen oder unregelmäßigen Zeitpunkten oder Zeitabschnitten"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "fe343264-5ff2-44ce-a5f6-139fe971a3e5",
                                "sense_id": "944178e5-449c-3efa-912c-4910e1808b3c",
                                "text": "Die Telefonverbindung brach öfters zusammen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34f076d7-c0c7-405e-9157-f833af431466",
                        "source_entry_id": "6515175c-b2a8-3c20-83dc-f83ff8ea6620",
                        "source_sense_id": "944178e5-449c-3efa-912c-4910e1808b3c",
                        "target_lang_word": "occasionally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "occasionally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d086e2d3-62f1-318d-8c53-f606710c8b13",
                                        "entry_id": "3e0a289b-2974-372c-83af-d03c55ae6573",
                                        "glosses": [
                                            "On occasion: at relatively infrequent intervals, from time to time, sometimes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eed73f00-8922-4017-88fc-32b4e915255b",
                                                "sense_id": "d086e2d3-62f1-318d-8c53-f606710c8b13",
                                                "text": "God ſetteth no houres for the morning or evening ſacrifice because they may occaſionally be changed."
                                            },
                                            {
                                                "example_id": "fc991f2b-3843-4a79-a918-92fc3b31b9ad",
                                                "sense_id": "d086e2d3-62f1-318d-8c53-f606710c8b13",
                                                "text": "Some perhaps worship only on alternate Sundays; others still more occasionally."
                                            },
                                            {
                                                "example_id": "5a09775f-ee1d-4146-858f-d9b1aac73887",
                                                "sense_id": "d086e2d3-62f1-318d-8c53-f606710c8b13",
                                                "text": "The journal, more occasionally, has turned to what might be called \"fashionable\" themes."
                                            },
                                            {
                                                "example_id": "e8260d65-b74b-4b5d-86af-1dadde51a4e9",
                                                "sense_id": "d086e2d3-62f1-318d-8c53-f606710c8b13",
                                                "text": "Flames could still be seen from town flaring up occasionally on a hill dotted with emergency vehicles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e817f47f-d546-3bd2-b96d-9911dc42f4c2",
                                        "entry_id": "3e0a289b-2974-372c-83af-d03c55ae6573",
                                        "glosses": [
                                            "On an occasion, accidentally, by chance."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7623644-740c-4170-8311-83fb1dc1d47d",
                                                "sense_id": "e817f47f-d546-3bd2-b96d-9911dc42f4c2",
                                                "text": "I had met Lord Ossory in the forenoon, who had come to town occasionally."
                                            },
                                            {
                                                "example_id": "0293cd6f-06fd-4510-a8ea-937c20b246c6",
                                                "sense_id": "e817f47f-d546-3bd2-b96d-9911dc42f4c2",
                                                "text": "Mr Tourville occasionally told his age; just turned of thirty-one."
                                            },
                                            {
                                                "example_id": "4da95638-8879-4d05-b2fc-392fa04eb634",
                                                "sense_id": "e817f47f-d546-3bd2-b96d-9911dc42f4c2",
                                                "text": "[N]othing gave him so much joy in conversation, as an opportunity of giving the company to understand, how well he was with persons of distinguished rank and character: he would often (for example) observe, as it were occasionally, that the duke of G— was one of the best natured men in the world […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3076add-7819-38a4-a430-badf5deafa1c",
                                        "entry_id": "3e0a289b-2974-372c-83af-d03c55ae6573",
                                        "glosses": [
                                            "On the occasion of something else happening; incidentally, by the way."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3c26434-ddb6-4381-96ce-05b09c39ec68",
                                                "sense_id": "d3076add-7819-38a4-a430-badf5deafa1c",
                                                "text": "Were nothing els diſcourſively inſerted (as ſome little elſe occaſionally preſented it ſelfe), what paper more currently fit for the bareſt mechanicall uſes, [...]"
                                            },
                                            {
                                                "example_id": "a9c1fc6f-41d8-4873-b060-fde5d291bf8d",
                                                "sense_id": "d3076add-7819-38a4-a430-badf5deafa1c",
                                                "text": "I think it is plain, that Origen, whatever Character he may have occaſionally given of this Book, did not judge it any part of the Canon..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db457c4a-eb63-4a73-a587-4439c83e85c4",
                        "source_entry_id": "6515175c-b2a8-3c20-83dc-f83ff8ea6620",
                        "source_sense_id": "944178e5-449c-3efa-912c-4910e1808b3c",
                        "target_lang_word": "often",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "often",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99f25ecb-71e8-3eec-a505-e818a1b8e54d",
                                        "entry_id": "6a9a5486-8764-343c-8fea-b30379c39b83",
                                        "glosses": [
                                            "Frequently; many times on different occasions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75b74c3-9bba-4e2a-9ff4-dcfee6482334",
                                                "sense_id": "99f25ecb-71e8-3eec-a505-e818a1b8e54d",
                                                "text": "I often walk to work when the weather is nice."
                                            },
                                            {
                                                "example_id": "891f7bb6-1220-42c3-8e4f-9bc6a14868de",
                                                "sense_id": "99f25ecb-71e8-3eec-a505-e818a1b8e54d",
                                                "text": "I’ve been going to the movies more often since a new theatre opened near me."
                                            },
                                            {
                                                "example_id": "d1e86e34-7e48-4d22-a4b7-03befeceb5b7",
                                                "sense_id": "99f25ecb-71e8-3eec-a505-e818a1b8e54d",
                                                "text": "It can't be said too often / often enough."
                                            },
                                            {
                                                "example_id": "ae708599-8fde-47cc-b31a-17b4146181bf",
                                                "sense_id": "99f25ecb-71e8-3eec-a505-e818a1b8e54d",
                                                "text": "☞ This word [wrap] is often pronounced wrop, rhyming with top, even by ſpeakers much above the vulgar."
                                            },
                                            {
                                                "example_id": "f1a10b1b-f1de-4946-b27a-220b454787b2",
                                                "sense_id": "99f25ecb-71e8-3eec-a505-e818a1b8e54d",
                                                "text": "How often is the comfort of a whole family abridged by some trifling circumstance, that ought not to have made a visible impression!"
                                            },
                                            {
                                                "example_id": "1062f540-1f8c-415c-9dec-ebe52002dfb7",
                                                "sense_id": "99f25ecb-71e8-3eec-a505-e818a1b8e54d",
                                                "text": "Although frogs are able to swim well and often are found in water, they are really land animals."
                                            },
                                            {
                                                "example_id": "4e188a08-06d1-4385-96a5-54b71d296ded",
                                                "sense_id": "99f25ecb-71e8-3eec-a505-e818a1b8e54d",
                                                "text": "According to this saga of intellectual-property misanthropy, these creatures [patent trolls] roam the business world, buying up patents and then using them to demand extravagant payouts from companies they accuse of infringing them. Often, their victims pay up rather than face the costs of a legal battle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "often",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5992fbc-0280-348f-8d3b-bc7fa5101526",
                                        "entry_id": "f9ea9e1e-cb80-355c-832e-26593d623329",
                                        "glosses": [
                                            "Frequent."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f195f0e-41e5-41cc-9ba6-7426de86b370",
                                                "sense_id": "e5992fbc-0280-348f-8d3b-bc7fa5101526",
                                                "text": "[…] it is a melancholy of mine own, compounded of many simples, extracted from many objects, and, indeed, the sundry contemplation of my travels; in which my often rumination wraps me in a most humorous sadness."
                                            },
                                            {
                                                "example_id": "5640b4e7-2f1b-4345-b2ef-15dc6324bd85",
                                                "sense_id": "e5992fbc-0280-348f-8d3b-bc7fa5101526",
                                                "text": "1618, Anthony Munday (translator), The Third Booke of Amadis de Gaule by Nicolas de Herberay des Essarts (1542), London, Chapter 2, p. 18,\nThen came the Ladies to visite him, and the Queene gaue him most gracious welcome, desiring him to be of good cheere: For heere is my Daughter (quoth she) right skilfull in the Art of Chirurgerie, that meanes to bee your often visitant."
                                            },
                                            {
                                                "example_id": "00347800-76f7-4c50-a4d0-86f3365b71e7",
                                                "sense_id": "e5992fbc-0280-348f-8d3b-bc7fa5101526",
                                                "text": "The Shew-bread by an often remove, and renewing, was continually to stand before the Lord in his House […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eae00fcc-6124-4d78-9cfc-f83aa7112af5",
                        "source_entry_id": "6515175c-b2a8-3c20-83dc-f83ff8ea6620",
                        "source_sense_id": "944178e5-449c-3efa-912c-4910e1808b3c",
                        "target_lang_word": "frequently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frequently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf31fa05-c760-3fe3-af2f-9b4406ba52ea",
                                        "entry_id": "147c8883-60da-3ebc-86f5-3bccbb2b31a1",
                                        "glosses": [
                                            "At frequent intervals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "377fb6f5-64d9-48ea-bfda-815c714cee99",
                                                "sense_id": "bf31fa05-c760-3fe3-af2f-9b4406ba52ea",
                                                "text": "This question arises frequently."
                                            },
                                            {
                                                "example_id": "eca12a86-8d82-47ff-8213-8949223fa997",
                                                "sense_id": "bf31fa05-c760-3fe3-af2f-9b4406ba52ea",
                                                "text": "He was enrolled but frequently didn't attend class."
                                            },
                                            {
                                                "example_id": "4b6e8b40-a8f8-495c-9533-7f5fcf4d9871",
                                                "sense_id": "bf31fa05-c760-3fe3-af2f-9b4406ba52ea",
                                                "text": "As we age, the major arteries of our bodies frequently become thickened with plaque, a fatty material with an oatmeal-like consistency that builds up along the inner lining of blood vessels. The reason plaque forms isn’t entirely known, but it seems to be related to high levels of cholesterol inducing an inflammatory response, which can also attract and trap more cellular debris over time."
                                            },
                                            {
                                                "example_id": "b23e3bae-3174-42b2-a5c5-7ca5dcc2b7af",
                                                "sense_id": "bf31fa05-c760-3fe3-af2f-9b4406ba52ea",
                                                "text": "The NFA has been a flashpoint for advocates, who say that silencers are not frequently used in crime and believe that the silencers and other weapons regulated under the law, including machine guns and short-barreled rifles and shotguns, are protected by the Second Amendment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7463657e-0f19-332a-8bca-d3652364ac66",
                                        "entry_id": "147c8883-60da-3ebc-86f5-3bccbb2b31a1",
                                        "glosses": [
                                            "For infinitely many terms of the sequence."
                                        ],
                                        "tags": [
                                            "of a sequence"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "711fc317-ffaf-4982-9845-9947c9956e84",
                        "source_entry_id": "6515175c-b2a8-3c20-83dc-f83ff8ea6620",
