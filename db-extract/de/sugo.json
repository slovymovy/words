                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f62cdd0-af8d-3051-811c-c7473d8b3d06",
                                        "entry_id": "f6b4cd3b-541c-3e64-94cc-4765cc3bde67",
                                        "glosses": [
                                            "A liquid (often thickened) condiment or accompaniment to food."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6eea1949-f3aa-43d1-ac6b-e0a94214ef32",
                                                "sense_id": "3f62cdd0-af8d-3051-811c-c7473d8b3d06",
                                                "text": "You could just use ordinary shop-bought kecap manis to marinade the meat, but making your own is easy, has a far more elegant fragrance and is, above all, such a great brag! Flavouring kecap manis is an intensely personal thing, so try this version now and next time cook the sauce down with crushed, split lemongrass and a shredded lime leaf."
                                            },
                                            {
                                                "example_id": "39f61ad6-5572-48f4-a754-aa2ef1ab55da",
                                                "sense_id": "3f62cdd0-af8d-3051-811c-c7473d8b3d06",
                                                "text": "apple sauce; mint sauce"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2667598-c49d-3089-9f7e-c73d3db67279",
                                        "entry_id": "f6b4cd3b-541c-3e64-94cc-4765cc3bde67",
                                        "glosses": [
                                            "Tomato sauce (similar to US tomato ketchup), as in"
                                        ],
                                        "tags": [
                                            "Australia",
                                            "India",
                                            "New-Zealand",
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b2580f2-0fcb-42ae-9cfd-26fe5dc17f83",
                                                "sense_id": "a2667598-c49d-3089-9f7e-c73d3db67279",
                                                "text": "[meat] pie and [tomato] sauce"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b45b66b-cf3b-3fde-a213-18e8a309f1c3",
                                        "entry_id": "f6b4cd3b-541c-3e64-94cc-4765cc3bde67",
                                        "glosses": [
                                            "Alcohol, booze."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "effb575c-3b9c-4196-ad19-640ba54e1be1",
                                                "sense_id": "2b45b66b-cf3b-3fde-a213-18e8a309f1c3",
                                                "text": "Maybe you should lay off the sauce."
                                            },
                                            {
                                                "example_id": "e157f9b8-a6f5-44c4-a673-a0bc48b2919b",
                                                "sense_id": "2b45b66b-cf3b-3fde-a213-18e8a309f1c3",
                                                "text": "[…] she was thinking of her first husband, who was a heel to end all heels and a constant pain in the neck to her till one night he most fortunately walked into the River Thames while under the influence of the sauce and didn't come up for days."
                                            },
                                            {
                                                "example_id": "3e369afd-d142-4121-b6f2-276a86e2c487",
                                                "sense_id": "2b45b66b-cf3b-3fde-a213-18e8a309f1c3",
                                                "text": "I've been pretty much off the sauce during the last week, trying to get Pepper to like me again. (Horace won't drink with me any more.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6667a026-d57f-36b6-a64e-dca9995bdc34",
                                        "entry_id": "f6b4cd3b-541c-3e64-94cc-4765cc3bde67",
                                        "glosses": [
                                            "Vitality; capability or talent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "050cf4bd-325b-4627-a35d-06e66b5f912b",
                                                "sense_id": "6667a026-d57f-36b6-a64e-dca9995bdc34",
                                                "text": "It's over for that guy. He lost the sauce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c440c26f-91df-3e2e-9635-ffb38e8cdb4c",
                                        "entry_id": "f6b4cd3b-541c-3e64-94cc-4765cc3bde67",
                                        "glosses": [
                                            "Anabolic steroids."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43e835b0-19a3-30ee-b8e3-fe7ab5412510",
                                        "entry_id": "f6b4cd3b-541c-3e64-94cc-4765cc3bde67",
                                        "glosses": [
                                            "A soft crayon for use in stump drawing or in shading with the stump."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac967592-21f5-323f-ae06-fa41e8a102cf",
                                        "entry_id": "f6b4cd3b-541c-3e64-94cc-4765cc3bde67",
                                        "glosses": [
                                            "Cheek; impertinence; backtalk; sass."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "353c4d52-307f-402c-863c-f176b9f26f57",
                                                "sense_id": "ac967592-21f5-323f-ae06-fa41e8a102cf",
                                                "text": "\"See here, Captain!\" He planted himself squarely in front of Faramir, his hands on his hips, and a look on his face as if he was addressing a young hobbit who had offered him what he called \"sauce\" when questioned about visiting the orchard."
                                            },
                                            {
                                                "example_id": "fc02ecb9-d6c8-4d22-aeea-5cb9fbe31146",
                                                "sense_id": "ac967592-21f5-323f-ae06-fa41e8a102cf",
                                                "text": "‘Well, you know what Matchett’s like! Just about bring herself to talk to me because I’m housemaid, but if the gardener’s boy so much as looks at ’er it’s sauce,’ said Sarah."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52c7a092-2b44-38df-8a52-0299e3cbb5e6",
                                        "entry_id": "f6b4cd3b-541c-3e64-94cc-4765cc3bde67",
                                        "glosses": [
                                            "Vegetables."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23e30406-5101-41a3-ad0e-29712e8d8918",
                                                "sense_id": "52c7a092-2b44-38df-8a52-0299e3cbb5e6",
                                                "text": "I wanted cabbage or potaters, or most any sort o' garden sarse [...]"
                                            },
                                            {
                                                "example_id": "d6e20053-495d-49d2-afc8-0068b40a75d2",
                                                "sense_id": "52c7a092-2b44-38df-8a52-0299e3cbb5e6",
                                                "text": "[...] and all would be well only for a remark of a little boy who, when asked if he will have some more of the sauce, says he \"don't want no strawberries pickled in kerosene.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04e7e1ff-248c-3dac-8b19-e29c300270a2",
                                        "entry_id": "f6b4cd3b-541c-3e64-94cc-4765cc3bde67",
                                        "glosses": [
                                            "Any garden vegetables eaten with meat."
                                        ],
                                        "tags": [
                                            "UK",
                                            "US",
                                            "countable",
                                            "dialectal",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c1f3964-3039-48ae-ac72-939d2da49b4f",
                                                "sense_id": "04e7e1ff-248c-3dac-8b19-e29c300270a2",
                                                "text": "Roots, herbs, vine fruits, and salad flowers […] they dish up various ways, and find them very delicious sauce to their meats, both roasted and boiled, fresh and salt."
                                            },
                                            {
                                                "example_id": "dece5e53-fcca-4b46-9362-8dfdd1884f4d",
                                                "sense_id": "04e7e1ff-248c-3dac-8b19-e29c300270a2",
                                                "text": "The first night of our expedition, we boiled our meat; and I asked the landlady for a little sauce, she told me to go to the garden and take as much cabbage as I pleased, and that, boiled with the meat, was all we could eat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sauce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9ca22c7-d486-388c-82dc-950a8a2d98d6",
                                        "entry_id": "f09e78ce-40a2-3575-a443-f96d0e17aea7",
                                        "glosses": [
                                            "To add sauce to; to season."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24b57923-3fa2-30d2-a218-f01c071edfe0",
                                        "entry_id": "f09e78ce-40a2-3575-a443-f96d0e17aea7",
                                        "glosses": [
                                            "To cause to relish anything, as if with a sauce; to tickle or gratify, as the palate; to please; to stimulate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddcc0aab-98fa-4200-b4ed-e3440f584fc3",
                                                "sense_id": "24b57923-3fa2-30d2-a218-f01c071edfe0",
                                                "text": "Earth, yield me roots; / Who seeks for better of thee, sauce his palate / With thy most operant poison!"
                                            },
                                            {
                                                "example_id": "ad4f6d5b-26ac-4953-8e85-85af7b498e8c",
                                                "sense_id": "24b57923-3fa2-30d2-a218-f01c071edfe0",
                                                "text": "Meales, uſually ſavvced vvith a healthfull hunger, vvherein no incocted Crudities oppreſſe Nature, and cheriſh diſeaſe: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c99048e2-82f9-3179-8a46-decb5ee2c8f6",
                                        "entry_id": "f09e78ce-40a2-3575-a443-f96d0e17aea7",
                                        "glosses": [
                                            "To make poignant; to give zest, flavour or interest to; to set off; to vary and render attractive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a2c8123-2262-4220-9bb1-6f0e67b5aef8",
                                                "sense_id": "c99048e2-82f9-3179-8a46-decb5ee2c8f6",
                                                "text": "Then fell she to sauce her desires with threatenings.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cec3eb5c-55ba-3f56-87a0-cd93fd547a23",
                                        "entry_id": "f09e78ce-40a2-3575-a443-f96d0e17aea7",
                                        "glosses": [
                                            "To treat with bitter, pert, or tart language; to be impudent or saucy to."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "251d0dce-0720-4e5e-bc96-52fa668cc1dc",
                                                "sense_id": "cec3eb5c-55ba-3f56-87a0-cd93fd547a23",
                                                "text": "I'll sauce her with bitter words."
                                            },
                                            {
                                                "example_id": "d44ebb75-f86c-4343-b08c-975ab3f7532a",
                                                "sense_id": "cec3eb5c-55ba-3f56-87a0-cd93fd547a23",
                                                "text": "\"A bit of real starvin' would do them no 'arm, and I would 'ave less sauce.\" \"What, has Willie sauced you?\" \"Yes, when 'e woke up.\" […] \"Wot did he say?\" \"Cursed me good and proper, 'e did.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "423c1a94-73ae-30ec-8094-64b2dcb1e614",
                                        "entry_id": "f09e78ce-40a2-3575-a443-f96d0e17aea7",
                                        "glosses": [
                                            "To send or hand over."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
