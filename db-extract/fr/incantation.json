                                    {
                                        "sense_id": "cc5fc172-c046-34a3-a2d4-bc6e54222d8c",
                                        "entry_id": "fe042d45-01cd-37d2-8ac9-ea193f961542",
                                        "glosses": [
                                            "Een stellige belofte. Die men lang niet altijd waar kan maken."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38c583fa-7040-4817-9d0a-78ff2923a6b3",
                                                "sense_id": "cc5fc172-c046-34a3-a2d4-bc6e54222d8c",
                                                "text": "Die bezwering was een van de redenen dat hij liever in een eenvoudig ongeverfd houten huis bij de bouw was gaan wonen dan bij de andere ingenieurs in het Centralhotellet in Kramfors, hij wilde in de buurt van het gedreun van de heimachine zijn wanneer de boomstammen in de bodem van de rivier werden gedreven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ced59efb-d8cd-3540-ae30-7ed1ba990001",
                                        "entry_id": "fe042d45-01cd-37d2-8ac9-ea193f961542",
                                        "glosses": [
                                            "geestenuitbanning"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b9c7220-e006-4677-b2f9-935193abbe9f",
                                                "sense_id": "ced59efb-d8cd-3540-ae30-7ed1ba990001",
                                                "text": "Bezweren, bespreken of belezen is letterlijk een bovennatuurlijke macht uitoefenen door iets voor te lezen, vaak uit een heilig geschrift, of door het lezen van bezweringsspreuken, waardoor boze geesten verdreven worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
