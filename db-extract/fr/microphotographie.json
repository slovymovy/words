                "senses": [
                    {
                        "sense_id": "9c5d916b-7b03-3c6b-8228-cf4bfbf2c279",
                        "entry_id": "e9f480d5-7ee9-3710-aee3-7c8845a4c5d5",
                        "glosses": [
                            "Technique consistant à réaliser des images à échelle très réduite de documents pour les transférer sur microfilm ou microfiches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a62ceaa-ec38-497a-a291-79c44f63bf15",
                                "sense_id": "9c5d916b-7b03-3c6b-8228-cf4bfbf2c279",
                                "text": "C'est alors due Franklin demande à Claudius de monter un service de microphotographie, […]. Il s'agit de réduire son volume et son poids, lesquels lui font courir de gros risques de transport."
                            }
                        ]
                    },
                    {
                        "sense_id": "013502f4-73e0-38eb-b67c-dcd96847689e",
                        "entry_id": "e9f480d5-7ee9-3710-aee3-7c8845a4c5d5",
                        "glosses": [
                            "Technique photographique à l’aide de la microscopie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a6f849bd-3d1d-346b-b61b-4ce3aa976b8a",
                        "entry_id": "e9f480d5-7ee9-3710-aee3-7c8845a4c5d5",
                        "glosses": [
                            "Photographie, image faite à l’aide de la microscopie."
                        ],
                        "tags": [],
                        "examples": [
                            {
