                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79e5cf77-3576-4e33-8e83-1f1dc452dcd1",
                                                "sense_id": "589ebc81-8645-31c1-872b-7662716d42c8",
                                                "text": "She smelled the newly budding flowers."
                                            },
                                            {
                                                "example_id": "0816047c-0363-45ef-91f4-70b60e902495",
                                                "sense_id": "589ebc81-8645-31c1-872b-7662716d42c8",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9bbf8ce-0c00-4202-8dbb-dbad915ea776",
