                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "751a7d49-6cfc-399a-a858-ff4c0b5ecdf2",
                                        "entry_id": "60c0ceca-9d06-368e-b31e-c82b63de982d",
                                        "glosses": [
                                            "een van de lichtpunten aan de nachtelijke hemel die maar heel traag van plaats lijken te veranderen, feitelijk een enorm ver verwijderde gasbol die licht uitzendt door kernfusie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d46a109-9650-4ad7-abcd-ea9e4a097baf",
                                                "sense_id": "751a7d49-6cfc-399a-a858-ff4c0b5ecdf2",
                                                "text": "Een zwart gat ontstaat doorgaans als een zware ster aan het einde van zijn leven komt en explodeert als supernova."
                                            },
                                            {
                                                "example_id": "e57337b0-f7c5-4df1-a0a2-b68f53e3859e",
                                                "sense_id": "751a7d49-6cfc-399a-a858-ff4c0b5ecdf2",
                                                "text": "Ik wilde met mijn hele hebben en houden op mijn rug in de overweldigende wildernis van Amerika slapen onder de sterren, nieuwe mensen ontmoeten, alleen met mijn gedachten door de bossen lopen en de vrijheid hebben om te gaan en te staan waar ik wilde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73220db8-2c97-356a-8b70-db09f50881ff",
                                        "entry_id": "60c0ceca-9d06-368e-b31e-c82b63de982d",
                                        "glosses": [
                                            "iemand die positief bekend staat dankzij buitengewone prestaties"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fbdfd9a-9653-4386-9448-8b375c2a0a09",
                                                "sense_id": "73220db8-2c97-356a-8b70-db09f50881ff",
                                                "text": "'Hoe voelt het om een grote ster in Parijs te zijn?' 'Wat bedoelt u met ster?' 'Nou, dat iedereen het over u heeft."
                                            },
                                            {
