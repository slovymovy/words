{
    "word_family": [
        "Welshman",
        "Welshwoman",
        "Welshness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d311c3a7-0f16-322d-b8fe-a5392d76ae31",
                    "sense_definition": "Relating to Wales, its people, their culture, or the Welsh language.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "adj_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather loves traditional <w>Welsh</w> music.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка любит традиционную <w>валлийскую</w> музыку.",
                                "zh": "我祖父很喜欢传统的<w>威尔士</w>音乐。"
                            }
                        },
                        {
                            "text": "We spent our holiday in a small <w>Welsh</w> village.",
                            "target_lang_translations": {
                                "ru": "Мы провели отпуск в маленькой <w>валлийской</w> деревне.",
                                "zh": "我们在一个小的<w>威尔士</w>村庄度过了假期。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Cymric"
                    ],
                    "common_phrases": [
                        "Welsh rarebit",
                        "Welsh dragon",
                        "Welsh cake",
                        "Welsh pony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Уэльсу, его народу, культуре или валлийскому языку.",
                        "zh": "与威尔士、其人民、文化或威尔士语有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "валлийский",
                                "target_lang_sense_clarification": "относящийся к Уэльсу"
                            },
                            {
                                "target_lang_word": "уэльский",
                                "target_lang_sense_clarification": "вариант названия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "威尔士的",
                                "target_lang_sense_clarification": "形容词，指代威尔士相关事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7696c78d-e267-3be3-9763-ab3957a1cf7b",
                    "sense_definition": "Relating to the Celtic peoples who lived in Britain before the Roman occupation; indigenously British.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "adj_historical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historians study the <w>Welsh</w> tribes that resisted the invasion.",
                            "target_lang_translations": {
                                "ru": "Историки изучают <w>валлийские</w> племена, сопротивлявшиеся вторжению.",
                                "zh": "历史学家们研究那些抵抗入侵的<w>威尔士</w>部落。"
                            }
                        },
                        {
                            "text": "The text describes ancient <w>Welsh</w> kings of the region.",
                            "target_lang_translations": {
                                "ru": "В тексте описываются древние <w>валлийские</w> короли этого региона.",
                                "zh": "文中描述了该地区古代的<w>威尔士</w>国王。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Cymric"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к кельтским народам, жившим в Британии до римского завоевания; коренной британский.",
                        "zh": "指罗马占领前居住在不列颠的凯尔特民族；原住民。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "валлийский",
                                "target_lang_sense_clarification": "исторический контекст"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "威尔士的",
                                "target_lang_sense_clarification": "历史语境下的称呼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cb93be98-48c3-3e3b-80de-4980ed3f0bd9",
                    "sense_definition": "The Celtic language spoken in Wales.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_lang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is learning to speak <w>Welsh</w> fluently.",
                            "target_lang_translations": {
                                "ru": "Она учится бегло говорить на <w>валлийском</w>.",
                                "zh": "她正在学习流利地说<w>威尔士语</w>。"
                            }
                        },
                        {
                            "text": "All the road signs are written in both English and <w>Welsh</w>.",
                            "target_lang_translations": {
                                "ru": "Все дорожные знаки написаны на английском и <w>валлийском</w>.",
                                "zh": "所有的路标都用英语和<w>威尔士语</w>书写。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Cymraeg",
                        "Cymric"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кельтский язык, на котором говорят в Уэльсе.",
                        "zh": "在威尔士使用的凯尔特语言。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "валлийский язык",
                                "target_lang_sense_clarification": "язык"
                            },
                            {
                                "target_lang_word": "валлийский",
                                "target_lang_sense_clarification": "субстантивированное прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "威尔士语",
                                "target_lang_sense_clarification": "语言名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19d8f3c2-b78c-31ba-91af-c52e695c90ba",
                    "sense_definition": "The people who inhabit or originate from Wales, considered collectively.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Welsh</w> are famous for their male voice choirs.",
                            "target_lang_translations": {
                                "ru": "<w>Валлийцы</w> славятся своими мужскими хорами.",
                                "zh": "<w>威尔士人</w>以他们的男声合唱团而闻名。"
                            }
                        },
                        {
                            "text": "Rugby is a sport that unites the <w>Welsh</w>.",
                            "target_lang_translations": {
                                "ru": "Регби — это вид спорта, который объединяет <w>валлийцев</w>.",
                                "zh": "橄榄球是一项能团结<w>威尔士人</w>的运动。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди, населяющие Уэльс или происходящие из него (как собирательное понятие).",
                        "zh": "居住在威尔士或原籍威尔士的人民（集合名词）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "валлийцы",
                                "target_lang_sense_clarification": "народ"
                            },
                            {
                                "target_lang_word": "уэльсцы",
                                "target_lang_sense_clarification": "народ (вариант)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "威尔士人",
                                "target_lang_sense_clarification": "指代该民族"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9bf5470-583e-39ba-a2e8-5e0b8c92d3b5",
                    "sense_definition": "To cheat someone by failing to pay a debt or to break a promise.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_cheat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>welshed</w> on the bet after his team lost the game.",
                            "target_lang_translations": {
                                "ru": "Он <w>не выплатил</w> ставку после того, как его команда проиграла игру.",
                                "zh": "他的球队输掉比赛后，他<w>赖掉</w>了赌注。"
                            }
                        },
                        {
                            "text": "I trust him because he has never <w>welshed</w> on a deal.",
                            "target_lang_translations": {
                                "ru": "Я доверяю ему, потому что он никогда не <w>обманывал</w> в сделке.",
                                "zh": "我信任他，因为他从没在交易中<w>食言</w>过。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "welsh on"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обмануть кого-то, не выплатив долг или нарушив обещание.",
                        "zh": "指通过不偿还债务或违背诺言来欺骗某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не выплатить",
                                "target_lang_sense_clarification": "долг, проигрыш"
                            },
                            {
                                "target_lang_word": "обмануть",
                                "target_lang_sense_clarification": "нарушить слово"
                            },
                            {
                                "target_lang_word": "кинуть",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赖账",
                                "target_lang_sense_clarification": "指不履行债务"
                            },
                            {
                                "target_lang_word": "食言",
                                "target_lang_sense_clarification": "指违背诺言"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4dfe6a59-3219-3e10-96c3-a596cd64ed9e",
                    "sense_definition": "A surname of English, Scottish, or Irish origin.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "name_surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Welsh</w> teaches history at the local high school.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Уэлш</w> преподает историю в местной средней школе.",
                                "zh": "<w>威尔什</w>先生在当地高中教历史。"
                            }
                        },
                        {
                            "text": "I have an appointment with Dr. <w>Welsh</w> tomorrow.",
                            "target_lang_translations": {
                                "ru": "У меня завтра прием у доктора <w>Уэлша</w>.",
                                "zh": "我明天和<w>威尔什</w>医生有个预约。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия английского, шотландского или ирландского происхождения.",
                        "zh": "源自英国、苏格兰或爱尔兰的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уэлш",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "威尔什",
                                "target_lang_sense_clarification": "姓氏译名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69aa02ad-4667-3702-8217-fd36948cba04",
                    "sense_definition": "A town in Louisiana or a community in Ohio, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through the small town of <w>Welsh</w> on their road trip.",
                            "target_lang_translations": {
                                "ru": "Во время поездки они проехали через маленький городок <w>Уэлш</w>.",
                                "zh": "他们在公路旅行中开车穿过了<w>威尔什</w>小镇。"
                            }
                        },
                        {
                            "text": "My cousin lives near <w>Welsh</w> in Louisiana.",
                            "target_lang_translations": {
                                "ru": "Мой двоюродный брат живет недалеко от <w>Уэлша</w> в Луизиане.",
                                "zh": "我的表亲住在路易斯安那州的<w>威尔什</w>附近。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в штате Луизиана или община в штате Огайо, США.",
                        "zh": "美国路易斯安那州的一个城镇或俄亥俄州的一个社区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уэлш",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "威尔什",
                                "target_lang_sense_clarification": "地名译名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}