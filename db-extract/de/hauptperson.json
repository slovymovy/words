                "senses": [
                    {
                        "sense_id": "461de991-8cb1-3700-8cbc-6543b51a2f01",
                        "entry_id": "15e9c0a1-67c9-3eca-8c1f-83fddea4ec1d",
                        "glosses": [
                            "diejenige Person, die in einem bestimmten Kontext am wichtigsten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b41d011b-50cd-4243-add6-2216ad2f8379",
                                "sense_id": "461de991-8cb1-3700-8cbc-6543b51a2f01",
                                "text": "„Interessanterweise gibt es diesen Witz nicht nur mit Erich Honnecker als Hauptperson.“"
                            },
                            {
                                "example_id": "f5ac982b-f30b-45a1-920b-cb78863e2c3e",
                                "sense_id": "461de991-8cb1-3700-8cbc-6543b51a2f01",
                                "text": "„Alle saßen nach gewöhnlicher Indianerweise, ihre Schenkel ineinandergeflochten, in ihren Gürteln ihre Skalpiermesser und Tomahawks, ruhig die Erscheinung der Hauptpersonen abwartend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67abdaec-6956-4f11-b97b-49425dba0d1e",
                        "source_entry_id": "15e9c0a1-67c9-3eca-8c1f-83fddea4ec1d",
                        "source_sense_id": "461de991-8cb1-3700-8cbc-6543b51a2f01",
