                        "cross_references": [
                            {
                                "target_word": "documentatie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "847a8b8c-528a-3836-aec2-8560f29c07d9",
                                        "entry_id": "9770b7c7-de19-3bbf-87d4-7c5c600338c4",
                                        "glosses": [
                                            "geschreven materiaal dat een bepaald onderwerp om- en beschrijft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ff1cd1e-6e55-4fd7-8461-f33c9b758723",
                                                "sense_id": "847a8b8c-528a-3836-aec2-8560f29c07d9",
                                                "text": "De bedoeling van dit boek is hierbij behulpzaam te zijn. In de vele lees- en voorleesverhalen en de korte documentaties wordt iets van de oorsprong en de viering van onze jaarfeesten belicht."
                                            },
                                            {
                                                "example_id": "4f88dd3d-857b-4023-aca2-37ad26fc739c",
                                                "sense_id": "847a8b8c-528a-3836-aec2-8560f29c07d9",
                                                "text": "De documentatie van dit computerprogramma is uiterst verwarrend en weinig behulpzaam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aad06c01-b67c-4b5c-91e2-e674fec1b3f3",
                        "source_entry_id": "290e3cd1-754c-3af0-ad84-fb4eb1f92585",
                        "source_sense_description": "documents that explain the operation of a particular machine or software program",
                        "target_lang_word": "documentation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "documentation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbcf407a-8040-370f-8951-92269e0b6940",
                                        "entry_id": "95e4fd3a-5eaf-3dfe-9bb2-40aff84c2132",
                                        "glosses": [
                                            "Ensemble de documents recueillis sur une question."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b5437f2-d3ef-4e97-9b2a-f2ff74d4083e",
                                                "sense_id": "fbcf407a-8040-370f-8951-92269e0b6940",
                                                "text": "L’avantage de la profession d’instituteur sur beaucoup d’autres, c’est qu’elle met à la disposition de ceux qui la pratiquent un matériel de documentation géographique qui permet de se faire à domicile une idée précise du vaste monde. Le fondement national de cette connaissance était la série murale des cartes Vidal-Lablache, avec renfort toilé aux angles et sur les côtés."
                                            },
                                            {
                                                "example_id": "0c35cd3f-b4c5-4e48-8fd6-099b508672ec",
                                                "sense_id": "fbcf407a-8040-370f-8951-92269e0b6940",
                                                "text": "D'ailleurs Christian Jacq a déjà réfléchi à l’avenir de sa formidable documentation. « Je léguerai ma bibliothèque à condition qu’elle soit ouverte au public et pas réservée aux érudits. »"
                                            },
                                            {
                                                "example_id": "c71beac0-99b0-4302-b63f-629e74c30f04",
                                                "sense_id": "fbcf407a-8040-370f-8951-92269e0b6940",
                                                "text": "La documentation archéologique y est malheureusement très rare pour le Haut Moyen Age, le site de Larina à Hières-sur-Amby (Isère) constituant une heureuse exception."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b23de068-fd81-3d6a-a5fb-f95db754ac38",
                                        "entry_id": "95e4fd3a-5eaf-3dfe-9bb2-40aff84c2132",
                                        "glosses": [
                                            "Action de consulter des documents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60e47b21-994f-41c2-94e7-a05defe3d837",
                                                "sense_id": "b23de068-fd81-3d6a-a5fb-f95db754ac38",
                                                "text": "Centre de documentation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "180e4c65-4886-329c-a1c0-b8650ad99d71",
                                        "entry_id": "95e4fd3a-5eaf-3dfe-9bb2-40aff84c2132",
                                        "glosses": [
                                            "Document."
                                        ],
                                        "tags": [
                                            "plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86d133f4-6334-42bd-963c-8d15f0bdf413",
                                                "sense_id": "180e4c65-4886-329c-a1c0-b8650ad99d71",
                                                "text": "Dans la rédaction de vos fiches, si vous ne pouvez rencontrer aucune personne connaissant l’entreprise, vous avez souvent la possibilité de trouver des documentations sérieuses grâce à Internet. […] La plupart des grandes entreprises possèdent leur site Internet, mais elles diffusent aussi diverses documentations qui vous fourniront leurs bilans d’activités, orientations et autres organigrammes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
