                ],
                "senses": [
                    {
                        "sense_id": "50d40966-6daf-3e43-859f-f828d2ebbdbf",
                        "entry_id": "156e0cb5-dc90-3a17-afa9-e5d6d531c57a",
                        "glosses": [
                            "Person, die mit anderen das gleiche Schicksal teilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de3aba4e-dd1b-43ac-a50e-a0288b5fba9e",
                                "sense_id": "50d40966-6daf-3e43-859f-f828d2ebbdbf",
                                "text": "„Mit einem Presslufthammer musste er als Himmlers Sklave zusammen mit seinen Schicksalsgenossen kilometerlange Stollen in den Berg treiben und ausbauen, unter unmenschlichsten Bedingungen.“"
                            },
                            {
                                "example_id": "8709a536-6b76-4e56-ab33-67df4bbc894e",
                                "sense_id": "50d40966-6daf-3e43-859f-f828d2ebbdbf",
                                "text": "„Pierres Blicke fielen auf seine Schicksalsgenossen, und er musterte sie.“"
                            },
                            {
                                "example_id": "cd62ca10-fc50-45c2-af98-f3e294f60039",
                                "sense_id": "50d40966-6daf-3e43-859f-f828d2ebbdbf",
                                "text": "„Dort thronte er wie ein fremder Gesandter in einer ahnungslosen Sicherheit, unberührt von Störungen und frei von verhängnisvollen Gewalten, denen er, Katell, wie alle Schicksalsgenossen ausgesetzt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
