                                "target_senses": [
                                    {
                                        "sense_id": "3d93899f-eb9d-327e-9cc9-3fae6e1d1925",
                                        "entry_id": "641bf526-1abf-3cd6-a5f1-da25aa041da8",
                                        "glosses": [
                                            "In a rational manner"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a7a7f60-17ce-4852-84ac-358eb9e3e5a9",
                        "source_entry_id": "f2fb3aef-6944-356e-9244-06aa96b4c968",
                        "target_lang_word": "reasonably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reasonably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "253736cd-0609-35f8-956c-d2e52665ba99",
                                        "entry_id": "8fa0dee1-1b80-3ce3-8e86-084c49b7a18a",
                                        "glosses": [
                                            "In accordance with reason."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef52ff75-f51a-4b2a-808b-233966511607",
                                                "sense_id": "253736cd-0609-35f8-956c-d2e52665ba99",
                                                "text": "They were able handle their disagreements reasonably."
                                            },
                                            {
                                                "example_id": "28eace97-2410-4e35-8bc5-301083c9656b",
                                                "sense_id": "253736cd-0609-35f8-956c-d2e52665ba99",
                                                "text": "Nineteen Eighty-Four was written in 1949. Its nightmarish fictional world is now 37 years in the past, so one might reasonably conclude that Orwell was far too pessimistic, but his great book was less a prediction than a warning, and above all an analysis of the totalitarian mentality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f27e4d2b-0dc0-3309-8c95-3971e9d4f682",
                                        "entry_id": "8fa0dee1-1b80-3ce3-8e86-084c49b7a18a",
                                        "glosses": [
                                            "Fairly; satisfactorily; not extremely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "827776f2-d6c6-48e8-be3e-9aa6067ed23b",
                                                "sense_id": "f27e4d2b-0dc0-3309-8c95-3971e9d4f682",
                                                "text": "The shoes were reasonably priced."
                                            },
                                            {
                                                "example_id": "3e8c0047-9275-45c4-9bb0-328a7031a8da",
                                                "sense_id": "f27e4d2b-0dc0-3309-8c95-3971e9d4f682",
                                                "text": "Fanny said she would drive to Center Campobello, but Dubin in his laryngitic voice told her he was reasonably sure he could make it to her after another week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d47abd7-b0a9-33ef-9e42-571dd9bc644d",
                                        "entry_id": "8fa0dee1-1b80-3ce3-8e86-084c49b7a18a",
                                        "glosses": [
                                            "Quite; fairly; satisfactorily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3699f4c2-069f-4bc9-8ea2-b912fbcfc8b2",
                                                "sense_id": "0d47abd7-b0a9-33ef-9e42-571dd9bc644d",
                                                "text": "That car goes reasonably fast."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f803f411-e64c-4c3c-912a-cf5f85bf070c",
                        "source_entry_id": "f2fb3aef-6944-356e-9244-06aa96b4c968",
                        "target_lang_word": "sensibly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sensibly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f03c9ca5-ce1f-3bc0-bba4-751b1717a2ff",
                                        "entry_id": "0d04ac0c-03b3-3aed-b58b-0654077d7767",
                                        "glosses": [
                                            "In a sensible manner; in a way that shows good sense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16041be3-e7f3-40d0-bd68-3bbc7a55fc70",
                                                "sense_id": "f03c9ca5-ce1f-3bc0-bba4-751b1717a2ff",
                                                "text": "[...] but in the damp conditions prevailing the driver sensibly was unwilling to attempt the climb up through Combe Down tunnel without help, for fear of slipping to a standstill in the unventilated bore, [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebbeb148-4161-3ff4-8ab5-96d5e791ec47",
                                        "entry_id": "0d04ac0c-03b3-3aed-b58b-0654077d7767",
                                        "glosses": [
                                            "In a way that can be sensed or noticed; perceptibly."
                                        ],
                                        "tags": [
                                            "dated",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0535de8-566a-4ef8-9507-513557676fae",
                                                "sense_id": "ebbeb148-4161-3ff4-8ab5-96d5e791ec47",
                                                "text": "Time sensibly all things impairs."
                                            },
                                            {
                                                "example_id": "5d683efa-603e-400f-8e0d-c073cdabf9a6",
                                                "sense_id": "ebbeb148-4161-3ff4-8ab5-96d5e791ec47",
                                                "text": "This four months' lastingness would doubtless be sensibly reduced if the tent were subject to numerous transportations and repitchings."
                                            },
                                            {
                                                "example_id": "2c04e4d6-15fa-4162-83e6-4fd4e2b6752a",
                                                "sense_id": "ebbeb148-4161-3ff4-8ab5-96d5e791ec47",
                                                "text": "4. P. californicum n. sp.\nVery similar in color and sculpture to seriatum. The form is, however, sensibly narrower, averaging very nearly two and one half times as long as wide, while in seriatum the length is ahout two and three- tenths times the width."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52fd3c5b-299b-4735-9107-0ba57b6ad36f",
                        "source_entry_id": "f2fb3aef-6944-356e-9244-06aa96b4c968",
