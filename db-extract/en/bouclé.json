                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6a377f72-968c-4801-b6f7-5715a531d8a0",
                                "sense_id": "f8e56fe6-da7e-39c5-ac92-dd73fdda7cb4",
                                "text": "Argent’s Metropolitan line was a sound investment, with its chemically treated bouclé cushions and Airform core."
                            },
                            {
                                "example_id": "f0d8639d-9066-4094-994a-bc6f696a7886",
                                "sense_id": "f8e56fe6-da7e-39c5-ac92-dd73fdda7cb4",
                                "text": "He, too, showed up in style ahead of the game, wearing a custom bedazzled Amri combination of a bouclé shirt and matching shimmering trousers."
                            }
                        ]
                    },
                    {
                        "sense_id": "f78e57b0-c3a8-39a8-b0d3-dc21f707e3e2",
                        "entry_id": "e529ecb6-08c8-36c6-a707-e9c9c5adaf6a",
                        "glosses": [
                            "Yarn with multiple plies, one of which is looser than the others, producing loops and curls."
