                        "sense_id": "f1991c66-a4bd-3ecd-8f0f-8e6c4779eeb9",
                        "entry_id": "5d594420-f667-3438-befa-d829c560d187",
                        "glosses": [
                            "iemand die bij een evenement aanwezig"
