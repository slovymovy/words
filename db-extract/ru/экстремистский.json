                                        "glosses": [
                                            "A person who holds extreme views, especially one who advocates such views; a radical or fanatic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c05ac2d8-a5e8-410f-aa76-7a7124a32e06",
                                                "sense_id": "7f1c42bd-4011-3af1-9dd4-e3a44f412bfb",
                                                "text": "In Urif, extremists spray painted “Death to Arabs” on shipping containers belonging to a local resident and the local quarry was tagged with the words “Fight the enemy.”"
                                            }
                                        ]
                                    }
                                ]
                            },
