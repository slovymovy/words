                "senses": [
                    {
                        "sense_id": "ad2122e5-8563-3498-9b76-0589cfc15623",
                        "entry_id": "c38a8111-d285-3a2a-944d-318e6bc615dd",
                        "glosses": [
                            "alle maatregelen die erop gericht zijn niet teveel geld uit te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "912d24ba-d91f-44a3-95c3-27b6997e2398",
                                "sense_id": "ad2122e5-8563-3498-9b76-0589cfc15623",
                                "text": "Dat resultaat is met name terug te voeren op de aantrekkende economie, een hogere rijksbijdrage, een strakke kostenbeheersing en betere samenwerking met de deelnemende gemeenten Hengelo, Borne en Hof van Twente."
                            },
                            {
                                "example_id": "f5fd3862-fc0f-4bc5-b5e2-a6c1dcaa2a82",
                                "sense_id": "ad2122e5-8563-3498-9b76-0589cfc15623",
                                "text": "Toch denkt algemeen directeur Axel Fisher van Monaco Resources winstgevend te kunnen werken in Suriname. Een strakke kostenbeheersing moet daar voor zorgen, aldus Fisher tijdens een persconferentie in Paramaribo."
                            },
                            {
                                "example_id": "116c9a6d-bd0b-45c3-ba23-29177d1bef99",
                                "sense_id": "ad2122e5-8563-3498-9b76-0589cfc15623",
                                "text": "De vergrijzing is een dringende reden om de ouderenzorg zo te regelen dat behoud van kwaliteit en kostenbeheersing alsnog hand in hand gaan. Ondoordachte, te snel uitgevoerde plannen maken alleen maar slachtoffers, zeker als die niet leiden tot het resultaat waarvoor ze in gang zijn gezet."
                            },
                            {
                                "example_id": "a99b8e57-de8b-4f47-a1c0-53bd3e7caf76",
                                "sense_id": "ad2122e5-8563-3498-9b76-0589cfc15623",
                                "text": "Zo goed als het gaat met de kostenbeheersing bij merkloze middelen, zo moeizaam gaat het bij de gepatenteerde middelen, de zogenoemde specialités. Deze middelen slokken driekwart van het budget op. En de komende jaren komen er veel nieuwe dure middelen aan."
                            }
                        ]
                    }
