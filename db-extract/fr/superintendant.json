                ],
                "senses": [
                    {
                        "sense_id": "f7f083ef-7d6d-36a5-8f2b-8487052caf6a",
                        "entry_id": "38dfdc37-0432-3f66-9aa0-bed214678c8d",
                        "glosses": [
                            "Intendant en chef."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac0a5e89-285b-4dc6-86cd-fc791991c3e6",
                                "sense_id": "f7f083ef-7d6d-36a5-8f2b-8487052caf6a",
                                "text": "Tout ce que nos officiers ont fait, c'est pour assurer la sécurité du public et des citoyens de Toronto, qui ont aussi des droits, a dit le superintendant Jeff McGuire, de la Police de Toronto."
                            },
                            {
                                "example_id": "1cabbb51-5ccd-4a01-b176-3810ce345d35",
                                "sense_id": "f7f083ef-7d6d-36a5-8f2b-8487052caf6a",
                                "text": "Le superintendant de l'unité des crimes économiques de la GRC, Stéphane Bonin, a déclaré que le jugement montrait que personne n'était au-dessus de la loi, pas même les politiciens."
                            }
                        ]
                    },
                    {
                        "sense_id": "9889bd1b-f395-31a9-aa7a-64a32d3e3ed2",
                        "entry_id": "38dfdc37-0432-3f66-9aa0-bed214678c8d",
                        "glosses": [
                            "Grade de la police britannique, supérieur à celui d’inspecteur-chef et à inférieur celui de superintendant en chef. Il correspond en France au commissaire de police."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1de71e66-b070-4c12-9e1f-23384423b39a",
                        "source_entry_id": "38dfdc37-0432-3f66-9aa0-bed214678c8d",
                        "source_sense_id": "f7f083ef-7d6d-36a5-8f2b-8487052caf6a",
                        "target_lang_word": "superintendent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superintendent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7418889c-7906-3d42-be1b-b3671fcf25bc",
                                        "entry_id": "459874e3-047f-39dc-83da-21007777c074",
                                        "glosses": [
                                            "A person who is authorized to supervise, direct or administer something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7ae4874-c85a-37b8-822f-9ce54deefeaf",
                                        "entry_id": "459874e3-047f-39dc-83da-21007777c074",
                                        "glosses": [
                                            "A police rank used in Commonwealth countries, ranking above chief inspector, and below chief superintendent."
                                        ],
                                        "tags": [
                                            "Commonwealth"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "802e93f5-e9d7-4b8b-9c98-62e062944161",
                                                "sense_id": "b7ae4874-c85a-37b8-822f-9ce54deefeaf",
                                                "text": "“No, don't,” replied the superintendent; “in fact, I'd rather you made yourself conspicuous elsewhere. Go down to the landing stage and cross to New Brighton or Wallasey—doesn't matter which—and come back. No doubt you will be seen, and reported to have gone across.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e59e4d47-452d-30e9-b51a-4de11ff40429",
                                        "entry_id": "459874e3-047f-39dc-83da-21007777c074",
                                        "glosses": [
                                            "The manager of a building, usually a communal residence, who is responsible for keeping the facilities functional and often collecting rent or similar payments, either as also the building's landlord or on behalf of same. Often abbreviated \\\"super\\\"."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0fa49d9-92d9-3e7f-b889-8f7476410cc9",
