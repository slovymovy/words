{
    "word_family": [
        "avis",
        "avisé",
        "malavisé",
        "préavis"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d7e03b2c-0223-3e7d-8294-2f9f31e893b3",
                    "sense_definition": "Prendre une décision selon l'évolution de la situation, déterminer la conduite à tenir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "decision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous verrons comment les choses évoluent demain et nous <w>aviserons</w> ensuite."
                        },
                        {
                            "text": "Si le train a du retard, nous <w>aviserons</w> sur place pour trouver un hôtel."
                        }
                    ],
                    "synonyms": [
                        "décider"
                    ],
                    "common_phrases": [
                        "on avisera plus tard"
                    ]
                },
                {
                    "sense_id": "b656b2a3-2629-3d00-9554-09a2bfb21ba7",
                    "sense_definition": "Avertir ou informer officiellement quelqu'un de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur nous <w>avise</w> immédiatement dès qu'un changement de planning survient."
                        },
                        {
                            "text": "La banque a <w>avisé</w> ses clients par courrier avant d'appliquer les nouveaux tarifs."
                        }
                    ],
                    "common_phrases": [
                        "aviser quelqu'un de"
                    ]
                },
                {
                    "sense_id": "02b0dd6d-c17f-365a-bbc4-dd873f5f2b65",
                    "sense_definition": "Apercevoir ou remarquer soudainement quelqu'un ou quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En marchant dans la rue, il <w>avisa</w> une vieille librairie pleine de charme."
                        },
                        {
                            "text": "Elle <w>avise</w> un banc libre dans le parc et décide de s'y asseoir."
                        }
                    ],
                    "synonyms": [
                        "voir"
                    ]
                },
                {
                    "sense_id": "3ffc179d-78d6-3b73-ac89-a75103d05096",
                    "sense_definition": "Sous la forme pronominale, avoir l'audace ou la témérité d'accomplir une action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "audace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'<w>avise</w> pas de recommencer une telle bêtise devant tes parents."
                        },
                        {
                            "text": "Il ne s'était jamais <w>avisé</w> de contredire les ordres de son supérieur."
                        }
                    ],
                    "common_phrases": [
                        "s'aviser de"
                    ]
                },
                {
                    "sense_id": "8e9f4982-25e1-35e0-bc77-a5190ef109dd",
                    "sense_definition": "Réfléchir à une situation difficile et chercher les moyens d'y pourvoir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est grand temps d'<w>aviser</w> aux mesures nécessaires pour résoudre cette crise financière."
                        },
                        {
                            "text": "Face à cet imprévu, les responsables doivent <w>aviser</w> sans attendre aux réparations urgentes."
                        }
                    ],
                    "common_phrases": [
                        "aviser aux moyens"
                    ]
                }
            ]
        }
    ]
}