                "senses": [
                    {
                        "sense_id": "2e92fb80-daf2-3465-a9fe-0077bdec6a66",
                        "entry_id": "3c07fbe7-f40e-31b6-8c8a-b7b63d6b797b",
                        "glosses": [
                            "Großstadt in São Paulo, Brasilien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a50196b9-7a88-43aa-954e-07df537b7afd",
                                "sense_id": "2e92fb80-daf2-3465-a9fe-0077bdec6a66",
                                "text": "Araraquara liegt circa 250km nordwestlich von São Paulo."
                            },
                            {
                                "example_id": "d3d9ee94-99aa-47c6-9a33-6cbf27587620",
                                "sense_id": "2e92fb80-daf2-3465-a9fe-0077bdec6a66",
                                "text": "„Der Brasilianer war beim Überfliegen seines Anwesens in der Nähe der Stadt Araraquara mit einem Ultraleichtflugzeug aus 90 Meter Höhe in einen Sumpf gestürzt und hatte sich dabei einen Rückenwirbel gebrochen.“"
                            },
                            {
                                "example_id": "479229c3-221a-458e-b23b-e88715f78d63",
                                "sense_id": "2e92fb80-daf2-3465-a9fe-0077bdec6a66",
                                "text": "„Anfang 2001 wechselte er von dort kurzfristig zum Eisenbahnerklub Ferroviária im benachbarten Araraquara und spielte mit diesem in der vierten Liga des Staates.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
