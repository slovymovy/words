                        "entry_id": "ede20501-3edd-372d-b916-de585f4403f7",
                        "glosses": [
                            "Not noting; failing to pay attention or observe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3900695b-e398-4085-862b-72c82f5b99ac",
                                "sense_id": "5fec495e-8900-3dcc-b48d-28cb8f1479e6",
                                "text": "The glance was politely unnoting, but in it there yet lurked, far back, the unmistakable quality of a caress."
                            },
                            {
                                "example_id": "ad6d376e-8417-4e27-a26b-b7b2a0703321",
                                "sense_id": "5fec495e-8900-3dcc-b48d-28cb8f1479e6",
                                "text": "Rain-laden mists swept down upon her from the heights, and she walked through them unnoting; the pale light from the eastern sky shone on an aspect introverted, rapt away from knowledge of its surroundings."
                            },
                            {
                                "example_id": "08c5ec63-4624-4a16-9291-b26c93f616b0",
                                "sense_id": "5fec495e-8900-3dcc-b48d-28cb8f1479e6",
                                "text": "It seemed drearily suggestive, the last journey of this humble mortality, in all the splendid environment of the mountains, under the vast expansions of the aloof skies, in the mystic light of the unnoting moon."
                            }
                        ]
                    }
