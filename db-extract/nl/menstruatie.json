                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11313b65-46ac-4c20-a899-80ce9eb59ddc",
                                "sense_id": "8d46ea2a-b0da-39b1-ac6c-518e01a310e0",
                                "text": "Hoe vrouwen het aanpakten tijdens hun menstruatie weet ik niet precies. Er bestaat een speciale PCT-vrouwenfacebookgroep (women of the PCT) waar onderling tips en tricks over dit soort onderwerpen worden gedeeld."
                            }
