                        "entry_id": "0e06270e-9532-35fa-a26c-2f2bcea2743a",
                        "glosses": [
                            "sytuacja, w której niektóre wymogi prawne dotyczące powstania wierzytelności lub innego prawa podmiotowego zostały częściowo spełnione"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e02c494-da46-45b2-b145-70761080db4f",
                                "sense_id": "9380384c-943c-3d47-86ce-c34ed5969bb1",
                                "text": "Z chwilą zawarcia umowy, o której mowa w art. 18 ust. 1, powstaje ekspektatywa własności. Ekspektatywa własności jest zbywalna wraz z wkładem budowlanym albo jego wniesioną częścią, przechodzi na spadkobierców i podlega egzekucji."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
