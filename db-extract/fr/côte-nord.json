                    {
                        "sense_id": "0bfe6d56-f43f-3452-a364-14e7451d6ee7",
                        "entry_id": "576b9a25-ea23-384d-88f5-192258c8d9b6",
                        "glosses": [
                            "Région du Québec."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "0b5e8eee-cd01-4f63-b7c2-73d62750649b",
                                "sense_id": "0bfe6d56-f43f-3452-a364-14e7451d6ee7",
                                "text": "Seules les régions de l’Abitibi-Témiscamingue, de la Côte-Nord et du Nunavik demeurent en zone jaune, soit le palier de préalerte."
                            },
                            {
                                "example_id": "4e87c8c7-9814-4c8c-8d26-eb6653f24c7b",
                                "sense_id": "0bfe6d56-f43f-3452-a364-14e7451d6ee7",
                                "text": "Cette alerte de tempête de neige concerne principalement les secteurs du Bas-Saint-Laurent, de la Côte-Nord, du Saguenay-Lac-Saint-Jean et de Charlevoix."
                            },
                            {
                                "example_id": "ca079069-6537-4e8b-bf84-db7b0d31caa6",
                                "sense_id": "0bfe6d56-f43f-3452-a364-14e7451d6ee7",
                                "text": "«Qu’est-ce qui empêche le gouvernement du Québec d’affréter un avion pour permettre aux gens, pour qui c’est leur gagne-pain, de se rendre sur la Côte-Nord à temps?» dit-il."
                            }
                        ]
                    }
