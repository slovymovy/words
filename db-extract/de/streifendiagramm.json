                ],
                "senses": [
                    {
                        "sense_id": "4c8f0219-9911-3f1e-820f-7827e2ea10f9",
                        "entry_id": "6b726bed-4ea8-3aaa-bb05-2b3b5ce03493",
                        "glosses": [
                            "Diagramm zur Darstellung der Häufigkeitsverteilung mit Hilfe auf der x- oder y-Achse senkrecht stehender, nicht aneinander grenzender Säulen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "622c88c7-1b2d-4ab7-a9b3-86853c8517f5",
                                "sense_id": "4c8f0219-9911-3f1e-820f-7827e2ea10f9",
                                "text": "„Versucht man gar, ein Streifendiagramm aus solchen Daten zu erstellen, erhält man ein Schaubild, das kaum sinnvoll zu interpretieren ist.“"
                            },
                            {
                                "example_id": "41cae734-5a5c-45a4-8a5f-f16699dcf413",
                                "sense_id": "4c8f0219-9911-3f1e-820f-7827e2ea10f9",
                                "text": "„Säulen- und Balkendiagramme sind Spezialfälle von Streifendiagrammen. In der Primarstufe kann zur Vereinfachung auf diese begriffliche Unterteilung verzichtet und nur von Streifendiagrammen gesprochen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2884ce6e-04d3-3eec-ad92-2e0cc9c0ae57",
                        "entry_id": "6b726bed-4ea8-3aaa-bb05-2b3b5ce03493",
                        "glosses": [
                            "rechteckiges Diagramm zur Darstellung von Prozentwerten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9b92f75-963b-4749-84be-4eca95299209",
                                "sense_id": "2884ce6e-04d3-3eec-ad92-2e0cc9c0ae57",
                                "text": "„Mit einem Streifendiagramm werden Größenverhältnisse oder Anteile verdeutlicht. Deshalb muss beim Streifendiagramm die Ergebnismenge [] 100 % der Ergebnisse wiedergeben.“"
                            },
                            {
                                "example_id": "2d7977ea-995a-42f5-99a3-538eeebe1a75",
                                "sense_id": "2884ce6e-04d3-3eec-ad92-2e0cc9c0ae57",
                                "text": "„Für das Streifendiagramm wählst du am besten eine einfache Maßeinheit, z.B. 10 cm. Die Breite des Streifens ist beliebig, allerdings solltest du ihn nicht zu klein zeichnen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
