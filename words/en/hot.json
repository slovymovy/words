                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "attractiveness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone at the party thought that the new lead singer was really <w>hot</w>.",
                            "target_lang_translations": {
                                "ru": "Все на вечеринке считали, что новый солист действительно <w>горяч</w>."
                            }
                        },
                        {
                            "text": "She looks smoking <w>hot</w> in that new red dress she bought.",
                            "target_lang_translations": {
                                "ru": "Она выглядит чертовски <w>привлекательно</w> в том новом красном платье, которое купила."
                            }
                        }
                    ],
                    "synonyms": [
                        "sexy",
                        "attractive",
                        "good-looking",
                        "smoking hot",
                        "gorgeous"
                    ],
                    "common_phrases": [
                        "really hot"
                    ],
