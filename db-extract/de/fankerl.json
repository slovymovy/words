                        "examples": [
                            {
                                "example_id": "967b00bf-b42a-4fb4-b633-3890ffa04a36",
                                "sense_id": "dd522888-178f-3105-bb62-6e37c543b342",
                                "text": "„Sie moant, der Fànkerl holt s' mein Oad, den s' hat in Sturm bischworn;“"
                            },
                            {
                                "example_id": "11fa32a4-5cee-482a-a707-9b280ec9b3e8",
                                "sense_id": "dd522888-178f-3105-bb62-6e37c543b342",
                                "text": "„Den hot, wia's Maßl voll g'we'n is, der Fankerl g'holt in d' Höll'.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
