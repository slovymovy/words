{
    "word_family": [
        "shake",
        "shaky",
        "shaker"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9d43d42d-7bf4-3467-b39e-2bc6f66fd50d",
                    "sense_definition": "Able to be moved or vibrated by shaking.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old table was quite <w>shakable</w> whenever someone leaned on it.",
                            "target_lang_translations": {
                                "pl": "Stary stół był dość <w>chwiejny</w>, ilekroć ktoś się o niego oparł."
                            }
                        },
                        {
                            "text": "Make sure the ladder is not <w>shakable</w> before you climb to the roof.",
                            "target_lang_translations": {
                                "pl": "Upewnij się, że drabina nie jest <w>chwiejna</w>, zanim wejdziesz na dach."
                            }
                        }
                    ],
                    "synonyms": [
                        "unstable",
                        "wobbly"
                    ],
                    "antonyms": [
                        "unshakable"
                    ],
                    "target_lang_definitions": {
                        "pl": "Taki, który może zostać poruszony lub wprawiony w drgania poprzez potrząsanie; niestabilny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "chwiejny",
                                "target_lang_sense_clarification": "odnoszący się do przedmiotu, który nie stoi stabilnie"
                            },
                            {
                                "target_lang_word": "niestabilny",
                                "target_lang_sense_clarification": "ogólne określenie braku stabilności"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62153669-333d-39b9-a117-541170ed9ac5",
                    "sense_definition": "Constructed or intended to be used by shaking.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salt container is <w>shakable</w> for easy seasoning of food.",
                            "target_lang_translations": {
                                "pl": "Pojemnik na sól jest <w>przystosowany do potrząsania</w>, co ułatwia przyprawianie potraw."
                            }
                        },
                        {
                            "text": "This <w>shakable</w> bottle helps mix the ingredients thoroughly.",
                            "target_lang_translations": {
                                "pl": "Ta <w>przystosowana do potrząsania</w> butelka pomaga dokładnie wymieszać składniki."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Przystosowany do użycia poprzez potrząsanie zawartością."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przystosowany do potrząsania",
                                "target_lang_sense_clarification": "opisujący funkcjonalność pojemnika"
                            },
                            {
                                "target_lang_word": "do wytrząsania",
                                "target_lang_sense_clarification": "wskazujący na sposób dozowania zawartości"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}