                    {
                        "translation_id": "682162c7-8811-4eca-8ecc-96604c6137c9",
                        "source_entry_id": "19e1ba3b-ca2d-3800-972d-542819639c1b",
                        "source_sense_id": "017e4c0b-9dbe-39a7-aa11-a1a5c5b689b7",
                        "target_lang_word": "Serviette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Serviette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75082728-6fc5-3bbf-aa76-5b55060f71f5",
                                        "entry_id": "d0f2ce4a-3253-3c8b-9c9b-91c4360cf24f",
                                        "glosses": [
                                            "Tuch, das zum Schützen der Kleidung und Reinigung des Mundes beim Essen verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da42ea90-495b-4d6b-91df-61f711957ec1",
                                                "sense_id": "75082728-6fc5-3bbf-aa76-5b55060f71f5",
                                                "text": "Im Restaurant wischt man sich den Mund nicht am Ärmel ab. Man benutzt dafür eine Serviette."
                                            },
                                            {
                                                "example_id": "c44d5cd1-fa4b-49f6-9e19-991cd4dc6738",
                                                "sense_id": "75082728-6fc5-3bbf-aa76-5b55060f71f5",
                                                "text": "„Meine Aufgabe war es, die Servietten ins Regal zurückzulegen.“"
                                            },
                                            {
                                                "example_id": "23b46a0a-c16a-44f8-9e2c-b4b314989acd",
                                                "sense_id": "75082728-6fc5-3bbf-aa76-5b55060f71f5",
                                                "text": "„Hastig griff sie nach der Serviette und rieb auf seinem Hemd, aber die bunte Flüssigkeit hatte sich schon verteilt.“"
                                            },
                                            {
                                                "example_id": "4806d0e7-949c-4f90-a478-1c2214de8762",
                                                "sense_id": "75082728-6fc5-3bbf-aa76-5b55060f71f5",
                                                "text": "„Ihre Servietten liegen zerknüllt neben ihnen auf dem Tisch.“"
                                            },
                                            {
                                                "example_id": "c972bbf8-6523-46ec-a264-133d5294fb80",
                                                "sense_id": "75082728-6fc5-3bbf-aa76-5b55060f71f5",
                                                "text": "„Ich spießte meine Serviette mit einer Gabel auf und winkte damit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
