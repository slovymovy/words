                    {
                        "sense_id": "24a102b6-6381-3fd3-9cad-75491c27be54",
                        "entry_id": "51c66e9a-d6be-3163-b54b-bb68782cce9b",
                        "glosses": [
                            "een organisatie die zich richt op het verzorgen van radio- of televisieprogramma's"
                        ],
                        "tags": [
                            "media"
                        ],
                        "examples": [
                            {
                                "example_id": "994f7534-ee8f-4578-ad3c-f14ebc50fea0",
                                "sense_id": "24a102b6-6381-3fd3-9cad-75491c27be54",
                                "text": "Het Bronovo-ziekenhuis in Den Haag blijft ook na 2024 open. Dat staat in plannen van Haaglanden Medisch Centrum (HMC) waar het ziekenhuis onder valt. Tot 2030 blijft het zeker open, schrijft Omroep West, voor operaties en andere niet-spoedeisende behandelingen, laat de HMC-directie weten."
                            },
                            {
                                "example_id": "066396dd-bc96-4d66-99b2-b229a9ba22c9",
                                "sense_id": "24a102b6-6381-3fd3-9cad-75491c27be54",
                                "text": "Toeters en vlaggen: Volgens de regionale omroep RTV Oost was het ook druk in de omgeving van het stadion van de club, De Adelaarshorst. Voorbijkomende auto's toeterden erop los en mensen hingen met vlaggen uit het raam."
                            }
                        ]
                    },
                    {
                        "sense_id": "b70add26-bdd1-3d65-897c-d608752626cc",
                        "entry_id": "51c66e9a-d6be-3163-b54b-bb68782cce9b",
                        "glosses": [
                            "het, doorgaans via een geluidsinstallatie, geven van gesproken mededelingen, berichten en oproepen, vanuit een centraal punt naar een algemeen publiek, omstanders, passagiers etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "676c60c2-7773-4bef-b768-889554c92a1c",
                                "sense_id": "b70add26-bdd1-3d65-897c-d608752626cc",
                                "text": "De omroep in de trein laat niets te wensen over, de berichten aan de reizigers zijn goed verstaanbaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b318fb2-257e-4a23-9707-b198d1b32238",
                        "source_entry_id": "51c66e9a-d6be-3163-b54b-bb68782cce9b",
                        "source_sense_id": "24a102b6-6381-3fd3-9cad-75491c27be54",
