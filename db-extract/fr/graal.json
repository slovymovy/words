                                            {
                                                "example_id": "fa7174d0-752c-41f6-97eb-3db9eebfea57",
                                                "sense_id": "24be42bf-656f-3a1b-ac1d-3ae0cfabc333",
                                                "text": "The quest for the Grail is not archeology. It's a race against evil. If it is captured by the Nazis, the armies of darkness will march all over the face of the earth. Do you understand me?"
                                            }
                                        ]
                                    },
                                    {
