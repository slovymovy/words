    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2727fd07-e223-3ad3-a282-c66179acdaa5",
                    "sense_definition": "Désir excessif de plaire, de se faire valoir ou d'être admiré des autres.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "orgueil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses compliments répétés finissaient par flatter la <w>vanité</w> de l'artiste."
                        },
                        {
                            "text": "Cette remarque anodine a pourtant profondément blessé sa <w>vanité</w> d'auteur."
                        }
                    ],
                    "synonyms": [
                        "fatuité"
                    ],
                    "antonyms": [
                        "modestie"
                    ],
                    "common_phrases": [
                        "flatter la vanité",
                        "blesser sa vanité"
                    ]
                },
                {
                    "sense_id": "8e87a025-66f2-349e-9344-ab1b660e4a54",
                    "sense_definition": "Caractère de ce qui est vain, illusoire, sans consistance ou sans utilité réelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inutilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le philosophe méditait souvent sur la <w>vanité</w> de ses efforts pour changer les hommes."
                        },
                        {
                            "text": "Face à l'immensité de la nature, il comprit soudain toute la <w>vanité</w> du monde."
                        }
                    ],
                    "synonyms": [
                        "futilité"
                    ],
                    "common_phrases": [
                        "la vanité du monde",
                        "la vanité de ses efforts"
                    ]
                },
                {
                    "sense_id": "1d264bcf-d1da-384f-9d8d-e81e0cc2c260",
                    "sense_definition": "Choses futiles, plaisirs superficiels ou apparences trompeuses du monde.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inutilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a choisi de renoncer à toutes les <w>vanités</w> de ce monde pour vivre dans la solitude."
                        },
                        {
                            "text": "Elle préférait la simplicité de la campagne plutôt que les <w>vanités</w> de la haute société."
                        }
                    ],
                    "synonyms": [
                        "frivolité"
                    ],
                    "common_phrases": [
                        "les vanités de ce monde"
                    ]
                },
                {
                    "sense_id": "3c20d997-a8e2-3f74-91b8-1854dcb72e13",
                    "sense_definition": "Genre de nature morte allégorique illustrant la précarité de la vie humaine et l'inéluctabilité de la mort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le musée expose une célèbre <w>vanité</w> hollandaise où figurent un crâne et un sablier."
                        },
                        {
                            "text": "Ce maître du dix-septième siècle aimait peindre une <w>vanité</w> pour rappeler la fuite du temps."
                        }
                    ],
                    "common_phrases": [
                        "peindre une vanité"
                    ]
                }
            ]
        }
    ]
