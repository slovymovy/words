                                        "glosses": [
                                            "Étude de l’adaptation des ouvrages humains aux sols et roches formant le terrain naturel."
                                        ],
                                        "tags": [
                                            "Génie civil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41e9b4df-2ae8-4023-87d6-144c51194d4a",
                                                "sense_id": "4131a3a3-a899-3e32-a522-b4951b55deed",
                                                "text": "Des experts en géotechnique du ministère vérifient notamment s’il n’y a pas d’autres mouvements de sol sur le tronçon touché."
                                            },
                                            {
                                                "example_id": "71aa6497-12ce-4948-90c5-48fbf7035082",
                                                "sense_id": "4131a3a3-a899-3e32-a522-b4951b55deed",
                                                "text": "Elles seront intégrées à LVM, la plus importante filiale de Dessau, qui œuvre dans le domaine de la géotechnique, l’ingénierie des matériaux et l’environnement."
                                            }
                                        ]
                                    }
