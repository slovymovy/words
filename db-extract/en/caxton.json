                            {
                                "example_id": "7062de70-9551-48c3-a3a5-6a44a164d1ba",
                                "sense_id": "6a54df17-33ce-3a9a-b5d2-0fd12d2f2605",
                                "text": "This remarkable passion of the British nobility for editiones principes and Caxtons seems to have lasted but a couple of decades."
                            }
