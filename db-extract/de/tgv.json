                    {
                        "sense_id": "6800bded-d02b-31d3-b9aa-b47985beb32d",
                        "entry_id": "acadd871-6caa-35d5-ae6f-8f9a6e662f8a",
                        "glosses": [
                            "Hochgeschwindigkeitszug in Frankreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "301a440d-8aa1-44b8-a0d3-6df7f94621d3",
                                "sense_id": "6800bded-d02b-31d3-b9aa-b47985beb32d",
                                "text": "Wann kommt der nächste TGV nach Paris?"
                            },
                            {
                                "example_id": "2de1eb9d-3e88-4781-bd9e-a1dd532b6718",
                                "sense_id": "6800bded-d02b-31d3-b9aa-b47985beb32d",
                                "text": "TGVs fahren u.a. auch nach Deutschland und Spanien."
                            }
                        ],
