                                                "sense_id": "167e9734-f53d-38fb-8545-11d8c95f2a16",
                                                "text": "„Ein typisches Produkt dieser Art Leichttrennwände sind die mit Gipskartonplatten beplankten Metallständerwände.“"
                                            }
