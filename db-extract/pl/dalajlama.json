                "senses": [
                    {
                        "sense_id": "334e84c0-5fe5-3eea-9b54-bcaa940e3b2b",
                        "entry_id": "cfb73af2-cd2f-3cc0-b17c-207bcdad4de3",
                        "glosses": [
                            "tytuł duchownego zwierzchnika kościoła lamaickiego (buddyzmu tybetańskiego) i do 1959 roku najwyższego świeckiego zwierzchnika politycznego w Tybecie"
                        ],
