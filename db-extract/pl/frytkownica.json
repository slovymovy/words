                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a2a55d7-e85e-4984-9f55-a22fc3df1d34",
                        "source_entry_id": "54cdb5f2-d75b-3c05-abae-dfb60f247ae0",
                        "source_sense_id": "b99534bb-37da-351a-b881-7ed70402009f",
                        "target_lang_word": "fryer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fryer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12d0e662-5ec5-3d41-a4da-836fac2b7acf",
                                        "entry_id": "69b59194-a862-3c32-9641-d6e1da0dcb67",
                                        "glosses": [
                                            "A machine or container for frying food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e16e19c6-c520-4a0d-85d8-9c6db913e415",
                                                "sense_id": "12d0e662-5ec5-3d41-a4da-836fac2b7acf",
                                                "text": "He learned to work the fryer as part of becoming a competent cook for a commercial kitchen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72dd51fd-8008-3500-8842-4fdb065a7d7e",
                                        "entry_id": "69b59194-a862-3c32-9641-d6e1da0dcb67",
                                        "glosses": [
                                            "A fish suitable for frying."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7088d9da-79f6-3e86-9a2f-0122484906f4",
                                        "entry_id": "69b59194-a862-3c32-9641-d6e1da0dcb67",
                                        "glosses": [
                                            "A young chicken suitable for frying; a pullet or cockerel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e956d153-2adf-4a7f-b8c3-d00d0c0f344f",
                                                "sense_id": "7088d9da-79f6-3e86-9a2f-0122484906f4",
                                                "text": "“The Boasts have got such a head-start with chickens, likely they’re planning to eat friers this summer,” said Pa. “It may be she took a few cockerels out of this flock, looking on them as meat.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "705d1f85-48f9-309a-bc60-9bc963755dfa",
                                        "entry_id": "69b59194-a862-3c32-9641-d6e1da0dcb67",
                                        "glosses": [
                                            "One who fries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c63933b4-1603-43bd-a308-f5022556fabc",
                                                "sense_id": "705d1f85-48f9-309a-bc60-9bc963755dfa",
                                                "text": "The dolphin was also borne by the family of Fryer, with reference, as Mr. Moule suggests, to the fry or swarm of fishes (or was not their ancestor an excellent fryer of fish?); […]"
                                            },
                                            {
                                                "example_id": "4156012d-af40-49f7-9323-90abe4520880",
                                                "sense_id": "705d1f85-48f9-309a-bc60-9bc963755dfa",
                                                "text": "The sale is conducted on the principle of what is termed a “Dutch auction,” purchasers not being allowed to inspect the fish in the doubles before they bid. Offal is bought only by the “fryers.”"
                                            },
                                            {
                                                "example_id": "7f1e8e2b-74c8-4b45-baeb-a67ac6e1da12",
                                                "sense_id": "705d1f85-48f9-309a-bc60-9bc963755dfa",
                                                "text": "Of course this may be true, this story of the fryer of fish in the square San Antonio, but the man may have been lying to me—that is, “stringing” me, as we say."
                                            },
                                            {
                                                "example_id": "94f629dd-97ee-4fe6-be4e-7ef6b38fbd1d",
                                                "sense_id": "705d1f85-48f9-309a-bc60-9bc963755dfa",
                                                "text": "Ernest Gilpin, employed in the Summer White House kitchen at Cedar Island Lodge, wrote the Milwaukee Circuit Court that he would be unable to appear to answer charges of desertion and cruelty filed by his wife. He said to do so might cost him his job as a fryer of fish for the President."
                                            },
                                            {
                                                "example_id": "3692bb86-053b-4280-beb3-0b7a123125d1",
                                                "sense_id": "705d1f85-48f9-309a-bc60-9bc963755dfa",
                                                "text": "Now I'm an excellent fryer of eggs, and the way I do it - do you want to know how I do it?"
                                            },
                                            {
                                                "example_id": "e703e2ce-608a-40c5-967d-9ef4e27cf4ab",
                                                "sense_id": "705d1f85-48f9-309a-bc60-9bc963755dfa",
                                                "text": "Clark is especially pleased when someone mentions his skill in the kitchen. “I am a great hot-cake cooker,” he says, warming up to his subject, “and I am one of the greatest dishwashers in the country. I am also one of the greatest fryers of chicken in the country, and I toss up a dandy fruit salad—grapefruit, oranges, pineapple and bananas, with French dressing. I really fix it up.”"
                                            },
                                            {
                                                "example_id": "c454ea6b-1c4f-41d8-8804-0cddae131114",
                                                "sense_id": "705d1f85-48f9-309a-bc60-9bc963755dfa",
                                                "text": "It seemed that here was a young lady who, while willing to accept three pounds a week for decorating the stage of the Winter Garden for a season or two, very definitely had other fish to fry. She was, as a fryer of fish, to make quite a name for herself."
                                            },
                                            {
                                                "example_id": "aac5aeb7-5a70-4ff1-99ac-6b8ace3cca0b",
                                                "sense_id": "705d1f85-48f9-309a-bc60-9bc963755dfa",
                                                "text": "‘I might not be the best fryer of fish,’ said Alexis’ voice from beside her, ‘but I am considered a very good hand as a maker of salads.’"
                                            },
                                            {
                                                "example_id": "b0153a3a-f735-4f12-8854-2deccd45d3ec",
                                                "sense_id": "705d1f85-48f9-309a-bc60-9bc963755dfa",
                                                "text": "My grandmother McGinness (whom I called “Nana\") was an ardent bird-watcher and a dedicated catcher, filleter, and fryer of fish."
                                            },
                                            {
                                                "example_id": "39adaa33-2665-4e57-b7bb-a1033f0cc144",
                                                "sense_id": "705d1f85-48f9-309a-bc60-9bc963755dfa",
                                                "text": "Michelangelo was an excellent fryer of eggs, a real master with a skillet, far better than I was."
                                            },
                                            {
                                                "example_id": "0e0921dd-97f8-4c0d-a267-04cd2bfbc473",
                                                "sense_id": "705d1f85-48f9-309a-bc60-9bc963755dfa",
                                                "text": "In the same vein is what happened once concerning a man who was a fryer of fish by trade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
