                "entry_id": "ed13fedc-584b-30d2-9292-2c7513820724",
                "word": "tanga",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b5b5e4c4-49bf-4ab7-a3fb-c71b392968ef",
                        "entry_id": "ed13fedc-584b-30d2-9292-2c7513820724",
                        "tags": [
                            "plural"
                        ],
