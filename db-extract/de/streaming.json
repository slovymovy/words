                "senses": [
                    {
                        "sense_id": "b71a79ed-764a-3fe1-b5dc-cf28c188ad51",
                        "entry_id": "b911b018-dfc9-3f3b-b09b-e8a31a3058e5",
                        "glosses": [
                            "Technik des Übertragens, Bereitstellens, Empfangens und Abspielens von Audio- und Videodaten über das Internet, ohne dass diese Daten auf einem lokalen Speichermedium (Festplatte oder Ähnliches) gespeichert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e4d5b8a-2c88-49f4-994b-c9fa1a60743d",
                                "sense_id": "b71a79ed-764a-3fe1-b5dc-cf28c188ad51",
                                "text": "„Doch der Vorteil, die Musik an einem Ort zu haben, und über alle möglichen Geräte synchronisieren zu können, überzeugte die Kunden und eröffnete Apple und der Musikbranche ein neues Milliardengeschäft. Inzwischen wird bei den Nutzern allerdings das Streaming, bei dem die Songs direkt aus dem Netz abgespielt werden, populärer. Apple reagiert.“"
                            },
                            {
                                "example_id": "29a97a06-fd5f-4507-97c8-d0d6daa28bed",
                                "sense_id": "b71a79ed-764a-3fe1-b5dc-cf28c188ad51",
                                "text": "„Die Software übermittelt Videobotschaften per Streaming ohne Download-Verzögerung und spezielle Software beim Empfänger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6f7763de-2fd5-3222-9b3a-fc225fd7e3cb",
                        "entry_id": "b911b018-dfc9-3f3b-b09b-e8a31a3058e5",
                        "glosses": [
