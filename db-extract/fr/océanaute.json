                        "glosses": [
                            "Spécialiste des expéditions sous-marines à grandes profondeurs et de longues durées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "548e730c-89c8-47ac-bef0-92650c9614a3",
                                "sense_id": "528ecb9f-cff3-37c0-8aef-142cf4191f71",
                                "text": "Le Commandant Cousteau peut-il être considéré comme le premier océanaute, ou bien est-ce Auguste Picard et son bathyscaphe ?"
                            },
                            {
                                "example_id": "5027a23b-3193-4199-8b14-a5fcde1980a4",
                                "sense_id": "528ecb9f-cff3-37c0-8aef-142cf4191f71",
                                "text": "Peut-être, mais moi je préfère me sentir telle une océanaute dans les profondeurs de la mer qui plonge pour déterrer des artéfacts anciens que je dois laver pour voir leur beauté."
                            }
                        ]
                    }
