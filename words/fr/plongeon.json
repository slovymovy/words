                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de nager, elle a fait un superbe <w>plongeon</w> depuis le haut du rocher."
                        },
                        {
                            "text": "Les enfants s'amusent à faire des <w>plongeons</w> spectaculaires dans la piscine municipale tout l'après-midi."
                        }
                    ],
                    "common_phrases": [
