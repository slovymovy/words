                "senses": [
                    {
                        "sense_id": "040c00ff-7431-3c09-8eba-11cd9271438a",
                        "entry_id": "2283011e-0dee-3c61-88d8-4467187733ae",
                        "glosses": [
                            "defensiv eingestellter Spieler, dessen Aufgabe es ist, das gegnerische Spiel zu stören und der gegnerischen Mannschaft das Spielgerät (Ball, Puck und so weiter) abzunehmen; Verhinderer von Toren der gegnerischen Mannschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b31dce97-f080-4ed8-a030-4d996a453fce",
                                "sense_id": "040c00ff-7431-3c09-8eba-11cd9271438a",
                                "text": "Schließlich gelang Neu-Nationalspieler Karim Bellarabi nach schönem Solo das dritte Tor für Leverkusen: Er tanzte vier VfB-Abwehrspieler im Strafraum aus und traf ins lange Eck (41. [Minute])."
                            },
                            {
                                "example_id": "3075e549-a567-476a-a4a0-4aa5c500febf",
                                "sense_id": "040c00ff-7431-3c09-8eba-11cd9271438a",
                                "text": "Per Mertesacker konnte der Niederlage dennoch Gutes abgewinnen: „Das war ein Wachmacher und wird uns gut tun für Sonntag“, sagte der Abwehrspieler von Arsenal London nach der Partie [Deutschland gegen Argentinien in Düsseldorf]."
                            },
                            {
                                "example_id": "153da9a0-bfd0-4219-ab81-79bfe8048435",
                                "sense_id": "040c00ff-7431-3c09-8eba-11cd9271438a",
                                "text": "Vor allem, und das ist selbst unter [Fußball-Bundestrainer] Joachim Löw noch immer das Wichtigste für einen Abwehrspieler, gewann Hummels alle wichtigen Zweikämpfe gegen Helder Postiga, Moutinho und Cristiano Ronaldo."
                            },
                            {
                                "example_id": "7348cf93-71f0-4dff-bf56-6a3413358b61",
                                "sense_id": "040c00ff-7431-3c09-8eba-11cd9271438a",
                                "text": "„Seine Aggressivität unterschied ihn von den anderen Abwehrspielern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5da56219-4dab-4e2e-aaca-9c1720fd33f1",
                        "source_entry_id": "2283011e-0dee-3c61-88d8-4467187733ae",
