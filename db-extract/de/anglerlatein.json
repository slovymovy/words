                        "glosses": [
                            "übertriebene oder erfundene Erzählung eines Anglers über einen besonderen Fang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "973bbd6e-a03a-4f8e-b433-1f04cf3d72b9",
                                "sense_id": "870d0f91-4c1b-3ec5-9993-35d09a268621",
                                "text": "Spätestens nach dem dritten Bier fängt er an jedem sein Anglerlatein aufzutischen."
                            },
                            {
                                "example_id": "0fa55511-9fa1-42eb-a3f1-a051ebff6d4b",
                                "sense_id": "870d0f91-4c1b-3ec5-9993-35d09a268621",
                                "text": "„Wer die schwerbeladenen Fischerboote nicht mit eigenen Augen gesehen hat, wird das für Anglerlatein halten.“"
                            },
                            {
                                "example_id": "1f8ca636-5f3e-4048-8979-3a845c7dff24",
                                "sense_id": "870d0f91-4c1b-3ec5-9993-35d09a268621",
                                "text": "„Wie bei allem Anglerlatein wurde der Walfisch bei jeder Weitergabe ein gehöriges Stück größer und gefährlicher.“"
                            }
                        ],
