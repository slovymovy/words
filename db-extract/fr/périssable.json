        "fr-extract.jsonl": [
            {
                "entry_id": "e14d1fff-b0fd-3070-b39e-6c86c1f59ef6",
                "word": "périssable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f5995d59-d640-4d4b-9d9b-8bad89c3f8f9",
                        "entry_id": "e14d1fff-b0fd-3070-b39e-6c86c1f59ef6",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "périssables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd11aa97-4f27-33c4-890e-68cf64fc8496",
                        "entry_id": "e14d1fff-b0fd-3070-b39e-6c86c1f59ef6",
                        "glosses": [
                            "Qui ne dure pas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99c8af9b-5add-42a9-90e0-7fb363ae8427",
                                "sense_id": "cd11aa97-4f27-33c4-890e-68cf64fc8496",
                                "text": "Les gens seront invités à faire des dons en argent ou à déposer des denrées alimentaires non périssables aux points de chute désignés."
                            },
                            {
                                "example_id": "8385b2d2-136e-44d4-898b-5685345b9555",
                                "sense_id": "cd11aa97-4f27-33c4-890e-68cf64fc8496",
                                "text": "Car les produits de la pêche, très rapidement périssables, devaient parcourir de longues distances en très peu de temps pour pouvoir être consommés dans l’Halil Rud."
                            },
                            {
                                "example_id": "a1e8024e-4cb9-4bb8-84c3-457705a43906",
                                "sense_id": "cd11aa97-4f27-33c4-890e-68cf64fc8496",
                                "text": "En son temps, l'écrivain romain Cassiodore (480-575) avait bien tenté de conserver ces textes en ouvrant une officine d'écriture où tout ce qui lui passait sous la main était retranscrit sur du papyrus, mais ce matériau était trop fragile et périssable. Il n’en subsiste aujourd'hui que d’infimes lambeaux…"
                            },
                            {
                                "example_id": "2d0d1cbf-f380-469c-9bab-510fde0f1c82",
                                "sense_id": "cd11aa97-4f27-33c4-890e-68cf64fc8496",
                                "text": "Les informations périssables et incertaines du bulletin de nouvelles quotidien."
                            },
                            {
                                "example_id": "358a4060-de39-4ba0-8277-8d327a768b43",
                                "sense_id": "cd11aa97-4f27-33c4-890e-68cf64fc8496",
                                "text": "Le bien de la fortune est un bien périssable,\nQuand on bâtit sur elle, on bâtit sur le sable."
                            },
                            {
                                "example_id": "8368da54-0fee-42cc-9c1b-26d49916179d",
                                "sense_id": "cd11aa97-4f27-33c4-890e-68cf64fc8496",
                                "text": "[…] et prétendait obéir à la nécessité d’agir ainsi, tant pour se rappeler à lui-même que pour rappeler aux personnes pieuses que leurs corps étaient périssables et leurs âmes immortelles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74dc4586-d24f-444c-ac2c-1a990a78e728",
                        "source_entry_id": "e14d1fff-b0fd-3070-b39e-6c86c1f59ef6",
                        "source_sense_id": "cd11aa97-4f27-33c4-890e-68cf64fc8496",
                        "target_lang_word": "verderblich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verderblich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "837738dd-0f06-36a9-9b96-f074a885c95f",
                                        "entry_id": "1e288930-496f-3e5c-9379-6fd374ba5201",
                                        "glosses": [
                                            "nach kurzer Zeit / schnell verdorben (und dann nicht mehr essbar)"
                                        ],
                                        "tags": [
                                            "Lebensmittel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ccb1f68-cc97-4025-8bdb-ae88b695b00b",
                                                "sense_id": "837738dd-0f06-36a9-9b96-f074a885c95f",
                                                "text": "Weißweinessig ist durch seinen hohen Säuregehalt nicht verderblich."
                                            },
                                            {
                                                "example_id": "8b17513f-f1bf-409a-b828-5b60dd24d408",
                                                "sense_id": "837738dd-0f06-36a9-9b96-f074a885c95f",
                                                "text": "Frisches Obst und Gemüse sowie frische Kräuter aus Afrika, Amerika und Asien, die zudem leicht verderblich sind, gelangen meist per Flugzeug in die EU."
                                            },
                                            {
                                                "example_id": "1f7a99ec-5105-419e-9884-c68fab89fbb3",
                                                "sense_id": "837738dd-0f06-36a9-9b96-f074a885c95f",
                                                "text": "Mascarpone ist relativ schnell verderblich, weshalb er früher vor allem im Winter hergestellt wurde."
                                            },
                                            {
                                                "example_id": "fdb73679-3400-4e7c-a8c5-d5c699a5c441",
                                                "sense_id": "837738dd-0f06-36a9-9b96-f074a885c95f",
                                                "text": "Der hohe Zuckergehalt zusammen mit dem hohen Wassergehalt frischer Früchte macht sie [die Früchte der Edelkastanie] leicht verderblich."
                                            },
                                            {
                                                "example_id": "125f1b53-5435-4a9d-afd9-b6812e0b4fca",
                                                "sense_id": "837738dd-0f06-36a9-9b96-f074a885c95f",
                                                "text": "Der Massenkonsum [von Fisch] war überhaupt erst durch Kühltechnik und Tiefkühlindustrie möglich geworden, denn Meeresfrüchte sind schnell verderblich, da ihre Enzyme auch bei niedrigen Temperaturen wirksam sind und so die biochemischen Verfallsprozesse weiter gehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cabef10e-e763-3ace-b825-2c23fdc0a39f",
                                        "entry_id": "1e288930-496f-3e5c-9379-6fd374ba5201",
                                        "glosses": [
                                            "schädlich, einen schlechten Einfluss auf jemanden habend"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "363123af-2368-4aeb-a5af-802b295a5784",
                                                "sense_id": "cabef10e-e763-3ace-b825-2c23fdc0a39f",
                                                "text": "\"Jeder nor einen wenzigen Schlock\" (= \"Jeder nur einen winzigen Schluck\"): spätestens seit dem Film \"Die Feuerzangenbowle\" weiß man doch um die verderbliche Wirkung von Alkohol."
                                            },
                                            {
                                                "example_id": "7a04403e-adf8-477c-bbf5-ea4eaffa3672",
                                                "sense_id": "cabef10e-e763-3ace-b825-2c23fdc0a39f",
                                                "text": "Rousseau, der Luxus moralisch verderblich fand, würde heute wohl einen Bogen darum [um eine luxuriöse Hotelsuite] machen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
