                "senses": [
                    {
                        "sense_id": "d780d50a-cd90-3681-be01-7a7048aac8ec",
                        "entry_id": "9cba40d3-20e2-39b1-96e4-b7e8045c9168",
                        "glosses": [
                            "zbiór twierdzeń nieakceptowanych powszechnie przez środowisko naukowe, które aspirują do miana nauki"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2804d23e-1a53-4660-8caf-bca29832bcc8",
                        "source_entry_id": "9cba40d3-20e2-39b1-96e4-b7e8045c9168",
                        "source_sense_id": "d780d50a-cd90-3681-be01-7a7048aac8ec",
                        "target_lang_word": "pseudoscience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pseudoscience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63049034-2eea-3644-8572-792b0a373c30",
                                        "entry_id": "28dd00f5-eb2a-3b12-bfac-e1dba2524c39",
                                        "glosses": [
                                            "Any body of knowledge that purports to be scientific or to be supported by science (or may appear to be scientific) but which fails to comply with the scientific method (or rather, is not true science)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62270e65-a982-40d0-8987-2ea167ebf0ea",
                                                "sense_id": "63049034-2eea-3644-8572-792b0a373c30",
                                                "text": "The fantastical pseudo-science of alchemy has in all ages had its numerous votaries …"
                                            },
                                            {
                                                "example_id": "e116c7e3-8557-4e45-a9ad-567c608ff38f",
                                                "sense_id": "63049034-2eea-3644-8572-792b0a373c30",
                                                "text": "We had enough to do in this world. Life was a beautiful thing. The man who appreciated its real duties and beauties would have sufficient to employ him without dabbling in pseudo sciences which had their roots in frauds, exposed already a hundred times and yet finding fresh crowds of foolish devotees whose insane credulity and irrational prejudice made them impervious to all argument."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82037b4c-2a6d-381b-ad4c-43ca6996098c",
                                        "entry_id": "28dd00f5-eb2a-3b12-bfac-e1dba2524c39",
                                        "glosses": [
                                            "Fictitious science as portrayed in science fiction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20ef76ae-5a04-4e3c-b347-01cecd1dc162",
                                                "sense_id": "82037b4c-2a6d-381b-ad4c-43ca6996098c",
                                                "text": "It pulls together first-rate pseudo-science and high-grade detective meller of the Spillane school (but entirely clean) and the result is fine read-and-forget entertainment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "323a5618-7528-4378-8d60-6dcf18c2653a",
                        "source_entry_id": "9cba40d3-20e2-39b1-96e4-b7e8045c9168",
                        "source_sense_id": "d780d50a-cd90-3681-be01-7a7048aac8ec",
                        "target_lang_word": "pseudověda",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "80a0ca96-c763-4668-be00-c571f9ce3938",
                        "source_entry_id": "9cba40d3-20e2-39b1-96e4-b7e8045c9168",
                        "source_sense_id": "d780d50a-cd90-3681-be01-7a7048aac8ec",
                        "target_lang_word": "pseudo-science",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pseudo-science",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "309fa5b1-b526-3d45-91dc-6555bd3510ac",
                                        "entry_id": "7a8fcd4c-d00f-39a8-bc9d-24ccd95c340f",
                                        "glosses": [
                                            "Démarche ou croyance faussement scientifique qui ne respecte pas les méthodes, ni les buts de la science, mais qui en prend l’apparence et le vocabulaire pour tromper le public."
                                        ],
                                        "tags": [
                                            "Pseudo-sciences"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18ab989c-d010-4450-9c0c-cfdf20f0fa28",
                                                "sense_id": "309fa5b1-b526-3d45-91dc-6555bd3510ac",
                                                "text": "La sociobiologie pourrait n'être qu'un avatar amusant de l'histoire des religions ou des pseudo-sciences. Malheureusement ses excès et la place qu'elle a usurpée dans les médias et dans les instances scientifiques de quelques pays tend à faire oublier les progrès considérables de la neurobiologie, de la physiologie du comportement et de l'éthologie animale et humaine."
                                            },
                                            {
                                                "example_id": "c9f72a90-7dac-4796-8427-6e6b85cf2ada",
                                                "sense_id": "309fa5b1-b526-3d45-91dc-6555bd3510ac",
                                                "text": "On dira que le critère est trop large lorsqu'il mène à inclure dans les sciences ce que la plupart des philosophes regardent comme des « pseudo-sciences » : la parapsychologie ou la voyance, par exemple."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "611eb3b4-0b80-47f9-af45-016e47035a51",
                        "source_entry_id": "9cba40d3-20e2-39b1-96e4-b7e8045c9168",
                        "source_sense_id": "d780d50a-cd90-3681-be01-7a7048aac8ec",
                        "target_lang_word": "pseudociencia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pseudociencia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "4b7395e1-2848-3bff-a6d2-a128eac0e104",
                                        "entry_id": "8144b313-b211-3f39-9d19-d3d16c77c815",
                                        "glosses": [
                                            "Afirmación, creencia o práctica que, a pesar de presentarse como científica, no se basa en un método científico válido, le falta plausibilidad o el apoyo de evidencias científicas o no puede ser verificada de forma fiable."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a7e2cc0-752b-45cf-9ab9-8b7187851c4a",
                        "source_entry_id": "9cba40d3-20e2-39b1-96e4-b7e8045c9168",
                        "source_sense_id": "d780d50a-cd90-3681-be01-7a7048aac8ec",
                        "target_lang_word": "лженаука",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лженаука",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4de2fb5e-81f1-3054-b4bc-6bd0aa26f0e3",
                                        "entry_id": "124f15d1-604c-38f8-8abb-59dbf63b3f63",
                                        "glosses": [
                                            "то, что не является наукой, но выдаётся за неё"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc270898-3606-437e-b4f8-a019fd27bc6b",
                                                "sense_id": "4de2fb5e-81f1-3054-b4bc-6bd0aa26f0e3",
                                                "text": "Лжепрофессора принялись читать лженауку, ставили лжеопыты, выпускали лжеучебники, молодые приспособленцы защищали лжедиссертации."
                                            },
                                            {
                                                "example_id": "47b38a0c-0cca-44c7-8b6e-909dd8155370",
                                                "sense_id": "4de2fb5e-81f1-3054-b4bc-6bd0aa26f0e3",
                                                "text": "Давайте лучше поговорим о другой лженауке, также весьма популярной в своё время, о «родной сестре» физиогномики ― френологии."
                                            },
                                            {
                                                "example_id": "3365a5df-ef29-4c8d-a119-4d5dc04af76a",
                                                "sense_id": "4de2fb5e-81f1-3054-b4bc-6bd0aa26f0e3",
                                                "text": "Имею в виду, что на примере астрологии особенно ясно видны некоторые черты лженауки вообще."
                                            },
                                            {
                                                "example_id": "ec5e999f-e187-4aef-a659-b70816be3fba",
                                                "sense_id": "4de2fb5e-81f1-3054-b4bc-6bd0aa26f0e3",
                                                "text": "Научные и ненаучные утверждения не всегда легко разграничить ― мы постоянно сталкиваемся с паранаукой или лженаукой, когда ненаучные по существу воззрения подаются упакованными в научную терминологию."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
