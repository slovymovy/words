                    },
                    {
                        "form_id": "5b1349d7-7936-4c8d-a41a-2e652d964258",
                        "entry_id": "af5f7a01-5ae7-363a-b462-04bdb3d0ec00",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Panentheismus"
                    },
                    {
                        "form_id": "768da7b6-9c31-4ace-be07-e626e8e4d10d",
                        "entry_id": "af5f7a01-5ae7-363a-b462-04bdb3d0ec00",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Panentheismus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "10175d4b-4fe6-31ca-9447-652b72f10b2c",
                        "entry_id": "af5f7a01-5ae7-363a-b462-04bdb3d0ec00",
                        "glosses": [
                            "die Auffassung, dass die Welt beziehungsweise das Universum ein unmittelbarer Teil Gottes ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f4b6281-174f-42a5-88cc-b11e19ecc241",
                                "sense_id": "10175d4b-4fe6-31ca-9447-652b72f10b2c",
                                "text": "„Die «Allingottlehre» (so die Übersetzung für ‹Panentheismus› ) bewahrt im Gegensatz zum «Grundirrthum» des Pantheismus die Abhängigkeit der Welt von Gott und dessen Transzendenz.“"
                            },
                            {
                                "example_id": "af14a28e-f9c6-4355-b7c6-80291fff6d91",
                                "sense_id": "10175d4b-4fe6-31ca-9447-652b72f10b2c",
                                "text": "„Allgemein gilt Karl Christian Friedrich Krause (1828) als Schöpfer des Begriffs Panentheismus. Jedoch schreibt Novalis bereits 1798: «Die Zeit muß kommen, wo politischer Entheism und Pantheism als nothwendige Wechselglieder aufs innigste verbunden sein werden.»“."
                            },
                            {
                                "example_id": "3290c041-a3e7-4ee6-aad4-215611679f8a",
                                "sense_id": "10175d4b-4fe6-31ca-9447-652b72f10b2c",
                                "text": "„… und weil in der Wesenschauung erkannt wird, daß Gott auch Alles in, unter und durch sich ist, so könnte wohl die Wissenschaft Panentheismus genannt werden. Wenn man aber den unbestimmten Ausdruck: Panentheismus, so erklärt, dass jede Lehre Panentheismus sey, die da behauptete, dass die Welt und der Mensch, auch der menschliche Geist, auf irgendeine Weise in Gott seyen, so darf sich der Philosoph zu diesem Panentheismus bekennen.“."
                            },
                            {
                                "example_id": "effc45a9-7419-438d-82b3-15e559560860",
                                "sense_id": "10175d4b-4fe6-31ca-9447-652b72f10b2c",
                                "text": "„Der Begriff des Panentheismus wird auch auf die religionsphilosophischen Anschauungen Johann Wolfgang von Goethes angewandt, die in Fausts Aussage »Der Allumfasser, der Allerhalter, fasst und erhält er nicht dich, mich, sich selbst?« kulminieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "713905d2-966e-4954-8aa6-3c0a386a05ec",
                        "source_entry_id": "af5f7a01-5ae7-363a-b462-04bdb3d0ec00",
                        "source_sense_id": "10175d4b-4fe6-31ca-9447-652b72f10b2c",
                        "source_sense_description": "die Auffassung, dass die Welt beziehungsweise das Universum ein unmittelbarer Teil Gottes ist",
                        "target_lang_word": "panentheism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panentheism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f14f9df3-1a58-360e-885a-9586f75333c4",
                                        "entry_id": "183d8df8-9c2f-39ba-bfee-ef378e8bcd24",
                                        "glosses": [
                                            "A doctrine that the universe subsists within God, but that God nevertheless transcends or has some existence separate from the universe."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a41fae2-e7e3-4a50-93de-52beb94eed42",
                                                "sense_id": "f14f9df3-1a58-360e-885a-9586f75333c4",
                                                "text": "The third great age of humanity (das Reifalter) is that in which all its powers are fully and harmoniously developed... and in which panentheism is universally and cordially accepted as the only true and adequate doctrine either of science or of society."
                                            },
                                            {
                                                "example_id": "568721c7-6b82-4b0a-a358-8bb6b5bea563",
                                                "sense_id": "f14f9df3-1a58-360e-885a-9586f75333c4",
                                                "text": "Pantheism or panentheism... is condemned by the Church, as well as by the teachings of Schopenhauer and of the modern Hartmann."
                                            },
                                            {
                                                "example_id": "e81a44b3-f73a-4380-bae1-ab6ffcfe1d87",
                                                "sense_id": "f14f9df3-1a58-360e-885a-9586f75333c4",
                                                "text": "This panentheistic doctrine contains all of deism and pandeism except their arbitrary negations. Thus ARCW, or absolute-relative panentheism, is the one doctrine that really states the whole of what all theists, if not all atheists as well, are implicitly talking about."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6af5d85c-7fb7-34ea-9ace-08bdb137710b",
                                        "entry_id": "183d8df8-9c2f-39ba-bfee-ef378e8bcd24",
                                        "glosses": [
                                            "A belief in all gods."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "426b601d-b749-4279-ba5a-6e4f807337d5",
                        "source_entry_id": "af5f7a01-5ae7-363a-b462-04bdb3d0ec00",
                        "source_sense_id": "10175d4b-4fe6-31ca-9447-652b72f10b2c",
                        "source_sense_description": "die Auffassung, dass die Welt beziehungsweise das Universum ein unmittelbarer Teil Gottes ist",
                        "target_lang_word": "panenthéisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panenthéisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed977b9d-cce9-35ad-917a-c1c40966674c",
                                        "entry_id": "29c9887a-aabc-392e-afe8-97cea073c108",
                                        "glosses": [
                                            "Système philosophicoreligieux qui affirme avec le panthéisme la thèse selon laquelle Dieu contient en soi le monde, mais qui s’écarte de celui-ci et se rapproche du théisme dans la mesure où il soutient l’irréductibilité de Dieu par rapport au monde, et donc sa transcendance relative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e40f689-8311-4aaa-8ebc-9ee4e3ddc33f",
                                                "sense_id": "ed977b9d-cce9-35ad-917a-c1c40966674c",
                                                "text": "Le concept de panenthéisme s’est développé à la suite de la philosophie hégélienne au cours du XIXᵉ siècle dans le cadre de l’idéalisme allemand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
