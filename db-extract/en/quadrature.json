                                                "sense_id": "32716c66-052a-3598-8682-04fa78998c4f",
                                                "text": "„In der numerischen Mathematik bezeichnet numerische Integration (traditionell auch als numerische Quadratur bezeichnet) die näherungsweise Berechnung von Integralen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "91b76ff9-e68d-34c3-b014-e42e87644d3f",
                                        "entry_id": "561cea76-57a5-361d-b142-4655009548a4",
                                        "glosses": [
                                            "Verwandlung eines Flächeninhalts eines von Kurven begrenzten Bereiches in ein Quadrat mit gleichem Flächeninhalt, nur mit Hilfe eines Zirkels und Lineal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "450ab7a7-4a61-478c-b929-99823c70d79b",
                                                "sense_id": "91b76ff9-e68d-34c3-b014-e42e87644d3f",
                                                "text": "Die Quadratur des Rechtecks ist eine klassische Aufgabe der Geometrie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "515d7132-8cff-37d4-bbc0-686af8785f84",
                                        "entry_id": "561cea76-57a5-361d-b142-4655009548a4",
                                        "glosses": [
                                            "Konstellation, in der Himmelskörper einen geozentrischen Winkel von 90° bilden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3efbc9c2-4179-4a7c-9bb6-2f9e9bc2edb0",
                                                "sense_id": "515d7132-8cff-37d4-bbc0-686af8785f84",
                                                "text": "„Der Mond steht im ersten und letzten Viertel mit der Sonne in Quadratur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
