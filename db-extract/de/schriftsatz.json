                "senses": [
                    {
                        "sense_id": "efc6343c-bf6e-3b17-b4ed-165e48bfe72b",
                        "entry_id": "41b333b2-df20-3f61-ab8b-13bb4b14a8df",
                        "glosses": [
                            "Schriftstück mit amtlicher oder rechtlicher Geltung"
                        ],
                        "tags": [
                            "Rechtsprechung"
                        ],
                        "examples": [
                            {
                                "example_id": "c746fcfd-ec72-47f3-bbbd-5d47b7ee02e3",
                                "sense_id": "efc6343c-bf6e-3b17-b4ed-165e48bfe72b",
                                "text": "„Denn diese zielten ja nicht allein auf das Lesen und Schreiben, sondern auch auf eine Unterweisung in der Kunst des Abfassens von Schriftsätzen.“"
                            },
                            {
                                "example_id": "33c4ea5e-44ca-4d4b-a03c-4ad713476513",
                                "sense_id": "efc6343c-bf6e-3b17-b4ed-165e48bfe72b",
                                "text": "„Es ist erstaunlich, wie klar und gut leserlich zum Beispiel Schriftsätze aus dem frühen 17. Jahrhundert sind.“"
                            },
                            {
                                "example_id": "c9964887-9b72-4cd1-928d-8a135ba9ed1d",
                                "sense_id": "efc6343c-bf6e-3b17-b4ed-165e48bfe72b",
                                "text": "„Er knüllt den Schriftsatz zusammen und haut ihn auf den Tisch, daß die Tassen fliegen.“"
                            },
                            {
                                "example_id": "2eea4bf0-02ee-469a-98fa-a86e5220fc7f",
                                "sense_id": "efc6343c-bf6e-3b17-b4ed-165e48bfe72b",
                                "text": "„Wieland war daran mit einen Schriftsätzen unmittelbar beteiligt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
