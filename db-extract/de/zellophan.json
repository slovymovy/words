                            {
                                "target_word": "cellophane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcd81ecb-52ca-380b-96de-a7ea1cee60b9",
                                        "entry_id": "e7c74629-675d-3e0e-ae26-64f632a76106",
                                        "glosses": [
                                            "Any of a variety of transparent plastic films, especially one made of processed cellulose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c39c6da5-3892-4520-afbb-33e6cef01510",
                                                "sense_id": "fcd81ecb-52ca-380b-96de-a7ea1cee60b9",
                                                "text": "Cellophane flowers of yellow and green towering over your head"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cellophane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28e86119-578e-3b98-be39-731e1f2bea52",
                                        "entry_id": "672c5624-b164-38c1-9765-9a5f9f8bb989",
                                        "glosses": [
                                            "To wrap or package in cellophane."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "069bffa9-ee89-42d5-9a38-9b145855330f",
                        "source_entry_id": "7aadf80f-ee17-3b2e-96a9-3be528102b3e",
                        "source_sense_id": "6adfbf45-760f-34f9-bb88-cf09dae9f14d",
                        "source_sense_description": "dünne Kunststofffolie, die glasklar durchsichtig ist",
                        "target_lang_word": "cellophane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cellophane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a3ec0a0-29ef-3c4e-a196-19e5a9ac95b2",
                                        "entry_id": "74d45c4e-043c-3316-98c4-643116bd69bc",
                                        "glosses": [
                                            "Pellicule fine et transparente constituée d’hydrate de cellulose, utilisée pour certains emballages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "894bcecf-8bd9-4907-81b8-f8fa0544d5c6",
                                                "sense_id": "8a3ec0a0-29ef-3c4e-a196-19e5a9ac95b2",
                                                "text": "Au milieu des livres, j’ai découvert ce livre d’images. Il était enveloppé de cellophane et entouré d’une ficelle dorée."
                                            },
                                            {
                                                "example_id": "ced4e1c5-aaa4-4d89-9b12-148f6d864207",
                                                "sense_id": "8a3ec0a0-29ef-3c4e-a196-19e5a9ac95b2",
                                                "text": "Le présent et le passé se confondent, et cela semble naturel puisqu’ils n'étaient séparés que par une paroi de cellophane. Il suffisait d’une piqûre d’insecte pour crever la cellophane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "036ee58c-1aa2-314a-a819-4a8e50005906",
                                        "entry_id": "74d45c4e-043c-3316-98c4-643116bd69bc",
                                        "glosses": [
                                            "Tout film plastique transparent qui sert à l’emballage, même si ce n’est pas à proprement parler de la cellophane, mais plus souvent du polyéthylène ou du PVC."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b72dff1e-10da-442d-86e3-1d8ba0bd11ab",
                                                "sense_id": "036ee58c-1aa2-314a-a819-4a8e50005906",
                                                "text": "On est vraiment de l’autre côté des Pyrénées. Un petit café noir. Café negro. Il y a tout un assortiment de biscuits collants, de pâtisseries compactes, d’étouffe-chrétiens emballés sous cellophane, conditionnés."
                                            },
                                            {
                                                "example_id": "c0c3c5c9-7ed8-42cd-ade3-01ace408701a",
                                                "sense_id": "036ee58c-1aa2-314a-a819-4a8e50005906",
                                                "text": "Puis, les allées et venues des moineaux au rayon des pâtes, en face de sa caisse, retiennent son attention. Les piafs se faufilent sous les comptoirs et les plus culottés s'attaquent aux paquets de cellophane sous les rayons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
