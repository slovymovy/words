                "senses": [
                    {
                        "sense_id": "b21b13d1-219b-3456-b393-2db56ebfa2fd",
                        "entry_id": "5573902a-cba5-3a28-89d0-f7aa78cf5618",
                        "glosses": [
                            "Gesamtheit der Ausrüstungsgegenstände für ein bestimmtes Vorhaben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a35d0f3-68ad-4ab7-9a65-1f4fdb4b95ac",
                                "sense_id": "b21b13d1-219b-3456-b393-2db56ebfa2fd",
                                "text": "Das Equipment war für diese gefährliche Unternehmung nicht ausreichend."
                            },
                            {
                                "example_id": "b6d84753-2448-4cbd-9a2c-d4a549a0dd65",
                                "sense_id": "b21b13d1-219b-3456-b393-2db56ebfa2fd",
                                "text": "„Er unterschied sich nicht signifikant vom anderen Equipment.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78ff9284-db86-4e74-b084-2425391406f3",
                        "source_entry_id": "5573902a-cba5-3a28-89d0-f7aa78cf5618",
                        "source_sense_id": "b21b13d1-219b-3456-b393-2db56ebfa2fd",
                        "source_sense_description": "Gesamtheit der Ausrüstungsgegenstände für ein bestimmtes Vorhaben",
                        "target_lang_word": "equipment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "equipment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9b72a87-943e-3e65-b24b-a1b2749a0e76",
                                        "entry_id": "a50588fd-fc67-324d-a4e8-9573e15cba0a",
                                        "glosses": [
                                            "The act of equipping, or the state of being equipped, as for a voyage or expedition."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bc28791-9dce-4934-a86e-1d48bb263b60",
                                                "sense_id": "d9b72a87-943e-3e65-b24b-a1b2749a0e76",
                                                "text": "The equipment of the fleet was therefore hastened by de Witt ; in hopes that , by striking at first a successful blow , he might inspire courage into the dismayed States"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                        "entry_id": "a50588fd-fc67-324d-a4e8-9573e15cba0a",
                                        "glosses": [
                                            "Any items used in equipping something or someone, for example things needed for an expedition or voyage."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a95e163-8cc9-4283-a135-9f12d3b13ef2",
                                                "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                                "text": "We need more gardening equipment if we want to properly landscape our yard, not just a rake and some gloves."
                                            },
                                            {
                                                "example_id": "72d04ec0-c08a-47f7-9713-c6b2ee67bf2a",
                                                "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                                "text": "The sports shop sells different kits of famous clubs, and equipment from all kind of sports."
                                            },
                                            {
                                                "example_id": "124b0ea7-6398-4553-8d53-ddb688c00592",
                                                "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                                "text": "Tompkins is considered a hero in the deep ecology movement and works hand in hand with his wife Kris, the former CEO of the outdoor clothing and equipment company Patagonia."
                                            },
                                            {
                                                "example_id": "ef7a840c-130a-43de-b4f9-c5f966a6f1c6",
                                                "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                                "text": "Armed and dight, In the equipments of a knight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d3e1b7c-1187-38ff-8e1a-efd3cf00bddf",
                                        "entry_id": "a50588fd-fc67-324d-a4e8-9573e15cba0a",
                                        "glosses": [
                                            "The male genitalia."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46ce009d-1f83-49df-92b0-0c7b08d28902",
                                                "sense_id": "2d3e1b7c-1187-38ff-8e1a-efd3cf00bddf",
                                                "text": "The segment advises the reader matter-of-factly that “the penis [of a whale] should be tucked inside the body and when needed enlarged into an erection”. At the very least, the statement sounds odd. At most, it could make human penis owners consider that their equipment might not represent the highest evolutionary ideal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a100a79-0df8-4b9e-9ee2-c40e6799005e",
                        "source_entry_id": "5573902a-cba5-3a28-89d0-f7aa78cf5618",
                        "source_sense_id": "b21b13d1-219b-3456-b393-2db56ebfa2fd",
                        "source_sense_description": "Gesamtheit der Ausrüstungsgegenstände für ein bestimmtes Vorhaben",
                        "target_lang_word": "équipement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "équipement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6f235f1-ada9-363f-99a9-3cadcf54a88c",
                                        "entry_id": "7dc2f664-936d-3884-be1d-a988db8b6a1e",
                                        "glosses": [
                                            "Action d’équiper un vaisseau, une flotte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "728080de-5e4b-42fd-a9d9-29d2a0c11184",
                                                "sense_id": "e6f235f1-ada9-363f-99a9-3cadcf54a88c",
                                                "text": "L’équipement de ce vaisseau a coûté cher."
                                            },
                                            {
                                                "example_id": "f2e1d984-f2db-491f-a3e7-2d745386f643",
                                                "sense_id": "e6f235f1-ada9-363f-99a9-3cadcf54a88c",
                                                "text": "On ordonna l’équipement de la flotte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1b4fad7-189d-30be-b6bc-a13283810240",
                                        "entry_id": "7dc2f664-936d-3884-be1d-a988db8b6a1e",
                                        "glosses": [
                                            "Action d’équiper des soldats en armes, uniformes, linge, chaussures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10df3487-ac99-4d18-8f9b-aac4a964afd7",
                                                "sense_id": "f1b4fad7-189d-30be-b6bc-a13283810240",
                                                "text": "L’équipement de nouveaux bataillons."
                                            },
                                            {
                                                "example_id": "4dd35380-be4a-4c9b-a13a-fe22e852186f",
                                                "sense_id": "f1b4fad7-189d-30be-b6bc-a13283810240",
                                                "text": "Frais d’équipement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9ac1368-499e-362e-ae1b-899ecb0babcc",
                                        "entry_id": "7dc2f664-936d-3884-be1d-a988db8b6a1e",
                                        "glosses": [
                                            "Ce qui sert à équiper."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "271ed331-ea0e-4136-9525-edde5aee89d2",
                                                "sense_id": "a9ac1368-499e-362e-ae1b-899ecb0babcc",
                                                "text": "L'appareil Sparton ? Vous l'avez peut-être déjà vu sur des voitures américaines circulant en France, ou sur les Bellanger, les Fiat qui l'ont déjà adopté pour leur équipement de série."
                                            },
                                            {
                                                "example_id": "1bc8b924-98f7-4fb8-af0b-3cc9a2d8269d",
                                                "sense_id": "a9ac1368-499e-362e-ae1b-899ecb0babcc",
                                                "text": "De nos jours, ces obstacles ont été levés grâce à la création des quatre pièces de base de l’équipement servant à l’immersion en apnée: le masque, les palmes, le tuba et la combinaison de plongeur."
                                            },
                                            {
                                                "example_id": "86eb1bf4-9ccf-47be-8c30-7fa87d56a056",
                                                "sense_id": "a9ac1368-499e-362e-ae1b-899ecb0babcc",
                                                "text": "En réfléchissant différemment sur l’installation des équipements, en refusant d’utiliser les équipements disponibles sur étagère, en traquant les poids inutiles, nous avons réussi à gagner 300 kilos sur le bateau proposé par les architectes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abd993ba-24f0-3a01-9187-e31b52091171",
                                        "entry_id": "7dc2f664-936d-3884-be1d-a988db8b6a1e",
                                        "glosses": [
                                            "Matériel, accessoire ou moyen destiné à un usage ou domaine défini."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d9eb6ef-2bbf-486e-856c-f3accc348b21",
                                                "sense_id": "abd993ba-24f0-3a01-9187-e31b52091171",
                                                "text": "Le matériel est plus onéreux pour la pêche de la crevette grise et les pêches au filet, car il ne faut pas hésiter à investir dans un équipement résistant en évitant les vagues imitations vendues dans les bazars de plage, qui rendront l'âme dès votre première sortie."
                                            },
                                            {
                                                "example_id": "04c28519-e930-4d38-8269-4380edd3e5bf",
                                                "sense_id": "abd993ba-24f0-3a01-9187-e31b52091171",
                                                "text": "Qu'est-ce que vous voliez de préférences dans les autoréduction ?\n Le plus cher, comme les produits fins : […]. De l’équipement aussi : une fois on a pris une disqueuse et une perceuse-visseuse dans une grande surface de bricolage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcd35104-bb62-4bed-8fbc-3fe13bd681f8",
                        "source_entry_id": "5573902a-cba5-3a28-89d0-f7aa78cf5618",
