                        "form": "озелени́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "debbac02-f085-3667-a37f-151093cde7cd",
                        "entry_id": "ed0196f6-8204-3573-a169-d1718b7465a7",
                        "glosses": [
                            "произвести где-либо посадку растений (обычно — деревьев, кустарников); украсить зелёными насаждениями"
                        ],
                        "tags": [
                            "что"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f6d271e-d29a-465a-a65b-8b8e90f03ce9",
                        "source_entry_id": "ed0196f6-8204-3573-a169-d1718b7465a7",
                        "source_sense_id": "debbac02-f085-3667-a37f-151093cde7cd",
                        "target_lang_word": "planter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "planter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "763052a8-b5fe-3548-a8c2-79dcf58ac27d",
                                        "entry_id": "9927b3ce-0b4d-3a2c-add5-387fcc7d0f7d",
                                        "glosses": [
                                            "Fixer une plante en terre pour qu’elle prenne racine et qu’elle croisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17714da6-a8f0-4e8a-804c-552a95aab61c",
                                                "sense_id": "763052a8-b5fe-3548-a8c2-79dcf58ac27d",
                                                "text": "Dans les vergers ou les terrains vagues, où l’on ne compte pas sur la récolte du sol, on plante en général 200 pommiers ou poiriers par hectare."
                                            },
                                            {
                                                "example_id": "a90e44cf-13a5-4656-bbd6-84176610608f",
                                                "sense_id": "763052a8-b5fe-3548-a8c2-79dcf58ac27d",
                                                "text": "La solution se trouve dans les jardins disséminés çà et là. Beaucoup d’habitants y passent une partie de la journée, devisant joyeusement de parcelle à parcelle en plantant des salades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f75091d0-3852-31a5-a995-3d6da67cc273",
                                        "entry_id": "9927b3ce-0b4d-3a2c-add5-387fcc7d0f7d",
                                        "glosses": [
                                            "Garnir d’arbres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b72ae8f-e844-4ff2-9abc-5911a564054e",
                                                "sense_id": "f75091d0-3852-31a5-a995-3d6da67cc273",
                                                "text": "Planter un bois, une allée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25fb71af-5a98-37ca-962b-97ed6914a6bf",
                                        "entry_id": "9927b3ce-0b4d-3a2c-add5-387fcc7d0f7d",
                                        "glosses": [
                                            "Planter des plantes."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa7ae03b-e225-4712-8879-41f628229ce7",
                                                "sense_id": "25fb71af-5a98-37ca-962b-97ed6914a6bf",
                                                "text": "Il aime beaucoup à planter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8d8df8b-f72a-3613-8cab-dadfec03376f",
                                        "entry_id": "9927b3ce-0b4d-3a2c-add5-387fcc7d0f7d",
                                        "glosses": [
                                            "Mettre en terre avec la main, au lieu de semer des graines ou des grains par poignée, et aussi pour des bulbes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d483aa29-7f53-4c9c-835e-7cc9498d388f",
                                                "sense_id": "d8d8df8b-f72a-3613-8cab-dadfec03376f",
                                                "text": "Planter des noyaux, des pépins."
                                            },
                                            {
                                                "example_id": "8fd1dd0e-4024-4029-9e50-b6bdcf866500",
                                                "sense_id": "d8d8df8b-f72a-3613-8cab-dadfec03376f",
                                                "text": "Planter des pois, des fèves, etc."
                                            },
                                            {
                                                "example_id": "837f77bc-0e91-410e-bc2f-86fb1590e7b5",
                                                "sense_id": "d8d8df8b-f72a-3613-8cab-dadfec03376f",
                                                "text": "Planter des bulbes d'oignon ou des patates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af2e192a-f520-38b6-bdf0-422230602679",
                                        "entry_id": "9927b3ce-0b4d-3a2c-add5-387fcc7d0f7d",
                                        "glosses": [
                                            "Enfoncer en terre en laissant paraître une partie en dehors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4051491-da84-4187-aa6d-64daba5af90f",
                                                "sense_id": "af2e192a-f520-38b6-bdf0-422230602679",
                                                "text": "Planter des bornes, un poteau, un piquet, des jalons, une croix, …"
                                            },
                                            {
                                                "example_id": "dcb8fa46-80dd-45e3-9452-15222ac27a6d",
                                                "sense_id": "af2e192a-f520-38b6-bdf0-422230602679",
                                                "text": "Planter un étendard, un drapeau, L’arborer sur les remparts d’une ville prise d’assaut, au moment où l’on y entre."
                                            },
                                            {
                                                "example_id": "ae74c44d-303b-4568-9d93-4499531abae5",
                                                "sense_id": "af2e192a-f520-38b6-bdf0-422230602679",
                                                "text": "Planter l’étendard de la croix dans un pays, Y introduire la religion chrétienne."
                                            },
                                            {
                                                "example_id": "d6ee7a5c-54e0-4395-a636-e8119d5d5dce",
                                                "sense_id": "af2e192a-f520-38b6-bdf0-422230602679",
                                                "text": "Planter sa tente, S’établir quelque part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29675aaa-e88f-3218-974c-ff21122ee72d",
                                        "entry_id": "9927b3ce-0b4d-3a2c-add5-387fcc7d0f7d",
                                        "glosses": [
                                            "Enfoncer un objet pointu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "775fb684-a292-4d56-8922-08ec5649fc6c",
                                                "sense_id": "29675aaa-e88f-3218-974c-ff21122ee72d",
                                                "text": "Planter son couteau dans la table"
                                            },
                                            {
                                                "example_id": "8a58ad4c-5ec6-4222-98ff-3c38d5e4c1f0",
                                                "sense_id": "29675aaa-e88f-3218-974c-ff21122ee72d",
                                                "text": "Planter un clou"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20504292-19e6-353c-b5e3-3e22f00d300c",
                                        "entry_id": "9927b3ce-0b4d-3a2c-add5-387fcc7d0f7d",
                                        "glosses": [
                                            "Poignarder."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64c15071-c433-410e-a35e-ef3ce1c3e557",
                                                "sense_id": "20504292-19e6-353c-b5e3-3e22f00d300c",
                                                "text": "Évidemment, c’est mieux de planter un méchant, ça fait moins de peine, on a l’impression de participer à une opération ville propre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99fa84f2-61f9-3689-87c8-e3f8512ec07f",
                                        "entry_id": "9927b3ce-0b4d-3a2c-add5-387fcc7d0f7d",
                                        "glosses": [
                                            "Disposer un décor sur la scène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2c2e59e-405d-4f4a-a3b3-bac1b1b47492",
                                                "sense_id": "99fa84f2-61f9-3689-87c8-e3f8512ec07f",
                                                "text": "Planter un décor."
                                            },
                                            {
                                                "example_id": "a3c90ecc-1b44-43d5-802c-b189cc871582",
                                                "sense_id": "99fa84f2-61f9-3689-87c8-e3f8512ec07f",
                                                "text": "Planter un édifice, Faire les premiers travaux pour la construction d’un édifice."
                                            },
                                            {
                                                "example_id": "06aaf4a4-c64b-4b62-907c-b2eb8e109339",
                                                "sense_id": "99fa84f2-61f9-3689-87c8-e3f8512ec07f",
                                                "text": "Être planté quelque part, être dans quelque lieu sans en bouger ou s’en éloigner.",
                                                "translation": "Et ils restèrent plantés, serrés les uns contre les autres, tout en noir, achevant les vieux vêtements du deuil de leur père.— (Émile Zola, Au Bonheur des Dames, 1883, Éditions Gallimard, 1980, page 29 ISBN 2070409309)"
                                            },
                                            {
                                                "example_id": "9a569783-490d-431f-ae0b-db9245383313",
                                                "sense_id": "99fa84f2-61f9-3689-87c8-e3f8512ec07f",
                                                "text": "J’étais planté là à vous attendre. On dit aussi"
                                            },
                                            {
                                                "example_id": "ff41f19d-036c-4694-aa80-68c616840403",
                                                "sense_id": "99fa84f2-61f9-3689-87c8-e3f8512ec07f",
                                                "text": "Planter une personne en quelque endroit, L’y aposter, l’y mettre en observation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81e42b0e-80e3-3de4-af35-e192430ddffd",
                                        "entry_id": "9927b3ce-0b4d-3a2c-add5-387fcc7d0f7d",
                                        "glosses": [
                                            "Quitter, abandonner quelqu'un ou quelque chose, s'en séparer, ne vouloir plus en avoir affaire."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38aaa26a-5769-41c7-9e31-2ff5fe1c27d7",
                                                "sense_id": "81e42b0e-80e3-3de4-af35-e192430ddffd",
                                                "text": "Au bout de huit jours, ou elle m’ennuie, je la plante là, ou elle me plaît trop, elle le voit, et se moque de moi."
                                            },
                                            {
                                                "example_id": "1826ecd6-47c8-4ec3-bd09-77f37407c020",
                                                "sense_id": "81e42b0e-80e3-3de4-af35-e192430ddffd",
                                                "text": "Je la rendrais malheureuse d’ailleurs, horriblement malheureuse ; le beau profit ! Le lendemain de mes noces, elle serait jalouse, elle aurait tort. Six mois après, elle aurait raison. Je la planterais là, je serais impitoyable ; je me connais, et j’en suis sûr."
                                            },
                                            {
                                                "example_id": "365c837b-3f16-4f02-9f23-91a3e5123456",
                                                "sense_id": "81e42b0e-80e3-3de4-af35-e192430ddffd",
                                                "text": "— J’ai planté là madame la baronne, continua mademoiselle Clara, et je suis entrée chez madame Donis."
                                            },
                                            {
                                                "example_id": "2139b706-8d18-4ca4-b2b0-63becbff6696",
                                                "sense_id": "81e42b0e-80e3-3de4-af35-e192430ddffd",
                                                "text": "— Vous ne pouvez pas nous lâcher si près du but ! On y est presque !\n— Je plante la tente, je peux planter les sœurs…"
                                            },
                                            {
                                                "example_id": "cd8253e1-1eb9-49c0-b61a-3e0f943aea86",
                                                "sense_id": "81e42b0e-80e3-3de4-af35-e192430ddffd",
                                                "text": "Si vous ne voulez pas faire ce que je vous dis, je vous planterai là et ne me mêlerai plus de vos affaires."
                                            },
                                            {
                                                "example_id": "44e7f760-13ea-48b6-a41c-a6e86b5d3fff",
                                                "sense_id": "81e42b0e-80e3-3de4-af35-e192430ddffd",
                                                "text": "« Comment t’es arrivée là ?\n— J’ai planté mon ex quand j’ai su qu’il avait une poule. »"
                                            },
                                            {
                                                "example_id": "34a62b4d-b48f-47ec-9e26-db13ff6e68ea",
                                                "sense_id": "81e42b0e-80e3-3de4-af35-e192430ddffd",
                                                "text": "Il a planté là les vers, la musique."
                                            },
                                            {
                                                "example_id": "c167248e-2e30-40b1-9888-b74440857f09",
                                                "sense_id": "81e42b0e-80e3-3de4-af35-e192430ddffd",
                                                "text": "Il a aussitôt planté là son travail et s’en est allé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09971af8-6ad8-3ce6-9ece-1cfdb3bcd957",
                                        "entry_id": "9927b3ce-0b4d-3a2c-add5-387fcc7d0f7d",
                                        "glosses": [
                                            "Se faire battre, employé sous la forme se faire planter."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14eea869-3615-4a88-86a9-e590e0ca6b4b",
                                                "sense_id": "09971af8-6ad8-3ce6-9ece-1cfdb3bcd957",
                                                "text": "« Pis, t’as-tu gagné ta game d’hockey?'\n— Pentoute. On s’est fait planter cinq à zéro. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ba9682b-b4d5-3324-a5b7-d2d457d2d162",
                                        "entry_id": "9927b3ce-0b4d-3a2c-add5-387fcc7d0f7d",
                                        "glosses": [
                                            "Se dit d’un ordinateur ou d'un logiciel lorsqu’il rencontre une erreur le rendant inutilisable."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f912cc9-b6ca-42e1-9388-fdb789ae535b",
                                                "sense_id": "0ba9682b-b4d5-3324-a5b7-d2d457d2d162",
                                                "text": "Ce logiciel a planté, il faut que je redémarre mon ordinateur"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99a95ca5-1df8-32db-ac98-73f98a535786",
                                        "entry_id": "9927b3ce-0b4d-3a2c-add5-387fcc7d0f7d",
                                        "glosses": [
                                            "Se tromper, ne pas réussir une épreuve, un travail, se perdre en cours de route…"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "655eb6b1-4774-486a-b4fa-8c6379d57ed1",
                                                "sense_id": "99a95ca5-1df8-32db-ac98-73f98a535786",
                                                "text": "Le résultat n'est pas bon, je me suis planté dans mes calculs."
                                            },
                                            {
                                                "example_id": "76f7af9a-1fed-4265-b351-f6f48f70c2a5",
                                                "sense_id": "99a95ca5-1df8-32db-ac98-73f98a535786",
                                                "text": "Je me suis lamentablement planté à mon contrôle."
                                            },
                                            {
