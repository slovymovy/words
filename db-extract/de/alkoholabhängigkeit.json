                "senses": [
                    {
                        "sense_id": "c3ce5f29-5c38-3c39-af8f-0d9e0e522073",
                        "entry_id": "5693f376-b9a6-3605-8180-62de689af8e8",
                        "glosses": [
                            "Dépendance à l’alcool, addiction à l’alcool, alcoolodépendance, alcoolisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e77dffb-10a8-4eab-af69-335f6722fb92",
                                "sense_id": "c3ce5f29-5c38-3c39-af8f-0d9e0e522073",
                                "text": "Wegen seiner Alkoholabhängigkeit ließ er sich in eine Entziehungsanstalt einweisen.",
                                "translation": "À cause de sa dépendance à l’alcool, il s’est fait interner dans un établissement de désintoxication."
                            },
                            {
                                "example_id": "ca7bf614-c558-4234-99e8-3fcf2c0b14f4",
                                "sense_id": "c3ce5f29-5c38-3c39-af8f-0d9e0e522073",
                                "text": "Alkoholabhängigkeit ist die häufigste psychische Krankheit bei Männern in den westlichen Industrienationen.",
                                "translation": "L’alcoolodépendance est la maladie psychique la plus fréquente chez les hommes dans les nations industrielles occidentales."
                            }
                        ]
                    }
                ],
