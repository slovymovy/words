                    },
                    {
                        "translation_id": "504f99c1-6c9c-423d-b0d7-afae550ac54b",
                        "source_entry_id": "ea6efe15-98ef-3634-a4b5-ca01fe2e3a3f",
                        "source_sense_description": "device that electrifies or electrocutes",
                        "target_lang_word": "Elektroschocker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elektroschocker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4b3fd03-c4a6-37c2-a917-284ddb2bf1a1",
                                        "entry_id": "437b14d5-dab0-3fc3-b60b-ddc8fcb6d310",
                                        "glosses": [
                                            "Waffe, die eine Person durch Elektroschocks kampfunfähig machen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83658216-48bb-4898-b022-562353d60b29",
                                                "sense_id": "b4b3fd03-c4a6-37c2-a917-284ddb2bf1a1",
                                                "text": "„Der 38-Jährige habe eine Gaspistole mit Schalldämpfer und einen Elektroschocker bei sich gehabt, berichtete die Polizei damals.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83128a6a-87a7-47d3-ba25-9c0cf0c3d312",
                        "source_entry_id": "ea6efe15-98ef-3634-a4b5-ca01fe2e3a3f",
                        "source_sense_description": "device that electrifies or electrocutes",
                        "target_lang_word": "Elektroschockgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "771f2344-53e5-4ded-b2ad-038eb699fab7",
                        "source_entry_id": "ea6efe15-98ef-3634-a4b5-ca01fe2e3a3f",
                        "source_sense_description": "anything that exterminates",
                        "target_lang_word": "Vernichter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vernichter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e332326d-c4bc-333f-b52e-b0ff7846fd57",
                                        "entry_id": "d727cf81-9f59-3c0c-af11-be7f698c71d9",
                                        "glosses": [
                                            "jemand, der etwas in unbrauchbaren oder nicht mehr vorhandenen Zustand überführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81129429-37b0-465a-aa47-17882ad77a89",
                                                "sense_id": "e332326d-c4bc-333f-b52e-b0ff7846fd57",
                                                "text": "„In den ‚Buddenbrooks‘ sind die Lehrer grausame oder lächerliche Vernichter der Kindheit.“"
                                            },
                                            {
                                                "example_id": "a31863ff-f8d9-4633-8757-a56dade0c1a3",
                                                "sense_id": "e332326d-c4bc-333f-b52e-b0ff7846fd57",
                                                "text": "„Seine zweifelhafte Doppelfunktion brachte ihm im Jahr 2005 ‚Die goldene Kettensäge‘ ein, die alljährlich von Greenpeace an den größten Vernichter von Regenwald verliehen wird.“"
                                            },
                                            {
                                                "example_id": "a8625f9b-c9e2-48b7-96cf-5c089d223a5f",
                                                "sense_id": "e332326d-c4bc-333f-b52e-b0ff7846fd57",
                                                "text": "„Aber wir haben noch dich, den Vernichter. Übe unseren Willen aus und setzte allem ein Ende! Die Sonne hast du bereits gestohlen.“"
                                            },
                                            {
                                                "example_id": "627fa47a-7001-41f8-a543-69f7794232da",
                                                "sense_id": "e332326d-c4bc-333f-b52e-b0ff7846fd57",
                                                "text": "„Es existieren nicht wenige Filme und noch viel mehr Romane, in denen [Südamerikanische Wanderameisen] eine unrühmliche Nebenrolle spielen als Vernichter ganze Vieherden [sic!], die auch vor menschlichen Opfern nicht Halt machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
