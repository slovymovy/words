                "senses": [
                    {
                        "sense_id": "167de3c5-5457-3c3d-886b-fefdfa856869",
                        "entry_id": "259735b3-e34b-364f-a04c-71832b4826ae",
                        "glosses": [
                            "Donner un caractère pragmatique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "368ec63e-163b-421e-b74c-6842cef3aac7",
                                "sense_id": "167de3c5-5457-3c3d-886b-fefdfa856869",
                                "text": "Dans le cadre de l'Ingénierie Ontologique, pragmatiser va consister à enrichir la sémantique formelle intrinsèque d'une ontologie de domaine à l'aide d'éléments caractéristiques d'un contexte de création ou d'usage."
                            },
                            {
                                "example_id": "d3775a05-2f04-40af-ac2c-66eb92156163",
                                "sense_id": "167de3c5-5457-3c3d-886b-fefdfa856869",
                                "text": "Penser, c'est du même coup syntaxiser, sémantiser et pragmatiser, ou resyntaxiser, resémantiser et repragmatiser."
                            },
                            {
                                "example_id": "77bbdb91-fb2f-43a6-9acc-a06566d0dc6e",
                                "sense_id": "167de3c5-5457-3c3d-886b-fefdfa856869",
                                "text": "L'autre aspect difficile à conceptualiser d'une part et à pragmatiser d'autre part, tout en étant primordial, est celui de sa connotation anthropologique."
                            }
                        ]
                    }
                ],
