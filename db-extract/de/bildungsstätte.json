                ],
                "senses": [
                    {
                        "sense_id": "bc7665ac-0834-3dd0-84a4-43748a186305",
                        "entry_id": "cfd6c0be-7854-3d22-ab0e-e5b934e90db1",
                        "glosses": [
                            "Einrichtung/Institution, die der Bildung/Ausbildung der Bevölkerung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dcd4a10-eabc-498d-bc7e-00023f3cd107",
                                "sense_id": "bc7665ac-0834-3dd0-84a4-43748a186305",
                                "text": "Die Universität ist eine Bildungsstätte."
                            },
                            {
                                "example_id": "22a38f7f-6265-43de-9937-a33f95a45ae6",
                                "sense_id": "bc7665ac-0834-3dd0-84a4-43748a186305",
                                "text": "„Die Bildungsstätte Anne Frank in Frankfurt will im nächsten Jahr die Beratungsstelle ‚Response‘ für Opfer rechter und rassistischer Gewalt eröffnen.“"
                            },
                            {
                                "example_id": "13580788-51e5-44c3-8e16-4cdbfe8330f1",
                                "sense_id": "bc7665ac-0834-3dd0-84a4-43748a186305",
                                "text": "„Er hatte von 1982 bis 1985 einen entsprechenden Kurs an einer Bildungsstätte der SED-Bezirksleitung Sachsen in Leipzig absolviert.“"
                            },
                            {
                                "example_id": "32d07676-cbee-4f33-b26d-09cc6b8d1c42",
                                "sense_id": "bc7665ac-0834-3dd0-84a4-43748a186305",
                                "text": "„Wegen der steigenden Geburtenzahl, des Zuzugs, der Entwicklung neuer und der Nachverdichtung bestehender Wohngebiete müssten weiterhin Krippen, Kindergärten und Horte sowie Bildungsstätten von der Grundschule bis zur Berufsschule geplant, gebaut und eröffnet werden.“"
                            },
                            {
                                "example_id": "d12c6404-59e1-4193-88ea-eca686745035",
                                "sense_id": "bc7665ac-0834-3dd0-84a4-43748a186305",
                                "text": "„Die Stadt Frankfurt muss in den nächsten Jahren Bildungsstätten im Akkord eröffnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
