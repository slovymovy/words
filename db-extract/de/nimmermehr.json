                                        "examples": [
                                            {
                                                "example_id": "a9cabe24-c462-467c-a86b-4055c0168caa",
                                                "sense_id": "b538900d-f83d-3aeb-80a6-9c6199fb2f0e",
                                                "text": "And my soul from out that shadow that lies floating on the floor\n Shall be lifted—nevermore!"
                                            }
