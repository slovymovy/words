    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2f0c12de-13f2-38c9-9ae2-db8225e559d9",
                    "sense_definition": "Worth having or doing because it is pleasing, useful, or good.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A stable economy is highly <w>desirable</w> for the country's growth.",
                            "target_lang_translations": {
                                "ru": "Стабильная экономика весьма <w>желательна</w> для роста страны.",
                                "de": "Eine stabile Wirtschaft ist für das Wachstum des Landes äußerst <w>wünschenswert</w>."
                            }
                        },
                        {
                            "text": "The apartment is in a <w>desirable</w> location near the park.",
                            "target_lang_translations": {
                                "ru": "Квартира находится в <w>привлекательном</w> месте рядом с парком.",
                                "de": "Die Wohnung befindet sich in einer <w>begehrten</w> Lage nahe dem Park."
                            }
                        }
                    ],
                    "synonyms": [
                        "attractive",
                        "pleasing",
                        "agreeable"
                    ],
                    "antonyms": [
                        "undesirable"
                    ],
                    "common_phrases": [
                        "highly desirable",
                        "desirable effect",
                        "desirable outcome"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что стоит иметь или сделать, так как это приятно, полезно или хорошо.",
                        "de": "So beschaffen, dass man es haben oder tun möchte, weil es nützlich, vorteilhaft oder attraktiv ist."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "желательный",
                                "target_lang_sense_clarification": "полезный, целесообразный"
                            },
                            {
                                "target_lang_word": "желанный",
                                "target_lang_sense_clarification": "приятный, ожидаемый"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wünschenswert",
                                "target_lang_sense_clarification": "als Ziel oder Zustand erstrebenswert"
                            },
                            {
                                "target_lang_word": "erstrebenswert",
                                "target_lang_sense_clarification": "lohnend, anzustreben"
                            },
                            {
                                "target_lang_word": "begehrenswert",
                                "target_lang_sense_clarification": "attraktiv oder reizvoll"
                            },
                            {
                                "target_lang_word": "erwünscht",
                                "target_lang_sense_clarification": "willkommen oder vorteilhaft"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dddf41bf-02fa-3834-9b4e-d6f903367861",
                    "sense_definition": "A thing that people want or consider worth having.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The store sells jewelry, antiques, and other <w>desirables</w>.",
                            "target_lang_translations": {
                                "ru": "В магазине продаются ювелирные изделия, антиквариат и другие <w>ценные вещи</w>.",
                                "de": "Das Geschäft verkauft Schmuck, Antiquitäten und andere <w>begehrte Artikel</w>."
                            }
                        },
                        {
                            "text": "He kept his cash and <w>desirables</w> in a safe.",
                            "target_lang_translations": {
                                "ru": "Он хранил наличные и <w>ценности</w> в сейфе.",
                                "de": "Er bewahrte sein Bargeld und seine <w>Wertgegenstände</w> in einem Safe auf."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещь, которую люди хотят или считают ценной.",
                        "de": "Ein Gegenstand, den Menschen gerne besitzen möchten oder als wertvoll erachten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ценная вещь",
                                "target_lang_sense_clarification": "предмет, который хочется иметь"
                            },
                            {
                                "target_lang_word": "предмет желаний",
                                "target_lang_sense_clarification": "то, чем хотят обладать"
                            }
                        ],
                        "de": [
