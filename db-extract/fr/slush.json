                "senses": [
                    {
                        "sense_id": "e6e2ba22-465f-341d-b633-33a65923ff3a",
                        "entry_id": "8a063e0a-efcc-36c1-9e23-8cd2a138b80c",
                        "glosses": [
                            "Neige fondue au sol ; névasse."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d82710ca-b4b2-366f-b222-cce5901fe65f",
                        "entry_id": "8a063e0a-efcc-36c1-9e23-8cd2a138b80c",
                        "glosses": [
                            "Neige fondue au sol ; névasse.",
                            "par son mélange avec de l’eau de mer remontant sur la banquise lorsque la couche de neige pèse trop lourd."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "ec01d503-7bd4-4f93-9f85-677df36dc6cf",
                                "sense_id": "d82710ca-b4b2-366f-b222-cce5901fe65f",
                                "text": "Ne surtout rien oublier, dans ces régions où la météo change très vite. Aujourd’hui, il ne fait « que moins 15 » mais l’on peut se retrouver dans une tempête ou les pieds dans la slush !"
                            }
                        ]
                    },
                    {
                        "sense_id": "b5f0d6ac-e55c-314c-b131-a19f3e6c1c91",
                        "entry_id": "8a063e0a-efcc-36c1-9e23-8cd2a138b80c",
                        "glosses": [
                            "Neige fondue au sol ; névasse.",
                            "par son mélange avec le calcium étendu sur les chemins pour la faire fondre."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "note": "Ce mot est souvent utilisé pour exprimer les mauvais côtés de l’hiver",
                        "examples": [
                            {
                                "example_id": "ccbb17eb-c034-4f10-a82d-5491f10eb171",
                                "sense_id": "b5f0d6ac-e55c-314c-b131-a19f3e6c1c91",
                                "text": "On le sait, les enfants sont les derniers à râler quand arrive la saison froide, les bancs de neige et la slush."
                            },
                            {
                                "example_id": "3c7ab3e7-8ac1-4b69-a3e4-dab06e83bfe5",
                                "sense_id": "b5f0d6ac-e55c-314c-b131-a19f3e6c1c91",
                                "text": "« Je me suis juré de ne plus jamais passer un autre hiver dans la slush à me geler le derrière. »"
                            },
                            {
                                "example_id": "cd5f475a-da13-4d24-a88f-78028356efab",
                                "sense_id": "b5f0d6ac-e55c-314c-b131-a19f3e6c1c91",
                                "text": "La slush partout, moi ça m’enrage."
                            }
                        ]
                    },
                    {
                        "sense_id": "b248012f-1143-378e-a83e-37ee627dd011",
                        "entry_id": "8a063e0a-efcc-36c1-9e23-8cd2a138b80c",
                        "glosses": [
                            "Boisson composée d’un sirop sucré à saveur de fruits ou autre mélangé à de la glace concassée en très petits morceaux."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "f2b7048d-c2b7-4351-9fd5-9727461622b5",
                                "sense_id": "b248012f-1143-378e-a83e-37ee627dd011",
                                "text": "Nathalie a adoré sa slush à la framboise."
                            },
                            {
                                "example_id": "b2e1383c-a0a9-4979-bc14-d2cbd8d82d97",
                                "sense_id": "b248012f-1143-378e-a83e-37ee627dd011",
                                "text": "« J’ai écrit cette pièce-là parce que, je dois l’avouer, j’ai déjà bu de la slush, porté du fluo et écouté les New Kids on the Block dans un sous-sol de la Rive-Sud en jouant aux Lego. »"
                            }
                        ]
                    }
