                                        "entry_id": "f5c9e9fe-077d-3f76-be80-fb3de95c7d38",
                                        "glosses": [
                                            "An old currency of the Netherlands (and its former overseas territory the Netherlands Antilles or the Dutch East Indies)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28bd9cbf-3671-4210-b71f-40e8e20950f5",
                                                "sense_id": "57453e67-908f-39ad-b1c3-574c50c6659f",
                                                "text": "The wheel spun and stopped at 13. I had lost! With a feeling like a sick qualm, as though I would like to make my way out of the crowd and go home, I staked another fifty gulden—this time on the red."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
