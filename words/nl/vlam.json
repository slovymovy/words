                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij kwam zijn oude <w>vlam</w> tegen in de supermarkt.",
                            "target_lang_translations": {
                                "en": "He ran into his old <w>flame</w> in the supermarket.",
                                "ru": "В супермаркете он встретил свою старую <w>любовь</w>.",
                                "pl": "Spotkał swoją dawną <w>sympatię</w> w supermarkecie.",
                                "de": "Er traf seine alte <w>Flamme</w> im Supermarkt.",
                                "fr": "Il a croisé son ancienne <w>flamme</w> au supermarché.",
                                "it": "Ha incontrato la sua vecchia <w>fiamma</w> al supermercato.",
                                "cs": "V supermarketu narazil na svou starou <w>lásku</w>.",
                                "tr": "Süpermarkette eski <w>sevgilisiyle</w> karşılaştı.",
                                "es": "Se encontró con su antiguo <w>amor</w> en el supermercado.",
                                "zh": "他在超市里碰到了他的<w>旧爱</w>。"
                            }
                        },
                        {
                            "text": "Zij stelde haar nieuwe <w>vlam</w> voor aan haar ouders.",
                            "target_lang_translations": {
                                "en": "She introduced her new <w>flame</w> to her parents.",
                                "ru": "Она представила свою новую <w>пассию</w> родителям.",
                                "pl": "Przedstawiła swoją nową <w>sympatię</w> rodzicom.",
                                "de": "Sie stellte ihre neue <w>Flamme</w> ihren Eltern vor.",
                                "fr": "Elle a présenté sa nouvelle <w>conquête</w> à ses parents.",
                                "it": "Ha presentato la sua nuova <w>fiamma</w> ai genitori.",
                                "cs": "Představila rodičům svou novou <w>sympatii</w>.",
                                "tr": "Yeni <w>sevgilisini</w> ailesiyle tanıştırdı.",
                                "es": "Le presentó su nuevo <w>ligue</w> a sus padres.",
                                "zh": "她把她的<w>新欢</w>介绍给了父母。"
                            }
