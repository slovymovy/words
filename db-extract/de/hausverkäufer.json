                "senses": [
                    {
                        "sense_id": "e1c8871c-a36c-344d-9adb-4ba36b0bf6a7",
                        "entry_id": "7a62bfa1-9826-32de-86bc-fe8f2dfad06a",
                        "glosses": [
                            "jemand, der ein Haus verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac0306b9-52b8-459f-b6fa-a218f5fe8d83",
                                "sense_id": "e1c8871c-a36c-344d-9adb-4ba36b0bf6a7",
                                "text": "Hausverkäufer wollen einen möglichst hohen Verkaufspreis erzielen."
                            },
                            {
                                "example_id": "2bd72d87-3c5e-40b5-8ae7-3605b667da6f",
                                "sense_id": "e1c8871c-a36c-344d-9adb-4ba36b0bf6a7",
                                "text": "„So habe ein Hausverkäufer kürzlich den Preis um mehrere Millionen angehoben, als er erfuhr, wer sich für seine Villa interessierte.“"
                            },
                            {
                                "example_id": "03aedc8d-4ea6-4d21-935d-9a00e37f8e17",
                                "sense_id": "e1c8871c-a36c-344d-9adb-4ba36b0bf6a7",
                                "text": "„Home Stager beraten Hausverkäufer bei der Präsentation ihrer Immobilie und richten Gebäude für den Verkauf optimal her.“"
                            },
                            {
                                "example_id": "44a12507-ccf6-4b1d-9f90-2dae0ebf65ad",
                                "sense_id": "e1c8871c-a36c-344d-9adb-4ba36b0bf6a7",
                                "text": "„Manche Hausverkäufer denken nicht nur ans Geld, sondern auch an ihre Mieter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
