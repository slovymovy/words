{
    "word_family": [
        "answerable",
        "unanswered",
        "answerer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d0d375b6-c2b4-3dd2-b6fd-355df338ff37",
                    "sense_definition": "A response or reply; something said or done in reaction to a statement or question.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am still waiting for a clear <w>answer</w> to the email I sent yesterday.",
                            "target_lang_translations": {
                                "ru": "Я все еще жду четкого <w>ответа</w> на письмо, которое отправил вчера."
                            }
                        },
                        {
                            "text": "Her <w>answer</w> to his proposal was a slap in the face.",
                            "target_lang_translations": {
                                "ru": "Ее <w>ответом</w> на его предложение была пощечина."
                            }
                        }
                    ],
                    "common_phrases": [
                        "give an answer",
                        "final answer",
                        "short answer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Реакция или отклик; то, что сказано или сделано в ответ на заявление или вопрос."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отве́т",
                                "target_lang_sense_clarification": "реакция на вопрос или действие"
                            },
                            {
                                "target_lang_word": "о́тповедь",
                                "target_lang_sense_clarification": "строгое возражение или отпор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f62433a-d772-39b7-ae68-e3e357e99659",
                    "sense_definition": "A solution to a problem or a result of a mathematical calculation.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "solution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student worked hard to find the correct <w>answer</w> to the math problem.",
                            "target_lang_translations": {
                                "ru": "Ученик усердно работал, чтобы найти правильный <w>ответ</w> на математическую задачу."
                            }
                        },
                        {
                            "text": "There is no simple <w>answer</w> to corruption in modern society.",
                            "target_lang_translations": {
                                "ru": "Нет простого <w>решения</w> проблемы коррупции в современном обществе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "correct answer",
                        "simple answer",
                        "no easy answer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Решение проблемы или результат математического вычисления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отве́т",
                                "target_lang_sense_clarification": "результат вычисления или задачи"
                            },
                            {
                                "target_lang_word": "реше́ние",
                                "target_lang_sense_clarification": "выход из ситуации или ответ на задачу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cef1abf-f879-3a00-aa8c-10456baf6a3f",
                    "sense_definition": "Someone or something that fills a similar role or position in a different context.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "equivalent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new electric car is the company's <w>answer</w> to the growing demand for green energy.",
                            "target_lang_translations": {
                                "ru": "Этот новый электромобиль — <w>ответ</w> компании на растущий спрос на экологически чистую энергию."
                            }
                        },
                        {
                            "text": "The young actor is emerging as England's <w>answer</w> to the famous Hollywood star.",
                            "target_lang_translations": {
                                "ru": "Молодой актер становится английским <w>ответом</w> знаменитой голливудской звезде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "country's answer to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кто-то или что-то, выполняющее аналогичную роль или занимающее схожую позицию в другом контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отве́т",
                                "target_lang_sense_clarification": "аналог или эквивалент в другой среде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75e8f69e-8144-3ddf-b606-397c71e9d23f",
                    "sense_definition": "A document filed in response to a legal complaint, responding to each point raised.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defendant's lawyer filed a formal <w>answer</w> to the lawsuit this morning.",
                            "target_lang_translations": {
                                "ru": "Адвокат ответчика подал официальный <w>ответ</w> на иск сегодня утром."
                            }
                        },
                        {
                            "text": "The court reviewed the <w>answer</w> before deciding whether to proceed with the trial.",
                            "target_lang_translations": {
                                "ru": "Суд изучил <w>возражение</w>, прежде чем решить, продолжать ли разбирательство."
                            }
                        }
                    ],
                    "common_phrases": [
                        "file an answer"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Документ, поданный в ответ на судебный иск, содержащий возражения по каждому пункту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отве́т",
                                "target_lang_sense_clarification": "официальный документ-возражение на иск"
                            },
                            {
                                "target_lang_word": "отзыв",
                                "target_lang_sense_clarification": "юридический ответ на исковое заявление"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4588d810-f880-3c7c-a802-9ae480562810",
                    "sense_definition": "To make a reply or response to a person, question, or statement.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>answer</w> the question directly without changing the subject.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>ответьте</w> на вопрос прямо, не меняя темы."
                            }
                        },
                        {
                            "text": "He did not <w>answer</w> me when I asked him where he was going.",
                            "target_lang_translations": {
                                "ru": "Он не <w>ответил</w> мне, когда я спросил его, куда он идет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "answer a question",
                        "answer back"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дать ответ или отреагировать на слова человека, вопрос или заявление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвеча́ть",
                                "target_lang_sense_clarification": "давать ответ (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "отве́тить",
                                "target_lang_sense_clarification": "дать ответ (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "727c98bd-6713-3e5b-bb8a-d0772b8293cd",
                    "sense_definition": "To respond to a call by someone at a door or telephone.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had to <w>answer</w> the door because the bell rang three times.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось <w>открыть</w> дверь, потому что звонок прозвенел трижды."
                            }
                        },
                        {
                            "text": "Nobody <w>answered</w> when I knocked on the door of the office.",
                            "target_lang_translations": {
                                "ru": "Никто не <w>ответил</w>, когда я постучал в дверь офиса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "answer the door",
                        "answer the phone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отреагировать на звонок в дверь или по телефону."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвеча́ть",
                                "target_lang_sense_clarification": "подходить к двери или телефону"
                            },
                            {
                                "target_lang_word": "отве́тить",
                                "target_lang_sense_clarification": "взять трубку или открыть дверь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d87d9dae-e2f7-361b-a568-2dfbf9628906",
                    "sense_definition": "To be accountable or responsible for something; to make amends.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager must <w>answer</w> to his employer for the money entrusted to his care.",
                            "target_lang_translations": {
                                "ru": "Менеджер должен <w>отвечать</w> перед своим работодателем за деньги, вверенные его заботе."
                            }
                        },
                        {
                            "text": "He has a lot to <w>answer</w> for after making such a big mistake.",
                            "target_lang_translations": {
                                "ru": "Ему за многое придется <w>ответить</w> после такой серьезной ошибки."
                            }
                        }
                    ],
                    "synonyms": [
                        "answer for"
                    ],
                    "common_phrases": [
                        "answer to someone",
                        "answer for something"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть подотчетным или ответственным за что-либо; нести ответственность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвеча́ть",
                                "target_lang_sense_clarification": "нести ответственность перед кем-то"
                            },
                            {
                                "target_lang_word": "понести́ отве́тственность",
                                "target_lang_sense_clarification": "ответить за последствия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3fb1d9d-0bcf-32ed-a052-a5bd690791cf",
                    "sense_definition": "To suit a need or purpose satisfactorily.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This small tool <w>answers</w> the purpose perfectly for minor home repairs.",
                            "target_lang_translations": {
                                "ru": "Этот маленький инструмент идеально <w>отвечает</w> целям мелкого домашнего ремонта."
                            }
                        },
                        {
                            "text": "The temporary solution <w>answered</w> the need until a permanent one was found.",
                            "target_lang_translations": {
                                "ru": "Временное решение <w>удовлетворяло</w> потребность, пока не было найдено постоянное."
                            }
                        }
                    ],
                    "common_phrases": [
                        "answer the purpose",
                        "answer the need"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удовлетворять потребность или соответствовать цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвеча́ть",
                                "target_lang_sense_clarification": "соответствовать цели или нужде"
                            },
                            {
                                "target_lang_word": "соотве́тствовать",
                                "target_lang_sense_clarification": "быть в соответствии с требованиями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba2a610c-ba8f-31bc-a964-ffe0eeb54e15",
                    "sense_definition": "To correspond to or be in agreement with a description or image.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect <w>answers</w> the description given by the witness at the scene.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый <w>соответствует</w> описанию, данному свидетелем на месте происшествия."
                            }
                        },
                        {
                            "text": "I wish the actual house <w>answered</w> the picture in the advertisement as well.",
                            "target_lang_translations": {
                                "ru": "Хотелось бы, чтобы настоящий дом так же <w>соответствовал</w> фотографии в объявлении."
                            }
                        }
                    ],
                    "common_phrases": [
                        "answer the description"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствовать описанию или изображению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соотве́тствовать",
                                "target_lang_sense_clarification": "подходить под описание"
                            },
                            {
                                "target_lang_word": "отвеча́ть",
                                "target_lang_sense_clarification": "соответствовать (описанию)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "717854f2-104b-3449-b596-7938e687ec38",
                    "sense_definition": "To speak in defense against a charge or accusation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician had to <w>answer</w> a charge of misconduct during the press conference.",
                            "target_lang_translations": {
                                "ru": "Политику пришлось <w>отвечать</w> на обвинение в неправомерном поведении во время пресс-конференции."
                            }
                        },
                        {
                            "text": "He was called to court to <w>answer</w> for his actions on that night.",
                            "target_lang_translations": {
                                "ru": "Его вызвали в суд, чтобы <w>ответить</w> за свои действия в ту ночь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "answer a charge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступать в защиту против обвинения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвеча́ть",
                                "target_lang_sense_clarification": "давать показания по обвинению"
                            },
                            {
                                "target_lang_word": "держа́ть отве́т",
                                "target_lang_sense_clarification": "оправдываться перед судом или обществом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19de3c3e-caeb-3c23-bffc-33016313d00b",
                    "sense_definition": "To act in compliance with or in fulfillment of an order or obligation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship will <w>answer</w> her helm much better when sailing at higher speeds.",
                            "target_lang_translations": {
                                "ru": "Корабль будет гораздо лучше <w>слушаться</w> руля при движении на более высоких скоростях."
                            }
                        },
                        {
                            "text": "The servant immediately <w>answered</w> the bell when the master rang it.",
                            "target_lang_translations": {
                                "ru": "Слуга немедленно <w>явился</w> на звонок, когда хозяин позвонил в него."
                            }
                        }
                    ],
                    "common_phrases": [
                        "answer the helm",
                        "answer the bell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действовать в соответствии с приказом, обязательством или техническим сигналом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слу́шаться",
                                "target_lang_sense_clarification": "повиноваться (о технике, например, руле)"
                            },
                            {
                                "target_lang_word": "отвеча́ть",
                                "target_lang_sense_clarification": "реагировать на сигнал или команду"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}