                        "glosses": [
                            "D’une manière dominicale, liée au dimanche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05834dba-14f2-4e80-ab17-5284c47feca8",
                                "sense_id": "e6fbfc3c-ff54-3c56-894c-dcfb2de926b4",
                                "text": "Dimanche dernier, ces Dames de Bachelier m’emmenaient à la campagne à l’heure même où il aurait fallu vous écrire pour que la lettre vous arrivât dominicalement."
                            },
                            {
                                "example_id": "ba0837ee-2f74-42d0-b0b6-ab52198fd0e6",
                                "sense_id": "e6fbfc3c-ff54-3c56-894c-dcfb2de926b4",
                                "text": "Les biens dominicalement bourgeois que mon caddie rapporte à la maison – huîtres, poulet rôti, brillat-savarin double crème, tarte aux mirabelles – satisferaient l’amante, épouse et grand-mère A.M., qui, nous félicitant de « ne pas avoir traîné », accentuerait le bonheur de la retrouver."
                            }
                        ]
                    }
