{
    "word_family": [
        "rot",
        "rotter"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bd51512f-1a37-3a93-a0da-a76a9be04991",
                    "sense_definition": "Decayed and no longer able to be used or eaten, especially regarding food.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should throw away that <w>rotten</w> apple before it spoils the others.",
                            "target_lang_translations": {
                                "ru": "Тебе следует выбросить это <w>гнилое</w> яблоко, пока оно не испортило остальные.",
                                "zh": "你应该把那个<w>腐烂的</w>苹果扔掉，免得它把其他的也弄坏了。"
                            }
                        },
                        {
                            "text": "The kitchen began to smell because of a <w>rotten</w> egg in the bin.",
                            "target_lang_translations": {
                                "ru": "На кухне появился запах из-за <w>тухлого</w> яйца в мусорном ведре.",
                                "zh": "厨房里开始有味道了，因为垃圾桶里有个<w>臭</w>鸡蛋。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spoiled",
                        "gone bad",
                        "gone off",
                        "decayed",
                        "moldy"
                    ],
                    "antonyms": [
                        "fresh",
                        "edible",
                        "unspoiled"
                    ],
                    "common_phrases": [
                        "rotten egg",
                        "smell rotten",
                        "rotten apple"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испорченный, разложившийся и непригодный для употребления (о еде).",
                        "zh": "指食物等腐烂、变质，无法食用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнило́й",
                                "target_lang_sense_clarification": "об овощах и фруктах"
                            },
                            {
                                "target_lang_word": "ту́хлый",
                                "target_lang_sense_clarification": "о яйцах, мясе, рыбе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "腐烂的",
                                "target_lang_sense_clarification": "指果蔬等有机物腐坏"
                            },
                            {
                                "target_lang_word": "变质的",
                                "target_lang_sense_clarification": "指食物因存放过久而坏掉"
                            },
                            {
                                "target_lang_word": "臭的",
                                "target_lang_sense_clarification": "指因腐烂而发出恶臭"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d43d6df7-8dce-39a2-bf1b-78b9bb6782c4",
                    "sense_definition": "Very bad, unpleasant, or causing a feeling of illness.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bad_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have the flu and I feel absolutely <w>rotten</w> today.",
                            "target_lang_translations": {
                                "ru": "У меня грипп, и я чувствую себя совершенно <w>паршиво</w> сегодня.",
                                "zh": "我得了流感，今天感觉<w>难受</w>极了。"
                            }
                        },
                        {
                            "text": "We decided to stay home because of the <w>rotten</w> weather outside.",
                            "target_lang_translations": {
                                "ru": "Мы решили остаться дома из-за <w>отвратительной</w> погоды на улице.",
                                "zh": "因为外面的天气太<w>糟糕</w>了，我们决定待在家里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bad",
                        "awful",
                        "terrible"
                    ],
                    "common_phrases": [
                        "rotten weather",
                        "feel rotten",
                        "rotten luck"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used to describe health or weather."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень плохой, неприятный или вызывающий болезненное состояние.",
                        "zh": "形容非常糟糕、令人不快或身体不适。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отврати́тельный",
                                "target_lang_sense_clarification": "о погоде или самочувствии"
                            },
                            {
                                "target_lang_word": "парши́вый",
                                "target_lang_sense_clarification": "разговорное; скверный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "糟糕的",
                                "target_lang_sense_clarification": "形容情况或天气很差"
                            },
                            {
                                "target_lang_word": "难受的",
                                "target_lang_sense_clarification": "形容身体感觉极差"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dd887f3-2fac-3103-8931-2fa97aae175d",
                    "sense_definition": "In a state of physical decay or falling apart.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden bridge is dangerous because the planks are <w>rotten</w>.",
                            "target_lang_translations": {
                                "ru": "Старый деревянный мост опасен, потому что доски <w>гнилые</w>.",
                                "zh": "那座老木桥很危险，因为木板已经<w>腐朽</w>了。"
                            }
                        },
                        {
                            "text": "He had to go to the dentist to fix his <w>rotten</w> teeth.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось пойти к стоматологу, чтобы вылечить свои <w>гнилые</w> зубы.",
                                "zh": "他不得不去看牙医，修补他那<w>蛀蚀</w>的牙齿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "carious"
                    ],
                    "common_phrases": [
                        "rotten wood",
                        "rotten teeth",
                        "rotten floor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии физического распада или разрушения.",
                        "zh": "指物体处于物理上的腐朽或崩解状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнило́й",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "трухля́вый",
                                "target_lang_sense_clarification": "о дереве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "腐朽的",
                                "target_lang_sense_clarification": "指木材等因老化而变质"
                            },
                            {
                                "target_lang_word": "蛀蚀的",
                                "target_lang_sense_clarification": "指牙齿等被侵蚀"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3dac8063-d2c2-3fd6-8d78-44ce31d82f21",
                    "sense_definition": "Dishonest, cruel, or morally corrupt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bad_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain in the movie was <w>rotten</w> to the core.",
                            "target_lang_translations": {
                                "ru": "Злодей в фильме был <w>гнилым</w> до мозга костей.",
                                "zh": "电影里的那个反派真是<w>坏</w>到骨子里了。"
                            }
                        },
                        {
                            "text": "It was a <w>rotten</w> thing to do to your best friend.",
                            "target_lang_translations": {
                                "ru": "Это был <w>гадкий</w> поступок по отношению к твоему лучшему другу.",
                                "zh": "那样对待你最好的朋友真是太<w>卑劣</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bad"
                    ],
                    "common_phrases": [
                        "rotten to the core",
                        "rotten scoundrel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесчестный, жестокий или морально разложившийся.",
                        "zh": "指人品行不端、卑劣或道德败坏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "га́дкий",
                                "target_lang_sense_clarification": "мерзкий, противный"
                            },
                            {
                                "target_lang_word": "по́длый",
                                "target_lang_sense_clarification": "низкий, бесчестный"
                            },
                            {
                                "target_lang_word": "гнило́й",
                                "target_lang_sense_clarification": "переносное значение; о человеке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卑劣的",
                                "target_lang_sense_clarification": "指行为下作、不道德"
                            },
                            {
                                "target_lang_word": "腐败的",
                                "target_lang_sense_clarification": "指道德上的堕落"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "578eb694-d9d0-33e1-90b3-42550bff9307",
                    "sense_definition": "Very drunk.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went to the pub and got absolutely <w>rotten</w> last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером он пошел в паб и напился <w>в стельку</w>.",
                                "zh": "他昨晚去了酒吧，喝得<w>烂醉如泥</w>。"
                            }
                        },
                        {
                            "text": "They were <w>rotten</w> after drinking too much wine at the party.",
                            "target_lang_translations": {
                                "ru": "Они были <w>пьяные в дрызг</w> после того, как выпили слишком много вина на вечеринке.",
                                "zh": "他们在派对上喝了太多酒，已经<w>烂醉</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень пьяный.",
                        "zh": "形容醉得非常厉害。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пья́ный в сте́льку",
                                "target_lang_sense_clarification": "идиома"
                            },
                            {
                                "target_lang_word": "гото́вый",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烂醉如泥",
                                "target_lang_sense_clarification": "形容醉到无法动弹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3841f6bc-9535-3996-8f63-48c04c5c0fa2",
                    "sense_definition": "Of stone or rock, crumbling or disintegrating.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The climbers avoided the cliff face because the rock was <w>rotten</w>.",
                            "target_lang_translations": {
                                "ru": "Альпинисты избегали этого склона, потому что порода была <w>рыхлой</w>.",
                                "zh": "登山者避开了那面悬崖，因为那里的岩石太<w>松散</w>了。"
                            }
                        },
                        {
                            "text": "Miners had to be careful when digging through the <w>rotten</w> quartz.",
                            "target_lang_translations": {
                                "ru": "Шахтерам приходилось быть осторожными при раскопках <w>рыхлого</w> кварца.",
                                "zh": "矿工在挖掘<w>易碎</w>的石英时必须非常小心。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крошащийся или распадающийся (о камне или горной породе).",
                        "zh": "指岩石或矿石松散、易碎。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ры́хлый",
                                "target_lang_sense_clarification": "ненадежный, рассыпчатый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "松散的",
                                "target_lang_sense_clarification": "指岩石结构不紧密"
                            },
                            {
                                "target_lang_word": "易碎的",
                                "target_lang_sense_clarification": "指岩石容易崩解"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9fb81ed1-0b9d-396f-98eb-e44bbbebff8f",
                    "sense_definition": "To an extreme degree, usually describing how someone is spoiled.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their grandmother has spoiled those children <w>rotten</w> with gifts.",
                            "target_lang_translations": {
                                "ru": "Их бабушка избаловала этих детей <w>донельзя</w> подарками.",
                                "zh": "他们的祖母用礼物把那些孩子<w>极其</w>宠坏了。"
                            }
                        },
                        {
                            "text": "He is rich and spoiled <w>rotten</w>, never having to work a day in his life.",
                            "target_lang_translations": {
                                "ru": "Он богат и избалован <w>вконец</w>, ему ни дня в жизни не приходилось работать.",
                                "zh": "他很有钱，而且被<w>极其</w>宠坏了，这辈子从来没工作过一天。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spoiled rotten"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерно, до крайней степени (обычно об избалованности).",
                        "zh": "形容程度极深，通常指被宠坏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доне́льзя",
                                "target_lang_sense_clarification": "до крайности"
                            },
                            {
                                "target_lang_word": "вконе́ц",
                                "target_lang_sense_clarification": "окончательно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极其",
                                "target_lang_sense_clarification": "用于程度副词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}