                        "entry_id": "12e3af0f-1f5e-3d4d-81c4-ed25006d946e",
                        "glosses": [
                            "A loosely woven cotton gauze, originally used to wrap cheese, but now used for various culinary tasks and by farmers to shade crops and keep birds off."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
