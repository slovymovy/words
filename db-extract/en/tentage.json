                        "examples": [
                            {
                                "example_id": "41524edb-e95b-4ecf-8e39-2bb0d2746460",
                                "sense_id": "ff122737-3095-3cae-b2a3-ccba0f13f764",
                                "text": "Whenever we shifted camp, we had to leave most of our things behind, so that the night before each fight was marked by our sleeping without tentage and with very little food, so far as officers were concerned, as everything had to be sacrificed to getting up what ammunition and medical supplies we had."
                            },
                            {
                                "example_id": "9bd0f14a-ae6f-4486-b4fc-39dc43812e7b",
                                "sense_id": "ff122737-3095-3cae-b2a3-ccba0f13f764",
                                "text": "In addition to the National Army camps, plans were made for the construction of 16 National Guard, two embarkation and one quartermaster training camp, but the construction of these items did not involve so large an expenditure as the National Army camps, as provision was made for fewer units and only tentage quarters for the men in the National Guard camps was provided."
                            }
                        ]
                    }
