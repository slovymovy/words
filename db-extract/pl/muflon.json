                            "ssak z podgatunku muflonów (1.1)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "5a96e850-8894-38db-9c6d-0911ee8bbe78",
                        "entry_id": "8e1c89ea-7853-351e-b9c8-b597eda48a98",
                        "glosses": [
                            "Ovis canadensis George Shaw, gatunek górskiej owcy z rzędu parzystokopytnych występujący w Ameryce Północnej"
                        ],
                        "tags": [
                            "syst."
                        ],
                        "examples": [
                            {
                                "example_id": "85688c3a-85f7-49c8-8ed6-e02762f4caaa",
                                "sense_id": "5a96e850-8894-38db-9c6d-0911ee8bbe78",
                                "text": "Futro muflona w części grzbietowej ma wybarwienie szarobrunatne."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
