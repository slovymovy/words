                ],
                "senses": [
                    {
                        "sense_id": "bb2aa192-4f8c-3c97-872d-3dd8dd1e8740",
                        "entry_id": "760200bc-62e0-3902-9f4e-674ff7c31084",
                        "glosses": [
                            "vom Gefühlszustand bedingt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21051980-688a-43df-93d1-aa7cf2ce1f9c",
                                "sense_id": "bb2aa192-4f8c-3c97-872d-3dd8dd1e8740",
                                "text": "„Eine Person die weitestgehend emotionale Entscheidungen trifft, wird instinktiv und stimmungsabhängig auf die Ausgangssituation reagieren.“"
                            },
                            {
                                "example_id": "68850e79-6c7a-47bd-968c-ecceb3516b93",
                                "sense_id": "bb2aa192-4f8c-3c97-872d-3dd8dd1e8740",
                                "text": "„Kurz gesagt ist die Art des Denkens stimmungsabhängig; Individuen lösen Probleme gut gelaunt anders als schlecht gelaunt, sie sind dann kreativer, aber auch gutgläubiger und oberflächlicher.“"
                            },
                            {
                                "example_id": "ee062979-884e-4f00-9b9d-31ac9841218c",
                                "sense_id": "bb2aa192-4f8c-3c97-872d-3dd8dd1e8740",
                                "text": "„Durch Taucher wurde außerdem beobachtet, dass Tintenfische sehr zärtliche Liebhaber sind, die während ihrer Paarung stimmungsabhängig ihre Farbe ändern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
