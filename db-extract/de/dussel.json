                    {
                        "form_id": "cff00b4e-4eae-4e82-9f9a-a60dbb148a9a",
                        "entry_id": "e2d6e98f-4e8d-3f85-9e7e-c925e0c16b4b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Dussel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1d60d4df-c397-3de7-a364-b14a1866de4d",
                        "entry_id": "e2d6e98f-4e8d-3f85-9e7e-c925e0c16b4b",
                        "glosses": [
                            "ungeschickter Mensch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "644a57b9-ed02-41ae-acbd-99e4254da56f",
                                "sense_id": "1d60d4df-c397-3de7-a364-b14a1866de4d",
                                "text": "Nur ein Dussel springt gegen die Fahrtrichtung ab."
                            },
                            {
                                "example_id": "590f2091-4243-4050-b9a6-286a2b468628",
                                "sense_id": "1d60d4df-c397-3de7-a364-b14a1866de4d",
                                "text": "„Das ist eigentlich ein kolossaler Dussel, dieser Franz Biberkopf.“"
                            },
                            {
                                "example_id": "a09ed060-7e12-482c-bcd0-540cef63bf25",
                                "sense_id": "1d60d4df-c397-3de7-a364-b14a1866de4d",
                                "text": "„Sie nennen einen »Außenseiter«, der nicht stiehlt, einen Dummkopf, einen Idioten, einen Dussel und einen Einfaltspinsel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1cb0b472-3e68-3e59-8bb0-0385c0e6d592",
                        "entry_id": "e2d6e98f-4e8d-3f85-9e7e-c925e0c16b4b",
                        "glosses": [
                            "Glück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96e1fa19-1ca8-4d08-a302-7fc7579380f3",
                                "sense_id": "1cb0b472-3e68-3e59-8bb0-0385c0e6d592",
                                "text": "„Du und Hannes – ihr habt vielleicht Dussel gehabt!“"
                            },
                            {
                                "example_id": "01a46c16-24d2-4f65-8478-54773ce8ec18",
                                "sense_id": "1cb0b472-3e68-3e59-8bb0-0385c0e6d592",
                                "text": "„‚[…] Aber eines steht fest,‘ sagte er ‚du hast'n ziemlichen Dussel gehabt […]‘“"
                            },
                            {
                                "example_id": "d574f74d-36a6-448e-90cd-de90fc1890eb",
                                "sense_id": "1cb0b472-3e68-3e59-8bb0-0385c0e6d592",
                                "text": "„Da hab ich wirklich Dussel gehabt.“"
                            },
                            {
                                "example_id": "18b70420-bd00-4f56-b282-5f332752bb14",
                                "sense_id": "1cb0b472-3e68-3e59-8bb0-0385c0e6d592",
                                "text": "„Da hast du ja noch einmal Dussel gehabt!“"
                            },
                            {
                                "example_id": "951c49a5-2a1d-47f4-8267-81de37cc4f32",
                                "sense_id": "1cb0b472-3e68-3e59-8bb0-0385c0e6d592",
                                "text": "„Herr O.. was haben sie ein Dussel gehabt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
