                        "target_lang_word": "vis-à-vis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vis-à-vis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa702c3e-a59f-38e9-a449-c3b1e941af9b",
                                        "entry_id": "f76924a1-7402-3d63-80ad-5dbbfc10855f",
                                        "glosses": [
                                            "En face, à l’opposé, se faisant face."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e57e91af-1f03-4713-a71d-492a6a422e8f",
                                                "sense_id": "fa702c3e-a59f-38e9-a449-c3b1e941af9b",
                                                "text": "Lorsque les deux adversaires se trouvèrent vis-à-vis l’un de l’autre aux deux extrémités de la lice, l’attention du public fut tendue au plus haut degré."
                                            },
                                            {
                                                "example_id": "405d7396-04ae-44ca-9285-a6377b84e480",
                                                "sense_id": "fa702c3e-a59f-38e9-a449-c3b1e941af9b",
                                                "text": "Doña Luz et le Cœur-Loyal étaient vis-à-vis l’un de l’autre dans une position singulière."
                                            },
                                            {
                                                "example_id": "87932607-f7b2-49a9-b54c-16d7a9121f15",
                                                "sense_id": "fa702c3e-a59f-38e9-a449-c3b1e941af9b",
                                                "text": "Le territoire est assez accidenté. Altit. princip. : 86 m. au moulin de Cheupré; […]; 177 m. à la limite septentrionale, vis-à-vis Mahéru (Vieil-St-Remy)."
                                            },
                                            {
                                                "example_id": "8386e411-739c-4d5f-97f3-594cc48b11b9",
                                                "sense_id": "fa702c3e-a59f-38e9-a449-c3b1e941af9b",
                                                "text": "Quand ils furent seul à seul, Martin s’assit vis-à-vis le supposé fuyard."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vis-à-vis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ceedde31-2397-3086-a59a-25753671831d",
                                        "entry_id": "fc80bf1b-704b-3f99-9c8d-4df972ab0cb6",
                                        "glosses": [
                                            "Personne qui est en face d’une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "840f53df-0241-45d1-8703-bfae08cf41de",
                                                "sense_id": "ceedde31-2397-3086-a59a-25753671831d",
                                                "text": "Je vous présente Pierre qui habite sur le même palier. C’est mon vis-à-vis."
                                            },
                                            {
                                                "example_id": "7fa309a7-607a-46aa-8bd7-04bdc9d9a249",
                                                "sense_id": "ceedde31-2397-3086-a59a-25753671831d",
                                                "text": "J’ai pu observer sa réaction, car il était mon vis-à-vis durant la réunion."
                                            },
                                            {
                                                "example_id": "1be5ff9a-c555-41dc-ba01-44a3a365a76c",
                                                "sense_id": "ceedde31-2397-3086-a59a-25753671831d",
                                                "text": "Dans aucun de mes voyages, je n’ai trouvé la moindre compensation aux tortures de cette vie de polype qui vous rend solidaire des faits et gestes de vos co-locataires momentanés, alors que, casé dans cette boîte de quelques pieds cubes, les jambes entrelacées à celles du vis-à-vis, […], il vous reste tout juste l’espace nécessaire pour respirer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb87915b-1bce-392e-b607-2025a6335de1",
                                        "entry_id": "fc80bf1b-704b-3f99-9c8d-4df972ab0cb6",
                                        "glosses": [
                                            "Couple qui danse en face d’un autre couple dans un quadrille."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ecaeac7-4f2c-3378-80c9-31c5eab588ce",
                                        "entry_id": "fc80bf1b-704b-3f99-9c8d-4df972ab0cb6",
                                        "glosses": [
                                            "Immeuble ou façade opposée à celle où l’on se trouve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "671b93e6-7676-4a99-a13f-6a15709a0f28",
                                                "sense_id": "8ecaeac7-4f2c-3378-80c9-31c5eab588ce",
                                                "text": "Comme c’est au bord de la falaise, vous n’aurez jamais de vis-à-vis !"
                                            },
                                            {
                                                "example_id": "79a2ee9f-134b-4d26-8680-a8f4784193e1",
                                                "sense_id": "8ecaeac7-4f2c-3378-80c9-31c5eab588ce",
                                                "text": "Ils n’avaient pas mis de rideaux car leur maison n’avait pas de vis-à-vis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5190224-5f49-3102-b230-3d5b9a3a2ec3",
                                        "entry_id": "fc80bf1b-704b-3f99-9c8d-4df972ab0cb6",
                                        "glosses": [
                                            "Petit siège de salon à deux places, disposé de telle façon que les personnes qui y sont assises se regardent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf9e7c50-4374-337c-ac7e-6ac53771f22b",
                                        "entry_id": "fc80bf1b-704b-3f99-9c8d-4df972ab0cb6",
                                        "glosses": [
                                            "Voiture où il n’y avait que deux sièges passagers se faisant face."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79cd538b-3602-4f6c-82c1-fac94d4d2cfa",
                                                "sense_id": "cf9e7c50-4374-337c-ac7e-6ac53771f22b",
                                                "text": "Je me voyais à minuit, arrivant, dans mon vis-à-vis de couleur olive, à la porte de l’Opéra."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
