                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Huflattich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "870d792c-4215-3e0b-86f0-5402047410e1",
                                        "entry_id": "2622eed1-99d3-3f19-9c5e-94017dd67913",
                                        "glosses": [
                                            "eine Pflanze aus der Familie der Korbblütler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cba5dc79-8472-4d99-8a73-3cabcd173acb",
                                                "sense_id": "870d792c-4215-3e0b-86f0-5402047410e1",
                                                "text": "Der Huflattich ist ein Frühblüher."
                                            },
                                            {
                                                "example_id": "8fe31144-2c82-47cc-ad09-273566cd286b",
                                                "sense_id": "870d792c-4215-3e0b-86f0-5402047410e1",
                                                "text": "Aus Huflattich werden Medikamente gegen Husten und Bronchialkatarrh hergestellt."
                                            },
                                            {
                                                "example_id": "cc043918-275f-46d1-813c-16b529e7ab41",
                                                "sense_id": "870d792c-4215-3e0b-86f0-5402047410e1",
                                                "text": "Und gleich da, am Lehmhang zu ihren Füßen, blüht sonnengelb der erste Huflattich, bohrt sich die Brennnessel, schon als junger Trieb erstaunlich dunkelgrün und borstig, aus der Erdkrume."
                                            },
                                            {
                                                "example_id": "03977b11-635e-4b54-930b-8309b2f906e7",
                                                "sense_id": "870d792c-4215-3e0b-86f0-5402047410e1",
                                                "text": "Durch einen Urwald aus Huflattich geht es die Lammer entlang."
                                            },
                                            {
                                                "example_id": "9651985c-3592-47f0-828d-9556db757972",
                                                "sense_id": "870d792c-4215-3e0b-86f0-5402047410e1",
                                                "text": "Einigen Naturfreunden in den USA steigt jedoch bei mancher Wildblume die Zornesröte ins Gesicht; wenn sie statt auf Trillium und Co. auf Dandelion (Löwenzahn) oder Coltsfoot (Huflattich) stoßen, die in ihren Bestimmungsbüchern als „Alien“ bezeichnet sind. Als Fremdling."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
