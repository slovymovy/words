                "senses": [
                    {
                        "sense_id": "8a92cbb3-2fde-3431-8670-b1f7385d18bf",
                        "entry_id": "da7c05f9-e278-3da5-bc54-99ea53358ed1",
                        "glosses": [
                            "Krieg, den ein Volk führt, um seine staatliche Unabhängigkeit von einer bis dahin beherrschenden Macht zu erringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb493282-ab31-4c68-af7f-533fadfc6e65",
                                "sense_id": "8a92cbb3-2fde-3431-8670-b1f7385d18bf",
                                "text": "„Dies war der Beginn des amerikanischen Unabhängigkeitskrieges.“"
                            },
                            {
                                "example_id": "96151eaf-f9ce-40c3-924c-95c1cc750c3a",
                                "sense_id": "8a92cbb3-2fde-3431-8670-b1f7385d18bf",
                                "text": "„Wohl mindestens 300000 Tote hat der Unabhängigkeitskrieg gekostet.“"
                            },
                            {
                                "example_id": "c4756128-e220-41ef-8ee1-f7e9744a135b",
                                "sense_id": "8a92cbb3-2fde-3431-8670-b1f7385d18bf",
                                "text": "„Die Eltern meiner Frau sind 1991 aus Tschetschenien geflüchtet, als die Einheimischen sich mit den Russen einen Unabhängigkeitskrieg lieferten und die Stadt wochenlang aus der Luft bombardiert wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
