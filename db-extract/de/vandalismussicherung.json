                "senses": [
                    {
                        "sense_id": "28a48e05-e7df-38c4-a08b-8f033eea41d1",
                        "entry_id": "5c73f7ef-ad0b-386c-ba12-d80f5f8a372f",
                        "glosses": [
                            "bauliche oder technische Vorrichtung, welche fremde Beschädigungen verhindern soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68515e39-83dc-4e0b-b930-fe29ace0f476",
                                "sense_id": "28a48e05-e7df-38c4-a08b-8f033eea41d1",
                                "text": "Die Risikobewertungen zum möglichen Vandalismus gegen Kunstobjekte im Kölner Dom gehen soweit, das es mehrere Vandalismussicherungen in Form von stabilen und hohen Gitterzäunen geben wird um sinnlose Anschläge auf Kunstobjekte zu verhindern."
                            },
                            {
                                "example_id": "be5f6a5f-fee1-41af-9ea4-f0dc8b0f3ccf",
                                "sense_id": "28a48e05-e7df-38c4-a08b-8f033eea41d1",
                                "text": "„Wartungsarbeiten, wie die Renigung des Lichtschachtes, lassen sich leicht durchführen, weil der Rost trotz unsichtbar integrierter Vandalismussicherung abmontiert werden kann.“"
                            },
                            {
                                "example_id": "80352781-eed1-40c8-83a9-fa0485d0a1a5",
                                "sense_id": "28a48e05-e7df-38c4-a08b-8f033eea41d1",
                                "text": "„Eines der beiden am Montag vorgestellten Modelle ist mit spezieller Vandalismussicherung ausgestattet, so dass die Einzelteile nicht gestohlen werden können.“"
                            },
                            {
                                "example_id": "e4ce0393-4565-4706-b207-d88b15909e8d",
                                "sense_id": "28a48e05-e7df-38c4-a08b-8f033eea41d1",
                                "text": "„Als Vandalismussicherung hat Herbert Lange an seinem jüngsten Bank-Bau diese natürliche Sicherung eingebaut.“"
                            },
                            {
                                "example_id": "64044e1b-cccf-445f-b4ee-834d4d92b862",
                                "sense_id": "28a48e05-e7df-38c4-a08b-8f033eea41d1",
                                "text": "„Das Ding hat doch wohl Diebstahls- und Vandalismussicherungen, oder?“"
                            },
                            {
                                "example_id": "38cb51e1-0b0c-412f-bc6e-3652dfcda195",
                                "sense_id": "28a48e05-e7df-38c4-a08b-8f033eea41d1",
                                "text": "„Neben Gussabdeckungen ist ein klassischer Gitterrost im Programm. Darüber hinaus überzeugen die optionalen Schnellverschlüsse und Vandalismussicherungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
