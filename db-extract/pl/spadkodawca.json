                        "tags": [],
                        "examples": [
                            {
                                "example_id": "714e9c8b-d79d-4a96-883f-aec23ee8cd75",
                                "sense_id": "eebf9e07-23ae-31fc-9a3f-553632f5ec59",
                                "text": "Z chwilą śmierci spadkodawcy następuje otwarcie spadku."
