                    {
                        "sense_id": "13ead0c2-d524-366c-9d21-a68b59170fc6",
                        "entry_id": "cb450676-d3a1-3d3f-b30b-c145fe2de441",
                        "glosses": [
                            "Kopf einer Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f241eecc-6c53-4355-bf3e-8d55faab49c6",
                                "sense_id": "13ead0c2-d524-366c-9d21-a68b59170fc6",
                                "text": "„Viele Sexualmörder nehmen Andenken von ihren Opfern mit und überreichen sie den Frauen, mit denen sie leben, als Zeichen der Dominanz und als Möglichkeit, die Tat seelisch erneut zu durchleben. Aber Hansen konnte sich nicht gut einen Frauenkopf an die Wand hängen, wie er es mit Großwild tat, und daher hielt ich es für wahrscheinlich, dass er eine andere Art Trophäe mitnehmen würde.“"
                            }
                        ],
