                                        "glosses": [
                                            "weibliche Person, die regelmäßig zum Gottesdienst in der Kirche geht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c16bc47f-e801-4433-b165-d166701621b7",
                                                "sense_id": "5082e9c1-0278-3656-a8ab-574f299222a0",
                                                "text": "„Für das 19. Jahrhundert wird in der Forschungsliteratur der Rückgang des Kirchgangs der Männer festgestellt, während die Frauen weiterhin treue Kirchgängerinnen geblieben seien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
