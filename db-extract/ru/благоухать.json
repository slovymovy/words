                        "glosses": [
                            "to be fragrant, to smell sweet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "029e2a27-a22a-4fb6-9605-2fc71dc925e1",
                                "sense_id": "8fcf141f-50fc-3145-a884-eab3628272a3",
                                "text": "Её го́рница всегда́ благоуха́ла че́м-нибудь: цвета́ми, духа́ми, сосно́ю, све́жими по весне́ ветвя́ми берёзы.",
                                "translation": "Her room was always full of some sweet scent—with flowers, with perfumes, with pines, and in the spring with birch-twigs.",
                                "english": "Her room was always full of some sweet scent—with flowers, with perfumes, with pines, and in the spring with birch-twigs."
                            }
                        ]
                    }
                ],
