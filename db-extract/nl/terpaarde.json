                        "glosses": [
                            "vruchtbare grond afkomstig van Friese terpen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "970431e9-7bb1-4a67-be19-065c9559d959",
                                "sense_id": "b5258539-e8bc-3e71-8ac4-3c895d53f39a",
                                "text": "De terp bij Anjum is een Rijksmonument. Door het gebruik van de vruchtbare terpaarde voor bemesting van de Friese zandgronden was het historische bouwwerk in de jaren veertig bijna verwoest."
                            },
                            {
                                "example_id": "0b8e7d3a-5423-41e9-8483-e785434671a7",
                                "sense_id": "b5258539-e8bc-3e71-8ac4-3c895d53f39a",
                                "text": "Rondom de terp ligt laaggelegen land. Daar is de vruchtbare terpaarde ongeveer honderd jaar geleden weggegraven voor het bevorderen van de vruchtbaarheid van de grond elders."
                            }
                        ]
                    }
