                "senses": [
                    {
                        "sense_id": "4abafe2f-9658-3aca-b813-c288e6d80879",
                        "entry_id": "92d37d29-55ed-3c0e-a24d-412538f2b124",
                        "glosses": [
                            "安靜，閉嘴"
                        ],
                        "tags": [
                            "Singapore",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "e553c050-ffdc-49d3-a08a-25f35bdef04c",
                                "sense_id": "4abafe2f-9658-3aca-b813-c288e6d80879",
                                "text": "Diam lah, you have no gal let alone have a son or daughter.",
                                "translation": "閉嘴啦，你都沒有女朋友，更別說兒子女兒了。"
                            },
                            {
                                "example_id": "cdbe8578-ede1-4f3a-9418-21a37053f3be",
                                "sense_id": "4abafe2f-9658-3aca-b813-c288e6d80879",
                                "text": "If the answer is affirmative, then he is qualified to talk to us. Otherwise, diam lah.",
                                "translation": "假如答案是肯定的，他才有資格跟我們談。否則，那他還是閉嘴啦。"
                            },
                            {
                                "example_id": "e278117e-38a4-4860-a49d-75622596f6f7",
                                "sense_id": "4abafe2f-9658-3aca-b813-c288e6d80879",
                                "text": "So diam lah, baruah bangsat!",
                                "translation": "所以你閉嘴啦，傻逼！"
                            }
                        ]
                    }
