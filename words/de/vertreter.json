                    ],
                    "synonyms": [
                        "Handelsvertreter",
                        "Verkäufer"
                    ],
                    "common_phrases": [
                        "Vertreter an der Haustür",
                        "selbstständiger Vertreter"
                    ]
                },
                {
                    "sense_id": "802ef845-1c1d-3187-9518-b1eb001602b8",
                    "sense_definition": "Person, die eine bestimmte geistige, politische oder künstlerische Richtung verkörpert",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "repraesentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der berühmte Philosoph galt als bedeutender <w>Vertreter</w> der europäischen Aufklärung."
                        },
                        {
                            "text": "Auf der Konferenz diskutierten viele namhafte <w>Vertreter</w> der modernen Wirtschaftstheorie miteinander."
