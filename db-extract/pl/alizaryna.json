                                "target_senses": [
                                    {
                                        "sense_id": "75741690-b8df-3914-81ea-cb639eb4c3c8",
                                        "entry_id": "9fd1cadd-04cd-3ec1-bf60-aff303c69709",
                                        "glosses": [
                                            "A red substance, 1,2-dihydroxyanthraquinone, extracted from madder root and used as a dye."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0c1de26-9678-4227-8123-ff440167fbcc",
                                                "sense_id": "75741690-b8df-3914-81ea-cb639eb4c3c8",
                                                "text": "glass headed pins,\noil-golds and copper greens,\nanthracite blues, alizarins,"
                                            },
                                            {
                                                "example_id": "b46e78fb-de4e-420b-9bec-8ffe5185e5e1",
                                                "sense_id": "75741690-b8df-3914-81ea-cb639eb4c3c8",
                                                "text": "In 1883, the German output of alizarin, the brilliant red chemical that imitated natural carmine, reached twelve thousand tons, dwarfing the amount being produced by Perkin's factory in London."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed192c3d-eed8-4b15-b687-93aa81f80f04",
                        "source_entry_id": "df9536da-1fcd-3cb6-928b-d9153790ee68",
                        "source_sense_id": "db579b56-600d-315e-b4cd-03458531a4a6",
                        "target_lang_word": "alizarine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alizarine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd49a8f0-2a38-3789-82e2-d0b7e8362299",
                                        "entry_id": "15b3f4c8-0b53-379f-bc08-a0fd5f17cbaf",
                                        "glosses": [
                                            "Colorant rouge, dérivé de l'anthraquinone que l'on extrait de la racine de la garance des teinturiers (Rubia tinctorum), en lui faisant subir divers traitements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12fd10ae-4f05-470d-a1fd-f856c1dbc363",
                                                "sense_id": "bd49a8f0-2a38-3789-82e2-d0b7e8362299",
                                                "text": "Par surcroît, la garance, devant la concurrence écrasante de l’alizarine artificielle, a perdu 60 % de sa valeur et ne rémunère plus ses frais de culture; […]."
                                            },
                                            {
                                                "example_id": "eef2091f-d3de-44f5-8fbd-72e725238bd5",
                                                "sense_id": "bd49a8f0-2a38-3789-82e2-d0b7e8362299",
                                                "text": "L’alizarine fournit avec les oxydes métalliques des composés de couleurs diverses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
