                        "target_lang_word": "Willenskraft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Willenskraft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7beb921f-eba8-3a7d-a1bc-d470fba65a3c",
                                        "entry_id": "2dddd8eb-e2f9-31e5-8c1b-bb32cca49df7",
                                        "glosses": [
                                            "Festigkeit/Stärke des Willens; Fähigkeit, innere Hindernisse (wie Unlust, Ängste oder Faulheit) zu überwinden und die gesetzten Ziele zu erreichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "941a4371-a6b9-46f5-909b-5ce1f1218c57",
                                                "sense_id": "7beb921f-eba8-3a7d-a1bc-d470fba65a3c",
                                                "text": "„Die Bettdecke zurückzuschlagen würde mich einen Tick zu viel Willenskraft kosten.“"
                                            },
                                            {
                                                "example_id": "b3efc71d-800a-4728-a9f1-d53682f540f0",
                                                "sense_id": "7beb921f-eba8-3a7d-a1bc-d470fba65a3c",
                                                "text": "„Mit einiger Willenskraft gelang es ihm, dies in die Stille des Raumes zu verlesen, ohne die Fassung wieder zu verlieren.“"
                                            },
                                            {
                                                "example_id": "1f815c61-16b9-4669-a198-2954b7f2256d",
                                                "sense_id": "7beb921f-eba8-3a7d-a1bc-d470fba65a3c",
                                                "text": "„Mit schierer Willenskraft reduzierte sie die Zigaretten um die Hälfte und machte jeden Abend zwischen Ladenschluss und einem Essen mit Freunden zu Hause oder einer Party anderswo einen langen Spaziergang durch den Jardin du Luxembourg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
