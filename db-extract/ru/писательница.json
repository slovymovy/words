                "senses": [
                    {
                        "sense_id": "dbcfb84e-5065-378d-9e6f-3d2155356829",
                        "entry_id": "4893fd61-4e36-35f6-b049-8a3c6e0c0b3c",
                        "glosses": [
                            "female equivalent of писа́тель (pisátelʹ): female author"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a5ec4fef-119c-44ec-9bc5-c94207432032",
                                "sense_id": "dbcfb84e-5065-378d-9e6f-3d2155356829",
                                "text": "С э́той но́шей мы́слей сле́довала писа́тельница вдоль бесконе́чной стены́ сбо́рочного це́ха комба́йнов, где за сплошны́ми пы́льными о́кнами — стёкла в желе́зных ра́мах — мерца́ли, каза́вшиеся нену́жными, жёлтые огни́ электри́ческих ламп."
                            }
                        ]
                    }
                ],
