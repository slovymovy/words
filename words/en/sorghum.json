            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e40d7676-0830-36d1-98c5-e4f737c0195e",
                    "sense_definition": "A type of cereal grass grown for its grain which is used for food and animal feed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cereal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers often plant <w>sorghum</w> because it grows well in dry climates.",
                            "target_lang_translations": {
                                "pl": "Rolnicy często sadzą <w>sorgo</w>, ponieważ dobrze rośnie w suchym klimacie."
                            }
                        },
                        {
                            "text": "The <w>sorghum</w> crop provides essential food for both people and livestock.",
                            "target_lang_translations": {
                                "pl": "Uprawa <w>sorga</w> stanowi podstawowe źródło pożywienia zarówno dla ludzi, jak i zwierząt gospodarskich."
                            }
                        }
                    ],
                    "synonyms": [
                        "guinea corn",
                        "kafir corn",
                        "mtama",
                        "durra",
                        "juar",
                        "jowar",
                        "cholam",
                        "kaoliang",
                        "milo",
                        "feterita"
                    ],
                    "common_phrases": [
                        "sorghum crop",
                        "sorghum grain"
                    ],
                    "target_lang_definitions": {
                        "pl": "Rodzaj trawy zbożowej uprawianej na ziarno wykorzystywane do celów spożywczych oraz jako pasza dla zwierząt."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "sorgo",
                                "target_lang_sense_clarification": "roślina zbożowa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c83d4ec-bf6e-3849-84df-c6e54d728a47",
                    "sense_definition": "A sweet syrup made from the juice of the sorghum plant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cereal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people enjoy drizzling <w>sorghum</w> over their hot biscuits in the morning.",
                            "target_lang_translations": {
                                "pl": "Wielu ludzi lubi rano polewać gorące ciasteczka <w>syropem z sorgo</w>."
                            }
                        },
                        {
                            "text": "The local market sells pure <w>sorghum</w> produced by nearby farms.",
                            "target_lang_translations": {
                                "pl": "Lokalny rynek sprzedaje czysty <w>syrop z sorgo</w> wytwarzany przez okoliczne gospodarstwa."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sweet sorghum"
                    ],
                    "target_lang_definitions": {
                        "pl": "Słodki syrop wytwarzany z soku łodyg sorga cukrowego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "syrop z sorgo",
                                "target_lang_sense_clarification": "syrop cukrowy"
                            },
                            {
                                "target_lang_word": "syrop sorgowy",
                                "target_lang_sense_clarification": "syrop słodzący"
                            }
                        ]
                    }
                }
            ]
        }
    ]
