                ],
                "senses": [
                    {
                        "sense_id": "c6c933f1-765b-3a6b-aa8e-a81136463b05",
                        "entry_id": "2acb03cf-782f-37f4-ae46-ee47db05100f",
                        "glosses": [
                            "A Roman Catholic philosophy that emphasises the prerogatives and powers of the Pope."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "575188e5-d694-45d6-8cbb-2720fe464bbd",
                                "sense_id": "c6c933f1-765b-3a6b-aa8e-a81136463b05",
                                "text": "Ultramontanism is often seen as a conservative force in the Church, but after 1815 it represented innovation and the prospect of Church reconstruction and revival, albeit of a particular type."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08a87652-4b5b-4d8e-b4af-957645f58d57",
                        "source_entry_id": "2acb03cf-782f-37f4-ae46-ee47db05100f",
                        "source_sense_id": "c6c933f1-765b-3a6b-aa8e-a81136463b05",
                        "source_sense_description": "Roman Catholic philosophy that emphasises the prerogatives and powers of the Pope",
                        "target_lang_word": "ultramontanisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultramontanisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38189a18-1313-355f-b2a1-7ca5282aa9b8",
                                        "entry_id": "77a61340-49af-3f1e-af13-bc31f14fbab1",
                                        "glosses": [
                                            "Système doctrinal et canonique de l’école théologique des ultramontains, caractérisé par le refus de la modernité et l’affirmation catégorique de l’autorité de l’Église dans la cité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09ae6de9-01b0-469e-a868-7c951a86919b",
                                                "sense_id": "38189a18-1313-355f-b2a1-7ca5282aa9b8",
                                                "text": "L’ultramontanisme ne parut d’abord à ces maîtres austères qu’une façon commode d’en appeler à une autorité éloignée, souvent mal informée, d’une autorité rapprochée et plus difficile à tromper."
                                            },
                                            {
                                                "example_id": "fb579771-eeff-4b47-b7d1-aa1d21629fc0",
                                                "sense_id": "38189a18-1313-355f-b2a1-7ca5282aa9b8",
                                                "text": "Sous l’impulsion de Mgr Bourget, l’ultramontanisme prend de plus en plus ses couleurs géographique et idéologique."
                                            },
                                            {
                                                "example_id": "913077ae-d9ac-4e9c-a9a1-935b33d6af27",
                                                "sense_id": "38189a18-1313-355f-b2a1-7ca5282aa9b8",
                                                "text": "… l’ultramontanisme, qui a voué aux gémonies toutes les idées modernes et qui souhaitait le rétablissement de l’autorité théocratique des papes!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
