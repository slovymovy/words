                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62c76f52-161e-3c61-b2b1-e0aa462850ea",
                                        "entry_id": "834004d4-1248-3864-bae5-4d0c6497a74b",
                                        "glosses": [
                                            "To form craters in a surface."
