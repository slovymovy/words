                        "sense_id": "13b2c788-fcdc-35fb-b1c4-a4792b488b8e",
                        "entry_id": "15f3d429-ac59-35db-bcad-1b9c060c6052",
                        "glosses": [
                            "Pluriel de gant."
                        ],
