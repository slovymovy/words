                ],
                "senses": [
                    {
                        "sense_id": "6c7eae68-b962-3ae8-b9a7-7161ad41bc9a",
                        "entry_id": "fb2dbde4-b0ae-3305-aa18-7fda1922eca8",
                        "glosses": [
                            "Qui est cabré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "948ad270-5edf-456a-9882-3c7781d601fd",
                                "sense_id": "6c7eae68-b962-3ae8-b9a7-7161ad41bc9a",
                                "text": "Dominant d’une tête tous les autres, le cheveu court, poivre et sel, aussi cabré que le reste de sa personne, le chevalier Nicolas Durand de Villegagnon arpentait son nouveau domaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "86560017-6901-3794-92aa-855b2f6b8d21",
                        "entry_id": "fb2dbde4-b0ae-3305-aa18-7fda1922eca8",
                        "glosses": [
                            "Se dit d’un cheval acculé sur les armoiries. À rapprocher d’acculé, effaré, effarouché, effrayé, forcené et furieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b291184b-7a4a-402f-b945-98f56665ee8b",
                                "sense_id": "86560017-6901-3794-92aa-855b2f6b8d21",
                                "text": "Tiercé en pairle au 1 de gueules à la colombe d’argent, au 2 d’or au cheval cabré de gueules bridé d’argent et au 3 d’azur à deux annelets d’argent percés de deux flèches tombantes du même mises en barre, qui est d’Ippécourt → voir illustration « cheval cabré »"
                            }
                        ]
                    }
