        "puzzling"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5caa7cd3-ab0e-3c23-b196-26b5d64b52c3",
                    "sense_definition": "Confused because you do not understand something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked completely <w>puzzled</w> by the strange question.",
                            "target_lang_translations": {
                                "ru": "Он выглядел совершенно <w>озадаченным</w> этим странным вопросом."
                            }
                        },
                        {
                            "text": "She listened with a <w>puzzled</w> look on her face as he explained.",
                            "target_lang_translations": {
                                "ru": "Она слушала его объяснения с <w>недоумевающим</w> выражением лица."
                            }
                        }
                    ],
                    "synonyms": [
                        "confused",
                        "perplexed",
                        "baffled"
                    ],
                    "antonyms": [
                        "clear",
                        "certain"
                    ],
                    "common_phrases": [
                        "puzzled look",
                        "puzzled expression",
                        "puzzled frown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбитый с толку или испытывающий недоумение из-за непонимания чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озадаченный",
                                "target_lang_sense_clarification": "в состоянии растерянности или раздумий"
                            },
                            {
                                "target_lang_word": "недоумевающий",
                                "target_lang_sense_clarification": "выражающий искреннее непонимание"
                            },
                            {
                                "target_lang_word": "сбитый с толку",
                                "target_lang_sense_clarification": "в замешательстве"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d2936b26-9812-330e-ba58-c93dd211a686",
                    "sense_definition": "Simple past and past participle of <w>puzzle</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected results <w>puzzled</w> the team of scientists.",
                            "target_lang_translations": {
                                "ru": "Неожиданные результаты <w>озадачили</w> группу учёных."
                            }
                        },
                        {
                            "text": "Her sudden change of mind has <w>puzzled</w> everyone in the office.",
                            "target_lang_translations": {
                                "ru": "Её внезапная перемена решения <w>привела в замешательство</w> всех в офисе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени глагола puzzle (озадачивать, приводить в недоумение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озадачил",
                                "target_lang_sense_clarification": "поставил в тупик (прош. вр.)"
                            },
                            {
                                "target_lang_word": "привёл в замешательство",
                                "target_lang_sense_clarification": "озадачил (прош. вр.)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
