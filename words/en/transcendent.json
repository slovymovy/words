{
    "word_family": [
        "transcend",
        "transcendence",
        "transcendency",
        "transcendental",
        "transcendently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "88a2af37-ff46-348a-9dcb-7a4639b05209",
                    "sense_definition": "Exceptionally great or supreme in excellence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The orchestra gave a <w>transcendent</w> performance that left the entire audience speechless.",
                            "target_lang_translations": {
                                "zh": "管弦乐队带来了一场<w>绝妙的</w>演出，令全场观众赞叹得说不出话来。"
                            }
                        },
                        {
                            "text": "Critics praised the novel for its <w>transcendent</w> beauty and emotional depth.",
                            "target_lang_translations": {
                                "zh": "评论家称赞这部小说具有<w>卓越的</w>美感与情感深度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sublime",
                        "supreme",
                        "peerless",
                        "matchless"
                    ],
                    "antonyms": [
                        "mediocre",
                        "ordinary"
                    ],
                    "common_phrases": [
                        "transcendent beauty",
                        "transcendent genius"
                    ],
                    "target_lang_definitions": {
                        "zh": "卓越的，杰出的；无比优秀的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卓越的",
                                "target_lang_sense_clarification": "指成就、品质等极高，远超常人"
                            },
                            {
                                "target_lang_word": "绝妙的",
                                "target_lang_sense_clarification": "极美或技艺登峰造极的"
                            },
                            {
                                "target_lang_word": "超绝的",
                                "target_lang_sense_clarification": "超群绝伦、达到极高水准的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ac6dfe7-0633-39db-a9dc-05612e6c1ab1",
                    "sense_definition": "Surpassing or extending far beyond normal limits.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "exceeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete achieved a <w>transcendent</w> victory by breaking three world records in one day.",
                            "target_lang_translations": {
                                "zh": "这名运动员在一天内打破三项世界纪录，取得了一场<w>非凡的</w>胜利。"
                            }
                        },
                        {
                            "text": "She displayed a <w>transcendent</w> ability to solve complex mathematical problems effortlessly.",
                            "target_lang_translations": {
                                "zh": "她展现出一种毫不费力就能解决复杂数学问题的<w>超常的</w>能力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "surpassing",
                        "extraordinary",
                        "preeminent"
                    ],
                    "common_phrases": [
                        "transcendent importance"
                    ],
                    "target_lang_definitions": {
                        "zh": "超越常规界限的；非凡的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "非凡的",
                                "target_lang_sense_clarification": "远超一般界限或能力的"
                            },
                            {
                                "target_lang_word": "超常的",
                                "target_lang_sense_clarification": "超出通常限度的"
                            },
                            {
                                "target_lang_word": "超越性的",
                                "target_lang_sense_clarification": "跨越既定界限或框架的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c997af1c-7482-33a5-ba92-9465b46b9b94",
                    "sense_definition": "Existing apart from and not subject to the limitations of the material universe.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphysical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many theologians describe God as a <w>transcendent</w> being who exists outside of time and space.",
                            "target_lang_translations": {
                                "zh": "许多神学家将上帝描述为存在于时空之外的<w>超然的</w>存在。"
                            }
                        },
                        {
                            "text": "Through intense meditation, he sought a <w>transcendent</w> state of consciousness.",
                            "target_lang_translations": {
                                "zh": "通过深度的冥想，他试图追寻一种<w>超验的</w>意识状态。"
                            }
                        }
                    ],
                    "synonyms": [
                        "otherworldly",
                        "divine"
                    ],
                    "antonyms": [
                        "immanent",
                        "material",
                        "earthly"
                    ],
                    "common_phrases": [
                        "transcendent being",
                        "transcendent power",
                        "transcendent reality"
                    ],
                    "target_lang_definitions": {
                        "zh": "（神学或哲学中）超然的，超越物质世界的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "超然的",
                                "target_lang_sense_clarification": "超脱于物质世界与感官之上的"
                            },
                            {
                                "target_lang_word": "超验的",
                                "target_lang_sense_clarification": "超越一切物质与经验界限的哲学概念"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf8aad68-8b3b-3c7d-a18a-dddc4ee3fe1c",
                    "sense_definition": "Lying beyond the range of ordinary human perception or experience.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Staring at the starry night sky gave her a <w>transcendent</w> feeling of peace.",
                            "target_lang_translations": {
                                "zh": "凝视繁星密布的夜空带给她一种<w>超脱的</w>宁静感。"
                            }
                        },
                        {
                            "text": "The mystic spoke of a <w>transcendent</w> truth that could not be expressed in mere words.",
                            "target_lang_translations": {
                                "zh": "这位神秘主义者谈到了一种仅凭言语无法表达的<w>超俗的</w>真理。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unknowable",
                        "incomprehensible"
                    ],
                    "antonyms": [
                        "perceptible",
                        "tangible"
                    ],
                    "common_phrases": [
                        "transcendent experience"
                    ],
                    "target_lang_definitions": {
                        "zh": "超出日常感知或世俗经验范围的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "超俗的",
                                "target_lang_sense_clarification": "超脱世俗感觉或体验的"
                            },
                            {
                                "target_lang_word": "不可言喻的",
                                "target_lang_sense_clarification": "超出凡俗语言与经验的"
                            },
                            {
                                "target_lang_word": "超脱的",
                                "target_lang_sense_clarification": "远离寻常人世感知的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "304f244c-ee40-3125-a7ec-fb0daf4c9a62",
                    "sense_definition": "That which surpasses ordinary limits or is supreme in excellence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Philosophers often spend their lives seeking the <w>transcendent</w> in art and nature.",
                            "target_lang_translations": {
                                "zh": "哲学家们常常穷其一生在艺术与自然中探寻<w>超越之物</w>。"
                            }
                        },
                        {
                            "text": "Her spiritual journey was a relentless pursuit of the <w>transcendent</w> beyond daily life.",
                            "target_lang_translations": {
                                "zh": "她的精神之旅是对超越日常生活的<w>超验之物</w>的不懈追求。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the transcendent"
                    ],
                    "target_lang_definitions": {
                        "zh": "超验之物；超越常规限度或极尽卓越的事物"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "超越之物",
                                "target_lang_sense_clarification": "超脱寻常界限的事物"
                            },
                            {
                                "target_lang_word": "超验之物",
                                "target_lang_sense_clarification": "指哲学或精神层面超越凡俗的存在"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}