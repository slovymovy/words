                ],
                "senses": [
                    {
                        "sense_id": "e76a0087-b3fa-346a-8a05-6db0c47f3f9b",
                        "entry_id": "69161ee7-516c-33c9-a9fc-9154fb665b47",
                        "glosses": [
                            "przysadzisty"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "33812429-24d3-4de1-b299-3315e6e53f07",
                                "sense_id": "e76a0087-b3fa-346a-8a05-6db0c47f3f9b",
                                "text": "Z trudem i wysiłkiem sularz Teofil Uracz odjął zbolałą głowę od kamienia, westchnął, jęknął[,] i opierając się silnie rękami o ścianę, powstał, z[ ]wolna prostując swą niską, przysadkowatą, barczystą postać"
                            },
                            {
                                "example_id": "31cf0311-b527-4ecd-8518-c324bdf67909",
                                "sense_id": "e76a0087-b3fa-346a-8a05-6db0c47f3f9b",
                                "text": "Na ich spotkanie wyszedł jegomość[,] opalony na kolor razowego chleba, wąsaty, przysadkowaty, typowy pan »okumon«"
                            },
                            {
                                "example_id": "ecc45b03-b1b7-442d-a192-36e4ff9cf353",
                                "sense_id": "e76a0087-b3fa-346a-8a05-6db0c47f3f9b",
                                "text": "Sala była niska, lecz obszerna, a jej sufit opierał się na mnóstwie przysadkowatych kolumn"
                            },
                            {
                                "example_id": "018a13bb-b307-4a69-8f0c-9fd6158557ac",
                                "sense_id": "e76a0087-b3fa-346a-8a05-6db0c47f3f9b",
                                "text": "Dzięcioł opuścił schronienie nocne w dziupli, wydał krzyk podobny do śmiechu ludzkiego i już myka naokolusieńko po pniach omszonych. Ptak to pracowity, sprężysty, przysadkowaty, ogromnie tęgi w karku, w barach, łbie, a równie tęgi w ogonie"
                            },
                            {
                                "example_id": "3ddd9469-8502-48bd-a6b5-023dcdd9518a",
                                "sense_id": "e76a0087-b3fa-346a-8a05-6db0c47f3f9b",
                                "text": "Przez pół otwarte drzwi ujrzałem w drugim pokoju towarzystwo, siedzące przy stole—na pierwszym miejscu siedziała czerwona, przysadkowata jejmość, o której domyśliłem się, że była to pani Klonowska"
                            },
                            {
                                "example_id": "3318bdde-e421-4e13-8998-344203170e10",
                                "sense_id": "e76a0087-b3fa-346a-8a05-6db0c47f3f9b",
                                "text": "Był to szlachcic przysadkowaty i[ ]mały, w szaraczkowym kontuszu i karmazynowym żupanie, twarzy prawie pąsowéj, ale tak gęsto pokiereszowanéj, jak bót stary łatany, co mu dawało wyraz dziwnie charakterystyczny i niemal typowy sejmikowego rębacza"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3cf14657-e06c-3045-97bf-a6ffbf9b68b2",
                        "entry_id": "69161ee7-516c-33c9-a9fc-9154fb665b47",
                        "glosses": [
                            "opatrzony przysadkami"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4fcdf59a-87dc-40ac-971e-f677f40c53ea",
                                "sense_id": "3cf14657-e06c-3045-97bf-a6ffbf9b68b2",
                                "text": ", przy nasadzie liści przysadkami jest opatrzona"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
