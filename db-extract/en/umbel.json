                                    },
                                    {
                                        "sense_id": "2fa843aa-2540-302f-bca6-f4529e092d79",
                                        "entry_id": "b53c5ade-0fdf-3bc8-ae85-e8e11457b9fc",
                                        "glosses": [
                                            "de monitor zn van een toestel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afd9dc26-d669-430e-995f-18d1d95fdcc8",
                                                "sense_id": "2fa843aa-2540-302f-bca6-f4529e092d79",
                                                "text": "Hij scrolt ondertussen over het scherm van zijn mobiele telefoon."
                                            },
                                            {
                                                "example_id": "52e60abd-660e-44d0-8259-0f2ba4689dec",
                                                "sense_id": "2fa843aa-2540-302f-bca6-f4529e092d79",
                                                "text": "Tot mijn verbazing zie ik de naam van een bekende castingagente op het scherm staan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9ffe39c-653e-37b7-a2a7-c1199c7da2aa",
                                        "entry_id": "b53c5ade-0fdf-3bc8-ae85-e8e11457b9fc",
                                        "glosses": [
                                            "een onderdeel van een bioscoop"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a83744f-d1be-3f20-9260-d24f46bbc6db",
                                        "entry_id": "b53c5ade-0fdf-3bc8-ae85-e8e11457b9fc",
                                        "glosses": [
                                            "een projectiescherm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3770765a-6959-4e5a-8963-1f982a82567e",
                                                "sense_id": "4a83744f-d1be-3f20-9260-d24f46bbc6db",
                                                "text": "Duizenden supporters waren voor de wedstrijd naar De Kuip in Rotterdam gereisd, maar ook in Deventer zelf werd het duel nauwlettend gevolgd. Op terrassen en in kroegen in de binnenstad zagen mensen op grote schermen hoe AZ na strafschoppen werd verslagen."
                                            },
                                            {
                                                "example_id": "e668105b-67e5-4be2-a168-d7dbcf329644",
                                                "sense_id": "4a83744f-d1be-3f20-9260-d24f46bbc6db",
                                                "text": "De rest is geschiedenis, gedetailleerd te zien op de expositie in Assen. Achter het podium met de oude gitaren hangt het scherm waarop de films te zien zijn van de Amerikaanse bluesreizen die Muskee maakte met Albert Haar. Daar zijn ook de beelden te zien van het karige Tutwiler, Mississippi, waar ze op zoek gingen naar het graf van Sonny Boy Williamson II."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95b60244-bbb2-3dc4-9755-259d6c44fb3d",
                                        "entry_id": "b53c5ade-0fdf-3bc8-ae85-e8e11457b9fc",
                                        "glosses": [
                                            "een bloeiwijze waarbij alle zijassen (bloemstelen) uit één punt ontspringen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
