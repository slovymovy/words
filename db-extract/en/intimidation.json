                                            {
                                                "example_id": "845de95b-ccf6-4b5f-ad20-daf004558837",
                                                "sense_id": "dfd274f1-060f-303d-a02d-d7113751ef9d",
                                                "text": "Geweld en intimidatie zijn volgens koning Willem-Alexander \"nooit de oplossing\". Dat zei hij woensdag na afloop van het staatsbezoek aan Oostenrijk, toen hem werd gevraagd naar de situatie rondom boeren en de stikstofcrisis in Nederland."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8c6df3c-1498-4c79-8c5d-7b84bb6a8d56",
                        "source_entry_id": "7ec0f7dd-b984-3c75-9eed-1c40df9cb87a",
                        "source_sense_id": "449f5091-a1f6-355e-adc8-4e3539af6432",
                        "source_sense_description": "act of making timid or fearful",
                        "target_lang_word": "intimidation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intimidation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5b0fc7f-93d1-33ae-b1cd-5567b00ba899",
                                        "entry_id": "1d78c5e6-63c4-3238-bec6-1a24b7fcc16c",
                                        "glosses": [
                                            "Action d’intimider."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d77da781-bcda-4484-be0f-f7a0703aa9ef",
                                                "sense_id": "e5b0fc7f-93d1-33ae-b1cd-5567b00ba899",
                                                "text": "« Pas de menaces, pas d’interventions violentes », convient la procureure, Solenne Briand, « mais ils caractérisent bien des intimidations »."
                                            },
                                            {
                                                "example_id": "8a7a41fb-d521-4f13-9051-ec9d4505bb04",
                                                "sense_id": "e5b0fc7f-93d1-33ae-b1cd-5567b00ba899",
                                                "text": "Le manuel d’histoire mettait en valeur le courage du commandant Lospinoso résistant à toutes les intimidations de la Gestapo pour sauver près de cinq mille réfugiés juifs."
                                            },
                                            {
                                                "example_id": "1c6afcc3-ed96-484b-a91e-d7c6db57710e",
                                                "sense_id": "e5b0fc7f-93d1-33ae-b1cd-5567b00ba899",
                                                "text": "« Le blasphème est toujours dangereux, non plus à cause de la loi, mais à cause des intimidations », observe Khadija Khan, journaliste britannique menacée de mort pour apostasie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4083314-f384-416e-9544-642f7202f2bd",
                        "source_entry_id": "7ec0f7dd-b984-3c75-9eed-1c40df9cb87a",
                        "source_sense_id": "449f5091-a1f6-355e-adc8-4e3539af6432",
                        "source_sense_description": "act of making timid or fearful",
                        "target_lang_word": "Einschüchterung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einschüchterung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8564d127-9092-3ea4-b70b-0444afafcbf1",
                                        "entry_id": "8aca9ce1-f68e-3934-ad9f-4c5b3c56b3eb",
                                        "glosses": [
                                            "das bewusste Auslösen von Furcht/Unsicherheit bei jemandem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32f0df9b-2e27-4dfe-9a49-51a6e63f25e8",
                                                "sense_id": "8564d127-9092-3ea4-b70b-0444afafcbf1",
                                                "text": "„Die Einschüchterung ist der wohl häufigste Psycho-Trick unter den Führungskräften, nicht selten wird er sogar in speziellen, fragwürdigen Führungsseminaren gelehrt.“"
                                            },
                                            {
                                                "example_id": "96ad0c8e-9025-4c04-a6a2-808e1958d985",
                                                "sense_id": "8564d127-9092-3ea4-b70b-0444afafcbf1",
                                                "text": "„In dem Bericht, in dem von ›erheblicher Einschüchterung‹ die Rede ist, werden etliche Beispiele geschildert.“"
                                            },
                                            {
                                                "example_id": "47426712-baf9-477e-973a-be054c49a2c8",
                                                "sense_id": "8564d127-9092-3ea4-b70b-0444afafcbf1",
                                                "text": "„Neuerdings beobachtet Strittmatter eine ›neue Qualität‹ der Maßnahmen, da inzwischen auch Journalisten aus Europa Einschüchterung und Bedrohung erleben.“"
                                            },
                                            {
                                                "example_id": "da704425-e6a0-46ff-afaa-26ba1f944c77",
                                                "sense_id": "8564d127-9092-3ea4-b70b-0444afafcbf1",
                                                "text": "„Kaum ein Schiedsrichter […] könnte sich dem Klima von Bestechung auf der einen und Einschüchterung auf der anderen Seite entziehen.“"
                                            },
                                            {
                                                "example_id": "8c589a8d-74e4-4556-baac-9827bd5b521f",
                                                "sense_id": "8564d127-9092-3ea4-b70b-0444afafcbf1",
                                                "text": "Charakterschwache Nachstellerinnen nutzen das Instrument des Nachstellens zur Einschüchterung ihrer Opfer."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f173c6c9-1d57-4e68-9ecd-684a4bf2bda2",
