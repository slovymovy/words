                ],
                "senses": [
                    {
                        "sense_id": "9a9fa846-b43a-37af-a208-8c9394442dd2",
                        "entry_id": "5f27c625-7fe4-3335-bd0a-ec5a8d38b63c",
                        "glosses": [
                            "Bei den Runeninschriften handelt es sich um die ältesten Schriftdenkmäler des Germanischen, geschrieben mit Runen, einem eigenen Schriftzeichensystem (Futhark)"
                        ],
                        "tags": [
                            "Skandinavistik"
                        ],
                        "examples": [
                            {
                                "example_id": "1ee08635-ff5e-47a7-af91-6e67818375c0",
                                "sense_id": "9a9fa846-b43a-37af-a208-8c9394442dd2",
                                "text": "Viele bekannte Runeninschriften finden sich auf Runensteinen."
                            },
                            {
                                "example_id": "73d33876-7dce-47b4-9be9-e5f23bf0164e",
                                "sense_id": "9a9fa846-b43a-37af-a208-8c9394442dd2",
                                "text": "Die ältesten Runeninschriften stammen aus der Zeit kurz nach Christi Geburt."
                            },
                            {
                                "example_id": "7ac1dd40-44fb-4e70-907e-a0eb7ba7bd37",
                                "sense_id": "9a9fa846-b43a-37af-a208-8c9394442dd2",
                                "text": "„Es sind ca. 5000 (meist nur sehr kurze) Runeninschriften bekannt, davon 3000 allein in Schweden, in Deutschland wurden bis jetzt nur ca. 30 gefunden.“"
                            },
                            {
                                "example_id": "1500391b-c289-41f1-a5c9-894fc7c67b34",
                                "sense_id": "9a9fa846-b43a-37af-a208-8c9394442dd2",
                                "text": "„Runeninschriften können grundsätzlich rechts- oder linksläufig angebracht sein.“"
                            },
                            {
                                "example_id": "4dda18c8-448e-4bb2-8be1-1c389e37fd7e",
                                "sense_id": "9a9fa846-b43a-37af-a208-8c9394442dd2",
                                "text": "„Einzelrunen und Runeninschriften konnten auf verschiedenem Material angebracht werden.“"
                            },
                            {
                                "example_id": "b1022961-5328-4190-a580-34bc1767746d",
                                "sense_id": "9a9fa846-b43a-37af-a208-8c9394442dd2",
                                "text": "„Die Sprache der Nordgermanen, das Nordische, ist von etwa 200 nach Christus an durch Runeninschriften bezeugt.“"
                            },
                            {
                                "example_id": "4d9600e5-39ce-49cc-a3f7-0f067e7723fd",
                                "sense_id": "9a9fa846-b43a-37af-a208-8c9394442dd2",
                                "text": "„In Runeninschriften, die sie in mächtige Steine ritzen, rühmen die Wikinger die Taten von Kriegern, Herrschern und Mäzenen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
