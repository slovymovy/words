        "fr-extract.jsonl": [
            {
                "entry_id": "f8cdbb05-7b6f-39bd-844b-216553134627",
                "word": "superstitieux",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5cc212b8-1523-4f62-8dc1-fc5921a01240",
                        "entry_id": "f8cdbb05-7b6f-39bd-844b-216553134627",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "superstitieuse"
                    },
                    {
                        "form_id": "89479851-cd3e-4a3f-89c4-d9d90e38d018",
                        "entry_id": "f8cdbb05-7b6f-39bd-844b-216553134627",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "superstitieuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "807e0c0f-1179-3cc7-825a-00e82db6d6ea",
                        "entry_id": "f8cdbb05-7b6f-39bd-844b-216553134627",
                        "glosses": [
                            "Qui vit dans la superstition ; qui craint les effets des influences surnaturelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fbb3a21-36f7-4adf-b244-0e6a969252cb",
                                "sense_id": "807e0c0f-1179-3cc7-825a-00e82db6d6ea",
                                "text": "Depuis que le Saint-Pierre est coulé, l’Alose ne drague plus, et des pêcheurs superstitieux prétendent que cet amatelotage rompu par la mort, ne vaut rien pour les vivants..."
                            },
                            {
                                "example_id": "68259c20-e9cc-4c4d-ba21-ded3fe8b21c4",
                                "sense_id": "807e0c0f-1179-3cc7-825a-00e82db6d6ea",
                                "text": "« Mauvais présage ! » disaient les personnes superstitieuses ; et le nombre en est grand en Lithuanie."
                            },
                            {
                                "example_id": "ba1fea46-e9d4-43c8-a64c-fcb5471651c2",
                                "sense_id": "807e0c0f-1179-3cc7-825a-00e82db6d6ea",
                                "text": "— Ma sœur Rosalie, c’est à vous de couper…\n— De la main gauche !… Je coupe toujours de la main gauche.\n— Est-ce que vous seriez superstitieuse ?\n— Non… mais c’est une idée que j’ai comme ça !…"
                            },
                            {
                                "example_id": "42e0ae26-2f79-47a1-84d4-3dc02e2fc735",
                                "sense_id": "807e0c0f-1179-3cc7-825a-00e82db6d6ea",
                                "text": "Bumper savait tout de la guerre et des pouvoirs paranormaux. Il attribuait sa survie aux divers pressentiments qui l'avaient assailli là-bas, dans la jungle. Il croyait dur comme fer au sixième sens, aux signes, aux présages. Comme beaucoup de vétérans, il était extrêmement superstitieux."
                            }
                        ]
                    },
                    {
                        "sense_id": "0775b802-9829-35c0-bc53-101c36098165",
                        "entry_id": "f8cdbb05-7b6f-39bd-844b-216553134627",
                        "glosses": [
                            "Où il y a de la superstition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13f2b906-9794-4e0b-8a78-452b5c60e33e",
                                "sense_id": "0775b802-9829-35c0-bc53-101c36098165",
                                "text": "[…] au bruit de leurs pas ils entendaient […] fuir les animaux sauvages, dont la présence multipliée indiquait que ces ruines solitaires étaient gardées contre la présence des hommes par quelque superstitieuse terreur."
                            },
                            {
                                "example_id": "00a8d029-3309-4708-9fcc-74a34a61f198",
                                "sense_id": "0775b802-9829-35c0-bc53-101c36098165",
                                "text": "Son enfance s’était passée calme et décolorée dans les pratiques religieuses ou plutôt superstitieuses qui, au Mexique, forment le fond de la religion."
                            }
                        ]
                    },
                    {
                        "sense_id": "5678894e-ea67-3ea9-b0c7-6ecbcd40ef28",
                        "entry_id": "f8cdbb05-7b6f-39bd-844b-216553134627",
                        "glosses": [
                            "Qui fait preuve d’un attachement tatillon à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "744af30a-b83d-4dfb-8643-e40046902cf7",
                                "sense_id": "5678894e-ea67-3ea9-b0c7-6ecbcd40ef28",
                                "text": "Le soldat des guerres de la Liberté attachait une importance presque supersti­tieuse à l’accomplissement des moindres consignes. De là résulte qu'il n'éprouvait aucune pitié pour les généraux ou les fonctionnaires qu'il voyait guillotiner après quelque défaite, sous l'inculpation de manquement à leur devoir ; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68535542-b8a9-4a22-9bd9-98c9bba4ccaa",
                        "source_entry_id": "f8cdbb05-7b6f-39bd-844b-216553134627",
                        "target_lang_word": "abergläubisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abergläubisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0f7ba30-7c4d-3e37-8257-77380d6912b0",
                                        "entry_id": "420534d4-6b9e-3dc4-8eb8-f6a1101967ca",
                                        "glosses": [
                                            "voller Aberglauben, vom Aberglauben voll oder teilweise überzeugt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ececae-8cbb-4ab0-a968-915eff642eeb",
                                                "sense_id": "b0f7ba30-7c4d-3e37-8257-77380d6912b0",
                                                "text": "Wer abergläubisch ist, würde sich womöglich weigern, ein Zimmer mit der Nummer 13 in einem Hotel zu mieten."
                                            },
                                            {
                                                "example_id": "2c350d6b-5444-404a-bc48-7ddc9482d876",
                                                "sense_id": "b0f7ba30-7c4d-3e37-8257-77380d6912b0",
                                                "text": "Abergläubische Menschen gehen nicht unter Leitern durch oder pfeifen auf einer Theaterbühne."
                                            },
                                            {
                                                "example_id": "e9d619a1-4f06-42f3-8c25-bbaf093ceab4",
                                                "sense_id": "b0f7ba30-7c4d-3e37-8257-77380d6912b0",
                                                "text": "„Wenn wir auf ihre Intelligenz zu sprechen kamen, gedachte meine Frau, die übrigens nicht im geringsten abergläubisch war, manchmal des alten Volksglaubens, daß Hexen oft die Gestalt schwarzer Katzen anzunehmen pflegen. Nicht, daß sie damit jemals eine ernstliche Anspielung hätte machen wollen – ich erwähne es nur, weil ich gerade jetzt daran dachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8896dfa8-7111-4ced-897e-c80a414a5732",
                        "source_entry_id": "f8cdbb05-7b6f-39bd-844b-216553134627",
