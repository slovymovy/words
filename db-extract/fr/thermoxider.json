                "senses": [
                    {
                        "sense_id": "bae20b7e-ca15-3868-96bc-71b133a5aeb5",
                        "entry_id": "42162688-c7a5-3553-b44e-5d98357d3f3a",
                        "glosses": [
                            "Oxyder dans des conditions de température élevée."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6dfba84d-4671-4f59-bcc2-f93a738efb30",
                                "sense_id": "bae20b7e-ca15-3868-96bc-71b133a5aeb5",
                                "text": "Le thermoxigène naissant se combine au métal et à l’huile. Le premier se thermoxide et se dissout dans l’acide nitrique, et l’huile se cérifie."
                            },
                            {
                                "example_id": "c6b74721-a8ad-40f0-b0cd-b717737b846d",
                                "sense_id": "bae20b7e-ca15-3868-96bc-71b133a5aeb5",
                                "text": "C’est pourquoi quelques métaux demandent l’intermède de la chaleur pour pouvoir se thermoxider dans les acides concentrés."
                            }
                        ]
                    }
