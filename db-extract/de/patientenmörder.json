                "senses": [
                    {
                        "sense_id": "3dbf376e-d8c7-39dc-976f-6b8cb17fd693",
                        "entry_id": "9e9d1806-263d-36cf-951f-97efe1ba2aea",
                        "glosses": [
                            "Person, die Patienten mit bewusst unzulässigen Medikationen zu Tode bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae5dce8c-9f1d-48e3-b82c-7ec8ae7c87d5",
                                "sense_id": "3dbf376e-d8c7-39dc-976f-6b8cb17fd693",
                                "text": "„Es gibt wohl keinen zweiten Menschen in Deutschland, der so viel über die Motive von Patientenmördern nachgedacht hat wie Beine.“"
                            },
                            {
                                "example_id": "fce3486b-c003-4131-9b7d-ab186299c364",
                                "sense_id": "3dbf376e-d8c7-39dc-976f-6b8cb17fd693",
                                "text": "„Es gibt keinen bekannten Fall, in dem ein Patientenmörder von alleine mit dem Töten aufhörte.“"
                            },
                            {
                                "example_id": "6d36ac7c-436e-4ecb-a9b2-cbd0fa6241fb",
                                "sense_id": "3dbf376e-d8c7-39dc-976f-6b8cb17fd693",
                                "text": "„Er soll für die größte Mordserie in der deutschen Nachkriegsgeschichte verantwortlich sein: Der verurteilte Patientenmörder Niels H. soll weitere 84 Menschen in den Kliniken in Oldenburg und Delmenhorst getötet haben, wie die Ermittlungen der Staatsanwaltschaft zeigten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
