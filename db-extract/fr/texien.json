                        "glosses": [
                            "Personne habitant le Texas, ou qui en est originaire."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a880759f-ab94-4faf-bc6a-181d50851b6b",
                                "sense_id": "3907a40f-7aa7-3ca7-8537-a11332603a1f",
                                "text": "Alors, on vit le Texien descendre avec un fouet semblable à un serpent noir et terminé par une boucle et passer derrière le troupeau, en le poussant vers la barrière à coups de fouet sur les croupes bigarrées."
                            }
                        ]
