                    {
                        "sense_id": "0f462e7f-9822-3d80-922b-bebbd1378ec0",
                        "entry_id": "04545cad-f6b6-33c1-9360-c74957bef7f2",
                        "glosses": [
                            "Prothèse comblant l’intérieur d’une dent cassée ou cariée."
                        ],
                        "tags": [],
