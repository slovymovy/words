            "senses": [
                {
                    "sense_id": "d5e39bb3-46ac-3429-9607-b48e87449b18",
                    "sense_definition": "For that reason; consequently.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "logical_consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop was closed, and <w>therefore</w> we could not buy any milk.",
                            "target_lang_translations": {
                                "ru": "Магазин был закрыт, и <w>поэтому</w> мы не смогли купить молока.",
                                "tr": "Dükkan kapalıydı, <w>bu yüzden</w> hiç süt alamadık."
                            }
                        },
                        {
                            "text": "She studied very hard for the test and <w>therefore</w> achieved a high score.",
                            "target_lang_translations": {
                                "ru": "Она очень усердно готовилась к тесту и <w>поэтому</w> получила высокий балл.",
                                "tr": "Sınava çok çalıştı ve <w>dolayısıyla</w> yüksek bir puan aldı."
                            }
                        },
                        {
                            "text": "I think, <w>therefore</w> I am.",
                            "target_lang_translations": {
                                "ru": "Я мыслю, <w>следовательно</w>, я существую.",
                                "tr": "Düşünüyorum, <w>öyleyse</w> varım."
                            }
                        }
                    ],
                    "synonyms": [
                        "consequently",
                        "as a result",
                        "so",
                        "thus",
                        "hence",
                        "accordingly",
                        "ergo"
                    ],
                    "antonyms": [
                        "nevertheless"
                    ],
                    "common_phrases": [
