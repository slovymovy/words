                    {
                        "translation_id": "ea9445b7-9a54-4be5-9ebe-28d1febe2921",
                        "source_entry_id": "57f0b66a-a4ae-3a29-9bee-69a7b6bb5d54",
                        "source_sense_description": "island region",
                        "target_lang_word": "Zanzibar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zanzibar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "92d6b50a-2c86-3d1e-8c3f-5e52315ee750",
                                        "entry_id": "1bb14375-11cf-3182-940e-3357928f3393",
                                        "glosses": [
                                            "eiland ten oosten van Tanzania"
                                        ],
                                        "tags": [
                                            "toponiem: eiland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8d4bdaf-3fcb-4900-98ed-def80c9e2f78",
                                                "sense_id": "92d6b50a-2c86-3d1e-8c3f-5e52315ee750",
                                                "text": "In mijn studententijd heb ik een klein jaar op Zanzibar gewoond, voor een stage op een luxe resort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1bc3f8f-3419-364c-ae24-1da61d9a4d1f",
                                        "entry_id": "1bb14375-11cf-3182-940e-3357928f3393",
                                        "glosses": [
                                            "stad op het gelijknamige eiland"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "335c9e97-8d59-4e7e-920a-3a736531941a",
                                                "sense_id": "d1bc3f8f-3419-364c-ae24-1da61d9a4d1f",
                                                "text": "Je ziet eruit als de burgemeester van Zanzibar, Paulie."
                                            },
                                            {
                                                "example_id": "f306f6da-d6d2-403e-8d86-3013d30e7ef0",
                                                "sense_id": "d1bc3f8f-3419-364c-ae24-1da61d9a4d1f",
                                                "text": "In Zanzibar belandde ik ooit in het stoffige winkeltje van een oude Indiase fotograaf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04641db5-03ac-3d7a-8f93-c3bc051936c5",
                                        "entry_id": "1bb14375-11cf-3182-940e-3357928f3393",
                                        "glosses": [
                                            "deelstaat van Tanzania, die naast het eiland Zanzibar ook het eiland Pemba en enkele kleinere eilanden omvat"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1b51451-6e80-4531-bba5-6fe4547ad5e1",
                                                "sense_id": "04641db5-03ac-3d7a-8f93-c3bc051936c5",
                                                "text": "De relatie tussen het vasteland (ruim 37 miljoen inwoners) en Zanzibar (een miljoen mensen) is al meer dan veertig jaar gespannen. Al sinds Tanganyika en Zanzibar in 1964 samen een unie vormden. Dat was kort nadat ze zich hadden bevrijd van hun koloniale heersers, Tanganyika in 1961 van Groot-Brittannië, Zanzibar in 1963 van de sultan van Oman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70a8b410-1e72-37eb-92d1-5d2e2c95226d",
                                        "entry_id": "1bb14375-11cf-3182-940e-3357928f3393",
                                        "glosses": [
                                            "naam van een sultanaat gevestigd op het eiland Zanzibar dat in de 19e en 20e eeuw ook gebieden op het vasteland van Afrika omvatte"
                                        ],
                                        "tags": [
                                            "historical",
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96760b6b-57e4-4beb-8357-c594c13e7185",
                                                "sense_id": "70a8b410-1e72-37eb-92d1-5d2e2c95226d",
                                                "text": "⧖ De oppervlakte, aan het beginsel van handelsvrijheid voor alle natiën door de Akte zelve onderworpen, bedraagt meer dan 3 millioen vierkante meters: wordt, ingevolge den door de Conferentie uitgesproken wensch, het beginsel ook uitgestrekt tot de landen tusschen de oostelijke grenslijn en de Indische zee (hetgeen van groot belang zou zijn voor den doorvoer van die zee naar het Congo-bekken) dan zal de geheele oppervlakte ongeveer 6 millioen vierkante meters bedragen. Voor deze uitbreiding zal bepaaldelijk de toestemming van den sultan van Zanzibar vereischt worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f97a8c2-ba68-43d9-a77b-311ff0d23b9d",
                        "source_entry_id": "57f0b66a-a4ae-3a29-9bee-69a7b6bb5d54",
                        "source_sense_description": "island region",
                        "target_lang_word": "Zanzibar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zanzibar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df4b0ff3-ef56-32ab-b322-d0d5c4c1028f",
                                        "entry_id": "0884c185-4a22-3f06-a4b7-c0ae361539a0",
                                        "glosses": [
                                            "Archipel tanzanien."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1527c41f-88c8-4c22-a251-18b237f907de",
                                                "sense_id": "df4b0ff3-ef56-32ab-b322-d0d5c4c1028f",
                                                "text": "Le crassispina est connu habiter, hors l’Inde archipélagique, la Mer rouge, les côtes de Zanzibar, des Seychelles, de Madras, de Chine et de la Nouvelle-Hollande septentrionale."
                                            },
                                            {
                                                "example_id": "a65dfb2c-f6fe-4ea8-9128-8dcc84e176fd",
                                                "sense_id": "df4b0ff3-ef56-32ab-b322-d0d5c4c1028f",
                                                "text": "Zanzibar… Je n’aurais plus jamais loisir de m’y rendre. Zanzibar, paradis dans l’océan Indien, embaumé de clous de girofle."
                                            },
                                            {
                                                "example_id": "66dd7a90-f75d-421d-b57b-031e431f1c10",
                                                "sense_id": "df4b0ff3-ef56-32ab-b322-d0d5c4c1028f",
                                                "text": "La Tanzanie, pays de 58 millions d’habitants connu pour ses parcs naturels, l’île de Zanzibar et le Kilimandjaro, a longtemps été considérée comme un havre de stabilité dans une région particulièrement volatile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03582750-f495-34f6-a78c-3dee4257b669",
                                        "entry_id": "0884c185-4a22-3f06-a4b7-c0ae361539a0",
                                        "glosses": [
                                            "Sultanat de Zanzibar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85ea0503-d7e7-3949-90be-a2bb2b3b545e",
                                        "entry_id": "0884c185-4a22-3f06-a4b7-c0ae361539a0",
                                        "glosses": [
                                            "Protectorat de Zanzibar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "997aabc5-0040-3a69-b32e-4015c795680c",
                                        "entry_id": "0884c185-4a22-3f06-a4b7-c0ae361539a0",
                                        "glosses": [
                                            "Pays indépendant, situé dans l’archipel de Zanzibar et ayant existé entre le 10 septembre 1963 et le 26 avril 1964."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c45f78b-3830-310b-bb62-76d754d25388",
                                        "entry_id": "0884c185-4a22-3f06-a4b7-c0ae361539a0",
                                        "glosses": [
                                            "Ville de Zanzibar, localité la plus importante de l’archipel du même nom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4a33527-c498-40cd-8b72-e5665c574def",
                                                "sense_id": "9c45f78b-3830-310b-bb62-76d754d25388",
                                                "text": "En passant d’un monument à l’autre, vous conviendrez que Zanzibar est un musée, un livre d’histoire à ciel ouvert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbe008ee-792f-49e6-aea8-cfaf3fc2ee79",
                        "source_entry_id": "57f0b66a-a4ae-3a29-9bee-69a7b6bb5d54",
