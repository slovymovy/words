                                        "entry_id": "687d5d92-4c0a-3111-984d-92677a6871ff",
                                        "glosses": [
                                            "Sport combinant le tennis, le squash, le badminton et le tennis de table au sein d’une même compétition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54e4094b-24d6-41f4-9c17-c6019ebad544",
                                                "sense_id": "78917f94-3f1a-39f7-a41a-edb5c79bc6ee",
                                                "text": "Participer à une compétition qui conjugue le tennis, le squash, le badminton et le tennis de table, voici le programme du racketlon."
                                            },
                                            {
                                                "example_id": "f75ec7f7-4a90-417d-bd2e-0fa2d6b90968",
                                                "sense_id": "78917f94-3f1a-39f7-a41a-edb5c79bc6ee",
                                                "text": "Le racketlon est un sport qui nous vient tout droit du Nord de l’Europe."
                                            },
                                            {
                                                "example_id": "2b5719a8-37b8-43e0-b01e-9a75273fec3e",
                                                "sense_id": "78917f94-3f1a-39f7-a41a-edb5c79bc6ee",
                                                "text": "Le racketlon, qui combine tennis de table, badminton, squash et tennis, dans un même sport, essaie de grandir en France."
                                            }
                                        ]
                                    }
