                    {
                        "sense_id": "b5418197-5417-3196-84f1-e980ab06122f",
                        "entry_id": "bf61a5ff-6b6d-32cc-9ed8-6f4135ed85be",
                        "glosses": [
                            "S’attacher soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f217e4cb-4427-4820-be6c-568655406dee",
                                "sense_id": "b5418197-5417-3196-84f1-e980ab06122f",
                                "text": "Cette erreur se produit lorsque le débogueur essaie de s'auto-attacher à une application Web qui utilise une adresse IP."
                            },
                            {
                                "example_id": "9e884af0-9742-4631-9634-bf152c049404",
                                "sense_id": "b5418197-5417-3196-84f1-e980ab06122f",
                                "text": "Comme vous le voyez, les changements seraient plutôt minimes puisqu'ils se résument à l'intégration d'un micro, à une refonte de la touche Home en une touche PS, à un anneau métallique plus fin et à de petites icônes pour éviter aux débiles de s'auto-attacher avec deux pauvres fils."
                            },
                            {
                                "example_id": "21e5ebaf-863d-44e9-8f48-f3bc740b63cd",
                                "sense_id": "b5418197-5417-3196-84f1-e980ab06122f",
                                "text": "demain j'ai rdv si elle me dit que le col s'est encore modifié je m'auto-attache au canapé"
                            }
                        ]
                    }
