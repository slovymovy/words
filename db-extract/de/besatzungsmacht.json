                                        "sense_id": "e81ba58a-a365-3916-822c-864277303be6",
                                        "entry_id": "1dfa0f38-2dba-37ff-9b52-c5981e4bc334",
                                        "glosses": [
                                            "Qui occupe un lieu."
                                        ],
                                        "tags": [],
