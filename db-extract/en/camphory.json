                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46abd4ee-6242-4c9c-8695-b328ea924115",
                                "sense_id": "a749cedf-4693-32ef-a698-59e99b153eb4",
                                "text": "\"Here are cigars—some of your old ones. I found them in a trunk of mine, inside a camel's-hair shawl. You said they would keep the moths out. Don't you remember?\" Kate was very voluble just here. ¶ \"They must be camphory.\""
                            },
                            {
                                "example_id": "165f6208-0b49-48a8-95d5-54d9aeb72a33",
                                "sense_id": "a749cedf-4693-32ef-a698-59e99b153eb4",
                                "text": "Father had a splendid chest of camphor-wood which had come from England round the Horn in a sailing-ship with him. His clean clothes lived in it and on Sunday he was very camphory."
                            },
                            {
                                "example_id": "af7eb08e-bc4d-4ab1-9a7d-5ce3c9f6f377",
                                "sense_id": "a749cedf-4693-32ef-a698-59e99b153eb4",
                                "text": "In thickets and woods, Wisteria floribunda is a common native there and is about to reach its flowering peak, filling its glades with that characteristic fruity, tuberose, mildly camphory scent."
                            }
                        ]
                    }
