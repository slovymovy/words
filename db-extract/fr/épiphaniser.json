                ],
                "senses": [
                    {
                        "sense_id": "468f0caa-135c-3216-9295-f49a61beff43",
                        "entry_id": "1077e55b-1ee1-3ef5-856b-e7fe735388a4",
                        "glosses": [
                            "Révéler, manifester (ce qui était caché)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1e87c9b-2a9f-4a7f-ac83-9093c6b7bb24",
                                "sense_id": "468f0caa-135c-3216-9295-f49a61beff43",
                                "text": "Celui-ci épiphanise l’un des plus parfaits attributs qui ait jamais été créé, c’est-à-dire l’attribut de la parole."
                            },
                            {
                                "example_id": "0c6053a3-eccc-4a82-8eb9-05231d04581e",
                                "sense_id": "468f0caa-135c-3216-9295-f49a61beff43",
                                "text": "Ainsi que le dira Dârâ Chukûh dans son Majma’al-Bahrayn, la Lumière divine peut s’épiphaniser sous n’importe quelle couleur."
                            },
                            {
                                "example_id": "252c4218-6f74-4d72-bf67-efa6365c7a66",
                                "sense_id": "468f0caa-135c-3216-9295-f49a61beff43",
                                "text": "Au moment de la seconde création, lorsqu’Il leur parla en maître, ces délices se réveillèrent dans les esprits, amenant leur amour à s’épiphaniser."
                            }
                        ]
                    }
                ],
