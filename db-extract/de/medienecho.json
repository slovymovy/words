                "senses": [
                    {
                        "sense_id": "892c990d-ec4f-3e82-a096-13046f4b2446",
                        "entry_id": "61bf2245-9cbc-3001-b712-c1760cc3ff19",
                        "glosses": [
                            "Reaktion von Presse, Funk und Fernsehen (= den Medien) auf eine Nachricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b15cf27-ceee-4af6-a582-62ddef7054ac",
                                "sense_id": "892c990d-ec4f-3e82-a096-13046f4b2446",
                                "text": "Das Medienecho auf diesen Skandal ist enorm."
                            },
                            {
                                "example_id": "bc605d67-5da4-4672-8b0d-9b41ffcbd7de",
                                "sense_id": "892c990d-ec4f-3e82-a096-13046f4b2446",
                                "text": "Eine führende Fast-Food-Kette hält auf ihrer Website vollständige Angaben für alle Produkte für interessierte Verbraucher bereit, ohne dass sie dazu verpflichtet wäre. Positives Medienecho gab es für derart vorbildliches Verhalten bisher nicht."
                            },
                            {
                                "example_id": "2e41d874-7b9e-4c17-9e21-78fc30bbb9f2",
                                "sense_id": "892c990d-ec4f-3e82-a096-13046f4b2446",
                                "text": "[Der Radprofi Jan] Ullrich hatte sich wegen vieler [Doping-]Vorwürfe bereits 2007 aus dem aktiven Radsport zurückgezogen. Damals hatte sein Fall ein großes Medienecho hervorgerufen […]"
                            },
                            {
                                "example_id": "9b683f40-b60d-46b6-aa1b-bdfb45ecf7a2",
                                "sense_id": "892c990d-ec4f-3e82-a096-13046f4b2446",
                                "text": "„Die Eröffnung der Elbphilharmonie hat die Wahrnehmung auf Hamburg verändert. Die Besucherzahlen und das weltweite Medienecho mit mehr als 60.000 Veröffentlichungen haben unsere Erwartungen deutlich übertroffen,“ sagte der Chef der Marketing-Organisation, Michael Otremba."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
