                                        "examples": [
                                            {
                                                "example_id": "d64a7af8-bd58-4cc6-affa-7a89d3dc1a7b",
                                                "sense_id": "a38e66cc-ecbf-3588-92df-7d1d736f2b30",
                                                "text": "Le genre chimpanzé (Pan) se compose de deux espèces : Pan troglodytes, avec trois sous-espèces, et Pan paniscus. La première, connue depuis bien plus longtemps que la seconde, est habituellement appelée chimpanzé commun, la deuxième chimpanzé nain ou bonobo."
                                            }
