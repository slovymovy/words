                                "example_id": "90ce2222-71f5-4d96-a5a6-450dbef81ef8",
                                "sense_id": "62135caf-1b60-356f-bc14-5d31e1fe7833",
                                "text": "Планктону противопоставляют нектон, составляющийся из животных, свободно передвигающихся в воде."
                            }
                        ]
                    }
