                    {
                        "sense_id": "7a5996ec-c10f-338a-935b-529dd6b98723",
                        "entry_id": "790db32d-6452-3b88-b893-f6c6e807e80c",
                        "glosses": [
                            "een officiële verklaring dat men in een bepaald land mag werken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd36b970-1a5c-4cf2-a3a4-66029cdf57d2",
                                "sense_id": "7a5996ec-c10f-338a-935b-529dd6b98723",
                                "text": "Trump vindt dat de Verenigde Staten niet iedereen gewoon maar kunnen toelaten. De groep van bijna 800.000 mensen kon volgens Obama's regeling een werkvergunning aanvragen. De regering van Trump vindt dat zij daarmee banen kunnen innemen van degenen die daadwerkelijk recht op werk hebben."
                            },
                            {
                                "example_id": "91092db7-6e1b-44d4-a3a2-2282dda8e6b9",
                                "sense_id": "7a5996ec-c10f-338a-935b-529dd6b98723",
                                "text": "De FIFA verwacht van de beoogde WK-organisatoren onder meer overheidsgaranties betreffende immigratie (bij voorkeur zonder visa), werkvergunningen en belastingvrijstellingen voor onder meer de FIFA. Ook dienen de potentiële WK-gastheren de mensenrechten in alle opzichten te respecteren en de arbeidsomstandigheden goed te controleren."
                            },
                            {
                                "example_id": "cd49218b-4843-444f-ae76-bdc98569e038",
                                "sense_id": "7a5996ec-c10f-338a-935b-529dd6b98723",
                                "text": "Per direct geldt een totaalverbod op EU-investeringen in Noord-Korea en op de verkoop van ruwe olie en aardolieproducten. Noord-Koreaanse werknemers in de EU mogen nog maximaal 5000 euro naar hun thuisland overmaken. Werkvergunningen worden niet meer verlengd."
                            }
                        ]
