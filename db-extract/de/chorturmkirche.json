                            "Kunstgeschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "16a57af1-0531-44de-9cc1-acdc359d5451",
                                "sense_id": "122c8f7c-ef70-366c-9ced-b637da8b3de2",
                                "text": "\"Die Chorturmkirche ist kennzeichnender Typ meist kleinerer, mittelalterlicher Dorfkirchen in Mittel- und Westeuropa.\""
                            },
                            {
                                "example_id": "426490e1-fda9-4702-af82-707e443fe686",
                                "sense_id": "122c8f7c-ef70-366c-9ced-b637da8b3de2",
                                "text": "\"Der Begriff Chorturmkirche bezeichnet einen Kirchenbau, bei dem sich über dem Altar, meist über einem ausgeschiedenen Altarraum (Chor), ein das Sanktuarium auszeichnender Turm erhebt.\""
                            }
                        ],
