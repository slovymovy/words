                {
                    "sense_id": "a6128cdf-ccfc-301c-9636-229e96a00c26",
                    "sense_definition": "O umyśle: bystry, inteligentny, szybko kojarzący fakty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intellect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mimo podeszłego wieku, dziadek zachował <w>jasny</w> umysł.",
