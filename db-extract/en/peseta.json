                            "plural"
                        ],
                        "form": "pesetas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "28185483-09b3-3b0e-88c6-ad90e54938cf",
                        "entry_id": "428fcc09-6dd5-313c-a0c4-976b10ca4f30",
                        "glosses": [
                            "The former currency of the Spanish Empire and Andorra, divided into 100 céntimos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95de17c1-08b3-4e6b-b2bb-aef4030bf87a",
                                "sense_id": "28185483-09b3-3b0e-88c6-ad90e54938cf",
                                "text": "The task was more to Appleby's liking than the one he had anticipated, and it was necessary, since the smaller merchants in Cuba and also in parts of Peninsular Spain have no great confidence in bankers, and prefer a packet of golden onzas or a bag of pesetas to the best accredited cheque."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8fafabf-26ef-37ce-aa8c-a5d33e4353aa",
                        "entry_id": "428fcc09-6dd5-313c-a0c4-976b10ca4f30",
                        "glosses": [
                            "The Equatorial Guinean peseta, a former currency of Equatorial Guinea"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6aa41c3e-84f3-31cd-83b8-1f7f5bf81e6d",
                        "entry_id": "428fcc09-6dd5-313c-a0c4-976b10ca4f30",
                        "glosses": [
                            "The Sahrawi peseta, de jure currency of the Sahrawi Arab Democratic Republic."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ac12bf40-2f4c-392a-a0d1-1e703db2d99e",
                        "entry_id": "428fcc09-6dd5-313c-a0c4-976b10ca4f30",
                        "glosses": [
                            "The Catalan peseta, a former currency of Catalonia."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "280e76ae-4a40-4025-9e34-806dfddb3ee1",
                        "source_entry_id": "428fcc09-6dd5-313c-a0c4-976b10ca4f30",
                        "source_sense_description": "currency",
                        "target_lang_word": "peseta",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peseta",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3e07d3b-79c4-34f7-9053-6f06bbbdb1f3",
                                        "entry_id": "bee9bf54-e07e-301f-9162-6d3cec17f0da",
                                        "glosses": [
                                            "Ancienne monnaie espagnole et andorrane, remplacée par l’euro. Son symbole est ₧ (Unicode U+20A7)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea7964c7-088f-4d2c-a5cb-4e3ac7fdaad3",
                                                "sense_id": "e3e07d3b-79c4-34f7-9053-6f06bbbdb1f3",
                                                "text": "Deux autres voyageurs se trouvant logés à la même enseigne que moi, nous allons trouver un loueur de voitures qui se charge de nous transporter à notre destination pour la somme de 13 pesetas; et, quelques minutes plus tard, nous sommes confortablement installés dans un léger véhicule attelé de deux bons chevaux qui ne tardent pas à rattraper et à dépasser le coche public."
                                            },
                                            {
                                                "example_id": "78a8c686-f1a3-4e86-9f94-1fef82706970",
                                                "sense_id": "e3e07d3b-79c4-34f7-9053-6f06bbbdb1f3",
                                                "text": "Depuis 1888, la peseta s’était dépréciée sur le marché des changes en raison d’une augmentation de volume de la monnaie espagnole."
                                            },
                                            {
                                                "example_id": "9ff7afe5-4d03-4d4b-a713-194f91972848",
                                                "sense_id": "e3e07d3b-79c4-34f7-9053-6f06bbbdb1f3",
                                                "text": "Les petites gens du quartier venaient dîner dans cette friterie d’une portion d’anguilles à une peseta, ou de percebes, et de calmars frits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d994e95-4066-4472-a025-f7d1fd6e6b31",
                        "source_entry_id": "428fcc09-6dd5-313c-a0c4-976b10ca4f30",
                        "source_sense_description": "currency",
                        "target_lang_word": "Peseta",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Peseta",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8552c4d3-4a11-33e4-8478-09182606bbb1",
                                        "entry_id": "d0a29a37-9ed9-33b8-814b-9f42f617bbc9",
                                        "glosses": [
                                            "ehemalige spanische Währung, die auch Andorra benutzt wurde, bis sie 2002 der Euro ablöste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05a0599c-a1a1-4eb5-ac60-c49496c61ce8",
                                                "sense_id": "8552c4d3-4a11-33e4-8478-09182606bbb1",
                                                "text": "„Tatsächlich hat sich die Wirtschaft dieser Länder genau in jenen Phasen am besten entwickelt, in denen sie ihre Währungen nicht abgewertet haben wie in den 1950er und 1960er Jahren oder zwischen 1999 und 2008. Umgekehrt wurden Drachme, Lira, Escudo und Peseta zwischen 1973 und 1999 immer wieder massiv abgewertet – was lediglich die Inflation anheizte; die Realwirtschaft profitierte davon nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f8f1582b-87c0-3973-8019-123deeb99dee",
                                        "entry_id": "d0a29a37-9ed9-33b8-814b-9f42f617bbc9",
                                        "glosses": [
                                            "Geld"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a59c283c-7d03-4c02-9958-5cac0dddeec8",
                                                "sense_id": "f8f1582b-87c0-3973-8019-123deeb99dee",
                                                "text": "Heute sind mir wieder die Peseten ausgegangen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
