                                        "sense_id": "fa5d3b95-765d-31f2-8a86-47612c5940ed",
                                        "entry_id": "a6948d50-e1c2-33cf-949b-bc6871a6df4a",
                                        "glosses": [
                                            "nicht natürlich, nicht der Natur entsprechend, nicht in der Art und Weise der Natur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4a6d06b-d02f-44da-a7db-a58cb2dd03e6",
                                                "sense_id": "fa5d3b95-765d-31f2-8a86-47612c5940ed",
                                                "text": "Die Straße war in ein unnatürliches Licht getaucht."
                                            },
                                            {
                                                "example_id": "764439a5-242e-4d25-a8af-9fbac3b8acd7",
                                                "sense_id": "fa5d3b95-765d-31f2-8a86-47612c5940ed",
                                                "text": "„Er liebt Rätsel, Wortspiele, Hieroglyphen und entwickelt bei ihrer Lösung oft einen Scharfsinn, der den mit dem Durchschnittsverstand begabten Menschenkindern unnatürlich erscheint.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4e038f4-55d1-434f-aad7-6d533cdc1b86",
                        "source_entry_id": "7296f1cf-6a1b-32e1-931b-e66c69414c08",
                        "source_sense_id": "090635b1-7a35-37f5-8ab2-0a9229d15fde",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "unecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6431b5fb-f5e3-3566-9ccd-6a3cbaf0cea8",
                                        "entry_id": "92053b83-2acd-3edf-bc97-cd3a40cadd27",
                                        "glosses": [
                                            "falsch (nicht echt) oder nachgemacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f87e7d56-7dc9-478b-9f61-bed257c8bea0",
                                                "sense_id": "6431b5fb-f5e3-3566-9ccd-6a3cbaf0cea8",
                                                "text": "Sie trägt unechten Schmuck."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85e18258-c223-3c4f-a083-f4ab055e0571",
                                        "entry_id": "92053b83-2acd-3edf-bc97-cd3a40cadd27",
                                        "glosses": [
                                            "wenn der Zähler größer als der Nenner ist"
                                        ],
                                        "tags": [
                                            "über Brüche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1214d229-5953-4b23-833a-b0cd78b13ece",
                                                "sense_id": "85e18258-c223-3c4f-a083-f4ab055e0571",
                                                "text": "Ein unechter Bruch ist ein Bruch, bei dem der Zähler – also die Zahl über dem Bruchstrich – einen größeren oder gleichen Wert besitzt wie der Nenner – also die Zahl unter dem Bruchstrich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6414ae36-3abf-362a-a827-8ee4240f8ba3",
                                        "entry_id": "92053b83-2acd-3edf-bc97-cd3a40cadd27",
                                        "glosses": [
                                            "wenn eine Farbe sich nicht hält, sondern zum Beispiel beim Waschen auswäscht"
                                        ],
                                        "tags": [
                                            "Färberei",
                                            "über Farben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47ad7542-ef9a-4043-a8cc-02b639e42bd3",
                                                "sense_id": "6414ae36-3abf-362a-a827-8ee4240f8ba3",
                                                "text": "„In Bezug auf die Dauerhaftigkeit spricht man von echten und unechten Farben, d. h. von solchen, welche gewöhnlichen Einflüssen sehr bald erliegen, im Gegensatze zu jenen, welche diesen Einflüssen dauernd ausgesetzt werden können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
