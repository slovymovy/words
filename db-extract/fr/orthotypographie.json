                    {
                        "sense_id": "48db8d91-436d-3363-b19e-a1a3294623d2",
                        "entry_id": "dd5e09a9-23d4-380a-9820-de0ce6ceb740",
                        "glosses": [
                            "Ensemble des règles qui permettent d’écrire de façon correcte qui recoupe l’orthographe et les règles typographiques (utilisation des majuscules et des minuscules, des espacements, de la ponctuation, de l’italique, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce5ba46f-450b-459c-a966-da211e1b83ad",
                                "sense_id": "48db8d91-436d-3363-b19e-a1a3294623d2",
                                "text": "Il faut donc coller l’appel ce modèle au dernier mot de la phrase (et le faire avant la ponctuation ou les guillemets), afin de respecter l’orthotypographie française."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a5b0d94-953c-3816-841a-5ae5975e816a",
                        "entry_id": "dd5e09a9-23d4-380a-9820-de0ce6ceb740",
                        "glosses": [
                            "Discipline ayant pour objet l’étude de cet ensemble, de son évolution, des ouvrages tels que codes, marches, manuels de bon usage, des pratiques de la correction et de la révision des textes et de celles et ceux qui en font profession."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28520894-e068-4b4b-8f6e-ede0c1e1fde6",
                                "sense_id": "4a5b0d94-953c-3816-841a-5ae5975e816a",
                                "text": "L’orthotypographie est à la composition des dictionnaires ce que la dictionnairique est à la détermination de leurs entrées."
                            }
                        ]
                    }
                ],
