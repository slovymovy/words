                                            {
                                                "example_id": "7d898e14-bf45-4908-a4b6-cef23fd8d277",
                                                "sense_id": "d2b71902-0166-35f0-96e8-4f4aa8f994fc",
                                                "text": "Вашего отца ужалила ядовитейшая из индийских змей — кобра."
                                            },
                                            {
                                                "example_id": "5d0e8ab7-f820-4063-b372-6b3bcccb1398",
                                                "sense_id": "d2b71902-0166-35f0-96e8-4f4aa8f994fc",
                                                "text": "В отличие от гюрзы, кусающей без предупреждения, .. кобра обычно предостерегает возможного противника: она поднимает переднюю часть тела, становится столбиком и расширяет шею, расставляя передние восемь рёбер (а не надувает капюшон, как пишут в приключенческих книжках!). Далее следует шипение, переходящее в характерное чихание — и только после этих процедур — молниеносный бросок."
                                            },
                                            {
                                                "example_id": "0bc632b4-3665-4c09-838c-2b0f6d5d0a6f",
                                                "sense_id": "d2b71902-0166-35f0-96e8-4f4aa8f994fc",
                                                "text": "Среднеазиатская кобра занесена в Красную книгу .."
                                            }
