                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glosseme",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3691888f-2c02-3290-9627-09e431c70c91",
                                        "entry_id": "2070364a-7602-3159-81a6-6ba603f3e50b",
                                        "glosses": [
                                            "The smallest irreducible unit of both the content and expression planes of language; the basic unit of language in the theory of glossematics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0063891e-4af3-43a2-a776-10618009fc98",
                                                "sense_id": "3691888f-2c02-3290-9627-09e431c70c91",
                                                "text": "We can now for a moment leave Hjelmslev's own conception of such a system—based upon glossematic formal definitions—and ask: to which degree can this system of glossemes be defended from a general phonological or phonetic point of view?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff822886-bcdc-42a2-b87b-562f4c4353b3",
                        "source_entry_id": "d06bc3a2-e7f8-375b-b485-c8cb5d9706fb",
                        "source_sense_id": "64f202a9-773f-33bc-890d-92eeff91d818",
                        "target_lang_word": "glossème",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glossème",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "628c2bba-e2d3-33cc-9b15-0c25b8c7b916",
                                        "entry_id": "51e91704-84aa-31f9-aa6b-d0720e903faa",
                                        "glosses": [
                                            "En glossématique, qualifie les formes minimales considérées comme invariants irréductibles sur les plans de l’expression et du contenu."
                                        ],
                                        "tags": [
                                            "Sémiotique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "570199c0-8cbb-3c41-a47a-eee1ec6aeedc",
                                        "entry_id": "51e91704-84aa-31f9-aa6b-d0720e903faa",
                                        "glosses": [
                                            "Qualifie un mot rare dont l'usage s’accompagne d'une explication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d591570f-d4b3-48e9-948b-90655b92f889",
                                                "sense_id": "570199c0-8cbb-3c41-a47a-eee1ec6aeedc",
                                                "text": "Sapience pour sagesse n'est pas un glossème si ce n'est que par affectation d'archaïsme ; mais si c'est pour désigner la sagesse acquise par l'expérience, distinguée de la sagesse en général qui peut être un fond du caractère, cela en devient un."
                                            },
                                            {
                                                "example_id": "e84bc4a5-b739-4718-9172-816a8e738e1f",
                                                "sense_id": "570199c0-8cbb-3c41-a47a-eee1ec6aeedc",
                                                "text": "Fortitude, qui désigne le courage à endurer, à supporter les maux, par opposition au courage qui porte à entreprendre des actions périlleuses, est un pur glossème."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
