                    {
                        "form_id": "3839b4d1-47a7-4e83-a1ef-c79af8ebd591",
                        "entry_id": "b08875f0-9bda-37a7-8ba3-d5fb6195964b",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind streifenfrei"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f5cd7bc-321e-3879-9eac-2afbe236d36e",
                        "entry_id": "b08875f0-9bda-37a7-8ba3-d5fb6195964b",
                        "glosses": [
                            "keine Streifen/Schlieren aufweisend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ba2bd51-cb02-4253-87b8-ebd916a00809",
                                "sense_id": "7f5cd7bc-321e-3879-9eac-2afbe236d36e",
                                "text": "„Auf dem streifenfrei geputztem Glastisch vor der Couch stand eine offene Camenbertschachtel aus Karton in der Pistazien lagen.“"
                            },
                            {
                                "example_id": "d31f0d13-e328-471e-8b64-7e026f47dd8b",
                                "sense_id": "7f5cd7bc-321e-3879-9eac-2afbe236d36e",
                                "text": "„Das Haus selbst erschien gepflegt, die Fenster glänzten klar und streifenfrei in der Sonne.“"
                            },
                            {
                                "example_id": "be55a4b2-b285-4aab-ad57-e19092c611ee",
                                "sense_id": "7f5cd7bc-321e-3879-9eac-2afbe236d36e",
                                "text": "„Diese Tücher nehmen Schmutz gut auf und hinterlassen eine streifenfreie Oberfläche.“"
                            },
                            {
                                "example_id": "12439a72-e34b-4f61-8295-69188b19df4f",
                                "sense_id": "7f5cd7bc-321e-3879-9eac-2afbe236d36e",
                                "text": "„Seine nach vorn gereckte Nasenspitze berührte beinahe die vollkommen streifenfreie Glasscheibe.“"
                            },
                            {
