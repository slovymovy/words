                    "semantic_group_id": "difference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это устройство работает <w>отлично</w> от предыдущей модели.",
                            "target_lang_translations": {
                                "en": "This device works <w>differently</w> from the previous model.",
                                "zh": "这个设备的工作方式与之前的型号<w>不同</w>。",
                                "nl": "Dit apparaat werkt <w>anders</w> dan het vorige model.",
                                "pl": "To urządzenie działa <w>inaczej</w> niż poprzedni model.",
                                "de": "Dieses Gerät funktioniert <w>anders</w> als das Vorgängermodell.",
                                "fr": "Cet appareil fonctionne <w>différemment</w> du modèle précédent.",
                                "it": "Questo dispositivo funziona in modo <w>diverso</w> dal modello precedente.",
                                "cs": "Toto zařízení funguje <w>odlišně</w> od předchozího modelu.",
                                "tr": "Bu cihaz, önceki modelden <w>farklı</w> çalışıyor.",
                                "es": "Este dispositivo funciona de manera <w>diferente</w> al modelo anterior."
                            }
