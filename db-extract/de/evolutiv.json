                "senses": [
                    {
                        "sense_id": "8365b423-7ab6-37fd-9f71-d09f76b07d78",
                        "entry_id": "02b99493-d37c-3c36-8396-1cf5d0dff7fc",
                        "glosses": [
                            "auf die Evolution, Entwicklung, Entwicklungsgeschichte bezogen; auf langsamer Entwicklung beruhend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9001949c-b947-4933-8d47-28e5820e9b02",
                                "sense_id": "8365b423-7ab6-37fd-9f71-d09f76b07d78",
                                "text": "„Auch wenn bei Säugern in der Epiphyse lichtempfindliche Sensoren fehlen, so hat sie in einem doch ihr evolutives Erbe bewahrt: Sie ist Produzent eines uralten Hormons, des Melatonins.“"
                            },
                            {
                                "example_id": "333d2a73-cd4b-49c4-9e4c-216b3853a369",
                                "sense_id": "8365b423-7ab6-37fd-9f71-d09f76b07d78",
                                "text": "„Es geht um die Frage der kausalen Vermittelbarkeit von naturalen Erbschaften als evolutivem Vorlauf einerseits und nachfolgenden geistig-kulturell konstruierten gesellschaftlichen Organisationsformen andererseits, …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
