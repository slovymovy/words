                    }
                ],
                "senses": [
                    {
                        "sense_id": "2460582b-ef00-3e65-9e41-63061c0726af",
                        "entry_id": "6e6cd4c0-7572-3af5-9b2c-dc200c15c85a",
                        "glosses": [
                            "eine im Euter einer Kuh produzierte Milch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a39a93e-18cf-436a-8e15-3b4eea4c6da3",
                                "sense_id": "2460582b-ef00-3e65-9e41-63061c0726af",
                                "text": "Ich habe einen Liter frische Kuhmilch beim Bauern gekauft."
                            },
                            {
                                "example_id": "1bc32bee-65cd-4fc4-8645-8ee9bc8816ee",
                                "sense_id": "2460582b-ef00-3e65-9e41-63061c0726af",
                                "text": "„Die neuen Veteranen versammeln sich zu einer letzten, großen Segnung durch untadelige Älteste, die die Initiierten mit Kuhmilch und Honigbier bespritzen und den Rat auf den Lebensweg geben: Habt Kinder, habt Vieh.“"
                            },
                            {
                                "example_id": "7ea3497d-9961-4f06-aa81-b6fbad812647",
                                "sense_id": "2460582b-ef00-3e65-9e41-63061c0726af",
                                "text": "„Die Herstellung von Hafermilch verbraucht im Vergleich zu Kuhmilch viel weniger Wasser und Landfläche.“"
                            },
                            {
                                "example_id": "2fbc7b1d-6a0e-47e4-982c-30264447d280",
                                "sense_id": "2460582b-ef00-3e65-9e41-63061c0726af",
                                "text": "„Mit Blick auf den CO₂-Ausstoß erzielt pflanzliche Milch eine [um den Faktor 4,5] bessere Ökobilanz als Kuhmilch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e52fba0-4cbb-4fcc-b271-589471ace6ff",
                        "source_entry_id": "6e6cd4c0-7572-3af5-9b2c-dc200c15c85a",
                        "source_sense_id": "2460582b-ef00-3e65-9e41-63061c0726af",
                        "source_sense_description": "eine im Euter einer Kuh produzierte Milch",
                        "target_lang_word": "cow's milk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cow's milk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bf6a3ba-528b-333c-a47c-1e3e41503fdc",
                                        "entry_id": "fa4d3717-9ab1-303f-a54b-16420ae11679",
                                        "glosses": [
                                            "A white liquid produced by the mammary glands of a cow, and used as food by humans."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38c096f8-7d06-4623-ac71-04a12c439cbe",
                                                "sense_id": "3bf6a3ba-528b-333c-a47c-1e3e41503fdc",
                                                "text": "The child is taken off the breast or bottle and fed soya milk or one of the new lactose-free cow’s milks."
                                            },
                                            {
                                                "example_id": "45484ee7-20e4-4542-a2ae-fcb69c381f40",
                                                "sense_id": "3bf6a3ba-528b-333c-a47c-1e3e41503fdc",
                                                "text": "With so many milks on the market these days, how do you decide which is best for you? Most have a similar protein and calcium content, with the main difference being fat content. Here is a brief run-down of cow’s milks: […]"
                                            },
                                            {
                                                "example_id": "d58e36e9-1513-4baf-8b3e-a6e8ac9daa6f",
                                                "sense_id": "3bf6a3ba-528b-333c-a47c-1e3e41503fdc",
                                                "text": "Plant milks are a boon for people who cannot tolerate cow’s milk, as are lactose-free and lactose-reduced cow’s milks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
