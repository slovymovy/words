                    {
                        "translation_id": "0faa9c6a-999d-48fb-b668-6f36531c9b1e",
                        "source_entry_id": "501ea9a3-385a-3728-99c7-c5d66aab460d",
                        "source_sense_id": "1792f26c-8bfa-32ef-a624-890515d902c7",
                        "source_sense_description": "Islamic prayer",
                        "target_lang_word": "Salat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ffb43903-f532-3d59-b3bb-1ea2883d061e",
                                        "entry_id": "057d0cdd-d86b-3180-ba40-c45b5c5aa2df",
                                        "glosses": [
                                            "roh zu essendes grünes Blattgemüse, zum Beispiel Eisbergsalat oder Endivien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "879d2c97-a365-47aa-ac86-cfff65f81257",
                                                "sense_id": "ffb43903-f532-3d59-b3bb-1ea2883d061e",
                                                "text": "Wegen der Schnecken pflanzen wir keinen Salat."
                                            },
                                            {
                                                "example_id": "c4d42690-0e1d-4392-a52a-97f6a3d972d9",
                                                "sense_id": "ffb43903-f532-3d59-b3bb-1ea2883d061e",
                                                "text": "„Vor den Häusern reihten sich gut gepflegte Beete mit Tomaten, Paprika, Gurken und Salat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ead80df0-5cbe-3f76-9e06-6109fdba5837",
                                        "entry_id": "057d0cdd-d86b-3180-ba40-c45b5c5aa2df",
                                        "glosses": [
                                            "aus Blattgemüse oder einer Mischung verschiedener Zutaten hergestellte kalte Speise, oft mit einer Salatsoße angemacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeaf156f-879a-4f75-98af-f2128271d4bc",
                                                "sense_id": "ead80df0-5cbe-3f76-9e06-6109fdba5837",
                                                "text": "Ich mache den Salat mit Zitrone an."
                                            },
                                            {
                                                "example_id": "e9e0c56e-dbe1-4ec9-96bc-7bccfa939af9",
                                                "sense_id": "ead80df0-5cbe-3f76-9e06-6109fdba5837",
                                                "text": "„Darin wurde vor allem Sauerampfer angebaut, der früher als Salat, Gemüse und Heilpflanze von großer Bedeutung war.“"
                                            },
                                            {
                                                "example_id": "c98b9c6d-2d3e-4332-8a9e-66492e82acda",
                                                "sense_id": "ead80df0-5cbe-3f76-9e06-6109fdba5837",
                                                "text": "„Nun werden sie im Ganzen abgekocht, geschält, gescheibt, mit Essig und rohen Meerrettigwürfeln eingemacht, und im Winter statt Salates genossen.“"
                                            },
                                            {
                                                "example_id": "a264b826-d744-42de-9aa7-bee0ff90a4f8",
                                                "sense_id": "ead80df0-5cbe-3f76-9e06-6109fdba5837",
                                                "text": "„Fereschte stellt eine Schüssel mit Salat auf den Esstisch und streicht mit einer Hand kurz über das schwarz lackierte Holz.“"
                                            },
                                            {
                                                "example_id": "2231b5aa-cdd9-488b-b824-255accda4880",
                                                "sense_id": "ead80df0-5cbe-3f76-9e06-6109fdba5837",
                                                "text": "„Die Frau bereitet Salat, Gemüse und Nachtisch vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9084e1f6-3b37-309e-89da-55cf6ca1c6a1",
                                        "entry_id": "057d0cdd-d86b-3180-ba40-c45b5c5aa2df",
                                        "glosses": [
                                            "Bredouille, Durcheinander, Kuddelmuddel"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c8ad8fd-1a15-4b98-b58d-65aa5efc59e9",
                                                "sense_id": "9084e1f6-3b37-309e-89da-55cf6ca1c6a1",
                                                "text": "Wer hat denn den Salat angerichtet?!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
