                ],
                "translations": [
                    {
                        "translation_id": "d53fa938-3500-4d94-b289-32491142575d",
                        "source_entry_id": "65c9814d-5fe2-3a54-a3a1-bff937ff6036",
                        "source_sense_id": "ee1d2ee1-2289-36d1-8a61-eb8c0d821d08",
                        "source_sense_description": "umgangssprachlich, meist abwertend: Plastik, Kunststoff, Plaste, Plast",
                        "target_lang_word": "Plastik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plastik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4eb86629-6965-3ee5-9e26-32b6bee4a02b",
                                        "entry_id": "c2353bed-fcfb-3ad2-9846-f93bbe5af8ce",
                                        "glosses": [
                                            "Gattung der Bildhauerei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d688bfc5-4497-4e59-a51b-d2afa4b28312",
                                                "sense_id": "4eb86629-6965-3ee5-9e26-32b6bee4a02b",
                                                "text": "Das Hauptthema der Plastik ist die Darstellung des Menschen in Wachs, Gips, Ton oder anderen geeigneten Materialien."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3dd8675f-64dc-3b3c-b680-f2bdbad90576",
                                        "entry_id": "c2353bed-fcfb-3ad2-9846-f93bbe5af8ce",
                                        "glosses": [
                                            "dreidimensionales Kunstwerk, das durch ein additives Verfahren geschaffen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "281b54f4-901f-4cd3-8876-e921450af1fc",
                                                "sense_id": "3dd8675f-64dc-3b3c-b680-f2bdbad90576",
                                                "text": "Die neue Plastik auf dem Rathausbrunnen erregt allgemeines Aufsehen."
                                            },
                                            {
                                                "example_id": "279baa56-f0d5-429e-a709-987d41b23c28",
                                                "sense_id": "3dd8675f-64dc-3b3c-b680-f2bdbad90576",
                                                "text": "„Statisch gehalten wird die Skulptur von einem Stahlblock, dessen Gewicht exakt dem der Plastik entspricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "06a17641-f044-35d0-8e62-c561378a3d0d",
                                        "entry_id": "c2353bed-fcfb-3ad2-9846-f93bbe5af8ce",
                                        "glosses": [
                                            "chirurgische Nachbildung oder Umformung eines Körperteils"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed7b5fa8-2e56-450a-b1f8-f93ed4686870",
                                                "sense_id": "06a17641-f044-35d0-8e62-c561378a3d0d",
                                                "text": "Die amputierte Brust wird durch eine Plastik ersetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Plastik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                        "entry_id": "aa0d53e2-01ce-304d-98d0-cfc179710a9b",
                                        "glosses": [
                                            "künstlich und chemisch hergestelltes Material, organisches Polymer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a5b64be-9d04-46e8-a39e-e85597b67035",
                                                "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                                "text": "Viele Gegenstände bestehen aus Plastik, wie zum Beispiel Taschen, Behälter oder Bauteile."
                                            },
                                            {
                                                "example_id": "f37667ad-f5c4-4935-89e7-50db6327f8dd",
                                                "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                                "text": "„Die Einsatzmöglichkeiten für Plastik sind genauso groß, wie die Liste der Probleme und Risiken dieses Materials lang ist.“"
                                            },
                                            {
                                                "example_id": "1f861a85-4226-4cf1-9efa-135c593c5ed6",
                                                "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                                "text": "„Das Plastik hält sich selbst im Wasser über Jahrzehnte und treibt lange Zeit an der Wasseroberfläche. Unter dem Einfluss von UV-Strahlung und der Belastung von Wasser, Wind und Wellen werden die Teile zwar mit der Zeit immer kleiner, aber sie lösen sich nicht auf.“"
                                            },
                                            {
                                                "example_id": "06f9deb7-1597-417a-a2eb-00ca1207021e",
                                                "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                                "text": "„In den vergangenen Jahren sind zahlreiche Projekte lanciert worden, um den Plastik wieder herauszufischen.“"
                                            },
                                            {
                                                "example_id": "f19006af-d669-4c29-92e8-15beca48f829",
                                                "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                                "text": "„Wenn uns das gelingt, dann wird das dazu führen, dass immer mehr Hersteller und auch Händler vermehrt Reciclate für ihre Verpackungen verwenden werden und wir es somit irgendwann schaffen, die Wertstoffe, den Plastik als Wertstoff im Kreislauf zu führen.“"
                                            },
                                            {
                                                "example_id": "21bcf620-eb0b-48c1-a52f-30331ac6b84f",
                                                "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                                "text": "„Durch die Hitze schmilzt der Plastik und der Kern taucht immer tiefer in die Form ein.“"
                                            },
                                            {
                                                "example_id": "2523ff8a-d8d6-4680-880f-ca5a7729eef4",
                                                "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                                "text": "„Dass er den Plastik gleich wieder ins Wasser wirft, ärgert mich, ist aber für ihn die normalste Sache der Welt.“"
                                            },
                                            {
                                                "example_id": "165a8451-9f15-4efe-9a4e-e6855fdf667b",
                                                "sense_id": "3d360c10-2d23-3774-b0bd-5f291215b53d",
                                                "text": "„Wenn du dich darüber aufregst, dann beginne, den Plastik auf der Straße, im Wald, der vor deinen Füßen oder am Rand liegt, aufzuheben und in den nächsten Mülleimer zu bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0f40695-7c03-4cfe-81db-90043255c017",
                        "source_entry_id": "65c9814d-5fe2-3a54-a3a1-bff937ff6036",
                        "source_sense_id": "ee1d2ee1-2289-36d1-8a61-eb8c0d821d08",
                        "source_sense_description": "umgangssprachlich, meist abwertend: Plastik, Kunststoff, Plaste, Plast",
                        "target_lang_word": "Kunststoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kunststoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                        "entry_id": "2e0f5361-b37e-3495-a571-f8d0b215e2a3",
                                        "glosses": [
                                            "Bezeichnung für einen Festkörper, dessen Grundbestandteil synthetisch oder halbsynthetisch erzeugte Polymere mit organischen Gruppen sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0d98936-4982-4f7d-9cd2-0b55907f2358",
                                                "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                                "text": "„Kunststoff ist alt. Fast 500 Jahre alt ist die älteste Anleitung zur Herstellung eines Kunststoffs auf Kaseinbasis.“"
                                            },
                                            {
                                                "example_id": "d106cdd5-91c2-4723-9d88-ea7af8847e2a",
                                                "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                                "text": "„Der erste richtige Kunststoff wurde 1870 von John Wesley Hyatt erfunden, als dieser auf der Suche nach einem Ersatzmaterial für die Herstellung von Billardkugeln war.“"
                                            },
                                            {
                                                "example_id": "73c285cb-5b30-4783-8d5c-9e58e7eeffda",
                                                "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                                "text": "„Die ersten Kunststoffe entstanden, als Mitte des 19. Jahrhunderts Rohstoffe wie Holz oder Metalle immer knapper und damit teurer wurden.“"
                                            },
                                            {
                                                "example_id": "a0f2b23a-1574-48b0-85dc-6b1d7418b68e",
                                                "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                                "text": "„Als Laufradwerkstoffe kommen neben den thermoplastischen Kunststoffen, in Abhängigkeit der Druckstufen sowie weitere verfahrenstechnische Parameter, diverse Sondermaterialien zur Anwendung (GfK, CfK, Stahl und Edelstahl).“"
                                            },
                                            {
                                                "example_id": "24a0dba9-dd94-425b-9732-90c1514028a0",
                                                "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                                "text": "„Seit nun über hundert Jahren wurden Gebrauchsgegenstände aus Kunststoff selbstverständlicher Bestandteil unseres Alltags.“"
                                            },
                                            {
                                                "example_id": "7d452ebe-35b0-4cfa-88d5-7df25f97e739",
                                                "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                                "text": "„Unser renommiertes Unternehmen stellt seit mehr als 25 Jahren Lüftungsformteile aus Kunststoff her.“"
                                            },
                                            {
                                                "example_id": "4b93ce85-99cd-40d9-9eae-4532af46f720",
                                                "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                                "text": "„Medizintechnikherstellern auf der Suche nach genau dem richtigen Werkstoff für ihre Anwendung steht nun eine weitere Option offen, da Bayer MaterialScience seine bereits umfangreiche Familie an medizinischen Kunststoffen erweitert hat.“"
                                            },
                                            {
                                                "example_id": "1892a3f7-b31b-4019-ba5d-f747b26d095a",
                                                "sense_id": "72c854db-3eeb-3073-8437-d13a992815b7",
                                                "text": "„In diesem Kapitel geht es um die Herstellung von Kunststoffen. Ganz allgemein entstehen Kunststoffe in sogenannten \"Polyreaktionen\", das sind Reaktionen, bei denen einzelne Moleküle, genannt \"Monomere\" (von griech. monos = einzeln und meros = Teilchen), zu \"Polymeren\" (griech. polys = viel) reagieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
