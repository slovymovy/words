                                            {
                                                "example_id": "3353a273-dfb6-4caf-9d7c-a2218ed9d1c3",
                                                "sense_id": "1c3025b8-49f6-3354-ba16-c6c420adef98",
                                                "text": "Heute würde man freilich anders interpunktieren, nämlich: „Besen, seid’s gewesen!“"
                                            },
                                            {
                                                "example_id": "fe3f50c8-79fe-4278-abc0-fb056496b929",
                                                "sense_id": "1c3025b8-49f6-3354-ba16-c6c420adef98",
                                                "text": "Dazwischen eine Anrufbeantworter-Ansage von Lamars Mutter, die erste von vielen, die den Plot interpunktieren."
                                            },
                                            {
                                                "example_id": "383c3347-5882-488b-bc3b-35cb6072b840",
                                                "sense_id": "1c3025b8-49f6-3354-ba16-c6c420adef98",
                                                "text": "Die Wissenschaft muss daher selbst die Zeit interpunktieren, also einen Zeitpunkt festlegen, zu dem sie den Gegenstand als gegeben betrachtet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
