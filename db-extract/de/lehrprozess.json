                ],
                "senses": [
                    {
                        "sense_id": "4a4530a7-530f-3f22-9c76-91e1cce6c58b",
                        "entry_id": "b5868534-6f1c-3c2e-9667-380c639bc591",
                        "glosses": [
                            "(geplanter) Ablauf eines Unterrichts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e54c981e-0216-4609-9353-6b8eaba66853",
                                "sense_id": "4a4530a7-530f-3f22-9c76-91e1cce6c58b",
                                "text": "„Unverzichtbar ist dabei, daß der Lehrprozeß an den Vorerfahrungen, Interessen und Einstellungen des Schülers anknüpft.“"
                            },
                            {
                                "example_id": "f832a238-a9f0-4654-a708-a27d512f4aa1",
                                "sense_id": "4a4530a7-530f-3f22-9c76-91e1cce6c58b",
                                "text": "„‚Das ist auch ein Lehrprozess für unsere Fachkräfte‘, sagt Julia Sterzer, die das Referat Kindertagesbetreuung bei der AWO leitet.“"
                            },
                            {
                                "example_id": "1c1dc6c6-0203-4327-aab5-ac4769e8ab37",
                                "sense_id": "4a4530a7-530f-3f22-9c76-91e1cce6c58b",
                                "text": "„Der Beitrag der Neurowissenschaften zur Verbesserung der Lern- und Lehrprozesse in den Schulen wird von Praktikern und Bildungsforschern sehr oft als zu wenig konkret und praxisorientiert kritisiert.“"
                            },
                            {
                                "example_id": "e9fd5050-b49e-48af-a447-20b9be5205aa",
                                "sense_id": "4a4530a7-530f-3f22-9c76-91e1cce6c58b",
                                "text": "„Der Lehrprozess ist dabei als Kette zu betrachten, welche mehr oder weniger weiten, ineinander verschränkten Kreisläufen entspricht.“"
                            },
                            {
                                "example_id": "e8f7e462-82f9-4731-a0d1-67085617a34c",
                                "sense_id": "4a4530a7-530f-3f22-9c76-91e1cce6c58b",
                                "text": "„Dabei sollen der Lehrprozess und der Lernprozess zur Reduzierung der Komplexität von einander unabhängig betrachtet werden, obwohl in der Realität von einer Wechselwirkung auszugehen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "463ebe1c-ef24-3889-be0b-7e5cb635aeda",
                        "entry_id": "b5868534-6f1c-3c2e-9667-380c639bc591",
                        "glosses": [
                            "Verfahren der Kirche den wahren Glauben betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "580865df-e259-49ca-a0fa-315f93c3f7b6",
                                "sense_id": "463ebe1c-ef24-3889-be0b-7e5cb635aeda",
                                "text": "„Man führt einen Lehrprozeß gegen einen Pfarrer, weil er die Überlieferung von der leiblichen Auferstehung Jesu bezweifelt, und gleichzeitig, während dieser Lehrprozeß alle Gemüter bewegt, gibt man den jungen Kandidaten für ihre Examensarbeit das Thema zur Bearbeitung: ‚Wie beweist sich das vere resurrexit (d. h. er ist leiblich auferstanden) der Confessio Augustana aus der Heiligen Schrift?‘“"
                            },
                            {
                                "example_id": "9273ad55-8db0-4e53-93f0-9d592a8d92f5",
                                "sense_id": "463ebe1c-ef24-3889-be0b-7e5cb635aeda",
                                "text": "„[…] und ausgerechnet in Gryphius' Geburtsjahr 1616 führte die Katholische Kirche den Lehrprozeß gegen Galilei und verwarf durch eine päpstliche Kommission […] den Lehrsatz, daß »die Sonne der Mittelpunkt des Universums« sei […].“"
                            },
                            {
                                "example_id": "91d78347-875d-495f-8c26-c616284f3f02",
                                "sense_id": "463ebe1c-ef24-3889-be0b-7e5cb635aeda",
                                "text": "„Einerseits galt für alle Lehrprozesse das strikte Sekretum des Hl. Offiziums, das analog auch bei der Indexkongregation Anwendung fand.“"
                            },
                            {
                                "example_id": "50b418ab-08c0-454e-85ac-ff1a3f2f78cf",
                                "sense_id": "463ebe1c-ef24-3889-be0b-7e5cb635aeda",
                                "text": "„Die Lehrprozesse der Jahrhundertwende gegen Steudel, Jatho, Traub u.a. bringen in voller Schärfe diese Problematik zum Ausdruck.“"
                            },
                            {
                                "example_id": "cf00b7c1-f670-41fb-aaf1-567c37ff3287",
                                "sense_id": "463ebe1c-ef24-3889-be0b-7e5cb635aeda",
                                "text": "„[…] gegen ihn in Rom anhängigen Lehrprozeß informiert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
