    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33885756-f101-3a55-a3f1-7cd4c705176a",
                    "sense_definition": "een lichaamsdeel of object zo ver mogelijk uitrekken of recht maken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fysiek_uitrekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange dag op kantoor moet ik even mijn benen <w>strekken</w>.",
                            "target_lang_translations": {
                                "en": "After a long day at the office, I need to <w>stretch</w> my legs for a bit.",
                                "ru": "После долгого дня в офисе мне нужно немного <w>размять</w> ноги."
                            }
                        },
                        {
                            "text": "De atleet begon zijn armen te <w>strekken</w> voor de wedstrijd begon.",
                            "target_lang_translations": {
                                "en": "The athlete started to <w>stretch</w> his arms before the race began.",
                                "ru": "Атлет начал <w>растягивать</w> руки перед началом соревнований."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitstrekken",
                        "rekken"
                    ],
                    "antonyms": [
                        "buigen"
                    ],
                    "common_phrases": [
                        "de benen strekken",
                        "de armen strekken"
                    ],
                    "target_lang_definitions": {
                        "en": "To extend or straighten a body part or object as far as possible.",
                        "ru": "вытянуть или выпрямить часть тела или предмет как можно сильнее"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stretch",
                                "target_lang_sense_clarification": "to extend limbs or muscles"
                            },
                            {
                                "target_lang_word": "extend",
                                "target_lang_sense_clarification": "to straighten a limb"
                            },
                            {
                                "target_lang_word": "stretch out",
                                "target_lang_sense_clarification": "to fully extend a body part"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "размять",
                                "target_lang_sense_clarification": "мышцы или конечности"
                            },
                            {
                                "target_lang_word": "вытянуть",
                                "target_lang_sense_clarification": "сделать прямым"
                            },
                            {
                                "target_lang_word": "растягивать",
                                "target_lang_sense_clarification": "мышцы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ac9a904-11bf-3f53-a6e1-8e02187377ff",
                    "sense_definition": "een bepaalde afstand beslaan of tot een bepaald punt reiken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bereik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het prachtige natuurgebied <w>strekt</w> zich uit tot aan de verre horizon.",
                            "target_lang_translations": {
                                "en": "The beautiful nature reserve <w>stretches</w> out to the distant horizon.",
                                "ru": "Прекрасный заповедник <w>простирается</w> до самого горизонта."
                            }
                        },
                        {
                            "text": "Hun politieke macht <w>strekte</w> tot ver buiten de grenzen van het land.",
                            "target_lang_translations": {
                                "en": "Their political power <w>extended</w> far beyond the country's borders.",
                                "ru": "Их политическая власть <w>распространялась</w> далеко за пределы страны."
                            }
                        }
                    ],
                    "synonyms": [
                        "reiken",
                        "uitstrekken"
                    ],
                    "common_phrases": [
                        "zich uitstrekken tot"
                    ],
                    "target_lang_definitions": {
                        "en": "To cover a certain distance or reach to a specific point.",
                        "ru": "охватывать определенное расстояние или доходить до определенной точки"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stretch",
                                "target_lang_sense_clarification": "to extend physically over an area"
                            },
                            {
                                "target_lang_word": "extend",
                                "target_lang_sense_clarification": "to cover an amount of space or reach a point"
                            },
                            {
                                "target_lang_word": "reach",
                                "target_lang_sense_clarification": "to extend as far as"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "простираться",
                                "target_lang_sense_clarification": "о территории или пространстве"
