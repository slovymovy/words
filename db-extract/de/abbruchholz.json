                "senses": [
                    {
                        "sense_id": "ba6ee847-0824-3cab-9aee-518c9c695a3a",
                        "entry_id": "913ea47c-c48f-35fe-92de-ab29bb0d5e94",
                        "glosses": [
                            "Holz, das aus dem Abbruch eines Gebäudes herrührt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c36dcea-c3b2-4b13-8331-69f85dc01141",
                                "sense_id": "ba6ee847-0824-3cab-9aee-518c9c695a3a",
                                "text": "„Möglicherweise rührte die Verseuchung daher, dass mit Giftstoffen belastetes Abbruchholz in dem Ofen verbrannt wurde.“"
                            },
                            {
                                "example_id": "ce963364-6278-4735-a83f-ca64f83c34d4",
                                "sense_id": "ba6ee847-0824-3cab-9aee-518c9c695a3a",
                                "text": "„Verschiedene Gewerbe der Umgebung entsorgen bei der Tegra ihr Abfallholz – Baustellenholz, Paletten, Abbruchholz, nur behandelt darf es nicht sein – und bezahlen zwischen 60 und 100 Fr. pro Tonne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
