                                    {
                                        "sense_id": "1bcb2c7d-4e87-354c-9354-b75fb03482a3",
                                        "entry_id": "efed8193-8e76-3f21-9ece-e34c4d242bfd",
                                        "glosses": [
                                            "A generic title used in reference to any peer of the British nobility or any peer below the dignity of duke and (as a courtesy title) for the younger sons of dukes and marquesses (see usage note)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "319a6a1c-0848-45b3-aa26-14e5ef32de5a",
                                                "sense_id": "1bcb2c7d-4e87-354c-9354-b75fb03482a3",
                                                "text": "How do you do, Lord Darlington?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "083435df-402c-32d7-b81f-a75d397d01b7",
