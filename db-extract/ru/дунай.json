                        "target_lang_word": "Donau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Donau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b99550b6-589c-3fa4-a745-ae0fd3f5f2f7",
                                        "entry_id": "7c574fdf-ff8a-30b7-82f9-f014ec257b41",
                                        "glosses": [
                                            "mitteleuropäischer und südosteuropäischer Fluss, Strom, der im Schwarzwald entspringt, Deutschland, Österreich, die Slowakei, Ungarn, Kroatien, Serbien, Rumänien, Bulgarien, Moldawien und die Ukraine durchfließt sowie zum Teil Grenzen zwischen diesen Staaten bildet, um im Donaudelta ins Schwarze Meer zu münden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f51bbbc-037e-43a6-830e-539b8a88e2e8",
                                                "sense_id": "b99550b6-589c-3fa4-a745-ae0fd3f5f2f7",
                                                "text": "Die Donau ist einer der längsten Ströme Europas."
                                            },
                                            {
                                                "example_id": "1040d03c-3978-4bbf-b4e7-7d21236f9098",
                                                "sense_id": "b99550b6-589c-3fa4-a745-ae0fd3f5f2f7",
                                                "text": "„Die Regnitz und die Altmühl, die Nebenflüsse des Mains und der Donau, sollten durch einen schiffbaren Graben miteinander verbunden werden.“"
                                            },
                                            {
                                                "example_id": "b2b14bcc-e4b6-48c7-bd95-a9983f3841e5",
                                                "sense_id": "b99550b6-589c-3fa4-a745-ae0fd3f5f2f7",
                                                "text": "„Die Donau belebte sich jetzt, eine Menge Barkassen und Kaiks manövrierten dort, begleitet von vielstimmigen Rufen, vom Knarren der Taue und Winden.“"
                                            },
                                            {
                                                "example_id": "ff07b66d-1463-4d6b-a0c3-1e347efbcf9f",
                                                "sense_id": "b99550b6-589c-3fa4-a745-ae0fd3f5f2f7",
                                                "text": "„Rustschuk wird geprägt von der weiten Wasserfläche der Donau und den Uferhügeln, die in der Stadt die Straßen ansteigen lassen.“"
                                            },
                                            {
                                                "example_id": "05c14a79-39a1-4b74-a467-57f14a476baa",
                                                "sense_id": "b99550b6-589c-3fa4-a745-ae0fd3f5f2f7",
                                                "text": "Wir überquerten die Donau."
                                            },
                                            {
                                                "example_id": "260094a9-158c-4262-871e-64cdcd790bd9",
                                                "sense_id": "b99550b6-589c-3fa4-a745-ae0fd3f5f2f7",
                                                "text": "Die Kinder versuchten, in der Donau zu baden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9995d480-4c8c-4336-a055-50aac201751e",
