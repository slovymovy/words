                    {
                        "sense_id": "b8f9f326-5b15-3039-8e69-11af315d28eb",
                        "entry_id": "c8756a04-4280-3614-acc7-a43d8ae7ebb8",
                        "glosses": [
                            "ein im Wasserbad gestockter, einem Pudding ähnlicher Nachtisch aus Milch, Eiern und Zucker"
                        ],
                        "tags": [
                            "besonders in Portugal, Spanien und Lateinamerika"
                        ],
                        "examples": [
                            {
                                "example_id": "782d0762-fd9c-4aad-bbd2-49e1a0f3c545",
                                "sense_id": "b8f9f326-5b15-3039-8e69-11af315d28eb",
                                "text": "Ein Backblech mit Wasser in den Ofen geben, die Auflaufform oder die Förmchen darauf stellen und den Flan bei 160°C ca. 1 Std. backen."
                            },
                            {
                                "example_id": "cf2114d2-4cad-4880-9e95-d2d8d6bd699b",
                                "sense_id": "b8f9f326-5b15-3039-8e69-11af315d28eb",
                                "text": "Wenn oben eine bräunliche Schicht entstanden ist, ist der Flan fertig."
                            }
                        ],
                        "sense_index_json": "\"1\""
