                                "target_lang_sense_clarification": "isim olarak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高音",
                                "target_lang_sense_clarification": "名词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b98085b-255f-3f69-a24b-270045a0a8ba",
