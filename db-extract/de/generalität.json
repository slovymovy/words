                "senses": [
                    {
                        "sense_id": "33102191-63c0-39aa-9e20-f44a5ca818d6",
                        "entry_id": "43efdc37-c0ab-3afe-959d-9b19f30e6136",
                        "glosses": [
                            "Unspezifiziertheit und Allgemeinheit, durch die sich etwas zum Beispiel in seiner Gestaltung oder seinem Inhalt auszeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "094a8fc9-ca49-420d-9019-2b745eb5908b",
                                "sense_id": "33102191-63c0-39aa-9e20-f44a5ca818d6",
                                "text": "In dieser Generalität ist Ihre Aussage nicht korrekt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6592a234-bb61-356d-815e-110113fa4f3c",
                        "entry_id": "43efdc37-c0ab-3afe-959d-9b19f30e6136",
                        "glosses": [
                            "Gesamtheit der Generäle in einer Armee"
                        ],
                        "tags": [
                            "Plural ungebräuchlich"
                        ],
                        "examples": [
                            {
                                "example_id": "2aa66f5c-3a26-40a2-a267-614b111b7ba6",
                                "sense_id": "6592a234-bb61-356d-815e-110113fa4f3c",
                                "text": "Einige Vertreter der Generalität kommen heute in Hannover zusammen."
                            },
                            {
                                "example_id": "95564fa4-a8de-433a-b151-317c37c61f2f",
                                "sense_id": "6592a234-bb61-356d-815e-110113fa4f3c",
                                "text": "Großvater gehörte der preußischen Generalität an."
                            },
                            {
                                "example_id": "b628cb2f-ce28-471f-87a1-b642d1cf94ca",
                                "sense_id": "6592a234-bb61-356d-815e-110113fa4f3c",
                                "text": "„Suzuki beugte sich dem Einspruch der Generalität.“"
                            },
                            {
                                "example_id": "e04de737-7573-4350-8b29-e1a841986b7b",
                                "sense_id": "6592a234-bb61-356d-815e-110113fa4f3c",
                                "text": "„Die Generalität folgte seinem Beispiel, dann drängten sich die Offiziere und nach ihnen Soldaten und Milizleute aufgeregt, einander beiseite schiebend, stossend und keuchend zum Muttergottesbilde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33e808cf-24e1-444a-a430-949cbb166c4b",
                        "source_entry_id": "43efdc37-c0ab-3afe-959d-9b19f30e6136",
                        "source_sense_id": "33102191-63c0-39aa-9e20-f44a5ca818d6",
