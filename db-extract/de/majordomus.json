                    {
                        "sense_id": "a37ba1b1-0f47-30ae-bed4-7210e54c241b",
                        "entry_id": "b727997a-e456-3057-b5c3-68a5c7af2ad8",
                        "glosses": [
                            "„oberster Hofbeamter“"
                        ],
                        "tags": [],
