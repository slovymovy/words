                        "entry_id": "4e4eefd3-953b-3de5-b966-495b0dee9160",
                        "glosses": [
                            "Physiologie pathologique, étude des troubles fonctionnels d’un organisme ou d’un système organique et de ses réactions au cours d’une maladie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c330a210-8edd-49d7-90de-8cc2e0d00b8c",
                                "sense_id": "8a440c08-6db7-3e2d-adcc-f3dbe3d898ba",
                                "text": "Le traitement de la maladie de Basedow a bénéficié ces dernières années des progrès de la physiopathologie de la glande thyroïde."
                            }
                        ]
                    },
                    {
                        "sense_id": "5956f61a-632b-3814-99c9-8caf70c00b54",
                        "entry_id": "4e4eefd3-953b-3de5-b966-495b0dee9160",
                        "glosses": [
                            "Physiologie pathologique, étude des troubles fonctionnels d’un organisme ou d’un système organique et de ses réactions au cours d’une maladie.",
                            "Étude des troubles fonctionnels engendrés par une maladie ou une affection particulière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e398937-5afa-4be8-9e42-795a75eeab4c",
                                "sense_id": "5956f61a-632b-3814-99c9-8caf70c00b54",
                                "text": "Il n’est pas sans intérêt de rappeler les notions récentes concernant certains facteurs humoraux et enzymatiques qui éclairent d’un jour nouveau la physiopathologie des arthrites."
                            }
                        ]
                    }
