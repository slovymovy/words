                        "examples": [
                            {
                                "example_id": "d1424942-7c73-4326-9f78-252f13bc2d7e",
                                "sense_id": "ca0511ca-abc2-351f-af69-d6f882c2d38e",
                                "text": "Viele Lippenblütler werden als Küchen- und Heilkräuter verwendet."
                            },
                            {
                                "example_id": "f6fdf1af-1d87-40bb-a0d8-c49610fbac62",
                                "sense_id": "ca0511ca-abc2-351f-af69-d6f882c2d38e",
                                "text": "„Eines Tages entdeckte Harbert in einer feuchten Niederung ganze Stauden von aromatischen Kräutern, Thymian, Quendel, Basilikum, Pfefferkraut und viele andere Lippenblütler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3ceb41d0-a719-37ee-b543-932abc41dc47",
                        "entry_id": "6348ac05-1a02-37f0-b33a-bafcf17e448d",
                        "glosses": [
                            "eine Pflanze oder Pflanzenart von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7c9a732-b281-4176-b3a1-c25fc2d2499e",
                                "sense_id": "3ceb41d0-a719-37ee-b543-932abc41dc47",
                                "text": "Der Ysop ist auch ein Lippenblütler."
