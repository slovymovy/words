                ],
                "senses": [
                    {
                        "sense_id": "8c5a48b8-8303-31d9-8506-183513220225",
                        "entry_id": "1cd9f8e9-3727-3485-9ab6-dc5ffe1983ef",
                        "glosses": [
                            "kurze Hose (Sporthose), die speziell für das Laufen konzipiert ist"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "1d9b8c7d-a44b-410c-9d30-236eb1584d72",
                                "sense_id": "8c5a48b8-8303-31d9-8506-183513220225",
                                "text": "„Die richtigen Shorts findest du am schnellsten, wenn du nicht nach Herrenshorts sondern je nach Bedarf nach Boxershorts, Bermudashorts, Sportshorts, Laufshorts, etc. suchst.“"
                            },
                            {
                                "example_id": "19f7ecd2-5f01-4d52-b59e-60edb8f14030",
                                "sense_id": "8c5a48b8-8303-31d9-8506-183513220225",
                                "text": "„Die bequeme Innenschale aus 75 % Polyamid mit 25 % Elasthan (Lycra) verhindert, dass Ihre wertvollen Teile bei dieser Laufshorts heraushängen.“"
                            },
                            {
                                "example_id": "b99aa928-8f2e-40c0-bbae-c6a5fbbb3f24",
                                "sense_id": "8c5a48b8-8303-31d9-8506-183513220225",
                                "text": "„Aus diesem Grund findest Du bei uns Laufhosen und Laufshorts in verschiedenen Längen - von Kurzgrößen über Normalgrößen bis hin zu Langgrößen.“"
                            },
                            {
                                "example_id": "6a17c983-1c97-4c47-b94d-7f6ef0f5734a",
                                "sense_id": "8c5a48b8-8303-31d9-8506-183513220225",
                                "text": "„Hier ein paar Laufsocken, da Laufshorts unter dem Schreibtisch und hinten in der Ecke sind noch ein paar durchgetretene Laufschuhe – Wenn man sich bei dir zu Hause, bei deinen Eltern oder bei der Arbeit aufhält, findet man stets eine Spur bzw. ein sportliches Lebenszeichen von dir.“"
                            },
                            {
                                "example_id": "770a39c4-e8f3-4e17-a7ab-f9ee3fd4c92a",
                                "sense_id": "8c5a48b8-8303-31d9-8506-183513220225",
                                "text": "„Mein Platz an der Theke ist noch warm, als ich in Laufshorts wieder vorm Zappes stehe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
