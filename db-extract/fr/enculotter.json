                ],
                "senses": [
                    {
                        "sense_id": "a3408f07-e1d3-3b03-9f5b-232cf13b1fa8",
                        "entry_id": "ffc649bc-352c-3fbc-8841-f9e5b2743645",
                        "glosses": [
                            "Revêtir d’une culotte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02f1606a-f75c-48d7-9bbf-347c2bc26b91",
                                "sense_id": "a3408f07-e1d3-3b03-9f5b-232cf13b1fa8",
                                "text": "Il y a cependant deux ans qu’on l’a enculotté."
                            },
                            {
                                "example_id": "56d1d5fc-01aa-4f3f-ac00-fd71c59908ef",
                                "sense_id": "a3408f07-e1d3-3b03-9f5b-232cf13b1fa8",
                                "text": "Et c’est ainsi qu’au mois de février de l’An de grâce 1940, une Compagnie d’infanterie de la vaillante armée française fut, si l’on ose dire, fractionnairement enculottée."
                            },
                            {
                                "example_id": "1127d588-f394-49a3-84d5-61a870de27cd",
                                "sense_id": "a3408f07-e1d3-3b03-9f5b-232cf13b1fa8",
                                "text": "Quand on l’appelait, il répondait : \"un moment, je m’enculotte\"."
                            }
                        ]
                    }
