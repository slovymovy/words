                                        "entry_id": "aed39a09-c1a2-399a-ad3c-20c77a4308d1",
                                        "glosses": [
                                            "Delighting in or feeling pleasure from the pain or humiliation of others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5795206a-0063-40b8-ac6c-f5797deaf548",
                                                "sense_id": "09f79883-cb90-37b0-a3ce-6ab68dceab7b",
                                                "text": "Together, with the help of the drunkard Haymitch (Woody Harrelson), the only District 12 citizen ever to win the Games, they challenge tributes that range from sadistic volunteers to crafty kids like the pint-sized Rue (Amandla Stenberg) to the truly helpless and soon-to-be-dead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78d92069-751b-386a-b65b-e94e7017bf10",
                                        "entry_id": "aed39a09-c1a2-399a-ad3c-20c77a4308d1",
                                        "glosses": [
                                            "Of behaviour which gives pleasure in the pain or humiliation of others."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8c5adc3-6a99-32d6-87a8-c9a13e4b91db",
                                        "entry_id": "aed39a09-c1a2-399a-ad3c-20c77a4308d1",
                                        "glosses": [
                                            "Causing a high degree of pain or humiliation."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
