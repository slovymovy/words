                "senses": [
                    {
                        "sense_id": "bd454979-0815-3c1c-a016-0743902483bf",
                        "entry_id": "07f94b52-8efe-3d86-971a-02420810546e",
                        "glosses": [
                            "hoe goed een afdruk is die door een printer gemaakt wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0928bdc6-7a12-427e-9a10-554281a7e191",
                                "sense_id": "bd454979-0815-3c1c-a016-0743902483bf",
                                "text": "De Consumentenbond test verschillende printers op onder meer afdrukkwaliteit, gebruiksgemak, kopiëren en scannen. Er zijn in totaal ruim 258 printers getest die op dit moment redelijk tot goed in de winkels verkrijgbaar zijn, waarvan 45 zwart-witprinters."
                            },
                            {
                                "example_id": "5f6893c0-b8f1-460a-b779-6f18c3a703db",
                                "sense_id": "bd454979-0815-3c1c-a016-0743902483bf",
                                "text": "Een foto in je handen geeft toch een ander gevoel dan een foto op een scherm. Wil je thuis je kiekjes afdrukken, dan kan een fotoprinter handig zijn. Wij testten vijf toestellen die ze in pocketformaat tevoorschijn toveren. Allemaal werken ze met speciaal fotopapier waar de ‘inkt’ in verwerkt zit. Verwacht hier dus geen inktpatronen. We drukten enkele foto’s vijfmaal af, en zochten naar het beste resultaat: een goede afdrukkwaliteit en een scherpe prijs per foto."
                            }
                        ]
                    }
