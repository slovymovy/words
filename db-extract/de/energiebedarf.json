                        "form": "dem Energiebedarfe"
                    },
                    {
                        "form_id": "2e3c09d9-c693-4821-ae66-7e3c2adeca50",
                        "entry_id": "07df970c-4b54-3aa3-b936-b4fda07099f8",
                        "tags": [
                            "dative",
                            "plural"
                        ],
                        "form": "den Energiebedarfen"
                    },
                    {
                        "form_id": "2d4f9249-1a2e-4203-aa1e-3a64203f6dba",
                        "entry_id": "07df970c-4b54-3aa3-b936-b4fda07099f8",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Energiebedarf"
                    },
                    {
                        "form_id": "ae8314b0-a7ef-42e4-83a4-931df5b565d9",
                        "entry_id": "07df970c-4b54-3aa3-b936-b4fda07099f8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Energiebedarfe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                        "entry_id": "07df970c-4b54-3aa3-b936-b4fda07099f8",
                        "glosses": [
                            "benötigte Menge an Energie, die etwas, beispielsweise ein Lebewesen, ein Staat, eine Industrie, ein Haus, zur Aufrechterhaltung seiner Funktionen/seines Funktionierens benötigt"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "b75bb6a3-3f21-48f4-b0b2-d96133f27043",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Die unentwegte Arbeit hat ihren Preis: Das Herz hat nur etwa ein halbes Prozent des Körpergewichts eines Menschen, braucht aber zehn Prozent des Energiebedarfs.“"
                            },
                            {
                                "example_id": "25a6f73c-607a-43df-88f2-f34e895d2acb",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Laut Empfehlung der Deutschen Gesellschaft für Ernährung (DGE) sollen 55 % des Energiebedarfs aus Kohlenhydraten gedeckt werden.“"
                            },
                            {
                                "example_id": "ad2ef918-8204-4510-adbe-e7bc3a65740b",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "Die Energiebedarfe der Stahlindustrie, der chemischen Industrie und der Zementindustrie sind enorm."
                            },
                            {
                                "example_id": "57afba7f-8c9b-4f04-b20c-08c387c9ac66",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "Kryptowährungen verursachen weltweit einen extrem hohen Energiebedarf."
                            },
                            {
                                "example_id": "7485b6d9-7bbe-42b5-9ea5-f7655ef39058",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "Um die Klimaziele zu erreichen, müssen wir unseren Energiebedarf senken."
                            },
                            {
                                "example_id": "d4fbba7a-aec1-4e72-ad4e-36b6eab2b63d",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Doch so gefährlich Methan auch als Klimakiller ist, als Hauptbestandteil von Erdgas und Biogas spielt es eine wichtige Rolle im täglichen Energiebedarf.“"
                            },
                            {
                                "example_id": "eefd6770-c4a6-4026-bfe0-b4549ae7ae30",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Die Türkei importiert nahezu ihren gesamten Energiebedarf“ […]."
                            },
                            {
                                "example_id": "2efb6d43-ea65-4877-9b77-2f286b7525ef",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Belarus deckt seinen Energiebedarf bislang größtenteils mit russischen fossilen Energieträgern.“"
                            },
                            {
                                "example_id": "14d8f305-8336-46cc-ab36-658f78a7bcdb",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Von 1990 bis 2008 stieg der Energiebedarf pro Kopf um 10 %, während die Weltbevölkerung um 27 % wuchs.“"
                            },
                            {
                                "example_id": "3a12df84-6040-4960-aa7b-213e57a54088",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Alle Experten sind sich einig, dass die EU derzeit mit ihren Vorräten beim Energiebedarf durch den Sommer kommt.“"
                            },
                            {
                                "example_id": "908f8709-abb7-454a-9b97-58abce377a8e",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Bis 2030 soll in Österreich produzierter Strom zu hundert Prozent aus erneuerbaren Energien stammen. Aber können wir den steigenden Energiebedarf tatsächlich mit Erneuerbaren decken? Ist eine CO2-freie Energieversorgung realistisch?“"
                            },
                            {
                                "example_id": "af8735ad-39e1-4c2c-9f67-4dc1bb9f9c6b",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„An die 20 Prozent des Energiebedarfs im IT-Sektor entfallen auf die Massenspeicher, hinzu kommen der Betrieb der Netze und der Transport der Daten.“"
                            },
                            {
                                "example_id": "1dabd250-9222-4bdc-9563-32f381040d2c",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Im Süden Hamburgs wurde vor etwa 100 Jahren kurzzeitig Braunkohle abgebaut, um den Energiebedarf nach dem Ersten Weltkrieg zu decken.“"
                            },
                            {
                                "example_id": "221ee794-6b39-4225-ac3e-5c87c21b0a05",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Die Stadt Schaffhausen will Strom sparen. Wie Zürich und Winterthur soll der Energiebedarf mehr als halbiert werden, die 2000-Watt-Gesellschaft soll in der Stadtverfassung verankert werden.“"
                            },
                            {
                                "example_id": "fb21c43b-6f9a-4cee-a165-c8879a299a03",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„1926 ist der Energiebedarf des Oktoberfestes bereits so hoch, dass die Stadt eine zweite Transformatorenstation im Keller des Brausebades am Bavariaring einrichten muss.“"
                            },
                            {
                                "example_id": "f2219f62-82e7-498a-aa9b-a5b6abe67314",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Bereits bei der Planung [Anmerkung: des Gebäudes] haben die Betreiber darauf geachtet, den Energiebedarf mit modernen Techniken möglichst gering zu halten.“"
                            },
                            {
                                "example_id": "bb0f155f-eb7f-479a-a195-5c3bddb73091",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "[Das neue Gesetzt] „schreibt Hausbesitzern vor, dass diese ihr neues Haus ohne Ölheizung planen und auf ihrem Dach Solarzellen montieren, um einen Teil ihres Energiebedarfs selber zu produzieren.“"
                            },
                            {
                                "example_id": "962fd65a-6452-46c2-bf5d-c39ee481f459",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Ein Überblick über typische Bedürfnisse während eines Tages zeigt, dass der Energiebedarf für Beleuchtung trotz der langen Nutzungsdauer wesentlich niedriger anzusetzen ist, als zum Beispiel für Fernsehen und Kochen.“",
                                "translation": "Biologie:"
                            },
                            {
                                "example_id": "d8aa5f9f-8405-4137-8174-a5a9fda949bf",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Der Energiebedarf ist abhängig von Alter, Geschlecht, Gesundheitszustand, körperlicher Tätigkeit und klimatischen Besonderheiten.“"
                            },
                            {
                                "example_id": "06487e5c-0551-4e60-8ed3-f2b99997a411",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Der Energiebedarf setzt sich aus Grundumsatz und Leistungsumsatz zusammen.“"
                            },
                            {
                                "example_id": "458448ec-f4bf-4620-8832-21b3d62a2987",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Der Energiebedarf wird meist in der Einheit Kilokalorie angegeben.“"
                            },
                            {
                                "example_id": "e825ed9c-8ad5-472a-a401-c2d99ca2bf94",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Leider sinkt mit dem Alter durch die abnehmende Muskelmasse, durch geringere körperliche Aktivität und durch hormonelle Veränderungen der Energiebedarf, was eine Gewichtsabnahme in höherem Lebensalter erschwert.“"
                            },
                            {
                                "example_id": "c1521ebb-ef04-4640-8fa5-060d2d870112",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Ausschließlich Säugetiere sind in der Lage, Winterschlaf zu halten. Dazu können sie ihren Energiebedarf um unglaubliche 99 Prozent senken.“"
                            },
                            {
                                "example_id": "8e868dbf-7658-40b6-81ea-c39cd6e5ea8b",
                                "sense_id": "00556ace-5185-31bd-89a0-94b2045827cf",
                                "text": "„Eine Kuh gibt inzwischen mehr Milch, als ihr Organismus verkraften kann. Das geht soweit, dass sie den gewaltigen Energiebedarf ihrer eigenen Milchproduktion mit der Nahrungsaufnahme nicht mehr decken kann. Nach maximal drei Jahren Milchproduktion magern die Kühe stark ab und und gehen mit einem Durchschnittsalter von fünf Jahren zum Schlachter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
