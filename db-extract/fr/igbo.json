                                        "sense_id": "83caff6d-f8e6-3e92-bcbf-c51c9f355d59",
                                        "entry_id": "4adda6f9-58b0-304e-a28c-ff24fa45532d",
                                        "glosses": [
                                            "taal die door 18 miljoen mensen in Nigeria en in enige andere Afrikaanse landen wordt gesproken"
                                        ],
                                        "tags": [
                                            "linguistics",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7533b760-b54c-4e26-be48-23c4c0f78701",
                                                "sense_id": "83caff6d-f8e6-3e92-bcbf-c51c9f355d59",
                                                "text": "Een van mijn studenten komt uit Togo en spreekt Igbo."
                                            },
                                            {
                                                "example_id": "04023483-40c9-4511-b9d4-f3220b00897f",
                                                "sense_id": "83caff6d-f8e6-3e92-bcbf-c51c9f355d59",
                                                "text": "Ze schrijft in het Engels: „Er zijn maar weinig mensen die Igbo kunnen lezen. En degenen die Igbo kunnen lezen, kunnen ook Engels lezen, dus waarom dan in het Igbo schrijven?”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Igbo",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a990250c-fc37-3088-8af8-3bc0df536884",
                                        "entry_id": "fb5ae718-df95-33cd-bbf3-9c65462c1aee",
                                        "glosses": [
                                            "iemand die behoort tot het gelijknamige volk in Nigeria"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7eba486-70b3-4685-9079-b1b406303e14",
                                                "sense_id": "a990250c-fc37-3088-8af8-3bc0df536884",
                                                "text": "Van de leidende kandidaten is hij de enige christen (de andere twee zijn moslim), in een land waar bijna de helft van de bevolking dat is. En Obi is een Igbo, een groep die zich al decennia gemarginaliseerd voelt en steeds luider roept om een Igbo-president."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Igbo",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "44fda325-1b77-3eaf-b9c0-e781ba85cf9b",
                                        "entry_id": "0673c36e-e46d-3b94-b71b-c9ec023363fa",
                                        "glosses": [
                                            "volk in het zuidoosten van Nigeria"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce001afd-99f9-47cd-8b25-85c4009f5180",
                                                "sense_id": "44fda325-1b77-3eaf-b9c0-e781ba85cf9b",
                                                "text": "De Oromo en Amhara in Ethiopië heten daar ‘nationaliteiten’, maar de Yoruba of Igbo in Nigeria, die even talrijk zijn, worden stammen genoemd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
