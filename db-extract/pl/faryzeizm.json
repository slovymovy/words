                    {
                        "translation_id": "de706a28-5230-4018-a855-8bc0a55568e9",
                        "source_entry_id": "bedee479-35b6-38c8-87e4-35eadedf43df",
                        "source_sense_id": "751737d9-448a-33d3-9bd3-75ac4300011e",
                        "target_lang_word": "фарисейство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фарисейство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "857bd246-a7ac-360b-b404-06f1db13552e",
                                        "entry_id": "64c60d4e-eac0-37d8-bbfe-bbccb68e582c",
                                        "glosses": [
                                            "истор. учение фарисеев"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60f52e3c-ac25-49e7-952e-e894eec01a18",
                                                "sense_id": "857bd246-a7ac-360b-b404-06f1db13552e",
                                                "text": "Для того, чтобы называть фарисейство сектою, надо показать, где, кем блюлось истинное учение Моисеева закона, а таких учителей не только нет, но по всем книгам Нового Завета видно, что эти самые учителя и были фарисеи и других никаких не было и не могло быть."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e851e87-193d-3c1d-9cef-bc5be7419c89",
                                        "entry_id": "64c60d4e-eac0-37d8-bbfe-bbccb68e582c",
                                        "glosses": [
                                            "перен., книжн., неодобр. неукоснительное, но чисто внешнее, формальное или даже показное исполнение каких-либо религиозных либо социальных нравственных правил, предписаний"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "264cb6e9-f892-4523-bcc1-e863e8396566",
                                                "sense_id": "1e851e87-193d-3c1d-9cef-bc5be7419c89",
                                                "text": "Быть сыном своего времени, отзываться на все его призывы, понимать все его задачи и бороться за их разрешение в первых рядах ― таковы обязанности, которые налагает нравственный закон. Вне такого содержания закон этот есть кимвал звенящий, он подвинет не на подвиг, а лишь на фарисейство и лицемерие."
                                            },
                                            {
                                                "example_id": "ae34a604-5703-4d71-a1d6-32c9f92ecba2",
                                                "sense_id": "1e851e87-193d-3c1d-9cef-bc5be7419c89",
                                                "text": "Но продуман распорядок действий, / И неотвратим конец пути. / Я один, всё тонет в фарисействе. / Жизнь прожить - не поле перейти."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbd6978b-ee62-4948-a74a-fe668ac7cb7a",
                        "source_entry_id": "bedee479-35b6-38c8-87e4-35eadedf43df",
