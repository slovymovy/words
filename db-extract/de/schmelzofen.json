                "senses": [
                    {
                        "sense_id": "debb71a4-fafe-341a-b61f-83bc149a6738",
                        "entry_id": "fa6ca4b9-e655-3880-b9fe-cafd16436561",
                        "glosses": [
                            "bestimmte Anlage/Vorrichtung, in der Metalle flüssig gemacht (geschmolzen) und zu Legierungen verbunden werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "196a3847-492f-423f-8e2b-444824effd7d",
                                "sense_id": "debb71a4-fafe-341a-b61f-83bc149a6738",
                                "text": "„Um die Schmelzöfen zu befeuern, wurden im 18. und 19. Jahrhundert die Buchen- und Eichenwälder der Vulkaneifel so rücksichtslos abgeholzt, daß ‚fast keine Bohnenstange mehr anzutreffen war‘, wie 1772 eine Denkschrift des Kurtrierischen Forstamtes anprangerte.“"
                            },
                            {
                                "example_id": "578ffb90-f4e9-4e71-beac-6e144df8c7e7",
                                "sense_id": "debb71a4-fafe-341a-b61f-83bc149a6738",
                                "text": "„Der Schmelzofen wurde mit Steinkohle beheizt.“"
                            },
                            {
                                "example_id": "51bf88f8-3a91-493f-b509-00b406278deb",
                                "sense_id": "debb71a4-fafe-341a-b61f-83bc149a6738",
                                "text": "„Sie erstanden die Geräte eines verkrachten Destillateurs, und bald kamen Siebe, Fäßchen, Trichter, Schaumlöffel, Filtrierbeutel und Waagen ins Haus, ohne eine Schleifschale mit Kugel und einen Destillierkolben mitzuzählen, der einen Schmelzofen mit Rauchfang erforderlich machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
