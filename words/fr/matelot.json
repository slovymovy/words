    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0d30889-0f78-32dd-b77d-dc4483821bd6",
                    "sense_definition": "Membre de l'équipage d'un navire chargé de son entretien ou de sa manœuvre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "marin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sur le pont, le jeune <w>matelot</w> rangeait soigneusement les cordages avant la tempête."
                        },
                        {
                            "text": "Chaque <w>matelot</w> de pont doit obéir rapidement aux ordres du capitaine pendant les manœuvres."
                        }
                    ],
                    "common_phrases": [
                        "matelot de pont",
                        "costume de matelot"
                    ]
                },
                {
                    "sense_id": "f2c35647-6740-3126-910c-b5ce5b9095ab",
                    "sense_definition": "Premier grade de la hiérarchie dans la marine militaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "grade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs mois d'entraînement, il a enfin été promu <w>matelot</w> de première classe."
                        },
                        {
                            "text": "Ce jeune engagé porte fièrement l'insigne de son grade de <w>matelot</w>."
                        }
                    ],
                    "common_phrases": [
                        "matelot de première classe",
                        "matelot de deuxième classe"
                    ]
                },
                {
                    "sense_id": "6494fe1a-2245-32a0-a727-d5c97fb1fbe2",
                    "sense_definition": "Chacun des navires qui en précède ou en suit immédiatement un autre dans une ligne de file.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "naval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En pleine manœuvre navale, chaque navire doit surveiller attentivement son <w>matelot</w> d'avant."
                        },
                        {
                            "text": "Le cuirassé a maintenu une distance constante avec son <w>matelot</w> d'arrière toute la nuit."
                        }
                    ],
                    "common_phrases": [
                        "matelot d'avant",
                        "matelot d'arrière"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3990024a-4cc7-3b9f-b836-35d8af4f6352",
                    "sense_definition": "Relatif à la fonction ou à l'habillement des marins.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a enfilé un tricot <w>matelot</w> pour se protéger du vent marin."
                        },
                        {
                            "text": "Cette coupe de veste au style <w>matelot</w> est redevenue très populaire cette saison."
                        }
                    ]
                },
                {
                    "sense_id": "f01710ca-b3a2-3a8e-a10b-86fe7717ec83",
                    "sense_definition": "Qui suit ou précède immédiatement un autre vaisseau dans une ligne de bataille.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "naval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vaisseau <w>matelot</w> suivait fidèlement la ligne tracée par le commandant de l'escadre."
                        },
                        {
                            "text": "La frégate de tête a transmis des signaux urgents au bâtiment <w>matelot</w>."
                        }
                    ],
                    "common_phrases": [
