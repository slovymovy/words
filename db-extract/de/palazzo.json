                "senses": [
                    {
                        "sense_id": "db51c181-7c45-3847-bd89-38f8434256ab",
                        "entry_id": "b33b89c2-0778-3e4f-b9fb-5a1e085a8ba0",
                        "glosses": [
                            "italienischer Palast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1553baf7-1eeb-4d35-99a9-0bbdf6776e7e",
                                "sense_id": "db51c181-7c45-3847-bd89-38f8434256ab",
                                "text": "„Mir standen noch die Palazzi vor Augen, die von den Jahrhunderten verwaschenen Steine, die Säle mit ihren hohen Decken und ihrem Geruch nach Staub, Feuchtigkeit, Bohnerwachs, Weihrauch, nach Geschichte eben – und hier in Berlin?“"
                            },
                            {
                                "example_id": "ffdd26aa-5cd2-4eb2-8765-8ec641c498e8",
                                "sense_id": "db51c181-7c45-3847-bd89-38f8434256ab",
                                "text": "„Er liebte Teresa, die Tochter des Schauspielers Imer, der unweit seines Palazzo in einem Hause wohnte, dessen Fenster seinem Schlafzimmer gegenüber lagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4db9319b-d3cc-4d90-9b6f-bc1a2fdf3ebd",
