{
    "word_family": [
        "clammy",
        "clamminess"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c04402f-342f-3f21-b24b-ca82f21102ca",
                    "sense_definition": "A type of edible bivalve mollusk that lives in sand or mud.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mollusk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went to the beach to dig for <w>clams</w> at low tide.",
                            "target_lang_translations": {
                                "it": "Siamo andati in spiaggia a scavare per cercare <w>vongole</w> durante la bassa marea."
                            }
                        },
                        {
                            "text": "The restaurant serves fresh steamed <w>clams</w> with garlic butter.",
                            "target_lang_translations": {
                                "it": "Il ristorante serve fresche <w>vongole</w> al vapore con burro all'aglio."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dig for clams",
                        "steamed clams"
                    ],
                    "target_lang_definitions": {
                        "it": "Un tipo di mollusco bivalve commestibile che vive nella sabbia o nel fango."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "vongola",
                                "target_lang_sense_clarification": "Termine comune per il mollusco bivalve usato in cucina."
                            },
                            {
                                "target_lang_word": "arsella",
                                "target_lang_sense_clarification": "Termine regionale o popolare per indicare vari molluschi marini commestibili."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a540a3b1-9ee4-3236-a46d-365a54daa45b",
                    "sense_definition": "A slang term for a dollar.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That fancy watch cost him five hundred <w>clams</w>.",
                            "target_lang_translations": {
                                "it": "Quell'orologio elegante gli è costato cinquecento <w>dollari</w>."
                            }
                        },
                        {
                            "text": "He spent all his <w>clams</w> on a new car.",
                            "target_lang_translations": {
                                "it": "Ha speso tutti i suoi <w>soldi</w> per una macchina nuova."
                            }
                        }
                    ],
                    "synonyms": [
                        "buck",
                        "dollar"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal term for money."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Termine gergale per indicare un dollaro."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "dollaro",
                                "target_lang_sense_clarification": "Traduzione letterale della valuta."
                            },
                            {
                                "target_lang_word": "bigliettone",
                                "target_lang_sense_clarification": "Termine colloquiale per indicare denaro o banconote."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90b13805-7f2f-3bd1-b30a-558840a3cbba",
                    "sense_definition": "A person's mouth, usually used in the phrase to shut one's clam.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He finally decided to shut his <w>clam</w> and listen to the instructions.",
                            "target_lang_translations": {
                                "it": "Alla fine ha deciso di chiudere il <w>becco</w> e ascoltare le istruzioni."
                            }
                        },
                        {
                            "text": "You should really learn to keep your <w>clam</w> shut during meetings.",
                            "target_lang_translations": {
                                "it": "Dovresti davvero imparare a tenere la <w>bocca</w> chiusa durante le riunioni."
                            }
                        }
                    ],
                    "synonyms": [
                        "trap",
                        "mouth"
                    ],
                    "common_phrases": [
                        "shut one's clam"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and slightly rude."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "La bocca di una persona, usato solitamente nell'espressione 'stare zitti'."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "bocca",
                                "target_lang_sense_clarification": "Termine standard per la parte del corpo."
                            },
                            {
                                "target_lang_word": "becco",
                                "target_lang_sense_clarification": "Termine colloquiale e leggermente rude per indicare la bocca."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "996be3f3-fbeb-31f3-9980-f26ba8378637",
                    "sense_definition": "To dig or search for clams in the sand or mud.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mollusk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the entire morning <w>clamming</w> along the shoreline.",
                            "target_lang_translations": {
                                "it": "Hanno passato l'intera mattinata a <w>raccogliere vongole</w> lungo la riva."
                            }
                        },
                        {
                            "text": "It is a popular local tradition to go <w>clamming</w> in the summer.",
                            "target_lang_translations": {
                                "it": "È una tradizione locale popolare andare a <w>raccogliere vongole</w> in estate."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go clamming"
                    ],
                    "target_lang_definitions": {
                        "it": "Cercare o scavare vongole nella sabbia o nel fango."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "raccogliere vongole",
                                "target_lang_sense_clarification": "Attività di ricerca dei molluschi."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6d476e95-4859-3ab5-9acf-2b6d55ed3f0a",
                    "sense_definition": "Feeling or being moist, sticky, and cold.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His hands felt <w>clam</w> and cold from the nervous sweat.",
                            "target_lang_translations": {
                                "it": "Le sue mani erano <w>umide</w> e fredde per il sudore nervoso."
                            }
                        },
                        {
                            "text": "The air in the basement was <w>clam</w> and unpleasant.",
                            "target_lang_translations": {
                                "it": "L'aria nel seminterrato era <w>umida</w> e sgradevole."
                            }
                        }
                    ],
                    "synonyms": [
                        "clammy",
                        "damp"
                    ],
                    "antonyms": [
                        "dry"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English; clammy is preferred."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Sensazione di essere umido, appiccicoso e freddo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "umido",
                                "target_lang_sense_clarification": "Che presenta umidità."
                            },
                            {
                                "target_lang_word": "viscido",
                                "target_lang_sense_clarification": "Che dà una sensazione di appiccicoso o scivoloso."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}