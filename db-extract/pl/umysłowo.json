                    {
                        "translation_id": "10fc0553-371c-4c08-8af6-ef9edd125719",
                        "source_entry_id": "4690cd3f-7bf9-3d46-974c-96313877de21",
                        "source_sense_id": "cead1a39-0807-3889-b09c-f5741263927b",
                        "target_lang_word": "geistig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geistig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb9aae49-7055-3c28-9f0e-16398d957a67",
                                        "entry_id": "e2197456-6984-3d80-98da-5ab71a0b20a9",
                                        "glosses": [
                                            "den menschlichen Geist, die Gedanken betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "178ef854-d1f7-4b57-afdc-1a7d739a00a7",
                                                "sense_id": "fb9aae49-7055-3c28-9f0e-16398d957a67",
                                                "text": "Man sollte sich nicht nur körperlich, sondern auch geistig anstrengen."
                                            },
                                            {
                                                "example_id": "5423c1c0-76e9-44f4-b688-39cdedfdc61a",
                                                "sense_id": "fb9aae49-7055-3c28-9f0e-16398d957a67",
                                                "text": "Der alte Herr ist geistig noch topfit."
                                            },
                                            {
                                                "example_id": "74e0279d-dc6e-45d2-b09d-39316943d0ec",
                                                "sense_id": "fb9aae49-7055-3c28-9f0e-16398d957a67",
                                                "text": "„Die Intelligenz, das geistige Leistungsvermögen, zeigt sich darin, inwieweit ein Lebewesen in der Lage ist, Probleme in einer gegebenen Umwelt situationsgerecht und rasch zu lösen.“"
                                            },
                                            {
                                                "example_id": "8b97da24-04aa-4f66-b3c3-4b8f49eece67",
                                                "sense_id": "fb9aae49-7055-3c28-9f0e-16398d957a67",
                                                "text": "„Für Schweitzer bedeutet es, ein geistiger Abenteurer zu sein, wie die Welt sie nötig hat, wenn man die Fähigkeit entwickelt, sein Vorhaben nicht als etwas Außergewöhnliches, sondern als etwas Selbstverständliches zu begreifen, bei dem man nur seine Pflicht erfüllt.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5cb172dc-8df9-301a-8814-5cd045520540",
                                        "entry_id": "e2197456-6984-3d80-98da-5ab71a0b20a9",
                                        "glosses": [
                                            "Alkohol enthaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da19d14a-649e-4df0-879e-617c36e685a4",
                                                "sense_id": "5cb172dc-8df9-301a-8814-5cd045520540",
                                                "text": "An diesem Abend flossen hauptsächlich geistige Getränke."
                                            },
                                            {
                                                "example_id": "82d64c8f-eea9-4cd5-84d1-0a5a4bdfdaeb",
                                                "sense_id": "5cb172dc-8df9-301a-8814-5cd045520540",
                                                "text": "Eine dünne, klare, röhlich-gelbe, geistige Flüssigkeit, welche, besonders wenn sie in der flachen Hand gerieben oder auf einem erhitzten Bleche verdampft einen eigenen lieblichen Geruch äußert und einen süßlichen, zugleich etwas scharfen und gelind etwas balsamischen Geschmack besitzt. (1825)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eceac5e0-dfde-47fb-8bf5-da19daad6909",
                        "source_entry_id": "4690cd3f-7bf9-3d46-974c-96313877de21",
                        "source_sense_id": "cead1a39-0807-3889-b09c-f5741263927b",
                        "target_lang_word": "intellektuell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intellektuell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08cec48a-4be2-3f8a-b852-60804c40e974",
                                        "entry_id": "6bdd9573-024e-3fcf-857d-f7e48e790241",
                                        "glosses": [
                                            "den Geist/Intellekt/Verstand betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1070d982-341b-44c9-b140-33067f4ab334",
                                                "sense_id": "08cec48a-4be2-3f8a-b852-60804c40e974",
                                                "text": "Das ist ein intellektuelles Spiel."
                                            },
                                            {
                                                "example_id": "bb0b837d-ff2a-4a99-bf3e-767bd13621e4",
                                                "sense_id": "08cec48a-4be2-3f8a-b852-60804c40e974",
                                                "text": "„Zu den Schülern dieses intellektuellen Zentrums zählte auch Paulus.“"
                                            },
                                            {
                                                "example_id": "64eca3b1-ef31-49ef-8354-30df56f58b93",
                                                "sense_id": "08cec48a-4be2-3f8a-b852-60804c40e974",
                                                "text": "„Sobald wir mit dem Begriff Zeit zu experimentieren beginnen, und sei es auch nur als Gedankenexperiment oder zum rein intellektuellen Zeitvertreib, müssen wir feststellen, daß unsere Sprache und mit ihr unsere Denkprozesse uns sehr bald im Stich lassen.“"
                                            },
                                            {
                                                "example_id": "09a253ea-6f4f-4081-bcca-95179a8ad5d2",
                                                "sense_id": "08cec48a-4be2-3f8a-b852-60804c40e974",
                                                "text": "„Der Glaube, dass es einen Gott gibt, bleibt jedoch trotz der Versuche des menschlichen Geistes, sich über sogenannte Gottesbeweise, über intellektuelle Erkenntnisse und logische Schlüsse, Sicherheit zu verschaffen, ein Wagnis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
