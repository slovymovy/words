                                "example_id": "00933f9b-a7db-42bd-906c-ef6a77fedeb5",
                                "sense_id": "20ee6059-5a26-37a6-bfe6-450c203d2f59",
                                "text": "„Wie sieht das polizeiliche Fahndungsnetz aus, wenn es darum geht, Sore einzufangen?“"
                            }
