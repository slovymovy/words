                                    {
                                        "sense_id": "7b85228c-3a31-3021-a5bd-5041dce1cb92",
                                        "entry_id": "ea40f8d6-2fb6-36a0-b289-1e0205a325b4",
                                        "glosses": [
                                            "A demonstration of respect, as towards a person after his or her retirement or death."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae42d67a-a544-4e4b-bde8-99f9f52978fe",
                                                "sense_id": "7b85228c-3a31-3021-a5bd-5041dce1cb92",
                                                "text": "I ſought no homage from the Race that vvrite; / I kept, like Aſian Monarchs, from their ſight: […]"
                                            },
                                            {
                                                "example_id": "70d26426-77e0-4292-971d-c8ea44d5478a",
                                                "sense_id": "7b85228c-3a31-3021-a5bd-5041dce1cb92",
                                                "text": "When a man squeezes the hand of a pretty woman, […] she will consider such an impertinent freedom in the light of an insult, if she have any true delicacy, instead of being flattered by this unmeaning homage to beauty."
                                            },
                                            {
                                                "example_id": "cf92f92c-5b4f-4742-afcd-0abc9b448810",
                                                "sense_id": "7b85228c-3a31-3021-a5bd-5041dce1cb92",
                                                "text": "It’s appropriate that we pay homage to them and the sacrifices they made."
                                            },
                                            {
                                                "example_id": "4e1e8bce-9668-497d-9c4e-5fe393efbf27",
                                                "sense_id": "7b85228c-3a31-3021-a5bd-5041dce1cb92",
                                                "text": "My rainy-day tour in April during the first lockdown was, in fact, a homage to Sir John Betjeman - the poet and railway campaigner whose statue can be found on the upper concourse of St Pancras station."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07ba8b6d-290a-39b3-915f-445760495933",
                                        "entry_id": "ea40f8d6-2fb6-36a0-b289-1e0205a325b4",
                                        "glosses": [
                                            "An artistic work imitating another in a flattering style."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3a730ee-9ac5-4a1b-8308-8ce599acc7d6",
                                                "sense_id": "07ba8b6d-290a-39b3-915f-445760495933",
                                                "text": "He likes to tell people that it's a Hitchcockian thriller, but that's kind of like saying Happy Gilmore is a homage to Woody Allen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f99a1181-6879-3ef4-bf77-1f7d138e848d",
                                        "entry_id": "ea40f8d6-2fb6-36a0-b289-1e0205a325b4",
                                        "glosses": [
                                            "In feudalism, the formal oath of a vassal to honor his or her lord's rights."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db3a727d-46d3-4ce9-87aa-053dfd05ddee",
                                                "sense_id": "f99a1181-6879-3ef4-bf77-1f7d138e848d",
                                                "text": "We'll do thee homage, and be rul'd by thee, / Love thee as our commander and our king."
                                            }
                                        ]
                                    }
                                ]
                            },
