                    },
                    {
                        "sense_id": "16b30746-e712-3d7d-8c77-883916e73173",
                        "entry_id": "9564f060-e397-3e6e-ac15-3573b33b468a",
                        "glosses": [
                            "Martin-pêcheur (d’Europe)."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "00e6c6dc-917b-4f98-bdb3-9aaca6686669",
                                "sense_id": "16b30746-e712-3d7d-8c77-883916e73173",
                                "text": "Le vol de cet oiseau, dans la rapidité duquel on a trouvé quelque ressemblance avec celui du martinet , et la manière dont il pourvoit à sa subsistance , lui ont fait donner les noms de martinet-pécheur et martin-pêcheur, en France, où il est également connu sous ceux de pécheur, tartarin, artre, monnier, bleuet, pivert-d'eau, péche-véron, vire-vent, etc. Une erreur populaire sur sa prétendue propriété de conserver les étoffes dans les magasins, où sa dépouille est elle-même attaquée par les teignes et les dermestes, l'a fait aussi appeler drapier et garde-boutique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b7863d0-d908-458c-b10f-f0a5f804e40d",
                        "source_entry_id": "9564f060-e397-3e6e-ac15-3573b33b468a",
                        "target_lang_word": "Ladenhüter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ladenhüter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5794a1dd-f2c4-3495-b7c8-22fd67fb9e99",
                                        "entry_id": "5f6af9d4-7029-32c8-b162-2943787a74bd",
                                        "glosses": [
                                            "Artikel, der schlecht oder gar nicht zu verkaufen ist"
                                        ],
                                        "tags": [
                                            "Einzelhandel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72a06de0-abec-46cc-b776-7eb8eab97390",
                                                "sense_id": "5794a1dd-f2c4-3495-b7c8-22fd67fb9e99",
                                                "text": "Die Spielzeuge aus Plastik sind richtige Ladenhüter, sie stehen schon seit zehn Monaten in den Regalen des Geschäftes."
                                            },
                                            {
                                                "example_id": "8f100645-dc0c-4ed4-b860-d6ed35888ba4",
                                                "sense_id": "5794a1dd-f2c4-3495-b7c8-22fd67fb9e99",
                                                "text": "Bei diesem fantastischen Wetter werden Regenschirme selbst in London zum Ladenhüter."
                                            },
                                            {
                                                "example_id": "023472f3-647a-4a27-9ea5-2cde236a1d17",
                                                "sense_id": "5794a1dd-f2c4-3495-b7c8-22fd67fb9e99",
                                                "text": "Trotz Staatsprämie sind E-Autos Ladenhüter."
                                            },
                                            {
                                                "example_id": "0c2fb263-f8d3-45f8-89a7-05ece3e525d8",
                                                "sense_id": "5794a1dd-f2c4-3495-b7c8-22fd67fb9e99",
                                                "text": "Mit dem Vorrundenaus der deutschen Fußballnationalmannschaft bei der WM 2018 wurden deren Trikots zu Ladenhütern."
                                            },
                                            {
                                                "example_id": "72ad56ee-3c6f-4f18-87f5-764a15e6a45f",
                                                "sense_id": "5794a1dd-f2c4-3495-b7c8-22fd67fb9e99",
                                                "text": "[…] während konventionelle Ware als Ladenhüter liegen bleibt, ist das Angebot für Bio-Ware bald vergriffen."
                                            },
                                            {
                                                "example_id": "571eac18-7c03-4f39-be26-e9a46b3a9672",
                                                "sense_id": "5794a1dd-f2c4-3495-b7c8-22fd67fb9e99",
                                                "text": "„Bei ihm jedoch bekamen die Ladenhüter nicht nur ihr Gnadenbrot, sie bekamen sogar die besseren Plätze in den Regalen.“"
                                            },
                                            {
                                                "example_id": "93de725b-9880-4d0f-9b97-6e880e572a55",
                                                "sense_id": "5794a1dd-f2c4-3495-b7c8-22fd67fb9e99",
                                                "text": "Ein Ladenhüter war [das Buch] „Die Ladenhüterin“ wahrlich nicht. 650.000 mal hat sich der Roman der knapp 40jährigen Sayaka Murata in Japan verkauft."
                                            },
                                            {
                                                "example_id": "1dca35a4-a51a-4e29-85b6-05db17c5d908",
                                                "sense_id": "5794a1dd-f2c4-3495-b7c8-22fd67fb9e99",
                                                "text": "Warum nur sind Werke von Künstlerinnen vielfach Ladenhüter und werden auch von Galeristinnen seltener verkauft?"
                                            },
                                            {
                                                "example_id": "3dde8143-7f52-435e-aef5-2ba39338e077",
                                                "sense_id": "5794a1dd-f2c4-3495-b7c8-22fd67fb9e99",
                                                "text": "„Ein Nimbus, der auch die Ladenhüter in neuem Licht erscheinen ließ.“"
                                            },
                                            {
                                                "example_id": "dd9d5e5a-8c66-4c10-abd2-9e7bce3ad2ec",
                                                "sense_id": "5794a1dd-f2c4-3495-b7c8-22fd67fb9e99",
                                                "text": "Der Skandal um manipulierte Abgaswerte war ein Supergau für die deutsche Autoindustrie. Noch immer ist der Diesel deshalb ein Ladenhüter, nicht nur bei uns in Deutschland."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
