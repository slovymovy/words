                                "target_lang_sense_clarification": "dare un colpo"
                            },
                            {
                                "target_lang_word": "picchiare",
                                "target_lang_sense_clarification": "percuotere, dare botte"
                            },
                            {
                                "target_lang_word": "battere",
                                "target_lang_sense_clarification": "colpire con forza"
                            }
                        ]
                    }
