                                    {
                                        "sense_id": "725eaa39-f673-3cc8-b17d-cb8b06570ff7",
                                        "entry_id": "e2ec78b1-03f9-3402-9dd8-0be0e65f9892",
                                        "glosses": [
                                            "the property of being universal, common to all members of a class"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
