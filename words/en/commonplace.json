                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "15b274bf-2efd-3652-8d62-b6f1abc12c98",
                    "sense_definition": "To speak in clichés or repeat dull platitudes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He preferred to act rather than <w>commonplace</w> about social responsibility.",
                            "target_lang_translations": {
                                "ru": "Он предпочитал действовать, а не <w>сыпать банальностями</w> о социальной ответственности."
                            }
                        },
                        {
                            "text": "Instead of debating real issues, politicians often simply <w>commonplace</w> on stage.",
                            "target_lang_translations": {
                                "ru": "Вместо обсуждения реальных проблем политики на сцене часто просто <w>говорят общими местами</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as a verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить банальностями или повторять избитые штампы."
                    },
                    "translations": {
