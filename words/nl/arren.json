                    "sense_definition": "rijden met een ar (een arrenslee)",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de winter gingen ze vaak <w>arren</w> door het besneeuwde landschap.",
                            "target_lang_translations": {
                                "it": "In inverno andavano spesso a <w>andare in slitta</w> attraverso il paesaggio innevato."
                            }
                        },
                        {
                            "text": "Het is een oude traditie om met kerst te <w>arren</w>.",
                            "target_lang_translations": {
                                "it": "È un'antica tradizione <w>andare in slitta</w> a Natale."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lekker arren"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "verwijst naar een traditionele manier van vervoer"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Viaggiare o andare in giro su una slitta trainata da cavalli."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "andare in slitta",
                                "target_lang_sense_clarification": "riferito specificamente all'uso di una slitta trainata da animali"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1ed7cce0-f367-3ad7-bf32-f01b3e4857ab",
                    "sense_definition": "datief van het verouderde <w>ar</w> (boos, kwaad)",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij sprak in <w>arren</w> moede over zijn verleden.",
                            "target_lang_translations": {
                                "it": "Parlò del suo passato in <w>preda alla disperazione</w>."
                            }
                        },
                        {
                            "text": "De man reageerde in <w>arren</w> rade op de situatie.",
                            "target_lang_translations": {
                                "it": "L'uomo reagì alla situazione in <w>preda all'ira</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in arren moede",
                        "in arren rade"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "komt enkel voor in vaste uitdrukkingen"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Forma arcaica e dativa di 'ar' (arrabbiato, adirato), utilizzata esclusivamente in espressioni idiomatiche fisse."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "adirato",
                                "target_lang_sense_clarification": "riferito a uno stato di rabbia o frustrazione estrema"
                            },
                            {
                                "target_lang_word": "disperato",
                                "target_lang_sense_clarification": "riferito a una condizione di impotenza o frustrazione profonda"
                            }
                        ]
                    }
                }
            ]
        }
