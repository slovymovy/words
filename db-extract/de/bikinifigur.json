                "senses": [
                    {
                        "sense_id": "1c7022d2-e688-3d7f-8c88-5f7f66762f8c",
                        "entry_id": "eb46cf65-d61f-39e9-b647-ab8ef404e2db",
                        "glosses": [
                            "schlanke, für einen Bikini geeignete Körperform"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c16f9a0d-fe4e-4b97-b0fd-ee6c6fe17e0b",
                                "sense_id": "1c7022d2-e688-3d7f-8c88-5f7f66762f8c",
                                "text": "„Wenn man sich als Frau aber zu oft mit Schokolade belohnt oder tröstet, ist die Bikinifigur schnell ruiniert.“"
                            },
                            {
                                "example_id": "b3fa10a3-abf8-40eb-a98f-f2b898906d29",
                                "sense_id": "1c7022d2-e688-3d7f-8c88-5f7f66762f8c",
                                "text": "Sie ziehen ihre Badekleider über den Kopf und zeigen stolz ihre Bikinifiguren, bevor sie formvollendet ins Wasser springen."
                            },
                            {
                                "example_id": "cb8db5b9-4e5f-45fc-84bc-2054b1773f49",
                                "sense_id": "1c7022d2-e688-3d7f-8c88-5f7f66762f8c",
                                "text": "Gar nicht erst den Gedanken an Essen aufkommen lassen, haben wir in dem fliederfarbenen Kasten mit den »10 Tipps für die Bikinifigur – so klappt's diesmal wirklich« in einer Zeitschrift gelesen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
