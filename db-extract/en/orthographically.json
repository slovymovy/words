                "entry_id": "552e5e4d-561a-3a90-a41c-1ffb04587e8f",
                "word": "orthographically",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6d02b6d6-9e44-3967-b5e6-ac67108416af",
                        "entry_id": "552e5e4d-561a-3a90-a41c-1ffb04587e8f",
                        "glosses": [
                            "Regarding or relating to orthography (the way in which languages, usually natural languages, are written)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "825c7fc8-e898-4357-8044-2b8c4582a144",
                                "sense_id": "6d02b6d6-9e44-3967-b5e6-ac67108416af",
                                "text": "Although it is possible to represent this phonetic distinction orthographically, such representation is not emically realized."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5ad0775-16a9-3cd3-9223-cc0e4b3ec4d0",
                        "entry_id": "552e5e4d-561a-3a90-a41c-1ffb04587e8f",
                        "glosses": [
                            "According to standardized or formally accepted orthography: using proper spelling, and (more strictly) proper spelling, punctuation, capitalization, and italics."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a26e0cca-2b0b-453d-9013-e62932d6f10d",
                                "sense_id": "f5ad0775-16a9-3cd3-9223-cc0e4b3ec4d0",
                                "text": "stylings that are orthographically valid (acceptable), albeit not preferable"
                            },
                            {
                                "example_id": "58cf327a-f801-410a-972d-a50064b994fd",
                                "sense_id": "f5ad0775-16a9-3cd3-9223-cc0e4b3ec4d0",
                                "text": "For example, in Mathematics, the SVL includes find and set, which are not as orthographically complex as other entries such as quadrilateral or trigonometric, and furthermore commonly occur outside mathematics."
                            }
                        ]
                    },
                    {
                        "sense_id": "3083b52a-d112-3686-ac81-87d9690989b0",
                        "entry_id": "552e5e4d-561a-3a90-a41c-1ffb04587e8f",
                        "glosses": [
                            "Using an orthographic projection (a way of showing three-dimensional objects in two-dimensional engineering drawings)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1416fe4d-2f4f-4466-a829-8048cb36696c",
                                "sense_id": "3083b52a-d112-3686-ac81-87d9690989b0",
                                "text": "To represent an internal feature orthographically, dashed lines are used instead of solid ones."
                            }
                        ]
                    }
                ],
