                        "examples": [
                            {
                                "example_id": "b3212cb3-8316-4f43-99f1-19917a88ada9",
                                "sense_id": "3c3c48a6-bc3d-3063-88db-0eff633b2284",
                                "text": "Acht jaar geleden liep Paul Elstak zijn aanstaande vrouw toevallig tegen het lijf op een boksgala waar hij tussen de rondes door de muziek verzorgde. \"Ze viel me gelijk op\", blikt hij met veel genoegen terug."
                            },
                            {
                                "example_id": "2e0a669e-b2a8-4ce3-aa7a-72a666ee3a99",
                                "sense_id": "3c3c48a6-bc3d-3063-88db-0eff633b2284",
                                "text": "\"Het was een topavond\", vond organisator Gedik na afloop van het drukbezochte boksgala. Er komt volgens hem volgend jaar dan ook beslist weer een interland in Almelo."
                            },
                            {
                                "example_id": "33a11870-2f60-4d51-9153-4abe4d3ff67d",
                                "sense_id": "3c3c48a6-bc3d-3063-88db-0eff633b2284",
                                "text": "Trainer-coach Martin Jansen, de voormalige steun en toeverlaat van de uit beeld geraakte profbokser Innocent Anyanwu, noemde de ongelukkige afloop voor Danyo van het openingsduel op het jaarlijkse boksgala in Carré niet meer dan een smetje."
                            }
                        ]
                    }
