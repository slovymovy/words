                                        "entry_id": "22d1d1b8-709f-31d0-b2be-6c4ef496c9c9",
                                        "glosses": [
                                            "Suffering from gloom; melancholy; dejected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2573acf6-caa0-45d7-9769-7d4a50c926e6",
                                                "sense_id": "1039e8a6-31c7-32d6-b92d-7fe26fa7c71c",
                                                "text": "a gloomy temper or countenance"
                                            },
                                            {
                                                "example_id": "a485de46-eb2c-40cd-9b93-3c052d6ccb48",
                                                "sense_id": "1039e8a6-31c7-32d6-b92d-7fe26fa7c71c",
                                                "text": "The report was slightly gloomier than in June, when unemployment rates eased in more than half of all U.S. states for a third straight month and only five states reported jobless rate increases."
                                            },
                                            {
                                                "example_id": "9878a7cf-c064-4647-b3bf-045a09f8519b",
                                                "sense_id": "1039e8a6-31c7-32d6-b92d-7fe26fa7c71c",
                                                "text": "“The outlook is less gloomy than in our October forecast, and could represent a turning point, with growth bottoming out and inflation declining,” Pierre-Olivier Gourinchas, the IMF’s director of research, wrote in a blog post."
                                            },
                                            {
                                                "example_id": "80c47d5a-fa06-44f0-8f87-15d256370d89",
                                                "sense_id": "1039e8a6-31c7-32d6-b92d-7fe26fa7c71c",
                                                "text": "The opposite of an escapist blockbuster, the eighth and apparently final outing for Tom Cruise's Ethan Hunt is the doomiest and gloomiest yet in the action-adventure franchise."
                                            }
                                        ]
                                    }
                                ]
                            },
