{
    "word_family": [
        "mure",
        "muralist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e07c11c0-b696-362e-8740-1f89fc6ad505",
                    "sense_definition": "A large painting, usually drawn on a wall.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city commissioned a local artist to paint a colorful <w>mural</w> on the side of the library.",
                            "target_lang_translations": {
                                "de": "Die Stadt beauftragte einen lokalen Künstler, ein farbenfrohes <w>Wandgemälde</w> an die Seite der Bibliothek zu malen."
                            }
                        },
                        {
                            "text": "Tourists often stop to take photos of the beautiful <w>mural</w> in the downtown district.",
                            "target_lang_translations": {
                                "de": "Touristen halten oft an, um Fotos von dem schönen <w>Wandgemälde</w> im Innenstadtviertel zu machen."
                            }
                        }
                    ],
                    "synonyms": [
                        "fresco",
                        "wall painting"
                    ],
                    "common_phrases": [
                        "paint a mural",
                        "large mural"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein großes Gemälde, das meist direkt auf eine Wand aufgetragen wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Wandgemälde",
                                "target_lang_sense_clarification": "allgemeiner Begriff für ein auf eine Wand gemaltes Bild"
                            },
                            {
                                "target_lang_word": "Mural",
                                "target_lang_sense_clarification": "modernes, oft großflächiges Wandbild im öffentlichen Raum"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "67ef13cf-b601-3940-be3e-86275020b27b",
                    "sense_definition": "Of or relating to a wall; on, or in, or against a wall.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect designed a <w>mural</w> decoration to enhance the building's facade.",
                            "target_lang_translations": {
                                "de": "Der Architekt entwarf eine <w>Wanddekoration</w>, um die Fassade des Gebäudes aufzuwerten."
                            }
                        },
                        {
                            "text": "Ancient fortifications often featured a <w>mural</w> crown as a symbol of defense.",
                            "target_lang_translations": {
                                "de": "Antike Befestigungsanlagen trugen oft eine <w>Mauer</w>krone als Symbol der Verteidigung."
                            }
                        }
                    ],
                    "synonyms": [
                        "parietal"
                    ],
                    "common_phrases": [
                        "mural decoration"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Wand betreffend; an, auf oder gegen eine Wand gerichtet."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "wandartig",
                                "target_lang_sense_clarification": "in Bezug auf die Eigenschaft einer Wand"
                            },
                            {
                                "target_lang_word": "Wand-",
                                "target_lang_sense_clarification": "als Präfix in Zusammensetzungen, z.B. Wanddekoration"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5361c17f-8808-30cd-9ed0-ca889b7b36c5",
                    "sense_definition": "Resembling a wall; perpendicular or steep.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The climbers faced a <w>mural</w> cliff that seemed impossible to scale.",
                            "target_lang_translations": {
                                "de": "Die Kletterer standen vor einer <w>steil abfallenden</w> Klippe, die unbezwingbar schien."
                            }
                        },
                        {
                            "text": "The mountain rose in a <w>mural</w> precipice above the valley floor.",
                            "target_lang_translations": {
                                "de": "Der Berg erhob sich als <w>senkrechter</w> Abgrund über dem Talboden."
                            }
                        }
                    ],
                    "synonyms": [
                        "steep",
                        "perpendicular",
                        "vertical"
                    ],
                    "antonyms": [
                        "sloping"
                    ],
                    "common_phrases": [
                        "mural precipice"
                    ],
                    "target_lang_definitions": {
                        "de": "Einer Wand ähnelnd; senkrecht oder steil abfallend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "steil",
                                "target_lang_sense_clarification": "von großer Neigung"
                            },
                            {
                                "target_lang_word": "senkrecht",
                                "target_lang_sense_clarification": "vertikal verlaufend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32b38595-293a-3ab9-b6a9-e30f93dd2016",
                    "sense_definition": "To create a mural.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The community gathered to <w>mural</w> the old school building during the summer festival.",
                            "target_lang_translations": {
                                "de": "Die Gemeinde versammelte sich während des Sommerfestes, um das alte Schulgebäude <w>mit einem Wandgemälde zu versehen</w>."
                            }
                        },
                        {
                            "text": "Local students were invited to <w>mural</w> the hallway with scenes from history.",
                            "target_lang_translations": {
                                "de": "Lokale Schüler wurden eingeladen, den Flur <w>mit Wandgemälden</w> historischer Szenen zu gestalten."
                            }
                        }
                    ],
                    "synonyms": [
                        "paint"
                    ],
                    "common_phrases": [
                        "mural a wall"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Wandgemälde erstellen oder eine Wand mit einem solchen verzieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "mit einem Wandgemälde versehen",
                                "target_lang_sense_clarification": "eine Wand künstlerisch gestalten"
                            },
                            {
                                "target_lang_word": "bemalen",
                                "target_lang_sense_clarification": "allgemein eine Fläche mit Farbe gestalten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}