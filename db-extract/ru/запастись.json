                        "cross_references": [
                            {
                                "target_word": "faire le plein",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9c6bcc9-c832-3f97-ab4d-6085eba75761",
                                        "entry_id": "476578ca-5f59-348d-940f-33524686d85f",
                                        "glosses": [
                                            "Remplir un réservoir (le plus souvent le carburant d’un véhicule)."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25077100-93bc-4af7-b524-75b96d98c0f4",
                                                "sense_id": "e9c6bcc9-c832-3f97-ab4d-6085eba75761",
                                                "text": "En début de mois, les gens font toujours le plein sans réfléchir. Là, beaucoup serrent les dents, ne dépassent pas des montants ronds, 30, 40 ou 50, comme pour tenir leur budget, comme si c’était déjà la fin du mois."
                                            },
                                            {
                                                "example_id": "d6487e3d-aa9a-4673-9c3b-d5a7b9810c77",
                                                "sense_id": "e9c6bcc9-c832-3f97-ab4d-6085eba75761",
                                                "text": "Rynner voudrait bien voir revenir le second camion-citerne qui est parti, voilà déjà déjà un bon moment, pour faire le plein au riachuelo voisin."
                                            },
                                            {
                                                "example_id": "3bfdaf95-5af8-4911-8ecf-57b37365435c",
                                                "sense_id": "e9c6bcc9-c832-3f97-ab4d-6085eba75761",
                                                "text": "Quand des Alsaciens ou des Mosellans se précipitaient dans le Bade-Wurtemberg, la Sarre ou la Rhénanie-Palatinat pour faire le plein, chercher du tabac ou acheter des produits d’hygiène…"
                                            },
                                            {
                                                "example_id": "bacab979-8bc1-4ab6-9808-f8b8ad738f73",
                                                "sense_id": "e9c6bcc9-c832-3f97-ab4d-6085eba75761",
                                                "text": "Si la foudre tombe sur une voiture électrique, est-ce que ça fait le plein?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56296d82-207b-3991-8ec3-6029146a8b29",
                                        "entry_id": "476578ca-5f59-348d-940f-33524686d85f",
                                        "glosses": [
                                            "Acheter de la nourriture ou une autre denrée, en grande quantité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63868f30-c47d-4165-9550-0e3d11a44f2b",
                                                "sense_id": "56296d82-207b-3991-8ec3-6029146a8b29",
                                                "text": "Il a fait le plein de bière et de cigarettes pour la soirée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5630c5d7-becd-385d-b6e5-0e1058ff8d70",
                                        "entry_id": "476578ca-5f59-348d-940f-33524686d85f",
                                        "glosses": [
                                            "Remplir une salle de spectacle, ce qui prouve son succès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4d5f265-3e71-4700-8823-055a59a8e046",
                                                "sense_id": "5630c5d7-becd-385d-b6e5-0e1058ff8d70",
                                                "text": "A la première Toussaint, les chers défunts font toujours le plein. Ensuite, le temps fait son boulot."
                                            },
                                            {
                                                "example_id": "ca0d4747-7e52-4179-94b3-fbec293afc2e",
                                                "sense_id": "5630c5d7-becd-385d-b6e5-0e1058ff8d70",
                                                "text": "En ce deuxième dimanche d’août, la rue principale d’Auvers-sur-Oise (Val-d’Oise) est inhabituellement calme. Sous le ciel menaçant, les terrasses des restaurants peinent à faire le plein. Les touristes, qui se pressent d’ordinaire par milliers pour découvrir le village où vécut Vincent Van Gogh, ne sont pas encore revenus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
