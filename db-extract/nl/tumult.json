                                                "sense_id": "45f11b13-324b-33cf-b9f0-6c519f40fc75",
                                                "text": "During a storm the sea is in agitation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6df8b746-a391-3ad4-8c62-ed9fbd8e4055",
                                        "entry_id": "083d7cf7-aa3e-3237-a4dc-34652faed907",
                                        "glosses": [
                                            "A disturbance of personal tranquillity; disturbance of someone's peace of mind."
