                {
                    "sense_id": "777ddb13-6a56-311f-b56a-823b27e130b0",
                    "sense_definition": "een kleine hoeveelheid vloeistof in een ronde of peerachtige vorm",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vloeistof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er viel een grote <w>druppel</w> regen op mijn voorhoofd.",
                            "target_lang_translations": {
                                "en": "A large <w>drop</w> of rain fell on my forehead.",
                                "ru": "Большая дождевая <w>капля</w> упала мне на лоб."
                            }
                        },
                        {
                            "text": "Je moet elke ochtend een <w>druppel</w> olie in de machine doen.",
                            "target_lang_translations": {
                                "en": "You must put a <w>drop</w> of oil into the machine every morning.",
                                "ru": "Каждое утро нужно добавлять в машину по <w>капле</w> масла."
                            }
                        }
                    ],
                    "synonyms": [
                        "droppel"
                    ],
                    "common_phrases": [
                        "een druppel water",
                        "laatste druppel",
                        "druppel op een gloeiende plaat"
                    ],
                    "target_lang_definitions": {
                        "en": "a small amount of liquid in a round or pear-like shape",
                        "ru": "небольшое количество жидкости округлой или грушевидной формы"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drop",
