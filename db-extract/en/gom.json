    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a711ad21-8de0-38e6-8959-7f1e3d464703",
                "word": "gom",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c0501012-f842-3acb-a79c-14bdd67ac4c5",
                        "entry_id": "a711ad21-8de0-38e6-8959-7f1e3d464703",
                        "glosses": [
                            "God!"
                        ],
                        "tags": [
                            "euphemistic",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1ca32f61-945f-4710-860f-2536abdb75c7",
                                "sense_id": "c0501012-f842-3acb-a79c-14bdd67ac4c5",
                                "text": "Robert took courage : \"Eh, by gom, no. It wasn't hereabouts.\""
                            },
                            {
                                "example_id": "e546b007-69e9-422a-a328-d82aa8ae2fcd",
                                "sense_id": "c0501012-f842-3acb-a79c-14bdd67ac4c5",
                                "text": "O dang it, Roger, did 'e ever see sich a sight afore? My gom! what a glorious lumination like! My goles! what a mort of gentry-folk!"
                            },
                            {
                                "example_id": "0f98f3dc-df39-4204-9a2f-dd039938a522",
                                "sense_id": "c0501012-f842-3acb-a79c-14bdd67ac4c5",
                                "text": "\"l'll drink as much cider as you 'plase, but by gom, sir, you munna come here to bork the trees over again.\""
                            },
                            {
                                "example_id": "7670303f-a8a5-4e6d-a287-212d2e233d03",
                                "sense_id": "c0501012-f842-3acb-a79c-14bdd67ac4c5",
                                "text": "There's a Lad, too, from York— but tho' he's a strange elf, / By gom! I respect him as much as myself,"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "9b29a11a-1174-3112-b1be-916eec44aea0",
                "word": "gom",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bf58a99f-9df7-4198-862f-e6b3627ce36c",
                        "entry_id": "9b29a11a-1174-3112-b1be-916eec44aea0",
                        "tags": [
                            "plural"
                        ],
                        "form": "goms"
