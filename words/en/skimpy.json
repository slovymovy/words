                            {
                                "target_lang_word": "sporý",
                                "target_lang_sense_clarification": "používá se pro oblečení, které zakrývá jen málo"
                            },
                            {
                                "target_lang_word": "odhalující",
                                "target_lang_sense_clarification": "přímo popisuje oblečení, které hodně ukazuje"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bbfd486-1fa4-3d7b-8672-dc1adb25bc2a",
                    "sense_definition": "Describing a person who is wearing very little clothing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "revealing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>skimpy</w> dancers performed on the stage.",
                            "target_lang_translations": {
                                "cs": "Na pódiu vystupovaly <w>spoře oděné</w> tanečnice."
                            }
                        },
                        {
                            "text": "He felt uncomfortable around the <w>skimpy</w> guests at the pool party.",
                            "target_lang_translations": {
                                "cs": "Cítil se nesvůj mezi <w>spoře oděnými</w> hosty na bazénové párty."
                            }
                        }
                    ],
                    "synonyms": [
                        "scantily-clad"
                    ],
                    "target_lang_definitions": {
                        "cs": "Popisuje osobu, která má na sobě velmi málo oblečení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "spoře oděný",
                                "target_lang_sense_clarification": "popisuje osobu s minimem oblečení"
