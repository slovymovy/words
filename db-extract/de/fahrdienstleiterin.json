                "senses": [
                    {
                        "sense_id": "ef709977-2818-3f48-8db9-359e85f79a7f",
                        "entry_id": "cd244922-1d90-3afa-bc6b-978db17371a4",
                        "glosses": [
                            "Mitarbeiterin eines Eisenbahninfrastrukturunternehmens, der in einem bestimmten Bereich eigenverantwortlich die Zulassung der Zugfahrten obliegt"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "82c8aea6-d420-4c91-a361-6893cf63d452",
                                "sense_id": "ef709977-2818-3f48-8db9-359e85f79a7f",
                                "text": "Die Fahrdienstleiterin übergab dem Triebfahrzeugführer seine Befehle."
                            },
                            {
                                "example_id": "6c3ac8fd-56ea-4e0d-9f12-b9524fea2bfa",
                                "sense_id": "ef709977-2818-3f48-8db9-359e85f79a7f",
                                "text": "„Nun wird geprüft, ob die Fahrdienstleiterin wegen möglicher falscher Anweisungen eine Mitschuld an dem schweren Zugunglück mit acht Toten trägt.“"
                            },
                            {
                                "example_id": "e11376b4-f45d-4053-9170-7a267197df2c",
                                "sense_id": "ef709977-2818-3f48-8db9-359e85f79a7f",
                                "text": "„Die zuständige Fahrdienstleiterin hat im Prozess um das Zugunglück von Brühl Mängel und Widersprüche im Sicherheitssystem der Bahn offenbart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
