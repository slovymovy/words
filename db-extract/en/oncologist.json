                                                "sense_id": "c99f48b4-56fe-3d82-97f6-18d34d558e83",
                                                "text": "\"Gerade als ich genug Mut zusammengekratzt hatte, um mir eine Schwangerschaft vorstellen zu können, sah ich im Wartezimmer meiner Onkologin ein kleines Mädchen, das ein rosarotes Stoffhäschen in der Hand hielt.\""
                                            },
                                            {
                                                "example_id": "67e3b6df-8dad-4703-a157-c6259e459088",
                                                "sense_id": "c99f48b4-56fe-3d82-97f6-18d34d558e83",
                                                "text": "\"Aufgrund der Aggressivität des Krebses wurde seitens der Onkologin eine Chemotherapie empfohlen.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
