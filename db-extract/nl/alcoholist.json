                "forms": [
                    {
                        "form_id": "899b094a-791c-4302-b0d0-f1e842f10aba",
                        "entry_id": "86744556-09d2-36d7-b6c7-ce478a5687ac",
                        "tags": [
                            "plural"
                        ],
                        "form": "alcoholisten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f56ddf2a-d68c-3a20-8629-3ca6c727a619",
                        "entry_id": "86744556-09d2-36d7-b6c7-ce478a5687ac",
                        "glosses": [
                            "iemand die lijdt onder een verslaving aan ethanol"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33694a6e-685b-49c0-bd2a-c6abb84c5ea2",
                                "sense_id": "f56ddf2a-d68c-3a20-8629-3ca6c727a619",
                                "text": "Hij was een alcoholist, maar hij wist zich de rest van zijn leven nuchter te houden."
                            },
                            {
                                "example_id": "7382d6cf-dc93-4318-8485-825db5ff16bb",
                                "sense_id": "f56ddf2a-d68c-3a20-8629-3ca6c727a619",
                                "text": "Als ik niet beter zou weten, dan schaarde ik je bij de club van stiekeme sherryhappers. ’Ze scharrelde wat met haar hand tussen de vleeswaren. ‘Van die eenzame alcoholisten, weet je wel. ’Chantal grinnikte."
                            },
                            {
                                "example_id": "43794649-abde-4dca-8997-ba61060c743a",
                                "sense_id": "f56ddf2a-d68c-3a20-8629-3ca6c727a619",
                                "text": "Hij verstopt cash zoals een alcoholist flessen wodka."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6440e2b4-6e9c-4a54-8f70-cc0a6d1e08c7",
                        "source_entry_id": "86744556-09d2-36d7-b6c7-ce478a5687ac",
                        "source_sense_id": "f56ddf2a-d68c-3a20-8629-3ca6c727a619",
                        "target_lang_word": "Alkoholiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alkoholiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35b7afb7-233f-36e1-8886-f65aae793126",
                                        "entry_id": "83b39583-c778-335c-9790-4a55c18add82",
                                        "glosses": [
                                            "jemand, der auf regelmäßigen Alkoholgenuss angewiesen und von Alkohol abhängig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "288f1d96-10c9-43f5-86fe-273ffc6997e2",
                                                "sense_id": "35b7afb7-233f-36e1-8886-f65aae793126",
                                                "text": "Hast du schon gehört? Dieser Gregor ist anscheinend Alkoholiker!"
                                            },
                                            {
                                                "example_id": "c7572ab3-d9a3-43b5-aae5-2a148c462d4e",
                                                "sense_id": "35b7afb7-233f-36e1-8886-f65aae793126",
                                                "text": "„Im Augenblick schienen ihre Liebesängste und -begierden denen eines Süchtigen zu gleichen, eines Alkoholikers, eines Spielers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fd2ff84-b43a-4892-9519-d9dfe4363815",
                        "source_entry_id": "86744556-09d2-36d7-b6c7-ce478a5687ac",
                        "source_sense_id": "f56ddf2a-d68c-3a20-8629-3ca6c727a619",
                        "target_lang_word": "alcoholic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcoholic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0b353ed-9c5d-330d-a0e8-b136cb5ed28e",
                                        "entry_id": "b8609848-a226-3d46-a6d7-947c13bc8409",
                                        "glosses": [
                                            "A person who is addicted to alcohol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce621017-0ea0-4a11-ba73-24f665071ef7",
                                                "sense_id": "a0b353ed-9c5d-330d-a0e8-b136cb5ed28e",
                                                "text": "Don't you know you've got your daddy's eyes\n Daddy was an alcoholic"
                                            },
                                            {
                                                "example_id": "9e420bf9-3d40-42bb-9b82-9a4b9b5082ae",
                                                "sense_id": "a0b353ed-9c5d-330d-a0e8-b136cb5ed28e",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic who still resists the idea that something drastic needs to happen for him to turn his life around."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81b745d8-8db6-3110-b84c-2f967e497a19",
                                        "entry_id": "b8609848-a226-3d46-a6d7-947c13bc8409",
                                        "glosses": [
                                            "One who abuses alcohol."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "alcoholic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "029d247a-930d-3e59-b1cb-5b71d94baffa",
                                        "entry_id": "2b73471d-57fc-3074-bd79-71eed9566ac9",
                                        "glosses": [
                                            "Of or pertaining to alcohol."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "947d5a48-88a2-322e-9ee6-4abf606f5836",
                                        "entry_id": "2b73471d-57fc-3074-bd79-71eed9566ac9",
                                        "glosses": [
                                            "Having more than a trace amount of alcohol in its contents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f795ac5-a394-49f8-bae4-eb99b7f156c4",
                                                "sense_id": "947d5a48-88a2-322e-9ee6-4abf606f5836",
                                                "text": "He ordered an alcoholic beverage."
                                            },
                                            {
                                                "example_id": "57cea307-8e8b-4e0f-8abd-c069e3a5d4e2",
                                                "sense_id": "947d5a48-88a2-322e-9ee6-4abf606f5836",
                                                "text": "The oysters were sour, and excessively alcoholic."
                                            },
                                            {
                                                "example_id": "4c6c7850-4e51-4296-bfed-10e6fb65b236",
                                                "sense_id": "947d5a48-88a2-322e-9ee6-4abf606f5836",
                                                "text": "A statement from the official Lao News Agency (KPL) Friday reported that “the consumption of tainted alcoholic beverages” was the suspected cause of the deaths."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52cfe304-2a28-3a97-9a8d-25fedd52459d",
                                        "entry_id": "2b73471d-57fc-3074-bd79-71eed9566ac9",
                                        "glosses": [
                                            "Of, pertaining to, or affected by alcoholism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90c0e8ca-b5e4-469b-9063-5ab2c9074eb5",
                        "source_entry_id": "86744556-09d2-36d7-b6c7-ce478a5687ac",
                        "source_sense_id": "f56ddf2a-d68c-3a20-8629-3ca6c727a619",
                        "target_lang_word": "alcoolique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcoolique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f309b917-f5ab-3c7e-87e0-ea8a7891e75a",
                                        "entry_id": "a9cbf803-2e8a-3235-b4c6-9484e24f8f6f",
                                        "glosses": [
                                            "Qui contient de l’alcool."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c4d6913-4766-446c-8889-870bdd3747d2",
                                                "sense_id": "f309b917-f5ab-3c7e-87e0-ea8a7891e75a",
                                                "text": "[…] il allait procéder à la confection du punch. […]. Il n’y avait plus qu’à enflammer ce lac alcoolique, et le caporal, la mèche allumée, attendait l’ordre de son capitaine, comme s’il se fût agi de mettre le feu à une mine."
                                            },
                                            {
                                                "example_id": "4b26bc10-64c7-4bc4-9542-4ff1ca4ffdb7",
                                                "sense_id": "f309b917-f5ab-3c7e-87e0-ea8a7891e75a",
                                                "text": "L’essai d’un alcool doit porter tout d’abord sur le degré alcoolique qui est déterminé au moyen de l’alcoomètre de Gay-Lussac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f454b7f-8595-311a-a8d9-74cb1c4dafd5",
                                        "entry_id": "a9cbf803-2e8a-3235-b4c6-9484e24f8f6f",
                                        "glosses": [
                                            "Relatif à l’alcool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "babbc2d2-023a-43d8-b65c-b2a355bf68c8",
                                                "sense_id": "4f454b7f-8595-311a-a8d9-74cb1c4dafd5",
                                                "text": "Autre différence, la respiration ne produit aucun résidu organique, alors que la fermentation produit de l’alcool ou de l’éthanol (fermentation alcoolique) ou de l’acide lactique (fermentation lactique)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "282fcecb-b831-3842-b912-4bbfdc9fd760",
                                        "entry_id": "a9cbf803-2e8a-3235-b4c6-9484e24f8f6f",
                                        "glosses": [
                                            "Qui fait abus des boissons alcoolisées."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f045e562-a984-4c84-bfd0-b5c65b7baa17",
                                                "sense_id": "282fcecb-b831-3842-b912-4bbfdc9fd760",
                                                "text": "Je m’instruis de mon mieux aux dissertations philologiques de Jacques Boulenger, d’André Thérive et des savants alcooliques du Grammaire Club."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68396339-d535-3799-8843-73c256b69e4c",
                                        "entry_id": "a9cbf803-2e8a-3235-b4c6-9484e24f8f6f",
                                        "glosses": [
                                            "Qui est dû à l’alcool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16be6a64-a0a4-48fe-8bda-2e43893ca113",
                                                "sense_id": "68396339-d535-3799-8843-73c256b69e4c",
                                                "text": "Le conducteur présumé du véhicule lors des faits, un homme de 46 ans, a été mis en examen pour assassinat, délit de fuite et conduite en état alcoolique en récidive légale. Son casier judiciaire porte la mention de 13 condamnations, la plus récente pour récidive de conduite en état alcoolique en mars 2019."
                                            },
                                            {
                                                "example_id": "41b99dc4-b65e-45d9-98d2-bd1fc06c6299",
                                                "sense_id": "68396339-d535-3799-8843-73c256b69e4c",
                                                "text": "[…] ; le petit verre de vin blanc ingéré le matin à jeun pour tuer le ver finit par tuer le buveur de gastrite alcoolique ou de cirrhose hépatique ou bien par déterminer une diminution de la nutrition favorable à l'envahissement de l’organisme par la tuberculose."
                                            },
                                            {
                                                "example_id": "45239d77-26b3-4237-b96d-fb1243f2f8cf",
                                                "sense_id": "68396339-d535-3799-8843-73c256b69e4c",
                                                "text": "L’ivresse alcoolique est une expérience qui fait de l’ivrogne un poète et du soulographe un génie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "alcoolique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bd932a2-c648-327d-b4fa-c03887f4df2f",
                                        "entry_id": "02fc17d3-539a-3d80-a5bf-df93ed657c43",
                                        "glosses": [
                                            "Personne qui fait abus de l’alcool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2e17720-6915-47bf-b967-ff69e8e0a314",
                                                "sense_id": "1bd932a2-c648-327d-b4fa-c03887f4df2f",
                                                "text": "En Allemagne, en France, et même dans l’Angleterre victorienne, la montée de l’autoritarisme familial produit des schizophrènes, des suicidés, des alcooliques. L'éducation devient persécution."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
