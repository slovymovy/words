                        "cross_references": [
                            {
                                "target_word": "superficiellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6350995d-5593-3e55-9fdf-c4ce3db23f42",
                                        "entry_id": "45e4ea3d-3502-309a-82b5-50d6dd67918a",
                                        "glosses": [
                                            "En superficie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2df82a15-c75a-43ef-b0c1-dc7ce37f921d",
                                                "sense_id": "6350995d-5593-3e55-9fdf-c4ce3db23f42",
                                                "text": "Ce champ contient mille mètres superficiellement, c’est-à-dire 1000 mètres carrés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dbc6a9b-f8b7-37e0-9efb-d173389e9997",
                                        "entry_id": "45e4ea3d-3502-309a-82b5-50d6dd67918a",
                                        "glosses": [
                                            "D’une manière superficielle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d714ab57-03fa-4e0d-9ad0-42095cc71300",
                                                "sense_id": "7dbc6a9b-f8b7-37e0-9efb-d173389e9997",
                                                "text": "Libre d’agir à sa guise, loin de tout contrôle, il sauvait seulement les apparences en émiant superficiellement son humus, sans guère se soucier des fondations — pour ce qu’il aurait à y planter !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d161d7d-5afd-3b40-ad29-d5ba56981921",
                                        "entry_id": "45e4ea3d-3502-309a-82b5-50d6dd67918a",
                                        "glosses": [
                                            "D’une manière superficielle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99568766-8c38-45bf-9d40-2e8a22633e45",
                                                "sense_id": "2d161d7d-5afd-3b40-ad29-d5ba56981921",
                                                "text": "J'ai dit que vous aviez lu superficiellement les petites lettres [les Provinciales] ; je m’en repens ; elles sont belles et trop dignes de vous pour avoir douté que vous ne les eussiez toutes lues avec application,"
                                            },
                                            {
                                                "example_id": "7ebb645d-94c1-470d-a292-bbaea6beb128",
                                                "sense_id": "2d161d7d-5afd-3b40-ad29-d5ba56981921",
                                                "text": "Si vous pensez que ces paroles passent superficiellement dans mon cœur, vous vous trompez ; je les sens vivement, elles s'y établissent,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc8701f1-cae7-43fc-86fd-ec87e42b3881",
                        "source_entry_id": "35b220fd-480f-3570-aaea-b9c9d2509512",
                        "source_sense_id": "a0b3a4d5-9801-3638-98b7-f8f504e08bad",
