                "senses": [
                    {
                        "sense_id": "c0484fa8-b0c5-3344-a172-98f6b0dcaeb4",
                        "entry_id": "e416395b-d4b1-3c62-8559-4a8a0a8855ce",
                        "glosses": [
                            "женск. к партизан"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5b7c4b1-4856-4533-8624-bfd3d94a475d",
                                "sense_id": "c0484fa8-b0c5-3344-a172-98f6b0dcaeb4",
                                "text": "Вот уже полгода моя машинка упорно молчит, как партизанка."
                            },
                            {
                                "example_id": "acd07525-2986-4c28-a5e6-d28d84255222",
                                "sense_id": "c0484fa8-b0c5-3344-a172-98f6b0dcaeb4",
                                "text": "Я не думаю, что нас кто-то видел вдвоем, но все-таки… Молчи, как партизанка. ― Партизанок фашисты, кажется, насиловали?"
                            }
                        ]
                    }
                ],
