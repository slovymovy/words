        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "15768eca-19d6-3664-8d3d-270f99d2f005",
                "word": "Scylla",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ec1366bb-d8f6-374e-8bd3-ffc4b30a7753",
                        "entry_id": "15768eca-19d6-3664-8d3d-270f99d2f005",
                        "glosses": [
                            "A dangerous rock on the Italian coast opposite the whirlpool Charybdis on the coast of Sicily. The passage between Scylla and Charybdis was formerly considered perilous; hence, the saying between Scylla and Charybdis signifies a great peril on either hand."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0ca573a-01ca-4f88-9c87-f0a3744f5eb0",
                                "sense_id": "ec1366bb-d8f6-374e-8bd3-ffc4b30a7753",
                                "text": "I have never yet been able to steer my lovers through the Scylla of presence, or the Charybdis of absence."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d714c9b-9d10-36b2-b4a5-cfb37ee5245f",
                        "entry_id": "15768eca-19d6-3664-8d3d-270f99d2f005",
                        "glosses": [
                            "A personification of said rock as a ravenous monster."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "587cbb47-f853-3be6-b631-9a58cd3a722f",
                        "entry_id": "15768eca-19d6-3664-8d3d-270f99d2f005",
                        "glosses": [
                            "A princess, daughter of King Nisos of Megara, who fell in love with King Minos and betrayed her city to him."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "c2dbf940-e805-4b4e-847a-98f1dd98fb8c",
                                "sense_id": "587cbb47-f853-3be6-b631-9a58cd3a722f",
                                "text": "Ah cease rash Youth! desist e'er 'tis too late, / Fear the just Gods, and think of Scylla′s Fate!"
                            }
                        ]
                    },
                    {
                        "sense_id": "da55f185-9d3a-38b5-aa52-87950e11d97b",
                        "entry_id": "15768eca-19d6-3664-8d3d-270f99d2f005",
                        "glosses": [
                            "The main belt asteroid 155 Scylla."
                        ],
                        "tags": [],
                        "examples": []
                    }
