                "forms": [],
                "senses": [
                    {
                        "sense_id": "acc03b73-82e9-3040-ac44-9b609420ff20",
                        "entry_id": "dd09718b-38d1-3d95-b400-2215134040da",
                        "glosses": [
                            "op dit moment"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5335361a-0cb2-4429-a434-26deb68cfe77",
                                "sense_id": "acc03b73-82e9-3040-ac44-9b609420ff20",
                                "text": "Momenteel ben ik een artikel aan het bewerken."
                            },
                            {
                                "example_id": "295303e0-75e6-4633-b4d2-ffc01c5ccce6",
                                "sense_id": "acc03b73-82e9-3040-ac44-9b609420ff20",
                                "text": "Ik gris een pen van het formicatafeltje en krabbel op de achterkant van de enveloppe: Beste yoni van Bibi, Ik ben momenteel buiten gebruik."
                            },
                            {
                                "example_id": "540013a2-23a6-494f-bc19-cd26de43f6b9",
                                "sense_id": "acc03b73-82e9-3040-ac44-9b609420ff20",
                                "text": "U ziet toch zelf wel dat Agnes momenteel niet in staat is te getuigen? Terwijl Nella al deze argumenten doorneemt, probeert ze zijn aandacht te trekken, maar Meermans kijkt niet in haar richting en staart over het hoofd van zijn vrouw naar beneden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4489adf0-f3ee-4e98-adf6-07e93fa03593",
                        "source_entry_id": "dd09718b-38d1-3d95-b400-2215134040da",
                        "source_sense_id": "acc03b73-82e9-3040-ac44-9b609420ff20",
                        "source_sense_description": "op dit moment",
                        "target_lang_word": "Moment",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moment",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de3d33cb-39fa-3048-a85a-22b251c9c5a7",
                                        "entry_id": "8c0332a2-5dc4-32b2-9454-94e84001fb83",
                                        "glosses": [
                                            "sehr kurz andauernde Zeitspanne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3306328a-aac3-47b1-981a-45d9ab8c515d",
                                                "sense_id": "de3d33cb-39fa-3048-a85a-22b251c9c5a7",
                                                "text": "Hast du einen Moment Zeit für mich?"
                                            },
                                            {
                                                "example_id": "3818f923-4c3c-496a-9268-5ca713bf4e67",
                                                "sense_id": "de3d33cb-39fa-3048-a85a-22b251c9c5a7",
                                                "text": "„Als die Ampel auf Grün schaltete, fuhr er an, als in diesem Moment die Radfahrerin von links in den PKW fuhr.“"
                                            },
                                            {
                                                "example_id": "c655b6a2-9e47-4ad6-a731-3b880d957b6b",
                                                "sense_id": "de3d33cb-39fa-3048-a85a-22b251c9c5a7",
                                                "text": "„Für einen Moment ist es still.“"
                                            },
                                            {
                                                "example_id": "92fa8a25-2f53-492d-9d78-93bd59f13822",
                                                "sense_id": "de3d33cb-39fa-3048-a85a-22b251c9c5a7",
                                                "text": "„Ich dachte einen Moment nach.“"
                                            },
                                            {
                                                "example_id": "c4cd2d16-cab3-43f1-be50-a82a5302fa21",
                                                "sense_id": "de3d33cb-39fa-3048-a85a-22b251c9c5a7",
                                                "text": "„Jeder Gleitschirmpilot und jede Pilotin kennt Momente in denen sich die Grenze zwischen positiver Aufregung und Fokussiertheit zu starken Emotionen und eingeengter Denkfähigkeit verschiebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf688602-192c-3afe-8765-4797da9532dc",
                                        "entry_id": "8c0332a2-5dc4-32b2-9454-94e84001fb83",
                                        "glosses": [
                                            "Zeitpunkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1e92370-f214-4be7-8eec-7b9c9c43e2f4",
                                                "sense_id": "bf688602-192c-3afe-8765-4797da9532dc",
                                                "text": "„Jeder Gleitschirmpilot und jede Pilotin kennt Momente in denen sich die Grenze zwischen positiver Aufregung und Fokussiertheit zu starken Emotionen und eingeengter Denkfähigkeit verschiebt.“"
                                            },
                                            {
                                                "example_id": "67c2b223-e9e1-4f04-923f-6a2ca2ddf034",
                                                "sense_id": "bf688602-192c-3afe-8765-4797da9532dc",
                                                "text": "Im selben Moment hörte er das Quietschen der Reifen."
                                            },
                                            {
                                                "example_id": "933dc361-e1fa-40db-83f7-6518f050f53f",
                                                "sense_id": "bf688602-192c-3afe-8765-4797da9532dc",
                                                "text": "„Die Stars haben sich herausgeputzt für den großen Moment: aufregende Bilder von der 79. Oscar-Verleihung.“"
                                            },
                                            {
                                                "example_id": "d875c601-4a8e-4fb3-938b-5f365e995a07",
                                                "sense_id": "bf688602-192c-3afe-8765-4797da9532dc",
                                                "text": "„Eine Sinnkrise im Alltag oder Berufsleben kann für den dynamischen Menschen und Sinnsucher ein fruchtbarer Moment, ein Auslöser sein, auf Entdeckungsreise nach Alternativen zu gehen.“"
                                            },
                                            {
                                                "example_id": "213a02e7-5c42-41be-8403-3e6bca2b1325",
                                                "sense_id": "bf688602-192c-3afe-8765-4797da9532dc",
                                                "text": "„Fast im selben Moment wurde der Champagner entkorkt, und das Knallen der Pfropfen verdoppelte die Lustigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Moment",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24810d70-a3fc-3aa0-9aa2-c84f5a5e71a4",
                                        "entry_id": "36ee5c06-4335-362d-94d9-86113de3e8b9",
                                        "glosses": [
                                            "ein Umstand oder ein Ereignis, das eine Handlung hervorruft oder entscheidend beeinflusst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8ebd488-50e2-407d-95e1-7756062648ad",
                                                "sense_id": "24810d70-a3fc-3aa0-9aa2-c84f5a5e71a4",
                                                "text": "Auslösendes Moment für alle späteren Ereignisse war der Konflikt mit …"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bd52badb-39af-38d8-a298-8e81d2e94b36",
                                        "entry_id": "36ee5c06-4335-362d-94d9-86113de3e8b9",
                                        "glosses": [
                                            "tangential um einen Kreismittelpunkt wirkende Kraft multipliziert mit der Länge des Hebelarms"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d539dde-a98e-4f65-b8eb-b7246485a719",
                                                "sense_id": "bd52badb-39af-38d8-a298-8e81d2e94b36",
                                                "text": "Die Physik kennt neben dem Drehmoment auch noch ein magnetisches Moment."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4ebcc266-47ab-3139-a8e2-14f9cc525379",
                                        "entry_id": "36ee5c06-4335-362d-94d9-86113de3e8b9",
                                        "glosses": [
                                            "charakteristische Eigenschaft einer Zufallsvariablen und deren Verteilung"
                                        ],
                                        "tags": [
                                            "Statistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4037dbd3-5ddd-464f-99fa-bd5e6a880fc4",
                                                "sense_id": "4ebcc266-47ab-3139-a8e2-14f9cc525379",
                                                "text": "Erwartungswert und Varianz gehören zu den sogenannten „zentralen Momenten“ der Statistik."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Moment",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bced1c3-c745-33d9-9530-68ee22559656",
                                        "entry_id": "ed6358be-2961-3361-b0ed-36350134e0cb",
