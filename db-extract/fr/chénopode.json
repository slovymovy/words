                "senses": [
                    {
                        "sense_id": "2285699c-56e0-3b90-bbf7-81735950ca1a",
                        "entry_id": "f083f430-010f-3d7b-9847-04fc9632e1d6",
                        "glosses": [
                            "Plantes du genre Chenopodium, de la famille des Amaranthacées (Amaranthaceae)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52d75c9f-3a2c-4b85-b256-ff253475e776",
                                "sense_id": "2285699c-56e0-3b90-bbf7-81735950ca1a",
                                "text": "Le chénopode, appelé vulgairement patte d'oie ou ansérine, doit ce nom à la disposition de ses feuilles ; l’ambrosie en est une espèce."
                            },
                            {
                                "example_id": "2873b4be-2ef3-4a13-8fa5-9d863aae2f64",
                                "sense_id": "2285699c-56e0-3b90-bbf7-81735950ca1a",
                                "text": "2. Désherbage de pré-levée. Sont préconisés : […]\n—le cycluron ou OMU, en mélange avec le BIPC (très voisin du chlorpropham) à la dose de 7 à 8l de produit (soit 0,9-1,1 kg MA/ha) ; plus actif à l’égard des ravenelles que la prométryne mais moins efficace à l’égard des chénopodes et mercuriales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5bf9155-a038-41b5-a4d2-41b6fa5d5bf0",
                        "source_entry_id": "f083f430-010f-3d7b-9847-04fc9632e1d6",
                        "source_sense_id": "2285699c-56e0-3b90-bbf7-81735950ca1a",
                        "target_lang_word": "Gänsefuß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gänsefuß",
