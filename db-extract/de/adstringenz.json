                                "example_id": "3a9faa84-3db4-479d-ac01-0ae1b73afda9",
                                "sense_id": "4893f0ae-8b91-3c73-b447-47606dcf716f",
                                "text": "„Der Oxforder Arzt John Floyer (1649–1734) schrieb 1687, dass ihn die Rinde und die Samen der Esche in ihrer Bitterkeit und Adstringenz an die Chinarinde erinnere.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
