                                    {
                                        "sense_id": "0f28fa80-ce6c-35fe-bf35-4c54e3ce0b3a",
                                        "entry_id": "8af5d74a-0bef-3858-9688-18035d185d81",
                                        "glosses": [
                                            "Happening once every year."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37c984c8-dc10-4087-825f-12d0e892d344",
                                                "sense_id": "0f28fa80-ce6c-35fe-bf35-4c54e3ce0b3a",
                                                "text": "Christmas is a yearly celebration."
                                            },
                                            {
                                                "example_id": "dd90b270-a6c0-4480-b393-649743ad98bc",
                                                "sense_id": "0f28fa80-ce6c-35fe-bf35-4c54e3ce0b3a",
                                                "text": "We deep-clean the kitchen lustrally, on a five-yearly basis."
                                            },
                                            {
                                                "example_id": "6696f052-cc76-4297-8475-bf0e4f89f3be",
                                                "sense_id": "0f28fa80-ce6c-35fe-bf35-4c54e3ce0b3a",
                                                "text": "all of these services, including mSpy, function with the same kind of predatory subscription scheme, luring you in with free trials that autorenew as abhorrently expensive monthly or yearly subscriptions. canceling the service requires reaching out to support, so users are typically unable to avoid overrunning the trial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82c3c66d-6b24-3230-97a1-6cbac254cbf9",
                                        "entry_id": "8af5d74a-0bef-3858-9688-18035d185d81",
                                        "glosses": [
                                            "Over the course of one year"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c567a9a7-0698-47dd-8910-e133ac6c8951",
                                                "sense_id": "82c3c66d-6b24-3230-97a1-6cbac254cbf9",
                                                "text": "a yearly income"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yearly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "853f7911-1977-3780-8db9-023d488c48c4",
                                        "entry_id": "585f2f10-2430-3c2c-9141-e77b2bad9aba",
                                        "glosses": [
                                            "Once a year."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dec4e8e6-846d-3dc5-9e3c-4faa2eb9928b",
                                        "entry_id": "585f2f10-2430-3c2c-9141-e77b2bad9aba",
                                        "glosses": [
                                            "Every year."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b466d465-d729-49e1-929b-496b0b9b9c3a",
                                                "sense_id": "dec4e8e6-846d-3dc5-9e3c-4faa2eb9928b",
                                                "text": "With a scanty supply of laws in Hellenic commonwealths or city states what an immense vista for an Aristotle, of that grand, complex, efficient machinery of law, turning out yearly thousands of laws and taboos for the paternalistic control and alleged welfare of the citizen!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yearly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cfbee38-0ab4-3223-877c-1450aa682ae3",
                                        "entry_id": "aa660ca4-18c9-3107-9b69-3c5132c24870",
                                        "glosses": [
                                            "Something that is published once a year."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "888e5147-3b33-4f46-950f-4a7ad3c1a139",
                        "source_entry_id": "0cacc4f5-5e5a-3e73-8c22-bc7cf7f30bf4",
                        "source_sense_id": "67a04171-cb3a-3b11-9f64-7fe698b09d08",
                        "target_lang_word": "every",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "every",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b596bd5f-62d5-3fca-8346-c17b21126c8b",
                                        "entry_id": "731a71f7-e1d1-379a-846d-a13d99afc167",
                                        "glosses": [
                                            "All of a countable group (considered individually), without exception."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47903944-9c0c-4c92-86be-279fe5125118",
                                                "sense_id": "b596bd5f-62d5-3fca-8346-c17b21126c8b",
                                                "text": "Every person in the room stood and cheered."
                                            },
                                            {
                                                "example_id": "8fa1aa24-f8e4-4dc9-8869-d24962974f17",
                                                "sense_id": "b596bd5f-62d5-3fca-8346-c17b21126c8b",
                                                "text": "She watches my every move."
                                            },
                                            {
                                                "example_id": "299213ee-6470-4ede-933f-8efb6b8b55bb",
                                                "sense_id": "b596bd5f-62d5-3fca-8346-c17b21126c8b",
                                                "text": "At half-past nine on this Saturday evening, the parlour of the Salutation Inn, High Holborn, contained most of its customary visitors.[…]In former days every tavern of repute kept such a room for its own select circle, a club, or society, of habitués, who met every evening, for a pipe and a cheerful glass."
                                            },
                                            {
                                                "example_id": "8e4b3d5d-83c1-4f2e-a0b8-55f0b999af3a",
                                                "sense_id": "b596bd5f-62d5-3fca-8346-c17b21126c8b",
                                                "text": "Here, in the transept and choir, where the service was being held, one was conscious every moment of an increasing brightness; colours glowing vividly beneath the circular chandeliers, and the rows of small lights on the choristers' desks flashed and sparkled in front of the boys' faces, deep linen collars, and red neckbands."
                                            },
                                            {
                                                "example_id": "1d2cad47-8430-47e4-8e57-a525b99c67f9",
                                                "sense_id": "b596bd5f-62d5-3fca-8346-c17b21126c8b",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63b792f4-7983-3bc0-bca3-686b991c1129",
                                        "entry_id": "731a71f7-e1d1-379a-846d-a13d99afc167",
                                        "glosses": [
                                            "Denotes equal spacing at a stated interval, or a proportion corresponding to such a spacing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdf634cc-b9f5-4c24-a07d-bb50ce411679",
                                                "sense_id": "63b792f4-7983-3bc0-bca3-686b991c1129",
                                                "text": "We stopped for refreshments every ten miles."
                                            },
                                            {
                                                "example_id": "3b0d83d0-26d5-4ea5-b625-df80badd5913",
                                                "sense_id": "63b792f4-7983-3bc0-bca3-686b991c1129",
                                                "text": "The alarm is going off every few minutes."
                                            },
                                            {
                                                "example_id": "dd74ff4b-e5fb-4afe-b2ec-20f814c5e853",
                                                "sense_id": "63b792f4-7983-3bc0-bca3-686b991c1129",
                                                "text": "Every third bead was red, and the rest were blue. The sequence was thus red, blue, blue, red, blue, blue etc."
                                            },
                                            {
                                                "example_id": "ad0b7490-c321-4115-afdd-0f594706d51d",
                                                "sense_id": "63b792f4-7983-3bc0-bca3-686b991c1129",
                                                "text": "Decimation originally meant the execution of every tenth soldier in a unit; that is, ten per cent of soldiers were killed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85b93283-237c-30bf-af2e-c3b7d8ae56ac",
                                        "entry_id": "731a71f7-e1d1-379a-846d-a13d99afc167",
                                        "glosses": [
                                            "Denotes an abundance of something."
                                        ],
                                        "tags": [
                                            "with certain nouns"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33887e7d-0df7-4a39-ae6a-a039e26fd52a",
                                                "sense_id": "85b93283-237c-30bf-af2e-c3b7d8ae56ac",
                                                "text": "We wish you every happiness in the future."
                                            },
                                            {
                                                "example_id": "27d13695-3867-4867-bcd4-7140cc48f6b6",
                                                "sense_id": "85b93283-237c-30bf-af2e-c3b7d8ae56ac",
                                                "text": "He shows every sign of becoming an excellent player. I have every confidence in him."
                                            },
                                            {
                                                "example_id": "29e80e82-f29e-4ca3-9025-bb6a651e36c2",
                                                "sense_id": "85b93283-237c-30bf-af2e-c3b7d8ae56ac",
                                                "text": "There is every reason why we shouldn't."
                                            },
                                            {
                                                "example_id": "491d8fa7-2f76-432b-bc97-d99ca965edc6",
                                                "sense_id": "85b93283-237c-30bf-af2e-c3b7d8ae56ac",
                                                "text": "The police will make every effort to trace the missing girl."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76fd98c1-7fea-4cb5-b011-1809e36afe3f",
                        "source_entry_id": "0cacc4f5-5e5a-3e73-8c22-bc7cf7f30bf4",
