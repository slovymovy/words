                        "source_entry_id": "64db7f37-2bf6-3be4-ad5e-171703fbc83a",
                        "source_sense_id": "06118f13-4129-33e1-8b27-23d4554c4318",
                        "source_sense_description": "Rundfunk- und Fernsehjargon: die Fernsehserie",
