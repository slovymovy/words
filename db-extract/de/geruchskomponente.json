                "senses": [
                    {
                        "sense_id": "38ccb047-a53d-3a11-85ce-12fa80c87b8e",
                        "entry_id": "fedbd594-e8c3-3d66-8716-90a6d16a7b3a",
                        "glosses": [
                            "der Geruch als Element und Bestandteil eines Ganzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d45c216-088e-4302-ae81-d99e4fd92185",
                                "sense_id": "38ccb047-a53d-3a11-85ce-12fa80c87b8e",
                                "text": "Die Aufführung von einem Theaterstück kann durch unterschiedliche Geruchskomponenten sinnlich erweitert werden."
                            },
                            {
                                "example_id": "fd40a899-8a89-4bbb-823e-c83e3d17a3c8",
                                "sense_id": "38ccb047-a53d-3a11-85ce-12fa80c87b8e",
                                "text": "„In der Parfümerie wird die Droge als Fixativ und Geruchskomponente eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d0b44f2c-62c1-35ee-8261-5133de225d06",
                        "entry_id": "fedbd594-e8c3-3d66-8716-90a6d16a7b3a",
                        "glosses": [
                            "anderer Ausdruck für semantisches Merkmal, Sem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f67a1ec-de91-4680-9bdb-6cc1d0efe116",
                                "sense_id": "d0b44f2c-62c1-35ee-8261-5133de225d06",
                                "text": "„Eine weitere Geruchskomponente auf der Fährte ist der Individualgeruch des Menschen, der die Fährte gelegt hat.“"
                            },
                            {
                                "example_id": "a592f704-f9e0-41a4-9476-f754ae6793a3",
                                "sense_id": "d0b44f2c-62c1-35ee-8261-5133de225d06",
                                "text": "Der vermeintliche \"Armeleutegeruch\" ist eine abwertende Charakterbeschreibung und weniger eine Geruchskomponente; wobei es auch erbärmliche Gestalten in den Gassen gibt, auf die es wahrnehmbar zutrifft."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
