                                        ]
                                    },
                                    {
                                        "sense_id": "1eb521c1-5083-3e09-ab79-2fc3da81a4c9",
                                        "entry_id": "ced26091-ed35-3199-ae3c-e71582a33dbf",
                                        "glosses": [
                                            "La maladie elle-même."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "168c6793-44cf-4102-ba62-e793830e9163",
                                                "sense_id": "1eb521c1-5083-3e09-ab79-2fc3da81a4c9",
                                                "text": "Il est important d’éliminer une pathologie grave en cas de douleur d’apparition brutale."
                                            },
                                            {
                                                "example_id": "9ce066bf-fe60-4ec7-90ea-da4cbb182394",
                                                "sense_id": "1eb521c1-5083-3e09-ab79-2fc3da81a4c9",
                                                "text": "Cela a engendré confusions, conflits et souffrances intrapsychiques, somatisations, pathologies comme l’anorexie ou la frigidité."
                                            },
                                            {
                                                "example_id": "9c4c64ce-3d15-49b8-b6b0-f26958fa5901",
                                                "sense_id": "1eb521c1-5083-3e09-ab79-2fc3da81a4c9",
                                                "text": "Il s’agit donc de repérer et de diagnostiquer le plus tôt possible ce TCA, notamment chez les personnes les plus vulnérables (adolescentes, jeunes femmes, mannequins, danseurs, sportifs et sujets atteints de pathologies impliquant des régimes, telles que le diabète de type 1, l’hypercholestérolémie familiale, etc)."
                                            }
                                        ]
                                    }
                                ]
                            }
