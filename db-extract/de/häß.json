                    },
                    {
                        "sense_id": "dcd5e0a9-fa7f-3f1b-8b9b-f9f94d19472c",
                        "entry_id": "634c4d3a-56af-3d9c-a29e-5d674c5531b5",
                        "glosses": [
                            "Fastnachts-Kostüm, die traditionelle Verkleidung der Narren in der schwäbisch-alemannischen Fastnacht"
                        ],
                        "tags": [
                            "Alemannic",
                            "Swabian"
                        ],
                        "examples": [
