                        "glosses": [
                            "Tasser avec une ploutreuse (un genre de herse)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68703fea-b2aa-4957-806f-f51379d93550",
                                "sense_id": "715e53e5-9a74-30ba-9d10-453d89efa19b",
                                "text": "Après une petite pluie, il ne faut pas oublier, dans le courant du mois, de ploutrer les vesces, afin de les rechausser et d'y conserver l'humidité;"
                            },
                            {
                                "example_id": "485922ab-8212-4c2d-844b-aea7905e7853",
                                "sense_id": "715e53e5-9a74-30ba-9d10-453d89efa19b",
                                "text": "Plusieurs cultivateurs se bornent à ploutrer leur blé ou à y faire passer le râteau."
                            }
                        ]
                    }
