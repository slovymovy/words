{
    "word_family": [
        "politely",
        "politeness",
        "impolite",
        "impoliteness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8abfeac8-bcea-3f14-945f-5f2c8074ee5d",
                    "sense_definition": "Having or showing behavior that is respectful and considerate of other people.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important to be <w>polite</w> when speaking to strangers.",
                            "target_lang_translations": {
                                "ru": "Важно быть <w>вежливым</w> при разговоре с незнакомцами.",
                                "de": "Es ist wichtig, <w>höflich</w> zu sein, wenn man mit Fremden spricht."
                            }
                        },
                        {
                            "text": "She gave a <w>polite</w> refusal to the invitation because she was busy.",
                            "target_lang_translations": {
                                "ru": "Она ответила <w>вежливым</w> отказом на приглашение, так как была занята.",
                                "de": "Sie gab eine <w>höfliche</w> Absage auf die Einladung, weil sie beschäftigt war."
                            }
                        }
                    ],
                    "synonyms": [
                        "courteous",
                        "well-mannered",
                        "civil",
                        "mannerly",
                        "civilized",
                        "respectful"
                    ],
                    "antonyms": [
                        "rude",
                        "impolite",
                        "bad-mannered",
                        "ill-mannered"
                    ],
                    "common_phrases": [
                        "be polite",
                        "polite conversation",
                        "polite smile",
                        "polite refusal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий уважение и внимание к другим людям; воспитанный.",
                        "de": "Sich respektvoll und rücksichtsvoll gegenüber anderen verhaltend; gut erzogen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вежливый",
                                "target_lang_sense_clarification": "соблюдающий правила приличия"
                            },
                            {
                                "target_lang_word": "учтивый",
                                "target_lang_sense_clarification": "подчеркнуто вежливый, почтительный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "höflich",
                                "target_lang_sense_clarification": "allgemein respektvolles Verhalten"
                            },
                            {
                                "target_lang_word": "zuvorkommend",
                                "target_lang_sense_clarification": "besonders aufmerksam und hilfsbereit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32e36c84-9b41-3c81-9cfc-2a8eec335997",
                    "sense_definition": "Smooth, polished, or having a burnished surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique mirror had a <w>polite</w> surface that reflected the candlelight perfectly.",
                            "target_lang_translations": {
                                "ru": "У старинного зеркала была <w>отполированная</w> поверхность, которая идеально отражала свет свечей.",
                                "de": "Der antike Spiegel hatte eine <w>glatte</w> Oberfläche, die das Kerzenlicht perfekt reflektierte."
                            }
                        },
                        {
                            "text": "He admired the <w>polite</w> finish of the marble statue.",
                            "target_lang_translations": {
                                "ru": "Он восхищался <w>гладкой</w> отделкой мраморной статуи.",
                                "de": "Er bewunderte die <w>polierte</w> Oberfläche der Marmorstatue."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "original meaning referring to physical smoothness"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Гладкий, блестящий или отполированный (устаревшее значение).",
                        "de": "Glatt, glänzend oder fein bearbeitet (veraltete Bedeutung)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отполированный",
                                "target_lang_sense_clarification": "о поверхности"
                            },
                            {
                                "target_lang_word": "гладкий",
                                "target_lang_sense_clarification": "о текстуре"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "glatt",
                                "target_lang_sense_clarification": "von der Oberflächenbeschaffenheit"
                            },
                            {
                                "target_lang_word": "poliert",
                                "target_lang_sense_clarification": "durch Bearbeitung glänzend gemacht"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4c5b56b6-4f18-30ec-b5a7-def63dd32d32",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Polite</w> has lived in this neighborhood for twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Полайт</w> живет в этом районе уже двадцать лет.",
                                "de": "Herr <w>Polite</w> lebt seit zwanzig Jahren in dieser Nachbarschaft."
                            }
                        },
                        {
                            "text": "We are looking for the records of a family named <w>Polite</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ищем записи о семье по фамилии <w>Полайт</w>.",
                                "de": "Wir suchen nach den Unterlagen einer Familie namens <w>Polite</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "de": "Ein Familienname."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Полайт",
                                "target_lang_sense_clarification": "транслитерация имени собственного"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Polite",
                                "target_lang_sense_clarification": "Eigenname"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a66ab6f-bd69-3db2-aeb1-c9c8fca7c4f1",
                    "sense_definition": "To polish, refine, or make someone civilized.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strict education was intended to <w>polite</w> the young students.",
                            "target_lang_translations": {
                                "ru": "Строгое образование предназначалось для того, чтобы <w>облагородить</w> юных студентов.",
                                "de": "Die strenge Erziehung sollte die jungen Schüler <w>kultivieren</w>."
                            }
                        },
                        {
                            "text": "They sought to <w>polite</w> their manners through constant practice.",
                            "target_lang_translations": {
                                "ru": "Они стремились <w>отшлифовать</w> свои манеры посредством постоянной практики.",
                                "de": "Sie versuchten, ihre Manieren durch ständiges Üben zu <w>verfeinern</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полировать, делать утонченным или цивилизованным (устаревшее).",
                        "de": "Polieren, verfeinern oder jemanden zivilisieren (veraltet)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облагораживать",
                                "target_lang_sense_clarification": "делать благородным, воспитывать"
                            },
                            {
                                "target_lang_word": "отшлифовывать",
                                "target_lang_sense_clarification": "улучшать манеры"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verfeinern",
                                "target_lang_sense_clarification": "im Sinne von Manieren verbessern"
                            },
                            {
                                "target_lang_word": "kultivieren",
                                "target_lang_sense_clarification": "jemanden bilden oder zivilisieren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}