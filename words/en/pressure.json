{
    "word_family": [
        "press",
        "pressurize",
        "depressurize",
        "overpressure",
        "pressurization"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7d353a7-471b-3c46-8f38-2aa476ef24bc",
                    "sense_definition": "A physical force applied to a surface by something in contact with it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should apply <w>pressure</w> to the wound to stop the bleeding.",
                            "target_lang_translations": {
                                "ru": "Вам следует прижать рану, создав <w>давление</w>, чтобы остановить кровотечение."
                            }
                        },
                        {
                            "text": "The nurse used firm <w>pressure</w> while wrapping the bandage around my arm.",
                            "target_lang_translations": {
                                "ru": "Медсестра использовала сильный <w>нажим</w>, когда накладывала повязку на мою руку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "apply pressure",
                        "firm pressure",
                        "constant pressure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая сила, прикладываемая к поверхности чем-либо, находящимся в контакте с ней."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давление",
                                "target_lang_sense_clarification": "физическое усилие"
                            },
                            {
                                "target_lang_word": "нажим",
                                "target_lang_sense_clarification": "приложение усилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07859343-86c6-30a7-98e3-2b0e0b74cbc7",
                    "sense_definition": "The use of persuasion, influence, or intimidation to make someone do something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager is putting <w>pressure</w> on the team to finish the project early.",
                            "target_lang_translations": {
                                "ru": "Менеджер оказывает <w>давление</w> на команду, чтобы закончить проект раньше срока."
                            }
                        },
                        {
                            "text": "He felt a lot of social <w>pressure</w> to conform to the group's expectations.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал сильное социальное <w>давление</w>, заставлявшее его соответствовать ожиданиям группы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "put pressure on",
                        "social pressure",
                        "peer pressure",
                        "under pressure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использование убеждения, влияния или запугивания, чтобы заставить кого-то что-то сделать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давление",
                                "target_lang_sense_clarification": "моральное или социальное"
                            },
                            {
                                "target_lang_word": "нажим",
                                "target_lang_sense_clarification": "принуждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf541a43-0206-346b-9144-d08adf2c2868",
                    "sense_definition": "The amount of force exerted per unit of area, especially by a gas or liquid.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot monitored the air <w>pressure</w> inside the cabin during the flight.",
                            "target_lang_translations": {
                                "ru": "Пилот следил за <w>давлением</w> воздуха в кабине во время полета."
                            }
                        },
                        {
                            "text": "High water <w>pressure</w> can sometimes damage old pipes in the house.",
                            "target_lang_translations": {
                                "ru": "Высокое <w>давление</w> воды иногда может повредить старые трубы в доме."
                            }
                        }
                    ],
                    "common_phrases": [
                        "air pressure",
                        "water pressure",
                        "blood pressure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Величина силы, приходящаяся на единицу площади, особенно со стороны газа или жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давление",
                                "target_lang_sense_clarification": "физическая величина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f812bd4e-854f-3d44-8cc7-dd779857f876",
                    "sense_definition": "A feeling of stress or anxiety caused by difficult situations or heavy responsibilities.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "distress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has been feeling a lot of <w>pressure</w> lately because of her upcoming exams.",
                            "target_lang_translations": {
                                "ru": "В последнее время она чувствует сильное <w>напряжение</w> из-за предстоящих экзаменов."
                            }
                        },
                        {
                            "text": "The <w>pressure</w> of work was starting to affect his health and sleep.",
                            "target_lang_translations": {
                                "ru": "<w>Давление</w> на работе начало сказываться на его здоровье и сне."
                            }
                        }
                    ],
                    "synonyms": [
                        "affliction",
                        "grievance"
                    ],
                    "common_phrases": [
                        "work pressure",
                        "feel pressure",
                        "handle pressure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство стресса или тревоги, вызванное трудными ситуациями или большой ответственностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давление",
                                "target_lang_sense_clarification": "психологическая нагрузка"
                            },
                            {
                                "target_lang_word": "напряжение",
                                "target_lang_sense_clarification": "состояние стресса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d64ce59c-0efd-3c25-b163-86b5a6fbac6f",
                    "sense_definition": "The state of being urgent or requiring immediate attention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "urgency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pressure</w> of business meant he had very little time for his family.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>напора</w> дел у него оставалось совсем мало времени на семью."
                            }
                        },
                        {
                            "text": "Due to the <w>pressure</w> of time, we had to skip the final presentation.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>нехватки</w> времени нам пришлось пропустить финальную презентацию."
                            }
                        }
                    ],
                    "synonyms": [
                        "press"
                    ],
                    "common_phrases": [
                        "pressure of business",
                        "time pressure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние срочности или необходимость немедленного внимания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давление",
                                "target_lang_sense_clarification": "нехватка времени или дел"
                            },
                            {
                                "target_lang_word": "напор",
                                "target_lang_sense_clarification": "интенсивность дел"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55977157-a531-3ff2-b8e8-3e0505a758b3",
                    "sense_definition": "A mark or character produced by a stamp or impression.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "impression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wax seal still bore the <w>pressure</w> of the king's signet ring.",
                            "target_lang_translations": {
                                "ru": "Старая восковая печать все еще хранила <w>оттиск</w> королевского перстня."
                            }
                        },
                        {
                            "text": "He studied the various <w>pressures</w> and marks left on the ancient manuscript.",
                            "target_lang_translations": {
                                "ru": "Он изучал различные <w>отпечатки</w> и следы, оставленные на древней рукописи."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts to mean an impression"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "След или знак, оставленный штампом или оттиском."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оттиск",
                                "target_lang_sense_clarification": "след от печати"
                            },
                            {
                                "target_lang_word": "отпечаток",
                                "target_lang_sense_clarification": "след надавливания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3cf2ad5-ea7c-3f5b-9351-6060c4337eb8",
                    "sense_definition": "To strongly encourage or force someone to do something they may not want to do.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not let anyone <w>pressure</w> you into buying something you do not want.",
                            "target_lang_translations": {
                                "ru": "Не позволяйте никому <w>давить</w> на вас, заставляя покупать то, что вы не хотите."
                            }
                        },
                        {
                            "text": "The salesman tried to <w>pressure</w> the couple into signing the contract immediately.",
                            "target_lang_translations": {
                                "ru": "Продавец пытался <w>заставить</w> пару немедленно подписать контракт."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pressure into",
                        "pressure someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настойчиво убеждать или заставлять кого-либо сделать то, чего они, возможно, не хотят делать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давить",
                                "target_lang_sense_clarification": "оказывать психологическое влияние"
                            },
                            {
                                "target_lang_word": "оказывать давление",
                                "target_lang_sense_clarification": "принуждать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}