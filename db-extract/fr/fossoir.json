                        "glosses": [
                            "Houe ou hoyau pour cultiver la vigne."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "c3628fc0-c034-4b15-a7f8-dc970ea4f221",
                                "sense_id": "6512704a-205a-3c78-b739-49c62bf8e969",
                                "text": "La fousserée (ou fosserée, ou fessorée), c’est la surface de vigne qui peut être fossoyée, c'est à dire travaillée avec un fossoir par un homme en une journée."
                            }
                        ]
                    },
                    {
