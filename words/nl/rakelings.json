{
    "word_family": [
        "raken",
        "rakeling"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "499f87cf-d0dc-3e95-b694-4c6cf8a04aeb",
                    "sense_definition": "Op een gevaarlijk korte afstand.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nabijheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De auto reed <w>rakelings</w> langs de fietser.",
                            "target_lang_translations": {
                                "fr": "La voiture est passée <w>en frôlant</w> le cycliste."
                            }
                        },
                        {
                            "text": "De bal vloog <w>rakelings</w> langs de paal van het doel.",
                            "target_lang_translations": {
                                "fr": "Le ballon est passé <w>en frôlant</w> le poteau du but."
                            }
                        }
                    ],
                    "synonyms": [
                        "scheerlings"
                    ],
                    "common_phrases": [
                        "rakelings langs"
                    ],
                    "target_lang_definitions": {
                        "fr": "À une distance dangereusement courte."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "de justesse",
                                "target_lang_sense_clarification": "indique une proximité extrême lors d'un événement"
                            },
                            {
                                "target_lang_word": "à un cheveu de",
                                "target_lang_sense_clarification": "expression imagée pour une distance très courte"
                            },
                            {
                                "target_lang_word": "frôlant",
                                "target_lang_sense_clarification": "participe présent utilisé pour décrire un passage très proche"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd112a6b-131b-37c4-a793-96c3834924ab",
                    "sense_definition": "Bijna rakend.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nabijheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het vliegtuig vloog <w>rakelings</w> over de bomen heen.",
                            "target_lang_translations": {
                                "fr": "L'avion a volé <w>en rasant</w> les arbres."
                            }
                        },
                        {
                            "text": "Zijn hand ging <w>rakelings</w> langs mijn gezicht.",
                            "target_lang_translations": {
                                "fr": "Sa main est passée <w>en frôlant</w> mon visage."
                            }
                        }
                    ],
                    "synonyms": [
                        "scheerlings"
                    ],
                    "target_lang_definitions": {
                        "fr": "Presque en contact avec quelque chose."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "en frôlant",
                                "target_lang_sense_clarification": "indique un mouvement qui passe très près sans toucher"
                            },
                            {
                                "target_lang_word": "rasant",
                                "target_lang_sense_clarification": "indique un passage très près d'une surface ou d'un objet"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "34a972b2-318b-34d7-88d4-f049b6fc1791",
                    "sense_definition": "Vlak langs iets gaand of bijna rakend.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nabijheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was een <w>rakelingse</w> ontsnapping aan een ongeluk.",
                            "target_lang_translations": {
                                "fr": "C'était une échappée <w>de justesse</w> à un accident."
                            }
                        },
                        {
                            "text": "De <w>rakelingse</w> passage van de boot was indrukwekkend.",
                            "target_lang_translations": {
                                "fr": "Le passage <w>frôlant</w> du bateau était impressionnant."
                            }
                        }
                    ],
                    "synonyms": [
                        "scheerlings"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui passe tout près ou qui frôle presque."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "de justesse",
                                "target_lang_sense_clarification": "utilisé pour qualifier un événement évité de peu"
                            },
                            {
                                "target_lang_word": "frôlant",
                                "target_lang_sense_clarification": "adjectif ou participe qualifiant un passage très proche"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}