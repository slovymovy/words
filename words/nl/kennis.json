                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is een goede <w>kennis</w> van mijn ouders.",
                            "target_lang_translations": {
                                "en": "He is a good <w>acquaintance</w> of my parents.",
                                "ru": "Он хороший <w>знакомый</w> моих родителей.",
                                "pl": "On jest dobrym <w>znajomym</w> moich rodziców.",
                                "de": "Er ist ein guter <w>Bekannter</w> meiner Eltern.",
                                "fr": "C'est une bonne <w>connaissance</w> de mes parents.",
