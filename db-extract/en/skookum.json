                        "entry_id": "5b930735-a510-38db-be19-0647d1ab80b1",
                        "glosses": [
                            "Big, strong, durable, reliable, trustworthy, doughty."
                        ],
                        "tags": [
                            "British-Columbia",
                            "Northwestern",
