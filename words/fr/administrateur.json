                    ],
                    "synonyms": [
                        "haut fonctionnaire"
                    ],
                    "common_phrases": [
                        "administrateur civil",
                        "administrateur d'État"
                    ]
                },
                {
                    "sense_id": "9fb2f834-c52d-3ec6-94df-5874925177bc",
                    "sense_definition": "Personne qui fait preuve d'un talent remarquable pour l'organisation et la gestion pratique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "competence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce chef de service est un piètre orateur, mais c'est un remarquable <w>administrateur</w> sur le terrain."
                        },
                        {
                            "text": "Grâce à ses qualités d'<w>administrateur</w>, il a su rétablir l'ordre dans ce service désorganisé."
