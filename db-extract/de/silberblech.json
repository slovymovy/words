                "senses": [
                    {
                        "sense_id": "db88e2ed-45d5-3d3b-ae77-afd2ba41f471",
                        "entry_id": "6bcc44c1-85d6-3638-92eb-2c4945005b13",
                        "glosses": [
                            "aus Silber bestehendes/hergestelltes Blech"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e217e77-cf24-479c-b7a4-814ad43083b3",
                                "sense_id": "db88e2ed-45d5-3d3b-ae77-afd2ba41f471",
                                "text": "„Die Äbtissin Beatrix II. von Quedlinburg ziert einen Brakteat (1150–1160), eine einseitige silberne Pfennigmünze des Mittelalters aus dünnem Silberblech.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2cf6308e-bfb6-4679-9fbb-044357a176e0",
                        "source_entry_id": "6bcc44c1-85d6-3638-92eb-2c4945005b13",
                        "source_sense_id": "db88e2ed-45d5-3d3b-ae77-afd2ba41f471",
                        "source_sense_description": "aus Silber bestehendes/hergestelltes Blech",
                        "target_lang_word": "silver sheet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silver sheet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbca2643-f660-30d2-a3db-7d7da80e7693",
                                        "entry_id": "928fc221-38b0-3373-988a-b147b7e385f1",
                                        "glosses": [
                                            "A thin sheet of silver, e.g. used in metalworking or jewellery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2dc96b5-080a-3da0-ac11-de78390af519",
                                        "entry_id": "928fc221-38b0-3373-988a-b147b7e385f1",
                                        "glosses": [
                                            "A cinema screen onto which movies are projected."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daf7a3ea-56a9-4881-b205-4ab9f7e2ade0",
                                                "sense_id": "d2dc96b5-080a-3da0-ac11-de78390af519",
                                                "text": "Ushers rushed up and dragged the belligerent one off before serious damage was done either to himself or the silver sheet."
                                            },
                                            {
                                                "example_id": "3e96bc10-730a-43df-8388-bc8691dc0859",
                                                "sense_id": "d2dc96b5-080a-3da0-ac11-de78390af519",
                                                "text": "Famous Players-Lasky Corporation, producers of Paramount Pictures today, has its product displayed upon the silver sheet in every country where there is a projection machine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce855960-da75-307e-8193-bd837fd6ab6d",
                                        "entry_id": "928fc221-38b0-3373-988a-b147b7e385f1",
                                        "glosses": [
                                            "By extension, movies, the film industry, or that which is related to movies or cinema (often preceded with \\\"the\\\")"
                                        ],
                                        "tags": [
                                            "dated",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2a3154e-f63d-4a72-be7b-3906fb4fd631",
                                                "sense_id": "ce855960-da75-307e-8193-bd837fd6ab6d",
                                                "text": "After years in local theatre productions, he made his debut on the silver sheet and became known around the world."
                                            },
                                            {
                                                "example_id": "11ef9a8d-b7b0-4bdb-829a-13b58ac13015",
                                                "sense_id": "ce855960-da75-307e-8193-bd837fd6ab6d",
                                                "text": "I began writing for the screen, which hadn't as yet been christened the \"silver sheet,\" while employed on the Dramatic Mirror in New York City"
                                            },
                                            {
                                                "example_id": "570009b9-ed62-452d-8932-ff5fc1b328c4",
                                                "sense_id": "ce855960-da75-307e-8193-bd837fd6ab6d",
                                                "text": "On the screen Virginia Valli impresses one as mature, womanly, and reserved; off the silver sheet there is an elfin charm about her..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
