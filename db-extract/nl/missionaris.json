                        "entry_id": "9bdd0a2a-02fe-3f86-8dcc-db069666d7ef",
                        "glosses": [
                            "iemand door de katholieke kerk gezonden om het geloof te verbreiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52d2b918-b98c-4ba8-a6da-445c54829d11",
                                "sense_id": "1065aa9f-fcae-3a51-848c-45c761f81733",
                                "text": "De missionaris richtte een ziekenzaaltje op."
                            }
                        ]
