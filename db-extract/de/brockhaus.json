                "senses": [
                    {
                        "sense_id": "56412ed1-056e-3979-83da-b5d05e985bc1",
                        "entry_id": "a4220d66-3950-383d-abb2-d29999be231c",
                        "glosses": [
                            "deutscher Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cec10ec-c3a3-49d9-8d3d-708d569aeb08",
                                "sense_id": "56412ed1-056e-3979-83da-b5d05e985bc1",
                                "text": "„Drei Jahre nach der Gründung seines Verlages, 1805, erwarb der junge Friedrich Arnold Brockhaus auf der Leipziger Buchhändlermesse 1808 das 1796 begonnene, aber unvollendet gebliebene »Conversationslexikon mit vorzüglicher Rücksicht auf die gegenwärtigen Zeiten« von Renatus Gotthelf Löbel und Christian Wilhelm Franke.“"
                            },
                            {
                                "example_id": "eeeb9301-1b94-4555-b9b4-8fb9c5b7d883",
                                "sense_id": "56412ed1-056e-3979-83da-b5d05e985bc1",
                                "text": "„Albert Eduard Brockhaus (* 2. September 1855 in Leipzig; † 27. März 1921 ebenda) war ein deutscher Verleger und Politiker.“"
                            },
                            {
                                "example_id": "ca0b7c10-45ac-4400-ac52-b1a06102a784",
                                "sense_id": "56412ed1-056e-3979-83da-b5d05e985bc1",
                                "text": "„Der Name Brockhaus steht für fundiertes Wissen!“"
                            },
                            {
                                "example_id": "7ae73b6d-bf83-4bd4-8ecb-d6ecc28bfa8c",
                                "sense_id": "56412ed1-056e-3979-83da-b5d05e985bc1",
                                "text": "„Frau Dr. Cornelia Brockhaus Fachärztin für Kinder- und Jugendmedizin “"
                            }
                        ],
                        "sense_index_json": "\"1\""
