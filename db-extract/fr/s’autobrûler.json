                "senses": [
                    {
                        "sense_id": "4d494434-2343-3e20-856b-ecd28809fb27",
                        "entry_id": "dbca8d51-5f47-3195-9419-22f48cf46c5e",
                        "glosses": [
                            "Se brûler soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c386da2-e39e-46d9-9f05-b6c702f478ef",
                                "sense_id": "4d494434-2343-3e20-856b-ecd28809fb27",
                                "text": "On dirait le cratère d'un volcan éteint dont les lèvres sont béantes, qui a craché son feu a l'intérieur comme pour mieux se détruire lui-même, s'autobrûler jusqu'à la mort intime et l'anéantissement total."
                            },
                            {
                                "example_id": "05f77c1a-06dd-46d8-a029-7d4a15bf7d6c",
                                "sense_id": "4d494434-2343-3e20-856b-ecd28809fb27",
                                "text": "Ils ne sont pas fous, ils ne vont pas s'autobrûler, oui bon je sais c'est du cliché."
                            },
                            {
                                "example_id": "fb48a7bc-d9ec-4731-819e-98e244810170",
                                "sense_id": "4d494434-2343-3e20-856b-ecd28809fb27",
                                "text": "On ne peut pas répondre trop tôt, sauf si on est du genre à s'autobrûler par over-intensité."
                            }
                        ]
                    }
                ],
