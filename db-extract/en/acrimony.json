                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "21ff7e23-3ec1-4cd9-b600-8a603c36f4b1",
                        "entry_id": "dce07cee-53ca-3014-8e1e-360e4fe0c15d",
                        "tags": [
