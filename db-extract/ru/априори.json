                                    {
                                        "sense_id": "49881149-87e7-3d29-83e9-006b5fd7416e",
                                        "entry_id": "de179f91-ebfa-39b8-99b3-7bf97e32818c",
                                        "glosses": [
                                            "grundsätzlich, im Vorhinein, von vornherein/von vorneherein"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bd1cef3-2291-4a66-97e7-f75751360468",
                                                "sense_id": "49881149-87e7-3d29-83e9-006b5fd7416e",
                                                "text": "Ein Sozialstaat ist nicht a priori eine »soziale Hängematte«."
                                            },
                                            {
                                                "example_id": "4046430e-4e90-4b5d-b854-3067e3b0a28b",
                                                "sense_id": "49881149-87e7-3d29-83e9-006b5fd7416e",
                                                "text": "»[…] Für mich waren die Nazis nicht a priori meine ersten Feinde. Das waren die Austrofaschisten, nicht die Nazis.«"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e02b6092-7662-3bdc-97d6-5a9aff15fbd2",
                                        "entry_id": "de179f91-ebfa-39b8-99b3-7bf97e32818c",
                                        "glosses": [
                                            "unabhängig von jeder Erfahrung und Wahrnehmung; rein mit der Vernunft durch logisches Denken erschließbar"
                                        ],
                                        "tags": [
                                            "Erkenntnistheorie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3ba450d-7fcc-435f-8a1a-8339a3714f4f",
                                                "sense_id": "e02b6092-7662-3bdc-97d6-5a9aff15fbd2",
                                                "text": "Aus dem Verstand stammt diejenige Erkenntnis, die der Erfahrung vorhergeht (a priori)."
                                            },
                                            {
                                                "example_id": "4cdbf4c4-b75e-4079-82c7-cbeb3e82967f",
                                                "sense_id": "e02b6092-7662-3bdc-97d6-5a9aff15fbd2",
                                                "text": "„Immanuel Kant kennzeichnet mit a priori Begriffe, die allein dem Verstande, der Vernunft entstammen, allerdings erst dann in Erscheinung bzw. Tätigkeit treten, wenn mit ihrer Hilfe Wahrnehmungen zu Begriffen geformt werden.“"
                                            },
                                            {
                                                "example_id": "8ff7f6b7-df67-4e1b-9bcc-a3e016a8f25c",
                                                "sense_id": "e02b6092-7662-3bdc-97d6-5a9aff15fbd2",
                                                "text": "„Der ontologische Gottesbeweis schlussfolgert aus dem bloßen Gedanken oder Begriff ‚Gott’, d. h. a priori, auf die Existenz Gottes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e811fee0-5876-4400-9bbc-220e957f536f",
                        "source_entry_id": "86a215fa-20fe-3d76-b9d7-8037218c7bb2",
