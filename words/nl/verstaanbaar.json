                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "audible",
                                "target_lang_sense_clarification": "able to be heard clearly"
                            },
                            {
                                "target_lang_word": "intelligible",
                                "target_lang_sense_clarification": "able to be clearly heard and understood"
                            },
                            {
                                "target_lang_word": "comprehensible",
                                "target_lang_sense_clarification": "acoustically distinct enough to be followed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84617a40-3cf6-3225-909e-cb782eca5d77",
                    "sense_definition": "gemakkelijk te vatten of te beredeneren met het verstand",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cognitief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De docent legde de moeilijke theorie uit in heldere en <w>verstaanbare</w> taal.",
                            "target_lang_translations": {
