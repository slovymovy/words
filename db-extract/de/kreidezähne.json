                    {
                        "sense_id": "88d8128b-c5e4-3be3-802f-88e61a4d6892",
                        "entry_id": "eeef69a9-024d-3fad-be11-5a2141f5201d",
                        "glosses": [
                            "bei Kindern und Jugendlichen Störung der Bildung von Zahnschmelz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46ffad11-ecd4-4ca7-9ec9-8395fb4358be",
                                "sense_id": "88d8128b-c5e4-3be3-802f-88e61a4d6892",
                                "text": "„Neuste Studien haben nachgewiesen, dass Bisphenol A auch ursächlich an der Volkskrankheit der sogenannten ‚Kreidezähne‘ beteiligt ist.“"
                            },
                            {
                                "example_id": "20fef0dd-81fd-4d3a-99e0-a1d3a66e9eca",
                                "sense_id": "88d8128b-c5e4-3be3-802f-88e61a4d6892",
                                "text": "„Darüber hinaus steht Bisphenol A auch im Verdacht, die so genannten Kreidezähne (MolarenInzisiven-Hypomineralisation) zu verursachen.“"
                            },
                            {
                                "example_id": "1b07efb6-d1bc-491e-9472-d76beaa21162",
                                "sense_id": "88d8128b-c5e4-3be3-802f-88e61a4d6892",
                                "text": "„Manchmal wird aber auch schlicht von »Kreidezähnen« gesprochen, was die Substanz der befallenen Zähne leider ganz gut beschreibt.“"
                            },
                            {
                                "example_id": "9743f1fe-307c-466d-82ff-75665707dc9d",
                                "sense_id": "88d8128b-c5e4-3be3-802f-88e61a4d6892",
                                "text": "„Zahnschmerzen, fleckige Zähne und ein raues Gefühl sind häufig ein Zeichen von Kreidezähnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
