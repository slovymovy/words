            {
                "entry_id": "7fa4b8fc-28cb-3709-9e32-d61f1ad7c491",
                "word": "tens",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "22673f99-b25d-390e-8615-aae9f34e73bc",
                        "entry_id": "7fa4b8fc-28cb-3709-9e32-d61f1ad7c491",
                        "glosses": [
                            "An inexact quantity or number, typically understood to be between 10 or 20 and 100."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "0bfbbed5-6dba-4a69-ba01-c209898f3730",
                                "sense_id": "22673f99-b25d-390e-8615-aae9f34e73bc",
                                "text": "Our houses are tens of meters apart, so we don't have to worry about noise from our neighbours."
                            },
                            {
                                "example_id": "f4556cef-0354-4fee-ba79-4897992c3a0e",
                                "sense_id": "22673f99-b25d-390e-8615-aae9f34e73bc",
                                "text": "tens of thousands of voters"
                            },
                            {
                                "example_id": "cd90aa53-afca-40b0-9e68-fb0e5c56530e",
                                "sense_id": "22673f99-b25d-390e-8615-aae9f34e73bc",
                                "text": "Several tens of hours out on its first journey, while it was testing its track scanner by focusing back along the route it had taken, the ship registered a single massive annihilation explosion deep behind it, where the factory craft had been."
                            },
                            {
                                "example_id": "7f7b03be-01a6-47ec-84ce-c0be8f3c3630",
                                "sense_id": "22673f99-b25d-390e-8615-aae9f34e73bc",
                                "text": "\"We are looking at being able to fly [drones] tens of miles from base, which is going to make a huge difference. It is the equivalent of having bobbies on the beat.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "aabdb896-bf78-36a6-bd0d-0f6fdde68810",
                        "entry_id": "7fa4b8fc-28cb-3709-9e32-d61f1ad7c491",
                        "glosses": [
                            "A pair of tens."
                        ],
                        "tags": [
                            "plural",
                            "plural-only",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "23833d44-d8a3-31eb-87d2-6e827a9d5aeb",
                        "entry_id": "7fa4b8fc-28cb-3709-9e32-d61f1ad7c491",
                        "glosses": [
                            "The period from a year ending in 10 to a year ending in 19 (mostly referring to the 1910s or 2010s); the teens, the oneties."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
