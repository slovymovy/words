                                                "sense_id": "a3deaf7c-6814-35a7-aedc-0e92ab84ac04",
                                                "text": "Als we deze versterking moeten overgeven hebben we een groot probleem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "002dbeb3-af9e-3bd6-8d89-1b3f86fca269",
                                        "entry_id": "5214e17e-2a94-352f-96dd-d128c427680b",
                                        "glosses": [
                                            "het groter worden van een elektrisch signaal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f60146b-1496-4dae-8911-a663ef528982",
                                                "sense_id": "002dbeb3-af9e-3bd6-8d89-1b3f86fca269",
                                                "text": "De versterking moet wel over het gehele frequentiegebied gelijkmatig zijn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b96fad1d-99ba-3a7c-80c3-1c7c0ca48da4",
