            {
                "entry_id": "d7dca619-7981-35ad-9bbf-a7fee14fac2e",
                "word": "nineteenthly",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c1fe4560-cdcb-4f88-9598-0f9f0bb9cb6a",
                        "entry_id": "d7dca619-7981-35ad-9bbf-a7fee14fac2e",
                        "tags": [
                            "plural"
                        ],
                        "form": "nineteenthlies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b07998e-033f-3515-8cc9-0a1200ffde6c",
                        "entry_id": "d7dca619-7981-35ad-9bbf-a7fee14fac2e",
                        "glosses": [
                            "One of numerous points in a long sermon."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "0f3feb90-7cb8-41e9-9bce-c8aaa9dfeb02",
                                "sense_id": "7b07998e-033f-3515-8cc9-0a1200ffde6c",
                                "text": "In a word, the old Dame of Babylon, against whom our fathers testified so loudly, seems now hardly worth a passing attack, even in the Nineteenthly of an afternoon's sermon, and is in some measure reduced to the pavé."
                            },
                            {
                                "example_id": "ec7d1cb1-cece-4bc7-a6e3-dca4cb11679c",
                                "sense_id": "7b07998e-033f-3515-8cc9-0a1200ffde6c",
                                "text": "One can fancy the delight of the oppressed Puritan boys in the days of the nineteenthlies, driven to the place of worship by the tithing-men, and cooped up on the pulpit and gallery stairs under charge of the constables, at hearing for once a discourse which they could understand, […]"
                            },
                            {
                                "example_id": "355f7472-c6be-454c-9284-fad32f3785b5",
                                "sense_id": "7b07998e-033f-3515-8cc9-0a1200ffde6c",
                                "text": "You and I know it is not the nineteenthlies in the smart sermons that persuade men to lay hold of Him whom men need."
                            },
                            {
                                "example_id": "2aaf8085-dee6-4635-a567-8a2f21df0d00",
                                "sense_id": "7b07998e-033f-3515-8cc9-0a1200ffde6c",
                                "text": "Sermons that, for mortal hours, / Taxed our fathers' vital powers, / As the long nineteenthlies poured / Downward from the sounding-board, […]"
                            },
                            {
                                "example_id": "0d8d429b-164f-4da3-8054-29a9511a8a47",
                                "sense_id": "7b07998e-033f-3515-8cc9-0a1200ffde6c",
                                "text": "[…] the tirades of a virago may find expression in a pile of neatly sliced kindling, while the nineteenthlies of her reverend spouse, may receive ultimation in the sawing of substantial logs."
                            }
                        ]
                    }
                ],
