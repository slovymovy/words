                ],
                "senses": [
                    {
                        "sense_id": "08a4733d-bf36-384d-ac83-20f83f6ea0e7",
                        "entry_id": "c21b45df-9d15-38bf-bfff-851dc8420e48",
                        "glosses": [
                            "A disc-shaped piece of chocolate, the size of a chocolate chip, designed for melting when cooking."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de6db00f-4ff8-48b9-9bb3-10d1aef35b23",
                                "sense_id": "08a4733d-bf36-384d-ac83-20f83f6ea0e7",
                                "text": "You add unmelted chocolate callets (purpose-made chocolate chips) or finely chopped chocolate to already-melted chocolate to bring the temperature down."
                            },
                            {
                                "example_id": "978015d7-53e0-4324-82b7-25c4fab13b4a",
                                "sense_id": "08a4733d-bf36-384d-ac83-20f83f6ea0e7",
                                "text": "In the shops and bakery we use chocolate callets (or chips) in our baking. They come in a range of cocoa percentages and have the great advantage of melting evenly, which makes the chocolate less temperamental to work with."
                            },
                            {
                                "example_id": "7b95d012-2685-4b9c-9129-825d07f0fc4e",
                                "sense_id": "08a4733d-bf36-384d-ac83-20f83f6ea0e7",
                                "text": "We call for chocolate chips in our Chocolate Chip Cookies (page 1010), but there's another chocolate product on the market that's sometimes used for the same purpose: chocolate callets, which are formulated for melting."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
