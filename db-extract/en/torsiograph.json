                    {
                        "sense_id": "820f708c-38fb-3aee-a76c-dc615a2b742b",
                        "entry_id": "21ba10b5-e00b-3b6c-8a1f-c911fe9bd953",
                        "glosses": [
                            "An instrument for measuring the torsion of the crankshaft of an engine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03346c6f-3e1c-4e7c-a254-8c735c9e20ce",
                                "sense_id": "820f708c-38fb-3aee-a76c-dc615a2b742b",
                                "text": "Mechanical seismic-type torsiographs which record on a continuous strip chart are generally limited to belt drive. This is due to difficulty in mounting the instrument drive shaft in proper axial alignment with the end of the shaft system under test."
                            },
                            {
                                "example_id": "1516a3f5-4b58-45ae-a9f1-3838a4dd5afd",
                                "sense_id": "820f708c-38fb-3aee-a76c-dc615a2b742b",
                                "text": "In 1912 he originated the Geiger mechanical seismic torsiograph which was the first instrument to record torsional vibrations of shaft systems as a continuous wave-trace on a paper ribbon […]"
                            },
                            {
                                "example_id": "c4616f8e-e72b-4b02-b9cb-5bb42eb1283f",
                                "sense_id": "820f708c-38fb-3aee-a76c-dc615a2b742b",
                                "text": "In appropriate installations, the torsiograph provides good evidence of most torsional vibration modes."
                            }
                        ]
                    }
                ],
