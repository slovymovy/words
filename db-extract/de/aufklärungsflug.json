                        "tags": [],
                        "examples": [
                            {
                                "example_id": "201cdf39-1140-41ac-9664-d7b2b4af9bbf",
                                "sense_id": "e324091c-6dc2-39a6-8003-82d3c6ca1c37",
                                "text": "„Dort wurde seine Ju 88 bei einem Aufklärungsflug am 1. September 1944 von russischen Jagdfliegern attackiert.“"
                            },
                            {
                                "example_id": "0a2c64e5-337d-41a6-adae-0aee75a1a6c2",
                                "sense_id": "e324091c-6dc2-39a6-8003-82d3c6ca1c37",
                                "text": "„Der Bundestag erweiterte 2007 den Auftrag der Bundeswehr um Aufklärungsflüge; seit 2008 stellte die Bundeswehr eine schnelle Einsatztruppe für Kampfhandlungen.“"
                            }
                        ],
