                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95152ae2-9a20-4c4a-816f-543f707ddcb2",
                        "source_entry_id": "96fa9c18-4435-3c55-925a-107d8d9d4cef",
                        "source_sense_id": "6e6b9137-3f25-385b-a722-033cd7751d8d",
                        "source_sense_description": "debuting male",
                        "target_lang_word": "Debütant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Debütant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9611386e-272c-3ee0-91bb-3ec6fe569a76",
                                        "entry_id": "9a50696a-24aa-39f3-9fcf-6e0ebb119449",
                                        "glosses": [
                                            "jemand, der erstmals in einem bestimmten Bereich, in einem bestimmten Rahmen öffentlich auftritt/antritt (besonders als Künstler oder Sportler)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60993e70-c14b-48df-9e30-a70691526d89",
                                                "sense_id": "9611386e-272c-3ee0-91bb-3ec6fe569a76",
                                                "text": "„Daß die heutigen Debütanten, Romanciers zumal, in vielen Fällen Arbeiten vorlegen, die sogleich von einem nicht geringen handwerklichen Können zeugen, muß ohne Vorbehalt als ein erfreuliches Symptom der Gegenwartsliteratur gewertet werden.“"
                                            },
                                            {
                                                "example_id": "ff8e91b5-0131-4147-8b5b-3f56a6f03ad0",
                                                "sense_id": "9611386e-272c-3ee0-91bb-3ec6fe569a76",
                                                "text": "„Die barocken Klänge der Champions-League-Erkennungsmelodie machen die Debütanten nervös.“"
                                            },
                                            {
                                                "example_id": "e4653422-43cd-466d-ad2a-d1208b83364e",
                                                "sense_id": "9611386e-272c-3ee0-91bb-3ec6fe569a76",
                                                "text": "„Rezensenten lobten den Mut und die Offenheit des Debütanten, erkannten auch literarische Qualität, aber in einer Zeit, da sich alles um die Bewältigung des Krieges drehte, blieb jede Breitenwirkung aus.“"
                                            },
                                            {
                                                "example_id": "3c8ad69f-c1bb-4e30-9235-a1342a956362",
                                                "sense_id": "9611386e-272c-3ee0-91bb-3ec6fe569a76",
                                                "text": "„Ich war ihr einmal begegnet, dieser Freundin, als ich mit der Straßenbahn zum Buchladen Tronsmo gefahren war, wo Ola zusammen mit zwei anderen Debütanten interviewt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65d67dcb-fa0f-4707-9ec8-cc8d62a0a47e",
                        "source_entry_id": "96fa9c18-4435-3c55-925a-107d8d9d4cef",
