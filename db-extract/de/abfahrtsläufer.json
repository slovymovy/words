                                                "sense_id": "3e33117b-7be8-3ded-9748-a71a257e67f5",
                                                "text": "Ce cycliste est un bon descendeur."
                                            },
                                            {
                                                "example_id": "f98d5f71-2982-4cb6-92a7-bfdf8452759a",
                                                "sense_id": "3e33117b-7be8-3ded-9748-a71a257e67f5",
                                                "text": "Ce descendeur fantastique était aussi un brillant grimpeur."
