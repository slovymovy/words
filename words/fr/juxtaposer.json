    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bab4514d-368e-3812-9328-f5a0b3f519d6",
                    "sense_definition": "Placer des choses l'une à côté de l'autre, souvent pour créer un effet ou pour les comparer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste a choisi de <w>juxtaposer</w> deux couleurs vives pour attirer immédiatement le regard du public."
                        },
                        {
                            "text": "Si nous <w>juxtaposons</w> ces deux photographies, la ressemblance entre les deux frères devient évidente."
                        }
                    ],
                    "synonyms": [
                        "accoler",
                        "rapprocher"
                    ],
                    "antonyms": [
                        "éloigner",
                        "séparer"
                    ],
                    "common_phrases": [
                        "juxtaposer deux couleurs",
                        "juxtaposer des éléments"
                    ]
                },
                {
                    "sense_id": "daa61911-10b8-3d13-a7cb-4b065204dabd",
                    "sense_definition": "Placer des propositions ou des mots l'un à côté de l'autre sans mot de liaison ou conjonction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette phrase, l'écrivain préfère <w>juxtaposer</w> deux propositions plutôt que d'utiliser des conjonctions."
                        },
                        {
                            "text": "On peut simplement <w>juxtaposer</w> ces adjectifs en les séparant par une virgule."
                        }
                    ],
                    "antonyms": [
                        "coordonner",
                        "subordonner"
                    ],
                    "common_phrases": [
                        "juxtaposer deux propositions"
                    ]
                }
            ]
        }
    ]
