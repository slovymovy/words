                        "target_lang_word": "aquarium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aquarium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "990fb510-5123-3c53-a979-faa94bf505ef",
                                        "entry_id": "faf149e7-b8ef-397c-bdae-61605f69419e",
                                        "glosses": [
                                            "Réservoir d’eau, généralement en verre épais, dans lequel on garde des poissons ou des algues."
                                        ],
                                        "tags": [
                                            "Aquariologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31be1a51-b0c7-4a48-92c1-27048f3bbb48",
                                                "sense_id": "990fb510-5123-3c53-a979-faa94bf505ef",
                                                "text": "Dans ce petit paysage intime, la disproportion de cet hippopotame fait paraître aquarium ou bassin pour Zoo le petit lac."
                                            },
                                            {
                                                "example_id": "c242fddf-ed65-41f2-aa30-c61b5b061fef",
                                                "sense_id": "990fb510-5123-3c53-a979-faa94bf505ef",
                                                "text": "Ils se les caillaient sur un trottoir entre deux réverbères depuis plus d'une heure, en face d’un restau dont la vitrine s’ornait d’une tête de dragon multicolore et d’un aquarium aux poissons également aussi généreux en couleurs pétantes qu’un « ensemble » de Karine."
                                            },
                                            {
                                                "example_id": "1b8875b0-a869-41a0-abba-06e4c3bd82d8",
                                                "sense_id": "990fb510-5123-3c53-a979-faa94bf505ef",
                                                "text": "Aquarium d’eau de mer. — Des aquariums d’eau douce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4f360a4-94d2-3c20-bdc6-0c5c5f7ace32",
                                        "entry_id": "faf149e7-b8ef-397c-bdae-61605f69419e",
                                        "glosses": [
                                            "Établissement aquariologique, bâtiment ou espace dans lequel une collection d’animaux et de végétaux aquatiques est exposée dans des réservoirs d'eau."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70c34e93-a47b-485a-9056-ce3f52c30ed7",
                                                "sense_id": "c4f360a4-94d2-3c20-bdc6-0c5c5f7ace32",
                                                "text": "Elle engendrait des mythes qui découlaient de mon attente dans la durée, cependant que mon âme, qui ne voyait presque pas ce que ma main créait devant elle, errait comme une somnambule entre les sombres murs imaginaires et les théâtres sous-marins de l’aquarium de Monaco !"
                                            },
                                            {
                                                "example_id": "b18105eb-93ff-4439-b836-ce82e20494ca",
                                                "sense_id": "c4f360a4-94d2-3c20-bdc6-0c5c5f7ace32",
                                                "text": "Un aquarium public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e965db3-972f-37aa-ba41-3cc3fec15d2c",
                                        "entry_id": "faf149e7-b8ef-397c-bdae-61605f69419e",
                                        "glosses": [
                                            "Tableau d’affichage vitré."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bde309f-88bc-4c6e-88d9-43cf4e794dc4",
                                                "sense_id": "6e965db3-972f-37aa-ba41-3cc3fec15d2c",
                                                "text": "Avoir mis des poissons rouges dans l’aquarium après l’avoir mastiqué. (motif de punition collective)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d662e602-8572-3dd4-96de-c197fd45445f",
                                        "entry_id": "faf149e7-b8ef-397c-bdae-61605f69419e",
                                        "glosses": [
                                            "Espace de travail vitré, clos et de petites dimensions."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0ff8492-4586-474f-977a-480032b891ae",
                                                "sense_id": "d662e602-8572-3dd4-96de-c197fd45445f",
                                                "text": "Le matin, aux aurores, j’étais au guichet de la police des frontières, attendant avec anxiété que le fonctionnaire enfermé dans son aquarium eût fini d’examiner mon passeport, page par page, lorsque le haut-parleur crachota une annonce dans un sabir qui voulait se faire passer pour de l’arabe classique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "171a3e4c-ddd2-3350-8f69-9498f53f10a1",
                                        "entry_id": "faf149e7-b8ef-397c-bdae-61605f69419e",
                                        "glosses": [
                                            "Espace confiné dans lequel on fume du cannabis afin de respirer plus de fumée."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
