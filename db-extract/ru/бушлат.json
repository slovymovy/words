                "senses": [
                    {
                        "sense_id": "15d53189-78bc-391d-8ddd-46e857cdcb42",
                        "entry_id": "f236b741-9ede-3800-9cbe-a12e715f4cd8",
                        "glosses": [
                            "двубортное пальто на тёплой подкладке с отложным воротником"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ba44579b-9b1e-3621-9320-2203ba9a0012",
                        "entry_id": "f236b741-9ede-3800-9cbe-a12e715f4cd8",
                        "glosses": [
                            "любая, как правило, форменная тяжёлая тёплая рабочая одежда в виде куртки у военных, заключённых, строителей и т. п."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb77296c-366c-4f77-9207-4dd79d6f7c27",
                        "source_entry_id": "f236b741-9ede-3800-9cbe-a12e715f4cd8",
                        "target_lang_word": "vareuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vareuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5fc8024-23fb-3825-8874-0d03af6841b2",
                                        "entry_id": "ff578234-5788-322e-a68f-36c8567420f7",
                                        "glosses": [
                                            "Sorte de blouse que portent les matelots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9062b22c-5350-40cd-ba32-d1764ad5bd43",
                                                "sense_id": "f5fc8024-23fb-3825-8874-0d03af6841b2",
                                                "text": "Cette fois il était prêt, Thiébot, et déjà il n’avait plus l’air d’un paysan avec sa vareuse lavée et relavée, son ciré sur le bras, son « boudin » de toile à cheval sur l’épaule, fermé par ses cordonnets à pompons comme ces blouses qu’on porte les jours de foire et, bien arrimé par une courroie à sa ceinture, une grosse botte « d’agréments » : oignons, ail, échalote, de quoi donner du goût aux sauces, car il avait pensé à tout."
                                            },
                                            {
                                                "example_id": "28ab9675-4b67-49c3-911c-1fa75045aad9",
                                                "sense_id": "f5fc8024-23fb-3825-8874-0d03af6841b2",
                                                "text": "Tu ne peux pas aller dîner en ville en vareuse rouge et avec un bonnet de débardeur."
                                            },
                                            {
                                                "example_id": "98601a7b-c151-48e3-a623-62600fcfa161",
                                                "sense_id": "f5fc8024-23fb-3825-8874-0d03af6841b2",
                                                "text": "Leur costume consistait en une grossière vareuse de laine noire connue dans tous les pays scandinaves sous le nom de « vadmel », un chapeau à vastes bords, un pantalon à lisère rouge et un morceau de cuir replié en manière de chaussure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65e2a3d1-517a-3a94-abf4-9bc622fcad2a",
                                        "entry_id": "ff578234-5788-322e-a68f-36c8567420f7",
                                        "glosses": [
                                            "Vêtement militaire plus court que la tunique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f7cbcec-7670-40a0-a684-afbc0b6d6348",
                                                "sense_id": "65e2a3d1-517a-3a94-abf4-9bc622fcad2a",
                                                "text": "Deux ou trois, qui avaient trop forci pour s’accommoder de ces ajustements, combinaient la tenue bourgeoise et la militaire, la casquette et le ceinturon, le pantalon et la vareuse désécussonnée."
                                            },
                                            {
                                                "example_id": "afad31f2-6d4b-42d2-be45-6d5ed8661415",
                                                "sense_id": "65e2a3d1-517a-3a94-abf4-9bc622fcad2a",
                                                "text": "Gabriel Morange extirpa fébrilement le cahier de sa vareuse. Il trempa sa fine plume métallique dans l’encre mauve et la fit courir sur le papier avec rage, y creusant profondément les mots, prolongement de son esprit où de noires pensées se répandaient comme une ombre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cc69dd6-bf77-3057-8718-c87fb6a543eb",
                                        "entry_id": "ff578234-5788-322e-a68f-36c8567420f7",
                                        "glosses": [
                                            "Veste très ample."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67b3888f-8f1d-3bc7-abfa-a64f3f2b240a",
                                        "entry_id": "ff578234-5788-322e-a68f-36c8567420f7",
                                        "glosses": [
                                            "Maillot des équipes de football."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfb10ef3-aead-4d3a-8ed3-4eee21138869",
                                                "sense_id": "67b3888f-8f1d-3bc7-abfa-a64f3f2b240a",
                                                "text": "Les supporters ne se sont pas non plus précipités pour acquérir la nouvelle vareuse des Diables rouges qui n’est guère appréciée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ddbb02b-ab50-41ad-a1df-53c41535e4ce",
                        "source_entry_id": "f236b741-9ede-3800-9cbe-a12e715f4cd8",
                        "target_lang_word": "caban",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caban",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0aa63fa0-f54b-3a4d-b58d-4d4ff6252b99",
                                        "entry_id": "aabed6be-ecf2-34fa-8d07-dece47a022ee",
                                        "glosses": [
                                            "Vêtement de dessus avec des manches et un capuchon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a72c3b10-9f83-406b-b8dc-b30cbc34800a",
                                                "sense_id": "0aa63fa0-f54b-3a4d-b58d-4d4ff6252b99",
                                                "text": "Un individu s’approche pourtant, un brave homme vêtu d’un caban rapiécé."
                                            },
                                            {
                                                "example_id": "e077b5d2-44dd-4f16-a7b7-4b34b61a919f",
                                                "sense_id": "0aa63fa0-f54b-3a4d-b58d-4d4ff6252b99",
                                                "text": "Devant cette Anglaise, je me sentis tout honteux de n’avoir ni gants blancs, ni lorgnon, ni souliers vernis, et je jetai un regard confus sur les broderies extravagantes de mon caban bleu de ciel. Pour la première fois, depuis six mois, je compris que je n’étais pas convenable, et que je n’avais pas l’air gentleman."
                                            },
                                            {
                                                "example_id": "ef5e9edd-fcec-4101-bdd4-73d92221dfd1",
                                                "sense_id": "0aa63fa0-f54b-3a4d-b58d-4d4ff6252b99",
                                                "text": "Je me penche pour ramasser son caban. Elle me lorgne, l’œil narquois, méchant pour tout dire. Son caban sous le bras, je me dirige vers la porte. Je l’ouvre. Je flanque le caban sur le palier. Je détends le bras pour l’inviter à quitter le studio."
                                            },
                                            {
                                                "example_id": "f901e773-1f2c-470f-b77e-6d2cd22ea49d",
                                                "sense_id": "0aa63fa0-f54b-3a4d-b58d-4d4ff6252b99",
                                                "text": "Malgré les souffrances physiques que j’endure au moment où je trace ces lignes, je me souviens non sans une mélancolie amusée de l’abominable caban bleu marine dont m’affublait l’autrice de mes jours sans tenir compte de mes supplications : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb129a5a-b701-329c-9cb6-0d9f146e7cd6",
                                        "entry_id": "aabed6be-ecf2-34fa-8d07-dece47a022ee",
                                        "glosses": [
                                            "Manteau-capote de laine foncée couverte de toile imperméable, parfois accompagné d’une capuche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6265368-ce56-40e7-819f-4ef65ccb6543",
                                                "sense_id": "fb129a5a-b701-329c-9cb6-0d9f146e7cd6",
                                                "text": "Son caban de matelot, bleu marine, arrêté aux genoux, lui donnait un air de collégien en uniforme de sortie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f05eb096-54dc-3555-a928-0e5691022d0b",
                                        "entry_id": "aabed6be-ecf2-34fa-8d07-dece47a022ee",
                                        "glosses": [
                                            "Étoffe de laine foulonnée rendue imperméable par la conservation d’une partie du suint, utilisée notamment pour la confection de chapeaux et de vêtements de marin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
