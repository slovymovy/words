{
    "word_family": [
        "assuagement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7391b6cd-a2dd-3bba-9c1f-b053514d9d37",
                    "sense_definition": "To make an unpleasant feeling or physical sensation less intense or severe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mitigate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cool water helped to <w>assuage</w> his burning thirst after the long hike.",
                            "target_lang_translations": {
                                "ru": "Прохладная вода помогла <w>утолить</w> его сильную жажду после долгого похода."
                            }
                        },
                        {
                            "text": "She tried to <w>assuage</w> her guilt by apologizing to everyone she had offended.",
                            "target_lang_translations": {
                                "ru": "Она пыталась <w>смягчить</w> чувство вины, извинившись перед всеми, кого она обидела."
                            }
                        }
                    ],
                    "synonyms": [
                        "alleviate",
                        "mitigate",
                        "relieve",
                        "soothe"
                    ],
                    "antonyms": [
                        "aggravate",
                        "intensify"
                    ],
                    "common_phrases": [
                        "assuage guilt",
                        "assuage thirst",
                        "assuage pain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ослаблять интенсивность неприятного чувства или физического ощущения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смягча́ть",
                                "target_lang_sense_clarification": "делать менее болезненным или тяжелым"
                            },
                            {
                                "target_lang_word": "успока́ивать",
                                "target_lang_sense_clarification": "уменьшать физическую боль или неприятное ощущение"
                            },
                            {
                                "target_lang_word": "утоля́ть",
                                "target_lang_sense_clarification": "удовлетворять потребность, например, жажду или голод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1feca7e1-9e85-3e79-8bb1-a3b9789d005d",
                    "sense_definition": "To calm or pacify someone who is angry or upset.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mitigate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager tried to <w>assuage</w> the angry customer with a full refund.",
                            "target_lang_translations": {
                                "ru": "Менеджер попытался <w>успокоить</w> разгневанного клиента, предложив полный возврат средств."
                            }
                        },
                        {
                            "text": "He spoke softly to <w>assuage</w> the crying child.",
                            "target_lang_translations": {
                                "ru": "Он говорил тихо, чтобы <w>успокоить</w> плачущего ребенка."
                            }
                        }
                    ],
                    "synonyms": [
                        "pacify",
                        "soothe",
                        "appease"
                    ],
                    "antonyms": [
                        "agitate",
                        "provoke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Успокаивать или умиротворять кого-либо, кто рассержен или расстроен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "успока́ивать",
                                "target_lang_sense_clarification": "приводить в состояние спокойствия, рассеивать тревогу"
                            },
                            {
                                "target_lang_word": "умиротворя́ть",
                                "target_lang_sense_clarification": "приводить к состоянию мира и спокойствия"
                            },
                            {
                                "target_lang_word": "задобри́ть",
                                "target_lang_sense_clarification": "сделать кого-либо более благосклонным, часто с помощью уступок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ec1ea93-ebcd-39f8-abe1-7926be7791f8",
                    "sense_definition": "To become less intense or violent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mitigate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm finally began to <w>assuage</w> as the night progressed.",
                            "target_lang_translations": {
                                "ru": "Буря наконец начала <w>утихать</w> с наступлением ночи."
                            }
                        },
                        {
                            "text": "His anger did not <w>assuage</w> even after he heard the explanation.",
                            "target_lang_translations": {
                                "ru": "Его гнев не <w>ослабел</w> даже после того, как он услышал объяснение."
                            }
                        }
                    ],
                    "synonyms": [
                        "subside",
                        "abate",
                        "diminish"
                    ],
                    "antonyms": [
                        "escalate",
                        "intensify"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться менее интенсивным, сильным или бурным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утиха́ть",
                                "target_lang_sense_clarification": "становиться менее сильным, ослабевать (о буре, боли, чувствах)"
                            },
                            {
                                "target_lang_word": "ослабева́ть",
                                "target_lang_sense_clarification": "терять свою силу или интенсивность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}