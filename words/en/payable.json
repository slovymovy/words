    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6306677e-1508-3047-abdb-444d7d629a2b",
                    "sense_definition": "Required to be paid; due or owing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "financial_obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The total amount is <w>payable</w> within thirty days of receiving the invoice.",
                            "target_lang_translations": {
                                "ru": "Общая сумма <w>подлежит оплате</w> в течение тридцати дней с момента получения счета."
                            }
                        },
                        {
                            "text": "Is value-added tax <w>payable</w> on planning application fees for this project?",
                            "target_lang_translations": {
                                "ru": "Должен ли <w>уплачиваться</w> налог на добавленную стоимость с пошлин за подачу заявок на проектирование по этому объекту?"
                            }
                        }
                    ],
                    "synonyms": [
                        "due",
                        "owing",
                        "outstanding"
                    ],
                    "common_phrases": [
                        "accounts payable",
                        "tax payable",
                        "payable in advance",
                        "payable on demand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подлежащий оплате; тот, который должен быть выплачен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подлежащий оплате",
                                "target_lang_sense_clarification": "обязательный к выплате"
                            },
                            {
                                "target_lang_word": "к оплате",
                                "target_lang_sense_clarification": "сумма, которую нужно заплатить"
                            },
                            {
                                "target_lang_word": "причитающийся",
                                "target_lang_sense_clarification": "о долге или налоге"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7701f841-e296-34b9-9518-d06e0116b472",
                    "sense_definition": "That can be paid; capable of being settled with money.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financial_capability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fine was set at a <w>payable</w> amount that the student could actually afford.",
                            "target_lang_translations": {
                                "ru": "Штраф был установлен в <w>посильном</w> размере, который студент действительно мог себе позволить."
                            }
                        },
                        {
                            "text": "We need to ensure the debt remains <w>payable</w> through a reasonable installment plan.",
                            "target_lang_translations": {
                                "ru": "Нам нужно убедиться, что долг остается <w>возможным для выплаты</w> благодаря разумному плану рассрочки."
                            }
                        }
                    ],
                    "synonyms": [
                        "affordable",
                        "solvable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Который может быть оплачен; посильный для выплаты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посильный",
                                "target_lang_sense_clarification": "который можно выплатить"
                            },
                            {
                                "target_lang_word": "оплачиваемый",
                                "target_lang_sense_clarification": "способный быть погашенным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d15c6494-61df-3b91-aa8f-8d9947c3b976",
                    "sense_definition": "Capable of yielding a profit, especially in reference to a mine or ore deposit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "profitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineers are still determining if the gold vein is <w>payable</w> enough to mine.",
                            "target_lang_translations": {
                                "ru": "Инженеры все еще определяют, является ли золотая жила достаточно <w>рентабельной</w> для добычи."
                            }
                        },
                        {
                            "text": "After years of exploration, they finally discovered a <w>payable</w> deposit of copper.",
                            "target_lang_translations": {
                                "ru": "После многих лет разведки они, наконец, обнаружили <w>промышленное</w> месторождение меди."
                            }
                        }
                    ],
                    "synonyms": [
                        "profitable",
                        "lucrative",
                        "remunerative"
                    ],
                    "common_phrases": [
                        "payable ore",
                        "payable gold"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рентабельный или прибыльный, особенно в отношении месторождений полезных ископаемых."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рентабельный",
                                "target_lang_sense_clarification": "приносящий прибыль"
                            },
                            {
                                "target_lang_word": "промышленный",
                                "target_lang_sense_clarification": "о содержании металла в руде, пригодном для разработки"
                            },
                            {
                                "target_lang_word": "доходный",
                                "target_lang_sense_clarification": "выгодный для добычи"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "687a18f2-c5ac-30cc-be64-926b7a071d6a",
                    "sense_definition": "Debts or liabilities owed by a business to its suppliers or creditors.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accounting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant spent the afternoon reviewing the company's <w>payables</w> to ensure all vendors were paid.",
                            "target_lang_translations": {
                                "ru": "Бухгалтер провел вторую половину дня, проверяя <w>кредиторскую задолженность</w> компании, чтобы убедиться, что всем поставщикам произведена оплата."
                            }
                        },
                        {
                            "text": "A sudden increase in <w>payables</w> can indicate that a business is struggling with cash flow.",
                            "target_lang_translations": {
                                "ru": "Внезапный рост <w>счетов к оплате</w> может указывать на то, что бизнес испытывает трудности с денежными потоками."
                            }
                        }
                    ],
                    "synonyms": [
                        "liabilities",
                        "debts",
                        "obligations"
                    ],
                    "antonyms": [
                        "receivable"
                    ],
                    "common_phrases": [
                        "accounts payable",
                        "trade payables"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Долги или обязательства предприятия перед поставщиками или кредиторами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кредиторская задолженность",
                                "target_lang_sense_clarification": "обязательства перед поставщиками"
                            },
                            {
                                "target_lang_word": "счета к оплате",
                                "target_lang_sense_clarification": "бухгалтерский термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbc8057d-9877-3958-bf0b-1171f279b8ce",
                    "sense_definition": "An item, such as a bill or an amount of money, that is to be paid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financial_items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract specifies that any <w>payable</w> shall cease to be due if the service is cancelled.",
                            "target_lang_translations": {
                                "ru": "В контракте указано, что любой <w>платеж</w> перестает быть обязательным, если услуга отменена."
                            }
                        },
                        {
                            "text": "He kept a detailed list of every <w>payable</w> that came through his office each month.",
                            "target_lang_translations": {
                                "ru": "Он вел подробный список каждого <w>финансового обязательства</w>, проходившего через его офис каждый месяц."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Статья расходов или сумма, подлежащая выплате."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "платеж",
                                "target_lang_sense_clarification": "сумма к выплате"
                            },
                            {
                                "target_lang_word": "обязательство",
                                "target_lang_sense_clarification": "финансовый долг"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}