                                "target_lang_sense_clarification": "роскошный и модный"
                            },
                            {
                                "target_lang_word": "щегольской",
                                "target_lang_sense_clarification": "изящный и франтоватый"
                            },
                            {
                                "target_lang_word": "модный",
                                "target_lang_sense_clarification": "стильный и актуальный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}