                                        "sense_id": "afd22121-dd69-346c-96bd-99c43298e9e7",
                                        "entry_id": "72a5a6f7-74ac-3a3b-a623-4f24906bb6d5",
                                        "glosses": [
                                            "Broken, saddened, depressed, devastated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3af6839a-563d-4dec-aa91-d95c8f83f924",
                                                "sense_id": "afd22121-dd69-346c-96bd-99c43298e9e7",
                                                "text": "We were totally crushed upon hearing the news of your accident."
                                            },
                                            {
                                                "example_id": "d8cceab7-d348-45cf-b078-5b0069ab347c",
                                                "sense_id": "afd22121-dd69-346c-96bd-99c43298e9e7",
                                                "text": "[…] St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London. Close-packed, crushed by the buttressed height of the railway viaduct, rendered airless by huge walls of factories, it at once banished lively interest from a stranger's mind and left only a dull oppression of the spirit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8e82662-f09a-35fc-a153-ae8720c00ca8",
                                        "entry_id": "72a5a6f7-74ac-3a3b-a623-4f24906bb6d5",
                                        "glosses": [
                                            "Of a fabric, having the appearance of having been crushed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4a27666-15c5-482d-8e02-c74b9176baa9",
                                                "sense_id": "e8e82662-f09a-35fc-a153-ae8720c00ca8",
                                                "text": "Her top was of black crushed velvet."
                                            }
                                        ]
                                    }
                                ]
                            }
