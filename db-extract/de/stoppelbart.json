                    },
                    {
                        "translation_id": "f3f197ed-45e5-4fee-bc42-d1b6b12936b4",
                        "source_entry_id": "94114c30-0fee-3b64-9008-0ac8905c3d3c",
                        "source_sense_id": "da97021b-4ac8-3d3a-bbf5-8eb5d10d5219",
                        "source_sense_description": "Bart mit nur kurzen Haaren",
                        "target_lang_word": "stubble",
                        "target_lang_code": "en",
