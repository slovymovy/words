                    },
                    {
                        "form_id": "a615ba24-07eb-459d-aae9-c53e36eb4824",
                        "entry_id": "dea7963b-f900-3b5f-a8d0-ce53fd396eef",
                        "tags": [
                            "orthographe de l’italien"
                        ],
                        "form": "tremolo"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5666ea88-55cc-3c5e-aa72-32e6e1c4bd05",
                        "entry_id": "dea7963b-f900-3b5f-a8d0-ce53fd396eef",
                        "glosses": [
                            "Répétition très rapide d’un même son avec un instrument à cordes frottées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c484fc12-a8cd-48da-a53c-d3d39bd04362",
                                "sense_id": "5666ea88-55cc-3c5e-aa72-32e6e1c4bd05",
                                "text": "Les trémolos d’un violon."
                            },
                            {
                                "example_id": "a3bce126-773d-426c-9340-a5edd992879a",
                                "sense_id": "5666ea88-55cc-3c5e-aa72-32e6e1c4bd05",
                                "text": "Mademoiselle Pierrotte nous joua sans la moindre flûte un de ces trémolos bien connus qu’on appelle Rêveries de Rosellen…"
                            }
                        ]
                    },
                    {
                        "sense_id": "c64ef7ec-d4bf-36bc-bd05-a2143e76fcb5",
                        "entry_id": "dea7963b-f900-3b5f-a8d0-ce53fd396eef",
                        "glosses": [
                            "Modulation du niveau d’un son autour d’un niveau moyen que l’on donne à la voix. C’est donc l’intensité sonore qui varie et non la fréquence du son (à l’inverse du vibrato). Le trémolo peut exprimer une profonde tristesse (tremblement d'émotion) ; il peut aussi être affecté ou exagéré pour intensifier l'émotion ou pour dramatiser un discours."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "043028d3-d7b3-43ae-85a1-09697d6bb687",
                                "sense_id": "c64ef7ec-d4bf-36bc-bd05-a2143e76fcb5",
                                "text": "Elle parlait avec des trémolos dans la voix, comme si elle roucoulait !"
                            },
                            {
                                "example_id": "cec21a0a-d355-46f4-a957-4f2d4f650df2",
                                "sense_id": "c64ef7ec-d4bf-36bc-bd05-a2143e76fcb5",
                                "text": "Elle accaparait de ses trémolos douloureux notre petit monde rétréci où nous étions en train de merdouiller en chœur par sa faute."
                            },
                            {
                                "example_id": "f731e991-25d7-4493-9519-4dcda2ac424e",
                                "sense_id": "c64ef7ec-d4bf-36bc-bd05-a2143e76fcb5",
                                "text": "Le mépris où il tenait le nationalisme dont j’ai toujours eu l’aversion, le dédain qu’il témoignait pour les trémolos sur le grand air de patrie qui enchantaient le sentimentalisme alangui de mon cher Paul Deschanel achevèrent de m’attacher à lui."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfb864b6-f4a1-4efa-b4a0-e689b531b98f",
                        "source_entry_id": "dea7963b-f900-3b5f-a8d0-ce53fd396eef",
                        "target_lang_word": "Tremolo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tremolo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61af85e4-8327-3112-bdcd-efdf2aa6f85f",
                                        "entry_id": "6bbd75f3-1997-3d89-adbb-1e7a0cf81a49",
                                        "glosses": [
                                            "Bebung, die bei Tasten-, Streich- oder Blasinstrumenten erzeugt wird; in kurzen Abständen erfolgende Tonwiederholung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a26f3e-a1ab-4de2-bec7-1dbe167405e4",
                                                "sense_id": "61af85e4-8327-3112-bdcd-efdf2aa6f85f",
                                                "text": "Die Ausführung des Tremolos ist bei jedem Instrument anders: Bei Streichinstrumenten wird der Bogen in einer schnellen Zitterbewegung über die Saiten geführt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ce9a6016-dd7b-3520-b9a1-c52ea89935c8",
                                        "entry_id": "6bbd75f3-1997-3d89-adbb-1e7a0cf81a49",
                                        "glosses": [
                                            "bebende Tonführung beim Gesang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1a82032-fa47-47b3-9e8d-1420ec7d9230",
                                                "sense_id": "ce9a6016-dd7b-3520-b9a1-c52ea89935c8",
                                                "text": "Das nennt sich Tremolo oder Vibrato (bei einer Stimme eher Vibrato). Das hat man oder man hat es nicht."
                                            },
                                            {
                                                "example_id": "7b10fc75-a871-477a-b82b-2afe46eaf076",
                                                "sense_id": "ce9a6016-dd7b-3520-b9a1-c52ea89935c8",
                                                "text": "„Sie zerquetscht eine Träne im Augenwinkel und in ihrer Stimme ist ein kleines Tremolo.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e81f6d18-b8a2-3bec-8080-c16e118c38bb",
                                        "entry_id": "6bbd75f3-1997-3d89-adbb-1e7a0cf81a49",
                                        "glosses": [
                                            "Amplitudenmodulation - Überlagerung mehrerer ähnlicher Töne beim Akkordeon oder bei elektronischen Instrumenten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dd54b63-262b-4421-84aa-33dc91423cb1",
                                                "sense_id": "e81f6d18-b8a2-3bec-8080-c16e118c38bb",
                                                "text": "Die Akkordeons von Demian waren \"einchörig\"; Tremolo oder andere Klangfarben kannte man noch nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e789122e-2697-46be-841d-49a96d0c87a5",
                        "source_entry_id": "dea7963b-f900-3b5f-a8d0-ce53fd396eef",
                        "target_lang_word": "tremolo",
