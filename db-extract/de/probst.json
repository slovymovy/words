                            {
                                "example_id": "910afc1c-1491-4093-8985-7277cb0b0871",
                                "sense_id": "36759e8e-817d-35f0-8ca0-fbe12c5b1be3",
                                "text": "Die Probst war der Star des Abends."
                            },
                            {
                                "example_id": "85442aed-04d7-48ac-b178-b9a3e0bc709e",
                                "sense_id": "36759e8e-817d-35f0-8ca0-fbe12c5b1be3",
                                "text": "Wir sind heute Abend bei Probsts eingeladen."
                            },
                            {
                                "example_id": "da4a2ee1-9304-4166-a753-8c5053e49b82",
                                "sense_id": "36759e8e-817d-35f0-8ca0-fbe12c5b1be3",
                                "text": "Kennst du die Probsts von nebenan?"
                            },
                            {
                                "example_id": "7723353b-41c2-4acc-9123-429b61b30b05",
                                "sense_id": "36759e8e-817d-35f0-8ca0-fbe12c5b1be3",
                                "text": "Probst rannte alles über den Haufen, als er ins Büro kam."
                            }
                        ],
