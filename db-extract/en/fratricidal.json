                                "target_senses": [
                                    {
                                        "sense_id": "66221f1a-1800-3844-8976-c15823c71770",
                                        "entry_id": "dec667ff-3e7a-3c42-a499-a9db2566c800",
                                        "glosses": [
                                            "Qualifie les guerres ou les luttes sanglantes entre frères ou concitoyens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95c2e2ff-22a1-4dbd-a109-d53a67813ea2",
                                                "sense_id": "66221f1a-1800-3844-8976-c15823c71770",
                                                "text": "Le Parti républicain se dirige vers des mois de luttes fratricides qui connaîtront leurs dénouements lors des élections de l’année prochaine."
                                            },
                                            {
                                                "example_id": "05496414-9e10-450d-8d03-af94d2b542cb",
                                                "sense_id": "66221f1a-1800-3844-8976-c15823c71770",
                                                "text": "Lutte fratricide."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fratricide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8fb9928-8dad-3e57-a464-36b6fe208684",
                                        "entry_id": "a13e0d31-09fe-3e4d-a522-c6c08e3c1add",
                                        "glosses": [
                                            "Personne qui tue son frère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82f59a39-e3eb-4462-a417-eab27e02a83f",
                                                "sense_id": "a8fb9928-8dad-3e57-a464-36b6fe208684",
                                                "text": "Caïn fut le premier fratricide."
                                            },
                                            {
                                                "example_id": "24bf8c7c-5be3-41a3-9e2b-503f07aadc71",
                                                "sense_id": "a8fb9928-8dad-3e57-a464-36b6fe208684",
                                                "text": "[Rome fut] fondée et bâtie par un fratricide et formée par l'assemblage de femmes enlevées par force à leurs parents."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fratricide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cdd972b0-3e13-3357-b19b-aeadea4fd505",
                                        "entry_id": "05ff90c0-13e9-3ed2-b2ae-1c26bc759d57",
                                        "glosses": [
                                            "Meurtre d’un frère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1f0ea9f-db4a-4b94-8dda-374485d939f7",
                                                "sense_id": "cdd972b0-3e13-3357-b19b-aeadea4fd505",
                                                "text": "Tu t’es jeté sur mon épée, et voilà tout. Donc, aux yeux de Dieu et des hommes, je ne suis pas coupable du crime de fratricide ; donc tu n'as pas reçu une mission divine, mais infernale ; donc tu es sorti de la tombe, non comme une ombre sainte, mais comme un spectre maudit, et tu vas rentrer dans ta tombe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
