            {
                "entry_id": "2f87a66e-6da9-357d-ba8a-806d8018a3ef",
                "word": "Sports",
                "pos": "noun",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8bb7f27a-45ec-3332-9899-67f4de615282",
                        "entry_id": "2f87a66e-6da9-357d-ba8a-806d8018a3ef",
                        "glosses": [
                            "ausgelassene Freude (die man an einer bestimmten Beschäftigung, Tätigkeit hat)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c5320b5b-4c45-4d7b-ad00-8194cb23cec5",
                                "sense_id": "8bb7f27a-45ec-3332-9899-67f4de615282",
                                "text": "„Unsere Schildbürger ham in der vergangenen Woche darrem für stief Sports gesorgt.“"
                            },
                            {
                                "example_id": "58047b32-0c05-4018-914b-957fb9f7baa8",
                                "sense_id": "8bb7f27a-45ec-3332-9899-67f4de615282",
                                "text": "„Jong, die Leut´ ham jetzt stief Sports im Lande der Bravourösen und das vor allem in Otjomuise, /Ai//gams, Ovenduka, Zankbrunnnen und wie wir die Hauptstadt sonst noch genannt haben und noch kennen.“"
                            },
                            {
                                "example_id": "4e4daba6-bda8-48fe-b592-85d2f01ab216",
                                "sense_id": "8bb7f27a-45ec-3332-9899-67f4de615282",
                                "text": "„Nach der Wassersperre, die durch ein leidliches Arrangement (sprich Arrahngschemang) mit NamWater wieder aufgehoben wurde, herrscht jetzt (wieder) stief Sports im Stadtrat.“"
                            },
                            {
                                "example_id": "ed4a62a3-79c9-4151-b007-d09394448d46",
                                "sense_id": "8bb7f27a-45ec-3332-9899-67f4de615282",
                                "text": "„Und die jüngste Mannsbild-Figur is natürlich der Trump-Donald, Trumpfkarte der USA, der die Medien net nich laikt, aber der der schreibenden Zunft nochall stief Sports bereiten wird.“"
                            },
                            {
                                "example_id": "2ff1a115-b9d2-4bdb-87a8-af1474623a6b",
                                "sense_id": "8bb7f27a-45ec-3332-9899-67f4de615282",
                                "text": "„Jong, mit unserer Opolifi kannste muhts Sports erleben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87a2a059-661d-4304-89d3-05812b91a67d",
                        "source_entry_id": "2f87a66e-6da9-357d-ba8a-806d8018a3ef",
                        "source_sense_id": "8bb7f27a-45ec-3332-9899-67f4de615282",
                        "source_sense_description": "Namibia umgangssprachlich: ausgelassene Freude",
                        "target_lang_word": "Gaudi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gaudi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83c8f64a-af75-3204-ac48-f264076f0442",
                                        "entry_id": "8f3c6f59-8a53-3f47-b17b-50f4bd5e3539",
                                        "glosses": [
                                            "ausgelassene Freude"
                                        ],
                                        "tags": [
                                            "South-German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "123dd2e4-404c-4635-a771-c87466b9df21",
                                                "sense_id": "83c8f64a-af75-3204-ac48-f264076f0442",
                                                "text": "Bei dem Firmenfest dieses Jahr, wo auch Familien eingeladen werden, hatten die Kinder viel Gaudi gehabt."
                                            },
                                            {
                                                "example_id": "c261ab8b-b4b5-4917-a99a-f685dd2afb1e",
                                                "sense_id": "83c8f64a-af75-3204-ac48-f264076f0442",
                                                "text": "Hänschen hat sich ein Gaudi mit den Ursprung Buam und ihren Liedern gemacht."
                                            },
                                            {
                                                "example_id": "4f232dd1-fcc1-4834-bed4-004e685a2128",
                                                "sense_id": "83c8f64a-af75-3204-ac48-f264076f0442",
                                                "text": "„In Pamplona werden bei der berühmten Fiesta de San Fermin zur Gaudi der Bevölkerung wilde Stiere durch die Altstadtgassen gejagt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "adf536c0-6e49-4db7-a532-e9b76eaded15",
                        "source_entry_id": "2f87a66e-6da9-357d-ba8a-806d8018a3ef",
                        "source_sense_id": "8bb7f27a-45ec-3332-9899-67f4de615282",
                        "source_sense_description": "Namibia umgangssprachlich: ausgelassene Freude",
                        "target_lang_word": "Spaß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spaß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4fa04b7-02b9-3cca-a97d-a7252edd1f23",
                                        "entry_id": "2969e487-db92-3557-8ba2-d4bcae0c08dd",
                                        "glosses": [
                                            "Freude; Vergnügen"
                                        ],
                                        "tags": [
                                            "unzählbar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e46ab5fe-13a9-413c-a49e-2ddf4e522f91",
                                                "sense_id": "f4fa04b7-02b9-3cca-a97d-a7252edd1f23",
                                                "text": "Habt ihr Spaß gehabt?"
                                            },
                                            {
                                                "example_id": "eb3ae098-9d44-49c0-8780-aac3dc6bf623",
                                                "sense_id": "f4fa04b7-02b9-3cca-a97d-a7252edd1f23",
                                                "text": "Die Arbeit macht mir keinen Spaß mehr."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b5b5f13-dd25-3d48-9952-43d6a163f321",
                                        "entry_id": "2969e487-db92-3557-8ba2-d4bcae0c08dd",
                                        "glosses": [
                                            "witzige Aussage oder Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3a2487e-9b96-46e9-8d7e-54b3da67b776",
                                                "sense_id": "0b5b5f13-dd25-3d48-9952-43d6a163f321",
                                                "text": "Da habe ich mir einen Spaß erlaubt."
                                            },
                                            {
                                                "example_id": "1a28e5d7-accc-46f2-851a-d5a4a0626c05",
                                                "sense_id": "0b5b5f13-dd25-3d48-9952-43d6a163f321",
                                                "text": "Das mit „spitzen, spaß, gespessen“ war nur Spaß."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df14440a-c92a-4c95-b47f-430238df5e53",
                        "source_entry_id": "2f87a66e-6da9-357d-ba8a-806d8018a3ef",
                        "source_sense_id": "8bb7f27a-45ec-3332-9899-67f4de615282",
                        "source_sense_description": "Namibia umgangssprachlich: ausgelassene Freude",
                        "target_lang_word": "Vergnügen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vergnügen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd1fa159-8a76-3210-83f7-af1dd01766ef",
                                        "entry_id": "fc828df4-c5d4-34ad-98a8-ecd9d05bc129",
                                        "glosses": [
                                            "Beglückung, helle oder heitere Stimmung, Frohgefühl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4774a241-1926-4690-9e9e-eb0eaf5ff8ac",
                                                "sense_id": "fd1fa159-8a76-3210-83f7-af1dd01766ef",
                                                "text": "Im Schwimmbad hatte er ein großes Vergnügen."
                                            },
                                            {
                                                "example_id": "f2c1ceec-3107-4e9a-9b41-5012ead72388",
                                                "sense_id": "fd1fa159-8a76-3210-83f7-af1dd01766ef",
                                                "text": "„Die ganz großen Vergnügen bereiten die Wochenendausflüge über die Dörfer.“"
                                            },
                                            {
                                                "example_id": "c7a1ce64-73f8-40d7-a4b8-b668f0952f5e",
                                                "sense_id": "fd1fa159-8a76-3210-83f7-af1dd01766ef",
                                                "text": "„Mit Bewunderung und Vergnügen begegnete Franz jetzt immer seinem Reinhold.“"
                                            },
                                            {
                                                "example_id": "e67741fd-7b70-4055-93b2-2109a60feca1",
                                                "sense_id": "fd1fa159-8a76-3210-83f7-af1dd01766ef",
                                                "text": "„Und um Vergnügen geht es hier.“"
                                            },
                                            {
                                                "example_id": "42b024bd-58ff-4cff-9b8a-49e79cc7708c",
                                                "sense_id": "fd1fa159-8a76-3210-83f7-af1dd01766ef",
                                                "text": "„Das von A.J. Hucket verbreitete moderne Bungee-Jumping wird, wie auch das Kine-Swinging, bei dem der Fall in ein Bergsteigerseil in seitwärtigen Pendelbewegungen ausgeschwungen wird, als abenteuerliches Vergnügen, als artistische Herausforderung, als kühne Präzisionskunst, als Mutprobe, als extremes Training der Seele […], als Psychotest verstanden und praktiziert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "69d00d6c-2264-36a4-9b16-bf76592bbb3d",
                                        "entry_id": "fc828df4-c5d4-34ad-98a8-ecd9d05bc129",
                                        "glosses": [
                                            "gesellige Veranstaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd540dfb-f04f-45b2-b72d-d9eec31a92ad",
                                                "sense_id": "69d00d6c-2264-36a4-9b16-bf76592bbb3d",
                                                "text": "Zum Vergnügen gestern Abend konnten wir leider nicht gehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
