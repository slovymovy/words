                "senses": [
                    {
                        "sense_id": "86417d51-efb6-36f2-a9b3-a8c1bcb3cd93",
                        "entry_id": "29bd11d6-6460-394e-9c41-a53e9f1be6f7",
                        "glosses": [
                            "Donner un caractère pharmaceutique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49d9d3b3-92a8-469d-a53e-5e2a7d33697f",
                                "sense_id": "86417d51-efb6-36f2-a9b3-a8c1bcb3cd93",
                                "text": "En Allemagne cette industrialisation se fait à partir d’une activité industrielle déjà existante : quelle est cette activité industrielle, donnez comme exemple le nom d’un médicament produit par cette industrie qui s’est pharmaceutisée."
                            },
                            {
                                "example_id": "e4f669ed-a32b-41b5-ba44-05cd16c5de9e",
                                "sense_id": "86417d51-efb6-36f2-a9b3-a8c1bcb3cd93",
                                "text": "Concernant l'évolution du cursus pharmaceutique, il présente progressivement ses propres spécificités (« se pharmaceutiser »), tels que les textes sont en train."
                            },
                            {
                                "example_id": "28760bc0-ff5d-44c6-82c0-2dd9cad9d96e",
                                "sense_id": "86417d51-efb6-36f2-a9b3-a8c1bcb3cd93",
                                "text": "On s'retraitise, on s'parkinsonnise, on s'alzheimerise, on s'agonise à domicile, on s'pharmaceutise à fond la caisse, on s'docteurise, on s’curise, on s’trop sensibilse à la chaleur, et il nous faudrait des couches trois épaisseurs, donc chères, pour éviter le syndrome \"tatie Danielle\" ! (sic)"
                            }
                        ]
                    }
                ],
