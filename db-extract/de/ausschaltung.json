                "senses": [
                    {
                        "sense_id": "61fa71d8-e3cc-3d6e-8e6f-b05aa9f34c4e",
                        "entry_id": "e78950d9-9253-3900-8d51-73967dee1471",
                        "glosses": [
                            "Stilllegung, Abstellung von Funktionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9632949f-07bc-48f7-bbdb-899fe4cf585e",
                                "sense_id": "61fa71d8-e3cc-3d6e-8e6f-b05aa9f34c4e",
                                "text": "Durch die Ausschaltung diverser Gene kann es passieren, dass es zu Missbildungen kommt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1991899b-0004-3843-8dd9-441ad545de3a",
                        "entry_id": "e78950d9-9253-3900-8d51-73967dee1471",
                        "glosses": [
                            "Bekämpfung, Verbot von Organisationen und Unternehmungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19040f3b-cb20-42ef-badd-b439e08870c7",
                                "sense_id": "1991899b-0004-3843-8dd9-441ad545de3a",
                                "text": "Die systematische Ausschaltung der Parteien, Vereinen und Gewerkschaften verhalf dem Diktator seine Macht zu stärken."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f370441d-3a65-3943-852f-762088f0d109",
                        "entry_id": "e78950d9-9253-3900-8d51-73967dee1471",
                        "glosses": [
                            "eine Schaltung, die die Aufgabe hat eine Anlage auszuschalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a2cd0b5-f4e7-463e-9771-a01c86218182",
                                "sense_id": "f370441d-3a65-3943-852f-762088f0d109",
                                "text": "Die Ausschaltung ist falsch verdrahtet, somit kann die Anlage nicht freigegeben werden."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "91a1cceb-949f-3291-b6af-22d753d1c9ea",
                        "entry_id": "e78950d9-9253-3900-8d51-73967dee1471",
                        "glosses": [
                            "Ermordung, Eliminierung"
                        ],
                        "tags": [
                            "euphemistisch"
                        ],
                        "examples": [
                            {
                                "example_id": "9303736e-ab41-4cfa-acd6-61c4ad512a74",
                                "sense_id": "91a1cceb-949f-3291-b6af-22d753d1c9ea",
                                "text": "Die Ausschaltung des Verräters ist unumgänglich, also findet ihn und macht das Nötige, um ihn loszuwerden."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
