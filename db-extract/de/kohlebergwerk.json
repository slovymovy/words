                "senses": [
                    {
                        "sense_id": "ce53d4e3-b24c-3b5b-a935-85bb260fd993",
                        "entry_id": "70999b4f-bf77-3b37-98ab-fa5c39defc6f",
                        "glosses": [
                            "Bergwerk, in dem Kohle abgebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0021ec6c-e86e-464e-add2-8cb343192838",
                                "sense_id": "ce53d4e3-b24c-3b5b-a935-85bb260fd993",
                                "text": "In den chinesischen Kohlebergwerken kommt es oft zu Unfällen."
                            },
                            {
                                "example_id": "f07c3ad0-5e30-4dfa-96bf-9dd48b255242",
                                "sense_id": "ce53d4e3-b24c-3b5b-a935-85bb260fd993",
                                "text": "„Eine gute Idee, denn dort konnte er ein erfolgreiches Kohlebergwerk sowie – wichtiger noch – eine Eisenbahnlinie zum Abtransport der geförderten Kohle gründen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
