                    }
                ],
                "senses": [
                    {
                        "sense_id": "bad6e61a-2255-3c88-becb-4d31711d8df3",
                        "entry_id": "3d154b32-ac1f-3712-8ea2-bc2aeecd7301",
                        "glosses": [
                            "butterähnliches Nahrungsmittel, das (vorwiegend) aus pflanzlichen Fetten hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9ce0229-3ab3-4a40-a1e7-648504d74ee3",
                                "sense_id": "bad6e61a-2255-3c88-becb-4d31711d8df3",
                                "text": "Butter habe ich keine im Haus, du musst Margarine nehmen."
                            },
                            {
                                "example_id": "8531d76e-a075-4a7f-90fb-edd149dbab27",
                                "sense_id": "bad6e61a-2255-3c88-becb-4d31711d8df3",
                                "text": "Anstelle von Butter kann man auch mit Margarine braten und backen."
                            },
                            {
                                "example_id": "8060b1b7-e9af-4d2d-a551-16b431d3563c",
                                "sense_id": "bad6e61a-2255-3c88-becb-4d31711d8df3",
                                "text": "„Meine Großmutter war gegen Margarine und begründete dies mit Argumenten, von denen sie nicht mehr abließ.“"
                            },
                            {
                                "example_id": "929b5d3f-ced7-463e-9253-4e50af609063",
                                "sense_id": "bad6e61a-2255-3c88-becb-4d31711d8df3",
                                "text": "„Ich esse mein Brot mit Margarine und Pflaumenmarmelade.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "871e83b1-634b-47eb-8b02-c027e033e575",
                        "source_entry_id": "3d154b32-ac1f-3712-8ea2-bc2aeecd7301",
                        "source_sense_id": "bad6e61a-2255-3c88-becb-4d31711d8df3",
                        "source_sense_description": "butterähnliches Nahrungsmittel",
                        "target_lang_word": "margarine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "margarine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2253f8b2-49f5-3ccf-8cad-878ecee29bad",
                                        "entry_id": "e3cc3edd-de81-3f64-ad38-a5161fd8f69e",
                                        "glosses": [
                                            "A spread, manufactured from a blend of vegetable oils (some of which are hydrogenated), emulsifiers etc, mostly used as a substitute for butter."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f85f6356-804e-39df-a504-602163ddbdac",
                                        "entry_id": "e3cc3edd-de81-3f64-ad38-a5161fd8f69e",
                                        "glosses": [
                                            "The solid ingredient of human fat, olive oil, etc."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "margarine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28dd7eba-8065-376b-92fe-64cfc0a443b1",
                                        "entry_id": "d18034d0-4616-3708-ba91-c0d74ef21a77",
                                        "glosses": [
                                            "To spread or cover (something) with margarine."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc664b9b-2556-4ebb-af06-218a68c012fe",
                                                "sense_id": "28dd7eba-8065-376b-92fe-64cfc0a443b1",
                                                "text": "Putting the finishing touches on her party dinner, this attractive hostess does the last minute job of margarining her rolls to serve piping hot to her guests."
                                            },
                                            {
                                                "example_id": "997a8925-6cfd-49cb-8f35-ae35d2c7f025",
                                                "sense_id": "28dd7eba-8065-376b-92fe-64cfc0a443b1",
                                                "text": "She is margarining a slice of bread, rubbing the grease carefully into the crumb."
                                            },
                                            {
                                                "example_id": "d0479c0d-04a3-486f-bfa2-91fff9ddaccc",
                                                "sense_id": "28dd7eba-8065-376b-92fe-64cfc0a443b1",
                                                "text": "Now that she was back in the land of the living, she took to margarining our toast again."
                                            },
                                            {
                                                "example_id": "4148c7da-d02e-4887-af8d-e0afb2b52381",
                                                "sense_id": "28dd7eba-8065-376b-92fe-64cfc0a443b1",
                                                "text": "He has been totally occupied since we sat down, margarining every inch of his roll, likewise his baked potato, salting down everything in sight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "947a9772-8d4c-4c37-a5bd-e075864ee0b6",
                        "source_entry_id": "3d154b32-ac1f-3712-8ea2-bc2aeecd7301",
                        "source_sense_id": "bad6e61a-2255-3c88-becb-4d31711d8df3",
                        "source_sense_description": "butterähnliches Nahrungsmittel",
                        "target_lang_word": "margarine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "margarine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "49e16371-c036-3576-963b-ad0c44c27ae4",
                                        "entry_id": "7c177fa1-2fca-3740-ad14-61b29afd3e38",
                                        "glosses": [
                                            "Matière grasse alimentaire composée de graisses et d’huiles (hydrogénées ou non) dispersées dans de l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3800e76-c4bd-4990-a79e-4e63e91137f5",
                                                "sense_id": "49e16371-c036-3576-963b-ad0c44c27ae4",
                                                "text": "La margarine est initialement un dérivé animal, développé en France sous le Second Empire pour fournir aux pauvres une graisse bon marché."
                                            },
                                            {
                                                "example_id": "ee027b28-bc1b-4fdf-bcbe-34718ddbde05",
                                                "sense_id": "49e16371-c036-3576-963b-ad0c44c27ae4",
                                                "text": "Concernant les délais de consommation, le beurre et la margarine sont les produits pour lesquels les Français s’autorisent le plus de libertés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c163bc9-f1c4-32bc-8a86-88b133578bd6",
                                        "entry_id": "7c177fa1-2fca-3740-ad14-61b29afd3e38",
                                        "glosses": [
                                            "Corps d’une couleur nacrée que l’on trouve dans le suif de mouton, dans l’axonge et dans quelques autres graisses animales."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
