                        "examples": [
                            {
                                "example_id": "b5b1af0b-6d1b-4c78-9ad6-beb160a5600f",
                                "sense_id": "c01ea270-1f0c-367f-a459-dfdafa134d87",
                                "text": "Sie ließen die Urkunde im Notariat bekundigen."
