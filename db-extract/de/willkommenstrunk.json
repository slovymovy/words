                "senses": [
                    {
                        "sense_id": "ecae75cb-34ed-3bf9-aac5-ce162b0488a9",
                        "entry_id": "9d4bbb11-d5e7-3b21-89ce-dbc25dcc420e",
                        "glosses": [
                            "ein Getränk, das einer Person angeboten beziehungsweise gegeben wird, wenn man sie begrüßt, willkommen heißt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "242c683c-3c45-4f6b-b881-35a84599eb0b",
                                "sense_id": "ecae75cb-34ed-3bf9-aac5-ce162b0488a9",
                                "text": "Ein Willkommenstrunk wird von vielen als höflich erachtet."
                            },
                            {
                                "example_id": "0ee39da1-8ec3-44bb-a48d-7614b4faf943",
                                "sense_id": "ecae75cb-34ed-3bf9-aac5-ce162b0488a9",
                                "text": "Als seine Familie daheim ankam, hieß er sie mit einem warmen Willkommenstrunk willkommen."
                            },
                            {
                                "example_id": "1deaeac3-e7d1-45f3-8e66-18a1175f7140",
                                "sense_id": "ecae75cb-34ed-3bf9-aac5-ce162b0488a9",
                                "text": "Wie viele Willkommenstrünke sie schon angeboten bekam, konnte sie nicht sagen."
                            }
                        ],
                        "sense_index_json": "\"1\""
