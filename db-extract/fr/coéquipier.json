                                "target_senses": [
                                    {
                                        "sense_id": "fbfce9b0-06d1-378b-941f-d6e807f4985d",
                                        "entry_id": "7993f4da-960c-3c29-9423-bfbff62b808f",
                                        "glosses": [
                                            "Person, die im selben Team ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93420606-6b49-415f-8186-b89d79b54607",
                                                "sense_id": "fbfce9b0-06d1-378b-941f-d6e807f4985d",
                                                "text": "Sein Teamkollege schoss bei dem letzten Fußballspiel drei Tore."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a1dfb3b-a3e1-4afc-b0dd-b2d0ade83750",
                        "source_entry_id": "7b8ea8b4-315b-35fd-967a-90a7a62c731b",
                        "source_sense_id": "0582e2df-06b6-3cf7-a47a-d39f5555c21f",
                        "target_lang_word": "Mannschaftskamerad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1d775ae6-0840-4e99-ad57-173b4b4f490b",
                        "source_entry_id": "7b8ea8b4-315b-35fd-967a-90a7a62c731b",
                        "source_sense_id": "0582e2df-06b6-3cf7-a47a-d39f5555c21f",
                        "target_lang_word": "Mitspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitspieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66d6467d-69d1-3cda-a1b0-4e634e313e72",
                                        "entry_id": "a3f70945-e07b-300d-9263-12a803da5001",
                                        "glosses": [
                                            "derjenige, der an einem Sport-, Gesellschafts- oder sonstigen Spiel aktiv teilnimmt"
                                        ],
                                        "tags": [
                                            "Gesellschaftsspiele"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0e44b3e-01f6-4e67-a1fb-c00d604c0471",
                                                "sense_id": "66d6467d-69d1-3cda-a1b0-4e634e313e72",
                                                "text": "„Im Training brachte er so schon mit vielen schönen Toren die Mitspieler zum Staunen.“"
                                            },
                                            {
                                                "example_id": "6c1be720-8d7f-4a53-b345-c1f00583f05c",
                                                "sense_id": "66d6467d-69d1-3cda-a1b0-4e634e313e72",
                                                "text": "„Das Vorspiel, wie wir es kennengelernt haben, kann auch dem Sichkennenlernen der Mitspieler und dem Ausprobieren der Spielmöglichkeiten dienen.“"
                                            },
                                            {
                                                "example_id": "0ddcb195-fbdd-4bcd-81c5-ffaa6541643f",
                                                "sense_id": "66d6467d-69d1-3cda-a1b0-4e634e313e72",
                                                "text": "„Macht ein Mitspieler einen Sünder auf seine Fehler aufmerksam, so dass dieser noch korrigieren kann und der Spielgesellschaft die anstehenden Bußgelder verlustig gehen, so zahlt er 10 Strafpunkte.“"
                                            },
                                            {
                                                "example_id": "e92c5de9-09ac-4868-9aa5-5cad540524a0",
                                                "sense_id": "66d6467d-69d1-3cda-a1b0-4e634e313e72",
                                                "text": "„Wer sich jedoch eine Basiskompetenz im Spielen angeeignet hat, gerät auch an scheinbar spielfeindlichen, anregungsarmen Orten, auch ohne jegliches Spielgerät, auch ohne Mitspieler nicht in Verlegenheit, zu sinnvollem Spielen zu finden.“"
                                            },
                                            {
                                                "example_id": "60104eb4-6083-4516-af66-bbc396c242ce",
                                                "sense_id": "66d6467d-69d1-3cda-a1b0-4e634e313e72",
                                                "text": "„Der Internet-Anschluss ermöglicht nicht nur das Nachladen von neuen Spielvarianten, sondern verweist auch auf die Zukunft, in der die traditionellen Konsolenspiele mit interaktiven Netzspielen eine neue Verbindung eingehen sollen - dann kämpft man nicht mehr gegen maschinelle Gegner, sondern übers Internet gegen einen menschlichen Mitspieler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1427343-bc1a-48f2-b8cf-5f592a37e5d5",
                        "source_entry_id": "7b8ea8b4-315b-35fd-967a-90a7a62c731b",
                        "source_sense_id": "0582e2df-06b6-3cf7-a47a-d39f5555c21f",
                        "target_lang_word": "Kollege",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kollege",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ea6b9ad-5dfd-327a-b1a0-2f1234147682",
                                        "entry_id": "43d91d24-b6be-3178-b001-e0e53dc1cc06",
                                        "glosses": [
                                            "Person, die im gleichen Unternehmen, in der gleichen Organisation, Einrichtung tätig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c36d64f4-7d69-4260-8a6d-d91abd7b3afd",
                                                "sense_id": "4ea6b9ad-5dfd-327a-b1a0-2f1234147682",
                                                "text": "Liebe Kolleginnen und Kollegen, ich begrüße euch alle herzlich zu unserer Betriebsversammlung."
                                            },
                                            {
                                                "example_id": "7c59e99c-7eff-498c-83af-f787167fe4b6",
                                                "sense_id": "4ea6b9ad-5dfd-327a-b1a0-2f1234147682",
                                                "text": "Frag doch mal deine Kollegen, ob sie zum Grillabend kommen wollen."
                                            },
                                            {
                                                "example_id": "41acaa11-0d4d-4e7b-b5c3-a9fbaf1db566",
                                                "sense_id": "4ea6b9ad-5dfd-327a-b1a0-2f1234147682",
                                                "text": "Kollege Bleibein hat mal wieder kein Papier in den Drucker eingelegt."
                                            },
                                            {
                                                "example_id": "1953576a-f803-431b-ab24-5c65872d6081",
                                                "sense_id": "4ea6b9ad-5dfd-327a-b1a0-2f1234147682",
                                                "text": "Die Kollegen haben zu meinem Geburtstag alle zusammengeschmissen und mir einen Porsche geschenkt."
                                            },
                                            {
                                                "example_id": "8287d3b3-1fda-4970-acd0-10f200cec493",
                                                "sense_id": "4ea6b9ad-5dfd-327a-b1a0-2f1234147682",
                                                "text": "„Die Archäologen arbeiteten bei der Erforschung und Interpretation der Funde mit zahlreichen Kollegen aus Nachbardisziplinen zusammen.“"
                                            },
                                            {
                                                "example_id": "907aea4b-1b29-4577-9e94-dc325d339d25",
                                                "sense_id": "4ea6b9ad-5dfd-327a-b1a0-2f1234147682",
                                                "text": "[Bundesaußenminister Frank-Walter] Steinmeier erläuterte, wie er seinen griechischen Kollegen[, den griechischen Außenminister Nikos Kotzias,] direkt angesprochen habe: Auch für andere Länder am Verhandlungstisch sei es – so der deutsche Minister – manchmal nicht einfach, einem Kompromiss im Sinne der gemeinsamen europäischen Linie zuzustimmen."
                                            },
                                            {
                                                "example_id": "3b92673b-a18e-4d95-bc5a-89a617058c64",
                                                "sense_id": "4ea6b9ad-5dfd-327a-b1a0-2f1234147682",
                                                "text": "Eine 22 Jahre alte Polizistin ist gestern in Heilbronn durch mehrere Kopfschüsse getötet worden. Ihr 24-jähriger Kollege ist sehr schwer verletzt und nicht ansprechbar, nachdem ihm ebenfalls in den Kopf geschossen worden war."
                                            },
                                            {
                                                "example_id": "735ac6a3-affb-4e5e-af28-9119c4b39e0b",
                                                "sense_id": "4ea6b9ad-5dfd-327a-b1a0-2f1234147682",
                                                "text": "„Fündig wurden die Kollegen in Wentorf: In der Hauptstraße und in der Hamburger Landstraße nahmen ihre Suchgeräte einen leichten Gasgeruch wahr. Um die Lecks genau zu lokalisieren, legte man die Gasrohre nach und nach frei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2a58df13-6045-388a-b696-16599944391a",
                                        "entry_id": "43d91d24-b6be-3178-b001-e0e53dc1cc06",
                                        "glosses": [
                                            "Person, die im gleichen Beruf (aber in einem anderen Unternehmen) tätig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8d75bc1-aac2-4edb-bf35-9bc836fb4514",
                                                "sense_id": "2a58df13-6045-388a-b696-16599944391a",
                                                "text": "„Da wird den Jungen etwa beigebracht, dass es als «Akt des mangelnden Respekts und der Unhöflichkeit» empfunden werde, wenn man einen andern Anwalt mit «Sehr geehrter Herr Soundso» anschreibe statt mit «Sehr geehrter Herr Kollege».“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "113e90ef-19f3-3625-9144-54241563dbaa",
                                        "entry_id": "43d91d24-b6be-3178-b001-e0e53dc1cc06",
                                        "glosses": [
                                            "befreundete Person"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f8487e0-92c7-469c-9ba3-c040e266cdc6",
                                                "sense_id": "113e90ef-19f3-3625-9144-54241563dbaa",
                                                "text": "„Drogen und Freundschaft – mein Kollege ist schwer zugänglich. Was könnte ich bloss tun, um ihm zu helfen, aus dieser Schlaufe heraus zu kommen?“"
                                            },
                                            {
                                                "example_id": "76acf630-d247-4b27-87c5-3efb47896d47",
                                                "sense_id": "113e90ef-19f3-3625-9144-54241563dbaa",
                                                "text": "„«Mein Kollege musste dringend aufs WC» [Titel; später:] «Mein Freund musste aufs WC, deshalb haben wir in einem Restaurant in Einsiedeln einen Halt gemacht», begründete der Angeklagte diesen vermeintlichen Umweg.“"
                                            },
                                            {
                                                "example_id": "0538f047-bfbe-4d03-ab7d-476f285e687f",
                                                "sense_id": "113e90ef-19f3-3625-9144-54241563dbaa",
                                                "text": "„Helvetische Beziehungen? «Gschpäändli, Koleege, Fründ.» Beziehungsbezeichnungen im Schweizerdeutschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7b9fe79-7f44-49bd-8ef9-1b37ce7b421b",
                        "source_entry_id": "7b8ea8b4-315b-35fd-967a-90a7a62c731b",
                        "source_sense_id": "0582e2df-06b6-3cf7-a47a-d39f5555c21f",
                        "target_lang_word": "Mannschaftskollege",
