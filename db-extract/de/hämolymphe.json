                                "example_id": "d4b01ca0-5576-4165-871b-9c4bc316d7f2",
                                "sense_id": "882a7cd2-c161-3e61-ae33-cde39622f183",
                                "text": "Die Hämolymphe der Insekten hat eine ähnliche Funktion wie das Blut bei Säugetieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
