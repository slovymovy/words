                    {
                        "translation_id": "ada4702b-3c7f-4347-a699-715bf17b1861",
                        "source_entry_id": "6a5b0994-a1aa-3d94-9355-c7e21986b543",
                        "source_sense_id": "396455c9-c183-3c59-8516-315d7459f1a0",
                        "source_sense_description": "Botanik: die äußere Zellschicht des Vegetationskegels der Pflanzen",
                        "target_lang_word": "tunica",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tunica",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47f74634-78f6-3a48-9cf7-f1580bb5782b",
                                        "entry_id": "6959a2b9-c753-364c-81ae-907c18b24fcd",
                                        "glosses": [
                                            "Synonym of tunic (“garment”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0990f2ac-2f2b-4c18-8126-65df5b1ce041",
                                                "sense_id": "47f74634-78f6-3a48-9cf7-f1580bb5782b",
                                                "text": "The tunica is made of a very rich material, plain silk or brocade, with an ornamental border, and over it is the paludamentum or semicircular cloak which was coming into very general use at this period. The collar is a separate article, and is of rich embroidery to match that on the bottom of the tunica."
                                            },
                                            {
                                                "example_id": "2bb7d81e-0183-48af-93d6-b2edcfe01943",
                                                "sense_id": "47f74634-78f6-3a48-9cf7-f1580bb5782b",
                                                "text": "I was being drawn up into the clouds, and Papinian, who in my vision was wearing a tunica of light, was fluttering about, his butterfly wings flapping noisily."
                                            },
                                            {
                                                "example_id": "3d1d3844-1c49-44ab-9bdf-2f39308ee934",
                                                "sense_id": "47f74634-78f6-3a48-9cf7-f1580bb5782b",
                                                "text": "It was then that I noticed some of them were wearing tunicas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b607f088-014e-33d2-964b-c33e51ad65a7",
                                        "entry_id": "6959a2b9-c753-364c-81ae-907c18b24fcd",
                                        "glosses": [
                                            "Synonym of tunic (“covering”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9880320-1e05-48f8-926f-fe73974cf06a",
                                                "sense_id": "b607f088-014e-33d2-964b-c33e51ad65a7",
                                                "text": "Ecto- and endotunicae thin, hardly discernable as two tunicae in unreleased, unstained asci; without zonation and ring structures; ocular chamber indistinct."
                                            },
                                            {
                                                "example_id": "cf93dc49-9f6e-4e3a-a357-c405860cac48",
                                                "sense_id": "b607f088-014e-33d2-964b-c33e51ad65a7",
                                                "text": "The hyaloid system and its associated vascular tunicas are responsible for providing vascular and metabolic support to the lens during embryological development."
                                            },
                                            {
                                                "example_id": "1c20e62e-15b2-417d-b589-2d337a261d00",
                                                "sense_id": "b607f088-014e-33d2-964b-c33e51ad65a7",
                                                "text": "Fig. 15.5 Tunicae of arteries and veins showing the thicker walls of the arteries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
