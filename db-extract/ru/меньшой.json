                "senses": [
                    {
                        "sense_id": "095b3b6d-b999-3bf6-ae0e-c6bfaebf2a3a",
                        "entry_id": "eca3c970-5f5b-3bab-a210-7c26c96b2d50",
                        "glosses": [
                            "нар.-разг. то же, что младший"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "579e58f9-7baf-4bab-a49d-f8a56588ced5",
                                "sense_id": "095b3b6d-b999-3bf6-ae0e-c6bfaebf2a3a",
                                "text": "Вид меньшого брата непосредственно располагал его к веселости."
                            },
                            {
                                "example_id": "136dae22-8e35-4eec-9cdb-8eb9b3f1e384",
                                "sense_id": "095b3b6d-b999-3bf6-ae0e-c6bfaebf2a3a",
                                "text": "Не печалься, батюшка, — говорит меньшая дочь. — Бог даст, мне и там хорошо будет!"
                            },
                            {
                                "example_id": "cc817399-ee97-486a-84ca-da21fb01a909",
                                "sense_id": "095b3b6d-b999-3bf6-ae0e-c6bfaebf2a3a",
                                "text": "Меньшой был слаб и нежен с юных дней, // Как цвет весенний под лучом заката! // Чуждался битв и крови он и зла, // Но искра в нём таилась… и ждала…"
                            }
                        ]
                    }
