                        "target_lang_word": "kayakista",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "aff18b6f-2cc3-4eb6-9afb-b000347ee488",
                        "source_entry_id": "cfc6b245-c978-3f6e-b1a8-44159a7e1236",
                        "source_sense_id": "b7a29481-9994-3d38-8903-367415cf40ae",
                        "source_sense_description": "Person, die ein Kajak fährt",
                        "target_lang_word": "байдарочник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "байдарочник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "af3a4737-9cab-3d6e-8ee3-74b25c0f0801",
                                        "entry_id": "a45440d3-b989-3c60-bf16-3310fac186a5",
                                        "glosses": [
                                            "тот, кто имеет байдару, байдарку, плавает на ней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcffbad2-c019-444d-820c-2b458c9dd341",
                                                "sense_id": "af3a4737-9cab-3d6e-8ee3-74b25c0f0801",
                                                "text": "Человек, который разговаривал с гиляками, был байдарочник алеут Михаил Иванович."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14435fc7-16b5-3150-801c-4be80a5b84b4",
                                        "entry_id": "a45440d3-b989-3c60-bf16-3310fac186a5",
                                        "glosses": [
                                            "спорт. тот, кто профессионально занимается или увлекается греблей на байдарке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b5ce812-17fc-4047-bc74-7e764cea8856",
                                                "sense_id": "14435fc7-16b5-3150-801c-4be80a5b84b4",
                                                "text": "В поселке Чуш в тот вечер вообще было неспокойно ― плач, визг, бегал с ружьем по улицам Командор, отыскивая погубителя дочери; на другом конце селения крушил домашний скарб Грохотало, на Енисее тонули какие-то байдарочники."
                                            },
                                            {
                                                "example_id": "2e9ac611-14b8-4712-a023-57d9d84f8ffa",
                                                "sense_id": "14435fc7-16b5-3150-801c-4be80a5b84b4",
                                                "text": "Пройдя пролив, байдарочники сразу же меняют курс и идут на юго-восток, в небольшой залив, где на стоянке, благоустроенной ранее туристами и местными рыбаками, разбивают лагерь и останавливаются на ночёвку и днёвку."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
