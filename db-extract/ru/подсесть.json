                        ],
                        "examples": [
                            {
                                "example_id": "2b1386f4-1507-451a-815c-a03cbe312b56",
                                "sense_id": "012c558b-64f1-34fb-9a36-e95fb6d102b5",
                                "text": "подсе́сть на иглу́",
                                "translation": "to get hooked; (figurative) to become dependent [with genitive ‘on something’]",
                                "english": "to get hooked; (figurative) to become dependent [with genitive ‘on something’]"
                            }
                        ]
