                                    {
                                        "sense_id": "a0714e6a-3377-32e8-90d5-df28421f2bd2",
                                        "entry_id": "972651cf-307b-30c2-91b9-5cea79d55554",
                                        "glosses": [
                                            "Vergütung, die Künstler erhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf1e641d-326e-4a82-89b9-02ee465172a2",
                                                "sense_id": "a0714e6a-3377-32e8-90d5-df28421f2bd2",
                                                "text": "Die Schauspieler spendeten ihre Gage an diesem Abend für einen wohltätigen Zweck."
                                            },
                                            {
                                                "example_id": "847e6638-1451-4130-8125-75cfd357322a",
                                                "sense_id": "a0714e6a-3377-32e8-90d5-df28421f2bd2",
                                                "text": "„Ich fand die Idee ziemlich pervers, dass echte syrische Kriegsflüchtlinge in Deutschland in einer amerikanischen Filmproduktion noch einmal ihre Vertreibung und Flucht, diesmal aber gegen Gage, nachspielten.“"
                                            },
                                            {
                                                "example_id": "cea4edf2-53ed-4b34-9793-160f590d0323",
                                                "sense_id": "a0714e6a-3377-32e8-90d5-df28421f2bd2",
                                                "text": "„Ich verließ als einer der letzten zusammen mit dem Leiter das Lokal, nach der Tagesabrechnung und der Auszahlung der Gage an mich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Gage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88fbf66d-0143-37da-9db9-6cfc42b97d32",
