                        "examples": [
                            {
                                "example_id": "7a707f85-a0a8-4e2e-807f-d3ec158d22a7",
                                "sense_id": "b37feb16-c532-3023-81c1-3818679f9bfa",
                                "text": "Die deutsche Mannschaft, die die Schwedenstaffel am ersten Tage gegen die Ungarn verloren hatte, konnte in der Olympischen Staffel den Spieß umdrehen.",
                                "translation": "The German team that had lost the Swedish relay on the first day against the Hungarians could turn the tables during the Olympic relay.",
                                "english": "The German team that had lost the Swedish relay on the first day against the Hungarians could turn the tables during the Olympic relay."
                            },
                            {
                                "example_id": "234824fd-5f42-48aa-8b50-cf1140829c49",
                                "sense_id": "b37feb16-c532-3023-81c1-3818679f9bfa",
                                "text": "Der mehrfache Olympiasieger [Michael Johnson] startet als Schlussläufer in einer so genannten Schwedenstaffel.",
                                "translation": "The multiple Olympic champion [Michael Johnson] is participating as the anchor in a so-called Swedish relay.",
                                "english": "The multiple Olympic champion [Michael Johnson] is participating as the anchor in a so-called Swedish relay."
                            },
                            {
                                "example_id": "4ca7bb16-f69a-484d-bea9-80f11e771f7c",
                                "sense_id": "b37feb16-c532-3023-81c1-3818679f9bfa",
                                "text": "Für den Einsatz in der Vereinsstaffel verzichtete er [Henry Guthmann] bei den Skagerrak-Gedächtnisspielen in Wilhelmshaven auf einen »sicheren Sieg im 800-m-Lauf«, um in der Schwedenstaffel gegen den norddeutschen 800m-Meister Breidenbach anzutreten.",
                                "translation": "To play in the club relay, he [Henry Guthmann] gave up his \"sure victory in the 800 m race\" at the Skagerrak Memorial Games in order to compete in the Swedish relay against the North German 800 m champion Breidenbach.",
                                "english": "To play in the club relay, he [Henry Guthmann] gave up his \"sure victory in the 800 m race\" at the Skagerrak Memorial Games in order to compete in the Swedish relay against the North German 800 m champion Breidenbach."
                            }
                        ]
