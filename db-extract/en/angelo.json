                    {
                        "sense_id": "f2fcf335-7dd9-3470-8239-825ea45d0ac5",
                        "entry_id": "0148f778-8f8b-3f1a-8584-2272cf819641",
                        "glosses": [
                            "A male given name from Italian."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "461eabdc-3036-471a-891c-7e35b741efb7",
                                "sense_id": "f2fcf335-7dd9-3470-8239-825ea45d0ac5",
                                "text": "I haue deliuerd to Lord Angelo / (A man of ſtricture and firme abſtinence) / My abſolute power, and place here in Vienna,"
                            },
                            {
                                "example_id": "6efc774a-d907-4d4c-8acf-db66aa0b23e5",
                                "sense_id": "f2fcf335-7dd9-3470-8239-825ea45d0ac5",
                                "text": "Luigi — Angelo. They're lovely names; and so grand and foreign — not like Jones and Robinson and such."
                            }
                        ]
                    },
