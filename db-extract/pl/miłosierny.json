                        "cross_references": [
                            {
                                "target_word": "miséricordieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a7544fe-4a34-3100-a12c-b7d9d154f624",
                                        "entry_id": "01be458d-385b-3ac9-a399-dcaeea238f26",
                                        "glosses": [
                                            "Qui a de la miséricorde ; qui est enclin à la miséricorde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b23eedf-d1c0-4235-aa0a-90fef7037c15",
                                                "sense_id": "2a7544fe-4a34-3100-a12c-b7d9d154f624",
                                                "text": "Il songeait à la Vierge […]. Par delà les âges, Elle demeurait l’éternelle orante et l’éternelle suppliée ; miséricordieuse et reconnaissante, à la fois ; miséricordieuse pour ces infortunes qu’Elle allégeait et reconnaissante envers elles."
                                            },
                                            {
                                                "example_id": "770b9742-d553-4315-95ff-4bf77874d2d3",
                                                "sense_id": "2a7544fe-4a34-3100-a12c-b7d9d154f624",
                                                "text": "La chose la plus miséricordieuse en ce bas monde est l’incapacité de l’esprit humain à mettre en corrélation toutes les informations qu’il contient."
                                            },
                                            {
                                                "example_id": "88ba3b7c-3470-4a60-b6e0-37babf25f6a3",
                                                "sense_id": "2a7544fe-4a34-3100-a12c-b7d9d154f624",
                                                "text": "L’enfer prouve que Dieu n’est ni bon, ni miséricordieux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "miséricordieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a113399-db32-36c2-8b55-95706106d427",
                                        "entry_id": "c192001f-320f-3870-a5cb-0bd829867c97",
                                        "glosses": [
                                            "Personne encline à la miséricorde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fec91e7-4859-4d08-9426-dbcda3f6974e",
                                                "sense_id": "7a113399-db32-36c2-8b55-95706106d427",
                                                "text": "L’évangile dit : Bienheureux sont les miséricordieux, car ils obtiendront miséricorde."
                                            },
                                            {
                                                "example_id": "ef677d8e-6907-4784-976a-c4000ee42733",
                                                "sense_id": "7a113399-db32-36c2-8b55-95706106d427",
                                                "text": "Un modeste, un miséricordieux, mettent la paix autour d’eux, dissipent la crainte, raniment les courages fléchissants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
