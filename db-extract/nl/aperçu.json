                        "examples": [
                            {
                                "example_id": "1338e596-42b1-4417-95ea-a7deba1c4937",
                                "sense_id": "ad3f22e6-6734-34ea-95fa-6cf64131b3ca",
                                "text": "Het aforisme, het als een flits oplichtende aperçu, observatie of inval, is de motor van beider verbeelding en die verbeelding werkt hoofdzakelijk in de vorm van een zelfanalyse, in de poging, zo omschreef Hermans het, te kijken achter de borden ‘Verboden Toegang’ die men zelf had neergezet."
                            },
                            {
                                "example_id": "c2aedd64-725e-4d53-a280-d5c448bb6b67",
                                "sense_id": "ad3f22e6-6734-34ea-95fa-6cf64131b3ca",
                                "text": "Ziet hier 't aperçu van eenen roman, dien Ref. oordeelt, dat veelzijdig nut kan stichten, en dien hij gaarne menig jeugdig leeraar in handen zou geven."
                            }
                        ]
