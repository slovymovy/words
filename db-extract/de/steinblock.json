                ],
                "senses": [
                    {
                        "sense_id": "6252fcbe-11ba-36ef-b030-2c08d78e4313",
                        "entry_id": "b495d70f-599f-38cc-8978-d99dd7b4f8fe",
                        "glosses": [
                            "ein aus Stein bestehender Block"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11f49b21-bdb9-4626-983a-8003c2f82503",
                                "sense_id": "6252fcbe-11ba-36ef-b030-2c08d78e4313",
                                "text": "„In Griechenland wurden die Erdhügel (tumuli) der archaischen Grabmale durch flache Steinblöcke, Grabtische, ersetzt, von denen im 4. Jahrhundert v. Chr. aller Luxus bis auf die Inschriftstelen (oft mit Flachrelief) verbannt wurde.“"
                            },
                            {
                                "example_id": "d9dee8b1-dc1d-4586-96e3-90d5d222df7f",
                                "sense_id": "6252fcbe-11ba-36ef-b030-2c08d78e4313",
                                "text": "„Die Azteken passten bei ihren Bauten die Steinblöcke in ein kunstvolles Muster ein.“"
                            },
                            {
                                "example_id": "14951261-86fc-4b28-b699-24799e2d3418",
                                "sense_id": "6252fcbe-11ba-36ef-b030-2c08d78e4313",
                                "text": "„Der Tempel von Tarxien im Südosten Maltas zeichnet sich vor allem durch seine in die Steinblöcke gravierten Spiralmuster und Tierreliefs aus."
                            },
                            {
                                "example_id": "f8694b54-6c37-4c58-b843-390b88111e75",
                                "sense_id": "6252fcbe-11ba-36ef-b030-2c08d78e4313",
                                "text": "„Unter dem Viereck gewaltiger Steinblöcke sollen sich einige Grabkammern befinden, in denen angeblich reich verzierte Tongefäße wie auch menschliche Knochen und Schädel entdeckt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
