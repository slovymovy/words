                "senses": [
                    {
                        "sense_id": "d4f2175e-2ceb-344e-bc29-fa553e26e56a",
                        "entry_id": "a9e40525-7d35-3103-bdc5-e8c23b054ff1",
                        "glosses": [
                            "elektronisches Gerät, mit dem menschliche Sprache verschlüsselt, moduliert und übertragen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1627587-ce30-42f9-8d69-5680760eaa25",
                                "sense_id": "d4f2175e-2ceb-344e-bc29-fa553e26e56a",
                                "text": "„Im Gedächtnis bleiben dem Hörer das jazzige Saxofon, die durch einen Vocoder gezogene Popstimme, der Dancefloor-Rhythmus.“"
                            },
                            {
                                "example_id": "2f3b13f3-3d6b-4129-bca0-bd459eca4301",
                                "sense_id": "d4f2175e-2ceb-344e-bc29-fa553e26e56a",
                                "text": "„Allein auf ‚Equinoxe‘ tauchen neben elektronischer Orgel, Keyboard-Computer, Mellotron, drei Sequenzern, Korg Polyphonic Ensemble, Rhythmuscomputer und einem Vocoder nicht weniger als sechs verschiedene Synthesizer auf.“"
                            },
                            {
                                "example_id": "daa9a727-2907-43df-a88f-38f360ed8651",
                                "sense_id": "d4f2175e-2ceb-344e-bc29-fa553e26e56a",
                                "text": "„Es gibt ein elektronisches Piano mit reichlich Hall, flehenden Gesang, Gitarrensoli, Saxophon und Vocoder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
