                    {
                        "translation_id": "1e2de1a1-d88f-4ea1-ba63-fc3d0e014484",
                        "source_entry_id": "3aa14b13-d058-36d5-9836-523c49e3b8b0",
                        "target_lang_word": "apparemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apparemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95cd48d3-2ee7-3320-b9e3-91a70f95ffe7",
                                        "entry_id": "0946bf74-62ab-3692-a1ef-41ad2eb15a7b",
                                        "glosses": [
                                            "Manifestement, assurément."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "note": "Ce sens a vieilli, il a été très utilisé autrefois",
                                        "examples": [
                                            {
                                                "example_id": "f6259e72-bedc-4043-9675-d86b264b7220",
                                                "sense_id": "95cd48d3-2ee7-3320-b9e3-91a70f95ffe7",
                                                "text": "Un psaume qui apparemment est de Salomon."
                                            },
                                            {
                                                "example_id": "2dd64e9d-7349-4725-8b28-8e2a3c3c8dd5",
                                                "sense_id": "95cd48d3-2ee7-3320-b9e3-91a70f95ffe7",
                                                "text": "Quoi qu’il en soit, deux choses sont assurées, l’une que le miracle de l’apparition de l’étoile servit de règle à Hérode pour étendre son massacre ; l’autre que celui qu’il cherchait fut le seul apparemment qui lui échappa."
                                            },
                                            {
                                                "example_id": "00735d0b-74fe-4333-8f5f-5a55ac86ace9",
                                                "sense_id": "95cd48d3-2ee7-3320-b9e3-91a70f95ffe7",
                                                "text": "Ce discours apparemment véritable."
                                            },
                                            {
                                                "example_id": "c6deb1de-90b9-428a-8f9c-f7b73b6b781c",
                                                "sense_id": "95cd48d3-2ee7-3320-b9e3-91a70f95ffe7",
                                                "text": "Apparemment que je suis le maître d'aller où il me plaît."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5efbe91e-d398-35f5-9b87-4320c2e1e40c",
                                        "entry_id": "0946bf74-62ab-3692-a1ef-41ad2eb15a7b",
                                        "glosses": [
                                            "Selon les apparences ; vraisemblablement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f9b7a22-b71a-4a1d-b14e-310785e89222",
                                                "sense_id": "5efbe91e-d398-35f5-9b87-4320c2e1e40c",
                                                "text": "Le grand jeune homme dégingandé, qui s’appelait Laurier, s’était apparemment institué chef en raison de sa position sociale et de ses aptitudes naturelles."
                                            },
                                            {
                                                "example_id": "072bfb2a-2fbd-4213-877e-a8ccec73bd8a",
                                                "sense_id": "5efbe91e-d398-35f5-9b87-4320c2e1e40c",
                                                "text": "C’est la nécessité de ce concours de tant de qualités… qui fait apparemment que le génie est toujours si rare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd3e1b5c-078c-36ba-b2af-0bd7dfb3d593",
                                        "entry_id": "0946bf74-62ab-3692-a1ef-41ad2eb15a7b",
                                        "glosses": [
                                            "En apparence ; visiblement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e260736-51f5-41d7-9d5f-38521be03c22",
                                                "sense_id": "dd3e1b5c-078c-36ba-b2af-0bd7dfb3d593",
                                                "text": "Tant que Galba vivra, le respect de son âge,\nDu moins apparemment, soutiendra son suffrage."
                                            },
                                            {
                                                "example_id": "ec8faf62-8acd-4c31-aecb-8b6cde4fa63f",
                                                "sense_id": "dd3e1b5c-078c-36ba-b2af-0bd7dfb3d593",
                                                "text": "Sa directrice était une mégère doublée d'un tyran qui n'avait apparemment pas inventé l'eau chaude à part peut-être celle qui coule dans les veines des assoiffés de pouvoir."
                                            },
                                            {
                                                "example_id": "c6f15c6f-903c-4c6e-b459-f7c38a2775e4",
                                                "sense_id": "dd3e1b5c-078c-36ba-b2af-0bd7dfb3d593",
                                                "text": "Le coadjuteur ne laissa apparemment d’employer la dignité de son caractère et ses persuasions pour calmer les orages."
                                            },
                                            {
                                                "example_id": "8b9bd88d-01a4-4288-82c8-f26f64afe58b",
                                                "sense_id": "dd3e1b5c-078c-36ba-b2af-0bd7dfb3d593",
                                                "text": "En public elle me persécutait apparemment avec plus d’animosité que les autres."
                                            },
                                            {
                                                "example_id": "d2fe2602-cae2-4506-93c2-04d84fca9e1c",
                                                "sense_id": "dd3e1b5c-078c-36ba-b2af-0bd7dfb3d593",
                                                "text": "Ô ciel ! ta providence, apparemment prospère,\nAu gré de mes soupirs de deux fils m’a fait père."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
