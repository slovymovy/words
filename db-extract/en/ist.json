                    {
                        "sense_id": "95172bc7-b1ee-3f10-ae8d-04e6fb36a6c2",
                        "entry_id": "a9f1439d-235d-3046-9310-b7d0deef215b",
                        "glosses": [
                            "Abbreviation of first."
                        ],
                        "tags": [
                            "abbreviation",
