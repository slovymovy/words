{
    "word_family": [
        "kijken",
        "omkijk",
        "omkijker",
        "omkijkgedrag"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "11c23190-249e-3f19-8cbd-9669144b4dac",
                    "sense_definition": "je hoofd of lichaam draaien om te zien wat er achter je gebeurt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "visuele actie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zonder <w>om</w> te <w>kijken</w> liep hij de kamer uit.",
                            "target_lang_translations": {
                                "en": "Without <w>looking back</w>, he walked out of the room."
                            }
                        },
                        {
                            "text": "Je moet niet steeds <w>omkijken</w> als je op de fiets zit.",
                            "target_lang_translations": {
                                "en": "You shouldn't keep <w>looking back</w> while you are on your bike."
                            }
                        }
                    ],
                    "synonyms": [
                        "omzien"
                    ],
                    "common_phrases": [
                        "niet omkijken",
                        "even omkijken"
                    ],
                    "target_lang_definitions": {
                        "en": "to turn your head or body to see what is happening behind you"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look back",
                                "target_lang_sense_clarification": "to turn one's head to see behind"
                            },
                            {
                                "target_lang_word": "look around",
                                "target_lang_sense_clarification": "to turn and look behind oneself"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48ed891e-9f3e-3e51-bce8-72667b552217",
                    "sense_definition": "om je heen kijken naar de omgeving",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "visuele actie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de prachtige stad bleef hij voortdurend <w>omkijken</w> naar de gebouwen.",
                            "target_lang_translations": {
                                "en": "In the beautiful city, he kept <w>looking around</w> at the buildings."
                            }
                        },
                        {
                            "text": "Tijdens de wandeling in het bos bleven de toeristen <w>omkijken</w> naar de natuur.",
                            "target_lang_translations": {
                                "en": "During the walk in the forest, the tourists kept <w>looking around</w> at nature."
                            }
                        }
                    ],
                    "common_phrases": [
                        "omkijken naar de omgeving"
                    ],
                    "target_lang_definitions": {
                        "en": "to look around at your surroundings"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look around",
                                "target_lang_sense_clarification": "to observe the environment"
                            },
                            {
                                "target_lang_word": "gaze around",
                                "target_lang_sense_clarification": "to look at surroundings with interest"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0745c0b7-ec73-3f15-b25b-d9be3ea59e8a",
                    "sense_definition": "zorg of aandacht besteden aan iemand of iets",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zorg en aandacht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er werd niet meer naar die oude vrouw <w>omgekeken</w>.",
                            "target_lang_translations": {
                                "en": "That old woman was no longer <w>looked after</w>."
                            }
                        },
                        {
                            "text": "Zijn vader <w>keek</w> nauwelijks <w>om</w> naar zijn zoon omdat hij het te druk had.",
                            "target_lang_translations": {
                                "en": "His father hardly <w>cared for</w> his son because he was too busy."
                            }
                        }
                    ],
                    "synonyms": [
                        "omzien"
                    ],
                    "antonyms": [
                        "verwaarlozen"
                    ],
                    "common_phrases": [
                        "omkijken naar iemand",
                        "naar niemand omkijken"
                    ],
                    "target_lang_definitions": {
                        "en": "to give care or attention to someone or something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look after",
                                "target_lang_sense_clarification": "to take care of someone"
                            },
                            {
                                "target_lang_word": "care for",
                                "target_lang_sense_clarification": "to provide attention or support"
                            },
                            {
                                "target_lang_word": "pay attention to",
                                "target_lang_sense_clarification": "to notice or show concern for"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}