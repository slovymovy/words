                    {
                        "translation_id": "3dc1ec25-811f-4bff-ba70-6aedd2e5c423",
                        "source_entry_id": "3d1a4b6f-8bfc-33ab-b175-0cdb01fd1fa4",
                        "source_sense_id": "00394d4b-7a02-3c51-b276-67de2244ba5d",
                        "source_sense_description": "Kloster des Augustinerordens",
                        "target_lang_word": "augustijnenklooster",
                        "target_lang_code": "nl",
