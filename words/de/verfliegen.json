    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b3e0472f-9bd1-391f-aed8-87ec894a88e8",
                    "sense_definition": "schnell vergehen oder unbemerkt vorübergehen (besonders von Zeit, Gefühlen oder Stimmungen)",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vergehen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn man mit guten Freunden zusammen ist, <w>verfliegt</w> die Zeit wie im Flug."
                        },
                        {
                            "text": "Nach einer erholsamen Nacht war seine schlechte Laune glücklicherweise völlig <w>verflogen</w>."
                        }
                    ],
                    "synonyms": [
                        "vergehen",
                        "dahinfliegen",
                        "verrinnen",
                        "verstreichen",
                        "vorübergehen"
                    ],
                    "common_phrases": [
                        "die Zeit verfliegt"
                    ]
                },
                {
                    "sense_id": "fc9cf656-cd55-3f80-80c1-739f8c0aa5b9",
                    "sense_definition": "sich allmählich in der Luft auflösen und nicht mehr wahrnehmbar sein (besonders von Gerüchen, Gasen oder Dämpfen)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "auflösen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir müssen das Fenster öffnen, damit der strenge Geruch nach Farbe rasch <w>verfliegt</w>."
                        },
                        {
                            "text": "Der angenehme Duft des frischen Kaffees ist schon nach kurzer Weile ganz <w>verflogen</w>."
                        }
                    ],
                    "synonyms": [
                        "verflüchtigen",
                        "verduften",
                        "verschwinden"
                    ],
                    "common_phrases": [
                        "schnell verfliegen"
                    ]
                },
                {
                    "sense_id": "11bec749-f70d-3730-87db-a85eed3b8aa5",
                    "sense_definition": "in die falsche Richtung fliegen oder während des Fluges die Orientierung verlieren",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "orientierung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegen des dichten Nebels fürchtete der Pilot, sich bei dem Flug zu <w>verfliegen</w>."
                        },
                        {
                            "text": "Die junge Taube hatte sich <w>verflogen</w> und fand den Weg zum Schlag erst spät zurück."
                        }
                    ],
                    "synonyms": [
                        "verfranzen"
                    ],
                    "common_phrases": [
                        "sich im Nebel verfliegen"
                    ]
                },
                {
                    "sense_id": "609e39ec-4c6e-3d81-998c-248663d278c3",
                    "sense_definition": "durch häufiges Reisen im Flugzeug aufbrauchen oder verbrauchen (etwa Flugmeilen, Geld oder Treibstoff)",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aufbrauchen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Geschäftsmann möchte seine angesammelten Bonusmeilen vor Ablauf des Jahres für einen Urlaub <w>verfliegen</w>."
                        },
                        {
                            "text": "Bei den vielen weltweiten Dienstreisen hat das Unternehmen enorme finanzielle Mittel <w>verflogen</w>."
                        }
                    ],
                    "common_phrases": [
                        "Bonusmeilen verfliegen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e7c4523-c0ba-327e-906a-860c5655ea19",
                    "sense_definition": "das Entweichen, Auflösen oder Vergehen; Substantivierung des Verbs <w>verfliegen</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vergehen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das rasche <w>Verfliegen</w> des Alkohols in der heißen Pfanne hinterließ nur das feine Aroma."
                        },
                        {
                            "text": "Das scheinbar mühelose <w>Verfliegen</w> der Jahre beschäftigt viele Menschen im Alter."
                        }
                    ],
                    "common_phrases": [
                        "rasches Verfliegen"
                    ]
                }
            ]
        }
    ]
}