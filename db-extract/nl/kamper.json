                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "52647831-90f2-4300-b57a-de1f2ffcb692",
                                "sense_id": "90499215-ccd0-3608-8323-8d08854e5a89",
                                "text": "Het is ons niet duidelijk of de vergrijsde kamper voor de Westvlaamse taaleigenheid op dat ogenblik meer van de jonge geestelijke afwist dan wat deze zopas in zijn prospectus had wereldkundig gemaakt."
                            }
                        ]
                    },
                    {
                        "sense_id": "88f82d42-2f5c-33d2-840c-071d23dc1607",
                        "entry_id": "761fb497-047b-34dd-8ef3-20347ccc9b12",
                        "glosses": [
                            "iemand die van een woonwagencentrum afkomstig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d846b7fd-8b52-4860-93da-6820a5a5c169",
                                "sense_id": "88f82d42-2f5c-33d2-840c-071d23dc1607",
                                "text": "Net als de burgerman trekt de kamper er 's zomers met zijn caravan op uit. Leny: \"Zeg maar gerust in de lente, want dan krijgen wij al de kriebels. Dat reizen zit ons in het bloed.\""
                            }
                        ]
                    }
