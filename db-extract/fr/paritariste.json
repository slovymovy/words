                ],
                "senses": [
                    {
                        "sense_id": "ee961ef3-eb83-37a4-a3db-5a8edcf2d89c",
                        "entry_id": "ec77449c-3ff1-354e-8ae2-768ff9bf17b1",
                        "glosses": [
                            "Adepte, partisan de la parité, en particulier entre hommes et femmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8590dac9-5dc1-4f6c-8e78-b86e909b3de3",
                                "sense_id": "ee961ef3-eb83-37a4-a3db-5a8edcf2d89c",
                                "text": "Il faut faire quelque chose, mais quoi ? Les paritaristes pensent que seule une loi, ou un amendement à la Constitution, établissant le principe de « une sur deux » est susceptible de faire évoluer la situation."
                            },
                            {
                                "example_id": "c71270ab-db19-441f-aa6d-8f97ee3e8630",
                                "sense_id": "ee961ef3-eb83-37a4-a3db-5a8edcf2d89c",
                                "text": "Les paritaristes posent, en effet, une bonne question, mais y répondent de manière biaisée."
                            }
                        ]
                    }
                ],
