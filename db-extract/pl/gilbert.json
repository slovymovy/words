                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9015d811-3b73-4f10-a1f9-16384ddf27d9",
                                "sense_id": "00d60eab-1c97-31d5-90d1-b4cec1674a69",
                                "text": "Chłopak mojej siostry ma na imię Gilbert."
                            }
                        ],
