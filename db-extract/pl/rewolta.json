                "forms": [],
                "senses": [
                    {
                        "sense_id": "97734908-e4c6-3717-b34e-8cedced62ee0",
                        "entry_id": "568a2629-7709-3068-803b-9be0a8025b87",
                        "glosses": [
                            "zbrojny spisek, bunt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38d50a04-25a6-4443-99cb-ad6ad6a326d7",
                                "sense_id": "97734908-e4c6-3717-b34e-8cedced62ee0",
                                "text": "Ma nawiązać kontakt z emirem Fajsalem i prosić o pomoc wojskową, by wzmocnić arabską rewoltę przeciwko Turkom"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "60c21283-a788-37f2-98da-3c7d3ad10c6a",
                        "entry_id": "568a2629-7709-3068-803b-9be0a8025b87",
                        "glosses": [
                            "sprzeciw wobec obowiązujących norm"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c722e8ea-a5ad-47c3-80d6-a186f4e3658d",
                        "source_entry_id": "568a2629-7709-3068-803b-9be0a8025b87",
                        "source_sense_id": "97734908-e4c6-3717-b34e-8cedced62ee0",
                        "target_lang_word": "revolt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revolt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8aad53b0-f663-358a-a625-56c5a7b12ccc",
                                        "entry_id": "bf243684-a3b3-3a9b-993f-141bca8bd261",
                                        "glosses": [
                                            "To rebel, particularly against authority."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59921ba8-e9e3-4beb-939e-c13157df5a15",
                                                "sense_id": "8aad53b0-f663-358a-a625-56c5a7b12ccc",
                                                "text": "Our diſcontented Counties doe reuolt"
                                            },
                                            {
                                                "example_id": "60c770b2-83f6-45ec-a3b6-24074fe82d17",
                                                "sense_id": "8aad53b0-f663-358a-a625-56c5a7b12ccc",
                                                "text": "The farmers had to revolt against the government to get what they deserved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97ae2376-249d-39d1-ae91-8e70b07be7c9",
                                        "entry_id": "bf243684-a3b3-3a9b-993f-141bca8bd261",
                                        "glosses": [
                                            "To repel greatly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "294ce959-d0e5-4e7d-b1a0-3459e6960152",
                                                "sense_id": "97ae2376-249d-39d1-ae91-8e70b07be7c9",
                                                "text": "Your brother revolts me!"
                                            },
                                            {
                                                "example_id": "cb77c36a-e677-4211-ae6e-d0a933cbef0b",
                                                "sense_id": "97ae2376-249d-39d1-ae91-8e70b07be7c9",
                                                "text": "I shall be told, that this abominable medley is made rather to revolt young and ingenuous minds."
                                            },
                                            {
                                                "example_id": "f8a218a1-dc00-4a90-a29e-a9c4f2cafa23",
                                                "sense_id": "97ae2376-249d-39d1-ae91-8e70b07be7c9",
                                                "text": "1870, John Morley, Condorcet (published in the Fortnightly Review\nTo derive delight from what inflicts pain on any sentient creature revolted his conscience and offended his reason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "333e7cfe-6e21-377e-804f-20de95c09831",
                                        "entry_id": "bf243684-a3b3-3a9b-993f-141bca8bd261",
                                        "glosses": [
                                            "To be disgusted, shocked, or grossly offended; hence, to feel nausea; used with at."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b1f1701-b74d-41f4-9ede-0cdb645c3292",
                                                "sense_id": "333e7cfe-6e21-377e-804f-20de95c09831",
                                                "text": "The stomach revolts at such food; his nature revolts at cruelty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84cb4257-d515-3ce6-a0ba-69ea7eec33a2",
                                        "entry_id": "bf243684-a3b3-3a9b-993f-141bca8bd261",
                                        "glosses": [
                                            "To cause to turn back; to roll or drive back; to put to flight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79216969-f6e2-4bbe-8e8d-8efd2d7f7203",
                                                "sense_id": "84cb4257-d515-3ce6-a0ba-69ea7eec33a2",
                                                "text": "The foring clouds into fad fhowres y molt; / So to her yold the flames, and did their force reuolt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab163f09-0a29-330b-8486-2a14ab16767d",
                                        "entry_id": "bf243684-a3b3-3a9b-993f-141bca8bd261",
                                        "glosses": [
                                            "To turn away; to abandon or reject something; specifically, to turn away, or shrink, with abhorrence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7516ddc6-3136-409e-a56b-8dd3c13821a0",
                                                "sense_id": "ab163f09-0a29-330b-8486-2a14ab16767d",
                                                "text": "And ſtill revolt when truth would ſet them free."
                                            },
                                            {
                                                "example_id": "a0ad9826-7e43-41bd-879c-22690714e3dd",
                                                "sense_id": "ab163f09-0a29-330b-8486-2a14ab16767d",
                                                "text": "His clear intelligence revolted from the dominant sophisms of that time."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "revolt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2d486e4-230e-3817-b6ae-4fc9ea5a8396",
                                        "entry_id": "0f990847-2e9b-3746-86ab-858b85d2b9cc",
                                        "glosses": [
                                            "An act of revolting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf0a2d01-7bfb-4d30-b0bb-43d62fa3849a",
                                                "sense_id": "c2d486e4-230e-3817-b6ae-4fc9ea5a8396",
                                                "text": "— It's a revolt?\n— No, Sire, it's a revolution..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b21b410d-e084-4907-aa0a-d4c22748f973",
                        "source_entry_id": "568a2629-7709-3068-803b-9be0a8025b87",
                        "source_sense_id": "97734908-e4c6-3717-b34e-8cedced62ee0",
                        "target_lang_word": "révolte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "révolte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "feccbea3-55f0-3626-b1fe-fa33e1cb3d88",
                                        "entry_id": "6180ab71-7ece-3664-a655-161655276c43",
                                        "glosses": [
                                            "Rébellion, soulèvement contre l’autorité établie, tentative de révolution, ou bien simple changement d’allégeance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c788b526-5c2c-4fc9-8367-486ff97bdbca",
                                                "sense_id": "feccbea3-55f0-3626-b1fe-fa33e1cb3d88",
                                                "text": "Et même au bled el-makhzen, où le Sultan règne en autocrate absolu, les révoltes contre son autorité ne sont pas rares."
                                            },
                                            {
                                                "example_id": "b1755b63-3fda-4877-87e7-a6acc6395676",
                                                "sense_id": "feccbea3-55f0-3626-b1fe-fa33e1cb3d88",
                                                "text": "À Ismaïlia en 1938, c’est pendant une manifestation antibritannique de soutien à la révolte palestinienne qu’Hasan al-Banna a été arrêté pour la première fois."
                                            },
                                            {
                                                "example_id": "afef57f9-dfe9-44b4-ab88-27e8726da8d0",
                                                "sense_id": "feccbea3-55f0-3626-b1fe-fa33e1cb3d88",
                                                "text": "Mais notre règne arrivera\nQuand votre règne finira. (bis)\nNous tisserons\nLe linceul du vieux monde,\nCar on entend déjà la révolte qui gronde."
                                            },
                                            {
                                                "example_id": "d2bca02a-e435-4d5c-a0bf-bdd5983b1363",
                                                "sense_id": "feccbea3-55f0-3626-b1fe-fa33e1cb3d88",
                                                "text": "Au vrai j’entrevoyais que le conflit politique était le même en tous pays, et qu’il n’était autre qu’une révolte des esclaves contre les maîtres, chose qu'il fallait attendre, après cette tuerie imbécile."
                                            },
                                            {
                                                "example_id": "b2f6e2cf-d304-4515-bde4-cedc7de47b1a",
                                                "sense_id": "feccbea3-55f0-3626-b1fe-fa33e1cb3d88",
                                                "text": "Une révolte peut être qualifiée de « résistance » ou de « terrorisme », et cela n'oriente pas le discours vers les mêmes ambitions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37fda3c4-0386-3617-ae43-e84a3bd9f09c",
                                        "entry_id": "6180ab71-7ece-3664-a655-161655276c43",
                                        "glosses": [
                                            "Refus, opposition ferme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5cd3ea3-498a-4c8a-a65f-9d0a95533a5e",
                                                "sense_id": "37fda3c4-0386-3617-ae43-e84a3bd9f09c",
                                                "text": "La révolte des sens contre la raison ; de la chair contre l’esprit. La révolte de l’instinct."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "799c2669-6d47-352a-b407-fa0aacf77a23",
                                        "entry_id": "6180ab71-7ece-3664-a655-161655276c43",
                                        "glosses": [
                                            "Violente indignation, sursaut de colère, de résistance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab5f4468-5b3d-431b-ac87-bf0e1b3d98ab",
                                                "sense_id": "799c2669-6d47-352a-b407-fa0aacf77a23",
                                                "text": "Et, peu à peu, de la douceur primordiale, un peu timide et avide de tendresse de son caractère, montaient une sourde irritation, une rancœur et une révolte."
                                            },
                                            {
                                                "example_id": "dc724a15-c9db-4d0d-b216-d03c0995d2a3",
                                                "sense_id": "799c2669-6d47-352a-b407-fa0aacf77a23",
                                                "text": "Le sentiment de révolte que l’on rencontre dans les classes pauvres se colorera dès lors d’une atroce jalousie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "révolte",
                                "target_lang_code": "fr",
