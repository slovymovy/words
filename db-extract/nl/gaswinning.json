                "senses": [
                    {
                        "sense_id": "dbc82618-0d30-3311-9e2c-ba3aa248b6c0",
                        "entry_id": "4f2b974d-d642-3d44-8e4d-0c8862ea971c",
                        "glosses": [
                            "het produceren en behandelen van aardgas uit een gasveld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "261a18ea-7e3a-481a-9067-f8a10727f475",
                                "sense_id": "dbc82618-0d30-3311-9e2c-ba3aa248b6c0",
                                "text": "Door de gaswinning te halveren ten opzichte van 2012 en woningen en andere gebouwen te versterken, worden veiligheidsrisico's beperkt."
                            },
                            {
                                "example_id": "440d5895-e8f4-402a-b90c-127fdd6ff819",
                                "sense_id": "dbc82618-0d30-3311-9e2c-ba3aa248b6c0",
                                "text": "In het vorige kabinet heeft de top van de coalitie een \"meedogenloos\" besluit genomen, om de gaswinning niet sneller te reduceren. Met dat besluit is bewust veel risico genomen, waardoor zelfs doden hadden kunnen vallen"
                            },
                            {
                                "example_id": "1e7a714e-7cbc-4229-b327-4ff545e94919",
                                "sense_id": "dbc82618-0d30-3311-9e2c-ba3aa248b6c0",
                                "text": "\"We willen bezoekers laten zien hoe kwetsbaar het waddengebied is\", zegt Venema. \"Met vervuiling, gaswinning en druk op de natuur is er veel werk te doen. In het nieuwe centrum kunnen we dat verhaal beter vertellen.\""
                            }
                        ]
                    }
