                                "sense_id": "e34572f1-7f21-3f72-b5b4-591adf0f231b",
                                "text": "Hij had een adel van geest die doorscheen in zijn werken.",
                                "translation": "He possessed a nobility of spirit that is reflected in his works.",
                                "english": "He possessed a nobility of spirit that is reflected in his works."
                            }
