                    {
                        "sense_id": "f4d859e5-9ebd-34da-b280-473dcd81312e",
                        "entry_id": "d8cc42d8-56d3-3ec8-97d0-6f548a610dc1",
                        "glosses": [
                            "haan van kleine hoendersoort"
