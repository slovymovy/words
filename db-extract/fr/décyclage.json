                        "entry_id": "af681856-4350-3109-994f-b6a0a56f95b4",
                        "glosses": [
                            "Forme de recyclage par laquelle on transforme un déchet matériel ou un produit inutile en un nouveau matériau ou produit de qualité ou de valeur moindre."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "b4c6e9f4-848e-418e-b8ab-cbd7772e78a9",
                                "sense_id": "93fe092a-eb0f-3ef6-b38b-897f7a1dae2c",
                                "text": "Le décyclage d'un plastique."
                            },
                            {
                                "example_id": "76b55d5f-840e-40f9-927a-5e8ae47df627",
                                "sense_id": "93fe092a-eb0f-3ef6-b38b-897f7a1dae2c",
                                "text": "Le vrai recyclage boucle la boucle (une bouteille deviendra une bouteille), alors que le décyclage transforme les produits en sous-produits ou produits secondaires (un pot en plastique en endos de tapis)."
                            }
                        ]
                    }
