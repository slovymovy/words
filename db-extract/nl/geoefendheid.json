                        "examples": [
                            {
                                "example_id": "ad6ad96e-28fa-4e22-865f-f39895615efb",
                                "sense_id": "6b6470af-2a67-3dee-93e6-37d39441b921",
                                "text": "Er gaat volgend jaar 300 miljoen naar Defensie. Daarmee moet vooral de zogeheten basisgereedheid op orde gebracht worden: daarvan wordt nieuw personeel aangenomen. Ook wordt de geoefendheid van de militairen verbeterd en wordt geïnvesteerd in oefenmunitie en brandstof."
                            },
                            {
                                "example_id": "0e6d67e5-1309-4a5d-8798-096ac0e6141b",
                                "sense_id": "6b6470af-2a67-3dee-93e6-37d39441b921",
                                "text": "De inzetbaarheid van de krijgsmacht staat onder druk door een gebrek aan munitie en reserveonderdelen. Als er niets gebeurt, is vanaf eind 2011 de geoefendheid van de pantserinfanterie niet meer verzekerd, schrijft minister Hillen aan de Tweede Kamer."
                            }
                        ]
