                "senses": [
                    {
                        "sense_id": "364a2a3c-d2b4-3ee5-871b-d4379e0384c2",
                        "entry_id": "6fcd246d-0aea-314d-b49c-8776fd4157b0",
                        "glosses": [
                            "Südalbaner; Sprecher des toskischen Dialekts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fa13cd8-f5cf-47fe-93c8-442755be6508",
                                "sense_id": "364a2a3c-d2b4-3ee5-871b-d4379e0384c2",
                                "text": "„Im Gebiet der Tosken im engeren Sinne und in der Myzeqeja war die Binnenwanderung wesentlich intensiver als im übrigen Kerngebiet.“"
                            },
                            {
                                "example_id": "2fcd5934-984e-46de-be92-c66a4df548c8",
                                "sense_id": "364a2a3c-d2b4-3ee5-871b-d4379e0384c2",
                                "text": "„...Slawen als Ackerbauern und Viehzüchter auf dem flachen Lande einstmals besaßen. Die im 13. Jahrhundert auf friedlichem Wege einsetzende Einwanderung der Albaner hatte im 14. Jahrhundert bereits den Peloponnes erreicht. Zumeist kamen die Tosken (Albaner) als Hirten ins Land. Bald aber wurden sie Ackerbauern und gingen im Griechentum unter. Feste Türme als Wehranlagen, Blutrache, Klanwesen und Brautkauf bei den Mainoten zeigen gewisse Übereinstimmungen...“"
                            },
                            {
                                "example_id": "90efbc70-3a52-4f6c-afe8-a59f7944f228",
                                "sense_id": "364a2a3c-d2b4-3ee5-871b-d4379e0384c2",
                                "text": "„...diesem wohnen die Gegen, südlich die Tosken. Obgleich eine verwandte Sprache sprechend, versteht doch der Toske den Gegen und dieser den Tosken nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
