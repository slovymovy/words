                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f8e53f0-c58c-4260-8ef0-f333f66a1e8b",
                                "sense_id": "17dbed22-5ab9-3a6a-8440-014369ee2089",
                                "text": "De bovenburen stampten hard op de grond toen wij een feestje gaven waarbij veel lawaai werd gemaakt; toen hebben we ze ook maar op het feestje uitgenodigd."
                            },
                            {
                                "example_id": "640d5de4-4a3a-42ad-bc94-78e28c1508b0",
                                "sense_id": "17dbed22-5ab9-3a6a-8440-014369ee2089",
                                "text": "In een flat kun je naast buren aan de linkerkant en rechterkant ook benedenburen en bovenburen hebben."
                            }
                        ]
                    }
                ],
