                {
                    "sense_id": "3deab9f1-9549-38a0-a4a9-3c38f7233fb3",
                    "sense_definition": "De plant van het geslacht Fragaria waar de aardbeien aan groeien.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben dit jaar een kleine <w>aardbei</w> in onze moestuin geplant.",
                            "target_lang_translations": {
                                "en": "We planted a small <w>strawberry plant</w> in our vegetable garden this year."
                            }
                        },
                        {
                            "text": "De bladeren van de <w>aardbei</w> zijn groen en drietallig.",
