                                "target_senses": [
                                    {
                                        "sense_id": "ef908940-83ec-34ed-bb79-c46a83d54915",
                                        "entry_id": "e51476ce-8a50-3a7b-8bf3-67a9ab1b41f3",
                                        "glosses": [
                                            "Of events, experiences, or phenomenona, that cannot be explained by current scientific understanding or natural laws."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "045c52fa-ebf3-47ee-a1c2-450ac3f54863",
                                                "sense_id": "ef908940-83ec-34ed-bb79-c46a83d54915",
                                                "text": "“We who study the paranormal always hope for strong readings with our equipment,” explains Nancy."
                                            }
