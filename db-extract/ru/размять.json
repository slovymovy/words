                                        "sense_id": "19aa09bc-32f9-3512-92a6-4d3976d2e953",
                                        "entry_id": "7c786b3a-25dc-3728-9a62-081298d265d6",
                                        "glosses": [
                                            "Mezclar dos o más materias, especialmente agua con materiales en polvo tales como yeso, harina, etc., y manipular esta mezcla, generalmente con las manos y con presión, hasta formar una masa."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c823af59-942d-3586-89a8-a89879032159",
                                        "entry_id": "7c786b3a-25dc-3728-9a62-081298d265d6",
                                        "glosses": [
                                            "Juntar una cantidad considerable de bienes o dinero."
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06923b0e-f784-4731-8f7e-bd557a604297",
                                                "sense_id": "c823af59-942d-3586-89a8-a89879032159",
                                                "text": "Allí logró amasar una gran fortuna ejerciendo de comerciante."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "39d0f39b-1884-3099-9766-cd003657e995",
                                        "entry_id": "7c786b3a-25dc-3728-9a62-081298d265d6",
                                        "glosses": [
                                            "Mezclar o unir cosas de diferente naturaleza."
