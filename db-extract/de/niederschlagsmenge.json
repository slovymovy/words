                "senses": [
                    {
                        "sense_id": "7a9939e6-e852-3e55-af08-3e224ce1dffb",
                        "entry_id": "507c1b1e-8f66-3934-8486-19f8532879ea",
                        "glosses": [
                            "insgesamt gefallener Niederschlag (zu einer bestimmten Zeit und an einem bestimmten Ort)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80f3040e-c302-43a7-a9ab-3abea11af8a6",
                                "sense_id": "7a9939e6-e852-3e55-af08-3e224ce1dffb",
                                "text": "„Die Niederschlagsmenge in einer Region wird in Millimeter pro Zeitraum und Fläche berechnet: Die Zahl gibt also an, wie hoch eine Wassersäule auf einem Quadratmeter in einem bestimmten Zeitraum steht.”"
                            },
                            {
                                "example_id": "ba0b48a2-14de-4808-8463-dd9e7895dc82",
                                "sense_id": "7a9939e6-e852-3e55-af08-3e224ce1dffb",
                                "text": "„Und so können Kunstmann und sein Team die Niederschlagsmenge ausrechnen, die zwischen zwei Sendemasten niedergeht.“"
                            },
                            {
                                "example_id": "239ee43a-e469-4959-b382-68af9cb2ee0b",
                                "sense_id": "7a9939e6-e852-3e55-af08-3e224ce1dffb",
                                "text": "„Die Niederschlagsmengen unterscheiden sich je nach Region beträchtlich.“"
                            },
                            {
                                "example_id": "d61ef8c1-a107-4d48-b01c-7f2e1c840dbe",
                                "sense_id": "7a9939e6-e852-3e55-af08-3e224ce1dffb",
                                "text": "[Klimawandel:] „Verbunden mit der Temperaturzunahme werden sehr wahrscheinlich die jährlichen Niederschlagsmengen weiter zunehmen.“"
                            },
                            {
                                "example_id": "d5ae5250-9557-4990-a0b1-36a388eabecc",
                                "sense_id": "7a9939e6-e852-3e55-af08-3e224ce1dffb",
                                "text": "„So wird in Hamburg ab einer Niederschlagsmenge von etwa 30 mm pro Tag nicht mehr von Regen, sondern von Starkregen gesprochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
