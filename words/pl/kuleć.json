                    "sense_id": "d6e4d931-a10a-327b-a57b-3c7be449c5dc",
                    "sense_definition": "poruszać się w sposób nierówny, utykając na jedną nogę",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "poruszanie się",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po wypadku zaczął <w>kuleć</w> na prawą nogę.",
                            "target_lang_translations": {
                                "ru": "После аварии он начал <w>хромать</w> на правую ногу."
                            }
                        },
                        {
                            "text": "Stary pies zaczął <w>kuleć</w> po długim spacerze w lesie.",
                            "target_lang_translations": {
                                "ru": "Старая собака начала <w>хромать</w> после долгой прогулки в лесу."
                            }
                        }
                    ],
                    "synonyms": [
                        "chromać",
                        "kuśtykać"
                    ],
                    "common_phrases": [
                        "kuleć na nogę"
                    ],
                    "target_lang_definitions": {
                        "ru": "передвигаться неровно, припадая на одну ногу из-за травмы или болезни"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хромать",
                                "target_lang_sense_clarification": "о физическом передвижении с нарушением походки"
                            },
                            {
                                "target_lang_word": "прихрамывать",
                                "target_lang_sense_clarification": "слегка хромать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a35a7d7-25bb-38e6-bdb8-1a0cd422f33d",
                    "sense_definition": "mieć trudności z funkcjonowaniem, działać niesprawnie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "niesprawność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "System opieki zdrowotnej w tym kraju wyraźnie <w>kuleje</w>.",
                            "target_lang_translations": {
                                "ru": "Система здравоохранения в этой стране явно <w>хромает</w>."
                            }
                        },
                        {
                            "text": "Organizacja tego wydarzenia <w>kuleje</w> od samego początku.",
                            "target_lang_translations": {
                                "ru": "Организация этого мероприятия <w>хромает</w> с самого начала."
                            }
                        }
                    ],
                    "common_phrases": [
                        "organizacja kuleje",
                        "system kuleje"
                    ],
                    "target_lang_definitions": {
                        "ru": "иметь серьезные недостатки, работать неэффективно или некачественно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хромать",
                                "target_lang_sense_clarification": "переносное значение: о плохой работе системы или процесса"
                            },
                            {
                                "target_lang_word": "быть не на высоте",
                                "target_lang_sense_clarification": "о недостаточном качестве выполнения чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
