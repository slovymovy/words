                                "example_id": "a7363ca2-54a3-4856-a9e2-6ea8c4f37e36",
                                "sense_id": "1c3c6a9d-036c-3b73-97c2-89925d71f0d0",
                                "text": "„Selbst die Schiffsleitung war nur noch auf sich bedacht.“"
                            },
