                        "entry_id": "66c21453-8b22-32b3-80a6-d3fff1ef6979",
                        "glosses": [
                            "de keer dat men een berg beklimt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "615e787c-ce63-4e17-a99a-d209494185ed",
                                "sense_id": "11d37822-865d-358d-b4c8-0c93b388eccd",
                                "text": "Jaarlijks komen er vier tot zes Nederlanders om het leven in de bergen. Het seizoen voor bergbeklimming en wandelingen in de bergen is nu zo goed als afgelopen."
                            },
                            {
                                "example_id": "c7fe9b16-2e14-4416-9ab2-182a14fc6c42",
                                "sense_id": "11d37822-865d-358d-b4c8-0c93b388eccd",
                                "text": "De vijf Duitsers die gisteren omkwamen tijdens een bergbeklimming in de Alpen waren een vader en een zoon, een collega van de zoon en twee kinderen van de enige overlevende van het gezelschap. Dat heeft de Zwitserse politie bekendgemaakt."
                            }
                        ]
                    }
