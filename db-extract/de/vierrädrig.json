                ],
                "senses": [
                    {
                        "sense_id": "57e3b4f9-ea44-3372-8e3a-cfecbec7a6a9",
                        "entry_id": "ac1c3436-8a50-375d-a2ec-db767d919a77",
                        "glosses": [
                            "mit vier Rädern versehen; über vier Räder verfügend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebb2f6f9-5f75-42ac-b1bd-e329009bafe1",
                                "sense_id": "57e3b4f9-ea44-3372-8e3a-cfecbec7a6a9",
                                "text": "„Das Gelände steht voll mit Quads, vierrädrigen offenen Geländefahrzeugen.“"
                            },
                            {
                                "example_id": "410df87f-ac88-4b57-b074-bb5847939b82",
                                "sense_id": "57e3b4f9-ea44-3372-8e3a-cfecbec7a6a9",
                                "text": "„Erleichterungen für Radler fordern die Bürger an diversen Stellen. Vierrädrig könne man sich im hiesigen Dauerstau schließlich nicht mehr frei bewegen, klagte ein Bürger.“"
                            },
                            {
                                "example_id": "62b99fd8-ce91-49ae-a12f-fd1d42b4cace",
                                "sense_id": "57e3b4f9-ea44-3372-8e3a-cfecbec7a6a9",
                                "text": "„Da es mit dem Flieger nicht klappte, galt es, die Donaustadt vierrädrig zu erreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": [
