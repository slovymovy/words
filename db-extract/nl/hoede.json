                        "examples": [
                            {
                                "example_id": "9f16c6e0-ac93-4390-8bfa-b970da084993",
                                "sense_id": "6823c4ab-91fb-3cb0-b4b3-c10264781b26",
                                "text": "Hoe verder men trekt, hoe meer de krachtderarmees wordt verminderd door vermoeienis, verspreiding en de noodzakelijkheid om op zijn hoede te zijn.",
                                "translation": "The further one marches, the more the armies' power decreases through fatigue, dispersion and the necessity to be on guard.",
                                "english": "The further one marches, the more the armies' power decreases through fatigue, dispersion and the necessity to be on guard."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3c70f25-fd51-380c-b034-3f17c6f2d2af",
                        "entry_id": "fa61e3c6-e324-3e3d-9d08-0681a9e8d868",
                        "glosses": [
                            "protection, care, auspices"
                        ],
                        "tags": [
