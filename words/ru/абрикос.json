    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2addbbe3-9ecc-3481-b0a2-c945bab14683",
                    "sense_definition": "Сочный сладкий плод округлой формы желтовато-красного или оранжевого цвета с крупной косточкой.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "абрикос_растение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом на рынке мы часто покупаем спелые и сладкие <w>абрикосы</w>.",
                            "target_lang_translations": {
                                "en": "In the summer at the market, we often buy ripe and sweet <w>apricots</w>."
                            }
                        },
                        {
                            "text": "Она аккуратно разломила сочный <w>абрикос</w> пополам и вынула косточку.",
                            "target_lang_translations": {
                                "en": "She gently broke the juicy <w>apricot</w> in half and took out the stone."
                            }
                        }
                    ],
                    "common_phrases": [
                        "спелый абрикос",
                        "сушёные абрикосы",
                        "варенье из абрикосов"
                    ],
                    "target_lang_definitions": {
                        "en": "A round, sweet and juicy fruit with yellowish-red or orange skin and a large stone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "apricot",
                                "target_lang_sense_clarification": "fruit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7684f29-0737-328c-badd-8a1609106c5a",
                    "sense_definition": "Плодовое южное дерево семейства Розовые с округлой кроной и ранними белыми или розовыми цветами.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "абрикос_растение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Весной в нашем саду пышно зацвёл старый <w>абрикос</w>.",
                            "target_lang_translations": {
                                "en": "In the spring, an old <w>apricot tree</w> bloomed luxuriantly in our garden."
                            }
                        },
                        {
                            "text": "В тени раскидистого <w>абрикоса</w> стоял деревянный стол со стульями.",
                            "target_lang_translations": {
                                "en": "A wooden table with chairs stood in the shade of a spreading <w>apricot tree</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "цветущий абрикос",
                        "посадить абрикос"
                    ],
                    "target_lang_definitions": {
                        "en": "A southern fruit tree of the rose family (Rosaceae) with a rounded crown and early white or pink flowers."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "apricot tree",
                                "target_lang_sense_clarification": "tree"
                            },
                            {
                                "target_lang_word": "apricot",
                                "target_lang_sense_clarification": "tree"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23af1ff6-4915-32c7-ab13-cc523f4e7794",
                    "sense_definition": "Мужские половые железы, семенники.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "жаргонизм_анатомия",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хулиган во дворе хвастался, что в драке может легко врезать по <w>абрикосам</w>.",
                            "target_lang_translations": {
                                "en": "The neighborhood bully bragged that he could easily kick someone in the <w>balls</w> during a fight."
                            }
                        },
                        {
                            "text": "После неудачного падения с велосипеда он получил сильный удар прямо по <w>абрикосам</w>.",
                            "target_lang_translations": {
                                "en": "After a bad fall off his bike, he took a hard blow right to the <w>nuts</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "яички"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "жаргонное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Male gonads; testicles."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "balls",
                                "target_lang_sense_clarification": "slang for testicles"
                            },
                            {
                                "target_lang_word": "nuts",
                                "target_lang_sense_clarification": "slang for testicles"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d20e74d-d3d4-3688-8d4e-037ac048a1c4",
                    "sense_definition": "Заболевание печени, сопровождающееся пожелтением кожи и слизистых оболочек; гепатит или желтуха.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В лазарете говорили, что новенький арестант подхватил тяжёлый <w>абрикос</w>.",
                            "target_lang_translations": {
                                "en": "In the infirmary, they said the new prisoner had caught severe <w>jaundice</w>."
                            }
                        },
                        {
                            "text": "Старый фельдшер сразу заподозрил <w>абрикос</w> из-за сильно пожелтевших белков глаз.",
                            "target_lang_translations": {
                                "en": "The old paramedic immediately suspected <w>hepatitis</w> because the whites of the eyes were so yellow."
                            }
                        }
                    ],
                    "synonyms": [
                        "гепатит",
                        "желтуха"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "уголовный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A liver disease causing yellowing of the skin and mucous membranes; hepatitis or jaundice."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jaundice",
                                "target_lang_sense_clarification": "medical condition; slang equivalent"
                            },
                            {
                                "target_lang_word": "hepatitis",
                                "target_lang_sense_clarification": "liver inflammation; slang equivalent"
                            }
                        ]
                    }
                }
            ]
