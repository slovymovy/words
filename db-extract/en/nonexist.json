                "senses": [
                    {
                        "sense_id": "868a03e1-3a3b-385b-bdfc-bc04442737b1",
                        "entry_id": "1aaf7803-223b-36fd-9d99-d88ccc9a5dd2",
                        "glosses": [
                            "To not exist; to unexist."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1146a71c-63e9-47e6-92c1-4db07be7fe66",
                                "sense_id": "868a03e1-3a3b-385b-bdfc-bc04442737b1",
                                "text": "Nothing is by the laws of the mind to be held as having no beginning, which we can rationally conceive to have once nonexisted and then begun."
                            },
                            {
                                "example_id": "28281857-77b3-453e-86bd-ebe47ab2fb3d",
                                "sense_id": "868a03e1-3a3b-385b-bdfc-bc04442737b1",
                                "text": "The brilliant Cerebron, attacking the problem analytically, discovered three distinct kinds of dragon: the mythical, the chimerical, and the purely hypothetical. They were all, one might say, nonexistent, but each nonexisted in an entirely different way."
                            },
                            {
                                "example_id": "b847a1ae-d27b-457f-8842-9aa841849b04",
                                "sense_id": "868a03e1-3a3b-385b-bdfc-bc04442737b1",
                                "text": "Like the Buddha, samsara and Nirvana neither exist nor nonexist, nor both exist and nonexist, nor neither exist nor nonexist."
                            },
                            {
                                "example_id": "60e04451-b13d-4402-82c5-e4fbc8d0bcad",
                                "sense_id": "868a03e1-3a3b-385b-bdfc-bc04442737b1",
                                "text": "Of something that does not satisfy the presupposition of the pair exists and nonexists, and so neither exists nor nonexists, we cannot ask why it exists."
                            }
                        ]
                    }
                ],
