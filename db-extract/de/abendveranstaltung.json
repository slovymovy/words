                "senses": [
                    {
                        "sense_id": "631a1982-7a07-3c8d-b4b2-b29f7e826af2",
                        "entry_id": "ee6d3567-9e9f-325f-b538-38cb743255fb",
                        "glosses": [
                            "Veranstaltung am Abend (nach 18:00 Uhr)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c69a4545-2f28-402f-a7c2-c20e54f41675",
                                "sense_id": "631a1982-7a07-3c8d-b4b2-b29f7e826af2",
                                "text": "Nehmen Sie doch bitte auch an unserer Abendveranstaltung teil."
                            },
                            {
                                "example_id": "a3ba25c0-9b28-4843-94e1-df4d7d66be87",
                                "sense_id": "631a1982-7a07-3c8d-b4b2-b29f7e826af2",
                                "text": "„Um unnötiges Gedrängel zu vermeiden, wählte der Besitzer des Tram am Eingang die Teilnehmer der Abendveranstaltung aus.“"
                            },
                            {
                                "example_id": "ccfd3f72-48dc-4d69-ab44-b0668abc9b65",
                                "sense_id": "631a1982-7a07-3c8d-b4b2-b29f7e826af2",
                                "text": "„Doch nach einer langen Woche voller Arbeit und Abendveranstaltungen verspürte Sylvia ein starkes Bedürfnis nach Rückzug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
