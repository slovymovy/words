                "senses": [
                    {
                        "sense_id": "0e0d27a1-14a6-3b0a-9beb-10aa31236fc6",
                        "entry_id": "74081299-d44c-34ad-ae22-fe5b71f28fdd",
                        "glosses": [
                            "ein Geschwür, wie es bei einer Krebserkrankung auftritt"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "879933df-fd55-3d47-b0a9-0b7a16c7bd2b",
                        "entry_id": "74081299-d44c-34ad-ae22-fe5b71f28fdd",
                        "glosses": [
                            "ein Übel, das unaufhaltsam um sich greift"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "d4cf967f-7ea0-4e76-9eea-f990b6945cc4",
                                "sense_id": "879933df-fd55-3d47-b0a9-0b7a16c7bd2b",
                                "text": "„In der Vergangenheit war Microsoft eher durch eine massive Ablehnung von Open Source aufgefallen, deren Firmenchef Steve Ballmer bezeichnete es gar einst als Krebsgeschwür.“"
                            },
                            {
                                "example_id": "edaab214-3ac9-4db8-b073-d6a3b15f5919",
                                "sense_id": "879933df-fd55-3d47-b0a9-0b7a16c7bd2b",
                                "text": "„Als wir näher kommen, erkennen wir, dass die Stadt, die an ihren Rändern wie ein Krebsgeschwür in die Savanne ausfranst, nur aus einstöckigen, aus Lehmziegeln errichteten, wellblechgedeckten Hütten besteht.“"
                            },
                            {
                                "example_id": "3ffeeba6-1f90-438f-bf2f-770151aad874",
                                "sense_id": "879933df-fd55-3d47-b0a9-0b7a16c7bd2b",
                                "text": "„Dieser Satz setzte sich in Udo Deppes Hirn wie ein Krebsgeschwür fest.“"
                            },
                            {
                                "example_id": "0073b9b4-93ed-48a4-820d-f7198100ac89",
                                "sense_id": "879933df-fd55-3d47-b0a9-0b7a16c7bd2b",
                                "text": "„In der Trauerrede auf seinen Amtsvorgänger hatte Nasrallah seinerzeit versichert, dass die Organisation alles daransetzen werde, das ›Krebsgeschwür Israel auszureißen‹, und die ›Juden‹ aufgefordert, ›unser Land zu verlassen, weil für euch bei uns kein Platz ist.‹“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
