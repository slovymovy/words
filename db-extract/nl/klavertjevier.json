                    {
                        "sense_id": "e7503e4f-d96e-3ab2-9422-3448b0474784",
                        "entry_id": "6be501dd-ac08-3c0e-9f95-198d8274ebf4",
                        "glosses": [
                            "vierdelig klaverblad, door sommigen beschouwd als gelukssymbool"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a197a84-8c49-4695-a88c-f119bc4286be",
                                "sense_id": "e7503e4f-d96e-3ab2-9422-3448b0474784",
                                "text": "Beweren dat ufo's echt bestaan en menen dat geheime luchtmachtbases dingen verborgen proberen te houden, is heel wat anders dan geloven dat een klavertjevier geluk brengt."
                            },
                            {
                                "example_id": "aa3f7234-7065-43da-9e03-b3d886f695c1",
                                "sense_id": "e7503e4f-d96e-3ab2-9422-3448b0474784",
                                "text": "Het indrukwekkende middengedeelte werd geflankeerd door drie verdiepingen tellende sierlijke torens, versierd met kantachtige gotische patronen met daarin ramen in de vorm van een klavertjevier."
                            }
                        ]
                    }
