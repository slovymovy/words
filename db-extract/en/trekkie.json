                        "entry_id": "fff4d542-c218-3586-9764-82e44cb85267",
                        "glosses": [
                            "A (usually major) fan of the TV science fiction series Star Trek."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "087ff1c8-415d-4a5b-9216-976c606d3753",
                                "sense_id": "e5ceddc3-19c6-3250-a8e1-198dde60327c",
                                "text": "Not all Trekkies go around speaking Klingon and making endless references to the original Star Trek series."
                            },
                            {
                                "example_id": "9e7499b5-fbea-4c14-960b-5dd525fa0a99",
                                "sense_id": "e5ceddc3-19c6-3250-a8e1-198dde60327c",
                                "text": "1992 StarTrek VI is a fast-moving, vigorous book that will not disappoint the legions of Trekkies who avidly follow the adventure of their heroes. — Review of Star Trek - The Undiscovered Country in Amiga User International, author unknown, December 1992, HHL Publishing (UK), page 90."
                            },
                            {
                                "example_id": "84254f21-55e2-4265-8f63-167608501c78",
                                "sense_id": "e5ceddc3-19c6-3250-a8e1-198dde60327c",
                                "text": "2002 I have a major confession to make which will probably incur the wrath of all Trekkies out there. — Trek & Treat, article in The Daily Mirror (UK), Jessica Mellor, Saturday, August 10, 2002, page 44."
                            }
                        ]
                    }
