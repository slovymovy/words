                ],
                "senses": [
                    {
                        "sense_id": "512a0f0c-b9e4-32a7-9c88-2e2211801859",
                        "entry_id": "94003ba9-e7cf-3088-9648-a1a8b4c20121",
                        "glosses": [
                            "Capacité de la rétine de percevoir deux gammes de couleurs différentes grâce à la présence de deux classes de photorécepteurs différant par la distribution spectrale du rayonnement électromagnétique auquel ils sont sensibles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9ba0f91-4833-41a2-84e6-6b20f90f3047",
                                "sense_id": "512a0f0c-b9e4-32a7-9c88-2e2211801859",
                                "text": "Le dichromatisme visuel est fréquent chez les mammifères, et chez l'homme, on parle même de trichromatisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "cba596d9-d51e-321e-83b0-89b0877d4a93",
                        "entry_id": "94003ba9-e7cf-3088-9648-a1a8b4c20121",
                        "glosses": [
                            "Propriété d'un corps ou d'un objet de se présenter sous deux couleurs distinctes."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "53228fde-2e7b-4aef-a669-14adac6ebcdc",
                                "sense_id": "cba596d9-d51e-321e-83b0-89b0877d4a93",
                                "text": "Pour expliquer le dichromatisme du cristallin jaune, c'est-à-dire , son apparence verte pendant la vie, M. Mackenzie dit que diverses substances présentent une couleur différente , selon qu'elles sont vues par réflexion ou par réfraction."
                            }
                        ]
                    },
                    {
                        "sense_id": "79a31d17-3aa8-3f2f-b01b-32d073f1bf88",
                        "entry_id": "94003ba9-e7cf-3088-9648-a1a8b4c20121",
                        "glosses": [
                            "Propriété au sein d'une même espèce de présenter deux types de coloration à l'état naturel sous l'effet de variations génétiques spontanées, ou dimorphisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f709f22-33c5-4fef-b32e-d01a4477097f",
                                "sense_id": "79a31d17-3aa8-3f2f-b01b-32d073f1bf88",
                                "text": "Dichromatisme individuel chez les Hiboux (Megascops asio) — On sait que, dans l'Amérique du Nord, les Hiboux de l'espèce Megascops asio ont le plumage soit brun rouge, soit gris."
                            }
                        ]
                    }
