                "senses": [
                    {
                        "sense_id": "f0eb738a-74f0-3e75-ae10-b0ea22612d61",
                        "entry_id": "af42cdf6-1f9b-3edd-b1bf-35cd1bd76416",
                        "glosses": [
                            "довести кого-либо до изнеможения или смерти при помощи телесных наказаний"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ad4ef7-93eb-4f9c-a02e-24a7541fe96d",
                                "sense_id": "f0eb738a-74f0-3e75-ae10-b0ea22612d61",
                                "text": "Самое удобное для правительства было бы казнить отказавшегося: засечь палками или каким-нибудь иным способом, как это делалось прежде."
                            },
                            {
                                "example_id": "744834ed-670e-4c10-a3af-9c6bbdeacee3",
                                "sense_id": "f0eb738a-74f0-3e75-ae10-b0ea22612d61",
                                "text": "Но, однако же, с пятисот, даже с четырехсот розог можно засечь человека до смерти; а свыше пятисот почти наверно."
                            }
                        ]
                    },
                    {
                        "sense_id": "15102df0-06c5-3a93-b950-6b2935b6ea21",
                        "entry_id": "af42cdf6-1f9b-3edd-b1bf-35cd1bd76416",
                        "glosses": [
                            "сделать засечку на чём-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "70e1bb46-5ade-39bf-957f-5718169a0f34",
                        "entry_id": "af42cdf6-1f9b-3edd-b1bf-35cd1bd76416",
                        "glosses": [
                            "заметить, обнаружить удалённый или изначально скрытый объект"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bfe32d8-33e4-4a61-bee5-58782d8835a0",
                                "sense_id": "70e1bb46-5ade-39bf-957f-5718169a0f34",
                                "text": "Это та самая миномётная батарея, которую мы никак не можем засечь."
                            },
                            {
                                "example_id": "e72acdd7-d930-4576-b3db-9d782dfb6a8e",
                                "sense_id": "70e1bb46-5ade-39bf-957f-5718169a0f34",
                                "text": "За машиной охраняемого идет вторая, с интервалом, чтобы засечь возможную слежку."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1b68f3e-67c7-302d-8703-ec6e5ef1de77",
                        "entry_id": "af42cdf6-1f9b-3edd-b1bf-35cd1bd76416",
                        "glosses": [
                            "измерить продолжительность чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5093db82-7180-4049-bdf6-db1e8478d874",
                                "sense_id": "f1b68f3e-67c7-302d-8703-ec6e5ef1de77",
                                "text": "Он хотел засечь время телефонного разговора, чтобы иметь какое-то представление о личности шантажиста."
                            }
                        ]
                    }
                ],
