                        ],
                        "form": "die Gefolgsleute"
                    },
                    {
                        "form_id": "d2c98e69-3024-407c-a2b8-f114e3005ab1",
                        "entry_id": "f6fc470b-0aaf-3684-a0e4-f8bad6a6cdaf",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gefolgsmänner"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "033e3555-2f72-3939-95a7-7326a700020b",
                        "entry_id": "f6fc470b-0aaf-3684-a0e4-f8bad6a6cdaf",
                        "glosses": [
                            "jemand, der jemandem Gefolgschaft leistet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cdcc8ef-c923-436c-9e66-93e8b892f82e",
                                "sense_id": "033e3555-2f72-3939-95a7-7326a700020b",
                                "text": "„Oft können in einer Region einzig die Goden eine größere Gruppe an Gefolgsleuten hinter sich versammeln.“"
                            },
                            {
                                "example_id": "6b016894-3331-4f2b-b86d-272e8042b9fc",
                                "sense_id": "033e3555-2f72-3939-95a7-7326a700020b",
                                "text": "„Seine engsten Gefolgsleute hieben in dieselbe Kerbe.“"
                            },
                            {
                                "example_id": "37b80252-fa83-4ce5-b41f-f8376b5d5528",
                                "sense_id": "033e3555-2f72-3939-95a7-7326a700020b",
                                "text": "„Die Herren wiesen gleichwohl ihre Gefolgsleute an, heimzugehn, im Kloster zu rasten und sie in der Frühe des nächsten Tages mit Pferden abzuholen.“"
                            },
                            {
                                "example_id": "6da12f22-7f44-4cb7-a5bd-7dd1511658eb",
                                "sense_id": "033e3555-2f72-3939-95a7-7326a700020b",
                                "text": "„Selbst als die Rajputenfürsten ihre treuesten Gefolgsleute wurden, weihten sie sie nicht in diese Kunst ein.“"
                            },
                            {
                                "example_id": "ce5f9bda-96bc-4a1c-a6b5-5c3f4fcd7ddb",
                                "sense_id": "033e3555-2f72-3939-95a7-7326a700020b",
                                "text": "„Er wurde 1729 von Nader Schah aus dem Turkstamm der Afschar, einem Gefolgsmann der Safawiden, besiegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "403e8f8d-ed77-4387-8e2b-04f6c1c9e156",
                        "source_entry_id": "f6fc470b-0aaf-3684-a0e4-f8bad6a6cdaf",
                        "source_sense_id": "033e3555-2f72-3939-95a7-7326a700020b",
                        "source_sense_description": "jemand, der jemandem Gefolgschaft leistet",
                        "target_lang_word": "partisan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partisan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42e97748-9291-3f7e-92f7-c20da9958c29",
                                        "entry_id": "89070f84-4d7e-373a-b2b7-c97b98cafba8",
                                        "glosses": [
                                            "Qui fait preuve de parti pris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46d48cfc-f18b-4ae8-baa3-1b56b49986a8",
                                                "sense_id": "42e97748-9291-3f7e-92f7-c20da9958c29",
                                                "text": "Les deux consultants se disent donc partisans d’une réforme de la comptabilité publique afin qu’elle soit davantage en adéquation avec la réalité opérationnelle."
                                            },
                                            {
                                                "example_id": "8326bac7-c27d-485b-8eaa-2d0d890a2f93",
                                                "sense_id": "42e97748-9291-3f7e-92f7-c20da9958c29",
                                                "text": "Un comportement partisan."
                                            },
                                            {
                                                "example_id": "b33a1680-8684-4133-b00e-ba22c8565c15",
                                                "sense_id": "42e97748-9291-3f7e-92f7-c20da9958c29",
                                                "text": "Querelles partisanes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "partisan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2a3900f-1003-3123-a2f4-448861861357",
                                        "entry_id": "23370940-dfb5-3e67-94d4-b6c56a4bf328",
                                        "glosses": [
                                            "Celui qui est attaché à la fortune d’un parti, qui en épouse les intérêts, qui en prend la défense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4cc225f-58f9-4dc8-b091-6ec42f54e6dd",
                                                "sense_id": "f2a3900f-1003-3123-a2f4-448861861357",
                                                "text": "En passant au large d’El-Kçar, nous vîmes au flanc des montagnes des Ahl Serif le camp de Raïssouli, qui mettait à la raison les derniers partisans de son ennemi mortel le caïd Er-Remiki."
                                            },
                                            {
                                                "example_id": "8796f751-5314-4046-9bce-78478bd64292",
                                                "sense_id": "f2a3900f-1003-3123-a2f4-448861861357",
                                                "text": "Muhammad Ahmad, qui l’avait fondé, tirait son inspiration de sa formation soufie, et ses partisans voyaient en lui le mahdi, celui qui est guidé par Dieu pour restaurer le règne de la justice en ce monde."
                                            },
                                            {
                                                "example_id": "6e1d4b8c-3430-41a3-9a7d-b4b9d81f4fb6",
                                                "sense_id": "f2a3900f-1003-3123-a2f4-448861861357",
                                                "text": "Il fallait que les États-Unis prissent le taureau par les cornes pour que les Congolais se réunissent pour former un nouveau gouvernement. Si besoin était, les partisans de Lumumba devaient y entrer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ad926f1-8cd6-3ad6-9557-c83b5c0c607f",
                                        "entry_id": "23370940-dfb5-3e67-94d4-b6c56a4bf328",
                                        "glosses": [
                                            "Celui qui défend une idée ou une doctrine."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf4f89ab-ff86-4206-a8ca-cdf7e0f47987",
                                                "sense_id": "5ad926f1-8cd6-3ad6-9557-c83b5c0c607f",
                                                "text": "On concédera aux partisans de la douceur que la violence peut gêner le progrès économique et même qu’elle peut être dangereuse pour la moralité, lorsqu’elle dépasse une certaine limite."
                                            },
                                            {
                                                "example_id": "d1a3b76d-06de-4131-9b46-b1193ed46866",
                                                "sense_id": "5ad926f1-8cd6-3ad6-9557-c83b5c0c607f",
                                                "text": "Au début de 1840, George Sand prit la tête du mouvement saint-simonien, partisan d’un socialisme humaniste. Elle apprit à faire la différence entre les « cultistes » et les « rationalistes », avec une préférence pour ces derniers."
                                            },
                                            {
                                                "example_id": "b2e848ec-8f34-4d67-8691-23753cc99159",
                                                "sense_id": "5ad926f1-8cd6-3ad6-9557-c83b5c0c607f",
                                                "text": "Si j'ai le soutien de mes partisans, la presse à scandale n'en attendait pas tant pour transformer mon banal coup de fatigue en une pathologie des plus sévères ; je la soupçonne même de se réjouir que je sois enfin amené à payer l'addition...."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa55d92b-42ee-3d5b-90c6-3c35b8f633a7",
                                        "entry_id": "23370940-dfb5-3e67-94d4-b6c56a4bf328",
                                        "glosses": [
                                            "Sous l'influence de parti : «part attribuée à celui qui afferme certains impôts», celui qui a fait un traité avec le roi pour des affaires de finances, qui prenait à ferme les revenus de l’état, les impôts, etc."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e486c46-c762-4ff4-9647-16461a076281",
                                                "sense_id": "aa55d92b-42ee-3d5b-90c6-3c35b8f633a7",
                                                "text": "J’étais plus fier et plus content avec Manon et mes cent pistoles que le plus riche partisan de Paris avec ses trésors entassés."
                                            },
                                            {
                                                "example_id": "3fe22597-d6ea-4e63-8b05-b896b6a87596",
                                                "sense_id": "aa55d92b-42ee-3d5b-90c6-3c35b8f633a7",
                                                "text": "Il s’était fait partisan."
                                            },
                                            {
                                                "example_id": "67be9032-fef9-4ef5-a8df-d297ac72cf34",
                                                "sense_id": "aa55d92b-42ee-3d5b-90c6-3c35b8f633a7",
                                                "text": "Les partisans étaient sujets à être recherchés, à être taxés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1baa2c4-a88c-39b3-885e-c8339537a59b",
                                        "entry_id": "23370940-dfb5-3e67-94d4-b6c56a4bf328",
                                        "glosses": [
                                            "Soldat de troupes légères ou irrégulières, détachées pour faire une guerre de surprises ou d’avant-postes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01c12945-f1f3-421f-a40b-f6ee1b5e9fac",
                                                "sense_id": "a1baa2c4-a88c-39b3-885e-c8339537a59b",
                                                "text": "Il avait pris le maquis un an plus tôt : arrêté par les gendarmes d’Alès, en avril 1943, pour ses activités politiques, il s’était évadé et avait trouvé refuge chez les francs-tireurs et partisans (FTP)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dae6fd48-03f1-40d8-88b7-bce8e497ca27",
                        "source_entry_id": "f6fc470b-0aaf-3684-a0e4-f8bad6a6cdaf",
                        "source_sense_id": "033e3555-2f72-3939-95a7-7326a700020b",
                        "source_sense_description": "jemand, der jemandem Gefolgschaft leistet",
                        "target_lang_word": "partisane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partisane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e0c77a6-c63f-3988-86b2-a9eafbeae4a4",
                                        "entry_id": "fc207b51-c201-385d-97bc-074b2024970d",
                                        "glosses": [
                                            "Celle qui avait fait un traité avec le roi, pour des affaires de finances, qui avait pris à ferme les revenus de l’État, les impôts, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b5cb26e-6656-4603-8521-a8aed2f1c7e3",
                                                "sense_id": "1e0c77a6-c63f-3988-86b2-a9eafbeae4a4",
                                                "text": "Une riche partisane."
                                            },
                                            {
                                                "example_id": "fcd104aa-e594-4af9-abaa-6d5f96ff6cea",
                                                "sense_id": "1e0c77a6-c63f-3988-86b2-a9eafbeae4a4",
                                                "text": "Elle s’était faite partisane."
                                            },
                                            {
                                                "example_id": "a55af518-62ae-4630-8c14-02e4cef5defc",
                                                "sense_id": "1e0c77a6-c63f-3988-86b2-a9eafbeae4a4",
                                                "text": "Les partisanes étaient sujettes à être recherchées, à être taxées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e6b244a-c41f-3cdf-9c7f-81c1e7e251d8",
                                        "entry_id": "fc207b51-c201-385d-97bc-074b2024970d",
                                        "glosses": [
                                            "Combattante par conviction lors de conflits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9763492b-4c1a-42e1-8716-a924e2d38afc",
                                                "sense_id": "6e6b244a-c41f-3cdf-9c7f-81c1e7e251d8",
                                                "text": "De nombreuses femmes entrent dans la Résistance armée et deviennent des partisanes « combattantes ». Le rôle des estafettes est de porter des informations ou des vivres aux groupes de résistants qui vivent cachés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abdbb6f0-d40b-3e39-8c3d-796d8de088f3",
                                        "entry_id": "fc207b51-c201-385d-97bc-074b2024970d",
                                        "glosses": [
                                            "Celle qui est attachée à la fortune d’un parti, qui en épouse les intérêts, qui en prend la défense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ad710b-1644-4a68-8848-56257597c588",
                                                "sense_id": "abdbb6f0-d40b-3e39-8c3d-796d8de088f3",
                                                "text": "Bien sûr, cela ne signifie pas que je sois considérée comme membre d’une association, de la fédération syndicale ou d’une autre organisation au même titre que les autres, mais plutôt qu’ils me perçoivent comme étant « de leur côté », une sympathisante, une partisane de leur cause, mais suffisamment extérieure pour qu’on lui explique les choses au fur et à mesure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07af811c-35c2-38db-8d9d-9f4bfb55f020",
                                        "entry_id": "fc207b51-c201-385d-97bc-074b2024970d",
                                        "glosses": [
                                            "Celle qui défend une idée, une pratique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22cd0a8c-5f72-4bf0-8e9c-135f0c3b9ba7",
                                                "sense_id": "07af811c-35c2-38db-8d9d-9f4bfb55f020",
                                                "text": "Le poème du Jugement des chiens et des oyseaulx intercalé dans le Roy Modus fait dire à la partisane de la fauconnerie que la vénerie n’est pas « déduit à dames », opinion également défendue par Gace de La Buigne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "partisane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d7f6bac-7e07-385e-b49a-a27512e6aced",
                                        "entry_id": "f615a60c-c83b-3808-8896-0b6cbe7d9621",
                                        "glosses": [
                                            "Féminin singulier de partisan."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a689eaab-0f1a-4885-a284-2de54ba04272",
                                                "sense_id": "0d7f6bac-7e07-385e-b49a-a27512e6aced",
                                                "text": "Si le légalisme du PCF participe à la baisse de la criminalité communiste pendant la guerre d’Algérie, c’est avant tout parce que ce dernier est accepté, intériorisé et réapproprié par la très grande majorité des membres du PCF qui, en vertu de leurs trajectoires militantes, de leur socialisation à la discipline partisane ou de leur attachement affectif et idéologique à l’institution, acceptent à des degrés divers et selon des modalités variées les contraintes pratiques du légalisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
