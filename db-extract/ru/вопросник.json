                                "target_senses": [
                                    {
                                        "sense_id": "6c54e947-ae94-3ed3-b597-208a3f2bc5e2",
                                        "entry_id": "270a5a05-a347-3a37-8838-f3a043ef8d78",
                                        "glosses": [
                                            "Formular zur Erfassung von Antworten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd5bec05-5371-42c2-81ea-32ad79132c70",
                                                "sense_id": "6c54e947-ae94-3ed3-b597-208a3f2bc5e2",
                                                "text": "Man bekam wahnsinnig neugierige Fragebögen, die selbst die Halsweite des Vaters wissen wollten, zum Ausfüllen vorgelegt."
                                            },
                                            {
                                                "example_id": "27beb310-2565-4d44-be6a-db250d682cf0",
                                                "sense_id": "6c54e947-ae94-3ed3-b597-208a3f2bc5e2",
                                                "text": "„Mit entsprechenden Fragebögen kann man jedem seinen Wahnsinn nachweisen.“"
                                            },
                                            {
                                                "example_id": "1fc41cb0-7a82-4a1d-a242-73ebbb841519",
                                                "sense_id": "6c54e947-ae94-3ed3-b597-208a3f2bc5e2",
                                                "text": "„Er war, siehst du wohl, nicht an jedem Sonntag, wie vorgeschrieben, in der Kirche gewesen, und auch sonst klangen die Antworten auf den Fragebogen nicht allzu positiv.“"
                                            },
                                            {
                                                "example_id": "7dca7428-33df-4a4b-af76-764aa4b2a94a",
                                                "sense_id": "6c54e947-ae94-3ed3-b597-208a3f2bc5e2",
                                                "text": "„Der Fragebogen der Westalliierten enthielt 131 Fragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
