                "senses": [
                    {
                        "sense_id": "647b71cb-d4b0-3ee9-9028-5b3abe2c52c3",
                        "entry_id": "4564b45c-658a-30eb-8bd3-86b67f89b7cf",
                        "glosses": [
                            "Grand reptile carnivore aquatique qu’on ne trouve qu’à l’état fossile, du sous-ordre Plesiosauroidea, de l’ordre Plesiosauria."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8deac44c-572e-4089-a288-18830734f2d7",
                                "sense_id": "647b71cb-d4b0-3ee9-9028-5b3abe2c52c3",
                                "text": "Bichette Cournot courait à travers le siècle comme un pauvre plésiosaure, échappé d’un muséum. Elle était de feu, mais les hommes fuyaient ses étreintes démesurées. De là, grande neurasthénie."
                            },
                            {
                                "example_id": "5a80bf04-02d7-4953-8b0d-e0eecef1c875",
                                "sense_id": "647b71cb-d4b0-3ee9-9028-5b3abe2c52c3",
                                "text": "Aux côtés des nombreux restes de poissons littoraux, les tétrapodes sont représentés par des chéloniens, crocodiliens, ophidiens, plésiosaures, ptérosaures et dinosaures."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8328353c-cae8-4c72-99e4-26f97333ddf5",
                        "source_entry_id": "4564b45c-658a-30eb-8bd3-86b67f89b7cf",
                        "source_sense_id": "647b71cb-d4b0-3ee9-9028-5b3abe2c52c3",
                        "target_lang_word": "plesiosaurus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plesiosaurus",
