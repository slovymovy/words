                            {
                                "target_word": "commons",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9800c2b8-2903-3a33-a9c9-383c5d5a3fb0",
                                        "entry_id": "97014245-770a-377c-ae32-24647ad43e32",
                                        "glosses": [
                                            "A public area, especially a dining hall, at a college or university; a similar shared spaced elsewhere."
                                        ],
                                        "tags": [
                                            "singular",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c14d1bd3-dc04-3ec7-8b86-49aa329bf655",
                                        "entry_id": "97014245-770a-377c-ae32-24647ad43e32",
                                        "glosses": [
                                            "A common (common land); especially, a central section of (usually an older) town, designated as a shared area."
                                        ],
                                        "tags": [
                                            "singular",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8d7e6e1-afe4-4f5f-aa9e-5d0f95c577eb",
                                                "sense_id": "c14d1bd3-dc04-3ec7-8b86-49aa329bf655",
                                                "text": "The Renaissance festival started with the \"peasants\" meeting in the commons."
                                            },
                                            {
                                                "example_id": "da9663f1-e0df-445c-8ca0-6e2c7cee71dd",
                                                "sense_id": "c14d1bd3-dc04-3ec7-8b86-49aa329bf655",
                                                "text": "The commons is the green space surrounded by the village hall, the school, and the church."
                                            },
                                            {
                                                "example_id": "8194e230-8a1d-4501-914a-2051477e0d9e",
                                                "sense_id": "c14d1bd3-dc04-3ec7-8b86-49aa329bf655",
                                                "text": "The commons of New England towns are important contributors to their charm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "242c8495-3051-3270-a46b-568e32638570",
                                        "entry_id": "97014245-770a-377c-ae32-24647ad43e32",
                                        "glosses": [
                                            "The mutual good of all; the abstract concept of resources shared by more than one, for example air, water, information."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58b61850-2b35-466b-9bff-8abdfbea5cb6",
                                                "sense_id": "242c8495-3051-3270-a46b-568e32638570",
                                                "text": "\"The tragedy of the commons\" is that none wish to make sacrifices of their or their family's interests for the common good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e1862e2-82c1-3e0c-96f1-4fe72f9f4950",
                                        "entry_id": "97014245-770a-377c-ae32-24647ad43e32",
                                        "glosses": [
                                            "The common people collectively, the third estate, the people not belonging to the nobility or clergy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f4f744c-08a2-4ecd-ad69-c3bc96cc1613",
                                                "sense_id": "8e1862e2-82c1-3e0c-96f1-4fe72f9f4950",
                                                "text": "We in the name of other Perſean ſtates [i.e. nobles],\nAnd commons of this mightie Monarchy,\nPreſent thee with the Emperiall Diadem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b53332c4-ef2c-3984-aa11-a0b021924645",
                                        "entry_id": "97014245-770a-377c-ae32-24647ad43e32",
                                        "glosses": [
                                            "The free burghers/bourgeoisie of a given town, taken collectively."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00a59c21-6d8e-3bb2-be11-eb7df183bd25",
                                        "entry_id": "97014245-770a-377c-ae32-24647ad43e32",
                                        "glosses": [
                                            "An outhouse."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dea0444a-e18a-33d7-83db-8430278ddbbd",
                                        "entry_id": "97014245-770a-377c-ae32-24647ad43e32",
                                        "glosses": [
                                            "Food served at a fixed rate from the college buttery, distinguished from battels."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a343b466-28c2-4698-8dcc-d12dd8336c54",
                                                "sense_id": "dea0444a-e18a-33d7-83db-8430278ddbbd",
                                                "text": "At the same time, the fashion at Oxford of confining lunch to a \"commons\" of bread and butter and a glass of beer till the crew reaches Putney (when a little meat is allowed,) is unreasonable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "489e511d-3a46-35d6-bd44-b8baaac7995a",
                                        "entry_id": "97014245-770a-377c-ae32-24647ad43e32",
                                        "glosses": [
                                            "Food in general; rations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37065343-43b6-46b2-a6e8-7383a6c39c61",
                                                "sense_id": "489e511d-3a46-35d6-bd44-b8baaac7995a",
                                                "text": "short commons"
                                            }
                                        ]
                                    }
                                ]
