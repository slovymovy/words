                "senses": [
                    {
                        "sense_id": "afb3716b-66f6-394a-9a2e-9640f6979bea",
                        "entry_id": "6002ade7-b095-3218-ac60-743ebb5242c0",
                        "glosses": [
                            "jemand, der durch das Stadtleben geprägt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4a19107-7e97-4d9f-9961-9fd38cd3bc11",
                                "sense_id": "afb3716b-66f6-394a-9a2e-9640f6979bea",
                                "text": "„Später noch blieb er öfter da für ein paar Tage, um sich vom Ärger, der ihn ja weiß Gott oft niederdrückte, zu erholen . Als »unverbesserlicher Stadtmensch, Urbanist« liebte er diese münsterländische Agraridylle nicht dermaßen wie seine Tante, die das Gut, die Gegend, die, so weit man übers flache Land blickt, zum Hof gehört, als ihr »wahres Zuhause, meine Heimat, natürlich im Blochschen Sinn, meinen wirklichen, immerwährenden Genesungsort« bezeichnet."
                            },
                            {
                                "example_id": "a5b34d7e-b400-49a3-848a-cffb9165de6c",
                                "sense_id": "afb3716b-66f6-394a-9a2e-9640f6979bea",
                                "text": "„Der eine war ein dicker Mann in Offiziersuniform, der andre langbeinig und wie ein Stadtmensch angezogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "462ba478-db56-3c66-b520-ae55ca39a39f",
                        "entry_id": "6002ade7-b095-3218-ac60-743ebb5242c0",
                        "glosses": [
                            "jemand, der in der Stadt wohnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9de281b6-a59b-4643-9761-8bbd8ab037dd",
                                "sense_id": "462ba478-db56-3c66-b520-ae55ca39a39f",
                                "text": "„An diesen Tagen konnten gewöhnliche Stadtmenschen von weit hinten im Kirchenschiff die Pracht rund um den Altar bestaunen: kostbar bestickte Messgewänder, triumphierend mit beiden Händen erhobene goldene Kelche, im Halbdunkel schimmernde Bischofsstäbe, perlenbestickte Mitren auf den Häuptern greiser Patriarchen – oder auf denen von Jünglingen, denen die Familie Bistümer besorgt hatte, wie Albrecht von Brandenburg, der mit 23 Erzbischof von Magdeburg und mit 24 Erzbischof von Mainz wurde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff088f07-0b90-4d68-8b3b-18eda49afac6",
                        "source_entry_id": "6002ade7-b095-3218-ac60-743ebb5242c0",
