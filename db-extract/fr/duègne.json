                            },
                            {
                                "target_word": "chaperone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3d98c1b-66e9-3a39-baef-108bc9340269",
                                        "entry_id": "e702d9fb-0f6e-3a3d-bd12-d372b986a078",
                                        "glosses": [
                                            "To act as a chaperone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7836d23-785f-4ea8-9ca4-2d6cfed3fb55",
                                                "sense_id": "b3d98c1b-66e9-3a39-baef-108bc9340269",
                                                "text": "They played you off very cunning, Eliza. If it had been only one of them, you could have nailed him. But you see, there was two; and one of them chaperoned the other, as you might say."
                                            },
                                            {
                                                "example_id": "07dd1689-2bea-438f-8d87-8ac30f38c807",
                                                "sense_id": "b3d98c1b-66e9-3a39-baef-108bc9340269",
                                                "text": "'Purcell had volunteered to chaperone a delegation of female students'"
                                            },
                                            {
                                                "example_id": "ac4e1bb1-a80a-4ffc-96ef-8f86543d22ee",
                                                "sense_id": "b3d98c1b-66e9-3a39-baef-108bc9340269",
                                                "text": "TfL has more than enough to be getting on with each day without having to chaperone TV crews."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81baa6d7-3491-3189-a18b-de7001476d11",
                                        "entry_id": "e702d9fb-0f6e-3a3d-bd12-d372b986a078",
                                        "glosses": [
                                            "To work as a chaperone."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0901d77-90b6-4ba5-a7e3-3de090705190",
                        "source_entry_id": "f22c4afa-7361-3cfb-b16e-8299743afd42",
                        "source_sense_id": "90a1d6c0-0e5a-3751-880c-5f208471ef43",
