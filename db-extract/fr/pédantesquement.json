                "senses": [
                    {
                        "sense_id": "aff7e8b9-659c-3d55-accc-ab4419db2909",
                        "entry_id": "c88ad825-0600-3e7d-93fa-7b04cdfd4736",
                        "glosses": [
                            "D’un air pédant, d’une manière pédante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edae0968-fab3-4bf8-807b-cd9509283925",
                                "sense_id": "aff7e8b9-659c-3d55-accc-ab4419db2909",
                                "text": "Il procédait par l’observation, analysant et classant des faits (instantiæ Naturæ, comme on les désignait assez pédantesquement), et les transformant en lois générales."
                            },
                            {
                                "example_id": "12d7dd36-1a39-43d9-ab0d-c43f697efb4a",
                                "sense_id": "aff7e8b9-659c-3d55-accc-ab4419db2909",
                                "text": "Lorsque ces maîtres franco-parisiens commenceront d’enseigner en déclamant pédantesquement leurs démonstrations scolastiques, les Toulousains cultivés, venus les écouter, éclateront de rire."
                            }
                        ]
                    }
