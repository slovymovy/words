                        "glosses": [
                            "Faire descendre de son piédestal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1d8247d-d070-4bbd-b09f-bfb31c05410f",
                                "sense_id": "79abe256-05b8-381e-96ae-2c2a54669025",
                                "text": "Bon, je pose une question impertinente pour te dépiédestaliser un brin : as-tu tout traduit les composants pour soulager ++ Ni... ?"
                            },
                            {
                                "example_id": "0a137b7d-63ac-492f-8766-e8c0b28bd525",
                                "sense_id": "79abe256-05b8-381e-96ae-2c2a54669025",
                                "text": "Faudrait d'abord que j'arrive à mettre à distance son souvenir, à le « dépiédestaliser » et ça, c'est pas encore gagné."
                            },
                            {
                                "example_id": "f2837d2d-a2c3-410d-94d5-7cbf75298cc5",
                                "sense_id": "79abe256-05b8-381e-96ae-2c2a54669025",
                                "text": "Dépiédestaliser ces êtres sommaires qui ne sont finalement qu'au service de la communauté ?"
                            }
                        ]
                    }
