                        ],
                        "form": "druses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1da6cce8-2791-3e41-b9fc-4c84d4aa928e",
                        "entry_id": "50d6242d-0a58-3ef8-ba4b-9aa6c0bbe186",
                        "glosses": [
                            "Cavité existant en certaines roches, et tapissée de cristaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90e9f65f-96a4-4902-bea8-b4a80c48d676",
                                "sense_id": "1da6cce8-2791-3e41-b9fc-4c84d4aa928e",
                                "text": "Quelquefois le filon renferme une cavité plus ou moins considérable à laquelle on donne le nom de druse ou de poche."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac11f71c-2710-3039-9e07-f1e3a2bd7431",
                        "entry_id": "50d6242d-0a58-3ef8-ba4b-9aa6c0bbe186",
                        "glosses": [
                            "Masse minérale en forme de rognon."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "45775f29-7192-34be-ba13-9d7749fce692",
                        "entry_id": "50d6242d-0a58-3ef8-ba4b-9aa6c0bbe186",
                        "glosses": [
                            "Cristallisation tapissant la surface d’un minéral ou l’intérieur d’une cavité rocheuse, d’une gangue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5da9ab86-546a-46c1-ab0f-2cbc9cea860f",
                                "sense_id": "45775f29-7192-34be-ba13-9d7749fce692",
                                "text": "Sur les parois intérieures d’une première cavité, des concrétions sculptaient des bas-reliefs, près desquels brillaient des druses de quartz et de très gros cristaux de calcite."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c119e55-df94-3605-8f1e-f4dae54df9f1",
                        "entry_id": "50d6242d-0a58-3ef8-ba4b-9aa6c0bbe186",
                        "glosses": [
                            "Drusen."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bcee8e2-50a4-4a47-9740-92afe52fa955",
                        "source_entry_id": "50d6242d-0a58-3ef8-ba4b-9aa6c0bbe186",
                        "source_sense_description": "gangue rocheuse cristallisée",
                        "target_lang_word": "Druse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Druse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb95d330-a3a6-30bc-bbbc-ba660e0e2192",
                                        "entry_id": "60baa01f-0e01-39d4-80a2-2ebf82e02441",
                                        "glosses": [
                                            "Angehöriger einer im Nahen Osten ansässigen Religionsgemeinschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "070c0111-a710-447d-8b10-408576a8132a",
                                                "sense_id": "fb95d330-a3a6-30bc-bbbc-ba660e0e2192",
                                                "text": "Als ein Druse der Gemeinschaft durfte er keine dementsprechenden Angelegenheiten versäumen."
                                            },
                                            {
                                                "example_id": "159f3956-5688-4cb8-ac4c-585da0916a4a",
                                                "sense_id": "fb95d330-a3a6-30bc-bbbc-ba660e0e2192",
                                                "text": "„Das einzige Land, in dem die Drusen eine größere politische Rolle spielen, ist der Libanon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Druse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a92aeb9a-dca9-3a90-90a2-82a8608201e0",
                                        "entry_id": "b0b2fe95-16ba-3c22-bdfe-93d4b0774ce6",
                                        "glosses": [
                                            "kristallgefüllte Gesteinshohlkugel"
                                        ],
                                        "tags": [
                                            "Mineralogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3dfe603-5ae3-4b56-8a79-de9c4b6e7567",
                                                "sense_id": "a92aeb9a-dca9-3a90-90a2-82a8608201e0",
                                                "text": "Die Druse wurde aufgemeißelt, und offenbarte dem Geologen seine einst verborgene, glimmernde Kristalle."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "34a88a29-0411-3e1c-bf84-aa13cde2961e",
                                        "entry_id": "b0b2fe95-16ba-3c22-bdfe-93d4b0774ce6",
                                        "glosses": [
                                            "infektiöse Pferdekrankheit"
                                        ],
                                        "tags": [
                                            "Tierheilkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "769b0f56-fba6-4f59-91c3-50206223c082",
                                                "sense_id": "34a88a29-0411-3e1c-bf84-aa13cde2961e",
                                                "text": "Druse ist eine durch das Bakterium Streptococcus equi hervorgerufene Infektionskrankheit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7ed525fe-40c8-3474-ae2c-28bc4fef8f03",
                                        "entry_id": "b0b2fe95-16ba-3c22-bdfe-93d4b0774ce6",
                                        "glosses": [
                                            "sich in einem Behältnis nach der Gärung von Wein oder Bier als Bodensatz abgesetzte Trubstoffe"
                                        ],
                                        "tags": [
                                            "Brauerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce987f0d-54e0-4efb-827c-34c460f12dfc",
                                                "sense_id": "7ed525fe-40c8-3474-ae2c-28bc4fef8f03",
                                                "text": "Der Hefesatz wird in der Fachsprache auch als Druse bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a556ca33-08b6-303c-8abb-452956c75a9b",
                                        "entry_id": "b0b2fe95-16ba-3c22-bdfe-93d4b0774ce6",
                                        "glosses": [
                                            "kristallhafte Einlagerung in einer Pflanzenzelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "662b743e-6154-4265-9cc4-7ddc35f0e780",
                                                "sense_id": "a556ca33-08b6-303c-8abb-452956c75a9b",
                                                "text": "Kristallaggregate werden Drusen, Bündel nadelförmiger Kristalle Raphiden genannt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
