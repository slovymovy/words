                        "glosses": [
                            "Nom donné à un genre de libellules de grande taille, au vol puissant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d04471f-2b8d-4025-9c88-54935a2e44a4",
                                "sense_id": "03c4b363-1c33-3826-8d80-364aacf03395",
                                "text": "D’un vol calme et puissant, la plus grande de nos libellules, l’anax empereur patrouille, tel un bijou scintillant, le long de la rive ensoleillée du lac de Montorge et soudain, démarre comme une flèche pour expulser, dans un bruissement d’ailes entrechoquées, un congénère qui a eu l’outrecuidance de violer son domaine."
                            },
                            {
                                "example_id": "025b68cd-9573-43e7-b2e8-e4bed6469fb8",
                                "sense_id": "03c4b363-1c33-3826-8d80-364aacf03395",
                                "text": "La larve de l’anax de juin est robuste, glabre et allongée."
                            }
                        ]
                    }
