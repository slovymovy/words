                    },
                    {
                        "translation_id": "d341ed68-691f-443f-b420-131e9b850c1e",
                        "source_entry_id": "836e4490-95b8-321b-a81a-b3ac56a612a1",
                        "source_sense_id": "8dbdb648-c614-3c67-9228-191cfe9ccdb5",
                        "source_sense_description": "fiktives (menschliches) Wesen von der Größe eines menschlichen Daumens",
                        "target_lang_word": "thumbling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thumbling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54735fd0-06be-36ce-9362-c0a3bdd010d5",
                                        "entry_id": "c0b13ee2-9379-3034-a085-5c0dda70ad74",
                                        "glosses": [
                                            "A tiny, thumb-sized person; manikin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2d35377-9ad6-4887-a6a3-99b80cf1398d",
                                                "sense_id": "54735fd0-06be-36ce-9362-c0a3bdd010d5",
                                                "text": "There is a long list of such spirits, including dwarfs, elves, gnomes, brownies, pixies, leprechauns, thumblings (like Tom Thumb), and dactyli (which means fingers). As with the Menehune, the thumblings and the dactyl-fingers are masculine figures, and so are the ancient gnomes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e06e195d-b393-3a52-ab0e-039b75ca1f2d",
                                        "entry_id": "c0b13ee2-9379-3034-a085-5c0dda70ad74",
                                        "glosses": [
                                            "Anything small, comparable to the size of a human thumb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b294a1bc-66fc-4abe-8c3f-75c50eadffea",
                                                "sense_id": "e06e195d-b393-3a52-ab0e-039b75ca1f2d",
                                                "text": "Passing through the kitchen to the scullery, to which place she ordered us, I saw Deborah was very busy frying thumblings — small croquettes about the size of a big man's thumb — […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
