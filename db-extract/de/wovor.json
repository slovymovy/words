        "de-extract.jsonl": [
            {
                "entry_id": "c70f4c7c-dc16-376d-80ad-92fff409f645",
                "word": "wovor",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "38f6967d-9223-3382-a141-f793b66d094b",
                        "entry_id": "c70f4c7c-dc16-376d-80ad-92fff409f645",
                        "glosses": [
                            "leitet eine Frage nach a) einer Sache/einem Sachverhalt b) einem Gegenstand (räumlich) ein; beantwortet wird die Frage beispielsweise mit: Davor …"
                        ],
                        "tags": [
                            "interrogativ"
                        ],
                        "examples": [
                            {
                                "example_id": "8c816175-af48-4001-a9a2-e627d5386ef9",
                                "sense_id": "38f6967d-9223-3382-a141-f793b66d094b",
                                "text": "Wovor sollte ich Angst haben?"
                            },
                            {
                                "example_id": "3d243b0c-e6d8-498d-8c50-ab7780b61a84",
                                "sense_id": "38f6967d-9223-3382-a141-f793b66d094b",
                                "text": "Wovor scheut dieses Pferd zurück?"
                            },
                            {
                                "example_id": "eb0d9c80-f8b0-448e-94b8-97c3e7c4e777",
                                "sense_id": "38f6967d-9223-3382-a141-f793b66d094b",
                                "text": "[Schlagzeile:] „Wovor haben die Deutschen Angst?“",
                                "translation": "Gegenstand (räumlich):"
                            },
                            {
                                "example_id": "fc30cc93-f9ba-49c6-896f-b0d8cf7a8ee5",
                                "sense_id": "38f6967d-9223-3382-a141-f793b66d094b",
                                "text": "Wovor sitzt Du gerade? Genau, vor Deinem Smartphone oder Rechner."
                            },
                            {
                                "example_id": "ea1f7b9f-fc72-4683-9032-99a0fb423aaf",
                                "sense_id": "38f6967d-9223-3382-a141-f793b66d094b",
                                "text": "Wovor treten Präsidenten, Kanzler und Premiers bei einem Gipfel zum Gruppenphoto? Vor eine schöne Kulisse."
                            },
                            {
                                "example_id": "dfce0f4b-ab56-4d65-945e-56a2f381dcef",
                                "sense_id": "38f6967d-9223-3382-a141-f793b66d094b",
                                "text": "„Wovor ſtehen wir hier? Ja, wer das wüßte!“",
                                "translation": "vorgenannte Sache/vorgenannter Sachverhalt:"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "abd486ec-e54e-3e36-a66d-c49ad32210bf",
                        "entry_id": "c70f4c7c-dc16-376d-80ad-92fff409f645",
                        "glosses": [
                            "leitet eine Relativsatz ein, der sich auf a) eine vorgenannte Sache/einen vorgenannten Sachverhalt bezieht, b) einen vorgenannten Gegenstand (räumlich) bezieht"
                        ],
                        "tags": [
                            "relativ"
                        ],
                        "examples": [
                            {
                                "example_id": "d76c29ea-7121-407f-a440-a9d9cd5ecdb1",
                                "sense_id": "abd486ec-e54e-3e36-a66d-c49ad32210bf",
                                "text": "„Die Insel ist von zahlreichen Möwen bevölkert, die in der Zeit von März bis April dort ihre Gelege gegen Touristen verteidigen, wovor mit Schildern gewarnt wird.“"
                            },
                            {
                                "example_id": "c11ab764-a8cf-4135-955c-6f465b41599f",
                                "sense_id": "abd486ec-e54e-3e36-a66d-c49ad32210bf",
                                "text": "Das Einzige, wovor er sich wirklich fürchtete, waren Schlangen."
                            },
                            {
                                "example_id": "041fcac8-e1ec-49b3-a937-d1ecef7dce9b",
                                "sense_id": "abd486ec-e54e-3e36-a66d-c49ad32210bf",
                                "text": "„Millionen Bakterien und Keime auf der Türklinke und dem Smartphone, auf dem Küchenschwamm und auf der Klobrille - das ist unsere Lebensrealität und im Normalfall nichts, wovor man sich fürchten muss.“"
                            },
                            {
                                "example_id": "757d706e-0a28-4d77-877b-3b367e471a64",
                                "sense_id": "abd486ec-e54e-3e36-a66d-c49ad32210bf",
                                "text": "„Der britische Premierminister Winston Churchill sagte: »Das einzige, wovor ich im Krieg wirklich Angst hatte, war die U-Boot-Gefahr.«“"
                            },
                            {
                                "example_id": "b2916951-1c3a-4681-9017-ec4d6e31fee6",
                                "sense_id": "abd486ec-e54e-3e36-a66d-c49ad32210bf",
                                "text": "„Tritt nun das ein, wovor Oppositionelle in Belarus lange gewarnt und wogegen sie sogar protestiert hatten?“"
                            },
                            {
                                "example_id": "4e34040f-ad95-4ef0-a793-6da9e32baa26",
                                "sense_id": "abd486ec-e54e-3e36-a66d-c49ad32210bf",
                                "text": "[Coronapandemie 2021:] „3000 Infektionen bei der EM – Superspreading mit Ansage – Wovor viele gewarnt haben, ist jetzt eingetreten. Tausende Fans durften in und vor den EM-Stadien feiern. UEFA und Johnson schauten zu. Das Ergebnis: 3000 vom Public Health bestätigte Infektionen.“"
                            },
                            {
                                "example_id": "86cf080c-c761-43e0-bba2-b89f2ccf4f04",
                                "sense_id": "abd486ec-e54e-3e36-a66d-c49ad32210bf",
                                "text": "[…] „der polnische Premier tut das, wovor Juristen immer warnen: Er reißt Zitate anderer europäischer Verfassungsgerichte aus dem Zusammenhang, um seine These zu belegen, dass überall in der EU oberste Richter Kritik am Vorrang von EuGH-Entscheidungen üben würden.“"
                            },
                            {
                                "example_id": "1a8c4426-6175-4006-af3b-374d7730eb1c",
                                "sense_id": "abd486ec-e54e-3e36-a66d-c49ad32210bf",
                                "text": "„Wie aus dem Nichts tauchte Ende 2019 in Wuhan das SARS-Co-Virus-2 auf. Es geschah, wovor Expertinnen und Experten schon seit Jahren gewarnt hatten: Ein neuartiges Coronavirus löste eine Pandemie aus.“"
                            },
                            {
                                "example_id": "9074e0e7-75bd-469b-8612-7274bee0a064",
                                "sense_id": "abd486ec-e54e-3e36-a66d-c49ad32210bf",
                                "text": "„Dieser Ruhm, zum Beispiel das Privileg, mit dem Bundespräsidenten zu reden oder in Fernseh-Talkshows zu sitzen, das ist etwas, wovor ich immer noch große Ehrfurcht habe und wofür ich dankbar bin.“",
                                "translation": "vorgenannter Gegenstand (räumlich):"
                            },
                            {
                                "example_id": "d973c08b-9c22-4598-b213-a56b8c160d46",
                                "sense_id": "abd486ec-e54e-3e36-a66d-c49ad32210bf",
                                "text": "„Ein junger Arzt führt uns zu einer Tür, wovor eine Bank steht.“"
                            },
                            {
                                "example_id": "70f4b8a7-bf98-4bba-b4ae-cbbf146c87b7",
                                "sense_id": "abd486ec-e54e-3e36-a66d-c49ad32210bf",
                                "text": "„Dann öffneten sich die Tore der äußeren und der inneren Mauer, wovor sich eine ganze Truppe an Sicherheitspersonal versammelte.“"
                            },
                            {
                                "example_id": "3a26525f-7cf4-4bef-b875-17e2e6adf9f8",
                                "sense_id": "abd486ec-e54e-3e36-a66d-c49ad32210bf",
                                "text": "„Sie wies mit dem Kopf zum Fenster, wovor sich die Anzahl der Protestierenden seit den ersten Todesfällen vervielfacht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
