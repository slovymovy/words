                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Villagers gathered to celebrate the infant's birth at a festive <w>gossiping</w>.",
                            "target_lang_translations": {
                                "ru": "Жители деревни собрались, чтобы отпраздновать рождение младенца на праздничных <w>крестинах</w>."
