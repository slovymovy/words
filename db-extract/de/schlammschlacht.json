                    {
                        "translation_id": "a18743d4-d944-4828-8bad-8a3e7a56d85d",
                        "source_entry_id": "cbb3ae45-b114-39c2-8d6a-25b91994675a",
                        "source_sense_id": "199ba29e-79dd-3e50-b429-26fb651bc9b9",
                        "source_sense_description": "Sport: Spiel auf einem morastigem Untergrund",
                        "target_lang_word": "moddergevecht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moddergevecht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8ef98020-115c-342e-b437-46f618ffde74",
                                        "entry_id": "c5772070-7c34-304b-bb58-16e860777a28",
                                        "glosses": [
                                            "wedstrijd tussen twee mensen of groepen mensen, die in een bad met modder met elkaar vechten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48f3b520-a38a-42e8-a74c-ea6e6744290d",
                                                "sense_id": "8ef98020-115c-342e-b437-46f618ffde74",
                                                "text": "'Moddergevecht' voor doordouwers bij Tot de Nek in de Drek in Vriezenveen: Bijna vierduizend 'modderfokkers' en 'drek queens' vermaken zich tijdens Tot de Nek in de Drek. Een pittig tochtje door de Vriezenveense blubber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d31888b3-3c19-38ea-a4ee-41a3c0a4440b",
                                        "entry_id": "c5772070-7c34-304b-bb58-16e860777a28",
                                        "glosses": [
                                            "smerige manier van met elkaar discussiëren"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc9eb9af-2848-4c75-b094-c2612361f409",
                                                "sense_id": "d31888b3-3c19-38ea-a4ee-41a3c0a4440b",
                                                "text": "Politieke kringen kijken stilaan bezorgd uit naar de komende verkiezingscampagnes. Die dreigen bijzonder bits te worden. ‘We zijn nog niet aan onze nieuwe patatjes’, klinkt het besmuikt. De wijze waarop Dedecker Groen aan de schandpaal nagelde, deed denken aan de attack ads die in Amerika allang de gewoonste zaak van de wereld zijn. Meteen draaien verkiezingen niet langer over het toekomstig beleid of over de realisaties, maar over de moraliteit van deze of gene kandidaat of partij. Zo wordt het moddergevecht het nieuwe normaal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
