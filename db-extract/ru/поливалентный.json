                                            },
                                            {
                                                "example_id": "4d5509fa-06fb-48e5-bf90-e76f79e844aa",
                                                "sense_id": "c141b6a9-587b-37ca-a8bd-6ad1b8af5fb7",
                                                "text": "„Bei Entscheidungen unter Unsicherheit bestehen mehrere mögliche Umweltzustände pro Alternative, die Konsequenz ist also nicht eindeutig, sondern mehrwertig.“"
                                            },
                                            {
                                                "example_id": "4d812182-56c8-4434-adfa-1eb598415f30",
                                                "sense_id": "c141b6a9-587b-37ca-a8bd-6ad1b8af5fb7",
                                                "text": "„Leben ist nicht nur zweiwertig (mit den beiden Wahrheitswerten von wahr und falsch), sondern mehrwertig.“"
                                            },
                                            {
                                                "example_id": "e34464b2-2283-4600-98ae-49605f90c583",
                                                "sense_id": "c141b6a9-587b-37ca-a8bd-6ad1b8af5fb7",
                                                "text": "„Zur Vermeidung weiterer Redundanzen und Anomalien werden nun mehrwertige Abhängigkeiten eingeführt.“"
                                            },
                                            {
                                                "example_id": "f5ad87e2-6c1a-45db-af37-21da02c05a3f",
                                                "sense_id": "c141b6a9-587b-37ca-a8bd-6ad1b8af5fb7",
                                                "text": "„Das Ergebnis eines solchen Planungsmodells ist dann eine relativierte mehrwertige Prognose.“"
                                            },
                                            {
                                                "example_id": "d5736682-5db2-40a5-b66e-7bb353b82775",
                                                "sense_id": "c141b6a9-587b-37ca-a8bd-6ad1b8af5fb7",
                                                "text": "„Meist ist das Umfeld hingegen mehrwertig, so dass Entscheidungen unter Ungewissheit erfolgen.“"
                                            },
                                            {
                                                "example_id": "e1280d17-3b9e-4e52-8096-0470b355606b",
                                                "sense_id": "c141b6a9-587b-37ca-a8bd-6ad1b8af5fb7",
                                                "text": "„Die Zukunftsszenarien, die mit den Folgen des weltweiten Schuldgeldsystems verbunden sein können, sind mehrwertig.“"
                                            },
                                            {
                                                "example_id": "86b646ca-af9e-4bfe-95cb-c31179cf02db",
                                                "sense_id": "c141b6a9-587b-37ca-a8bd-6ad1b8af5fb7",
                                                "text": "„In diesem Sinne sind Werkzeuge in der Regel als funktional mehrwertig anzusehen.“"
                                            },
                                            {
                                                "example_id": "91a99cfd-a281-4ea3-b9ef-3b59e79ed5e1",
                                                "sense_id": "c141b6a9-587b-37ca-a8bd-6ad1b8af5fb7",
                                                "text": "„Andere Modelle verwenden diskrete Zustände, die binär oder mehrwertig sein können.“"
                                            },
                                            {
                                                "example_id": "f10aafd1-5663-4343-8db3-a0508d7b1438",
                                                "sense_id": "c141b6a9-587b-37ca-a8bd-6ad1b8af5fb7",
                                                "text": "„Man unterscheidet dabei innerhalb eines Objekts einwertige Eigenschaften, mehrwertige Eigenschaften und NULL-Werte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "723d7a42-b0dc-49fd-a72a-f37fa39067c0",
                        "source_entry_id": "10eea31c-5d29-3e97-98c7-d19ab0a28e38",
                        "target_lang_word": "polyvalent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polyvalent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be521c81-5f0d-3f95-a287-9f07ed51da5f",
                                        "entry_id": "5c320763-d4e6-39f0-a44b-b48ba2ce7a08",
                                        "glosses": [
                                            "aus Antikörpern gegen verschiedene Antigene gemischt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "468cb672-d201-4064-a623-11eb2f030e43",
                                                "sense_id": "be521c81-5f0d-3f95-a287-9f07ed51da5f",
                                                "text": "„Kommerziell erhältliche Produkte sind darum polyvalente Mischungen verschiedener Seren, z. B. das Schlangengift-Immunserum ‚Europa‘ gemäß Europäischem Arzneibuch (Kreuzotter, Bergotter, Sandotter, Aspisviper, Levante-Viper).“"
                                            },
                                            {
                                                "example_id": "f87478e7-819b-47ad-9ca3-20cfe57dc48d",
                                                "sense_id": "be521c81-5f0d-3f95-a287-9f07ed51da5f",
                                                "text": "„Man kann sich also durchaus eine Art polyvalente Vakzine gegen die meisten Krebsarten vorstellen.“"
                                            },
                                            {
                                                "example_id": "7666b055-cf83-4de4-98f5-1fcfb229b784",
                                                "sense_id": "be521c81-5f0d-3f95-a287-9f07ed51da5f",
                                                "text": "„Solche Vaccinen gegen die verschiedensten Infektionen sind im Handel zu haben. Es sind meistens polyvalente Impfstoffe, d. h. sie sind aus möglichst verschiedenen Stämmen der betreffenden Bakterien hergestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ed7a336a-102d-3ef2-9789-3598dba96442",
                                        "entry_id": "5c320763-d4e6-39f0-a44b-b48ba2ce7a08",
                                        "glosses": [
                                            "mit einer Vielzahl von Ladungen"
                                        ],
                                        "tags": [
                                            "von Ionen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06d5216b-b870-44f4-910d-531371d54dc6",
                                                "sense_id": "ed7a336a-102d-3ef2-9789-3598dba96442",
                                                "text": "„Dadurch, daß die Säureanionen gestreckte polyvalente Kettenmoleküle darstellen, wird eine Art gegenseitiger Festlegung der Säureanionen durch Ionenladungen eintreten.“"
                                            },
                                            {
                                                "example_id": "6c62c957-0e53-4767-941f-8a3c529b7160",
                                                "sense_id": "ed7a336a-102d-3ef2-9789-3598dba96442",
                                                "text": "„Polyäthylenimine sind polyvalente basische Verbindungen; sie können aus wässerigen Lösungen mit starker Kalilauge gefällt werden.“"
                                            },
                                            {
                                                "example_id": "87aa163e-dd13-4a8e-b24f-2d9c277b0c92",
                                                "sense_id": "ed7a336a-102d-3ef2-9789-3598dba96442",
                                                "text": "„In wäßrigem, physiologischem Milieu liegen die Moleküle vieler Proteine als polyvalente lonen vor, da die Aminosäure - Reste noch dissoziierende Gruppen besitzen […].“"
                                            },
                                            {
                                                "example_id": "8f2d110c-891a-428c-9f02-b1dd434fd328",
                                                "sense_id": "ed7a336a-102d-3ef2-9789-3598dba96442",
                                                "text": "„Diese Gestaltänderung tritt ein, sobald die gefalteten Moleküle der undissoziierten Polyacrylsäure durch Zusatz von Alkali in polyvalente Ionen verwandelt werden.“"
                                            },
                                            {
                                                "example_id": "fa181a48-30a8-4287-831e-00e74474eafa",
                                                "sense_id": "ed7a336a-102d-3ef2-9789-3598dba96442",
                                                "text": "„Makroionen können Makrokationen oder Makroanionen oder Makroampholytionen sein mit den entsprechenden mono-, bi- oder polyvalenten, also auch mit makromolekularen Gegenionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "35620213-34b3-322c-9621-41f599e00bee",
                                        "entry_id": "5c320763-d4e6-39f0-a44b-b48ba2ce7a08",
                                        "glosses": [
                                            "mit einer Vielzahl von Lösungen, Bedeutungen, Funktionen oder Ähnlichem"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5d5dc7c-8736-44cd-a227-73b5d114688a",
                                                "sense_id": "35620213-34b3-322c-9621-41f599e00bee",
                                                "text": "„Eine besondere Art offener Aufgaben sind polyvalente Aufgaben. Diese Bezeichnung hat sich bei unseren Forschungsarbeiten zu speziellen offenen Aufgaben herausgebildet.“"
                                            },
                                            {
                                                "example_id": "9f28c181-bb0f-4916-a972-e09f070a86b3",
                                                "sense_id": "35620213-34b3-322c-9621-41f599e00bee",
                                                "text": "„Die polyvalente Gottheit Saturn ist mit Ackerbau und mit den Saturnalien assoziiert.“"
                                            },
                                            {
                                                "example_id": "59bc0cfd-df5f-4dd3-8083-9e0617f774fc",
                                                "sense_id": "35620213-34b3-322c-9621-41f599e00bee",
                                                "text": "„Wein ist in der Welt der griechisch-hellenistischen Antike fest verbunden mit der Gottheit Dionysos, wobei Wein nur als ein Bereich der polyvalenten Gottheit gilt.“"
                                            },
                                            {
                                                "example_id": "ffe9a6a6-4360-4f08-8c5b-1ba3911c359f",
                                                "sense_id": "35620213-34b3-322c-9621-41f599e00bee",
                                                "text": "„Texte sind polyvalente Phänomene – schon in ihrem Entstehungsmoment.“"
                                            },
                                            {
                                                "example_id": "cbd10b2b-e7e9-4272-ad20-22221afe2214",
                                                "sense_id": "35620213-34b3-322c-9621-41f599e00bee",
                                                "text": "„Lurche, vor allem Frösche, können polyvalente Wirte für verschiedene parasitäre Würmer sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
