                "senses": [
                    {
                        "sense_id": "21270f48-bf9f-364f-aea8-b438ac9294b8",
                        "entry_id": "1255e213-296e-302a-9c5c-2c087a5c9ee3",
                        "glosses": [
                            "autoritair en arrogant waardoor minder democratisch, al is het aanvankelijk vaak met de beste bedoelingen"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "7ff13b87-70ff-4f48-bf14-447fe4e1bf85",
                                "sense_id": "21270f48-bf9f-364f-aea8-b438ac9294b8",
                                "text": "Daar toont zich een tweede vorm van regenteske machtsconcentratie die hinderlijk is voor de democratische transparantie: politici die verkozen mandaten cumuleren."
                            },
                            {
                                "example_id": "1793ddbb-02ec-4680-b7fe-27f541af9de0",
                                "sense_id": "21270f48-bf9f-364f-aea8-b438ac9294b8",
                                "text": "De CDA-fractie is woedend over uitlatingen van raadslid George ten Brummelhuis (BurgerBelangen), afgelopen zaterdag in deze krant. ‘Het vorige college was regentesk’, liet deze onder meer weten."
                            },
                            {
                                "example_id": "edd311b1-dc59-4fad-9299-72e90cd08e88",
                                "sense_id": "21270f48-bf9f-364f-aea8-b438ac9294b8",
                                "text": "Is het idee niet dat je iemand in het zonnetje zet?: „Ik vind dat bevoogding en regentesk. Je moet je maar net in een omgeving begeven die met lintjes bekend is. Anno 2016 eist de overheid heel veel zelfstandigheid. Je moet alles zelf doen. Waarom dan niet je lintje regelen?”"
                            }
                        ]
                    }
