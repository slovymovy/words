                        "glosses": [
                            "Any individual of the extinct marsupial genus Diprotodon, similar to a wombat in appearance but the size of a small elephant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab56f74c-e8d7-4ab5-9cc3-6d866e5b3cc4",
                                "sense_id": "4d64e186-254a-3147-afc8-94d2d96f6e00",
                                "text": "It is rather hard to understand how animals so largo and heavy as the diprotodons and gigantic kangaroos could have existed there when the country was in the same state in which it is now,[…]."
                            },
                            {
                                "example_id": "52adac0d-a06d-472f-ae20-aa9cc7ebdf36",
                                "sense_id": "4d64e186-254a-3147-afc8-94d2d96f6e00",
                                "text": "No fewer than eighty diprotodons are represented by the bones already unearthed, […]"
                            },
                            {
                                "example_id": "b35d9373-5a0f-4c7a-97e0-0f13397b470b",
                                "sense_id": "4d64e186-254a-3147-afc8-94d2d96f6e00",
                                "text": "Soon we had a good view of the diprotodons, relatives of the present-day wombat but vastly larger."
                            }
                        ]
                    }
