                        "examples": [
                            {
                                "example_id": "bd7870ee-b450-4719-b5dd-8864ebf7be73",
                                "sense_id": "5c65f950-c952-3ad9-b42a-b923953993b8",
                                "text": "On the island of the Tiber towered the mast-like obelisk of the huge nautiform temple of Aesculapius, whose serpent there deposited, had stayed the plague in the fifth century of Rome."
                            },
                            {
                                "example_id": "1332f599-cfb9-42e9-bd93-166635b1e414",
                                "sense_id": "5c65f950-c952-3ad9-b42a-b923953993b8",
                                "text": "[…] nautiform, 15 cm long; male flowers small, mixing with bristle-shaped bractlets. Petals 3, similarly as calyx, smaller. Stamens 3, uniting to form a cylindrical structure; anthers basifixed, linear, 2-celled[…]"
                            },
                            {
                                "example_id": "042f660f-08ed-4a46-99cb-3fbad19dd9d9",
                                "sense_id": "5c65f950-c952-3ad9-b42a-b923953993b8",
                                "text": "[…] inner whorl nautiform, ca. 2.2 mm; synandrium with 9 anthers. Female flowers not seen. Infructescences borne on old stems, stout, carpophores stout, […]"
                            }
                        ]
