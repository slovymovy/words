{
    "word_family": [
        "platinize",
        "platinic",
        "platinous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "30a9f8c7-e7f8-327e-a7db-c143508d412f",
                    "sense_definition": "The chemical element with atomic number 78 and symbol Pt; a dense, malleable, ductile, highly unreactive, silverish-white transition metal of great value.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "element",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wedding ring was made of pure <w>platinum</w> and cost a fortune.",
                            "target_lang_translations": {
                                "ru": "Обручальное кольцо было сделано из чистой <w>платины</w> и стоило целое состояние.",
                                "zh": "这枚结婚戒指是用纯<w>铂金</w>做的，花了一大笔钱。"
                            }
                        },
                        {
                            "text": "Because of its resistance to corrosion, <w>platinum</w> is used in many industrial applications.",
                            "target_lang_translations": {
                                "ru": "Благодаря устойчивости к коррозии <w>платина</w> используется во многих промышленных сферах.",
                                "zh": "由于其耐腐蚀性，<w>铂</w>被广泛应用于许多工业领域。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pure platinum",
                        "platinum group"
                    ],
                    "target_lang_definitions": {
                        "ru": "Химический элемент с атомным номером 78; плотный, ковкий, химически инертный драгоценный металл серебристо-белого цвета.",
                        "zh": "原子序数为78的化学元素，符号为Pt；一种密度高、延展性好、化学性质稳定且价值极高的银白色过渡金属。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "платина",
                                "target_lang_sense_clarification": "химический элемент / металл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铂",
                                "target_lang_sense_clarification": "化学元素"
                            },
                            {
                                "target_lang_word": "白金",
                                "target_lang_sense_clarification": "常用于珠宝首饰的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b110667-96b3-365c-aa61-8d778a00f005",
                    "sense_definition": "A musical recording that has achieved a specific high volume of sales, typically over one million copies.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "music_award",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band has several <w>platinums</w> on their wall from their early career.",
                            "target_lang_translations": {
                                "ru": "На стене у группы висит несколько <w>платиновых дисков</w> времён начала их карьеры.",
                                "zh": "这支乐队的墙上挂着几张他们职业生涯早期的<w>白金唱片</w>。"
                            }
                        },
                        {
                            "text": "Achieving a <w>platinum</w> is much harder in the age of digital streaming.",
                            "target_lang_translations": {
                                "ru": "Получить <w>платину</w> в эпоху цифрового стриминга гораздо сложнее.",
                                "zh": "在数字流媒体时代，获得<w>白金</w>认证要困难得多。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "double platinum",
                        "multi-platinum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальная запись, достигшая высокого объема продаж (обычно более миллиона копий).",
                        "zh": "指销量达到极高标准（通常超过一百万张）的音乐唱片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "платиновый диск",
                                "target_lang_sense_clarification": "награда"
                            },
                            {
                                "target_lang_word": "платина",
                                "target_lang_sense_clarification": "разг. о статусе альбома"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "白金唱片",
                                "target_lang_sense_clarification": "音乐奖项或销量认证"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcefbecf-58c0-363c-ac33-878b02db3608",
                    "sense_definition": "A whitish grey colour, like that of the metal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car was painted in a stunning shade of <w>platinum</w>.",
                            "target_lang_translations": {
                                "ru": "Машина была покрашена в потрясающий <w>платиновый цвет</w>.",
                                "zh": "这辆车被漆成了一种迷人的<w>铂金</w>色。"
                            }
                        },
                        {
                            "text": "She chose a cool <w>platinum</w> for the walls of her modern office.",
                            "target_lang_translations": {
                                "ru": "Она выбрала холодный <w>платиновый цвет</w> для стен своего современного офиса.",
                                "zh": "她为现代风格的办公室墙壁选择了冷色调的<w>铂金</w>色。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Беловато-серый цвет, напоминающий цвет металла платины.",
                        "zh": "一种类似于铂金属的灰白色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "платиновый цвет",
                                "target_lang_sense_clarification": "оттенок"
                            },
                            {
                                "target_lang_word": "цвет платины",
                                "target_lang_sense_clarification": "цвет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铂金色",
                                "target_lang_sense_clarification": "颜色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee5587a1-33f1-3cdc-8d44-d496a3effc37",
                    "sense_definition": "A platinum-based drug used in chemotherapy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor prescribed a <w>platinum</w> to treat the aggressive tumor.",
                            "target_lang_translations": {
                                "ru": "Врач назначил <w>препарат платины</w> для лечения агрессивной опухоли.",
                                "zh": "医生开了一种<w>铂类药物</w>来治疗这种侵袭性肿瘤。"
                            }
                        },
                        {
                            "text": "Patients often respond well to the new generation of <w>platinums</w>.",
                            "target_lang_translations": {
                                "ru": "Пациенты часто хорошо реагируют на новое поколение <w>препаратов платины</w>.",
                                "zh": "患者通常对新一代的<w>铂类药物</w>反应良好。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лекарственный препарат на основе платины, используемый при химиотерапии.",
                        "zh": "一种用于化疗的铂类药物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препарат платины",
                                "target_lang_sense_clarification": "медицина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铂类药物",
                                "target_lang_sense_clarification": "医学"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "119b0ce7-2fa0-3703-8acd-dfb83ebdbd78",
                    "sense_definition": "Very expensive, or of very high quality and status.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to upgrade to the <w>platinum</w> package for our vacation.",
                            "target_lang_translations": {
                                "ru": "Мы решили улучшить наш турпакет до <w>платинового</w> уровня.",
                                "zh": "我们决定将度假套餐升级为<w>白金</w>套餐。"
                            }
                        },
                        {
                            "text": "As a <w>platinum</w> member, you are entitled to free lounge access.",
                            "target_lang_translations": {
                                "ru": "Как <w>платиновый</w> клиент, вы имеете право на бесплатный доступ в лаунж-зону.",
                                "zh": "作为<w>白金</w>会员，您有权免费进入贵宾休息室。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "platinum card",
                        "platinum member",
                        "platinum service",
                        "platinum status"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень дорогой, элитный или высшего качества и статуса.",
                        "zh": "指非常昂贵、高端或具有极高地位的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "платиновый",
                                "target_lang_sense_clarification": "о статусе или услуге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "白金",
                                "target_lang_sense_clarification": "形容等级或服务"
                            },
                            {
                                "target_lang_word": "铂金",
                                "target_lang_sense_clarification": "形容高端级别"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ce2dde3-5ffb-372f-97ee-881fccc45131",
                    "sense_definition": "Of a musical recording that has sold over one million copies.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music_award",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their debut album went <w>platinum</w> within just three months.",
                            "target_lang_translations": {
                                "ru": "Их дебютный альбом стал <w>платиновым</w> всего за три месяца.",
                                "zh": "他们的首张专辑在短短三个月内就达到了<w>白金</w>销量。"
                            }
                        },
                        {
                            "text": "It is a <w>platinum</w> record that defined a generation of pop music.",
                            "target_lang_translations": {
                                "ru": "Это <w>платиновая</w> пластинка, определившая поколение поп-музыки.",
                                "zh": "这是一张定义了一代流行音乐的<w>白金</w>唱片。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go platinum",
                        "platinum album",
                        "platinum record"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к музыкальной записи, проданной тиражом более миллиона копий.",
                        "zh": "指销量超过一百万张的音乐唱片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "платиновый",
                                "target_lang_sense_clarification": "о музыкальном альбоме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "白金",
                                "target_lang_sense_clarification": "形容唱片销量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7d2f38e-8e63-3860-8853-f82c89a451f9",
                    "sense_definition": "Of a whitish grey colour, like that of the metal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is famous for her iconic <w>platinum</w> hair.",
                            "target_lang_translations": {
                                "ru": "Она известна своими культовыми <w>платиновыми</w> волосами.",
                                "zh": "她以标志性的<w>铂金</w>色头发而闻名。"
                            }
                        },
                        {
                            "text": "The sky turned a <w>platinum</w> grey just before the snow started to fall.",
                            "target_lang_translations": {
                                "ru": "Небо стало <w>платиново</w>-серым как раз перед тем, как пошёл снег.",
                                "zh": "下雪前，天空变成了<w>铂金</w>灰色。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "platinum blonde"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беловато-серого цвета, как металл платина.",
                        "zh": "指像铂金属一样的灰白色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "платиновый",
                                "target_lang_sense_clarification": "о цвете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铂金",
                                "target_lang_sense_clarification": "形容颜色"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cdd80ae6-1fb9-3d2f-a993-c131167d7d03",
                    "sense_definition": "To attain all of the achievements or trophies in a video game.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I managed to <w>platinum</w> the game after playing for two hundred hours.",
                            "target_lang_translations": {
                                "ru": "Мне удалось <w>выбить платину</w> в игре после двухсот часов прохождения.",
                                "zh": "在玩了二百个小时后，我终于成功<w>白金</w>了这款游戏。"
                            }
                        },
                        {
                            "text": "He tries to <w>platinum</w> every new release in the series.",
                            "target_lang_translations": {
                                "ru": "Он пытается <w>выбить платину</w> в каждом новом выпуске серии.",
                                "zh": "他试图<w>白金</w>该系列的每一部新作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "platinum a game"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Получить все достижения или трофеи в видеоигре.",
                        "zh": "指在电子游戏中获得所有成就或奖杯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбить платину",
                                "target_lang_sense_clarification": "игровой сленг"
                            },
                            {
                                "target_lang_word": "получить платину",
                                "target_lang_sense_clarification": "об играх"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "白金",
                                "target_lang_sense_clarification": "游戏术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}