                    "frequency": "High",
                    "semantic_group_id": "planet_earth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn kinderen zitten aan de andere kant van de <w>wereld</w> op school.",
                            "target_lang_translations": {
                                "en": "My children go to school on the other side of the <w>world</w>.",
                                "ru": "Мои дети ходят в школу на другом краю <w>света</w>.",
                                "pl": "Moje dzieci chodzą do szkoły na drugim końcu <w>świata</w>.",
                                "de": "Meine Kinder gehen am anderen Ende der <w>Welt</w> zur Schule.",
                                "fr": "Mes enfants vont à l'école à l'autre bout du <w>monde</w>.",
                                "it": "I miei figli vanno a scuola dall'altra parte del <w>mondo</w>.",
                                "cs": "Moje děti chodí do školy na druhém konci <w>světa</w>.",
                                "tr": "Çocuklarım <w>dünyanın</w> öbür ucunda okula gidiyorlar.",
                                "es": "Mis hijos van a la escuela en el otro lado del <w>mundo</w>."
                            }
                        },
                        {
                            "text": "Er zijn miljoenen mensen over de hele <w>wereld</w> die naar dit programma kijken.",
                            "target_lang_translations": {
                                "en": "There are millions of people all over the <w>world</w> watching this program.",
                                "ru": "Миллионы людей по всему <w>миру</w> смотрят эту программу.",
                                "pl": "Są miliony ludzi na całym <w>świecie</w>, którzy oglądają ten program.",
                                "de": "Es gibt Millionen von Menschen auf der ganzen <w>Welt</w>, die diese Sendung sehen.",
                                "fr": "Il y a des millions de personnes dans le <w>monde</w> entier qui regardent cette émission.",
                                "it": "Ci sono milioni di persone in tutto il <w>mondo</w> che guardano questo programma.",
                                "cs": "Na tento pořad se dívají miliony lidí po celém <w>světě</w>.",
                                "tr": "Tüm <w>dünyada</w> bu programı izleyen milyonlarca insan var.",
                                "es": "Hay millones de personas en todo el <w>mundo</w> que ven este programa."
                            }
