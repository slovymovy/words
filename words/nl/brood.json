                    "sense_id": "601377ba-10df-3e98-aca4-db09d744b324",
                    "sense_definition": "Een voedingsmiddel gemaakt van gebakken deeg, meestal bestaande uit meel, water en gist.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik eet elke ochtend twee sneetjes <w>brood</w> met kaas.",
                            "target_lang_translations": {
                                "ru": "Я каждое утро ем два ломтика <w>хлеба</w> с сыром.",
                                "en": "I eat two slices of <w>bread</w> with cheese every morning.",
                                "pl": "Każdego ranka jem dwie kromki <w>chleba</w> z serem.",
                                "de": "Ich esse jeden Morgen zwei Scheiben <w>Brot</w> mit Käse.",
                                "fr": "Je mange deux tranches de <w>pain</w> avec du fromage chaque matin.",
                                "it": "Mangio due fette di <w>pane</w> con formaggio ogni mattina.",
                                "cs": "Každé ráno jím dva krajíce <w>chleba</w> se sýrem.",
                                "tr": "Her sabah peynirli iki dilim <w>ekmek</w> yerim.",
                                "es": "Como dos rebanadas de <w>pan</w> con queso todas las mañanas."
                            }
                        },
                        {
                            "text": "De bakker verkoopt heerlijk vers <w>brood</w>.",
                            "target_lang_translations": {
                                "ru": "Пекарь продает вкусный свежий <w>хлеб</w>.",
                                "en": "The baker sells delicious fresh <w>bread</w>.",
                                "pl": "Piekarz sprzedaje pyszny, świeży <w>chleb</w>.",
                                "de": "Der Bäcker verkauft herrlich frisches <w>Brot</w>.",
                                "fr": "Le boulanger vend du délicieux <w>pain</w> frais.",
                                "it": "Il panettiere vende dell'ottimo <w>pane</w> fresco.",
                                "cs": "Pekař prodává lahodný čerstvý <w>chléb</w>.",
                                "tr": "Fırıncı nefis, taze <w>ekmek</w> satıyor.",
                                "es": "El panadero vende un <w>pan</w> fresco delicioso."
                            }
                        }
