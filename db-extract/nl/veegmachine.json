                                "sense_id": "e0ea381e-106a-3f85-bb46-f0fa8f26b2c9",
                                "text": "Een veegmachine veegt het voorplein van Paleis Noordeinde in Den Haag."
                            },
                            {
                                "example_id": "67e140ad-ff9e-45df-8b13-f5a4beeeac82",
                                "sense_id": "e0ea381e-106a-3f85-bb46-f0fa8f26b2c9",
                                "text": "Dat resulteert in bijvoorbeeld het schoonmaken van een parkeervak, waar de veegmachine niet bij kan of het weghalen van onkruid waar de maaiers niet bij kunnen."
                            }
                        ]
                    },
