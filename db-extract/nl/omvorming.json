                ],
                "senses": [
                    {
                        "sense_id": "e7683ef4-d798-3da1-9161-d7d944ad1266",
                        "entry_id": "a4cf28ac-052d-3e5f-864b-fc2eed74cb8f",
                        "glosses": [
                            "verandering van vorm of functie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1652d5f-8849-4edf-8ae3-886306a025a7",
                                "sense_id": "e7683ef4-d798-3da1-9161-d7d944ad1266",
                                "text": "Onder leiding van Legro begon de omvorming van Transavia van een chartermaatschappij die vooral reisorganisaties bediende, tot een aanbieder van lijnvluchten naar vooral populaire zonbestemmingen."
                            },
                            {
                                "example_id": "d19e9f7f-58af-478f-8d76-61b181685814",
                                "sense_id": "e7683ef4-d798-3da1-9161-d7d944ad1266",
                                "text": "Kijkshop was om die reden dan ook begonnen met een omvorming naar een nieuw onlinewinkelconcept, waarbij al in maart de sluiting van twintig winkels werd aangekondigd."
                            },
                            {
                                "example_id": "ec419fc2-f832-4198-b6dc-267a3d29f588",
                                "sense_id": "e7683ef4-d798-3da1-9161-d7d944ad1266",
                                "text": "De Algemene Onderwijsbond (AOb) en CNV Onderwijs haastten zich donderdagochtend om PO in Actie te feliciteren met de omvorming naar een vakbond."
                            },
                            {
                                "example_id": "38f7b099-cc9b-42f3-8fdf-0bd67857426a",
                                "sense_id": "e7683ef4-d798-3da1-9161-d7d944ad1266",
                                "text": "Met de verkiezingen van juni moet de omvorming afgerond worden. De president is dan tegelijkertijd staatshoofd en premier met verreikende volmachten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdb24545-a497-4d4b-94b3-896cf4c1c024",
                        "source_entry_id": "a4cf28ac-052d-3e5f-864b-fc2eed74cb8f",
