{
    "word_family": [
        "matting",
        "matted"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "abfee82a-c96d-3834-a49c-8896a5702be8",
                    "sense_definition": "A flat piece of coarse material used for wiping one’s feet, or as a decorative or protective floor covering.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "covering_pad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please wipe your dirty shoes on the <w>mat</w> before entering the house.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, вытри грязную обувь о <w>коврик</w> перед входом в дом.",
                                "zh": "进屋前请把脏鞋在<w>地垫</w>上蹭干净。"
                            }
                        },
                        {
                            "text": "There is a welcome <w>mat</w> right in front of the front door.",
                            "target_lang_translations": {
                                "ru": "Прямо перед входной дверью лежит приветственный <w>коврик</w>.",
                                "zh": "前门正前方放着一块欢迎<w>地垫</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "doormat",
                        "rug"
                    ],
                    "common_phrases": [
                        "welcome mat",
                        "door mat",
                        "bath mat",
                        "floor mat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоский кусок грубого материала, используемый для вытирания ног, или как декоративное или защитное покрытие пола.",
                        "zh": "一种平坦的粗糙材料，用于擦拭鞋底或作为装饰性、保护性的地面覆盖物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коврик",
                                "target_lang_sense_clarification": "небольшой ковер"
                            },
                            {
                                "target_lang_word": "половик",
                                "target_lang_sense_clarification": "для вытирания ног"
                            },
                            {
                                "target_lang_word": "циновка",
                                "target_lang_sense_clarification": "плетеная из соломы или тростника"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地垫",
                                "target_lang_sense_clarification": "放在门口用于擦鞋的垫子"
                            },
                            {
                                "target_lang_word": "脚垫",
                                "target_lang_sense_clarification": "用于擦脚或防滑的垫子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df381682-2983-353d-96d1-f1e6e5bea139",
                    "sense_definition": "A small flat piece of material used to protect a surface from anything hot or rough; a coaster.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "covering_pad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waiter placed a beer <w>mat</w> under my glass to keep the table dry.",
                            "target_lang_translations": {
                                "ru": "Официант положил <w>подставку</w> под мой стакан с пивом, чтобы стол оставался сухим.",
                                "zh": "服务员在我的杯子下放了一个<w>杯垫</w>，以保持桌面干燥。"
                            }
                        },
                        {
                            "text": "We always use a <w>mat</w> on the dining table when serving hot dishes.",
                            "target_lang_translations": {
                                "ru": "Мы всегда используем <w>подставку</w> на обеденном столе при подаче горячих блюд.",
                                "zh": "上热菜时，我们总会在餐桌上放一个<w>餐垫</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coaster",
                        "placemat",
                        "pad",
                        "protector"
                    ],
                    "common_phrases": [
                        "place mat",
                        "beer mat",
                        "table mat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой плоский кусок материала, используемый для защиты поверхности от чего-либо горячего или шероховатого; подставка.",
                        "zh": "一种小型平坦材料，用于保护桌面免受高温或粗糙物体的损坏；杯垫或餐垫。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подставка",
                                "target_lang_sense_clarification": "под кружку или тарелку"
                            },
                            {
                                "target_lang_word": "салфетка",
                                "target_lang_sense_clarification": "сервировочная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杯垫",
                                "target_lang_sense_clarification": "放在杯子下保护桌面的垫子"
                            },
                            {
                                "target_lang_word": "餐垫",
                                "target_lang_sense_clarification": "放在餐具下保护桌面的垫子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "877095f8-b78c-39d2-84e8-20033b8d446f",
                    "sense_definition": "A floor pad to protect athletes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "covering_pad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gymnast landed safely on the soft <w>mat</w> after her jump.",
                            "target_lang_translations": {
                                "ru": "Гимнастка благополучно приземлилась на мягкий <w>мат</w> после прыжка.",
                                "zh": "体操运动员跳跃后安全地落在了柔软的<w>垫子</w>上。"
                            }
                        },
                        {
                            "text": "You should bring your own yoga <w>mat</w> to the exercise class.",
                            "target_lang_translations": {
                                "ru": "Тебе следует принести свой собственный <w>коврик</w> для йоги на занятие.",
                                "zh": "你应该带上自己的<w>瑜伽垫</w>去参加健身课。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "yoga mat",
                        "gym mat",
                        "exercise mat",
                        "wrestling mat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напольное покрытие для защиты спортсменов.",
                        "zh": "用于保护运动员的地面软垫。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мат",
                                "target_lang_sense_clarification": "спортивный"
                            },
                            {
                                "target_lang_word": "коврик",
                                "target_lang_sense_clarification": "для йоги или фитнеса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "垫子",
                                "target_lang_sense_clarification": "通用的软垫"
                            },
                            {
                                "target_lang_word": "瑜伽垫",
                                "target_lang_sense_clarification": "专门用于健身的垫子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8118f0de-220c-302d-8ef5-e69064b2c041",
                    "sense_definition": "A thickly tangled mess.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tangle_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stray dog had a large <w>mat</w> of fur behind its ear.",
                            "target_lang_translations": {
                                "ru": "У бродячей собаки был большой <w>колтун</w> шерсти за ухом.",
                                "zh": "那只流浪狗的耳后有一大团<w>纠结</w>的毛。"
                            }
                        },
                        {
                            "text": "Gardening was difficult because of the thick <w>mat</w> of weeds covering the soil.",
                            "target_lang_translations": {
                                "ru": "Садоводством было трудно заниматься из-за густого <w>сплетения</w> сорняков, покрывающих почву.",
                                "zh": "由于土壤上覆盖着厚厚的<w>乱团</w>杂草，园艺工作变得很困难。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tangle",
                        "knot"
                    ],
                    "common_phrases": [
                        "mat of hair",
                        "mat of weeds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Густая спутанная масса.",
                        "zh": "厚重且纠缠在一起的团块。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колтун",
                                "target_lang_sense_clarification": "сбившейся шерсти или волос"
                            },
                            {
                                "target_lang_word": "сплетение",
                                "target_lang_sense_clarification": "растений или корней"
                            },
                            {
                                "target_lang_word": "ком",
                                "target_lang_sense_clarification": "спутанный комок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乱团",
                                "target_lang_sense_clarification": "纠缠在一起的毛发或杂草"
                            },
                            {
                                "target_lang_word": "纠结",
                                "target_lang_sense_clarification": "指毛发或纤维缠绕成团"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "517545ce-d66b-34a2-8d73-f58ca3c0f792",
                    "sense_definition": "Clipping of <w>material</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to harvest more <w>mats</w> so I can build a fort.",
                            "target_lang_translations": {
                                "ru": "Мне нужно собрать больше <w>материалов</w>, чтобы построить форт.",
                                "zh": "我需要收集更多的<w>材料</w>才能建造堡垒。"
                            }
                        },
                        {
                            "text": "He lost the game because he ran out of <w>mats</w> during the fight.",
                            "target_lang_translations": {
                                "ru": "Он проиграл игру, потому что у него закончились <w>материалы</w> во время боя.",
                                "zh": "他在战斗中因为用光了<w>材料</w>而输掉了比赛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resources",
                        "materials"
                    ],
                    "common_phrases": [
                        "farm mats",
                        "harvest mats"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от слова material (материал).",
                        "zh": "材料（Material）的缩写，常用于游戏语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "материалы",
                                "target_lang_sense_clarification": "ресурсы в играх"
                            },
                            {
                                "target_lang_word": "ресы",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "材料",
                                "target_lang_sense_clarification": "游戏中的资源"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d4c2652-3a15-36d4-bb88-b16854cd9a7e",
                    "sense_definition": "Alternative spelling of <w>matte</w> (decorative border around a picture).",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She chose a white <w>mat</w> to go inside the black frame.",
                            "target_lang_translations": {
                                "ru": "Она выбрала белое <w>паспарту</w>, чтобы вставить его в черную раму.",
                                "zh": "她选了一张白色<w>卡纸边框</w>放在黑色画框里。"
                            }
                        },
                        {
                            "text": "The <w>mat</w> of the photograph had yellowed with age.",
                            "target_lang_translations": {
                                "ru": "<w>Паспарту</w> фотографии пожелтело от времени.",
                                "zh": "照片的<w>卡纸边框</w>已经因年代久远而发黄了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "picture mat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Альтернативное написание слова matte (декоративная рамка вокруг картины).",
                        "zh": "指画框内衬的卡纸边框（同 matte）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паспарту",
                                "target_lang_sense_clarification": "картонная рамка для рисунка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卡纸边框",
                                "target_lang_sense_clarification": "装裱照片或画作的衬纸"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1d97760-bc53-322e-8c44-6df648f412c8",
                    "sense_definition": "Vulgar, obscene, or profane language in Russian and some other Slavic language communities.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel was controversial because it contained a lot of <w>mat</w>.",
                            "target_lang_translations": {
                                "ru": "Роман вызвал споры, потому что в нем было много <w>мата</w>.",
                                "zh": "这部小说引起了争议，因为它包含了很多<w>脏话</w>。"
                            }
                        },
                        {
                            "text": "Using <w>mat</w> is considered very impolite in formal situations.",
                            "target_lang_translations": {
                                "ru": "Использование <w>мата</w> считается очень невежливым в официальных ситуациях.",
                                "zh": "在正式场合使用<w>脏话</w>被认为是非常不礼貌的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "profanity",
                        "obscenity"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Russian culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вульгарная, непристойная или нецензурная лексика в русском и некоторых других славянских языках.",
                        "zh": "俄语及其他斯拉夫语言中的粗俗、淫秽或不雅语言。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мат",
                                "target_lang_sense_clarification": "нецензурная брань"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脏话",
                                "target_lang_sense_clarification": "不雅的语言"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9cbc8e99-4900-3a05-90ee-626e7b1efb5d",
                    "sense_definition": "To form a thick, tangled mess; to interweave into, or like, a mat; to entangle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tangle_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you don't brush the cat regularly, its fur will <w>mat</w>.",
                            "target_lang_translations": {
                                "ru": "Если не расчесывать кошку регулярно, ее шерсть будет <w>сваливаться</w>.",
                                "zh": "如果你不定期给猫梳毛，它的毛就会<w>打结</w>。"
                            }
                        },
                        {
                            "text": "The wet leaves began to <w>mat</w> together on the forest floor.",
                            "target_lang_translations": {
                                "ru": "Мокрые листья начали <w>слеживаться</w> на лесной подстилке.",
                                "zh": "潮湿的叶子开始在森林地面上<w>纠缠</w>在一起。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tangle",
                        "entangle",
                        "knot"
                    ],
                    "antonyms": [
                        "untangle"
                    ],
                    "common_phrases": [
                        "mat together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образовывать густую, спутанную массу; сплетаться или сваливаться.",
                        "zh": "形成厚重、纠缠的团块；缠绕在一起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сваливаться",
                                "target_lang_sense_clarification": "о шерсти"
                            },
                            {
                                "target_lang_word": "слеживаться",
                                "target_lang_sense_clarification": "о листьях или траве"
                            },
                            {
                                "target_lang_word": "спутываться",
                                "target_lang_sense_clarification": "запутываться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打结",
                                "target_lang_sense_clarification": "毛发缠绕在一起"
                            },
                            {
                                "target_lang_word": "纠缠",
                                "target_lang_sense_clarification": "纤维或毛发缠绕"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99c278d3-3506-37b5-a41f-c1570b108e0c",
                    "sense_definition": "To cover, protect or decorate with mats.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>mat</w> the floor to make it safer for the children.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>застелить</w> пол матами, чтобы сделать его безопаснее для детей.",
                                "zh": "他们决定在地面<w>铺设</w>垫子，让孩子们玩耍更安全。"
                            }
                        },
                        {
                            "text": "The gardener <w>matted</w> the delicate plants to protect them from frost.",
                            "target_lang_translations": {
                                "ru": "Садовник <w>укрыл</w> нежные растения, чтобы защитить их от мороза.",
                                "zh": "园丁用垫子<w>覆盖</w>了娇嫩的植物，以保护它们免受霜冻。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать, защищать или украшать матами.",
                        "zh": "用垫子覆盖、保护或装饰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устилать",
                                "target_lang_sense_clarification": "покрывать поверхность"
                            },
                            {
                                "target_lang_word": "застилать",
                                "target_lang_sense_clarification": "покрывать чем-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铺设",
                                "target_lang_sense_clarification": "在地面铺上垫子"
                            },
                            {
                                "target_lang_word": "覆盖",
                                "target_lang_sense_clarification": "用垫子保护物体"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a78acb25-95e1-3da1-b799-9c64dcd8f10d",
                    "sense_definition": "Alternative form of <w>matte</w> (not reflecting light).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car was painted in a stylish <w>mat</w> black finish.",
                            "target_lang_translations": {
                                "ru": "Автомобиль был окрашен в стильный <w>матовый</w> черный цвет.",
                                "zh": "这辆车喷涂了时尚的<w>哑光</w>黑色漆面。"
                            }
                        },
                        {
                            "text": "I prefer <w>mat</w> lipstick because it looks more natural than gloss.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю <w>матовую</w> помаду, потому что она выглядит естественнее, чем блеск.",
                                "zh": "我更喜欢<w>哑光</w>口红，因为它看起来比亮面的更自然。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dull",
                        "flat",
                        "lusterless"
                    ],
                    "antonyms": [
                        "glossy",
                        "shiny"
                    ],
                    "common_phrases": [
                        "mat finish",
                        "mat black"
                    ],
                    "target_lang_definitions": {
                        "ru": "Альтернативная форма слова matte (не отражающий свет).",
                        "zh": "不反光的，无光泽的（同 matte）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матовый",
                                "target_lang_sense_clarification": "лишенный блеска"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哑光",
                                "target_lang_sense_clarification": "没有光泽的表面"
                            },
                            {
                                "target_lang_word": "无光",
                                "target_lang_sense_clarification": "不反光的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
