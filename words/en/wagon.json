                    "synonyms": [
                        "cart",
                        "transport",
                        "haul"
                    ],
                    "common_phrases": [
                        "wagon produce",
                        "wagon goods"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перевозить товары или людей на телеге или фургоне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевозить на телеге",
                                "target_lang_sense_clarification": "транспортировать гужевым транспортом"
                            },
                            {
                                "target_lang_word": "развозить",
                                "target_lang_sense_clarification": "доставлять грузы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdb33733-e37e-3449-87b4-fde9365d3074",
                    "sense_definition": "To travel in a wagon.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pioneers <w>wagoned</w> across the vast plains for months to reach the west coast.",
                            "target_lang_translations": {
                                "ru": "Пионеры месяцами <w>ехали</w> в повозках через бескрайние равнины, чтобы добраться до западного побережья."
                            }
                        },
                        {
                            "text": "They spent the summer <w>wagoning</w> through the countryside, sleeping under the stars each night.",
                            "target_lang_translations": {
                                "ru": "Они провели лето, <w>путешествуя</w> в фургоне по сельской местности и каждую ночь засыпая под звездами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wagon across"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical travel"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествовать в повозке или фургоне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ехать на повозке",
                                "target_lang_sense_clarification": "совершать поездку в телеге"
                            }
                        ]
                    }
                }
            ]
        },
        {
