                ],
                "translations": [
                    {
                        "translation_id": "262c4e76-512d-4dbb-8767-a4357da2a4ab",
                        "source_entry_id": "9496267b-5a37-3f2a-a7d9-a9133e857342",
                        "source_sense_id": "02acdb1b-4359-3c3a-bc08-d34e1ffcce7f",
                        "target_lang_word": "gout",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09e18707-0f59-30f7-863a-4ef62550e6cd",
                                        "entry_id": "b749c29b-38a3-3987-a621-964dadcd1add",
                                        "glosses": [
                                            "An extremely painful inflammation of joints, especially of the big toe, caused by a metabolic defect resulting in the accumulation of uric acid in the blood and the deposition of urates around the joints."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1df2a6fa-b209-475b-9b44-d425eaf09312",
                                                "sense_id": "09e18707-0f59-30f7-863a-4ef62550e6cd",
                                                "text": "Once gout was confined largely to Western civilization (with some outliers, like the Mongol ruler Kublai Khan); now its ravages are global."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                        "entry_id": "b749c29b-38a3-3987-a621-964dadcd1add",
                                        "glosses": [
                                            "A drop; a spurt or splotch."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a95a4788-afb5-48ca-b7db-f02b6039d1cb",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "Alternative forms: gut, gutt"
                                            },
                                            {
                                                "example_id": "9c53b8fc-b86a-4406-9fa9-a9a8970e54c1",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "I see thee still, / And on thy blade and dudgeon gouts of blood."
                                            },
                                            {
                                                "example_id": "d5bf4269-e565-4e79-849d-1018e67bf177",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "... of whose wounds were undefined - and every throb of the veins added length to some of the red streams, that wound down the hollows of the indrawn cheeks - some of them ending in half-clotted gouts or drops."
                                            },
                                            {
                                                "example_id": "219d373d-6cf5-45dd-94ab-1e718effd726",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "... there sprang a gout of black and oozy blood. Whereat a great cry went up and James Mure fell forward on the sand as one suddenly stricken dead."
                                            },
                                            {
                                                "example_id": "5dca2c58-2b04-4508-970a-775c3d58d4f2",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "... gouts or drops from the hand of Zeus."
                                            },
                                            {
                                                "example_id": "024de701-002e-4f96-89db-0b54421810c1",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "... gouts or drops of water on their shield,[…]"
                                            },
                                            {
                                                "example_id": "d18fe2fd-4639-4712-a005-25a3d8103a75",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "[S]mall chunks of rubble and gouts of soot had fallen from the chimney, and were ground into the rug under his unwary feet."
                                            },
                                            {
                                                "example_id": "75bdfd63-ca26-491a-89ca-4baf56708034",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "Another blow sent gouts of blood flying, along with gobbets of flesh."
                                            },
                                            {
                                                "example_id": "645dffdd-0302-4e11-bf0c-462f401d4ab6",
                                                "sense_id": "d92d974c-8fb4-33ea-ba75-b64a9c2b1da2",
                                                "text": "McInnis staggered back and to his feet, the chair flying aside, as a gout of blood spurted from the open wound. Veiksaar screamed, and reached up to claw at her husband's face with her fingernails."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f4efb4b-df93-389c-a83c-d9d35ce7cf30",
                                        "entry_id": "b749c29b-38a3-3987-a621-964dadcd1add",
                                        "glosses": [
                                            "A disease of wheat and cornstalks, caused by insect larvae."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "560d6e74-8e28-3c79-94f1-cbe21b2cdb57",
                                        "entry_id": "6c19f31a-6feb-394f-85ba-0e7b20543a68",
                                        "glosses": [
                                            "To spurt."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa26a548-0d75-426f-b30f-a86fa08f0cb6",
                                                "sense_id": "560d6e74-8e28-3c79-94f1-cbe21b2cdb57",
                                                "text": "Dark blood gouts from the creature's brisket."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ee64b72-6e4c-32d2-81ac-64a0cd7a2720",
                                        "entry_id": "a3f9f887-bb2f-3063-b570-409ee7b8e828",
                                        "glosses": [
                                            "Alternative form of gote (“sluice, ditch, drain; vault”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eab0f7d7-fc4d-4c52-b7bf-28963f6cd57c",
                                                "sense_id": "4ee64b72-6e4c-32d2-81ac-64a0cd7a2720",
                                                "text": "... Anton's Gout, let it be enlarged to whatever extent it may. The Sill of Anton's Gout is 2 feet 3 inches higher than the Sill of Maud Foster, and the surface of the water, in times when there is a full quantity in the Witham, and as[…]"
                                            },
                                            {
                                                "example_id": "a463abd1-4278-445e-b68c-da2267b6799a",
                                                "sense_id": "4ee64b72-6e4c-32d2-81ac-64a0cd7a2720",
                                                "text": "... Anton's Gout, and the remainder was drained through Maud Foster's Gout, a sluice discharging the waters into Boston Haven, a mile below the town. In 1801, an Act was obtained for the drainage of these fens, the area of which was[…]"
                                            },
                                            {
                                                "example_id": "7fc71d8b-6205-408a-9bcb-2c04ef0c4633",
                                                "sense_id": "4ee64b72-6e4c-32d2-81ac-64a0cd7a2720",
                                                "text": "Vast quantities of water were discharged, which used to enter through the Gout at Langare.\" - Will. Chapman, Facts and Remarks relative to the Witham and the Welland, 1800, p. 29."
                                            },
                                            {
                                                "example_id": "28bf823e-840f-45d9-98fa-561149353b9a",
                                                "sense_id": "4ee64b72-6e4c-32d2-81ac-64a0cd7a2720",
                                                "text": "[…] reported as to the gout at Aston Somerville […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d125d292-b719-36f4-b035-ed1b8581791f",
                                        "entry_id": "40f26401-961b-31c6-9250-88d6affb7bc1",
                                        "glosses": [
                                            "Taste; relish."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e297b3a-5e72-4a0f-88dc-c9ec27cbae26",
                                                "sense_id": "d125d292-b719-36f4-b035-ed1b8581791f",
                                                "text": "After a time, however, he became more sensible of the reviving influence proceeding from renewed energy; luxurious indolence had for ever lost to him its goût;[…]"
                                            },
                                            {
                                                "example_id": "bb1cd59b-a8a4-4185-a60f-a3fa5c4e5f84",
                                                "sense_id": "d125d292-b719-36f4-b035-ed1b8581791f",
                                                "text": "A modern refinement is to put laver in the dripping-pan, which, in basting, imparts a high gout: or a large saddle may be served over a pound and a half of laver, stewed in brown sauce with catsup […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
