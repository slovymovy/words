                "senses": [
                    {
                        "sense_id": "874bcb86-43d3-3c23-b53b-802bfc5320bb",
                        "entry_id": "25e21102-0b26-34b6-9d73-84e8b739c036",
                        "glosses": [
                            "Klage zwecks Verhinderung/Unterdrückung von Verleumdung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b6d9566-b850-4952-a8a7-7c1a61881918",
                                "sense_id": "874bcb86-43d3-3c23-b53b-802bfc5320bb",
                                "text": "„Schumann reagierte umgehend: Da Wieck mit seinen Vorwürfen auch öffentlich nicht hinter dem Berg hielt, strengte Schumann eine Verleumdungsklage gegen den Musikpädagogen an.“"
                            },
                            {
                                "example_id": "c19bfb60-78a5-4c74-8731-4ff16903b872",
                                "sense_id": "874bcb86-43d3-3c23-b53b-802bfc5320bb",
                                "text": "„Indessen lähmten die unzähligen Verleumdungsklagen gegen Autor, Herausgeber und Drucker von Simon Balcairns letztem Artikel beinahe das Gerichtswesen des ganzen Landes.“"
                            }
                        ],
