                        "form": "das Zugbild"
                    },
                    {
                        "form_id": "a67c12c8-f8a4-4a3e-b2c3-2ddc3fe66135",
                        "entry_id": "ae1a207a-84c5-3c4d-a260-275d60d5a514",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zugbilder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "91082e7f-bcb7-38a9-9c88-76c3eb4420c7",
                        "entry_id": "ae1a207a-84c5-3c4d-a260-275d60d5a514",
                        "glosses": [
                            "optischer Eindruck einer Eisenbahn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ca67e02-dfa1-47f6-b921-cb6bfaf850b2",
                                "sense_id": "91082e7f-bcb7-38a9-9c88-76c3eb4420c7",
                                "text": "„Seither hat sich auch das Zugbild verändert, die Triebwagenanhänger wichen Personenwagen mit Endbühnen.“"
                            },
                            {
                                "example_id": "5957f04c-aec4-450f-8bdd-2a40230a1cc0",
                                "sense_id": "91082e7f-bcb7-38a9-9c88-76c3eb4420c7",
                                "text": "„Die Holz-Pendelzüge prägten lange Zeit das Zugbild im Regionalverkehr Genf-Lausanne, Luzern-Seetal, St. Gallen- Sulgen und um Winterthur und Zürich.“"
                            },
                            {
                                "example_id": "0a88d89e-dbbf-4521-aecb-f268e6502841",
                                "sense_id": "91082e7f-bcb7-38a9-9c88-76c3eb4420c7",
                                "text": "„Dieses Zugbild sah ich vor meinem inneren Auge, als ich die Geschichte von Antonio zum ersten Mal las.“"
                            },
                            {
                                "example_id": "dba1ee9a-709a-4459-874a-80ccb77f644e",
                                "sense_id": "91082e7f-bcb7-38a9-9c88-76c3eb4420c7",
                                "text": "„Mit dem Assoziationsdruck der Zugbilder entstand ein Blitzpanorama dessen, wohin es führen könnte, wenn Flüchtlinge zurückgewiesen werden.“"
                            },
                            {
                                "example_id": "fdb7e339-2dc8-424c-8a31-5b7876080039",
                                "sense_id": "91082e7f-bcb7-38a9-9c88-76c3eb4420c7",
                                "text": "„Gerade in den Einstellungen, die im Santa Fe Railroad Depot des kalifornischen San Bernardino gedreht wurden, entsteht jene transparente Materie aus ephemerem Filmbild und Lokomotivendampf, aus dem Transport des Filmstreifens durch den Projektor und dem Blick aus dem Fenster, der vom Rattern der Schienen begleitet wird; beides, das Filmbild und das Zugbild, animiert vom gleißenden Licht der diegetisch und diskursiv positionierten Scheinwerfer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "da1efa46-fa59-30b8-967b-811b3a8a3763",
                        "entry_id": "ae1a207a-84c5-3c4d-a260-275d60d5a514",
                        "glosses": [
                            "optischer Eindruck des Vogelzugs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f034ddd-4cc6-43e7-b1ad-913b392d7218",
                                "sense_id": "da1efa46-fa59-30b8-967b-811b3a8a3763",
                                "text": "„[Der Kiebitz] beherrscht an gewissen Tagen vollständig das Zugbild.“"
                            },
                            {
                                "example_id": "02a241cb-340b-4d6c-9385-ed602be3ed32",
                                "sense_id": "da1efa46-fa59-30b8-967b-811b3a8a3763",
                                "text": "„Das gesamte Zugbild wie das der einzelnen Arten kann sich in verschiedenen Jahren verschieden gestalten, erst eine Reihe von Beobachtungsjahren gibt ein allgemeingültiges Bild, mit dem die Zugbilder der einzelnen Jahre verglichen werden können um die Abweichungen vom Normalen zu konstatieren und die dabei mitwirkenden Faktoren zu ergründen.“"
                            },
                            {
                                "example_id": "9d77104c-f3a0-426b-b388-0fa008b93909",
                                "sense_id": "da1efa46-fa59-30b8-967b-811b3a8a3763",
                                "text": "„Drury und NISBET (1964) wiesen darauf hin, dass die von ihnen in Nordamerika beobachteten Arten vielleicht andere Fähigkeiten haben als jene, die in Europa das Zugbild bestimmen.“"
                            },
                            {
                                "example_id": "4564510a-862c-4c11-b025-0931a792a359",
                                "sense_id": "da1efa46-fa59-30b8-967b-811b3a8a3763",
                                "text": "„Ein zuverlässiges Zugbild entsteht erst nach mehreren Jahren aufgrund der Durchschnittszahlen.“"
                            },
                            {
                                "example_id": "c1768451-79ac-40d1-8cb9-e29084e4fdc3",
                                "sense_id": "da1efa46-fa59-30b8-967b-811b3a8a3763",
                                "text": "„An der Hand von aufgehängten großen Zugkarten wird nunmehr eine Anzahl Zugbilder, wie sie durch die jüngsten Ringvogelfunde selbsttätig aufgezeichnet und gegen frühere ergänzt wurden, erläutert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ed380f5c-4952-3a52-a3f5-a5dd107f4132",
                        "entry_id": "ae1a207a-84c5-3c4d-a260-275d60d5a514",
                        "glosses": [
                            "ein mechanisches Spielzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d695511-1b02-452f-bca1-d90f53b34385",
                                "sense_id": "ed380f5c-4952-3a52-a3f5-a5dd107f4132",
                                "text": "„In den Kunsthandlungen Wiens, welche nicht das Bedürfniß der höheren Stände ausschließend ins Auge zu fassen sich zur Aufgabe gemacht, verkaufte man damals sogenannte Zugbilder, welche sehr beliebt waren.“"
                            },
                            {
                                "example_id": "5146320b-eeef-449c-85e1-f6481243a41e",
                                "sense_id": "ed380f5c-4952-3a52-a3f5-a5dd107f4132",
                                "text": "„Das vorliegende Zugbilderbuch, von dem nebenstehend der Umschlagtitel und rechts eines von den sechs Zugbildern gebracht werden, führt folgenden Titel: „Die beweglichen Bilder mit der Beschreibung einiger schönen Umgebungen Wiens […]“"
                            },
                            {
                                "example_id": "75d24e06-840a-411b-b72b-8e3c7ca79903",
                                "sense_id": "ed380f5c-4952-3a52-a3f5-a5dd107f4132",
                                "text": "„Ein Zugbild, auf welchem sich durch versteckt angebrachte Züge die Vorstellungen der 4 Jahrszeiten schnell ändern lassen.“"
                            },
                            {
                                "example_id": "06e465a4-a7df-4cf5-89ba-9fdcd91f8d2f",
                                "sense_id": "ed380f5c-4952-3a52-a3f5-a5dd107f4132",
                                "text": "„Zu den Spielwaren der Nr. 299b gehören unter anderem Kinderspielzeug, Bilderspiele, Gesellschaftsspiele, Zauberspiele u. dgl. aus Papier, Pappe, Papiermasse oder Holzfasermasse sowie aus Steinpappe und den zu dieser Klasse gehörigen Formerstoffen, Bilderbücher mit Zugbildern, Christbaumverzierungen, Luftballons, Zerleg- oder Zusammensetzbilder […]“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "efa21d7d-c9cb-3b4d-8e75-2a5a7b911964",
                        "entry_id": "ae1a207a-84c5-3c4d-a260-275d60d5a514",
                        "glosses": [
                            "Aufmerksamkeit hervorrufendes Gemälde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8984c0b6-460b-4faa-9590-842ae9e6dc93",
                                "sense_id": "efa21d7d-c9cb-3b4d-8e75-2a5a7b911964",
                                "text": "„Was aber die diesmalige Ausstellung besonders arm erscheinen ließ – denn jene Uebel alle sind nicht etwa von heut und gestern – das war der gänzliche Mangel einiger sogenannten Zugbilder.“"
                            },
                            {
                                "example_id": "53d4120d-8ea7-4cc9-9594-8671a7dcf681",
                                "sense_id": "efa21d7d-c9cb-3b4d-8e75-2a5a7b911964",
                                "text": "„Zwar weist die gegenwärtige Ausstellung keine Namen ersten Ranges auf, keine sogenannten kräftigen Zugbilder fesseln das Publikum; dagegen ist aber auch die entgegengesetzte Grenze, Bilder von äußerster Mittelmäßigkeit, glücklich vermieden.“"
                            },
                            {
                                "example_id": "b75d319b-2edf-4c74-94a5-e39b9c025fd5",
                                "sense_id": "efa21d7d-c9cb-3b4d-8e75-2a5a7b911964",
                                "text": "„Für den Abgang von eigentlichen ‚Zugbildern‘ wird man indeß durch die reiche Zahl von ganz tüchtigen Kunstwerken nicht ersten Ranges – der Katalog enthält hundert und achtzig Nummern – theilweise enschädigt.“"
                            },
                            {
                                "example_id": "9ccdc727-a3c1-45e7-97f9-83e3991c140a",
                                "sense_id": "efa21d7d-c9cb-3b4d-8e75-2a5a7b911964",
                                "text": "„Zugbilder ersten Rangs in derselben sind die großen Gemälde ‚Die Walpurgisnacht‘ (nach Goethes ‚Faust‘) von Professor Albert Zimmermann in Wien und die ‚Mongolenschlacht‘ von Professor E. Wohnlich in Breslau.“"
                            },
                            {
                                "example_id": "bdfa85c8-6601-41cb-8b3b-6d0903ee18e1",
                                "sense_id": "efa21d7d-c9cb-3b4d-8e75-2a5a7b911964",
                                "text": "„Werke, […] die zum Theil auf einer Reihe von akademischen Ausstellungen die Haupt- und Zugbilder gewesen sind, verleihen dieser Ausstellung eine Bedeutung, welche bisher noch keine andere hier gehabt hat.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "80933e19-74d6-3244-a1e0-79a6552edf46",
                        "entry_id": "ae1a207a-84c5-3c4d-a260-275d60d5a514",
                        "glosses": [
                            "Graffiti auf einem Schienenfahrzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec83c3d-293e-40db-b6a2-8efbe5de82a6",
                                "sense_id": "80933e19-74d6-3244-a1e0-79a6552edf46",
                                "text": "„Wenn du zwei, drei, vier Tage hintereinander nachts solche Bombing-Aktionen machst und am nächsten Morgen die Strecke abfährst, um dein Zugbild zu fotografieren, immer erst vormittags ins Bett kommst […]“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
                ],
