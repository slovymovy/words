                ],
                "senses": [
                    {
                        "sense_id": "3dcc0658-3de6-36c6-9d6c-94e11c97c859",
                        "entry_id": "f0037773-2f89-3b93-8d73-49f3cf6388aa",
                        "glosses": [
                            "一天裡的時刻"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea80bfa-bba0-4e2b-986a-d63f76b15dbb",
                                "sense_id": "3dcc0658-3de6-36c6-9d6c-94e11c97c859",
                                "text": "Als Tageszeiten unterscheiden wir zum Beispiel Morgen, Mittag, Nachmittag, Abend und Nacht.",
                                "translation": "例如，在一天中的时间里，我们分为早上、中午、下午、傍晚和夜间。"
                            },
                            {
                                "example_id": "2b3e74af-66b1-4562-b9e0-28e87d7c3a54",
                                "sense_id": "3dcc0658-3de6-36c6-9d6c-94e11c97c859",
                                "text": "Hier lernst du, wie du zu welcher Tageszeit jemanden begrüßt.",
                                "translation": "在这里，您将学习如何在一天中的不同时间跟别人打招呼。"
                            },
                            {
                                "example_id": "e68304a1-c76c-4138-830a-e1a14d6f4201",
                                "sense_id": "3dcc0658-3de6-36c6-9d6c-94e11c97c859",
                                "text": "Gudrun Heise: Sind Krebszellen nachts aktiv?, Deutsche Welle, 28.06.2022:"
                            },
                            {
                                "example_id": "9729fac7-494b-4a23-9e16-51b5a18cae06",
                                "sense_id": "3dcc0658-3de6-36c6-9d6c-94e11c97c859",
                                "text": "„Metastasen sind meist gefährlicher als der primäre Tumor. Laut einer Schweizer Studie verhalten sich diese Krebszellen je nach Tageszeit unterschiedlich.“",
                                "translation": "“转移瘤通常比原发肿瘤更危险。根据瑞士的一项研究，这些癌细胞在一天中的不同时间表现不同。”"
                            }
                        ]
                    },
                    {
                        "sense_id": "26bcf787-1821-3543-9d5d-64bdb9caa9f7",
                        "entry_id": "f0037773-2f89-3b93-8d73-49f3cf6388aa",
                        "glosses": [
                            "白天，白昼"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "851dc9a1-5855-4e77-88b3-bcc6fc0a1610",
                                "sense_id": "26bcf787-1821-3543-9d5d-64bdb9caa9f7",
                                "text": "Zu dieser Tageszeit sind viele Leute auf der Straße.",
                                "translation": "白天街上有很多人。"
                            },
                            {
                                "example_id": "8493958c-ad64-405b-8ce9-aa9cfc1d974a",
                                "sense_id": "26bcf787-1821-3543-9d5d-64bdb9caa9f7",
                                "text": "In der Nacht sieht der Fluss noch schöner aus als zur Tageszeit.",
                                "translation": "夜晚的河流看起来比白天更加美丽。"
                            }
                        ]
                    }
                ],
