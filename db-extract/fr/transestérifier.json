                "senses": [
                    {
                        "sense_id": "f3974b59-fe90-371e-bd89-7fb9549228a8",
                        "entry_id": "f04893d0-257f-364f-b611-ddbc873f80db",
                        "glosses": [
                            "Transformer un ester et un alcool en un autre ester et autre alcool."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72c78a6d-0b79-43f8-9a18-ef01ccb7fcae",
                                "sense_id": "f3974b59-fe90-371e-bd89-7fb9549228a8",
                                "text": "Partie d'une huile végétale riche en esters oléiques, l'ioder puis transestérifier par l'éthanol."
                            },
                            {
                                "example_id": "91e9adb0-f620-46ee-8c44-f701efe8d87d",
                                "sense_id": "f3974b59-fe90-371e-bd89-7fb9549228a8",
                                "text": "(...) les triglycérides, constituants essentiels des corps gras, en acides gras et glycérine, ou à transestérifier, en produisant des esters et de la glycérine, et à transformer ces esters et acides gras en des produits largement utilisés dans l'industrie chimique."
                            }
                        ]
                    }
