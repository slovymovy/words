                "senses": [
                    {
                        "sense_id": "415a8c47-265d-3452-b68b-77be7e800bb9",
                        "entry_id": "e06cb810-b039-376b-ad89-b87d500e29c4",
                        "glosses": [
                            "to strip bare of something (to take all of something from)"
                        ],
                        "tags": [
                            "perfective",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5c42130b-d264-401c-81cf-f82c76a355ae",
                                "sense_id": "415a8c47-265d-3452-b68b-77be7e800bb9",
                                "text": "Kolejni prezydenci ogołocili Kancelarię Prezydenta m[iędzy] in[nymi] z mebli i sprzętu elektronicznego.",
                                "translation": "Successive presidents have stripped the Presidential Office bare of, among other things, furniture and electronic devices.",
                                "english": "Successive presidents have stripped the Presidential Office bare of, among other things, furniture and electronic devices."
                            },
                            {
                                "example_id": "f765664a-4f05-4781-896d-b9cdee286125",
                                "sense_id": "415a8c47-265d-3452-b68b-77be7e800bb9",
                                "text": "Jesteś taki jak Elías? Mężczyzna, który bierze innych w posiadanie, z wszystkiego ich ogołaca, a potem zostawia na pastwę losu?",
                                "translation": "Are you like Elías? A man who takes others into his possession, takes everything from them, and then leaves them as prey of fortune?",
                                "english": "Are you like Elías? A man who takes others into his possession, takes everything from them, and then leaves them as prey of fortune?"
                            },
                            {
                                "example_id": "09c78958-bd6c-4f14-980f-8c318bc33046",
                                "sense_id": "415a8c47-265d-3452-b68b-77be7e800bb9",
                                "text": "Czekają na człowieka, który mówi im to, co chcą usłyszeć — że masowa imigracja ogałaca Rosję z jej zasobów i rozmywa jej narodową tożsamość...",
                                "translation": "They are waiting for a person who tells them what they want to hear — that mass immigration is stripping Russia bare of its resources and diluting its national identity...",
                                "english": "They are waiting for a person who tells them what they want to hear — that mass immigration is stripping Russia bare of its resources and diluting its national identity..."
                            }
                        ]
                    },
