                ],
                "senses": [
                    {
                        "sense_id": "eb139cc6-bdb9-32fb-b162-e7ba652c6e84",
                        "entry_id": "80c8b018-62d2-3686-b5e6-81d40c4b140c",
                        "glosses": [
                            "Relatif au tréfonds d’un sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2547802e-cabd-4467-9ee1-b4cc15aafac8",
                                "sense_id": "eb139cc6-bdb9-32fb-b162-e7ba652c6e84",
                                "text": "Les religieux de Stavelot, seigneurs tréfonciers de Chooz et de ses appendices, lèvent les amendes à Chooz, dont ils donnent le tiers à Gérard de Jauche, seigneur de Hierges, qui, depuis dix-huit ans, s'est emparé de différents revenus."
                            },
                            {
                                "example_id": "bfc8c18b-eb91-475e-a597-3139c6898c54",
                                "sense_id": "eb139cc6-bdb9-32fb-b162-e7ba652c6e84",
                                "text": "Le décret instituant une concession fixe le montant de la redevance tréfoncière due par le titulaire aux propriétaires de la surface."
                            },
                            {
                                "example_id": "22fbd7e7-c106-4080-a3ba-c09e6b15b834",
                                "sense_id": "eb139cc6-bdb9-32fb-b162-e7ba652c6e84",
                                "text": "Veuf, il prit les ordres et devint chanoine tréfoncier, ce qui veut dire émargeant aux revenus, de la collégiale Saint-Jean."
                            }
                        ]
                    }
                ],
