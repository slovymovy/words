                "senses": [
                    {
                        "sense_id": "1ca56351-6416-3aa0-abbf-5eb0df4a3f37",
                        "entry_id": "599114a8-d605-3df5-8f28-7a54b8466f2a",
                        "glosses": [
                            "Name mit allen Namensteilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6ee5087-9b52-4515-9902-5fc0d88b0935",
                                "sense_id": "1ca56351-6416-3aa0-abbf-5eb0df4a3f37",
                                "text": "„Ganz anders als der Familienname ist der Vorname der persönlichste Teil unseres offiziellen Gesamtnamens.“"
                            },
                            {
                                "example_id": "85137deb-5af5-4b4b-8d43-d32b33eab3bf",
                                "sense_id": "1ca56351-6416-3aa0-abbf-5eb0df4a3f37",
                                "text": "„Auch heute ist der zweite oder dritte Vorname die Stelle im Gesamtnamen, die sich zur Erfüllung derartiger Rücksichten anbietet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b7722e03-13f9-30e9-99b6-393fcd9dabb3",
                        "entry_id": "599114a8-d605-3df5-8f28-7a54b8466f2a",
                        "glosses": [
                            "Name für eine Gemeinde, die aus mindestens zwei zuvor selbständigen Gemeinden fusioniert wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5d96ac2-4a4c-4a3c-87e6-0c18cbbce8aa",
                                "sense_id": "b7722e03-13f9-30e9-99b6-393fcd9dabb3",
                                "text": "„Recht handfest war manchmal das Bemühen von Ortsbewohnern, den eigenen ON als Gesamtnamen der künftigen Großgemeinde aus Prestigegründen durchzusetzen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
