                    {
                        "translation_id": "da20c889-3d7f-4cef-949b-2a325c36006d",
                        "source_entry_id": "6a92050f-5d39-3ad4-b561-20a939f6eec2",
                        "source_sense_description": "alternate succession",
                        "target_lang_word": "сме́на",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сме́на",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9fda6ad9-0b13-3be2-bc93-9da95be2640d",
                                        "entry_id": "6444d3d4-4bd8-33d9-a3cc-96ecdb0f0718",
                                        "glosses": [
                                            "действие по значению гл. менять; изменение или замещение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bb14f38-9fba-4b1c-a382-60b7a8b5a1bb",
                                                "sense_id": "9fda6ad9-0b13-3be2-bc93-9da95be2640d",
                                                "text": "Прошло четверть часа, и на смену его басу зажужжал сиплый тенорок бухгалтера."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1c28df7-502b-3742-8006-5990905b81e5",
                                        "entry_id": "6444d3d4-4bd8-33d9-a3cc-96ecdb0f0718",
                                        "glosses": [
                                            "промежуток времени, по истечении которого одна группа работающих на предприятии замещает другую"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15314b9f-5e0a-4b04-b77d-460de6efa053",
                                                "sense_id": "c1c28df7-502b-3742-8006-5990905b81e5",
                                                "text": "Завод работает в три смены по пяти часов — от семи утра до десяти ночи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c414681-8c13-38e4-b1a2-85c92a574b47",
                                        "entry_id": "6444d3d4-4bd8-33d9-a3cc-96ecdb0f0718",
                                        "glosses": [
                                            "группа сотрудников, действующих в течение такого промежутка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fe29ca9-d57b-4e65-bfea-d11d367d87e6",
                                                "sense_id": "0c414681-8c13-38e4-b1a2-85c92a574b47",
                                                "text": "Сейчас должна спуститься под землю вторая смена. Сотни две человек толпятся на шахтенном дворе между штабелей, сложенных из крупных кусков блестящего каменного угля."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b866ff0-587a-3723-bff9-0bc467571edd",
                                        "entry_id": "6444d3d4-4bd8-33d9-a3cc-96ecdb0f0718",
                                        "glosses": [
                                            "тот, кто приходит, чтобы сменить, заместить другого"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "813b411d-97ee-4b14-8583-5fc33adac253",
                                                "sense_id": "0b866ff0-587a-3723-bff9-0bc467571edd",
                                                "text": "Поторопитесь, скоро должна прийти моя смена."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3be48485-d1c0-3947-bf9e-ace07cbe53c7",
                                        "entry_id": "6444d3d4-4bd8-33d9-a3cc-96ecdb0f0718",
                                        "glosses": [
                                            "комплект периодически меняемой одежды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f54e13e-7f4b-436d-a37a-3d1c0820fbe3",
                                                "sense_id": "3be48485-d1c0-3947-bf9e-ace07cbe53c7",
                                                "text": "С собой иметь две смены белья."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "177620ac-8da3-3393-89ce-3d32b0ddb5c3",
                                        "entry_id": "6444d3d4-4bd8-33d9-a3cc-96ecdb0f0718",
                                        "glosses": [
                                            "воен. процедура передачи охраняемого поста от одного часового (караульного) другому"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f1e0314-5bca-4834-bde7-3a7bdd3c104b",
                                                "sense_id": "177620ac-8da3-3393-89ce-3d32b0ddb5c3",
                                                "text": "Смена караула, регулярно проходящая перед Букингемским дворцом, всегда привлекает тысячи туристов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
