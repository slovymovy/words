{
    "word_family": [
        "nibbler",
        "nibbling",
        "nybble"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3bada9c-67fb-3a74-a999-871d0e3afd7b",
                    "sense_definition": "To take a small, quick bite, or several of such bites, of something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rabbit began to <w>nibble</w> the lettuce in the garden.",
                            "target_lang_translations": {
                                "ru": "Кролик начал <w>грызть</w> салат в огороде."
                            }
                        },
                        {
                            "text": "She would <w>nibble</w> a biscuit while reading her favorite book.",
                            "target_lang_translations": {
                                "ru": "Она любила <w>покусывать</w> печенье, читая любимую книгу."
                            }
                        }
                    ],
                    "synonyms": [
                        "knabble"
                    ],
                    "common_phrases": [
                        "nibble a biscuit",
                        "nibble the lettuce"
                    ],
                    "target_lang_definitions": {
                        "ru": "Откусывать маленькими кусочками или делать несколько быстрых мелких укусов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грызть",
                                "target_lang_sense_clarification": "откусывать по чуть-чуть"
                            },
                            {
                                "target_lang_word": "покусывать",
                                "target_lang_sense_clarification": "слегка кусать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "318d14f0-a2b8-397d-a09c-a3b18d758149",
                    "sense_definition": "To take small, quick bites, or to eat at frequent intervals with small bites, often followed by 'at', 'away', or 'on'.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mouse was seen to <w>nibble</w> at the cheese left on the counter.",
                            "target_lang_translations": {
                                "ru": "Видели, как мышь <w>грызла</w> сыр, оставленный на столе."
                            }
                        },
                        {
                            "text": "I like to <w>nibble</w> on snacks throughout the afternoon.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>кусочничать</w> в течение дня."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nibble at the bait",
                        "nibble on snacks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Есть что-либо мелкими кусочками, часто перекусывая в течение дня."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грызть",
                                "target_lang_sense_clarification": "о еде, например, орешках или печенье"
                            },
                            {
                                "target_lang_word": "кусочничать",
                                "target_lang_sense_clarification": "перекусывать понемногу"
                            },
                            {
                                "target_lang_word": "пощипывать",
                                "target_lang_sense_clarification": "есть по чуть-чуть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6273026-0d48-39bb-9584-e6b3ec84e324",
                    "sense_definition": "To lightly bite a person or animal, especially in a loving or playful manner.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puppy would <w>nibble</w> my fingers whenever we played together.",
                            "target_lang_translations": {
                                "ru": "Щенок <w>покусывал</w> мои пальцы каждый раз, когда мы играли вместе."
                            }
                        },
                        {
                            "text": "He began to <w>nibble</w> her ear playfully during the movie.",
                            "target_lang_translations": {
                                "ru": "Он начал игриво <w>прикусывать</w> её ухо во время фильма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nibble playfully",
                        "nibble my fingers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слегка покусывать человека или животное, обычно любя или в игре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покусывать",
                                "target_lang_sense_clarification": "игриво или нежно"
                            },
                            {
                                "target_lang_word": "прикусывать",
                                "target_lang_sense_clarification": "слегка зажимать зубами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecf40811-6054-382a-9f3c-a94cae8302a9",
                    "sense_definition": "To make one's way through or across an area while taking small bites.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cows <w>nibbled</w> their way across the green field.",
                            "target_lang_translations": {
                                "ru": "Коровы медленно <w>проедали</w> себе путь через зеленое поле."
                            }
                        },
                        {
                            "text": "He had <w>nibbled</w> his way through a whole bag of chips before the show ended.",
                            "target_lang_translations": {
                                "ru": "Он <w>схомячил</w> целую пачку чипсов еще до конца шоу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nibble one's way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продвигаться куда-либо, попутно откусывая или съедая что-то маленькими порциями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проедать",
                                "target_lang_sense_clarification": "прокладывать путь, поедая что-то"
                            },
                            {
                                "target_lang_word": "обгладывать",
                                "target_lang_sense_clarification": "съедать по пути"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14433354-2020-32e0-93e5-9b31c478c6ee",
                    "sense_definition": "To reduce or use up something gradually, often followed by 'away at'.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Inflation continues to <w>nibble</w> away at the value of our savings.",
                            "target_lang_translations": {
                                "ru": "Инфляция продолжает <w>подтачивать</w> стоимость наших сбережений."
                            }
                        },
                        {
                            "text": "Small bank fees can <w>nibble</w> away at your monthly budget.",
                            "target_lang_translations": {
                                "ru": "Небольшие банковские комиссии могут <w>размывать</w> ваш ежемесячный бюджет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nibble away at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно уменьшать или истощать запасы, ресурсы или стоимость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтачивать",
                                "target_lang_sense_clarification": "постепенно уменьшать"
                            },
                            {
                                "target_lang_word": "размывать",
                                "target_lang_sense_clarification": "о ценности или бюджете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27dad292-afa4-33b4-bfcc-ca031d21d5f6",
                    "sense_definition": "To show a slight interest in something, such as a proposal or commercial opportunity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several investors started to <w>nibble</w> at the new tech startup's proposal.",
                            "target_lang_translations": {
                                "ru": "Несколько инвесторов начали <w>проявлять интерес</w> к предложению нового технологического стартапа."
                            }
                        },
                        {
                            "text": "We hope the buyers will <w>nibble</w> at the offer we made yesterday.",
                            "target_lang_translations": {
                                "ru": "Мы надеемся, что покупатели <w>клюнут</w> на предложение, которое мы сделали вчера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nibble at the offer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявлять слабый интерес к предложению или коммерческой возможности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проявлять интерес",
                                "target_lang_sense_clarification": "осторожно интересоваться"
                            },
                            {
                                "target_lang_word": "клевать",
                                "target_lang_sense_clarification": "переносно о предложении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8daaa40-dcd7-3cd1-b974-96ccfea89d49",
                    "sense_definition": "To make insignificant complaints or to find fault with minor details.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critics began to <w>nibble</w> at the minor inconsistencies in the script.",
                            "target_lang_translations": {
                                "ru": "Критики начали <w>придираться</w> к мелким нестыковкам в сценарии."
                            }
                        },
                        {
                            "text": "It is frustrating when colleagues <w>nibble</w> at every small detail of a project.",
                            "target_lang_translations": {
                                "ru": "Раздражает, когда коллеги <w>цепляются</w> к каждой мелкой детали проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "niggle",
                        "piddle"
                    ],
                    "common_phrases": [
                        "nibble at details"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высказывать незначительные жалобы или придираться к мелочам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придираться",
                                "target_lang_sense_clarification": "к мелким деталям"
                            },
                            {
                                "target_lang_word": "грызть",
                                "target_lang_sense_clarification": "изводить мелкими замечаниями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "650f2e29-ba52-3a35-be90-52cf5a65634a",
                    "sense_definition": "To catch or arrest someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police managed to <w>nibble</w> the thief just as he was leaving.",
                            "target_lang_translations": {
                                "ru": "Полиции удалось <w>сцапать</w> вора как раз в тот момент, когда он уходил."
                            }
                        },
                        {
                            "text": "He was worried the authorities would <w>nibble</w> him for his past crimes.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что власти <w>загребут</w> его за прошлые преступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "nab"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "archaic slang for catching someone"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поймать или арестовать кого-либо (устаревший сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сцапать",
                                "target_lang_sense_clarification": "поймать, арестовать"
                            },
                            {
                                "target_lang_word": "загрести",
                                "target_lang_sense_clarification": "арестовать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9847a870-1230-37ab-85c9-69d8978c7308",
                    "sense_definition": "An act of taking a small, quick bite, especially with the front teeth.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mouse took a quick <w>nibble</w> of the cracker and ran away.",
                            "target_lang_translations": {
                                "ru": "Мышь быстро <w>откусила</w> кусочек крекера и убежала."
                            }
                        },
                        {
                            "text": "I felt a small <w>nibble</w> on my fishing line while waiting by the lake.",
                            "target_lang_translations": {
                                "ru": "Я почувствовал легкую <w>поклёвку</w> на леске, пока ждал у озера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "take a nibble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый и мелкий укус, часто передними зубами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укус",
                                "target_lang_sense_clarification": "маленький и быстрый"
                            },
                            {
                                "target_lang_word": "поклёвка",
                                "target_lang_sense_clarification": "в контексте рыбалки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9894275-4ecf-3e6e-accd-3e9b07d76774",
                    "sense_definition": "A small amount of food that can be taken into the mouth in one small bite.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There wasn't even a <w>nibble</w> of bread left in the pantry.",
                            "target_lang_translations": {
                                "ru": "В кладовой не осталось ни <w>крошки</w> хлеба."
                            }
                        },
                        {
                            "text": "She offered me a <w>nibble</w> of her chocolate bar.",
                            "target_lang_translations": {
                                "ru": "Она предложила мне <w>кусочек</w> своей шоколадки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nibble of food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький кусочек еды, который можно съесть за один раз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кусочек",
                                "target_lang_sense_clarification": "очень маленькая порция"
                            },
                            {
                                "target_lang_word": "крошка",
                                "target_lang_sense_clarification": "малое количество еды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd938705-6571-3539-8e7d-0403e94909bd",
                    "sense_definition": "A unit of computer memory equal to half a byte, or four bits.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In computing, a <w>nibble</w> is used to represent a single hexadecimal digit.",
                            "target_lang_translations": {
                                "ru": "В информатике <w>полубайт</w> используется для представления одной шестнадцатеричной цифры."
                            }
                        },
                        {
                            "text": "The programmer had to mask the lower <w>nibble</w> of the byte to zero.",
                            "target_lang_translations": {
                                "ru": "Программисту пришлось обнулить младший <w>ниббл</w> байта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "high nibble",
                        "low nibble"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often spelled nybble in technical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица компьютерной памяти, равная половине байта или четырем битам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полубайт",
                                "target_lang_sense_clarification": "технический термин"
                            },
                            {
                                "target_lang_word": "ниббл",
                                "target_lang_sense_clarification": "прямое заимствование"
                            },
                            {
                                "target_lang_word": "тетрада",
                                "target_lang_sense_clarification": "группа из четырех бит"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}