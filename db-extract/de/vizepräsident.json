                    },
                    {
                        "translation_id": "be4e402e-9fcd-421b-bb66-1933b76fd8eb",
                        "source_entry_id": "80877da9-51c8-3e88-811a-af78a9894081",
                        "source_sense_id": "36d4861c-a5bd-35ff-a8db-a7467fc6309f",
                        "source_sense_description": "Stellvertreter eines Präsidenten",
                        "target_lang_word": "vice-président",
                        "target_lang_code": "fr",
