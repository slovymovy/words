                        "tags": [],
                        "examples": [
                            {
                                "example_id": "550058b1-504f-488f-ab30-f1872672eef3",
                                "sense_id": "0ccbb559-a187-3052-93dd-bcd216cecf8a",
                                "text": "Der Sommer-Austernseitling ist eine Pilzsorte."
                            },
                            {
                                "example_id": "1c3da260-2518-4530-985d-da0de67e605f",
                                "sense_id": "0ccbb559-a187-3052-93dd-bcd216cecf8a",
                                "text": "„Der Kastanien- oder Lungenseitling wird auch Sommer-Austernseitling genannt, da er vom Frühjahr bis in den Herbst fruchtet.“"
                            },
                            {
                                "example_id": "d716dca8-53f6-4146-bea7-4b5995e2aa8b",
                                "sense_id": "0ccbb559-a187-3052-93dd-bcd216cecf8a",
                                "text": "„Er [Lungenseitling] ähnelt sehr dem beliebten Austernseitling und wird, seinem Vorkommen entsprechend, auch als ‚Sommer-Austernsentling‘ bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
