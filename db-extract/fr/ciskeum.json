                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cisdude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90d23d62-91a0-3e70-af87-69453bbb3870",
                                        "entry_id": "f3941125-95b1-3b9d-8229-74a6f56f96a8",
                                        "glosses": [
                                            "A cisgender man."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26492c3a-d10a-43c9-a9f1-6d0f07398e36",
                                                "sense_id": "90d23d62-91a0-3e70-af87-69453bbb3870",
                                                "text": "The Pride parade in particular is heavily weighted toward cisdudes."
                                            },
                                            {
                                                "example_id": "aca346aa-aa20-41c3-b126-2c1775648015",
                                                "sense_id": "90d23d62-91a0-3e70-af87-69453bbb3870",
                                                "text": "I’m a 25-year-old fat, brown, queer cisdude."
                                            },
                                            {
                                                "example_id": "f6499ea2-8462-40af-ab29-3e5cbb2cbadc",
                                                "sense_id": "90d23d62-91a0-3e70-af87-69453bbb3870",
                                                "text": "In Brighton, a lot of gigs are billed as ‘queer’, I think because we are known as a queer town or something? But like, you turn up and the bands are all cisdudes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
