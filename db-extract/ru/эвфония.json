                    },
                    {
                        "translation_id": "8fc12663-2a4e-4168-93de-5c0ff8b62b1d",
                        "source_entry_id": "f0282575-36ed-3018-86b7-9c74ca65cc52",
                        "target_lang_word": "Euphonie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Euphonie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa7b0d9b-6fe5-39f7-b580-ec33702c05f5",
                                        "entry_id": "9af3a2e3-9a8f-3356-a7d9-678bb8a72d5e",
                                        "glosses": [
                                            "sprachlicher Wohlklang"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55fa09fe-f0a4-4e2c-b4c6-de314276ef8e",
                                                "sense_id": "fa7b0d9b-6fe5-39f7-b580-ec33702c05f5",
                                                "text": "„Untersucht man die phonische Seite von Gedichten, so hat man es immer mit der Euphonie zu tun.“"
                                            },
                                            {
                                                "example_id": "fad0f190-aa6a-4653-b1f5-725149f209fc",
                                                "sense_id": "fa7b0d9b-6fe5-39f7-b580-ec33702c05f5",
                                                "text": "Der Euphonie „dienen z.T. die Einschiebung von Lauten zur Vermeidung der Kakophonie oder die Regeln zur Vermeidung des Hiatus.“"
                                            },
                                            {
                                                "example_id": "3dd280ff-a15a-4d22-9232-4c63d0c94c28",
                                                "sense_id": "fa7b0d9b-6fe5-39f7-b580-ec33702c05f5",
                                                "text": "„Beim Übergang in andere Sprachen (und auch sonst in der Sprachgeschichte) werden Lautformen gelegentlich verändert um der Sprechbarkeit oder des Wohlklangs willen (Euphonie, euphonisch).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1c64f483-9eec-3e75-87b5-07878413ae85",
                                        "entry_id": "9af3a2e3-9a8f-3356-a7d9-678bb8a72d5e",
                                        "glosses": [
                                            "musikalischer Wohlklang"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b7ad10f-1acd-44da-96ae-de200fa58b2c",
                                                "sense_id": "1c64f483-9eec-3e75-87b5-07878413ae85",
                                                "text": "„‚Kakophonie – Euphonie‘ versucht, zwei Extrembereiche der Musik, die ‚Kakophonie‘ alltäglicher Geräusche und die Euphonie kitschigen Schönklangs, zu ‚stimmen‘, wie man ein Instrument stimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3cd6eff-1275-45f7-8e60-4387f30f4bfc",
                        "source_entry_id": "f0282575-36ed-3018-86b7-9c74ca65cc52",
                        "target_lang_word": "Wohllaut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohllaut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62bf885d-11de-3168-908b-88ad07294d60",
                                        "entry_id": "b332a7d6-9981-3a56-8b9b-a12b1659c6c0",
                                        "glosses": [
                                            "guter, angenehmer Klang/Ton"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02abf06b-32ab-49ab-9c49-73ed5ef950a5",
                                                "sense_id": "62bf885d-11de-3168-908b-88ad07294d60",
                                                "text": "„Dann sah er sie auf der Bühne stehen, ruhig, ihres Erfolges sicher, und es war ihm, als vernähme er den Wohllaut ihrer Stimme.“"
                                            },
                                            {
                                                "example_id": "6eb3da93-5778-4fff-927a-0d9c48d34c96",
                                                "sense_id": "62bf885d-11de-3168-908b-88ad07294d60",
                                                "text": "„Mit anderen Worten: Anita Cerquetti hatte eine Stradivari in der Kehle, die beglückenden Wohllaut verströmte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "031cb839-3a06-4b44-9ce2-37ccafa5ac70",
                        "source_entry_id": "f0282575-36ed-3018-86b7-9c74ca65cc52",
                        "target_lang_word": "eufonia",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eufonia",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "ae4b54da-4eb9-36e5-86ed-aeacd484ba05",
                                        "entry_id": "9707ad6c-d369-38d8-84d4-37d36d4a857c",
                                        "glosses": [
                                            "wyraz, fraza lub zdanie mające strukturę fonetyczną skutkującą w harmonijnym i przez to przyjemnym akustycznie jego brzmieniu, też: to przyjemne brzmienie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb746ec-9843-4b7c-96ea-065ba10dc451",
                                                "sense_id": "ae4b54da-4eb9-36e5-86ed-aeacd484ba05",
                                                "text": "Bo to piękno układa się także z brzmienia słów, z eufonii, z nich „bierze się mówienie”"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "e7458f38-72e0-3dd6-a0cc-1899171a8745",
                                        "entry_id": "9707ad6c-d369-38d8-84d4-37d36d4a857c",
                                        "glosses": [
                                            "celowe rymowanie wyrazów występujących w tej samej wypowiedzi, zazwyczaj dla efektu komicznego"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "f17c5fc1-f4c6-31b7-ae8c-bfc90a29190f",
                                        "entry_id": "9707ad6c-d369-38d8-84d4-37d36d4a857c",
                                        "glosses": [
                                            "unikanie i często za tym idąca redukcja trudnych w wymowie zbitek głoskowych, np. magistrowie > magistrzy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d8725f4-1c35-420d-8b3b-ad6e50d440df",
                                                "sense_id": "f17c5fc1-f4c6-31b7-ae8c-bfc90a29190f",
                                                "text": "Pojęcie eufonii odnosi się przede wszystkim do języka mówionego, jednak w pewnym ograniczonym stopniu dotyczy również tekstów pisanych"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "da4c2d60-78d5-3209-8652-fc0160910242",
                                        "entry_id": "9707ad6c-d369-38d8-84d4-37d36d4a857c",
                                        "glosses": [
                                            "intencjonalne dobranie wyrazów w utworze tak, by tworzyły eufonię (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "551344a7-a8b7-4783-9955-b1e940e438a4",
                                                "sense_id": "da4c2d60-78d5-3209-8652-fc0160910242",
                                                "text": "Eufonia to ta warstwa poetyki wiersza, która wydaje się niezbyt doceniana nawet przez profesjonalnych czytelników"
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "ce94b511-9473-3b5d-835c-1a50f05c594f",
                                        "entry_id": "9707ad6c-d369-38d8-84d4-37d36d4a857c",
                                        "glosses": [
