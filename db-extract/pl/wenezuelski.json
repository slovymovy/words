                                        "sense_id": "85a27fbc-587c-3789-a7f2-ea4959766a11",
                                        "entry_id": "5944302f-b987-301c-bf7f-4b30bf13f63a",
                                        "glosses": [
                                            "Of, from, or pertaining to Venezuela or the Venezuelan people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d9b090f-f466-48e7-89b9-2a16861fc10b",
                                                "sense_id": "85a27fbc-587c-3789-a7f2-ea4959766a11",
                                                "text": "But the first foray by Russian strategic bombers into the Western hemisphere since the Cold War is simply the curtain raiser for joint naval maneuvers that will bring Russian warships into Venezuelan waters in November."
                                            },
                                            {
                                                "example_id": "35d44a03-bd90-4228-88cc-68b6b376490f",
                                                "sense_id": "85a27fbc-587c-3789-a7f2-ea4959766a11",
                                                "text": "The Venezuelan gang, known as Tren de Aragua, or TDA, has a known presence in 15 states and a possible presence in eight others, according to the data."
                                            }
                                        ]
                                    }
                                ]
                            }
