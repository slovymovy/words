{
    "word_family": [
        "start",
        "starter",
        "restart"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7f8a3ad8-cb5b-3f8c-927e-1052e5549555",
                    "sense_definition": "present participle and gerund of <w>start</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>starting</w> a new job next Monday.",
                            "target_lang_translations": {
                                "tr": "Gelecek pazartesi yeni bir işe <w>başlıyor</w>.",
                                "ru": "В следующий понедельник она <w>начинает</w> новую работу."
                            }
                        },
                        {
                            "text": "Before <w>starting</w> the engine, check the oil level.",
                            "target_lang_translations": {
                                "tr": "Motoru <w>çalıştırmadan</w> önce yağ seviyesini kontrol edin.",
                                "ru": "Перед тем как <w>запустить</w> двигатель, проверьте уровень масла."
                            }
                        }
                    ],
                    "common_phrases": [
                        "starting point",
                        "starting line",
                        "starting salary"
                    ],
                    "target_lang_definitions": {
                        "tr": "\"start\" fiilinin şimdiki zaman sıfat-fiili ve isim-fiil hali; başlamak, çalıştırmak",
                        "ru": "Форма причастия настоящего времени или герундия глагола «начинать»; процесс начала чего-либо или приведения в действие."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "başlama",
                                "target_lang_sense_clarification": "bir eyleme başlama durumu"
                            },
                            {
                                "target_lang_word": "başlayarak",
                                "target_lang_sense_clarification": "başlama eylemini belirterek"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "начало",
                                "target_lang_sense_clarification": "процесс или момент начала действия"
                            },
                            {
                                "target_lang_word": "запуск",
                                "target_lang_sense_clarification": "приведение в действие механизма или процесса"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f31362d8-ccec-31e3-a9d1-748cd33e3ef6",
                    "sense_definition": "The action, process, or an instance of beginning or setting something in motion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frequent <w>startings</w> and stoppings of the old machine made a lot of noise.",
                            "target_lang_translations": {
                                "tr": "Eski makinenin sık sık <w>çalışıp durması</w> çok gürültü yapıyordu.",
                                "ru": "Частые <w>запуски</w> и остановки старой машины создавали много шума."
                            }
                        },
                        {
                            "text": "The smooth <w>starting</w> of the motor impressed the mechanical engineers.",
                            "target_lang_translations": {
                                "tr": "Motorun sorunsuz <w>çalışması</w> makine mühendislerini etkiledi.",
                                "ru": "Плавный <w>запуск</w> двигателя впечатлил инженеров-механиков."
                            }
                        }
                    ],
                    "synonyms": [
                        "beginning",
                        "commencement"
                    ],
                    "antonyms": [
                        "stopping",
                        "ending"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi başlatma, harekete geçirme eylemi, süreci veya örneği",
                        "ru": "Действие, процесс или отдельный случай начала чего-либо или приведения чего-либо в движение."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "başlangıç",
                                "target_lang_sense_clarification": "bir şeyin başlama anı veya eylemi"
                            },
                            {
                                "target_lang_word": "çalıştırma",
                                "target_lang_sense_clarification": "motor veya makineyi harekete geçirme"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "запуск",
                                "target_lang_sense_clarification": "процесс приведения в действие двигателя или системы"
                            },
                            {
                                "target_lang_word": "начало",
                                "target_lang_sense_clarification": "момент возникновения или старта процесса"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}