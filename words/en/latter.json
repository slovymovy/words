{
    "word_family": [
        "late",
        "lately",
        "latish"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e5365d85-6e37-304f-8b9a-542f500a7fcc",
                    "sense_definition": "Relating to or being the second of two items mentioned.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He offered me tea or coffee, and I chose the <w>latter</w> because I needed the caffeine.",
                            "target_lang_translations": {
                                "ru": "Он предложил мне чай или кофе, и я выбрал <w>последнее</w>, так как мне нужен был кофеин."
                            }
                        },
                        {
                            "text": "Between the two options provided, the <w>latter</w> option seems much more practical for our current budget.",
                            "target_lang_translations": {
                                "ru": "Из двух предложенных вариантов <w>второй</w> кажется гораздо более практичным для нашего текущего бюджета."
                            }
                        }
                    ],
                    "antonyms": [
                        "former"
                    ],
                    "common_phrases": [
                        "the latter option",
                        "the latter case"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся ко второму из двух упомянутых предметов или лиц."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "последний",
                                "target_lang_sense_clarification": "из двух упомянутых"
                            },
                            {
                                "target_lang_word": "второй",
                                "target_lang_sense_clarification": "из двух названных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96f19d1d-e200-3999-ad7e-0c8d600bd839",
                    "sense_definition": "Belonging to or occurring near the end of a period of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architectural style changed significantly during the <w>latter</w> half of the century.",
                            "target_lang_translations": {
                                "ru": "Архитектурный стиль значительно изменился во <w>второй</w> половине столетия."
                            }
                        },
                        {
                            "text": "Most of the major discoveries were made in the <w>latter</w> part of the decade.",
                            "target_lang_translations": {
                                "ru": "Большинство крупных открытий было сделано в <w>последней</w> части десятилетия."
                            }
                        }
                    ],
                    "synonyms": [
                        "later"
                    ],
                    "common_phrases": [
                        "latter half",
                        "latter part"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к концу какого-либо периода времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "второй",
                                "target_lang_sense_clarification": "о половине периода"
                            },
                            {
                                "target_lang_word": "последний",
                                "target_lang_sense_clarification": "о части периода"
                            },
                            {
                                "target_lang_word": "более поздний",
                                "target_lang_sense_clarification": "о времени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29f1616a-b1c4-38b8-9312-166d685b807d",
                    "sense_definition": "Belonging to a time that is in the past but relatively close to the present.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his <w>latter</w> years, the famous author preferred a quiet life in the countryside.",
                            "target_lang_translations": {
                                "ru": "В свои <w>последние</w> годы знаменитый автор предпочитал тихую жизнь в сельской местности."
                            }
                        },
                        {
                            "text": "The museum features many artifacts from these <w>latter</w> ages of human civilization.",
                            "target_lang_translations": {
                                "ru": "В музее представлено множество артефактов этих <w>более поздних</w> эпох человеческой цивилизации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "latter years",
                        "latter days"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к времени, которое было в прошлом, но относительно близко к настоящему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "последний",
                                "target_lang_sense_clarification": "о годах жизни или эпохе"
                            },
                            {
                                "target_lang_word": "поздний",
                                "target_lang_sense_clarification": "о периоде жизни"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}