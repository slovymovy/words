                        "entry_id": "1d210f6c-c37d-37c2-b38c-87e9734424d8",
                        "glosses": [
                            "A national (or group) policy of non-interaction with other nations (or groups)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "726227bc-d665-44f1-8118-e3a22f815dc3",
                                "sense_id": "dd84eccd-0793-3cb8-97b9-7ae58bab56f1",
                                "text": "Many hope the period of American isolationism and country-first populism under President Trump will give way to an era of renewed U.S. global leadership and embrace of multilateralism to tackle common challenges."
                            }
                        ]
                    }
