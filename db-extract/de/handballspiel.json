                                        "entry_id": "dc7f18a7-0184-3a65-ad20-55d1fb2cb148",
                                        "glosses": [
                                            "desporto de equipe de sete elementos onde a bola se joga com as mãos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08e061c5-97da-4d1c-a1af-c9fb2760258f",
                                                "sense_id": "25d0a7c7-4dc1-36aa-8d9c-fd11aef6ca81",
                                                "text": "Nas partidas jogadas em recinto coberto, cada equipa é formada por sete jogadores. Contudo, na variante jogada ao ar livre — o andebol de campo é muito pouco praticado — a equipa é formada por 11 jogadores."
                                            }
