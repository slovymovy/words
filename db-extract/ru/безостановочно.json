                                "target_senses": [
                                    {
                                        "sense_id": "152f2289-9c95-35a2-8c43-d2a56afab6eb",
                                        "entry_id": "8753f42c-ede0-30e9-b48a-2d54d88d482e",
                                        "glosses": [
                                            "nicht ablassend, ohne Unterbrechung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe422dce-7ec3-4dfd-9a53-f4aeaf326f07",
                                                "sense_id": "152f2289-9c95-35a2-8c43-d2a56afab6eb",
                                                "text": "Diese unablässigen Wiederholungen im Fernsehen stören mich sehr."
                                            },
                                            {
                                                "example_id": "042f9407-51db-4469-9187-d9b8a7f37c90",
                                                "sense_id": "152f2289-9c95-35a2-8c43-d2a56afab6eb",
                                                "text": "Er beobachtete ihn unablässig."
                                            },
                                            {
                                                "example_id": "a51685de-3f1e-41e5-b10f-74db61f5868d",
                                                "sense_id": "152f2289-9c95-35a2-8c43-d2a56afab6eb",
                                                "text": "Meine Nachbarn streiten sich unablässig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a5e20c5-2a14-4e41-b01e-2450aa7178d4",
                        "source_entry_id": "3b6dfb04-a5df-3368-aca2-c4e3692ce744",
                        "source_sense_id": "8948278b-873e-398f-a4f7-f11e396778e6",
                        "target_lang_word": "ohne Unterlaß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ede101b4-4c50-49fc-bcf0-f281246b237c",
                        "source_entry_id": "3b6dfb04-a5df-3368-aca2-c4e3692ce744",
                        "source_sense_id": "8948278b-873e-398f-a4f7-f11e396778e6",
                        "target_lang_word": "continuellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "continuellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                        "entry_id": "21c83ecc-d27d-36c0-894d-0da3feb3533c",
                                        "glosses": [
                                            "Sans interruption, de manière continue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "957ca6d5-768a-4c0c-8d0d-7fe378a3b7d6",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "On n’a point continuellement des juges devant les yeux, et l’on craint la magistrature et non pas les magistrats."
                                            },
                                            {
                                                "example_id": "102357e9-f805-4bf8-8baf-7126def780fd",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "Nous le voyons continuellement occupé du soin d’acquérir ce qu’il juge utile et d’écarter ce qu’il présume devoir nuire à sa félicité."
                                            },
                                            {
                                                "example_id": "f5fecb57-70cc-44e1-810b-b4478cf6c3db",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "Ces champs ne sont-ils pas à moi, et ces bois chanteurs, et ce ciel que raye continuellement le vol fantaisiste des martinets ?"
                                            },
                                            {
                                                "example_id": "62e5c941-5b8a-4dd5-b009-efc856f04fd0",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "Le filage au continu permet d’obtenir une plus grande production, car le fil se produit et se renvide continuellement."
                                            },
                                            {
                                                "example_id": "cb07ea95-6948-4268-b6ed-b350d20b38b5",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "[…], Galilée a dû combattre continuellement les Péripatéticiens qui occupaient alors presque toutes les chaires magistrales des Universités."
                                            },
                                            {
                                                "example_id": "a1664d04-bd9f-4a86-bb05-a5e8e559cc2b",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "[…] le progrès est un perpétuel devenir, nulle méthode ne saurait être considérée comme immuable, tout est en mouvement, tout est continuellement améliorable, tout ce qui existe aujourd’hui sera demain mieux encore…"
                                            },
                                            {
                                                "example_id": "12afbee1-d8c4-48e2-954a-5849f1c7db2f",
                                                "sense_id": "3fc7d9b1-05b8-3181-bad6-776f0ee57644",
                                                "text": "L’inlandsis du continent groenlandais se déversant lentement mais continuellement dans les fjords par des glaciers importants, vêle des icebergs de tailles variant à l’infini […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b551cb3-a68e-4ead-8b5c-ce07d5d8115c",
                        "source_entry_id": "3b6dfb04-a5df-3368-aca2-c4e3692ce744",
                        "source_sense_id": "8948278b-873e-398f-a4f7-f11e396778e6",
                        "target_lang_word": "sans désemparer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans désemparer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "652e9356-8b59-3ba8-815c-85505a14e0c9",
                                        "entry_id": "d3a6d9e1-d6b6-3f9e-b6d1-d38841c4d9b6",
                                        "glosses": [
                                            "Sans quitter la place ; sans laisser passer aucun intervalle de temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16e43bc7-0176-486a-9d4d-4819b2bbbd3e",
                                                "sense_id": "652e9356-8b59-3ba8-815c-85505a14e0c9",
                                                "text": "J'ai voyagé à cheval, à dos de chameau, en voiture, en traîneau. J'ai usé de tous les moyens de locomotion possibles, et passé des mois entiers en tarentas nuit et jour, et sans désemparer."
                                            },
                                            {
                                                "example_id": "615ec289-43c8-4171-a6a8-aff56674c800",
                                                "sense_id": "652e9356-8b59-3ba8-815c-85505a14e0c9",
                                                "text": "Sans désemparer, Geneviève se précipita sur l'édition suivante qu'elle descendit acheter au kiosque de l'avenue Jean-Jaurès."
                                            },
                                            {
                                                "example_id": "6f7eebda-c821-49c3-a644-87dc8340270e",
                                                "sense_id": "652e9356-8b59-3ba8-815c-85505a14e0c9",
                                                "text": "Cela ne l’empêchait pas de dormir douze heures sans désemparer, et, là-dessus, il aurait rendu des points à un loir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
