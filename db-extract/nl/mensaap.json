                                    },
                                    {
                                        "sense_id": "4e97f039-744e-3d39-a54e-be2bd3f4a6e5",
                                        "entry_id": "83e85457-b267-3f30-bd7d-494c8c48a23a",
                                        "glosses": [
                                            "One who apes; a foolish imitator."
