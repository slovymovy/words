                        "examples": [
                            {
                                "example_id": "062df030-9a6f-488d-9933-47fdf7cf5710",
                                "sense_id": "571d96f0-08be-33f9-b172-d1e83b440592",
                                "text": "Al twee jaar wilde Riyadi trouwen met de vrouw van zijn dromen, aldus pleegvader Darmi. Door het leeftijdsverschil werd dit echter steeds geweigerd. Maar de wees Riyadi bleef aandringen en zo geschiedde. Het dorpshoofd van Karang Endah, Ani, zei dat ze niet kon weigeren Riyadi te trouwen omdat hij had gedreigd gif in te nemen als zijn droomhuwelijk niet doorging."
                            }
                        ]
                    },
