                                "target_senses": [
                                    {
                                        "sense_id": "652e36ba-89f3-3c7e-beae-441006e056b7",
                                        "entry_id": "eeda72d2-166b-3747-963b-aa8500925c50",
                                        "glosses": [
                                            "Cuit en rotissant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b0ac252-ac8f-45ba-b8ad-b4fe264159f9",
                                                "sense_id": "652e36ba-89f3-3c7e-beae-441006e056b7",
                                                "text": "De la dinde rôtie."
                                            },
                                            {
                                                "example_id": "dbf06b8e-8951-4b20-b1a2-06342ddf4e54",
                                                "sense_id": "652e36ba-89f3-3c7e-beae-441006e056b7",
                                                "text": "Comment Ulespiègle entre au service d’un prêtre, et comment il lui mange un poulet rôti."
                                            },
                                            {
                                                "example_id": "b73e5449-0dad-4948-8b42-872115da2f7c",
                                                "sense_id": "652e36ba-89f3-3c7e-beae-441006e056b7",
                                                "text": "C’est bon hein ? Mais, c’est pas franchement nouveau quand on sait qu’une pléiade de légumes peut ainsi se déguster rôtis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rôti",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "403f36f5-ca85-3faf-9865-c7beca588c54",
                                        "entry_id": "88f8bb19-44a9-3f80-8774-da3d6fd0cfa9",
                                        "glosses": [
                                            "Viande grillée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "358b5713-7797-40d7-a023-aafcac80a9b8",
                                                "sense_id": "403f36f5-ca85-3faf-9865-c7beca588c54",
                                                "text": "On a servi le rôti."
                                            },
                                            {
                                                "example_id": "30e4fe11-115a-4332-bf3f-4c72b0292444",
                                                "sense_id": "403f36f5-ca85-3faf-9865-c7beca588c54",
                                                "text": "Le rôti chaud était un filet aux truffes, et le rôti froid, une galantine de pintade à la gelée."
                                            },
                                            {
                                                "example_id": "c48d4346-c7df-4c69-984e-622415470043",
                                                "sense_id": "403f36f5-ca85-3faf-9865-c7beca588c54",
                                                "text": "On sortit de la table mortuaire, où la nourriture, je dois l’ajouter, était à la fois exécrable et parée, le poisson, sans goût ni sauce, prenant la forme d’une côtelette, et le rôti baignant sur une eau saumâtre, comme si le bœuf était demeuré toute la nuit assis dans une mare."
                                            },
                                            {
                                                "example_id": "b2e15e26-2ee5-4d38-b643-b2485e0d2c26",
                                                "sense_id": "403f36f5-ca85-3faf-9865-c7beca588c54",
                                                "text": "Clémence mit au four un rôti de porc dans la pointe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4df9c76c-a750-3c66-9f43-17bde5ebc3d2",
                                        "entry_id": "88f8bb19-44a9-3f80-8774-da3d6fd0cfa9",
                                        "glosses": [
                                            "Rôt, partie du repas où l’on sert les viandes."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d38c7f3-3a68-46bb-9f5b-d5f4854fc416",
                                                "sense_id": "4df9c76c-a750-3c66-9f43-17bde5ebc3d2",
                                                "text": "Il y eut quelques tables où le rôti manqua, à cause de plusieurs dîners où l'on ne s'était point attendu : cela saisit Vatel ; il se dit plusieurs fois : je suis perdu d'honneur."
                                            },
                                            {
                                                "example_id": "9e60441e-ba19-401e-9c16-b99bd103369d",
                                                "sense_id": "4df9c76c-a750-3c66-9f43-17bde5ebc3d2",
                                                "text": "Le rôti fut composé de faisandeaux, de perdreaux, de gelinotes, de cailles et d'ortolans, avec quatre salades."
                                            }
                                        ]
                                    }
                                ]
                            },
