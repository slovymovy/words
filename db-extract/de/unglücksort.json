                ],
                "senses": [
                    {
                        "sense_id": "8e39492f-db61-3d41-bbc1-fe58dfbc66e8",
                        "entry_id": "ed34f718-843e-3755-83c7-d8faa8b19ec6",
                        "glosses": [
                            "Ort, an dem ein Unglück (Unfall und Ähnliches) passiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae2789c9-a28e-444b-bdab-7f5955483231",
                                "sense_id": "8e39492f-db61-3d41-bbc1-fe58dfbc66e8",
                                "text": "Der Verletzte verstarb noch am Unglücksort."
                            },
                            {
                                "example_id": "62ff69a2-e209-460f-9001-f9d7f847ff7c",
                                "sense_id": "8e39492f-db61-3d41-bbc1-fe58dfbc66e8",
                                "text": "Hunderte Trauernde haben Blumenkränze am Unglücksort niedergelegt."
                            },
                            {
                                "example_id": "1e86ad38-c4bd-4b8d-b94a-82466dd1f4b9",
                                "sense_id": "8e39492f-db61-3d41-bbc1-fe58dfbc66e8",
                                "text": "Die Spurensicherung am Unglücksort dauert noch an."
                            },
                            {
                                "example_id": "c830a855-6934-4d9a-bf24-f5cfa6035fa7",
                                "sense_id": "8e39492f-db61-3d41-bbc1-fe58dfbc66e8",
                                "text": "„In der Zwischenzeit waren die Spezialisten eingetroffen, die den Unglücksort untersuchten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
