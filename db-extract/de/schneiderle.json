                "senses": [
                    {
                        "sense_id": "61cf60d1-7216-3b61-82c9-6323c5e692b4",
                        "entry_id": "08649b30-3e08-3017-ad3e-db7b2c6710a5",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48127a85-c92a-45cf-993a-aba06eaf50f8",
                                "sense_id": "61cf60d1-7216-3b61-82c9-6323c5e692b4",
                                "text": "Frau Schneiderle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "eb81f62a-c495-477f-9a70-928613cc14c5",
                                "sense_id": "61cf60d1-7216-3b61-82c9-6323c5e692b4",
                                "text": "Herr Schneiderle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e5866a8e-86b6-4552-b93d-1c3c8cffc640",
                                "sense_id": "61cf60d1-7216-3b61-82c9-6323c5e692b4",
                                "text": "Die Schneiderles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "45aacd0c-9188-49f6-8bd6-05163090ce49",
                                "sense_id": "61cf60d1-7216-3b61-82c9-6323c5e692b4",
                                "text": "Der Schneiderle trägt nie die Pullover, die die Schneiderle ihm strickt."
                            },
                            {
                                "example_id": "fa816b8f-fffb-48c7-b996-37b669831815",
                                "sense_id": "61cf60d1-7216-3b61-82c9-6323c5e692b4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schneiderle kommt, geht der Herr Schneiderle.“"
                            },
                            {
                                "example_id": "5716532e-1250-4b23-9ad5-441eebf3af45",
                                "sense_id": "61cf60d1-7216-3b61-82c9-6323c5e692b4",
                                "text": "Schneiderle kommt und geht."
                            },
                            {
                                "example_id": "8d9802c0-8ddf-4308-83c1-65962ef0091f",
                                "sense_id": "61cf60d1-7216-3b61-82c9-6323c5e692b4",
                                "text": "Schneiderles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
