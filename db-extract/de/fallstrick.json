                        ],
                        "form": "die Fallstricke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13edcaca-5b0f-3daa-b12d-204e8a9c643a",
                        "entry_id": "f300070b-af81-35d4-a1c4-eb747cfb0257",
                        "glosses": [
                            "Mittel, um jemanden zu Fall zu bringen oder zu schaden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c361a54-b213-424a-a465-d11a12170ffd",
                                "sense_id": "13edcaca-5b0f-3daa-b12d-204e8a9c643a",
                                "text": "„So gilt Brigitte Ederer etwa als eine sehr erfahrene Personalerin, die lange auf ihrem Posten war und wohl eher über politische Fallstricke gestolpert ist als über eigenes Versagen.“"
                            },
                            {
                                "example_id": "33e6be87-81a2-427e-a11b-e6fcf59d4b28",
                                "sense_id": "13edcaca-5b0f-3daa-b12d-204e8a9c643a",
                                "text": "„Aber sein Weg war voller Fallstricke.“"
                            },
                            {
                                "example_id": "30200dd1-c849-447f-86a1-36cafcc19b4e",
                                "sense_id": "13edcaca-5b0f-3daa-b12d-204e8a9c643a",
                                "text": "„Ich glaubte im Gegenteil, gerade weil ich C. C. liebte, müsse ich hingehen, um sie vor anderen Fallstricken zu bewahren.“"
                            },
                            {
                                "example_id": "6ad1597d-145e-4e12-a883-cac7fa0962a9",
                                "sense_id": "13edcaca-5b0f-3daa-b12d-204e8a9c643a",
                                "text": "„Wenn man mit 280 Zeichen langen Tweets Wahlen beeinflussen, Pandemien kartieren und Märkte erschüttern kann, kommt es darauf an, die Verheißungen und Fallstricke von Buchstaben, Schriftarten, Emojis und Satzzeichen, vor allem aber der paradoxen !!! zu verstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f100541d-ec83-47fa-9557-4480fe0ae4db",
                        "source_entry_id": "f300070b-af81-35d4-a1c4-eb747cfb0257",
                        "source_sense_id": "13edcaca-5b0f-3daa-b12d-204e8a9c643a",
                        "source_sense_description": "Mittel, um jemanden zu Fall zu bringen oder zu schaden",
                        "target_lang_word": "pitfall",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pitfall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85bc8b84-3d82-370e-a58e-76ab256b7a45",
                                        "entry_id": "c2e40dd0-4e42-350c-a808-1e07bc5d3c8c",
                                        "glosses": [
                                            "A potential, unsuspected, hidden problem, hazard, or danger that is easily encountered but not immediately obvious."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b708657c-6901-4252-93a1-e1c6caf6cb88",
                                                "sense_id": "85bc8b84-3d82-370e-a58e-76ab256b7a45",
                                                "text": "It's usually a simple task, but you should know the pitfalls before you attempt it yourself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31164325-b5ce-361f-a023-4dd0af39af82",
                                        "entry_id": "c2e40dd0-4e42-350c-a808-1e07bc5d3c8c",
                                        "glosses": [
                                            "A type of trap consisting of a concealed pit in the ground, which the victim is supposed to fall into and not be able to get out from."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cba79313-0a59-348d-b5f8-3c4faeb710b8",
                                        "entry_id": "c2e40dd0-4e42-350c-a808-1e07bc5d3c8c",
                                        "glosses": [
                                            "An antipattern."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30934adb-c045-3b86-97a7-72f6e4534558",
                                        "entry_id": "c2e40dd0-4e42-350c-a808-1e07bc5d3c8c",
                                        "glosses": [
                                            "Subsidence below ground in a mine, which can cause the ground level above to drop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c6bf999-f119-4ba5-b4eb-64c75871f76c",
                                                "sense_id": "30934adb-c045-3b86-97a7-72f6e4534558",
                                                "text": "This pitfall, beginning in February and finishing in May, resulted in a drop of about 3 ft. in the platform level; during this period it was necessary to level the track three times weekly, and impose a service slack of 15 m.p.h. The subsidence appears now to have finished, and normal speed is once again permitted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
