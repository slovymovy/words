                ],
                "senses": [
                    {
                        "sense_id": "8549c982-7899-32a3-83fe-9243d45c44dd",
                        "entry_id": "cfce6a69-1cc5-30d1-8b0a-47e3d651d9a6",
                        "glosses": [
                            "veraltet: Bauer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa143bf1-6434-4538-a948-e6ffc8711aa5",
                                "sense_id": "8549c982-7899-32a3-83fe-9243d45c44dd",
                                "text": "„Sechs Tage geht in harter Fron // der Bauersmann. Sein Werk ist schwer. // Die Scholle kargt. Den dürftigen Lohn // gibt sie nur hart gezwungen her.“"
                            },
                            {
                                "example_id": "54fa8343-a1e7-4705-a8cf-c3a02cca1e8f",
                                "sense_id": "8549c982-7899-32a3-83fe-9243d45c44dd",
                                "text": "„Und wenn man des Bauersmanns That durch die Jahrhunderte rühmt, die des Edelmanns ist nicht geringer.“"
                            },
                            {
                                "example_id": "005d766b-de7e-4bc7-a505-cc3c12edf441",
                                "sense_id": "8549c982-7899-32a3-83fe-9243d45c44dd",
                                "text": "„Nach den Kindern treten die Mägde und Knechte in ihren Sonntagskleidern aus den Bauern- und Gesindehäusern, und nach ihnen kommen Arm in Arm die Bauersfrauen und die Bauersmänner, die jungen und die alten.“"
                            },
                            {
                                "example_id": "ef3be561-7f5c-4d26-ac20-6485de351a39",
                                "sense_id": "8549c982-7899-32a3-83fe-9243d45c44dd",
                                "text": "„Die Greise im Dorf belehren die jungen Bauersmänner über die von den Vorfahren erprobten Wirthschaftsregeln; und diese sind auch weiter nichts als bloße Theorie; ob nun Theorie mündlich oder schriftlich gelehret wird, ist doch wohl gleichgültig.“"
                            },
                            {
                                "example_id": "f1b526ab-9adf-42a7-a355-4bb2f09f2bd3",
                                "sense_id": "8549c982-7899-32a3-83fe-9243d45c44dd",
                                "text": "„Die Pachtverträge waren meistens sehr hart, die Güter heruntergewirtschaftet und von einheimischen ‚häbigen Bauersmännern‘ gemieden, der Pächter von der dörflichen Gemeinschaft durch seinen Sitz auf einem Einzelhofe abgeschieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
