                                "target_lang_word": "bijbedoeling",
                                "target_lang_sense_clarification": "meestal gebruikt in de uitdrukking 'een bijbedoeling hebben'"
                            },
                            {
                                "target_lang_word": "achterliggend",
                                "target_lang_sense_clarification": "verwijzend naar een verborgen motief"
                            }
