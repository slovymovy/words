                                        "sense_id": "3a707e69-0b57-32f5-b623-41a8f41af56a",
                                        "entry_id": "7349420f-054f-3dfa-b8d9-127f511ea655",
                                        "glosses": [
                                            "A feeling of understanding and ease of communication between two or more people."
                                        ],
