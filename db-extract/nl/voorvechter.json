                "senses": [
                    {
                        "sense_id": "51303c44-60dd-3a42-87b2-a474857a05b6",
                        "entry_id": "5bd20c0a-1e3e-3921-9679-a3cd65382fd1",
                        "glosses": [
                            "iemand die ergens een voorstander van is en zich daarvoor actief inzet"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "db83d027-1795-4ba4-ac17-b6b9551a9f1a",
                                "sense_id": "51303c44-60dd-3a42-87b2-a474857a05b6",
                                "text": "Voorvechters voor dierenrechten zijn de afgelopen tijd opmerkelijk actief. Dinsdag stapten twee agenten een viswinkel in Oldenzaal binnen vanwege een te grote goudvis in een grote kom. En vorige week moest groep 4 van de Budelse basisschool De Triolier afscheid nemen van goudvis Hans/Grietje in hun lokaal. De Stichting Vissenbescherming had boos naar de directie gebeld en geëist dat een eind gemaakt zou worden aan deze ernstige vorm van dierenkwelling."
                            },
                            {
                                "example_id": "04e607ee-160a-44a6-b090-5d318f0b6b69",
                                "sense_id": "51303c44-60dd-3a42-87b2-a474857a05b6",
                                "text": "Nu kunnen burgers nog bij iedere wet vragen om een raadgevend referendum over die wet. Het kabinet wil daarvan af, maar is bang dat burgers over de zogenoemde afschaffingswet ook een volksraadpleging aanvragen. Voorvechters van het referendum hebben die al aangekondigd."
                            }
                        ]
                    },
                    {
                        "sense_id": "01924fea-c04b-33f4-9b1e-d63680af4eea",
                        "entry_id": "5bd20c0a-1e3e-3921-9679-a3cd65382fd1",
                        "glosses": [
                            "iemand die vooropgaat in een gevecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "549ce7d2-ea62-46e7-961d-f1b3246c5ede",
                                "sense_id": "01924fea-c04b-33f4-9b1e-d63680af4eea",
                                "text": "Deze dracht gold niet als vrouwelijk, maar juist als mannelijk en martiaal, de haardracht van voorvechters en koppensnellers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca392a9b-b4ac-40a8-8a14-1140ee2813b6",
