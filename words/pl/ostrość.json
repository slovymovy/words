        "ostrze"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b30edc9-271f-39e2-b22a-bff0d6211141",
                    "sense_definition": "Właściwość przedmiotów mających tnącą krawędź lub szpiczaste zakończenie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fizyczna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed rozpoczęciem krojenia warzyw kucharz dokładnie sprawdził <w>ostrość</w> noża kuchennego.",
                            "target_lang_translations": {
                                "ru": "Перед тем как начать нарезать овощи, повар тщательно проверил <w>остроту</w> кухонного ножа."
                            }
                        },
                        {
                            "text": "Ten stary scyzoryk dawno stracił swoją pierwotną <w>ostrość</w> i wymaga naostrzenia.",
                            "target_lang_translations": {
                                "ru": "Этот старый складной нож давно потерял свою первоначальную <w>остроту</w> и требует заточки."
                            }
                        }
                    ],
                    "antonyms": [
                        "tępość"
                    ],
                    "common_phrases": [
                        "ostrość noża",
                        "stracić ostrość"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство предметов, имеющих режущий край или острое окончание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "острота",
                                "target_lang_sense_clarification": "лезвия, режущего края или острия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fed5678-0be4-3add-b0cc-fe0046c04ceb",
                    "sense_definition": "Wyrazistość detali i konturów widocznych na obrazie lub zdjęciu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "optyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fotograf musiał ręcznie ustawić <w>ostrość</w> w obiektywie, aby zdjęcie portretowe wyszło wyraźne.",
                            "target_lang_translations": {
                                "ru": "Фотографу пришлось вручную настраивать <w>резкость</w> объектива, чтобы портретный снимок получился чётким."
                            }
                        },
                        {
                            "text": "Na tym starym nagraniu wideo całkowicie brakuje <w>ostrości</w> i trudno rozpoznać twarze.",
                            "target_lang_translations": {
                                "ru": "На этой старой видеозаписи совершенно нет <w>чёткости</w>, и лица трудно различить."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyrazistość"
                    ],
                    "common_phrases": [
                        "ustawić ostrość",
                        "głębia ostrości"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чёткость деталей и контуров, различимых на изображении или фотографии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резкость",
                                "target_lang_sense_clarification": "в оптике и фотографии"
                            },
                            {
                                "target_lang_word": "чёткость",
                                "target_lang_sense_clarification": "изображения или контуров"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f987d96-c3af-3d31-b60a-f736a72c524d",
                    "sense_definition": "Zdolność dokładnego odbierania bodźców przez zmysły, zwłaszcza wzrok lub słuch.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zmysly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wraz z wiekiem pacjent zauważył, że <w>ostrość</w> jego wzroku uległa znacznemu pogorszeniu.",
                            "target_lang_translations": {
                                "ru": "С возрастом пациент заметил, что <w>острота</w> его зрения значительно ухудшилась."
                            }
                        },
                        {
                            "text": "Zwierzęta drapieżne polegają w nocy na niezwykłej <w>ostrości</w> swojego słuchu i węchu.",
                            "target_lang_translations": {
                                "ru": "Ночью хищные животные полагаются на исключительную <w>остроту</w> своего слуха и обоняния."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ostrość wzroku",
                        "ostrość słuchu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность органов чувств точно и отчётливо воспринимать раздражители (особенно о зрении или слухе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "острота",
                                "target_lang_sense_clarification": "о зрении, слухе или восприятии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3e84953-c5ef-3fcc-9fcb-08340e339563",
                    "sense_definition": "Cecha wypowiedzi, krytyki lub zachowania charakteryzująca się surowością i bezwzględnością.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cecha_charakteru",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszyscy uczestnicy debaty byli zaskoczeni niezwykłą <w>ostrością</w> jego komentarzy i opinii.",
                            "target_lang_translations": {
                                "ru": "Все участники дебатов были поражены необычайной <w>резкостью</w> его комментариев и мнений."
                            }
                        },
                        {
                            "text": "Dyrektor złagodził nieco <w>ostrość</w> swojej nagany, aby nie zniechęcać młodego pracownika.",
                            "target_lang_translations": {
                                "ru": "Директор немного смягчил <w>резкость</w> своего выговора, чтобы не демотивировать молодого сотрудника."
                            }
                        }
                    ],
                    "synonyms": [
                        "surowość",
                        "ciętość"
                    ],
                    "antonyms": [
                        "łagodność"
                    ],
                    "common_phrases": [
                        "ostrość sądów",
                        "ostrość wypowiedzi"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство высказывания, критики или поведения, отличающееся суровостью, резкостью и прямотой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резкость",
                                "target_lang_sense_clarification": "в высказываниях, критике или поведении"
                            },
                            {
                                "target_lang_word": "острота",
                                "target_lang_sense_clarification": "полемики, спора или критики"
                            },
                            {
                                "target_lang_word": "язвительность",
                                "target_lang_sense_clarification": "едкий характер слов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "533ac716-067a-33ea-af9d-4a885e93a3b6",
                    "sense_definition": "Mocne zarysowanie, kanciastość lub wyrazistość kształtów i linii twarzy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cechy_fizyczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mocne oświetlenie ze sceny jeszcze bardziej podkreślało <w>ostrość</w> rysów twarzy aktora.",
                            "target_lang_translations": {
                                "ru": "Яркое сценическое освещение ещё сильнее подчёркивало <w>резкость</w> черт лица актёра."
                            }
                        },
                        {
                            "text": "Z biegiem lat zauważalna stała się pewna <w>ostrość</w> w profilu jej podbródka.",
                            "target_lang_translations": {
                                "ru": "С годами стала заметна некоторая <w>заострённость</w> в профиле её подбородка."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyrazistość"
                    ],
                    "antonyms": [
                        "delikatność"
                    ],
                    "common_phrases": [
                        "ostrość rysów"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чёткая очерченность, угловатость или выразительность форм и линий лица."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заострённость",
                                "target_lang_sense_clarification": "черт лица или контуров"
                            },
                            {
                                "target_lang_word": "резкость",
                                "target_lang_sense_clarification": "линий или очертаний лица"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}