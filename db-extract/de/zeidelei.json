                        "glosses": [
                            "Bienenzucht im Mittelalter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d432291-0069-44ba-a4a3-1b120e786f52",
                                "sense_id": "76dfbc25-e6ff-3459-b72b-a2a8f1746469",
                                "text": "„Nicht unwahrscheinlich ist, daß die Wenden, den Formen der intensiven Bodennutzung abhold, es meist vorzogen, sich durch Zeidelei oder als Kossäten oder Einlieger durch Dienstleistungen für Bauern und Ritter zu ernähren, als selbst harte Landarbeit durch Rodung zu leisten, gegen ihren Willen dazu herabgedrückt wurden sie nicht.“"
                            },
                            {
                                "example_id": "98e5ac7f-30b2-4b13-a287-6b59edf057fc",
                                "sense_id": "76dfbc25-e6ff-3459-b72b-a2a8f1746469",
                                "text": "„Besondere Fähigkeiten hatten sich die Heveller in der Pferdezucht und in der Zeidelei (Waldbienenhaltung) angeeignet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
