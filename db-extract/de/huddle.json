                        "cross_references": [
                            {
                                "target_word": "huddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a8c8ad2-eda3-34a1-9e0f-71ff452165ff",
                                        "entry_id": "024b1fe2-d798-3c96-b2e1-b3b3a4a981b4",
                                        "glosses": [
                                            "A dense and disorderly crowd."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e748d209-d965-3606-bad5-05c6f16b3bde",
                                        "entry_id": "024b1fe2-d798-3c96-b2e1-b3b3a4a981b4",
                                        "glosses": [
                                            "A small group of individuals in very close proximity to one another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dd2a138-6555-4038-a7b2-3474cfe84c81",
                                                "sense_id": "e748d209-d965-3606-bad5-05c6f16b3bde",
                                                "text": "It’s about as riveting as listening to a huddle of ents discuss the finer points of deciduous shedding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68eaa1fe-9926-3acb-8606-ce3f3809b8b6",
                                        "entry_id": "024b1fe2-d798-3c96-b2e1-b3b3a4a981b4",
                                        "glosses": [
                                            "A small group of individuals in very close proximity to one another.",
                                            "A session in which a group of journalists assemble in an informal, dense cluster to question a person of interest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e9efa1a-1ddb-4356-921b-0f0899d34a60",
                                                "sense_id": "68eaa1fe-9926-3acb-8606-ce3f3809b8b6",
                                                "text": "The post-PMQs huddle takes place just outside the press gallery, and all the journalists swarm first around the Prime Minister's press team[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30c0802e-b2a6-35c1-8a37-35a939569188",
                                        "entry_id": "024b1fe2-d798-3c96-b2e1-b3b3a4a981b4",
                                        "glosses": [
                                            "A small group of individuals in very close proximity to one another.",
                                            "A brief meeting of all the players from one team that are on the field with the purpose of planning the following play."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c4f9ee9-c9d3-3f70-b3dd-6055a7c7ff2a",
                                        "entry_id": "024b1fe2-d798-3c96-b2e1-b3b3a4a981b4",
                                        "glosses": [
                                            "A hesitation during play to think about one's next move."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "huddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f493f0d-fbcd-3f5c-904c-8cde98cb25db",
                                        "entry_id": "c0d71312-c230-3e8b-a03b-a191abfda3d4",
                                        "glosses": [
                                            "To crowd together."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab7e7c65-7f75-462c-a1aa-cc4364c980a4",
                                                "sense_id": "0f493f0d-fbcd-3f5c-904c-8cde98cb25db",
                                                "text": "The sheep huddled together seeking warmth."
                                            },
                                            {
                                                "example_id": "cd638e81-8551-4b01-8bb1-0e4c966cce2e",
                                                "sense_id": "0f493f0d-fbcd-3f5c-904c-8cde98cb25db",
                                                "text": "During all these operations the apes who had entered sat huddled near the door watching their chief, while those outside strained and crowded to catch a glimpse of what transpired within."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aa0a647-c382-3f2c-b10d-b9093f5c0563",
                                        "entry_id": "c0d71312-c230-3e8b-a03b-a191abfda3d4",
                                        "glosses": [
                                            "To curl one's legs up to the chest and keep one's arms close to the torso; to crouch; to assume a position similar to that of an embryo in the womb."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "301eb05f-30a3-456a-b3f1-f295bd23c6a8",
                                                "sense_id": "5aa0a647-c382-3f2c-b10d-b9093f5c0563",
                                                "text": "Just south of Wamphray station they overtook the runaway. The dim figure of Mitchell could be seen sitting huddled behind the stormboard. They shouted and whistled. He paid no attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be70dfa2-42a7-316c-8380-750853562b2e",
                                        "entry_id": "c0d71312-c230-3e8b-a03b-a191abfda3d4",
                                        "glosses": [
                                            "To get together and discuss a topic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d03638c-85b8-49f7-a3e9-e84a75c84fa0",
                                                "sense_id": "be70dfa2-42a7-316c-8380-750853562b2e",
                                                "text": "George Hirsch, chairman of the board of Road Runners, said officials huddled all day Friday, hoping to devise an alternate race. They considered replacing the marathon with a race that would comprise the final 10 miles of marathon, starting at the base of the Queensboro 59th Street Bridge on the Manhattan side. But that was not deemed plausible, Mr. Hirsch said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7162358e-d15f-358d-8cb9-b3623aadc1e7",
                                        "entry_id": "c0d71312-c230-3e8b-a03b-a191abfda3d4",
                                        "glosses": [
                                            "To form a huddle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ed4fad0-2385-3988-8a07-cd547eab47a4",
                                        "entry_id": "c0d71312-c230-3e8b-a03b-a191abfda3d4",
                                        "glosses": [
                                            "To crowd (things) together; to mingle confusedly; to assemble without order or system."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e700b8d-719d-44e4-84f9-68a6987b04c6",
                                                "sense_id": "4ed4fad0-2385-3988-8a07-cd547eab47a4",
                                                "text": "Our adversary, huddling several suppositions together,[…]makes a medley and confusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04ab64c6-f543-3e07-bd0e-8612e79ec1e1",
                                        "entry_id": "c0d71312-c230-3e8b-a03b-a191abfda3d4",
                                        "glosses": [
                                            "To do, make, or put, in haste or roughly; hence, to do imperfectly; usually with a following preposition or adverb (huddle on, huddle up, huddle together)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cde5da6-2304-4ce7-b99c-301b917685af",
                                                "sense_id": "04ab64c6-f543-3e07-bd0e-8612e79ec1e1",
                                                "text": "Huddle up a peace."
                                            },
                                            {
                                                "example_id": "fa092cb9-3ff4-4677-a9e2-148ed9e79526",
                                                "sense_id": "04ab64c6-f543-3e07-bd0e-8612e79ec1e1",
                                                "text": "Let him forecast his work with timely care, / Which else is huddled when the skies are fair."
                                            },
                                            {
                                                "example_id": "d5174a66-92f2-4f13-ae79-bd14307a0bde",
                                                "sense_id": "04ab64c6-f543-3e07-bd0e-8612e79ec1e1",
                                                "text": "Now, in all haste, they huddle on / Their hoods, their cloaks, and get them gone."
                                            },
                                            {
                                                "example_id": "e820dd41-120e-4911-8174-3544a29c9c89",
                                                "sense_id": "04ab64c6-f543-3e07-bd0e-8612e79ec1e1",
                                                "text": "This resolution she accordingly executed; and the next morning before the sun, she huddled on her cloaths, and at a very unfashionable, unseasonable, unvisitable hour, went to Lady Bellaston […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec12eb10-511c-351c-bfb4-730cd66cc8cd",
                                        "entry_id": "c0d71312-c230-3e8b-a03b-a191abfda3d4",
                                        "glosses": [
                                            "To hesitate during play while thinking about one's next move."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "huddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b04a8edc-16f5-3c3e-903b-849a8e5cc142",
                                        "entry_id": "ff8eef1a-f692-3d31-bef0-7f74510dc125",
                                        "glosses": [
                                            "Huddled, confused, congested."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd326712-40c9-4679-82c2-7ccd2c206d98",
                                                "sense_id": "b04a8edc-16f5-3c3e-903b-849a8e5cc142",
                                                "text": "There was in Sicilie a certaine fisherman who resembled in all points Sura the pro-consull, not onely in visage and feature of the face, but also in mowing with his mouth when he spake, in drawing his tongue short, and in his huddle and thicke speech."
                                            },
                                            {
                                                "example_id": "f28d990c-7a95-4b70-b7c0-1a71436db91d",
                                                "sense_id": "b04a8edc-16f5-3c3e-903b-849a8e5cc142",
                                                "text": "The evangelists are easily distinguished from the rest, by a passionate zeal and love which the painter has thrown in their faces; the huddle group of those who stand most distant, are admirable representations of men abashed with their late unbelief and hardness of heart."
                                            },
                                            {
                                                "example_id": "181cf3ad-fe3c-45bd-bffa-29c87ebc5e29",
                                                "sense_id": "b04a8edc-16f5-3c3e-903b-849a8e5cc142",
                                                "text": "Gowan snored, each respiration choking to a huddle fall as though he would never breathe again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
