                        "glosses": [
                            "Tout petit four."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34c6e0e8-8d55-4a91-a785-09d3eebf7b81",
                                "sense_id": "87c52d8d-8637-3c37-8854-66b6a39a813f",
                                "text": "Le long des murs courent des paillasses où sont posés samovars, cafetières, bouilloires, plaques chauffantes, mini-fours, presse-fruits et bien d’autres ustensiles."
                            },
                            {
                                "example_id": "b23e5aa8-736e-4fb7-b1c2-aab497b51cf9",
                                "sense_id": "87c52d8d-8637-3c37-8854-66b6a39a813f",
                                "text": "L’avantage de ces mini-fours est qu’ils consomment peu."
                            },
                            {
                                "example_id": "2540d0d5-16f2-48be-82e9-4b13b9a4e865",
                                "sense_id": "87c52d8d-8637-3c37-8854-66b6a39a813f",
                                "text": "Encore au XVᵉ siècle, de petites forges rurales ou de quartier, la forge d’un chantier ou d’une carrière de pierre, de mini-fours d’artisans à domicile (orfèvres) ne s’écartent guère du procédé décrit."
                            }
                        ]
                    }
