                    {
                        "sense_id": "2c73639c-7ad9-3243-8acc-f00f21d07762",
                        "entry_id": "6626cc78-7b46-33a3-ab07-6d3de261b202",
                        "glosses": [
                            "Interjection pour exprimer la peine, la pitié, l’étonnement."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "772c824e-576a-4176-8b6f-937e0f8a818a",
                                "sense_id": "2c73639c-7ad9-3243-8acc-f00f21d07762",
                                "text": "« Nous viendrons le chercher demain, dit M. Eyssette, sur les bateaux, rien ne s’égare ! » Et là-dessus, malgré mes larmes, il m’entraîna. Pécaïre ! le lendemain on l’envoya chercher et on ne le trouva pas…"
                            },
                            {
                                "example_id": "781fb213-a28f-4e16-a7fc-a0639fd95f4e",
                                "sense_id": "2c73639c-7ad9-3243-8acc-f00f21d07762",
                                "text": "Pécaïre ! Pauvre Renaude !… Ça ne fait rien, monsieur Seguin, laissez-moi aller dans la montagne."
                            },
                            {
                                "example_id": "70e260c6-2d04-4380-ab66-580e5c675c71",
                                "sense_id": "2c73639c-7ad9-3243-8acc-f00f21d07762",
                                "text": "Pécaïre ! elle n’aurait pas mieux demandé, elle, que de descendre…"
                            },
                            {
                                "example_id": "10c6acc8-7e86-4835-bc81-f2ec0f0faadb",
                                "sense_id": "2c73639c-7ad9-3243-8acc-f00f21d07762",
                                "text": "Ha ! Pécaïre ! Alors il faut que je me contente de voir cela en imagination."
                            }
                        ]
                    }
                ],
