        "ru-extract.jsonl": [
            {
                "entry_id": "3ad6925f-aa7b-3d9c-9494-03681abaa1af",
                "word": "Калашников",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b17b892d-63b1-3090-bd56-a71fd7381f16",
                        "entry_id": "3ad6925f-aa7b-3d9c-9494-03681abaa1af",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76407f21-b581-4727-a3ce-d6dee7828ae4",
                                "sense_id": "b17b892d-63b1-3090-bd56-a71fd7381f16",
                                "text": "Легендарный инженер-конструктор Михаил Калашников выбрал Ford Focus российского производства в качестве личного автомобиля."
                            },
                            {
                                "example_id": "f0b4ebf7-5519-448a-8112-8a8bd77a5799",
                                "sense_id": "b17b892d-63b1-3090-bd56-a71fd7381f16",
                                "text": "Когда царский опричник Кирибеевич покусился на честь прекрасной Алёны Дмитревны, он заплатил за это, как мы знаем от Лермонтова, жизнью, муж красавицы, купец Степан Калашников, убил его в честном поединке."
                            },
                            {
                                "example_id": "785d6e6f-8e82-49fd-b115-be7e9ce0d2f0",
                                "sense_id": "b17b892d-63b1-3090-bd56-a71fd7381f16",
                                "text": "Директор Федеральной службы исполнения наказаний (ФСИН) Александр Калашников предложил организовать в России трудовые лагеря для осуждённых, которым содержание в колонии может быть заменено на принудительные работы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec19a2ed-f880-449e-a460-5b1c02670c0b",
                        "source_entry_id": "3ad6925f-aa7b-3d9c-9494-03681abaa1af",
                        "source_sense_id": "b17b892d-63b1-3090-bd56-a71fd7381f16",
                        "target_lang_word": "Kalashnikov",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kalashnikov",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62750b6e-2cfb-3f76-a029-40bc377e249c",
                                        "entry_id": "f5031647-e5b9-326e-a134-707bf72b821f",
                                        "glosses": [
                                            "A particular model of Russian assault rifle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91c3e7df-8ebd-4f3a-9ac8-24b21e923ddb",
                                                "sense_id": "62750b6e-2cfb-3f76-a029-40bc377e249c",
                                                "text": "A Cameroonian soldier lies in a trench, the tip of his Kalashnikov rifle pointing toward the Nigerian town of Gambaru, which has been taken over by Boko Haram terrorists."
                                            },
                                            {
                                                "example_id": "bdd2b85d-ee09-44eb-94ee-6c253854c61b",
                                                "sense_id": "62750b6e-2cfb-3f76-a029-40bc377e249c",
                                                "text": "So, we are prepared to bear arms and yesterday we were given Kalashnikovs so we will be able to resist if Russian forces will come to Kyiv."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da0c6168-a1dd-36f1-8974-108c2b996340",
                                        "entry_id": "f5031647-e5b9-326e-a134-707bf72b821f",
                                        "glosses": [
                                            "A transliteration of the Russian surname Кала́шников (Kalášnikov)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce6def9f-da2f-42b1-a08c-a0efff0bb953",
                                                "sense_id": "da0c6168-a1dd-36f1-8974-108c2b996340",
                                                "text": "As if he were assembling a collection of Russian scary stories, the director Dmitrii Kalashnikov makes the bizarre beguiling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
