                "senses": [
                    {
                        "sense_id": "f2afa50e-9690-33a3-a4ea-5b1a6577f574",
                        "entry_id": "1104bf2e-6438-3df4-853e-d4cebc079d44",
                        "glosses": [
                            "Rapace de la Réunion, aussi appelé busard de Maillard (nom CINFO), busard de la Réunion ou pied jaune."
                        ],
                        "tags": [
                            "La Réunion"
                        ],
                        "examples": [
                            {
                                "example_id": "d13e4596-6e0b-4a20-960f-67b169fbef94",
                                "sense_id": "f2afa50e-9690-33a3-a4ea-5b1a6577f574",
                                "text": "Sur les hauteurs de Sainte-Suzanne, près d’une cascade, monsieur Dejean fut tué par un oiseau, probablement un papangue, qui laissa une tortue tomber sur son crâne pelé qu’on confondait facilement avec une pierre."
                            },
                            {
                                "example_id": "e1112d2b-9159-4817-95a7-46be57d218c4",
                                "sense_id": "f2afa50e-9690-33a3-a4ea-5b1a6577f574",
                                "text": "Il lui raconta également toutes ces histoires anciennes, celles qu’il tenait de Mémé Gâté, la légende de Grand-Mère Kalle, et celle d’Anchaing qui se transforma en papangue du haut de son piton."
                            }
                        ]
                    }
                ],
