                ],
                "senses": [
                    {
                        "sense_id": "55c9a7fb-2e6b-386f-a279-86c143ebe8c1",
                        "entry_id": "ccfaf6ca-bc2a-374a-a9d0-4e6cbee4281b",
                        "glosses": [
                            "Boire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20a791ec-8d85-42d2-981d-811470b33272",
                                "sense_id": "55c9a7fb-2e6b-386f-a279-86c143ebe8c1",
                                "text": "Maubert qui ne connaît pas les saisons, je te l'ai dit, veille toutes les nuits, la gamelle de bouillon mendiée à une porte de restaurant vite avalée pour carafonner à l'aise."
                            },
                            {
                                "example_id": "3f42b418-80ac-4ecc-9f54-d768f3310544",
                                "sense_id": "55c9a7fb-2e6b-386f-a279-86c143ebe8c1",
                                "text": "Lichetrogner, siffler, se mouiller la meule, se démolir la bouteille, écluser le godet, se carafonner, chalumer à tire-larigot, pitancher, s'aniser, se biturer, se rouiller le mou, se camphrer la cornemuse, sucer le cruchon, boire !"
                            }
                        ]
                    }
