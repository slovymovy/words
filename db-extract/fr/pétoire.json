                                    },
                                    {
                                        "sense_id": "17410795-810f-3aef-a8aa-3c865d5b5ac4",
                                        "entry_id": "ecabb1c4-c10c-3392-9bd4-8387a55666bc",
                                        "glosses": [
                                            "Any small or ineffective gun or weapon."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a65cf056-846e-4307-8e31-5253d4ae3ad1",
                                                "sense_id": "17410795-810f-3aef-a8aa-3c865d5b5ac4",
                                                "text": "Compared to my forty-five, it's a toy. Christ, Thanet, why did you buy it in the first place? I would have given you one of mine, a real weapon, one with knock down power, compared to that peashooter on your hip."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
