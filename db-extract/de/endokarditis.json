                "senses": [
                    {
                        "sense_id": "99fd5155-70e8-3ed7-9e71-f3eaa90d15c4",
                        "entry_id": "ca152313-b739-3239-b183-48ae8f0d41ce",
                        "glosses": [
                            "Entzündung der Herzinnenhaut (Endokard) und teilweise auch der Herzklappen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f78ceac3-bad3-4488-9af6-8d534616e0f2",
                                "sense_id": "99fd5155-70e8-3ed7-9e71-f3eaa90d15c4",
                                "text": "Es gibt kaum einen Erreger, der nicht zu einer Endokarditis führen kann."
                            },
                            {
                                "example_id": "2653d193-e0d6-466f-9692-04db3a54d547",
                                "sense_id": "99fd5155-70e8-3ed7-9e71-f3eaa90d15c4",
                                "text": "Diphterische Endokarditen sind nicht nur an nativen, sondern nicht selten auch an prothetischen Klappen beschrieben worden (s. Gerry u. Greenough III 1976)."
                            },
                            {
                                "example_id": "d9a7ed80-0f9d-40a4-ae17-69509d9ac260",
                                "sense_id": "99fd5155-70e8-3ed7-9e71-f3eaa90d15c4",
                                "text": "Die Prognose der Endokarditis hängt vom Zeitpunkt des Therapiebeginns, den Erregern, dem Alter und der Abwehrlage des Patienten sowie der Vorschädigung des Herzens ab."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
