                ],
                "senses": [
                    {
                        "sense_id": "af92d4a1-5fd8-30f7-89e9-d38f3d890d8e",
                        "entry_id": "806cdcaa-c24f-3d89-a6f8-1c260cf42fca",
                        "glosses": [
                            "Gesamtheit der Adern; linienartiges Muster von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "148434fd-0175-4324-990e-08bd6fe2f6cc",
                                "sense_id": "af92d4a1-5fd8-30f7-89e9-d38f3d890d8e",
                                "text": "„Die Venezianer schätzten bunten und stark geäderten Stein, grünen Porphyr und schwarzen Granit, weißen Stein mit einer rötlichen Äderung oder orangefarbenen Stein mit einer weißen.“"
                            },
                            {
                                "example_id": "9b1c276d-89c6-4ee9-8118-41e191465c64",
                                "sense_id": "af92d4a1-5fd8-30f7-89e9-d38f3d890d8e",
                                "text": "„Die etwa handtellergroßen Blätter sind sattgrün und deren Äderung ist an der Oberseite gut erkennbar.“"
                            },
                            {
                                "example_id": "bad4704c-ae9b-4270-9921-8965643e09a1",
                                "sense_id": "af92d4a1-5fd8-30f7-89e9-d38f3d890d8e",
                                "text": "„Irgendwann lag dieser flache, dunkle Kiesel mit der weißen Äderung vor meinen Füßen.“"
                            },
                            {
                                "example_id": "f8ec0bff-4621-4ebc-b5aa-8c4be3c17806",
                                "sense_id": "af92d4a1-5fd8-30f7-89e9-d38f3d890d8e",
                                "text": "„Der ganze Baum ist nur ein einziges Blatt, und Flüsse sind die Äderung übergroßer Blätter, die zwischen den Windungen liegende Erde ist ihr Fleisch, mit den Dörfern und Städten als der Eiablage von Insekten in den Gabelungen.“"
                            },
                            {
                                "example_id": "614f2c3a-b3a6-4d9d-8660-0fada5dd1559",
                                "sense_id": "af92d4a1-5fd8-30f7-89e9-d38f3d890d8e",
                                "text": "„Sie waren von dem Röhrensystem der Kühlanlage durchzogen und glichen durch ihre Äderung den Flügeln einer großen Libelle.“"
                            },
                            {
                                "example_id": "5958f63c-ba3e-4639-8e5a-401d6b813e29",
                                "sense_id": "af92d4a1-5fd8-30f7-89e9-d38f3d890d8e",
                                "text": "„Die Blätter sind wechselständig, kurzgestielt, verkehrt-eiförmig bis verkehrt-lanzettlich, lederig, ganzrandig, am Rande flaumhaarig behaart, oberseits dunkelgrün, unterseits hellgrün, mit plastisch hervortretender, netzartiger Äderung.“"
                            },
                            {
                                "example_id": "fa8ae0e3-9f3a-4e06-8aca-21748babd4ae",
                                "sense_id": "af92d4a1-5fd8-30f7-89e9-d38f3d890d8e",
                                "text": "„Das Imitieren glattgeschliffener Marmoroberflächen in ihren Farben, Strukturen und in der Äderung geht bis in die Antike zurück.“"
                            },
                            {
                                "example_id": "8405708f-45f0-41a7-b16e-0b751a977144",
                                "sense_id": "af92d4a1-5fd8-30f7-89e9-d38f3d890d8e",
                                "text": "„Die alten Ärzte erkannten in der blaßvioletten Blüte mit der dunkelvioletten Äderung und dem gelben Pünktchen die Signatur eines kranken Auges.“"
                            },
                            {
                                "example_id": "27b2386c-83df-4a7e-9719-2a292def083b",
                                "sense_id": "af92d4a1-5fd8-30f7-89e9-d38f3d890d8e",
                                "text": "„Eine weiße Hand mit rissiger Haut und schwarzer Äderung packte den Schamanen an der Kehle.“"
                            },
                            {
                                "example_id": "a16c14b7-ede8-49ac-9abd-49ccfff4597c",
                                "sense_id": "af92d4a1-5fd8-30f7-89e9-d38f3d890d8e",
                                "text": "„Seine niedergeschlagenen Augen folgten der stummen Äderung der eichenen Tischplatte.“"
                            },
                            {
                                "example_id": "9728d8f5-0cc2-4a21-a98f-b704a2da9adf",
                                "sense_id": "af92d4a1-5fd8-30f7-89e9-d38f3d890d8e",
                                "text": "„Die Mannschaftsführer erkundeten die Äderung des Gesteins und ritzten Zeichen ein, die den Männern als Anhaltspunkte dienten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
