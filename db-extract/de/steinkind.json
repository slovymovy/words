                "senses": [
                    {
                        "sense_id": "bb3c6699-6861-39ed-944a-827acd11e390",
                        "entry_id": "786e92d1-59fd-3484-88d4-343e64db2978",
                        "glosses": [
                            "außerhalb der Gebärmutter in der Bauchhöhle entwickelte, abgestorbene, von Kalksalzen durchsetzte Leibesfrucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21dcdf37-fa46-4fad-86f5-66485c79e06f",
                                "sense_id": "bb3c6699-6861-39ed-944a-827acd11e390",
                                "text": "„Die Entwicklung einer Frucht im Uterus bei Vorhandensein einer zweiten abgestorbenen und abgesackten nach früher bestandener Extrauterinalschwangerschaft, wie es z. B. im Helfft’schen Falle und beim s. g. Steinkinde von Leinzell gefunden wurde, kann nicht unter die Zwillingsschwangerschaften mit eingerechnet werden, da sich hier die abgestorbene Frucht immer nur als fremder Körper verhält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
