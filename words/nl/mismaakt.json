        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e28c6aa6-bd8c-31d7-9bec-a7744c7e39f4",
                    "sense_definition": "Met een duidelijk zichtbare lichamelijke afwijking, vaak vanaf de geboorte.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het arme dier werd <w>mismaakt</w> geboren en had extra zorg nodig.",
                            "target_lang_translations": {
                                "en": "The poor animal was born <w>deformed</w> and needed extra care.",
                                "ru": "Бедное животное родилось <w>уродливым</w> и нуждалось в особом уходе.",
                                "fr": "Le pauvre animal est né <w>difforme</w> et avait besoin de soins particuliers."
                            }
                        },
                        {
                            "text": "In het verhaal wordt een <w>mismaakt</w> wezen beschreven dat in de toren woont.",
                            "target_lang_translations": {
                                "en": "The story describes a <w>misshapen</w> creature living in the tower.",
                                "ru": "В рассказе описывается <w>уродливое</w> существо, живущее в башне.",
                                "fr": "Dans l'histoire, on décrit une créature <w>difforme</w> qui vit dans la tour."
                            }
                        }
                    ],
                    "synonyms": [
                        "misvormd",
                        "wanschapen",
                        "wanstaltig"
                    ],
                    "antonyms": [
                        "welgevormd",
                        "gaaf"
                    ],
                    "common_phrases": [
                        "mismaakt lichaam",
                        "mismaakt gezicht",
                        "ernstig mismaakt"
                    ],
                    "target_lang_definitions": {
                        "en": "Having a clearly visible physical abnormality, often from birth.",
                        "ru": "Имеющий явно видимый физический недостаток, часто с рождения.",
                        "fr": "Présentant une anomalie physique nettement visible, souvent dès la naissance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deformed",
                                "target_lang_sense_clarification": "physical abnormality"
                            },
                            {
                                "target_lang_word": "misshapen",
                                "target_lang_sense_clarification": "badly shaped"
                            }
                        ],
                        "ru": [
