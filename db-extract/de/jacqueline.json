                                "target_senses": [
                                    {
                                        "sense_id": "9b57e4fb-cf3f-399e-a424-4347196782c3",
                                        "entry_id": "393744eb-b07b-3b3e-b5cb-6644af635273",
                                        "glosses": [
                                            "A female given name from French."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e544355-be7f-4651-953c-8905dc474fc7",
                                                "sense_id": "9b57e4fb-cf3f-399e-a424-4347196782c3",
                                                "text": "Jacqueline was so named simply because their mother had liked the ring of the word, sounding Parisian and worldly and auguring, to her mind, a good life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e02b9a1-fd18-4ceb-8e93-dd882712d02f",
                        "source_entry_id": "e83f5d3a-d2ce-319b-9a7a-988385499a33",
                        "source_sense_id": "f447cf86-2a94-3484-814e-a5b2b8a459c1",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Jacquelyn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
