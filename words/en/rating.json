{
    "word_family": [
        "rate",
        "ratable",
        "overrate",
        "underrate",
        "ratingless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c773af1c-93de-39da-a21d-7b79435c10ce",
                    "sense_definition": "An evaluation of status, especially regarding financial standing or quality.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank decided to lower the company's credit <w>rating</w> after the recent financial report.",
                            "target_lang_translations": {
                                "ru": "Банк решил снизить кредитный <w>рейтинг</w> компании после недавнего финансового отчета."
                            }
                        },
                        {
                            "text": "They have a poor credit <w>rating</w> which makes it difficult for them to secure a mortgage.",
                            "target_lang_translations": {
                                "ru": "У них плохой кредитный <w>рейтинг</w>, что затрудняет получение ипотеки."
                            }
                        }
                    ],
                    "synonyms": [
                        "evaluation",
                        "assessment",
                        "appraisal"
                    ],
                    "common_phrases": [
                        "credit rating",
                        "approval rating",
                        "investment rating"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оценка статуса, особенно в отношении финансового положения или качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рейтинг",
                                "target_lang_sense_clarification": "показатель популярности или кредитоспособности"
                            },
                            {
                                "target_lang_word": "оценка",
                                "target_lang_sense_clarification": "определение качества или уровня"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecbae473-883a-3147-b611-56ee0d7d483f",
                    "sense_definition": "A quantitative measure of the audience size for a television or radio program.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The show was canceled because it failed to achieve a high television <w>rating</w> during its first season.",
                            "target_lang_translations": {
                                "ru": "Шоу было закрыто, так как ему не удалось достичь высокого телевизионного <w>рейтинга</w> в первом сезоне."
                            }
                        },
                        {
                            "text": "A television <w>rating</w> is an indication of how many people saw what you gave them.",
                            "target_lang_translations": {
                                "ru": "Телевизионный <w>рейтинг</w> — это показатель того, сколько людей посмотрели то, что вы им предложили."
                            }
                        }
                    ],
                    "common_phrases": [
                        "television rating",
                        "audience rating",
                        "high rating"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количественный показатель размера аудитории телевизионной или радиопрограммы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рейтинг",
                                "target_lang_sense_clarification": "популярность передачи у зрителей"
                            },
                            {
                                "target_lang_word": "показатель",
                                "target_lang_sense_clarification": "численное значение охвата аудитории"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c25ef28f-0e8e-36e0-9160-bb5a0befe0bb",
                    "sense_definition": "A number, letter, or mark that indicates the skill level or ability of a person or thing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a high chess <w>rating</w> after winning several international tournaments this year.",
                            "target_lang_translations": {
                                "ru": "У него высокий шахматный <w>рейтинг</w> после победы в нескольких международных турнирах в этом году."
                            }
                        },
                        {
                            "text": "The player worked hard to improve his chess <w>rating</w> before the national championship.",
                            "target_lang_translations": {
                                "ru": "Игрок усердно работал над повышением своего шахматного <w>рейтинга</w> перед национальным чемпионатом."
                            }
                        }
                    ],
                    "synonyms": [
                        "score",
                        "rank",
                        "grade"
                    ],
                    "common_phrases": [
                        "chess rating",
                        "skill rating",
                        "performance rating"
                    ],
                    "target_lang_definitions": {
                        "ru": "Число, буква или отметка, указывающая на уровень мастерства или способностей человека или предмета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рейтинг",
                                "target_lang_sense_clarification": "спортивный или квалификационный показатель"
                            },
                            {
                                "target_lang_word": "разряд",
                                "target_lang_sense_clarification": "уровень квалификации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fafcf08-1d70-3d1d-8c72-0bbe25c8b7da",
                    "sense_definition": "A specific position or level on a scale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel received a five-star <w>rating</w> for its exceptional service and facilities.",
                            "target_lang_translations": {
                                "ru": "Отель получил пятизвездочный <w>рейтинг</w> за исключительный сервис и удобства."
                            }
                        },
                        {
                            "text": "The safety <w>rating</w> of the vehicle was the highest in its class.",
                            "target_lang_translations": {
                                "ru": "<w>Рейтинг</w> безопасности автомобиля был самым высоким в своем классе."
                            }
                        }
                    ],
                    "synonyms": [
                        "rank",
                        "standing",
                        "status"
                    ],
                    "common_phrases": [
                        "star rating",
                        "safety rating",
                        "efficiency rating"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная позиция или уровень на шкале."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рейтинг",
                                "target_lang_sense_clarification": "место в списке или классификации"
                            },
                            {
                                "target_lang_word": "категория",
                                "target_lang_sense_clarification": "уровень качества или безопасности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94ca7e70-d7e5-311e-9c48-f635699a7c1a",
                    "sense_definition": "A non-commissioned sailor in the navy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "military_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship's crew consisted of fifty officers and over seven hundred <w>ratings</w> from the Royal Navy.",
                            "target_lang_translations": {
                                "ru": "Экипаж корабля состоял из пятидесяти офицеров и более семисот <w>матросов</w> Королевского флота."
                            }
                        },
                        {
                            "text": "In the Royal Navy the <w>ratings</w> include ordinary seaman and petty officer.",
                            "target_lang_translations": {
                                "ru": "В Королевском флоте к <w>рядовому составу</w> относятся матросы и унтер-офицеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "seaman",
                        "sailor"
                    ],
                    "antonyms": [
                        "officer"
                    ],
                    "common_phrases": [
                        "naval rating",
                        "enlisted rating"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Матрос рядового состава в военно-морском флоте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матрос",
                                "target_lang_sense_clarification": "рядовой военно-морского флота"
                            },
                            {
                                "target_lang_word": "рядовой",
                                "target_lang_sense_clarification": "военнослужащий не офицерского состава"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a09150d-c659-3266-ba4b-cd432e4b9bfc",
                    "sense_definition": "The present participle and gerund of <w>rate</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critics are currently <w>rating</w> the new films released this weekend.",
                            "target_lang_translations": {
                                "ru": "Критики в настоящее время <w>оценивают</w> новые фильмы, вышедшие в эти выходные."
                            }
                        },
                        {
                            "text": "By <w>rating</w> the products online, customers help others make informed purchasing decisions.",
                            "target_lang_translations": {
                                "ru": "<w>Оценивая</w> товары онлайн, покупатели помогают другим принимать обоснованные решения о покупке."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «оценивать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценивание",
                                "target_lang_sense_clarification": "процесс выставления оценки"
                            },
                            {
                                "target_lang_word": "оценивающий",
                                "target_lang_sense_clarification": "причастие, совершающий оценку"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}