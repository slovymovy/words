                ],
                "senses": [
                    {
                        "sense_id": "ea575674-f30f-3493-9e08-5efda6a099f9",
                        "entry_id": "e8879c8d-23f7-3ded-a23e-1a02b6d894f9",
                        "glosses": [
                            "Variante de désalkyler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b641899-e994-497b-a506-fd9e567ebd85",
                                "sense_id": "ea575674-f30f-3493-9e08-5efda6a099f9",
                                "text": "S’il s’agit de dérivés ammonium quaternaires, il existe deux méthodes assez générales pour désalcoyler une fois."
                            },
                            {
                                "example_id": "b79daf78-4cc5-4630-8335-1a3fc50990f5",
                                "sense_id": "ea575674-f30f-3493-9e08-5efda6a099f9",
                                "text": "Le diéthylbenzène a été désalcoylé sous p, sur un catalyseur alumine-silice, pour donner du monoéthylbenzène."
                            },
                            {
                                "example_id": "1b8d70d3-ce07-432a-afef-d13016f57af4",
                                "sense_id": "ea575674-f30f-3493-9e08-5efda6a099f9",
                                "text": "De plus, le catalyseur fait preuve d'une aptitude extraordinaire à transalcoyler et désalcoyler préférentiellement 1'éthylbenzène plutôt que les xylenes."
                            }
                        ]
                    }
