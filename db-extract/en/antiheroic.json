                        "sense_id": "10a87965-80c3-367b-bd1a-3b387fd0f0e2",
                        "entry_id": "bf674446-fd1a-30c7-88aa-a108889d678c",
                        "glosses": [
                            "Of, pertaining to or typical of an antihero."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4de785d0-1cd7-4466-9de1-1272a14caf2f",
                                "sense_id": "10a87965-80c3-367b-bd1a-3b387fd0f0e2",
                                "text": "“Monsieur Verdoux” may once again be timely, but the audacity of its statement derives less from Chaplin’s antiwar polemic than from his antiheroic pose."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7341d55a-6d93-41cc-a01b-9cac000bd074",
                        "source_entry_id": "bf674446-fd1a-30c7-88aa-a108889d678c",
                        "source_sense_id": "10a87965-80c3-367b-bd1a-3b387fd0f0e2",
                        "source_sense_description": "pertaining to or typical of an antihero",
                        "target_lang_word": "antihéroïque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antihéroïque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5afdc410-dbbb-38af-b0b9-7c75ea1a7929",
                                        "entry_id": "a19c1b9f-1dc4-3052-bc61-6127de6c17cc",
                                        "glosses": [
                                            "Non héroïque, relatif au antihéros, à l’antihéroïsme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a3dd7a0-2f48-4571-a4b1-c9e3570a68e4",
                                                "sense_id": "5afdc410-dbbb-38af-b0b9-7c75ea1a7929",
                                                "text": "Avec le pessimisme d’un homme profondément marqué par la guerre, mais non sans un certain humour, Voyage au bout de la nuit présente une vision chaotique et antihéroïque, à la fois burlesque et tragique, de la condition humaine."
                                            },
                                            {
                                                "example_id": "514a9969-4b8c-4c44-b4d2-c2bbec84da27",
                                                "sense_id": "5afdc410-dbbb-38af-b0b9-7c75ea1a7929",
                                                "text": "Par quelle voie, par quel chemin peut-on être héroïque dans une société antihéroïque, dans une société prosaïque ?"
                                            },
                                            {
                                                "example_id": "615d09ae-d5b8-445d-8bf6-999708e08e2b",
                                                "sense_id": "5afdc410-dbbb-38af-b0b9-7c75ea1a7929",
                                                "text": "La démocratie recèle cependant une étonnante capacité à contenir comme à trivialiser la révolte. À la contenir, tant le pouvoir niveleur de l’égalité est, au fond, antihéroïque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
