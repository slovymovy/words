                        "glosses": [
                            "deutsche Bezeichnung für Funktionsverbgefüge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d11d812-2056-40c2-b43e-4221e1e23249",
                                "sense_id": "2fc87698-1bcb-3c67-9560-5247a4a143b8",
                                "text": "„In Erfahrung bringen“, „zur Niederschrift erklären“, „in Frage stellen“, „in Marsch setzen“ sind Beispiele für Schwellformen."
                            },
                            {
                                "example_id": "ef36f524-520a-4d0e-a06a-74e7f2aeb9da",
                                "sense_id": "2fc87698-1bcb-3c67-9560-5247a4a143b8",
                                "text": "„Unter diese Kategorie von Verstößen gegen die Prägnanz fällt auch die Verwendung von Funktionsverbgefügen (Schwellformen, Streckformen, das heißt Verbindungen aus einem von einem Verb abgeleiteten Substantiv und einem bedeutungsschwachen Verb), wenn diese im Vergleich zu einem einfachen Verb keine zusätzliche Bedeutungsnuance … zum Ausdruck bringen sollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
