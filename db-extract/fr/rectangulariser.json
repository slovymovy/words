                "senses": [
                    {
                        "sense_id": "fd33613b-e7d0-3602-a094-8b29835f1633",
                        "entry_id": "c4573615-751d-317d-bacd-6cbf6a1233f4",
                        "glosses": [
                            "Donner un caractère rappelant les rectangles, les angles droits, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff053d03-553b-4e2a-bcb2-ff5d2cb6a6e3",
                                "sense_id": "fd33613b-e7d0-3602-a094-8b29835f1633",
                                "text": "N'hésitez pas à \"rectangulariser\" vos parts en coupant les bords arrondis."
                            },
                            {
                                "example_id": "f1633fd7-46d3-4fc1-bae9-97219756cbef",
                                "sense_id": "fd33613b-e7d0-3602-a094-8b29835f1633",
                                "text": "Sur un plan général, pour les deux figures, on constate qu’anciens et débutants tendent à rectangulariser les angles."
                            },
                            {
                                "example_id": "70c704b5-a72f-472b-87db-a4f510d96c68",
                                "sense_id": "fd33613b-e7d0-3602-a094-8b29835f1633",
                                "text": "La pyramide actuelle porte les traces des deux grandes guerres du siècle, mais sa forme tend à se rectangulariser, sous l’effet des progrès médicaux qui repoussent un peu plus chaque année la durée moyenne de vie."
                            }
                        ]
                    }
