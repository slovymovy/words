                                        "glosses": [
                                            "Having a fever, an elevated body temperature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "112ed62e-ebc7-4502-8b88-b83482ad5455",
                                                "sense_id": "cc08cb37-7bfa-34e7-98f6-8229583e4493",
                                                "text": "The illness made him feverish, so they applied cold compresses."
                                            },
                                            {
                                                "example_id": "d466e356-f1bf-4858-970f-ba52e9e6711f",
                                                "sense_id": "cc08cb37-7bfa-34e7-98f6-8229583e4493",
                                                "text": "People who feel warm or provide a history of feeling feverish may also be determined to have a fever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e749f4bb-ce58-3b56-8f9d-8d46ab0f2af4",
                                        "entry_id": "f9b472f5-39e7-3485-84fd-cb442b8be56d",
                                        "glosses": [
                                            "Filled with excess energy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dcff526-7b07-4eaf-880b-337605c17521",
                                                "sense_id": "e749f4bb-ce58-3b56-8f9d-8d46ab0f2af4",
                                                "text": "He worked with feverish excitement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "812796e3-58fc-3448-9188-884b9fcd40c9",
                                        "entry_id": "f9b472f5-39e7-3485-84fd-cb442b8be56d",
                                        "glosses": [
                                            "Morbidly eager."
                                        ],
