                ],
                "senses": [
                    {
                        "sense_id": "3d55bbb8-15cc-39f2-8900-f7c8a4daa00d",
                        "entry_id": "2466a501-61ed-3047-8096-29c56eace9b6",
                        "glosses": [
                            "Kriegs- und Sonnengott und Schutzpatron der Stadt Tenochtitlán in der aztekischen Mythologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e805d067-bd1a-46c3-a9a4-34e75950fe67",
                                "sense_id": "3d55bbb8-15cc-39f2-8900-f7c8a4daa00d",
                                "text": "„Der enttäuschte Huitzilihuitl zog allein los und betete zu Huitzilopochtli (›Linksfüßig wie ein Kolibri‹), dem Gott seines Volkes.“"
                            },
                            {
                                "example_id": "52b89c1e-c914-4bac-8366-5632f4fb4382",
                                "sense_id": "3d55bbb8-15cc-39f2-8900-f7c8a4daa00d",
                                "text": "„Dem Mythos zufolge sahen sie dort einen Adler, der auf einem Feigenkaktus sitzend mit einer Schlange kämpfte, wie es ihnen ihr Stammesgott Huitzilopochtli prophezeit hatte.“"
                            },
                            {
                                "example_id": "0a90841b-85fd-4db5-bea2-2fdf45c921d4",
                                "sense_id": "3d55bbb8-15cc-39f2-8900-f7c8a4daa00d",
                                "text": "„Raue, aber eindrückliche vielsilbige Laute hatten seine übliche Mischung aus schlechtem Spanisch und noch schlechterem Englisch ersetzt, und mir schien allein der häufig wiederholte Aufschrei «Huitzilopochtli» irgendwie vertraut.“"
                            },
                            {
                                "example_id": "8b288e5a-2e3f-4df0-9419-566ea1224751",
                                "sense_id": "3d55bbb8-15cc-39f2-8900-f7c8a4daa00d",
                                "text": "„Würden wir die anmutigen Gestalten des griechischen Pantheons mit Blut auf den Gewändern sehen, wir würden von Grausen erfüllt zurückweichen, aber den schrecklichen Mithras oder den Herzfresser Huitzilopochtli würden wir als wenig überzeugend ansehen, erschienen sie uns in unseren Träumen ohne Flecken des roten Opfersafts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
