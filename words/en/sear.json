{
    "word_family": [
        "searing",
        "seared"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "942281fb-19ad-32de-b216-1439701beadc",
                    "sense_definition": "To burn or scorch the surface of something, especially food, quickly with intense heat.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking-and-burning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He likes to <w>sear</w> his steaks quickly so that the center stays rare.",
                            "target_lang_translations": {
                                "ru": "Он любит быстро <w>обжаривать</w> стейки, чтобы внутри они оставались с кровью.",
                                "cs": "Má rád, když se steaky <w>prudce opečou</w>, aby uvnitř zůstaly krvavé."
                            }
                        },
                        {
                            "text": "When you <w>sear</w> the meat in a hot pan, it develops a rich flavor.",
                            "target_lang_translations": {
                                "ru": "Когда вы <w>прижигаете</w> мясо на горячей сковороде, оно приобретает насыщенный вкус.",
                                "cs": "Když maso na rozpálené pánvi <w>zatáhnete</w>, získá bohatou chuť."
                            }
                        }
                    ],
                    "synonyms": [
                        "scorch",
                        "char",
                        "brown",
                        "singe",
                        "burn"
                    ],
                    "common_phrases": [
                        "sear the meat",
                        "sear the skin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро обжаривать или прижигать поверхность чего-либо (особенно пищи) при высокой температуре.",
                        "cs": "Rychle opéct nebo připálit povrch něčeho (zejména jídla) při vysoké teplotě."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обжаривать",
                                "target_lang_sense_clarification": "кулинария"
                            },
                            {
                                "target_lang_word": "прижигать",
                                "target_lang_sense_clarification": "поверхность"
                            },
                            {
                                "target_lang_word": "подрумянивать",
                                "target_lang_sense_clarification": "до корочки"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zatáhnout",
                                "target_lang_sense_clarification": "maso při prudkém opékání"
                            },
                            {
                                "target_lang_word": "prudce opéct",
                                "target_lang_sense_clarification": "kulinářská technika"
                            },
                            {
                                "target_lang_word": "sežehnout",
                                "target_lang_sense_clarification": "povrchové spálení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3ef6fe9-59cd-3ac2-b36d-d46a0d2efdc0",
                    "sense_definition": "To leave a permanent and deep impression on someone's mind or memory, often due to trauma or intensity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental-impression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tragic events of that day were <w>seared</w> into her memory forever.",
                            "target_lang_translations": {
                                "ru": "Трагические события того дня навсегда <w>запечатлелись</w> в её памяти.",
                                "cs": "Tragické události toho dne se jí navždy <w>vypálily</w> do paměti."
                            }
                        },
                        {
                            "text": "The image of the accident will <w>sear</w> itself into his mind.",
                            "target_lang_translations": {
                                "ru": "Картина аварии <w>врежется</w> ему в память.",
                                "cs": "Obraz té nehody se mu <w>vryje</w> do paměti."
                            }
                        }
                    ],
                    "synonyms": [
                        "brand",
                        "etch",
                        "engrave"
                    ],
                    "common_phrases": [
                        "seared into memory",
                        "sear the soul"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставлять глубокий и неизгладимый след в чьем-либо сознании или памяти, часто из-за травмы.",
                        "cs": "Zanechat hluboký a trvalý dojem v něčí mysli nebo paměti, často v důsledku traumatu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запечатлеться",
                                "target_lang_sense_clarification": "в памяти"
                            },
                            {
                                "target_lang_word": "врезаться",
                                "target_lang_sense_clarification": "в память"
                            },
                            {
                                "target_lang_word": "выжигать",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vypálit se",
                                "target_lang_sense_clarification": "do paměti"
                            },
                            {
                                "target_lang_word": "vkrýt se",
                                "target_lang_sense_clarification": "hluboko do paměti"
                            },
                            {
                                "target_lang_word": "zapsat se",
                                "target_lang_sense_clarification": "nesmazatelně do paměti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a57b1c6b-b44d-3c6f-ba92-7710b93f1f6a",
                    "sense_definition": "To cause vegetation to become dry, withered, or brown, typically due to heat or drought.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "withering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense summer sun began to <w>sear</w> the grass in the fields.",
                            "target_lang_translations": {
                                "ru": "Сильное летнее солнце начало <w>иссушать</w> траву в полях.",
                                "cs": "Intenzivní letní slunce začalo <w>vypalovat</w> trávu na polích."
                            }
                        },
                        {
                            "text": "A terrible drought can <w>sear</w> the crops and ruin the entire harvest.",
                            "target_lang_translations": {
                                "ru": "Ужасная засуха может <w>выжечь</w> посевы и погубить весь урожай.",
                                "cs": "Strašné sucho může <w>spálit</w> úrodu a zničit celou sklizeň."
                            }
                        }
                    ],
                    "synonyms": [
                        "wither",
                        "parch",
                        "shrivel"
                    ],
                    "antonyms": [
                        "moisten",
                        "hydrate"
                    ],
                    "common_phrases": [
                        "sear the crops",
                        "sear the grass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать высыхание или увядание растительности из-за жары или засухи.",
                        "cs": "Způsobit vyschnutí nebo uvadnutí vegetace v důsledku horka nebo sucha."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иссушать",
                                "target_lang_sense_clarification": "о солнце или жаре"
                            },
                            {
                                "target_lang_word": "палить",
                                "target_lang_sense_clarification": "о зное"
                            },
                            {
                                "target_lang_word": "выжигать",
                                "target_lang_sense_clarification": "растительность"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vypálit",
                                "target_lang_sense_clarification": "o slunci a suchu"
                            },
                            {
                                "target_lang_word": "spálit",
                                "target_lang_sense_clarification": "o vegetaci horkem"
                            },
                            {
                                "target_lang_word": "vysušit",
                                "target_lang_sense_clarification": "intenzivním žárem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e04c8a29-a20e-3578-a72e-326935e89f9b",
                    "sense_definition": "To make someone's conscience or feelings insensitive or callous.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mental-impression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Years of cruelty had served to <w>sear</w> his conscience against the suffering of others.",
                            "target_lang_translations": {
                                "ru": "Годы жестокости <w>ожесточили</w> его совесть по отношению к страданиям других.",
                                "cs": "Léta krutosti <w>otupila</w> jeho svědomí vůči utrpení druhých."
                            }
                        },
                        {
                            "text": "Constant exposure to violence can <w>sear</w> the emotions of young witnesses.",
                            "target_lang_translations": {
                                "ru": "Постоянное созерцание насилия может <w>очерствить</w> чувства юных свидетелей.",
                                "cs": "Neustálé vystavení násilí může <w>zatvrdit</w> city mladých svědků."
                            }
                        }
                    ],
                    "synonyms": [
                        "harden",
                        "desensitize",
                        "deaden"
                    ],
                    "antonyms": [
                        "sensitize"
                    ],
                    "common_phrases": [
                        "sear the conscience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать чью-либо совесть или чувства нечувствительными или черствыми.",
                        "cs": "Učinit něčí svědomí nebo city necitlivými či zatvrzelými."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ожесточать",
                                "target_lang_sense_clarification": "сердце или совесть"
                            },
                            {
                                "target_lang_word": "закалять",
                                "target_lang_sense_clarification": "в негативном смысле"
                            },
                            {
                                "target_lang_word": "очерствлять",
                                "target_lang_sense_clarification": "чувства"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "otupit",
                                "target_lang_sense_clarification": "city nebo svědomí"
                            },
                            {
                                "target_lang_word": "zatvrdit",
                                "target_lang_sense_clarification": "srdce nebo svědomí"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ec8927c-9a89-31cf-a539-f59b0db8985f",
                    "sense_definition": "A part of the trigger mechanism in a firearm that holds the hammer or striker back until the trigger is pulled.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "firearm-parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gunsmith carefully polished the <w>sear</w> to ensure a smoother trigger pull.",
                            "target_lang_translations": {
                                "ru": "Оружейник тщательно отполировал <w>шептало</w>, чтобы обеспечить более плавный спуск.",
                                "cs": "Puškař pečlivě vyleštil <w>ozub</w>, aby zajistil hladší chod spouště."
                            }
                        },
                        {
                            "text": "If the <w>sear</w> is worn down, the weapon might become unsafe to handle.",
                            "target_lang_translations": {
                                "ru": "Если <w>шептало</w> изношено, оружие может стать небезопасным в обращении.",
                                "cs": "Pokud je <w>ozub</w> opotřebovaný, manipulace se zbraní může být nebezpečná."
                            }
                        }
                    ],
                    "common_phrases": [
                        "trigger sear",
                        "sear engagement"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in firearms"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деталь спускового механизма огнестрельного оружия, удерживающая курок до нажатия на спуск.",
                        "cs": "Součást spoušťového mechanismu střelných zbraní, která drží úderník nebo kohout v napnuté poloze."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шептало",
                                "target_lang_sense_clarification": "деталь оружия"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "ozub",
                                "target_lang_sense_clarification": "součást spouště"
                            },
                            {
                                "target_lang_word": "záchyt",
                                "target_lang_sense_clarification": "spoušťového mechanismu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97a48acd-e223-303a-8eaa-5e2f03af67cb",
                    "sense_definition": "A mark or scar left on the skin or a surface after being burned or cauterized.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cooking-and-burning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>sear</w> on his arm was a reminder of the kitchen accident.",
                            "target_lang_translations": {
                                "ru": "Старый <w>ожог</w> на его руке был напоминанием о несчастном случае на кухне.",
                                "cs": "Stará <w>spálenina</w> na jeho paži byla připomínkou nehody v kuchyni."
                            }
                        },
                        {
                            "text": "The hot iron left a permanent <w>sear</w> on the wooden table.",
                            "target_lang_translations": {
                                "ru": "Горячий утюг оставил неизгладимый <w>след</w> на деревянном столе.",
                                "cs": "Horká žehlička zanechala na dřevěném stole trvalý <w>ožeh</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "scar",
                        "mark",
                        "burn"
                    ],
                    "target_lang_definitions": {
                        "ru": "След или шрам, оставшийся на коже или поверхности после ожога или прижигания.",
                        "cs": "Značka nebo jizva na kůži či povrchu vzniklá po popálení nebo vypálení."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ожог",
                                "target_lang_sense_clarification": "след от огня"
                            },
                            {
                                "target_lang_word": "шрам",
                                "target_lang_sense_clarification": "от ожога"
                            },
                            {
                                "target_lang_word": "отметина",
                                "target_lang_sense_clarification": "от прижигания"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "spálenina",
                                "target_lang_sense_clarification": "jizva po popálení"
                            },
                            {
                                "target_lang_word": "ožeh",
                                "target_lang_sense_clarification": "stopa po ohni"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "46a9061f-3861-3c24-826d-56341c5fad13",
                    "sense_definition": "Dry and withered, particularly in reference to leaves or vegetation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "withering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The autumn winds blew the <w>sear</w> leaves across the abandoned garden.",
                            "target_lang_translations": {
                                "ru": "Осенние ветры гнали <w>пожухлые</w> листья по заброшенному саду.",
                                "cs": "Podzimní větry hnaly <w>požloutlé</w> listí přes opuštěnou zahradu."
                            }
                        },
                        {
                            "text": "He looked out at the <w>sear</w> landscape after months without rain.",
                            "target_lang_translations": {
                                "ru": "Он смотрел на <w>иссохший</w> пейзаж после нескольких месяцев без дождя.",
                                "cs": "Díval se na <w>vyprahlou</w> krajinu po měsících bez deště."
                            }
                        }
                    ],
                    "synonyms": [
                        "withered",
                        "dried",
                        "parched"
                    ],
                    "antonyms": [
                        "lush",
                        "green",
                        "verdant"
                    ],
                    "common_phrases": [
                        "sear leaves"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in poetic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сухой и увядший, особенно в отношении листьев или растительности (поэтическое).",
                        "cs": "Suchý a zvadlý, zejména ve vztahu k listům nebo vegetaci (poeticky)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пожухлый",
                                "target_lang_sense_clarification": "о листьях"
                            },
                            {
                                "target_lang_word": "иссохший",
                                "target_lang_sense_clarification": "от жары"
                            },
                            {
                                "target_lang_word": "увядший",
                                "target_lang_sense_clarification": "сухой"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "požloutlý",
                                "target_lang_sense_clarification": "o listech"
                            },
                            {
                                "target_lang_word": "vyprahlý",
                                "target_lang_sense_clarification": "o krajině"
                            },
                            {
                                "target_lang_word": "zvadlý",
                                "target_lang_sense_clarification": "suchý"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "114b5e8e-40d8-319e-9771-015c0e576cfc",
                    "sense_definition": "An English surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the <w>Sear</w> family who donated the land.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь семьи <w>Сир</w>, которая пожертвовала землю.",
                                "cs": "Místní knihovna byla pojmenována po rodině <w>Searových</w>, kteří darovali pozemek."
                            }
                        },
                        {
                            "text": "Mr. <w>Sear</w> has lived in this neighborhood for over forty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Сир</w> живет в этом районе уже более сорока лет.",
                                "cs": "Pan <w>Sear</w> žije v této čtvrti přes čtyřicet let."
                            }
                        }
                    ],
