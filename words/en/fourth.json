    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c0a05d49-1343-3d9d-847f-70436ef357f0",
                    "sense_definition": "The ordinal form of the number <w>four</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ordinal numbers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is the <w>fourth</w> time I have tried to call you today.",
                            "target_lang_translations": {
                                "ru": "Это уже <w>четвёртый</w> раз, когда я пытаюсь дозвониться тебе сегодня."
                            }
                        },
                        {
                            "text": "She finished in <w>fourth</w> place during the final race.",
                            "target_lang_translations": {
                                "ru": "Она заняла <w>четвёртое</w> место в финальном забеге."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fourth place",
                        "fourth floor",
                        "fourth time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порядковая форма числа четыре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "четвёртый",
                                "target_lang_sense_clarification": "порядковое числительное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b09bbd90-290c-3f13-8e06-4cc680e4aea9",
                    "sense_definition": "One of four equal parts of a whole.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fractions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ate a <w>fourth</w> of the pizza by himself.",
                            "target_lang_translations": {
                                "ru": "Он один съел <w>четверть</w> пиццы."
                            }
                        },
                        {
                            "text": "Please cut the apple into <w>fourths</w> so we can share it.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, разрежь яблоко на <w>четыре части</w>, чтобы мы могли им поделиться."
                            }
                        }
                    ],
                    "synonyms": [
                        "fourth part",
                        "quarter"
                    ],
                    "common_phrases": [
                        "cut into fourths",
                        "one fourth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из четырех равных частей целого."
                    },
                    "translations": {
