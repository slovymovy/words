                            {
                                "example_id": "997ab26b-a49f-4c1c-b92b-3c39039a033f",
                                "sense_id": "f4e22228-33f0-35c1-ad53-60e0d54b133f",
                                "text": "„Wenige Meter nach der Ortstafel «Sonnental» leuchtet dagegen von einem Laternenmast ein fünfzackiger Stern mit Schweif.“"
                            },
                            {
                                "example_id": "e61c6584-4ac2-4a31-89c4-9fe19d12d5ac",
                                "sense_id": "f4e22228-33f0-35c1-ad53-60e0d54b133f",
                                "text": "„Oder warum sonst sei sowohl der amerikanische als auch der russische Stern fünfzackig?“"
                            }
                        ],
