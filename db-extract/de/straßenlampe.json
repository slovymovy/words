                                        "sense_id": "3ed5e49c-0b25-366a-bcc0-1f00ce9f97d8",
                                        "entry_id": "b7211957-7c60-308d-bbb7-4e790e4252b7",
                                        "glosses": [
                                            "Synonym of streetlight (“any large outdoor light used to illuminate a public area”)."
                                        ],
                                        "tags": [],
