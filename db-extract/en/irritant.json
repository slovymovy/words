                    {
                        "translation_id": "48df43f2-be7c-4570-8123-4bbd10ca9f22",
                        "source_entry_id": "f87a4cb7-0802-3507-a676-ebded0529ae0",
                        "source_sense_description": "a source of irritation",
                        "target_lang_word": "Ärgernis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ärgernis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f1db894-e4e5-33f6-a791-ff478a705365",
                                        "entry_id": "3b8eccfc-4f9d-3ecd-abd0-d17c40a12511",
                                        "glosses": [
                                            "Vorkommnis, das ein negatives Gefühl wie einen kleinen Ärger, eine Verstimmung oder Irritation auslöst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "440444e4-ba8b-46de-9746-bc53c18ed70e",
                                                "sense_id": "1f1db894-e4e5-33f6-a791-ff478a705365",
                                                "text": "Das leichte Zittern seiner rechten Hand, das bisher nur ein Ärgernis war, würde sich verstärken."
                                            },
                                            {
                                                "example_id": "2fb787d3-0d70-4746-982b-f3c47744fdd0",
                                                "sense_id": "1f1db894-e4e5-33f6-a791-ff478a705365",
                                                "text": "Ein Autounfall hier ist ein Ärgernis, zwei Missernten dort haben existentielle Konsequenzen."
                                            },
                                            {
                                                "example_id": "808e0640-d863-4d7c-8301-5564a02f7e33",
                                                "sense_id": "1f1db894-e4e5-33f6-a791-ff478a705365",
                                                "text": "„Die Kartons wurden zu einem Ärgernis.“"
                                            },
                                            {
                                                "example_id": "82bbe722-6f6b-4948-8b45-6f3603936ba0",
                                                "sense_id": "1f1db894-e4e5-33f6-a791-ff478a705365",
                                                "text": "„Sollen doch endlich die sich ärgern, die uns ständig Ärgernis brachten: krumme Geschäfte, gemeine Befehle, Abgaben, Drangsale aller Art, Verrat, Spitzelei.“"
                                            },
                                            {
                                                "example_id": "9bed85b0-7d01-42c6-8951-b2554455c1bf",
                                                "sense_id": "1f1db894-e4e5-33f6-a791-ff478a705365",
                                                "text": "„Amazon war schon lange ein Ärgernis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f8a10003-e6d1-3a79-bcd3-ebf9073ac537",
                                        "entry_id": "3b8eccfc-4f9d-3ecd-abd0-d17c40a12511",
                                        "glosses": [
                                            "negatives Gefühl der Erregung, das dem Ärger gleicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "472dc685-4d3d-4b9f-8ef1-d4c24035cf0a",
                                                "sense_id": "f8a10003-e6d1-3a79-bcd3-ebf9073ac537",
                                                "text": "Ein gewisses Ärgernis wollte sich regen. (Goethe)"
                                            },
                                            {
                                                "example_id": "5b96ea40-db3f-48df-bd45-27ad2796d556",
                                                "sense_id": "f8a10003-e6d1-3a79-bcd3-ebf9073ac537",
                                                "text": "Das ist mir ein Ärgernis."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a554e32f-71e4-486a-b33d-110a1811805c",
                        "source_entry_id": "f87a4cb7-0802-3507-a676-ebded0529ae0",
                        "source_sense_description": "a source of irritation",
                        "target_lang_word": "Reiz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reiz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "141f5f02-471d-3085-b579-1fbd40c0463a",
                                        "entry_id": "a9b74006-c8a5-32c5-a1ef-f8abc3c0892e",
                                        "glosses": [
                                            "äußere oder innere Einwirkung auf einen Organismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34cbdd88-72af-4471-b548-8c471798f59e",
                                                "sense_id": "141f5f02-471d-3085-b579-1fbd40c0463a",
                                                "text": "Ein elektrischer Reiz bewegt auch einen toten Muskel."
                                            },
                                            {
                                                "example_id": "ce717c93-5890-4f2e-8b1c-938a0b5b0d08",
                                                "sense_id": "141f5f02-471d-3085-b579-1fbd40c0463a",
                                                "text": "„Eigentlich hätte sie mal wieder einen Strandurlaub nötig, die weiße Haut war fast durchsichtig und so empfindlich, dass sie schon beim geringsten Reiz rot wurde oder einen Ausschlag bekam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dcefe1da-45b1-3ad9-9f44-fa944feea405",
                                        "entry_id": "a9b74006-c8a5-32c5-a1ef-f8abc3c0892e",
                                        "glosses": [
                                            "verlockende Wirkung, die von einer Sache oder Person ausgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dcb5332-e16b-4d00-8c24-64017de0fda9",
                                                "sense_id": "dcefe1da-45b1-3ad9-9f44-fa944feea405",
                                                "text": "Die Dame konnte mit ihren Reizen alle Blicke auf sich ziehen."
                                            },
                                            {
                                                "example_id": "4661c871-542f-4457-8334-7a0292ebfb6c",
                                                "sense_id": "dcefe1da-45b1-3ad9-9f44-fa944feea405",
                                                "text": "Es hätte schon seinen Reiz jetzt eine Woche Urlaub zu machen."
                                            },
                                            {
                                                "example_id": "f2f42995-879d-488a-924e-9dbb72660a37",
                                                "sense_id": "dcefe1da-45b1-3ad9-9f44-fa944feea405",
                                                "text": "Der Reiz des Neuen verfliegt schnell."
                                            },
                                            {
                                                "example_id": "335751bf-b48c-465f-b3da-4b5c23f09dff",
                                                "sense_id": "dcefe1da-45b1-3ad9-9f44-fa944feea405",
                                                "text": "„Sie nahm Musikunterricht, um später zur Bühne zu gehen, saß immerzu am Fenster und hatte den Greis mit ihren Reizen völlig berauscht; aber sie zeigte sich grausam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d1dabce-c432-4342-81f2-65f096d2d124",
                        "source_entry_id": "f87a4cb7-0802-3507-a676-ebded0529ae0",
                        "source_sense_description": "a source of irritation",
                        "target_lang_word": "Nervensäge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nervensäge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e45b2699-2d99-34e1-af51-59968c741a7a",
                                        "entry_id": "fffcfdcc-0075-3ec2-a3ab-2cf6b81b85c3",
                                        "glosses": [
                                            "Person, die man nur schwer ertragen kann, weil sie einem „auf die Nerven geht“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c10fcd0-d2e8-41fd-a9ac-f63851fe4202",
                                                "sense_id": "e45b2699-2d99-34e1-af51-59968c741a7a",
                                                "text": "Du bist heute wieder eine richtige Nervensäge."
                                            },
                                            {
                                                "example_id": "4897ecae-16f0-46f6-9b2c-f4bd7ed34ed8",
                                                "sense_id": "e45b2699-2d99-34e1-af51-59968c741a7a",
                                                "text": "„Hoffentlich kommt die blöde Nervensäge nicht auf die Idee, mir von hinten eine Kugel in den Kopf zu jagen, dachte Wilson.“"
                                            },
                                            {
                                                "example_id": "47b43966-6d21-4d7d-a5ed-fc1710297dac",
                                                "sense_id": "e45b2699-2d99-34e1-af51-59968c741a7a",
                                                "text": "„Die Nummern der schlimmsten Nervensägen habe ich eingespeichert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
