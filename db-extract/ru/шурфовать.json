                                            {
                                                "example_id": "b61b2f9d-75e1-429c-b5fb-ca6778a2b298",
                                                "sense_id": "d5b59aed-1654-3aa8-8735-5fdb923da6c1",
                                                "text": "Viele Privatleute schürften während des Goldrausches nach wertvollem Gold."
                                            },
                                            {
                                                "example_id": "9ac62ebb-6fcc-4a0e-a5bd-4a14c6c87743",
                                                "sense_id": "d5b59aed-1654-3aa8-8735-5fdb923da6c1",
                                                "text": "„Im Übrigen schürften einige Studenten selbst in den Minen, um ihre Schulden zu begleichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "03ec5dba-290e-3de6-ba83-b6fdc059d878",
