                "senses": [
                    {
                        "sense_id": "34109aa8-d14a-3fae-a941-eb1466ae2cff",
                        "entry_id": "fe04e3a5-8c1e-34b5-9d4e-17f0849f96a1",
                        "glosses": [
                            "Approuver quelque chose, sur Internet."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "c93cbb04-3b10-4efc-80d1-95b2f0bb16c8",
                                "sense_id": "34109aa8-d14a-3fae-a941-eb1466ae2cff",
                                "text": "Il sera possible pour tout utilisateur authentifié d’upvoter (+1) ou de downvoter (-1) un lien ou un commentaire."
                            },
                            {
                                "example_id": "412a7d86-005d-4d79-904a-2139be3bd9bc",
                                "sense_id": "34109aa8-d14a-3fae-a941-eb1466ae2cff",
                                "text": "Ce qui apparaît sur la page d’accueil est du contenu qui a été upvoté par les utilisateurs."
                            },
                            {
                                "example_id": "6cefef83-8821-42b6-85db-31ca9959854a",
                                "sense_id": "34109aa8-d14a-3fae-a941-eb1466ae2cff",
                                "text": "Une flèche vers le haut pour \"upvoter\", une flèche vers le bas pour \"downvoter\"."
                            }
                        ]
                    }
