                "senses": [
                    {
                        "sense_id": "4832a7be-4289-39fe-8594-ce7d34fa960b",
                        "entry_id": "7040279a-7b31-3afc-bdbd-23de233801d9",
                        "glosses": [
                            "falsches, unangebrachtes Verhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de3e0bf4-236c-4e9a-8248-44f056077bf4",
                                "sense_id": "4832a7be-4289-39fe-8594-ce7d34fa960b",
                                "text": "Ein solches Fehlverhalten ist unakzeptabel."
                            },
                            {
                                "example_id": "f0e0d1ab-1eab-4bf3-93b3-f6377e62da07",
                                "sense_id": "4832a7be-4289-39fe-8594-ce7d34fa960b",
                                "text": "„Das Oberlandesgericht Wien kam zu dem Schluss, dass dieses Fehlverhalten aufgrund der Begleitumstände die fristlose Entlassung des Arbeitnehmers nicht rechtfertigt.“"
                            },
                            {
                                "example_id": "26085098-5ae6-412d-80bc-5cd3a141f1dc",
                                "sense_id": "4832a7be-4289-39fe-8594-ce7d34fa960b",
                                "text": "„Die Briten versuchten sich einmal mehr aus ihrer historischen Verantwortung zu stehlen und leugneten ihr koloniales Fehlverhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59d37d11-d10f-431f-8be1-4dc78276d2b2",
                        "source_entry_id": "7040279a-7b31-3afc-bdbd-23de233801d9",
                        "source_sense_id": "4832a7be-4289-39fe-8594-ce7d34fa960b",
                        "source_sense_description": "falsches, unangebrachtes Verhalten",
                        "target_lang_word": "misdemeanour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misdemeanour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36d0c7f9-fa13-365a-84d6-8b20b0920c9d",
                                        "entry_id": "4de70048-8812-3d80-8cac-9e65dfc2dce5",
                                        "glosses": [
                                            "Alternative form of misdemeanor."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2623856-a423-4ec7-bad6-b59e2134680b",
                                                "sense_id": "36d0c7f9-fa13-365a-84d6-8b20b0920c9d",
                                                "text": "Therefore, welcome new Secretary of State for Transport Mark Harper, a man about whom even my esteemed political journalist friends know little - apart from the fact he was once Chief Whip, a job that requires knowing about every Tory MP's misdemeanours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7eaf8f5-ff62-4d7c-a85c-56d828e4419a",
                        "source_entry_id": "7040279a-7b31-3afc-bdbd-23de233801d9",
                        "source_sense_id": "4832a7be-4289-39fe-8594-ce7d34fa960b",
                        "source_sense_description": "falsches, unangebrachtes Verhalten",
                        "target_lang_word": "misconduct",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misconduct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "987eba80-325b-3a04-adb1-a15df495051b",
                                        "entry_id": "f5babb49-e6eb-3c92-9020-b795c1189757",
                                        "glosses": [
                                            "Behavior that is considered to be unacceptable."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c062054-a094-4975-81fd-55d7d805b1a9",
                                                "sense_id": "987eba80-325b-3a04-adb1-a15df495051b",
                                                "text": "The student was banned from using the university's computing resources for two weeks due to gross misconduct on the Internet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d423d0c-4d67-389a-b893-a781a2c2b644",
                                        "entry_id": "f5babb49-e6eb-3c92-9020-b795c1189757",
                                        "glosses": [
                                            "A penalty or write-up for improper behavior."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0ea2928-d282-4aa8-8e38-c1e41f9f78b4",
                                                "sense_id": "8d423d0c-4d67-389a-b893-a781a2c2b644",
                                                "text": "There is definitely an indication of retaliation in this case. I have never received a misconduct for possessing or using drugs."
                                            },
                                            {
                                                "example_id": "6efe14b8-d718-4692-9e5c-bd7919e8ad68",
                                                "sense_id": "8d423d0c-4d67-389a-b893-a781a2c2b644",
                                                "text": "After Jonathan Marchessault buried an empty-net goal with 90 seconds left in overtime, Hartman yelled from the bench and allegedly threw his stick in the officials’ direction. Hartman was assessed a misconduct for abusive language, according to the game sheet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "misconduct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41259c5e-fe83-3cdd-a187-ea4dfe612749",
                                        "entry_id": "0b4e803d-923b-3a0c-8b2c-9b61b8c4e56b",
                                        "glosses": [
                                            "To mismanage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e8475ac-c404-3dd0-9603-03c92fa5a704",
                                        "entry_id": "0b4e803d-923b-3a0c-8b2c-9b61b8c4e56b",
                                        "glosses": [
                                            "To behave inappropriately, to misbehave."
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8874a224-560e-4320-bb1e-339d785e1db3",
                                                "sense_id": "0e8475ac-c404-3dd0-9603-03c92fa5a704",
                                                "text": "It had been pointed out […] that in the past enemy aliens misconducting themselves had been returned to the internment camp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "852edb79-848f-3b75-9bfa-0b9204958bb1",
                                        "entry_id": "0b4e803d-923b-3a0c-8b2c-9b61b8c4e56b",
                                        "glosses": [
                                            "To act improperly."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb08d0e2-ade9-4156-8d0e-f69cbdb5ea88",
                                                "sense_id": "852edb79-848f-3b75-9bfa-0b9204958bb1",
                                                "text": "It seems no answer for the recipient to allege that he was incompetent and misconducted, but that the acts were committed outside the jurisdiction."
                                            },
                                            {
                                                "example_id": "cab34f7e-c050-40a1-b4e9-f468aa15938b",
                                                "sense_id": "852edb79-848f-3b75-9bfa-0b9204958bb1",
                                                "text": "The quartermasters have misconducted, and the government should bear the loss resulting from that misconduct."
                                            },
                                            {
                                                "example_id": "2f06e9fa-f534-4d47-b928-a751dcb52f5b",
                                                "sense_id": "852edb79-848f-3b75-9bfa-0b9204958bb1",
                                                "text": "Whether the jury misconducted in making the view of the premises, or whether the court erred in instructing them as to what effect they should give, in making up their verdict, to matters which came under their observation while making the view, does not appear from the record in this case."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
