                "senses": [
                    {
                        "sense_id": "b73e9f4e-390f-3d1d-aab7-d523ed7f1271",
                        "entry_id": "9883e65f-1b3a-35a4-8169-ff5d54347a01",
                        "glosses": [
                            "Schuss, bei dem das Projektil auf der Rückseite des Zielobjekts wieder austritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "671a40d2-a2a3-402d-be7a-64950b6d7ee5",
                                "sense_id": "b73e9f4e-390f-3d1d-aab7-d523ed7f1271",
                                "text": "Beim Angriff der Terroristen erlitt der Soldat einen Durchschuss."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "651ea786-65dd-326b-85ae-c0d3daa24c57",
                        "entry_id": "9883e65f-1b3a-35a4-8169-ff5d54347a01",
                        "glosses": [
                            "vertikaler Zwischenraum zwischen Zeilen im Textsatz"
                        ],
                        "tags": [
                            "Druckwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "417ad13d-51d2-4a7c-913f-2a4941dc8657",
                                "sense_id": "651ea786-65dd-326b-85ae-c0d3daa24c57",
                                "text": "„Häufig wird die Satzspiegelneuberechnung im Zusammenhang mit der Veränderung des Zeilenabstandes (Durchschuss) benötigt. Da der Satzspiegel unbedingt so berechnet werden sollte, dass eine ganze Anzahl an Zeilen in den Textbereich passt, muss bei Verwendung eines anderen Durchschusses als des normalen der Satzspiegel für diesen Zeilenabstand neu berechnet werden.“"
                            },
                            {
                                "example_id": "bb411afd-ac09-4c79-b8cf-df46410c4bef",
                                "sense_id": "651ea786-65dd-326b-85ae-c0d3daa24c57",
                                "text": "„Wenn sich der Durchschuss zwischen den Zeilen befindet, spricht man auch von durchschossenem Satz, ohne diesen Abstand heißt es kompresser Satz oder kompress gesetzter Text.“"
                            },
                            {
                                "example_id": "5def1845-f205-478f-a030-3183065f350e",
                                "sense_id": "651ea786-65dd-326b-85ae-c0d3daa24c57",
                                "text": "„Jedes Mal, wenn ich diese Kolumne schreibe, mache ich anstelle eines Absatzes einen Durchschuss.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52529265-98ed-4312-8f9b-0cab573ff61d",
                        "source_entry_id": "9883e65f-1b3a-35a4-8169-ff5d54347a01",
                        "source_sense_id": "651ea786-65dd-326b-85ae-c0d3daa24c57",
                        "source_sense_description": "Druckwesen: vertikaler Zwischenraum zwischen Zeilen im Textsatz",
                        "target_lang_word": "leading",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leading",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1ae8a10-b46d-30f8-b389-ce545b70d407",
                                        "entry_id": "56660649-c082-312e-b2d4-f2d1803b03cc",
                                        "glosses": [
                                            "present participle and gerund of lead"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecf06edc-a052-4ef6-8b4f-41222cff3f0b",
                                                "sense_id": "e1ae8a10-b46d-30f8-b389-ce545b70d407",
                                                "text": "I had occasion […] to make a somewhat long business trip to Chicago, and on my return […] I found Farrar awaiting me in the railway station. He smiled his wonted fraction by way of greeting, […], and finally leading me to his buggy, turned and drove out of town."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "leading",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c9f8fa5-f428-3aae-94f8-fa8edade8ec8",
                                        "entry_id": "397c4c4f-ef85-3385-bf84-7046a46d2784",
                                        "glosses": [
                                            "Providing guidance or direction."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d26cac14-02b1-4949-bb9d-787864811c44",
                                                "sense_id": "8c9f8fa5-f428-3aae-94f8-fa8edade8ec8",
                                                "text": "Avoid leading questions if you really want the truth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f6c81a8-1d00-3a27-8b37-bc56e9401c7a",
                                        "entry_id": "397c4c4f-ef85-3385-bf84-7046a46d2784",
                                        "glosses": [
                                            "Ranking first."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb8bdf27-66df-47e3-a5d3-42adf4fee6de",
                                                "sense_id": "5f6c81a8-1d00-3a27-8b37-bc56e9401c7a",
                                                "text": "He is a leading supplier of plumbing supplies in the county."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a0a8b1d-4814-3c3c-9c63-b1d478052f0f",
                                        "entry_id": "397c4c4f-ef85-3385-bf84-7046a46d2784",
                                        "glosses": [
                                            "Occurring in advance; preceding."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e544565-13ec-41fa-a75c-ff02ffe9abc8",
                                                "sense_id": "0a0a8b1d-4814-3c3c-9c63-b1d478052f0f",
                                                "text": "The stock market can be a leading economic indicator."
                                            },
                                            {
                                                "example_id": "b93053e1-448d-41de-ba0f-07638944e3d4",
                                                "sense_id": "0a0a8b1d-4814-3c3c-9c63-b1d478052f0f",
                                                "text": "Passengers on the earliest railway services would not even have enjoyed the luxury of a platform, instead having to step up onto the waiting open top wagons, where they would experience a journey that left many choking on the plumes of smoke exhaled by the leading locomotive."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "leading",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b99eb88e-42f2-3d8c-ba4a-1f6da3e5f39f",
                                        "entry_id": "b3c2eb7b-05a6-3350-9d50-d9d548fe6c1a",
                                        "glosses": [
                                            "An act by which one is led or guided."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8033b7ec-4516-43ed-a26f-e0b0f0af3018",
                                                "sense_id": "b99eb88e-42f2-3d8c-ba4a-1f6da3e5f39f",
                                                "text": "It has been said that we ought not to force our way, but to wait for the openings, and leadings of Providence; but it might with equal propriety be answered in this case, neither ought we to neglect embracing those openings in providence which daily present themselves to us."
                                            },
                                            {
                                                "example_id": "36462157-c144-40b9-9981-84227a98a193",
                                                "sense_id": "b99eb88e-42f2-3d8c-ba4a-1f6da3e5f39f",
                                                "text": "I do not affirm that what you see beyond is futile, I do not advise you to stop, / I do not say leadings you thought great are not great, / But I say that none lead to greater than these lead to."
                                            },
                                            {
                                                "example_id": "7039164d-a555-43c2-a84e-6a49473005d2",
                                                "sense_id": "b99eb88e-42f2-3d8c-ba4a-1f6da3e5f39f",
                                                "text": "In his poetic method each writer followed the leadings of his own genius, without reference to common rules and standards; the individualism of the Revolutionary epoch asserted itself to the full."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73ccfa84-6849-3614-b046-bb7488ef7f85",
                                        "entry_id": "b3c2eb7b-05a6-3350-9d50-d9d548fe6c1a",
                                        "glosses": [
                                            "Command of an army or military unit."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2b3f2b2-7abc-4cae-8c44-a2bf00a5690d",
                                                "sense_id": "73ccfa84-6849-3614-b046-bb7488ef7f85",
                                                "text": "Art thou but Captaine of a thouſand horſe,\nThat by Characters grauen in thy browes,\nAnd by thy martiall face and ſtout aſpect,\nDeſeru’ſt to haue the leading of an hoſte?"
                                            }
                                        ]
                                    }
                                ]
                            },
