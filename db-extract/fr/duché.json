                "translations": [
                    {
                        "translation_id": "23a8fc88-f3e6-43b3-91a4-eb8554714bb5",
                        "source_entry_id": "a75f0c66-7b15-3919-8df7-fc8b6f2936f1",
                        "source_sense_id": "0955e0a9-5825-3bfe-84f2-17846659a40b",
