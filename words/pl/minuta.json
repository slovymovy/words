                                "zh": "火车一<w>分钟</w>后从车站发车。"
                            }
                        },
                        {
                            "text": "Czekam na ciebie już piętnaście <w>minut</w>.",
                            "target_lang_translations": {
                                "ru": "Я жду тебя уже пятнадцать <w>минут</w>.",
                                "en": "I have been waiting for you for fifteen <w>minutes</w>.",
                                "nl": "Ik wacht al vijftien <w>minuten</w> op je.",
                                "de": "Ich warte schon seit fünfzehn <w>Minuten</w> auf dich.",
                                "fr": "Je t'attends déjà depuis quinze <w>minutes</w>.",
                                "it": "Ti aspetto già da quindici <w>minuti</w>.",
                                "cs": "Čekám na tebe už patnáct <w>minut</w>.",
                                "tr": "Zaten on beş <w>dakikadır</w> seni bekliyorum.",
                                "es": "Llevo esperándote ya quince <w>minutos</w>.",
                                "zh": "我已经等了你十五<w>分钟</w>。"
                            }
