                "senses": [
                    {
                        "sense_id": "5eeb14ad-e3e8-3790-abbc-cf84bd529802",
                        "entry_id": "6f4f3a6a-07be-3601-b110-aaef4c35890e",
                        "glosses": [
                            "plötzliche Wendung (in einem Drama)"
                        ],
                        "tags": [
                            "Dramentheorie"
                        ],
                        "examples": [
                            {
                                "example_id": "6179430c-c170-4def-9986-00def19eeef0",
                                "sense_id": "5eeb14ad-e3e8-3790-abbc-cf84bd529802",
                                "text": "„Das junge Mädchen zu sehen, erfüllt ihn mit Melancholie und erschüttert ihn tief; während die anderen Anwesenden sich lärmend über die ärgsten Albernheiten unterhalten und ein tauber Onkel mit burlesker Pedanterie die Peripetien eines Begräbnisses schildert, erfährt Hoffmann, eben aus dem Mund jenes Malchens, daß Cora tot ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff4a6c5d-3e65-4f7d-b3db-aa80209b1d39",
                        "source_entry_id": "6f4f3a6a-07be-3601-b110-aaef4c35890e",
                        "source_sense_id": "5eeb14ad-e3e8-3790-abbc-cf84bd529802",
                        "source_sense_description": "Literatur, Dramentheorie: plötzliche Wendung (in einem Drama)",
                        "target_lang_word": "peripeteia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peripeteia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76285882-12a2-34fb-8270-89b3c061a99d",
                                        "entry_id": "30b1cacd-639c-3cbf-b7e4-bf8911de56b1",
                                        "glosses": [
                                            "A sudden reversal of fortune as a plot point in Classical tragedy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc295790-4e76-327c-8392-a9e98d5e8175",
                                        "entry_id": "30b1cacd-639c-3cbf-b7e4-bf8911de56b1",
                                        "glosses": [
                                            "Any sudden change in circumstances; a crisis."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c24ccc81-9ad5-4593-b8c3-a92dd9100831",
                                                "sense_id": "dc295790-4e76-327c-8392-a9e98d5e8175",
                                                "text": "Once more I was a man in a myth, incapable of understanding it, but somehow aware that understanding it meant it must continue, however sinister its peripeteia."
                                            },
                                            {
                                                "example_id": "2a81d12b-6321-4b77-b25b-f5f3780aef57",
                                                "sense_id": "dc295790-4e76-327c-8392-a9e98d5e8175",
                                                "text": "They were to bestride the Algerian scene like demigods until the tragic peripeteia of 1961 […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2f9ad3d-814a-3035-a6d5-f5e87aeb9da7",
                                        "entry_id": "30b1cacd-639c-3cbf-b7e4-bf8911de56b1",
                                        "glosses": [
                                            "A turning point in psychosocial development."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "021dd1f1-ba11-4224-a1a7-88dd8845a224",
                                                "sense_id": "e2f9ad3d-814a-3035-a6d5-f5e87aeb9da7",
                                                "text": "The visual moment whose consequences Freud began to ponder in the essay on the phallic stage has evolved into a peripeteia: \"Some day or other it happens that the child whose own penis is such a proud possession obtains a sight of the genital parts of a little girl; he must then become convinced of the absence of a penis in a creature so like himeself. With this, however, the loss of his own penis becomes imaginable, and the threat of castration achieves its delayed effect.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afe065cc-0947-4eb6-83a4-6434ffa70205",
                        "source_entry_id": "6f4f3a6a-07be-3601-b110-aaef4c35890e",
                        "source_sense_id": "5eeb14ad-e3e8-3790-abbc-cf84bd529802",
                        "source_sense_description": "Literatur, Dramentheorie: plötzliche Wendung (in einem Drama)",
                        "target_lang_word": "péripétie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "péripétie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6260eaa0-72c8-31c6-b4b3-cb0de0d2ea6f",
                                        "entry_id": "b0a7441d-7b46-387e-bd9d-0a56993f0994",
                                        "glosses": [
                                            "Changement subit et imprévu d’un état dans un autre, notamment des changements de ce genre qui ont lieu dans les pièces de théâtre, les romans, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48ee506f-79f8-41ea-b534-ea8201365e8f",
                                                "sense_id": "6260eaa0-72c8-31c6-b4b3-cb0de0d2ea6f",
                                                "text": "La péripétie est bien amenée dans cette pièce."
                                            },
                                            {
                                                "example_id": "4a032b23-7bff-4d2e-bc0b-2edca931ecf4",
                                                "sense_id": "6260eaa0-72c8-31c6-b4b3-cb0de0d2ea6f",
                                                "text": "Une péripétie ingénieuse, touchante, inattendue."
                                            },
                                            {
                                                "example_id": "65494529-179c-4250-9f55-068e53123326",
                                                "sense_id": "6260eaa0-72c8-31c6-b4b3-cb0de0d2ea6f",
                                                "text": "Mais il existe des femmes dont le cœur trop fortement dilaté s’anévrise dans ces terribles péripéties; d’autres, chez lesquelles le sang se tourne, et qui font de graves maladies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2a64d52-d765-3f45-8469-c40cbee941c5",
                                        "entry_id": "b0a7441d-7b46-387e-bd9d-0a56993f0994",
                                        "glosses": [
                                            "Ensemble d’événements imprévus, d’aventures, de déboires et d’histoires ennuyeuses ou agitées."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "215b1a15-0a38-4945-8f6d-02181a1e0c1b",
                                                "sense_id": "d2a64d52-d765-3f45-8469-c40cbee941c5",
                                                "text": "Elle se plaisait à rappeler dans son esprit prévenu les différentes péripéties de cette tragédie de quelques heures, pendant lesquelles le chasseur avait joué le plus grand rôle."
                                            },
                                            {
                                                "example_id": "aedce6ba-d833-48cb-91f0-9f37fa88c168",
                                                "sense_id": "d2a64d52-d765-3f45-8469-c40cbee941c5",
                                                "text": "Après une semaine fertile en péripéties et en catastrophes, Hervé, depuis la résurrection d'Alain Kernoul, venait de passer bien des heures paisibles."
                                            },
                                            {
                                                "example_id": "3c7cf2df-6143-4967-b538-0d7e889d10d1",
                                                "sense_id": "d2a64d52-d765-3f45-8469-c40cbee941c5",
                                                "text": "Bert avait suivi les péripéties de la catastrophe, depuis la séparation des eaux jusqu’à la culée du pont."
                                            },
                                            {
                                                "example_id": "b4c16c2b-b2b8-423c-804f-a4a78de81e8d",
                                                "sense_id": "d2a64d52-d765-3f45-8469-c40cbee941c5",
                                                "text": "On a prodigieusement écrit sur l’affaire Dreyfus. Joseph Reinach a consacré je ne sais combien de volumes à en retracer toutes les péripéties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
