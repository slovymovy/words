                        "glosses": [
                            "netwerk dat vooral geschikt is voor het verzeden van gegevens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e31200d4-4245-4151-ae6a-dbf1d20f7802",
                                "sense_id": "34c31565-89bc-38c7-bc21-56f23695e851",
                                "text": "Bij Voice over IP (internetprotocol) of VoIP, beter bekend als internettelefonie, worden telefoongesprekken opgedeeld in pakketjes en over het datanet gestuurd in plaats van over het klassieke telefoonnet. Dat levert allerlei voordelen op. Het bekendste voordeel zijn de gratis of goedkope gesprekken. Skype is veruit de populairste aanbieder van dergelijke gesprekken."
                            },
                            {
                                "example_id": "dbdbe354-2795-45fe-8636-aab6b9d85b6c",
                                "sense_id": "34c31565-89bc-38c7-bc21-56f23695e851",
                                "text": "Niemand wil dat onze datanetten misbruikt worden. Maar, zo vervolgt Kamp: die maatregelen zorgen wel voor administratieve lasten bij de aangewezen ondernemingen. En dat kan ons vestigings- en investeringsklimaat negatief beïnvloeden. En dáár zijn het ministerie van Economische Zaken en werkgeverslobby VNO-NCW traditioneel tegen."
                            }
                        ]
                    }
