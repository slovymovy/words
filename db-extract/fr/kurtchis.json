                            {
                                "example_id": "16873a17-b54b-43e5-ad7e-02ef17f9560b",
                                "sense_id": "c19dbb9e-d5f3-3d7c-b8ce-2f43a2738cd3",
                                "text": "Leur Commandant s'appelle Kurtchi Baschi. C'était autrefois la première dignité du Royaume, & son autorité était pareille à celle du Connétable en France."
                            },
                            {
                                "example_id": "00a8b394-6776-4bc5-8e16-0da3ae90ccf2",
                                "sense_id": "c19dbb9e-d5f3-3d7c-b8ce-2f43a2738cd3",
                                "text": "Les Kurtchi sont un Corps de Cavalerie, c'est la Noblesse du Royaume de Perse, & la postérité des Conquérans Turcs d'origine, qui mirent Ismaël Sophi sur le Trône."
                            }
                        ]
