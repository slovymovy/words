                        "glosses": [
                            "Faire d'un élément d'information le rhème (ou prédicat) d'une phrase, souvent par une tournure de mise en relief."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "073b3f59-f1c0-49fd-a700-771a77889ff2",
                                "sense_id": "105f65cd-b4e8-382f-8f8b-0692c3e31110",
                                "text": "On dit ainsi que la focalisation est en réalité une rhématisation, qui rhématise le constituant focalisé. Ce nouveau rhème reçoit aussi le nom de focus, ou foyer."
                            }
