                                    {
                                        "sense_id": "2fd0819c-9f8f-384e-a23c-1ee73ab993ba",
                                        "entry_id": "4c154097-0487-3efe-bd14-a97dd77f70c9",
                                        "glosses": [
                                            "allgemein: Messsystem, Verfahren zur Messung quantifizierbarer Einheiten, Größen",
                                            "eine Funktion, die je zwei Elementen eines Raums einen nichtnegativen reellen Wert zuordnet"
                                        ],
                                        "tags": [],
