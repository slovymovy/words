{
    "word_family": [
        "sigillary",
        "sigillate",
        "sigillation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea428b34-8c72-341b-bc0d-bbd64e943e8e",
                    "sense_definition": "An occult or magical sign, image or symbol.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "symbolism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient book was filled with every mysterious <w>sigil</w> used by the secret society.",
                            "target_lang_translations": {
                                "ru": "Древняя книга была заполнена всеми таинственными <w>сигилами</w>, которые использовало тайное общество."
                            }
                        },
                        {
                            "text": "He drew a protective <w>sigil</w> on the floor to keep the spirits away.",
                            "target_lang_translations": {
                                "ru": "Он начертил на полу защитный <w>сигил</w>, чтобы отогнать духов."
                            }
                        }
                    ],
                    "synonyms": [
                        "symbol",
                        "glyph",
                        "emblem"
                    ],
                    "common_phrases": [
                        "protective sigil",
                        "ancient sigil",
                        "magical sigil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оккультный или магический знак, изображение или символ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сигил",
                                "target_lang_sense_clarification": "магический символ"
                            },
                            {
                                "target_lang_word": "сигилла",
                                "target_lang_sense_clarification": "оккультный знак"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa1bc92c-8b5c-3ae7-b4ef-fc2c16bab491",
                    "sense_definition": "A seal, signature or signet.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "symbolism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king pressed his personal <w>sigil</w> into the hot wax to authenticate the decree.",
                            "target_lang_translations": {
                                "ru": "Король прижал свою личную <w>печать</w> к горячему воску, чтобы подтвердить подлинность указа."
                            }
                        },
                        {
                            "text": "Each noble house in the kingdom is identified by a unique <w>sigil</w> on their banners.",
                            "target_lang_translations": {
                                "ru": "Каждый благородный дом в королевстве узнают по уникальному <w>гербу</w> на их знаменах."
                            }
                        }
                    ],
                    "synonyms": [
                        "seal",
                        "signet",
                        "insignia"
                    ],
                    "common_phrases": [
                        "royal sigil",
                        "personal sigil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Печать, подпись или перстень-печать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "печать",
                                "target_lang_sense_clarification": "оттиск или знак"
                            },
                            {
                                "target_lang_word": "герб",
                                "target_lang_sense_clarification": "символ рода на знамени"
                            },
                            {
                                "target_lang_word": "сигил",
                                "target_lang_sense_clarification": "эмблема дома в фэнтези"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "288c9b60-b4d2-3b50-afa8-12687d2c2bf2",
                    "sense_definition": "A nonalphanumeric symbol affixed to a term to indicate a property such as type or scope.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "programming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some programming languages, a <w>sigil</w> like a dollar sign is used to denote a variable.",
                            "target_lang_translations": {
                                "ru": "В некоторых языках программирования для обозначения переменной используется <w>сигил</w>, например знак доллара."
                            }
                        },
                        {
                            "text": "The developer explained that the <w>sigil</w> indicates the scope of the data within the script.",
                            "target_lang_translations": {
                                "ru": "Разработчик объяснил, что этот <w>сигил</w> указывает на область видимости данных внутри скрипта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "variable sigil"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небуквенно-цифровой символ, прикрепляемый к терму для обозначения таких свойств, как тип или область видимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сигил",
                                "target_lang_sense_clarification": "префикс переменной в программировании"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}