                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "66aea0f1-26dc-4e6b-a47e-4b7fff0cc4f7",
                                "sense_id": "26c0fe23-686a-3738-a262-ca42f7b3e131",
                                "text": "Among the light breeds there are probably more good strains of White Leghorn than any other variety. The Brown Leghorn is not quite so popular but is capable of high yields …. The Black Leghorn is another breed which has enjoyed popularity."
                            }
                        ]
                    }
                ],
