                                "example_id": "1a0b0141-50ac-4d18-b8d8-c6ca075b84e0",
                                "sense_id": "f6877278-0356-3deb-895d-b636c6b3135a",
                                "text": "Ze droeg een handtas met draagriem over haar linkerschouder."
                            },
