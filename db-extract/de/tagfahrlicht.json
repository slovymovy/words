                ],
                "senses": [
                    {
                        "sense_id": "1e55e9d4-bed5-3fd9-9514-fac7ba1fa266",
                        "entry_id": "bcad90b7-caf8-3aa0-99c0-29dd9bd34412",
                        "glosses": [
                            "Beleuchtung an Kraftfahrzeugen, die am Tage eingeschaltet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c30ecdb-6ec5-4409-8aa7-b9949c5973cb",
                                "sense_id": "1e55e9d4-bed5-3fd9-9514-fac7ba1fa266",
                                "text": "„Neue Fahrzeugmodelle dürfen europaweit nur noch zugelassen werden, wenn sie mit einem sogenannten Tagfahrlicht ausgerüstet sind.“"
                            },
                            {
                                "example_id": "e6f11d05-84fb-47a1-b0a4-edf79d28c4b6",
                                "sense_id": "1e55e9d4-bed5-3fd9-9514-fac7ba1fa266",
                                "text": "„In Österreich dürfen Nebelscheinwerfer, sofern sie fest in die Fahrzeugfront eingebaut sind, auch als Tagfahrlicht verwendet werden.“"
                            },
                            {
                                "example_id": "50f7c92e-01f1-4b51-a1ff-847153d38b8c",
                                "sense_id": "1e55e9d4-bed5-3fd9-9514-fac7ba1fa266",
                                "text": "„BMW hat die Standlichtringe inzwischen weiterentwickelt, so dass sie wegen ihrer hohen Leuchtkraft auch als Tagfahrlicht fungieren können.“"
                            },
                            {
                                "example_id": "b175e12a-7e61-4742-887e-336ac773e361",
                                "sense_id": "1e55e9d4-bed5-3fd9-9514-fac7ba1fa266",
                                "text": "„Wie beim A6 sorgt auch beim A7 schnellere Elektronik für zügigeren Datentransfer. Äußerlich fallen beim viertürigen Coupé ebenfalls in erster Linie die geänderten Tagfahrlichter sowie die neue Grafik der LED-Heckleuchten auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
