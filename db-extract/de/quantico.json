                "senses": [
                    {
                        "sense_id": "0ba2ad2d-0438-3554-a064-8604ad1ef8ac",
                        "entry_id": "c601582f-4916-3b8e-b90a-ab3560f9d07e",
                        "glosses": [
                            "Stadt im US-Bundesstaat Virginia, in der sich die Akademie des FBI und ein Marinestützpunkt befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aef6767-7e97-4ef7-aa6f-34cc745e81d0",
                                "sense_id": "0ba2ad2d-0438-3554-a064-8604ad1ef8ac",
                                "text": "„Sie fuhr nach Quantico zurück, zurück zur Abteilung für Verhaltensforschung mit ihren behaglichen braunkarierten Vorhängen und ihren grauen Akten voller Hölle.“"
                            },
                            {
                                "example_id": "03543f90-df22-41df-9140-ee174f4e09c1",
                                "sense_id": "0ba2ad2d-0438-3554-a064-8604ad1ef8ac",
                                "text": "„Bei der Investigative Support Unit in Quantico war das Meinungsbild klarer: Die Öffentlichkeit ist oft unser bester Partner.“"
                            },
                            {
                                "example_id": "363a681a-bb20-4b70-ab98-84e672902bbb",
                                "sense_id": "0ba2ad2d-0438-3554-a064-8604ad1ef8ac",
                                "text": "„Sie befinden sich beide in Quantico.“"
                            },
                            {
                                "example_id": "e0a96d40-d827-4431-b3a7-70cb9bdb5936",
                                "sense_id": "0ba2ad2d-0438-3554-a064-8604ad1ef8ac",
                                "text": "„Zehn Minuten später kam das FBI angefahren, in Gestalt von sechs Special Agents. Diese verständigten ihr eigenes Geiselbefreiungsteam, doch das FBI-Spezialkommando brauchte erst noch eine weitere halbe Stunde Fahrt von Quantico bis hierher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
