                "senses": [
                    {
                        "sense_id": "b2f3e53c-0497-33c1-92c7-7af64a0e0720",
                        "entry_id": "dfa9f5d3-9600-3318-a0c1-396e4776b84c",
                        "glosses": [
                            "ein öffentliches Lokal, in dem man speisen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2bffcac-16ba-4a51-84cc-9bd2de6f3fbd",
                                "sense_id": "b2f3e53c-0497-33c1-92c7-7af64a0e0720",
                                "text": "„Es gibt ungeklärte Punkte in Sarah Dorsets Geschichte, die in dem Speiselokal begann.“"
                            },
                            {
                                "example_id": "fae655ab-0fa4-421c-beb7-92be34965dec",
                                "sense_id": "b2f3e53c-0497-33c1-92c7-7af64a0e0720",
                                "text": "„Wir waren inzwischen in einem libanesischen Speiselokal angekommen.“"
                            },
                            {
                                "example_id": "8c17d0b3-37fe-4b50-9478-0fba670e83db",
                                "sense_id": "b2f3e53c-0497-33c1-92c7-7af64a0e0720",
                                "text": "„Bei dem Versuch, Jeannes Speiselokal wieder in Schwung zu bringen, bewies Oberst Siméon übrigens doch noch seine Eignung für den Geheimdienst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
