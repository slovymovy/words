                    },
                    {
                        "sense_id": "474d7110-9cba-33cc-a76f-00f5f0d28fd3",
                        "entry_id": "db226685-275b-3b8f-b0ea-1ee76f9f35c8",
                        "glosses": [
                            "persoonlijk: vervangt *voor+het, *voor+ze",
                            "voor het doel, vanwege de reden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3f56b19-3157-4d51-bc32-f979c58bb524",
                                "sense_id": "474d7110-9cba-33cc-a76f-00f5f0d28fd3",
                                "text": "Je moet het ervoor overhebben."
                            },
                            {
                                "example_id": "3a3cf8bd-c4ab-48a8-97d5-c3286ff67c4a",
                                "sense_id": "474d7110-9cba-33cc-a76f-00f5f0d28fd3",
                                "text": "Hij is ervoor beloond."
                            },
                            {
                                "example_id": "bfaba863-523b-48ad-aa4e-dc4d44256d9d",
                                "sense_id": "474d7110-9cba-33cc-a76f-00f5f0d28fd3",
                                "text": "Terlouw pleitte ervoor \"progressief, onafhankelijk, kritisch en redelijk\" te zijn. Hij zette zichzelf neer als optimist en idealist, die stond voor de zorg voor de aarde en het milieu. Het was een boodschap die hij ook na zijn politieke carrière tot op hoge leeftijd zou blijven uitdragen."
                            }
                        ]
                    },
                    {
                        "sense_id": "146fe672-c1a4-3b26-be77-f03e227941a7",
                        "entry_id": "db226685-275b-3b8f-b0ea-1ee76f9f35c8",
                        "glosses": [
                            "persoonlijk: vervangt *voor+het, *voor+ze",
                            "voor deze tijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62df1678-d428-404f-b08b-30964be2ac7a",
                                "sense_id": "146fe672-c1a4-3b26-be77-f03e227941a7",
                                "text": "'Hij had mama vlak ervoor gebeld om te zeggen dat het niet goed met hem ging."
                            },
                            {
                                "example_id": "8ade2572-df79-462f-ac34-5f463756b75c",
                                "sense_id": "146fe672-c1a4-3b26-be77-f03e227941a7",
                                "text": "Dit alles betekende ook dat ik mijn gezin lange tijd niet zou zien. Gelukkig had mijn vrouw daar geen probleem mee omdat ze zelf kort ervoor een lange wandeling naar Santiago de Compostela had gemaakt."
                            },
                            {
                                "example_id": "b544e64b-b149-4627-815d-06c550dcd620",
                                "sense_id": "146fe672-c1a4-3b26-be77-f03e227941a7",
                                "text": "Sinds 1813 is Nederland een koninkrijk. Ervoor was het een republiek"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
