                                "target_senses": [
                                    {
                                        "sense_id": "9e3c41ab-36a9-3e6d-b547-9aa681fc8061",
                                        "entry_id": "04f955c9-4137-3f9d-89f5-8ee3c0e129f6",
                                        "glosses": [
                                            "buiten het zojuist genoemde om"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce000929-a8e3-490d-9264-57b3006b3ea7",
                                                "sense_id": "9e3c41ab-36a9-3e6d-b547-9aa681fc8061",
                                                "text": "Dat is overigens al eerder gezien."
                                            },
                                            {
                                                "example_id": "53878714-b66d-4741-abfe-374031328e6f",
                                                "sense_id": "9e3c41ab-36a9-3e6d-b547-9aa681fc8061",
                                                "text": "Trainers lieten zich overigens niet onbetuigd in dit debat: er is zelfs een eloquente verdediging van de derde- eeuwse auteur Philostratus, waarin de pretenties van de artsen werden doorgeprikt."
                                            },
                                            {
                                                "example_id": "3d3da406-2576-4e98-aec8-e83572c7afda",
                                                "sense_id": "9e3c41ab-36a9-3e6d-b547-9aa681fc8061",
                                                "text": "Het afgeschraapte mengsel van zand, zweet en olie (gloios) werd overigens verzameld en verkocht - er werden genezende eigenschappen aan toegeschreven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1eb87113-0aaf-46a7-b5fb-2055161737d1",
                        "source_entry_id": "01a7f911-7155-3a7f-aee9-11ca7d7f3747",
                        "source_sense_id": "ec89f9f2-8276-3134-b46d-d5146827c7e5",
                        "target_lang_word": "toevallig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toevallig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d21f9837-62e3-3e85-9b5f-4b4773797198",
                                        "entry_id": "f716cf13-da49-3717-8499-1321888e1bd5",
                                        "glosses": [
                                            "bij toeval, niet met opzet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf5c27b-eaf6-4895-ab04-3e9e529989f7",
                                                "sense_id": "d21f9837-62e3-3e85-9b5f-4b4773797198",
                                                "text": "wat moet je anders doen als je op Ibiza woont? Ik werd weer een levend, voelend mens die toevallig elk halfjaar op en neer moest naar Nederland voor een controle."
                                            },
                                            {
                                                "example_id": "2e783ff1-a33b-4653-a2c3-102fdaf65519",
                                                "sense_id": "d21f9837-62e3-3e85-9b5f-4b4773797198",
                                                "text": "Ik was er toevallig op het goede moment, zodat je mij als je doek kon gebruiken."
                                            },
                                            {
                                                "example_id": "b831447d-3277-44d0-b654-c65c53787536",
                                                "sense_id": "d21f9837-62e3-3e85-9b5f-4b4773797198",
                                                "text": "Toevallig had ik aan het zwembad een gesprek gevoerd met een Zwitser, Wale, die met zijn gezin in een camper een rondreis maakte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc23f7cb-6ac9-4932-8d33-7bd5d81fab36",
                        "source_entry_id": "01a7f911-7155-3a7f-aee9-11ca7d7f3747",
                        "source_sense_id": "ec89f9f2-8276-3134-b46d-d5146827c7e5",
                        "target_lang_word": "bovendien",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bovendien",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "917a041f-f73f-3948-9228-dc8ea1339188",
                                        "entry_id": "a5404809-0177-3e3d-9c57-f074caeefb09",
                                        "glosses": [
                                            "op de koop toe, daarenboven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "add36785-38ab-4e07-ba5b-aff384f672db",
                                                "sense_id": "917a041f-f73f-3948-9228-dc8ea1339188",
                                                "text": "Stoppen met roken is gezond en bovendien een snelle manier om veel geld te besparen."
                                            },
                                            {
                                                "example_id": "dadf0373-a763-4dc9-8caa-ccba50c01b3b",
                                                "sense_id": "917a041f-f73f-3948-9228-dc8ea1339188",
                                                "text": "Nu ik helemaal alleen was viel er weinig te zeuren en bovendien zou niemand het horen."
                                            },
                                            {
                                                "example_id": "0660d1d8-7885-4ca3-bd92-340cea3a711d",
                                                "sense_id": "917a041f-f73f-3948-9228-dc8ea1339188",
                                                "text": "Ze moesten het materiaal dus verwarmen met vuur en bovendien een systeem bedenken om de stammen boven het vuur om te draaien op ongeveer dezelfde manier als zuiderlingen schapenlichamen boven open vuur roteerden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
