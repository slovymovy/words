                        "examples": [
                            {
                                "example_id": "a5330a78-a491-4fd7-984c-b0c0b18d1d4f",
                                "sense_id": "2f2db7c4-c42f-3d68-8a82-1ed52e3feb64",
                                "text": "„Nicht einmal mehr der Allradantrieb ist ein Muss. Und als Dreitürer gibt es ihn gleich überhaupt nicht.“"
                            },
                            {
                                "example_id": "fe3325cf-49f5-4328-b5f1-6ef8f86f5620",
                                "sense_id": "2f2db7c4-c42f-3d68-8a82-1ed52e3feb64",
                                "text": "„Die Linienführung im Heck ist perfekt gelungen, an den Dreitürer wird sich bald keiner mehr erinnern.“"
                            }
                        ],
