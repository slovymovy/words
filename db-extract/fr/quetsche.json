                "senses": [
                    {
                        "sense_id": "d9915e13-765d-3d6d-973a-cf27e16bf2fe",
                        "entry_id": "7a4ad65c-0e09-3b29-b312-a737babe5fb3",
                        "glosses": [
                            "Grosse prune oblongue, le plus souvent violette ou noire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ccf6b3d-2bc6-41b2-bc94-1412808b3f72",
                                "sense_id": "d9915e13-765d-3d6d-973a-cf27e16bf2fe",
                                "text": "Une servante étalait le dessert sur la table, les quiches aux « quetsches » dont le jus coulait parfumé, les gâteaux à la croûte dorée et craquante, les tartes aux pommes, larges comme des fonds de tonneau et dont la pâte avait un goût fin de cannelle."
                            },
                            {
                                "example_id": "517eda11-3c1e-479d-a7bf-f6860f2721d2",
                                "sense_id": "d9915e13-765d-3d6d-973a-cf27e16bf2fe",
                                "text": "La sauce tomate inimitable, les quetsches, dont on dégusta quatre ans après la mort d’Irma le dernier bocal retrouvé au fond d’une étagère, dessert à la saveur unique au royaume des tartes, à mi-chemin entre acide & sucré, à la consistance gluante & sirupeuse."
                            },
                            {
                                "example_id": "6c7bd531-378c-43bd-8578-112f6d8577db",
                                "sense_id": "d9915e13-765d-3d6d-973a-cf27e16bf2fe",
                                "text": "La quetsche et sa pellicule de pruine, signe extérieur de maturité intérieure !"
                            }
                        ]
                    },
                    {
                        "sense_id": "cea93b79-30e9-3b29-a72b-026f11359704",
                        "entry_id": "7a4ad65c-0e09-3b29-b312-a737babe5fb3",
                        "glosses": [
                            "Eau-de-vie faite avec ce fruit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13e56863-ac73-4d83-8f51-0196a8fd8fb8",
                                "sense_id": "cea93b79-30e9-3b29-a72b-026f11359704",
                                "text": "Je vous sers un petit verre de quetsche ?"
                            },
                            {
                                "example_id": "098cbe02-ca3f-4b52-8f44-e1d53b842718",
                                "sense_id": "cea93b79-30e9-3b29-a72b-026f11359704",
                                "text": "« Une petite quetsche, monsieur Labbé ? C’est ma tournée !..."
                            }
                        ]
                    },
