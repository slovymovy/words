                ],
                "senses": [
                    {
                        "sense_id": "9c5ff5dd-1990-3216-a482-69d5b435b1f6",
                        "entry_id": "25ecd1a6-e1ae-3603-9cd9-8a60653fb653",
                        "glosses": [
                            "Querschnitt, der durch einen Impuls (Sog) mit Unterdruck beaufschlagt ist, und gezogen wird (zieht)"
                        ],
                        "tags": [
                            "Strömungstechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "5a70ed79-51ed-4950-9fea-f83c7ad6b95c",
                                "sense_id": "9c5ff5dd-1990-3216-a482-69d5b435b1f6",
                                "text": "„In praktischen Anwendungen ist jedoch manchmal die bewusste Drosselung der Saugseite notwendig oder sie findet aufgrund eines verstopften Grundventils bzw. der zunehmenden Verschmutzung eines Filters zwangsläufig statt.“"
                            },
                            {
                                "example_id": "62012e08-f210-47db-ae6b-08d4c57aaccf",
                                "sense_id": "9c5ff5dd-1990-3216-a482-69d5b435b1f6",
                                "text": "„Zur Ermittlung der Kennlinien für die Parallelschaltung werden die beiden Drücke auf den Saugseiten der Pumpen, der Gesamtdruck, beide Drehzahlen, die Gesamtleistungsaufnahme sowie der Gesamtvolumenstrom aufgenommen.“"
                            },
                            {
                                "example_id": "4a769a0a-f56b-4f38-944e-4ea11034e0be",
                                "sense_id": "9c5ff5dd-1990-3216-a482-69d5b435b1f6",
                                "text": "„Da bei der Flüssigkeitsförderung zwischen Pumpendruckstutzen und Pumpensaugstutzen eine positive Druckdifferenz erzeugt wird, fließt durch die Spalte zwischen Rotoren und Gehäuse ein Anteil des Förderstromes von der Druck- zur Saugseite zurück.“"
                            },
                            {
                                "example_id": "96eb8469-0472-4090-b63f-68893a84ac34",
                                "sense_id": "9c5ff5dd-1990-3216-a482-69d5b435b1f6",
                                "text": "„Pulsationsdämpfer für die Saugseite arbeiten im Unterdruckbereich und weisen keine Membrane zur Trennung der Luft- und Mediumsseite auf.“"
                            },
                            {
                                "example_id": "3de2d566-3ee1-4df2-b959-410c02b4e4d2",
                                "sense_id": "9c5ff5dd-1990-3216-a482-69d5b435b1f6",
                                "text": "„Im Bereich der Druckseite und der Saugseite der Schaufel legt sich der Nachlauf an die Grenzschicht der Schaufel an, wodurch die Form der Nachlaufdelle eine gebogene Kontur erhält.“"
                            },
                            {
                                "example_id": "367f25ed-34e6-432e-94e3-7b98db285add",
                                "sense_id": "9c5ff5dd-1990-3216-a482-69d5b435b1f6",
                                "text": "„Geregelt werden die Kolbenpumpen entweder durch eine recht einfache Umlaufregelung (Bypass), bei der je nach Bedarf mehr oder weniger große Anteile des Förderstromes von der Druckseite zur Saugseite zurückgeleitet werden (die Verluste sind bei kleinen Einheiten tragbar) oder wirtschaftlicher durch stufenlose Drehzahlverstellung (Regelung) der polumschaltbaren Motoren in Verbindung mit einer Umlaufregelung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
