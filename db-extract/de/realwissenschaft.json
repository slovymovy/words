                "senses": [
                    {
                        "sense_id": "5809140a-9439-3166-aa7b-7588ee77a799",
                        "entry_id": "4f7dbd63-de3b-31f8-9b98-003887a5af12",
                        "glosses": [
                            "Wissenschaft, die sich mit einem bestimmten Teilbereich der menschlichen Erfahrungswirklichkeit, entweder mit der Natur oder mit etwas, das durch menschliches Handeln entstanden ist, auseinandersetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7292b857-14bf-4c39-b96b-8a5f404059a5",
                                "sense_id": "5809140a-9439-3166-aa7b-7588ee77a799",
                                "text": "„Realwissenschaften erforschen ihre Teilbereiche, indem sie Beschreibungs- und Begründungszusammenhänge aufweisen.“"
                            },
                            {
                                "example_id": "c1cace4f-ff5b-4423-a3f0-72290b3278b4",
                                "sense_id": "5809140a-9439-3166-aa7b-7588ee77a799",
                                "text": "„Die Naturwissenschaft strebt gedanklicher Einheit in der Physik zu; die Fülle ihrer Anwendungen verwandelt die Welt. Vielleicht die größten Fortschritte unter den Realwissenschaften macht die Biologie. Medizin, Psychologie, Anthropologie stehen in der ungelösten Spannung zwischen der strömenden Fruchtbarkeit des naturwissenschaftlichen Ansatzes und der überwiegenden, aber heute unerfüllten Wichtigkeit eines verstehenden Verhältnisses des Menschen zum Menschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
