        "absorberend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6148600f-18b1-3fe8-ad89-0f518658f156",
                    "sense_definition": "in zich opnemen of opzuigen, met name van vloeistoffen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opnemen_fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze droge spons kan heel snel veel water <w>absorberen</w>.",
                            "target_lang_translations": {
                                "en": "This dry sponge can <w>absorb</w> a lot of water very quickly."
                            }
                        },
                        {
                            "text": "Het zaagsel <w>absorbeerde</w> de gemorste olie direct van de grond.",
                            "target_lang_translations": {
                                "en": "The sawdust immediately <w>soaked up</w> the spilled oil from the floor."
                            }
                        }
                    ],
                    "synonyms": [
                        "opnemen",
                        "opslorpen",
                        "opzuigen"
                    ],
                    "antonyms": [
                        "afstoten"
                    ],
                    "common_phrases": [
                        "vocht absorberen",
                        "water absorberen"
                    ],
                    "target_lang_definitions": {
                        "en": "to take in or soak up, especially of liquids"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "absorb",
                                "target_lang_sense_clarification": "liquids"
                            },
                            {
                                "target_lang_word": "soak up",
                                "target_lang_sense_clarification": "fluids, liquid spills"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02c1c63c-e8bb-3b89-9aa8-7bfe13daa865",
                    "sense_definition": "straling, licht, warmte of geluid opnemen en niet terugkaatsen of doorlaten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opnemen_fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit speciale filter <w>absorbeert</w> schadelijke ultraviolette straling uitstekend.",
                            "target_lang_translations": {
                                "en": "This special filter <w>absorbs</w> harmful ultraviolet radiation excellently."
                            }
                        },
                        {
                            "text": "De dikke gordijnen <w>absorberen</w> het geluid van het drukke verkeer.",
                            "target_lang_translations": {
                                "en": "The thick curtains <w>absorb</w> the noise of the busy traffic."
                            }
                        }
                    ],
                    "synonyms": [
                        "opnemen",
                        "dempen"
                    ],
                    "antonyms": [
                        "weerkaatsen",
                        "reflecteren"
                    ],
                    "common_phrases": [
                        "licht absorberen",
                        "geluid absorberen",
                        "schokken absorberen"
                    ],
                    "target_lang_definitions": {
                        "en": "to take in radiation, light, heat, or sound without reflecting or transmitting it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "absorb",
                                "target_lang_sense_clarification": "light, sound, heat, or radiation"
                            },
                            {
                                "target_lang_word": "dampen",
                                "target_lang_sense_clarification": "sound or vibration"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b34a79ad-3a8a-3413-8512-acc932dbac14",
                    "sense_definition": "kosten, schokken of veranderingen accepteren en financieel of organisatorisch verwerken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verwerken_figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bedrijf kon de onverwachte prijsstijgingen gelukkig zonder problemen <w>absorberen</w>.",
                            "target_lang_translations": {
                                "en": "Fortunately, the company was able to <w>absorb</w> the unexpected price increases without any problems."
                            }
                        },
                        {
                            "text": "De Chinese fabrikanten hebben de extra kosten van de heffingen grotendeels <w>geabsorbeerd</w>.",
                            "target_lang_translations": {
                                "en": "Chinese manufacturers largely <w>absorbed</w> the additional costs of the tariffs."
                            }
                        }
                    ],
                    "synonyms": [
                        "opvangen",
                        "verwerken",
                        "incasseren"
                    ],
                    "antonyms": [
                        "doorberekenen"
                    ],
                    "common_phrases": [
                        "kosten absorberen",
                        "schokken absorberen",
                        "verliezen absorberen"
                    ],
                    "target_lang_definitions": {
                        "en": "to accept and manage costs, shocks, or changes financially or organizationally"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "absorb",
                                "target_lang_sense_clarification": "costs, losses, or shocks"
                            },
                            {
                                "target_lang_word": "cushion",
                                "target_lang_sense_clarification": "an impact or shock"
                            }
                        ]
                    }
                }
            ]
        }
    ]
