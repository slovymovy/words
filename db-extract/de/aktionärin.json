                "senses": [
                    {
                        "sense_id": "738fce6c-1f07-3aa6-b0be-b32240f2397c",
                        "entry_id": "ce9793f5-b17e-3440-98c6-e7f384f8ad79",
                        "glosses": [
                            "Inhaberin von Aktien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4bec1eb-d5e2-46f3-aea2-0f6ec12b6152",
                                "sense_id": "738fce6c-1f07-3aa6-b0be-b32240f2397c",
                                "text": "„Die Dresdner Bank wurde damit nicht nur zum dominierenden Faktor im Syndikat, sondern zur wichtigsten Aktionärin bei der Ersten Brünner Maschinenfabrik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45626415-a112-49f6-9568-94d20ccad380",
                        "source_entry_id": "ce9793f5-b17e-3440-98c6-e7f384f8ad79",
                        "source_sense_id": "738fce6c-1f07-3aa6-b0be-b32240f2397c",
                        "source_sense_description": "Inhaberin von Aktien",
                        "target_lang_word": "shareholder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shareholder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c729da4a-4ae6-395b-bc0d-d786d7ca4bb3",
                                        "entry_id": "e7e609b5-47f9-3b07-9bb6-5fec0207f9bd",
                                        "glosses": [
                                            "One who owns shares of stock in a corporation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a785e93b-d483-42e2-b441-5cb8fbee6710",
                                                "sense_id": "c729da4a-4ae6-395b-bc0d-d786d7ca4bb3",
                                                "text": "Shareholders are the real owners of a publicly traded business, but management runs it."
                                            },
                                            {
                                                "example_id": "b033b9f1-2d60-4206-8c6b-6f2281ab1442",
                                                "sense_id": "c729da4a-4ae6-395b-bc0d-d786d7ca4bb3",
                                                "text": "Hudson personally would not face the music at that meeting and the business could hardly proceed for groans and hisses and cries of \"Hudson! Hudson! Why is Hudson not here?\" and so the ungrateful shareholders to whom Hudson had generously paid dividends out of their own capital cast out Hudson bag and baggage, including therein the agreement with the Newmarket Railway."
                                            },
                                            {
                                                "example_id": "f9423df7-8591-4e4c-b3c4-e961284f7cfc",
                                                "sense_id": "c729da4a-4ae6-395b-bc0d-d786d7ca4bb3",
                                                "text": "High prices have swelled profits for energy companies, leaving them flush with cash. And their shareholders are certainly feeling that windfall. Exxon Mobil made a record $59 billion profit in 2022, up 157% from the year prior, and the company plans to spend up to $50 billion buying back shares."
                                            },
                                            {
                                                "example_id": "7eed34cd-b2c2-4bd7-96ff-9d516919ac9e",
                                                "sense_id": "c729da4a-4ae6-395b-bc0d-d786d7ca4bb3",
                                                "text": "As of March 2022, the Qatar Holding LLC, the investment arm of Qatar Investment Authority (QIA) was the single largest shareholder of QIB, owning 16.7% of the bank, while Nasser Al-Khelaifi, president of PSG, is a board member at QIA."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60128129-876c-476b-80b0-0c93d8edd1b3",
                        "source_entry_id": "ce9793f5-b17e-3440-98c6-e7f384f8ad79",
