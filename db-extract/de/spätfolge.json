                ],
                "senses": [
                    {
                        "sense_id": "d9ff4670-c665-38c6-a8ba-4df86bcb610f",
                        "entry_id": "97ba6a96-604b-381b-b881-77376b3a8b57",
                        "glosses": [
                            "aktuell (erstmals) auftretendes (meist negatives) Ergebnis, das auf eine lang zurückliegende Ursache zurückgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3277f7ab-0e0b-4369-b611-5e89be11a150",
                                "sense_id": "d9ff4670-c665-38c6-a8ba-4df86bcb610f",
                                "text": "„Wenn Besucher keinerlei Empathie für jene Kriegskinder erkennen ließen, die im Alter unter den Spätfolgen litten, konnte es geschehen, dass in den hinteren Reihen drei Menschen aufstanden und die Veranstaltung verließen.“"
                            },
                            {
                                "example_id": "7b0a2252-aee2-4010-a912-428f1ff6ee1e",
                                "sense_id": "d9ff4670-c665-38c6-a8ba-4df86bcb610f",
                                "text": "„Spätfolge der Pharyngitis ist das rheumatische Fieber (ARF), das zwei bis drei Wochen nach der Erkrankung auftreten kann.“"
                            },
                            {
                                "example_id": "0ed36fdc-c36f-4f3d-80f8-17bcc83f4151",
                                "sense_id": "d9ff4670-c665-38c6-a8ba-4df86bcb610f",
                                "text": "„Zum anderen lässt sich die Inflation auch als Spätfolge des bis 1971 bestehenden Weltwährungsregimes interpretieren, in dessen Mittelpunkt ein goldgedeckter Dollar stand.“"
                            },
                            {
                                "example_id": "cd810f2f-db9b-4a1d-923c-c96229c498b5",
                                "sense_id": "d9ff4670-c665-38c6-a8ba-4df86bcb610f",
                                "text": "„In diesem Agenblick hat Kant als erster Wissenschaftler den Ausdruck »Spätfolgen« geprägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
