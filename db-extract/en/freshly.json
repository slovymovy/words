                            "uncommon"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66f564e2-ab69-4cfb-9516-b3bba4455fbf",
                        "source_entry_id": "a8b446af-3ddb-30c4-ab0e-71a164dc94d0",
                        "source_sense_description": "recently",
                        "target_lang_word": "fraîchement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fraîchement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1f0399f-001a-3fd4-bdda-0d0b6c0784e6",
                                        "entry_id": "9155dddd-53f1-361f-8f34-d05d6d9a5ffd",
                                        "glosses": [
                                            "Avec une fraîcheur agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f62add51-21f5-4974-89ad-a2c39fff04fd",
                                                "sense_id": "a1f0399f-001a-3fd4-bdda-0d0b6c0784e6",
                                                "text": "Marcher la nuit pour voyager fraîchement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dc9fadc-4dd2-3b8c-a252-83a61a053525",
                                        "entry_id": "9155dddd-53f1-361f-8f34-d05d6d9a5ffd",
                                        "glosses": [
                                            "Au frais, dans un endroit frais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a11769fb-799a-4703-9eaa-2f954f6e5ae1",
                                                "sense_id": "1dc9fadc-4dd2-3b8c-a252-83a61a053525",
                                                "text": "Être logé fraîchement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90d76527-7284-33ca-9224-bba0895b2b8b",
                                        "entry_id": "9155dddd-53f1-361f-8f34-d05d6d9a5ffd",
                                        "glosses": [
                                            "Récemment, depuis peu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70ae1fea-9efe-42fd-8b49-35ef122d84d5",
                                                "sense_id": "90d76527-7284-33ca-9224-bba0895b2b8b",
                                                "text": "Jean Donnard et Pierre Kerhuon embarquaient les filets dans la chaloupe, amarrée au quai, près de la cale qu’ensanglantaient des débris de poissons fraîchement éventrés."
                                            },
                                            {
                                                "example_id": "59e367fa-155c-43d2-b46f-ce4c00f5ddb7",
                                                "sense_id": "90d76527-7284-33ca-9224-bba0895b2b8b",
                                                "text": "Cet illustre personnage qui venait de perdre fraîchement deux de ses enfants."
                                            },
                                            {
                                                "example_id": "b42a946a-c1e0-47d4-9f92-4adbd6935003",
                                                "sense_id": "90d76527-7284-33ca-9224-bba0895b2b8b",
                                                "text": "Il tient quelque moineau qu’il a pris fraîchement."
                                            },
                                            {
                                                "example_id": "e7196411-36fc-4633-b67c-8b093b965297",
                                                "sense_id": "90d76527-7284-33ca-9224-bba0895b2b8b",
                                                "text": "Cet étranger extravague ; il vient sans doute tout fraîchement de l’autre monde."
                                            },
                                            {
                                                "example_id": "3816f09c-29ce-4c1d-8916-100c96a33e5d",
                                                "sense_id": "90d76527-7284-33ca-9224-bba0895b2b8b",
                                                "text": "Ce qui inspirait à l’un tant de hardiesse, et à l’autre tant de docilité, était la nouvelle qu’on avait reçue tout fraîchement de la grande victoire que les Romains avaient remportée sur Persée, roi de Macédoine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a10372a6-a609-3b40-b4c1-bf8bb3130f45",
                                        "entry_id": "9155dddd-53f1-361f-8f34-d05d6d9a5ffd",
                                        "glosses": [
                                            "Avec quelque froideur (c'est un adoucissement de froidement)."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cd85264-5b46-496a-a7b1-f7d5a1de10f5",
                                                "sense_id": "a10372a6-a609-3b40-b4c1-bf8bb3130f45",
                                                "text": "Il aperçut seulement alors que madame Grandet le recevait très fraîchement ; il en fut amusé."
                                            },
                                            {
                                                "example_id": "e4b913e2-4d48-449d-8b76-079ef7a76b5c",
                                                "sense_id": "a10372a6-a609-3b40-b4c1-bf8bb3130f45",
                                                "text": "Mais un grand escogriffe en smoking et coiffé d'une casquette à carreaux sortait de la limousine et accourait vers les trois femmes qui l'accueillirent fraîchement."
                                            },
                                            {
                                                "example_id": "75abd60a-de2a-4189-9061-59791d222586",
                                                "sense_id": "a10372a6-a609-3b40-b4c1-bf8bb3130f45",
                                                "text": "Le compliment [de la duchesse de Lauzun] fut d’abord fraîchement reçu ; incontinent la marée monta, et voilà la duchesse du Maine aux reproches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38beeea2-6350-42e4-a741-f52edfe14eda",
                        "source_entry_id": "a8b446af-3ddb-30c4-ab0e-71a164dc94d0",
                        "source_sense_description": "rude manner",
                        "target_lang_word": "froidement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "froidement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c11c870e-62a4-3c80-86e1-cfaa2e65c1c5",
                                        "entry_id": "ad8db57b-86ac-37bf-b6d2-81690386401d",
                                        "glosses": [
                                            "De manière à sentir le froid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5427bc06-57d6-41f1-9971-2f5295ae4cfd",
                                                "sense_id": "c11c870e-62a4-3c80-86e1-cfaa2e65c1c5",
                                                "text": "Être logé, vêtu froidement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1fa5f93-a666-3f80-847a-7128e738fa40",
                                        "entry_id": "ad8db57b-86ac-37bf-b6d2-81690386401d",
                                        "glosses": [
                                            "D’une manière froide, sans chaleur, sans émotion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c14a6753-c4bc-4141-a072-73837d0e9dbf",
                                                "sense_id": "a1fa5f93-a666-3f80-847a-7128e738fa40",
                                                "text": "Il écoute froidement les injures. Le stoïcien regarde froidement la mort."
                                            },
                                            {
                                                "example_id": "a48b7da9-2f03-4c78-97ec-413e7d953df0",
                                                "sense_id": "a1fa5f93-a666-3f80-847a-7128e738fa40",
                                                "text": "En entendant cette horrible phrase, Pons se redressa comme si la décharge de quelque pile galvanique l’eût atteint, salua froidement sa cousine et alla reprendre son spencer."
                                            },
                                            {
                                                "example_id": "6e422b68-0e1d-4027-a86d-7cbe536aa636",
                                                "sense_id": "a1fa5f93-a666-3f80-847a-7128e738fa40",
                                                "text": "Il conte brièvement, mais froidement ; il ne se fait point écouter, il ne fait point rire."
                                            },
                                            {
                                                "example_id": "6983a801-092f-4aec-931e-4a096f669cb9",
                                                "sense_id": "a1fa5f93-a666-3f80-847a-7128e738fa40",
                                                "text": "Porus répondit froidement qu’il l’irait recevoir sur sa frontière, mais que ce serait les armes à la main."
                                            },
                                            {
                                                "example_id": "9a46f9c5-1d0d-4628-b661-626978801ede",
                                                "sense_id": "a1fa5f93-a666-3f80-847a-7128e738fa40",
                                                "text": "[…]Ces flammes secrètes Que ne sentit jamais Boileau l’imitateur Dans ses tristes beautés si froidement parfaites."
                                            },
                                            {
                                                "example_id": "ba9c0509-da32-43f9-badb-79bf04766c51",
                                                "sense_id": "a1fa5f93-a666-3f80-847a-7128e738fa40",
                                                "text": "Mais honte soit au cœur Qui n'offre froidement que des vœux au malheur !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bb39831-f28f-357a-a40a-ef4e00abf93e",
                                        "entry_id": "ad8db57b-86ac-37bf-b6d2-81690386401d",
                                        "glosses": [
                                            "D’une manière froide, avec réserve, sans encourager."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abc90c25-9b26-4ee0-956e-7455442df1d3",
                                                "sense_id": "6bb39831-f28f-357a-a40a-ef4e00abf93e",
                                                "text": "Vous louez les œuvres d’autrui froidement."
                                            },
                                            {
                                                "example_id": "59ce0825-5721-4bfb-abb3-4d2acdd2329d",
                                                "sense_id": "6bb39831-f28f-357a-a40a-ef4e00abf93e",
                                                "text": "M. le nonce en a parlé froidement."
                                            },
                                            {
                                                "example_id": "2df6370c-5889-4a6a-b4ec-c8312a61dce8",
                                                "sense_id": "6bb39831-f28f-357a-a40a-ef4e00abf93e",
                                                "text": "Piper lui demanda s’il n'y avait rien de nouveau : Non, dit le général froidement, et passa outre pour aller donner ses ordres."
                                            },
                                            {
                                                "example_id": "ca93502f-a3b2-47a4-9f16-a972dff9d860",
                                                "sense_id": "6bb39831-f28f-357a-a40a-ef4e00abf93e",
                                                "text": "La veille de son départ [de Bernin], on lui porta trois mille louis avec un brevet de douze mille livres de pension, il reçut le tout assez froidement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeab8436-7c79-3f47-9a0f-04ff7d8c3724",
                                        "entry_id": "ad8db57b-86ac-37bf-b6d2-81690386401d",
                                        "glosses": [
                                            "Avec impassibilité, sans se troubler, sans s’émouvoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8566e281-3d10-48cb-af87-30ace76649ed",
                                                "sense_id": "aeab8436-7c79-3f47-9a0f-04ff7d8c3724",
                                                "text": "Il calcule froidement ce qui peut lui rester de vie."
                                            },
                                            {
                                                "example_id": "c5ad1a40-ff47-442a-931f-a99699729363",
                                                "sense_id": "aeab8436-7c79-3f47-9a0f-04ff7d8c3724",
                                                "text": "Il écouta froidement leurs injures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
