    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f351cdd-d682-3201-a397-d4d87b3603f1",
                    "sense_definition": "a small dog that is kept as a pet and is small enough to be held in the lap; or, figuratively, a person who is completely controlled by someone else and does whatever they are told",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "subservient person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy woman was never seen without her tiny <w>lapdog</w> resting on her expensive silk dress.",
                            "target_lang_translations": {
                                "ru": "Богатую женщину никогда не видели без её крошечной <w>собачки</w>, лежащей на дорогом шёлковом платье."
                            }
                        },
                        {
                            "text": "The corrupt politician was nothing more than a <w>lapdog</w> for the large corporations that funded his campaign.",
                            "target_lang_translations": {
                                "ru": "Коррумпированный политик был не более чем <w>марионеткой</w> крупных корпораций, финансировавших его кампанию."
                            }
                        }
                    ],
                    "synonyms": [
                        "puppet",
                        "minion",
                        "toady",
                        "sycophant"
                    ],
                    "antonyms": [
                        "leader",
                        "rebel"
                    ],
                    "common_phrases": [
                        "corporate lapdog",
                        "political lapdog",
                        "pampered lapdog"
                    ],
                    "target_lang_definitions": {
                        "ru": "маленькая комнатная собачка, которую удобно держать на коленях; или, в переносном смысле, человек, который полностью подчиняется другому и беспрекословно выполняет все указания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комнатная собачка",
                                "target_lang_sense_clarification": "маленькое домашнее животное"
                            },
                            {
                                "target_lang_word": "марионетка",
                                "target_lang_sense_clarification": "человек, находящийся под полным контролем"
                            },
                            {
                                "target_lang_word": "подпевала",
