                        "examples": [
                            {
                                "example_id": "8d5a0ca8-36d0-4860-8120-0f5f14702729",
                                "sense_id": "8520e609-25e8-3ce5-b6e1-c592ab94cd8d",
                                "text": "En tels procès la reine est très experte ; bénignement elle vous recevra."
                            },
                            {
                                "example_id": "4c9b8473-c625-41f6-ad74-e2080099b614",
                                "sense_id": "8520e609-25e8-3ce5-b6e1-c592ab94cd8d",
                                "text": "Nous, l’armée invisible aux cris éblouissants\nPlus doux que n’est le miel et plus simples qu’un peu de terre\nNous te tournons bénignement le dos Italie\nMais ne t’en fais pas, nous t’aimons bien\nItalie ô mère qui es aussi notre fille."
                            }
                        ]
                    }
