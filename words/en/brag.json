{
    "word_family": [
        "braggart",
        "braggadocio",
        "bragging",
        "braggy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b4e46c8-45f7-3120-a00a-eb59f912fd55",
                    "sense_definition": "To boast or talk with excessive pride about one's achievements, possessions, or abilities.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "boasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He likes to <w>brag</w> about his expensive car whenever we meet for lunch.",
                            "target_lang_translations": {
                                "ru": "Он любит <w>хвастаться</w> своей дорогой машиной всякий раз, когда мы встречаемся за обедом."
                            }
                        },
                        {
                            "text": "It is not polite to <w>brag</w> about money when others are struggling financially.",
                            "target_lang_translations": {
                                "ru": "Невежливо <w>хвалиться</w> деньгами, когда другие испытывают финансовые трудности."
                            }
                        }
                    ],
                    "synonyms": [
                        "boast",
                        "beat one's chest",
                        "show off"
                    ],
                    "common_phrases": [
                        "brag about money",
                        "brag of success"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хвастаться или говорить с чрезмерной гордостью о своих достижениях, имуществе или способностях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвастаться",
                                "target_lang_sense_clarification": "выставлять напоказ свои успехи"
                            },
                            {
                                "target_lang_word": "хвалиться",
                                "target_lang_sense_clarification": "говорить о себе с излишней похвалой"
                            },
                            {
                                "target_lang_word": "бахвалиться",
                                "target_lang_sense_clarification": "самонадеянно и грубо хвастаться"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "92d52b84-0e61-3758-9c14-af9772ba33c1",
                    "sense_definition": "An instance of boastful talk or a statement expressing excessive pride.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "boasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant <w>brag</w> about his athletic skills eventually started to annoy his teammates.",
                            "target_lang_translations": {
                                "ru": "Его постоянное <w>хвастовство</w> своими спортивными навыками в конце концов начало раздражать товарищей по команде."
                            }
                        },
                        {
                            "text": "The general made a bold <w>brag</w> regarding the strength of his army before the battle.",
                            "target_lang_translations": {
                                "ru": "Генерал сделал смелое <w>заявление</w> о силе своей армии перед битвой."
                            }
                        }
                    ],
                    "synonyms": [
                        "boast"
                    ],
                    "common_phrases": [
                        "empty brag",
                        "bold brag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай хвастливой речи или заявление, выражающее чрезмерную гордость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвастовство",
                                "target_lang_sense_clarification": "процесс или слова хвастающегося"
                            },
                            {
                                "target_lang_word": "бахвальство",
                                "target_lang_sense_clarification": "пустое или грубое хвастовство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4df377ef-a91e-306b-a095-0091572d10ad",
                    "sense_definition": "A thing or person that is a source of pride or is boasted about.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "boasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new library is the <w>brag</w> of the entire town because of its modern design.",
                            "target_lang_translations": {
                                "ru": "Новая библиотека — <w>гордость</w> всего города благодаря своему современному дизайну."
                            }
                        },
                        {
                            "text": "She considered her homemade sauce to be a great <w>brag</w> when hosting dinner parties.",
                            "target_lang_translations": {
                                "ru": "Она считала свой домашний соус отличным поводом для <w>гордости</w>, когда принимала гостей на ужин."
                            }
                        }
                    ],
                    "common_phrases": [
                        "great brag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет или человек, являющийся предметом гордости или хвастовства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гордость",
                                "target_lang_sense_clarification": "предмет, которым гордятся"
                            },
                            {
                                "target_lang_word": "украшение",
                                "target_lang_sense_clarification": "лучшая часть чего-либо, вызывающая гордость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90a652fd-159a-381f-aed7-15f3d614d881",
                    "sense_definition": "A British card game, similar to poker, typically played with three cards.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "games",
                    "name_type": "game_or_sport_name",
                    "examples": [
                        {
                            "text": "The sailors spent their evening playing <w>brag</w> and drinking ale in the tavern.",
                            "target_lang_translations": {
                                "ru": "Моряки проводили вечер, играя в <w>брэг</w> и попивая эль в таверне."
                            }
                        },
                        {
                            "text": "He lost a significant amount of money during a high-stakes game of three card <w>brag</w>.",
                            "target_lang_translations": {
                                "ru": "Он проиграл значительную сумму денег во время игры в трехкарточный <w>брэг</w> на высокие ставки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "three card brag"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Британская карточная игра, похожая на покер, в которую обычно играют тремя картами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брэг",
                                "target_lang_sense_clarification": "название карточной игры"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c3a96c11-ac99-33b2-a00d-f3aeb4ca3b46",
                    "sense_definition": "Excellent or first-rate in quality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The craftsman produced a <w>brag</w> piece of furniture that was admired by everyone.",
                            "target_lang_translations": {
                                "ru": "Мастер изготовил <w>первоклассный</w> предмет мебели, которым все восхищались."
                            }
                        },
                        {
                            "text": "They served a <w>brag</w> dinner to the guests to celebrate the successful merger.",
                            "target_lang_translations": {
                                "ru": "Они подали <w>отличный</w> обед гостям, чтобы отпраздновать успешное слияние."
                            }
                        }
                    ],
                    "synonyms": [],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "No longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Превосходный или первоклассный по качеству."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первоклассный",
                                "target_lang_sense_clarification": "высшего качества"
                            },
                            {
                                "target_lang_word": "отличный",
                                "target_lang_sense_clarification": "очень хороший"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f276ae0-75be-3ed8-a4c3-aacbac158172",
                    "sense_definition": "Brisk, full of spirits, or showing a conceited and pretentious attitude.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a <w>brag</w> young fellow who thought he knew more than his elders.",
                            "target_lang_translations": {
                                "ru": "Он был <w>заносчивым</w> молодым человеком, который думал, что знает больше старших."
                            }
                        },
                        {
                            "text": "The <w>brag</w> bullock tossed its head and pricked its ears at the passing crowd.",
                            "target_lang_translations": {
                                "ru": "<w>Резвый</w> бычок вскинул голову и навострил уши при виде проходящей толпы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "No longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бодрый, полный сил или проявляющий тщеславное и претенциозное отношение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокомерный",
                                "target_lang_sense_clarification": "проявляющий надменность"
                            },
                            {
                                "target_lang_word": "заносчивый",
                                "target_lang_sense_clarification": "самоуверенный и спесивый"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "217ace52-90a5-3f05-b50f-f545408d825a",
                    "sense_definition": "In a proud or boastful manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young soldier walked <w>brag</w> through the village after returning from his first mission.",
                            "target_lang_translations": {
                                "ru": "Молодой солдат <w>гордо</w> шел по деревне, вернувшись со своего первого задания."
                            }
                        },
                        {
                            "text": "Do you see how <w>brag</w> that animal carries itself across the field?",
                            "target_lang_translations": {
                                "ru": "Видишь, как <w>важно</w> это животное держится, переходя поле?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "No longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Гордо или хвастливо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гордо",
                                "target_lang_sense_clarification": "с чувством собственного достоинства или превосходства"
                            },
                            {
                                "target_lang_word": "хвастливо",
                                "target_lang_sense_clarification": "с желанием похвалиться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
