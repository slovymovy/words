                        "sense_id": "270d230f-1574-3a4a-a6da-208556454da9",
                        "entry_id": "3430cae4-2a14-301e-8fa0-96ffe67fb273",
                        "glosses": [
                            "Cigarette électronique."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "24b621e5-e724-45ca-a93c-6c44cb9653ee",
                                "sense_id": "270d230f-1574-3a4a-a6da-208556454da9",
                                "text": "Une enquête auprès de 2.000 individus âgés de 15 à 75 ans, réalisée fin 2013, confirme le succès impressionnant de la « vapoteuse »."
                            }
                        ]
                    },
                    {
                        "sense_id": "7961eee3-9855-34fb-84f2-82b564a2051f",
                        "entry_id": "3430cae4-2a14-301e-8fa0-96ffe67fb273",
                        "glosses": [
                            "Utilisatrice d’une cigarette électronique."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "bc8339e6-66fc-4166-9dac-0bf92868a6e2",
                                "sense_id": "7961eee3-9855-34fb-84f2-82b564a2051f",
                                "text": "Un premier cas a été décrit chez une vapoteuse ayant des antécédents d’allergies de contact aux bijoux fantaisie."
                            },
                            {
                                "example_id": "83f04b60-4e84-44af-93cf-e84156982bf1",
                                "sense_id": "7961eee3-9855-34fb-84f2-82b564a2051f",
                                "text": "Le liquide contenu dans le réservoir de la cigarette électronique est composé d’un mélange de propylène glycol, de glycérine végétale, d’arômes alimentaires et de nicotine (à un taux variable selon les besoins des vapoteuses et vapoteurs)."
                            }
                        ]
                    }
