    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dfc524f9-b737-3f90-8a17-3ace623a0faf",
                "word": "interglacial",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "422518c0-953a-3867-a7d6-d18792adaf9d",
                        "entry_id": "dfc524f9-b737-3f90-8a17-3ace623a0faf",
                        "glosses": [
                            "Occurring between glaciations (colloquially known as ice ages)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5266cb13-234c-4a1c-8e97-b20461601427",
                                "sense_id": "422518c0-953a-3867-a7d6-d18792adaf9d",
                                "text": "Palaeoenvironmental evidence from northwest Europe indicates that the oligocratic phase of the interglacial cycle (Fig. 3.1) had begun by ca. 5K years BP."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29bed2a0-f281-47f9-8aeb-a2b26d48d870",
                        "source_entry_id": "dfc524f9-b737-3f90-8a17-3ace623a0faf",
                        "source_sense_id": "422518c0-953a-3867-a7d6-d18792adaf9d",
                        "source_sense_description": "occurring between glaciations",
                        "target_lang_word": "interglaciaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interglaciaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2add071d-f0a5-3673-8077-4c8d8a66a909",
                                        "entry_id": "e1379d66-62e2-3bd4-9457-9d0edd923c9f",
                                        "glosses": [
                                            "Qui occupe l’intervalle entre deux périodes glaciaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e477b29e-a77d-4f69-abd0-5d026e3ac28f",
                                                "sense_id": "2add071d-f0a5-3673-8077-4c8d8a66a909",
                                                "text": "Chaque période interglaciaire amène un adoucissement du climat, qui prend le type froid et sec ou bien doux et humide."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "interglaciaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da25cad5-e251-3e34-a50c-f0aa48ca71f1",
                                        "entry_id": "358da111-c2e9-35ea-b540-1b58c24eb42d",
                                        "glosses": [
                                            "Période interglaciaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63d6e28e-9001-47aa-aefc-fc0ac47b8aca",
                                                "sense_id": "da25cad5-e251-3e34-a50c-f0aa48ca71f1",
                                                "text": "(…) pendant 1,3 millions d’années, la mousson amplifiée des étés durant les interglaciaires (…)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b24ed876-3bbf-4660-8ea2-e1af36c12517",
                        "source_entry_id": "dfc524f9-b737-3f90-8a17-3ace623a0faf",
                        "source_sense_id": "422518c0-953a-3867-a7d6-d18792adaf9d",
                        "source_sense_description": "occurring between glaciations",
                        "target_lang_word": "post-glaciaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "post-glaciaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7407a25e-9863-360e-bdf0-578aea9f8753",
                                        "entry_id": "90aa2797-6bca-383d-ae6b-6655c8db1dfc",
                                        "glosses": [
                                            "Qui succède à la période glaciaire, à une glaciation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49285426-1c65-434a-9fc9-9abce5d2991f",
                                                "sense_id": "7407a25e-9863-360e-bdf0-578aea9f8753",
                                                "text": "On a pu suivre d'une façon précise l'histoire post-glaciaire dans le Nord de l'Europe, où de nombreux végétaux à demi fossilisés des tourbières ont permis de suivre couche par couche l'évolution des végétaux principaux."
                                            },
                                            {
                                                "example_id": "def6a2e3-c082-462f-8092-c1ef8088e4d3",
                                                "sense_id": "7407a25e-9863-360e-bdf0-578aea9f8753",
                                                "text": "Le climat, dit post-glaciaire, s’est adouci."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4177878f-d951-4075-97a5-d6bcbc2ec2ed",
                        "source_entry_id": "dfc524f9-b737-3f90-8a17-3ace623a0faf",
                        "source_sense_id": "422518c0-953a-3867-a7d6-d18792adaf9d",
                        "source_sense_description": "occurring between glaciations",
                        "target_lang_word": "interglazial",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interglazial",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dc088ea-3351-3bc6-9a42-86f1f5c55c9e",
                                        "entry_id": "f356ab15-a81d-3dca-a2a2-7476a82dd3e6",
                                        "glosses": [
                                            "zwischen zwei Eiszeiten liegend"
                                        ],
                                        "tags": [
                                            "Klimatologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e035727-0e2d-4739-a29b-ae874b3d74d6",
                                                "sense_id": "0dc088ea-3351-3bc6-9a42-86f1f5c55c9e",
                                                "text": "Bei der Suche nach einem pleistozänen Äquivalent für die rezenten interglazialen Bedingungen wird in der Paläoklimaforschung seit geraumer Zeit vermehrt das Isotopenstadium 11, eine interglaziale Warmphase vor ca. 400.000 Jahren, als bestes mögliches Analog zum Holozän betrachtet."
                                            },
                                            {
                                                "example_id": "83e0ddeb-0e01-42f1-9657-6681193670b9",
                                                "sense_id": "0dc088ea-3351-3bc6-9a42-86f1f5c55c9e",
                                                "text": "Im Schnitt währte eine Eiszeit etwa 100 000 Jahre, eine interglaziale Periode hingegen nur 10 000 bis 20 000 Jahre: […]"
                                            },
                                            {
                                                "example_id": "df0fa07a-13d5-4eff-96a4-74a8cce96916",
                                                "sense_id": "0dc088ea-3351-3bc6-9a42-86f1f5c55c9e",
                                                "text": "Auf einem Umweg kehrte er [der Rhein], über die Kalksteinkante der alten Flußrinne stürzend, ins angestammte interglaziale Bett zurück, räumte sich den verschütteten Weg wieder frei - vor 6000 bis 8000 Jahren."
                                            },
                                            {
                                                "example_id": "0aaaec0b-08e6-4e4f-83fc-54684e83b815",
                                                "sense_id": "0dc088ea-3351-3bc6-9a42-86f1f5c55c9e",
                                                "text": "Wellenmuster des Bodens deuten an, daß sich die Abdrücke dort schon vor 130.000 Jahren befanden, als das Land in einer interglazialen Periode unter Wasser gelegen hat."
                                            },
                                            {
                                                "example_id": "e0791785-c037-4f12-a668-64c92c75227b",
                                                "sense_id": "0dc088ea-3351-3bc6-9a42-86f1f5c55c9e",
                                                "text": "In der Schöpfungsgeschichte dieser Traumlandschaft gab es drei Eiszeiten und zwei interglaziale Perioden, während derer das Klima warm und angenehm war."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "4b9dd50d-39b1-306c-9048-609315773db7",
                "word": "interglacial",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e8d52e7f-6dc7-4a87-a30a-017de5e0493f",
                        "entry_id": "4b9dd50d-39b1-306c-9048-609315773db7",
                        "tags": [
                            "plural"
                        ],
                        "form": "interglacials"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61f2e0ab-2985-3aa1-973c-1f9119b24671",
                        "entry_id": "4b9dd50d-39b1-306c-9048-609315773db7",
                        "glosses": [
                            "The relatively warm period between glacial periods."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92cf5d00-8510-458b-a173-b6dd7da11d67",
                                "sense_id": "61f2e0ab-2985-3aa1-973c-1f9119b24671",
                                "text": "The climatic recession which produced Britain's last glaciers came rapidly to an end about 10,000 bp, as temperatures rose during the end of the protocratic phase of the present interglacial."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cbf84e1-0973-4825-b1e6-8da4e532ece6",
                        "source_entry_id": "4b9dd50d-39b1-306c-9048-609315773db7",
                        "source_sense_id": "61f2e0ab-2985-3aa1-973c-1f9119b24671",
                        "source_sense_description": "relatively warm period between glacial periods",
                        "target_lang_word": "Warmzeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Warmzeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7e9ff07-41e5-3762-9fef-83d70777953a",
                                        "entry_id": "74e6e074-7581-34ff-9654-bcc6970bf679",
                                        "glosses": [
                                            "Epoche mit überdurchschnittlichen Temperaturen und minimaler Eisbedeckung der Pole"
                                        ],
                                        "tags": [
                                            "Klimatologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b12a303-b797-4069-876d-f65a0f7f42f1",
                                                "sense_id": "c7e9ff07-41e5-3762-9fef-83d70777953a",
                                                "text": "Zwischen der Riß- und der Würmkaltzeit lag eine ungefähr 11.000 Jahre währende Warmzeit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b655f9ff-4fe3-4cb4-8152-eaf8b7a658ec",
                        "source_entry_id": "4b9dd50d-39b1-306c-9048-609315773db7",
                        "source_sense_id": "61f2e0ab-2985-3aa1-973c-1f9119b24671",
                        "source_sense_description": "relatively warm period between glacial periods",
                        "target_lang_word": "Interglazial",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Interglazial",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "214441bb-45ef-39fe-9931-9052af064bb2",
                                        "entry_id": "c46ad7f6-bbe3-391e-9ae2-c72d1ae1f957",
                                        "glosses": [
                                            "eine erdgeschichtliche Periode zwischen zwei Eiszeiten mit höheren Temperaturen"
                                        ],
                                        "tags": [
                                            "Klimatologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "601b9b49-a93b-455b-9c0e-277a2461f040",
                                                "sense_id": "214441bb-45ef-39fe-9931-9052af064bb2",
                                                "text": "Wenn sich die Eismassen, über einen längeren Zeitraum betrachtet, verringern, sich also das Volumen verkleinert und die Eisränder abschmelzen, spricht man von einem Interglazial. Ein Interglazial liegt immer zwischen zwei Glazialen."
                                            },
                                            {
                                                "example_id": "3c2a3891-09b8-4183-b690-a6bf5fe6026d",
                                                "sense_id": "214441bb-45ef-39fe-9931-9052af064bb2",
                                                "text": "Die vertikale Durchmischung des Ozeans erfolgt in Glazialen rascher als in Interglazialen; die Mischung der Isotopenänderungen verläuft im Ozean 10mal rascher als Isotopenschwankungen zwischen Glazial und Interglazial eintreten."
                                            },
                                            {
                                                "example_id": "1568f7a3-eba8-4007-a683-3df6701864c2",
                                                "sense_id": "214441bb-45ef-39fe-9931-9052af064bb2",
                                                "text": "Einer Untersuchung der Beziehungen zwischen Klimaschwankungen, Änderungen der Biosphäre und denen der Gehalte an strahlungswirksamen Spurengasen der Atmosphäre über den letzten Interglazial-Glazial-Interglazial-Zyklus stehen mehrere prinzipielle Schwierigkeiten entgegen."
                                            },
                                            {
                                                "example_id": "01ea5160-45db-449e-81b6-7401013be970",
                                                "sense_id": "214441bb-45ef-39fe-9931-9052af064bb2",
                                                "text": "Das Mittelpleistozän beginnt vor ca. 780 000 Jahren und liegt zwischen Interglazial I und II der Cromer-Zeit, einem langandauernden Komplex aus warmen und kälteren Abschnitten."
                                            },
                                            {
                                                "example_id": "42b2add0-b882-45c7-a4f6-b99363eb42c5",
                                                "sense_id": "214441bb-45ef-39fe-9931-9052af064bb2",
                                                "text": "Diese Warmzeit (wahrscheinlich Interglazial III des Cromer) hatte so ein mildes Klima, dass auch das Flusspferd seinen Lebensraum wieder nach Mitteleuropa ausdehnen konnte."
                                            },
                                            {
                                                "example_id": "df021343-adef-41cd-90a2-c5ab0d9ef9ee",
                                                "sense_id": "214441bb-45ef-39fe-9931-9052af064bb2",
                                                "text": "[…] „innerhalb der letzten zwei bis drei Millionen Jahre kam es bisher sechsmal zu ausgeprägten Gletschervorstößen, den Glazialen, die etwa 100 Tausend Jahre andauerten und von den Warmzeiten, den Interglazialen abgelöst wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
