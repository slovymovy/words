                    {
                        "translation_id": "1b57805a-e47e-41d8-a7cf-9d086615a4e1",
                        "source_entry_id": "d47dfce5-2f21-3e9c-96fd-7a0c47931a78",
                        "source_sense_id": "b5f44338-2b22-338d-b635-fb1f1078a25c",
                        "target_lang_word": "eindigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eindigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "608d9881-5a41-3d6c-ade8-ce29f93fc885",
                                        "entry_id": "602f00a4-7a52-328b-a42d-82321d0e8ac8",
                                        "glosses": [
                                            "het feit dat iets een einde heeft, met name dat het leven tijdelijk is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "227c5581-b278-4a70-a11f-6c284e904df9",
                                                "sense_id": "608d9881-5a41-3d6c-ade8-ce29f93fc885",
                                                "text": "‘In Helsinki hebben we een mooie begraafplaats met veel artiestengraven, en zo wil ik toch vooral herinnerd worden: als een goede schrijfster. Het is nog een reden waarom ik de dood niet vrees: kunst is een manier om de eindigheid te overstijgen en ik heb in mijn werk genoeg bereikt om morgen zonder spijt te kunnen vertrekken. Ik vind het belangrijk te leven op zo’n manier dat je het niet betreurt als je de volgende dag moet sterven.’"
                                            },
                                            {
                                                "example_id": "62f697c1-72f6-4459-a635-ab1ede68bdb4",
                                                "sense_id": "608d9881-5a41-3d6c-ade8-ce29f93fc885",
                                                "text": "Laatst werd ik opgewekt wakker. Ik had zin in het leven. Scheren, aankleden en meteen aan de slag. Meestal word ik lichtelijk verdrietig wakker. Waar komt dat vandaan? Iets in mijn dromen? Werd ik me daardoor bewust van mijn eigen eindigheid? De nacht duurt lang als hij gedompeld is in verdriet."
                                            },
                                            {
                                                "example_id": "ae6fdf4a-3291-447b-8593-aca6dc85eb64",
                                                "sense_id": "608d9881-5a41-3d6c-ade8-ce29f93fc885",
                                                "text": "Caterpillar gaat over eindigheid en begoocheling. En over rupsen en de symboliek daarvan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b88521b-a040-47c9-91f3-f56b7b28dd31",
                        "source_entry_id": "d47dfce5-2f21-3e9c-96fd-7a0c47931a78",
                        "source_sense_id": "b5f44338-2b22-338d-b635-fb1f1078a25c",
