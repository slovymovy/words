                {
                    "sense_id": "13d9ed6a-e9be-302f-a284-53a7390e5256",
                    "sense_definition": "The part of the hair closest to the scalp, especially when showing a natural color different from the rest.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I just coloured my hair and already my <w>roots</w> are showing.",
