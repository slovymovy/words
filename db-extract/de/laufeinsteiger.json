                "senses": [
                    {
                        "sense_id": "e0aacd86-0823-33e2-9c5d-bc3714afda48",
                        "entry_id": "ef68559c-69cc-32f1-b41c-776ecc95964b",
                        "glosses": [
                            "Person, die neu beim Laufen ist und wenig bis keine Erfahrung damit hat"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "7d0c3d83-9c0c-49d6-aa35-a978903110c0",
                                "sense_id": "e0aacd86-0823-33e2-9c5d-bc3714afda48",
                                "text": "„Diese Frage stellen sich viele Läuferinnen und Läufer, nicht einmal nur Laufeinsteiger.“"
                            },
                            {
                                "example_id": "8c177510-b6b2-44ce-bbbd-748a2146b2c6",
                                "sense_id": "e0aacd86-0823-33e2-9c5d-bc3714afda48",
                                "text": "„Der Treffpunkt wurde geschaffen, damit Laufeinsteiger und Wiedereinsteiger sich in lockerer Atmosphäre begegnen und- etwas für sich und ihre Gesundheit tun können.“"
                            },
                            {
                                "example_id": "003a227e-9b90-4223-936e-c710d633047a",
                                "sense_id": "e0aacd86-0823-33e2-9c5d-bc3714afda48",
                                "text": "„Ich habe schon mit Laufeinsteigern gesprochen, die unbedingt gleich von Anfang an wieder die Strecke laufen wollten, mit der sie vor Jahren aufgehört hatten.“"
                            },
                            {
                                "example_id": "87bad3d7-2481-4cc9-bf31-5e3b9a82dbef",
                                "sense_id": "e0aacd86-0823-33e2-9c5d-bc3714afda48",
                                "text": "„Die enthaltenen Vorträge, Kurse und Veranstaltungen richten sich gleichermaßen an Laufeinsteiger wie auch an erfahrene oder wettkampferprobte Läuferinen und Läufer sowie natürlich auch weitere interessierte Personen.“"
                            },
                            {
                                "example_id": "6da771a7-da80-4c50-8810-a73126a105cc",
                                "sense_id": "e0aacd86-0823-33e2-9c5d-bc3714afda48",
                                "text": "„Mit diesem Plan werden Sie als Laufeinsteiger so fit, dass Sie nach 12 Wochen mit gutem Gefühl nach 21,1 Kilometern in Ziel ankommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
