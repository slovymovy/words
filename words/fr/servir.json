    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "357b31d8-3c02-3583-a1f3-6e76b07a5302",
                    "sense_definition": "Apporter ou présenter des plats et des boissons à des convives ou des clients.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "restauration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le serveur va <w>servir</w> le café chaud aux clients sur la terrasse."
                        },
                        {
                            "text": "À quelle heure voulez-vous que nous <w>servions</w> le dîner ce soir ?"
                        }
                    ],
                    "synonyms": [
                        "présenter"
                    ],
                    "antonyms": [
                        "desservir"
                    ],
                    "common_phrases": [
                        "servir le repas",
                        "servir à table",
                        "servir un café"
                    ]
                },
                {
                    "sense_id": "673495cd-5b3d-3078-bd82-1eba02997b5e",
                    "sense_definition": "Avoir une utilité ou remplir une fonction précise.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "utilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet outil simple peut <w>servir</w> à ouvrir facilement les bouteilles en verre."
                        },
                        {
                            "text": "Cette vieille boîte en bois <w>sert</w> de rangement pour tous mes stylos."
                        }
                    ],
                    "common_phrases": [
                        "ne servir à rien",
                        "servir de guide"
                    ]
                },
                {
                    "sense_id": "c476c8d2-ce7b-3ea1-80bf-446cc23c3f14",
                    "sense_definition": "Utiliser un outil, un objet ou un moyen pour réaliser quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "utilisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il apprend vite à se <w>servir</w> de cet appareil pour son travail quotidien."
                        },
                        {
                            "text": "Je me <w>sers</w> souvent de mon vélo pour aller rapidement au marché."
                        }
                    ],
                    "synonyms": [
                        "utiliser",
                        "employer"
                    ],
                    "common_phrases": [
                        "se servir d'un outil",
                        "se servir de l'ordinateur"
                    ]
                },
                {
                    "sense_id": "08e208fd-07cc-33d4-86c5-8ee45a88bf66",
                    "sense_definition": "Prendre pour soi-même des aliments ou de la boisson lors d'un repas.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "restauration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les invités peuvent se <w>servir</w> un grand verre d'eau fraîche au buffet."
                        },
                        {
                            "text": "Elle se <w>sert</w> une part généreuse de gâteau au chocolat avant de s'asseoir."
                        }
                    ],
                    "synonyms": [
                        "prendre"
                    ],
                    "common_phrases": [
                        "se servir un verre",
                        "se servir à volonté"
                    ]
                },
                {
                    "sense_id": "ac3d60d7-a9ea-3838-9a91-34710f42087d",
                    "sense_definition": "S'acquitter de devoirs envers une collectivité, une patrie ou une cause supérieure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "devoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce magistrat intègre a choisi de <w>servir</w> son pays avec un grand dévouement."
                        },
                        {
                            "text": "Les bénévoles de cette association <w>servent</w> une cause noble depuis des années."
                        }
                    ],
                    "antonyms": [
                        "trahir"
                    ],
                    "common_phrases": [
                        "servir son pays",
                        "servir l'État",
                        "servir une cause"
                    ]
                },
                {
                    "sense_id": "bdc60611-9767-37bb-a01e-3c044fe75656",
                    "sense_definition": "Mettre la balle en jeu pour commencer un point dans les sports de raquette ou de ballon.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur de tennis se prépare à <w>servir</w> pour remporter la manche décisive."
                        },
                        {
                            "text": "Quand elle <w>sert</w> avec puissance, son adversaire a beaucoup de mal à retourner la balle."
                        }
                    ],
                    "common_phrases": [
                        "servir pour le match",
                        "servir un ace"
                    ]
                },
                {
                    "sense_id": "9f2d4825-53b7-3e01-b8a1-7b4a1b4d56e3",
                    "sense_definition": "Faire son service militaire ou être engagé dans les forces armées.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son grand-père a <w>servi</w> dans l'aviation militaire pendant plus de vingt ans."
                        },
                        {
                            "text": "Plusieurs jeunes de notre village ont <w>servi</w> sous les drapeaux à cette époque."
                        }
                    ],
                    "common_phrases": [
                        "servir dans l'armée",
                        "servir sous les drapeaux"
                    ]
                },
                {
                    "sense_id": "b93c9a44-c43a-39a7-b477-41b4f8f7baa4",
                    "sense_definition": "Agir de façon favorable envers quelqu'un, favoriser ses desseins ou ses intérêts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le hasard a merveilleusement <w>servi</w> ses intérêts dans cette négociation délicate."
                        },
                        {
                            "text": "Sa parfaite maîtrise des langues étrangères l'a bien <w>servi</w> durant toute sa carrière."
                        }
                    ],
                    "synonyms": [
                        "favoriser",
                        "avantager",
                        "seconder"
                    ],
                    "antonyms": [
                        "desservir",
                        "nuire"
                    ],
                    "common_phrases": [
                        "servir les intérêts de",
                        "bien servir"
                    ]
                }
            ]
        }
    ]
}