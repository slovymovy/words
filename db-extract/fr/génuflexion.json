                                    {
                                        "sense_id": "ab475599-88c4-3f71-8614-032b68f3af4e",
                                        "entry_id": "fd81e5ea-ad3d-3d7f-a487-e856ffaaffc9",
                                        "glosses": [
                                            "The act of genuflecting."
                                        ],
                                        "tags": [
