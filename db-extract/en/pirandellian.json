                                        "entry_id": "5c6ca9f2-d73a-3890-835e-c60cce60b276",
                                        "glosses": [
                                            "Propre à l'œuvre de l'auteur dramatique et romancier italien Luigi Pirandello (1867-1936)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aaa10ce-6d4a-4d31-b379-d0cfbe73cc14",
                                                "sense_id": "d303de22-7c74-34cc-9d64-557ce9c87010",
                                                "text": "Tout cela est extraordinairement pirandellien, et en même temps extraordinairement dramatique et vivant."
                                            },
                                            {
                                                "example_id": "07777a2e-b34f-46a2-a87e-37a8fd076313",
                                                "sense_id": "d303de22-7c74-34cc-9d64-557ce9c87010",
                                                "text": "En somme, c’est un film pour rien. Et la disparition brutale de l’actrice Carrie Fisher, fin 2016, est venue donner à ce sentiment d’impossible happy-ending une matérialité pirandellienne."
                                            }
                                        ]
                                    }
