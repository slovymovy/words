                "senses": [
                    {
                        "sense_id": "38ce2d42-db6e-39b8-84da-8fff9987198e",
                        "entry_id": "e2522b45-0997-39c5-b6aa-a8ba3ddc1603",
                        "glosses": [
                            "Verbot, Konfetti zu benutzen"
