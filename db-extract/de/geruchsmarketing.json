                "senses": [
                    {
                        "sense_id": "e64d0c96-5bce-365c-ab57-12d6d9c7866e",
                        "entry_id": "77cb4488-fc3e-3f83-9408-3a67d50b9aa6",
                        "glosses": [
                            "Eigenschaften, Maßnahmen oder auch Konzepte, die den Geruch zur Vermarktung von etwas einsetzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f48ef779-0fcf-48d1-b042-b78c0ebad079",
                                "sense_id": "e64d0c96-5bce-365c-ab57-12d6d9c7866e",
                                "text": "„Ihr gemeinsames Geschäftsfeld nennt sich Geruchsmarketing.“"
                            },
                            {
                                "example_id": "fe8e507e-4f7e-41e3-82cb-fc09bd353633",
                                "sense_id": "e64d0c96-5bce-365c-ab57-12d6d9c7866e",
                                "text": "„\"Die Supermärkte nutzen Backwaren immer häufiger dazu, Kunden anzulocken\", sagte Essel und sprach von Geruchsmarketing.“"
                            },
                            {
                                "example_id": "6fd2de32-92f2-4cf1-8922-48eab897c92b",
                                "sense_id": "e64d0c96-5bce-365c-ab57-12d6d9c7866e",
                                "text": "„Auf der Einzelhandelsmesse Global Shop in Las Vegas war das Thema Geruchsmarketing im Frühjahr erstmals nicht nur eine Randerscheinung.“"
                            },
                            {
                                "example_id": "8b4c89aa-9b62-4745-addf-9e4be2874955",
                                "sense_id": "e64d0c96-5bce-365c-ab57-12d6d9c7866e",
                                "text": "„Für das sogenannte Geruchsmarketing sind bereits verschiedene Duftkompositionen erhältlich, die den Umsatz mit Hilfe von Gerüchen ankurbeln sollen.“"
                            },
                            {
                                "example_id": "3111e033-84e7-4cd2-8502-ee2af2501ff4",
                                "sense_id": "e64d0c96-5bce-365c-ab57-12d6d9c7866e",
                                "text": "„Honig könnte Geruchsmarketing auch brauchen, denn geschlossene Gläser riechen nach nichts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
