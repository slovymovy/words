                        "glosses": [
                            "een geloofsaanhanger van de islam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feb48268-b4ed-4ee7-af71-50ba3025fb1b",
                                "sense_id": "39cb0ce0-5865-3c3d-a648-87f5938c0615",
                                "text": "In Nederland wonen sinds de tweede helft van de vorige eeuw belangrijke groepen islamieten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69fd44f2-d285-4a86-86f4-57ac81d59d4d",
                        "source_entry_id": "78f23941-1abf-3748-9fc0-b658796d40d3",
                        "source_sense_id": "39cb0ce0-5865-3c3d-a648-87f5938c0615",
                        "source_sense_description": "een geloofsaanhanger van de islam",
                        "target_lang_word": "Islamit",
                        "target_lang_code": "de",
