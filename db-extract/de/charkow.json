                "senses": [
                    {
                        "sense_id": "eeb178e7-cbe3-3cc4-9966-bb1466320eae",
                        "entry_id": "d016181f-9133-3ca7-9b04-636e14905d56",
                        "glosses": [
                            "zweitgrößte Stadt der Ukraine sowie Hauptort und Verwaltungssitz der Oblast Charkow"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "51509d48-7096-43b8-a842-f67d1898469b",
                                "sense_id": "eeb178e7-cbe3-3cc4-9966-bb1466320eae",
                                "text": "„Es giebt aber von dieſen Tſcherkaſſiern, die ſolchergeſtalt in Pflanzſtaͤdte vertheilet ſind, fuͤnf Landſchaften, deren Hauptſtaͤdte ſind Ißy, Charkow, Ochtirka, Ribinſka und Sumy.“"
                            },
                            {
                                "example_id": "622a1fcf-e219-4b8c-a211-831b6a73c5fc",
                                "sense_id": "eeb178e7-cbe3-3cc4-9966-bb1466320eae",
                                "text": "„Von tausend Fingern tausendmal abgegriffen, waren auf dem dünnen Zeitungspapier die Namen der ehemaligen Kampforte zu schwarzen Dreckflecken geworden. Gomel, Kiew, Charkow …“"
                            },
                            {
                                "example_id": "af349bec-5b5c-4a0a-9220-2137da269c60",
                                "sense_id": "eeb178e7-cbe3-3cc4-9966-bb1466320eae",
                                "text": "„Es kamen Kursanten aus Charkow und Lwow nach Tschernobyl, leichte, schnelle, zähe Jungs.“"
                            },
                            {
                                "example_id": "4ee7bec9-acb7-446b-977d-995944bbefea",
                                "sense_id": "eeb178e7-cbe3-3cc4-9966-bb1466320eae",
                                "text": "„Charkow, heute heißt es Charkiw, ist mit rund 1,4 Millionen Einwohnern die zweitgrößte Stadt der Ukraine und das bedeutendste Wissenschafts- und Bildungszentrum des Landes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
