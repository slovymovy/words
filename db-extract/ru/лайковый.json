                                        "glosses": [
                                            "A small wooden mess tub in which sailors received their food."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2869f19d-ec95-4d6a-ad36-c5da7b00dbcc",
                                                "sense_id": "131a17fc-5ae1-3c91-a76b-d6da18b46ba9",
                                                "text": "peaceable, well-disposed chaps as ever eat duff (dough) out of a kid"
                                            },
                                            {
                                                "example_id": "f8993a8e-d65a-4cbc-b1a9-b8ee9acb1df3",
                                                "sense_id": "131a17fc-5ae1-3c91-a76b-d6da18b46ba9",
                                                "text": "We fasted till night, when one of the boys came along with a couple of \"kids\" containing a thin, saffron-coloured fluid, with oily particles floating on top. The young wag told us this was soup: it turned out to be nothing more than oleaginous warm water."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kid",
                                "target_lang_code": "en",
                                "target_senses": [
