                                "sense_id": "36a78914-591f-3784-9414-16fbb91214a9",
                                "text": "вы́свободить сре́дства (ресу́рсы)",
                                "translation": "to release funds (resources)",
                                "english": "to release funds (resources)"
                            },
                            {
                                "example_id": "0270aea1-cb1c-4be2-828d-1c0e7c640b5b",
                                "sense_id": "36a78914-591f-3784-9414-16fbb91214a9",
                                "text": "вы́свободить дополни́тельные сре́дства (для)",
                                "translation": "to make additional funding available (for)",
                                "english": "to make additional funding available (for)"
                            }
                        ]
