                "translations": [
                    {
                        "translation_id": "0b51b702-c68e-438d-be78-5651bbea654d",
                        "source_entry_id": "794ef7e4-2c78-3019-b484-2c713d8f96fc",
                        "source_sense_id": "6fd83d8f-4064-3db8-8b11-c7ccbfa3ca7d",
                        "target_lang_word": "écoulement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écoulement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3697edf-a608-34c6-81c5-ca05cdedd052",
                                        "entry_id": "dfb8671f-c838-376c-81c0-c07d12d4cf1f",
                                        "glosses": [
                                            "Action de s’écouler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd522d68-0098-43e0-af1e-42885022293b",
                                                "sense_id": "b3697edf-a608-34c6-81c5-ca05cdedd052",
                                                "text": "Cependant l’écoulement de l’eau vers les dunes ne contamine pas l’eau du sous-sol de celles-ci , parce qu’elle se purifie par filtration horizontale dans le sable."
                                            },
                                            {
                                                "example_id": "f70c0c6e-c1f0-48f6-9fb3-c879d310b32f",
                                                "sense_id": "b3697edf-a608-34c6-81c5-ca05cdedd052",
                                                "text": "L’écoulement turbulent déplacera non seulement presque toute la boue circulable, mais détruira aussi les couches tendres de cake par une action décapante."
                                            },
                                            {
                                                "example_id": "f9eac233-73ed-44c4-8fac-db45a018be17",
                                                "sense_id": "b3697edf-a608-34c6-81c5-ca05cdedd052",
                                                "text": "Signalons enfin que dans les trous d’anguiller rectangulaires ménagés à la base de chaque couple, de part et d’autre de la quille, et destinés à assurer l’écoulement de l’eau dans la sentine, on a retrouvé intact le cordage, passant d’anguiller en anguiller, qui permettait sans doute le ramonage de ce conduit."
                                            },
                                            {
                                                "example_id": "4bdc2ae0-d3c2-47a0-84f2-f63bebbfca00",
                                                "sense_id": "b3697edf-a608-34c6-81c5-ca05cdedd052",
                                                "text": "Les flux présentent un cycle annuel où se succèdent une phase d’écoulement en direction de la nappe, et une phase ascendante quand l’évapotranspiration devient supérieure aux précipitations."
                                            },
                                            {
                                                "example_id": "ca15bdcf-94dd-4139-b43e-88355c17574d",
                                                "sense_id": "b3697edf-a608-34c6-81c5-ca05cdedd052",
                                                "text": "La lame du kinjal porte sur chaque face une rainure pour permettre l’écoulement du sang de la victime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71c33c4c-8cc9-3f13-bb29-a2901b962ee7",
                                        "entry_id": "dfb8671f-c838-376c-81c0-c07d12d4cf1f",
                                        "glosses": [
                                            "Mouvement des humeurs qui sortent d’un organe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e41789d1-3747-434b-9e0a-641df0e33f6d",
                                                "sense_id": "71c33c4c-8cc9-3f13-bb29-a2901b962ee7",
                                                "text": "Écoulement catarrhal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6d1151d-d3fe-3e97-9c51-7490b028f08e",
                                        "entry_id": "dfb8671f-c838-376c-81c0-c07d12d4cf1f",
                                        "glosses": [
                                            "Hémorragie légère."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "633c3274-0962-30c1-8da8-1dcb4b0ddefe",
                                        "entry_id": "dfb8671f-c838-376c-81c0-c07d12d4cf1f",
                                        "glosses": [
                                            "Mouvement progressif ou continu."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcea4751-05c1-4b50-9d07-fb4a2628c7b1",
                                                "sense_id": "633c3274-0962-30c1-8da8-1dcb4b0ddefe",
                                                "text": "L’écoulement d’une foule."
                                            },
                                            {
                                                "example_id": "12172305-1a03-4a2f-a19b-96aa81af6ad0",
                                                "sense_id": "633c3274-0962-30c1-8da8-1dcb4b0ddefe",
                                                "text": "L’écoulement du temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cc589e8-a945-3f82-a75e-fa0d83f63b0a",
                                        "entry_id": "dfb8671f-c838-376c-81c0-c07d12d4cf1f",
                                        "glosses": [
                                            "Exportation, vente, débit des marchandises, des produits de l’agriculture ou des fabriques."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1016ead-aca7-4988-82a7-277988aa9f02",
                                                "sense_id": "9cc589e8-a945-3f82-a75e-fa0d83f63b0a",
                                                "text": "Ménager un débouché qui favorise l’écoulement des farines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16403faf-4c18-4884-ba03-11d0f1cecad6",
                        "source_entry_id": "794ef7e4-2c78-3019-b484-2c713d8f96fc",
                        "source_sense_id": "6fd83d8f-4064-3db8-8b11-c7ccbfa3ca7d",
                        "target_lang_word": "épanchement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épanchement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c59fa44-8811-3ca6-9a9f-38b0a4cb094d",
                                        "entry_id": "3810f4e2-564e-3b5c-981b-23ee674ae29a",
                                        "glosses": [
                                            "Action de verser le liquide contenu dans un flacon."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b5458f5-20be-3831-ac16-702d4f520632",
                                        "entry_id": "3810f4e2-564e-3b5c-981b-23ee674ae29a",
                                        "glosses": [
                                            "Déversement d’un liquide organique dans les tissus ou dans une cavité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b02b79f7-0e14-4771-bf2f-d9b87756d914",
                                                "sense_id": "5b5458f5-20be-3831-ac16-702d4f520632",
                                                "text": "Et une des conséquences les plus importantes de ce fait, c'est l'apparition d'un son plus fort et plus haut : le tympanisme de Skoda ou skodisme. Ce phénomène existe nettement dans les épanchements pleurétiques moyens."
                                            },
                                            {
                                                "example_id": "8e8d0980-e196-4967-b955-06a824776cbb",
                                                "sense_id": "5b5458f5-20be-3831-ac16-702d4f520632",
                                                "text": "On réalisera aussi une échographie qui pourra soit être normale soit retrouver un épanchement dans le Douglas, des ovaires dystrophiques, des images évocatrices d’hydrosalpinx."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8bc80c1-3c8f-39ce-ae5c-6118cc378c70",
                                        "entry_id": "3810f4e2-564e-3b5c-981b-23ee674ae29a",
                                        "glosses": [
                                            "Écoulement abondant, abondance de quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbf76031-e906-4755-ae06-273c52b8ede6",
                                                "sense_id": "b8bc80c1-3c8f-39ce-ae5c-6118cc378c70",
                                                "text": "Le pavé se dérobait sous les pneus. Les arroseurs, qui travaillent avant l’aurore, délayaient le crottin dans de vastes épanchements d’eau. Un dérapage succédait à une secousse. Parfois les roues fendaient une flaque. On croyait entendre une bête qui boit."
                                            },
                                            {
                                                "example_id": "ddd6c64e-ddfd-40c2-a61f-737c79bff905",
                                                "sense_id": "b8bc80c1-3c8f-39ce-ae5c-6118cc378c70",
                                                "text": "Dans un grand épanchement de clarté, je vois, sous les pins des promontoires, une côte éclatante, d'immenses baies toutes bleues, une théâtrale enluminure, où la ligne déchiquetée des porphyres limite en ses anfractuosités rougeoyantes l'azur doré de la mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ba77f93-748e-37b4-ad9e-59048e5b4824",
                                        "entry_id": "3810f4e2-564e-3b5c-981b-23ee674ae29a",
                                        "glosses": [
                                            "Émission de lave par un volcan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d8c2bbe-3f71-330b-98c9-bfc141b219a7",
                                        "entry_id": "3810f4e2-564e-3b5c-981b-23ee674ae29a",
                                        "glosses": [
                                            "Action de s’épancher ; communication libre et confiante des sentiments, des pensées intimes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab24309a-6975-4528-84ff-fdd6d49fd624",
                                                "sense_id": "9d8c2bbe-3f71-330b-98c9-bfc141b219a7",
                                                "text": "Merveilleuses histoires racontées autour du foyer, tendres épanchements du cœur, longues habitudes d’aimer si nécessaires à la vie, vous avez rempli les journées de ceux qui n’ont point quitté leur pays natal !"
                                            },
                                            {
                                                "example_id": "a07f0ee8-1f60-4a44-a380-89bf5a9404f0",
                                                "sense_id": "9d8c2bbe-3f71-330b-98c9-bfc141b219a7",
                                                "text": "Saccard eut un sourire. Il était dans une heure d’épanchement."
                                            },
                                            {
                                                "example_id": "3ad3edb4-31ba-4c6d-b80e-466963691ecc",
                                                "sense_id": "9d8c2bbe-3f71-330b-98c9-bfc141b219a7",
                                                "text": "En France, dans un café ou un restaurant, quand on entend parler allemand, le garçon louche en apportant son bock, les voisins grimacent et modèrent leurs épanchements… c'est la vision de l'espion."
                                            },
                                            {
                                                "example_id": "44f62d79-7468-466a-aee2-654bf69587ea",
                                                "sense_id": "9d8c2bbe-3f71-330b-98c9-bfc141b219a7",
                                                "text": "Ce tutoiement soudain n’étonna pas Kotlowski, habitué aux épanchements d’ivrognes."
                                            },
                                            {
                                                "example_id": "e8f4203e-bfa0-433e-9f0e-d1b67a506c51",
                                                "sense_id": "9d8c2bbe-3f71-330b-98c9-bfc141b219a7",
                                                "text": "Même dans l'épanchement des confidences, même dans l'étreinte physique, la communication avec l'autre n'est que partielle et éphémère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
