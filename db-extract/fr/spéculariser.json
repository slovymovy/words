                ],
                "senses": [
                    {
                        "sense_id": "09bc248f-4a4c-3d75-8f54-6f8fe610b078",
                        "entry_id": "14502e17-d870-3fd9-a9b1-85c8f8edb76b",
                        "glosses": [
                            "Donner un caractère spéculaire à, refléter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "878a12c9-70fc-432c-ab06-59196067e01d",
                                "sense_id": "09bc248f-4a4c-3d75-8f54-6f8fe610b078",
                                "text": "La désintégration des os spécularise la désintégration des pensées."
                            },
                            {
                                "example_id": "d2401044-9512-4f62-b640-df9357684e55",
                                "sense_id": "09bc248f-4a4c-3d75-8f54-6f8fe610b078",
                                "text": "Désintégration de l’objet représenté et désintégration de l’agent représentant se spécularisent, se réfractent l’un l’autre."
                            },
                            {
                                "example_id": "f527172c-1b22-4b48-a01e-e3e0c2b6014f",
                                "sense_id": "09bc248f-4a4c-3d75-8f54-6f8fe610b078",
                                "text": "Tout cela tourne uniquement autour de ce qui ne se spécularise pas ; et ce qui ne se spécularise pas c’est l’objet a autour duquel tout cela s’anticipe : c’est la voix, la voix de la mère, la voix de l’enfant, la voix des autres."
                            }
                        ]
                    }
