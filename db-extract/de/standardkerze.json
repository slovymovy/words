                ],
                "senses": [
                    {
                        "sense_id": "acfd4b54-d649-3043-acdf-9b132a472433",
                        "entry_id": "2c842a0d-7eb9-34c5-8508-4b2a607dfc05",
                        "glosses": [
                            "astronomisches Objekt, von dem angenommen wird, dass es eine bekannte, unveränderliche Helligkeit besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d4f5a19-58c8-4223-acb8-81c87e8cf3e7",
                                "sense_id": "acfd4b54-d649-3043-acdf-9b132a472433",
                                "text": "„Astronomen bauen dabei auf sogenannte Standardkerzen, also Objekte, deren Helligkeit sie recht genau zu kennen glauben.“"
                            },
                            {
                                "example_id": "39a05210-5785-479c-9029-df99f57acf68",
                                "sense_id": "acfd4b54-d649-3043-acdf-9b132a472433",
                                "text": "„Glaubt man Kirshners Lichtkurven, dann müssen Tammanns Messungen mit den \"Standardkerzen\" revidiert werden, und es ergibt sich ein neuer Wert der Hubble-Konstante von rund 67.“"
                            },
                            {
                                "example_id": "7375fb91-0f2f-4bed-af90-8fdfcbfb58de",
                                "sense_id": "acfd4b54-d649-3043-acdf-9b132a472433",
                                "text": "„Supernova-Explosionen vom Typ Ia sind eine wahre Goldgrube für Astronomen. Sie spielen nicht nur eine wichtige Rolle beim Verständnis der Sternentwicklung, sondern werden auch als kosmische Standardkerzen eingesetzt, um die Ausdehnung des Universums zu kartieren, denn die Sternenexplosionen scheinen stets gleich hell aufzuleuchten.“"
                            },
                            {
                                "example_id": "95738cab-8760-42cd-9b2e-9c1e32aa1ab0",
                                "sense_id": "acfd4b54-d649-3043-acdf-9b132a472433",
                                "text": "„Die Oberflächentemperatur und damit die absolute Helligkeit von RR-Lyrae-Sternen variiert in schöner Regelmäßigkeit, weshalb Astronomen diese Sterne als sogenannte Standardkerzen nutzen, mit denen galaktische Entfernungen gemessen werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
