                    "frequency": "Middle",
                    "semantic_group_id": "spiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie zog ihren <w>Turm</w> nach vorne und bedrohte damit sofort die gegnerische Dame."
