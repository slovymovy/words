                    {
                        "sense_id": "56d4fd89-677f-3608-b5d2-917d4ccf52eb",
                        "entry_id": "ddee566c-5bc9-30f7-b7c0-744dd7f6a1e9",
                        "glosses": [
                            "Non vernaculaire de Citrus hystrix un agrume cultivé autour de l’océan Indien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "979d0eb3-5480-48cb-b5fd-24fe3504623d",
                                "sense_id": "56d4fd89-677f-3608-b5d2-917d4ccf52eb",
                                "text": "Mélangez le poulet, l’oignon, l’ail, la citronnelle, les feuilles de combava, le piment, l’huile, le sucre et le curcuma dans un saladier."
                            },
                            {
                                "example_id": "0b479c9f-3aff-473a-bba1-191424e6cb9c",
                                "sense_id": "56d4fd89-677f-3608-b5d2-917d4ccf52eb",
                                "text": "Ajouter l’ail, la citronnelle, les feuilles de combava, le piment et la coriandre moulue, puis faire cuire pendant 5 min supplémentaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0d6004c-b5a2-3e08-a440-590440ed9025",
                        "entry_id": "ddee566c-5bc9-30f7-b7c0-744dd7f6a1e9",
                        "glosses": [
                            "Fruit vert de cet agrume, plus petit que le citron et à l’arôme particulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf91a165-2e08-4a11-9e15-fa0f846e9ec5",
                                "sense_id": "d0d6004c-b5a2-3e08-a440-590440ed9025",
                                "text": "Les espèces exotiques coûteuses en empreinte carbone (kumquat, yuzu, combava, etc.) sont à réserver aux repas d’exception."
                            }
                        ]
                    }
