                        "examples": [
                            {
                                "example_id": "affadfcb-1cae-417b-b52a-4c49baa8a077",
                                "sense_id": "4e89b19e-6cda-326f-b189-85ccb2f4c74f",
                                "text": "He moved with a befitting grace."
                            },
                            {
                                "example_id": "5a8c770f-2a6b-4c46-9116-c0c8bd2eacb3",
                                "sense_id": "4e89b19e-6cda-326f-b189-85ccb2f4c74f",
                                "text": "At a time when the old have never been more vulnerable and, in many cases, lonely, here is a befitting reminder that the frail souls you see sitting in a semi-circle in a day room on the TV news, their eyes distant and their hair like candy floss, do not necessarily feel as you think they look."
                            }
                        ]
                    }
                ],
