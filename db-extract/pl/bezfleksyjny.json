                                        "entry_id": "10bfd4c6-3b1d-37ec-ae54-16a1c7d3cc9a",
                                        "glosses": [
                                            "Adverbio de negación, negando la frase o expresión que sigue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4641c6f-d2ec-4173-a9d7-b5de27a5e315",
                                                "sense_id": "592d7f80-9956-3ca9-990e-ea94bdaa406e",
                                                "text": "-No vengo."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "55173edd-7b77-3aed-8ff1-909921c17264",
                                        "entry_id": "10bfd4c6-3b1d-37ec-ae54-16a1c7d3cc9a",
                                        "glosses": [
                                            "Adverbio de negación, que niega la existencia o realidad del concepto expresado por el adjetivo o sustantivo al que antecede."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af9461a4-836b-457e-9560-920e6db8a70f",
                                                "sense_id": "55173edd-7b77-3aed-8ff1-909921c17264",
                                                "text": "La no existencia del Yeti, es una suposición fundada."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "47afbfec-8775-3866-9452-974ce647c3c5",
                                        "entry_id": "10bfd4c6-3b1d-37ec-ae54-16a1c7d3cc9a",
                                        "glosses": [
                                            "Adverbio de negación necesario al comienzo de las frases con nada, nadie, nunca, y otras negaciones después del verbo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feb6c5ba-32d4-4405-9ad5-581a40d5b71f",
                                                "sense_id": "47afbfec-8775-3866-9452-974ce647c3c5",
                                                "text": "Nadie vino. No vino nadie."
                                            },
                                            {
                                                "example_id": "974d585c-267d-494e-bab0-56d0e1c036f8",
                                                "sense_id": "47afbfec-8775-3866-9452-974ce647c3c5",
                                                "text": "Nunca vino. No vino nunca."
                                            },
                                            {
                                                "example_id": "6676d574-f4d6-4724-ab35-da2216ba8bc0",
                                                "sense_id": "47afbfec-8775-3866-9452-974ce647c3c5",
                                                "text": "Nada sé. No sé nada."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "f04c29ab-7cc9-38f7-ac8d-946e4ac2bb22",
                                        "entry_id": "10bfd4c6-3b1d-37ec-ae54-16a1c7d3cc9a",
                                        "glosses": [
                                            "Adverbio de negación, usado en frases interrogativas cuando se espera una respuesta positiva."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45bcd4fc-dc38-4f4e-91ac-e6b1111716f3",
                                                "sense_id": "f04c29ab-7cc9-38f7-ac8d-946e4ac2bb22",
                                                "text": "¿Que no venía hoy?"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "3f521577-c086-34d2-a67d-3abbfb50e349",
                                        "entry_id": "10bfd4c6-3b1d-37ec-ae54-16a1c7d3cc9a",
                                        "glosses": [
                                            "Adverbio de negación expletivo, que en comparaciones no niega, sino que refuerza la contraposición de las ideas."
                                        ],
                                        "tags": [
                                            "expletivo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7d4e4f4-6afc-48d3-bbcc-a79e73c6bf77",
                                                "sense_id": "3f521577-c086-34d2-a67d-3abbfb50e349",
                                                "text": "Mejor caminar un poco, que no quedarnos esperando aquí."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "022858f2-7fc1-31b5-841e-a5c32b6c92b0",
                                        "entry_id": "10bfd4c6-3b1d-37ec-ae54-16a1c7d3cc9a",
                                        "glosses": [
                                            "Manera irónica y sarcástica para responder una pregunta tonta por tratarse de algo obvio."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f8d6da0-16d8-4d45-9a7f-a17e4f377a15",
                                                "sense_id": "022858f2-7fc1-31b5-841e-a5c32b6c92b0",
                                                "text": "—¿Está enyesando con yeso? —¡No, con leche de burra! (Roberto Gómez Bolaños, \"Los Yeseros\" —El Chavo del Ocho—)."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
