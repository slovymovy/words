                    ],
                    "common_phrases": [
                        "свежий редис",
                        "пучок редиса"
                    ],
                    "target_lang_definitions": {
                        "en": "An annual vegetable plant with an edible rounded or elongated root, as well as the root itself"
                    },
                    "translations": {
