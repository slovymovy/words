                    {
                        "sense_id": "396fcbda-fc22-3021-ae6b-e54278ed9970",
                        "entry_id": "b004ca3d-acd8-34e1-afac-0f381bebc591",
                        "glosses": [
                            "een dunne laag cellen die slijm produceren, meestal met bescherming of transport van afvalstoffen als doel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "032976f3-1387-4a70-9cee-ba60817eb99f",
                                "sense_id": "396fcbda-fc22-3021-ae6b-e54278ed9970",
                                "text": "De binnenzijde van de maag wordt bij vele diersoorten door een slijmvlies beschermd; als de slijmaanmaak stokt, begint het maagzuur de eigen maagwand te verteren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8357d87c-2ec2-48c1-bfa6-b1f7eb13b3f3",
                        "source_entry_id": "b004ca3d-acd8-34e1-afac-0f381bebc591",
                        "source_sense_id": "396fcbda-fc22-3021-ae6b-e54278ed9970",
                        "source_sense_description": "slijm afscheidend membraan",
                        "target_lang_word": "Schleimhaut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schleimhaut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a35b7205-aeab-34f3-90a1-e8a1a09118ba",
                                        "entry_id": "1b1236f1-d20e-3d6a-bd01-5de24422a97a",
                                        "glosses": [
                                            "Schutzschicht, die das Innere von Hohlorganen auskleidet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4708a73b-3199-45ca-841c-7b175963346a",
                                                "sense_id": "a35b7205-aeab-34f3-90a1-e8a1a09118ba",
                                                "text": "Die Schleimhaut in der Nase, genannt Nasenschleimhaut, sondert ein Sekret aus, das, wenn es trocken ist, umgangssprachlich Popel genannt wird."
                                            },
                                            {
                                                "example_id": "45e59638-1bb9-4906-9ac3-5f2d695faace",
                                                "sense_id": "a35b7205-aeab-34f3-90a1-e8a1a09118ba",
                                                "text": "„Das Wasser aus den Säcken war leicht schlammig und ließ im Mund einen Geschmack nach Erde und Feuerstein zurück, der die Schleimhäute zusammenzog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c41b28a0-af9c-4c48-a6ab-45afcd926497",
                        "source_entry_id": "b004ca3d-acd8-34e1-afac-0f381bebc591",
                        "source_sense_id": "396fcbda-fc22-3021-ae6b-e54278ed9970",
                        "source_sense_description": "slijm afscheidend membraan",
                        "target_lang_word": "mucous membrane",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mucous membrane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f49b33b2-a43a-3f99-ba18-dddf1198bdf8",
                                        "entry_id": "dd7f495f-01b6-382c-b0e9-d981ec8a8f9a",
                                        "glosses": [
                                            "A membrane which secretes mucus. It forms the lining of various body passages that communicate with the air, such as the respiratory, genitourinary, and alimentary tracts including the mouth, nasal passages, vagina, and urethra."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf2031d3-cbd7-4744-b12e-49bd21e94e31",
                        "source_entry_id": "b004ca3d-acd8-34e1-afac-0f381bebc591",
                        "source_sense_id": "396fcbda-fc22-3021-ae6b-e54278ed9970",
                        "source_sense_description": "slijm afscheidend membraan",
                        "target_lang_word": "muqueuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muqueuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91898464-a29b-309e-928e-d09187ff2c16",
                                        "entry_id": "97730a33-5cc7-3364-be03-9c97372e8f95",
                                        "glosses": [
                                            "Tissu mou humecté de mucus, qui tapisse les cavités anatomiques (muqueuse utérine, muqueuse buccale, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b869d351-3cf8-4213-832a-675be727f5ea",
                                                "sense_id": "91898464-a29b-309e-928e-d09187ff2c16",
                                                "text": "Quelques observations d’empoisonnement à la suite d’injection vaginales avec de l’eau de Goulard, de l’usage de collyres à base de plomb, montrent que l’absorption se fait par les diverses muqueuses."
                                            },
                                            {
                                                "example_id": "dae9b74f-74ad-4cdf-ad9d-7c694cd2841d",
                                                "sense_id": "91898464-a29b-309e-928e-d09187ff2c16",
                                                "text": "Néanmoins, l’effet protecteur et anti-inflammatoire des mucilages sur les muqueuses du système digestif est assez largement reconnu."
                                            },
                                            {
                                                "example_id": "fee83688-094a-4e51-a146-2f795c6d8856",
                                                "sense_id": "91898464-a29b-309e-928e-d09187ff2c16",
                                                "text": "Les muqueuses sont de fines membranes qui tapissent les parois internes de l’organisme. Elles sont plus fines que la peau et humidifiées en permanence par le mucus. Leur finesse est telle que vous pouvez distinguer les vaisseaux sanguins qui les irriguent, vous permettant ainsi d’apprécier l’état de l’organisme. Certaines sont bien visibles, à l’intérieur de la bouche, au niveau de la vulve et du vagin, ou à l’intérieur de la paupière. C’est précisément à l’intérieur de la paupière qu’elles sont les plus faciles à voir car ailleurs, elles sont souvent brunes ou noires comme la peau."
                                            },
                                            {
                                                "example_id": "79e0fdb2-04a1-4ced-b489-a34888641e34",
                                                "sense_id": "91898464-a29b-309e-928e-d09187ff2c16",
                                                "text": "Un comprimé orodispersible se place sur la langue et le principe actif est absorbé au niveau de la muqueuse gastro-intestinale. Il se dissout dans la bouche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "muqueuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b51baba5-c335-3914-bef0-49e2d5869b16",
                                        "entry_id": "87546d51-7226-32de-994d-2b2d6d03d43f",
                                        "glosses": [
                                            "Féminin singulier de muqueux."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4307c17a-c71c-4ea8-8476-b1dc3eb1a639",
                                                "sense_id": "b51baba5-c335-3914-bef0-49e2d5869b16",
                                                "text": "Dans l'état de vacuité, la membrane muqueuse de l’estomac est d'une couleur grisâtre. Au moment où les aliments s’accumulent dans le réservoir gastrique, cette membrane devient rose, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
