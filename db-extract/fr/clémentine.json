                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dc21a6f-ccb5-4d95-a9e5-c65d0b40387e",
                                                "sense_id": "6f01e731-2549-3918-9dd3-eae5cd97370c",
                                                "text": "„Um orange zu werden, brauchen Clementinen nachts Kälte. Ist es zu mild, bleibt die Schale grünlich.“"
                                            }
                                        ],
