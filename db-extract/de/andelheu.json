                "senses": [
                    {
                        "sense_id": "16630657-b320-33c7-8335-f68b1a90c0a0",
                        "entry_id": "4ebb1dc6-ae49-3068-a5b4-4a0e236ea748",
                        "glosses": [
                            "Heu, getrocknetes Gras von Salzwiesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00d28b10-293c-48ab-9f27-403d4015be75",
                                "sense_id": "16630657-b320-33c7-8335-f68b1a90c0a0",
                                "text": "Aufgrund des hohen Mineralstoffgehaltes ist Andelheu sehr wertvolles Tierfutter."
                            },
                            {
                                "example_id": "2052d1db-d0bd-4a77-9b1f-7fc19d1e11e2",
                                "sense_id": "16630657-b320-33c7-8335-f68b1a90c0a0",
                                "text": "„Das Andelheu wird von den Landwirthen als Viehfutter und zwar ganz besonders als Beifutter neben anderem Heu im hohen Grade geschätzt.“"
                            },
                            {
                                "example_id": "b5666678-641e-4a2f-9fb9-4fee91121ed5",
                                "sense_id": "16630657-b320-33c7-8335-f68b1a90c0a0",
                                "text": "„der Küstenbewohner kennt die Atropis maritima, welche das köstliche Andelheu liefert.“"
                            },
                            {
                                "example_id": "e83399c0-987c-4ca0-8f02-ff58cab6ca2b",
                                "sense_id": "16630657-b320-33c7-8335-f68b1a90c0a0",
                                "text": "„Sie haben uns wenigstens unser schönes Andelheu gerettet, und auf das bißchen Erde können wir gut und gern verzichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
