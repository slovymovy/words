                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Как мы упоминали <w>ранее</w>, этот вопрос требует особого внимания.",
                            "target_lang_translations": {
                                "en": "As we mentioned <w>earlier</w>, this issue requires special attention.",
                                "zh": "正如我们<w>先前</w>提到的，这个问题需要特别关注。",
                                "nl": "Zoals we <w>eerder</w> vermeldden, vereist deze kwestie speciale aandacht.",
                                "pl": "Jak wspominaliśmy <w>wcześniej</w>, ta kwestia wymaga szczególnej uwagi.",
                                "de": "Wie wir <w>zuvor</w> erwähnt haben, erfordert dieses Thema besondere Aufmerksamkeit.",
                                "fr": "Comme nous l'avons mentionné <w>auparavant</w>, cette question nécessite une attention particulière.",
                                "it": "Come abbiamo menzionato <w>in precedenza</w>, questa questione richiede particolare attenzione.",
                                "cs": "Jak jsme <w>dříve</w> zmínili, tato otázka vyžaduje zvláštní pozornost.",
                                "tr": "<w>Daha önce</w> belirttiğimiz gibi, bu konu özel ilgi gerektiriyor.",
                                "es": "Como mencionamos <w>anteriormente</w>, este asunto requiere atención especial."
                            }
                        },
                        {
                            "text": "<w>Ранее</w> в этом здании находилась городская библиотека.",
                            "target_lang_translations": {
                                "en": "<w>Previously</w> the city library was located in this building.",
                                "zh": "这座建筑<w>以前</w>是市图书馆。",
                                "nl": "<w>Voorheen</w> was de stadsbibliotheek in dit gebouw gevestigd.",
                                "pl": "<w>Wcześniej</w> w tym budynku znajdowała się biblioteka miejska.",
                                "de": "<w>Früher</w> befand sich in diesem Gebäude die Stadtbibliothek.",
                                "fr": "<w>Auparavant</w>, la bibliothèque municipale se trouvait dans ce bâtiment.",
                                "it": "<w>Precedentemente</w>, in questo edificio si trovava la biblioteca comunale.",
                                "cs": "<w>Dříve</w> se v této budově nacházela městská knihovna.",
                                "tr": "Bu binada <w>eskiden</w> şehir kütüphanesi bulunuyordu.",
                                "es": "<w>Anteriormente</w>, en este edificio se encontraba la biblioteca municipal."
                            }
                        }
