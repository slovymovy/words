                ],
                "senses": [
                    {
                        "sense_id": "4b2da232-ab2b-3c56-89b0-5700a1f60b52",
                        "entry_id": "50e97ab7-5e18-3b94-b637-fd2e8b989314",
                        "glosses": [
                            "staatliche Hilfeleistung, die auf Erfüllung der Grundbedürfnisse der Menschen abzielt"
                        ],
                        "tags": [
                            "Sozialpolitik",
                            "Sozialrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "0ea1edde-c6e2-4e52-80af-5b7af8bc1f23",
                                "sense_id": "4b2da232-ab2b-3c56-89b0-5700a1f60b52",
                                "text": "„Der Anspruch auf lebenslange Sozialhilfe wurde auf fünf Jahre gekürzt, Väter wurden rigoros zum Unterhalt gezwungen.“"
                            },
                            {
                                "example_id": "6a537a1c-103c-41ea-aac0-3d294ddd1471",
                                "sense_id": "4b2da232-ab2b-3c56-89b0-5700a1f60b52",
                                "text": "„Die Zusammenlegung von Arbeitslosenhilfe und Sozialhilfe zum Arbeitslosengeld II, auch Hartz IV genannt, hat eine Prozesslawine ausgelöst.“"
                            },
                            {
                                "example_id": "acfa1c4b-5562-4acf-ad8b-d5e752dc8522",
                                "sense_id": "4b2da232-ab2b-3c56-89b0-5700a1f60b52",
                                "text": "„Die Sozialhilfe stockte sie mit Telefon-Heimarbeit auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
