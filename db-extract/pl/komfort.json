                                "target_senses": [
                                    {
                                        "sense_id": "70cf7cda-8132-3fcf-a3b6-f08be86b648a",
                                        "entry_id": "5913069d-87ca-3fcf-aae1-e4e534717fbe",
                                        "glosses": [
                                            "Assistance matérielle ou morale."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b85fe05-49a5-415b-a29b-f05ecb6df157",
                                                "sense_id": "70cf7cda-8132-3fcf-a3b6-f08be86b648a",
                                                "text": "Donner aide et confort."
                                            },
                                            {
                                                "example_id": "3b6f5ea9-ce86-4049-9187-e4d93cc06d84",
                                                "sense_id": "70cf7cda-8132-3fcf-a3b6-f08be86b648a",
                                                "text": "Dans cette affliction il ne reçut de confort de personne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "confort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d00c0a62-fe23-3a73-bce3-19eb14d5b032",
                                        "entry_id": "27190b40-b13a-3773-b1e0-7fc4e5c9bf9d",
                                        "glosses": [
                                            "Bien-être matériel et moral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "277e15d7-a163-4790-bb4f-1a8766b2e215",
                                                "sense_id": "d00c0a62-fe23-3a73-bce3-19eb14d5b032",
                                                "text": "Mais je conseille peu l’Islande aux malades, aux invalides et à quiconque est habitué au confort des hôtels et des wagons-lits."
                                            },
                                            {
                                                "example_id": "179bfdb9-be4c-40cb-8cfa-93662911835d",
                                                "sense_id": "d00c0a62-fe23-3a73-bce3-19eb14d5b032",
                                                "text": "Comparé à la libéralité et au confort de la vie ordinaire de l’époque, l’ordre de l’Empire romain, sous les Antonins, apparaît local et limité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
