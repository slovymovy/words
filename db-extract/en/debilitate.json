                        "source_entry_id": "3cfd2a63-de13-3042-822f-b94bb18356ff",
                        "source_sense_id": "37fcc9bd-4fb2-343b-bf3e-80fea38b3e84",
                        "source_sense_description": "to make feeble; to weaken",
                        "target_lang_word": "schwächen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schwächen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e1ded37-9a95-3882-87cc-69c3f7a85087",
                                        "entry_id": "bf1e0a16-18c4-3152-92f5-c4d8102d9795",
                                        "glosses": [
                                            "schwach machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "113aefdf-1ad3-452e-8b90-e05d4ad0f228",
                                                "sense_id": "4e1ded37-9a95-3882-87cc-69c3f7a85087",
                                                "text": "„Von den Nationalsozialisten wurde dieser Begriff missbräuchlich entlehnt mit der Absicht, das Bewusstsein für Österreich als selbständiges Territorium und politisches Gefüge zu schwächen und über die Betonung der historischen Bedeutung im alten Reich ein Zugehörigkeitsgefühl zum Deutschen Reich herauszubilden.“"
                                            },
                                            {
                                                "example_id": "b7d73c70-b858-4848-8665-fda6ea93e852",
                                                "sense_id": "4e1ded37-9a95-3882-87cc-69c3f7a85087",
                                                "text": "„Der EU-Zentralismus schwächt die Demokratie: Je weiter entfernt von den Betroffenen Entscheidungen fallen, um so geringer die Möglichkeit, auf diese Einfluss zu nehmen, um so schwächer die demokratische Legitimation.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "103464da-6400-437f-9c02-7bb2eecad821",
                        "source_entry_id": "3cfd2a63-de13-3042-822f-b94bb18356ff",
                        "source_sense_id": "37fcc9bd-4fb2-343b-bf3e-80fea38b3e84",
                        "source_sense_description": "to make feeble; to weaken",
                        "target_lang_word": "entkräften",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entkräften",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19ab1e71-34bf-3e17-8c5d-1827c8fa4a8d",
                                        "entry_id": "205449e9-2925-3b4c-85c3-3faf2f96b033",
                                        "glosses": [
                                            "jemandem oder etwas die Kraft nehmen, kraftlos machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dcf8cc3-10f3-4bcf-bf76-ca9805ed546c",
                                                "sense_id": "19ab1e71-34bf-3e17-8c5d-1827c8fa4a8d",
                                                "text": "Die Grippe hat ihn entkräftet und deshalb musste er sich die ganze Woche krankschreiben lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "58dfd003-3d8e-3cf1-b96e-da034e8bdcff",
                                        "entry_id": "205449e9-2925-3b4c-85c3-3faf2f96b033",
                                        "glosses": [
                                            "eine Theorie, einen Vorwurf, eine Anschuldigung widerlegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a078e395-5edc-4aea-b65e-87c1c59e1a1f",
                                                "sense_id": "58dfd003-3d8e-3cf1-b96e-da034e8bdcff",
                                                "text": "Der Verdacht wurde durch Zeugenaussagen entkräftet."
                                            },
                                            {
                                                "example_id": "664b52f1-fb35-478f-8aa9-9496b65ba184",
                                                "sense_id": "58dfd003-3d8e-3cf1-b96e-da034e8bdcff",
                                                "text": "„Mit Schweigen ist dieser Anklagevorwurf nicht zu entkräften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
