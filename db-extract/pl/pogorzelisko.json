                "translations": [
                    {
                        "translation_id": "368ba5dc-e492-47c5-a8df-7d482260ca4e",
                        "source_entry_id": "e7f0809d-b37f-3184-8fff-72dd47a8c282",
                        "source_sense_id": "57b76c7e-5c72-3a51-8015-a1f2fe9e96b5",
                        "target_lang_word": "пепели́ще",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пепели́ще",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "10a464a2-54eb-324a-bcad-9cd398ae84c0",
                                        "entry_id": "3777b030-af74-3e2e-bdea-519321f80c85",
                                        "glosses": [
                                            "место, где был пожар; пожарище; догорающий костер, очаг"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42af4cd9-1f14-4292-a9ad-9dccfd8caf8a",
                                                "sense_id": "10a464a2-54eb-324a-bcad-9cd398ae84c0",
                                                "text": "Свой теперешний классически строгий вид здание получило в 1816–1825 годах, когда Москва заново отстраивалась после вражеского нашествия, когда на месте прежних пепелищ появлялись ампирные, с хорошим вкусом построенные особняки и особнячки, ставшие своеобразным символом «послепожарной» Москвы и ее украшением."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c29a1608-32f3-3c68-bf6d-901a0d04b0f6",
                                        "entry_id": "3777b030-af74-3e2e-bdea-519321f80c85",
                                        "glosses": [
                                            "перен. родной дом, родное место, где жил прежде"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de0cb594-15ea-4ad7-aaa4-ef1e1dc22af3",
                                                "sense_id": "c29a1608-32f3-3c68-bf6d-901a0d04b0f6",
                                                "text": "Два чувства дивно бли́зки нам // В них обретает сердце пищу // Любовь к родному пепелищу, // Любовь к отеческим гробам."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82dd9ac7-0bae-4e6c-a8fc-c6daa8db0b2d",
                        "source_entry_id": "e7f0809d-b37f-3184-8fff-72dd47a8c282",
                        "source_sense_id": "57b76c7e-5c72-3a51-8015-a1f2fe9e96b5",
                        "target_lang_word": "пожа́рище",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
