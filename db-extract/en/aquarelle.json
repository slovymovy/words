            {
                "entry_id": "149b7f24-596c-3392-b29a-09f64544d97b",
                "word": "aquarelle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f889c7ca-232a-4fa7-96cc-1c9f74cbe3cf",
