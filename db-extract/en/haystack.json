                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edcf4c8c-9d2e-4191-ac71-d7ec2de7cb53",
                                                "sense_id": "6a5fa6ea-c73b-33f4-bf00-cc9ae561abce",
                                                "text": "Zur Mittagsrast haben wir uns in einen großen Heuhaufen gesetzt."
                                            },
                                            {
                                                "example_id": "d11a1f00-53dd-46a1-b7bd-86b2e9f261ba",
                                                "sense_id": "6a5fa6ea-c73b-33f4-bf00-cc9ae561abce",
                                                "text": "„Frauen mit Strohhüten, Kopftüchern aus Kattun oder Schutzhauben aus Papier harkten mit Rechen das eingeschnittene Heu zusammen; und am andern Rande der Ebene, bei den Heuhaufen, wurden die Bündel hurtig auf einen langen, von drei Pferden gezogenen Erntewagen geworfen.“"
                                            }
