                        "glosses": [
                            "nationale feestdag in België (15 november) ter ere van de Belgische koning."
                        ],
                        "tags": [
                            "feest"
                        ],
                        "examples": [
                            {
                                "example_id": "ed1cccfd-069b-48bf-9c39-3958a9085c70",
                                "sense_id": "6d65652e-cba4-38cd-bca7-e5377ad82a80",
                                "text": "De koninklijke familie viert op 15 november Koningsdag met een Te Deum in de Brusselse Sint-Michiels en Sint-Goedelekathedraal. Het is het feest ter ere van de koning, maar het wordt een viering in beperkte kring. Alleen koning Albert en koningin Paola en hun schoonzoon prins Lorenz hebben hun komst aangekondigd."
                            }
