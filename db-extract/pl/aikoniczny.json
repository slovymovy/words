                        "sense_id": "89bbb692-a73c-3046-9277-db126d577eb0",
                        "entry_id": "5cb2bab4-7f0d-3fc0-b83d-235f28c23525",
                        "glosses": [
                            "niezawierający przedstawień istot żywych, ze względu na zakaz religijny"
