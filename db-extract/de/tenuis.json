                ],
                "senses": [
                    {
                        "sense_id": "513c5e67-d901-3603-a408-d9c48b9ea56a",
                        "entry_id": "28bbffe9-ae0e-3c86-ac8e-896a0f28b42e",
                        "glosses": [
                            "stimmloser, nicht aspirierter Verschlusslaut; der Begriff begegnet häufig in der Indogermanistik (Historiolinguistik)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "994eac49-b819-48a0-918a-a7b96f77dd43",
                                "sense_id": "513c5e67-d901-3603-a408-d9c48b9ea56a",
                                "text": "„Die Labiovelare sind Velare, die mit Lippenrundung gesprochen werden; ihre Aussprache ähnelt also bei der Tenuis etwa dem hochdeutschen qu.“"
                            },
                            {
                                "example_id": "6ebc73b6-b712-434b-a658-a2c9a7445800",
                                "sense_id": "513c5e67-d901-3603-a408-d9c48b9ea56a",
                                "text": "„Der angenommene Merger im Altgriechischen sieht für die Tenues somit wie folgt aus […].“"
                            },
                            {
                                "example_id": "bb41b8c9-d62f-49e2-9999-dcc4e8ef45fe",
                                "sense_id": "513c5e67-d901-3603-a408-d9c48b9ea56a",
                                "text": "Zum System der Verschlußlaute im Indogermanischen: „Somit ergeben sich vier Reihen von Verschlußlauten: a) reine stimmlose Laute = Tenues, b) behauchte stimmlose Laute = Tenues aspiratae, c) reine stimmhafte Laute = Mediae, d) behauchte stimmhafte Laute = Mediae aspiratae.“"
                            },
                            {
                                "example_id": "c6f1d0a4-0509-44c0-a4c7-b1e38e1e8a9c",
                                "sense_id": "513c5e67-d901-3603-a408-d9c48b9ea56a",
                                "text": "„Im Zuge der Verschiebung der einfachen Tenues kam es zu Phonemspaltungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
