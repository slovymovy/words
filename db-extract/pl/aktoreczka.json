                "senses": [
                    {
                        "sense_id": "e51c599e-9521-3a7c-b2bf-1c4c395d4f1a",
                        "entry_id": "e0acc719-a1da-3d50-aaaf-bb3b1de46058",
                        "glosses": [
                            "Schauspielerin"
                        ],
                        "tags": [
                            "meist abwertend",
                            "Film",
                            "Theater"
                        ],
                        "examples": [],
