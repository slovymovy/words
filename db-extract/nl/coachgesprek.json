                        "examples": [
                            {
                                "example_id": "29dcc4c0-0550-481c-ad2e-761300f5bebe",
                                "sense_id": "52324352-a962-3bed-a17d-c0f2eb4192d5",
                                "text": "Meteen na de vergadering zijn er coachgesprekken, waarin coach en leerling één keer per week de behaalde doelen en de weekplanning doornemen. Vijftien minuten een individueel gesprek. Een uitkomst, vinden docenten én leerlingen."
                            },
                            {
                                "example_id": "883cdcc1-6fe6-4e7d-8e08-b419048077d7",
                                "sense_id": "52324352-a962-3bed-a17d-c0f2eb4192d5",
                                "text": "Elke startende student moet een coachgesprek krijgen waarin de mogelijkheden van hulpverlening aan de orde komen, vindt de ChristenUnie."
                            }
                        ]
                    }
