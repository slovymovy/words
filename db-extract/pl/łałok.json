                        "glosses": [
                            "luźna, obwisła skóra podgardla żubra, również skóra gardłowa innych zwierząt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "169262f9-53a0-4bb5-b9bb-592db2b5d7ff",
                                "sense_id": "2220641a-0396-3982-8452-039ffa8cb638",
                                "text": "Szyja wilczarza irlandzkiego jest średniej długości, bardzo silna i muskularna, wysklepiona, bez łałoka lub luźnej skóry"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
