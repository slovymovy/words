                "senses": [
                    {
                        "sense_id": "48959d54-9155-3291-8aa6-3548d26699bd",
                        "entry_id": "158c8cda-17ff-3211-87bd-85348d86ecb5",
                        "glosses": [
                            "Planche de bois amovible fermant l’arrière d’une charrette."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b98a9c9e-78f0-488c-915b-ae4b13843ce4",
                                "sense_id": "48959d54-9155-3291-8aa6-3548d26699bd",
                                "text": "Et puis, alors que les prisonniers montaient un à un dans le char, sa tête se mit à tourner et ses jambes l’abandonnèrent.\nC’était impossible, et pourtant il le voyait, escaladant avec peine le hayon."
                            }
                        ]
                    },
                    {
                        "sense_id": "83f7b764-4b72-3ad9-8bac-29fd3607c5c9",
                        "entry_id": "158c8cda-17ff-3211-87bd-85348d86ecb5",
                        "glosses": [
                            "Panneau amovible fermant le coffre d’une voiture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "269043e0-1509-4bf1-96f4-b0b4824bbf67",
                                "sense_id": "83f7b764-4b72-3ad9-8bac-29fd3607c5c9",
                                "text": "Les deux autres se tenaient près d'un monospace Mercedes dont le hayon était ouvert, la presse hydraulique posée au sol."
                            }
                        ]
                    },
                    {
                        "sense_id": "90f37ec7-e3a9-37a1-b1b2-40630b74a5c3",
                        "entry_id": "158c8cda-17ff-3211-87bd-85348d86ecb5",
                        "glosses": [
                            "Ouverture arrière des voitures et des camionnettes facilitant le chargement et de déchargement des marchandises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dfaace1-6830-4027-b2aa-0f6e330ee216",
                                "sense_id": "90f37ec7-e3a9-37a1-b1b2-40630b74a5c3",
                                "text": "On s’attaque au fait que l’arrière finit sur un hayon plutôt que sur une valise."
                            },
                            {
                                "example_id": "6628590d-1fff-41cd-a841-22b13e96dff4",
                                "sense_id": "90f37ec7-e3a9-37a1-b1b2-40630b74a5c3",
                                "text": "Hacine se gara en marche arrière, cul à cul et ouvrit le hayon."
                            }
                        ]
                    },
                    {
                        "sense_id": "8420fd7e-354e-30ee-a1fb-b4ff7fdc1e39",
                        "entry_id": "158c8cda-17ff-3211-87bd-85348d86ecb5",
                        "glosses": [
                            "Abri utilisé par les pâtres et les bergers installé au milieu des prés."
                        ],
                        "tags": [
                            "Le Mans"
                        ],
                        "examples": []
                    },
