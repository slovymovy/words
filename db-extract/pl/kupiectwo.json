                "senses": [
                    {
                        "sense_id": "0e4390c9-8e5a-38c0-9b93-c6934122c80c",
                        "entry_id": "40b052f7-cd29-3619-9d7f-f174f17746e9",
                        "glosses": [
                            "zajęcie osoby prowadzącej działalność handlową"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ae33770-df43-42ba-9ba3-109c4e015913",
                                "sense_id": "0e4390c9-8e5a-38c0-9b93-c6934122c80c",
                                "text": "Zepchnięci przez najeźdźców w nieurodzajne, pozbawione nawet drzew górskie wąwozy, nie mogli żyć z ziemi, zarabiać na życie kupiectwem czy rzemiosłem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e6a0982e-1d77-31c0-ac74-577e88f9452d",
                        "entry_id": "40b052f7-cd29-3619-9d7f-f174f17746e9",
                        "glosses": [
                            "ogół kupców"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "405551bb-217c-4b33-a808-8c84b19085b3",
                                "sense_id": "e6a0982e-1d77-31c0-ac74-577e88f9452d",
                                "text": "Rurykowicze, przenoszący się dawniej z jednej dzielnicy do drugiej, \"awansujący\" z biedniejszej na bogatszą, ustabilizowali się, ale jednocześnie uzależnili od lokalnych grup możnowładztwa (bojarów) i kupiectwa"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
