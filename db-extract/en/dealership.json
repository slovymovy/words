                    {
                        "translation_id": "9896a2df-e9bf-4dfe-a108-8dc5cc1c3500",
                        "source_entry_id": "e8098284-a3f2-3b87-9764-2ebf76b50836",
                        "source_sense_id": "ae92a4e1-7710-343c-b138-7df619d36f18",
