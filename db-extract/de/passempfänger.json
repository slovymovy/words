                ],
                "senses": [
                    {
                        "sense_id": "9de4f903-064f-3882-8ad0-e68f831f82d4",
                        "entry_id": "fb6803d8-b6f9-351f-8cef-4faff94d840d",
                        "glosses": [
                            "Person, die eine gezielte Ballabgabe an einen Spieler der eigenen Mannschaft erhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bfe76ce-4a57-4051-bf63-ab429edc9399",
                                "sense_id": "9de4f903-064f-3882-8ad0-e68f831f82d4",
                                "text": "„Seine Pässe fielen so akkurat in die Hände seiner Passempfänger, dass diese ihre Sprints ungehindert fortsetzen konnten.“"
                            },
                            {
                                "example_id": "9b0e4ddd-e8d9-48b2-9a27-a1ccc046b734",
                                "sense_id": "9de4f903-064f-3882-8ad0-e68f831f82d4",
                                "text": "„Vergangene Woche etwa hatte sich Passempfänger Dominikus Hägel bei einem Fahrradunfall einen Wadenbeinbruch zugezogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f6572cf4-5a26-3248-9b1d-16e74a6ce376",
                        "entry_id": "fb6803d8-b6f9-351f-8cef-4faff94d840d",
                        "glosses": [
                            "Person, die einen (Berechtigungs-)Ausweis bekommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8122d0f-1c06-48ec-ba73-826a115d490c",
                                "sense_id": "f6572cf4-5a26-3248-9b1d-16e74a6ce376",
                                "text": "„Die Zahl Anspruchsberechtigten und Passempfänger stellt sich differenziert nach Personengruppen für das Jahr 2010 wie folgt dar:“"
                            },
                            {
                                "example_id": "cc67e9fa-eb2f-4e1c-8803-0fcdd97e711e",
                                "sense_id": "f6572cf4-5a26-3248-9b1d-16e74a6ce376",
                                "text": "„[…], daß bei der Ausstellung von Pässen zur Reise nach Rußland, oder bei Verlängerung, beziehentlich Erneuerung von Pässen für in Rußland wohnende hierländische Staatsangehörige die Paßempfänger auf nachstehende Vorschriften aufmerksam gemacht werden.“"
                            },
                            {
                                "example_id": "989d8726-0a91-4364-9c46-237edd0a508c",
                                "sense_id": "f6572cf4-5a26-3248-9b1d-16e74a6ce376",
                                "text": "„Wenn die Paßempfänger keine Urlaubspäße in Händen haben, so ist dies ausdrücklich zu bemerken.“"
                            },
                            {
                                "example_id": "9052af4a-3bea-49c6-bfdb-d0ac4598b399",
                                "sense_id": "f6572cf4-5a26-3248-9b1d-16e74a6ce376",
                                "text": "„Hiebei wird zugleich bestimmt, daß von der erfolgten Ertheilung eines solchen Passes die Heimathbehörde des Paßempfängers in Kenntniß zu setzen ist […]“"
                            },
                            {
                                "example_id": "59365802-00bf-4911-972e-b03293ca6050",
                                "sense_id": "f6572cf4-5a26-3248-9b1d-16e74a6ce376",
                                "text": "„[…] die Polizeibehörden sind angewiesen worden, dies nicht allein auf dem Paß ausdrücklich zu bemerken, sondern auch die Paßempfänger bei Aushändigung der Pässe auf diese Bestimmung aufmerksam zu machen; […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
