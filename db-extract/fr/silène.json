                        "entry_id": "459ef34b-db24-3fcb-8bff-08bf14e42450",
                        "glosses": [
                            "Satyre âgé, fils ou petit-fils de Silène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "444baa47-78d6-429e-90b4-6f5d5752dc18",
                                "sense_id": "0670b12c-1e03-3b3a-9b69-4391359a24ed",
                                "text": "Les silènes faisaient partie du cortège de Bacchus."
                            }
                        ]
                    },
                    {
                        "sense_id": "9031d486-6eaf-363e-ae8c-ad1428377203",
                        "entry_id": "459ef34b-db24-3fcb-8bff-08bf14e42450",
                        "glosses": [
                            "Plante herbacée, annuelle ou vivace, du genre Silene, appartenant à la famille des Caryophyllacées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ae69156-8c4a-4a8f-b137-19cca38f3ee2",
                                "sense_id": "9031d486-6eaf-363e-ae8c-ad1428377203",
                                "text": "On notera, enfin, que la plante connue des Anciens sous le nom d’Aphrodes porte à présent le nom de Silène (Silène inflata), image du satyre âgé, ventru mais plein de sagesse…"
                            }
                        ]
                    },
                    {
                        "sense_id": "0feda248-29c6-31e4-8922-0995548fa295",
                        "entry_id": "459ef34b-db24-3fcb-8bff-08bf14e42450",
                        "glosses": [
                            "Nom vulgaire du Satyrus circe, papillon de la famille des Satyridés."
                        ],
                        "tags": [
                            "Lépidoptérologie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bd918b5e-75eb-38f7-bd47-cac0025c6541",
                        "entry_id": "459ef34b-db24-3fcb-8bff-08bf14e42450",
                        "glosses": [
                            "Insecte lépidoptère (papillon) de la famille des nymphalidés, dont les ailes sont de couleur brun foncé et rayées d’une bande blanc crème."
                        ],
                        "tags": [
                            "Lépidoptérologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4dc6632a-dea2-4a1e-afc3-cde0158ad0fa",
                                "sense_id": "bd918b5e-75eb-38f7-bd47-cac0025c6541",
                                "text": "La chenille du silène se nourrit sur des graminées."
                            }
                        ]
                    },
