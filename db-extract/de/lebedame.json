                        "source_sense_id": "19cbb8d0-3db2-3fc1-a42b-06b4a7f1f080",
                        "source_sense_description": "weibliche Person, die möglichst viele Genüsse jeglicher Art für sich in Anspruch nimmt",
                        "target_lang_word": "noceuse",
