                "senses": [
                    {
                        "sense_id": "1687ef49-1d0e-3aa9-b015-78711fd99542",
                        "entry_id": "07fedc8e-5229-3bc2-905d-24fb050f002d",
                        "glosses": [
                            "mit einer 1 oder 3 beginnende Folge von 27 bis 34 Buchstaben und Ziffern, die benötigt wird, um einen Transfer von Bitcoins durchführen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3214ab75-41d3-4a7c-88c0-a777d7d4e5c6",
                                "sense_id": "1687ef49-1d0e-3aa9-b015-78711fd99542",
                                "text": "„Neben einer solchen elektronischen Geldbörse bekommt jeder Nutzer eine Bitcoinadresse, mit der das Webgeld empfangen werden kann, und einen privaten, kryptografischen Schlüssel, mit dem die eigenen Bitcoins ausgeben werden.“"
                            },
                            {
                                "example_id": "24610dd0-73d9-4351-8f1c-4a991e099d53",
                                "sense_id": "1687ef49-1d0e-3aa9-b015-78711fd99542",
                                "text": "„Den Code auf dem Gutschein lösen die Nutzer dann über die Website ein, worauf der Bitcoinbetrag dann auf die angegebene Bitcoinadresse überwiesen wird.“"
                            },
                            {
                                "example_id": "0dec53f2-a8d7-448f-8a09-3f1a1a1e2b9e",
                                "sense_id": "1687ef49-1d0e-3aa9-b015-78711fd99542",
                                "text": "„Verkäufer sollen laut Platzer ihr Kryptogeld von einer eigens dafür generierten Bitcoinadresse auf den Automaten transferieren.“"
                            },
                            {
                                "example_id": "99d1c3a1-0e84-4555-8266-5044f2ddcd72",
                                "sense_id": "1687ef49-1d0e-3aa9-b015-78711fd99542",
                                "text": "„Um Bitcoins zu kaufen, benötigt man zum einen Bargeld, das in einen Schlitz eingeführt wird, und zum anderen einen sogenannten QR-Code mit einer Bitcoinadresse, der vom Automaten für den Transfer abgescannt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
