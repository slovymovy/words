                                    {
                                        "sense_id": "8e2fae8f-f6b6-3510-a072-7797da514fdf",
                                        "entry_id": "17b1e88a-36be-32d3-8638-114f2529d577",
                                        "glosses": [
                                            "Gedicht, mit dem jemand oder etwas verspottet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e544f0c9-fe8f-4196-95b3-a37d98ce5ab1",
                                                "sense_id": "8e2fae8f-f6b6-3510-a072-7797da514fdf",
                                                "text": "„Ein Prozess wegen Majestätsbeleidigung im Zusammenhang mit einem Spottgedicht Frank Wedekinds auf Wilhelm II. und dessen Orientreise 1898 zwang Lange für drei Jahre ins Exil, er starb knapp vierzigjährig im April 1909 in München.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6813be97-bacf-420f-b0dd-ed0eef16a5f3",
                        "source_entry_id": "cc1842d0-dc01-3ddd-9cc7-7b03a5d11ab6",
