{
    "word_family": [
        "frizz",
        "frizziness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "61b8bba7-191a-31d1-803d-45d43ee5ef7c",
                    "sense_definition": "Formed of a mass of small, tight, wiry curls; unruly or extending in all directions.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hair_texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The humid weather made her hair <w>frizzy</w> and difficult to manage.",
                            "target_lang_translations": {
                                "zh": "潮湿的天气让她的头发变得<w>毛躁</w>，难以打理。"
                            }
                        },
                        {
                            "text": "She used a special serum to tame her <w>frizzy</w> hair.",
                            "target_lang_translations": {
                                "zh": "她用了一种特殊的精华液来抚平她<w>毛躁</w>的头发。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fuzzy"
                    ],
                    "common_phrases": [
                        "frizzy hair"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容头发卷曲、蓬松且难以打理的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "毛躁的",
                                "target_lang_sense_clarification": "形容头发因干燥或受潮而显得蓬松、不顺滑。"
                            },
                            {
                                "target_lang_word": "卷曲蓬松的",
                                "target_lang_sense_clarification": "描述头发呈现细小、紧密且杂乱的卷曲状态。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d54192f-b7c9-3ba4-ac74-a8e4310d160a",
                    "sense_definition": "A small amount of unkempt, curly hair.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hair_texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tried to smooth down the <w>frizzies</w> before the meeting.",
                            "target_lang_translations": {
                                "zh": "开会前，她试图把那些<w>毛躁碎发</w>抚平。"
                            }
                        },
                        {
                            "text": "A little hairspray helps keep the <w>frizzies</w> away.",
                            "target_lang_translations": {
                                "zh": "喷一点发胶有助于防止<w>毛躁碎发</w>出现。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in plural form to refer to stray hairs."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指细小、杂乱且卷曲的碎发。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "毛躁碎发",
                                "target_lang_sense_clarification": "指那些不服帖、翘起来的细小头发。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}