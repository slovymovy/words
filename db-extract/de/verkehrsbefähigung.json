                ],
                "senses": [
                    {
                        "sense_id": "341bc542-fd15-3f2d-8bf6-e6289e1bbae3",
                        "entry_id": "5b6e9483-a35a-30d4-96eb-d9fdcec18b84",
                        "glosses": [
                            "Vorgang und Ergebnis einer Qualifizierungsmaßnahme zur Beteiligung am öffentlichen Verkehr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "742e8af1-2b9b-4143-8eac-9275171a62df",
                                "sense_id": "341bc542-fd15-3f2d-8bf6-e6289e1bbae3",
                                "text": "„Das ‚Karlsruher Modell’ zur Verkehrserziehung wurde in erster Linie zur Verkehrsbefähigung des Vorschulkindes und des Schulanfängers entwickelt.“"
                            },
                            {
                                "example_id": "64274d60-e273-482a-92de-8ef90d938f09",
                                "sense_id": "341bc542-fd15-3f2d-8bf6-e6289e1bbae3",
                                "text": "„Die sozialen Leistungen zur Rehabilitation beginnen ebenfalls schon während der medizinischen Maßnahmen. Sozialarbeiter im Krankenhaus, in Rehabilitationseinrichtungen und Sozialstationen führen diese Maßnahmen durch. Dazu können gehören: […] Hilfen zur Verkehrsbefähigung.“"
                            },
                            {
                                "example_id": "c2c006c8-33fa-484f-8168-76f9ec647c2c",
                                "sense_id": "341bc542-fd15-3f2d-8bf6-e6289e1bbae3",
                                "text": "„Eine Anerkennung als Schwerbehinderter, die Gewährung von Leistungen der Gesetzlichen Pflegeversicherung, Hilfen zur Verkehrsbefähigung, die Vermittlung von Selbsthilfegruppen und eine Unterstützung bei der wohnlichen Unterbringung sind weitere Hilfen, die ggf. in die Wege geleitet werden sollten.“"
                            },
                            {
                                "example_id": "f5af20e1-864b-49ac-8c0a-600b8909d5a5",
                                "sense_id": "341bc542-fd15-3f2d-8bf6-e6289e1bbae3",
                                "text": "„Verkehrsbefähigung ist von vielen Faktoren abhängig.“"
                            },
                            {
                                "example_id": "b86ff431-e0b2-4a3e-8e1e-a4382c5648b3",
                                "sense_id": "341bc542-fd15-3f2d-8bf6-e6289e1bbae3",
                                "text": "„Die Didaktik des ‚Karlsruher Modells’ (Warwitz 1998), das in Deutschland zur Verkehrsbefähigung des Vorschulkindes und des Schulanfängers entwickelt wurde und inzwischen in sieben weiteren europäischen Ländern verwendet wird, eignet sich zum gemeinsamen Lernen von Educadoras und Kindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
