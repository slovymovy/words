        "fr-extract.jsonl": [
            {
                "entry_id": "ec2fae02-2fb1-32f2-97cb-7c51b279a134",
                "word": "opportunément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7920161e-b809-3390-9a65-68b27bb5c1d7",
                        "entry_id": "ec2fae02-2fb1-32f2-97cb-7c51b279a134",
                        "glosses": [
                            "D’une manière opportune."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70e9dcd9-8e85-467c-a52f-cc5facabd3fb",
                                "sense_id": "7920161e-b809-3390-9a65-68b27bb5c1d7",
                                "text": "Messire Goupil, vaguement étourdi par quelque plomb qui lui avait meurtri la caboche, se réveillait en effet fort opportunément […]."
                            },
                            {
                                "example_id": "6b7a51e4-dc3a-4a52-9d81-39a87fb8b229",
                                "sense_id": "7920161e-b809-3390-9a65-68b27bb5c1d7",
                                "text": "Quelques fumigations opportunément et soigneusement faites, et tout vibrion est anéanti."
                            },
                            {
                                "example_id": "c9a6f967-a5a3-4982-803c-1eb22de21cf5",
                                "sense_id": "7920161e-b809-3390-9a65-68b27bb5c1d7",
                                "text": "La baguette magique agitée opportunément pour chercher à se faire élire ne suffit plus, ne convainc plus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e407b0c-4f5d-4693-bfc9-19e550a81d19",
                        "source_entry_id": "ec2fae02-2fb1-32f2-97cb-7c51b279a134",
                        "source_sense_id": "7920161e-b809-3390-9a65-68b27bb5c1d7",
                        "target_lang_word": "conveniently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conveniently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd75d28a-ae52-3900-a4ed-9928b75e660b",
                                        "entry_id": "7aec045d-729e-30fa-a071-3a3e3207cbff",
                                        "glosses": [
                                            "In a convenient manner, form, or situation; without difficulty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "815e4779-513c-4b27-b338-472710593592",
                                                "sense_id": "dd75d28a-ae52-3900-a4ed-9928b75e660b",
                                                "text": "his body was now conveniently inclin'd towards me, and just softly chucking his smooth beardless chin, I asked him if he was afraid of a lady?",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85aa1af8-e182-3c0d-8e26-17eb0060c695",
                                        "entry_id": "7aec045d-729e-30fa-a071-3a3e3207cbff",
                                        "glosses": [
                                            "In a manner provoking suspicion due to how well it suits someone's purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "292db347-06b0-4deb-ae9b-152f4691de05",
                                                "sense_id": "85aa1af8-e182-3c0d-8e26-17eb0060c695",
                                                "text": "You expect me to believe that someone created a wormhole, and now conveniently has disassembled it?"
                                            },
                                            {
                                                "example_id": "dc0ab232-b4f5-41b9-ad6a-7132e582ba4b",
                                                "sense_id": "85aa1af8-e182-3c0d-8e26-17eb0060c695",
                                                "text": "If you prefer to deal in actual figures, as opposed to conveniently distracting speculative ones, then do recall that the British taxpayer bailed out Lloyds to the tune of around £20bn, and continues to face a massive loss on those shares."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "408aceea-c7dc-436b-9bb2-e9ce2668ea91",
                        "source_entry_id": "ec2fae02-2fb1-32f2-97cb-7c51b279a134",
                        "source_sense_id": "7920161e-b809-3390-9a65-68b27bb5c1d7",
