                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grumbler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8ca4d9c-938b-3138-a4ee-e58622139913",
                                        "entry_id": "d23d1fbe-0b83-31fc-a9e1-6a658f9646ba",
                                        "glosses": [
                                            "A person who persistently grumbles; a complainer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58eb3e31-59b2-4266-853b-4337f96680a0",
                                                "sense_id": "e8ca4d9c-938b-3138-a4ee-e58622139913",
                                                "text": "But the grumbler must be heard through the newspapers, and a great deal of unpleasantness comes to newspapers from the grumbler; and the newspapers, and not the grumbler, nearly always have to take the brunt of the trouble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5063e622-c038-41ce-a4a6-f3336aa18834",
                        "source_entry_id": "873351c4-bd4f-399f-8821-8375f39b1c0f",
                        "source_sense_id": "527d14d5-22e8-33c8-ba2f-e74dae3abaa1",
                        "source_sense_description": "chagrijnig met iedereen overhoop liggend persoon",
                        "target_lang_word": "querelleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "querelleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e692be9-3c06-359f-8b31-aa72641554e6",
                                        "entry_id": "6ab577a8-4a4a-31c8-bef4-f3d203fcb11d",
                                        "glosses": [
                                            "Qui aime chercher querelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd4194e-6d8d-4dc5-bb10-7bf899596bb3",
                                                "sense_id": "5e692be9-3c06-359f-8b31-aa72641554e6",
                                                "text": "Ces indigènes étaient tous Bochjesmen, gens laborieux, peu irritables, peu querelleurs, capables de supporter de grandes fatigues physiques."
                                            },
                                            {
                                                "example_id": "c09c240a-42f9-4552-a1de-ddf313ea8f1a",
                                                "sense_id": "5e692be9-3c06-359f-8b31-aa72641554e6",
                                                "text": "Tout comme Cormon, je suis moi aussi sous le charme de ce jeune garçon, dans lequel je me reconnais par le comportement insolent et querelleur."
                                            },
                                            {
                                                "example_id": "cd4eabb2-c48e-4bbd-98d5-5180f6913116",
                                                "sense_id": "5e692be9-3c06-359f-8b31-aa72641554e6",
                                                "text": "Je n’en doute pas, noble dame ; mais le peuple d’Angleterre est une race fière, querelleuse et toujours prête aux troubles intérieurs ; …."
                                            },
                                            {
                                                "example_id": "daa4570c-f2d7-4baa-a321-ef2fe48cc53a",
                                                "sense_id": "5e692be9-3c06-359f-8b31-aa72641554e6",
                                                "text": "Ce siècle qui vient de finir est un siècle querelleur, belliqueux et assassin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "querelleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "317c714f-a4fa-34a8-b954-3b591195d715",
                                        "entry_id": "20969a0a-efd3-331a-a837-e6a033e42b29",
                                        "glosses": [
                                            "Celui qui aime chercher querelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffd5361c-57b8-44f9-8081-3dd745f5f679",
                                                "sense_id": "317c714f-a4fa-34a8-b954-3b591195d715",
                                                "text": "C’est un grand querelleur. C’est une querelleuse perpétuelle."
                                            },
                                            {
                                                "example_id": "046cfe6f-1c9e-43e4-813b-3392a329428a",
                                                "sense_id": "317c714f-a4fa-34a8-b954-3b591195d715",
                                                "text": "Dès qu’un ours est en vue, le couteleur et le querelleur s’avancent vers lui d'un air indifférent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
