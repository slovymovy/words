                ],
                "translations": [
                    {
                        "translation_id": "d862a554-1bb8-499a-a4ee-40ace80d3201",
                        "source_entry_id": "d38f0cdd-eb69-3633-862c-b9766a347cc9",
                        "source_sense_id": "bfd74f2a-c8dc-3bdf-b24e-78f82603925f",
                        "target_lang_word": "microsecond",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microsecond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1343eb9c-688b-3861-9d7b-8fba902e10d1",
                                        "entry_id": "8ea69656-83ea-3a7d-b47e-8a6bec7d11e3",
                                        "glosses": [
                                            "An SI unit of time equal to 10⁻⁶ seconds. Symbol: μs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f4791b5-16cd-4e6f-9ce3-3051f3b0b534",
                                                "sense_id": "1343eb9c-688b-3861-9d7b-8fba902e10d1",
                                                "text": "Holonyms: millisecond < centisecond < decisecond < second < decasecond < minute < hectosecond < kilosecond < hour < day < week < megasecond < fortnight < month < year < gigasecond < century < kiloannum, kiloyear, millennium < terasecond < mega-annum, megayear < petasecond < giga-annum, gigayear < exasecond < zettasecond < yottasecond < ronnasecond < quettasecond"
                                            },
                                            {
                                                "example_id": "be5ca89a-2ed1-42bd-b5dd-57b16ebf304e",
                                                "sense_id": "1343eb9c-688b-3861-9d7b-8fba902e10d1",
                                                "text": "Meronyms: quectosecond < rontosecond < yoctosecond < zeptosecond < attosecond < femtosecond < picosecond < nanosecond"
                                            },
                                            {
                                                "example_id": "5f9ec917-c01d-452f-8880-00d7e6c97237",
                                                "sense_id": "1343eb9c-688b-3861-9d7b-8fba902e10d1",
                                                "text": "He'd be on her ass in a microsecond, revoke her letters testamentary, they'd call her names, proclaim her through all Orange County as a redistributionist and pinko, slip the old man from Warpe, Wistfull, Kubitschek and McMingus in as administrator de bonis non and so much baby for code, constellations, shadow-legatees."
                                            },
                                            {
                                                "example_id": "e35c6f2d-2530-465d-b185-50bb1c0af8d7",
                                                "sense_id": "1343eb9c-688b-3861-9d7b-8fba902e10d1",
                                                "text": "The data word processor 606 handles the in-flow and out-flow of byte-oriented input/output data and interleaved signals at a rate of, for example, 500 kilobytes per second. Instruction processing rates of four to eight per microsecond are required for such a data flow."
                                            },
                                            {
                                                "example_id": "59cc09c6-27f7-4ae5-8743-13bd982aaff9",
                                                "sense_id": "1343eb9c-688b-3861-9d7b-8fba902e10d1",
                                                "text": "O₂^(•−) and OH^• are highly unstable (half-life at the level of microseconds and nanoseconds, respectively) and cannot cross membrane, while H₂O₂, though not a free radical but a ROS, is relatively stable (half-life around 1 ms) (Møller et al. 2007) and can cross membranes through aquaporins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6e38b04-4194-439f-893d-00b30973750a",
                        "source_entry_id": "d38f0cdd-eb69-3633-862c-b9766a347cc9",
