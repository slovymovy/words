                    {
                        "translation_id": "503974d1-9419-44d5-a3fc-3ec0e4d0a21c",
                        "source_entry_id": "386f654a-9027-3d85-b747-4742e6949d7a",
                        "source_sense_id": "97cd7416-31ca-3849-ae54-d20d46a358fd",
                        "source_sense_description": "state or quality of being nervous",
                        "target_lang_word": "nervosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nervosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62260efa-c6d0-3efc-90b0-3289782b0e95",
                                        "entry_id": "d4e2cf2a-48e5-3aaf-a40b-593db1828366",
                                        "glosses": [
                                            "État d’irritation des nerfs, d’excitabilité passagère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05287f64-d63f-480c-87f4-2eb2a2d5f144",
                                                "sense_id": "62260efa-c6d0-3efc-90b0-3289782b0e95",
                                                "text": "Sa nervosité s'était calmée et son âme s'exhalait dans le silence des choses, tout en douceur, sans souffrance."
                                            },
                                            {
                                                "example_id": "5c7c8cc4-9999-4ee0-9687-27044587fc2d",
                                                "sense_id": "62260efa-c6d0-3efc-90b0-3289782b0e95",
                                                "text": "Un cantinier qui se rase sur l'accotement, sa glace pendue à un cerisier, attend avec nervosité, la figure débordant de mousse, que nous ayons fini de faire trembler la route."
                                            },
                                            {
                                                "example_id": "5e3015d8-5a65-4eda-a684-22e3d43fb60e",
                                                "sense_id": "62260efa-c6d0-3efc-90b0-3289782b0e95",
                                                "text": "Le commissaire Massart […] se rongeait les ongles et c'était le seul signe de nervosité que ce fonctionnaire eût jamais donné ; […]."
                                            },
                                            {
                                                "example_id": "0c4506be-d5be-47ac-a476-35612613bff5",
                                                "sense_id": "62260efa-c6d0-3efc-90b0-3289782b0e95",
                                                "text": "Nadia conduit lentement, tant par crainte d'enliser sa Fiat, qui patine dans les roulières, qu'en raison de la nervosité qu'elle ressent à la perspective de cette rencontre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8b0a3aa-229e-3e7e-a9fa-930a5666bfe4",
                                        "entry_id": "d4e2cf2a-48e5-3aaf-a40b-593db1828366",
                                        "glosses": [
                                            "Coefficient de rétractabilité (c’est-à-dire son retrait volumétrique quand sa teneur en eau diminue de 1 %) d'un bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e5dfc96-142b-4cba-a726-6995de56f196",
                                                "sense_id": "d8b0a3aa-229e-3e7e-a9fa-930a5666bfe4",
                                                "text": "On appelle nervosité d’un bois son coefficient de rétractabilité, c’est-à-dire son retrait volumétrique quand sa teneur en eau diminue de 1 %."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbe29e9c-8849-4fa4-af74-613600938cc9",
                        "source_entry_id": "386f654a-9027-3d85-b747-4742e6949d7a",
                        "source_sense_id": "97cd7416-31ca-3849-ae54-d20d46a358fd",
                        "source_sense_description": "state or quality of being nervous",
                        "target_lang_word": "Nervosität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nervosität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e58fb7c-3406-375a-ae4b-30afa320d416",
                                        "entry_id": "aac5bf45-adb9-3c0c-8e00-bed24a380807",
                                        "glosses": [
                                            "psychische Unruhe oder Anspannung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eabdfaf-a372-4633-9616-e84bf66867dc",
                                                "sense_id": "6e58fb7c-3406-375a-ae4b-30afa320d416",
                                                "text": "Ich suche ein Medikament gegen Nervosität und Schlaflosigkeit."
                                            },
                                            {
                                                "example_id": "15940403-55e6-449c-8ae5-53f891d9d631",
                                                "sense_id": "6e58fb7c-3406-375a-ae4b-30afa320d416",
                                                "text": "„Als wäre der Laden nie geschlossen gewesen, als wären wir immer da gewesen, öffnet sich die Tür, und herein kommen Menschen, die keine Ahnung davon haben, dass wir hier vor Nervosität fast vergehen.“"
                                            },
                                            {
                                                "example_id": "5fb92181-bdef-426c-a4c8-9c38347b4201",
                                                "sense_id": "6e58fb7c-3406-375a-ae4b-30afa320d416",
                                                "text": "„Ledwina wird von ihrer eigenen Nervosität nahezu aufgezehrt.“"
                                            },
                                            {
                                                "example_id": "2cbc3813-c261-47a8-9a3f-d5338ea15ba3",
                                                "sense_id": "6e58fb7c-3406-375a-ae4b-30afa320d416",
                                                "text": "„Enorme Nervosität hatte die Passanten erfasst, sodass jeder, der irgendwie oder auch gerade gar nicht auffiel, in den Verdacht geraten konnte, ein verdeckter Feind zu sein.“"
                                            },
                                            {
                                                "example_id": "d759a03c-3eb4-4e87-a927-c81afd155dcc",
                                                "sense_id": "6e58fb7c-3406-375a-ae4b-30afa320d416",
                                                "text": "„Die Nervosität war von mir abgefallen und hatte einem Hochgefühl Platz gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e3e97bf-9965-43c0-962f-fb07359454fd",
                        "source_entry_id": "386f654a-9027-3d85-b747-4742e6949d7a",
                        "source_sense_id": "97cd7416-31ca-3849-ae54-d20d46a358fd",
                        "source_sense_description": "state or quality of being nervous",
                        "target_lang_word": "Unruhe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unruhe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4c27aae-358e-305e-a827-26b08da1a644",
                                        "entry_id": "693b93fa-7f5c-3f7f-87e8-a6d9904f205d",
                                        "glosses": [
                                            "(als unangenehm oder lästig empfundene) Bewegungen oder Geräusche"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caa7ddcd-72d3-4e69-b078-4fea7b5b973f",
                                                "sense_id": "c4c27aae-358e-305e-a827-26b08da1a644",
                                                "text": "Ich ziehe aus: Die Mitbewohner verursachen mir zu viel Unruhe."
                                            },
                                            {
                                                "example_id": "f5098a8a-1564-4cab-ac98-5cb66ccaebcc",
                                                "sense_id": "c4c27aae-358e-305e-a827-26b08da1a644",
                                                "text": "„Eine plötzliche Unruhe unter den Frauen schreckte ihn aus seinen freudlosen Gedanken auf.“"
                                            },
                                            {
                                                "example_id": "150ecd83-1d27-43ff-b6a4-db8af411f45e",
                                                "sense_id": "c4c27aae-358e-305e-a827-26b08da1a644",
                                                "text": "„Die Unruhe im Saal blieb.“"
                                            },
                                            {
                                                "example_id": "b3917071-e04b-476b-b426-0fd238ac55ce",
                                                "sense_id": "c4c27aae-358e-305e-a827-26b08da1a644",
                                                "text": "„Das Zucken seines Gesichts, das Flackern seiner Augen und die krampfartige Unruhe seiner Finger verrieten es. Kaum hatten die Gesandten ihren Bericht beendet, als er aufsprang und wie ein Tobsüchtiger durch das Zimmer raste.“"
                                            },
                                            {
                                                "example_id": "28a1d925-bcff-4f1d-b3be-c7270bf132b6",
                                                "sense_id": "c4c27aae-358e-305e-a827-26b08da1a644",
                                                "text": "„Der Sturm brachte eine Unruhe in die graue Meeresoberfläche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85939af5-48de-3dd9-b2fc-773c8eff8867",
                                        "entry_id": "693b93fa-7f5c-3f7f-87e8-a6d9904f205d",
                                        "glosses": [
                                            "aus dem eigenen Inneren kommende Aufregung; innere Angespanntheit und/oder Unzufriedenheit"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ce609f1-426c-4c48-914c-e0bd89d9a006",
                                                "sense_id": "85939af5-48de-3dd9-b2fc-773c8eff8867",
                                                "text": "„Gewiß seid Ihr alle voll Unruhe, daß ich so lange - lange nicht geschrieben.“"
                                            },
                                            {
                                                "example_id": "eb0e1133-c522-4982-b918-5f53f5359282",
                                                "sense_id": "85939af5-48de-3dd9-b2fc-773c8eff8867",
                                                "text": "Eine innere Unruhe ließ ihn nicht einschlafen."
                                            },
                                            {
                                                "example_id": "4cba7e0c-c955-44ac-89ce-ca2da1481b9e",
                                                "sense_id": "85939af5-48de-3dd9-b2fc-773c8eff8867",
                                                "text": "„Am vierten Tag greift die Unruhe stark nach ihr.“"
                                            },
                                            {
                                                "example_id": "e89d6421-3322-489f-93cf-073e6ff93d2f",
                                                "sense_id": "85939af5-48de-3dd9-b2fc-773c8eff8867",
                                                "text": "„Ich stand vor Unruhe auf und ging hinaus.“"
                                            },
                                            {
                                                "example_id": "f0ee3c4b-a2b2-4825-89b1-ae988a3e1626",
                                                "sense_id": "85939af5-48de-3dd9-b2fc-773c8eff8867",
                                                "text": "„Mutters Unruhe wächst: Noch nie kam eine Nachricht aus Karzin, obwohl es kaum zwanzig Kilometer entfernt liegt.“"
                                            },
                                            {
                                                "example_id": "ce074f9f-3521-4c25-9359-b959decb0f3c",
                                                "sense_id": "85939af5-48de-3dd9-b2fc-773c8eff8867",
                                                "text": "„Von Unruhe gequält, wandte sich Han Dau-go dem Vergnügungsviertel zu, um Jing Bo-djau dort zu suchen.“"
                                            },
                                            {
                                                "example_id": "17238cf0-2b13-401a-9460-e2f61c2e9525",
                                                "sense_id": "85939af5-48de-3dd9-b2fc-773c8eff8867",
                                                "text": "„In der Klinik war er in ständiger Unruhe, konnte nicht ruhig sitzen, lief dauernd dem Arzt nach, er halte es nicht aus, er gehe zugrunde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4040fbb8-272c-32c6-a6f0-5b276f7c8985",
                                        "entry_id": "693b93fa-7f5c-3f7f-87e8-a6d9904f205d",
                                        "glosses": [
                                            "Aufstand gegen bestehende Verhältnisse"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2aa1d60-2c30-4035-9137-e9b663e2ae92",
                                                "sense_id": "4040fbb8-272c-32c6-a6f0-5b276f7c8985",
                                                "text": "„Sie kritisierten den Umgang der Behörden mit den Unruhen in Tibet.“"
                                            },
                                            {
                                                "example_id": "71a853de-b0f4-4f6d-98f2-8f35d284463b",
                                                "sense_id": "4040fbb8-272c-32c6-a6f0-5b276f7c8985",
                                                "text": "„Es könnte an einer Überbevölkerung, dem dadurch bedingten Nahrungsmangel und folgenden sozialen Unruhen gelegen haben.“"
                                            },
                                            {
                                                "example_id": "647627b3-8c98-458f-bdff-114e88636650",
                                                "sense_id": "4040fbb8-272c-32c6-a6f0-5b276f7c8985",
                                                "text": "„Dort rettet er bei Unruhen einige Jahre später Hunderten mehrheitlich syrischen Christen und vielen Diplomaten das Leben, denen er Zuflucht auf seinem Anwesen gewährt.“"
                                            },
                                            {
                                                "example_id": "aee7ae9b-d593-410c-9cb2-751c757035a7",
                                                "sense_id": "4040fbb8-272c-32c6-a6f0-5b276f7c8985",
                                                "text": "„Doch die Stabilität blieb oberflächlich, es gab weiterhin Unruhen und Putschversuche, die jedes Mal von italienischen Truppen niedergeschlagen wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "eea94215-6071-3137-aa66-f8745605fc75",
                                        "entry_id": "693b93fa-7f5c-3f7f-87e8-a6d9904f205d",
                                        "glosses": [
                                            "meistens mit einer Spiralfeder verbundenes Schwungrad in mechanischen Uhren, das für einen gleichmäßigen Gang sorgt"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29174222-5538-41fc-97e1-143331cf6d40",
                                                "sense_id": "eea94215-6071-3137-aa66-f8745605fc75",
                                                "text": "„Die Schwingungsbogen der Unruhe, ob gross oder klein, sollen von gleicher Zeitdauer sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Unruhe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db8897dd-31e6-3022-9de0-bca37e10cda5",
                                        "entry_id": "9a1b1ff7-56d9-3f74-b985-c2c8b942f9ed",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7050c4a-c532-468b-8e1b-9bcbca6efee6",
                                                "sense_id": "db8897dd-31e6-3022-9de0-bca37e10cda5",
                                                "text": "Frau Unruhe ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "366e34a5-63c8-4766-b811-f79e4024a24f",
                                                "sense_id": "db8897dd-31e6-3022-9de0-bca37e10cda5",
                                                "text": "Herr Unruhe wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "afcff163-e8a4-4f42-b424-d4324178da29",
                                                "sense_id": "db8897dd-31e6-3022-9de0-bca37e10cda5",
                                                "text": "Die Unruhes fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "3767d92b-5b8f-4f9b-abf6-6a65891a4fff",
                                                "sense_id": "db8897dd-31e6-3022-9de0-bca37e10cda5",
                                                "text": "Der Unruhe trägt nie die Schals, die die Unruhe ihm strickt."
                                            },
                                            {
                                                "example_id": "163d8595-c6f5-4b46-bf35-8e86afd5b2d4",
                                                "sense_id": "db8897dd-31e6-3022-9de0-bca37e10cda5",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Unruhe kommt, geht der Herr Unruhe.“"
                                            },
                                            {
                                                "example_id": "a96ddb12-9957-4ab9-8bfa-a991782a1919",
                                                "sense_id": "db8897dd-31e6-3022-9de0-bca37e10cda5",
                                                "text": "Unruhe kommt und geht."
                                            },
                                            {
                                                "example_id": "a293fb2d-4390-434d-a054-842899d5428e",
                                                "sense_id": "db8897dd-31e6-3022-9de0-bca37e10cda5",
                                                "text": "Unruhes kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
