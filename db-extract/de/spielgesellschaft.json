                "senses": [
                    {
                        "sense_id": "1d59c756-b73f-3f6e-99fb-cb3b89463e22",
                        "entry_id": "4e6e4b13-20ca-30bc-86a3-634f6ac1eaa9",
                        "glosses": [
                            "Gruppe von Menschen, die sich zum Zwecke des gemeinsamen Spielens zusammenfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d2c5bc6-62dc-47f2-b0c1-660e084129fd",
                                "sense_id": "1d59c756-b73f-3f6e-99fb-cb3b89463e22",
                                "text": "„Einer derselben rief ihr zu, sie möge ihm aus ihrer Tabakspfeife Feuer geben, was sie auch that, und dann weiter ging, sich über die seltsame Spielgesellschaft verwundernd.“"
                            },
                            {
                                "example_id": "e714d933-1eea-4b35-af3f-6a6e0b3a8893",
                                "sense_id": "1d59c756-b73f-3f6e-99fb-cb3b89463e22",
                                "text": "„Man wird sie auslachen, wenn sie gestiefelt in Spielgesellschaften gehen wollen.“"
                            },
                            {
                                "example_id": "378196f0-e660-4b5a-9922-28399026fffc",
                                "sense_id": "1d59c756-b73f-3f6e-99fb-cb3b89463e22",
                                "text": "„Er meinte, das wäre so eine artige Spielgesellschaft für einen Doctor der Theologie gewesen!“"
                            },
                            {
                                "example_id": "935749d4-96b3-4bc9-9a55-aa4f947ba6bc",
                                "sense_id": "1d59c756-b73f-3f6e-99fb-cb3b89463e22",
                                "text": "„Da sehen die meisten Leute diese Welt als eine Spielgesellschaft an, wo die Klugen nichts weiter thun, als Parthien machen.“"
                            },
                            {
                                "example_id": "e8fabda9-12af-4bd7-84ab-f78d57660415",
                                "sense_id": "1d59c756-b73f-3f6e-99fb-cb3b89463e22",
                                "text": "„Der Hauptgrund war, daß die besten Elemente der Spielgesellschaft nicht mehr mit Herrn Dr. Kornblum bei Hecht zusammentreffen wollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
