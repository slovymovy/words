{
    "word_family": [
        "citaat",
        "citatie",
        "citeerbaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f3537665-db33-30eb-a716-389a8c2d63fb",
                    "sense_definition": "het letterlijk overnemen van wat iemand anders gezegd of geschreven heeft",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "overnemen van tekst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet altijd de bron vermelden als je een auteur wilt <w>citeren</w>.",
                            "target_lang_translations": {
                                "en": "You must always mention the source if you want to <w>quote</w> an author."
                            }
                        },
                        {
                            "text": "De student kon moeiteloos een bekend gedicht <w>citeren</w> tijdens de les.",
                            "target_lang_translations": {
                                "en": "The student could effortlessly <w>quote</w> a famous poem during the lesson."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanhalen"
                    ],
                    "common_phrases": [
                        "een auteur citeren",
                        "uit het hoofd citeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to repeat or copy the exact words of someone else, either spoken or written"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quote",
                                "target_lang_sense_clarification": "to repeat exact words"
                            },
                            {
                                "target_lang_word": "cite",
                                "target_lang_sense_clarification": "to refer to a source"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "801ad256-d981-3db1-9dc8-90877e81cbd3",
                    "sense_definition": "iemand eervol vermelden, met name in een militair dagorder",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "eervolle vermelding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaat werd <w>geciteerd</w> voor zijn uitzonderlijke moed tijdens de missie.",
                            "target_lang_translations": {
                                "en": "The soldier was <w>cited</w> for his exceptional courage during the mission."
                            }
                        },
                        {
                            "text": "Het is een grote eer om in een officieel rapport te worden <w>geciteerd</w>.",
                            "target_lang_translations": {
                                "en": "It is a great honor to be <w>cited</w> in an official report."
                            }
                        }
                    ],
                    "synonyms": [
                        "een citatie verlenen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "voornamelijk in militaire context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to mention someone honorably, especially in a military dispatch or official report"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cite",
                                "target_lang_sense_clarification": "to mention for bravery or merit"
                            },
                            {
                                "target_lang_word": "mention in dispatches",
                                "target_lang_sense_clarification": "specifically military context"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "045d937a-4d89-33ce-ae46-f55b71337aaf",
                    "sense_definition": "iemand officieel oproepen om voor de rechtbank te verschijnen",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "juridische oproep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De deurwaarder kwam de getuige formeel <w>citeren</w> voor de zitting van morgen.",
                            "target_lang_translations": {
                                "en": "The bailiff came to formally <w>summon</w> the witness for tomorrow's hearing."
                            }
                        },
                        {
                            "text": "In deze complexe rechtszaak besloot de advocaat de tegenpartij direct te <w>citeren</w>.",
                            "target_lang_translations": {
                                "en": "In this complex lawsuit, the lawyer decided to <w>summon</w> the opposing party directly."
                            }
                        }
                    ],
                    "synonyms": [
                        "dagvaarden",
                        "dagen"
                    ],
                    "common_phrases": [
                        "voor het gerecht citeren"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "juridisch jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to officially summon someone to appear before a court of law"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "summon",
                                "target_lang_sense_clarification": "to order to appear in court"
                            },
                            {
                                "target_lang_word": "subpoena",
                                "target_lang_sense_clarification": "legal order for a witness"
                            },
                            {
                                "target_lang_word": "cite",
                                "target_lang_sense_clarification": "legal summons"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}