                                        "glosses": [
                                            "Of a person, or movement: not handy; inept; clumsy; not dexterous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd450f4f-508e-475b-be54-de6a5a13aa0e",
                                                "sense_id": "a351b7f9-cc00-3187-ae95-5b35ef04d1c8",
                                                "text": "Bradly collected Pippies; their trick vanishing was not too swift for his unhandy clutches."
                                            },
                                            {
                                                "example_id": "32ee6497-af1a-41e8-8555-fd46dadd342f",
                                                "sense_id": "a351b7f9-cc00-3187-ae95-5b35ef04d1c8",
                                                "text": "\"Strike your father, eh?\" Syed Omar launched an unhandy cuff, then another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f09e9eec-fb17-39ca-bb68-6801afa5debd",
                                        "entry_id": "9b40f539-1a28-3f78-9b50-c95f86b69d8b",
