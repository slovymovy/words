                            "comment": "poker"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A situation in poker where a strong hand loses to a weaker one due to unlikely cards.",
                        "de": "Eine Situation beim Poker, in der ein Spieler mit einer starken Hand gegen eine schwächere Hand verliert, weil unwahrscheinliche Karten aufgedeckt werden."
                    },
                    "translations": {
                        "en": [
