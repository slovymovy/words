                ],
                "senses": [
                    {
                        "sense_id": "7ae4b7b6-25e8-3067-b4fc-070080c4a850",
                        "entry_id": "ebe83f37-ee5e-3313-be38-9ee62896e7a5",
                        "glosses": [
                            "das Beeinträchtigen, Beeinträchtigtwerden durch Geruchsemissionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49df11a0-d7e9-4aa3-88b3-80d4290ba18b",
                                "sense_id": "7ae4b7b6-25e8-3067-b4fc-070080c4a850",
                                "text": "„Auch nach der GIRL muss ein im Außenbereich gelegenes Wohngebäude grundsätzlich an 15% der Jahresstunden Geruchsbeeinträchtigungen von 1 GE je Kubikmeter Luft hinnehmen.“"
                            },
                            {
                                "example_id": "f7c13f0f-c1df-4891-b7d2-c72de38d0262",
                                "sense_id": "7ae4b7b6-25e8-3067-b4fc-070080c4a850",
                                "text": "„Wird in einem dörflich geprägten Gebiet ein Wohnhaus in der Nähe eines bestehenden Mast(schweine)stalles errichtet, so daß dort nur in rund 3 % der Jahresstunden mit Geruchsbeeinträchtigungen einer Intensität von über 3 GE/cbm und in etwa 2 % der Jahresstunden mit solchen von über 5 GE/cbm gerechnet werden muß, kann dies für die Bewohner des Hauses im Einzelfall zumutbar sein mit der Folge, daß dem Schweinemäster kein Abwehranspruch gegen diese Wohnbebauung zusteht.“"
                            },
                            {
                                "example_id": "6cc07467-e6ce-4db9-a671-20571af0a8cb",
                                "sense_id": "7ae4b7b6-25e8-3067-b4fc-070080c4a850",
                                "text": "„Laut Ausführungen des gewerbetechnischen Amtssachverständigen sei die Geruchsbeeinträchtigung bei den Lüftungsanlagen für die Nachbarn nicht prognostizierbar.“"
                            },
                            {
                                "example_id": "a953e974-466d-43d9-9603-abd50f595e2a",
                                "sense_id": "7ae4b7b6-25e8-3067-b4fc-070080c4a850",
                                "text": "„Zur Beurteilung der Zumutbarkeit von Geruchsbeeinträchtigungen durch ein Putenmastvorhaben ist der Rückgriff auf die VDI-Richtlinie 3472 (Tierhaltung - Hühner) ohne eine Umrechnung der Mastplätze von Hühner auf Puten zulässig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
