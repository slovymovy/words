                        "entry_id": "9db014ef-1d91-3e35-883b-4ad1b1c88ea6",
                        "glosses": [
                            "een deel van een trap waarop men kan staan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5b8078a-00cd-401a-967e-ddc68d9a1e77",
                                "sense_id": "08b01e49-a36e-30a0-be35-846ba604788a",
                                "text": "Er zitten 32 traptreeën in deze trap."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed6aca05-6a36-4f22-9498-4a185b281b75",
                        "source_entry_id": "9db014ef-1d91-3e35-883b-4ad1b1c88ea6",
                        "source_sense_id": "08b01e49-a36e-30a0-be35-846ba604788a",
                        "source_sense_description": "een deel van een trap waarop men kan staan",
                        "target_lang_word": "Treppenstufe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Treppenstufe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "105b9a11-740c-3d8b-8d27-1fd71590dc09",
                                        "entry_id": "54c8eafc-0401-333f-bf29-e0e5f3d72587",
                                        "glosses": [
                                            "Stufe einer Treppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b4d0253-c9e0-4cdf-965d-a31231ea1cb8",
                                                "sense_id": "105b9a11-740c-3d8b-8d27-1fd71590dc09",
                                                "text": "„Ich setzte den Fuß auf die erste schneeverkrustete Treppenstufe und wollte mich am Geländer nach oben ziehen, als mich ein Geräusch in der Bewegung erstarren ließ.“"
                                            },
                                            {
                                                "example_id": "a59edc05-a3ec-4ccf-98e6-6c493e851ec8",
                                                "sense_id": "105b9a11-740c-3d8b-8d27-1fd71590dc09",
                                                "text": "„Ein paar Treppenstufen führten weiter nach unten, und es tat sich ein überraschend großer, hoher Raum auf.“"
                                            },
                                            {
                                                "example_id": "1e61d34e-7c9e-4908-85bb-bc6a15b832a0",
                                                "sense_id": "105b9a11-740c-3d8b-8d27-1fd71590dc09",
                                                "text": "„Er setzte sich auf eine Treppenstufe, steckte die Hand und den Arm durch das Gitter des Treppengeländers und forderte sie auf, seinen Unterarm mit beiden Händen festzuhalten, er wollte den ausgekugelten Arm mit einem Ruck zurück ins Gelenk setzen.“"
                                            },
                                            {
                                                "example_id": "1a27f1c8-81ca-4f98-b784-ce04facc99d8",
                                                "sense_id": "105b9a11-740c-3d8b-8d27-1fd71590dc09",
                                                "text": "„Sobald Irina hörte, wie er die Treppenstufen nach unten ging, sichtete sie die Fotos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23335a18-f446-4693-8248-60b431e34f57",
                        "source_entry_id": "9db014ef-1d91-3e35-883b-4ad1b1c88ea6",
