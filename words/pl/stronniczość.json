                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвзятость",
                                "target_lang_sense_clarification": "склонность отдавать предпочтение одной стороне"
                            },
                            {
                                "target_lang_word": "пристрастность",
                                "target_lang_sense_clarification": "отсутствие объективности из-за личных симпатий"
                            }
