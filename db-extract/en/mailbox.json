                                                "sense_id": "ea4e8277-475b-34a4-b8d8-601a0898ecdf",
                                                "text": "„Am nächsten Morgen fand ich ihre Antwort in meiner Mailbox, getippt von der Journalistin.“"
                                            },
                                            {
                                                "example_id": "90238fae-5413-416d-847d-4da02995b7f3",
                                                "sense_id": "ea4e8277-475b-34a4-b8d8-601a0898ecdf",
                                                "text": "„Kaum eine Mailbox ist davor sicher, von solchen Sendungen heimgesucht zu werden.“"
                                            },
