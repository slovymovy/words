{
    "word_family": [
        "spectacular",
        "spectacularly",
        "spectate",
        "spectator",
        "spectatorship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b31db81b-c7ae-3393-a6ff-074cf076f326",
                    "sense_definition": "An impressive, large-scale, or exciting public display, performance, or scene.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "public display",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The opening ceremony of the Olympic Games was a magnificent <w>spectacle</w> of light and sound.",
                            "target_lang_translations": {
                                "ru": "Церемония открытия Олимпийских игр была великолепным <w>зрелищем</w> света и звука."
                            }
                        },
                        {
                            "text": "Thousands of people gathered to watch the grand <w>spectacle</w> of the annual parade through the city.",
                            "target_lang_translations": {
                                "ru": "Тысячи людей собрались, чтобы посмотреть на грандиозное <w>зрелище</w> ежегодного парада, проходящего через город."
                            }
                        }
                    ],
                    "synonyms": [
                        "show",
                        "pageant"
                    ],
                    "common_phrases": [
                        "grand spectacle",
                        "visual spectacle",
                        "public spectacle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Впечатляющее, масштабное или захватывающее публичное мероприятие, представление или сцена."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зрелище",
                                "target_lang_sense_clarification": "что-то впечатляющее, открывающееся взору"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "зрелищное действо или шоу"
                            },
                            {
                                "target_lang_word": "спектакль",
                                "target_lang_sense_clarification": "необычное или масштабное событие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "882e6923-d9d5-3283-92e6-94a36f52c68e",
                    "sense_definition": "A person or situation that is embarrassing, ridiculous, or draws negative attention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "embarrassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had too much to drink and began to make a <w>spectacle</w> of himself in front of his colleagues.",
                            "target_lang_translations": {
                                "ru": "Он слишком много выпил и начал выставлять себя на <w>посмешище</w> перед коллегами."
                            }
                        },
                        {
                            "text": "Please stop shouting in the street; you are creating a sorry <w>spectacle</w> for everyone to see.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, перестань кричать на улице; ты представляешь собой жалкое <w>зрелище</w> на глазах у всех."
                            }
                        }
                    ],
                    "common_phrases": [
                        "make a spectacle of himself",
                        "sorry spectacle",
                        "pitiful spectacle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или ситуация, которые выглядят нелепо, постыдно или привлекают негативное внимание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зрелище",
                                "target_lang_sense_clarification": "неприятная или жалкая картина"
                            },
                            {
                                "target_lang_word": "посмешище",
                                "target_lang_sense_clarification": "объект насмешек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce3a5fdf-f9f6-32f4-8e15-cfee3a011f1c",
                    "sense_definition": "Relating to or used as a modifier for <w>spectacles</w> (eyeglasses).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "optics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum display included an antique <w>spectacle</w> case made of fine leather.",
                            "target_lang_translations": {
                                "ru": "Музейная экспозиция включала старинный <w>футляр</w> <w>для</w> <w>очков</w> из тонкой кожи."
                            }
                        },
                        {
                            "text": "The optician repaired the broken <w>spectacle</w> frames while the customer waited.",
                            "target_lang_translations": {
                                "ru": "Оптик починил сломанную оправу <w>очков</w>, пока клиент ждал."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spectacle case",
                        "spectacle frames",
                        "spectacle maker"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "attributive use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к очкам или используемый в качестве определения для очков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очковый",
                                "target_lang_sense_clarification": "относящийся к очкам"
                            },
                            {
                                "target_lang_word": "для очков",
                                "target_lang_sense_clarification": "предназначенный для очков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d25d8f84-387f-3cb0-8798-62c1d451d5bc",
                    "sense_definition": "A frame holding colored glass on a railway signal, used to change the color of the light at night.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "railway equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The signalman checked that the <w>spectacle</w> moved correctly to show the red light.",
                            "target_lang_translations": {
                                "ru": "Сигналист проверил, правильно ли переместилось <w>очко</w> семафора, чтобы показать красный свет."
                            }
                        },
                        {
                            "text": "A cracked <w>spectacle</w> plate on the semaphore could lead to a dangerous signal failure.",
                            "target_lang_translations": {
                                "ru": "Треснувшая <w>рамка</w> с цветным стеклом на семафоре могла привести к опасному сбою сигнала."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spectacle plate",
                        "signal spectacle"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical railway terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рамка с цветным стеклом в железнодорожном семафоре, используемая для смены цвета сигнала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очко",
                                "target_lang_sense_clarification": "отверстие или рамка в семафоре"
                            },
                            {
                                "target_lang_word": "люнет",
                                "target_lang_sense_clarification": "технический термин для подвижной рамки сигнала"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53360c74-f97b-3ee3-b059-b93c82d3ab69",
                    "sense_definition": "The transparent, scale-like membrane that covers and protects the eye of a snake.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "zoology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before shedding its skin, the snake's <w>spectacle</w> often becomes cloudy or opaque.",
                            "target_lang_translations": {
                                "ru": "Перед линькой глазной <w>щиток</w> змеи часто становится мутным или непрозрачным."
                            }
                        },
                        {
                            "text": "The <w>spectacle</w> is a specialized scale that prevents the reptile's eye from drying out.",
                            "target_lang_translations": {
                                "ru": "Этот <w>щиток</w> представляет собой специализированную чешуйку, которая предохраняет глаз рептилии от высыхания."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "herpetology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прозрачная чешуйчатая мембрана, которая покрывает и защищает глаз змеи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очко",
                                "target_lang_sense_clarification": "прозрачное веко у рептилий"
                            },
                            {
                                "target_lang_word": "щиток",
                                "target_lang_sense_clarification": "защитная чешуйка глаза"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}