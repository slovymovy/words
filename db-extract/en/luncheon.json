                    {
                        "sense_id": "1dabcd75-6f66-3656-8040-dc4847286359",
                        "entry_id": "e5ce1250-a631-320b-8255-33cf9bf35d64",
                        "glosses": [
                            "Bezeichnung für ein formales Essen um die Mittagszeit; Mittagessen, Mittagsmahlzeit"
                        ],
                        "tags": [],
