                                    {
                                        "sense_id": "678bd0e6-1cff-30cd-811f-cd44a90f66e3",
                                        "entry_id": "8014d4dd-f5a7-362c-870e-83dac8421d87",
                                        "glosses": [
                                            "Overpowering, staggering, or irresistibly strong."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6439a9c-e6b9-4688-9056-10b009736f18",
                                                "sense_id": "678bd0e6-1cff-30cd-811f-cd44a90f66e3",
                                                "text": "The vote was taken at once, and it was agreed by an overwhelming majority that rats were comrades."
                                            },
                                            {
                                                "example_id": "adbaa3f5-b197-45bc-9e35-0f8e6c5ff179",
                                                "sense_id": "678bd0e6-1cff-30cd-811f-cd44a90f66e3",
                                                "text": "It is this stretch which provides what is perhaps the most staggering scenic prospect of all; the impression made on the mind by the overwhelming height of the Eiger, towering over the train, is almost impossible to describe."
                                            },
                                            {
                                                "example_id": "e876cca5-2f2c-4905-ba30-658fe9489411",
                                                "sense_id": "678bd0e6-1cff-30cd-811f-cd44a90f66e3",
                                                "text": "God is an overwhelming responsibility."
                                            },
                                            {
                                                "example_id": "733fe5fe-eaf4-4d63-ae40-355ac38870f5",
                                                "sense_id": "678bd0e6-1cff-30cd-811f-cd44a90f66e3",
                                                "text": "“What makes a eugenicist is this overwhelming faith that everything in human nature is determined by your genes,” he says."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a81df59-d816-323c-9dd4-8fbeb4aedc07",
                                        "entry_id": "8014d4dd-f5a7-362c-870e-83dac8421d87",
                                        "glosses": [
                                            "Very great or intense."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "661ca777-5e78-335f-8201-a5288380496a",
                                        "entry_id": "8014d4dd-f5a7-362c-870e-83dac8421d87",
                                        "glosses": [
                                            "Extreme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "overwhelming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40da0768-b975-3efb-a830-929dbecf2d11",
                                        "entry_id": "7d4538cb-4a12-38e3-ba6d-68fc5c584174",
                                        "glosses": [
                                            "A situation of being overwhelmed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "597b830b-67d5-4e25-a73b-1ad2582106e7",
                                                "sense_id": "40da0768-b975-3efb-a830-929dbecf2d11",
                                                "text": "They have centuries of premodern experience in coping with being overwhelmed in multiple ways—not only by God, but also by other overwhelmings that have always been part of the human condition, such as disease, famine, war […]"
                                            }
