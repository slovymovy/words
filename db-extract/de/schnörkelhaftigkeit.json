                "senses": [
                    {
                        "sense_id": "e6e3f815-0577-3a15-bf91-d624dcb964a4",
                        "entry_id": "1f3d10bc-e55c-3b35-a6fa-ad66585e4b48",
                        "glosses": [
                            "Vorhandensein zahlreicher Schnörkel, vieler geschwungener Verzierungen"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "52add2e0-125a-4547-b15a-9e1e13b87311",
                                "sense_id": "e6e3f815-0577-3a15-bf91-d624dcb964a4",
                                "text": "„Anna Baar, 1973 in Zagreb geboren und in Klagenfurt lebend, findet für dieses zur Welt kommen durch die Sprache einen lyrischen, sinnlichen Ton, der zuweilen etwas zur Schnörkelhaftigkeit neigt: Erinnerungsblüten, die üppig sprießen und wuchern, sich fast zu dekorativ um die Gegenstände ranken.“"
                            },
                            {
                                "example_id": "5f7d7869-befa-40f5-9b19-b505f849e58c",
                                "sense_id": "e6e3f815-0577-3a15-bf91-d624dcb964a4",
                                "text": "„Nichts von der geradezu barocken Schnörkelhaftigkeit, zu der Heller neigt, ist an diesem Film, komprimiert aus zehn Stunden Gespräch.“"
                            },
                            {
                                "example_id": "a5ad0100-4875-4421-83d2-a0f2d2af8f9b",
                                "sense_id": "e6e3f815-0577-3a15-bf91-d624dcb964a4",
                                "text": "„Man kann sich der Sache auch gleichsam musikalisch oder doch jedenfalls von der künstlerischen Seite her nähern und kommt dabei unversehens in die Epoche des Barock – mit all der Verspieltheit und Schnörkelhaftigkeit jener Zeit.“"
                            },
                            {
                                "example_id": "d8dead1e-9a9f-43b4-b0e4-c0c3f5c9f688",
                                "sense_id": "e6e3f815-0577-3a15-bf91-d624dcb964a4",
                                "text": "„Die graphemische Schnörkelhaftigkeit, die in manchen Textsorten zu einer üppigen ‚Letterhäufelung‘ (Harsdörffer) von mehr als fünf Konsonanten aufschwillt und zurecht als Kennzeichen barocker Schriftlichkeit gelten kann, hält sich in der eher nüchternen Textsorte ‚Verhörprotokolle‘ in Grenzen, sie ist aber durchaus ein Merkmal der untersuchten Texte.“"
                            },
                            {
                                "example_id": "e23c149e-b7d2-4a97-9778-8dded3bd0d39",
                                "sense_id": "e6e3f815-0577-3a15-bf91-d624dcb964a4",
                                "text": "„Auffällig ist die Schnörkelhaftigkeit des Rahmens um das Reliefbild.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
