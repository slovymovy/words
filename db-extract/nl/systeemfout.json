                    {
                        "sense_id": "3c4d7f3f-6443-374a-92a6-8c072dd49b7d",
                        "entry_id": "1b93763f-cd65-3108-a6ed-10711c12e941",
                        "glosses": [
                            "een fout die in de aard van iets zit ingebakken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b25d65e-82a3-4db7-a7ce-ff338494cbfd",
                                "sense_id": "3c4d7f3f-6443-374a-92a6-8c072dd49b7d",
                                "text": "Maar: alle metingen vallen zonder uitzondering juist hoger uit. Er moet volgens de ingenieurs dan ook sprake zijn van een systeemfout in het rekenmodel."
                            },
                            {
                                "example_id": "7427eb2d-7999-421f-8cc5-f938ce6f8804",
                                "sense_id": "3c4d7f3f-6443-374a-92a6-8c072dd49b7d",
                                "text": "\"Ik heb dan ook besloten om een onafhankelijk onderzoek in te stellen naar de omvang, duur en consequenties van de aan het licht gekomen systeemfout\", aldus Dekker."
                            },
                            {
                                "example_id": "1ac9c29b-ac34-489b-bbc0-4f8646de1911",
                                "sense_id": "3c4d7f3f-6443-374a-92a6-8c072dd49b7d",
                                "text": "De woonwinkel plaatste de aanbieding in juli in zijn webshop. De hoogslaper was afgeprijsd van 319 voor 24,95 euro. Het nieuws ging als een lopend vuurtje, totdat Leen Bakker bekendmaakte dat het de bedden niet tegen die prijs zou leveren. De winkel zegt dat de stuntprijs een 'systeemfout' was op de website."
                            }
                        ]
                    }
