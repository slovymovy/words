                        "cross_references": [
                            {
                                "target_word": "p.m.",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66bb2e61-fc88-3cfd-bb5f-88269993778b",
                                        "entry_id": "0a321f01-5f26-306c-a5e6-24678ee9abe7",
                                        "glosses": [
                                            "In the 12-hour period from noon to midnight (the latter half of the day) when using the 12-hour clock."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ce840e7-ddc8-41e5-99c8-1cff436182fb",
                                                "sense_id": "66bb2e61-fc88-3cfd-bb5f-88269993778b",
                                                "text": "HOURLY PRECIPITATION … 9 PM THROUGH 12 PM (MIDNIGHT) ZERO DAILY TOTAL"
                                            },
                                            {
                                                "example_id": "f604c109-0d9d-4abb-a238-53f3a135e2d1",
                                                "sense_id": "66bb2e61-fc88-3cfd-bb5f-88269993778b",
                                                "text": "We never say 12 a.m. or 12 p.m. It's either 12 midnight or 12 noon, respectively."
                                            },
                                            {
                                                "example_id": "ea1b5e3e-dcae-42fe-82ca-5176fb5a862f",
                                                "sense_id": "66bb2e61-fc88-3cfd-bb5f-88269993778b",
                                                "text": "The 12-hour clock uses A.M. for the morning hours of midnight (12:00 A.M.) to almost noon (11:59 A.M.) and the P.M. designation for the hours from noon (12:00 P.M.) to almost midnight (11:59 PM)."
                                            },
                                            {
                                                "example_id": "894e7213-f967-43ab-8e34-dabb415f0d25",
                                                "sense_id": "66bb2e61-fc88-3cfd-bb5f-88269993778b",
                                                "text": "The 12-hour clock, which is used in the U.S., Canada, and a few other countries, divides time into two cycles: a.m. (ante meridiem, Latin for before midday) from midnight, 12 a.m., to 11:59 a.m.; and p.m. (post meridiem, Latin for after midday) from noon, 12 p.m., to 11:59 p.m."
                                            },
                                            {
                                                "example_id": "4765fa6b-1a47-489c-8eeb-cbe783063705",
                                                "sense_id": "66bb2e61-fc88-3cfd-bb5f-88269993778b",
                                                "text": "Anna. — Yes, Ms. Weaver. — Are you busy? — Yes, Ms. Weaver. I am busy. — My office. 5:00 p.m. — 5:00 p.m."
                                            },
                                            {
                                                "example_id": "c949f524-9ae2-480c-a2c9-14761d81cabb",
                                                "sense_id": "66bb2e61-fc88-3cfd-bb5f-88269993778b",
                                                "text": "CNN is seeking comment from legal representation for Martin. He is scheduled to appear in court Tuesday at 3 p.m. PT (6 p.m. ET)."
                                            },
                                            {
                                                "example_id": "cb294c08-885b-4a13-bf53-fcf1dda6e949",
                                                "sense_id": "66bb2e61-fc88-3cfd-bb5f-88269993778b",
                                                "text": "The Taoyuan City Fire Department said that two others, a man and a woman, were pulled from the vehicle alive after rescuers were called to the scene of the accident near Sbunaw Bridge in Fuxing District at 12:27 p.m."
                                            },
                                            {
                                                "example_id": "6b4b1abc-2f73-46ce-8fb1-8eef1913e91c",
                                                "sense_id": "66bb2e61-fc88-3cfd-bb5f-88269993778b",
                                                "text": "Some AI startups are taking the workplace back to the dark ages, adopting the Chinese “9-9-6 work schedule” in which employees toil from 9:00 a.m. to 9:00 p.m. six days a week from Monday to Saturday."
                                            }
                                        ]
                                    }
                                ]
                            },
