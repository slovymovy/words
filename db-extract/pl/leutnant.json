                            "stopień wojskowy odpowiadający porucznikowi lub podporucznikowi w wojsku polskim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ac1af21-3d0b-4d0f-9159-204a4ca4657e",
                                "sense_id": "df50ed92-9f0e-3c1a-a7d0-a2ede5b5e0ee",
                                "text": "Do tej pory leutnant postępował spolegliwie i nawet wytypowano go do awansu."
                            }
                        ],
