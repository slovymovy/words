                "senses": [
                    {
                        "sense_id": "389b3354-6c05-3d28-a254-6887463eebfc",
                        "entry_id": "a8b75444-77eb-327a-9854-49dc2f91ea83",
                        "glosses": [
                            "Spielmarke bei Glücksspielen"
                        ],
                        "tags": [
                            "Glücksspiel"
                        ],
                        "examples": [
                            {
                                "example_id": "93dd7138-8265-4f06-a6ad-d3131f7e4fcd",
                                "sense_id": "389b3354-6c05-3d28-a254-6887463eebfc",
                                "text": "„Er verteilte an alle Mitspielenden zwanzig Jetons und erklärte, jeder Jeton gelte eine halbe Guinee.“"
                            },
                            {
                                "example_id": "d05d4b13-2954-436e-a9ad-9d57558633b2",
                                "sense_id": "389b3354-6c05-3d28-a254-6887463eebfc",
                                "text": "„Fiola begann zu spielen, und nach ein paar Minuten ließ auch Lillian ein paar Scheine in Jetons umwechseln.“"
                            },
                            {
                                "example_id": "4c24e2dc-087c-49a8-bd06-7ac7cb2368b3",
                                "sense_id": "389b3354-6c05-3d28-a254-6887463eebfc",
                                "text": "„Nur noch sieben einsame Jetons lagen vor ihr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
