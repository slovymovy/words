                        ],
                        "form": "die Vormutter"
                    },
                    {
                        "form_id": "1c13fcea-a82d-4a0b-ba22-4824a3966423",
                        "entry_id": "5976757e-3f33-35e2-b804-df19ef26aea3",
                        "tags": [
                            "accusative",
