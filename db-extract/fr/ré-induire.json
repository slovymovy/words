                "senses": [
                    {
                        "sense_id": "79df1529-e14a-3f2e-960e-91af47df10a1",
                        "entry_id": "bcff83a3-77cd-35f1-9696-a2fa0d5cc887",
                        "glosses": [
                            "Induire à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d26c1bcd-0f65-4bdf-bb19-54118b8b3fc4",
                                "sense_id": "79df1529-e14a-3f2e-960e-91af47df10a1",
                                "text": "Néanmoins, je touche quand même le patient et lui prends la main, je mets en place un signal post-hypnotique afin de ré-induire la transe plus rapidement lors d’inductions ultérieures."
                            },
                            {
                                "example_id": "d612bd2b-1df4-4894-b032-e7b88845763f",
                                "sense_id": "79df1529-e14a-3f2e-960e-91af47df10a1",
                                "text": "Là, une bobine calée sur chaque aimant devient elle-même un capteur pour le champ magnétique variable ré-induit par les roues, elles-mêmes fabriquées dans un matériau ferromagnétique."
                            }
                        ]
                    }
