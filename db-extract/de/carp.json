                ],
                "senses": [
                    {
                        "sense_id": "f073fc04-39fd-3884-bb62-d08382fcd02e",
                        "entry_id": "c7c2d5d0-a2a2-3aa4-86a0-75ec972a1ba0",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8cb7122-3559-4308-8e79-878915b5feef",
                                "sense_id": "f073fc04-39fd-3884-bb62-d08382fcd02e",
                                "text": "Frau Carp ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e4865b33-662c-40f5-a4af-cb352b02b1d4",
                                "sense_id": "f073fc04-39fd-3884-bb62-d08382fcd02e",
                                "text": "Herr Carp wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e881f613-3eea-4b2c-be63-91b610a0d479",
                                "sense_id": "f073fc04-39fd-3884-bb62-d08382fcd02e",
                                "text": "Die Carps kommen heute aus der Sächsischen Schweiz."
                            },
                            {
                                "example_id": "2fbed4ff-d0d1-468f-a446-fa8ba27ab5e2",
                                "sense_id": "f073fc04-39fd-3884-bb62-d08382fcd02e",
                                "text": "Der Carp trägt nie die Schals, die die Carp ihm strickt."
                            },
                            {
                                "example_id": "ea3fcd92-bbb3-4ee4-ad36-9066d942efb0",
                                "sense_id": "f073fc04-39fd-3884-bb62-d08382fcd02e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Carp kommt, geht der Herr Carp.“"
                            },
                            {
                                "example_id": "7e7e6f1b-5410-4350-a3ac-f3df67dcce7a",
                                "sense_id": "f073fc04-39fd-3884-bb62-d08382fcd02e",
                                "text": "Carp kommt und geht."
                            },
                            {
                                "example_id": "189aba71-c660-4071-bfbf-fd17f19143fa",
                                "sense_id": "f073fc04-39fd-3884-bb62-d08382fcd02e",
                                "text": "Carps kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
