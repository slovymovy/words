                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "loyaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>ontrouw</w> kwam hem duur te staan in zijn huwelijk.",
                            "target_lang_translations": {
