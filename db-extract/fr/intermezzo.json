                "senses": [
                    {
                        "sense_id": "6600ccef-b1a2-347f-9a20-e208a4991d99",
                        "entry_id": "b06909bb-ab5c-34a3-9b7e-93dc8a3a0f86",
                        "glosses": [
                            "Intermède musical, partie, le plus souvent intercalaire, d'une œuvre musicale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38d37898-747c-4320-8527-fbfc82e65a3f",
                                "sense_id": "6600ccef-b1a2-347f-9a20-e208a4991d99",
                                "text": "Dans Euryanthe [de Weber], l'apparition de l'ombre d'Emma, formant le poétique intermezzo de l’Ouverture."
                            },
                            {
                                "example_id": "9d843f34-28d7-472a-82ca-93c2508eb7e5",
                                "sense_id": "6600ccef-b1a2-347f-9a20-e208a4991d99",
                                "text": "Entre le premier et le deuxième morceau [d'une Sonate], on peut intercaler une petite pièce courte telle que Menuet, Scherzo, Intermezzo."
                            }
                        ]
                    },
                    {
                        "sense_id": "d41bf1ed-d91f-32d6-9f54-fd9160fedbe4",
                        "entry_id": "b06909bb-ab5c-34a3-9b7e-93dc8a3a0f86",
                        "glosses": [
                            "Coup intermédiaire censé apporter un avantage à celui qui le joue, en contraignant l'adversaire à parer une menace en lieu et place d'un coup attendu."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e48cf50f-53d0-4a4f-a136-051fda70da46",
                        "source_entry_id": "b06909bb-ab5c-34a3-9b7e-93dc8a3a0f86",
                        "target_lang_word": "Intermezzo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Intermezzo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f05014e1-3ee5-35bf-add6-cce074802247",
                                        "entry_id": "03c25a17-4a42-3893-a26e-645f48e1d491",
                                        "glosses": [
                                            "(kürzeres) stimmungsvolles Instrumentalstück"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ac1953a-95d5-4f31-b53e-3b689efa8169",
                                                "sense_id": "f05014e1-3ee5-35bf-add6-cce074802247",
                                                "text": "„Sichtbar von der Intensität ihrer Darbietung ergriffen, hatte sie bei den Intermezzi die Vibration des letzten Akkords zum Ende hin ausklingen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d991a72-8292-3c76-a06d-afdc217c0c2d",
                                        "entry_id": "03c25a17-4a42-3893-a26e-645f48e1d491",
                                        "glosses": [
                                            "vorübergehendes Geschehnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fb954fa-9d6c-4188-a1dd-21ff91e10b0f",
                                                "sense_id": "3d991a72-8292-3c76-a06d-afdc217c0c2d",
                                                "text": "„In mancher Hinsicht war das fünfzehnjährige demokratische Intermezzo bei all seinen Problemen dennoch zukunftsweisend, und zwar nicht nur für Deutschland.“"
                                            },
                                            {
                                                "example_id": "3d40f404-ab37-4c29-af10-e4b62eb78efe",
                                                "sense_id": "3d991a72-8292-3c76-a06d-afdc217c0c2d",
                                                "text": "„Alf Bertini hatte nach dem mißglückten nautischen Intermezzo verbittert zur Musik zurückgefunden, wenn auch nur als Pianist in Kaffeehaus-Ensembles, meist am Steindamm.“"
                                            },
                                            {
                                                "example_id": "e9948956-4335-4b82-8e69-79fb773b29b5",
                                                "sense_id": "3d991a72-8292-3c76-a06d-afdc217c0c2d",
                                                "text": "„Für Kinkel war damit das Berliner Intermezzo schon wieder beendet, im April 1849 kehrte er nach Bonn zurück.“"
                                            },
                                            {
                                                "example_id": "f479950c-9102-4e7e-a621-06216dbf5af5",
                                                "sense_id": "3d991a72-8292-3c76-a06d-afdc217c0c2d",
                                                "text": "„Womöglich mache ich mir eine Menge Feinde, wenn ich zugebe, dass mich diese Intermezzi zärtlich berühren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cf35dc0-83bd-4870-8d31-20dcd6407c4f",
                        "source_entry_id": "b06909bb-ab5c-34a3-9b7e-93dc8a3a0f86",
