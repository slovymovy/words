            {
                "entry_id": "80298408-f5c0-3114-a96f-c3cd79567473",
                "word": "genoeg",
                "pos": "pron",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3ee356e7-d1aa-38b1-bbfb-692a5d6cf0b9",
                        "entry_id": "80298408-f5c0-3114-a96f-c3cd79567473",
                        "glosses": [
                            "voldoende, in een hoeveelheid die niet te veel en niet te weinig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4abd295f-0dc2-4b20-ade3-110a4eee1705",
                                "sense_id": "3ee356e7-d1aa-38b1-bbfb-692a5d6cf0b9",
                                "text": "Zo is het wel genoeg thee."
                            },
                            {
                                "example_id": "06125347-60ba-49e7-b291-c8a71d5717c2",
                                "sense_id": "3ee356e7-d1aa-38b1-bbfb-692a5d6cf0b9",
                                "text": "Er zijn mensen genoeg die niet van thee houden."
                            },
                            {
                                "example_id": "6e2846d0-d109-44e1-888d-b2d25fb149a6",
                                "sense_id": "3ee356e7-d1aa-38b1-bbfb-692a5d6cf0b9",
                                "text": "Want ieder jaar gaat er een nieuw Pietje mee, klein genoeg om door de schoorstenen te roetsjen en handig in klauteren en springen."
                            },
                            {
                                "example_id": "48819d1f-7cfd-4fbc-9fde-36ac6929abcc",
                                "sense_id": "3ee356e7-d1aa-38b1-bbfb-692a5d6cf0b9",
                                "text": "Maar om te zorgen dat de boog niet instortte in de harde wind moest je een vakwerk van hout en planken bouwen dat vanaf de bodem van het dal omhoogging — er waren enorme hoeveelheden hout nodig om de ondersteuning sterk genoeg te maken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "685b3655-c6c7-436f-b7bc-69a7f16d96e0",
                        "source_entry_id": "80298408-f5c0-3114-a96f-c3cd79567473",
                        "source_sense_id": "3ee356e7-d1aa-38b1-bbfb-692a5d6cf0b9",
                        "target_lang_word": "genug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95cc59e8-8ee1-3102-9a5e-1da96a9c359c",
                                        "entry_id": "46f5320d-dd2c-30c2-a011-5890a9988635",
                                        "glosses": [
                                            "ausreichend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41156cbe-4e1b-4dae-b510-05818538a374",
                                                "sense_id": "95cc59e8-8ee1-3102-9a5e-1da96a9c359c",
                                                "text": "Es sind genug Lebensmittel für alle da."
                                            },
                                            {
                                                "example_id": "c4d1c220-abd6-4e8e-be46-edca14424e8d",
                                                "sense_id": "95cc59e8-8ee1-3102-9a5e-1da96a9c359c",
                                                "text": "[…] in Deutschland [bewegen] sich mehr als 42 Prozent der Erwachsenen nicht genug."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a3a50fc7-2796-36ea-a411-2e654b6ecae9",
                                        "entry_id": "46f5320d-dd2c-30c2-a011-5890a9988635",
                                        "glosses": [
                                            "einen bestimmten maximalen Wert erreichend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52adcd2a-f322-4072-a9e5-6c776e9d12a1",
                                                "sense_id": "a3a50fc7-2796-36ea-a411-2e654b6ecae9",
                                                "text": "Ich habe endgültig genug von deinem kindischen Verhalten!"
                                            },
                                            {
                                                "example_id": "0d3bf78e-13cd-41a7-a874-62d66f2bdd60",
                                                "sense_id": "a3a50fc7-2796-36ea-a411-2e654b6ecae9",
                                                "text": "„‚Genug der Komödie‘, sagte K. auffallend leise, legte sich nieder und zog die Decke über sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a51a5248-f103-4af7-9267-81e4390162b8",
                        "source_entry_id": "80298408-f5c0-3114-a96f-c3cd79567473",
                        "source_sense_id": "3ee356e7-d1aa-38b1-bbfb-692a5d6cf0b9",
                        "target_lang_word": "enough",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e20b3740-1726-349e-b9cf-9b6edd9b5557",
                                        "entry_id": "8e9a035b-a429-3bad-b08d-3fcd5d7987a8",
                                        "glosses": [
                                            "Sufficient; all that is required, needed, or appropriate.",
                                            "Used before a noun in the manner of words like some, a bit of, and so on."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9e9e823-3e31-4bbd-98fd-bf262349ee08",
                                                "sense_id": "e20b3740-1726-349e-b9cf-9b6edd9b5557",
                                                "text": "I've already had enough coffee today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80cc7c9a-c36f-35e7-99ef-3409b036f291",
                                        "entry_id": "8e9a035b-a429-3bad-b08d-3fcd5d7987a8",
                                        "glosses": [
                                            "Sufficient; all that is required, needed, or appropriate.",
                                            "Used after a noun."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af28d1cd-b44d-4d97-83b1-e8d078b1950a",
                                                "sense_id": "80cc7c9a-c36f-35e7-99ef-3409b036f291",
                                                "text": "There is food enough for us all."
                                            },
                                            {
                                                "example_id": "b5ef94dc-648d-4d59-b11e-b33b9bd3ddff",
                                                "sense_id": "80cc7c9a-c36f-35e7-99ef-3409b036f291",
                                                "text": "How many hired servants of my father's have bread enough and to spare!"
                                            },
                                            {
                                                "example_id": "e4a71a4d-edfd-4a7d-b987-f7fa124d5ad3",
                                                "sense_id": "80cc7c9a-c36f-35e7-99ef-3409b036f291",
                                                "text": "But it wasn’t ransom enough.\nHis captors accepted it all,\nBut didn’t let go of the king."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0706ea6a-68e2-3996-ac7c-ceb9bcc9d50d",
                                        "entry_id": "b23cf919-54ca-3a1c-9c46-b0d744c05138",
                                        "glosses": [
                                            "Sufficiently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "289ff4ad-72d4-48f7-8495-9ba0ca6eaf64",
                                                "sense_id": "0706ea6a-68e2-3996-ac7c-ceb9bcc9d50d",
                                                "text": "Those pears aren't ripe enough for the children to eat (them)."
                                            },
                                            {
                                                "example_id": "aaae703e-d95b-45e5-abd2-13eba1bae9a5",
                                                "sense_id": "0706ea6a-68e2-3996-ac7c-ceb9bcc9d50d",
                                                "text": "You've worked enough; rest for a bit."
                                            },
                                            {
                                                "example_id": "44850180-36db-4984-acbe-6a4bf3f0b36a",
                                                "sense_id": "0706ea6a-68e2-3996-ac7c-ceb9bcc9d50d",
                                                "text": "We don't have long enough nails."
                                            },
                                            {
                                                "example_id": "5d298b16-ad09-4df6-8bb1-ddf1a6029a2e",
                                                "sense_id": "0706ea6a-68e2-3996-ac7c-ceb9bcc9d50d",
                                                "text": "Of all the queer collections of humans outside of a crazy asylum, it seemed to me this sanitarium was the cup winner. […] When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose."
                                            },
                                            {
                                                "example_id": "3255a1aa-a38e-4fd8-abf6-011342c0d59c",
                                                "sense_id": "0706ea6a-68e2-3996-ac7c-ceb9bcc9d50d",
                                                "text": "The preposterous altruism too![…]Resist not evil. It is an insane immolation of self—as bad intrinsically as fakirs stabbing themselves or anchorites warping their spines in caves scarcely large enough for a fair-sized dog."
                                            },
                                            {
                                                "example_id": "521b62af-03e0-44b4-a04e-0b4b177af72b",
                                                "sense_id": "0706ea6a-68e2-3996-ac7c-ceb9bcc9d50d",
                                                "text": "‘No,’ said Luke, grinning at her. ‘You're not dull enough! […] What about the kid's clothes? I don't suppose they were anything to write home about, but didn't you keep anything? A bootee or a bit of embroidery or anything at all?’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2c9accb-72d8-3b8b-9fb0-b7920d063a55",
                                        "entry_id": "b23cf919-54ca-3a1c-9c46-b0d744c05138",
                                        "glosses": [
                                            "Fully; quite; used after adjectives to express slight augmentation of the positive degree, and sometimes equivalent to very."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1c8de6c-1038-4d4f-8f29-81402e70af12",
                                                "sense_id": "f2c9accb-72d8-3b8b-9fb0-b7920d063a55",
                                                "text": "He is ready enough to accept the offer."
                                            },
                                            {
                                                "example_id": "54c5d400-3b6f-47d6-9e5f-dddf7d7d322c",
                                                "sense_id": "f2c9accb-72d8-3b8b-9fb0-b7920d063a55",
                                                "text": "I know you well enough; you are Signior Antonio."
                                            },
                                            {
                                                "example_id": "c547d299-abda-4d2d-90a7-ff4293b1117f",
                                                "sense_id": "f2c9accb-72d8-3b8b-9fb0-b7920d063a55",
                                                "text": "“[…] it is not fair of you to bring against mankind double weapons ! Dangerous enough you are as woman alone, without bringing to your aid those gifts of mind suited to problems which men have been accustomed to arrogate to themselves.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0394e803-f0ee-32db-a5b6-1710f11215c9",
                                        "entry_id": "b23cf919-54ca-3a1c-9c46-b0d744c05138",
                                        "glosses": [
                                            "Used after certain adverbs to emphasise that a quality is notable, unexpected, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08b9bca7-4b92-4ba7-b5d4-73174925fdd3",
                                                "sense_id": "0394e803-f0ee-32db-a5b6-1710f11215c9",
                                                "text": "Talking of Mr Smith, funnily enough, I saw him just the other day."
                                            },
                                            {
                                                "example_id": "c5eaf5c6-1475-4686-80f8-0a3482e88cc7",
                                                "sense_id": "0394e803-f0ee-32db-a5b6-1710f11215c9",
                                                "text": "I left my camera on the train, but luckily enough someone handed it in to lost property."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e906be94-db30-372c-8619-8997177555f6",
                                        "entry_id": "5fd6e01e-d5d6-3c21-8e2e-805c16b5cdde",
                                        "glosses": [
                                            "A sufficient or adequate number, amount, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29f9dcc1-9758-4419-9e5d-aa67ced7f8b4",
                                                "sense_id": "e906be94-db30-372c-8619-8997177555f6",
                                                "text": "I have enough (of it) to keep me going."
                                            },
                                            {
                                                "example_id": "b4517b70-5fe2-44a8-a8f0-846d114ff754",
                                                "sense_id": "e906be94-db30-372c-8619-8997177555f6",
                                                "text": "Enough of you are here to begin the class."
                                            },
                                            {
                                                "example_id": "4a4fedac-2c6a-4224-aabb-320333d0d3d4",
                                                "sense_id": "e906be94-db30-372c-8619-8997177555f6",
                                                "text": "Get some more plates. There aren’t enough yet."
                                            },
                                            {
                                                "example_id": "0ac75b6d-1ee6-45eb-a99f-e5e6c6946c1d",
                                                "sense_id": "e906be94-db30-372c-8619-8997177555f6",
                                                "text": "Not enough is known yet about the causes of the pandemic."
                                            },
                                            {
                                                "example_id": "1c94b39f-f7ca-4394-a1a9-dce3d1639af2",
                                                "sense_id": "e906be94-db30-372c-8619-8997177555f6",
                                                "text": "I explained enough for her to understand the issue: there wasn't enough of an economic surplus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ab5694b-8968-382b-bb0c-aa9272fe4326",
                                        "entry_id": "fdaa7c79-60f4-3dfc-a783-de0beb061449",
                                        "glosses": [
                                            "Stop! Don't do that any more!"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64d1ed87-4914-491b-bee3-618db1fc178a",
                                                "sense_id": "3ab5694b-8968-382b-bb0c-aa9272fe4326",
                                                "text": "I'm sick of you complaining! Enough!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce80ee51-3f01-3aee-a98b-b1388f8b9ff7",
                                        "entry_id": "2e225d8a-9aab-3b9f-a710-4eb128038505",
                                        "glosses": [
                                            "An instance of being sufficient, or of doing something sufficiently."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "032608b6-efba-4161-bf72-180a676d09ca",
                                                "sense_id": "ce80ee51-3f01-3aee-a98b-b1388f8b9ff7",
                                                "text": "And she was neither beautiful nor handsome, but just at the point halfway between which a girl of twenty-three reaches who inherits good features and healthful figure, and who has learned to dance well, ride well, study enough, golf enough, and has attained the thousand other \"well and enoughs\" which include talking well and listening enough, and allow a woman to be liked and loved with so little consciousness that she never suspects she is particularly liked at all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b44277d-c819-4737-8f5a-d9ec85717f61",
                        "source_entry_id": "80298408-f5c0-3114-a96f-c3cd79567473",
                        "source_sense_id": "3ee356e7-d1aa-38b1-bbfb-692a5d6cf0b9",
                        "target_lang_word": "assez",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assez",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01674903-14e0-3a0d-a6ca-30e54741962e",
                                        "entry_id": "35ccdbc9-2cf6-3424-b4f3-454cdf9ddcfd",
                                        "glosses": [
                                            "Suffisamment, d'une quantité adéquate, suffisante ou tolérable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20d0f059-a8cd-4941-a248-450a30924cfb",
                                                "sense_id": "01674903-14e0-3a0d-a6ca-30e54741962e",
                                                "text": "Bert se hâta de les suivre, mais il lui fut impossible d’avancer assez vite et assez subrepticement pour surprendre en quel endroit ils avaient caché les vivres."
                                            },
                                            {
                                                "example_id": "87426089-8353-4b15-8dae-4c910e68d70d",
                                                "sense_id": "01674903-14e0-3a0d-a6ca-30e54741962e",
                                                "text": "C’est assez, cela suffit ! — Vous n’en avez jamais assez, vous êtes insatiables !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b2560b8-a19f-33a4-945a-94926493e578",
                                        "entry_id": "35ccdbc9-2cf6-3424-b4f3-454cdf9ddcfd",
                                        "glosses": [
                                            "Suffisamment nombreux. Une quantité suffisante de."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "026f84b3-32ed-4250-ab02-91675b143408",
                                                "sense_id": "6b2560b8-a19f-33a4-945a-94926493e578",
                                                "text": "Il y a assez de lumière pour ceux qui ne désirent que de voir, et assez d’obscurité pour ceux qui ont une disposition contraire."
                                            },
                                            {
                                                "example_id": "d26d3b4d-8e61-4a24-817e-767e2f2c71fd",
                                                "sense_id": "6b2560b8-a19f-33a4-945a-94926493e578",
                                                "text": "Non ! Assez de malheur, de meurtre et de ravages !\nAssez d’égorgement ! Assez de deuil ! Assez\nDe fantômes sans tête et d’affreux trépassés !\nAssez de visions funèbres dans la brume !\nAssez de doigts hideux, montrant le sang qui fume,\nNoirs, et comptant les trous des linceuls dans la nuit !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8670070-660a-3b68-bd74-e0cb70e4e2da",
                                        "entry_id": "35ccdbc9-2cf6-3424-b4f3-454cdf9ddcfd",
                                        "glosses": [
                                            "Particulièrement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "197d73ab-6741-4e3c-bfac-a84517bbc7e5",
                                                "sense_id": "d8670070-660a-3b68-bd74-e0cb70e4e2da",
                                                "text": "J’aime assez son culot, même si parfois, elle va trop loin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65aaed4f-13b9-3089-b145-0c6153615e58",
                                        "entry_id": "35ccdbc9-2cf6-3424-b4f3-454cdf9ddcfd",
                                        "glosses": [
                                            "Relativement, passablement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "215519ba-c409-4e84-b1f0-1e43d0ee4e4f",
                                                "sense_id": "65aaed4f-13b9-3089-b145-0c6153615e58",
                                                "text": "Assez bien. (Appréciation scolaire assez vague ; une chose est sûre, c’est moins que bien !)"
                                            },
                                            {
                                                "example_id": "fb5141b3-702a-4b1f-a728-0ca25c4e8f1f",
                                                "sense_id": "65aaed4f-13b9-3089-b145-0c6153615e58",
                                                "text": "C’est assez facile à réaliser mais il faut du temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a27356c5-65b3-3886-ac9b-49d18c899881",
                                        "entry_id": "35ccdbc9-2cf6-3424-b4f3-454cdf9ddcfd",
                                        "glosses": [
                                            "Considérant le contexte et l’intonation, souvent sous forme d’exclamation : qui frappe l’imagination, tellement, excessivement."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28f5801b-4e1c-4c0b-a76e-b6f2d9013734",
                                                "sense_id": "a27356c5-65b3-3886-ac9b-49d18c899881",
                                                "text": "Ch’t’assez content, là ! (Je suis assez…)"
                                            },
                                            {
                                                "example_id": "3db73b06-b6fe-4724-a6bd-7a9f1e15d7d4",
                                                "sense_id": "a27356c5-65b3-3886-ac9b-49d18c899881",
                                                "text": "Y’é’t’assez l’fun ! (Il est assez…)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "assez",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88fdb08f-c8ca-3faf-8e79-8a0278c97df8",
                                        "entry_id": "4d6573d9-ecde-3895-a332-f093faeef1d9",
                                        "glosses": [
                                            "S’emploie pour demander avec exaspération à son interlocuteur de s’arrêter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36df740c-2259-470d-89dc-f1684b36f4d1",
                                                "sense_id": "88fdb08f-c8ca-3faf-8e79-8a0278c97df8",
                                                "text": "— … Nous avons, monsieur l’Observateur, assez avalé de couleuvres, vous en êtes témoin. Mais assez, c’est assez."
                                            },
                                            {
                                                "example_id": "9e40e25a-df3f-4287-ba0d-144856c5a615",
                                                "sense_id": "88fdb08f-c8ca-3faf-8e79-8a0278c97df8",
                                                "text": "Alors aujourd’hui, je dépose ma voix à côté de ceux et celles qui ont eu la force et le courage de dire : « Assez c’est assez » !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
