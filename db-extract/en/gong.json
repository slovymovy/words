                        "target_lang_word": "gong",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gong",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "130104c8-a668-3696-bdc7-705518b354b4",
                                        "entry_id": "6f355004-311f-3d48-b9c3-b834d39965b5",
                                        "glosses": [
                                            "een hangend slagwerk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "946bc55e-4be9-4e10-9e7b-4e7dcc9bc7d4",
                                                "sense_id": "130104c8-a668-3696-bdc7-705518b354b4",
                                                "text": "De gong is een van de instrumenten van het gamelan-orkest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d9447a1-e32b-421f-bb45-ed9ea3380c63",
                        "source_entry_id": "f03d9894-892b-3844-b9e7-de5624184ce8",
                        "source_sense_description": "percussion instrument",
                        "target_lang_word": "gong",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gong",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f01c973b-8e59-3b96-9509-a536eb25bb77",
                                        "entry_id": "6addf593-2590-3a93-8bf8-3990c9037e0d",
                                        "glosses": [
                                            "Percussion d’Extrême-Orient, composée d’un disque de métal dont on tire des sons retentissants en le frappant avec une baguette garnie de peau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a9a8a15-2e45-4fbb-ab99-e64a972aa137",
                                                "sense_id": "f01c973b-8e59-3b96-9509-a536eb25bb77",
                                                "text": "Le Chinois s'agenouille sur un coussin ou paillasson placé devant l'autel, s'incline trois fois en agitant ses bâtons d'encens, puis les dépose dans un brûle-parfum, tandis que le prêtre frappe sur un gong pour attirer l'attention du dieu ; lequel, sans cette précaution, serait supposé ne pas s'apercevoir de la présence de ses adorateurs."
                                            },
                                            {
                                                "example_id": "50a499ac-69fd-41de-b271-c3a054842a39",
                                                "sense_id": "f01c973b-8e59-3b96-9509-a536eb25bb77",
                                                "text": "Plus de 3.000 objets au total y sont présentés, liés étroitement à leur vie quotidienne, dont plusieurs sont d’une grande valeur culturelle comme gongs, brûle-parfums en cuir ou métiers à tisser."
                                            },
                                            {
                                                "example_id": "28631b0d-c014-45c9-a21d-55042dc7990d",
                                                "sense_id": "f01c973b-8e59-3b96-9509-a536eb25bb77",
                                                "text": "Aussitôt que l’astre divin fut monté de l’horizon, les vibrations d’un gong se firent entendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0743a659-0d0c-39d0-8955-19e7feb443b0",
                                        "entry_id": "6addf593-2590-3a93-8bf8-3990c9037e0d",
                                        "glosses": [
                                            "Dispositif de forme analogue dont on se sert comme signal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a248f09e-010f-4643-bfc7-0fca4efbb05f",
                                                "sense_id": "0743a659-0d0c-39d0-8955-19e7feb443b0",
                                                "text": "En effet, à l’appel du gong, Habib se porta rapidement à la rencontre du Suédois et le bombarda sans arret de swings si vigoureux à la poitrine que l’autre s’écroula."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28d5b072-c998-3518-82d5-8eed3222c6bb",
                                        "entry_id": "6addf593-2590-3a93-8bf8-3990c9037e0d",
                                        "glosses": [
                                            "Timbre métallique ou sonnerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f1b59af-947e-46bd-839d-a990d0db46bd",
                                                "sense_id": "28d5b072-c998-3518-82d5-8eed3222c6bb",
                                                "text": "Les nuits de Cap Juby, de quart d’heure en quart d’heure, étaient coupées comme par le gong d’une horloge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30d31ea8-1a47-32d3-aa1e-500d0516feac",
                                        "entry_id": "6addf593-2590-3a93-8bf8-3990c9037e0d",
                                        "glosses": [
                                            "Timbre retentissant annonçant le début ou la fin d'un round de boxe."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1f77224-6bcc-469c-aceb-2a0e9d3778d6",
                                                "sense_id": "30d31ea8-1a47-32d3-aa1e-500d0516feac",
                                                "text": "[Boxeur] sauvé par le gong, boxeur à qui la fin du round donne du répit et permet de reconstituer ses forces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59110590-44ff-3788-9744-08761ec67371",
                                        "entry_id": "6addf593-2590-3a93-8bf8-3990c9037e0d",
                                        "glosses": [
                                            "Symbole de la fatalité, de la fin."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0e1e46d-fd81-4788-9459-9a413047a043",
                                                "sense_id": "59110590-44ff-3788-9744-08761ec67371",
                                                "text": "J'ai entendu le gong sonner. Le gong brandi par ma mère : « Rien n’est possible. » « La vie est une tartine de merde. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1868b1a4-1136-4962-9ada-94e0abf2ce27",
                        "source_entry_id": "f03d9894-892b-3844-b9e7-de5624184ce8",
                        "source_sense_description": "percussion instrument",
                        "target_lang_word": "Gong",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gong",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f20d2d67-b381-37f6-8fce-42735254c6fe",
                                        "entry_id": "8a4fde91-06be-32b2-a7ec-c7a0dcf454df",
                                        "glosses": [
                                            "selbstklingendes Schlaginstrument aus einer freischwingenden Metallscheibe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7aa9f1b-28c6-4ed1-8848-e43720523745",
                                                "sense_id": "f20d2d67-b381-37f6-8fce-42735254c6fe",
                                                "text": "Das asiatisch anmutende Stück begann mit einem krachenden Schlag auf den Gong."
                                            },
                                            {
                                                "example_id": "7ab00858-0e44-4ae4-96ce-66616b51bbf2",
                                                "sense_id": "f20d2d67-b381-37f6-8fce-42735254c6fe",
                                                "text": "„Der Gong ertönte, und wir schoben ihn nach vorn.“"
                                            },
                                            {
                                                "example_id": "b38c8f96-5b39-43d2-b366-cd8dce88ba67",
                                                "sense_id": "f20d2d67-b381-37f6-8fce-42735254c6fe",
                                                "text": "„Die beiden Gongs und Trommeln aus Kupfer trugen bunte Malerei und Goldverzierung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f075fe0-156a-3881-a8f9-657625968ecb",
                                        "entry_id": "8a4fde91-06be-32b2-a7ec-c7a0dcf454df",
                                        "glosses": [
                                            "ein meist elektronisch erzeugter, akustischer Signalton bzw. das diesen Ton erzeugende Gerät"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "862944ac-bc83-4e9e-ab8b-1acef336a7d5",
                                                "sense_id": "2f075fe0-156a-3881-a8f9-657625968ecb",
                                                "text": "Am Bahnhof ertönt vor jeder Durchsage ein Gong."
                                            },
                                            {
                                                "example_id": "09aa36c7-9512-4cb0-8b3c-e88134d09c9c",
                                                "sense_id": "2f075fe0-156a-3881-a8f9-657625968ecb",
                                                "text": "Als endlich der Gong zur großen Pause ertönte, gab es für die Schüler kein Halten mehr."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
