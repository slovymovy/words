                "entry_id": "fa63dea3-8199-30c8-8f59-f02cc3a59815",
                "word": "rincette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1532dee6-690d-4025-bdfa-18126594bb56",
                        "entry_id": "fa63dea3-8199-30c8-8f59-f02cc3a59815",
                        "tags": [
                            "plural"
                        ],
                        "form": "rincettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b666154-7fef-36d5-8d96-d1872fdc542f",
                        "entry_id": "fa63dea3-8199-30c8-8f59-f02cc3a59815",
                        "glosses": [
                            "Coup de vin servi, soi-disant pour rincer le verre."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0440b2b3-759b-411e-a2e3-a3f5f3f869bd",
                                "sense_id": "1b666154-7fef-36d5-8d96-d1872fdc542f",
                                "text": "Un gloria, une rincette, ça ne se refuse jamais, voyons !"
                            },
                            {
                                "example_id": "59ef0ab0-0f60-46eb-a81e-10b698febf4c",
                                "sense_id": "1b666154-7fef-36d5-8d96-d1872fdc542f",
                                "text": "Nous eûmes une bonne rincette et une petite consolation. Pour finir, je me chargeai spécialement du brûlot."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fc48f54-83b4-3fa4-95b0-ef9c6dfe7e68",
                        "entry_id": "fa63dea3-8199-30c8-8f59-f02cc3a59815",
                        "glosses": [
                            "Petite quantité d’eau-de-vie qu’on verse dans la tasse quand on a bu le café."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91ea9dba-8d6b-4b90-bc88-f5bbb91a51e4",
                                "sense_id": "3fc48f54-83b4-3fa4-95b0-ef9c6dfe7e68",
                                "text": "Puis le docteur, s’emparant soudain de la bouteille d’eau-de-vie, versa la rincette à tout le monde. Et, sans parler, engourdis dans la chaleur douce de la digestion, saisis malgré eux par ce bien-être animal que donne l’alcool après dîner, ils se gargarisaient lentement avec le cognac sucré qui formait un sirop jaunâtre au fond des tasses."
                            },
                            {
                                "example_id": "e265f09a-5e8d-42b9-812c-f2c8f991575b",
                                "sense_id": "3fc48f54-83b4-3fa4-95b0-ef9c6dfe7e68",
                                "text": "— Pousse-café, rincette, surrincette. Vous avez dû vous faire jolis."
                            },
                            {
                                "example_id": "0f1a00f2-79e6-48af-a8e8-b2624f94f1b3",
                                "sense_id": "3fc48f54-83b4-3fa4-95b0-ef9c6dfe7e68",
                                "text": "Sois pas salaud, mets-lui la rincette."
                            }
                        ]
                    }
                ],
