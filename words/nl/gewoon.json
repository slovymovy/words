                {
                    "sense_id": "33c8375e-3908-34c6-8999-54dae3ae1fc9",
                    "sense_definition": "Zonder meer; simpelweg; alleen maar.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "simply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet <gewoon> op het knopje drukken om te starten.",
                            "target_lang_translations": {
                                "en": "You <w>just</w> have to press the button to start.",
                                "ru": "Тебе нужно <просто> нажать на кнопку, чтобы начать.",
                                "pl": "Musisz <w>po prostu</w> nacisnąć przycisk, aby uruchomić.",
                                "de": "Du musst <w>einfach</w> auf den Knopf drücken, um zu starten.",
                                "fr": "Il te suffit <w>juste</w> d'appuyer sur le bouton pour démarrer.",
                                "it": "Devi <w>semplicemente</w> premere il pulsante per iniziare.",
                                "cs": "Pro spuštění musíš <w>prostě</w> zmáčknout tlačítko.",
                                "tr": "Başlatmak için <w>sadece</w> düğmeye basman gerekiyor.",
                                "es": "<w>Simplemente</w> tienes que pulsar el botón para empezar."
                            }
                        },
                        {
                            "text": "Ik wil <gewoon> even rustig op de bank zitten.",
                            "target_lang_translations": {
                                "en": "I <w>just</w> want to sit quietly on the couch for a while.",
                                "ru": "Я <просто> хочу спокойно посидеть на диване.",
                                "pl": "Chcę <w>po prostu</w> chwilę posiedzieć spokojnie na kanapie.",
                                "de": "Ich möchte <w>einfach</w> nur kurz ruhig auf dem Sofa sitzen.",
                                "fr": "Je veux <w>simplement</w> m'asseoir tranquillement sur le canapé un instant.",
                                "it": "Voglio <w>solo</w> stare seduto tranquillamente sul divano per un po'.",
                                "cs": "Chci si <w>prostě</w> na chvíli v klidu sednout na pohovku.",
                                "tr": "<w>Sadece</w> kanepede biraz sessizce oturmak istiyorum.",
                                "es": "<w>Solo</w> quiero sentarme un rato tranquilo en el sofá."
                            }
                        },
                        {
                            "text": "Het is <gewoon> een kwestie van goed opletten.",
                            "target_lang_translations": {
                                "en": "It is <w>simply</w> a matter of paying close attention.",
                                "ru": "Это <просто> вопрос внимательности.",
                                "pl": "To <w>po prostu</w> kwestia uważnego uważaia.",
                                "de": "Es ist <w>einfach</w> eine Frage der Aufmerksamkeit.",
                                "fr": "C'est <w>tout simplement</w> une question de bien faire attention.",
                                "it": "È <w>semplicemente</w> una questione di fare molta attenzione.",
                                "cs": "Je to <w>jednoduše</w> otázka dobré pozornosti.",
                                "tr": "Bu <w>sadece</w> dikkatli olma meselesidir.",
                                "es": "Es <w>simplemente</w> una cuestión de prestar mucha atención."
                            }
                        }
                    ],
