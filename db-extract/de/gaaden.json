                ],
                "senses": [
                    {
                        "sense_id": "518b5746-cc99-3080-88d1-e113c1b6f8a8",
                        "entry_id": "eb393944-b40b-3840-b246-bb8e35a65a64",
                        "glosses": [
                            "niederösterreichische Gemeinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba347454-d2e9-4fb1-9943-defd2e1f681f",
                                "sense_id": "518b5746-cc99-3080-88d1-e113c1b6f8a8",
                                "text": "Die Wienerwaldgemeinde Gaaden liegt zwischen Mödling und Heiligenkreuz am Westhang des Anningers."
                            },
                            {
                                "example_id": "b3f958e7-6754-4653-b00a-5fc966be25a1",
                                "sense_id": "518b5746-cc99-3080-88d1-e113c1b6f8a8",
                                "text": "„Von der Höldrichsmühle in der Hinterbrühl führt eine Fahrstrasse, welche nach einer halben Stunde rechts von der nach Gaaden und Heiligenkreuz führenden abzweigt, und ein etwas näherer Weg über Weissenbach nach Sparbach (1 bis 1 1/4 Std.). …“"
                            },
                            {
                                "example_id": "755fe5e8-bb46-4af4-860a-eaa59f49eecd",
                                "sense_id": "518b5746-cc99-3080-88d1-e113c1b6f8a8",
                                "text": "Die Pfarre Gaaden wird seit 1579 durch Stiftsgeistliche betreut."
                            },
                            {
                                "example_id": "c0d13093-31ce-4857-8ea8-88db8ea88730",
                                "sense_id": "518b5746-cc99-3080-88d1-e113c1b6f8a8",
                                "text": "Am 15. August 1926 wurde in Gaaden am Haus Heiligenkreuzer Straße 1, in dem Raimund am 2. Dezember 1833 den Verschwender vollendet hatte, eine Gedenktafel mit Porträtmedaillon enthüllt."
                            },
                            {
                                "example_id": "7b5b5e0b-07ca-42d7-aa9d-131f92a149aa",
                                "sense_id": "518b5746-cc99-3080-88d1-e113c1b6f8a8",
                                "text": "Für Gumpoldskirchen und seine Musikschulen war es ein erfreulicher Tag, konnte doch Frederic Lipgens aus Gaaden Platz 1 belegen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
