                "senses": [
                    {
                        "sense_id": "6113265b-d7fa-3b73-b1a6-7fe8c1095e97",
                        "entry_id": "a90bb077-17c3-375d-a405-694a057b81f0",
                        "glosses": [
                            "Eingangshalle eines Hotels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47b3f36b-481a-4234-9407-2ba304fac152",
                                "sense_id": "6113265b-d7fa-3b73-b1a6-7fe8c1095e97",
                                "text": "Er verabredete sich mit seinem Geschäftspartner in der Hotellobby."
                            },
                            {
                                "example_id": "c912cfc3-d329-4985-b78f-8300452b7f69",
                                "sense_id": "6113265b-d7fa-3b73-b1a6-7fe8c1095e97",
                                "text": "„Wir lernen uns am ersten Abend der Reise kennen, als die Gruppe in einer Hotellobby in Reykjavík zusammenkommt.“"
                            },
                            {
                                "example_id": "09d18ee5-7a8d-4b2f-a910-12b48259cf70",
                                "sense_id": "6113265b-d7fa-3b73-b1a6-7fe8c1095e97",
                                "text": "„Als mein Führer mich in die Wandelhalle begleitet, entdecke ich den schlichten Charme einer Hotellobby.“"
                            },
                            {
                                "example_id": "4a1b3bf2-1d07-4910-945f-aad12b3398c9",
                                "sense_id": "6113265b-d7fa-3b73-b1a6-7fe8c1095e97",
                                "text": "„Ich sah den Ring an seinem Finger, dachte aber, auf eine Party zu gehen sei unverfänglicher als in einer Hotellobby zu sitzen.“"
                            },
                            {
                                "example_id": "9e81bf34-fbf2-4e42-88b0-1179230d45a0",
                                "sense_id": "6113265b-d7fa-3b73-b1a6-7fe8c1095e97",
                                "text": "„In der Hotellobby schlägt Vicky einen Absacker auf der Dachterrasse vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
