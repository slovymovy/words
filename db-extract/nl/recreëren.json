                            "unergative"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6639db17-cb57-432b-9808-343e96ae4176",
                        "source_entry_id": "21348ead-534f-3bce-891d-ed540e5aa7f8",
                        "source_sense_id": "6e2b3040-0316-3823-aad7-18b02703284b",
                        "target_lang_word": "récréer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "récréer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee0ce295-cbb7-3e46-afb2-91d8ee99ac07",
                                        "entry_id": "5bd4e91e-76de-30ec-b9bb-95b191589dc0",
                                        "glosses": [
                                            "Réjouir, divertir, délasser."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb9f9c7a-f13e-41f1-9d69-86b16b8af91c",
                                                "sense_id": "ee0ce295-cbb7-3e46-afb2-91d8ee99ac07",
                                                "text": "Comme la bouffonnerie ne divertit un honnête homme que par de petits intervalles, il faut la finir à propos et ne pas donner le temps à l’esprit de revenir à la justesse du discours et à l’idée du vrai naturel. Cette économie serait à désirer dans la comédie italienne, où le premier dégoût est suivi d’un nouvel ennui plus lassant encore, et où la variété, au lieu de vous récréer, ne vous apporte qu’une autre sorte de langueur."
                                            },
                                            {
                                                "example_id": "258e72d4-c75f-4093-a4c1-fde7eae573c6",
                                                "sense_id": "ee0ce295-cbb7-3e46-afb2-91d8ee99ac07",
                                                "text": "Bon prieur Aymer, […], sachez que je ne me soucie pas des raffinements d’outre-mer, sans le secours desquels je puis très bien me récréer dans les bois."
                                            },
                                            {
                                                "example_id": "2f63be5b-b615-4126-bab2-f3004c9ce64c",
                                                "sense_id": "ee0ce295-cbb7-3e46-afb2-91d8ee99ac07",
                                                "text": "Sa femme, pour le récréer, fit venir des jongleurs et des danseuses."
                                            },
                                            {
                                                "example_id": "c843ecbc-e5df-48dc-bf8f-ad4b4781342f",
                                                "sense_id": "ee0ce295-cbb7-3e46-afb2-91d8ee99ac07",
                                                "text": "Les travaux de dentellerie, qui jadis récréaient ses doigts par leur grâce menue, qui la faisaient rêver de baptêmes et de mariages, lui paraissaient maintenant une tâche odieuse, qu’elle accomplissait avec dégoût."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7599e8b7-893f-321a-9fba-b9ee23362d04",
                                        "entry_id": "5bd4e91e-76de-30ec-b9bb-95b191589dc0",
                                        "glosses": [
                                            "Stimuler."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47b90e32-ca2b-44ee-b06c-fdc99d82b9af",
                                                "sense_id": "7599e8b7-893f-321a-9fba-b9ee23362d04",
                                                "text": "Le vin récrée les esprits, Le vin ranime les esprits,"
                                            },
                                            {
                                                "example_id": "f343086f-382c-4672-ae23-c814a50d44fb",
                                                "sense_id": "7599e8b7-893f-321a-9fba-b9ee23362d04",
                                                "text": "Le vert récrée la vue, Le vert est agréable à la vue."
                                            },
                                            {
                                                "example_id": "5e6f655d-e8dd-4af7-82f6-19d0252cb78a",
                                                "sense_id": "7599e8b7-893f-321a-9fba-b9ee23362d04",
                                                "text": "Mais chacun se délassait ainsi des fatigues du cheval et se récréait à la conversation de cette aimable femme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
