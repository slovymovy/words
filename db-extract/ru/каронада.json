                "senses": [
                    {
                        "sense_id": "e626de78-bfad-31b0-9b12-97e3fdc406f3",
                        "entry_id": "b4e2c79b-d26e-304a-bd27-85f7478d94e2",
                        "glosses": [
                            "истор., воен. гладкоствольная корабельная пушка большого калибра с укороченным стволом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f98201c8-691f-439d-912f-159ca1a25006",
                                "sense_id": "e626de78-bfad-31b0-9b12-97e3fdc406f3",
                                "text": "На возглас крепостных каронад фрегаты царские отозвались оглушительным грохотом; воздух потрясся, земля задрожала, и народ русский, обнажив голову, набожно перекрестился."
                            },
                            {
                                "example_id": "d6c38d76-83d4-4042-962f-580183d3bd8c",
                                "sense_id": "e626de78-bfad-31b0-9b12-97e3fdc406f3",
                                "text": "Корабль будет вооружен тридцатью шестью тяжелыми каронадами и таким же количеством средних морских пушек, стреляющих двадцатифунтовыми ядрами."
                            }
                        ]
                    }
