                        "examples": [
                            {
                                "example_id": "427e79ad-29a4-454b-bd13-405a28ce32ae",
                                "sense_id": "689a259b-66d3-3682-ac25-43358e1f966c",
                                "text": "This will be the way to obtain an indefinitely large supply of antimatter which can then by used to power the kind of ships that would make interstellar travel possible."
