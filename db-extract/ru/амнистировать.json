                                                "sense_id": "bb98e4fd-8f65-36f8-88ab-f84382b408d0",
                                                "text": "Beni affedin, gelemeyeceğim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baf3734b-1bc1-3406-bc4a-7557817a6ad6",
                                        "entry_id": "b9e827af-0f74-3b60-8dda-7cad4bae0bbe",
                                        "glosses": [
                                            "birinin sorumluluğundaki bir görevden veya işten çıkmasına izin vermek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42cb4f3b-6893-46a0-b666-f031de8c3ae3",
                                                "sense_id": "baf3734b-1bc1-3406-bc4a-7557817a6ad6",
                                                "text": "Beni bu çalışmadan bir defalık affedin lütfen."
                                            }
