                ],
                "senses": [
                    {
                        "sense_id": "21987569-f8fe-39e8-a01f-7751ad91b698",
                        "entry_id": "d0500ee1-1091-36c7-a315-8b39d6a2cc1f",
                        "glosses": [
                            "Grund-/Übersichtsinformation über etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7347d18b-1079-4acb-a5b0-e56a80eaa1ec",
                                "sense_id": "21987569-f8fe-39e8-a01f-7751ad91b698",
                                "text": "„Ein Exposé zur Vorbereitung der entscheidenden Sitzung des Ausschusses am 15.2.2013 umgrenzte die Thematik und schätzte die zeitlichen Vorgaben ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5ad4ee18-e2fc-342b-bc83-710af9119d4f",
                        "entry_id": "d0500ee1-1091-36c7-a315-8b39d6a2cc1f",
                        "glosses": [
                            "Darstellung einer Planung, Skizzierung von Inhalten, zum Beispiel für einen Film, ein Buch oder eine Doktorarbeit oder auch vor dem Börsengang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75526100-651a-4327-b68a-61acaebfe55a",
                                "sense_id": "5ad4ee18-e2fc-342b-bc83-710af9119d4f",
                                "text": "Das Exposé ist in der Filmbranche eine Art Bewerbungsunterlage – oder vielleicht besser noch: ein Angebot an die Produzenten."
                            },
                            {
                                "example_id": "310c2aa8-e972-4956-a132-be75cae67e92",
                                "sense_id": "5ad4ee18-e2fc-342b-bc83-710af9119d4f",
                                "text": "„Das heißt, ich rufe ein paar Leute an und bitte sie, da mal reinzuschauen, und ich versende die ersten drei Kapitel inklusive Exposé an ein paar Verlage.“"
                            },
                            {
                                "example_id": "f4897167-0eb3-4cfc-ab23-c54cdc805357",
                                "sense_id": "5ad4ee18-e2fc-342b-bc83-710af9119d4f",
                                "text": "„Er reichte mir mein Exposé.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
