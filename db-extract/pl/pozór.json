                "senses": [
                    {
                        "sense_id": "31d588c1-bb85-3e92-adb1-b1456a91067e",
                        "entry_id": "160b67c9-9efd-31df-9468-916398fdad2f",
                        "glosses": [
                            "to, co jest widoczne na zewnątrz, nierzadko udane"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14cb1a39-7452-4aed-b562-13c02b86b96d",
                                "sense_id": "31d588c1-bb85-3e92-adb1-b1456a91067e",
                                "text": "Kaśka wydaje się być radosna, ale to tylko pozory. Śmierć przyjaciela bardzo ją przybiła."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "57b0a9c3-c5fd-3ed0-a6c6-9e00af646c0e",
                        "entry_id": "160b67c9-9efd-31df-9468-916398fdad2f",
                        "glosses": [
                            "gw. (Śląsk Cieszyński i Górny Śląsk) uwaga"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf443697-03d8-4633-9511-6a82e3c5afc8",
                                "sense_id": "57b0a9c3-c5fd-3ed0-a6c6-9e00af646c0e",
                                "text": "Dej se pozór.",
                                "translation": "Uważaj."
                            }
                        ],
