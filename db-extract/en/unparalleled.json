                ],
                "senses": [
                    {
                        "sense_id": "6a523776-958e-332b-832d-754150eb6560",
                        "entry_id": "ed970735-867f-34ea-a767-14e02a1144c2",
                        "glosses": [
                            "Having no parallel; without equal; lacking anything similar or worthy of comparison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce9f4c9f-2c78-43a5-8fba-3fb44f185cb1",
                                "sense_id": "6a523776-958e-332b-832d-754150eb6560",
                                "text": "The candidate experienced unparalleled support in the last election."
                            },
                            {
                                "example_id": "c7b9f066-68e1-432a-a49a-882ab910eec8",
                                "sense_id": "6a523776-958e-332b-832d-754150eb6560",
                                "text": "Experience had taught me, that woman's falsehood was no unparalleled marvel; but it had coupled with this conviction, that nothing in after life can atone for the bitterness of our first rude awakening."
                            },
                            {
                                "example_id": "bea177f6-9bea-461d-99d0-94a4ee2766a2",
                                "sense_id": "6a523776-958e-332b-832d-754150eb6560",
                                "text": "“Let us go out and drink to the very good health of Monsieur Tarzan in some of old Plancon’s unparalleled absinth; not forgetting that the Count de Coude is one of the best swordsmen in Paris, and by far the best shot in all France.”"
                            },
                            {
                                "example_id": "315a89f0-0b1c-4ab0-b3c6-598290e62e70",
                                "sense_id": "6a523776-958e-332b-832d-754150eb6560",
                                "text": "Such equipment has had to bear the unparalleled stress of wartime operation without the maintenance and renewal it would have received under the far easier conditions of peacetime working."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59dc1ee2-3c36-460e-bee5-705d3c0d3739",
                        "source_entry_id": "ed970735-867f-34ea-a767-14e02a1144c2",
                        "source_sense_id": "6a523776-958e-332b-832d-754150eb6560",
                        "source_sense_description": "having no parallel",
                        "target_lang_word": "ongeëvenaard",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ongeëvenaard",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f0c79184-72fa-34fb-91fc-a9951820d6cd",
                                        "entry_id": "dacc40c7-867b-3e54-9f77-32d14d2b8417",
                                        "glosses": [
                                            "van een niveau dat niet door iets anders bereikt is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91649840-fff7-4f40-9506-bb575764e204",
                                                "sense_id": "f0c79184-72fa-34fb-91fc-a9951820d6cd",
                                                "text": "Dit is een ongeëvenaarde prestatie."
                                            },
                                            {
                                                "example_id": "5cc7eb96-aff9-4637-be32-733dcdf20357",
                                                "sense_id": "f0c79184-72fa-34fb-91fc-a9951820d6cd",
                                                "text": "'Meneer, het zou kunnen dat ik inderdaad iets heb vernomen van de geruchten waar u op zinspeelt. Maar als die verhalen kloppen, zou er mijns inziens sprake zijn van een plaag van blindheid. Prins Henry zou toch blind hebben moeten zijn om zijn aanbedene niet te herkennen, of om een lelijk meisje aan te zien voor een ongeëvenaarde schoonheid? En mijn dochters zouden wel blind hebben moeten zijn voor hun spiegelbeeld en voor de blik in de ogen van degenen die hen aankijken...'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b173d41-ccc3-40d7-ac0c-333249237800",
                        "source_entry_id": "ed970735-867f-34ea-a767-14e02a1144c2",
                        "source_sense_id": "6a523776-958e-332b-832d-754150eb6560",
                        "source_sense_description": "having no parallel",
                        "target_lang_word": "sans égal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans égal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30e58820-1a64-33ee-981f-5667b6135da7",
                                        "entry_id": "fce24388-c1c6-3a95-a5f8-438cead136fd",
                                        "glosses": [
                                            "Excellent et unique, incomparable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9f4c9d5-7bb2-4e5a-9ba8-eb79f0281a70",
                                                "sense_id": "30e58820-1a64-33ee-981f-5667b6135da7",
                                                "text": "Je ne parle, monsieur, que de sa supériorité aux armes ; d’après la réputation qu’on lui a faite, il a un talent sans égal."
                                            },
                                            {
                                                "example_id": "0d934890-4b5b-4999-bfc7-c1abab01564b",
                                                "sense_id": "30e58820-1a64-33ee-981f-5667b6135da7",
                                                "text": "Deux noirs limiers de la race de saint Hubert, fameux par leur courage et leur vitesse sans égale, le serrent de près, et sont sur le point de l’atteindre."
                                            },
                                            {
                                                "example_id": "6256f9db-223a-4046-ae16-00a76cd29854",
                                                "sense_id": "30e58820-1a64-33ee-981f-5667b6135da7",
                                                "text": "Lorsque nous restions au palais, nous nous occupions de musique, je chantais avec la grande-duchesse et ma cousine, dont la voix avait un timbre d’une pureté, d’une suavité sans égales, et que je n’ai jamais pu entendre sans me sentir remué jusqu’au fond de l’âme."
                                            },
                                            {
                                                "example_id": "0c15c95a-ac80-4915-b61d-e00850c8de92",
                                                "sense_id": "30e58820-1a64-33ee-981f-5667b6135da7",
                                                "text": "L’esprit de cette armée était admirable, l’élan qui emportait vers la terre d’Afrique tous ces vaillants hommes sans égal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "726ebd2d-b592-46e2-890a-76c6733c14e2",
                        "source_entry_id": "ed970735-867f-34ea-a767-14e02a1144c2",
                        "source_sense_id": "6a523776-958e-332b-832d-754150eb6560",
                        "source_sense_description": "having no parallel",
                        "target_lang_word": "incomparable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incomparable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa13d1d1-b87f-3dcd-8d8f-c30be35eef7d",
                                        "entry_id": "412c659c-07e4-3d6e-ac8d-7e453306143a",
                                        "glosses": [
                                            "À qui ou à quoi rien ne peut être comparé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71f1ae0b-ee3b-4ebe-895c-f889c3efa33f",
                                                "sense_id": "fa13d1d1-b87f-3dcd-8d8f-c30be35eef7d",
                                                "text": "Puis, après une demi-heure d’un incomparable éclat, sans qu’il se fût resserré ni concentré, sans un amoindrissement même partiel de sa lumière, le splendide météore s'éteignit soudain, […]."
                                            },
                                            {
                                                "example_id": "21625221-a492-45dc-bc68-e02e9b093e04",
                                                "sense_id": "fa13d1d1-b87f-3dcd-8d8f-c30be35eef7d",
                                                "text": "Au bout d'une heure nous atteignons la cime, du haut de laquelle on domine tout l'archipel féroésien; contemplée au crépuscule de minuit, cette vue est d'une incomparable magnificence."
                                            },
                                            {
                                                "example_id": "22bfca14-af4c-4349-bed3-a2c21f0a7698",
                                                "sense_id": "fa13d1d1-b87f-3dcd-8d8f-c30be35eef7d",
                                                "text": "Ce chef de gouvernement capable de discuter avec Einstein la théorie de la relativité de l'espace et du temps emprunte à sa vie intérieure un incomparable prestige."
                                            },
                                            {
                                                "example_id": "c94605fd-d948-4b61-847d-86b5c9e52cc6",
                                                "sense_id": "fa13d1d1-b87f-3dcd-8d8f-c30be35eef7d",
                                                "text": "Le Caux est une terre à blé, mais la vallée verdoyante du Bray est un immense et magnifique pâturage où un élevage intensif se pratique dans des prés incomparables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7111d5fa-017b-4897-bbb8-2278233e6d31",
                        "source_entry_id": "ed970735-867f-34ea-a767-14e02a1144c2",
