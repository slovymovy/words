                        "entry_id": "aa3eb449-94d0-389c-8340-981718ec78fc",
                        "glosses": [
                            "Vertreter der Gattung der Brunellen (fachsprachlich: Brunella)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cb7e329-fc6f-4da1-a32f-e35f758a3d2d",
                                "sense_id": "458769d3-3b3a-3e7e-8518-71a86e0df9af",
                                "text": "„Von den Brunellen z. B. gibt’s teils ganze Wiesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a7785e1b-371b-3da5-a82f-a77a9923b03f",
                        "entry_id": "aa3eb449-94d0-389c-8340-981718ec78fc",
                        "glosses": [
                            "Vertreter einer alpinen Orchideenart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75e442b0-3313-4237-8778-778b4de6ade0",
                                "sense_id": "a7785e1b-371b-3da5-a82f-a77a9923b03f",
                                "text": "„Ich lief über schöne sattgrüne Wiesen, dann guckte auf einmal eine Brunelle, ein Schwarzes Kohlröschen hinter einem dunklen Baumstumpf hervor. Diese Orchidee erfrischte mit ihrem seltsamen Vanilleduft.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
