                        "sense_id": "da4c48e1-e225-3a0c-a0d8-b5e6e2726db2",
                        "entry_id": "972cf0f3-8f3b-3a7b-89ed-bf49897787b4",
                        "glosses": [
                            "A sporangium for androspores."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19b8b08c-9e33-46ef-8f5c-283742bb5f72",
                                "sense_id": "da4c48e1-e225-3a0c-a0d8-b5e6e2726db2",
                                "text": "The androsporangia are formed in a series by the repeated transverse division of any vegetative cell of a large filament. The contents of each androsporangium are metamorphosed into a single androspore."
                            },
                            {
                                "example_id": "39bc46fe-1481-42dc-9a64-ff0529733ac6",
                                "sense_id": "da4c48e1-e225-3a0c-a0d8-b5e6e2726db2",
                                "text": "The androsporangia produce the androspores which are special kinds of zoospores and give rise to the “dwarf males” as in Œdogonium."
                            },
                            {
                                "example_id": "2a780b8c-0f86-4eea-a4a4-ab1f85526ea8",
                                "sense_id": "da4c48e1-e225-3a0c-a0d8-b5e6e2726db2",
                                "text": "The androsporangium is usually produced in the neighbourhood of an oogonium and becomes the mother-cell of a motile ciliated spore known as an androspore, intermediate in size between an antherozoid and a zoogonidium."
                            }
                        ]
                    }
                ],
