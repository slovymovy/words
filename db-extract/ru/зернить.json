                                                "example_id": "dd99a810-c65b-4650-b028-505061ab427c",
                                                "sense_id": "8889da4b-735a-3d8a-847d-91af2fcd6828",
                                                "text": "„Diese Maschine teilt vollständig automatisch und absolut genau, so daß die mit ihr gebohrten Platten weder zugelegt noch angekörnt zu werden brauchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
