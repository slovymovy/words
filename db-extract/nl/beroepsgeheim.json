                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8dc20b7b-bd17-37a7-a01e-3b00e2f43227",
                                        "entry_id": "3932891f-0bb9-3059-a70b-b23d6c0f685f",
                                        "glosses": [
                                            "Discrétion que l'on est tenu de garder sur des détails de vie privée que l'on a été amené, par l'exercice de sa profession, à connaître."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5831704-3e4e-4466-ab2d-a6d447dcb2c5",
                                                "sense_id": "8dc20b7b-bd17-37a7-a01e-3b00e2f43227",
                                                "text": "Le premier devoir, et le plus strict, de l’hôtelier, est le respect absolu du secret professionnel."
                                            },
                                            {
                                                "example_id": "278bb3c6-eafb-49dd-b4cd-ee938040f800",
                                                "sense_id": "8dc20b7b-bd17-37a7-a01e-3b00e2f43227",
                                                "text": "Il avait préparé des phrases solennelles : « Monsieur le devoir m’oblige à trahir en votre faveur le secret professionnel… Avant tout chose et quelle que soit votre décision, donnez-moi votre parole que ceci restera entre nous… » Va te faire fiche ! Les mots se bloquent entre ses dents."
                                            },
                                            {
                                                "example_id": "7a89dfa8-2177-4675-9739-dfb5072e30f0",
                                                "sense_id": "8dc20b7b-bd17-37a7-a01e-3b00e2f43227",
                                                "text": "Le coordonnateur est soumis au secret professionnel dans les conditions prévues aux articles 226-13 et 226-14 du code pénal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
