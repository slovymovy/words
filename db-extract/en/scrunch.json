                "senses": [
                    {
                        "sense_id": "fe8b97ab-70af-3397-b7ce-fd01b5fb6708",
                        "entry_id": "9fd44e64-e4ab-38a3-a72f-1125436afccf",
                        "glosses": [
                            "To crumple and squeeze to make more compact."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a39522d2-27e0-4245-8df6-cf4dbdd90704",
                                "sense_id": "fe8b97ab-70af-3397-b7ce-fd01b5fb6708",
                                "text": "He scrunched the paper into a ball and threw it at the whistling girl."
                            },
                            {
                                "example_id": "4ed1cbcb-6132-4a29-9b9d-d940b314a0fc",
                                "sense_id": "fe8b97ab-70af-3397-b7ce-fd01b5fb6708",
                                "text": "[…] and the scrunching of ashes under our feet I have often observed to be disagreeable to many."
                            },
                            {
                                "example_id": "38103253-7139-417a-831b-d7aec7d6e778",
                                "sense_id": "fe8b97ab-70af-3397-b7ce-fd01b5fb6708",
                                "text": "Then I put them under my heel, and scrunched them up, every one."
                            }
                        ]
                    },
                    {
                        "sense_id": "b75c5813-cc22-3168-a946-2b2cc9698ee9",
                        "entry_id": "9fd44e64-e4ab-38a3-a72f-1125436afccf",
                        "glosses": [
                            "To crumple and squeeze to make more compact.",
                            "To contract the muscles of one's face so as to draw their facial features together, out of pain, discomfort, uncertainty, etc."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8ce33a97-b0c1-467c-bab1-fffbc29d6f84",
                                "sense_id": "b75c5813-cc22-3168-a946-2b2cc9698ee9",
                                "text": "He scrunched his eyebrows in confused frustration."
                            }
                        ]
                    },
                    {
                        "sense_id": "c507f7ad-65a6-31ae-a216-d8c0080245e7",
                        "entry_id": "9fd44e64-e4ab-38a3-a72f-1125436afccf",
