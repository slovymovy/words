                ],
                "senses": [
                    {
                        "sense_id": "7222b94c-5106-3e09-8a0a-a6aa9a7533fc",
                        "entry_id": "840157c7-86ad-3be4-b569-376ea7ab6388",
                        "glosses": [
                            "Relatif à un vœu ; qui est fait ou offert pour s’acquitter d’un vœu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b419562b-9e5d-4656-8ed1-e790c55cdb16",
                                "sense_id": "7222b94c-5106-3e09-8a0a-a6aa9a7533fc",
                                "text": "Sur un buffet machiné, on distinguait d’étranges cercles de dorures, posés comme des couronnes votives les uns au-dessus des autres, et qui semblaient sans aucun rapport entre eux à l’état de repos."
                            },
                            {
                                "example_id": "b39d61ad-85ed-4d22-b64a-6e92cc86bdce",
                                "sense_id": "7222b94c-5106-3e09-8a0a-a6aa9a7533fc",
                                "text": "Le Louvre conserve une tablette votive sumérienne, venant de l’embouchure de l’Euphrate et datant de 2850 avant J.C., faite d’un mélange artificiel de bitume et d’argile."
                            },
                            {
                                "example_id": "74079e44-0b5d-4829-b419-ef0c45cdcf14",
                                "sense_id": "7222b94c-5106-3e09-8a0a-a6aa9a7533fc",
                                "text": "Tableau votif, offert pour acquitter un vœu."
                            },
                            {
                                "example_id": "54a38b59-e700-48b9-9582-b665e83745be",
                                "sense_id": "7222b94c-5106-3e09-8a0a-a6aa9a7533fc",
                                "text": "Messe votive, dite dans quelque intention particulière."
                            },
                            {
                                "example_id": "da7c7a96-d0c8-4261-8368-b7bd8c2aacc0",
                                "sense_id": "7222b94c-5106-3e09-8a0a-a6aa9a7533fc",
                                "text": "Boucliers votifs, que l’on appendait quelquefois dans les temples ou dans d’autres lieux, soit pour se rendre les dieux favorables, soit en action de grâce."
                            },
                            {
                                "example_id": "1c7a9b4d-670c-407a-b1cf-32cb345986c9",
                                "sense_id": "7222b94c-5106-3e09-8a0a-a6aa9a7533fc",
                                "text": "Chapelle votive, faite pour y déposer des ex-voto."
                            }
                        ]
                    }
                ],
