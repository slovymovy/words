{
    "word_family": [
        "object",
        "objective",
        "objectivity"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "20002c94-79b8-3a9b-8ced-7e4ad677d2b0",
                    "sense_definition": "To treat a person as a mere object, denying their dignity and dehumanizing them.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "dehumanize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The media often <w>objectify</w> celebrities by focusing only on their physical appearance."
                        },
                        {
                            "text": "Many people argue that certain advertisements <w>objectify</w> women to sell products."
                        }
                    ],
                    "common_phrases": [
                        "objectify women",
                        "objectify people"
                    ]
                },
                {
                    "sense_id": "f413e190-95e8-3290-b93e-f53493d47894",
                    "sense_definition": "To make an abstract idea possible to be perceived by the senses.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "represent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist tried to <w>objectify</w> her grief through a series of dark, abstract paintings."
                        },
                        {
                            "text": "Writers often <w>objectify</w> complex emotions by using metaphors that readers can easily visualize."
                        }
                    ],
                    "synonyms": [
                        "reify",
                        "objectivize",
                        "thingify"
                    ]
                },
                {
                    "sense_id": "a8551c9a-b520-319e-b56d-150341cc95f5",
                    "sense_definition": "To treat something as objectively real.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "represent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is common for people to <w>objectify</w> their internal fears as external threats."
                        },
                        {
                            "text": "The philosopher argues that we <w>objectify</w> our subjective experiences to make sense of the world."
                        }
                    ],
                    "synonyms": [
                        "reify",
                        "objectivize"
                    ]
                }
            ]
        }
    ]
}