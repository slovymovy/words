                                                "sense_id": "504b0b9e-b160-34d3-8279-b4d71e033777",
                                                "text": "„Alle, die im Showbusiness des Landes Rang und Namen haben, sind dabei in der meistgesehenen Sendung der Welt.“"
                                            },
                                            {
                                                "example_id": "44206e05-7b1f-416e-aa7d-bbb63db5c2c8",
                                                "sense_id": "504b0b9e-b160-34d3-8279-b4d71e033777",
                                                "text": "„In jüngster Zeit zog es die Stars des Showbusiness und die Akrobaten des Finanzkapitalismus an den teuersten Flecken Genfs.“"
                                            }
