                ],
                "translations": [
                    {
                        "translation_id": "2515ac41-d454-438c-b340-a8acbb63005d",
                        "source_entry_id": "fbed0b6a-9ba7-36e7-af21-fc0c791c2a54",
                        "source_sense_id": "79f16891-5e62-3c95-8afa-2bc2781041e7",
                        "target_lang_word": "heave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9450e9b1-690e-3e88-a150-d329e2a5fbed",
                                        "entry_id": "1daaeed6-6960-3fb4-8e6e-f9e00bb0b606",
                                        "glosses": [
                                            "To lift with difficulty; to raise with some effort; to lift (a heavy thing)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5990084c-2005-4920-b257-5d3baa9cc401",
                                                "sense_id": "9450e9b1-690e-3e88-a150-d329e2a5fbed",
                                                "text": "We heaved the chest-of-drawers up to the second-floor landing."
                                            },
                                            {
                                                "example_id": "460918ca-7019-4d4a-943a-71f375b991ed",
                                                "sense_id": "9450e9b1-690e-3e88-a150-d329e2a5fbed",
                                                "text": "He hove himself out of the bed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75766f4f-ce49-3e2a-91cd-a80a3f0abbe6",
                                        "entry_id": "1daaeed6-6960-3fb4-8e6e-f9e00bb0b606",
                                        "glosses": [
                                            "To throw, cast."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e684d78-81ee-4d56-b312-56432d23274c",
                                                "sense_id": "75766f4f-ce49-3e2a-91cd-a80a3f0abbe6",
                                                "text": "They hove rocks into the pond."
                                            },
                                            {
                                                "example_id": "4c94b76c-e879-4f9c-a8d6-219a4479ee1d",
                                                "sense_id": "75766f4f-ce49-3e2a-91cd-a80a3f0abbe6",
                                                "text": "The cap'n hove the body overboard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7813c78-e707-3982-9df9-355da22c70fa",
                                        "entry_id": "1daaeed6-6960-3fb4-8e6e-f9e00bb0b606",
                                        "glosses": [
                                            "To rise and fall."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24b505bd-89ec-454d-ac2d-75edbe053e1e",
                                                "sense_id": "d7813c78-e707-3982-9df9-355da22c70fa",
                                                "text": "Her chest heaved with emotion."
                                            },
                                            {
                                                "example_id": "5bd45a45-a751-40e5-9651-faf694ee847f",
                                                "sense_id": "d7813c78-e707-3982-9df9-355da22c70fa",
                                                "text": "Frequent for breath his panting bosom heaves."
                                            },
                                            {
                                                "example_id": "ebb1f5b6-eff7-487b-80a5-aa6a56ad67bd",
                                                "sense_id": "d7813c78-e707-3982-9df9-355da22c70fa",
                                                "text": "the heaving plain of ocean"
                                            },
                                            {
                                                "example_id": "cac74327-55ab-4419-b8b5-f342f8870c10",
                                                "sense_id": "d7813c78-e707-3982-9df9-355da22c70fa",
                                                "text": "Presently the moon went down, and left us floating on the waters, now only heaving like some troubled woman's breast, with leisure to reflect upon all that we had gone through and all that we had escaped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4de09499-3caa-377c-87c1-ed12df7d9d32",
                                        "entry_id": "1daaeed6-6960-3fb4-8e6e-f9e00bb0b606",
                                        "glosses": [
                                            "To utter with effort."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e281fe1-85f0-4e91-b030-92e92cd916c6",
                                                "sense_id": "4de09499-3caa-377c-87c1-ed12df7d9d32",
                                                "text": "She heaved a sigh and stared out of the window."
                                            },
                                            {
                                                "example_id": "64a50332-41c8-4814-9103-87b23f0ba720",
                                                "sense_id": "4de09499-3caa-377c-87c1-ed12df7d9d32",
                                                "text": "The wretched animal heaved forth such groans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdea4bd3-1727-3c4c-b568-b3b274df8466",
                                        "entry_id": "1daaeed6-6960-3fb4-8e6e-f9e00bb0b606",
                                        "glosses": [
                                            "To pull up with a rope or cable."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80b72da4-e9f2-4e7c-81bc-6f45082ddb0c",
                                                "sense_id": "fdea4bd3-1727-3c4c-b568-b3b274df8466",
                                                "text": "Heave up the anchor there, boys!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa829216-3b8b-3c55-91f5-ab413c1dfa74",
                                        "entry_id": "1daaeed6-6960-3fb4-8e6e-f9e00bb0b606",
                                        "glosses": [
                                            "To lift (generally); to raise, or cause to move upwards (particularly in ships or vehicles) or forwards."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9865b9da-a1e8-4d78-a775-6853a7491969",
                                                "sense_id": "fa829216-3b8b-3c55-91f5-ab413c1dfa74",
                                                "text": "Here a little child I stand, / Heaving up my either hand; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02a6773f-c4ac-3d6c-acff-f93c672dbd32",
                                        "entry_id": "1daaeed6-6960-3fb4-8e6e-f9e00bb0b606",
                                        "glosses": [
                                            "To be thrown up or raised; to rise upward, as a tower or mound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bbaee2b-04a6-4553-a412-49d749fc4598",
                                                "sense_id": "02a6773f-c4ac-3d6c-acff-f93c672dbd32",
                                                "text": "The grovving Tovv'rs like Exhalations riſe, / And the huge Columns heave into the Skies."
                                            },
                                            {
                                                "example_id": "372d9e52-ef0f-4236-b009-43f06c3e89e9",
                                                "sense_id": "02a6773f-c4ac-3d6c-acff-f93c672dbd32",
                                                "text": "where heaves the turf in many a mouldering heap"
                                            },
                                            {
                                                "example_id": "4cbde83b-e44d-4abc-bba4-66a54fa49959",
                                                "sense_id": "02a6773f-c4ac-3d6c-acff-f93c672dbd32",
                                                "text": "17 June, 1857, Edward Everett, The Statue of Warren\nthe heaving sods of Bunker Hill"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f526712c-e1fa-37ce-95a1-03c07743ae29",
                                        "entry_id": "1daaeed6-6960-3fb4-8e6e-f9e00bb0b606",
                                        "glosses": [
                                            "To displace (a vein, stratum)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff2fe4f5-b02d-3d85-a494-66798a264f59",
                                        "entry_id": "1daaeed6-6960-3fb4-8e6e-f9e00bb0b606",
                                        "glosses": [
                                            "To cause to swell or rise, especially in repeated exertions."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8f88f1e-00c7-4cff-9536-6c4f688d8d7e",
                                                "sense_id": "ff2fe4f5-b02d-3d85-a494-66798a264f59",
                                                "text": "The wind heaved the waves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "644615e7-39ca-3189-ab99-3625f5b3ba10",
                                        "entry_id": "1daaeed6-6960-3fb4-8e6e-f9e00bb0b606",
                                        "glosses": [
                                            "To move in a certain direction or into a certain position or situation."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6709b2af-24c2-4f74-bd3b-6a2aa8b663ff",
                                                "sense_id": "644615e7-39ca-3189-ab99-3625f5b3ba10",
                                                "text": "to heave the ship ahead"
                                            },
                                            {
                                                "example_id": "4b217fe4-5c89-42c9-af7f-a3cc32743638",
                                                "sense_id": "644615e7-39ca-3189-ab99-3625f5b3ba10",
                                                "text": "Pausing there I waited until the foremost Sagoth hove into sight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c414212-50fb-3528-97f2-c2f6bef3e6a2",
                                        "entry_id": "1daaeed6-6960-3fb4-8e6e-f9e00bb0b606",
                                        "glosses": [
                                            "To retch, to make an effort to vomit; to vomit."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5f04ad5-fc22-48f1-b675-5a2a65ab7566",
                                                "sense_id": "6c414212-50fb-3528-97f2-c2f6bef3e6a2",
                                                "text": "The smell of the old cheese was enough to make you heave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b8a4028-d875-3a66-892c-78e6a46b2c29",
                                        "entry_id": "1daaeed6-6960-3fb4-8e6e-f9e00bb0b606",
                                        "glosses": [
                                            "To make an effort to raise, throw, or move anything; to strain to do something difficult."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f69f0c2d-709c-4cbf-ad00-d3b16bdda6c2",
                                                "sense_id": "6b8a4028-d875-3a66-892c-78e6a46b2c29",
                                                "text": "She [The Church of England] had ſtruggl'd and heav'd at a Reformation; ever ſince Wicliffs dayes, for about a 150 years together: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0025b048-9822-3988-96b1-938a5b95f16b",
                                        "entry_id": "1daaeed6-6960-3fb4-8e6e-f9e00bb0b606",
                                        "glosses": [
                                            "To rob; to steal from; to plunder."
                                        ],
                                        "tags": [
                                            "British",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "367b4142-6fb8-40a9-86b0-f37a37a318e0",
                                                "sense_id": "0025b048-9822-3988-96b1-938a5b95f16b",
                                                "text": "Ben mort (good vvench) ſhal you and I heaue a booth, mill a ken, or nip a bung? ſhall you and I rob a houſe, or cut a purſe?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "heave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3ef31b2-686b-3ba1-ae96-33efdd321285",
                                        "entry_id": "0f14403f-c27b-3e50-affb-663ee9835761",
                                        "glosses": [
                                            "An effort to raise something, such as a weight or one's own body, or to move something heavy."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eed67d8b-efdc-4aa4-b86e-0b3f755ab4c6",
                                                "sense_id": "b3ef31b2-686b-3ba1-ae96-33efdd321285",
                                                "text": "We gave one more heave and the wall toppled over at last."
                                            },
                                            {
                                                "example_id": "3495f013-9339-4050-b132-0c279f012e30",
                                                "sense_id": "b3ef31b2-686b-3ba1-ae96-33efdd321285",
                                                "text": "July made no reply but that of a sigh. For she was thinking of the heave she must make to see herself lifted from the ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a3e7abe-bdce-3245-b09a-453f5e85423e",
                                        "entry_id": "0f14403f-c27b-3e50-affb-663ee9835761",
                                        "glosses": [
                                            "An upward motion; a rising; a swell or distention, as of the breast in difficult breathing, of the waves, of the earth in an earthquake, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9834b69f-3b4c-462f-b2eb-ec7f973824a3",
                                                "sense_id": "0a3e7abe-bdce-3245-b09a-453f5e85423e",
                                                "text": "and now the bed shook, the curtains rattled so, that I could scarce hear the sighs and murmurs, the heaves and pantings that accompanied the action, from the beginning to the end",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "623e621c-1cfc-450a-90f5-2d7a0d30805a",
                                                "sense_id": "0a3e7abe-bdce-3245-b09a-453f5e85423e",
                                                "text": "The slab and piles will work together to resist 'ground heave' (the upward movement of the ground as it tries to push up into the box)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "166630e6-8567-3a8e-89ee-b87411ae946c",
                                        "entry_id": "0f14403f-c27b-3e50-affb-663ee9835761",
                                        "glosses": [
                                            "A horizontal dislocation in a metallic lode, taking place at an intersection with another lode."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4ea50e7-e8c7-3a5b-a55f-dcd9811456dd",
                                        "entry_id": "0f14403f-c27b-3e50-affb-663ee9835761",
                                        "glosses": [
                                            "The measure of extent to which a nautical vessel goes up and down in a short period of time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e64e8b8c-7cb7-3796-8d47-fec51c1e7bac",
                                        "entry_id": "0f14403f-c27b-3e50-affb-663ee9835761",
                                        "glosses": [
                                            "An effort to vomit; retching."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f56b88c-35ec-3618-bb78-d64569c89779",
                                        "entry_id": "0f14403f-c27b-3e50-affb-663ee9835761",
                                        "glosses": [
                                            "Broken wind in horses."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02cc65d8-835f-44d4-b368-d77438f5cf00",
                                                "sense_id": "9f56b88c-35ec-3618-bb78-d64569c89779",
                                                "text": "The dust would have to be watched out for with a heave horse, and most alfalfa hay..."
                                            },
                                            {
                                                "example_id": "2ded9010-355d-447f-aa9e-a563612316bb",
                                                "sense_id": "9f56b88c-35ec-3618-bb78-d64569c89779",
                                                "text": "The late stage is recognized by horse people as the true \"heave\" horse and at this stage most of the airways are partially or completely obstructed."
                                            },
                                            {
                                                "example_id": "d51cf239-df59-474f-8674-7486bfdba847",
                                                "sense_id": "9f56b88c-35ec-3618-bb78-d64569c89779",
                                                "text": "The bay horse was straining at the time the picture was taken, making its heave line more noticeable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e77aee95-004e-315a-b37e-6ea0eb4ac965",
                                        "entry_id": "0f14403f-c27b-3e50-affb-663ee9835761",
                                        "glosses": [
                                            "A forceful shot in which the ball follows a high trajectory"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47e73ce0-4f77-4e2a-a8fe-b0b34e83cfa9",
                                                "sense_id": "e77aee95-004e-315a-b37e-6ea0eb4ac965",
                                                "text": "That left 15 needed from Boult's final set. Two dots were followed by a heave over deep mid-wicket, then came the outrageous moment of fortune."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
