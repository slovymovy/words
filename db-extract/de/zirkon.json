                    {
                        "sense_id": "f47729c0-ad7e-3645-8b4c-d3fef9137d29",
                        "entry_id": "4c5affdf-1eba-3d1b-a269-2e0daecf2019",
                        "glosses": [
                            "ein natürlicher Edelstein (Zirkonium-Silicat), im Unterschied zum synthetischen Diamant-Ersatz Zirkonia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86ed2782-6c01-45e6-ad7c-fd90a96ead12",
                                "sense_id": "f47729c0-ad7e-3645-8b4c-d3fef9137d29",
                                "text": "Die bisher ältesten Minerale, die auf der Erde gefunden wurden, sind Zirkone aus [..] Westaustralien, mit einem Alter von 4,404 Milliarden Jahren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37f0db8f-ea79-4bf1-8e97-809a4a7e7584",
                        "source_entry_id": "4c5affdf-1eba-3d1b-a269-2e0daecf2019",
                        "source_sense_id": "f47729c0-ad7e-3645-8b4c-d3fef9137d29",
                        "source_sense_description": "ein natürlicher Edelstein (Zirkonium-Silicat)",
                        "target_lang_word": "zircon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zircon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3d1251c-d408-3e25-9f74-a809d91f0cfb",
                                        "entry_id": "262e7c3d-97b9-38fc-a34c-0d2f4abb58c5",
                                        "glosses": [
                                            "A mineral occurring in tetragonal crystals, usually of a brown or grey colour and consisting of silica and zirconia."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f793055-2f6b-4a0d-9296-c2c51bd4bebd",
                                                "sense_id": "a3d1251c-d408-3e25-9f74-a809d91f0cfb",
                                                "text": "[…] salamanders, mermaids, chimaeras, wild men o’ the woods, leviathans, all hewn from faultless gems, thrice the bulk of a big man’s body, velvet-dark sapphires, chrysolite, beryl, amethyst, and the yellow zircon that is like transparent gold."
                                            },
                                            {
                                                "example_id": "cbd055f0-84a8-48ae-bb1c-fb7fcdc386bb",
                                                "sense_id": "a3d1251c-d408-3e25-9f74-a809d91f0cfb",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are […]. (Common gem materials not addressed in this article include amber, amethyst, chalcedony, garnet, lazurite, malachite, opals, peridot, rhodonite, spinel, tourmaline, turquoise and zircon.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "159b8417-ea34-308a-8f4e-2bf0c59fa78c",
                                        "entry_id": "262e7c3d-97b9-38fc-a34c-0d2f4abb58c5",
                                        "glosses": [
                                            "A crystal of zircon, sometimes used as a false gemstone."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21cdcc95-867d-46d6-914f-9e2fd39521a5",
                                                "sense_id": "159b8417-ea34-308a-8f4e-2bf0c59fa78c",
                                                "text": "A zircon princess, seemed to lost her senses"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
