                ],
                "senses": [
                    {
                        "sense_id": "35d4f1d3-ca5a-3687-8b07-120d3d78e6cb",
                        "entry_id": "486a6d69-39d9-3534-80e2-5dfc3a6fef4f",
                        "glosses": [
                            "Akrobatik"
                        ],
                        "tags": [
                            "Zirkus"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "65f7bffb-ca5e-3765-b1ae-1780d529e1e0",
                        "entry_id": "486a6d69-39d9-3534-80e2-5dfc3a6fef4f",
                        "glosses": [
                            "besonderes Geschick beim Ausführen einer Tätigkeit, die meist mit Risiko verbunden ist; Akrobatik"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f14efdd0-045e-406b-862b-7daa2ec32830",
                        "source_entry_id": "486a6d69-39d9-3534-80e2-5dfc3a6fef4f",
                        "source_sense_id": "35d4f1d3-ca5a-3687-8b07-120d3d78e6cb",
                        "source_sense_description": "Sport, Zirkus: Akrobatik",
                        "target_lang_word": "Akrobatik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akrobatik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7c06fc8-b37c-3a1d-9dd3-085261ce856e",
                                        "entry_id": "159faf95-4f0b-337c-9948-eeab9dc05cc5",
                                        "glosses": [
                                            "Geschicklichkeit bei körperlichen Übungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0341cee-fc89-4a86-a26a-25c8dc30f4fc",
                                                "sense_id": "c7c06fc8-b37c-3a1d-9dd3-085261ce856e",
                                                "text": "„Kraft ist sicherlich für die Akrobatik eine wichtige Voraussetzung. Sie darf jedoch in ihrer Bedeutung nicht überbewertet werden.“"
                                            },
                                            {
                                                "example_id": "c7ac9d5d-2bd5-4ced-bd82-b3c007a06acd",
                                                "sense_id": "c7c06fc8-b37c-3a1d-9dd3-085261ce856e",
                                                "text": "„In der Akrobatik ist immer auch Rhythmik, hier gehen die Uhren richtig, wenn auch anders als draußen.“"
                                            },
                                            {
                                                "example_id": "30641daa-eb81-4b29-a223-c61a6d3e6601",
                                                "sense_id": "c7c06fc8-b37c-3a1d-9dd3-085261ce856e",
                                                "text": "[übertragen:] „‚Dein Glaube hat dir geholfen‘ - der Glaube kann wirklich die Möglichkeit dafür schaffen, dass wir gesund werden. Das kann ganz einfach gehen. Da ist eventuell gar keine große Akrobatik im Glauben erforderlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d4b9c157-abf5-3f3d-97a7-b7653e803a31",
                                        "entry_id": "159faf95-4f0b-337c-9948-eeab9dc05cc5",
                                        "glosses": [
                                            "Sportart, bei der körperliche Bewegungen mit hohen koordinativen und konditionellen Anforderungen im Vordergrund stehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c967be1-667f-417a-82a8-154b4a1f474b",
                                                "sense_id": "d4b9c157-abf5-3f3d-97a7-b7653e803a31",
                                                "text": "„Die Seiten standen alle offen und in der Mitte, der sogenannten Manege, wurde gerade Akrobatik geübt.“"
                                            },
                                            {
                                                "example_id": "e6713b64-c700-4f97-b489-f824000ccdb2",
                                                "sense_id": "d4b9c157-abf5-3f3d-97a7-b7653e803a31",
                                                "text": "„Tatsächlich sind Akrobatik und Bewegungskünste wichtige Bestandteile des Sportunterrichts in der Grundschule, da sie Gleichgewicht, Geschicklichkeit und Koordination fördern.“"
                                            },
                                            {
                                                "example_id": "b0212719-0fc9-48b6-bd81-c643a0b4cdf8",
                                                "sense_id": "d4b9c157-abf5-3f3d-97a7-b7653e803a31",
                                                "text": "„Es bilden sich fünf Gruppen: eine Gruppe an den Ringen und am Trapez, eine Gruppe Akrobatik, eine Gruppe an einer Balancierkugel, eine Gruppe Jonglieren und eine Gruppe zu Kunststücken mit dem Ball am Fuß.“"
                                            },
                                            {
                                                "example_id": "6646d30b-b1a7-4ad3-9d69-1ff2caa9ec7d",
                                                "sense_id": "d4b9c157-abf5-3f3d-97a7-b7653e803a31",
                                                "text": "„Vielleicht gab es eine Artistengruppe, die jemand wie mich brauchte, ich war nicht schwer, schwindelfrei und konnte nach einigem Training ganz gut ein bißchen Akrobatik mitmachen, oder mit einem anderen Clown zusammen Sketche einstudieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
