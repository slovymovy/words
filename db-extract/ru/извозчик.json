                "senses": [
                    {
                        "sense_id": "7a649182-27f7-3dbc-8e81-a19ac02d9471",
                        "entry_id": "36e33c51-ba7d-34ff-9c5f-a5cc14605492",
                        "glosses": [
                            "истор. кучер наёмного экипажа, повозки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf2e0919-5674-444e-9106-d57c14709782",
                                "sense_id": "7a649182-27f7-3dbc-8e81-a19ac02d9471",
                                "text": "Меж тем подъехал воз; кричит Разбойник: «Стой!» ― // И на Извозчика бросается с дубиной."
                            },
                            {
                                "example_id": "6aff66ca-219b-44a8-af56-958bc5d5128b",
                                "sense_id": "7a649182-27f7-3dbc-8e81-a19ac02d9471",
                                "text": ".. извозчик-палач // Бил кургузым кнутом спотыкавшихся кляч .."
                            }
                        ]
                    },
                    {
                        "sense_id": "210c3676-5602-3c9c-9a53-2e7aa434d5c7",
                        "entry_id": "36e33c51-ba7d-34ff-9c5f-a5cc14605492",
                        "glosses": [
                            "истор. наёмный экипаж с кучером"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f18dcfdf-c745-4021-829a-d343bc8506d6",
                                "sense_id": "210c3676-5602-3c9c-9a53-2e7aa434d5c7",
                                "text": "Дыбкин хватается за эту идею, как пьяный купец за перила, одевает пальто и мчится на извозчике по данному адресу."
                            }
                        ]
                    },
                    {
                        "sense_id": "55e1c803-f6cd-3071-8966-f7e027cde1f1",
                        "entry_id": "36e33c51-ba7d-34ff-9c5f-a5cc14605492",
                        "glosses": [
                            "разг. тот, кто занимается перевозкой пассажиров и грузов на частном автомобиле"
                        ],
                        "tags": [],
                        "examples": []
                    }
