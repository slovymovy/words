                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "073db68b-d84b-49b2-ae74-609050b968f0",
                                                "sense_id": "0c917311-e4c0-3bbf-91b3-9cb2ec5c4876",
                                                "text": "Nach diesen erneuten Angriffen entschloss ich mich, die Urheber zu bekämpfen."
                                            },
                                            {
                                                "example_id": "7f2a8c39-38ce-40e4-a4c8-ebd8a04df83f",
                                                "sense_id": "0c917311-e4c0-3bbf-91b3-9cb2ec5c4876",
                                                "text": "„Die CIA machte sich ans Werk und kaufte sich zunächst eine neue laotische Regierung, dann baute sie eine Guerillaarmee auf, die die Kommunisten bekämpfen und den Dschungelpfad angreifen sollte.“"
                                            },
                                            {
                                                "example_id": "2a4898d1-743d-4b42-b72d-53ecd2673498",
                                                "sense_id": "0c917311-e4c0-3bbf-91b3-9cb2ec5c4876",
                                                "text": "„Mehrzweckschiffe und ein Seenotrettungskreuzer kühlten den Tanker mit großen Mengen Wasser und bekämpften den Brand von außen.“"
                                            },
                                            {
                                                "example_id": "43db11e3-f3e4-44f2-a909-03ae13cd3a80",
                                                "sense_id": "0c917311-e4c0-3bbf-91b3-9cb2ec5c4876",
                                                "text": "„Der Sozialpädagoge Tobias Lucht hat eine Mission: Er will Kinderarmut bekämpfen. Dafür gründete er 2006 die Arche Hamburg, wo Kindern und Jugendlichen jeden Tag eine warme Mahlzeit, Hausaufgabenbetreuung und Freizeitaktivitäten geboten werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e385fff-6580-391f-abe7-311d8c03edb1",
                                        "entry_id": "a6a59e77-01e9-3a1f-beb5-1da7de4f0379",
                                        "glosses": [
                                            "gegeneinander kämpfen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "579350e7-1cf8-42a3-9872-18757956172c",
                                                "sense_id": "3e385fff-6580-391f-abe7-311d8c03edb1",
                                                "text": "Die verfeindeten Brüder bekämpften sich bis aufs Blut."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
