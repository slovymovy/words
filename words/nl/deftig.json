                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stately",
                                "target_lang_sense_clarification": "impressive and dignified in appearance"
                            },
                            {
                                "target_lang_word": "dignified",
                                "target_lang_sense_clarification": "showing a composed or serious manner"
                            },
                            {
                                "target_lang_word": "grand",
                                "target_lang_sense_clarification": "impressive in size or appearance"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "distingué",
                                "target_lang_sense_clarification": "qui a des manières nobles ou raffinées"
                            },
                            {
                                "target_lang_word": "imposant",
                                "target_lang_sense_clarification": "qui inspire le respect par son maintien"
                            },
                            {
                                "target_lang_word": "digne",
                                "target_lang_sense_clarification": "qui a de la gravité et du maintien"
                            }
                        ]
