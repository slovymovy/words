        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "aee31770-9687-3362-8302-8ec9aac9d7f7",
                "word": "doorstappen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "86897997-8bb5-3425-8579-31da0abe536d",
                        "entry_id": "aee31770-9687-3362-8302-8ec9aac9d7f7",
                        "glosses": [
                            "flink doorlopen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0962cffc-cc08-47e7-bb5e-8e6dfe4cf3b8",
                                "sense_id": "86897997-8bb5-3425-8579-31da0abe536d",
                                "text": "‘Patiënten doen er goed aan om na hun behandeling op te bouwen naar 150 minuten bewegen per week’, zei hoofdonderzoekster Erin Van Blarigan, epidemiologe aan de University of California in San Francisco. ‘Dat mag gewoon een dagelijkse wandeling zijn. Flink doorstappen is voor iedereen haalbaar.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "1591041a-8526-3469-abbc-50549895c7e8",
                        "entry_id": "aee31770-9687-3362-8302-8ec9aac9d7f7",
                        "glosses": [
                            "doorgaan"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8fee8d9d-2278-4a74-9dae-eb219c57f113",
                                "sense_id": "1591041a-8526-3469-abbc-50549895c7e8",
                                "text": "Die hele brexit was tot nu toe een hilarisch spektakel. Hoe May met haar Britse pumps dapper, vaak ternauwernood, bleef doorstappen terwijl ze door zowat iedereen in Groot-Brittannië onderuit werd gehaald. Bij toespraken stortte het decor in achter haar en verloor ze haar stem. Ze kreeg briefjes toegespeeld tijdens een speech, waarop zoiets stond als ‘en nou opzouten jij’. Toen ze afgelopen maandag dacht een deal te hebben gesloten, werd ze diezelfde dag alweer door een politieke splinterpartij onderuit gehaald."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8be24be8-2e4a-4fd8-b768-129813bca563",
                        "source_entry_id": "aee31770-9687-3362-8302-8ec9aac9d7f7",
                        "source_sense_id": "1591041a-8526-3469-abbc-50549895c7e8",
                        "source_sense_description": "doorgaan",
                        "target_lang_word": "go on",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "go on",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66029d21-3468-3f1b-9287-feddf22414db",
                                        "entry_id": "ceb10096-0141-35f9-b1e4-b7d7e018682f",
                                        "glosses": [
                                            "To continue in extent."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f9f69fc-4a97-45cb-987d-71b30d218ebc",
                                                "sense_id": "66029d21-3468-3f1b-9287-feddf22414db",
                                                "text": "The meeting seemed to go on forever."
                                            },
                                            {
                                                "example_id": "cc17869c-a72a-4925-bf4d-fbcc3dae90ec",
                                                "sense_id": "66029d21-3468-3f1b-9287-feddf22414db",
                                                "text": "This road goes on for another twenty miles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9591eec5-d62a-3e8e-975d-9542d74c5612",
                                        "entry_id": "ceb10096-0141-35f9-b1e4-b7d7e018682f",
                                        "glosses": [
                                            "To continue an action."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9717d1ea-9242-4f7f-b102-adc4b20ca507",
                                                "sense_id": "9591eec5-d62a-3e8e-975d-9542d74c5612",
                                                "text": "I think I've said enough now; I'm not sure I should go on."
                                            },
                                            {
                                                "example_id": "cbb4f1b3-7e67-4b7a-8fb1-b821cbb17e38",
                                                "sense_id": "9591eec5-d62a-3e8e-975d-9542d74c5612",
                                                "text": "He went on walking even when the policeman told him to stop."
                                            },
                                            {
                                                "example_id": "5e44157c-9836-4bda-a2fa-780ac442816a",
                                                "sense_id": "9591eec5-d62a-3e8e-975d-9542d74c5612",
                                                "text": "One might imagine that the directors foresaw the somewhat uninspiring appearance of the future Manchester stations, and decided to start as it was intended to go on."
                                            },
                                            {
                                                "example_id": "15bf7566-7846-4d58-b8e6-9faaac47da52",
                                                "sense_id": "9591eec5-d62a-3e8e-975d-9542d74c5612",
                                                "text": "She crept up the stairs [...] On she went, across the landing, from which sprang the tall window, and up the next flight until she reached the top."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1031ecd6-c903-36de-801b-67078bb97bd7",
                                        "entry_id": "ceb10096-0141-35f9-b1e4-b7d7e018682f",
                                        "glosses": [
                                            "To proceed (to do something)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dae8aa7d-1081-4049-ac41-cfd9c47dc611",
                                                "sense_id": "1031ecd6-c903-36de-801b-67078bb97bd7",
                                                "text": "He started the competition badly but went on to win the gold medal."
                                            },
                                            {
                                                "example_id": "c52d80eb-7bbd-4ec7-97da-99f3ee6c7d4f",
                                                "sense_id": "1031ecd6-c903-36de-801b-67078bb97bd7",
                                                "text": "\"Do you want to hear a joke?\" — \"Oh, all right, go on then.\""
                                            },
                                            {
                                                "example_id": "8be87516-9c84-49a0-a5f7-b30f8505bcae",
                                                "sense_id": "1031ecd6-c903-36de-801b-67078bb97bd7",
                                                "text": "The kid who starts a business selling candy out of his locker always goes on to be a major sleazeball later in life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "891a9ab7-f225-332c-b7e4-828ae1c9dd0f",
                                        "entry_id": "ceb10096-0141-35f9-b1e4-b7d7e018682f",
                                        "glosses": [
                                            "To talk frequently or at great length (about a subject)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c77771ab-a253-4295-af6a-e7b3162c1c57",
                                                "sense_id": "891a9ab7-f225-332c-b7e4-828ae1c9dd0f",
                                                "text": "Will you stop going on about your stupid holiday?"
                                            },
                                            {
                                                "example_id": "e4b226bc-a601-478a-af79-e58ee79e80f3",
                                                "sense_id": "891a9ab7-f225-332c-b7e4-828ae1c9dd0f",
                                                "text": "Sam goes on and on about Pokémon."
                                            },
                                            {
                                                "example_id": "a2ffd000-66e2-494c-947b-3e834890a95a",
                                                "sense_id": "891a9ab7-f225-332c-b7e4-828ae1c9dd0f",
                                                "text": "Don't ask Sam about Pokémon, because he'll go on and on."
                                            },
                                            {
                                                "example_id": "e074abca-af83-46ed-a0da-44df7707eecd",
                                                "sense_id": "891a9ab7-f225-332c-b7e4-828ae1c9dd0f",
                                                "text": "\"I don't believe you.\" I shake my head. \"How on earth did you remember that? I must have told you years ago.\"[…]\n\"First of all, you go on about it far more than you think you do,[…].\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6bf6c40-6847-394f-8cdc-90b14636f79b",
                                        "entry_id": "ceb10096-0141-35f9-b1e4-b7d7e018682f",
                                        "glosses": [
                                            "To happen (occur)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6af3a75-848e-4996-9395-67e360457d38",
                                                "sense_id": "b6bf6c40-6847-394f-8cdc-90b14636f79b",
                                                "text": "What's going on?"
                                            },
                                            {
                                                "example_id": "b62d368f-790b-46c4-ab1a-b10255f22053",
                                                "sense_id": "b6bf6c40-6847-394f-8cdc-90b14636f79b",
                                                "text": "I really don't want to know what goes on between you and your boyfriend behind closed doors."
                                            },
                                            {
                                                "example_id": "84c1560e-23d1-4203-b7cd-d659c23b8fc6",
                                                "sense_id": "b6bf6c40-6847-394f-8cdc-90b14636f79b",
                                                "text": "At the time, with the D-Day invasion of Europe going on, their heroism was hardly noticed. Plenty of other heroes were dying elsewhere. Plenty of bigger bits of history were being made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c841619e-365a-3faf-9a2f-6379d2a4fabb",
                                        "entry_id": "ceb10096-0141-35f9-b1e4-b7d7e018682f",
                                        "glosses": [
                                            "To move or proceed so as to become \\\"on\\\" in any of various senses."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b71021ef-9571-452d-980f-34ba9c207bea",
                                                "sense_id": "c841619e-365a-3faf-9a2f-6379d2a4fabb",
                                                "text": "Bertha's about to finish her song. Who's going on next?"
                                            },
                                            {
                                                "example_id": "be2e6e50-1f76-4c0c-86a1-7ac1f6d77772",
                                                "sense_id": "c841619e-365a-3faf-9a2f-6379d2a4fabb",
                                                "text": "Smith went on for Jones at left back after Jones got injured."
                                            },
                                            {
                                                "example_id": "6091bfd4-6693-4129-b245-ffbd83d0e766",
                                                "sense_id": "c841619e-365a-3faf-9a2f-6379d2a4fabb",
                                                "text": "It was pitch black and then suddenly all the lights went on."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "go on",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f86e6db-786d-3cde-9f87-20eb5f9ce760",
                                        "entry_id": "a8951865-75cb-3134-a62f-96bb7ac17408",
                                        "glosses": [
                                            "Expressing that the speaker can continue speaking without interruption from the listener."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "754c84db-8bed-41ab-a9fd-403ec6cdfb22",
                                                "sense_id": "2f86e6db-786d-3cde-9f87-20eb5f9ce760",
                                                "text": "Go on! You were saying about those other ones too?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fbbe50a-d962-3f91-b9ca-8959d96c694e",
                                        "entry_id": "a8951865-75cb-3134-a62f-96bb7ac17408",
                                        "glosses": [
                                            "Expressing surprise, disbelief or incredulity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c32b70a8-d77a-4aa1-b589-e301bc694295",
                                                "sense_id": "2fbbe50a-d962-3f91-b9ca-8959d96c694e",
                                                "text": "A: He asked Fiona to marry him.\nB: Go on!\nA: It's true, I swear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3ce2322-e046-389b-a5fd-2dfdc7e3ba8b",
                                        "entry_id": "a8951865-75cb-3134-a62f-96bb7ac17408",
                                        "glosses": [
                                            "Expressing encouragement, see come on."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77543444-2a74-4ac5-a6a9-b797bdecdb5a",
                                                "sense_id": "f3ce2322-e046-389b-a5fd-2dfdc7e3ba8b",
                                                "text": "Go on! You can do it!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21f870f7-f0d9-3af8-a3a7-b8211db1e752",
                                        "entry_id": "a8951865-75cb-3134-a62f-96bb7ac17408",
                                        "glosses": [
                                            "Yes; okay; it's a deal."
                                        ],
                                        "tags": [
                                            "British",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d1de8cb-b18d-4ff6-b587-ffcf1e88147a",
                                                "sense_id": "21f870f7-f0d9-3af8-a3a7-b8211db1e752",
                                                "text": "—So three hundred on the chair then, and can we do two-fifty on the clock?\n—Go on, then."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "go on",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b405882-41b1-365f-bbc0-158b82adc440",
                                        "entry_id": "d4addddf-c6ac-3408-b41b-a24b73525689",
                                        "glosses": [
                                            "To use and adopt (information) in order to understand an issue, make a decision, etc.; to go by."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71a0e7a2-4191-41d5-a6e9-b4b66a9a453c",
                                                "sense_id": "8b405882-41b1-365f-bbc0-158b82adc440",
                                                "text": "We can't go on what this map says; it's twenty years out of date."
                                            },
                                            {
                                                "example_id": "54ffbf0b-585c-4b1a-b9cd-4a8ebfc9bb50",
                                                "sense_id": "8b405882-41b1-365f-bbc0-158b82adc440",
                                                "text": "I didn't make a decision because I didn't have anything to go on."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
