                                "target_lang_word": "чуть",
                                "target_lang_sense_clarification": "едва, почти"
                            },
                            {
                                "target_lang_word": "едва",
                                "target_lang_sense_clarification": "с трудом избежав"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "nearly",
                                "target_lang_sense_clarification": "almost, barely missed"
                            },
                            {
                                "target_lang_word": "almost",
                                "target_lang_sense_clarification": "very close to happening"
                            }
