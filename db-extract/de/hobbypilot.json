                "senses": [
                    {
                        "sense_id": "6fc6cd3b-a532-3a4f-a941-614db1652fff",
                        "entry_id": "33a4fce0-8b66-3656-aba4-5809d529a7bd",
                        "glosses": [
                            "jemand, der das Fliegen von Flugzeugen als Hobby betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cb6b467-45f6-477c-aee2-7378f7e3f767",
                                "sense_id": "6fc6cd3b-a532-3a4f-a941-614db1652fff",
                                "text": "„Hobbypilot Mathias Rust sorgte vor 25 Jahren für eine Weltsensation. Mit seiner Cessna durchbrach der Deutsche während des Kalten Krieges die Luftabwehr der Sowjetunion und landete auf dem Roten Platz in Moskau.“"
                            },
                            {
                                "example_id": "b2105063-7fdf-4da8-96d2-ead2e56af9bc",
                                "sense_id": "6fc6cd3b-a532-3a4f-a941-614db1652fff",
                                "text": "„Allerdings ist der Held dieser Story ein Hobbypilot, der mit seinem primitiven Fluggerät die Ruinen einer einstigen Megacity ansteuert und dort versucht, diese Stadt wieder zum Leben zu erwecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
