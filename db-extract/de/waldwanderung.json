                "senses": [
                    {
                        "sense_id": "1b209661-b073-3067-ad0a-3cf9277d80d0",
                        "entry_id": "4a40fbfd-46c8-3fb4-982b-0a295d4caabf",
                        "glosses": [
                            "Wanderung in/durch den Wald"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63255a55-84cf-45be-b338-0da12123f1fc",
                                "sense_id": "1b209661-b073-3067-ad0a-3cf9277d80d0",
                                "text": "„Eine Waldwanderung macht der ganzen Familie Spaß.“"
                            },
                            {
                                "example_id": "d1a9b49e-9191-46b4-962e-7086f51837a9",
                                "sense_id": "1b209661-b073-3067-ad0a-3cf9277d80d0",
                                "text": "„Das ehemalige Bürstenbinderdorf Ramberg ist Ausgangspunkt einer ausdehnten Waldwanderung, die über die Ruine Ramburg zu einem Forsthaus hinaufführt.“"
                            },
                            {
                                "example_id": "44adf4ad-896b-4d78-b849-941afd51d98d",
                                "sense_id": "1b209661-b073-3067-ad0a-3cf9277d80d0",
                                "text": "„Ich komme, bis auf die Knochen durchgefroren, von der Waldwanderung zurück.“"
                            },
                            {
                                "example_id": "1506bef7-9775-460c-b13f-fd22457040be",
                                "sense_id": "1b209661-b073-3067-ad0a-3cf9277d80d0",
                                "text": "„Auf langen Waldwanderungen sammelten die Leute zentnerweise Pilze und trockneten sie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
