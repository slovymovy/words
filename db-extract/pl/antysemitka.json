                        "entry_id": "f7b2d715-77cf-3f09-bc20-6e96aefc10c2",
                        "glosses": [
                            "kobieta uprzedzona do Żydów, cechująca się niechęcią bądź nienawiścią do tego narodu; kobieta, którą cechuje antysemityzm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20b39e26-ef72-4c9c-9d62-8f0736fe457a",
                                "sense_id": "9037ffb0-9e4f-39a4-9c0a-225c6ecb78f9",
                                "text": "Alicja jest antysemitką, zawsze źle się wyraża o Żydach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
