                    },
                    {
                        "translation_id": "6e9f0122-6e5a-4555-a332-2796e976a736",
                        "source_entry_id": "141b6b63-689c-3fe6-b1da-6d8513ee6668",
                        "source_sense_description": "platform for bands to play on",
                        "target_lang_word": "muziektent",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muziektent",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c8bf20d7-dff9-3a7f-b320-36f5d3412695",
                                        "entry_id": "07346c67-3d70-3160-909d-2ebbeb7f2d8a",
                                        "glosses": [
                                            "tijdelijk, of niet geheel afgesloten muziektheater"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ce0b136-b78e-4b35-8156-88fe7f5782e3",
                                                "sense_id": "c8bf20d7-dff9-3a7f-b320-36f5d3412695",
                                                "text": "Er komt meer structuur in de Occupy-beweging op het Beursplein. Zo is er een groep die het contact met de media regelt en een beveiligingsgroep die controleert op overlast. Naast de tenten van de betogers is er onder andere een keukentent, een muziektent en zijn er wc's. Ook houden de actievoerders visiegesprekken om tot gezamenlijke ideeën te komen."
                                            },
                                            {
                                                "example_id": "0eaba7b0-5f90-4329-9940-a113e855cade",
                                                "sense_id": "c8bf20d7-dff9-3a7f-b320-36f5d3412695",
                                                "text": "Verschillende mensen waren er vanmiddag bij toen de vrouw bij de muziektent in de dorpskern zichzelf in brand stak. \"Met flessen water probeerden enkelen van hen het vuur uit te krijgen\", zei een woordvoerder van de brandweer bij Omroep Gelderland. \"Het is zaterdag altijd extra druk in het centrum van Bennekom. Daardoor zagen veel mensen het gebeuren.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0c6a53a-606c-380a-94e5-084ba4009b77",
                                        "entry_id": "07346c67-3d70-3160-909d-2ebbeb7f2d8a",
                                        "glosses": [
                                            "gebouw waarin muziekoptredens kunnen plaatsvinden"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ba111bf-9148-4334-97bb-af1f68c4822a",
                        "source_entry_id": "141b6b63-689c-3fe6-b1da-6d8513ee6668",
