                "senses": [
                    {
                        "sense_id": "6c077b66-0bc0-37d1-b500-4dd5b31c9a4b",
                        "entry_id": "5c5a7be0-4e6a-3ee2-83e7-5b13e39b050b",
                        "glosses": [
                            "Beutel aus hitzebeständigem Kunststoff, in dem Nahrungsmittel in kochendem Wasser gegart oder erhitzt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b8bbc70-7941-4270-8d64-8c7fb0109399",
                                "sense_id": "6c077b66-0bc0-37d1-b500-4dd5b31c9a4b",
                                "text": "Der Reis im Kochbeutel ist nach zehn Minuten fertig."
                            },
                            {
                                "example_id": "067712d1-bd39-4b02-8776-ad7be474dc07",
                                "sense_id": "6c077b66-0bc0-37d1-b500-4dd5b31c9a4b",
                                "text": "„1959 revolutionierte das erste Flockenpüree ohne Milch den deutschen Kartoffelbrei, 1967 folgte die erste Kartoffel-Instant-Suppe, 1970 schließlich der erste Knödel im Kochbeutel.“"
                            },
                            {
                                "example_id": "63469abd-f471-46b1-9301-a512b754c940",
                                "sense_id": "6c077b66-0bc0-37d1-b500-4dd5b31c9a4b",
                                "text": "„Von ihrem Münchner »Skinny-Menu«-Laden aus versorgt sie einen ständig wachsenden Kundenkreis […] mit Tiefkühl-Menus der Nouvelle Cuisine, die mittags im Kochbeutel und abends im Backofen problemlos erhitzt werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
