                ],
                "senses": [
                    {
                        "sense_id": "1f0b6073-afb5-3607-8c25-da66aba619ba",
                        "entry_id": "4f9cce12-29d9-309a-bef9-5dc04f536503",
                        "glosses": [
                            "Stoff, der giftige Substanzen im Körper (mikrobielle, pflanzliche oder tierische Gifte) neutralisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58143c9f-fcb9-4501-9e64-85e930d0f3db",
                                "sense_id": "1f0b6073-afb5-3607-8c25-da66aba619ba",
                                "text": "„Für die Therapie der Erkrankung steht ein spezielles Antitoxin zur Verfügung.“"
                            },
                            {
                                "example_id": "765a1ca9-1dc1-4b61-8969-1f283dd025ad",
                                "sense_id": "1f0b6073-afb5-3607-8c25-da66aba619ba",
                                "text": "„Sobald das Tetanustoxin an die Nervenzellen gebunden ist, kann es nicht mehr mit Antitoxin neutralisiert werden.“"
                            },
                            {
                                "example_id": "a51f9356-70c6-458e-9025-557069630205",
                                "sense_id": "1f0b6073-afb5-3607-8c25-da66aba619ba",
                                "text": "„Die Antitoxine gelangen auch kaum ins Zentralnervensystem: zu spät verabreichtes Tetanus-Antitoxin ist daher wirkungslos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b021aa8-efb8-4b22-a8af-8108392ca196",
                        "source_entry_id": "4f9cce12-29d9-309a-bef9-5dc04f536503",
                        "source_sense_id": "1f0b6073-afb5-3607-8c25-da66aba619ba",
                        "source_sense_description": "Gegengift",
                        "target_lang_word": "antitoxin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antitoxin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35972eb3-0f2b-308e-b61c-d3e5bd11b163",
                                        "entry_id": "d540925b-9937-31e5-983b-891a71123416",
                                        "glosses": [
                                            "A medicine able to neutralize a toxin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26e9b362-2bb4-402d-aa6d-598251ecf9ef",
                                                "sense_id": "35972eb3-0f2b-308e-b61c-d3e5bd11b163",
                                                "text": "Through the needle-hole thus stained with dye it was possible to \"superinject\" antitoxin, using a slightly wider needle avoid back leak along the old needle track, and thus to ensure a distribution of both toxin and antitoxin solutions from the same point the skin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb48aa82-e0c0-3c32-a76d-609f2847a6c2",
                                        "entry_id": "d540925b-9937-31e5-983b-891a71123416",
                                        "glosses": [
                                            "An antibody capable of neutralizing specific toxins."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2fef3a7-11c7-49d0-bf31-12f6a2d26a28",
                                                "sense_id": "eb48aa82-e0c0-3c32-a76d-609f2847a6c2",
                                                "text": "These albuminous substances, whether found as normal products or created artificially in the blood, are distinguished as antitoxins, protective proteïds, vaccines, or alexines; physiologically they have been divided into sozines, those found in animals naturally immune, and phylaxines, those found in animals which by subcutaneous injections have artificially been made immune."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
