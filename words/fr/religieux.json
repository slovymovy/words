                        "respect religieux"
                    ]
                },
                {
                    "sense_id": "9845c4a1-ba2c-341a-8cc0-d88e45441e47",
                    "sense_definition": "Qui fait preuve d'une exactitude scrupuleuse ou d'un soin extrême.",
