                    }
                ],
                "senses": [
                    {
                        "sense_id": "408506d2-d6c4-39f1-b497-e02c782d6c5d",
                        "entry_id": "10fd11e1-098c-3ea6-b591-626172116082",
                        "glosses": [
                            "A relaxing of tension, especially between countries."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a8d90e1d-e373-44ba-b70b-0a5e5cf6dff8",
                                "sense_id": "408506d2-d6c4-39f1-b497-e02c782d6c5d",
                                "text": "Analogous structural and political constraints stood in the way of a lasting détente between Germany and Britain."
                            },
                            {
                                "example_id": "b94e910a-dd9b-44a1-a116-f7b8bac2e63b",
                                "sense_id": "408506d2-d6c4-39f1-b497-e02c782d6c5d",
                                "text": "No step the United States could take anywhere in the world would bring strategic benefits as great as detente with Iran."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1419a2b-752e-4e21-9d5d-95b41caca23a",
                        "source_entry_id": "10fd11e1-098c-3ea6-b591-626172116082",
                        "source_sense_id": "408506d2-d6c4-39f1-b497-e02c782d6c5d",
