        "ru-extract.jsonl": [
            {
                "entry_id": "e7dd60ab-8b83-3c63-96a8-bcfe15523bc1",
                "word": "бесспорно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2c9962be-7c3b-3e5c-805e-aaa6c5c40eee",
                        "entry_id": "e7dd60ab-8b83-3c63-96a8-bcfe15523bc1",
                        "glosses": [
                            "наречие к бесспорный; не допуская возражений, сомнений"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "8f379081-2e2f-4bbc-a78a-758dcbada8ef",
                                "sense_id": "2c9962be-7c3b-3e5c-805e-aaa6c5c40eee",
                                "text": "Так, известный советский иранист В. И. Абаев выявил ряд североиранско-европейских языковых сближений и параллели в области мифологии, бесспорно свидетельствующие о контактах древних иранцев Юго-Восточной Европы с ещё не расчленёнными европейскими племенами."
                            }
                        ]
                    },
                    {
                        "sense_id": "55b018a0-d938-35d1-bd4a-b0eb74c4dea7",
                        "entry_id": "e7dd60ab-8b83-3c63-96a8-bcfe15523bc1",
                        "glosses": [
                            "несомненно, разумеется"
                        ],
                        "tags": [
                            "в знач. вводного слова"
                        ],
                        "examples": [
                            {
                                "example_id": "2b976fb9-542f-4a6a-8001-5af5e0bebbd3",
                                "sense_id": "55b018a0-d938-35d1-bd4a-b0eb74c4dea7",
                                "text": "Бесспорно, немалую роль в нашем расколе играл низкий уровень образования, русский обскурантизм."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34267c96-91c0-442d-b8d4-251ead84e89d",
                        "source_entry_id": "e7dd60ab-8b83-3c63-96a8-bcfe15523bc1",
                        "target_lang_word": "undoubtedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undoubtedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                                        "entry_id": "c765d208-4c5e-32dd-9549-1f8c430d2e6c",
                                        "glosses": [
                                            "Without doubt; definitely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f14f2397-0f7b-4e01-bea5-73e800d079a6",
                                                "sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                                                "text": "The cane was undoubtedly of foreign make, for it had a solid silver ferrule at one end, which was not English hall–marked."
                                            },
                                            {
                                                "example_id": "1ce691d9-5a8c-4522-89d8-2374aeee8b87",
                                                "sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                                                "text": "He declared that these drastic steps would undoubtedly inconvenience a good many people, but the alternative was bankruptcy of the Ulster Transport Authority and the breakdown of public transport services."
                                            },
                                            {
                                                "example_id": "67475126-f87b-45d9-b8cc-5c05c8488998",
                                                "sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                                                "text": "“It’s been a long process and I’ve come close to giving up along the way, but this is undoubtedly the craziest archaeological excavation I’ve yet been part of,” Bloch said in the news release."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
