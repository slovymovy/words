                    },
                    {
                        "translation_id": "44bd0a95-ce75-4720-8274-99f9a5085dc9",
                        "source_entry_id": "33359632-4e8d-384c-816e-2b12bcdcb0e3",
                        "target_lang_word": "marasma",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marasma",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "be16f2f0-ec2c-3ffd-92df-6b255cf49030",
                                        "entry_id": "1e8b6268-9bf9-3569-992a-8484a67382b4",
                                        "glosses": [
                                            "condizione estrema ma non irreversibile di consunzione fisica e decadimento psichico dovuta, nei bambini, a malnutrizione o svezzamento precoce (nel qual caso si parla di kwashiorkor o marasma infantile), negli adulti, a processi patologici gravemente debilitanti in forma cronica o dal lento e progressivo decorso, a tumori, alla senilità"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2ad8e5f-c468-4ccd-a256-748ed33cf843",
                                                "sense_id": "be16f2f0-ec2c-3ffd-92df-6b255cf49030",
                                                "text": "Il suo viso rappresentava il marasma senile. Con lui, sul tavolo, si pensava alla vecchiaia condannata dall'indifferenza sociale al supplizio lento della fame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e51dd6ec-f71a-3fc6-b115-abb2a0796f0a",
                                        "entry_id": "1e8b6268-9bf9-3569-992a-8484a67382b4",
                                        "glosses": [
                                            "paralisi, crollo, collasso di un apparato pubblico o privato o di un intero sistema, accompagnato o causato da un caotico, vorticoso dissesto"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b5b2e44-d3ba-4b83-98ab-b645b2adc75b",
                                                "sense_id": "e51dd6ec-f71a-3fc6-b115-abb2a0796f0a",
                                                "text": "L'azione parlamentare è stata sostituita dal regime dei decreti a getto continuo, che rimangono lettera morta per il marasma amministrativo"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "816effa5-8795-3745-a344-cb0d0155bf3d",
                                        "entry_id": "1e8b6268-9bf9-3569-992a-8484a67382b4",
                                        "glosses": [
                                            "intollerabile confusione"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a807ab5e-1680-40c7-b952-4aeebbc2b65d",
                                                "sense_id": "816effa5-8795-3745-a344-cb0d0155bf3d",
                                                "text": "ma come fai a non perderti in un simile marasma?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fc10cc2-56db-3b3b-90ae-60c7c34881cd",
                                        "entry_id": "1e8b6268-9bf9-3569-992a-8484a67382b4",
                                        "glosses": [
                                            "eccesso di euforia e furore, anche di una folla di più individui, talvolta con grida e comportamenti incontrollati"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71e37553-d186-4a49-925a-1b6d6117f87a",
                        "source_entry_id": "33359632-4e8d-384c-816e-2b12bcdcb0e3",
                        "target_lang_word": "Marasmus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marasmus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b07537c9-66db-33d4-b1ea-1589ac728910",
                                        "entry_id": "02894934-9ea3-3c23-86d2-051bf16c2e89",
                                        "glosses": [
                                            "fortschreitender Verfall der körperlichen und geistigen Kräfte, durch Alter, Krankheit oder Mangelernährung; Eiweiß- und Energiemangel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f3c33c4-766c-4e67-a359-718e927c109e",
                                                "sense_id": "b07537c9-66db-33d4-b1ea-1589ac728910",
                                                "text": "„Die Masern\", schrieb die New York Times, sind bei mangelernährten afrikanischen Kindern „ein Killer\". Andere Folgeerkrankungen durch unzureichende Ernährung: Eisenmangelanämie, Diarrhöe, Marasmus (allgemeiner Verfall) und Kwashiorkor (ein sogenannter Mehlnährschaden, der, sich entwickelt, wenn trotz ausreichender Kohlehydrateernährung dem Körper zuwenig Eiweiß zugeführt wird)."
                                            },
                                            {
                                                "example_id": "71b617fb-368c-4711-a877-27301d193188",
                                                "sense_id": "b07537c9-66db-33d4-b1ea-1589ac728910",
                                                "text": "Die Auswirkungen: In den Slums von Bangkok ist jedes zweite Baby unterernährt, und jedes siebte Kleinkind leidet an Marasmus."
                                            },
                                            {
                                                "example_id": "fcacfcb6-8480-447c-97c6-23f6cd4adfda",
                                                "sense_id": "b07537c9-66db-33d4-b1ea-1589ac728910",
                                                "text": "„Da er niemals im eigentlichen Sinne krank gewesen war, kann auch der Zustand zunehmender Schwäche nicht als konkretes Symptom einer organischen Krankheit gewertet werden, sondern der Körper des Philosophen fiel einem allgemeinen und umfassenden Marasmus anheim, einem Abnehmen der physischen Kräfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cd32de1a-e4d6-3c25-b3fd-4ce780c00991",
                                        "entry_id": "02894934-9ea3-3c23-86d2-051bf16c2e89",
                                        "glosses": [
                                            "Verlust an Kraft; Verfall"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c43824a1-0282-4faf-a032-2e48bb5627d6",
                                                "sense_id": "cd32de1a-e4d6-3c25-b3fd-4ce780c00991",
                                                "text": "In der kontroversen Diskussion, die sich um die Sendung in Tschechien entfaltete, war mitunter die Verunsicherung der Gesellschaft zu spüren, die nach dem Marasmus des realen Sozialismus in dem realen Kapitalismus Orientierung sucht und sich nun vor der Blamage fürchtet, würde etwa einer der populären Popsänger zum grössten Tschechen erkoren - was letztlich nicht geschah."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f10779d9-ab94-47c6-b774-51301ba1f7ee",
                        "source_entry_id": "33359632-4e8d-384c-816e-2b12bcdcb0e3",
                        "target_lang_word": "Altersschwäche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
