                    {
                        "translation_id": "8ec6e567-3ade-42e1-8091-ef5e9ab22b6d",
                        "source_entry_id": "75bcc055-e2a0-3564-87cf-8e9dcee58507",
                        "target_lang_word": "scintiller",
