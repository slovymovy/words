                ],
                "senses": [
                    {
                        "sense_id": "47a1676e-20bc-3516-bf6c-bf721790f376",
                        "entry_id": "2f5f2052-4937-31c6-a2e6-c540041df5c0",
                        "glosses": [
                            "Qui assoupit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d39aac90-db84-4f29-bd55-1defb943d44d",
                                "sense_id": "47a1676e-20bc-3516-bf6c-bf721790f376",
                                "text": "Je me souviens qu’on voyait des fenêtres deux grands moulins à vent qui dépassaient les murs de clôture, et dont les ailes grises, rayées de baguettes sombres, tournaient sans cesse devant les yeux avec une monotonie de mouvement assoupissante."
                            },
                            {
                                "example_id": "fe62df32-24ac-4ec0-b5c1-c0688e1eaed9",
                                "sense_id": "47a1676e-20bc-3516-bf6c-bf721790f376",
                                "text": "Comme à un signal, toutes les bêtes de l’eau se mirent à crier à la fois, faisant entendre leurs clameurs assoupissantes."
                            },
                            {
                                "example_id": "82c3834a-1073-481a-9573-e395b6ab9a1d",
                                "sense_id": "47a1676e-20bc-3516-bf6c-bf721790f376",
                                "text": "Fumées, vapeurs assoupissantes."
                            },
                            {
                                "example_id": "610ae1be-8189-441c-97e0-84318519e056",
                                "sense_id": "47a1676e-20bc-3516-bf6c-bf721790f376",
                                "text": "Remède assoupissant."
                            },
                            {
                                "example_id": "964f5cbf-afee-4497-9356-765209725b76",
                                "sense_id": "47a1676e-20bc-3516-bf6c-bf721790f376",
                                "text": "Lecture assoupissante."
                            },
                            {
                                "example_id": "059c3f53-3612-4d95-86d5-d8a53b09449a",
                                "sense_id": "47a1676e-20bc-3516-bf6c-bf721790f376",
                                "text": "Son débit est assoupissant."
                            },
                            {
                                "example_id": "07f09fde-15b2-4f23-b9c3-6c1eb3dd92a3",
                                "sense_id": "47a1676e-20bc-3516-bf6c-bf721790f376",
                                "text": "Ouvrage assoupissant."
                            }
                        ]
                    }
