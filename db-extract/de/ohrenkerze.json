                        "glosses": [
                            "präparierte Kerze, die der Ohrreinigung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f205ac0-0de9-4f85-b86a-d0c969032e10",
                                "sense_id": "ef4f5c07-7926-3211-bcb2-0a2bf030293d",
                                "text": "„Der Schlauch sieht aus wie eine Ohrenkerze. Kennen Sie Ohrenkerzen? Man zündet sie an und hält sie sich ans Ohr, dabei entsteht ein Unterdruck, der einem die Ohren reinigt.“"
                            }
                        ],
