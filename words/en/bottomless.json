    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1cca415b-dfbe-3a56-a5ec-1bfbdaa29698",
                    "sense_definition": "Extremely deep or appearing to have no floor.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "depth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers stared into the dark, seemingly <w>bottomless</w> canyon.",
                            "target_lang_translations": {
                                "es": "Los exploradores contemplaron el cañón oscuro y aparentemente <w>sin fondo</w>."
                            }
                        },
                        {
                            "text": "The mysterious ocean trench seemed like a <w>bottomless</w> abyss stretching forever.",
                            "target_lang_translations": {
                                "es": "La misteriosa fosa oceánica parecía un abismo <w>sin fondo</w> que se extendía para siempre."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bottomless pit",
                        "bottomless abyss"
                    ],
                    "target_lang_definitions": {
                        "es": "Extremadamente profundo o que da la impresión de no tener suelo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "sin fondo",
                                "target_lang_sense_clarification": "aparentemente interminable en profundidad"
                            },
                            {
                                "target_lang_word": "hondo",
                                "target_lang_sense_clarification": "muy profundo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb5483d8-b4e7-35ce-a026-0eb61e20d310",
                    "sense_definition": "Having no limits; virtually boundless.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limitless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She seemed to possess a <w>bottomless</w> well of patience with the children.",
                            "target_lang_translations": {
                                "es": "Parecía poseer un pozo <w>inagotable</w> de paciencia con los niños."
                            }
                        },
                        {
                            "text": "His ambition felt like a <w>bottomless</w> hunger that could never be satisfied.",
                            "target_lang_translations": {
                                "es": "Su ambición parecía un hambre <w>sin fondo</w> que nunca podría saciarse."
