                    "frequency": "Middle",
                    "semantic_group_id": "morue_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons préparé un plat traditionnel avec de la <w>morue</w> salée et des pommes de terre."
                        },
                        {
                            "text": "Le médecin m'a conseillé de prendre de l'huile de foie de <w>morue</w> pendant tout l'hiver."
                        }
                    ],
                    "synonyms": [
                        "cabillaud"
                    ],
                    "common_phrases": [
