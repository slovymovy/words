                        "glosses": [
                            "Doctrine socialiste pour en finir avec la Première Guerre mondiale et préparer la révolution prolétarienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22e69a51-2ef9-44dc-8dc4-b5b6d5cc6cbb",
                                "sense_id": "81b8f1f6-030b-3842-b9e8-3a342a554f2f",
                                "text": "Le soulèvement des bolchevikis en juillet et la conversion définitive des soviets au zimmerwaldisme, tels furent les seuls résultats concrets de cette tentative."
                            },
                            {
                                "example_id": "2d21c896-b577-4386-b9c4-8fb59df6dd00",
                                "sense_id": "81b8f1f6-030b-3842-b9e8-3a342a554f2f",
                                "text": "De plus, les minoritaires, peu nombreux et divisés entre longuettisme et zimmerwaldisme, sont loin d’adopter des thèses, qui non sans être parfois radicales, ne sont pas défaitistes, mais pacifistes."
                            }
                        ]
                    }
