                ],
                "senses": [
                    {
                        "sense_id": "cffd9938-507d-3b6d-9e93-49332b6ce323",
                        "entry_id": "4590dd57-e59d-3d97-8aa8-72d6c0353702",
                        "glosses": [
                            "Störung der Fähigkeit zu sprechen bzw. Sprachliches zu verstehen, die auf physische oder psychische Ursachen zurückgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23d1050a-3213-454d-91a3-a0ef594f9936",
                                "sense_id": "cffd9938-507d-3b6d-9e93-49332b6ce323",
                                "text": "Sprachstörungen müssen von Sprech- und Verstehensfehlern unterschieden werden, die keine physischen oder psychischen Ursachen haben, sondern lediglich auf mangelnde Konzentration oder Stress zurückzuführen sind."
                            },
                            {
                                "example_id": "be83141e-a5f1-4fff-a4ec-d79932e0aec5",
                                "sense_id": "cffd9938-507d-3b6d-9e93-49332b6ce323",
                                "text": "Lewandowski definiert Sprachstörungen als „Störungen der Sprachproduktion und/oder Sprechrezeption bzw. der Sprachwahrnehmung.“"
                            },
                            {
                                "example_id": "12231c19-d832-4ead-9ce3-8634ded0f5ce",
                                "sense_id": "cffd9938-507d-3b6d-9e93-49332b6ce323",
                                "text": "„Überhaupt wird, je genauer man die eigentlichen Ursachen der Sprachstörungen untersucht, die entscheidende Rolle des Gehirns auch in den Außenbezirken immer klarer.“"
                            },
                            {
                                "example_id": "0b6d3005-762a-4c63-8745-88a626fbe8ba",
                                "sense_id": "cffd9938-507d-3b6d-9e93-49332b6ce323",
                                "text": "Die häufigsten kindlichen Sprachstörungen sind Aussprachstörungen, auch Dyslalie oder Stammeln genannt."
                            },
                            {
                                "example_id": "fe3e09d6-5d69-4fa6-8c7d-c309f2bca9fb",
                                "sense_id": "cffd9938-507d-3b6d-9e93-49332b6ce323",
                                "text": "„Er sprach über typische Sprachstörungen bei Schizophrenen, in denen Denkstörungen zum Ausdruck kamen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
