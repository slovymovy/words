                "senses": [
                    {
                        "sense_id": "64bb1a28-3b81-38e9-8cf9-b7a94c3ef0b5",
                        "entry_id": "2429f0a1-2a22-33a9-8941-5c00f3620113",
                        "glosses": [
                            "ein Wein, der im Anbaugebiet Saale gewachsen und produziert wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8af663ef-01e8-492e-ad38-3c524ed1ca47",
                                "sense_id": "64bb1a28-3b81-38e9-8cf9-b7a94c3ef0b5",
                                "text": "„Bei diesem interessanten Gespräch – übrigens bei einer Flasche Saalewein aus der Gegend von Jena – machte ich unüberlegt eine Bemerkung, die bei ihm entschiedenen Protest auslöste: …“"
                            },
                            {
                                "example_id": "e89c7aa4-b8ff-4fc6-a14b-98bbab6c5f13",
                                "sense_id": "64bb1a28-3b81-38e9-8cf9-b7a94c3ef0b5",
                                "text": "„Es dürfte auch nicht allgemein bekannt sein, daß gute Jahrgänge des Saaleweines früher schon in die berühmten Gegenden Westdeutschlands gingen und dort zur Verbesserung ausgefallener Gewächse dienten.“"
                            },
                            {
                                "example_id": "187b59b4-261a-4b94-8b3f-4692f68657f7",
                                "sense_id": "64bb1a28-3b81-38e9-8cf9-b7a94c3ef0b5",
                                "text": "„Der vorgesehene Betreiber der dort geplanten Vinothek für Saaleweine ist abgesprungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
