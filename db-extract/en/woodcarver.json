                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c5f6433-0920-4c05-bb02-6f7fbe8c9e6a",
                                                "sense_id": "f3a6f14d-1314-3882-955b-2a0d51425a54",
                                                "text": "Ale tím rozhněval si biskupa, jenž uložil mu za pokutu, aby jakožto řezbář dovedný ze dřeva tělo Ukřižovaného vyřezal v té velikosti, jakož sám byl, a tak ten krucifix aby na kříž připevnil a do Říma donesl."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4954bc0c-d3eb-4ba2-9c2e-8c43edcfe6c1",
                        "source_entry_id": "5c69ac3b-f10a-38df-999a-77f4c3bd6f7a",
                        "source_sense_id": "c01e5380-1bd2-3506-a06b-f6f753c0e5d1",
                        "source_sense_description": "a person who is skilled at woodcarving",
                        "target_lang_word": "Holzschnitzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holzschnitzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a529b0d4-adc7-3320-b548-486e979a243e",
                                        "entry_id": "871b6cfe-ca24-3dc7-9beb-ed185d7c98c2",
                                        "glosses": [
                                            "jemand, der Holz durch künstlerisches Bearbeiten mit einem Messer oder Ähnlichem in bestimmte Formen bringt, hölzerne Schnitzwerke herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beea3b73-36fe-451a-8de1-87f77d77ce9d",
                                                "sense_id": "a529b0d4-adc7-3320-b548-486e979a243e",
                                                "text": "„Noch im 7. bis 9. Jahrhundert verzierten schottische Holzschnitzer Kästchen mit keltischen Wirbelmotiven.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fe7844e-36af-405e-a9ed-1c2047847cc6",
                        "source_entry_id": "5c69ac3b-f10a-38df-999a-77f4c3bd6f7a",
                        "source_sense_id": "c01e5380-1bd2-3506-a06b-f6f753c0e5d1",
                        "source_sense_description": "a person who is skilled at woodcarving",
                        "target_lang_word": "Schnitzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnitzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c5174de-955e-35b4-9109-3ee8636b5585",
                                        "entry_id": "22c64b82-8558-3c36-9097-d54170bc0c4a",
                                        "glosses": [
                                            "jemand, der schnitzt, im engeren Sinne: jemand, der das Schnitzen zum Beruf hat oder als Kunst betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5350fa6-59e7-452b-b619-c1316053ed88",
                                                "sense_id": "1c5174de-955e-35b4-9109-3ee8636b5585",
                                                "text": "Wären auch die zwei Geißlein gar nicht übel geschnitzt, so müßte doch Toni, um wirklich etwas Rechtes zu leisten und sein Brot damit zu verdienen, erst bei einem guten Schnitzer lernen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d02b725-78e0-3ce0-8872-9af1c10cf99f",
                                        "entry_id": "22c64b82-8558-3c36-9097-d54170bc0c4a",
                                        "glosses": [
                                            "Fehler, der aus Unachtsamkeit begangen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d505e5ee-cafc-4fab-9d88-fef8f53718f5",
                                                "sense_id": "8d02b725-78e0-3ce0-8872-9af1c10cf99f",
                                                "text": "Noch so einen Schnitzer darfst du dir aber nicht erlauben."
                                            },
                                            {
                                                "example_id": "0340d993-80c6-496c-8e39-24120f6bc21b",
                                                "sense_id": "8d02b725-78e0-3ce0-8872-9af1c10cf99f",
                                                "text": "Hochzuverehrender Herr Vetter! […] Verzeihen mir mein Schreiben; danke für gütige Erlaubnis, und daß orthografische Schnitzer darin, das kommt daher, weil mich mein Vater schon früh aus der Schul genommen, nämlich bei Herr Piler zu St. Petri und Pauli, kaum zehn Jahr alt, und mich zu sich in die Werkstatt getan […]."
                                            },
                                            {
                                                "example_id": "cbdb2e2d-6d93-43f7-8c27-70a1c1181ad4",
                                                "sense_id": "8d02b725-78e0-3ce0-8872-9af1c10cf99f",
                                                "text": "„Nach und nach füllte sich die Stube, aber heute erklärte sie nicht, heute duldete sie Schnitzer, die sie sonst nie hätte durchgehen lassen.“"
                                            },
                                            {
                                                "example_id": "012bc41a-0f9f-449d-9ae0-4c5ef28b0238",
                                                "sense_id": "8d02b725-78e0-3ce0-8872-9af1c10cf99f",
                                                "text": "„Ich möchte aber doch gerne wissen, was es mit den neuen Hinweisen auf sich hat, obwohl es mir eher die stereotype Form zu sein scheint, mit der die Polizei verbrämt, daß sie einen Schnitzer gemacht hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
