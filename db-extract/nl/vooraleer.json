        "nl-extract.jsonl": [
            {
                "entry_id": "09456d35-16f2-3e69-9579-5cd7714903c9",
                "word": "vooraleer",
                "pos": "conj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6de62c77-5e9e-31cd-9c36-f8d0bff64e43",
                        "entry_id": "09456d35-16f2-3e69-9579-5cd7714903c9",
                        "glosses": [
                            "voordat"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "55f4d136-8842-4eca-ad1e-f32687ca0a68",
                                "sense_id": "6de62c77-5e9e-31cd-9c36-f8d0bff64e43",
                                "text": "Vooraleer een subject op negatieve wijze gedefinieerd kan worden, moet het wezen van een subject als een fundamentele oerbepaling uitgesproken worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "772d8ede-1fea-4525-a43a-065d007fc016",
                        "source_entry_id": "09456d35-16f2-3e69-9579-5cd7714903c9",
                        "source_sense_id": "6de62c77-5e9e-31cd-9c36-f8d0bff64e43",
                        "target_lang_word": "before",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "before",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35461d09-f153-35e5-898c-2ce1f7e88974",
                                        "entry_id": "b1005c05-85da-3d14-93e8-c7daaddd3a86",
                                        "glosses": [
                                            "Earlier than (in time)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d85209-6f7d-45f7-9811-a62d154cbebd",
                                                "sense_id": "35461d09-f153-35e5-898c-2ce1f7e88974",
                                                "text": "I want this done before Monday."
                                            },
                                            {
                                                "example_id": "9f92acfc-303c-49e9-b5b5-c4b309fff01c",
                                                "sense_id": "35461d09-f153-35e5-898c-2ce1f7e88974",
                                                "text": "We made an odd party before the arrival of the Ten, particularly when the Celebrity dropped in for lunch or dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d00f7dd-f5c6-3cba-9e2a-14f1fa9413a7",
                                        "entry_id": "b1005c05-85da-3d14-93e8-c7daaddd3a86",
                                        "glosses": [
                                            "In front of in space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a79c492-6d41-42ba-808b-2d9226e6c152",
                                                "sense_id": "2d00f7dd-f5c6-3cba-9e2a-14f1fa9413a7",
                                                "text": "He stood before me."
                                            },
                                            {
                                                "example_id": "3df626fc-9779-4e0c-bd08-12063b6f0df8",
                                                "sense_id": "2d00f7dd-f5c6-3cba-9e2a-14f1fa9413a7",
                                                "text": "We sat before the fire to warm ourselves."
                                            },
                                            {
                                                "example_id": "6d82c226-36c1-4903-9937-a53999e233a7",
                                                "sense_id": "2d00f7dd-f5c6-3cba-9e2a-14f1fa9413a7",
                                                "text": "His angel, who shall go / Before them in a cloud and pillar of fire."
                                            },
                                            {
                                                "example_id": "9865cbf0-d3b0-4b92-85b5-70835dda21bc",
                                                "sense_id": "2d00f7dd-f5c6-3cba-9e2a-14f1fa9413a7",
                                                "text": "He tried to persuade Cicely to stay away from the ball-room for a fourth dance.[…]But she said she must go back, and when they joined the crowd again[…]she found her mother standing up before the seat on which she had sat all the evening searching anxiously for her with her eyes, and her father by her side."
                                            },
                                            {
                                                "example_id": "16f45174-aa1f-455f-ab00-cc8b30b57435",
                                                "sense_id": "2d00f7dd-f5c6-3cba-9e2a-14f1fa9413a7",
                                                "text": "The ability of a segment of a glass sphere to magnify whatever is placed before it was known around the year 1000, when the spherical segment was called a reading stone, essentially what today we might term a frameless magnifying glass or plain glass paperweight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c4bd09c-516f-3fc7-9906-a4594312bd5e",
                                        "entry_id": "b1005c05-85da-3d14-93e8-c7daaddd3a86",
                                        "glosses": [
                                            "In the presence of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6e4daea-aa46-4658-8bc2-ee88ac9566be",
                                                "sense_id": "9c4bd09c-516f-3fc7-9906-a4594312bd5e",
                                                "text": "He performed before the troops in North Africa."
                                            },
                                            {
                                                "example_id": "0b05ceb6-2b86-4817-9ebb-5eb6c2ba4f55",
                                                "sense_id": "9c4bd09c-516f-3fc7-9906-a4594312bd5e",
                                                "text": "He spoke before a joint session of Congress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ef60913-a2c6-3ee4-a1bd-ea42d8f19782",
                                        "entry_id": "b1005c05-85da-3d14-93e8-c7daaddd3a86",
                                        "glosses": [
                                            "Under consideration, judgment, authority of (someone)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80ae4c5c-6310-456b-b28b-2e48eecd8503",
                                                "sense_id": "3ef60913-a2c6-3ee4-a1bd-ea42d8f19782",
                                                "text": "The case laid before the panel aroused nothing but ridicule."
                                            },
                                            {
                                                "example_id": "39332ef7-2935-4ad0-8a94-fd95f542d6ba",
                                                "sense_id": "3ef60913-a2c6-3ee4-a1bd-ea42d8f19782",
                                                "text": "If a suit be begun before an archdeacon[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "229458b9-8d46-3b1c-ae73-369130aafb39",
                                        "entry_id": "b1005c05-85da-3d14-93e8-c7daaddd3a86",
                                        "glosses": [
                                            "In store for, in the future of (someone)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "544372cb-3816-4464-9be7-d0eb03f068ab",
                                                "sense_id": "229458b9-8d46-3b1c-ae73-369130aafb39",
                                                "text": "Your whole life is before you."
                                            },
                                            {
                                                "example_id": "05bc54c3-5021-4576-a4de-1655100643f7",
                                                "sense_id": "229458b9-8d46-3b1c-ae73-369130aafb39",
                                                "text": "The golden age[…]is before us."
                                            },
                                            {
                                                "example_id": "e38bd4a5-b566-4cd6-9171-c8730f9f9584",
                                                "sense_id": "229458b9-8d46-3b1c-ae73-369130aafb39",
                                                "text": "There is an Eternity behind thee as well as one before. Hast thou bewailed the aeons that passed without thee, who art so much afraid of the aeons that shall pass?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42acbf01-0fc3-3572-9391-f53281de0442",
                                        "entry_id": "b1005c05-85da-3d14-93e8-c7daaddd3a86",
                                        "glosses": [
                                            "In front of, according to a formal system of ordering items."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d434c11e-cf4a-4fd9-b108-2eac242882d1",
                                                "sense_id": "42acbf01-0fc3-3572-9391-f53281de0442",
                                                "text": "In alphabetical order, \"cat\" comes before \"dog\", \"canine\" before feline\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b625ee07-cc32-3408-95d0-36156c1bf041",
                                        "entry_id": "b1005c05-85da-3d14-93e8-c7daaddd3a86",
                                        "glosses": [
                                            "At a higher or greater position than, in a ranking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8770135-e087-4ae9-bc72-aab0c573af08",
                                                "sense_id": "b625ee07-cc32-3408-95d0-36156c1bf041",
                                                "text": "An entrepreneur puts market share and profit before quality, and amateur intrinsic qualities before economical considerations."
                                            },
                                            {
                                                "example_id": "7157290f-b748-453c-9546-a423e17a4aed",
                                                "sense_id": "b625ee07-cc32-3408-95d0-36156c1bf041",
                                                "text": "He that cometh after me is preferred before me."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "before",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab50674b-313c-39fd-938f-8ff757eeb450",
                                        "entry_id": "47d452d7-1b79-37f3-acd1-556e64504805",
                                        "glosses": [
                                            "At an earlier time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de148ef3-32c5-44ae-a911-50cf2faba901",
                                                "sense_id": "ab50674b-313c-39fd-938f-8ff757eeb450",
                                                "text": "I've never done this before."
                                            },
                                            {
                                                "example_id": "bf8b7fd3-ff38-46e1-bc4f-ccf4bde8950e",
                                                "sense_id": "ab50674b-313c-39fd-938f-8ff757eeb450",
                                                "text": "This achievement far exceeded anything that had come before."
                                            },
                                            {
                                                "example_id": "9e593580-3725-42a3-a634-a1902bc80153",
                                                "sense_id": "ab50674b-313c-39fd-938f-8ff757eeb450",
                                                "text": "All this was extraordinarily distasteful to Churchill. It was ugly, gross. Never before had he felt such repulsion when the vicar displayed his characteristic bluntness or coarseness of speech. In the present connexion—or rather as a transition from the subject that started their conversation—such talk had been distressingly out of place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2122281c-5f7b-3567-bbac-f374f0438ba4",
                                        "entry_id": "47d452d7-1b79-37f3-acd1-556e64504805",
                                        "glosses": [
                                            "In advance in position or sequence; ahead."
                                        ],
                                        "tags": [
                                            "literary",
                                            "not-comparable",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac47c11d-d489-4b74-8b05-187335346128",
                                                "sense_id": "2122281c-5f7b-3567-bbac-f374f0438ba4",
                                                "text": "We walked behind while they went before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bb475a4-ab82-3335-a140-2800a694f438",
                                        "entry_id": "47d452d7-1b79-37f3-acd1-556e64504805",
                                        "glosses": [
                                            "At the front end."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbe556ef-eb6b-4c24-8234-3772849d7e51",
                                                "sense_id": "7bb475a4-ab82-3335-a140-2800a694f438",
                                                "text": "When people call this beast to mind,\nThey marvel more and more\nAt such a little tail behind,\nSo LARGE a trunk before."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "before",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a33308ae-f56f-3cf1-b09e-87da25d37fe8",
                                        "entry_id": "b5ac287c-64c1-33ac-8a14-eaebdbc781ee",
                                        "glosses": [
                                            "In advance of the time when."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b2bb7d1-fcf9-414e-a87c-0fa071e3ea69",
                                                "sense_id": "a33308ae-f56f-3cf1-b09e-87da25d37fe8",
                                                "text": "Brush your teeth before you go to bed."
                                            },
                                            {
                                                "example_id": "4afaa83f-7162-424d-8562-ac96d48608cd",
                                                "sense_id": "a33308ae-f56f-3cf1-b09e-87da25d37fe8",
                                                "text": "But before this elaborate treatise can become of universal use and ornament to my native country, two points[…] are absolutely necessary."
                                            },
                                            {
                                                "example_id": "8c3bf7f7-b7b3-4348-868e-313337274676",
                                                "sense_id": "a33308ae-f56f-3cf1-b09e-87da25d37fe8",
                                                "text": "Stephen Ward then had to time his tackle excellently to deny Tarmo Kink as the Wolves winger slid the ball out of play before the Estonian could attempt to beat Given."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71258eb2-5e76-3bf1-ab12-1d7677c02822",
                                        "entry_id": "b5ac287c-64c1-33ac-8a14-eaebdbc781ee",
                                        "glosses": [
                                            "Rather or sooner than."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef16e405-8a7c-4555-af55-bf964f1486c8",
                                                "sense_id": "71258eb2-5e76-3bf1-ab12-1d7677c02822",
                                                "text": "I'll die before I('ll) tell you anything about it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "before",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93a3561c-d6c6-3129-a6c0-cfb8a3cf33da",
                                        "entry_id": "ae44a353-7b48-395b-afdd-2e9dac8e156d",
                                        "glosses": [
                                            "Of before-and-after images: the one that shows the difference before a specified treatment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd7eb1b1-3b85-460b-8fe0-881bcb3b959e",
                                                "sense_id": "93a3561c-d6c6-3129-a6c0-cfb8a3cf33da",
                                                "text": "On the left of the double column of photographs are the “befores.” Look at them! Fine boys all, yet here is an unformed mouth; there, a fine face just missing strength by a slight over-plumpness of feature; below, a clever face just a shade too “smart”; on the next page, a form too slight and beginning to stoop. On the right are the “afters.”"
                                            },
                                            {
                                                "example_id": "d17d3f13-6a86-44d7-8952-dff8781a36db",
                                                "sense_id": "93a3561c-d6c6-3129-a6c0-cfb8a3cf33da",
                                                "text": "I told them that I was taking part in a ‘Before and After’ feature for the magazine. The beauty editor had picked a couple of girls in the office to experiment on. ‘I always think that the befores look better than the afters in that kind of experiment,’ Aunt G said."
                                            },
                                            {
                                                "example_id": "c38424a4-2882-4fe6-b14c-fb94eb6d61b3",
                                                "sense_id": "93a3561c-d6c6-3129-a6c0-cfb8a3cf33da",
                                                "text": "Sometimes we’d agree the person looked better in their before. Happier somehow. More themselves before the muscles. […] Other times we’d laugh at the befores. I’d make a crack, something like, “People should need a special government ID to buy spandex like that. It’s a question of public safety.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "679c7ef4-3d7c-3680-9f91-07bc8c1dd42e",
                                        "entry_id": "ae44a353-7b48-395b-afdd-2e9dac8e156d",
                                        "glosses": [
                                            "That which occurred or existed previously."
                                        ],
                                        "tags": [
                                            "often",
                                            "poetic",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72a7143b-7a37-4540-9744-149a026ebd7f",
                                                "sense_id": "679c7ef4-3d7c-3680-9f91-07bc8c1dd42e",
                                                "text": "As all are commanded to yield like the mummy when the dung beetle rolls the sun / before all the befores of the trillion nights past night and day / though I knew that the broken receding mouth of the Sphinx had nothing to add / of resurrection in the history of its grimace."
                                            },
                                            {
                                                "example_id": "3cd897a6-72b1-4d8f-bdb7-262078eeeb99",
                                                "sense_id": "679c7ef4-3d7c-3680-9f91-07bc8c1dd42e",
                                                "text": "Your music has lasted since the beginning of the world. A stone was born in the waters. […] Voice rising to heaven, pure music, green primal root, mother-sea, before all the befores."
                                            },
                                            {
                                                "example_id": "452fe8bc-b752-4734-8877-615d994edac7",
                                                "sense_id": "679c7ef4-3d7c-3680-9f91-07bc8c1dd42e",
                                                "text": "Yet when I was a child, I stood with my mother on that distant shore, or walked with her up the road, past orchards of plums and pears, past fields narrow as piano keys. To the village where she was born, and her mother before her; all other mothers, all the befores that ever were."
                                            },
                                            {
                                                "example_id": "c09be261-71de-45ef-8a25-61e66e39f82e",
                                                "sense_id": "679c7ef4-3d7c-3680-9f91-07bc8c1dd42e",
                                                "text": "Because we’re in debt to that before, to all the befores where the life was before the words. Every time we pick up a hammer and a nail there’s a dead man in it who built a lean-to out of the weather in Wyoming in December or a farmer in Latin America someplace on the back of a mule-drawn cart broken down with a town’s vegetables rotting in the sun or a Mennonite right over there in McGaheysville this minute saying no to some nigh useless particle board siding and still fashioning his house with his hand."
                                            },
                                            {
                                                "example_id": "346bc54d-af9d-46ba-bc7c-4f2ef317a724",
                                                "sense_id": "679c7ef4-3d7c-3680-9f91-07bc8c1dd42e",
                                                "text": "For high in the brightest tower of Light Castle, one thing shone still brighter—the Princess of Light! She came from before all the befores, from a place that is no place. Not fire. Not water. Not air. Not earth. No place. Neither solid, nor liquid, nor gas. Nothing to speak of."
                                            },
                                            {
                                                "example_id": "27bffcb4-630d-43e4-a3c1-69239c24e89f",
                                                "sense_id": "679c7ef4-3d7c-3680-9f91-07bc8c1dd42e",
                                                "text": "The packing that took all week to finish had also taken her mind off Mike. Less and less she found herself weeping. Her focus was on the nexts. There was little time now to think about all the befores. Today would put an end to the last leftover one."
                                            },
                                            {
                                                "example_id": "add92060-6b66-4d9d-abe5-623eb33ff933",
                                                "sense_id": "679c7ef4-3d7c-3680-9f91-07bc8c1dd42e",
                                                "text": "We talk about all the befores. The stupid things we did. The funny things. The times she made us laugh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c91dd975-1f19-36f9-b2ee-c0bf9442d257",
                                        "entry_id": "ae44a353-7b48-395b-afdd-2e9dac8e156d",
                                        "glosses": [
                                            "A previous form or instance."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c3a0ecf-cc50-48be-820d-7614088f7f49",
                                                "sense_id": "c91dd975-1f19-36f9-b2ee-c0bf9442d257",
                                                "text": "A big wind blew all their befores away. Impacted teeth grew over their names. Even the lines in their hands unraveled, these are the lines they stand in to ask for their hands back."
                                            },
                                            {
                                                "example_id": "3b7e22ed-7dc2-4a60-b328-7011e59bdb0a",
                                                "sense_id": "c91dd975-1f19-36f9-b2ee-c0bf9442d257",
                                                "text": "I guess I should have known from all the befores / that when it’s all said and done / I don’t want to be / I won’t stand to be / I refuse to be / anything but YOURS"
                                            },
                                            {
                                                "example_id": "62732b1f-ddb7-4fa3-9c0c-1cb81c9db625",
                                                "sense_id": "c91dd975-1f19-36f9-b2ee-c0bf9442d257",
                                                "text": "They were chatting and laughing and it made my heart hurt. They were getting out. Returning to whatever their befores were. They didn’t even glance back at the house as they climbed into the waiting vehicles."
                                            }
                                        ]
                                    }
                                ]
