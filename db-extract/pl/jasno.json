                                                "example_id": "7c5a8358-7172-44e7-a812-2ea96d76f4b3",
                                                "sense_id": "ca45f283-8e2a-3ce0-b392-cbb6601555b6",
                                                "text": "听不清楚"
                                            },
                                            {
                                                "example_id": "1e649903-8b61-4f9e-b811-b8bd64a45a6c",
                                                "sense_id": "ca45f283-8e2a-3ce0-b392-cbb6601555b6",
                                                "text": "學習漢語發音一定要分清楚調類。"
                                            },
                                            {
                                                "example_id": "9819be75-745d-4205-9048-0ed91246b8ce",
                                                "sense_id": "ca45f283-8e2a-3ce0-b392-cbb6601555b6",
                                                "text": "学习汉语发音一定要分清楚调类。"
                                            },
                                            {
                                                "example_id": "9c9eb391-fb4d-4c9d-8f7b-576a069fb10f",
                                                "sense_id": "ca45f283-8e2a-3ce0-b392-cbb6601555b6",
                                                "text": "既然你們都已經想清楚了，那我尊敬你們的意願。"
                                            },
                                            {
                                                "example_id": "46eeb4de-1519-49c8-b856-acb7b8631e54",
                                                "sense_id": "ca45f283-8e2a-3ce0-b392-cbb6601555b6",
                                                "text": "既然你们都已经想清楚了，那我尊敬你们的意愿。"
                                            },
                                            {
                                                "example_id": "715669f8-6f35-4128-bd5e-2000b3f70b02",
                                                "sense_id": "ca45f283-8e2a-3ce0-b392-cbb6601555b6",
                                                "text": "你了解得很全面，講述得也很清楚。"
                                            },
                                            {
                                                "example_id": "934ac43b-d810-47c3-8df4-c10d86a25ab0",
                                                "sense_id": "ca45f283-8e2a-3ce0-b392-cbb6601555b6",
                                                "text": "你了解得很全面，讲述得也很清楚。"
                                            },
                                            {
                                                "example_id": "4cc3b2ec-100c-4d6c-9538-361af4abaa26",
                                                "sense_id": "ca45f283-8e2a-3ce0-b392-cbb6601555b6",
                                                "text": "說清楚"
                                            },
                                            {
                                                "example_id": "c4b3ee1c-3081-4972-aab7-2a6035783617",
                                                "sense_id": "ca45f283-8e2a-3ce0-b392-cbb6601555b6",
                                                "text": "说清楚"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "清楚",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "44662102-9c84-389e-a391-4de3055a6314",
                                        "entry_id": "213ed942-bea3-3df2-be04-f7861d21ef66",
                                        "glosses": [
                                            "理解，了解"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bdc8946-0720-466b-bafc-cc61339f4aec",
                                                "sense_id": "44662102-9c84-389e-a391-4de3055a6314",
                                                "text": "你是一個什麼樣的人，我比誰都清楚。"
                                            },
                                            {
                                                "example_id": "03d7b2af-fa46-4811-95a8-caffddd11715",
                                                "sense_id": "44662102-9c84-389e-a391-4de3055a6314",
                                                "text": "你是一个什么样的人，我比谁都清楚。"
                                            },
                                            {
                                                "example_id": "531f835c-abff-4b6e-a41b-2bacbdf5e7cb",
                                                "sense_id": "44662102-9c84-389e-a391-4de3055a6314",
                                                "text": "這句話的道理你應該清楚。"
                                            },
                                            {
                                                "example_id": "b6af1937-5e3f-425a-8ae4-69e37b5e384d",
                                                "sense_id": "44662102-9c84-389e-a391-4de3055a6314",
                                                "text": "这句话的道理你应该清楚。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
