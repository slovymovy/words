                                        "entry_id": "1cf0f373-b79f-3bff-aa88-c914ab9e6879",
                                        "glosses": [
                                            "Région historique côtière de la mer du Nord, allant des Pays-bas à la frontière danoise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bc322f3-3cc8-4ca2-83a1-410673bd641b",
                                                "sense_id": "3aaae900-1779-3034-9799-3715ddff93ab",
                                                "text": "Tibère qui avait abandonné l’idée de conquérir la Germanie se souciait peu d’engager une nouvelle guerre pour reprendre la Frise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b1c81f1-204f-3266-9b05-b8573a415b4d",
                                        "entry_id": "1cf0f373-b79f-3bff-aa88-c914ab9e6879",
                                        "glosses": [
                                            "Une des douze provinces des Pays-Bas dont le chef-lieu est Leeuwarden."
                                        ],
