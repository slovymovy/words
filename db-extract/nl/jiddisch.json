                    {
                        "sense_id": "e6201607-10be-35e4-b5fa-f93fc14510ed",
                        "entry_id": "0b5d0f09-7594-35a6-b3ce-a23dfb85a478",
                        "glosses": [
                            "Germaanse taal die door Joden over de hele wereld wordt gesproken"
                        ],
                        "tags": [
                            "linguistics",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "b0bd093b-a6c3-4de2-afe2-0d8612ea9a8d",
                                "sense_id": "e6201607-10be-35e4-b5fa-f93fc14510ed",
                                "text": "Ik ken iemand die Jiddisch spreekt."
                            },
                            {
                                "example_id": "bae56b57-d632-45f1-9c55-587e5a6ed7e1",
                                "sense_id": "e6201607-10be-35e4-b5fa-f93fc14510ed",
                                "text": "Al aan het eind van de 17de eeuw verscheen in Amsterdam een krant in het Jiddisch. Vervolgens werden er ook boeken, romans, toneelstukken en gedichten in het Jiddisch gepubliceerd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac55a190-ef18-48cd-8262-170606649acc",
                        "source_entry_id": "0b5d0f09-7594-35a6-b3ce-a23dfb85a478",
                        "source_sense_id": "e6201607-10be-35e4-b5fa-f93fc14510ed",
                        "source_sense_description": "Germaanse taal die door de Joden in West-Europa gesproken werd",
                        "target_lang_word": "意第绪语",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8c4b4078-1048-4c25-bdc9-ac11e36d8db6",
                        "source_entry_id": "0b5d0f09-7594-35a6-b3ce-a23dfb85a478",
                        "source_sense_id": "e6201607-10be-35e4-b5fa-f93fc14510ed",
                        "source_sense_description": "Germaanse taal die door de Joden in West-Europa gesproken werd",
                        "target_lang_word": "Jiddisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jiddisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4ffdc84-bd63-39ac-8e08-31b208a32a5c",
                                        "entry_id": "aea4e218-72bd-388c-baed-be50fcdcf1bb",
                                        "glosses": [
                                            "aus einer im Mittelalter in wichtigen Handelszentren (Rhein, Donauländer) als Verkehrssprache der Juden entstandenen Variante des Deutschen hervorgegangene Komponentensprache, bestehend vor allem aus mittel- und ostoberdeutschen (rheinfränkisch, ostmitteldeutsch und bairisch), semitisch-hebräisch-aramäischen (vor allem aus Talmud, Mischna), slawischen (polnisch, weißrussisch, ukrainisch) und romanischen Sprachelementen, die vor der Schoah von ungefähr 12 Millionen aschkenasischen Juden und heutzutage weltweit von schätzungsweise annähernd 1.5 Millionen Juden als Mutter- beziehungsweise Zweitsprache (insbesondere von älteren sowie haredischen Personen) in Israel, den USA, Großbritannien, Belgien, Lateinamerika (vor allem Argentinien) und auf dem Gebiet der ehemaligen Sowjetunion gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "223df6bd-eda5-4466-a085-fe0b731af1e2",
                                                "sense_id": "d4ffdc84-bd63-39ac-8e08-31b208a32a5c",
                                                "text": "„Dieses Jiddisch war nun inzwischen dem gleichzeitigen Deutsch immer unähnlicher geworden, obwohl der deutsche Wortschatz nie unter drei Viertel des gesamten Bestandes herabsank.“"
                                            },
                                            {
                                                "example_id": "02c2a315-12c6-413a-95a6-3e2cae033a0a",
                                                "sense_id": "d4ffdc84-bd63-39ac-8e08-31b208a32a5c",
                                                "text": "„Heller sprach mit Mama Jiddisch, Lucille unterhielt sich ausgezeichnet mit Borka, ohne daß der es auch nur einmal gewagt hätte, sie anzufassen.“"
                                            },
                                            {
                                                "example_id": "7872e275-edfc-4e9a-a030-00c5abf78203",
                                                "sense_id": "d4ffdc84-bd63-39ac-8e08-31b208a32a5c",
                                                "text": "„Im Jiddischen bilden vier Hauptkomponenten die Struktur: die germanische, die semitische, die slawische und die romanische. Zu berücksichtigen ist noch das griechische und persische Lehngut, das meist über das nachbiblische Schrifttum, wie den Talmud in das Jiddische gelangt ist.“"
                                            },
                                            {
                                                "example_id": "94c29d95-395a-412d-beb1-c2a15409ae62",
                                                "sense_id": "d4ffdc84-bd63-39ac-8e08-31b208a32a5c",
                                                "text": "„Als Kind wurde er einmal in glimmende Kohlen gestoßen und einmal attackierte ihn ein Stier, als Erwachsener überstand er ein rumänisches Lager unter den Faschisten und dann zehn Jahre den Gulag im äußersten Norden, und nun lebt er hochbetagt und blind im Hochschwarzwald: eines deutschen Dichters Jahrhundert. «Deutsch»? Ja, denn der kleine Moses Rosenkranz, 1904 in Berhometh in der Bukowina geboren, erwählte sich, in einem Sprachengemisch von Jiddisch, Polnisch, Ruthenisch und Deutsch am östlichen Rand des K.-u.-k.-Kronlandes, das «Buchenland» heißt, aufwachsend, rätselhafterweise die deutsche Sprache als das Medium, das allein seinem Innern entspreche.“"
                                            },
                                            {
                                                "example_id": "23417641-8b23-4926-874a-59d9ba535386",
                                                "sense_id": "d4ffdc84-bd63-39ac-8e08-31b208a32a5c",
                                                "text": "„Geboren 1963 in Frankreich, lernt er Hebräisch und Jiddisch, heute ist er Direktor des Hauses für Jiddische Kultur in Paris. Er liest Gedichte in Jiddisch, ein anderes Mal aus seinem neuen Roman ‚Eine Liebe ohne Widerstand‘, er liest auf Französisch, später auf Deutsch.“"
                                            },
                                            {
                                                "example_id": "9937d6bb-dc23-451c-a9d7-1cd8bb53f03b",
                                                "sense_id": "d4ffdc84-bd63-39ac-8e08-31b208a32a5c",
                                                "text": "„Mit mehr Berechtigung lässt sich Jiddisch nämlich als eine Komponentensprache (engl. fusion language, jidd. schmélzschprach) bezeichnen, die ihre Entstehung einem lang andauernden und intensiven Kontakt verschiedener Sprachen bei den aschkenasischen Juden verdankt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dce8fb6-17a3-4ba7-a456-8fb6964b1c56",
                        "source_entry_id": "0b5d0f09-7594-35a6-b3ce-a23dfb85a478",
