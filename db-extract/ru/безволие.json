                                "target_senses": [
                                    {
                                        "sense_id": "94e78341-3197-30cb-9a08-855288ea4f69",
                                        "entry_id": "f9a0ed1f-3303-3e46-af9f-f8a4acca8300",
                                        "glosses": [
                                            "Absence of willpower or decisiveness, especially as a symptom of mental illness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e90074fc-cc88-4133-a867-e5be43a165dd",
                                                "sense_id": "94e78341-3197-30cb-9a08-855288ea4f69",
                                                "text": "He felt without volition, plunged into a state of aboulia."
                                            },
                                            {
                                                "example_id": "51ff0ba5-06d0-44bb-9475-487ce965a867",
                                                "sense_id": "94e78341-3197-30cb-9a08-855288ea4f69",
                                                "text": "His virginal modesty is a modern abulia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21b2ca9b-22de-4083-9842-ac5cfe265bb0",
