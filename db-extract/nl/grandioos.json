                                    },
                                    {
                                        "sense_id": "f9128ebc-49fe-3c0c-a92d-b74b77a07d12",
                                        "entry_id": "c48bace0-75b0-3cd9-ab53-9cf335edf1a7",
                                        "glosses": [
                                            "Large, senior (high-ranking), intense, extreme, or exceptional",
                                            "Great in size, and fine or imposing in appearance or impression; illustrious, dignified, magnificent."
                                        ],
                                        "tags": [
                                            "augmentative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aadcace-8acc-4e6b-881d-e9544b458a80",
                                                "sense_id": "f9128ebc-49fe-3c0c-a92d-b74b77a07d12",
                                                "text": "a grand monarch"
                                            },
                                            {
                                                "example_id": "d8b00975-7d4d-45af-a31b-0f8af9a6b38e",
                                                "sense_id": "f9128ebc-49fe-3c0c-a92d-b74b77a07d12",
                                                "text": "a grand view"
                                            },
                                            {
                                                "example_id": "edeb34cd-f2ba-4ef6-acfc-5d05437df15b",
                                                "sense_id": "f9128ebc-49fe-3c0c-a92d-b74b77a07d12",
                                                "text": "His simple vision has transformed into something far more grand."
                                            },
                                            {
                                                "example_id": "808ee3bf-96f7-4f50-85cd-caa013f906ee",
                                                "sense_id": "f9128ebc-49fe-3c0c-a92d-b74b77a07d12",
                                                "text": "In the mean time, Cluffe had arrived. He was a little bit huffed and grand at being nailed as an evidence, upon a few words carelessly, or, if you will, confidentially dropped at his own mess-table, where Lowe chanced to be a guest; and certainly with no suspicion that his little story could in any way be made to elucidate the mystery of Sturk's murder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c35e411-eeec-38e1-ac8a-6e103a86766c",
                                        "entry_id": "c48bace0-75b0-3cd9-ab53-9cf335edf1a7",
                                        "glosses": [
                                            "Large, senior (high-ranking), intense, extreme, or exceptional",
                                            "Having higher rank or more dignity, size, or importance than other persons or things of the same name."
                                        ],
                                        "tags": [
                                            "augmentative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13492b30-be67-440e-9366-856d2b19386f",
                                                "sense_id": "5c35e411-eeec-38e1-ac8a-6e103a86766c",
                                                "text": "a grand lodge"
                                            },
                                            {
                                                "example_id": "011fea53-cae1-4ed9-8e0b-8f8d681cd834",
                                                "sense_id": "5c35e411-eeec-38e1-ac8a-6e103a86766c",
                                                "text": "a grand vizier"
                                            },
                                            {
                                                "example_id": "5b3be028-af61-4870-a592-3c864f71323c",
                                                "sense_id": "5c35e411-eeec-38e1-ac8a-6e103a86766c",
                                                "text": "a grand piano"
                                            },
                                            {
                                                "example_id": "0f6f3f99-6021-4d3e-a38b-a247d962fbfe",
                                                "sense_id": "5c35e411-eeec-38e1-ac8a-6e103a86766c",
                                                "text": "The Grand Viziers of the Ottoman Empire."
                                            },
                                            {
                                                "example_id": "be1a81cd-3131-4743-9b95-56e8921343d1",
                                                "sense_id": "5c35e411-eeec-38e1-ac8a-6e103a86766c",
