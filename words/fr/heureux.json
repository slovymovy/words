                        {
                            "text": "Depuis qu'elle a changé de travail, elle est vraiment très <w>heureuse</w>.",
                            "target_lang_translations": {
                                "en": "Since she changed jobs, she has been genuinely <w>happy</w>.",
                                "ru": "С тех пор как она сменила работу, она и правда очень <w>счастлива</w>.",
                                "nl": "Sinds ze van baan is veranderd, is ze echt heel <w>gelukkig</w>.",
                                "de": "Seit sie die Arbeit gewechselt hat, ist sie wirklich sehr <w>glücklich</w>.",
                                "pl": "Odkąd zmieniła pracę, jest naprawdę bardzo <w>szczęśliwa</w>.",
                                "it": "Da quando ha cambiato lavoro, è davvero molto <w>felice</w>.",
                                "cs": "Od té doby, co změnila práci, je opravdu velmi <w>šťastná</w>.",
                                "tr": "İş değiştirdiğinden beri gerçekten çok <w>mutlu</w>.",
                                "es": "Desde que cambió de trabajo, está de verdad muy <w>feliz</w>.",
                                "zh": "她自从换了工作，真的很<w>高兴</w>。"
                            }
                        },
                        {
                            "text": "Les enfants étaient <w>heureux</w> de retrouver leurs grands-parents pour les vacances.",
                            "target_lang_translations": {
                                "en": "The children were <w>happy</w> to see their grandparents again for the holidays.",
                                "ru": "Дети были <w>рады</w> снова увидеться с бабушками и дедушками на каникулах.",
                                "nl": "De kinderen waren <w>blij</w> hun grootouders tijdens de vakantie weer te zien.",
                                "de": "Die Kinder waren <w>froh</w>, ihre Großeltern in den Ferien wiederzusehen.",
                                "pl": "Dzieci były <w>szczęśliwe</w>, że na wakacjach znów zobaczą dziadków.",
                                "it": "I bambini erano <w>felici</w> di rivedere i nonni durante le vacanze.",
                                "cs": "Děti byly <w>rády</w>, že na prázdniny zase uvidí prarodiče.",
                                "tr": "Çocuklar tatilde büyükanne ve büyükbabalarını yeniden görecekleri için <w>seviniyorlardı</w>.",
                                "es": "Los niños estaban <w>contentos</w> de volver a ver a sus abuelos en vacaciones.",
                                "zh": "孩子们一想到假期能和爷爷奶奶团聚，个个都很<w>快乐</w>。"
                            }
