                "senses": [
                    {
                        "sense_id": "298e39b0-e529-3a9a-ac34-fa87246ae5b7",
                        "entry_id": "147bebc4-0152-3ee9-aa34-ba8e8ea3f32b",
                        "glosses": [
                            "Anzahl der jeweils gleich ablaufenden Bewegungen pro Minute im Rudersport"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c3926c6-2d2a-4848-99ae-233bee75b67b",
                                "sense_id": "298e39b0-e529-3a9a-ac34-fa87246ae5b7",
                                "text": "„Die deutschen Frauen erhöhten die Schlagzahl und schoben sich an die Spitze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "200de69c-0415-30e8-8bae-fe250091150a",
                        "entry_id": "147bebc4-0152-3ee9-aa34-ba8e8ea3f32b",
                        "glosses": [
                            "Geschwindigkeit des Handelns"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "121cb926-b6d2-4ed1-8fa0-29961374ac58",
                                "sense_id": "200de69c-0415-30e8-8bae-fe250091150a",
                                "text": "„Um Werbekunden anzuziehen und Geld zu verdienen, muss Snapchat mit hoher Schlagzahl wachsen.“"
                            },
                            {
                                "example_id": "9ca3ee1b-fcfe-4e86-9640-d17ffbd7354b",
                                "sense_id": "200de69c-0415-30e8-8bae-fe250091150a",
                                "text": "„Ministerpräsident Horst Seehofer will beim Regieren die Schlagzahl erhöhen.“"
                            },
                            {
                                "example_id": "e143b402-e7d0-4424-9b58-4c542a2b6db9",
                                "sense_id": "200de69c-0415-30e8-8bae-fe250091150a",
                                "text": "„Die folgende Tabelle zeigt ein Beispiel für eine sinnvolle Darstellung von Vertriebsaktivität (Schlagzahl) und Ergebnis (Schlagkraft).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "25798cad-1416-3c19-af30-f47071c98355",
                        "entry_id": "147bebc4-0152-3ee9-aa34-ba8e8ea3f32b",
                        "glosses": [
                            "Anzahl der Ankerschläge einer Uhr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cbf4a56-d25f-4262-a05a-7ac99bdea1da",
                                "sense_id": "25798cad-1416-3c19-af30-f47071c98355",
                                "text": "„Die einschneidendste Veränderung am legendären ‚El Primero‘“ Kaliber 400 betraf die Verringerung der Schlagzahl von 36.000 auf 28.800 Halbschwingungen pro Stunde durch den Einbau einer eigenen Unruh.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "d7caa6ca-bbbf-3bb7-81d9-4e288a0ae629",
                        "entry_id": "147bebc4-0152-3ee9-aa34-ba8e8ea3f32b",
                        "glosses": [
                            "mit einem Stempel erzeugte Nummer zur Kennzeichnung von Werkstücken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "867c8259-78b8-4261-a6ad-d3e8f062d0ad",
                                "sense_id": "d7caa6ca-bbbf-3bb7-81d9-4e288a0ae629",
                                "text": "„Kerben – das sind Einschnitte in die glatte Oberfläche des Werkstücks wie Einstiche, Gewinde, scharfkantige Querschnittsübergänge, aber auch Bearbeitungsriefen, Härterisse und Schlagzahlen – vermindern die Dauerfestigkeit von Maschinenteilen erheblich.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "67d74ccd-9337-30e2-bfbb-e9328e6a5236",
                        "entry_id": "147bebc4-0152-3ee9-aa34-ba8e8ea3f32b",
                        "glosses": [
                            "Anzahl der Arbeitstakte von Hämmern pro Minute"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "909ed5f7-126e-48e9-aadc-059881b3da18",
                                "sense_id": "67d74ccd-9337-30e2-bfbb-e9328e6a5236",
                                "text": "„Immerhin ist ein Anwachsen der Lagerungsdichte und der Steifezahl mit der Schlagzahl bei nichtbindigen und nicht wassergesättigten mittelbindigen Böden nicht zu verkennen.“"
                            },
                            {
                                "example_id": "b480085a-b552-4197-ac61-263d15742e12",
                                "sense_id": "67d74ccd-9337-30e2-bfbb-e9328e6a5236",
                                "text": "„Die Schlagzahl der Bohrhämmer liegt heute sehr hoch, meist zwischen 1700 und 3000.“"
                            },
                            {
                                "example_id": "d9d79b54-4d7e-498e-8f32-4930503566f4",
                                "sense_id": "67d74ccd-9337-30e2-bfbb-e9328e6a5236",
                                "text": "„Je geringer die Schlagarbeit ist, um so größer wird die Schlagzahl gewählt.“"
                            },
                            {
                                "example_id": "8d9aa5a5-706b-4e29-9a93-c57eebf87a47",
                                "sense_id": "67d74ccd-9337-30e2-bfbb-e9328e6a5236",
                                "text": "„Wegen des kleineren Gewichtes und der hohen Schlagzahl bei kleinerem Fallgewicht benötigen die Schnellschlagbäre kein Rammgerüst und werden frei reitend eingesetzt.“"
                            },
                            {
                                "example_id": "f4c8a613-d1ad-420e-b9a2-3ad2cfbe67d6",
                                "sense_id": "67d74ccd-9337-30e2-bfbb-e9328e6a5236",
                                "text": "„Es gibt auch hochfrequente Vibrationsrammen mit Schlagzahlen bis zu 6.000 je Minute.“"
                            },
                            {
                                "example_id": "f313b836-70fe-4bb8-bdc9-adeb53d1f8c0",
                                "sense_id": "67d74ccd-9337-30e2-bfbb-e9328e6a5236",
                                "text": "„Die Frage, ob der Diagonal- oder der Mittenhammer zuletzt auf das Werkstück geschlagen hat, kann aufgrund der hohen Schlagzahl bzw. des Abschaltvorgangs der Schmiedebewegung nicht genau beantwortet werden.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
                ],
