                    ]
                },
                {
                    "sense_id": "4f073a49-144c-34ed-bb1c-2d421eb3256c",
                    "sense_definition": "Fixer ou stabiliser autoritairement un montant ou une valeur pour en empêcher la hausse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stabilisation_financiere",
                    "name_type": "no",
                    "examples": [
