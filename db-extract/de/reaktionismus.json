                        "examples": [
                            {
                                "example_id": "b81a1d1b-0991-46f6-9b27-ae38793cee3f",
                                "sense_id": "827f2438-f106-30cb-af3f-90efdbbd99c5",
                                "text": "Sie fürchten nicht nur die Einführung des Präsidialsystems, sondern auch den Aufstieg des radikalen Islam. „Wir werden dieses Land nicht dem Reaktionismus überlassen“, skandieren sie."
                            },
                            {
                                "example_id": "35b797fc-cdcb-44ca-a570-2f356d6395dd",
                                "sense_id": "827f2438-f106-30cb-af3f-90efdbbd99c5",
                                "text": "1981 musste sich Rainald Goetz im Spiegel vor seinen Freunden dafür verteidigen, dass er zuvor Botho Strauß’ „Paare, Passanten“ himmlisch gelobt hatte, da sie dem Text Reaktionismus vorwarfen."
                            }
                        ]
                    }
