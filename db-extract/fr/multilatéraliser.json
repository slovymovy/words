                        "glosses": [
                            "Donner un caractère multilatéral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62a4fe2f-b85b-41c2-88a3-67f8d85ce7a7",
                                "sense_id": "6debbc59-79f6-3572-a47f-202ecd7cadcd",
                                "text": "Si l'accord a favorisé une expansion des échanges entre Européens de l'Ouest, il n'a pu contribuer à les multilatéraliser."
                            },
                            {
                                "example_id": "1715466c-5f96-4834-8980-5860e68bf6d0",
                                "sense_id": "6debbc59-79f6-3572-a47f-202ecd7cadcd",
                                "text": "C'est pourquoi, en partie sur l'initiative de la France, on décida de multilatéraliser le système des droits de tirage pour l'exercice 1949-1950."
                            }
                        ]
