                {
                    "sense_id": "6e112b00-3221-3ef0-a717-89c16e86cece",
                    "sense_definition": "Uncannily striking or surprising; extreme in a way that is hard to believe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "striking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>scary</w> how much she looks like her mother.",
                            "target_lang_translations": {
                                "ru": "Просто <w>жутко</w>, насколько она похожа на свою мать.",
                                "de": "Es ist <w>unheimlich</w>, wie sehr sie ihrer Mutter sieht.",
                                "fr": "C'est <w>incroyable</w> à quel point elle ressemble à sa mère.",
                                "nl": "Het is <w>eng</w> hoeveel ze op haar moeder lijkt."
                            }
                        },
                        {
                            "text": "The new computer program is <w>scary</w> good at predicting the weather.",
                            "target_lang_translations": {
                                "ru": "Новая компьютерная программа <w>пугающе</w> хороша в предсказании погоды.",
                                "de": "Das neue Computerprogramm ist <w>beängstigend</w> gut darin, das Wetter vorherzusagen.",
                                "fr": "Le nouveau programme informatique est <w>effrayamment</w> doué pour prédire la météo.",
                                "nl": "Het nieuwe computerprogramma is <w>bizar</w> goed in het voorspellen van het weer."
                            }
                        }
                    ],
                    "synonyms": [
