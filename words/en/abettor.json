            "senses": [
                {
                    "sense_id": "ba042925-9ad7-3969-9b95-fb8534626713",
                    "sense_definition": "A person who incites, encourages, or assists someone to commit a crime or wrong.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver of the getaway car was prosecuted as an active <w>abettor</w> in the bank robbery."
                        },
                        {
                            "text": "The law punishes the principal offender and any willing <w>abettor</w> with equal severity."
                        }
                    ],
                    "synonyms": [
                        "accessory",
                        "accomplice",
                        "confederate"
                    ],
                    "common_phrases": [
