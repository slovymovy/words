                "senses": [
                    {
                        "sense_id": "a7f821bb-b238-3440-875f-99c702ca8e9f",
                        "entry_id": "37a4de33-71a9-3707-a312-2af36cb45431",
                        "glosses": [
                            "Pratique de ski alpin consistant à descendre des pentes de neige vierge isolées auxquelles on accède par hélicoptère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b58ddd36-cc4a-4a6b-b469-f7c7fb22be94",
                                "sense_id": "a7f821bb-b238-3440-875f-99c702ca8e9f",
                                "text": "Plusieurs pays – Suisse, Italie, Espagne - tolèrent une pratique d’un autre âge : l’héliski."
                            },
                            {
                                "example_id": "1a0df35b-9adf-4faa-90f8-f22709d84fd7",
                                "sense_id": "a7f821bb-b238-3440-875f-99c702ca8e9f",
                                "text": "Le milliardaire est mort dans un accident d’hélicoptère survenu samedi 27 mars, en Alaska, alors qu’il était en excursion d’héliski autour du glacier Knik, à 80 kilomètres d’Anchorage, la plus grande ville de l’Etat américain. Cette discipline sportive consiste à se faire déposer en hélicoptère en haut de pentes vierges de toute autre trace de skieurs."
                            }
                        ]
                    }
