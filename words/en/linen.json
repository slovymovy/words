{
    "word_family": [
        "linseed",
        "linnet",
        "lint",
        "lining"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "650b9e38-89d4-3611-8848-698449ddd51f",
                    "sense_definition": "Domestic textiles such as tablecloths, bedding, and towels, originally made of linen but now often made of cotton or synthetic fibers.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "textiles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She put the freshly cleaned <w>linens</w> into the linen closet.",
                            "target_lang_translations": {
                                "ru": "Она положила свежевыстиранное <w>бельё</w> в бельевой шкаф."
                            }
                        },
                        {
                            "text": "We need to change the <w>linen</w> on the guest bed before they arrive.",
                            "target_lang_translations": {
                                "ru": "Нам нужно сменить <w>постельное бельё</w> на гостевой кровати до их приезда."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedding",
                        "bedclothes"
                    ],
                    "common_phrases": [
                        "bed linen",
                        "table linen",
                        "linen closet",
                        "fresh linen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Домашний текстиль, такой как скатерти, постельные принадлежности и полотенца, изначально изготавливавшийся из льна, но теперь часто из хлопка или синтетики."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бельё",
                                "target_lang_sense_clarification": "домашний текстиль"
                            },
                            {
                                "target_lang_word": "постельное бельё",
                                "target_lang_sense_clarification": "простыни, наволочки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2053c3e2-7370-3875-8cff-577be1b7b388",
                    "sense_definition": "A type of cloth or thread made from the fibers of the flax plant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "textiles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist preferred to paint on high-quality <w>linen</w> rather than cotton canvas.",
                            "target_lang_translations": {
                                "ru": "Художник предпочитал писать на высококачественном <w>холсте</w>, а не на хлопковом полотне."
                            }
                        },
                        {
                            "text": "This summer suit is made of pure <w>linen</w> to keep you cool in the heat.",
                            "target_lang_translations": {
                                "ru": "Этот летний костюм сделан из чистого <w>льна</w>, чтобы вам было прохладно в жару."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pure linen",
                        "irish linen",
                        "linen thread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип ткани или нити, изготовленной из волокон растения лен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лён",
                                "target_lang_sense_clarification": "материал или растение"
                            },
                            {
                                "target_lang_word": "полотно",
                                "target_lang_sense_clarification": "льняная ткань"
                            },
                            {
                                "target_lang_word": "холст",
                                "target_lang_sense_clarification": "грубая льняная ткань"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f653e5f9-8c5e-31d1-8161-eabcfbed9e99",
                    "sense_definition": "A pale, light beige color resembling the appearance of undyed linen cloth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "colors",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The walls were painted a soft shade of <w>linen</w> to create a calm atmosphere.",
                            "target_lang_translations": {
                                "ru": "Стены были выкрашены в мягкий <w>льняной цвет</w>, чтобы создать спокойную атмосферу."
                            }
                        },
                        {
                            "text": "She chose a <w>linen</w> colored dress for the garden party.",
                            "target_lang_translations": {
                                "ru": "Она выбрала платье <w>льняного цвета</w> для вечеринки в саду."
                            }
                        }
                    ],
                    "synonyms": [
                        "beige",
                        "flaxen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бледно-бежевый цвет, напоминающий вид неокрашенного льняного полотна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "льняной цвет",
                                "target_lang_sense_clarification": "светло-бежевый оттенок"
                            },
                            {
                                "target_lang_word": "цвет небеленого полотна",
                                "target_lang_sense_clarification": "серовато-бежевый"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a125eca8-2a75-35ad-b1b2-44fe6dbb52b0",
                    "sense_definition": "Made of or relating to linen cloth or thread.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "textiles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a crisp <w>linen</w> shirt to the outdoor wedding.",
                            "target_lang_translations": {
                                "ru": "На свадьбу на открытом воздухе он надел свежую <w>льняную</w> рубашку."
                            }
                        },
                        {
                            "text": "The table was covered with a heavy <w>linen</w> cloth.",
                            "target_lang_translations": {
                                "ru": "Стол был накрыт тяжелой <w>полотняной</w> скатертью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "linen shirt",
                        "linen suit",
                        "linen fabric"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из льняной ткани или нити или относящийся к ним."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "льняной",
                                "target_lang_sense_clarification": "изготовленный из льна"
                            },
                            {
                                "target_lang_word": "полотняный",
                                "target_lang_sense_clarification": "сделанный из полотна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4387ee5c-eb88-3eee-be0c-fd373f727133",
                    "sense_definition": "Having a light beige or off-white color.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "colors",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>linen</w> curtains filtered the sunlight beautifully.",
                            "target_lang_translations": {
                                "ru": "<w>Льняные</w> шторы красиво рассеивали солнечный свет."
                            }
                        },
                        {
                            "text": "The room was decorated in <w>linen</w> tones.",
                            "target_lang_translations": {
                                "ru": "Комната была оформлена в <w>светло-бежевых</w> тонах."
                            }
                        }
                    ],
                    "synonyms": [
                        "beige",
                        "off-white"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий светло-бежевый или почти белый цвет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "льняной",
                                "target_lang_sense_clarification": "о цвете"
                            },
                            {
                                "target_lang_word": "светло-бежевый",
                                "target_lang_sense_clarification": "оттенок"
                            }
                        ]
                    }
                }
            ]
        },
        {
