                        "glosses": [
                            "To cause to appear less attractive to consumers or adherents."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "08b8ec07-8cfa-42cd-927a-58d091fc994f",
                                "sense_id": "7f334228-7bc6-31f8-9f7c-7fa07d9acf02",
                                "text": "Politicians will try to unsell the public on its convinction of rearmament."
                            },
                            {
                                "example_id": "6b05d2de-b59e-4eec-9a97-a30df0bec522",
                                "sense_id": "7f334228-7bc6-31f8-9f7c-7fa07d9acf02",
                                "text": "At the same time, every effort to unsell something may also be viewed as an effort to sell something else. Those who attempt to unsell cigarette smoking are attempting to sell health..."
                            },
                            {
                                "example_id": "b6171727-5746-4b59-8139-c1aeb4bbff18",
                                "sense_id": "7f334228-7bc6-31f8-9f7c-7fa07d9acf02",
                                "text": "After the meeting Bob grabbed me by the ear and told me, \"Once you make the sale, shut up and don't unsell it.\""
                            }
                        ]
                    }
