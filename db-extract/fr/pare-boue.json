                                "example_id": "68f4e587-7adf-42d7-8b51-72c9f190cf76",
                                "sense_id": "ae307815-9264-3f7a-bfcd-767a5f8b0d79",
                                "text": "Pneus, portes, capot, pare-boue, projecteurs, feux, sans oublier le groupe motopropulseur…"
