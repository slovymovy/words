                                        "glosses": [
                                            "A small depression or indentation in a surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d45a56a6-a174-4859-8654-71e5b8442b96",
                                                "sense_id": "8995928d-f7cf-3692-9fa6-8120587738e5",
                                                "text": "The accident created a dimple in the hood of the car."
                                            },
                                            {
                                                "example_id": "a91d337b-1d3a-4c7f-a301-4cfc0b3d19c8",
                                                "sense_id": "8995928d-f7cf-3692-9fa6-8120587738e5",
                                                "text": "The garden pool's dark surface […] breaks into dimples small and bright."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5512c8dd-8f99-349c-9b82-05f4624873cc",
                                        "entry_id": "01d84d92-35d8-37db-b5d8-9aafb6184668",
                                        "glosses": [
                                            "Specifically, a small natural depression on the skin, especially on the face near the corners of the mouth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "110e91ef-abc7-4b7b-a63a-9fb69c8391a5",
                                                "sense_id": "5512c8dd-8f99-349c-9b82-05f4624873cc",
                                                "text": "You have very cute dimples."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4362bf5c-086f-3a80-bf1d-06ccc641bb02",
                                        "entry_id": "01d84d92-35d8-37db-b5d8-9aafb6184668",
                                        "glosses": [
                                            "A small depression, made with a punch on a metal object, as a guide for further drilling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
