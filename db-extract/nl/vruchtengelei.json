                                        "sense_id": "e1e3a0f3-1165-3c85-8c52-925fb00eb581",
                                        "entry_id": "305dc11c-bec3-339d-b523-65dbefb1c0df",
                                        "glosses": [
                                            "To brusquely force something into a space; to cram, to squeeze."
                                        ],
