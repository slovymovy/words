                "senses": [
                    {
                        "sense_id": "b577de2a-ac6c-35d9-9ede-6f479758f3c5",
                        "entry_id": "dd64e960-350d-3acb-b58c-02106f9c7d47",
                        "glosses": [
                            "To avow or affirm in advance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac8691b2-1998-4b9e-b970-acb3c13d208c",
                                "sense_id": "b577de2a-ac6c-35d9-9ede-6f479758f3c5",
                                "text": "And His own psalm in Hades had been forevouched for centuries, predicting His release from the grave and the intermediate world, and his reentrance into life, and assuming \"the path of (unending) life.\""
                            },
                            {
                                "example_id": "9ea605e0-4536-41b7-a9c1-4b2649f1177e",
                                "sense_id": "b577de2a-ac6c-35d9-9ede-6f479758f3c5",
                                "text": "Our Saviour hath forevouched that the wicked shall \"go away into everlasting punishment, but the righteous into life eternal.\""
                            },
                            {
                                "example_id": "d0e0bf8c-512f-4753-8ffb-6eabdf1aeb8f",
                                "sense_id": "b577de2a-ac6c-35d9-9ede-6f479758f3c5",
                                "text": "Is it not a startling fact, that in the midst of the Babel confusion which prevails, one conviction presses upon every mind, that we are in a period of solemn grandeur, forevouching the speedy approach of some universal, unprecedented change?"
                            },
                            {
                                "example_id": "97ab7f30-f625-48a8-89d0-46f7900f12f6",
                                "sense_id": "b577de2a-ac6c-35d9-9ede-6f479758f3c5",
                                "text": "[…] was forevouched to be killer of his maternal uncle Rai Dayach in the likeness of Lord Krishna to be the ender of King Kanas."
                            }
                        ]
                    }
                ],
