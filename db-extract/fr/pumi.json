                "senses": [
                    {
                        "sense_id": "2c8e67ef-0c7c-3a69-8555-247973be7c11",
                        "entry_id": "b736ff71-9890-3446-8344-68faaf275979",
                        "glosses": [
                            "Sorte de camion malaxeur, équipé d'une pompe, pour la livraison et la mise en place du béton prêt à l'emploi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb6ee857-cefe-44cb-9cbf-71d4c3858304",
                                "sense_id": "2c8e67ef-0c7c-3a69-8555-247973be7c11",
                                "text": "Le malaxeur pompe, aussi appelé mixo-pompe ou pumi, est en fait un camion toupie standard sur lequel a été ajoutée une pompe à béton comportant un bras de distribution nommé « flèche ». Cette pompe peut aller de 12 à 24 m de haut, ce qui est idéal lorsque le chantier est difficile d’accès."
                            },
                            {
                                "example_id": "9df18347-e498-49ac-a7d4-644d776b16e3",
                                "sense_id": "2c8e67ef-0c7c-3a69-8555-247973be7c11",
                                "text": "Son avantage ? Le camion tapis offre les mêmes avantages que le pumi, tout en étant moins cher."
                            }
                        ]
                    }
                ],
