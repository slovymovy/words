                        "examples": [
                            {
                                "example_id": "8e1e6d65-cc2b-4111-a0f4-72dc8b79977e",
                                "sense_id": "5da0c4aa-f10a-364b-8d24-df1dc2bf62b6",
                                "text": "“Hé Lohues!” roept Harry Muskee amicaal wanneer zijn dertig jaar jongere partner in crime de gelagkamer van wijnboerderij Streuer betreedt. De crime die beide Drenten verbindt, heet de blues, die weemoedige, vaalblauwe substantie die bij beide mannen krachtig door de aderen stroomt."
                            },
                            {
                                "example_id": "f33dc77f-9db4-4422-a650-8ad28086c882",
                                "sense_id": "5da0c4aa-f10a-364b-8d24-df1dc2bf62b6",
                                "text": "De volgende stop is dan Bar VIP, eigendom van de familie Messi. De bar is dicht, de journalist staart ontnuchterd naar de vaalblauwe parasols en de zielloze hipheid van de zaak. En weer: nergens iets dat aan Messi doet denken. Niet eens een naam."
                            }
                        ]
                    }
