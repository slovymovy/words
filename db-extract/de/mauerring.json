                        "glosses": [
                            "Bauwerk, bei dem die Mauer ringförmig verläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e51475f2-6988-4935-a378-8a8c913fb070",
                                "sense_id": "597252f8-b855-3d30-bdaa-42568381a1a7",
                                "text": "„Im Mauerring der Stadt gab es acht Wasserpforten, durch die Boote einfahren konnten.“"
                            },
                            {
                                "example_id": "8414f001-9136-4c09-9ea4-bbf30d83bfe2",
                                "sense_id": "597252f8-b855-3d30-bdaa-42568381a1a7",
                                "text": "„Die Stadtmauern und -tore waren wichtig für die Aufrechterhaltung der symbolischen wie des physischen Unterschieds zwischen Stadt und Land, obwohl auch die meisten Stadtbürger noch ihre Äcker und Gärten hatten, zum Teil sogar innerhalb des Mauerrings.“"
                            }
                        ],
