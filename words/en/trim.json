                            {
                                "target_lang_word": "отделка",
                                "target_lang_sense_clarification": "декоративная"
                            },
                            {
                                "target_lang_word": "окантовка",
                                "target_lang_sense_clarification": "по краям"
                            },
                            {
                                "target_lang_word": "молдинг",
                                "target_lang_sense_clarification": "в интерьере или авто"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9aa022ed-a87b-3bb9-ac96-929c71467df1",
                    "sense_definition": "A specific version or equipment level of a particular car model.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "automotive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This SUV is available in three different <w>trims</w> ranging from basic to luxury.",
                            "target_lang_translations": {
                                "ru": "Этот внедорожник доступен в трех различных <w>комплектациях</w>: от базовой до люксовой."
                            }
                        },
                        {
                            "text": "If you want leather seats, you must choose the highest <w>trim</w> level.",
                            "target_lang_translations": {
                                "ru": "Если вы хотите кожаные сиденья, вам нужно выбрать максимальный уровень <w>оснащения</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "configuration",
                        "specification"
                    ],
                    "common_phrases": [
                        "trim level"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная версия или уровень оснащения определенной модели автомобиля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комплектация",
                                "target_lang_sense_clarification": "автомобиля"
                            },
                            {
                                "target_lang_word": "вариант исполнения",
                                "target_lang_sense_clarification": "модели"
                            }
                        ]
                    }
                }
            ]
        },
        {
