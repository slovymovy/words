                "senses": [
                    {
                        "sense_id": "fd5f1f67-f33f-3b4e-9ce9-2c7fefda7d47",
                        "entry_id": "a787e45b-4d0e-3a9e-bdac-6c0d2c74be4e",
                        "glosses": [
                            "a pig or wild pig in Indonesia"
                        ],
                        "tags": [
                            "dated",
                            "masculine",
                            "no-diminutive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ce6fd8ad-a4c8-3608-8630-6913e6ab7771",
                        "entry_id": "a787e45b-4d0e-3a9e-bdac-6c0d2c74be4e",
                        "glosses": [
                            "pork in an Indonesian or Malay dish"
                        ],
                        "tags": [
                            "masculine",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "8bcabc46-02f9-4fc8-a464-89a29536e083",
                                "sense_id": "ce6fd8ad-a4c8-3608-8630-6913e6ab7771",
                                "text": "Ik ben altijd een groot voorstander geweest van het aran-vuurtje waar je dan zo gezellig naast zat te kipassen terwijl de stukjes babi aan het garen waren."
                            },
                            {
                                "example_id": "c0b5fb5f-46d4-486b-bd6f-91555779c986",
                                "sense_id": "ce6fd8ad-a4c8-3608-8630-6913e6ab7771",
                                "text": "En niet te vergeten de kreukelzones en de opvouwbare stuurkolom, die tegenwoordig gemeengoed zijn, maar indertijd waren er geen kreukelzones en was de stuurkolom nog een stijve spies waaraan je geregen kon worden als babi of ajam aan een satéstokje.",
                                "translation": "And do not forget the crumple zones and the collapsible steering column, that are commonplace today, but at the times there were no crumple zones and the steering column was still a rigid spear on which you could be impailed like pork or chicken on a satay skewer.",
                                "english": "And do not forget the crumple zones and the collapsible steering column, that are commonplace today, but at the times there were no crumple zones and the steering column was still a rigid spear on which you could be impailed like pork or chicken on a satay skewer."
                            },
                            {
                                "example_id": "b7e0915d-23ed-44ed-99f2-4ff483d727d2",
                                "sense_id": "ce6fd8ad-a4c8-3608-8630-6913e6ab7771",
                                "text": "Omdat ze in China honden door de babi douwen,^([sic]) moeten we het dus hier ook doen?",
                                "translation": "So because they put dogs in their (Indo-Malay) pork,^([sic]) we should do the same? (based on the misconception that the dish is Chinese)",
                                "english": "So because they put dogs in their (Indo-Malay) pork,^([sic]) we should do the same? (based on the misconception that the dish is Chinese)"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
