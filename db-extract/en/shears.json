                    {
                        "translation_id": "57e4e8fc-44c4-46d0-becd-f4d8f7036fe3",
                        "source_entry_id": "d9218efb-a121-3a81-9fb8-244d08d9060c",
                        "source_sense_description": "tool consisting of two blades with bevel edges",
                        "target_lang_word": "Schere",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schere",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c2be535-2443-385d-91e4-5a66c3dcda71",
                                        "entry_id": "c33e0074-c73b-312f-94d8-ff965f3490c9",
                                        "glosses": [
                                            "Gerät zum Schneiden von Papier und anderer dünner Materialien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61728a7f-2291-49ff-8712-a6cb0f72c76e",
                                                "sense_id": "9c2be535-2443-385d-91e4-5a66c3dcda71",
                                                "text": "Die Schere ist ein klassisches Bastelutensil."
                                            },
                                            {
                                                "example_id": "590f2e6c-c984-4f95-9d19-58442d9bd9a5",
                                                "sense_id": "9c2be535-2443-385d-91e4-5a66c3dcda71",
                                                "text": "„Simen Tjing ergriff eine Schere und schnitt ihr vom Scheitel aus der erfaßten Haarfülle eine dicke Strähne heraus, wickelte sie in Papier ein und steckte sie in die Tasche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1145bc64-5085-33bd-a7b7-7202b2c2808d",
                                        "entry_id": "c33e0074-c73b-312f-94d8-ff965f3490c9",
                                        "glosses": [
                                            "Organ zum Greifen bei Krebstieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "243e29ae-8b02-46d8-b317-ed2664c94bb1",
                                                "sense_id": "1145bc64-5085-33bd-a7b7-7202b2c2808d",
                                                "text": "Krebse haben oft eine große und eine kleine Schere."
                                            },
                                            {
                                                "example_id": "ee7ae068-0226-4508-9e48-3f85e8d0380d",
                                                "sense_id": "1145bc64-5085-33bd-a7b7-7202b2c2808d",
                                                "text": "„Er knackt die Scheren mit einem Nußknacker und zieht das Fleisch mit einer gebogenen Pinzette heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a57e8d78-f6e5-35f2-b8c1-bcb2c5c640ea",
                                        "entry_id": "c33e0074-c73b-312f-94d8-ff965f3490c9",
                                        "glosses": [
                                            "große Differenz in der Ausprägung eines Merkmals"
                                        ],
                                        "tags": [
                                            "metaphorisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e32ef7f0-3fe4-46f8-8e87-bc768fa1b5e3",
                                                "sense_id": "a57e8d78-f6e5-35f2-b8c1-bcb2c5c640ea",
                                                "text": "Die Schere zwischen arm und reich wird immer größer."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
