{
    "word_family": [
        "effleurement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e797d44-cb75-3e03-b36d-955cce75bd03",
                    "sense_definition": "Toucher très légèrement la surface de quelque chose ou passer tout près en frôlant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contact_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une brise agréable <w>effleurait</w> son visage pendant qu'elle se promenait le long de la plage."
                        },
                        {
                            "text": "Il a tendu doucement la main pour <w>effleurer</w> la joue de son enfant endormi."
                        }
                    ],
                    "synonyms": [
                        "caresser"
                    ],
                    "common_phrases": [
                        "effleurer la peau",
                        "effleurer la surface"
                    ]
                },
                {
                    "sense_id": "531d473e-7d3f-3f04-8d23-bc532bcb0c68",
                    "sense_definition": "Aborder brièvement un sujet sans l'approfondir, ou traverser fugitivement la pensée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a seulement <w>effleuré</w> cette question complexe avant de passer au chapitre suivant."
                        },
                        {
                            "text": "Cette idée étrange m'a brièvement <w>effleuré</w> l'esprit avant que je ne retrouve mon calme."
                        }
                    ],
                    "common_phrases": [
                        "effleurer le sujet",
                        "effleurer l'esprit"
                    ]
                },
                {
                    "sense_id": "acd8443e-35a1-3e1d-bc08-91c5b4ab36db",
                    "sense_definition": "Entamer ou écorcher très légèrement la partie superficielle de quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contact_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le projectile n'a fait qu'<w>effleurer</w> son épaule sans provoquer de blessure grave."
                        },
                        {
                            "text": "L'outil était mal réglé et ne faisait qu'<w>effleurer</w> la terre sans creuser le sillon."
                        }
                    ],
                    "common_phrases": [
                        "effleurer la terre"
                    ]
                }
            ]
        }
    ]
}