                        "glosses": [
                            "Sauna, die nur für Mädchen oder Frauen zugänglich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4d7ed07-0bf5-47c3-a8b1-9d5b8f418bde",
                                "sense_id": "9850f5c0-127e-3d5f-b77e-b2856d062587",
                                "text": "„Eine reine Damensauna ist aber auch nicht die reine Freude.“"
                            },
                            {
                                "example_id": "0fed4690-a3ae-475f-875c-ee084c141d7c",
                                "sense_id": "9850f5c0-127e-3d5f-b77e-b2856d062587",
                                "text": "„Frauen, die lieber unter ihresgleichen bleiben möchten, sind donnerstags in der Damensauna richtig.“"
                            }
                        ],
