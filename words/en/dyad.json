                    ]
                },
                {
                    "sense_id": "54958800-c0bc-38f9-beb9-487bb2f6bc3a",
                    "sense_definition": "Any set of two different pitch classes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music_theory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer used a dissonant <w>dyad</w> to create tension in the opening bars."
                        },
                        {
                            "text": "A harmonic <w>dyad</w> can imply a chord without fully sounding it."
                        }
                    ],
                    "common_phrases": [
                        "harmonic dyad"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in music theory"
                        }
                    ]
                },
                {
                    "sense_id": "57381692-7caf-3a08-8b4a-4fc1a24f35bf",
                    "sense_definition": "An element, atom, or radical having a valence of or combining power of two.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oxygen acts as a <w>dyad</w> in most of its chemical compounds."
                        },
                        {
                            "text": "The textbook describes how a divalent atom or <w>dyad</w> forms two covalent bonds."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in chemistry"
                        }
                    ]
                },
                {
                    "sense_id": "87b9a3fb-01be-3db4-a6df-608e2aa1c7b3",
                    "sense_definition": "A chromosome structure, usually X- or V-shaped, consisting of two condensed sister chromatids joined by a centromere.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During meiosis, each chromosome is visible as a <w>dyad</w> before separation."
                        },
                        {
                            "text": "The sister chromatids remain attached at the centromere to form a chromosome <w>dyad</w>."
                        }
                    ],
                    "common_phrases": [
                        "chromosome dyad"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in biology"
                        }
                    ]
                },
                {
                    "sense_id": "c2aad646-9965-3142-a602-af7bf9613645",
                    "sense_definition": "A secondary unit of organisation consisting of an aggregate of monads.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Leibnizian philosophy, a <w>dyad</w> represents a higher level of complexity than a single monad."
                        },
                        {
                            "text": "The system builds upward from the monad to the <w>dyad</w> and beyond."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in philosophy"
                        }
                    ]
                },
                {
                    "sense_id": "dcbcf79e-7bf6-32b0-922c-91a4a92c804b",
                    "sense_definition": "A tensor of order two and rank one.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The outer product of two vectors yields a <w>dyad</w> in tensor algebra."
                        },
                        {
                            "text": "We can represent the stress state using a sum of a <w>dyad</w> and other tensors."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in mathematics"
                        }
                    ]
                }
            ]
