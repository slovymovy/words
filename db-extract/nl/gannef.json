                    {
                        "sense_id": "ae0bc73e-625b-3bd8-aaf6-f03fa53c14d3",
                        "entry_id": "e634d85b-d813-3c01-8af0-5869d819474d",
                        "glosses": [
                            ", meestal dief, oplichter, schurk"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "26b860a3-a31c-4e4b-bb1e-b9726784378c",
                                "sense_id": "ae0bc73e-625b-3bd8-aaf6-f03fa53c14d3",
                                "text": "Alles is gejat door die gannef!"
                            }
                        ]
                    },
                    {
                        "sense_id": "01dea980-2b27-3fa4-9c35-589e0b820c2c",
                        "entry_id": "e634d85b-d813-3c01-8af0-5869d819474d",
                        "glosses": [
                            "meestal boef, schelm"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5797c6b3-3f5e-4e9c-a1fd-20446168fa78",
                        "source_entry_id": "e634d85b-d813-3c01-8af0-5869d819474d",
                        "source_sense_id": "ae0bc73e-625b-3bd8-aaf6-f03fa53c14d3",
                        "target_lang_word": "Ganove",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ganove",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae19114c-866c-3dfd-9df6-dc05a5eeb11a",
                                        "entry_id": "19ff2609-0d20-327e-9146-3c808e8b2cd5",
                                        "glosses": [
                                            "jemand, der andere betrügt und/oder schwere Straftaten begeht; jemand, der der Unterwelt angehört"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c27970ac-edd1-4b4a-a7bd-c7620e3bf3ee",
                                                "sense_id": "ae19114c-866c-3dfd-9df6-dc05a5eeb11a",
                                                "text": "„Die Reichen trennen sich von ihren Luxuskarossen, um keine weithin sichtbare Zielscheibe für die Ganoven zu geben, die sich neuerdings auf \"Blitzentführungen\" spezialisiert haben.“"
                                            },
                                            {
                                                "example_id": "2301fdde-ed53-4f43-8250-4864bd3e95dc",
                                                "sense_id": "ae19114c-866c-3dfd-9df6-dc05a5eeb11a",
                                                "text": "„Der Streit, der sich in den letzten Tagen auf beiden Seiten in einer nicht mehr sehr diplomatischen Wortwahl artikuliert hat, handelt im Grunde davon, wer ein Ganove ist und wer nicht, und wer den Ganoven hilft und wer nicht.“"
                                            },
                                            {
                                                "example_id": "5286fe50-6b0c-4812-b0cb-67029a194a9a",
                                                "sense_id": "ae19114c-866c-3dfd-9df6-dc05a5eeb11a",
                                                "text": "„Leider wachsen die Kinder dieser Ganoven in einer Umgebung auf, in der Straftaten zum Alltag gehören und als normaler Lebensinhalt angesehen werden.“"
                                            },
                                            {
                                                "example_id": "221fec21-f255-44ac-a6a4-df61ad7bb9df",
                                                "sense_id": "ae19114c-866c-3dfd-9df6-dc05a5eeb11a",
                                                "text": "„Die Zeiten sind nicht einfach für Ganoven wie Khedache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87223e1f-01f3-4401-a68b-0098c3178b69",
                        "source_entry_id": "e634d85b-d813-3c01-8af0-5869d819474d",
                        "source_sense_id": "ae0bc73e-625b-3bd8-aaf6-f03fa53c14d3",
                        "target_lang_word": "ganef",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ganef",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a0589de-45c9-3a2e-9709-3002b8542a55",
                                        "entry_id": "e8fddf8c-3e09-3bd1-b44d-719162bd4540",
                                        "glosses": [
                                            "A thief; a rascal or scoundrel."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29ff1a7b-266b-4d71-aec1-f358d3df893c",
                                                "sense_id": "6a0589de-45c9-3a2e-9709-3002b8542a55",
                                                "text": "Right to the end of the street he dragged her, pursued by a hooting crowd. Then he stopped, worn out. \"Will you give me that sixpence, you Ganef!\""
                                            },
                                            {
                                                "example_id": "2acd14b3-2312-46a3-a407-3cf8b5f3ae50",
                                                "sense_id": "6a0589de-45c9-3a2e-9709-3002b8542a55",
                                                "text": "Packed in airtight against the bite of the steely out-of-doors, most of the village of Vodna—except the children and the half-witted Shimsha, the ganef—huddled under its none-too-plentiful coverings that night and prayed and trembled."
                                            },
                                            {
                                                "example_id": "a949cd04-762e-4666-bf82-c1831f1f1ef2",
                                                "sense_id": "6a0589de-45c9-3a2e-9709-3002b8542a55",
                                                "text": "The streets swarmed with hucksters, ganefs, and handkerchief girls who solicited in the shadows of buildings draped in black bunting."
                                            },
                                            {
                                                "example_id": "a29afe9c-6cf4-4a36-ac03-98898c2387f9",
                                                "sense_id": "6a0589de-45c9-3a2e-9709-3002b8542a55",
                                                "text": "I would love to have a little inside knowledge that my grandfather's friends took down a president, but the reality is an endless procession of desperate little ganefs—and most of them are very small—trying to stay one step ahead of cops in suits from Sy Syms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d6bc9af-21fe-45c6-94d6-61654231acee",
                        "source_entry_id": "e634d85b-d813-3c01-8af0-5869d819474d",
                        "source_sense_id": "ae0bc73e-625b-3bd8-aaf6-f03fa53c14d3",
                        "target_lang_word": "gonoph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gonoph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e266dad3-3364-3661-a546-42a2113c435a",
                                        "entry_id": "45587396-882e-316b-adde-a6bbf3922268",
                                        "glosses": [
                                            "Dated spelling of ganef."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef1f636-9815-4589-8ebb-8ff176dd3ee6",
                                                "sense_id": "e266dad3-3364-3661-a546-42a2113c435a",
                                                "text": "If the smallest Gonoph about town were crouching at the bottom... Inspector Field would nose him with a finer scent than an ogre's, when adventurous Jack lay trembling in his kitchen copper.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
