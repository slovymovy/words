                "senses": [
                    {
                        "sense_id": "83e79c76-a61f-3121-a5f6-27795f4e4990",
                        "entry_id": "afbd1e8a-ab49-3ad2-8e80-701ca75ad2a4",
                        "glosses": [
                            "Donner un caractère sacrificiel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b3ad77f-0a17-478d-a4af-8d5d48cab515",
                                "sense_id": "83e79c76-a61f-3121-a5f6-27795f4e4990",
                                "text": "L’utilisation systématique, à grand déploiement, de la configuration sacrificielle a contribué, non pas à «sacrificialiser» la mort de Jésus, mais à fonder en elle l’abrogation de cette institution de l’ancienne alliance (8,13; 9,10; 10,18.26)."
                            },
                            {
                                "example_id": "2b4508a0-76f6-43ae-9b8e-73871fdff2d4",
                                "sense_id": "83e79c76-a61f-3121-a5f6-27795f4e4990",
                                "text": "S’il est plausible de percevoir ici ou là quelques accents eucharistiques, Hébreux, en tout cas, n’a certainement pas sacralisé, ni « sacrificialisé » l’eucharistie, ni, encore moins, « sacerdotalisé » ceux qui la célébraient sans doute."
                            }
                        ]
                    }
