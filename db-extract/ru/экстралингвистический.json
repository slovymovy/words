                "senses": [
                    {
                        "sense_id": "0bfe3b85-e8a5-3d39-9bc0-e0bb761aa6f7",
                        "entry_id": "48574f5e-6a1a-33f4-97ad-ca27cc3320ff",
                        "glosses": [
                            "лингв. не являющийся языковой сущностью; определяемый факторами, не относящимися к языку; относящийся к некоторой сущности, не входящей в круг предметов, изучаемых лингвистикой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b82f458-0004-454d-82f4-a8a9fd269aa0",
                                "sense_id": "0bfe3b85-e8a5-3d39-9bc0-e0bb761aa6f7",
                                "text": "Смысловые универсалии являются экстралингвистической категорией и описывают компоненты содержания независимо от формы их выражения, а также их дальнейшего употребления."
                            }
                        ]
                    }
                ],
