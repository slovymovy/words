                        "examples": [
                            {
                                "example_id": "c8b756ad-8e50-4da6-be5c-d58d6e9b4c70",
                                "sense_id": "e2439bb8-0a3e-3e27-8488-251cc626181d",
                                "text": "„Allerdings ist unter natürlichen Bedingungen der Mangel an geeigneten Schalen ein begrenzender Faktor für die Population, so dass die Tiere erst einmal von der Abfallflut profitieren könnten.“"
                            },
                            {
                                "example_id": "67e46bc6-d798-498f-b7eb-f749999d96de",
                                "sense_id": "e2439bb8-0a3e-3e27-8488-251cc626181d",
                                "text": "„Mit Stampffußwalzen und Müll-Krematorien, mit Planierraupen und Kompostierungsanlagen suchen die Müll-Werker der steigenden Abfallflut Herr zu werden.“"
                            }
                        ],
