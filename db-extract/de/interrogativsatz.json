                "senses": [
                    {
                        "sense_id": "2d70702b-166e-318e-8286-9ab88c2d0394",
                        "entry_id": "383be080-bd0b-323b-8ce6-e06dd9068f43",
                        "glosses": [
                            "Oberbegriff für verschiedene Satzformen, die hauptsächlich dazu verwendet werden, um eine Frage zu äußern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dd64efd-fd6f-4229-8c9b-4575d1bbd8ac",
                                "sense_id": "2d70702b-166e-318e-8286-9ab88c2d0394",
                                "text": "„Der Fragesatz (Interrogativsatz, von lat. interrogare ‚fragen‘) ist eine Satzform, die eine genau bezeichnete Informationslücke der Sprecherin enthält, und zugleich eine Aufforderung an den Gesprächspartner darstellt, diese Lücke zu füllen.“"
                            },
                            {
                                "example_id": "5cf2d574-c1e6-4e18-8097-de7d75f92811",
                                "sense_id": "2d70702b-166e-318e-8286-9ab88c2d0394",
                                "text": "Der Satz \"Kommst du heute?\" ist ein Interrogativsatz."
                            },
                            {
                                "example_id": "a8be07ae-1930-4ab4-942e-ec2e3b82ddad",
                                "sense_id": "2d70702b-166e-318e-8286-9ab88c2d0394",
                                "text": "Interrogativsätze werden mit dem Satzzeichen \"?\" gekennzeichnet, wenn es sich um Hauptsätze handelt."
                            },
                            {
                                "example_id": "eeda315c-c56a-4a7b-96c4-55a935e42e74",
                                "sense_id": "2d70702b-166e-318e-8286-9ab88c2d0394",
                                "text": "Manche Interrogativsätze dienen nicht als Fragen, sondern eher als Aufforderungen, wie z.B. \"Willst du nicht endlich kommen?\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
