                        "form": "die Scheingewinn"
                    },
                    {
                        "form_id": "81171b76-3590-476a-81a4-3c7b2917e80e",
                        "entry_id": "71ac288b-44c3-3a7d-8f3a-4cfb2fe8e4dc",
                        "tags": [
                            "accusative",
