                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3f0948c-2817-4016-933b-54af000a4788",
                        "source_entry_id": "4e91c7dd-1f16-34c3-9f2b-1ae806090098",
                        "source_sense_id": "106b0c66-7a00-3bc3-b2a6-a882c50b4e9c",
                        "target_lang_word": "sindirmek",
                        "target_lang_code": "tr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sindirmek",
                                "target_lang_code": "tr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ab40fda-1466-36fc-a23f-99c2882e8e82",
                                        "entry_id": "dad25007-a48f-39ef-8a8c-3e9140a7b145",
                                        "glosses": [
                                            "sinmesini sağlamak veya sinmesine sebep olmak, pıstırmak, sındırmak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe4ea4a4-a6b5-4afa-ab1c-20904690f749",
                                                "sense_id": "2ab40fda-1466-36fc-a23f-99c2882e8e82",
                                                "text": "Kartal burunlu, kalın kaşlı, çember sakallı ihtiyar, Sertman'ı biraz sindirdi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83794ef2-6249-3733-8aa1-9e8acbf0b384",
                                        "entry_id": "dad25007-a48f-39ef-8a8c-3e9140a7b145",
                                        "glosses": [
                                            "yenilen besin maddesini sindirim sisteminde gereken değişikliklere uğratarak kana karışabilir bir duruma getirmek, hazmetmek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fd3c973-02b1-4ee7-93f3-de2cd9a60474",
                                                "sense_id": "83794ef2-6249-3733-8aa1-9e8acbf0b384",
                                                "text": "Hoca, sabahleyin bir bahçıvanın ikram ettiği turp salatasını henüz sindirememişti."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45da7f3a-0279-3404-9036-b33295d7cf5d",
                                        "entry_id": "dad25007-a48f-39ef-8a8c-3e9140a7b145",
                                        "glosses": [
                                            "(mecaz) kendine mal etmek, anlayışla karşılayıp benimsemek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a880ce2-174c-4b5d-811a-8fc3c334279b",
                                                "sense_id": "45da7f3a-0279-3404-9036-b33295d7cf5d",
                                                "text": "Bir de o düşünceleri gerçekten sindirmiş bilginlerin, bilge kişilerin tutumuna bir bakın."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d412b02-d2b7-41d4-96c6-f582b4d649fa",
                        "source_entry_id": "4e91c7dd-1f16-34c3-9f2b-1ae806090098",
                        "source_sense_id": "106b0c66-7a00-3bc3-b2a6-a882c50b4e9c",
                        "target_lang_word": "intimider",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intimider",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3a3a0e2-3594-39ce-9940-791bab09d5f3",
                                        "entry_id": "fd0052dc-59f3-387e-af19-367ce1192d2b",
                                        "glosses": [
                                            "Troubler quelqu’un en lui causant de la crainte, de l’appréhension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a5cd289-2d21-44b4-8ee7-d068b4e6934d",
                                                "sense_id": "c3a3a0e2-3594-39ce-9940-791bab09d5f3",
                                                "text": "Il croyait que les lois étaient faites pour secourir les citoyens autant que pour les intimider."
                                            },
                                            {
                                                "example_id": "af86b790-6394-4e7b-bc80-e117faa84893",
                                                "sense_id": "c3a3a0e2-3594-39ce-9940-791bab09d5f3",
                                                "text": "Enfin, à l'image des oiseaux des îles Falkland, décrits par Darwin en 1835, les limules manquent de timidité. En effet, ils ne craignent pas l'homme et ne sont aucunement intimidés par sa présence. Se pencher sur un limule est aussi une expérience un peu troublante... Souvent, l'invertébré se positionne pour mieux percevoir l'étranger. Dès lors, on ne sait plus très bien qui étudie qui."
                                            },
                                            {
                                                "example_id": "5281c074-9e54-448b-992e-08c3bd0d7fde",
                                                "sense_id": "c3a3a0e2-3594-39ce-9940-791bab09d5f3",
                                                "text": "Il l’intimida en lui disant un seul mot."
                                            },
                                            {
                                                "example_id": "2a5ea606-8d1f-41f4-b4f8-a53418696364",
                                                "sense_id": "c3a3a0e2-3594-39ce-9940-791bab09d5f3",
                                                "text": "Il n’y a qu’à l’intimider pour venir à bout de lui."
                                            },
                                            {
                                                "example_id": "719bbcbc-aacd-451a-8e57-d6129df4988f",
                                                "sense_id": "c3a3a0e2-3594-39ce-9940-791bab09d5f3",
                                                "text": "C’est un esprit qu’on intimide facilement par des menaces."
                                            },
                                            {
                                                "example_id": "3b6fed25-9581-4778-a405-7d2db3d3f058",
                                                "sense_id": "c3a3a0e2-3594-39ce-9940-791bab09d5f3",
                                                "text": "C’est un homme qui ne se laisse point intimider."
                                            },
                                            {
                                                "example_id": "95d9eddb-9947-4e1e-af4d-0f40887d31e7",
                                                "sense_id": "c3a3a0e2-3594-39ce-9940-791bab09d5f3",
                                                "text": "Son aspect m’intimide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f922a67c-9ce7-4ad2-94e9-2cee629b9669",
                        "source_entry_id": "4e91c7dd-1f16-34c3-9f2b-1ae806090098",
