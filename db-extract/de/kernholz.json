                "senses": [
                    {
                        "sense_id": "ed4809bf-4e5f-3d7b-9cad-10502e987fbb",
                        "entry_id": "b40b5142-ea02-374b-a897-bb64bebeb615",
                        "glosses": [
                            "härteres, dunkel gefärbtes Holz im inneren Teil eines Baumstamms"
                        ],
                        "tags": [
                            "Holzwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "0ee5bce0-ea11-4a92-8725-a29d1449c77b",
                                "sense_id": "ed4809bf-4e5f-3d7b-9cad-10502e987fbb",
                                "text": "In der Mitte ist das Kernholz, das dem Baum seine Festigkeit gibt."
                            },
                            {
                                "example_id": "0ed2265b-028f-47cc-b8f8-f01230540bb4",
                                "sense_id": "ed4809bf-4e5f-3d7b-9cad-10502e987fbb",
                                "text": "Aufgrund der Farbe, der Dauerhaftigkeit und der besseren technischen Eigenschaften ist das Kernholz meist wertvoller als das Splintholz (z.B. bei Eiche, Ulme, Mahagoni)."
                            },
                            {
                                "example_id": "e6a3d85e-540c-4dea-a339-29d7e38706e9",
                                "sense_id": "ed4809bf-4e5f-3d7b-9cad-10502e987fbb",
                                "text": "Als Farbstofflieferant wird das rote Kernholz - Lignum Santali rubrum - in Teemischungen und zum Färben von Natrufasern verwendet."
                            },
                            {
                                "example_id": "6f127610-7793-4901-a186-94c72624c5bf",
                                "sense_id": "ed4809bf-4e5f-3d7b-9cad-10502e987fbb",
                                "text": "Das etwa drei bis sechs Millimeter breite Splintholz ist weiß bis gelblich-weiß und hebt sich deutlich vom hellgelblich-braunen bis rotbraunen Kernholz ab, das überdies noch kräftig nachdunkelt."
                            },
                            {
                                "example_id": "36754400-87d6-4e13-9647-f50b70823934",
                                "sense_id": "ed4809bf-4e5f-3d7b-9cad-10502e987fbb",
                                "text": "Bedrohte, weil bis zum Kernholz durchgenagte Baumstämme und von Biberdämmen verursachte Feldüberflutungen, das sind die häufigsten unliebsamen Folgen der Biberausbreitung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88f43c9f-a938-4569-bfd7-604fd90201a1",
                        "source_entry_id": "b40b5142-ea02-374b-a897-bb64bebeb615",
                        "source_sense_id": "ed4809bf-4e5f-3d7b-9cad-10502e987fbb",
                        "source_sense_description": "Holzwirtschaft: härteres, dunkel gefärbtes Holz im inneren Teil eines Baumstamms",
                        "target_lang_word": "heartwood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heartwood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83002ec2-14e1-3e51-a953-eafd161ad84a",
                                        "entry_id": "3543cff0-9957-30e0-a9c8-f43db6c8ec9c",
                                        "glosses": [
                                            "The wood nearer the heart of a stem or branch, different in color from the sapwood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb5a1350-d12b-4a12-9c68-8b854f8152fc",
                                                "sense_id": "83002ec2-14e1-3e51-a953-eafd161ad84a",
                                                "text": "A popular myth is that heartwood is stronger than sapwood."
                                            },
                                            {
                                                "example_id": "d3091492-9716-471e-b4ef-6f378f0f73a7",
                                                "sense_id": "83002ec2-14e1-3e51-a953-eafd161ad84a",
                                                "text": "The staves are split from the heartwood. The heartwood is composed of dead cells; it supports the tree, but no longer has any physiological purpose. The staves must follow the grain of the wood to achieve a watertight cask, so they are split rather than sawn. — L'encyclopédie du Cognac: From log to stave"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "adc5f9bc-77c2-459b-b014-449b565a58c7",
                        "source_entry_id": "b40b5142-ea02-374b-a897-bb64bebeb615",
