                    {
                        "sense_id": "cd19e7eb-9a73-39c2-a5da-2798d499cdea",
                        "entry_id": "759b013d-8cc9-380e-ab7c-ef4152ec48ce",
                        "glosses": [
                            "One of the separators between panes of glass in a composite window."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f33cc96e-2d30-4f95-8676-c2f02e92a72d",
                                "sense_id": "cd19e7eb-9a73-39c2-a5da-2798d499cdea",
                                "text": "He looked for a bell but there were just the wires hanging from a hole so he tapped on the glass of the sidelights. They gave soft and soundless in their lead muntins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
