                "senses": [
                    {
                        "sense_id": "086018ec-36f4-3ed7-aaed-a8760ea2a974",
                        "entry_id": "cefb9d3c-90c0-3a3b-94c8-e06646536b49",
                        "glosses": [
                            "zur besseren Übersicht angelegte schematisch-hierarchische Darstellung in einem Computer-Strategiespiel, die alle erforschbaren (und bereits erforschten) Technologien und ihre Abhängigkeiten untereinander anzeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1afa08ab-d642-4502-a768-ce1d7f1cfadc",
                                "sense_id": "086018ec-36f4-3ed7-aaed-a8760ea2a974",
                                "text": "„Was die Beantwortung der Frage weiter erschwert, ist der Fakt, dass sich die Völker im Spiel sehr ähnlich sind und fast ausschließlich durch ihre Boni und verschiedenen Technologiebäume unterscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
