                    }
                ],
                "senses": [
                    {
                        "sense_id": "f73d714f-bcf4-32af-b580-b8d6db8fd252",
                        "entry_id": "a996faaa-baad-35fb-9b53-361d65ee1a63",
                        "glosses": [
                            "długi, prosty, obosieczny nóż z masywną rękojeścią, służący dawniej do dobijania postrzelonej grubej zwierzyny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0abfbdd-2b5f-41a0-9e04-12593240b25d",
                                "sense_id": "f73d714f-bcf4-32af-b580-b8d6db8fd252",
                                "text": "Gdy myśliwcy przypadli na strzał chyżo, ażeby rozjuszoną bestię dobić kordelasami, leżała już brocząc krwią ziemię"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "109812a5-f1fa-3137-a5d3-c6f1b9d7ad68",
                        "entry_id": "a996faaa-baad-35fb-9b53-361d65ee1a63",
                        "glosses": [
                            "broń boczna o jednosiecznej głowni, używana od XV wieku przez piechotę, także na okrętach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "470be177-c7c9-4c2f-8902-d6f1f34bf1fb",
                                "sense_id": "109812a5-f1fa-3137-a5d3-c6f1b9d7ad68",
                                "text": "Janczarowie stanowili rodzaj gwardyi i milicyi sułtanów […]; służyli pieszo, uzbrojeni w strzelby, zwane w Polsce janczarkami, krótkie szable, kordelas i pistolet za pasem"
                            },
                            {
                                "example_id": "8e3154d0-f8ea-42c1-bcda-7ad5ede91feb",
                                "sense_id": "109812a5-f1fa-3137-a5d3-c6f1b9d7ad68",
                                "text": "Naokoło wielkiego masztu ułożono stos pik, toporów, szabli i kordelasów, oraz kilkanaście nabitych muszkietów"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
