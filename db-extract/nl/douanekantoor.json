                    {
                        "sense_id": "f2fb14d5-6eb4-3191-baac-59a666ae365b",
                        "entry_id": "d927b202-2da1-3ccc-b45f-9215ec3e160f",
                        "glosses": [
                            "werkruimte voor de ambtenaren die toezicht houden op internationaal verkeer van mensen, dieren en goederen\\nMeestal te vinden bij een lucht- of zeehaven of een grensovergang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ee66d27-6a7b-4030-b7d6-55dcad60d358",
                                "sense_id": "f2fb14d5-6eb4-3191-baac-59a666ae365b",
                                "text": "Hazeldonk-Meer is sinds het wegvallen van de Europese binnengrenzen veranderd. De douanekantoren zijn verdwenen."
                            },
                            {
                                "example_id": "c7815547-6859-45d1-b637-d869791b4954",
                                "sense_id": "f2fb14d5-6eb4-3191-baac-59a666ae365b",
                                "text": "Eind december werd in Moermansk een kustwachtbasis geopend met spiksplinternieuwe pieren, hangars en een douanekantoor."
                            },
                            {
                                "example_id": "07a5facd-850f-447f-ae14-9fed91fcdaee",
                                "sense_id": "f2fb14d5-6eb4-3191-baac-59a666ae365b",
                                "text": "Een hub (overstapluchthaven) wordt het sowieso niet. En om Lelystad aantrekkelijk te maken voor maatschappijen en passagiers moeten er vele tientallen miljoenen geïnvesteerd worden in terminals, verkeersleiding, een douanekantoor en betere bereikbaarheid."
                            },
                            {
                                "example_id": "5cc25400-7f65-4a2a-b22e-4b9a0934f31b",
                                "sense_id": "f2fb14d5-6eb4-3191-baac-59a666ae365b",
                                "text": "Ze stelt voor de coffeeshops aan de grens te zetten, bijvoorbeeld in de voormalige douanekantoortjes."
                            }
                        ]
                    }
