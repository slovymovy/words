                                    {
                                        "sense_id": "b7d23607-ace0-3216-ac73-157b36031eea",
                                        "entry_id": "ca6963c4-a97b-3151-b2ca-cd58af7d21b9",
                                        "glosses": [
                                            "A line of concrete fortifications, obstacles and weapon installations built by France in the 1930s to deter invasion by Germany."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0686a7ad-c2ee-4c5a-8c20-edf346b0ec02",
                        "source_entry_id": "68a0b233-28a3-3820-967b-f9c0c34ded98",
                        "source_sense_id": "4591057f-0426-303c-bb52-5a03b72e8a72",
                        "source_sense_description": "französische Befestigungsanlage",
                        "target_lang_word": "ligne Maginot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ligne Maginot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "453ba38c-01b8-357a-ad12-399a82235e10",
                                        "entry_id": "760b2153-1683-302e-9204-f0c485cf4c1b",
                                        "glosses": [
                                            "Ligne de fortifications construite par la France à sa frontière avec l’Italie, la Suisse, l’Allemagne, le Luxembourg et la Belgique dans les années 1930, mais qui se révéla plutôt inefficace lors de la Seconde Guerre mondiale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df382943-854e-473a-9820-20d756d62d4f",
                                                "sense_id": "453ba38c-01b8-357a-ad12-399a82235e10",
                                                "text": "La Ligne Maginot est une ligne de défense construite pendant l’entre-deux-guerres et tirant son nom du ministre de de la Guerre de l’époque, Monsieur André Maginot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1de21550-7890-3841-be12-7fb78b0e269f",
                                        "entry_id": "760b2153-1683-302e-9204-f0c485cf4c1b",
                                        "glosses": [
                                            "Défense réputée inviolable, mais inefficace."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23a8140f-6c2d-4d46-97ca-c083c0226f0e",
                                                "sense_id": "1de21550-7890-3841-be12-7fb78b0e269f",
                                                "text": "Et le coronavirus avait été arrêté aux portes des Etats-Unis par Donald Trump lorsqu’il avait décidé, le 31 janvier, d’interdire l’entrée du territoire aux ressortissants étrangers en provenance de l’épicentre de l’épidémie Covid-19, la Chine. […] Le coronavirus s’est joué de la Ligne Maginot dressée par le président et le voilà qui frappe désormais partout."
                                            },
                                            {
                                                "example_id": "4ec16a41-7737-4257-b662-5c99bfe5de1d",
                                                "sense_id": "1de21550-7890-3841-be12-7fb78b0e269f",
                                                "text": "Ce raisonnement très logique m'inspirait plus de confiance dans la victoire de l'armée française que toutes les lignes Maginot et tous les discours claironnants de nos chefs bien-aimés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
