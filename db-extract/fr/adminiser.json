                "senses": [
                    {
                        "sense_id": "a6178915-136c-3df4-b231-853815181634",
                        "entry_id": "469fdcd1-7e70-3153-aa39-13df78ddf8fd",
                        "glosses": [
                            "Donner à quelqu'un le statut d'admin, sur un site Internet."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "aee7ad73-a41b-4105-9984-503758eb42c9",
                                "sense_id": "a6178915-136c-3df4-b231-853815181634",
                                "text": "Et Oxion, si tu crois qu'on en a quelque chose à foutre de se faire adminiser, le concours c'est juste parce que c'est marrant."
                            },
                            {
                                "example_id": "ae4abd89-8622-45ca-b6d0-2215c676085e",
                                "sense_id": "a6178915-136c-3df4-b231-853815181634",
                                "text": "Si ça continue nihil va tous nous adminiser et on aura même plus besoin de publier les monceaux de conneries qui s'accumulent dans les coulisses."
                            }
                        ]
                    }
