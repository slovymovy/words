                        "glosses": [
                            "Celui qui fait ou qui applique les pétards."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6402a31-7fb6-44af-868c-fc5d20b30ad1",
                                "sense_id": "2f4b097b-344c-3b92-b394-0463d9db4ed3",
                                "text": "— J’ai oui dire aux premiers petardiers, qu’ils avoient inventé cette machine en contemplant des tapisseries."
                            },
                            {
                                "example_id": "fe64f2b4-268d-48c6-b516-ab5b9e2abbac",
                                "sense_id": "2f4b097b-344c-3b92-b394-0463d9db4ed3",
                                "text": "Un quartier de pierre rompit la planche, et envoia petardier et petard dans les fossez."
                            },
                            {
                                "example_id": "08284061-49bd-467f-ac08-47e7f9f622d5",
                                "sense_id": "2f4b097b-344c-3b92-b394-0463d9db4ed3",
                                "text": "La herse en tombant tue le pétardier qui allait faire sauter la porte, pour donner passage à l’armée."
                            }
                        ]
                    },
                    {
                        "sense_id": "b14079bf-d66e-3d92-9f0f-9ee8f68621d6",
