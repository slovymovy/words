                        "entry_id": "82c639c8-f08b-391b-b85a-9b35c65ca97f",
                        "glosses": [
                            "een afkorting van \\\"application\\\", een gebruiksklaar programma waarmee digitale apparatuur bepaalde functies kan vervullen"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "d00e3fc4-cca5-429a-a724-c26a912acc01",
                                "sense_id": "b372ac11-2377-365e-b67b-f5f62490801c",
                                "text": "Mobiele apparaten worden steeds veelzijdiger door de apps die ervoor beschikbaar komen."
                            },
                            {
                                "example_id": "0d34f589-f617-4da0-b7aa-a3294e2be837",
                                "sense_id": "b372ac11-2377-365e-b67b-f5f62490801c",
                                "text": "Vincenzo legt uit dat ik een app moet installeren op mijn telefoon."
                            },
                            {
                                "example_id": "f03612b3-18d3-4a04-8868-824a3c88855c",
                                "sense_id": "b372ac11-2377-365e-b67b-f5f62490801c",
                                "text": "Deze app was voor mij in vele opzichten een reddingslijn en ik raadpleegde hem meerdere malen per dag om te zien waar ik me bevond."
                            }
                        ]
                    },
                    {
                        "sense_id": "b68671e2-55eb-3154-8731-0afdcb9fd46c",
                        "entry_id": "82c639c8-f08b-391b-b85a-9b35c65ca97f",
                        "glosses": [
                            "een persoonlijk bericht verstuurd met de applicatie WhatsApp"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "170e9e23-6541-4e11-a3c6-8bd40cdd28a1",
                                "sense_id": "b68671e2-55eb-3154-8731-0afdcb9fd46c",
                                "text": "Ik heb nog geen app van je gekregen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4484653-34bb-48c4-a88c-1eb12c2fd83f",
                        "source_entry_id": "82c639c8-f08b-391b-b85a-9b35c65ca97f",
