                    {
                        "translation_id": "af8df461-1a1a-4c3d-a225-d942f3c708b6",
                        "source_entry_id": "fc050826-0239-32e6-bd11-94c7be66c452",
                        "source_sense_id": "ef09c86c-b964-32b5-af11-06c439474720",
                        "target_lang_word": "Henna",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Henna",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "641dca20-f0ba-3e84-b832-fd3c5f375271",
                                        "entry_id": "c4176356-f947-3699-8282-4d4be98e738b",
                                        "glosses": [
                                            "Hennastrauch, einem in Afrika und Asien wachsenden Strauch mit gelben bis ziegelroten Blüten"
                                        ],
                                        "tags": [
                                            "Kurzform für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb02072d-fc04-44d0-ab4c-a775bf2c76e3",
                                                "sense_id": "641dca20-f0ba-3e84-b832-fd3c5f375271",
                                                "text": "Henna ist ein mehrjähriger Busch, der in tropischen und heißen Klimazonen zwei bis sechs Meter hoch wachsen kann."
                                            },
                                            {
                                                "example_id": "6be89b0b-e592-4518-b029-3d066d7fd651",
                                                "sense_id": "641dca20-f0ba-3e84-b832-fd3c5f375271",
                                                "text": "Henna kommt als laubabwerfender Busch oder kleiner Baum mit steifen, breit ausladenden Zweigen vor."
                                            },
                                            {
                                                "example_id": "64ad7170-9c34-4fac-89b0-c40f394bc423",
                                                "sense_id": "641dca20-f0ba-3e84-b832-fd3c5f375271",
                                                "text": "Die Kultivierung von Henna reicht bis in die Antike zurück."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a292d67-8653-3880-bfb0-e54e96ee1b90",
                                        "entry_id": "c4176356-f947-3699-8282-4d4be98e738b",
                                        "glosses": [
                                            "rotgelbes Pulver aus zerriebenen Blättern und jungen Trieben des Hennastrauchs, das zum Färben von Haaren, Nägeln, Leder und Kleiderstoffen verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35fcf836-ff28-48e0-8d09-e5d759ddecb3",
                                                "sense_id": "7a292d67-8653-3880-bfb0-e54e96ee1b90",
                                                "text": "Das dunkle Gesicht ist sorgsam gewaschen, ein Hauch von Frische und süßen Düften strahlt davon aus; die Augenbrauen sind untermalt, die Nägel der schönen Hände mit Henna geschminkt; die perlenden Zähne zeigt das beständige Lächeln."
                                            },
                                            {
                                                "example_id": "4129a28a-f124-41d4-aa1d-b1b074cf2157",
                                                "sense_id": "7a292d67-8653-3880-bfb0-e54e96ee1b90",
                                                "text": "Es waren sieben alte Männer mit langen Barten. Sie ritten seitlings auf weißen Eseln, die mit Henna gefärbt waren und rote Schwänze und rote Ohren hatten."
                                            },
                                            {
                                                "example_id": "ba5af12a-14be-4a89-8ded-bedfccf87dee",
                                                "sense_id": "7a292d67-8653-3880-bfb0-e54e96ee1b90",
                                                "text": "Auch Henna, das etwa in der Türkei oder Marokko für Körperbemalungen genutzt wird, ist laut Jesper nicht unbedenklich: Der Farbe sei häufig Paraphenylendiamin beigemischt. Dieser Stoff kann eine massive Allergie auslösen, die der Betroffene dann ein Leben lang hat."
                                            },
                                            {
                                                "example_id": "64d5ea21-4326-4068-b7db-d7199ff4c40a",
                                                "sense_id": "7a292d67-8653-3880-bfb0-e54e96ee1b90",
                                                "text": "Nur einmal im Jahr, wenn die \"Zeit der Männer\" bevorsteht und die Frauen sich die Haare mit Henna färben, bekommt auch Aicha das Meer zu Gesicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
