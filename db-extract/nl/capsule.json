                                "example_id": "4ad8a883-950f-4b24-b195-a7dc8643b097",
                                "sense_id": "b3396fa9-7c3f-3121-8985-898961209408",
                                "text": "Terwijl zij hier in het halfdonker naar capsules zat te staren, trokken de donkere depressies langzamerhand uit haar geest weg."
                            }
                        ]
                    },
                    {
                        "sense_id": "af4357bc-f578-30df-a4c8-9cc96ab46a4d",
