    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3762c580-9928-34d2-8757-0f3771b9d6ea",
                    "sense_definition": "Niet bebouwd of onbewerkt gelaten (van landbouwgrond)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer liet het veld een jaar <w>braak</w> liggen om de grond te laten herstellen.",
                            "target_lang_translations": {
                                "en": "The farmer let the field lie <w>fallow</w> for a year to allow the soil to recover."
                            }
                        },
                        {
                            "text": "Er liggen veel stukken grond <w>braak</w> aan de rand van de stad.",
                            "target_lang_translations": {
                                "en": "There are many plots of land lying <w>fallow</w> on the outskirts of the city."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbebouwd",
                        "onontgonnen"
                    ],
                    "antonyms": [
                        "bebouwd",
                        "bewerkt"
                    ],
                    "common_phrases": [
                        "braak liggen"
                    ],
                    "target_lang_definitions": {
                        "en": "Left uncultivated or unplowed (of agricultural land)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fallow",
                                "target_lang_sense_clarification": "of land, left unseeded or uncultivated"
                            },
                            {
                                "target_lang_word": "uncultivated",
                                "target_lang_sense_clarification": "not used for growing crops"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bc9c21a3-c0ba-3d00-9071-65044a226b99",
                    "sense_definition": "Het breken of geforceerd openmaken, in het bijzonder bij een inbraak",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "criminaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er waren duidelijke sporen van <w>braak</w> te zien op de achterdeur.",
                            "target_lang_translations": {
                                "en": "There were clear signs of <w>forced entry</w> visible on the back door."
                            }
                        },
                        {
                            "text": "Zonder sporen van <w>braak</w> keert de verzekering soms niets uit.",
                            "target_lang_translations": {
                                "en": "Without signs of <w>forced entry</w>, the insurance company sometimes pays out nothing."
                            }
                        }
                    ],
                    "synonyms": [
                        "inbraak",
                        "verbreking"
                    ],
                    "common_phrases": [
                        "sporen van braak"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of breaking or forcing open, especially during a burglary"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forced entry",
                                "target_lang_sense_clarification": "illegal entry into a building using force"
                            },
                            {
                                "target_lang_word": "break-in",
                                "target_lang_sense_clarification": "an illegal forced entry into a property"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63a749dd-b275-347b-9091-8c391fdd729d",
                    "sense_definition": "Een stuk land dat niet bebouwd of bewerkt is",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen speelden vaak op de <w>braak</w> achter de fabriek.",
                            "target_lang_translations": {
                                "en": "The children often played on the <w>wasteland</w> behind the factory."
                            }
                        },
                        {
                            "text": "Deze <w>braak</w> zal volgend jaar worden volgebouwd met nieuwe woningen.",
                            "target_lang_translations": {
                                "en": "This <w>vacant lot</w> will be built over with new homes next year."
                            }
                        }
                    ],
                    "synonyms": [
                        "braakland",
                        "braakliggend terrein"
