                "senses": [
                    {
                        "sense_id": "829d82ef-cf4e-3f00-b29d-4d2d8ad27aea",
                        "entry_id": "f64d1a48-5d1c-36e8-ba4b-1a269a40eb14",
                        "glosses": [
                            "Période de la nuit qui précède de peu le lever du jour."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b9f8f3cb-1b47-440c-bd08-6f5208a4eb75",
                                "sense_id": "829d82ef-cf4e-3f00-b29d-4d2d8ad27aea",
                                "text": "Il vous faudrait au moins […] vous installer pour vraiment dormir jusqu'à l´avant-matin comme tous ces autres, […]."
                            },
                            {
                                "example_id": "17523bf8-537b-4815-9ba2-988ab80f58bb",
                                "sense_id": "829d82ef-cf4e-3f00-b29d-4d2d8ad27aea",
                                "text": "Dans l'innocence de l´avant-matin, elle se reprenait à espérer qu'elle n'aimait pas Swen."
                            },
                            {
                                "example_id": "0c356d10-3e6c-4f74-a1da-cb5370ca06bb",
                                "sense_id": "829d82ef-cf4e-3f00-b29d-4d2d8ad27aea",
                                "text": "Là, dans le petit jour flottant de l´avant-matin, comme de grandes brebis blanches sommeillant couchées sur la terre, il avait compté aussi les pierres tombales : une, deux, trois, jusqu'à vingt-neuf."
                            },
                            {
                                "example_id": "014e4144-617e-435b-9905-b2e7f2e6cbf8",
                                "sense_id": "829d82ef-cf4e-3f00-b29d-4d2d8ad27aea",
                                "text": "Entre Van der Meulen, le général d'état-major, et Salvator Rosa, le reître furieux, depuis la veille jusqu'au lendemain de la bataille, de l´avant-matin des Thermopyles au soir d'Eylau, les peintres ont tout employé et tout usé."
                            }
                        ]
                    }
