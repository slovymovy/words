                                                "sense_id": "f2624473-8e95-3043-b255-2c3257163e66",
                                                "text": "Die Krönung war die teuerste aller Zeiten."
                                            },
                                            {
                                                "example_id": "c7cc0fba-7b49-471a-afac-e25c5bed48bc",
                                                "sense_id": "f2624473-8e95-3043-b255-2c3257163e66",
                                                "text": "„Sieben Monate lang hat der König der Könige von Äthiopien seine Krönung vorbereiten lassen.“"
                                            },
                                            {
                                                "example_id": "c5a31941-21b1-4743-a3eb-fe8b2815f646",
                                                "sense_id": "f2624473-8e95-3043-b255-2c3257163e66",
                                                "text": "„Nach der Kritik lässt Wieland seine Rosamunde in die Krönung einwilligen und von Elinor erdolchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "53ea16d2-c82f-3fdc-9fc4-0f142444ed83",
