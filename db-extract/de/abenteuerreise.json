                "senses": [
                    {
                        "sense_id": "91af3a26-bd78-3cbd-8337-984929e0b826",
                        "entry_id": "6ebe1947-9316-364f-9bdb-30b2ebec459e",
                        "glosses": [
                            "wagnisreiche Unternehmung eines Menschen, der sein gewohntes räumliches und soziales Umfeld verlässt und sich in ein ihm fremdes begibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e49866ae-2584-4851-9e01-2e341b522635",
                                "sense_id": "91af3a26-bd78-3cbd-8337-984929e0b826",
                                "text": "„Abenteuerreisen sind beliebt – aber nicht, weil sie Nervenkitzel bieten.“"
                            },
                            {
                                "example_id": "b6fa45f4-264b-4d01-affe-2dc652f04648",
                                "sense_id": "91af3a26-bd78-3cbd-8337-984929e0b826",
                                "text": "„Es ist eine große Abenteuerreise, eine Odyssee, die Siri durchstehen muss.“"
                            },
                            {
                                "example_id": "2b849177-4eb4-4b96-abcd-0eac2e02e631",
                                "sense_id": "91af3a26-bd78-3cbd-8337-984929e0b826",
                                "text": "„Sie erzählen die Geschichte des Hobbits Bilbo Beutlin, der auf einer Abenteuerreise einen Ring findet, der ihn unsichtbar macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
