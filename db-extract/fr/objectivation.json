                        "sense_id": "8baa6b88-507d-3e45-bc3b-c4292fc41c8c",
                        "entry_id": "3658790b-3a0c-38d4-8d67-5e1ddeda4f09",
                        "glosses": [
                            "Action d’objectiver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "150fa8be-3530-4bd9-9092-22ae9d8811c0",
                                "sense_id": "8baa6b88-507d-3e45-bc3b-c4292fc41c8c",
                                "text": "L’esclave est l’élément actif, fécond, de tout le développement historique de l’activité productive et donc de l’objectivation du sujet dans le monde, qu’elle réalise."
                            },
                            {
                                "example_id": "52211ec8-8b95-47b5-b120-e1ce8fb96d30",
                                "sense_id": "8baa6b88-507d-3e45-bc3b-c4292fc41c8c",
                                "text": "Il y a, à Paris, un phénomène spectaculaire qui s’apparente à une objectivation spatiale de la lutte des classes. On a, d’un côté, les beaux quartiers à l’ouest et, de l’autre, les quartiers les plus populaires à l’est et au nord."
                            }
                        ]
                    }
