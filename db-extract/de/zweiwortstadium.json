                "senses": [
                    {
                        "sense_id": "47d56abb-f410-381e-96b9-7622e2c8405e",
                        "entry_id": "44e05bcc-5a85-324a-aa6c-aad40c4f5c2c",
                        "glosses": [
                            "Phase im Spracherwerb eines Kindes, in dem es in der Lage ist, Äußerungen, die aus zwei Wörtern bestehen, hervorzubringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c72d4d0c-fffb-49da-b363-5f6d685fd2b7",
                                "sense_id": "47d56abb-f410-381e-96b9-7622e2c8405e",
                                "text": "„Die Anwendbarkeit des Modells für andere Sprachen, zum Beispiel das Deutsche, ist auch auf dem Zweiwortstadium nur bedingt möglich.“"
                            },
                            {
                                "example_id": "3dffe019-7b4f-4463-a920-39a5e2856669",
                                "sense_id": "47d56abb-f410-381e-96b9-7622e2c8405e",
                                "text": "„Das Zweiwortstadium gilt deshalb nur als Protosprache, das heißt als Eingangsstufe zur grammatisch geordneten Vollsprache.“"
                            },
                            {
                                "example_id": "795fd8b2-ef1f-46cc-91e0-f15aa0db3df9",
                                "sense_id": "47d56abb-f410-381e-96b9-7622e2c8405e",
                                "text": "„Diese rasante Entwicklung der Sprache teilt die Wissenschaft heute in vier Stufen beziehungsweise Stadien ein: Das Lallstadium, das Einwortstadium, das Zweiwortstadium und das Stadium des Telegrammstils.“"
                            },
                            {
                                "example_id": "d4718536-bb0e-4b41-bc69-9cccaab5c2d9",
                                "sense_id": "47d56abb-f410-381e-96b9-7622e2c8405e",
                                "text": "„Nach etwa 18 Monaten wird das Zweiwortstadium erreicht, welches vom Stadium des Telegrammstils abgelöst wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
