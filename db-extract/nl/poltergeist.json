                "senses": [
                    {
                        "sense_id": "c15b0fbc-b330-3dff-8cc5-3fb4fcb407ea",
                        "entry_id": "a51b7ea1-e252-35a4-99c1-05208c8893fb",
                        "glosses": [
                            "een spook dat veel lawaai maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ec8dcfb-4a74-4f3a-93e3-09a70879c9de",
                                "sense_id": "c15b0fbc-b330-3dff-8cc5-3fb4fcb407ea",
                                "text": "De laatste vier maanden wordt Doris Birch, een 73-jarige grootmoeder uit de Britse plaats Herne Bay, uit haar slaap gehouden door, plat gezegd, een geile geest. Als de vrouw haar bed instapt, voelt ze onder de lakens de onzichtbare handen van de poltergeist over haar lichaam glijden."
                            },
                            {
                                "example_id": "01511a38-6ec0-41e2-b64c-71465de6e167",
                                "sense_id": "c15b0fbc-b330-3dff-8cc5-3fb4fcb407ea",
                                "text": "In 1982 vroeg Steven Spielberg aan Hooper of hij Poltergeist wilde regisseren. Deze film, over een gezin dat door geesten geterroriseerd wordt, was commercieel een nog groter succes dan The Texas Chainsaw Massacre en groeide eveneens uit tot een klassieker in het genre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "956cb6f8-6859-472a-899a-f56b51134105",
                        "source_entry_id": "a51b7ea1-e252-35a4-99c1-05208c8893fb",
                        "source_sense_id": "c15b0fbc-b330-3dff-8cc5-3fb4fcb407ea",
                        "source_sense_description": "een spook dat veel lawaai maakt",
                        "target_lang_word": "poltergeist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poltergeist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                                        "entry_id": "de9fd66a-7329-3171-b014-265d3d1c8704",
                                        "glosses": [
                                            "An unseen ghost which makes noises and causes disruption, especially by causing physical objects to move or fly about."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaf2f9a9-de95-46e1-8e99-10de3add0121",
                                                "sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                                                "text": "A poltergeist haunts the house by moving objects around, making chain-rattling noises and throwing things."
                                            },
                                            {
                                                "example_id": "95eb6569-fe22-4b2f-b0ba-83c9430ed796",
                                                "sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                                                "text": "The chapel is haunted by a demonic poltergeist."
                                            },
                                            {
                                                "example_id": "1944fb72-fc56-4420-bbdf-afa838ad11f9",
                                                "sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                                                "text": "\"Perhaps even a small poltergeist might come your way. Any trifle would be welcome.\" His bull's bellow of laughter followed them into the lift."
                                            },
                                            {
                                                "example_id": "57f40f4a-afee-43fe-b0d6-e118610aa773",
                                                "sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                                                "text": "I risk becoming nothing more than a common poltergeist wallowing in regrets and introspection and other terrible things."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
