{
    "word_family": [
        "spank"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c02dce52-68b9-3d35-8ee6-4b19456884a1",
                    "sense_definition": "A fore-and-aft gaff-rigged sail on the aft-most mast of a square-rigged vessel.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew worked quickly to adjust the <w>spanker</w> as the wind shifted direction.",
                            "target_lang_translations": {
                                "pl": "Załoga szybko pracowała, by dostosować <w>bezan</w>, gdy wiatr zmienił kierunek."
                            }
                        },
                        {
                            "text": "Beyond the broad white wing of the <w>spanker</w> sail, the horizon looked clear.",
                            "target_lang_translations": {
                                "pl": "Poza szerokim białym skrzydłem żagla <w>bezanowego</w>, horyzont wyglądał na czysty."
                            }
                        }
                    ],
                    "synonyms": [
                        "blooper",
                        "tallboy"
                    ],
                    "target_lang_definitions": {
                        "pl": "Żagiel skośny na ostatnim maszcie żaglowca."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bezan",
                                "target_lang_sense_clarification": "żagiel na ostatnim maszcie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45d21e16-69e1-3a31-a6a5-8979c99e4fe8",
                    "sense_definition": "Something splendid or a fine example of its kind.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I like the new vehicle; it is a real <w>spanker</w> with no marks on the bodywork.",
                            "target_lang_translations": {
                                "pl": "Podoba mi się ten nowy pojazd; to prawdziwe <w>cacko</w> bez żadnych śladów na karoserii."
                            }
                        },
                        {
                            "text": "He bought a <w>spanker</w> of a house that was perfectly maintained and beautifully decorated.",
                            "target_lang_translations": {
                                "pl": "Kupił <w>prawdziwe cacko</w> – dom, który był doskonale utrzymany i pięknie urządzony."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in British English to describe something excellent."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Coś wspaniałego lub doskonały przykład czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "cacko",
                                "target_lang_sense_clarification": "coś bardzo ładnego lub doskonałego"
                            },
                            {
                                "target_lang_word": "rarytas",
                                "target_lang_sense_clarification": "coś wyjątkowego"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9ab4b5a-4f8c-3321-be0d-92677343497f",
                    "sense_definition": "Something very large or larger than usual.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That fish he caught was a real <w>spanker</w> compared to the others.",
                            "target_lang_translations": {
                                "pl": "Ryba, którą złowił, była <w>prawdziwym olbrzymem</w> w porównaniu do innych."
                            }
                        },
                        {
                            "text": "The storm brought a <w>spanker</w> of a wave that crashed over the deck.",
                            "target_lang_translations": {
                                "pl": "Burza przyniosła <w>ogromną</w> falę, która rozbiła się o pokład."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to emphasize size."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Coś bardzo dużego lub większego niż zazwyczaj."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "olbrzym",
                                "target_lang_sense_clarification": "coś bardzo dużego"
                            },
                            {
                                "target_lang_word": "kawał",
                                "target_lang_sense_clarification": "coś dużego (potocznie)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81dde53b-333d-36b5-995a-2f8940d01cf4",
                    "sense_definition": "A swift horse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rider pushed his <w>spanker</w> to reach the finish line before the sun set.",
                            "target_lang_translations": {
                                "pl": "Jeździec pogonił swojego <w>szybkiego konia</w>, by dotrzeć do mety przed zachodem słońca."
                            }
                        },
                        {
                            "text": "He was known throughout the county for owning the fastest <w>spanker</w> in the stables.",
                            "target_lang_translations": {
                                "pl": "Był znany w całym hrabstwie z posiadania najszybszego <w>konia</w> w stajniach."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical usage regarding horses."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Szybki koń."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "szybki koń",
                                "target_lang_sense_clarification": "koń o dużej szybkości"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68dc91f6-e43a-3941-9fe0-7edb04b6d2a6",
                    "sense_definition": "A small coin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am glad to see you, for I am in need of a few <w>spankers</w> for the journey.",
                            "target_lang_translations": {
                                "pl": "Cieszę się, że cię widzę, bo potrzebuję kilku <w>groszy</w> na podróż."
                            }
                        },
                        {
                            "text": "He tossed a <w>spanker</w> onto the counter to pay for his morning coffee.",
                            "target_lang_translations": {
                                "pl": "Rzucił <w>monetę</w> na ladę, by zapłacić za poranną kawę."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Historical slang for money."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Dawne określenie na małą monetę lub pieniądze."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "grosz",
                                "target_lang_sense_clarification": "mała moneta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "139d03b4-9e74-3e01-a2d3-11ce1164aaff",
                    "sense_definition": "Someone who spanks.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strict teacher was known as a frequent <w>spanker</w> in the old school days.",
                            "target_lang_translations": {
                                "pl": "Surowy nauczyciel był znany w dawnych czasach szkolnych jako osoba często <w>wymierzająca klapsy</w>."
                            }
                        },
                        {
                            "text": "He was not a <w>spanker</w> and preferred to use words to discipline his children.",
                            "target_lang_translations": {
                                "pl": "Nie był osobą <w>wymierzającą klapsy</w> i wolał używać słów, by dyscyplinować swoje dzieci."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba, która wymierza klapsy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "osoba wymierzająca klapsy",
                                "target_lang_sense_clarification": "ktoś, kto karze fizycznie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37d916a5-d98a-3959-b04f-f7c6e50635b9",
                    "sense_definition": "An instrument used to give someone a spanking.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wooden paddle served as a <w>spanker</w> for the unruly students.",
                            "target_lang_translations": {
                                "pl": "Drewniana łopatka służyła jako <w>przyrząd do karania</w> nieposłusznych uczniów."
                            }
                        },
                        {
                            "text": "She hid the <w>spanker</w> away so it would not be used again.",
                            "target_lang_translations": {
                                "pl": "Schowała <w>przyrząd do karania</w>, żeby nie został ponownie użyty."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Przedmiot służący do wymierzania klapsów."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przyrząd do karania",
                                "target_lang_sense_clarification": "narzędzie do wymierzania klapsów"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ed7d6c3-451a-32bd-a054-7e28b93cf30f",
                    "sense_definition": "A musician who plays their instrument well.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jazz club was filled with every <w>spanker</w> in the city that night.",
                            "target_lang_translations": {
                                "pl": "Klub jazzowy był tamtej nocy wypełniony każdym <w>wirtuozem</w> w mieście."
                            }
                        },
                        {
                            "text": "He is a real <w>spanker</w> on the guitar and can play any song by ear.",
                            "target_lang_translations": {
                                "pl": "Jest prawdziwym <w>wirtuozem</w> gitary i potrafi zagrać każdą piosenkę ze słuchu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Musician slang."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Muzyk, który świetnie gra na swoim instrumencie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wirtuoz",
                                "target_lang_sense_clarification": "mistrz gry na instrumencie"
                            },
                            {
                                "target_lang_word": "świetny muzyk",
                                "target_lang_sense_clarification": "osoba bardzo dobrze grająca"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfbdadc1-3697-3e36-a194-ae8c98c3a394",
                    "sense_definition": "One who takes long, quick strides in walking.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is such a <w>spanker</w> that I can barely keep up with her on the sidewalk.",
                            "target_lang_translations": {
                                "pl": "Ona jest tak <w>szybkim piechurem</w>, że ledwo mogę za nią nadążyć na chodniku."
                            }
                        },
                        {
                            "text": "The tall man was a <w>spanker</w> who crossed the park in just a few minutes.",
                            "target_lang_translations": {
                                "pl": "Ten wysoki mężczyzna był <w>szybkim piechurem</w>, który przeszedł przez park w zaledwie kilka minut."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba, która chodzi długimi, szybkimi krokami."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "szybki piechur",
                                "target_lang_sense_clarification": "osoba szybko chodząca"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}