                "senses": [
                    {
                        "sense_id": "63f02d29-8469-3ff4-939a-1bbc38328bad",
                        "entry_id": "516a25f6-8700-3a3d-831f-4c545b52a3aa",
                        "glosses": [
                            "Verteilung von Speisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d17ff295-09bd-4af1-b300-b18d7e5257c0",
                                "sense_id": "63f02d29-8469-3ff4-939a-1bbc38328bad",
                                "text": "„Die Essensausgabe sei oft zu einem Kampf ausgeartet. Auch ihre Schwester sei manchmal mit einem leeren Napf in der Baracke angekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4c5f16a9-0ee4-3cb0-b1f8-c2cd049d4233",
                        "entry_id": "516a25f6-8700-3a3d-831f-4c545b52a3aa",
                        "glosses": [
                            "Stelle, an der Speisen verteilt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7751fc1b-136a-43ac-962b-f75e00b37d20",
                                "sense_id": "4c5f16a9-0ee4-3cb0-b1f8-c2cd049d4233",
                                "text": "„Lange Schlangen warteten an der Essensausgabe.“"
                            },
                            {
                                "example_id": "be34dc65-1ded-4cfc-9aa8-b7966f4d40ce",
                                "sense_id": "4c5f16a9-0ee4-3cb0-b1f8-c2cd049d4233",
                                "text": "„Vor zehn Jahren habe Cannes eine Kleiderkammer und eine Essensausgabe eröffnet, seitdem kämen jeden Tag zwischen 100 und 300 Menschen in den Hinterhof mit den Plastikstühlen und dem lauwarmen Kaffee.“"
                            },
                            {
                                "example_id": "e127ebff-9f0a-4bbd-98d3-7865d90c92b5",
                                "sense_id": "4c5f16a9-0ee4-3cb0-b1f8-c2cd049d4233",
                                "text": "„Papa ist dann aufgestanden und mit seinem Erbseneintopf zur Essensausgabe gegangen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
