            {
                "entry_id": "21be4fcc-38d9-381b-aa55-cf1d9893ef38",
                "word": "Carney",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6b53f29f-9aac-3693-896a-9ce17817dab7",
                        "entry_id": "21be4fcc-38d9-381b-aa55-cf1d9893ef38",
                        "glosses": [
                            "A rare disorder characterized by increased risk of tumors, dark blotches on the skin, and endocrine overactivity."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "14c801e9-03d3-4bb2-b0bd-c4fa35ba391d",
                                "sense_id": "6b53f29f-9aac-3693-896a-9ce17817dab7",
                                "text": "In male patients at risk for Carney complex testicular ultrasonography for the early detection of LCCSCT and associated testicular pathology is recommended."
                            },
                            {
                                "example_id": "b77f554f-5c26-4833-aa68-4ef135296301",
                                "sense_id": "6b53f29f-9aac-3693-896a-9ce17817dab7",
                                "text": "The patient's mother has Carney syndrome, with lentigines, cardiac myxoma, fibroadenoma of the breast, and a fibroepithelial polyp of the external auditory canal."
                            },
                            {
                                "example_id": "e435b9d1-171e-48f6-8a89-48247e8cbd3b",
                                "sense_id": "6b53f29f-9aac-3693-896a-9ce17817dab7",
                                "text": "Other diagnoses associated with catecholamine-secreting tumors that do not appear to be inherited are the Carney triad (gastric leiomyosarcoma, pulmonary chondroma, and extraadrenal catecholamine-secreting tumors), cholelithiasis, and renal artery stenosis."
                            }
                        ]
                    }
