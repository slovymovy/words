                    "frequency": "Middle",
                    "semantic_group_id": "douleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ressentait une douleur <w>lancinante</w> dans l'épaule depuis sa chute de vélo."
                        },
                        {
                            "text": "Ce mal de dents <w>lancinant</w> l'a empêché de dormir pendant toute la nuit."
                        }
                    ],
                    "synonyms": [
                        "aigu",
                        "pulsatile",
                        "pénétrant"
                    ],
                    "antonyms": [
