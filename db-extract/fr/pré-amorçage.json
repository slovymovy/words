                                    {
                                        "sense_id": "503774d8-6c85-399b-8837-cf86decaf647",
                                        "entry_id": "74d8b155-2c86-3791-995d-3e24a6fffada",
                                        "glosses": [
                                            "a way to set answers to questions asked during the installation process, without having to manually enter the answers while the installation is running."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70cb2784-e955-49a4-a9c9-d4e605db36d2",
                                                "sense_id": "503774d8-6c85-399b-8837-cf86decaf647",
                                                "text": "2004, Joey Hess, \"d-i preseed file version 0.1\", reprinted in Frank Ronneburg, 2005, Debian GNU/ Linux Anwenderhandbuch,\nSome parts of the installation process cannot be automated using some forms of preseeding, because the questions are asked before the preseed file is loaded."
                                            },
                                            {
                                                "example_id": "1f5f7f97-dc75-4ab9-b449-d9ebc04b533c",
                                                "sense_id": "503774d8-6c85-399b-8837-cf86decaf647",
                                                "text": "In addition to the preseed option, the boot command will then be longer than 100 characters, which defeats the purpose of preseeding -- a manual installation of Debian requires only twelve keystrokes before you are prompted for the root password."
                                            },
                                            {
                                                "example_id": "ea30ec33-f6de-4be8-b897-e66ef2e6175a",
                                                "sense_id": "503774d8-6c85-399b-8837-cf86decaf647",
                                                "text": "This first command is run as early as possible, just after preseeding is read."
                                            },
                                            {
                                                "example_id": "439a14a1-005d-473b-b89a-1e188cff8dda",
                                                "sense_id": "503774d8-6c85-399b-8837-cf86decaf647",
                                                "text": "I'm using preseeding over network(PXE)."
                                            }
                                        ]
