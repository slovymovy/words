                        "glosses": [
                            "eine sehr erfolgreiche Entwicklung/Unternehmung oder dergleichen und/oder der Bericht darüber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "211395be-0e7e-4caf-872b-e62f778071e7",
                                "sense_id": "3c63e5b6-41d5-3290-94e6-b90c7c24b344",
                                "text": "„Viele meinen, die Erfolgsgeschichte dieses Slogans sei groß.“"
                            },
                            {
                                "example_id": "d2d7c68c-139f-4344-bcf5-098a840a571f",
                                "sense_id": "3c63e5b6-41d5-3290-94e6-b90c7c24b344",
                                "text": "„Die Erfolgsgeschichte unserer Buchhandlung ist plötzlich schwer angekratzt, wir sind so erschöpft, dass wir am liebsten alles hinwerfen würden.“"
                            }
                        ],
