                        ],
                        "examples": [
                            {
                                "example_id": "bacb4485-9f36-47ed-b57f-1217cb542d77",
                                "sense_id": "09c286e4-ea93-3bdc-ac14-ec0f072adbc5",
                                "text": "Cette conduite semble devoir être réservée aux sols très riches dont on veut obtenir des flots de vin destinés à la chaudière avec des folles, des noha, ou autres cépages analogues."
                            },
                            {
                                "example_id": "befc85e2-69b5-4c19-a06c-fceee96f208b",
                                "sense_id": "09c286e4-ea93-3bdc-ac14-ec0f072adbc5",
                                "text": "J’ai obtenu un noha parfait, entièrement exempt de goût foncé, et dont le bouquet rappelle réellement le Chablis : plus clair et moins jaune que d’habitude."
                            },
                            {
                                "example_id": "67fcadc9-0494-45d1-9072-ff7379736cda",
                                "sense_id": "09c286e4-ea93-3bdc-ac14-ec0f072adbc5",
                                "text": "Le noha on l’interdit à présent, on fait arracher les vignes. C’était un vin trop brutal qui contenait de l’éther paraît-il. Il attaquait le cerveau. Mais il avait bon goût !"
                            }
                        ]
                    }
