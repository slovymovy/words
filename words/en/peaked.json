                        },
                        {
                            "text": "Traffic on the highway <w>peaked</w> around five o'clock in the afternoon.",
                            "target_lang_translations": {
                                "tr": "Otoyoldaki trafik öğleden sonra saat beş civarında <w>doruğa ulaştı</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
