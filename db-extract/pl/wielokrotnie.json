                        "translation_id": "6bd3012a-e126-4c64-b901-58b40610575b",
                        "source_entry_id": "3b0c12ec-7ab1-335e-b9fe-39b9695c8581",
                        "source_sense_id": "863ebd5c-3a38-341f-9169-6ee6f5b8a357",
                        "target_lang_word": "многократно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "многократно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "15867a4d-6d34-3dc2-bc9a-ce9fe4c9bc02",
                                        "entry_id": "008815a2-007d-3d16-b19e-5a94f7f27732",
                                        "glosses": [
                                            "повторяясь или повторяя что-либо много раз"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e469ce7d-0b90-4189-988e-1923b3a9c14a",
                                                "sense_id": "15867a4d-6d34-3dc2-bc9a-ce9fe4c9bc02",
                                                "text": "Отче Леонид! я знаю тебя давно, многократно слыхал от тебя речи, вовсе противные тому, что нам говоришь теперь."
                                            },
                                            {
                                                "example_id": "f44fd4be-20b9-4a21-8eac-a159af87680a",
                                                "sense_id": "15867a4d-6d34-3dc2-bc9a-ce9fe4c9bc02",
                                                "text": "А уж Дарья Францевна, женщина злонамеренная и полиции многократно известная, раза три через хозяйку наведывалась."
                                            },
                                            {
                                                "example_id": "f71ecf29-9316-4e23-89e6-d69b2bcec377",
                                                "sense_id": "15867a4d-6d34-3dc2-bc9a-ce9fe4c9bc02",
                                                "text": "Нет того русского человека, который многократно не отсчитал бы эти «пять минут», сидя в приемной, в ожидании нужного человека."
                                            },
                                            {
                                                "example_id": "7abf760a-dbec-4d1c-93fe-71e8ed071a9d",
                                                "sense_id": "15867a4d-6d34-3dc2-bc9a-ce9fe4c9bc02",
                                                "text": "Горбатый уродец визгливо хихикал, многократно повторял какое-то странное слово…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28d3e5e4-bcf8-35cd-abd8-c0438cce96b7",
                                        "entry_id": "008815a2-007d-3d16-b19e-5a94f7f27732",
                                        "glosses": [
                                            "увеличиваясь или увеличивая что-либо во много раз"
                                        ],
