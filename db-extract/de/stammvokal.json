                ],
                "senses": [
                    {
                        "sense_id": "dfb92e6a-8e8a-3f45-9e90-1b32840428d4",
                        "entry_id": "59892f06-9205-313b-9fe5-c8a5a2d94bfe",
                        "glosses": [
                            "Vokal des Wortstamms"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7a3f4e9-2258-4e20-b9b4-141866bf1236",
                                "sense_id": "dfb92e6a-8e8a-3f45-9e90-1b32840428d4",
                                "text": "Der Stammvokal ändert sich bei starken Verben je nach Ablautreihe in unterschiedlicher Weise: z.B. leiden - litt - gelitten; sehen - sah - gesehen."
                            },
                            {
                                "example_id": "edb6dc00-700c-4765-8ce5-f5f3a2805b1a",
                                "sense_id": "dfb92e6a-8e8a-3f45-9e90-1b32840428d4",
                                "text": "„Regelmäßige Verben ändern im Präteritum und im Partizip II ihren Stammvokal nicht, unregelmäßige Verben ändern ihn in gesetzmäßiger Weise in den drei Stammformen (Infinitiv - Präteritum - Partizip II) (Ablaut):…“"
                            },
                            {
                                "example_id": "22584253-0ffe-4602-99d9-73240d4fab09",
                                "sense_id": "dfb92e6a-8e8a-3f45-9e90-1b32840428d4",
                                "text": "„Der Umlaut des Stammvokals im Konjunktiv II ist in Klammern hinter der Präteritumform angegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d17fefa4-ceef-3af2-b98b-795023037114",
                        "entry_id": "59892f06-9205-313b-9fe5-c8a5a2d94bfe",
                        "glosses": [
                            "ein der Wortwurzel angefügter Kennlaut einer Deklinationsklasse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "213d91d4-1117-40b6-a040-40216deb2558",
                                "sense_id": "d17fefa4-ceef-3af2-b98b-795023037114",
                                "text": "Das althochdeutsche Wort \"tag\" (= der \"Tag\") gehört zur a-Deklination, da sein Stammvokal (= Kennlaut) im Germanischen ein [a] war, das im Althochdeutschen noch in der Endung von Nominativ und Akkusativ Plural in der Form \"taga\" (= die Tage) erhalten ist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
