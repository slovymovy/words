        "fr-extract.jsonl": [
            {
                "entry_id": "5ef46c18-b69e-33a4-9cff-dd0023cf0836",
                "word": "terroir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "68b028a9-eae5-4f2b-b3f4-df93f4d58b48",
                        "entry_id": "5ef46c18-b69e-33a4-9cff-dd0023cf0836",
                        "tags": [
                            "plural"
                        ],
                        "form": "terroirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ccd4ec56-63a7-3580-8390-fe55116d01d9",
                        "entry_id": "5ef46c18-b69e-33a4-9cff-dd0023cf0836",
                        "glosses": [
                            "Terre considérée par rapport à la culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2edddf7a-ca8a-469e-a9ef-ce5eb6f2ad1e",
                                "sense_id": "ccd4ec56-63a7-3580-8390-fe55116d01d9",
                                "text": "On cueillait depuis une quinzaine de jours, au long des routes vicinales, aux orées des « longs champs », autour des villages, sur des lieues et des lieues de terroir, par toutes les vallées."
                            },
                            {
                                "example_id": "4a16c748-3f70-4f25-86fb-eda8bd8f4742",
                                "sense_id": "ccd4ec56-63a7-3580-8390-fe55116d01d9",
                                "text": "« C’est un produit reconnu mondialement donc la demande est plus importante. C’est un véritable produit du terroir ou plutôt merroir », conclut le responsable."
                            },
                            {
                                "example_id": "21f5babb-f174-4516-b3ac-9c99474f07bf",
                                "sense_id": "ccd4ec56-63a7-3580-8390-fe55116d01d9",
                                "text": "Terroir de clos honorés jusque sur les tables royales, l’Orléanais se vantait de posséder sa propre « façon de barillerie » qu'on pouvait reconnaître de Jargeau à Beaugency."
                            },
                            {
                                "example_id": "27775794-e466-45d2-a7da-bdfdabc0d93b",
                                "sense_id": "ccd4ec56-63a7-3580-8390-fe55116d01d9",
                                "text": "Elle parle du métier de vigneron et de son petit vignoble situé en grande partie sur Villenauxe, planté de chardonnay, de pinot noir sur le terroir de Bethon et de pinot meunier sur Dormans."
                            }
                        ]
                    },
                    {
                        "sense_id": "f038f7fc-ef79-33cc-8e03-08ba8584d04d",
                        "entry_id": "5ef46c18-b69e-33a4-9cff-dd0023cf0836",
                        "glosses": [
                            "Pays d’origine, du pays où l’on a vécu, où l’on vit."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a8deb1cf-e95f-4ee9-9021-36c100f72350",
                                "sense_id": "f038f7fc-ef79-33cc-8e03-08ba8584d04d",
                                "text": "Il a l’accent de son terroir, un accent de terroir."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cc3f958-ca36-3864-921a-15ebbdc3dea7",
                        "entry_id": "5ef46c18-b69e-33a4-9cff-dd0023cf0836",
                        "glosses": [
                            "Territoire communal."
                        ],
                        "tags": [
                            "Rural"
                        ],
                        "examples": [
                            {
                                "example_id": "7223ff1c-a826-475b-a5fd-198f3a5d4c66",
                                "sense_id": "5cc3f958-ca36-3864-921a-15ebbdc3dea7",
                                "text": "En comparant ce tableau avec celui fourni par le cadastre de 1810 que nous donnons ci-dessous, on est frappé des immenses changements survenus dans l'état de la culture du terroir de Laon depuis moins d'un demi-siècle."
                            },
                            {
                                "example_id": "2ef8840c-e944-4c27-91b2-dbde8766b11c",
                                "sense_id": "5cc3f958-ca36-3864-921a-15ebbdc3dea7",
                                "text": "La Société, après avoir donné un souvenir à ces antiques paroisses, a visité l'église d’Hartennes. Cet édifice, bâti en grande partie en grès qui abondent sur ce terroir, aurait un aspect assez triste, s'il ne rachetait ce défaut par un portail de la Renaissance, en pierres de taille, décoré d'une assez jolie rosace et portant des écussons et des salamandres fantastiques."
                            },
                            {
                                "example_id": "66e988ec-423e-4d59-916b-8b6507fd954c",
                                "sense_id": "5cc3f958-ca36-3864-921a-15ebbdc3dea7",
                                "text": "Elle a consisté en un relevé cadastral complet du terroir villageois : voie ferrée, piste principale, sentiers, maisons, plantations de cacaoyers, champs vivriers des deux saisons de cultures, limites entre Mom et les villages voisins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7262ad40-869d-4f8e-9649-4e5ebba652e9",
                        "source_entry_id": "5ef46c18-b69e-33a4-9cff-dd0023cf0836",
                        "target_lang_word": "terroir",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terroir",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ef116653-6d79-3aca-aba6-12034eadd243",
                                        "entry_id": "b1d29d20-d9d1-35f1-8ea2-0c3c955915c9",
                                        "glosses": [
                                            "grond of bodem en/of specifieke kenmerken daarvan in relatie tot de hierop geteelde gewassen. m.n. gebruikt in de wijnbouw"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b64af00-e9d0-4b32-9a86-a59feae9f7ff",
                                                "sense_id": "ef116653-6d79-3aca-aba6-12034eadd243",
                                                "text": "Natuurlijk is alleen een goed terroir niet zaligmakend, maar samen met de kwaliteiten van de wijnboer en wijnmaker ligt het ten grondslag aan een goede wijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
