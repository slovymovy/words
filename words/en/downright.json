{
    "word_family": [
        "down",
        "right"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7efcb348-d2c8-3356-a800-1169da98f8c3",
                    "sense_definition": "Describing a person or their behavior as direct, plain, and straightforward, or speech that is blunt and unambiguous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "directness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>downright</w> fellow who always says exactly what he thinks.",
                            "target_lang_translations": {
                                "es": "Es un tipo <w>franco</w> que siempre dice exactamente lo que piensa."
                            }
                        },
                        {
                            "text": "She gave a <w>downright</w> answer to the difficult question during the interview.",
                            "target_lang_translations": {
                                "es": "Dio una respuesta <w>tajante</w> a la difícil pregunta durante la entrevista."
                            }
                        }
                    ],
                    "synonyms": [
                        "blunt",
                        "straightforward",
                        "plain"
                    ],
                    "common_phrases": [
                        "downright answer",
                        "downright fellow"
                    ],
                    "target_lang_definitions": {
                        "es": "Que describe a una persona o su comportamiento como directo, claro y sincero, o que describe palabras tajantes e inequívocas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "franco",
                                "target_lang_sense_clarification": "dicho de una persona o respuesta que es sincera y directa"
                            },
                            {
                                "target_lang_word": "directo",
                                "target_lang_sense_clarification": "sin rodeos ni ambigüedades"
                            },
                            {
                                "target_lang_word": "tajante",
                                "target_lang_sense_clarification": "rotundo y sin dar lugar a discusión"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8df64bda-d707-3262-9089-273c44816fa7",
                    "sense_definition": "Used to emphasize that something is absolute or complete, often in a negative context.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>downright</w> lie that he told to cover his mistake.",
                            "target_lang_translations": {
                                "es": "Fue una mentira <w>rotunda</w> que dijo para encubrir su error."
                            }
                        },
                        {
                            "text": "What he said about his colleagues was a <w>downright</w> insult.",
                            "target_lang_translations": {
                                "es": "Lo que dijo sobre sus colegas fue un <w>auténtico</w> insulto."
                            }
                        }
                    ],
                    "synonyms": [
                        "absolute",
                        "complete",
                        "utter"
                    ],
                    "common_phrases": [
                        "downright lie",
                        "downright terrible"
                    ],
                    "target_lang_definitions": {
                        "es": "Utilizado para enfatizar que algo es absoluto, rotundo o total, a menudo en un contexto negativo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "rotundo",
                                "target_lang_sense_clarification": "absoluto y categórico"
                            },
                            {
                                "target_lang_word": "absoluto",
                                "target_lang_sense_clarification": "total y completo"
                            },
                            {
                                "target_lang_word": "auténtico",
                                "target_lang_sense_clarification": "usado como intensificador para subrayar una cualidad negativa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67e6080e-9ca9-3984-9770-28b377fd7cba",
                    "sense_definition": "Directed vertically downward.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The climber faced a <w>downright</w> drop of fifty feet.",
                            "target_lang_translations": {
                                "es": "El escalador se enfrentó a una caída <w>en picado</w> de quince metros."
                            }
                        },
                        {
                            "text": "He delivered a <w>downright</w> blow to the target with his hammer.",
                            "target_lang_translations": {
                                "es": "Asestó un golpe <w>vertical</w> al blanco con su martillo."
                            }
                        }
                    ],
                    "synonyms": [
                        "vertical",
                        "perpendicular"
                    ],
                    "antonyms": [
                        "horizontal"
                    ],
                    "common_phrases": [
                        "downright blow",
                        "downright drop"
                    ],
                    "target_lang_definitions": {
                        "es": "Dirigido verticalmente hacia abajo; perpendicular."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vertical",
                                "target_lang_sense_clarification": "en dirección de arriba abajo"
                            },
                            {
                                "target_lang_word": "en picado",
                                "target_lang_sense_clarification": "que cae verticalmente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "59a12699-0e48-36a1-b9a7-ab6ab5ed9ab8",
                    "sense_definition": "Completely or wholly, used as an intensifier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>downright</w> rude to the guests at the party.",
                            "target_lang_translations": {
                                "es": "Fue <w>totalmente</w> grosero con los invitados en la fiesta."
                            }
                        },
                        {
                            "text": "The situation became <w>downright</w> dangerous as the storm intensified.",
                            "target_lang_translations": {
                                "es": "La situación se volvió <w>francamente</w> peligrosa a medida que la tormenta se intensificaba."
                            }
                        }
                    ],
                    "synonyms": [
                        "completely",
                        "utterly",
                        "thoroughly"
                    ],
                    "common_phrases": [
                        "downright rude",
                        "downright dangerous"
                    ],
                    "target_lang_definitions": {
                        "es": "Completamente o del todo; usado como intensificador."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "totalmente",
                                "target_lang_sense_clarification": "por completo"
                            },
                            {
                                "target_lang_word": "absolutamente",
                                "target_lang_sense_clarification": "de forma absoluta"
                            },
                            {
                                "target_lang_word": "francamente",
                                "target_lang_sense_clarification": "para enfatizar una cualidad evidente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "892d212f-854c-3277-a35a-a4a74c5593a9",
                    "sense_definition": "In a direct, clear, and unambiguous manner.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "directness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He told her <w>downright</w> that he could not attend the meeting.",
                            "target_lang_translations": {
                                "es": "Le dijo <w>directamente</w> que no podía asistir a la reunión."
                            }
                        },
                        {
                            "text": "She refused the offer <w>downright</w> without any hesitation.",
                            "target_lang_translations": {
                                "es": "Rechazó la oferta <w>tajantemente</w> sin dudarlo."
                            }
                        }
                    ],
                    "synonyms": [
                        "bluntly",
                        "plainly"
                    ],
                    "common_phrases": [
                        "refused downright"
                    ],
                    "target_lang_definitions": {
                        "es": "De manera directa, tajante y sin ambigüedades."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "tajantemente",
                                "target_lang_sense_clarification": "de forma tajante y contundente"
                            },
                            {
                                "target_lang_word": "rotundamente",
                                "target_lang_sense_clarification": "de modo concluyente y sin dudas"
                            },
                            {
                                "target_lang_word": "directamente",
                                "target_lang_sense_clarification": "sin rodeos ni disimulos"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f1a6b4b-7c01-37f2-8653-979b80ea750e",
                    "sense_definition": "A specific low grade of wool taken from the lower parts of a fleece.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textiles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant sorted the fleece to separate the <w>downrights</w> from the finer wool.",
                            "target_lang_translations": {
                                "es": "El comerciante clasificó el vellón para separar la <w>lana basta</w> de la más fina."
                            }
                        },
                        {
                            "text": "High-quality cloth is rarely made using <w>downrights</w> due to their coarse texture.",
                            "target_lang_translations": {
                                "es": "Rara vez se fabrica tela de alta calidad con <w>lana basta</w> debido a su textura áspera."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in historical textile trade contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Grado bajo o basto de lana procedente de las partes inferiores del vellón."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "lana basta",
                                "target_lang_sense_clarification": "lana gruesa de baja calidad de la parte inferior del vellón"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}