                "senses": [
                    {
                        "sense_id": "0fe3365f-bb00-3d60-afc1-2c5117cd502b",
                        "entry_id": "8f6711cf-ca6c-3df9-89a7-c3b035a686bb",
                        "glosses": [
                            "Synonym of bibliomaniac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "323add28-64ce-4369-bc1b-7498ee0cd5ea",
                                "sense_id": "0fe3365f-bb00-3d60-afc1-2c5117cd502b",
                                "text": "A very significant fact is that the Greek and Latin classics in the choicest editions, unless indeed they have the good luck to be in Derome or Trautz-Bauzonnet bindings, are not looked at by the bibliomanes of the period."
                            },
                            {
                                "example_id": "c9dce72d-5c53-4732-b7f2-cc4f9c50dc80",
                                "sense_id": "0fe3365f-bb00-3d60-afc1-2c5117cd502b",
                                "text": "To the bibliomanes of my generation, it comes as a shock to learn how much of a book can be punched onto a tape and clicked off by a computer."
                            },
                            {
                                "example_id": "b7a43d0d-31b6-462c-b64c-25337fd6569a",
                                "sense_id": "0fe3365f-bb00-3d60-afc1-2c5117cd502b",
                                "text": "(A companion piece by Brenda Scragg on the bibliomane William Ford is, alas, but a shadow of the rewarding study of this collector-turned-dealer which Anthony Lister published in the book collector in 1989.)"
                            },
                            {
                                "example_id": "10d97256-af62-4a1e-8860-4e95e5c7c15a",
                                "sense_id": "0fe3365f-bb00-3d60-afc1-2c5117cd502b",
                                "text": "The ever-present danger was that the cultivated amateur would overstep the bounds of civilized interest into the domain of obsession; the line between the bibliophile and the bibliomane was never quite as firmly drawn as Nodier would have liked: “There is only a single attack of nerves separating the bibliophile from the bibliomaniac” (Du bibliophile au bibliomane, il n’y a qu’une crise”; 102)."
                            }
                        ]
                    }
