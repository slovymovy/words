                "senses": [
                    {
                        "sense_id": "bca4502f-fc33-3b71-bb3a-caecbe7fe11c",
                        "entry_id": "e50215a5-4920-3dad-903b-fe605263775c",
                        "glosses": [
                            "Sicherstellung, dass jemand oder etwas gesund bleibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6da307d6-3d56-4553-bd2b-9d138fb3ccea",
                                "sense_id": "bca4502f-fc33-3b71-bb3a-caecbe7fe11c",
                                "text": "„Wie wichtig die Gesunderhaltung der Klauen von Rindern ist, darüber informierte ein Vortrag bei der Jungbauernschaft in Schwabniederhofen.“"
                            },
                            {
                                "example_id": "70bd483a-9b82-409a-8651-aee9c3c88830",
                                "sense_id": "bca4502f-fc33-3b71-bb3a-caecbe7fe11c",
                                "text": "„Schon der Grieche Hippokrates, der antike Urvater aller Heilberufler, wusste um die Bedeutung der bewussten Auswahl von Lebensmitteln für das Wohlbefinden und die Gesunderhaltung des Körpers: ‚Eure Nahrungsmittel sollen eure Heilmittel sein, und eure Heilmittel sollen eure Nahrungsmittel sein.‘“"
                            },
                            {
                                "example_id": "948c8027-e53b-446f-8bfd-0f6ca633ac97",
                                "sense_id": "bca4502f-fc33-3b71-bb3a-caecbe7fe11c",
                                "text": "„Die Vereine leisten einen entscheidenden Beitrag zur sozialen Verantwortung, zur Gesunderhaltung, zum ehrenamtlichen Engagement und zum Erlernen der Schwimmfähigkeit als lebensrettender Maßnahme.“"
                            },
                            {
                                "example_id": "caf9ea05-2e8d-4142-991d-1cc99c5a0312",
                                "sense_id": "bca4502f-fc33-3b71-bb3a-caecbe7fe11c",
                                "text": "„Gesundheitsministerin Schmidt würde das Thema Ernährung gerne zum Unterrichtsfach machen. Ernährung und Gesunderhaltung müssten in einer älter werdenden Gesellschaft unbedingt in den Schulen gelehrt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
