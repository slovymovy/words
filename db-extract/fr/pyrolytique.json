                "senses": [
                    {
                        "sense_id": "8957da48-d315-3d8b-bd1d-11f763c9ae23",
                        "entry_id": "4c98a052-cfa1-3707-b741-9c0487da075c",
                        "glosses": [
                            "Lié à la pyrolyse (par exemple obtenu par pyrolyse)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83ffa6ae-a400-4072-aeb2-932197fdd717",
                                "sense_id": "8957da48-d315-3d8b-bd1d-11f763c9ae23",
                                "text": "On étudiera entre autres les pyrolyseurs électriques, les seuils de rentabilité du fermage de la forêt, l’implantation de centres régionaux d’acheminement des déchets, le traitement, le stokage et le transport des gaz pyrolytiques."
                            },
                            {
                                "example_id": "c4c1f7a5-e69d-4d91-8d73-9f8069a4632a",
                                "sense_id": "8957da48-d315-3d8b-bd1d-11f763c9ae23",
                                "text": "Analyse d’huiles pyrolytiques produites à partir de résidus forestiers (écorces) et de cultures agricoles (résidus de houblon et tourteaux de chanvre)."
                            },
                            {
                                "example_id": "bacaefa2-ec3f-4594-8f19-3adc0ff3e28e",
                                "sense_id": "8957da48-d315-3d8b-bd1d-11f763c9ae23",
                                "text": "Pour une utilisation rentable des liquides pyrolytiques, la question est de savoir s’ils peuvent être utilisés dans d'autres applications."
                            }
                        ]
                    }
                ],
