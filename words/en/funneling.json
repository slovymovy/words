{
    "word_family": [
        "funnel"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "320f22c7-292f-3c64-b83f-0ff13f78ce03",
                    "sense_definition": "The process of passing something through a funnel.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>funneling</w> of the liquid into the narrow bottle was done carefully.",
                            "target_lang_translations": {
                                "ru": "Аккуратное <w>переливание</w> жидкости в узкую бутылку было выполнено осторожно."
                            }
                        },
                        {
                            "text": "Proper <w>funneling</w> prevents spills when transferring chemicals.",
                            "target_lang_translations": {
                                "ru": "Правильное <w>использование воронки</w> предотвращает проливание при переливании химикатов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс переливания или перемещения чего-либо через воронку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переливание",
                                "target_lang_sense_clarification": "процесс перемещения жидкости через воронку"
                            },
                            {
                                "target_lang_word": "наполнение через воронку",
                                "target_lang_sense_clarification": "процесс заполнения емкости с использованием воронки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c9746bb7-f793-346d-971b-c8daa68c14be",
                    "sense_definition": "Present participle and gerund of <w>funnel</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind was <w>funneling</w> through the narrow alleyway between the buildings.",
                            "target_lang_translations": {
                                "ru": "Ветер <w>прорывался потоком</w> через узкий переулок между зданиями."
                            }
                        },
                        {
                            "text": "They are <w>funneling</w> money into the project to ensure its success.",
                            "target_lang_translations": {
                                "ru": "Они <w>направляют</w> деньги в этот проект, чтобы обеспечить его успех."
                            }
                        }
                    ],
                    "synonyms": [
                        "channeling",
                        "directing"
                    ],
                    "common_phrases": [
                        "funneling money",
                        "funneling resources"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направленное движение потока (воздуха, воды) или целенаправленное перемещение ресурсов, денег или информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направлять",
                                "target_lang_sense_clarification": "целенаправленно перемещать ресурсы или деньги"
                            },
                            {
                                "target_lang_word": "проходить потоком",
                                "target_lang_sense_clarification": "о движении воздуха или воды через узкое пространство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}