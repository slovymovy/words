                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "material_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please put all the signed contracts in a large <w>manila</w> envelope.",
