    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f56c30a-1797-317a-bf16-d9cb7f4c024b",
                    "sense_definition": "Déterminer avec précision l'emplacement de quelqu'un ou de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce au signal du téléphone, les secours ont pu rapidement <w>localiser</w> les randonneurs perdus."
                        },
                        {
                            "text": "Il est parfois difficile de <w>localiser</w> ce petit village sur une carte routière."
                        }
                    ],
                    "synonyms": [
                        "repérer",
                        "situer",
                        "trouver"
                    ],
                    "common_phrases": [
                        "localiser sur une carte",
                        "localiser un téléphone",
                        "localiser la panne"
                    ]
                },
                {
                    "sense_id": "0e4b9a4d-70ff-306c-8a24-78ec64814abf",
                    "sense_definition": "Limiter la propagation ou l'extension d'un phénomène dangereux à un espace restreint.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pompiers ont lutté toute la nuit pour <w>localiser</w> l'incendie avant qu'il n'atteigne le village."
                        },
                        {
                            "text": "Le médecin tente de <w>localiser</w> l'infection afin d'éviter qu'elle ne se propage à d'autres organes."
                        }
                    ],
                    "synonyms": [
                        "circonscrire",
                        "endiguer",
                        "limiter"
                    ],
                    "antonyms": [
                        "propager",
                        "diffuser"
                    ],
                    "common_phrases": [
                        "localiser un incendie",
                        "localiser une épidémie",
                        "localiser le mal"
                    ]
                },
                {
                    "sense_id": "e55d8561-b406-3889-a75f-95932602d9de",
                    "sense_definition": "Adapter un produit, un contenu ou un logiciel aux spécificités linguistiques et culturelles d'un marché régional.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise doit <w>localiser</w> son site web pour toucher plus efficacement la clientèle étrangère."
                        },
                        {
                            "text": "Le studio a mis six mois à traduire et <w>localiser</w> ce jeu vidéo pour le marché japonais."
                        }
                    ],
                    "synonyms": [
                        "adapter",
                        "régionaliser"
                    ],
                    "common_phrases": [
                        "localiser un logiciel",
                        "localiser une application",
                        "localiser un site"
                    ]
                },
                {
                    "sense_id": "a08181d8-ce95-3953-9a13-3910d8d81a0c",
                    "sense_definition": "Situer un fait, un événement ou un souvenir à une époque ou dans un cadre temporel précis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les historiens peinent encore à <w>localiser</w> précisément cet événement dans la chronologie royale."
                        },
                        {
                            "text": "J'essaie de <w>localiser</w> ce souvenir d'enfance, mais je ne me rappelle plus l'année exacte."
                        }
                    ],
                    "synonyms": [
                        "dater",
                        "situer"
                    ],
                    "common_phrases": [
                        "localiser dans le temps"
                    ]
                }
            ]
        }
    ]
}