                "senses": [
                    {
                        "sense_id": "063fa931-2540-3ad2-82a5-cb2f1d8ebe1d",
                        "entry_id": "d8425d0a-ca99-321c-bfa5-0654a72e70a0",
                        "glosses": [
                            "eenvoudig en dus makkelijk te begrijpen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a20e1f23-eb77-4000-ba9e-0faf042f742d",
                                "sense_id": "063fa931-2540-3ad2-82a5-cb2f1d8ebe1d",
                                "text": "Bach troost en ontroert. Reikend naar het hogere, filosoferend over onze kleinheid: een totaalervaring biedt hij. Zijn muziek, al is het een heksentoer om ze zó uit te voeren, klinkt ongecompliceerd en vanzelfsprekend. Of ze nu extatisch galmt of lichtvoetig uitdijt in een veelvoud van versieringsnootjes, toch weet je: de architectuur van Bachs lijnenspel palmt je onweerstaanbaar in."
                            },
                            {
                                "example_id": "7bc1f076-2061-44c8-86a6-d508afc89001",
                                "sense_id": "063fa931-2540-3ad2-82a5-cb2f1d8ebe1d",
                                "text": "Dat Mr. Polska weet hoe hij een feestje moet bouwen, bewees hij zondagmiddag op de Zwarte Cross. Binnen een minuut had Polska het publiek in de bomvolle Megatent in de flow van zijn ongecompliceerde feestraps."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f44a000-fa5b-460d-9beb-299a3fbeddfc",
                        "source_entry_id": "d8425d0a-ca99-321c-bfa5-0654a72e70a0",
                        "source_sense_id": "063fa931-2540-3ad2-82a5-cb2f1d8ebe1d",
                        "source_sense_description": "eenvoudig en dus makkelijk te begrijpen",
                        "target_lang_word": "easy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "easy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbdbb1a7-a6ee-362d-bfd9-4ab2a62431dd",
                                        "entry_id": "6561d2b6-283c-3078-ae72-0886daa73aa6",
                                        "glosses": [
                                            "Comfortable; at ease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2a7ba94-1a2f-44df-98e1-a6f40184d1ed",
                                                "sense_id": "fbdbb1a7-a6ee-362d-bfd9-4ab2a62431dd",
                                                "text": "Now that I know it's taken care of, I can rest easy at night."
                                            },
                                            {
                                                "example_id": "e5e20fef-334b-414e-9fc8-40bb43150fe5",
                                                "sense_id": "fbdbb1a7-a6ee-362d-bfd9-4ab2a62431dd",
                                                "text": "“[…] She takes the whole thing with desperate seriousness. But the others are all easy and jovial—thinking about the good fare that is soon to be eaten, about the hired fly, about anything.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2ba1cfc-39ae-3f66-aa02-c6cd7bcfb6a7",
                                        "entry_id": "6561d2b6-283c-3078-ae72-0886daa73aa6",
                                        "glosses": [
                                            "Requiring little skill or effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d30fcef-60b7-4ea8-9711-610da22071f4",
                                                "sense_id": "c2ba1cfc-39ae-3f66-aa02-c6cd7bcfb6a7",
                                                "text": "It's often easy to wake up but hard to get up."
                                            },
                                            {
                                                "example_id": "ef9f37da-b955-4272-8ac3-c93b088ba607",
                                                "sense_id": "c2ba1cfc-39ae-3f66-aa02-c6cd7bcfb6a7",
                                                "text": "The teacher gave an easy test to her students."
                                            },
                                            {
                                                "example_id": "187cc05a-a5f4-4a1f-8a1e-6121e50828c9",
                                                "sense_id": "c2ba1cfc-39ae-3f66-aa02-c6cd7bcfb6a7",
                                                "text": "Now the easiest sell in traveldom is made even easier."
                                            },
                                            {
                                                "example_id": "bec79209-6238-4cc5-ac3e-f908ae1aba6f",
                                                "sense_id": "c2ba1cfc-39ae-3f66-aa02-c6cd7bcfb6a7",
                                                "text": "I realized this all too well when as a seminarian I got stuck with the job of recruiting the washees for a Maundy Thursday service. It's much easier to be the one down on the floor with the basin[…]"
                                            },
                                            {
                                                "example_id": "3ddf5c37-051a-4634-811e-907030f52e8d",
                                                "sense_id": "c2ba1cfc-39ae-3f66-aa02-c6cd7bcfb6a7",
                                                "text": "As the world's drug habit shows, governments are failing in their quest to monitor every London window-box and Andean hillside for banned plants. But even that Sisyphean task looks easy next to the fight against synthetic drugs. No sooner has a drug been blacklisted than chemists adjust their recipe and start churning out a subtly different one."
                                            },
                                            {
                                                "example_id": "65a89ad7-030d-486d-993f-3a3eed8a2ad1",
                                                "sense_id": "c2ba1cfc-39ae-3f66-aa02-c6cd7bcfb6a7",
                                                "text": "You could just use ordinary shop-bought kecap manis to marinade the meat, but making your own is easy, has a far more elegant fragrance and is, above all, such a great brag! Flavouring kecap manis is an intensely personal thing, so try this version now and next time cook the sauce down with crushed, split lemongrass and a shredded lime leaf."
                                            },
                                            {
                                                "example_id": "57c21a3b-eb4e-434f-a666-15668200f9fd",
                                                "sense_id": "c2ba1cfc-39ae-3f66-aa02-c6cd7bcfb6a7",
                                                "text": "Toyota spokesman Paul Hogard said the automaker wants speedometers to be easy to read, so there’s value in placing the typical operating speed of American cars, 45 mph to 70 mph, he said, at the top of the speedometer, which is the easiest place on the speedometer for the driver to read."
                                            },
                                            {
                                                "example_id": "755c59e1-0c14-474d-b56f-3227572f89da",
                                                "sense_id": "c2ba1cfc-39ae-3f66-aa02-c6cd7bcfb6a7",
                                                "text": "President Donald Trump asked the Supreme Court on Tuesday to make it easier for his administration to deport people to South Sudan and other countries that are not their homeland, the latest in a series of controversial immigration policies the administration has put before the conservative-majority high court."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc9910d5-168d-3817-bb52-f41a73316fc8",
                                        "entry_id": "6561d2b6-283c-3078-ae72-0886daa73aa6",
                                        "glosses": [
                                            "Causing ease; giving comfort, or freedom from care or labour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7853635b-dba4-4250-9fc9-4a40cb527146",
                                                "sense_id": "dc9910d5-168d-3817-bb52-f41a73316fc8",
                                                "text": "Rich people live in easy circumstances."
                                            },
                                            {
                                                "example_id": "c550078b-9cfe-487c-9242-d161c3bee665",
                                                "sense_id": "dc9910d5-168d-3817-bb52-f41a73316fc8",
                                                "text": "an easy chair"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc27efd3-59e0-351c-8beb-acfdf715fa3f",
                                        "entry_id": "6561d2b6-283c-3078-ae72-0886daa73aa6",
                                        "glosses": [
                                            "Free from constraint, harshness, or formality; unconstrained; smooth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2302bae6-e900-4e1a-80b1-5b7952678714",
                                                "sense_id": "fc27efd3-59e0-351c-8beb-acfdf715fa3f",
                                                "text": "easy manners; an easy style"
                                            },
                                            {
                                                "example_id": "0a5c2410-6640-4551-b862-8a9d96a10538",
                                                "sense_id": "fc27efd3-59e0-351c-8beb-acfdf715fa3f",
                                                "text": "the easy vigour of a line"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e330363-7df8-31a0-a69d-6f2746bf91ee",
                                        "entry_id": "6561d2b6-283c-3078-ae72-0886daa73aa6",
                                        "glosses": [
                                            "Consenting readily to sex."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "353cb07c-0e18-4568-8038-bb06800561f4",
                                                "sense_id": "3e330363-7df8-31a0-a69d-6f2746bf91ee",
                                                "text": "She has a reputation for being easy; they say she slept with half the senior class."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c03a2d12-c8d1-31ae-9454-4450198f3e18",
                                        "entry_id": "6561d2b6-283c-3078-ae72-0886daa73aa6",
                                        "glosses": [
                                            "Not making resistance or showing unwillingness; tractable; yielding; compliant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1977f5b5-e348-46b0-8650-40bcb5cba818",
                                                "sense_id": "c03a2d12-c8d1-31ae-9454-4450198f3e18",
                                                "text": "He gain'd their easy hearts."
                                            },
                                            {
                                                "example_id": "e0030dca-834a-4d19-83f0-334d4662c165",
                                                "sense_id": "c03a2d12-c8d1-31ae-9454-4450198f3e18",
                                                "text": "He is[…] too tyrannical to be an easy monarch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e649e5e-ffee-34b3-aac1-81c21c263fd5",
                                        "entry_id": "6561d2b6-283c-3078-ae72-0886daa73aa6",
                                        "glosses": [
                                            "Not straitened as to money matters; opposed to tight."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be0dd39e-be10-4c4c-9e71-87c5bbd57719",
                                                "sense_id": "3e649e5e-ffee-34b3-aac1-81c21c263fd5",
                                                "text": "The market is easy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "easy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d44b84ce-c67d-3802-972c-572ccd4689fe",
                                        "entry_id": "cdfeff23-adf6-3542-b6b4-758affd64eb1",
                                        "glosses": [
                                            "In a relaxed or casual manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4419e4e8-b759-4ea5-8c8e-eaf99eeb2282",
                                                "sense_id": "d44b84ce-c67d-3802-972c-572ccd4689fe",
                                                "text": "After his illness, John decided to take it easy."
                                            },
                                            {
                                                "example_id": "bd0d82e6-fece-4b6f-899d-a3eb43e34105",
                                                "sense_id": "d44b84ce-c67d-3802-972c-572ccd4689fe",
                                                "text": "Everything comes easy to her."
                                            },
                                            {
                                                "example_id": "4971c3c7-c413-4771-a3af-8da574ad041a",
                                                "sense_id": "d44b84ce-c67d-3802-972c-572ccd4689fe",
                                                "text": "We immediately threw out all the little things we had with us, ſuch as biſcuits, apples, &c. and after that one of our oars or wings; but ſtill deſcending, we caſt away the other wing, and then the governail ; having likewiſe had the precaution, for fear of accidents, while the Balloon was filling, partly to looſen and make it go eaſy, I now ſucceeded in attempting to reach without the Car, and unſcrewing the moulinet, with all its apparatus; I likewiſe caſt that into the ſea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b11b00c-275c-3539-a165-795243cb9943",
                                        "entry_id": "cdfeff23-adf6-3542-b6b4-758affd64eb1",
                                        "glosses": [
                                            "In a manner without strictness or harshness; gently; softly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72f1d38e-9756-4041-83b9-98e35a80d7e0",
                                                "sense_id": "5b11b00c-275c-3539-a165-795243cb9943",
                                                "text": "Jane went easier on him after he broke his arm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "098662e0-e922-32fb-91c6-2dff73b349d8",
                                        "entry_id": "cdfeff23-adf6-3542-b6b4-758affd64eb1",
                                        "glosses": [
                                            "Handily; at the very least."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75a4fd4f-9122-4927-b46d-9d9b5b6f7023",
                                                "sense_id": "098662e0-e922-32fb-91c6-2dff73b349d8",
                                                "text": "This project will cost 15 million dollars, easy."
                                            }
                                        ]
                                    }
                                ]
                            },
