                    "sense_id": "9cfbf378-478f-3b8d-abce-0a4d428005ad",
                    "sense_definition": "Происходить в течение какого-либо времени.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Урок будет <длиться> сорок пять минут.",
                            "target_lang_translations": {
                                "en": "The lesson will <last> forty-five minutes.",
                                "de": "Der Unterricht wird 45 Minuten <dauern>.",
                                "nl": "De les zal veertig minuten <duren>.",
                                "pl": "Lekcja będzie <w>trwać</w> czterdzieści pięć minut.",
                                "fr": "Le cours va <w>durer</w> quarante-cinq minutes.",
                                "it": "La lezione <durera> quarantacinque minuti.",
                                "cs": "Lekce bude <trvat> čtyřicet pět minut.",
                                "tr": "Ders kırk beş dakika <sürecek>.",
                                "es": "La clase <durará> cuarenta y cinco minutos.",
                                "zh": "这节课将<w>持续</w>四十五分钟。"
                            }
                        },
                        {
                            "text": "Этот ремонт не может <длиться> вечно.",
                            "target_lang_translations": {
                                "en": "This renovation cannot <last> forever.",
                                "de": "Diese Renovierung kann nicht ewig <dauern>.",
                                "nl": "Deze verbouwing kan niet eeuwig <duren>.",
                                "pl": "Ten remont nie może <w>trwać</w> wiecznie.",
                                "fr": "Ces travaux ne peuvent pas <w>durer</w> éternellement.",
                                "it": "Questa ristrutturazione non può <durare> in eterno.",
                                "cs": "Tato rekonstrukce nemůže <trvat> věčně.",
                                "tr": "Bu tadilat sonsuza kadar <süremez>.",
                                "es": "Esta reforma no puede <durar> para siempre.",
                                "zh": "这次装修不可能<w>持续</w>到永远。"
                            }
                        },
                        {
                            "text": "Молчание <длилось> несколько минут, пока кто-то не заговорил.",
                            "target_lang_translations": {
                                "en": "The silence <lasted> a few minutes until someone spoke.",
                                "de": "Das Schweigen <dauerte> einige Minuten, bis jemand das Wort ergriff.",
                                "nl": "De stilte <duurde> enkele minuten, totdat iemand begon te praten.",
                                "pl": "Cisza <w>trwała</w> kilka minut, zanim ktoś się odezwał.",
                                "fr": "Le silence a <w>duré</w> quelques minutes, jusqu'à ce que quelqu'un prenne la parole.",
                                "it": "Il silenzio è <durato> alcuni minuti, finché qualcuno non ha parlato.",
                                "cs": "Ticho <trvalo> několik minut, než někdo promluvil.",
                                "tr": "Biri konuşana kadar sessizlik birkaç dakika <sürdü>.",
                                "es": "El silencio <duró> unos minutos hasta que alguien habló.",
                                "zh": "沉默<w>持续</w>了几分钟，直到有人开口说话。"
                            }
                        }
