{
    "word_family": [
        "geslenter",
        "slenteraar",
        "slentergang"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b2593fc1-b017-321b-9802-a04a012df63e",
                    "sense_definition": "op een ontspannen, rustig tempo wandelen zonder haast of specifiek doel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lopen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op zondagmiddag <w>slenteren</w> veel mensen gezellig door de oude straatjes van de stad.",
                            "target_lang_translations": {
                                "ru": "В воскресенье днем многие люди приятно <w>прогуливаются</w> по старым улочкам города."
                            }
                        },
                        {
                            "text": "We <w>slenterden</w> urenlang langs het strand terwijl we van de zon genoten.",
                            "target_lang_translations": {
                                "ru": "Мы часами <w>бродили</w> по пляжу, наслаждаясь солнцем."
                            }
                        }
                    ],
                    "synonyms": [
                        "kuieren",
                        "dwalen",
                        "struinen"
                    ],
                    "antonyms": [
                        "haasten",
                        "hollen",
                        "snellen"
                    ],
                    "common_phrases": [
                        "door de stad slenteren",
                        "over de markt slenteren"
                    ],
                    "target_lang_definitions": {
                        "ru": "гулять в расслабленном, спокойном темпе, без спешки или определенной цели"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогуливаться",
                                "target_lang_sense_clarification": "неспешно идти ради удовольствия"
                            },
                            {
                                "target_lang_word": "слоняться",
                                "target_lang_sense_clarification": "ходить без определенной цели"
                            },
                            {
                                "target_lang_word": "бродить",
                                "target_lang_sense_clarification": "медленно ходить, гулять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4beaaea-653a-3ebd-a25f-01ff779e0bf9",
                    "sense_definition": "langzaam en futloos of met tegenzin ergens naartoe lopen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lopen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was na de zware ruzie met duidelijke tegenzin naar huis <w>geslenterd</w>.",
                            "target_lang_translations": {
                                "ru": "После тяжелой ссоры он с явной неохотой <w>поплелся</w> домой."
                            }
                        },
                        {
                            "text": "De vermoeide kinderen <w>slenterden</w> langzaam achter hun ouders aan naar de auto.",
                            "target_lang_translations": {
                                "ru": "Уставшие дети медленно <w>плелись</w> к машине вслед за родителями."
                            }
                        }
                    ],
                    "synonyms": [
                        "sloffen"
                    ],
                    "common_phrases": [
                        "naar huis slenteren"
                    ],
                    "target_lang_definitions": {
                        "ru": "идти медленно, вяло или с неохотой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плестись",
                                "target_lang_sense_clarification": "идти медленно, волоча ноги или с неохотой"
                            },
                            {
                                "target_lang_word": "тащиться",
                                "target_lang_sense_clarification": "идти медленно из-за усталости или нежелания"
                            },
                            {
                                "target_lang_word": "брести",
                                "target_lang_sense_clarification": "идти с трудом или вяло"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a16e0fb-f345-382c-8d49-6fc2b13942e4",
                    "sense_definition": "de tijd verdoen door traag te werk te gaan of uit te stellen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "traagheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop toch met <w>slenteren</w> en begin eindelijk eens aan je huiswerk voor morgen.",
                            "target_lang_translations": {
                                "ru": "Хватит уже <w>тянуть время</w> и начни наконец делать домашнее задание на завтра."
                            }
                        },
                        {
                            "text": "Als we zo blijven <w>slenteren</w>, krijgen we het project voor de deadline nooit af.",
                            "target_lang_translations": {
                                "ru": "Если мы продолжим так <w>медлить</w>, мы никогда не закончим проект к дедлайну."
                            }
                        }
                    ],
                    "synonyms": [
                        "talmen",
                        "treuzelen",
                        "drailen"
                    ],
                    "antonyms": [
                        "opschieten",
                        "haasten"
                    ],
                    "target_lang_definitions": {
                        "ru": "терять время, действуя медленно или откладывая дела"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мешкать",
                                "target_lang_sense_clarification": "действовать слишком медленно, теряя время"
                            },
                            {
                                "target_lang_word": "медлить",
                                "target_lang_sense_clarification": "не торопиться, оттягивать время"
                            },
                            {
                                "target_lang_word": "тянуть время",
                                "target_lang_sense_clarification": "затягивать процесс"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}