                                        "entry_id": "b365283c-c791-3420-8c00-52da232aa9f0",
                                        "glosses": [
                                            "iemand die zingt."
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e4fae0f-6cfb-4495-9e4e-0f3574dd8fc5",
                                                "sense_id": "15a81218-79be-34ab-8e77-5f28c1ef814e",
                                                "text": "Die band heeft een hele goede zanger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68425842-e732-3a34-ba0f-91d585eb0ed8",
                                        "entry_id": "b365283c-c791-3420-8c00-52da232aa9f0",
