                        "examples": [
                            {
                                "example_id": "866d60a5-a797-44ba-9f1c-b5a62d699178",
                                "sense_id": "81d68280-62d8-3ece-b762-99015a521731",
                                "text": "De vroegere rector van de priesteropleiding van de benedictijnenabdij Kremsmünster in het noorden van Oostenrijk moet zich deze week verantwoorden voor seksueel misbruik. Hij zou zich in de periode 1973-1993 hebben vergrepen aan 24 mannen, meldt het Oostenrijkse persbureau APA."
                            },
                            {
                                "example_id": "2bd505e4-06e7-4218-a543-6e239a61dd12",
                                "sense_id": "81d68280-62d8-3ece-b762-99015a521731",
                                "text": "Broeder Adelbert, reliekenbeheerder van de Abdij van Egmond, zegt dat hij kan instaan voor de authenticiteit. ,,Het stuk rib is echt zeker van deze heilige”, zegt hij. De geschiedenis van dit stukje gebeente is volgens hem gedocumenteerd tot het jaar 1087. Het is het eerste Nicolaasrelikwie dat in Amsterdam wordt bijgezet. De Egmondse benedictijnenabdij houdt zelf na de schenking nog vier relieken van Sint Nicolaas over."
                            }
                        ]
