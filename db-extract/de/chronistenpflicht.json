                "senses": [
                    {
                        "sense_id": "00b547da-5dc2-3309-b19f-48cc39584b7e",
                        "entry_id": "f3796a2d-76c0-37bc-9ecc-a84193e4c94b",
                        "glosses": [
                            "auferlegte oder freiwillig übernommene Aufgabe, über ein Geschehen wahrheitsgemäße, vollständige Fakten zu liefern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8793c67-d1c0-41c2-b411-bab9e62b5435",
                                "sense_id": "00b547da-5dc2-3309-b19f-48cc39584b7e",
                                "text": "„Bolle als überzeugter Journalist, der das Redakteurshandwerk von der Pike auf gelernt hat, weiß natürlich, dass nicht nur die Kreativität und Aktualität zählt, nicht nur das Besondere in der Tageszeitung wichtig ist, sondern er auch seinen Lesern in Sachen Chronistenpflicht Informationen schuldet.“"
                            },
                            {
                                "example_id": "10a16ccb-2bdb-4e87-94e0-bd6c8d837531",
                                "sense_id": "00b547da-5dc2-3309-b19f-48cc39584b7e",
                                "text": "„Trotz der Strapazen, ihrer Kopfschmerzen und Erschöpfung legt sich Amelia Stewart Knight eine Chronistenpflicht auf, jeden Abend in einigen Sätzen knapp den Tag zu beschreiben.“"
                            },
                            {
                                "example_id": "9796b93b-5ced-4211-a9a6-ef7e2a11cbbf",
                                "sense_id": "00b547da-5dc2-3309-b19f-48cc39584b7e",
                                "text": "„Wo endet die Chronistenpflicht und wo beginnt der Voyeurismus?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
