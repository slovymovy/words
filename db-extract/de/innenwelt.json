                    {
                        "sense_id": "96dc3cf0-e88d-3892-93ed-37c53cd67632",
                        "entry_id": "5025991e-1e11-3aec-b5b6-424fed941373",
                        "glosses": [
                            "die Gesamtheit der Vorstellungen, Gedanken und Gefühle, die das Erleben eines Menschen ausmachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "961d605e-bb8e-437a-b779-34c7c4f55192",
                                "sense_id": "96dc3cf0-e88d-3892-93ed-37c53cd67632",
                                "text": "„Die Unterscheidung einer sicheren Innenwelt von einer zweifelhaften Außenwelt erfordert eine Erklärung für den intentionalen Gehalt unserer mentalen Zustände, die nicht auf die Existenz äußerer Gegenstände rekurriert.“"
                            },
                            {
                                "example_id": "8d0b2582-02a6-4081-b8cb-f40142e80312",
                                "sense_id": "96dc3cf0-e88d-3892-93ed-37c53cd67632",
                                "text": "„Ich wundere mich stets aufs Neue, dass ich noch immer nicht vom Äußeren auf die Innenwelt eines Menschen schließen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
