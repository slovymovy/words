                "senses": [
                    {
                        "sense_id": "5a32624a-c1a2-30b6-b6d2-5fa49d34d9b4",
                        "entry_id": "53dec8b5-27e0-39f4-9d9c-dd68f38feaa6",
                        "glosses": [
                            "für eine Sprache spezifische Gestaltung der Tonhöhenbewegung beim Sprechen"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "dcadcc72-b383-4f53-95f1-e0239f5443b6",
                                "sense_id": "5a32624a-c1a2-30b6-b6d2-5fa49d34d9b4",
                                "text": "„Eine realisierte, aktuale Sprachmelodie nennt von Essen Sprechmelodie.“"
                            },
                            {
                                "example_id": "90f23149-6246-43ff-8724-01e1d717ff4d",
                                "sense_id": "5a32624a-c1a2-30b6-b6d2-5fa49d34d9b4",
                                "text": "„In bezug auf die Lautung unterscheiden sich Sprachen…nach der Sprachmelodie, das heißt nach lautübergreifenden Merkmalen.“"
                            },
                            {
                                "example_id": "31f51f92-5855-4ca9-b034-2560b405f944",
                                "sense_id": "5a32624a-c1a2-30b6-b6d2-5fa49d34d9b4",
                                "text": "„Ich glaube, es ist der Tonfall der Stimme, die französische Sprachmelodie, die den gelernten und gestandenen preußischen Soldaten an Eroberung denken läßt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
