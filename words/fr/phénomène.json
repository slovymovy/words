    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e0728031-548f-3fc7-9b73-b852b22406ab",
                    "sense_definition": "Fait naturel, physique ou social susceptible d'être observé et étudié scientifiquement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "observation_scientifique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'éclipse solaire totale est un <w>phénomène</w> naturel particulièrement impressionnant."
                        },
                        {
                            "text": "Les scientifiques étudient ce <w>phénomène</w> physique depuis plusieurs décennies."
                        }
                    ],
                    "synonyms": [
                        "manifestation",
                        "événement"
                    ],
                    "common_phrases": [
                        "phénomène naturel",
                        "phénomène météorologique",
                        "phénomène de société"
                    ]
                },
                {
                    "sense_id": "a6e4def4-889c-313a-8ef6-1957f009d32e",
                    "sense_definition": "Fait, événement ou chose remarquable et surprenant par sa rareté ou son caractère exceptionnel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chose_extraordinaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une chute de neige en plein mois de mai est un <w>phénomène</w> tout à fait inattendu."
                        },
                        {
                            "text": "Ce livre a connu un succès fulgurant et représente un véritable <w>phénomène</w> éditorial."
                        }
                    ],
                    "synonyms": [
                        "prodige",
                        "curiosité",
                        "merveille"
                    ],
                    "common_phrases": [
                        "phénomène rare",
                        "vrai phénomène"
                    ]
                },
                {
                    "sense_id": "ac8669ea-16c1-32e4-87b6-ac149e695c18",
                    "sense_definition": "Personne qui suscite l'étonnement par des capacités hors du commun ou un comportement singulier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personne_extraordinaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune pianiste est un véritable <w>phénomène</w> sur la scène internationale."
                        },
                        {
                            "text": "Son cousin est un sacré <w>phénomène</w> qui ne fait jamais rien comme les autres."
                        }
                    ],
                    "synonyms": [
                        "prodige",
                        "numéro"
                    ],
                    "common_phrases": [
                        "sacré phénomène"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé sur un ton familier"
                        }
                    ]
                },
                {
                    "sense_id": "c4efa0ea-91eb-3d01-ad25-693a9f0a3ca2",
                    "sense_definition": "En philosophie, ce qui apparaît directement aux sens et à la conscience, par opposition à la réalité en soi.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon Kant, l'être humain ne peut percevoir que le <w>phénomène</w> et non la chose en soi."
                        },
                        {
                            "text": "La critique kantienne sépare rigoureusement le <w>phénomène</w> du monde intelligible."
                        }
                    ],
                    "synonyms": [
                        "apparence"
                    ],
                    "antonyms": [
                        "noumène"
                    ]
                }
            ]
        }
    ]
