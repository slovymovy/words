                ],
                "senses": [
                    {
                        "sense_id": "5b8c36cf-574a-34b9-8e47-b17e0826b843",
                        "entry_id": "58bbba9e-6ba7-3f31-a4cd-fc5b34a5b22f",
                        "glosses": [
                            "Volksfest im Zusammenhang mit einem Wettkampf von Mitgliedern eines Schützenvereins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aec1f6d0-9030-4d37-b778-040866d425cb",
                                "sense_id": "5b8c36cf-574a-34b9-8e47-b17e0826b843",
                                "text": "Auf dem Schützenfest gewann er an der Schießbude für seine Freundin ein großes Stofftier."
                            },
                            {
                                "example_id": "59498a92-7157-4df4-b5c2-d16bf196eb41",
                                "sense_id": "5b8c36cf-574a-34b9-8e47-b17e0826b843",
                                "text": "„Ohne die weise Vorsicht des Schützenkollegiums, welches das Schützenfest auf den Anfang des Monats legt, hätte ich wahrhaftig meinen Pegasus versetzen müssen.“"
                            },
                            {
                                "example_id": "37366ff5-7cf2-4d1b-a5f0-fd888ec260ab",
                                "sense_id": "5b8c36cf-574a-34b9-8e47-b17e0826b843",
                                "text": "„Auf dem Schützenfest kriegten wir Zuckerwatte.“"
                            },
                            {
                                "example_id": "36424a01-4670-43d0-98fe-0dd4bc61e37d",
                                "sense_id": "5b8c36cf-574a-34b9-8e47-b17e0826b843",
                                "text": "„Draußen hörte er die Musik vom Schützenfest dudeln.“"
                            },
                            {
                                "example_id": "7afc7db1-c2b9-41a7-9e06-c998fc3964a1",
                                "sense_id": "5b8c36cf-574a-34b9-8e47-b17e0826b843",
                                "text": "„Seit der Großvater tot war, machte ich mir auch aus Schützenfesten nichts mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b502696c-32a9-36ba-9a42-640fbfd690d0",
                        "entry_id": "58bbba9e-6ba7-3f31-a4cd-fc5b34a5b22f",
                        "glosses": [
                            "Spiel, bei dem viele Tore erzielt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f037026c-6ef8-49de-b491-afb706f1a378",
                                "sense_id": "b502696c-32a9-36ba-9a42-640fbfd690d0",
                                "text": "Der deutsche Meister feierte im ersten Spiel der Saison ein Schützenfest und gewann mit vier Toren Vorsprung."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
