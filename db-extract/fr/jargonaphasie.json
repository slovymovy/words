                "senses": [
                    {
                        "sense_id": "8e8fac89-b56b-3c6f-903a-310e0853c873",
                        "entry_id": "63162e90-eaca-32e6-b7b4-cc91dd564daf",
                        "glosses": [
                            "Trouble du langage où l'on observe une déformation et/ou une substitution des mots qui sont parfois choisis de manière imprécise par le malade qui n'a pas conscience de sa maladie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47d1a76f-6dbc-4faf-8725-b4be3d42bf99",
                                "sense_id": "8e8fac89-b56b-3c6f-903a-310e0853c873",
                                "text": "Le phénomène d'anosognosie est souvent présent dans cette aphasie, associé généralement à la jargonaphasie et aux troubles massifs de la compréhension."
                            },
                            {
                                "example_id": "810de66d-a490-4922-9b82-db13c8fd3e83",
                                "sense_id": "8e8fac89-b56b-3c6f-903a-310e0853c873",
                                "text": "Un premier cas de jargonaphasie est cependant décrit par Woods et Teuber (1978), chez un enfant de 5 ans présentant une logorrhée avec paraphasies, néologismes et persévérations verbales, suggérant que l'aphasie acquise de l'enfant et de l'adolescent, peut, à l'instar de l'adulte avoir des présentations cliniques variées."
                            }
                        ]
                    }
