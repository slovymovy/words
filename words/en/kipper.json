                },
                {
                    "sense_id": "b561e0c2-8577-344b-bb6c-c276057fab78",
                    "sense_definition": "An air patrol operating to protect fishing fleets and sea convoys.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_patrol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The squadron flew a daily <w>kipper</w> to protect fishing vessels from enemy attack.",
                            "target_lang_translations": {
                                "ru": "Эскадрилья ежедневно совершала <w>патрульный вылет</w> для защиты рыболовецких судов от нападения противника."
                            }
                        },
                        {
                            "text": "During the war, pilots assigned to the <w>kipper</w> kept watch over the North Sea.",
                            "target_lang_translations": {
                                "ru": "Во время войны пилоты, назначенные в <w>воздушный эскорт конвоев</w>, несли дежурство над Северным морем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kipper patrol"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Military aviation slang"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "Historically used during World War II"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Воздушный патруль для защиты рыболовецких судов и морских конвоев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противолодочный патруль",
                                "target_lang_sense_clarification": "авиапатруль конвоев"
                            },
                            {
                                "target_lang_word": "воздушный эскорт",
                                "target_lang_sense_clarification": "авиационное охранение судов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cef1c53-0554-3918-8f99-8205a7498562",
                    "sense_definition": "An English person, especially an English immigrant living in Australia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "demonym",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was just another newly arrived <w>kipper</w> adjusting to life in Sydney.",
                            "target_lang_translations": {
                                "ru": "Он был всего лишь очередным недавно приехавшим <w>англичанином</w>, привыкающим к жизни в Сиднее."
                            }
                        },
                        {
                            "text": "The dockers teased the young <w>kipper</w> about his accent.",
                            "target_lang_translations": {
                                "ru": "Докеры подшучивали над молодым <w>британцем</w> из-за его акцента."
