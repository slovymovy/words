                                "sense_id": "98731557-0a89-34cb-bb4f-c805d690cf45",
                                "text": "On n’entendait que des voix confuses et indistinctes."
                            },
                            {
                                "example_id": "0b11d981-6c05-4f93-8c15-a7b5d1deb97e",
                                "sense_id": "98731557-0a89-34cb-bb4f-c805d690cf45",
