                "senses": [
                    {
                        "sense_id": "eeb59579-0f69-37ee-9e5b-66eb330aa146",
                        "entry_id": "95e8a47f-92ce-3a2c-b74e-c106784d7354",
                        "glosses": [
                            "Médecin qui œuvre essentiellement en clinique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d33c0c7-939d-4a3d-b95e-d9dbe963cc9e",
                                "sense_id": "eeb59579-0f69-37ee-9e5b-66eb330aa146",
                                "text": "Néanmoins la préoccupation constante des cliniciens à l'égard de l’amibiase, et cette tendance à la voir partout peut-être parce qu'elle est partout, prennent figure de manie aux yeux des parasitologues."
                            },
                            {
                                "example_id": "9eaf2eba-7302-42fb-8c64-baf905b0758e",
                                "sense_id": "eeb59579-0f69-37ee-9e5b-66eb330aa146",
                                "text": "En 1878, le professeur S. Botkine, éminent clinicien russe, offrit au jeune physiologiste plein de talent un poste de manipulateur."
                            },
                            {
                                "example_id": "63b4c733-f214-4aa3-9716-8791aa2ab6e9",
                                "sense_id": "eeb59579-0f69-37ee-9e5b-66eb330aa146",
                                "text": "Le diagnostic différentiel de l’apathie et de la dépression reste un véritable défi lancé au clinicien, certains symptômes étant communs, le manque de motivation en particulier."
                            },
                            {
                                "example_id": "70b11075-d782-4b35-a836-3f46ab33807e",
                                "sense_id": "eeb59579-0f69-37ee-9e5b-66eb330aa146",
                                "text": "Il faudrait aussi une représentation interdisciplinaire avec des spécialistes du développement de l'enfant, des accidentologues, des ingénieurs, des urbanistes, des cliniciens, des sociologues et d'autres encore."
                            }
                        ]
                    }
                ],
