                    },
                    {
                        "translation_id": "f5724418-a3f1-4a3b-9d0e-3b80cf3f03eb",
                        "source_entry_id": "a14849a8-883a-3ebe-ab86-eba251ced56b",
                        "source_sense_id": "a4ed7693-17be-35fe-ba2c-2f9bd916e6e2",
                        "target_lang_word": "ecoterrorism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ecoterrorism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e3ac587-3ded-3c2d-9e75-5deb92a577ca",
                                        "entry_id": "4939838a-f52c-3c51-91fc-d2d7046b7bd2",
                                        "glosses": [
                                            "Terrorism with an ecological motive, such as attacks against corporations perceived to be harming the natural environment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb6445f7-39c5-42f0-bc8d-5768a959ec3a",
                                                "sense_id": "3e3ac587-3ded-3c2d-9e75-5deb92a577ca",
                                                "text": "On either view and at least in principle, ecoterrorism will be the worst possible policy […]"
                                            },
                                            {
                                                "example_id": "dbe23774-ad99-4b98-af0d-77b9ff643184",
                                                "sense_id": "3e3ac587-3ded-3c2d-9e75-5deb92a577ca",
                                                "text": "Hours later, Ms. Bari, whose pelvis was crushed by the blast, and Mr. Cherney, who was slightly wounded, were arrested by the Oakland police and the F.B.I., which said the bomb had accidentally detonated while the pair were transporting it to use for ecoterrorism."
                                            },
                                            {
                                                "example_id": "b64c6f58-c4ca-4e9d-85a9-0a83c38e9ba1",
                                                "sense_id": "3e3ac587-3ded-3c2d-9e75-5deb92a577ca",
                                                "text": "He said that ecoterrorism by radical and violent groups only encourages fear […]"
                                            },
                                            {
                                                "example_id": "67f02f14-a2e0-4f23-8e5e-e92faa4fc4fc",
                                                "sense_id": "3e3ac587-3ded-3c2d-9e75-5deb92a577ca",
                                                "text": "The message on the sheet was signed with the letters “E.L.F.,” the infamous initials of the Earth Liberation Front, a loosely organized group that has been linked to multiple bold acts of ecoterrorism across the Northwest and elsewhere for two decades."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
