                "senses": [
                    {
                        "sense_id": "085397bf-b29b-34d2-b571-81a32bb5b943",
                        "entry_id": "9d1123c6-4095-311b-9a4a-c79d32f33def",
                        "glosses": [
                            "pot van aardewerk of kunststof waarin men een plant kweekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a0cdfcc-b5f4-431f-8154-f8f4597bb4ba",
                                "sense_id": "085397bf-b29b-34d2-b571-81a32bb5b943",
                                "text": "Ik drukte mijn sigaret uit in de bloempot die ons tot asbak had gediend. Hij deed hetzelfde en sprong overeind om zich over mijn bagage te ontfermen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fca4f50-d72e-4314-9eb9-b6686fbd5d72",
                        "source_entry_id": "9d1123c6-4095-311b-9a4a-c79d32f33def",
                        "source_sense_id": "085397bf-b29b-34d2-b571-81a32bb5b943",
                        "source_sense_description": "pot waarin men een plant kweekt",
                        "target_lang_word": "Blumentopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blumentopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0eee28f8-a5b9-38f5-9501-f8e79cbfcb36",
                                        "entry_id": "270e2295-14b1-38b1-b635-a45128fae0e8",
                                        "glosses": [
                                            "Behältnis, in welches eine Pflanze/Pflanzen eingesetzt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3db26f6-be11-4f98-b0a6-5cec4ce16481",
                                                "sense_id": "0eee28f8-a5b9-38f5-9501-f8e79cbfcb36",
                                                "text": "Wenn Pflanzen zu groß werden, muss man sie in einen größeren Blumentopf umpflanzen."
                                            },
                                            {
                                                "example_id": "38ac921d-7837-4cc5-9f89-6a7f4d92ec3b",
                                                "sense_id": "0eee28f8-a5b9-38f5-9501-f8e79cbfcb36",
                                                "text": "„Ein kleines Fenster mit einem Blumentopf und einer unverwüstlichen, pelzigen Topfpflanze ging zur Straße hinaus.“"
                                            },
                                            {
                                                "example_id": "88291305-0dc7-41a5-8db1-ecaf872aa0c3",
                                                "sense_id": "0eee28f8-a5b9-38f5-9501-f8e79cbfcb36",
                                                "text": "„Wir sitzen in der Werkstadt Wilkes zwischen Hobelspänen, Särgen, Blumentöpfen mit Geranien und Leimtöpfen.“"
                                            },
                                            {
                                                "example_id": "df0b72c6-8e9f-4f2f-8c75-93e52062fe7e",
                                                "sense_id": "0eee28f8-a5b9-38f5-9501-f8e79cbfcb36",
                                                "text": "„Weil die Sonnenblume in einen schwimmenden Blumentopf eingepflanzt ist, kann sie sich während des ganzen Tages nach der Sonne richten und mühelos die Stunden anzeigen.“"
                                            },
                                            {
                                                "example_id": "e7ea86ee-b7ac-4628-b587-3343ca2f62c1",
                                                "sense_id": "0eee28f8-a5b9-38f5-9501-f8e79cbfcb36",
                                                "text": "„Im Gartenschuppen, der eigentlich Teil des Anbaus war, den aber der Gärtner für seine eigenen Zwecke nutzte, hatte ich einen Blumentopf gefunden, in den ich einen Löwenzahn in voller Blüte eingepflanzt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e164ab8-0064-4906-9384-ff955120076c",
                        "source_entry_id": "9d1123c6-4095-311b-9a4a-c79d32f33def",
                        "source_sense_id": "085397bf-b29b-34d2-b571-81a32bb5b943",
                        "source_sense_description": "pot waarin men een plant kweekt",
                        "target_lang_word": "flowerpot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flowerpot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0ba68d5-0b33-3769-a0f8-ae7ff3130447",
                                        "entry_id": "ce8452fe-9a2a-3104-8cb5-394b193eac30",
                                        "glosses": [
                                            "A pot filled with soil in which plants are grown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a8a33fa-d8c3-4c11-b0d6-e4f0aa711f05",
                                                "sense_id": "b0ba68d5-0b33-3769-a0f8-ae7ff3130447",
                                                "text": "O Laurinella! little doſt thou wot\n How fraile a flower thou doſt ſo highly prize:\nBeauty's the flower, but love the flower-pot\n That muſt preſerve it, els it quickly dyes."
                                            },
                                            {
                                                "example_id": "3fe15a92-e004-45b5-b1df-bf2bb19a2e15",
                                                "sense_id": "b0ba68d5-0b33-3769-a0f8-ae7ff3130447",
                                                "text": "I hope you will think kindly of my whitened bones, and never have anything more to do with Greek writing on flower-pots, sir, if I may make so bold as to say so."
                                            },
                                            {
                                                "example_id": "3ee36131-91b2-400f-a51e-39526a5ee248",
                                                "sense_id": "b0ba68d5-0b33-3769-a0f8-ae7ff3130447",
                                                "text": "Three chairs of the steamer type, all maimed, comprised the furniture of this roof-garden, with (by way of local color) on one of the copings a row of four red clay flower-pots filled with sun-baked dust from which gnarled and rusty stalks thrust themselves up like withered elfin limbs."
                                            },
                                            {
                                                "example_id": "42065568-6950-42e0-b162-a4df587e0184",
                                                "sense_id": "b0ba68d5-0b33-3769-a0f8-ae7ff3130447",
                                                "text": "As a multifaceted kitchen enabler, nothing can quite supplant the gorgeous, timeless, ever-available, often dirt-cheap terra-cotta flowerpot."
                                            },
                                            {
                                                "example_id": "05cbc80f-75a0-43a4-b05e-048926be1d17",
                                                "sense_id": "b0ba68d5-0b33-3769-a0f8-ae7ff3130447",
                                                "text": "The reason we have for so long been unaware that the universe evolves probabilistically is that for the relatively large, everyday objects we typically encounter -- baseballs, flowerpots, the Moon -- quantum mechanics shows that the probabilities become highly skewed, hugely favoring one outcome and effectively suppressing all others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
