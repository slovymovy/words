                        "entry_id": "c650f7cf-07cd-3898-9d45-714bdda02196",
                        "glosses": [
                            "To stink; to smell bad."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "745b5d6b-b1e2-4667-b19c-053cac6f1c22",
                                "sense_id": "281b776b-e6f0-36d7-9c17-8595e9c83e27",
                                "text": "I just ignored him because he stanked worst than I did."
                            },
                            {
                                "example_id": "de251221-ec59-48fa-b92a-2f5cd1c8e822",
                                "sense_id": "281b776b-e6f0-36d7-9c17-8595e9c83e27",
                                "text": "I did not want to ask for her hand in marriage in a hospital room that stanked of chlorine and god knew what else."
                            },
                            {
                                "example_id": "61cae914-354e-467b-bf19-2feb3dc7fb52",
                                "sense_id": "281b776b-e6f0-36d7-9c17-8595e9c83e27",
                                "text": "I couldn't figure out exactly how the Preacher'd done it, but something with this tithing business stanked real bad."
                            },
                            {
                                "example_id": "2965a0c5-4e94-4c3a-90a0-afada2506168",
                                "sense_id": "281b776b-e6f0-36d7-9c17-8595e9c83e27",
                                "text": "You washed it because it stanked.” It is supposed to stank."
                            }
