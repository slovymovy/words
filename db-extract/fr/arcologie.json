                        "entry_id": "1b4f8b23-6e79-3192-b4d9-106b248d420a",
                        "glosses": [
                            "Projet urbain gigantesque et autosuffisant."
                        ],
                        "tags": [
                            "Urbanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "ad1935e2-8afa-4bd6-8a62-24d3b849e0c9",
                                "sense_id": "86c7a325-9bdc-313b-b2f6-84a0947b02d7",
                                "text": "L’arcologie constitue un lieu privé à l’accès soigneusement contrôlé."
                            },
                            {
                                "example_id": "2ccf33ed-8f46-48ad-af7d-6fbbfaf1b70e",
                                "sense_id": "86c7a325-9bdc-313b-b2f6-84a0947b02d7",
                                "text": "Les ascenseurs étaient logés au cœur de l’arcologie, leurs cages regroupées avec les canalisations d’eau, les descentes d’eaux usées, les énormes câbles électriques et les tuyauteries calorifugées que Bobby supposa faire partie de l’installation géothermique décrite par Beauvoir."
                            }
                        ]
                    }
