                        "entry_id": "9c56b237-3f12-37ed-97e4-b4addafd5d4b",
                        "glosses": [
                            "Kosten, die entstehen, wenn man bei einem Gerichtsverfahren einen Rechtsanwalt in Anspruch nimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9a67dd2-0026-49ab-9928-5b9f8e83f528",
                                "sense_id": "c05c6783-a61d-3c88-9449-8c84eac6b40b",
                                "text": "„Da die Abmahnung in aller Regel von einem Anwalt im Auftrag des Verletzten vorgenommen wird, entstehen durch die Abmahnung selbst Anwaltskosten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
