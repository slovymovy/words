                ],
                "senses": [
                    {
                        "sense_id": "a1ade0c1-ac1e-3b1b-96dc-94af765582d7",
                        "entry_id": "428705af-30eb-3bcc-867b-9c49e9da5066",
                        "glosses": [
                            "Alternative letter-case form of Skidoo (“snowmobile”)."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "8c349db1-08b6-43fc-9f42-609a8d10ed72",
                                "sense_id": "a1ade0c1-ac1e-3b1b-96dc-94af765582d7",
                                "text": "From the manufacture of snowgoing equipment such as snow cats, it diversified first into that of snowmobiles (and later skidoos, or water scooters), then into railcar and locomotive manufacture, and finally into the manufacture of small (less than 100-seat) commercial aircraft."
                            },
                            {
                                "example_id": "2adf79fd-9f05-4a09-bda0-cf7d1aec41ee",
                                "sense_id": "a1ade0c1-ac1e-3b1b-96dc-94af765582d7",
                                "text": "He couldn't have seen Peter's skidoo, but he must have seen Peter climbing up the ridgeline. He must have heard Peter's approach on the skidoo."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
