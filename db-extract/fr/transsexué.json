                "senses": [
                    {
                        "sense_id": "d77ceb4f-7575-3942-9e35-3193f50882a2",
                        "entry_id": "b0268a73-f29b-3494-9bb2-e8bd478c4a0b",
                        "glosses": [
                            "Personne qui a changé ou souhaite changer de sexe, ou est en cours de transition."
                        ],
                        "tags": [
                            "Transitude"
                        ],
                        "examples": [
                            {
                                "example_id": "9cfee526-f103-4690-bf52-693a4e1ff5d2",
                                "sense_id": "d77ceb4f-7575-3942-9e35-3193f50882a2",
                                "text": "A défaut d’un prénom correspondant, le transsexué cherche souvent, par la consonnance, à se rapprocher de celui qu’il quitte."
                            },
                            {
                                "example_id": "0c2391fb-3cb8-47fc-b191-848f17a1e79c",
                                "sense_id": "d77ceb4f-7575-3942-9e35-3193f50882a2",
                                "text": "On imagine l’intérêt passionné qu’il aurait voué de nos jours aux informations et aux expériences concernant les transsexués."
                            }
                        ]
                    }
                ],
