                        ]
                    },
                    {
                        "translation_id": "5b1a74c6-3116-4fb3-b0a2-d0cad373c160",
                        "source_entry_id": "56c18eda-25fb-33ce-bf46-0ab181fa71e4",
                        "source_sense_id": "b74e9bbe-57ea-3410-87c0-51d68f1b95ac",
                        "target_lang_word": "remiss",
