                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7abdb6c-fd60-4b62-8dbe-34114583ef0a",
                                "sense_id": "7a56a222-fce9-3aab-b3ab-df85742f8585",
                                "text": "Het eiland werd getroffen door een uiterst destructieve aardbeving."
                            },
                            {
                                "example_id": "e3a5ccbd-8a6d-42d8-829e-1da10b114dfb",
                                "sense_id": "7a56a222-fce9-3aab-b3ab-df85742f8585",
                                "text": "Door haar wimpers heen zag ze hoe de homepage aan zijn destructieve metamorfose begon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56ab88a4-d846-40c9-97de-2aeddfbb7755",
                        "source_entry_id": "c05c69bd-720a-3207-a613-f89b8bb7db2b",
                        "source_sense_id": "7a56a222-fce9-3aab-b3ab-df85742f8585",
                        "target_lang_word": "destructive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "destructive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0381537-8e79-3b7b-8942-6d88eaa4f0ca",
                                        "entry_id": "ee50644f-3452-3e34-961f-68766c365dc4",
                                        "glosses": [
                                            "Causing destruction; damaging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c324417f-934d-491d-b43d-3fd7cb7f6095",
                                                "sense_id": "e0381537-8e79-3b7b-8942-6d88eaa4f0ca",
                                                "text": "The pastures are filled with gay political drop-outs, persons of reasonable intent who found the scene personally destructive."
                                            },
                                            {
                                                "example_id": "b88bafc8-4227-43dd-b921-1e1e1e808f64",
                                                "sense_id": "e0381537-8e79-3b7b-8942-6d88eaa4f0ca",
                                                "text": "After rescuing his estranged daughter in the last film, Live Free Or Die Hard, Willis heads to Russia to rescue his estranged son (Jai Courtney), a CIA agent on a mission to protect a whistleblower (Sebastian Koch) from a corrupt government official (Sergei Kolesnikov) with no shortage of destructive resources at his disposal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fca52481-a713-35e1-a6c1-dac89057b581",
                                        "entry_id": "ee50644f-3452-3e34-961f-68766c365dc4",
                                        "glosses": [
                                            "Causing breakdown or disassembly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dafb6f58-eaf1-40cb-abbf-78e7d612e2ff",
                                                "sense_id": "fca52481-a713-35e1-a6c1-dac89057b581",
                                                "text": "Catabolism is a destructive metabolism that involves the breakdown of molecules and release of energy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03b46c03-8e22-3d84-bbca-c1835e0b0280",
                                        "entry_id": "ee50644f-3452-3e34-961f-68766c365dc4",
                                        "glosses": [
                                            "Lossy; causing irreversible change."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6acc128f-54f4-4591-8ace-56521fd97ac7",
                                                "sense_id": "03b46c03-8e22-3d84-bbca-c1835e0b0280",
                                                "text": "Blurring an image is a destructive operation, but rotating an image is not."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cf7540f-4018-4ce2-a1f9-085a6830fbb2",
                        "source_entry_id": "c05c69bd-720a-3207-a613-f89b8bb7db2b",
