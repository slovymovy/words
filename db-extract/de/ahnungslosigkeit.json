                "senses": [
                    {
                        "sense_id": "3a4b4bde-dfde-3818-8828-226f611a4f8e",
                        "entry_id": "ed5b8bd0-961f-3995-ba2a-e32407940364",
                        "glosses": [
                            "die vollkommene Unwissenheit im Bezug auf eine bestimmte Sachlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca1125a-837b-452d-929c-ad83c5b3f923",
                                "sense_id": "3a4b4bde-dfde-3818-8828-226f611a4f8e",
                                "text": "„Der Prozess endete mit Freisprüchen für die Manager, denen im Urteil erschütternde Ahnungslosigkeit und Sorglosigkeit bis hin zur Unfähigkeit bescheinigt wurde.“"
                            },
                            {
                                "example_id": "c8d3c58e-bfd1-418d-a9a5-c05554a08750",
                                "sense_id": "3a4b4bde-dfde-3818-8828-226f611a4f8e",
                                "text": "„Nur eine unbegrenzte Ahnungslosigkeit hätte sie vor dem Tod schützen können, und die konnte ich bei ihnen nicht annehmen.“"
                            },
                            {
                                "example_id": "929ebdbe-5bd7-44cd-b7af-29d252f5eafd",
                                "sense_id": "3a4b4bde-dfde-3818-8828-226f611a4f8e",
                                "text": "„Zumindest bei mir hat diese Ahnungslosigkeit Konsequenzen.“"
                            },
                            {
                                "example_id": "519a0831-5b94-451e-bda3-f004a0da0611",
                                "sense_id": "3a4b4bde-dfde-3818-8828-226f611a4f8e",
                                "text": "„Seine Ahnungslosigkeit schien ihm so vollständig, daß er ihn drängte, sich zu erklären, und errötend machte ihm Pécuchet schließlich ein Geständnis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7192aaf3-849f-4b1f-823e-7d8daf3c4ee2",
