{
    "word_family": [
        "salt",
        "saltiness",
        "unsalted",
        "saline",
        "desalinate"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "452180d9-577d-331a-9f5f-2da8a1db166d",
                    "sense_definition": "Tasting of salt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "salt_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This soup is too <w>salty</w> for me to eat.",
                            "target_lang_translations": {
                                "ru": "Этот суп слишком <w>солёный</w>, я не могу его есть.",
                                "zh": "这汤对我来说太<w>咸</w>了，没法喝。"
                            }
                        },
                        {
                            "text": "I prefer <w>salty</w> snacks like chips over sweet ones.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю <w>солёные</w> закуски, вроде чипсов, сладким.",
                                "zh": "比起甜食，我更喜欢薯片这类<w>咸</w>味零食。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unsalty"
                    ],
                    "common_phrases": [
                        "salty taste",
                        "salty food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий вкус соли.",
                        "zh": "有盐味的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солёный",
                                "target_lang_sense_clarification": "о вкусе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "咸",
                                "target_lang_sense_clarification": "形容食物的味道"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bbd1f07-0123-3707-a1de-7c27ba59cccb",
                    "sense_definition": "Containing salt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "salt_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>salty</w> ocean water stung his eyes when he dove in.",
                            "target_lang_translations": {
                                "ru": "<w>Солёная</w> океанская вода защипала ему глаза, когда он нырнул.",
                                "zh": "他潜入水中时，<w>含盐的</w>海水刺痛了他的眼睛。"
                            }
                        },
                        {
                            "text": "Mangroves are plants that are adapted to grow in <w>salty</w> water.",
                            "target_lang_translations": {
                                "ru": "Мангры — это растения, приспособленные расти в <w>солёной</w> воде.",
                                "zh": "红树林是适应在<w>含盐的</w>水中生长的植物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "saline",
                        "briny"
                    ],
                    "antonyms": [
                        "nonsaline"
                    ],
                    "common_phrases": [
                        "salty water",
                        "salty air",
                        "salty tears"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий соль.",
                        "zh": "含有盐分的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солёный",
                                "target_lang_sense_clarification": "о воде, растворах"
                            },
                            {
                                "target_lang_word": "соляной",
                                "target_lang_sense_clarification": "относящийся к добыче или составу соли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "含盐的",
                                "target_lang_sense_clarification": "形容水或溶液"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e3581a4-51ee-38c9-99b8-f57fb8629abc",
                    "sense_definition": "Irritated, annoyed, or bitter, often due to a failure or disappointment.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got really <w>salty</w> after losing the video game match.",
                            "target_lang_translations": {
                                "ru": "Он стал очень <w>раздражённым</w> после проигрыша в матче видеоигры.",
                                "zh": "输掉游戏比赛后，他变得非常<w>恼火</w>。"
                            }
                        },
                        {
                            "text": "There is no need to be <w>salty</w> just because you were not invited.",
                            "target_lang_translations": {
                                "ru": "Нет нужды быть таким <w>обиженным</w> только из-за того, что тебя не пригласили.",
                                "zh": "没必要因为没被邀请就表现得那么<w>愤愤不平</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "get salty",
                        "be salty"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in internet culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздражённый, расстроенный или злой, часто из-за неудачи или разочарования.",
                        "zh": "因失败或失望而感到恼火、不满或愤愤不平。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обиженный",
                                "target_lang_sense_clarification": "чувствующий обиду"
                            },
                            {
                                "target_lang_word": "раздражённый",
                                "target_lang_sense_clarification": "недовольный"
                            },
                            {
                                "target_lang_word": "злой",
                                "target_lang_sense_clarification": "испытывающий злость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恼火",
                                "target_lang_sense_clarification": "形容情绪"
                            },
                            {
                                "target_lang_word": "愤愤不平",
                                "target_lang_sense_clarification": "形容不满的情绪"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "709bf526-f693-317a-94a9-59cf6a81cc53",
                    "sense_definition": "Coarse, provocative, or earthy in style or language.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian is famous for his <w>salty</w> humor that shocks some audiences.",
                            "target_lang_translations": {
                                "ru": "Этот комик известен своим <w>солёным</w> юмором, который шокирует некоторых зрителей.",
                                "zh": "那位喜剧演员以其<w>粗俗</w>的幽默而闻名，这让一些观众感到震惊。"
                            }
                        },
                        {
                            "text": "She gave a <w>salty</w> response to the reporter's rude question.",
                            "target_lang_translations": {
                                "ru": "Она дала <w>едкий</w> ответ на грубый вопрос репортёра.",
                                "zh": "她对记者无礼的问题给出了<w>尖刻</w>的回应。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "salty language",
                        "salty humor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубый, провокационный или непристойный (о стиле или языке).",
                        "zh": "风格或语言粗俗、挑衅或尖刻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солёный",
                                "target_lang_sense_clarification": "остроумный, но грубый или непристойный"
                            },
                            {
                                "target_lang_word": "непристойный",
                                "target_lang_sense_clarification": "грубый"
                            },
                            {
                                "target_lang_word": "едкий",
                                "target_lang_sense_clarification": "язвительный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尖刻",
                                "target_lang_sense_clarification": "形容言语"
                            },
                            {
                                "target_lang_word": "粗俗",
                                "target_lang_sense_clarification": "形容语言风格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a119514a-72b2-3a0c-ba49-e854602f0820",
                    "sense_definition": "Experienced and toughened, typically by life at sea.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>salty</w> old captain told us stories about storms in the Atlantic.",
                            "target_lang_translations": {
                                "ru": "<w>Бывалый</w> старый капитан рассказывал нам истории о штормах в Атлантике.",
                                "zh": "那位<w>老练</w>的老船长给我们讲了他在大西洋遭遇风暴的故事。"
                            }
                        },
                        {
                            "text": "He looked like a <w>salty</w> dog who had spent his whole life on a ship.",
                            "target_lang_translations": {
                                "ru": "Он выглядел как <w>бывалый</w> морской волк, который провёл всю жизнь на корабле.",
                                "zh": "他看起来就像个一辈子都在船上度过的<w>饱经风霜</w>的老水手。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "salty dog"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Опытный и закалённый, обычно жизнью в море.",
                        "zh": "经验丰富且坚韧的，通常指长期在海上生活的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бывалый",
                                "target_lang_sense_clarification": "опытный"
                            },
                            {
                                "target_lang_word": "закалённый",
                                "target_lang_sense_clarification": "выносливый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "老练",
                                "target_lang_sense_clarification": "形容经验丰富"
                            },
                            {
                                "target_lang_word": "饱经风霜",
                                "target_lang_sense_clarification": "形容经历丰富且坚韧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf2b49a0-8581-3703-b5e3-bda27034e6b3",
                    "sense_definition": "Relating to Sardinian or Catalan dialects that use specific articles derived from Latin 'ipse'.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The linguist published a paper on the <w>salty</w> dialects spoken in the Balearic Islands.",
                            "target_lang_translations": {
                                "ru": "Лингвист опубликовал статью о <w>саладских</w> диалектах, на которых говорят на Балеарских островах.",
                                "zh": "那位语言学家发表了一篇关于巴利阿里群岛所用<w>萨拉德语</w>方言的论文。"
                            }
                        },
                        {
                            "text": "This specific article usage is a key feature of the <w>salty</w> language group.",
                            "target_lang_translations": {
                                "ru": "Это специфическое использование артиклей является ключевой особенностью <w>саладской</w> языковой группы.",
                                "zh": "这种特定的冠词用法是<w>萨拉德语</w>族群的一个关键特征。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к сардинским или каталанским диалектам, использующим определённые артикли, происходящие от латинского 'ipse'.",
                        "zh": "指使用源自拉丁语“ipse”的特定冠词的撒丁语或加泰罗尼亚语方言。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "саладский",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "萨拉德语",
                                "target_lang_sense_clarification": "语言学术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}