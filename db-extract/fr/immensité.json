                                    {
                                        "sense_id": "297592bc-8a96-3496-86a2-7080b6e2866b",
                                        "entry_id": "154d2710-1e7f-3b32-a416-b815050fb791",
                                        "glosses": [
                                            "The quality of being vast."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "043bcfc5-f1ab-408d-b8bb-b83f8ac5fbd2",
                                                "sense_id": "297592bc-8a96-3496-86a2-7080b6e2866b",
                                                "text": "He was thinking; but the glory of the song, the swell from the great organ, the clustered lights, […], the height and vastness of this noble fane, its antiquity and its strength—all these things seemed to have their part as causes of the thrilling emotion that accompanied his thoughts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9bcbc8a-4248-3285-8c0b-bdcd5f717a29",
                                        "entry_id": "154d2710-1e7f-3b32-a416-b815050fb791",
                                        "glosses": [
                                            "Something vast."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7567b018-ed29-488f-b27a-3e2e996ac6b8",
                                                "sense_id": "f9bcbc8a-4248-3285-8c0b-bdcd5f717a29",
                                                "text": "He had a feeling that he was lost in the vastness of a huge forest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
