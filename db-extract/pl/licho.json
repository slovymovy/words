                ],
                "translations": [
                    {
                        "translation_id": "fe5f0c28-117d-4f5a-a566-d17e255d9ef9",
                        "source_entry_id": "de09dfce-62e4-3b5e-a599-cd6fd1b853d2",
                        "source_sense_id": "79d43bfa-2cd1-372b-954a-6c6ded700636",
                        "target_lang_word": "лихо",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лихо",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d3ccf829-3ca4-3f59-a7ec-c5b0175bb126",
                                        "entry_id": "3d3f85e3-1d5b-39e1-9936-b426931cdece",
                                        "glosses": [
                                            "устар., поэт. зло, беда"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4e8efda-6117-4306-b433-57d3c5ef73e7",
                                                "sense_id": "d3ccf829-3ca4-3f59-a7ec-c5b0175bb126",
                                                "text": "Скажешь правду, не узнаешь лиха."
                                            },
                                            {
                                                "example_id": "f41c5cfc-02e7-4a81-8a49-c0cdf7583ed9",
                                                "sense_id": "d3ccf829-3ca4-3f59-a7ec-c5b0175bb126",
                                                "text": "Она грозила лихами, // Сожжением дотла. // Её мы кляли истово, // Как несыть и как сыть, — // Исчадие Мефистово, // Исчезни, сгинь, изыдь!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "лихо",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bc66f7cc-4534-34e4-b263-60802ea1adc0",
                                        "entry_id": "0112c2fe-97b4-31aa-bf9f-aa37961e23db",
                                        "glosses": [
                                            "разг. быстро, споро, ладно; залихватски, бойко, щегольски"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c000f4a0-976e-4146-9fa1-7bef00c4d036",
                                                "sense_id": "bc66f7cc-4534-34e4-b263-60802ea1adc0",
                                                "text": "Он посмотрел на меня пронзительно, лихо улыбаясь необыкновенной красоты глазами."
                                            },
                                            {
                                                "example_id": "3bfa50e1-1243-4c15-8a5b-3bb1674e2298",
                                                "sense_id": "bc66f7cc-4534-34e4-b263-60802ea1adc0",
                                                "text": "Но среди помощников его, особенно среди командиров эскадронов, всё ещё было много народу, умеющего лихо рубить шашкой и кричать «ура», но не привыкшего шевелить мозгами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02e3eb63-bbd8-3fa8-84f2-84f960438310",
                                        "entry_id": "0112c2fe-97b4-31aa-bf9f-aa37961e23db",
                                        "glosses": [
                                            "разг., устар. тягостно, тяжко, губительно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b144894-a5ed-43b3-9606-f1473cac18e6",
                                                "sense_id": "02e3eb63-bbd8-3fa8-84f2-84f960438310",
                                                "text": "Смотрит — видит дело лихо: // Бьётся лебедь средь зыбей, // Коршун носится над ней."
                                            },
                                            {
                                                "example_id": "f3408483-6389-4f5a-92be-7b6298d4d71c",
                                                "sense_id": "02e3eb63-bbd8-3fa8-84f2-84f960438310",
                                                "text": "Лихо пришлось ему на чужой стороне."
                                            }
                                        ]
                                    }
                                ]
                            },
