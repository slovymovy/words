                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c96f61a6-1fd4-4715-9787-def660173c73",
                                "sense_id": "a70db71e-aef7-3c45-b9b6-fe70b187e144",
                                "text": "Le système complet a la capacité de s'auto-stériliser avec de la vapeur pure auto-générée et ceci avant le démarrage de la production."
                            },
                            {
                                "example_id": "38139a14-762d-4d90-8e90-a6855e85e891",
                                "sense_id": "a70db71e-aef7-3c45-b9b6-fe70b187e144",
                                "text": "Ce milieu permet d'éradiquer des micro-organismes et/ou des toxines plus efficacement que les solutions de la technique antérieure et peut aussi s'auto-stériliser."
                            },
                            {
                                "example_id": "cc28dab8-619e-4f69-89ab-597e980880b4",
                                "sense_id": "a70db71e-aef7-3c45-b9b6-fe70b187e144",
                                "text": "Versez dans les bocaux, fermez aussitôt et retournez les pots pour les \"auto-stériliser\"."
                            }
                        ]
