                "senses": [
                    {
                        "sense_id": "70a1da80-d8cc-3359-b586-ca38cf9d82bb",
                        "entry_id": "5c24248c-42b9-3bcf-b60f-51eca1c13c1a",
                        "glosses": [
                            "Fels, der aus dem umgebenden Gelände hervorsteht/der übersteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d5edbbb-c1ba-44de-8b2d-1013ecbb82db",
                                "sense_id": "70a1da80-d8cc-3359-b586-ca38cf9d82bb",
                                "text": "„Ich lachte, als ich auf einem Felsvorsprung ein Bruchstück eines alten Spiegels fand.“"
                            },
                            {
                                "example_id": "152e7e71-5ade-49af-a200-a08f8c37f598",
                                "sense_id": "70a1da80-d8cc-3359-b586-ca38cf9d82bb",
                                "text": "„Zu Fuß erreichen wir eine Stelle, an der sich fünf Wasserfälle mehrere Hundert Meter senkrecht in ein enges Tal stürzen, dessen Grund wir vom Felsvorsprung nicht erkennen können.“"
                            },
                            {
                                "example_id": "ac5b2e01-a042-4245-a882-d6525b9961b5",
                                "sense_id": "70a1da80-d8cc-3359-b586-ca38cf9d82bb",
                                "text": "„Der Felsvorsprung schützte sie einigermaßen vor dem Wind, so daß sie sich wieder miteinander verständigen konnten.“"
                            },
                            {
                                "example_id": "d385a621-1282-4ddf-879a-0777e009170e",
                                "sense_id": "70a1da80-d8cc-3359-b586-ca38cf9d82bb",
                                "text": "„Sie verlor fast das Gleichgewicht auf dem rutschigen Felsvorsprung und hielt sich reflexartig an Sævar fest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
