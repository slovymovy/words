                ],
                "senses": [
                    {
                        "sense_id": "d8848a52-a1e1-3f31-b4f8-698013813d9b",
                        "entry_id": "5ef675d6-b8d7-306a-8191-30323d9814e2",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc9d9b7d-e298-4e42-8e95-c0a0bc29f530",
                                "sense_id": "d8848a52-a1e1-3f31-b4f8-698013813d9b",
                                "text": "Frau Kiesele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9a58ae40-8d5d-4c64-9f65-9b2f61bf1bb5",
                                "sense_id": "d8848a52-a1e1-3f31-b4f8-698013813d9b",
                                "text": "Herr Kiesele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b3402b00-b2f5-445b-a2a1-1f35809de3c9",
                                "sense_id": "d8848a52-a1e1-3f31-b4f8-698013813d9b",
                                "text": "Die Kieseles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "9fece855-98c6-447f-bbd9-059173554824",
                                "sense_id": "d8848a52-a1e1-3f31-b4f8-698013813d9b",
                                "text": "Der Kiesele trägt nie die Pullover, die die Kiesele ihm strickt."
                            },
                            {
                                "example_id": "cd2628a1-9655-4686-87a4-7300ecfa6701",
                                "sense_id": "d8848a52-a1e1-3f31-b4f8-698013813d9b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kiesele kommt, geht der Herr Kiesele.“"
                            },
                            {
                                "example_id": "bf9fd320-fa43-4a2b-99a6-0336a40da988",
                                "sense_id": "d8848a52-a1e1-3f31-b4f8-698013813d9b",
                                "text": "Kiesele kommt und geht."
                            },
                            {
                                "example_id": "a6c1379f-6183-4e5d-8d91-1b92111d27e8",
                                "sense_id": "d8848a52-a1e1-3f31-b4f8-698013813d9b",
                                "text": "Kieseles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
