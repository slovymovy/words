                        "sense_id": "7d9432bc-c2dc-3224-be8e-f3ffded042b7",
                        "entry_id": "f0d352f6-a13a-3233-b22b-c93d35f4b3a5",
                        "glosses": [
                            "eher seltenes, rückbezügliches Pronomen, das dem zugehörigen Wort die Ursache für den im Satz geschilderten Sachverhalt zuweist, kann als Relativ- oder Demonstrativpronomen verwendet werden"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a30228be-372a-3377-b624-500f1bb28834",
                        "entry_id": "f0d352f6-a13a-3233-b22b-c93d35f4b3a5",
                        "glosses": [
                            "weil das durch diesen Umstand so verursacht ist, dass"
                        ],
                        "tags": [
                            "Relativadverb"
                        ],
                        "examples": [
                            {
                                "example_id": "7070c604-4bb0-4df5-9918-d4b58d58bff5",
                                "sense_id": "a30228be-372a-3377-b624-500f1bb28834",
                                "text": "Den Güterverkehr, dessentwegen dieser Aufwand betrieben wurde, gibt es nicht mehr."
                            },
                            {
                                "example_id": "9da6a307-2373-43bc-9776-d6d79686a023",
                                "sense_id": "a30228be-372a-3377-b624-500f1bb28834",
                                "text": "Wird im ersuchten Staat gegen die gesuchte Person gerichtlich vorgegangen oder verbüßt sie dort eine Strafe wegen eines anderen Verbrechens als desjenigen, dessentwegen die Überstellung an den Gerichtshof verlangt wird, so konsultiert der ersuchte Staat den Gerichtshof, nachdem er beschlossen hat, dem Ersuchen stattzugeben. (Artikel 89 (4) des Römischen Statuts des Internationalen Strafgerichtshofs)"
                            },
                            {
                                "example_id": "cc8fda2c-83ff-45c2-aa66-2d22c7378e8b",
                                "sense_id": "a30228be-372a-3377-b624-500f1bb28834",
                                "text": "„Doch nun zu dem Problem, dessentwegen ich dieses Vorwort verfasse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4ab00b40-7ad8-3d54-a45c-bf60fe7033a6",
                        "entry_id": "f0d352f6-a13a-3233-b22b-c93d35f4b3a5",
                        "glosses": [
                            "wegen dieser Person oder aufgrund dieses Sachverhaltes"
                        ],
                        "tags": [
                            "Demonstrativadverb"
                        ],
                        "examples": [
                            {
                                "example_id": "28234929-3f19-4e96-870e-440ae9c9b14f",
                                "sense_id": "4ab00b40-7ad8-3d54-a45c-bf60fe7033a6",
                                "text": "Der Direktor kündigte dem Abteilungsleiter. Dessentwegen hatte die Firma einen lukrativen Auftrag verpasst."
                            },
                            {
                                "example_id": "0a72473c-375d-4c4d-bf9e-799d6e97f765",
                                "sense_id": "4ab00b40-7ad8-3d54-a45c-bf60fe7033a6",
                                "text": "Die Straße war von Geröll übersät. Wir mussten dessentwegen einen Riesenumweg fahren."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
