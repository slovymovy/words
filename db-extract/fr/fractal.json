                                "target_senses": [
                                    {
                                        "sense_id": "bd6120c5-fb68-3665-aeff-ba23962371b6",
                                        "entry_id": "50a6a9b5-867e-3c01-8cec-97c8c3d53e27",
                                        "glosses": [
                                            "geometrisch vielfach gebrochen, zerklüftet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64c558df-4884-4f20-a1a3-68dba1883c12",
                                                "sense_id": "bd6120c5-fb68-3665-aeff-ba23962371b6",
                                                "text": "„Das besondere ist, dass die fraktale Dimension keine ganze Zahl sein muss.“"
                                            },
                                            {
                                                "example_id": "108bbce5-edf5-4151-8179-26b7e52b566c",
                                                "sense_id": "bd6120c5-fb68-3665-aeff-ba23962371b6",
                                                "text": "„Die fraktale Geometrie enthüllt außerdem ein bis jetzt verborgenes Antlitz der formalsten Kapitel der Mathematik: eine Welt voller Schönheiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4862586-4f4d-4e77-bbf4-aee5898a32bb",
                        "source_entry_id": "2e4dfc57-0be2-39d8-a55e-8cef3fe0edd7",
                        "source_sense_id": "5ef0bb73-0a7a-302c-b264-d7a45e87d5eb",
                        "target_lang_word": "fractal",
