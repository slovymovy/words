                        "glosses": [
                            "Zusammenschluss von Personen, die auf dem gleichen Gebiet tätig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7314fceb-c8ce-4268-aff0-8cc787f1861a",
                                "sense_id": "6e89c26f-ab9b-3958-a5e5-10a11a352dfb",
                                "text": "„Der Staatsbeitrag ist ein Zuschuß zu der Arbeitslosenunterstützung, die die Fachorganisation aus ihren eigenen Mitteln zahlt (§ 3 Abs. 1 des Gesetzes vom 19. Juli 1921).“"
                            },
                            {
                                "example_id": "f8498434-8fd0-4bb4-863c-7c78fdba82d7",
                                "sense_id": "6e89c26f-ab9b-3958-a5e5-10a11a352dfb",
                                "text": "„Sie reklamiert für sich, seit 1964 die Fachorganisation der Erziehungswissenschaft in Deutschland zu sein (vgl. Homepage der DGfE1).“"
                            }
                        ],
