                    {
                        "sense_id": "3cedf563-dbf7-3686-8e3a-ed1d9732f876",
                        "entry_id": "f2cb29eb-81d4-3a33-b7f3-19facb052a22",
                        "glosses": [
                            "Première foncée d’une ardoisière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50f5bba3-0cc0-47f2-b728-1a4997bd5d6a",
                                "sense_id": "3cedf563-dbf7-3686-8e3a-ed1d9732f876",
                                "text": "Quand on veut établir un chantier, on commence par enlever une épaisseur d'environ 0ᵐ 90 de schiste sur toute l'étendue que doit avoir le chantier. Cette opération qui s'appelle le crabotage est très-pénible, car elle oblige l'ouvrier à travailler à demi-couché ; elle se fait tantôt au pic, tantôt à la poudre."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2ba5f83-a48b-33de-ba6a-3c802de5fd49",
                        "entry_id": "f2cb29eb-81d4-3a33-b7f3-19facb052a22",
                        "glosses": [
                            "Accouplement par clabot ou crabot."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "98b97deb-95d9-3ac0-8fa5-16a66a22a661",
                        "entry_id": "f2cb29eb-81d4-3a33-b7f3-19facb052a22",
                        "glosses": [
                            "Cette fonction elle-même."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "700e51da-8f15-4c61-b89a-aefdcc156fac",
                                "sense_id": "98b97deb-95d9-3ac0-8fa5-16a66a22a661",
                                "text": "Dans les locutions, mettre, enclencher.. le crabotage, pour un conducteur d’un tracteur, d’un 4x4 ou d’engin tout terrain, action de choisir un mode d’entrainement spécifique à sa machine privilégiant le couple de transmission."
                            },
                            {
                                "example_id": "e541c898-a396-415d-97af-374f67947929",
                                "sense_id": "98b97deb-95d9-3ac0-8fa5-16a66a22a661",
                                "text": "Sur les boîtes synchronisées, en complément des crabots est installé un synchroniseur qui, comme son nom l’indique, permet, préalablement au crabotage, de synchroniser la vitesse d’un pignon (liée au régime moteur au rapport de transmission près) et la vitesse de l’arbre de sortie (liée à la vitesse des roues)."
                            },
                            {
                                "example_id": "8378bdcb-a0b6-4a10-a230-502cab1b6d1c",
                                "sense_id": "98b97deb-95d9-3ac0-8fa5-16a66a22a661",
                                "text": "Sur une toyota avec crabotage manuel ya H2 H4 N 4L ok ! (http://www.forum4x4.org/threads/105601-crabotage)"
                            }
                        ]
                    }
