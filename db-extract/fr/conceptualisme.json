                        "target_lang_word": "conceitualismo",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conceitualismo",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "7e9d9693-9c05-3d33-8a95-f2722fd67c7b",
                                        "entry_id": "62551abd-833b-3442-acbb-60f766d92d2f",
                                        "glosses": [
                                            "doutrina intermediária entre o nominalismo e o realismo, segundo a qual os universais não existem como entidades reais independentes, mas também não são meros nomes; são conceitos que existem apenas na mente humana, derivados da observação das coisas"
                                        ],
                                        "tags": [
                                            "filosofia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c71d092-1920-4f48-86c9-c411ebbfafc5",
                                                "sense_id": "7e9d9693-9c05-3d33-8a95-f2722fd67c7b",
                                                "text": "O conceitualismo medieval sustentava que os universais eram representações mentais com base na realidade, mas sem existência própria fora dela"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e1800b8-8158-3305-8985-df300dff8e5b",
                                        "entry_id": "62551abd-833b-3442-acbb-60f766d92d2f",
                                        "glosses": [
                                            "corrente estética que valoriza a primazia das ideias e conceitos sobre a forma material da obra, aproximando-se da arte conceitual"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d453869e-efc9-4711-89ab-aa2625b2a477",
                                                "sense_id": "7e1800b8-8158-3305-8985-df300dff8e5b",
                                                "text": "O conceitualismo artístico do século XX enfatizou a importância do conceito em detrimento do objeto físico"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
