                        "examples": [
                            {
                                "example_id": "9053e963-a3a7-4848-b6c4-c4e385d36884",
                                "sense_id": "72201587-f993-38a1-a651-cae7478e9095",
                                "text": "Médiums sensitifs ou impressibles."
                            },
                            {
                                "example_id": "b68a2b98-e962-4d78-9e0d-49575a8ef76e",
                                "sense_id": "72201587-f993-38a1-a651-cae7478e9095",
                                "text": "Si la mélancolie nous gagne infailliblement lorsque nous sommes au bord des eaux, une autre loi de notre nature impressible fait que, sur les montagnes, nos sentiments s’épurent."
                            },
                            {
                                "example_id": "44cfcc46-947f-4fc5-b2ef-7abb09c06bf2",
                                "sense_id": "72201587-f993-38a1-a651-cae7478e9095",
                                "text": "Louis m’inspira d’autant mieux sa passion pour l’espèce de sommeil dans lequel les contemplations profondes plongent le corps, que j’étais plus jeune et plus impressible."
                            },
                            {
                                "example_id": "af359ec9-d0ae-4f63-840d-1fdf6ba0252e",
                                "sense_id": "72201587-f993-38a1-a651-cae7478e9095",
                                "text": "La rue de la Paix est une large rue, une grande rue ; mais elle ne réveille aucune des pensées gracieusement nobles qui surprennent une âme impressible au milieu de la rue Royale."
                            }
                        ]
                    }
