{
    "word_family": [
        "roast",
        "roaster"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dc32addb-f861-3649-95b9-3ec031c83af0",
                    "sense_definition": "Very hot.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The afternoon sun was <w>roasting</w> as we walked across the desert.",
                            "target_lang_translations": {
                                "ru": "Послеполуденное солнце было <w>знойным</w>, пока мы шли через пустыню."
                            }
                        },
                        {
                            "text": "It is absolutely <w>roasting</w> in this small room without any air conditioning.",
                            "target_lang_translations": {
                                "ru": "В этой маленькой комнате без кондиционера просто <w>невыносимо жарко</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "scorching",
                        "sweltering"
                    ],
                    "antonyms": [
                        "freezing"
                    ],
                    "common_phrases": [
                        "roasting hot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень жаркий, знойный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знойный",
                                "target_lang_sense_clarification": "о погоде или климате"
                            },
                            {
                                "target_lang_word": "жаркий",
                                "target_lang_sense_clarification": "общая характеристика высокой температуры"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e10a9ff3-456c-3fce-9bbf-25b18e16195b",
                    "sense_definition": "A strong rebuke or reprimand.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager gave the team a severe <w>roasting</w> for missing the project deadline.",
                            "target_lang_translations": {
                                "ru": "Менеджер устроил команде суровый <w>разнос</w> за срыв сроков проекта."
                            }
                        },
                        {
                            "text": "After the poor performance, the coach gave the players a real <w>roasting</w> in the locker room.",
                            "target_lang_translations": {
                                "ru": "После неудачного выступления тренер устроил игрокам настоящий <w>нагоняй</w> в раздевалке."
                            }
                        }
                    ],
                    "synonyms": [
                        "scolding",
                        "reprimand"
                    ],
                    "common_phrases": [
                        "give a roasting"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in informal British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Строгий выговор или разнос."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разнос",
                                "target_lang_sense_clarification": "разговорный вариант строгого выговора"
                            },
                            {
                                "target_lang_word": "нагоняй",
                                "target_lang_sense_clarification": "разговорное выражение для сурового замечания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0d92814-210a-3d27-a813-e8dab810753e",
                    "sense_definition": "The process of cooking something by exposure to dry heat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>roasting</w> of the coffee beans brings out a rich and deep flavor.",
                            "target_lang_translations": {
                                "ru": "<w>Обжаривание</w> кофейных зерен раскрывает их насыщенный и глубокий вкус."
                            }
                        },
                        {
                            "text": "Proper <w>roasting</w> of the turkey ensures the skin becomes crispy and golden brown.",
                            "target_lang_translations": {
                                "ru": "Правильное <w>запекание</w> индейки гарантирует, что кожица станет хрустящей и золотисто-коричневой."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс приготовления пищи путем воздействия сухого жара."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запекание",
                                "target_lang_sense_clarification": "приготовление в духовке"
                            },
                            {
                                "target_lang_word": "обжаривание",
                                "target_lang_sense_clarification": "процесс термической обработки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cfcdc5a1-bca7-3ede-aa06-5178188ea5ab",
                    "sense_definition": "Present participle and gerund of <w>roast</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>roasting</w> a chicken for dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Она <w>запекает</w> курицу на сегодняшний ужин."
                            }
                        },
                        {
                            "text": "We spent the afternoon <w>roasting</w> vegetables in the oven.",
                            "target_lang_translations": {
                                "ru": "Мы провели день, <w>запекая</w> овощи в духовке."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «жарить» или «запекать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запекающий",
                                "target_lang_sense_clarification": "причастие"
                            },
                            {
                                "target_lang_word": "запекание",
                                "target_lang_sense_clarification": "герундий"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}