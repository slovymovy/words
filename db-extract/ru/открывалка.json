                                    },
                                    {
                                        "sense_id": "26a94cf7-10b9-3a76-97d5-63e94481c860",
                                        "entry_id": "d8cfa136-dc8e-368a-aff0-5c13094c7fc6",
                                        "glosses": [
                                            "A tool for safe-cracking."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5eb7421-41b8-4a72-bfa9-62a31679b2af",
                                                "sense_id": "26a94cf7-10b9-3a76-97d5-63e94481c860",
                                                "text": "Even the work of opening a safe with nitroglycerine or with a can opener places the criminal in a state of nervous tension."
                                            },
                                            {
                                                "example_id": "79caa70c-af3c-449e-9761-80ee300681cf",
                                                "sense_id": "26a94cf7-10b9-3a76-97d5-63e94481c860",
                                                "text": "“I wonder why they didn't use 'soup' (nitroglycerine) snuffing the drum (blowing safe) instead of a 'can-opener,” (3 ft. steel rod, pointed one end to punch starting hole in bottom of safe, other end shaped like a can opener to peal^([sic]) the bottom of safe open.) commented McLaughlin? ^([sic])"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "925c8842-79e7-3bf2-af67-f9d5673c523e",
                                        "entry_id": "d8cfa136-dc8e-368a-aff0-5c13094c7fc6",
                                        "glosses": [
                                            "A ramming maneuver, that opens up the target ship like a tin can."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3080507-a70a-3b30-b81b-da8590987ede",
                                        "entry_id": "d8cfa136-dc8e-368a-aff0-5c13094c7fc6",
                                        "glosses": [
                                            "An anti-tank munition or attack vehicle, that opens up armour like a tin can."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
