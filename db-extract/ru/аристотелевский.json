                                    {
                                        "sense_id": "004a7b49-54c7-3528-93a2-3a49f4605859",
                                        "entry_id": "4f77d23a-9ab4-3d05-9995-21a17657757b",
                                        "glosses": [
                                            "gemäß der Lehre des Aristoteles"
