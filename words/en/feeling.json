{
    "word_family": [
        "feel",
        "feeler",
        "unfeeling",
        "feelingly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8df5a620-9611-3ea6-8ad7-792c4e2b8c76",
                    "sense_definition": "An emotion or emotional reaction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotion_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie left me with a <w>feeling</w> of sadness.",
                            "target_lang_translations": {
                                "ru": "Фильм оставил у меня <w>чувство</w> грусти.",
                                "de": "Der Film hinterließ bei mir ein <w>Gefühl</w> der Traurigkeit.",
                                "zh": "这部电影让我产生了一种悲伤的<w>感觉</w>。"
                            }
                        },
                        {
                            "text": "She had a <w>feeling</w> of joy when she saw her family.",
                            "target_lang_translations": {
                                "ru": "Она испытала <w>чувство</w> радости, когда увидела свою семью.",
                                "de": "Sie hatte ein <w>Gefühl</w> der Freude, als sie ihre Familie sah.",
                                "zh": "见到家人时，她心中涌起一股喜悦的<w>感觉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "emotion",
                        "sense"
                    ],
                    "antonyms": [
                        "apathy"
                    ],
                    "common_phrases": [
                        "feeling of joy",
                        "bad feeling",
                        "good feeling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эмоция или эмоциональная реакция.",
                        "de": "Eine Emotion oder eine emotionale Reaktion.",
                        "zh": "一种情绪或情感反应。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чу́вство",
                                "target_lang_sense_clarification": "эмоция"
                            },
                            {
                                "target_lang_word": "ощуще́ние",
                                "target_lang_sense_clarification": "переживание"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Gefühl",
                                "target_lang_sense_clarification": "emotionaler Zustand"
                            },
                            {
                                "target_lang_word": "Emotion",
                                "target_lang_sense_clarification": "psychische Erregung"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感觉",
                                "target_lang_sense_clarification": "情绪或心理状态"
                            },
                            {
                                "target_lang_word": "心情",
                                "target_lang_sense_clarification": "情绪状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "033a9968-4b5c-379f-a3ae-74eb4a5ab44f",
                    "sense_definition": "A physical sensation experienced through the body or skin.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have lost all <w>feeling</w> in my toes because of the cold.",
                            "target_lang_translations": {
                                "ru": "Я потерял всякую <w>чувствительность</w> в пальцах ног из-за холода.",
                                "de": "Ich habe wegen der Kälte jedes <w>Gefühl</w> in meinen Zehen verloren.",
                                "zh": "因为太冷，我的脚趾已经完全失去了<w>知觉</w>。"
                            }
                        },
                        {
                            "text": "The warm sun on my face was a pleasant <w>feeling</w>.",
                            "target_lang_translations": {
                                "ru": "Теплое солнце на моем лице вызывало приятное <w>ощущение</w>.",
                                "de": "Die warme Sonne auf meinem Gesicht war ein angenehmes <w>Gefühl</w>.",
                                "zh": "温暖的阳光照在脸上，那是一种舒适的<w>感觉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sensation",
                        "touch",
                        "sense"
                    ],
                    "antonyms": [
                        "numbness"
                    ],
                    "common_phrases": [
                        "loss of feeling",
                        "feeling of warmth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое ощущение, испытываемое телом или кожей.",
                        "de": "Eine körperliche Empfindung, die durch den Körper oder die Haut wahrgenommen wird.",
                        "zh": "通过身体或皮肤体验到的物理感知。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ощуще́ние",
                                "target_lang_sense_clarification": "физическое восприятие"
                            },
                            {
                                "target_lang_word": "чувстви́тельность",
                                "target_lang_sense_clarification": "способность ощущать"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Gefühl",
                                "target_lang_sense_clarification": "Sinneswahrnehmung"
                            },
                            {
                                "target_lang_word": "Empfindung",
                                "target_lang_sense_clarification": "körperliche Wahrnehmung"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感觉",
                                "target_lang_sense_clarification": "物理感知"
                            },
                            {
                                "target_lang_word": "知觉",
                                "target_lang_sense_clarification": "生理上的感知能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37b41a2c-2fbf-32bc-b0e1-a9ffeaf508aa",
                    "sense_definition": "An intuition or belief that something is true without proof.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mental_perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have a <w>feeling</w> that it is going to rain today.",
                            "target_lang_translations": {
                                "ru": "У меня <w>предчувствие</w>, что сегодня пойдет дождь.",
                                "de": "Ich habe das <w>Gefühl</w>, dass es heute regnen wird.",
                                "zh": "我有一种<w>预感</w>，今天会下雨。"
                            }
                        },
                        {
                            "text": "She had a gut <w>feeling</w> that something was wrong.",
                            "target_lang_translations": {
                                "ru": "У нее было внутреннее <w>чувство</w>, что что-то не так.",
                                "de": "Sie hatte ein Bauch<w>gefühl</w>, dass etwas nicht stimmte.",
                                "zh": "她有一种直觉，觉得哪里不对劲。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hunch",
                        "intuition",
                        "impression",
                        "suspicion",
                        "inkling"
                    ],
                    "common_phrases": [
                        "gut feeling",
                        "funny feeling",
                        "feeling that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Интуиция или вера в то, что что-то является правдой, без доказательств.",
                        "de": "Eine Intuition oder der Glaube, dass etwas wahr ist, ohne Beweise.",
                        "zh": "在没有证据的情况下，对某事真实性的直觉或信念。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предчу́вствие",
                                "target_lang_sense_clarification": "интуиция"
                            },
                            {
                                "target_lang_word": "ощуще́ние",
                                "target_lang_sense_clarification": "внутреннее убеждение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Gefühl",
                                "target_lang_sense_clarification": "Einschätzung ohne Überlegung"
                            },
                            {
                                "target_lang_word": "Vorahnung",
                                "target_lang_sense_clarification": "intuitives Wissen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预感",
                                "target_lang_sense_clarification": "直觉"
                            },
                            {
                                "target_lang_word": "直觉",
                                "target_lang_sense_clarification": "凭感觉判断"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a15f4a9-6d7c-301d-8760-b6b19bea89c8",
                    "sense_definition": "A person's emotional state or sensitivities, especially regarding being offended.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I hope I did not hurt your <w>feelings</w> with my comment.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, я не задел твои <w>чувства</w> своим комментарием.",
                                "de": "Ich hoffe, ich habe deine <w>Gefühle</w> mit meinem Kommentar nicht verletzt.",
                                "zh": "希望我的评论没有伤害到你的<w>感情</w>。"
                            }
                        },
                        {
                            "text": "There are no hard <w>feelings</w> between us after the argument.",
                            "target_lang_translations": {
                                "ru": "После ссоры между нами не осталось <w>обид</w>.",
                                "de": "Nach dem Streit gibt es zwischen uns keine bösen <w>Gefühle</w>.",
                                "zh": "争吵过后，我们之间并没有留下什么<w>芥蒂</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sensibilities",
                        "emotions",
                        "sentiments"
                    ],
                    "common_phrases": [
                        "hurt feelings",
                        "hard feelings"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эмоциональное состояние или уязвимость человека, особенно в отношении обид.",
                        "de": "Der emotionale Zustand oder die Empfindlichkeit einer Person, besonders in Bezug auf Kränkungen.",
                        "zh": "一个人的情感状态或敏感度，尤指容易受到伤害的心理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чу́вства",
                                "target_lang_sense_clarification": "эмоции, душевное состояние"
                            },
                            {
                                "target_lang_word": "самолю́бие",
                                "target_lang_sense_clarification": "чувство собственного достоинства"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Gefühle",
                                "target_lang_sense_clarification": "emotionales Befinden"
                            },
                            {
                                "target_lang_word": "Empfindlichkeit",
                                "target_lang_sense_clarification": "Verletzlichkeit"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感情",
                                "target_lang_sense_clarification": "心理感受"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55b1daab-b3a9-3daf-b645-a5567a19f03e",
                    "sense_definition": "Emotional attraction, love, or affection for someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion_romantic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He still has strong <w>feelings</w> for his first love.",
                            "target_lang_translations": {
                                "ru": "У него все еще сильные <w>чувства</w> к своей первой любви.",
                                "de": "Er hat immer noch starke <w>Gefühle</w> für seine erste Liebe.",
                                "zh": "他对初恋依然怀有深厚的<w>感情</w>。"
                            }
                        },
                        {
                            "text": "It is difficult to hide your <w>feelings</w> when you like someone.",
                            "target_lang_translations": {
                                "ru": "Трудно скрывать свои <w>чувства</w>, когда тебе кто-то нравится.",
                                "de": "Es ist schwer, seine <w>Gefühle</w> zu verbergen, wenn man jemanden mag.",
                                "zh": "当你喜欢一个人时，很难隐藏自己的<w>感情</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "affection",
                        "love"
                    ],
                    "common_phrases": [
                        "have feelings for",
                        "catch feelings"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эмоциональное влечение, любовь или привязанность к кому-либо.",
                        "de": "Emotionale Anziehung, Liebe oder Zuneigung zu jemandem.",
                        "zh": "对某人的情感吸引、爱或依恋。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чу́вства",
                                "target_lang_sense_clarification": "любовь, привязанность"
                            },
                            {
                                "target_lang_word": "симпа́тия",
                                "target_lang_sense_clarification": "влечение, расположение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Gefühle",
                                "target_lang_sense_clarification": "Zuneigung oder Liebe"
                            },
                            {
                                "target_lang_word": "Sympathie",
                                "target_lang_sense_clarification": "Zuneigung"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感情",
                                "target_lang_sense_clarification": "爱慕之情"
                            },
                            {
                                "target_lang_word": "好感",
                                "target_lang_sense_clarification": "喜欢某人的感觉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8e4c2c8-41b0-372c-9951-429e49c1a62c",
                    "sense_definition": "An opinion, attitude, or general view about something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My personal <w>feeling</w> is that we should wait a bit longer.",
                            "target_lang_translations": {
                                "ru": "Мое личное <w>мнение</w> таково, что нам следует подождать еще немного.",
                                "de": "Mein persönliches <w>Gefühl</w> ist, dass wir noch etwas warten sollten.",
                                "zh": "我个人的<w>看法</w>是，我们应该再等一会儿。"
                            }
                        },
                        {
                            "text": "The general <w>feeling</w> in the meeting was one of optimism.",
                            "target_lang_translations": {
                                "ru": "Общим <w>настроением</w> на встрече был оптимизм.",
                                "de": "Die allgemeine <w>Stimmung</w> bei dem Treffen war von Optimismus geprägt.",
                                "zh": "会议上的总体<w>氛围</w>是乐观的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "opinion",
                        "view",
                        "belief"
                    ],
                    "common_phrases": [
                        "general feeling",
                        "my feeling is"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мнение, отношение или общий взгляд на что-либо.",
                        "de": "Eine Meinung, Einstellung oder allgemeine Sichtweise zu etwas.",
                        "zh": "对某事的意见、态度或总体看法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мне́ние",
                                "target_lang_sense_clarification": "взгляд, точка зрения"
                            },
                            {
                                "target_lang_word": "ощуще́ние",
                                "target_lang_sense_clarification": "впечатление"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Meinung",
                                "target_lang_sense_clarification": "persönliche Ansicht"
                            },
                            {
                                "target_lang_word": "Stimmung",
                                "target_lang_sense_clarification": "allgemeine Atmosphäre"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "看法",
                                "target_lang_sense_clarification": "观点"
                            },
                            {
                                "target_lang_word": "氛围",
                                "target_lang_sense_clarification": "整体感受"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ffe0a988-1b73-30b3-86ab-2ef7fbef7061",
                    "sense_definition": "The present participle of <w>feel</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>feeling</w> much better after sleeping.",
                            "target_lang_translations": {
                                "ru": "Я <w>чувствую</w> себя намного лучше после сна.",
                                "de": "Ich <w>fühle</w> mich nach dem Schlafen viel besser.",
                                "zh": "睡了一觉后，我<w>感觉</w>好多了。"
                            }
                        },
                        {
                            "text": "Are you <w>feeling</w> cold in this room?",
                            "target_lang_translations": {
                                "ru": "Ты <w>чувствуешь</w> холод в этой комнате?",
                                "de": "<w>Fühlst</w> du dich in diesem Raum kalt?",
                                "zh": "你在这个房间里<w>感觉</w>冷吗？"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола <w>feel</w>.",
                        "de": "Das Partizip Präsens von fühlen.",
                        "zh": "动词 feel 的现在分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чу́вствующий",
                                "target_lang_sense_clarification": "причастие"
                            },
                            {
                                "target_lang_word": "чу́вствовать",
                                "target_lang_sense_clarification": "глагол (ощущать)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fühlend",
                                "target_lang_sense_clarification": "Partizip"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感觉",
                                "target_lang_sense_clarification": "动词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "73f94836-7c78-3127-9f7a-d19dc4eacbc9",
                    "sense_definition": "Showing or expressing deep emotion and sensitivity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "adjective_sensitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave a <w>feeling</w> performance that moved the audience to tears.",
                            "target_lang_translations": {
                                "ru": "Она дала <w>проникновенное</w> представление, которое довело зрителей до слез.",
                                "de": "Sie lieferte eine <w>gefühlvolle</w> Darbietung, die das Publikum zu Tränen rührte.",
                                "zh": "她的表演十分<w>动人</w>，让观众感动落泪。"
                            }
                        },
                        {
                            "text": "He cast a <w>feeling</w> glance at his wife across the room.",
                            "target_lang_translations": {
                                "ru": "Он бросил <w>выразительный</w> взгляд на жену через всю комнату.",
                                "de": "Er warf einen <w>gefühlvollen</w> Blick zu seiner Frau hinüber.",
                                "zh": "他深情地望了房间对面的妻子一眼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sensitive",
                        "emotional",
                        "tender"
                    ],
                    "antonyms": [
                        "unfeeling",
                        "cold"
                    ],
                    "common_phrases": [
                        "with deep feeling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Показывающий или выражающий глубокие эмоции и чувствительность.",
                        "de": "Tiefe Emotionen und Sensibilität zeigend oder ausdrückend.",
                        "zh": "表现出或表达深厚情感和敏感性的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чувстви́тельный",
                                "target_lang_sense_clarification": "восприимчивый"
                            },
                            {
                                "target_lang_word": "проникове́нный",
                                "target_lang_sense_clarification": "полный чувств, трогательный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "einfühlsam",
                                "target_lang_sense_clarification": "sensibel"
                            },
                            {
                                "target_lang_word": "gefühlvoll",
                                "target_lang_sense_clarification": "mit viel Gefühl"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "深情的",
                                "target_lang_sense_clarification": "充满感情的"
                            },
                            {
                                "target_lang_word": "动人的",
                                "target_lang_sense_clarification": "感人的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
