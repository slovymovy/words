                "senses": [
                    {
                        "sense_id": "6506702f-ef87-30c0-ab4a-92c92bac5637",
                        "entry_id": "a94d6d50-fa75-3551-b147-3e091a46e26d",
                        "glosses": [
                            "Petit logement généralement situé à l'arrière du pont supérieur d'un bateau et ne s'étendant pas sur toute la largeur comme la dunette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af252333-9a29-4786-8e0d-19ffdb96fc5d",
                                "sense_id": "6506702f-ef87-30c0-ab4a-92c92bac5637",
                                "text": "L'énorme rouf construit sur l’embarcation et son gréement, démontraient l'inexpérience totale que son propriétaire avait des choses de la mer, […]."
                            },
                            {
                                "example_id": "12a5e9d2-68ad-42c5-9017-df71895e50a5",
                                "sense_id": "6506702f-ef87-30c0-ab4a-92c92bac5637",
                                "text": "Sur le pont supérieur, le coq qui refermait les portes du rouf avait une altercation avec le jeune Charley au sujet d’une paire de chaussettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "848df04b-6455-3fd1-bbc7-c2fa79445f61",
                        "entry_id": "a94d6d50-fa75-3551-b147-3e091a46e26d",
                        "glosses": [
                            "Abri réservé à l'équipage sur le pont avant des navires marchands."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adcb3a38-18bd-4e87-beb0-a49084041b12",
                                "sense_id": "848df04b-6455-3fd1-bbc7-c2fa79445f61",
                                "text": "Il y avait deux femmes, qui causaient à voix basse, dans le rouf, et un douanier, près du treuil, qui roulait sa cigarette."
                            }
                        ]
                    }
                ],
