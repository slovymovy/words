                    {
                        "sense_id": "87a779f7-015d-3612-91b3-40914c40353f",
                        "entry_id": "ff10c4fe-b919-3118-b9ac-f36b6362ee5b",
                        "glosses": [
                            "Qui se rapporte à la glande thyroïde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42266fde-7a82-4fd3-b3f5-6710de83afd8",
                                "sense_id": "87a779f7-015d-3612-91b3-40914c40353f",
                                "text": "Corps thyroïde"
                            },
                            {
                                "example_id": "a3e96cdf-7f87-4efa-9f55-e1a4a173ddae",
                                "sense_id": "87a779f7-015d-3612-91b3-40914c40353f",
                                "text": "L’accroissement anormal de la glande thyroïde forme le goitre."
                            },
                            {
                                "example_id": "9d5db490-09ee-412d-8a6c-d8dbbdc65f97",
                                "sense_id": "87a779f7-015d-3612-91b3-40914c40353f",
                                "text": "Quand tout va bien, la petite glande se tient coite. C’est donc par l’une de ses déviances majeures qu’elle parvint tout d’abord à attirer l’attention : le goitre, caractérisé par un corps thyroïde de volume supérieur à la normale, aurait été mentionné dès 2800 avant J.-C. par un empereur chinois."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "c041d527-0fac-3f47-8cb8-5f655fb28943",
                "word": "thyroïde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "40c009db-4d3c-4d0e-aaab-eecffc1e6b71",
                        "entry_id": "c041d527-0fac-3f47-8cb8-5f655fb28943",
                        "tags": [
                            "plural"
