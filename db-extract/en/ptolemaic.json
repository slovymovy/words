                    {
                        "translation_id": "9fb94b1f-21c6-48b3-88fc-24a8c98e6e86",
                        "source_entry_id": "8c5ce7a1-be2c-3e15-a9e3-750f38eedf1f",
                        "source_sense_description": "of, or pertaining to, Claudius Ptolemy",
                        "target_lang_word": "ptolemäisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ptolemäisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38d2c337-8d5d-3388-8984-0bf3a6380e90",
                                        "entry_id": "e4202266-79b3-3d3a-b66e-c3706e171589",
                                        "glosses": [
                                            "von dem griechischen Astronomen Claudius Ptolemäus stammend, nach ihm benannt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "152cce75-2ec5-4d21-bc04-6ab55b7efc82",
                                                "sense_id": "38d2c337-8d5d-3388-8984-0bf3a6380e90",
                                                "text": "„Obschon die kopernikanische Beschreibung der Planetenbewegung grundsätzlich bedeutend einfacher war als die ptolemäische, wurde sie in der Anwendung, durch das Anfügen der Exzentrizität des Deferenten und kleiner Epizykeln, wieder so kompliziert wie die ptolemäische Berechnung; darüber hinaus war sie keineswegs genauer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e65ccab9-5dfa-3c02-9627-41f542b7ea5c",
                                        "entry_id": "e4202266-79b3-3d3a-b66e-c3706e171589",
                                        "glosses": [
                                            "die makedonisch-griechische Dynastie der Ptolemäer betreffend, zu ihnen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8466fb8a-0042-4306-8ab5-3130bab0169e",
                                                "sense_id": "e65ccab9-5dfa-3c02-9627-41f542b7ea5c",
                                                "text": "„Etwa zur selben zeit bediente sich der pontische König Ariobarzanes galatischer Söldner im Kampf gegen ein ptolemäisches Invasionskorps.“"
                                            },
                                            {
                                                "example_id": "1e3b2321-0854-467d-87ff-e905cf888b53",
                                                "sense_id": "e65ccab9-5dfa-3c02-9627-41f542b7ea5c",
                                                "text": "„Oft zitierte Denis Marshs sonderbare Behauptung, dass die Legenden über Medusas Schlangenhaar lediglich gewisse Tatsachen verschleierten, genau wie die zeitlich späteren ptolemäischen Mythen um Königin Berenike.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
