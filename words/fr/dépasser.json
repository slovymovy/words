    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea9c8547-e609-376a-a537-3887e7e4eb0e",
                    "sense_definition": "Passer devant une personne ou un véhicule en se déplaçant plus vite.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La voiture a accéléré pour <w>dépasser</w> un camion sur la voie de gauche."
                        },
                        {
                            "text": "Il est dangereux de <w>dépasser</w> un cycliste sans laisser un mètre cinquante d'écart."
                        }
                    ],
                    "synonyms": [
                        "doubler"
                    ],
                    "common_phrases": [
                        "interdiction de dépasser",
                        "dépasser un cycliste",
                        "dépasser un véhicule"
                    ]
                },
                {
                    "sense_id": "9525c2bc-8fc1-3a2c-9a2a-1b09b763333d",
                    "sense_definition": "Être supérieur à un nombre, une valeur ou une limite établie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le poids de votre valise ne doit pas <w>dépasser</w> vingt kilogrammes."
                        },
                        {
                            "text": "Le conducteur a reçu une amende pour avoir <w>dépassé</w> la limite de vitesse autorisée."
                        }
                    ],
                    "common_phrases": [
                        "dépasser les limites",
                        "dépasser le budget"
                    ]
                },
                {
                    "sense_id": "5eb56079-7631-3014-a637-c2641f3e5cd5",
                    "sense_definition": "Aller au-delà d'un repère spatial ou franchir un endroit précis.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tournez à droite immédiatement après avoir <w>dépassé</w> le carrefour principal."
                        },
                        {
                            "text": "Absorbé par sa lecture, le voyageur a <w>dépassé</w> son arrêt de bus habituel."
                        }
                    ],
                    "common_phrases": [
                        "dépasser le carrefour",
                        "dépasser la ligne"
                    ]
                },
                {
                    "sense_id": "3324737d-58b6-3e69-976e-a2d45732d189",
                    "sense_definition": "Faire saillie ou sortir des bords d'un cadre, d'un espace ou d'un vêtement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant s'applique à colorier soigneusement sans <w>dépasser</w> les lignes du dessin."
                        },
                        {
                            "text": "Un mouchoir en tissu blanc <w>dépassait</w> légèrement de la poche de sa veste."
                        }
                    ],
                    "common_phrases": [
                        "laisser dépasser",
                        "dépasser des bords"
                    ]
                },
                {
                    "sense_id": "7969028b-8a6f-3dfa-8330-31a0443da5fc",
                    "sense_definition": "Surpasser quelqu'un ou quelque chose en talent, en qualité ou en résultat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à son travail assidu, l'élève a rapidement <w>dépassé</w> son maître."
                        },
                        {
                            "text": "Les bénéfices annuels de l'entreprise ont largement <w>dépassé</w> nos espérances."
                        }
                    ],
                    "common_phrases": [
                        "dépasser les attentes",
                        "dépasser le maître"
                    ]
                },
                {
                    "sense_id": "4bf5c914-c01e-3ed6-86ab-6fc9a80b112b",
                    "sense_definition": "Être au-delà de la capacité de compréhension ou de contrôle d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une telle réaction d'incompréhension face à cette situation me <w>dépasse</w> totalement."
                        },
                        {
                            "text": "L'équipe s'est vite retrouvée <w>dépassée</w> par l'ampleur des tâches imprévues."
                        }
                    ],
                    "common_phrases": [
                        "ça me dépasse",
                        "dépassé par les événements"
                    ]
                }
            ]
        }
    ]
}