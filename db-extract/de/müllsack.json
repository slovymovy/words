                        ]
                    },
                    {
                        "translation_id": "8209361d-470f-489f-931a-541924cc240a",
                        "source_entry_id": "6c54134d-de2e-3305-80d3-be5e02467928",
                        "source_sense_id": "f007b3fe-64a6-3d38-814b-86c13f960061",
                        "source_sense_description": "Sack für Müll",
                        "target_lang_word": "sac-poubelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sac-poubelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41120c2b-efa1-37ea-b208-06b6a29ac324",
                                        "entry_id": "950310b0-4e97-3485-92b3-486e6ce6be2c",
                                        "glosses": [
                                            "Variante orthographique de sac poubelle"
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93aace91-3c14-46b5-bc43-10b93cba6b90",
                                                "sense_id": "41120c2b-efa1-37ea-b208-06b6a29ac324",
                                                "text": "Le lendemain il descendit les premiers sacs-poubelle, puis lentement, minutieusement, démonta sa chambre photographique avant de ranger le soufflet, les dépolis, les objectifs, le dos numérique, le corps de l’appareil dans leurs mallettes de transport."
                                            },
                                            {
                                                "example_id": "69035751-f15e-4179-b8bf-bfb66a3ae79b",
                                                "sense_id": "41120c2b-efa1-37ea-b208-06b6a29ac324",
                                                "text": "Fin de journée : Je raccompagne les auxis qui vont jeter leurs sacs-poubelle quand nous nous trouvons bloqués à une grille. D'autres prisonniers reviennent des ateliers et il ne faut pas les croiser."
                                            },
                                            {
                                                "example_id": "dc9acb11-d9eb-4030-aff6-a6b180356cfe",
                                                "sense_id": "41120c2b-efa1-37ea-b208-06b6a29ac324",
                                                "text": "Lorsqu’il réussit à ouvrir les yeux, celle-ci portait un tablier et remplissait un sac-poubelle des déchets divers et variés qui jonchaient le sol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
