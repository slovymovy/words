                        "entry_id": "0e7b5327-434e-35f1-b19c-50e1e8c9b456",
                        "glosses": [
                            "południowoamerykański ssak żywiący się mrówkami i termitami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f79d5c5-73bf-4d8a-86bc-817f91f0182a",
                                "sense_id": "70ac15b2-2557-39fa-9707-a75586d33afa",
                                "text": "Naszym zarzucam głupotę wprost bajeczną, co bowiem mógłby ktoś powiedzieć, na przykład, o mrówkach, któreby wytoczyły sprawę robotnic i gryzły się o nią w chwili, gdy na mrowisku leży mrówkojad i połyka je tysiącami?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82c4f2ed-6058-49d2-bf58-79a3fc1e9f2b",
