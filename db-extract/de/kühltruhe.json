                        "sense_id": "ceaec4f7-0ad2-3fef-a8e2-fa8b438b6183",
                        "entry_id": "de8d0572-ec02-3448-961f-58a0edf78126",
                        "glosses": [
                            "truhenförmiges Behältnis mit Kühltechnik zur Kühlung von leicht verderblichen Lebensmitteln"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "3a4cdf24-d91f-44a6-97bb-d319e997f9f1",
                                "sense_id": "ceaec4f7-0ad2-3fef-a8e2-fa8b438b6183",
                                "text": "In den Kühltruhen im Supermarkt werden Gemüse, Salate und frische Pilze gelagert, da diese zum alsbaldigen Verzehr bestimmt sind."
                            },
                            {
                                "example_id": "78e49e7f-b5ca-4ea4-a343-cfc88077490c",
                                "sense_id": "ceaec4f7-0ad2-3fef-a8e2-fa8b438b6183",
                                "text": "Weil drei tote Babys in einer Kühltruhe gefunden wurden, steht eine Mutter in Siegen vor Gericht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
