                        ],
                        "examples": [
                            {
                                "example_id": "18b2ae8d-8a85-4c98-8e89-31ef9b6431c0",
                                "sense_id": "594fc2d8-62b0-3cfb-b3f0-71191a9d418b",
                                "text": "Der echte Buchweizen wird im Volksmund immer noch gerne schwarzes Welschkorn genannt."
