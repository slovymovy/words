{
    "word_family": [
        "renoncement",
        "renonciation",
        "renonciateur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "253515f9-f31f-36ac-b961-7a2f56a9dbd9",
                    "sense_definition": "Abandonner volontairement un projet, une habitude, ou l'espoir d'obtenir ou de conserver quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abandon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face aux nombreuses difficultés, ils ont décidé de <w>renoncer</w> à leur projet de voyage."
                        },
                        {
                            "text": "Il refuse de <w>renoncer</w> à ses rêves d'enfance malgré les avertissements de ses proches."
                        }
                    ],
                    "synonyms": [
                        "abandonner",
                        "délaisser"
                    ],
                    "antonyms": [
                        "persévérer",
                        "poursuivre"
                    ],
                    "common_phrases": [
                        "renoncer à un projet",
                        "renoncer à fumer",
                        "renoncer à tout"
                    ]
                },
                {
                    "sense_id": "79b89f3f-9060-33a9-b136-2762b1894f16",
                    "sense_definition": "Se désister formellement d'un droit, d'un titre, d'une fonction ou d'une prétention légale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'héritier a choisi de <w>renoncer</w> à la succession pour ne pas payer les dettes."
                        },
                        {
                            "text": "Le ministre a dû <w>renoncer</w> à ses fonctions après l'annonce de l'enquête judiciaire."
                        }
                    ],
                    "synonyms": [
                        "se désister",
                        "abdiquer"
                    ],
                    "antonyms": [
                        "revendiquer",
                        "réclamer"
                    ],
                    "common_phrases": [
                        "renoncer à un droit",
                        "renoncer à la succession",
                        "renoncer à une fonction"
                    ]
                },
                {
                    "sense_id": "56515fbe-6bad-3424-af82-678967a9aac2",
                    "sense_definition": "Dans un jeu de cartes, jouer une carte d'une autre couleur que celle qui est demandée.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'ayant plus de cœur, le joueur a dû <w>renoncer</w> en posant un trèfle."
                        },
                        {
                            "text": "Si vous n'avez pas la couleur demandée, vous devez obligatoirement <w>renoncer</w> selon la règle."
                        }
                    ],
                    "synonyms": [
                        "défausser"
                    ]
                },
                {
                    "sense_id": "24fbc0b7-1a66-3306-86a9-05fbbd2f9e0b",
                    "sense_definition": "Renier ou désavouer quelqu'un en refusant de le reconnaître comme sien.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rejet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par crainte des gardes, le disciple effrayé a <w>renoncé</w> son maître à trois reprises."
                        },
                        {
                            "text": "Le père furieux a menacé de <w>renoncer</w> son propre fils devant les membres de la famille."
                        }
                    ],
                    "synonyms": [
                        "désavouer",
                        "renier"
                    ],
                    "antonyms": [
                        "reconnaître"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Emploi transitif direct vieilli ou littéraire."
                        }
                    ]
                }
            ]
        }
    ]
}