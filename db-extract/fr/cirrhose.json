                    {
                        "translation_id": "b5fafc55-7033-4e89-9b0a-274de3be5d79",
                        "source_entry_id": "d55c8fff-7c59-3283-83bb-71d0dc2c6621",
                        "source_sense_id": "ef334c44-382b-32a8-9249-8208f490a908",
                        "target_lang_word": "cirrosis",
                        "target_lang_code": "es",
