                "senses": [
                    {
                        "sense_id": "c05e5ce4-cd6c-372c-914a-2ea4b0e05b41",
                        "entry_id": "983c9798-09d4-34de-a52a-cc290c7d547c",
                        "glosses": [
                            "een met een halve toon verhoogde toon \\\"c\\"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f13720aa-ffdf-47dd-91e2-f9dc39b3f419",
                                "sense_id": "c05e5ce4-cd6c-372c-914a-2ea4b0e05b41",
                                "text": "De toon “cis” klinkt in de getempereerde stemming, gelijk aan de toon “des”."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dd93738-9915-3c6c-87a7-9b4f56a02387",
                        "entry_id": "983c9798-09d4-34de-a52a-cc290c7d547c",
                        "glosses": [
                            "de grondtoon (tonica) van de “cis-mineurtoonladder”, tevens een korte aanduiding van die toonladder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21e8e361-fa37-46b9-9039-3fe1268c3e60",
                                "sense_id": "2dd93738-9915-3c6c-87a7-9b4f56a02387",
                                "text": "Op de notenbalk van een sonate in cis, staan vier kruisen als voortekens."
                            }
                        ]
                    },
                    {
                        "sense_id": "0853f8b8-3b13-3783-bfdd-c50cdf390432",
                        "entry_id": "983c9798-09d4-34de-a52a-cc290c7d547c",
                        "glosses": [
                            "de grondtoon van het “cis-mineurakkoord”, de kleine drieklank op de eerste trap (tonica-akkoord) van de kleinetertstoonladder op die toon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b8dcb9c-b536-4575-9ac8-f4649d691220",
                                "sense_id": "0853f8b8-3b13-3783-bfdd-c50cdf390432",
                                "text": "De drie tonen van het cis-mineurakkoord (symbool: C#m) in grondligging, zijn: cis - e - gis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c8da4eb-e5d4-459d-b7ad-418e32c1593c",
                        "source_entry_id": "983c9798-09d4-34de-a52a-cc290c7d547c",
                        "source_sense_id": "c05e5ce4-cd6c-372c-914a-2ea4b0e05b41",
                        "source_sense_description": "verhoogde toon c",
                        "target_lang_word": "cis",
