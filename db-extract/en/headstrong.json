                    {
                        "translation_id": "66e42a49-5992-43bb-801f-993391835d8c",
                        "source_entry_id": "01780a74-24e7-3add-a5d2-f13432c4e947",
                        "source_sense_id": "c98f0f50-2c1f-3a32-a26c-a844dd208ac9",
                        "source_sense_description": "determined to do as one pleases, and not as others want",
                        "target_lang_word": "obstiné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstiné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07942af4-f50a-3422-85b1-4a52ccb9a535",
                                        "entry_id": "e5ebd097-4cfd-3e53-a7b4-bff19eb0fd2e",
                                        "glosses": [
                                            "Qui s’obstine ; qui est entêté ou acharné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e2040c9-54e9-48d1-a674-8af6910c3d01",
                                                "sense_id": "07942af4-f50a-3422-85b1-4a52ccb9a535",
                                                "text": "Celui-là est défendu contre les quémandeurs trop opiniâtres par une sorte de femelle revêche, bourrue, grimaçante, qui s’entend à merveille à décourager les volontés les plus obstinées."
                                            },
                                            {
                                                "example_id": "3953b0dc-3f62-458b-8028-fcd67dcd399b",
                                                "sense_id": "07942af4-f50a-3422-85b1-4a52ccb9a535",
                                                "text": "Quoiqu’elle eût cinquante-sept ans et que ses travaux obstinés au sein du ménage lui permissent bien de se reposer, elle tricotait les bas de son mari, les siens et ceux d’un oncle, comme tricotent les femmes de la campagne, en marchant, en parlant, en se promenant dans le jardin, en allant voir ce qui se passait à sa cuisine."
                                            },
                                            {
                                                "example_id": "473b20b5-65c6-4bee-90c3-66d9f6a925df",
                                                "sense_id": "07942af4-f50a-3422-85b1-4a52ccb9a535",
                                                "text": "Le cordonnier a repris son air rogue, son visage obstiné."
                                            },
                                            {
                                                "example_id": "4bd418ff-9fb4-45fa-8180-f7eb3e6b26e5",
                                                "sense_id": "07942af4-f50a-3422-85b1-4a52ccb9a535",
                                                "text": "Les desservants peuvent, désormais, disparaître ; le peuple tiendra. Il tiendra, car il est, par caractère, obstiné ; car il vit groupé dans un rayon peu étendu."
                                            },
                                            {
                                                "example_id": "fa6d47a8-568b-470e-b978-a82fa468ee73",
                                                "sense_id": "07942af4-f50a-3422-85b1-4a52ccb9a535",
                                                "text": "Un rhume obstiné. — Lutte obstinée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "obstiné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d3005dd-b216-3297-a276-22e57533755c",
                                        "entry_id": "56d029c2-fe64-331b-811a-d5d528db004d",
                                        "glosses": [
                                            "Homme qui s’obstine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeecf424-5a2c-4998-8a26-70f80de46dbe",
                                                "sense_id": "9d3005dd-b216-3297-a276-22e57533755c",
                                                "text": "L’obstiné ne veut rien céder ; il fait paraître un esprit de contrariété."
                                            },
                                            {
                                                "example_id": "15f279e1-0cc9-4dde-a2e5-468df1133693",
                                                "sense_id": "9d3005dd-b216-3297-a276-22e57533755c",
                                                "text": "C’est un obstiné."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "obstiné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8dc4b2f-a22a-34dc-854a-5344b28c9915",
                                        "entry_id": "6c5d4e52-26f2-3b42-a8f9-38978b280836",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe obstiner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e292000-a651-4fdb-b8d5-7f624e18b3af",
                                                "sense_id": "a8dc4b2f-a22a-34dc-854a-5344b28c9915",
                                                "text": "Seul le costaud ‒ nommé Bradford ‒ s’est obstiné à faire la moue, sous-entendant que j’en rajoutais pour faire l’intéressante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
