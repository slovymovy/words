                                "target_senses": [
                                    {
                                        "sense_id": "f2b9fe91-c6ea-3a2b-ab2c-e30a0dedde98",
                                        "entry_id": "0c4d61a7-46b5-30fc-b512-14f166fc75e5",
                                        "glosses": [
                                            "A man, especially one who is divorced or estranged from his partner, who fails to provide monetary child support when he is legally required to do so."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "derogatory",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6761284a-690f-4466-9906-54c00541da35",
                                                "sense_id": "f2b9fe91-c6ea-3a2b-ab2c-e30a0dedde98",
                                                "text": "If the '90s offer one villain by consensus, it is the deadbeat dad, that selfish fugitive condemned by liberals and conservatives alike for his irresponsible behavior and generous contributions to the cycle of welfare dependency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79a208bf-fa9e-3655-8f79-1f4b16b42e8a",
                                        "entry_id": "0c4d61a7-46b5-30fc-b512-14f166fc75e5",
                                        "glosses": [
                                            "A man who is voluntarily absent and uncaring towards his children, especially one who leaves them entirely in their mother's care."
                                        ],
