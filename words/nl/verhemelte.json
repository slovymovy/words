                    "sense_id": "cc7ffdfe-45f4-362e-a90f-18f15cb30e40",
                    "sense_definition": "de bovenkant van de binnenkant van de mond",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hete soep verbrandde het <w>verhemelte</w> van mijn mond.",
                            "target_lang_translations": {
                                "en": "The hot soup burned the <w>palate</w> of my mouth."
                            }
                        },
                        {
                            "text": "Het <w>harde</w> <w>verhemelte</w> bevindt zich aan de voorkant van de mondholte.",
                            "target_lang_translations": {
                                "en": "The hard <w>palate</w> is located at the front of the oral cavity."
                            }
                        }
                    ],
                    "synonyms": [
                        "gehemelte",
                        "palatum"
                    ],
                    "common_phrases": [
                        "hard verhemelte",
                        "zacht verhemelte"
                    ],
                    "target_lang_definitions": {
