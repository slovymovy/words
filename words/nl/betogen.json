                            },
                            {
                                "target_lang_word": "pleas",
                                "target_lang_sense_clarification": "plural of a formal statement or request"
                            },
                            {
                                "target_lang_word": "discourses",
                                "target_lang_sense_clarification": "plural of a formal discussion of a topic"
                            }
                        ]
                    }
                }
            ]
        }
    ]
