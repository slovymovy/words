                "senses": [
                    {
                        "sense_id": "493654f4-e39f-3988-89be-6678c4c49f7c",
                        "entry_id": "b69e9042-461a-3ad7-bfee-02fd8bc1b9bd",
                        "glosses": [
                            "van een stuk vlees dat de botten eruit verwijderd zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4092356c-79ac-4939-8b36-21c3e18711c2",
                                "sense_id": "493654f4-e39f-3988-89be-6678c4c49f7c",
                                "text": "400 g kipmedaillons of ontbeende kippendijen in stukken"
                            },
                            {
                                "example_id": "93ea5c01-8a5a-4381-a773-909af553e681",
                                "sense_id": "493654f4-e39f-3988-89be-6678c4c49f7c",
                                "text": "Dan stopt Bongani voor een snelle hap in een 'restaurantje'. Hier wordt ons een ontbeende, uitgekookte, in stukken gesneden koeienkop opgediend. Na de vliegen weggejaagd te hebben waag ik me aan een stukje en neem snel een slok cola om de vieze smaak weg te spoelen."
                            },
                            {
                                "example_id": "98c11f90-f9ea-428c-ae04-c45f68371c0d",
                                "sense_id": "493654f4-e39f-3988-89be-6678c4c49f7c",
                                "text": "Ik haal de kip niet net als mijn moeder uit de tuin, maar bij de slager. Ik gebruik ontbeende kippenbouten mét vel, zo blijft het vlees lekker mals en zacht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0f86838-75b0-47ef-b1ab-6c01213583c8",
                        "source_entry_id": "b69e9042-461a-3ad7-bfee-02fd8bc1b9bd",
                        "source_sense_id": "493654f4-e39f-3988-89be-6678c4c49f7c",
                        "target_lang_word": "boneless",
