                                        "entry_id": "dc202835-3adc-3c91-a0e5-65e142515cb4",
                                        "glosses": [
                                            "rechtlich anerkennen, als rechtens erklären"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9d526ca-6b2c-4ee0-9408-abfdde1bc36a",
                                                "sense_id": "286538a0-eea0-34b6-99de-6d4e821c3bbc",
                                                "text": "Das Vorgehen wurde nachträglich legitimiert."
                                            },
                                            {
                                                "example_id": "e618fc47-79df-42a9-ac4a-13123a5dd6b8",
                                                "sense_id": "286538a0-eea0-34b6-99de-6d4e821c3bbc",
                                                "text": "„Der Princeps musste Sorge tragen, die politischen Verhältnisse zu konsolidieren, mit derer Hilfe er seine Machtposition legitimieren konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d48bf5b-8ac9-36e8-a3d1-3b4a171e9166",
                                        "entry_id": "dc202835-3adc-3c91-a0e5-65e142515cb4",
                                        "glosses": [
                                            "jemanden mit gewissen Rechten ausstatten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fa85c5b-ec7a-4e5a-856f-82266e51d62b",
                                                "sense_id": "4d48bf5b-8ac9-36e8-a3d1-3b4a171e9166",
                                                "text": "Er war legitimiert, als Schiedsrichter einzuschreiten."
                                            },
                                            {
                                                "example_id": "7645c3ac-50a4-431d-bf0a-d7ee158d10fd",
                                                "sense_id": "4d48bf5b-8ac9-36e8-a3d1-3b4a171e9166",
                                                "text": "Sie ist legitimiert, ein Rezept auszustellen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f3e9ad10-b900-3884-9c1b-3df4e29f8d1b",
                                        "entry_id": "dc202835-3adc-3c91-a0e5-65e142515cb4",
                                        "glosses": [
                                            "sich ausweisen, seine Identität (und sein Recht auf Anwesenheit) nachweisen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ca92976-b278-47e2-989d-bd791f6834b7",
                                                "sense_id": "f3e9ad10-b900-3884-9c1b-3df4e29f8d1b",
                                                "text": "Am Eingang zum Gerichtssaal musste sie sich legitimieren."
                                            },
                                            {
                                                "example_id": "a6ea44d1-1f39-449f-982a-a857d75d3392",
                                                "sense_id": "f3e9ad10-b900-3884-9c1b-3df4e29f8d1b",
                                                "text": "Nachdem er sich legitimiert hatte, durfte er passieren."
                                            },
                                            {
                                                "example_id": "1d05df13-7e6c-456c-a6ff-41ce3ec174ad",
                                                "sense_id": "f3e9ad10-b900-3884-9c1b-3df4e29f8d1b",
                                                "text": "„Sie müssen sich legitimieren, um die Sperrzone zu passieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
