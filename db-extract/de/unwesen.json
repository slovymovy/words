                    {
                        "form_id": "1227f9c9-945f-4718-97ae-36b6a30203eb",
                        "entry_id": "41cab86f-8937-3a49-b2fb-e3bd9ada4561",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Unwesen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "280a1de2-8c6e-30a5-b7ae-3848cc1d1b61",
                        "entry_id": "41cab86f-8937-3a49-b2fb-e3bd9ada4561",
                        "glosses": [
                            "verwerfliches Handeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d45838df-1933-4028-8dca-1de672bb0ab4",
                                "sense_id": "280a1de2-8c6e-30a5-b7ae-3848cc1d1b61",
                                "text": "„Aber sie war für einen Hafen geeignet, von dem aus man die vielen Piraten in Schach halten konnte, die im Südchinesischen Meer ihr Unwesen trieben.“"
                            },
                            {
                                "example_id": "3f0bae0b-eb1f-4253-9aad-cc932796b39d",
                                "sense_id": "280a1de2-8c6e-30a5-b7ae-3848cc1d1b61",
                                "text": "„In Teilen von Neukölln, Spandau und Lichtenberg trieben rivalisierende Banden und Bürgerwehren ihr Unwesen, weil der Staat weder die Versorgung der Bevölkerung gewährleisten noch deren Sicherheit garantieren konnte.“"
                            },
                            {
                                "example_id": "e89f738b-8aca-41bd-b3ba-e320937a09fa",
                                "sense_id": "280a1de2-8c6e-30a5-b7ae-3848cc1d1b61",
                                "text": "„Kohlhase konnte sein Unwesen deshalb so lange treiben, weil der Kurfürst von Brandenburg das Marodieren auf dem Territorium des Kurfürsten von Sachsen duldete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b548112-b2db-4e8a-9437-fc8e52f64373",
                        "source_entry_id": "41cab86f-8937-3a49-b2fb-e3bd9ada4561",
                        "source_sense_id": "280a1de2-8c6e-30a5-b7ae-3848cc1d1b61",
                        "source_sense_description": "verwerfliches Handeln",
                        "target_lang_word": "misdeed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misdeed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d375b860-1d11-3786-8f86-4c9f3f210229",
                                        "entry_id": "cb81d770-210a-38f3-97a7-abc61ccdb480",
                                        "glosses": [
                                            "That which was done that should not have been, ranging from any sin or moral offense to various degrees of crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d345cc99-bdae-4a40-b3ad-d09ab30d3750",
                                                "sense_id": "d375b860-1d11-3786-8f86-4c9f3f210229",
                                                "text": "The petty misdeeds of his youth came back to haunt him when he ran for political office and his character was smeared."
                                            },
                                            {
                                                "example_id": "7d90b864-53ab-423c-b7d8-aa3803e2a5e0",
                                                "sense_id": "d375b860-1d11-3786-8f86-4c9f3f210229",
                                                "text": "These [putting feet on seats and leaving rubbish behind] are officially among the worst habits revealed by staff working on Northern's trains and at stations. Other bugbears include playing music through loudspeakers, not giving way to passengers getting off the train and actually illegal activities such as fare evasion and vaping in enclosed spaces. The list of misdeeds was released by the operator on March 3 to coincide with Employee Appreciation Day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
