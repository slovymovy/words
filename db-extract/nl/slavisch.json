                                "target_senses": [
                                    {
                                        "sense_id": "f51f58b3-0b32-3073-9474-2a0fd2db2fa4",
                                        "entry_id": "2b43dc2b-9f31-33d5-86d6-8564992d8e3a",
                                        "glosses": [
                                            "Angehöriger einer Völkergruppe im Osten Europas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b1a16fc-d9b7-479a-a5e3-aa159b5d845a",
                                                "sense_id": "f51f58b3-0b32-3073-9474-2a0fd2db2fa4",
                                                "text": "„Trotz der häufigen Kämpfe zwischen Deutschen und Slawen bestand ein friedlicher Handelsverkehr und Warenaustausch zwischen dem Westen und den ostelbischen Völkern.“"
                                            },
                                            {
                                                "example_id": "d456d76a-d7f1-48a1-b957-86fe15664c0a",
                                                "sense_id": "f51f58b3-0b32-3073-9474-2a0fd2db2fa4",
                                                "text": "„Als Slawe fürchtete ich mich gewaltig davor, ich könnte scheitern und meine Zunge verschlucken.“"
                                            },
                                            {
                                                "example_id": "41ba16c4-7886-44b9-ad65-c2a8a1ad99bb",
                                                "sense_id": "f51f58b3-0b32-3073-9474-2a0fd2db2fa4",
                                                "text": "„Erst im Zuge der Völkerwanderung seien die Slawen gekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
