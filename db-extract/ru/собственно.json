                                    },
                                    {
                                        "sense_id": "25cb5b63-fb3e-3627-8180-b4c224ca2e68",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Accurate, strictly applied.",
                                            "Excellent, of high quality; such as the specific person or thing should ideally be. (Now often merged with later senses.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e44e473f-5f71-4097-b5f2-4a073a2779aa",
                                                "sense_id": "25cb5b63-fb3e-3627-8180-b4c224ca2e68",
                                                "text": "Now that was a proper breakfast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a5946a0-a2b7-32ed-be53-ce6687706fd7",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Accurate, strictly applied.",
                                            "Attractive, elegant."
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b30a5b79-ad8b-41df-bbe5-96f9983b1019",
                                                "sense_id": "0a5946a0-a2b7-32ed-be53-ce6687706fd7",
                                                "text": "The same tyme was Moses borne, and was a propper [translating ἀστεῖος (asteîos)] childe in the sight of God, which was norisshed up in his fathers housse thre monethes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45fa0194-23a9-3040-a7f3-ce3b2ad77d5a",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Accurate, strictly applied.",
                                            "In the very strictest sense of the word."
                                        ],
                                        "tags": [
                                            "often",
                                            "postpositional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0c1bbad-0c0e-45f2-8715-fd5af7f40903",
                                                "sense_id": "45fa0194-23a9-3040-a7f3-ce3b2ad77d5a",
                                                "text": "Though unusual in the Dublin area he knew that it was not by any means unknown for desperadoes who had next to nothing to live on to be abroad waylaying and generally terrorising peaceable pedestrians by placing a pistol at their head in some secluded spot outside the city proper[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd4c63af-bb6c-3029-a012-bbaaa00e243c",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Accurate, strictly applied.",
                                            "Utter, complete."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04738965-fe61-4b53-9388-772457e23cb1",
                                                "sense_id": "dd4c63af-bb6c-3029-a012-bbaaa00e243c",
                                                "text": "When I realized I was wearing my shirt inside out, I felt a proper fool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "063a4894-cb23-39b3-a538-bf5f7fd08a59",
                                        "entry_id": "a74a3f3d-d5d5-3711-9f27-5b6d11556860",
                                        "glosses": [
                                            "Accurate, strictly applied.",
                                            "Not being a set."
                                        ],
                                        "tags": [
                                            "of a class"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "proper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae8f2ca7-2682-361b-9f5c-6b9e3de3fe85",
                                        "entry_id": "409130b1-6677-324b-9b7f-9b2dbbc66440",
                                        "glosses": [
                                            "properly; thoroughly; completely."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "730b2034-a35c-45cc-86f1-e4566e3b5fdd",
                                                "sense_id": "ae8f2ca7-2682-361b-9f5c-6b9e3de3fe85",
                                                "text": "'I thought it was the American Associated Press.' 'Oh, they are on the track, are they?' 'They to-day, and the Times yesterday. Oh, they are buzzing round proper.'"
                                            },
                                            {
                                                "example_id": "644724c3-3af5-42a6-b97d-add5d35af5af",
                                                "sense_id": "ae8f2ca7-2682-361b-9f5c-6b9e3de3fe85",
                                                "text": "“Christmas Eve,” said Nabby Adams. “I used to pump the bloody organ for the carols, proper pissed usually.”"
                                            },
                                            {
                                                "example_id": "31990aa5-e05a-48af-b30e-3815cd36aaca",
                                                "sense_id": "ae8f2ca7-2682-361b-9f5c-6b9e3de3fe85",
                                                "text": "The kid towelled him up proper."
                                            },
                                            {
                                                "example_id": "b4e857f7-12eb-4057-bbfc-6fcdd2090384",
                                                "sense_id": "ae8f2ca7-2682-361b-9f5c-6b9e3de3fe85",
                                                "text": "Don't you think you must have looked proper daft?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c40ba4d6-a582-3d58-a34b-f54c5011664a",
                                        "entry_id": "409130b1-6677-324b-9b7f-9b2dbbc66440",
                                        "glosses": [
                                            "properly."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "nonstandard",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2355832b-aa7e-4fa9-b385-6406672c70b8",
                                                "sense_id": "c40ba4d6-a582-3d58-a34b-f54c5011664a",
                                                "text": "\"But it's not many of us as can make 'em proper.\""
                                            },
                                            {
                                                "example_id": "86ba6b61-59eb-45fa-873e-d27d07ff9270",
                                                "sense_id": "c40ba4d6-a582-3d58-a34b-f54c5011664a",
                                                "text": "When I meet a bad chick, know I gotta tell her hello\ntalk real proper, but she straight up out the ghetto"
                                            }
                                        ]
                                    }
                                ]
                            },
