                        "source_sense_id": "16ef7bd5-26d3-3097-85ad-a0a232df9328",
                        "source_sense_description": "process of raising and educating a child from birth until adulthood",
                        "target_lang_word": "Kindererziehung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kindererziehung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf1a9d29-8200-360b-9386-decef8ad122b",
                                        "entry_id": "c0c15f3d-c054-3ec6-8d46-70053c1c2e46",
                                        "glosses": [
                                            "Erziehung von jungen, minderjährigen Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2f504c9-1c72-4b9c-912c-ff3c7822d37a",
                                                "sense_id": "bf1a9d29-8200-360b-9386-decef8ad122b",
                                                "text": "„Während vor einigen Jahrzehnten die Frauen sich noch wie selbstverständlich um Haushalt und Kindererziehung kümmerten, ist die Gleichstellung der Geschlechter nun fast abgeschlossen und die weibliche Bevölkerung strebt eine andere Lebensweise an: Mehr als die Hälfte aller Frauen stellen sich Mutterschaft und eine Teilzeitarbeit als eine ideale Kombination vor.“"
                                            },
                                            {
                                                "example_id": "e9f979f7-6cdd-464b-9810-00e297d57c2d",
                                                "sense_id": "bf1a9d29-8200-360b-9386-decef8ad122b",
                                                "text": "„Ältere Mütter neigen auch dazu, nicht mehr den nötigen Elan und die Autorität aufbringen zu können, die bei der Kindererziehung notwendig sind.“"
                                            },
                                            {
                                                "example_id": "92cf13fb-1183-45c0-8e59-e2ff7afd1949",
                                                "sense_id": "bf1a9d29-8200-360b-9386-decef8ad122b",
                                                "text": "„Es war in Fragen der Kindererziehung und irgendwelchem Haushaltskram.“"
                                            },
                                            {
                                                "example_id": "07d2244b-427f-405e-9ef2-f8898205ae12",
                                                "sense_id": "bf1a9d29-8200-360b-9386-decef8ad122b",
                                                "text": "„Vielleicht ist Kindererziehung heutzutage ja wirklich schwerer als früher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
