                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d193b46b-5b0d-42b5-bf8b-024e4a8222a4",
                                "sense_id": "532f9742-f80a-3795-afa5-a769d5fad4df",
                                "text": "He acknowledges that it must seem \"a crackers thing to say\", but given the substantial progress which has been made in other areas of the business, his optimism isn't without foundation."
                            },
                            {
                                "example_id": "0debd5e8-11ff-4a2f-b7f6-87474fe4a7d8",
                                "sense_id": "532f9742-f80a-3795-afa5-a769d5fad4df",
                                "text": "Dominic Cummings, Boris Johnson’s former chief adviser, told the online magazine UnHerd in May that Truss was “as close to properly crackers as anybody I have met in parliament” and would be an “even worse” prime minister than Johnson."
                            }
                        ]
                    }
