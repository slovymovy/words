                "senses": [
                    {
                        "sense_id": "24050f7d-9266-3966-b8fd-59ec51681a61",
                        "entry_id": "0a2e57ef-4154-314c-a894-d33ac611af13",
                        "glosses": [
                            "Like (that of) a girl; feminine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da4b60d8-dee9-452b-b5b4-e0c09744b94d",
                                "sense_id": "24050f7d-9266-3966-b8fd-59ec51681a61",
                                "text": "She saw her own face, glowing with girlish beauty, and illuminating all the interior of the dusky mirror in which she had been wont to gaze at it."
                            },
                            {
                                "example_id": "bd1cfb94-abfc-42d2-967e-495c2df87587",
                                "sense_id": "24050f7d-9266-3966-b8fd-59ec51681a61",
                                "text": "Three little maids from school are we, / Pert as a school-girl well can be, / Filled to the brim with girlish glee, / Three little maids from school!"
                            },
                            {
                                "example_id": "9a134b6f-6432-4a88-9cc4-b3f269fe4ad5",
                                "sense_id": "24050f7d-9266-3966-b8fd-59ec51681a61",
                                "text": "April, April, / Laugh thy girlish laughter; / Then, the moment after, / Weep thy girlish tears!"
                            }
                        ]
                    },
                    {
                        "sense_id": "1cf6f0c8-7bda-3b2a-bcf7-b83e61c0ba1c",
                        "entry_id": "0a2e57ef-4154-314c-a894-d33ac611af13",
                        "glosses": [
                            "Of or relating to girlhood."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "874165b8-d5bb-4c0c-b706-f8997285727b",
                                "sense_id": "1cf6f0c8-7bda-3b2a-bcf7-b83e61c0ba1c",
                                "text": "1602, Richard Carew, The Survey of Cornwall, London: E. Law, 1769, pp. 119-20, http://www.gutenberg.org/cache/epub/9878/pg9878-images.html\nThis village was the birth-place of Thomasine Bonauenture, I know not, whether by descent, or euent, so called: for whiles in her girlish age she kept sheepe on the foreremembered moore, it chanced that a London merchant passing by, saw her […] ."
                            }
