                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "34610a06-6435-4e34-8e35-d4728ea4aba5",
                                "sense_id": "d61daad0-ab63-37c0-8cd3-bcfc297cc60b",
                                "text": "Une personnalité politique qui ait affaire avec la justice se retrouve imbaisable du fait de ses soutiens tant financiers que de ses amis hauts placés."
                            }
                        ]
                    },
                    {
                        "sense_id": "8912f196-93f3-38ed-a363-0cfebb17443b",
                        "entry_id": "d4c936cd-ca26-35d0-96e9-87128fcd4342",
                        "glosses": [
