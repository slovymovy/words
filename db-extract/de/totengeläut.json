                ],
                "senses": [
                    {
                        "sense_id": "d63fa6c1-c65e-3a7d-b0d7-6ea716751425",
                        "entry_id": "035b0014-f317-3556-8a42-9c0629e4c477",
                        "glosses": [
                            "das Läuten der Totenglocke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab5de629-8df6-4a38-b56c-b821ece129f2",
                                "sense_id": "d63fa6c1-c65e-3a7d-b0d7-6ea716751425",
                                "text": "„Ebenfalls ist es regional üblich, den Tod durch ein Totengeläut mitzuteilen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b872ff2-b1ce-43d0-a9b5-c0b8b2a20c30",
                        "source_entry_id": "035b0014-f317-3556-8a42-9c0629e4c477",
                        "source_sense_id": "d63fa6c1-c65e-3a7d-b0d7-6ea716751425",
                        "source_sense_description": "das Läuten der Totenglocke",
                        "target_lang_word": "knell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bb0a61a-4f23-34b8-bae7-00a8b74d4802",
                                        "entry_id": "7e6a07bc-5c85-38a8-bdb6-9f967d32ce1d",
                                        "glosses": [
                                            "To ring a bell slowly, especially for a funeral; to toll."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20d94139-8482-4470-bd74-5627a52d9ef3",
                                                "sense_id": "7bb0a61a-4f23-34b8-bae7-00a8b74d4802",
                                                "text": "I’ll make thee sick at heart, before I leave thee,\nAnd groan, and die indeed, and be worth nothing,\nNot worth a blessing nor a bell to knell for thee […]"
                                            },
                                            {
                                                "example_id": "f0a84359-a64e-48ee-9b5d-27c071dcd1dc",
                                                "sense_id": "7bb0a61a-4f23-34b8-bae7-00a8b74d4802",
                                                "text": "“[…] God!—the words of the warlock are knelling in my ears!”"
                                            },
                                            {
                                                "example_id": "b3930458-60a0-431c-8ee9-af247425e2d0",
                                                "sense_id": "7bb0a61a-4f23-34b8-bae7-00a8b74d4802",
                                                "text": "The chill rain is falling, the nipt worm is crawling,\nThe rivers are swelling, the thunder is knelling\nFor the year"
                                            },
                                            {
                                                "example_id": "49805eba-b7b7-4596-9f48-c4be1b5ba22f",
                                                "sense_id": "7bb0a61a-4f23-34b8-bae7-00a8b74d4802",
                                                "text": "Yet all that poets sing, and grief hath known,\nOf hopes laid waste, knells in that word—ALONE!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d17ae47-4ec8-3525-811c-42a43d51dbd9",
                                        "entry_id": "7e6a07bc-5c85-38a8-bdb6-9f967d32ce1d",
                                        "glosses": [
                                            "To signal or proclaim something (especially a death) by ringing a bell."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bfb1af3-691a-4944-8711-351250be41c2",
                                                "sense_id": "5d17ae47-4ec8-3525-811c-42a43d51dbd9",
                                                "text": "Let thy friends be as the dead in doom,\nAnd build to them a final tomb;\nLet the starred shade that nightly falls\nStill celebrate their funerals,\nAnd the bell of beetle and of bee\nKnell their melodious memory."
                                            },
                                            {
                                                "example_id": "0a337b90-aec2-48bb-9e08-2de9ca8ace76",
                                                "sense_id": "5d17ae47-4ec8-3525-811c-42a43d51dbd9",
                                                "text": "The church bells knelled the peaceful ending of the day, while the purple shades of night descended sadly and majestically on the low chain of neighbouring hills."
                                            },
                                            {
                                                "example_id": "1264b921-a4bb-47e6-8bc6-a3d21a39207d",
                                                "sense_id": "5d17ae47-4ec8-3525-811c-42a43d51dbd9",
                                                "text": "His right hand, clenched into an iron mallet, battered desperately at the fearful face bent toward his; the beast-like teeth shattered under his blows and blood splattered, but still the red eyes gloated and the taloned fingers sank deeper and deeper until a ringing in Turlogh’s ears knelled his soul’s departure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "276e4521-588e-36e4-b6ea-5f8fdb395a2f",
                                        "entry_id": "7e6a07bc-5c85-38a8-bdb6-9f967d32ce1d",
                                        "glosses": [
                                            "To summon by, or as if by, ringing a bell."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "knell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f132ed8-c56d-3b6e-b3bf-e475d96a4dfb",
                                        "entry_id": "f51cef82-b500-352a-aa86-c5bc80649461",
                                        "glosses": [
                                            "The sound of a bell knelling; a toll (particularly one signalling a death)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "039f4506-31e1-4d10-aa22-9b68f326f754",
                                                "sense_id": "0f132ed8-c56d-3b6e-b3bf-e475d96a4dfb",
                                                "text": "[…]he is able to pierce a corselet with his eye; talks like a knell, and his hum is a battery."
                                            },
                                            {
                                                "example_id": "0fe82a17-b44d-4c0b-9cef-47dfa0d6857e",
                                                "sense_id": "0f132ed8-c56d-3b6e-b3bf-e475d96a4dfb",
                                                "text": "I go, and it is done. The bell invites me.\nHear it not, Duncan, for it is a knell\nThat summons thee to heaven or to hell."
                                            },
                                            {
                                                "example_id": "f33e31a4-3c5e-44e8-8e52-3656c505535e",
                                                "sense_id": "0f132ed8-c56d-3b6e-b3bf-e475d96a4dfb",
                                                "text": "The curfew tolls the knell of parting day,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d471df7-1a9f-3d10-8f11-8cbf432b71b8",
                                        "entry_id": "f51cef82-b500-352a-aa86-c5bc80649461",
                                        "glosses": [
                                            "A sign of the end or demise of something or someone."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb00d2b5-13d5-4d7e-af3c-f5f279d23506",
                                                "sense_id": "4d471df7-1a9f-3d10-8f11-8cbf432b71b8",
                                                "text": "But at the close of the war there was less thought of what [Britain] had retained than of what she had lost. She was parted from her American Colonies; and at the moment such a parting seemed to be the knell of her greatness."
                                            },
                                            {
                                                "example_id": "af0cdf28-8008-4720-a4c5-6724e56cf869",
                                                "sense_id": "4d471df7-1a9f-3d10-8f11-8cbf432b71b8",
                                                "text": "At Ballymacarrett, the main line diverges to the right on its way to Newcastle. All services were discontinued on it in 1950, and the abandonment order finally rang the knell of faint hopes that services would be restored as far as Comber, […]."
                                            },
                                            {
                                                "example_id": "477be55b-d00c-40a6-930c-42596e5e805a",
                                                "sense_id": "4d471df7-1a9f-3d10-8f11-8cbf432b71b8",
                                                "text": "The internet sounds the knell for conventional brands, predicts Professor Alec Reed, who has set up an Academy of Enterprise to chart the emerging individual economy. By making price and other comparisons ever easier, the internet strips them of mystique and turns them into commodities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e4d6064-af2e-469e-8bb8-9bcfba57ceed",
                        "source_entry_id": "035b0014-f317-3556-8a42-9c0629e4c477",
                        "source_sense_id": "d63fa6c1-c65e-3a7d-b0d7-6ea716751425",
                        "source_sense_description": "das Läuten der Totenglocke",
                        "target_lang_word": "passing-bell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passing-bell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6284f93-cf15-3e59-b37d-96efb9a92ddc",
                                        "entry_id": "ce8de75e-f27f-331f-b220-966f495eacb1",
                                        "glosses": [
                                            "Alternative form of passing bell."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd7ba43a-8f39-4af9-b9a4-781040bd8f1e",
                                                "sense_id": "e6284f93-cf15-3e59-b37d-96efb9a92ddc",
                                                "text": "1917, Wilfred Owen, Anthem for Doomed Youth\nWhat passing-bells for these who die as cattle?\n— Only the monstrous anger of the guns.\nOnly the stuttering rifles' rapid rattle\nCan patter out their hasty orisons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
