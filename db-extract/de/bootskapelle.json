                "senses": [
                    {
                        "sense_id": "489abc18-09d0-35b9-99c7-9dec23eb95c3",
                        "entry_id": "53272e89-5781-3d00-99d1-26a3e9d8bdc5",
                        "glosses": [
                            "einfach gestalteter Raum auf einem Boot, der für Andachten der Bootsleute genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fe2dff4-a979-4fd5-b0da-3d7fa98e3607",
                                "sense_id": "489abc18-09d0-35b9-99c7-9dec23eb95c3",
                                "text": "„Es war eine unbequeme Nacht auf der Fähre von Pireus nach Heraklion, aber ich konnte mich in der Bootskapelle aufheitern.“"
                            },
                            {
                                "example_id": "7318e71b-9ccd-4a93-86e6-3ae28d73c9b1",
                                "sense_id": "489abc18-09d0-35b9-99c7-9dec23eb95c3",
                                "text": "„Sobald sie an Bord waren und etwas Wasser getrunken hatten, gingen sie sofort in die Bootskapelle und beteten etwa eine Stunde, das hätten Sie mal sehen sollen\", berichtete Canepa dem kalifornischen Nachrichtenportal \"U-T San Diego\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0fb27f4a-b56c-3d90-bb72-828ea7ed8edb",
                        "entry_id": "53272e89-5781-3d00-99d1-26a3e9d8bdc5",
                        "glosses": [
                            "kleines, privates Musiker-Ensemble von Bootsleuten, die Musik machen"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "122ce0f5-dc75-468c-b620-59fc3d880e78",
                                "sense_id": "0fb27f4a-b56c-3d90-bb72-828ea7ed8edb",
                                "text": "„Statt dessen lädt Naidoo einen Rasta-Mann auf Deck und treibt die Bootskapelle zu wellenbrechendem Jazzrock-Reggae an.“"
                            },
                            {
                                "example_id": "c5ab54b8-96f7-4e69-86cf-3ec91641aeba",
                                "sense_id": "0fb27f4a-b56c-3d90-bb72-828ea7ed8edb",
                                "text": "„Angetrieben von den wilden Klängen der Bootskapelle erobern sie das Deck mit ihren Tänzen, artistischen Einlagen und Emotionen, drehen auf und in Rädern ihre Kreise und schleudern sich mit wackeligen Teeterboards durch die Lüfte.“"
                            },
                            {
                                "example_id": "2b0c81fe-3332-4e47-8c3b-20ed25fa4e7a",
                                "sense_id": "0fb27f4a-b56c-3d90-bb72-828ea7ed8edb",
                                "text": "„Ein Wasser- und Sonnenbad wurde nicht versäumt, und so herrschte denn auch auf der Rückfahrt auf Deck bei den Klängen der Bootskapelle eine frohe Stimmung, die als Ausdruck seelischer und körperlicher Loslösung vom Werktag zu werten waren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
