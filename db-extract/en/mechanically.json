                "senses": [
                    {
                        "sense_id": "7e29108d-131e-3b9a-b1b4-b33a5a2e60fa",
                        "entry_id": "43b06ea9-338d-32c0-9f39-1ba346161259",
                        "glosses": [
                            "From a mechanical point of view."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6f21bc4-88d7-4250-9a67-34f75cbfeab7",
                                "sense_id": "7e29108d-131e-3b9a-b1b4-b33a5a2e60fa",
                                "text": "mechanically speaking"
                            }
                        ]
                    },
                    {
                        "sense_id": "b497a6be-58a1-3d95-b5bb-fe9fd1b3f4e7",
                        "entry_id": "43b06ea9-338d-32c0-9f39-1ba346161259",
                        "glosses": [
                            "In a mechanical manner, mindlessly, thoughtlessly, automatically, without thinking."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7e6f49a-92af-4c95-9dd0-b23a2e8fd12a",
                                "sense_id": "b497a6be-58a1-3d95-b5bb-fe9fd1b3f4e7",
                                "text": "My fears, however, made me mechanically close my thighs; but the very touch of his hand insinuated between them, disclosed them and opened a way for the main attack.",
                                "translation": "Fanny Hill",
                                "english": "Fanny Hill"
                            },
                            {
                                "example_id": "33e20d62-7b37-49e6-a904-f1998feb90db",
                                "sense_id": "b497a6be-58a1-3d95-b5bb-fe9fd1b3f4e7",
                                "text": "\"Of what avail,\" and her eyes wandered mechanically round, \"is all the luxury by which I am surrounded, if it serve only as a barrier to all kindly feelings?\""
                            },
                            {
                                "example_id": "311670a5-267d-4537-9c01-2fbf68b830f0",
                                "sense_id": "b497a6be-58a1-3d95-b5bb-fe9fd1b3f4e7",
                                "text": "Provided they stick to their legal priors, rather than voting mechanically as Republican appointees, the justices seem likely to split on some of these cases — with real consequences for Trump’s agenda."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "733a3b2d-a907-4afc-a0d0-3e21af55e2c5",
                        "source_entry_id": "43b06ea9-338d-32c0-9f39-1ba346161259",
                        "source_sense_description": "from a mechanical point of view",
                        "target_lang_word": "mécaniquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mécaniquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09c4461e-ba59-3d59-8467-c100c03e23b0",
                                        "entry_id": "fe9bf80a-8fc4-3f1a-b3a4-410985bdcc93",
                                        "glosses": [
                                            "D’une façon mécanique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f448e123-b37f-4428-bec6-1d379612cd59",
                                                "sense_id": "09c4461e-ba59-3d59-8467-c100c03e23b0",
                                                "text": "La fausse idée qu’il est possible d’expliquer mécaniquement tous les effets des forces de la nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2e50c5e-a68c-3815-801e-00f70cf243de",
                                        "entry_id": "fe9bf80a-8fc4-3f1a-b3a4-410985bdcc93",
                                        "glosses": [
                                            "Machinalement ; sans y penser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9e40115-b692-40bc-b419-7105e75db93b",
                                                "sense_id": "c2e50c5e-a68c-3815-801e-00f70cf243de",
                                                "text": "J’ai écrit Julien, en très grand, avec de la Solexine dans les buissons. Crac une allumette. Je l’ai fait mécaniquement, sans réfléchir, à cause du vent. Et je suis calmement remonté sur mon Solex. J’étais pas à un kilomètre que ça flambait."
                                            },
                                            {
                                                "example_id": "394ec46c-e9d0-423c-b9f6-b5a0aa2ac74b",
                                                "sense_id": "c2e50c5e-a68c-3815-801e-00f70cf243de",
                                                "text": "Mécaniquement, elle se leva et déverrouilla le compartiment du convertisseur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82177072-c1d7-3a9b-9a14-9ba8444503b9",
                                        "entry_id": "fe9bf80a-8fc4-3f1a-b3a4-410985bdcc93",
                                        "glosses": [
                                            "Avec des moyens mécaniques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88c21b5f-f4cc-45c9-9058-29f577d47ec4",
                                                "sense_id": "82177072-c1d7-3a9b-9a14-9ba8444503b9",
                                                "text": "Avant de servir au tannage des cuirs, l'écorce de chêne est hachée mécaniquement ou à la main, puis réduite entre des meules en une poudre grossière qui prend le nom de tan."
                                            },
                                            {
                                                "example_id": "6c243170-8b88-480d-b265-fdf16b20038f",
                                                "sense_id": "82177072-c1d7-3a9b-9a14-9ba8444503b9",
                                                "text": "Le pâturage fut clos à l'automne 1974 et divisé en 4 parcs englobant chacun une part de la zone herbacée, du secteur débroussaillable mécaniquement et de la friche non mécanisable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea0e0f8d-95bc-3632-9fea-d909390b19e8",
                                        "entry_id": "fe9bf80a-8fc4-3f1a-b3a4-410985bdcc93",
                                        "glosses": [
                                            "Par un processus mécanique ; selon les règles de la mécanique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d1391bd-3fa8-482d-8f74-107150ca724f",
                                                "sense_id": "ea0e0f8d-95bc-3632-9fea-d909390b19e8",
                                                "text": "Avant, il était impossible d’accéder aux textes autrement qu'en ouvrant mécaniquement le papyrus. Là, avec la tomographie X en contraste de phase (XPCT), on arrive à reconstituer des lettres, un alphabet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15cda7ae-3eb3-4687-9f3c-22a5de63db17",
                        "source_entry_id": "43b06ea9-338d-32c0-9f39-1ba346161259",
                        "source_sense_description": "from a mechanical point of view",
