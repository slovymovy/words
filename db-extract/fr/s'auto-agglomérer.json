                "senses": [
                    {
                        "sense_id": "ecb31f89-dfd2-360f-b013-a2594bbdd902",
                        "entry_id": "3de9f080-bf44-3457-8408-7e613367f1cd",
                        "glosses": [
                            "S’agglomérer de soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4e6ccb9-5068-413d-a8db-0bb5fbcaa497",
                                "sense_id": "ecb31f89-dfd2-360f-b013-a2594bbdd902",
                                "text": "Les colorants s'agglomérant dans la bande J sont des colorants cyanines qui s'auto-agglomèrent en produisant des déplacements vers les longueurs d'ondes plus grandes et des courbes d'absorption plus marquées que les colorants non agglomérés."
                            },
                            {
                                "example_id": "b7695c67-d07e-4ab1-a954-66074a6ebfba",
                                "sense_id": "ecb31f89-dfd2-360f-b013-a2594bbdd902",
                                "text": "Le procédé selon l'invention permet globalement d'obtenir, à partir de matières premières exclusivement végétales, un matériau absorbant s'auto-agglomérant, pouvant lier, très rapidement et avec une grande capacité, des liquides à éliminer, par exemple des huiles, des solvants, des excréments animaux ou similaires."
                            }
                        ]
                    }
