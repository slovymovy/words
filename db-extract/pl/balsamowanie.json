                "senses": [
                    {
                        "sense_id": "ab5f09d3-36d4-37e5-88cc-db2f5574ea54",
                        "entry_id": "caf9dbf7-69a0-3551-a3d6-0b0531d4fd5c",
                        "glosses": [
                            "zabezpieczanie zwłok przed rozkładem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37f80c61-6bdd-4ba2-b897-d620b88039d1",
                                "sense_id": "ab5f09d3-36d4-37e5-88cc-db2f5574ea54",
                                "text": "Staroegipskie metody balsamowania zwłok okazały się niezwykle skuteczne."
                            },
                            {
                                "example_id": "a938c70b-81c9-47ad-9944-e4ad296d0e5d",
                                "sense_id": "ab5f09d3-36d4-37e5-88cc-db2f5574ea54",
                                "text": "Nowoczesne balsamowanie, zwane przez specjalistów tanatopraksją, polega na wpompowaniu w żyły zmarłego chemicznych płynów infuzyjnych i nasycenia ciała środkami chemicznymi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
