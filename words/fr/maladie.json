                {
                    "sense_id": "0d022e66-2c87-384e-b0b9-0fec8840509c",
                    "sense_definition": "Désordre profond ou altération morale affectant un groupe, une institution ou la société.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La corruption généralisée est une <w>maladie</w> qui ronge les institutions du pays.",
                            "target_lang_translations": {
                                "en": "Widespread corruption is a <w>cancer</w> eating away at the country's institutions.",
                                "ru": "Повсеместная коррупция — это <w>язва</w>, которая разъедает институты страны.",
                                "nl": "Wijdverspreide corruptie is een <w>kanker</w> die de instellingen van het land aantast.",
                                "de": "Die weitverbreitete Korruption ist ein <w>Krebsgeschwür</w>, das die Institutionen des Landes zerfrisst.",
                                "pl": "Powszechna korupcja to <w>rak</w>, który trawi instytucje kraju.",
                                "it": "La corruzione generalizzata è un <w>cancro</w> che corrode le istituzioni del paese.",
                                "cs": "Rozšířená korupce je <w>rakovinou</w>, která rozežírá instituce země.",
                                "tr": "Yaygınlaşan yolsuzluk, ülkenin kurumlarını kemiren bir <w>kanser</w> gibidir.",
                                "es": "La corrupción generalizada es un <w>cáncer</w> que corroe las instituciones del país.",
                                "zh": "普遍存在的腐败是侵蚀国家各个机构的<w>毒瘤</w>。"
                            }
                        },
                        {
                            "text": "L'individualisme excessif constitue selon lui la principale <w>maladie</w> du siècle.",
                            "target_lang_translations": {
                                "en": "According to him, excessive individualism is the main <w>scourge</w> of the age.",
                                "ru": "По его мнению, чрезмерный индивидуализм — главный <w>бич</w> века.",
                                "nl": "Volgens hem is overmatig individualisme de grootste <w>gesel</w> van deze eeuw.",
                                "de": "Übermäßiger Individualismus ist seiner Ansicht nach die größte <w>Geißel</w> des Jahrhunderts.",
                                "pl": "Według niego nadmierny indywidualizm jest główną <w>plagą</w> tego wieku.",
                                "it": "Secondo lui, l'individualismo eccessivo è il principale <w>flagello</w> del secolo.",
                                "cs": "Podle něj je přehnaný individualismus hlavní <w>pohromou</w> století.",
                                "tr": "Ona göre aşırı bireycilik, bu çağın başlıca <w>belası</w> sayılmalıdır.",
                                "es": "Según él, el individualismo excesivo constituye la principal <w>lacra</w> del siglo.",
                                "zh": "在他看来，过度的个人主义是这个时代最主要的<w>弊病</w>。"
                            }
                        }
