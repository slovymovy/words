                "senses": [
                    {
                        "sense_id": "78df6f48-48ea-38c4-9a86-3d49c7cf33bc",
                        "entry_id": "553f72bc-9377-38ca-87cf-fca0352da820",
                        "glosses": [
                            "Qui produit des cellules sanguines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d61148c-0953-4423-8ad7-6a7f4063b567",
                                "sense_id": "78df6f48-48ea-38c4-9a86-3d49c7cf33bc",
                                "text": "La conférence de consensus tenue à l’Institut Pasteur le 21 mars 2000 s’est donnée pour but de définir les méthodes optimales et/ou reconnues pour prévenir le risque aspergillaire chez les patients les plus exposés à ce risque en pratique médicale (principalement hémopathies, greffes de cellules souches hématopoïétiques et transplantations d'organes)."
                            },
                            {
                                "example_id": "571e2270-87e5-449b-8c64-db2ec69646b1",
                                "sense_id": "78df6f48-48ea-38c4-9a86-3d49c7cf33bc",
                                "text": "La grande majorité des patients traités par auto-greffe de cellules souches hématopoïétiques (CSH) reçoivent des transfusions de concentrés plaquettaires issus d’aphérèse (CPA) irradiés."
                            }
                        ]
                    }
                ],
