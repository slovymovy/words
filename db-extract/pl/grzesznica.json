                    {
                        "translation_id": "56862e5e-933d-4fef-b0e9-ba6414db25ec",
                        "source_entry_id": "6e8e25a8-f3b1-3326-9f51-b8a9eb9fa48b",
                        "source_sense_id": "66fa9284-c220-3f95-986f-7be687925c91",
                        "target_lang_word": "Sünderin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sünderin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd5daf36-6d9e-3a4f-b1db-b6858f5547d3",
                                        "entry_id": "935e5952-6784-3082-af2c-b498e8e62c5c",
                                        "glosses": [
                                            "weibliche Person, die etwas Unerwünschtes/Verbotenes (eine Sünde) begangen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc1a0f80-7bf6-416d-acdd-777782ef152d",
                                                "sense_id": "bd5daf36-6d9e-3a4f-b1db-b6858f5547d3",
                                                "text": "„Erzählungen von namenlosen Sünderinnen und Ehebrecherinnen wurden schon früh mit ihrem Namen verknüpft, und auch heute noch kursieren Legenden, die besagen, Maria [Magdalena] habe ein intimes Verhältnis zu Jesus gehabt und nach seinem Tod ein Kind von ihm bekommen.“:"
                                            },
                                            {
                                                "example_id": "092504a1-37ed-4d1f-a584-8310c43f17cb",
                                                "sense_id": "bd5daf36-6d9e-3a4f-b1db-b6858f5547d3",
                                                "text": "„Es war die Haltung, in der sie betete, in der sie als arme Sünderin Gott um Vergebung anflehte.“"
                                            },
                                            {
                                                "example_id": "7fbd83e6-c4c3-4499-80b3-31844d29c2ee",
                                                "sense_id": "bd5daf36-6d9e-3a4f-b1db-b6858f5547d3",
                                                "text": "„Völlig verdattert, mit vor Schreck erdfarbenen Gesichtern standen die drei armen Sünderinnen und brachten keinen Mucks hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20b97ec6-5103-40c3-bdae-00efd0827e0c",
                        "source_entry_id": "6e8e25a8-f3b1-3326-9f51-b8a9eb9fa48b",
                        "source_sense_id": "66fa9284-c220-3f95-986f-7be687925c91",
                        "target_lang_word": "грешница",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "грешница",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0194870e-3b4c-31fc-8efc-bf23dc77eaf2",
                                        "entry_id": "95cbb510-e67d-3851-8ca3-03f1e658a0ef",
                                        "glosses": [
                                            "религ. женск. к грешник; грешная женщина"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12e1bb7c-bd71-47a8-b9e5-b57bd62e3230",
                                                "sense_id": "0194870e-3b4c-31fc-8efc-bf23dc77eaf2",
                                                "text": "Сквозь них мелькала, в окнах кельи, // Лампада грешницы младой."
                                            },
                                            {
                                                "example_id": "5964d7bc-864f-4e21-9b6e-8c1fbef3f956",
                                                "sense_id": "0194870e-3b4c-31fc-8efc-bf23dc77eaf2",
                                                "text": "По милосердию своему, Бог не отвергнет меня, грешницу, отвергнутую вами."
                                            },
                                            {
                                                "example_id": "4344a3fe-f653-4453-9d5b-73c99a924dec",
                                                "sense_id": "0194870e-3b4c-31fc-8efc-bf23dc77eaf2",
                                                "text": "Мамочка была такая хорошая, не может быть, чтобы она была грешница, помилуй ее, Господи, сделай, чтобы она не мучилась."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
