        "nl-extract.jsonl": [
            {
                "entry_id": "1392a23e-dc15-3319-a0c5-6e89aa55fabd",
                "word": "brabbelen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "00a5fd4e-d06f-3f49-bcc1-789fe67a5c13",
                        "entry_id": "1392a23e-dc15-3319-a0c5-6e89aa55fabd",
                        "glosses": [
                            "slecht en onduidelijk praten met name van baby's"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "049e12b3-c5eb-4231-9152-b4cb899e846a",
                                "sense_id": "00a5fd4e-d06f-3f49-bcc1-789fe67a5c13",
                                "text": "Babette heeft het Rett syndroom, dat is een neurologische aandoening. Babette leek een normale baby, die ging kruipen, brabbelen en later begon te lopen en te praten. Maar toen ze twee jaar oud was, veranderde alles. Opeens stopte haar ontwikkeling. Sterker nog: ze ging achteruit in haar ontwikkeling."
                            },
                            {
                                "example_id": "4c847cac-4691-4692-8cef-e3dc19f15e60",
                                "sense_id": "00a5fd4e-d06f-3f49-bcc1-789fe67a5c13",
                                "text": "'Lang leve all-inclusive,' brabbelde hij tegen niemand in het bijzonder."
                            },
                            {
                                "example_id": "0a251a36-5bab-4039-8bfd-b4b8bf66924e",
                                "sense_id": "00a5fd4e-d06f-3f49-bcc1-789fe67a5c13",
                                "text": "Door de open raampjes klonk het geknetter van de radio, afgewisseld door plotselinge, gebrabbelde mededelingen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3890c0a-7aa1-4b02-af16-d8da939d0bab",
                        "source_entry_id": "1392a23e-dc15-3319-a0c5-6e89aa55fabd",
                        "source_sense_id": "00a5fd4e-d06f-3f49-bcc1-789fe67a5c13",
                        "source_sense_description": "slecht en onduidelijk praten met name van baby's",
                        "target_lang_word": "plappern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plappern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c83e5cf5-123a-34a2-9efa-98a80bae1f0b",
                                        "entry_id": "f269f3d5-1e42-34d2-8e8d-ba106c199203",
                                        "glosses": [
                                            "aus der Freude am Reden ohne besonderen inhaltlichen Tiefgang fröhlich vor sich hin erzählen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "809ae2ae-8adc-4cc8-aea7-1767e533ca25",
                                                "sense_id": "c83e5cf5-123a-34a2-9efa-98a80bae1f0b",
                                                "text": "Munter plapperte die Kleine auf dem Rücksitz des Wagens vor sich hin."
                                            },
                                            {
                                                "example_id": "25dbf10f-f4f5-49d0-8315-e54d572b1d81",
                                                "sense_id": "c83e5cf5-123a-34a2-9efa-98a80bae1f0b",
                                                "text": "„Wie die Äffchen haben die immer geplappert und geplappert und geplappert, auf der Stube.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e917aaf6-138e-35a4-9c1d-0bc5acccdbbb",
                                        "entry_id": "f269f3d5-1e42-34d2-8e8d-ba106c199203",
                                        "glosses": [
                                            "Falsches, Nutzloses oder Schädliches von sich geben"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f809f4d-d464-46aa-bf00-613ed0bbea4f",
                                                "sense_id": "e917aaf6-138e-35a4-9c1d-0bc5acccdbbb",
                                                "text": "Der plappert viel dummes Zeug, wenn der Tag lang ist."
                                            },
                                            {
                                                "example_id": "d8c4b211-1ffd-4d23-9a2f-1a3493a87d50",
                                                "sense_id": "e917aaf6-138e-35a4-9c1d-0bc5acccdbbb",
                                                "text": "„Ich las Gedichte, denn ich war nicht so bekloppt, dass ich laut vor mich hin geplappert hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3be5eaa-dd2d-4f80-b708-d0b8fd41e14c",
                        "source_entry_id": "1392a23e-dc15-3319-a0c5-6e89aa55fabd",
                        "source_sense_id": "00a5fd4e-d06f-3f49-bcc1-789fe67a5c13",
                        "source_sense_description": "slecht en onduidelijk praten met name van baby's",
                        "target_lang_word": "babble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5a81e53-403e-3305-abfe-8ef0b443f8c7",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To utter words indistinctly or unintelligibly; to utter inarticulate sounds"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a193d31e-8efa-4fef-b088-a258199d6910",
                                                "sense_id": "c5a81e53-403e-3305-abfe-8ef0b443f8c7",
                                                "text": "The men were babbling, so we couldn't make sense of anything."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c47b9baa-2f0e-332e-92e4-4a4dc73976cd",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To talk incoherently; to utter meaningless words."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c79109fb-d661-3c00-9758-f4a8acf17678",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To talk too much; to chatter; to prattle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25302be4-f21e-448d-a686-f6e33590dbcb",
                                                "sense_id": "c79109fb-d661-3c00-9758-f4a8acf17678",
                                                "text": "She babbled on for hours about the importance of some new gadget."
                                            },
                                            {
                                                "example_id": "c8e906d2-9612-4a7a-b541-b3608e07629f",
                                                "sense_id": "c79109fb-d661-3c00-9758-f4a8acf17678",
                                                "text": "Radical rather than rhetorical, babble like an oracle"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc4cf23d-6dbc-36b3-8685-1937c22652f0",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To make a continuous murmuring noise, like shallow water running over stones."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "329cdd9c-4482-4788-833f-570a45693ce7",
                                                "sense_id": "dc4cf23d-6dbc-36b3-8685-1937c22652f0",
                                                "text": "Hounds are said to babble, or to be babbling, when they are too noisy after having found a good scent."
                                            },
                                            {
                                                "example_id": "a9fdb455-748e-461e-88b2-0676886465f9",
                                                "sense_id": "dc4cf23d-6dbc-36b3-8685-1937c22652f0",
                                                "text": "In every babbling brook he finds a friend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36e3e448-085d-35bd-b189-d49c136d3bd5",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To utter in an indistinct or incoherent way; to repeat words or sounds in a childish way without understanding."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf1951c7-9d45-4f30-811c-032d04ed985c",
                                                "sense_id": "36e3e448-085d-35bd-b189-d49c136d3bd5",
                                                "text": "All this vvhile John had conn'd over ſuch a Catalogue of hard VVords, as vvere enough to conjure up the Devil; theſe he uſed to babble indifferently in all Companies, eſpecially at Coffee-houſes; ſo that his Neighbour Tradeſmen began to ſhun his Company as a Man that vvas crack'd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d682684-06b9-39d9-b933-f540bdd3f16a",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To reveal; to give away (a secret)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "babble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4e7c6fe-8c46-3897-88d0-854c232a0cdd",
                                        "entry_id": "055b559f-e87f-31e6-a26a-c4c94325685e",
                                        "glosses": [
                                            "Idle talk; senseless prattle"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2b5a6f7-cffb-4834-b40d-3f24b49b9454",
                                                "sense_id": "a4e7c6fe-8c46-3897-88d0-854c232a0cdd",
                                                "text": "This is mere moral babble.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "685a07fb-8dd3-3d37-af34-bf10357e5881",
                                        "entry_id": "055b559f-e87f-31e6-a26a-c4c94325685e",
                                        "glosses": [
                                            "Inarticulate speech; constant or confused murmur."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83e3dd33-3e95-4d1a-b387-ddd5aa6b48e5",
                                                "sense_id": "685a07fb-8dd3-3d37-af34-bf10357e5881",
                                                "text": "[M]an has an instinctive tendency to speak, as we see in the babble of our young children; whilst no child has an instinctive tendency to brew, bake, or write."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e422815-780f-3380-9203-3775f65a99cc",
                                        "entry_id": "055b559f-e87f-31e6-a26a-c4c94325685e",
                                        "glosses": [
                                            "A sound like that of water gently flowing around obstructions."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c49b847d-9dc8-449f-b931-734ac7599a1a",
                                                "sense_id": "4e422815-780f-3380-9203-3775f65a99cc",
                                                "text": "[T]he babble of the stream / Fell, and without the steady glare / Shrank the sick olive sere and small."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04d86b14-d42d-4b1c-9393-2ad793b776c5",
                        "source_entry_id": "1392a23e-dc15-3319-a0c5-6e89aa55fabd",
                        "source_sense_id": "00a5fd4e-d06f-3f49-bcc1-789fe67a5c13",
                        "source_sense_description": "slecht en onduidelijk praten met name van baby's",
                        "target_lang_word": "babiller",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babiller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2dd5ff5-cbdc-31c4-9ab3-1667ed6102c1",
                                        "entry_id": "53546258-4421-3a7a-a604-9a05dc3acb3d",
                                        "glosses": [
                                            "Parler beaucoup à propos de rien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ab8f52d-85af-454d-ac61-88bd8331959c",
                                                "sense_id": "f2dd5ff5-cbdc-31c4-9ab3-1667ed6102c1",
                                                "text": "… alors que le vaniteux s’était affublé d’un habit de couleur et babillait avec autant d’insolence et d’orgueil qu’un fat ?"
                                            },
                                            {
                                                "example_id": "751915e3-9ad0-4de1-bf56-2ac2174f7b3e",
                                                "sense_id": "f2dd5ff5-cbdc-31c4-9ab3-1667ed6102c1",
                                                "text": "Elle marchait fièrement, noblement, comme une martyre au Colysée. Elle avait néanmoins épuisé ses forces, car elle se laissa tomber sur le divan de son boudoir bleu, comme une femme près de se trouver mal, et elle resta les yeux attachés sur le kiosque en ruines où sa fille babillait avec la cousine Bette."
                                            },
                                            {
                                                "example_id": "ab7e9735-e401-450f-ab27-e54fa1fc0162",
                                                "sense_id": "f2dd5ff5-cbdc-31c4-9ab3-1667ed6102c1",
                                                "text": "La jeune métisse […], ne se fit pas prier pour babiller ; en quelques minutes elle mit le chasseur au courant des faits terribles dont elle avait été spectatrice."
                                            },
                                            {
                                                "example_id": "dac508af-d62e-4af3-be45-24f32cc1e311",
                                                "sense_id": "f2dd5ff5-cbdc-31c4-9ab3-1667ed6102c1",
                                                "text": "Elle babillait, minaudait comme au temps où elle tenait le haut du pavé dans le Brandebourg."
                                            },
                                            {
                                                "example_id": "b3e15c95-e766-4861-96ee-a4975e9e19c1",
                                                "sense_id": "f2dd5ff5-cbdc-31c4-9ab3-1667ed6102c1",
                                                "text": "Je sais, tout ce qui est interdit devient soudainement très attirant. Du moins, c’est la conclusion qu’a tirée sœur Carmelle la centième fois où elle m’a pognée en train de babiller dans le corridor en sixième année."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb5efe2d-d884-33ef-b4b5-3f743bdf474e",
                                        "entry_id": "53546258-4421-3a7a-a604-9a05dc3acb3d",
                                        "glosses": [
                                            "Parler sans cohérence de vocabulaire, en parlant d’un bébé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f03a13a-fb7b-4b06-8b24-744cc809aea6",
                                                "sense_id": "eb5efe2d-d884-33ef-b4b5-3f743bdf474e",
                                                "text": "Une année, deux années s’écoulèrent. Le fils d’Elhamy fut sevré, grandit ; il babillait gentiment sous la garde de sa nourrice …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "270ef808-57de-37a9-a26d-ac6ee501122e",
                                        "entry_id": "53546258-4421-3a7a-a604-9a05dc3acb3d",
                                        "glosses": [
                                            "Produire un bruit semblable à un babil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca860abe-c6a4-4ccb-a710-eed964176bda",
                                                "sense_id": "270ef808-57de-37a9-a26d-ac6ee501122e",
                                                "text": "Angoulême, ville bizarrement juchée sur un coteau fort roide au pied duquel la Charente fait babiller deux ou trois moulins, …."
                                            },
                                            {
                                                "example_id": "bcb55e64-4cc2-4fa5-8398-c05bcf209442",
                                                "sense_id": "270ef808-57de-37a9-a26d-ac6ee501122e",
                                                "text": "Fribourg a la physionomie la plus amicale, la plus attrayante. Ah ! Les jolis ruisseaux qui s’épanchent et babillent le long de ses rues ! On dirait qu’ils courent au-devant du voyageur pour le saluer et lui offrir leur onde rafraîchissante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
