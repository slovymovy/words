                            {
                                "example_id": "c1021cfd-e28f-43e9-8b85-b3424c11df89",
                                "sense_id": "497f7620-26de-3de2-9eb3-3afdd65f6c1a",
                                "text": "„Ab dem Frühjahr 2003 war er hauptverantwortlicher Trainer des polnischen B-Kaders.“"
                            },
                            {
                                "example_id": "ba604c6d-49ab-402f-90c9-9fa0efe2f35f",
                                "sense_id": "497f7620-26de-3de2-9eb3-3afdd65f6c1a",
                                "text": "„Als hauptverantwortlicher Trainer der Nationalmannschaft aus Tschechien war Hasek nur mit zwei Testspielen, in denen er mit der Mannschaft arbeiten konnte, in die EM-Vorbereitung gegangen:“ […]."
                            },
                            {
                                "example_id": "cdcb5ee6-df2c-42a5-bb19-4821ee1c03b4",
                                "sense_id": "497f7620-26de-3de2-9eb3-3afdd65f6c1a",
                                "text": "„»Wir haben da ein großes Trainertalent bei uns«, erklärte HSV-Sportvorstand Jonas Boldt am Montag und bestätigte, dass Polzin am Sonnabend […] im Auswärtsspiel beim FC Hansa Rostock \"hundertprozentig\" der hauptverantwortliche Coach sein werde.“"
                            },
                            {
                                "example_id": "dc9a4f50-fc93-4afd-87c6-330e0a334fc7",
                                "sense_id": "497f7620-26de-3de2-9eb3-3afdd65f6c1a",
                                "text": "[Fußball:] „Stand der Club nach der Freistellung von Geschäftsführer Marcel Schäfer zunächst ohne hauptverantwortliche sportliche Leitung da, ist nun seit Juli Peter Christiansen als Geschäftsführer im Amt.“"
                            },
                            {
                                "example_id": "5c611c95-538b-4b38-b49d-5365313dfc91",
                                "sense_id": "497f7620-26de-3de2-9eb3-3afdd65f6c1a",
                                "text": "„Industrie-Designer Jonathan Ive ist hauptverantwortlicher Designer bei Apple.“"
                            },
                            {
                                "example_id": "ae666094-fddb-49fe-99c0-483fce4da466",
                                "sense_id": "497f7620-26de-3de2-9eb3-3afdd65f6c1a",
                                "text": "„Die genaue Ermittlung der Opferzahlen erschwerte das für den Krieg hauptverantwortliche NS-Regime durch Geheimhaltung, Aktenvernichtung und Deklarieren von Massenmorden als Kriegsfolgen.“"
                            },
                            {
                                "example_id": "eb7c8188-5772-4b71-a59e-8f2f2dccceda",
                                "sense_id": "497f7620-26de-3de2-9eb3-3afdd65f6c1a",
                                "text": "„Derweil will Israel den Druck auf die für den Terroranschlag vom 7. Oktober hauptverantwortliche Terrororganisation Hamas im Gazastreifen erhöhen.“"
                            },
                            {
                                "example_id": "de4df8c2-c77c-48af-b248-175752abc31e",
                                "sense_id": "497f7620-26de-3de2-9eb3-3afdd65f6c1a",
                                "text": "„Ein Schienenkartell prellte Bahn und Steuerzahler jahrelang um viel Geld. Nach Informationen der \"Süddeutschen Zeitung\" zahlt der österreichische Stahlkonzern Voestalpine nun 50 Millionen Euro Schadenersatz. Doch der nach Erkenntnissen des Bundeskartellamtes hauptverantwortliche Konzern Thyssen-Krupp weigert sich zu zahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e4d4cc65-fb27-3169-bbeb-d0072eb9ea97",
                        "entry_id": "b50a4f7e-4468-36e6-b463-5bb8279a8a7e",
                        "glosses": [
                            "entscheidende Ursache für ein Problem oder Schaden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fd9141d-95f1-45e7-941d-e36ee1b46358",
                                "sense_id": "e4d4cc65-fb27-3169-bbeb-d0072eb9ea97",
                                "text": "„Schon seit Jahrzehnten gehen die Bestände zurück: Zwischen 1980 bis 2016 ist die Zahl der Vögel in Europa um rund ein Viertel gesunken. Die Autorinnen und Autoren einer aktuellen Studie haben die intensive Landwirtschaft als hauptverantwortliche Ursache identifiziert.“"
                            },
                            {
                                "example_id": "12df561b-1742-47f8-ac10-4eb966ca9e66",
                                "sense_id": "e4d4cc65-fb27-3169-bbeb-d0072eb9ea97",
                                "text": "„Das Verbrennen von Braunkohle in den Kraftwerken […] emittiert auch hohe Mengen des für die globale Erwärmung hauptverantwortlichen Treibhausgases Kohlenstoffdioxid.“"
                            },
                            {
                                "example_id": "d72fae6c-65b8-47d5-95ee-e7db8d2e9e3e",
                                "sense_id": "e4d4cc65-fb27-3169-bbeb-d0072eb9ea97",
                                "text": "„Heute ist es auf der Welt im Durchschnitt 1,2 Grad wärmer als 1880. […] Hauptverantwortlich für den Temperaturanstieg ist die Zunahme von CO2 in der Atmosphäre.“"
                            },
                            {
                                "example_id": "dbd7702c-c770-4c55-9274-23fe1e136021",
                                "sense_id": "e4d4cc65-fb27-3169-bbeb-d0072eb9ea97",
                                "text": "„Im südlichen Bayern hat das Zusammentreffen gleich mehrerer hochwasserträchtiger Faktoren bereits zu Überschwemmungen und zu Hochwasser an Flüssen geführt. Hauptverantwortlich ist die Großwetterlage: Ein Tief zieht von Norditalien langsam über die Ostalpen bis nach Polen.“"
                            },
                            {
                                "example_id": "4e33f8c5-eab2-45da-a42c-f3f1d82f2461",
                                "sense_id": "e4d4cc65-fb27-3169-bbeb-d0072eb9ea97",
                                "text": "[Fußball:] „Für die Misere war vor allem die Torflaute mit dem vereinsinternen Negativrekord mit 33 Toren aus 46 Spielen hauptverantwortlich.“"
                            },
                            {
                                "example_id": "8f90e5e4-eb14-40b4-b0c4-bfe9230041f7",
                                "sense_id": "e4d4cc65-fb27-3169-bbeb-d0072eb9ea97",
                                "text": "„Ulbrichs Kanzlei ist in Deutschland hauptverantwortlich für die Klagewelle gegen Hersteller von Impfstoffen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
