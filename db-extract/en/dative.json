                        "entry_id": "45177c6a-020a-3d30-b552-1703f0e7f7b5",
                        "glosses": [
                            "A word inflected in the dative case."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf3adf5d-8db3-4149-9a01-ae4512082f8c",
                        "source_entry_id": "45177c6a-020a-3d30-b552-1703f0e7f7b5",
                        "source_sense_description": "word in the dative",
                        "target_lang_word": "Dativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d8d1ee0-5501-3513-9a1d-eefbb3132d06",
                                        "entry_id": "2c1f1f91-5400-359c-86bf-320f3fd3b7d7",
                                        "glosses": [
                                            "Wem-Fall, (im Deutschen und Lateinischen) 3. Fall (Kasus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "823752fb-b6b7-44cd-9014-36e6a305b21a",
                                                "sense_id": "4d8d1ee0-5501-3513-9a1d-eefbb3132d06",
                                                "text": "Im Dativ stehen im Satz oft Personen, denen geholfen wird: \"Dem Manne kann geholfen werden.\""
                                            },
                                            {
                                                "example_id": "2f8ab014-cf15-46c5-94a9-a77e1a20d479",
                                                "sense_id": "4d8d1ee0-5501-3513-9a1d-eefbb3132d06",
                                                "text": "„Was Holländer mit dem deutschen Dativ haben, ist mir schleierhaft.“"
                                            },
                                            {
                                                "example_id": "4d1c482d-cab2-4dbb-98cf-b583788ea6eb",
                                                "sense_id": "4d8d1ee0-5501-3513-9a1d-eefbb3132d06",
                                                "text": "„Unsere Eltern belegten einen Sprachkurs nach dem anderen, sie lernten unaufhörlich Vokabeln, sie waren irritiert, wenn sie merkten, dass die deutschen Nachbarn Dativ statt Genitiv benutzten, und schauten daheim in ihren Lehrbüchern nach.“"
                                            },
                                            {
                                                "example_id": "25e94e29-62ee-489c-8b41-2343b768f59f",
                                                "sense_id": "4d8d1ee0-5501-3513-9a1d-eefbb3132d06",
                                                "text": "„Der Genitiv ist auf vielen Feldern auf dem Rückzug und wird durch den Dativ ersetzt.“"
                                            },
                                            {
                                                "example_id": "54a6928e-680a-44a4-af9f-7707d654fc3e",
                                                "sense_id": "4d8d1ee0-5501-3513-9a1d-eefbb3132d06",
                                                "text": "„Auch in den Überlieferungen wird der Dativ aufgeführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
