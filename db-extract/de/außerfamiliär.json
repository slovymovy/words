                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e47d7a05-0b3b-4574-9092-ad28be9407ec",
                                "sense_id": "a077ccdb-2905-348d-87be-881b5fa61af8",
                                "text": "Die außerfamiliäre Betreuung kann zum Beispiel in Krippe, Kita, in Kindergärten oder durch eine Tagesmutter geleistet werden."
                            },
                            {
                                "example_id": "4a8669d1-e9cb-4971-af6d-9a717a48644f",
                                "sense_id": "a077ccdb-2905-348d-87be-881b5fa61af8",
                                "text": "Die Kinder lernen so spielerisch die Beziehungsaufnahme in ihrem schulischen und außerfamiliären Umfeld."
                            }
                        ],
