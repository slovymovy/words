                        "glosses": [
                            "Que l’on peut amalgamer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b7b90aa-a7ff-4454-9d1f-516556f6fbb1",
                                "sense_id": "f9bc80bd-82dd-31e0-91ef-5dce61495a21",
                                "text": "Ductile et résistant sur l’os calciné ; soluble en bleu dans l’acide nitrique, sulfurique et l’ammoniaque purs ; dissolutions précipitées par le fer, et le précipité est amalgamable."
                            },
                            {
                                "example_id": "b15e2d9a-ead0-4320-8ae1-f7692a82d40a",
                                "sense_id": "f9bc80bd-82dd-31e0-91ef-5dce61495a21",
                                "text": "L’or se présente dans ses minerais, en partie à l’état d’or amalgamable par le mercure, et en partie dans des conditions physiques ou chimiques telles qu’on ne peut réussir à l’amalgamer."
                            }
                        ]
                    }
