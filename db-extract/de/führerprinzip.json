                        "entry_id": "bfd692bc-c558-357a-b054-3c1fbc12fe6c",
                        "glosses": [
                            "the authoritarian principle that a group is entirely subordinated to a leader (Führer) who has ultimate control over it"
                        ],
                        "tags": [
                            "Nazism",
                            "neuter",
