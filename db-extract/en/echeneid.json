                        "sense_id": "6dd1e2b9-e2ac-3dfd-95ab-3477f8922080",
                        "entry_id": "3c8883b8-e328-32fb-9429-4c2b1b388c76",
                        "glosses": [
                            "Any fish of the family Echeneidae (the remoras or suckerfish)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c7c132a-8207-46f5-b127-15c800c3241a",
                                "sense_id": "6dd1e2b9-e2ac-3dfd-95ab-3477f8922080",
                                "text": "They are characterized by a unique cephalic sucking disc by which the echeneid attaches itself externally to its host."
                            },
                            {
                                "example_id": "3740f325-397d-4a3d-8388-07f854bd46b9",
                                "sense_id": "6dd1e2b9-e2ac-3dfd-95ab-3477f8922080",
                                "text": "Postflexion stage, larvae, and juveniles of some echeneids have been illustrated by Richards (2005a)."
                            },
                            {
                                "example_id": "596430db-3cae-4d12-8a8c-b1ac680da7d8",
                                "sense_id": "6dd1e2b9-e2ac-3dfd-95ab-3477f8922080",
                                "text": "With a force applied to their caudal peduncle, the echeneids generated suction pressure differentials averaging –92.7 kPa within the disk cavity while attached to Plexiglas."
                            }
                        ]
                    }
                ],
