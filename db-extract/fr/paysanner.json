                    }
                ],
                "senses": [
                    {
                        "sense_id": "1fcdf888-550e-3fe5-8bf3-16832395f76d",
                        "entry_id": "e1cf0b12-f98b-315d-a42f-39fa2a729c5c",
                        "glosses": [
                            "Vivre, penser à la manière des paysans."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c5ba9152-3e99-4e86-9dc0-a3b2052dccea",
                                "sense_id": "1fcdf888-550e-3fe5-8bf3-16832395f76d",
                                "text": "Voici quinze nuits passées à paysanner, malgré mes douleurs."
                            },
                            {
                                "example_id": "0350e453-48fe-4bda-955f-9c989636a2a9",
                                "sense_id": "1fcdf888-550e-3fe5-8bf3-16832395f76d",
                                "text": "Il en arriva, sous la pression de cette idée, à s’adultérer la vue, à se convaincre que les traits de sa femme se paysannaient ; elle avait été jadis assez plaisante, avec ses yeux noirs, ses cheveux bruns, sa bouche un peu grande, sa figure en fer de serpe, un peu chiffonnée et fraîche. Maintenant, les lèvres lui parurent s’effiler, le nez se durcir, le teint se hâler, les yeux s’imprégner d’eau froide."
                            },
                            {
                                "example_id": "258e6750-aa45-4f6b-9d43-1135b203d2e1",
                                "sense_id": "1fcdf888-550e-3fe5-8bf3-16832395f76d",
                                "text": "Puis, de nouveau, nous reprenions nos jeux et je me remettais à paysanner."
                            },
                            {
                                "example_id": "1f2ff147-afde-47e4-9e51-193a74fe4961",
                                "sense_id": "1fcdf888-550e-3fe5-8bf3-16832395f76d",
                                "text": "…, Pierre-Auguste Renoir était d’Essoyes par le cœur. […]. Chevalet sur le dos, tubes sous le bras, il part « paysanner » sur les bords de l’Ource."
                            }
                        ]
                    }
                ],
