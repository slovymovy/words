                                "example_id": "56fa307b-f4c3-45f6-a66f-64f3f9b422a2",
                                "sense_id": "d99f0c47-fa49-35f0-a4d6-a2f25d0848a3",
                                "text": "Ze droeg een mooie gouden enkelband tijdens het strandfeest.",
                                "translation": "She wore a beautiful golden anklet during the beach party.",
                                "english": "She wore a beautiful golden anklet during the beach party."
                            },
                            {
                                "example_id": "d3906972-af51-484e-9cd7-2d506ce12775",
                                "sense_id": "d99f0c47-fa49-35f0-a4d6-a2f25d0848a3",
                                "text": "Het meisje was blij met het zilveren enkelbandje dat ze als cadeau kreeg.",
                                "translation": "The girl was happy with the silver anklet she received as a gift.",
                                "english": "The girl was happy with the silver anklet she received as a gift."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed9d7e8d-cb44-3cfa-b734-8f0bd08affcb",
                        "entry_id": "e58cdf24-4265-3524-9efd-f9a063ce7159",
                        "glosses": [
                            "ankle monitor (electronic tracking device fixed around the ankle)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "ad028034-95f3-4aed-88b8-a44822e3f23c",
                                "sense_id": "ed9d7e8d-cb44-3cfa-b734-8f0bd08affcb",
                                "text": "De politie besloot om de verdachte vrij te laten onder voorwaarde van het dragen van een enkelband.",
                                "translation": "The police decided to release the suspect under the condition of wearing an ankle monitor.",
                                "english": "The police decided to release the suspect under the condition of wearing an ankle monitor."
                            }
                        ]
                    }
