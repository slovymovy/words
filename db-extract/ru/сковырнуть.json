                "senses": [
                    {
                        "sense_id": "fd6ddcd5-5d96-3976-ab7a-df4ddf1e40af",
                        "entry_id": "7077cf42-4631-363b-a24b-f683ca475775",
                        "glosses": [
                            "поперечным движением сорвать, откинуть в сторону что-либо с какой-то поверхности или основы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a546fd5-2bf7-4747-b942-de7fa81ac2f6",
                                "sense_id": "fd6ddcd5-5d96-3976-ab7a-df4ddf1e40af",
                                "text": "Сковырнуть крышку с бутылки"
                            },
                            {
                                "example_id": "2780752b-0867-4af8-b71a-e24f71c9039d",
                                "sense_id": "fd6ddcd5-5d96-3976-ab7a-df4ddf1e40af",
                                "text": "Сковырнуть запёкшуюся кровь"
                            },
                            {
                                "example_id": "8814203a-9818-413f-8aad-e32d57a1170f",
                                "sense_id": "fd6ddcd5-5d96-3976-ab7a-df4ddf1e40af",
                                "text": "Подкопались под него враги, сковырнули с насиженного места и вытряхнули со службы за незнание иностранных языков."
                            }
                        ]
                    }
