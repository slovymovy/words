{
    "word_family": [
        "equivocate",
        "equivocator",
        "equivocal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2dabd0f-c5d1-3669-8eff-f882f6e1fb4b",
                    "sense_definition": "The use of ambiguous language to conceal the truth or avoid committing oneself.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's <w>equivocation</w> during the interview left voters feeling frustrated and confused.",
                            "target_lang_translations": {
                                "zh": "政客在采访中的<w>含糊其辞</w>让选民感到沮丧和困惑。"
                            }
                        },
                        {
                            "text": "Avoid <w>equivocation</w> when you are asked a direct question about your future plans.",
                            "target_lang_translations": {
                                "zh": "当被问及关于未来的明确计划时，切忌说<w>模棱两可的话</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "evasion",
                        "prevarication",
                        "ambiguity"
                    ],
                    "antonyms": [
                        "clarity",
                        "frankness"
                    ],
                    "common_phrases": [
                        "constant equivocation",
                        "avoid equivocation"
                    ],
                    "target_lang_definitions": {
                        "zh": "使用模棱两可或含糊其辞的语言来隐瞒真相或避免表态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "模棱两可的话",
                                "target_lang_sense_clarification": "指含糊不清、不明确表态的说辞"
                            },
                            {
                                "target_lang_word": "含糊其辞",
                                "target_lang_sense_clarification": "指用不明确的语言回避问题"
                            },
                            {
                                "target_lang_word": "推诿之词",
                                "target_lang_sense_clarification": "用于逃避责任或表态的借口或言辞"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1431a411-b5f0-39e6-9e10-6a1ac5c6ec8f",
                    "sense_definition": "A logical fallacy caused by using a word or phrase with two different meanings in the same argument.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The argument relies on <w>equivocation</w> by switching the definition of freedom halfway through the speech.",
                            "target_lang_translations": {
                                "zh": "该论证依赖于<w>偷换概念</w>，在演讲中途变换了“自由”的定义。"
                            }
                        },
                        {
                            "text": "Students often struggle to identify <w>equivocation</w> in complex philosophical texts.",
                            "target_lang_translations": {
                                "zh": "学生们在复杂的哲学文本中往往很难识别出<w>歧义谬误</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ambiguity"
                    ],
                    "target_lang_definitions": {
                        "zh": "逻辑学上的一种谬误，指在同一论证中偷换同一个词语的不同含义。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "偷换概念",
                                "target_lang_sense_clarification": "逻辑谬误，暗中改变概念的内涵"
                            },
                            {
                                "target_lang_word": "歧义谬误",
                                "target_lang_sense_clarification": "哲学与逻辑学专业术语，因词语多义引起的谬误"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}