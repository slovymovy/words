{
    "word_family": [
        "marchand",
        "marchandage",
        "marchandise"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ba35855-80a9-3a4c-a2e9-bb7786bf2ff4",
                    "sense_definition": "Discuter du prix d'un bien ou d'un service afin d'obtenir un rabais.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au marché aux puces, les clients aiment <w>marchander</w> le prix des meubles anciens."
                        },
                        {
                            "text": "Mon père a <w>marchandé</w> pendant dix minutes avant de conclure cette bonne affaire."
                        }
                    ],
                    "synonyms": [
                        "bargainer",
                        "barguigner"
                    ],
                    "common_phrases": [
                        "marchander le prix"
                    ]
                },
                {
                    "sense_id": "91b7edad-6640-311b-af7d-683a23559cb3",
                    "sense_definition": "Donner ou accorder avec parcimonie, souvent employé avec une négation pour signifier prodiguer généreusement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "generosite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les bénévoles n'ont pas <w>marchandé</w> leurs efforts pour reconstruire le village après l'inondation."
                        },
                        {
                            "text": "Cette directrice ne <w>marchande</w> jamais ses éloges envers les employés les plus dévoués."
                        }
                    ],
                    "common_phrases": [
                        "ne pas marchander ses efforts",
                        "ne pas marchander sa peine"
                    ]
                },
                {
                    "sense_id": "4a91ea1e-b062-368a-a5b4-b296f1f5ac4d",
                    "sense_definition": "Hésiter ou tergiverser longuement avant d'agir ou de prendre une décision.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face au danger immédiat, le jeune homme s'est élancé sans <w>marchander</w> pour sauver l'enfant."
                        },
                        {
                            "text": "Il n'y a plus le temps d'hésiter, il faut agir sans <w>marchander</w>."
                        }
                    ],
                    "common_phrases": [
                        "sans marchander"
                    ]
                }
            ]
        }
    ]
}