                ],
                "senses": [
                    {
                        "sense_id": "15aa3911-6141-3b05-88e8-f6e26b82aeea",
                        "entry_id": "9689b71d-2ac5-3625-a31e-d8c3a244e63b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6180f36-acd4-4d41-83b1-2da46bcb22bb",
                                "sense_id": "15aa3911-6141-3b05-88e8-f6e26b82aeea",
                                "text": "Frau Vögele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5798b629-af1b-45f5-8d4e-b5c3713a950e",
                                "sense_id": "15aa3911-6141-3b05-88e8-f6e26b82aeea",
                                "text": "Herr Vögele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2c12ff12-db0a-4d67-a6c0-b35be2d6ad9a",
                                "sense_id": "15aa3911-6141-3b05-88e8-f6e26b82aeea",
                                "text": "Die Vögeles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "af0a02a1-2a62-44e8-bc39-1ac0e1d2b331",
                                "sense_id": "15aa3911-6141-3b05-88e8-f6e26b82aeea",
                                "text": "Der Vögele trägt nie die Pullover, die die Vögele ihm strickt."
                            },
                            {
                                "example_id": "4851768e-e01f-447f-a2a2-6eef5b100100",
                                "sense_id": "15aa3911-6141-3b05-88e8-f6e26b82aeea",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Vögele kommt, geht der Herr Vögele.“"
                            },
                            {
                                "example_id": "15819a57-ca4b-4a84-8740-425d5d78c79a",
                                "sense_id": "15aa3911-6141-3b05-88e8-f6e26b82aeea",
                                "text": "Vögele kommt und geht."
                            },
                            {
                                "example_id": "9ef748e3-19a0-453c-9ab6-88480209ba5c",
                                "sense_id": "15aa3911-6141-3b05-88e8-f6e26b82aeea",
                                "text": "Vögeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
