                "senses": [
                    {
                        "sense_id": "dbe9966d-102b-319f-9f96-bfa600f573a6",
                        "entry_id": "e6bef05d-e9de-3f57-8dbb-94d553275dc7",
                        "glosses": [
                            "Régler le spine, la rigidité, d’une flèche, à une valeur inférieure à la moyenne (au tir à l’arc)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45a867cd-9c18-4832-9a1c-08c8798eb83b",
                                "sense_id": "dbe9966d-102b-319f-9f96-bfa600f573a6",
                                "text": "Et si ton arc préhisto n’a pas de fenêtre, il faudra sous-spiner, évidemment."
                            },
                            {
                                "example_id": "300f74f9-98ad-4377-af01-9595222a8306",
                                "sense_id": "dbe9966d-102b-319f-9f96-bfa600f573a6",
                                "text": "J’ai tiré en longbow et j’ai eu le même souci de sortie de flèche avec des futs ^([sic : fûts]) trop rigides ; essaie de sous-spiner pour voir, le résultat est parfois flagrant."
                            },
                            {
                                "example_id": "e61d23dd-099f-4255-b605-221cbb461e6d",
                                "sense_id": "dbe9966d-102b-319f-9f96-bfa600f573a6",
                                "text": "Pas de fenêtre, penser à fortement sous-spiner les futs ^([sic : fûts])."
                            }
                        ]
                    }
