        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "42f9dbf3-a857-3261-8e49-ade7796f3cc0",
                    "sense_definition": "Распространённая китайская фамилия.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Господин <w>У</w> прибыл на конференцию вовремя.",
                            "target_lang_translations": {
