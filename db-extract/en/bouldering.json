                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5471ba06-ed8a-4c4b-8a83-46391478dde0",
                        "source_entry_id": "be134740-040a-3814-9621-fa0242f953f2",
                        "source_sense_id": "2764b75f-2eb6-32c7-a564-e26211458194",
                        "source_sense_description": "climbing on large boulders",
                        "target_lang_word": "bloc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bloc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d34ac11e-f0a6-35d1-9b71-eca0fa915526",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Masse, gros morceau d’une matière pesante et dure, telle que la pierre, le marbre, le fer non encore travaillés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71a93740-be8f-448b-9245-7f1d55d03e10",
                                                "sense_id": "d34ac11e-f0a6-35d1-9b71-eca0fa915526",
                                                "text": "D'énormes blocs de corail éblouissants de blancheur sortaient de l'eau et semblaient les débris d'une gigantesque convulsion."
                                            },
                                            {
                                                "example_id": "d2f9bda9-1f29-4654-a441-f21e3cde53c0",
                                                "sense_id": "d34ac11e-f0a6-35d1-9b71-eca0fa915526",
                                                "text": "On peut rapporter aussi à la pression des glaces le morcellement des bancs de grès vosgiens à poudingues dont les blocs s'entassent de façon chaotique au pied de falaises […]."
                                            },
                                            {
                                                "example_id": "0fff6418-63ad-4fc6-b973-12820eac13ad",
                                                "sense_id": "d34ac11e-f0a6-35d1-9b71-eca0fa915526",
                                                "text": "Il m'est dit à chaque instant que l'un des grands soucis des autorités départementales, c'est l'entretien des routes, souvent emportées par des torrents, par les coulées de boue, par les éboulements, par des chutes de blocs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1e3f8cf-3079-3c35-815d-0d14625e7b00",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Bloc erratique"
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85477f3e-5530-3614-b246-20443253edd7",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Masse de pierre qui a été taillée avant d’être transportée à pied d’œuvre pour une construction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a42b534-fdad-3560-89b4-13a0e359dd4a",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Pâté de maisons ou de constructions diverses situé entre des rues perpendiculaires."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8366bd7d-9fa3-4540-bdce-085d7a1252b2",
                                                "sense_id": "7a42b534-fdad-3560-89b4-13a0e359dd4a",
                                                "text": "[À New York], comme ce qu'on appelle un bloc, ou pâté de maisons (une \"île\", comme nous disons en France, et comme disaient les Latins), a généralement, dans le sens des rues ou des avenues, une longueur régulière, [l'étranger] connaît aussi la distance qu'il doit franchir pour se transporter d'un point à un autre. Ainsi, les rues transversales aux avenues se succédant à des distances de 75 mètres, s'il part de la 1ère rue pour aller à la 100e, il sait qu'il doit faire un parcours de 7.500 mètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e35b39f-78fc-33c1-bb2a-9cc5c2356177",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Parpaing"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "920362b1-4f42-3c7d-8c65-28784cad2b27",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Style d'escalade pratiqué sur des rochers ou murs de faible hauteur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e4f31fa-83f5-419e-b958-52fe4c8aef1e",
                                                "sense_id": "920362b1-4f42-3c7d-8c65-28784cad2b27",
                                                "text": "Vous ne développerez pas les mêmes qualités selon que vous faites du bloc, de la compétition de difficulté ou de grandes voies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3f272c1-8732-3b3e-840d-cd9cb6c529ee",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Billot de bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a23dc1ef-ca89-4444-a1f2-472a53b31e4d",
                                                "sense_id": "b3f272c1-8732-3b3e-840d-cd9cb6c529ee",
                                                "text": "Chaque soir, les cueilleurs se groupaient dans notre salle commune, autour de la table à six pieds, massive comme un bloc de boucher, pour le dernier verre de kirch de la journée et les comptes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd5a9496-1cd7-3188-9993-3269bafe2083",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Billot de plomb sur lequel les graveurs posent et arrêtent les ouvrages qu’ils veulent graver."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdd2e73b-c7dd-3840-8cdd-25f292c02925",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Masse de bois d’où le raffineur détachait la forme du pain de sucre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb064430-20d4-3088-bde8-8f40d707be3c",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Plusieurs feuillets de papier de même format légèrement collés ensemble sur un seul côté, de manière que l’on puisse les détacher facilement un à un pour prendre des notes ou écrire des lettres. → voir bloc-note."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "331bc6b2-2d31-3bf3-a357-272035b0115c",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Amas, assemblage de diverses choses, et principalement de plusieurs marchandises."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c8f7c53-0b07-4f56-b29a-dc94a2f9a572",
                                                "sense_id": "331bc6b2-2d31-3bf3-a357-272035b0115c",
                                                "text": "Faire un bloc de diverses marchandises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffcfd1a5-7b2e-3ece-bc49-4cb585e1e228",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "séquence d'information"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50fa8a08-dd1f-3dbc-9702-e514c6a79204",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "séquence d'information",
                                            "Manière de grouper un groupe d'instructions, spécifiquement: Section ou contenu d'une section d'un programme."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84eaa7e0-ab34-4b37-ac37-0e22b4cbd54e",
                                                "sense_id": "50fa8a08-dd1f-3dbc-9702-e514c6a79204",
                                                "text": "La durée de vie d’un compound literal est soit statique soit automatique selon que sa déclaration est faite au niveau fichier ou au niveau d’un bloc d’instructions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20abdc6e-1260-3252-9b91-c806ad753775",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "séquence d'information",
                                            "En particulier Manière d'organiser les caractères Unicode"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56604b75-c673-4f90-a2f1-891d975039b8",
                                                "sense_id": "20abdc6e-1260-3252-9b91-c806ad753775",
                                                "text": "Dans la version 4.0.0, le standard Unicode et la norme ISO/CEI 10646 réserve 1 026 codes pour coder l’écriture arabe de base ainsi que les différentes écritures dérivées de l’arabe de base. Les caractères sont regroupés en blocs de caractères au niveau de la rangée 6, FB, FC, FD et une partie de la rangée FE du Plan Multilingue de Base (BMP)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2fc56b0-ec26-323c-a269-119bd123c446",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "séquence d'information",
                                            "Groupe de données enregistré ou transmis globalement pour des motifs techniques indépendamment de leur contenu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "942b0ac1-5fc1-4119-818c-72219170c05a",
                                                "sense_id": "a2fc56b0-ec26-323c-a269-119bd123c446",
                                                "text": "les longueurs possibles pour la clé secrète devaient être de 128, 192 et 256 bits – contre 112 bits pour le triple-DES –, et la longueur du bloc de chiffrement égale à 128 bits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a512ae7-0048-35be-aab4-22c6b31f4fc9",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "séquence d'information",
                                            "Groupe de données enregistré ou transmis globalement pour des motifs techniques indépendamment de leur contenu.",
                                            "(En particulier) Unité de stockage sur disque dur constitué d'une séquence d'octets en nombre fixe."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff37efd4-2dd7-4df2-a91b-95d4fb674387",
                                                "sense_id": "6a512ae7-0048-35be-aab4-22c6b31f4fc9",
                                                "text": "LVM donnait d’excellents résultats dans les benchmarks synthétiques, mais les performances se révélaient nettement moins attrayantes avec des tests applicatifs correspondant à la réalité du terrain : en pratique, nos clients qui font un usage intensif de Redis, MongoDB ou Hadoop ne se limitent pas à aligner des blocs de 4K."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c41a4761-4fb0-3064-a4c9-207d5fbe22ba",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "séquence d'information",
                                            "Groupe de données enregistré ou transmis globalement pour des motifs techniques indépendamment de leur contenu.",
                                            "Élément principal d’une blockchain, regroupe toutes les transactions enregistrées pendant un certain intervalle de temps."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dd7e62e-ea7e-4ba3-b0f7-7bfe60c0ac46",
                                                "sense_id": "c41a4761-4fb0-3064-a4c9-207d5fbe22ba",
                                                "text": "Un bloc Bitcoin est censé mettre 10 minutes à être validé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f45e6ba1-4cfd-3d10-9c6e-9ee0f65310fc",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Balises HTML de mise en page verticale d'une séquence (de la largeur de la page) contraire aux balises en-ligne horizontale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d25667a-a7ba-4113-8e4b-4bb8284abb6e",
                                                "sense_id": "f45e6ba1-4cfd-3d10-9c6e-9ee0f65310fc",
                                                "text": "Une balise de type block sur votre page web crée automatiquement un retour à la ligne avant et après. Il suffit d’imaginer tout simplement un bloc. Votre page web sera en fait constituée d’une série de blocs les uns à la suite des autres. Il est possible de mettre un bloc à l’intérieur d’un autre."
                                            },
                                            {
                                                "example_id": "097a7a5d-5f79-40a4-a3ea-fb9e3adca601",
                                                "sense_id": "f45e6ba1-4cfd-3d10-9c6e-9ee0f65310fc",
                                                "text": "De nouvelles balises ont été introduites afin de grouper le contenu à étiqueter : la balise de contenu en bloc (\n) et la balise de contenu en ligne (). Ces balises sont personnalisables par les étiquettes qui représentent la sémantique du contenu enveloppé. À l'aide de la balise de contenu en bloc\n, on crée des petites boîtes qui répondent au modèle de la boîte. Elles peuvent être décorées et la bordure de ces boîtes est souvent mise en évidence par une coloration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84069632-11da-30d3-ac56-f55e0bf5ad1a",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Union de plusieurs États, de plusieurs partis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3b5b965-f2c3-4ffb-90e9-692d6ca65e34",
                                                "sense_id": "84069632-11da-30d3-ac56-f55e0bf5ad1a",
                                                "text": "Le bloc communiste."
                                            },
                                            {
                                                "example_id": "5ac20273-f533-4612-a583-c688fe752cb9",
                                                "sense_id": "84069632-11da-30d3-ac56-f55e0bf5ad1a",
                                                "text": "Le bloc des gauches."
                                            },
                                            {
                                                "example_id": "6f451892-b7d6-478d-9330-2ed099e69e4e",
                                                "sense_id": "84069632-11da-30d3-ac56-f55e0bf5ad1a",
                                                "text": "Faire bloc, s'unir."
                                            },
                                            {
                                                "example_id": "49cfe7da-d22c-4e07-b452-280f23119b87",
                                                "sense_id": "84069632-11da-30d3-ac56-f55e0bf5ad1a",
                                                "text": "Le règlement définitif de la crise ukrainienne exige l'abandon de la mentalité de la guerre froide, de la logique consistant à assurer sa propre sécurité au détriment de celle des autres, et de l'approche consistant à rechercher la sécurité régionale en élargissant les blocs militaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b6f92ab-f765-3e8f-8de8-63d66f1d5d53",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Union de plusieurs États, de plusieurs partis.",
                                            "Spécialement et anglicisme: l'Union européenne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9c3177c-7b90-4200-ae82-eb5c7f07b132",
                                                "sense_id": "4b6f92ab-f765-3e8f-8de8-63d66f1d5d53",
                                                "text": "Le bloc a introduit sa première directive sur la qualité de l'air pour résoudre ce problème en 1980. (...) Les directives fixent certains objectifs finaux ou cibles juridiquement contraignants, mais les États membres disposent d'une certaine flexibilité quant à la manière dont ils les atteignent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee80eb5b-4b89-376f-bc04-2d4949ff7813",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Prison, pièce dans un commissariat de police où l'on enferme temporairement les délinquants."
                                        ],
                                        "tags": [
                                            "Prison"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a3fd412-51be-4fca-935d-967bde5cf178",
                                                "sense_id": "ee80eb5b-4b89-376f-bc04-2d4949ff7813",
                                                "text": "— Il n’y a pas de mais enfin, Monsieur… Et vous m’embêtez, c’est clair ça !… Et vous savez, rentrez vite à Senonches ou je vous fais fourrer au bloc…"
                                            },
                                            {
                                                "example_id": "0fe87654-b06d-4264-b7e8-7f225a90809d",
                                                "sense_id": "ee80eb5b-4b89-376f-bc04-2d4949ff7813",
                                                "text": "L’agent. — Allez ! Allez ! Au bloc ! Et pas de rouspétance !"
                                            },
                                            {
                                                "example_id": "c5326ce5-9ce8-47cd-b39b-6ca9e3ff7aac",
                                                "sense_id": "ee80eb5b-4b89-376f-bc04-2d4949ff7813",
                                                "text": "Car, messieurs, nous pourrions être tous au bloc, à l’heure qu’il est. Pêcheurs solitaires, nous harponnerions des haricots dans une gamelle."
                                            },
                                            {
                                                "example_id": "ebc4dc0d-d4b8-4a35-b728-a275790ad4a0",
                                                "sense_id": "ee80eb5b-4b89-376f-bc04-2d4949ff7813",
                                                "text": "Mais la mise au bloc de Mohammed suffirait-elle à dissuader les autres de prolonger leur sit-in ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7949dc7a-d997-3768-91b5-b89ad10d72fa",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Blockhaus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f11c79af-8653-315d-a0cf-d1e7886f4f7f",
                                        "entry_id": "997377d0-bda7-39ea-b6ef-a37d0b8dd941",
                                        "glosses": [
                                            "Partie d'une macromolécule comprenant de nombreuses unités constitutives et qui possède au moins une particularité de constitution ou de configuration qui n'apparaît pas dans les parties adjacentes."
