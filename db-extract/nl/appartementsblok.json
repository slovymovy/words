                        "examples": [
                            {
                                "example_id": "6e39eb71-d79f-4fd2-965f-3073bf1191cf",
                                "sense_id": "cc9e41d6-a255-3001-b55d-8430c203cab9",
                                "text": "In totaal wonen tien eigenaren van de vijftien in het appartementsblok in de verkeerde woning. ,,Ik woon in nummer acht en dacht dus dat ik nummer acht gekocht had, maar nu blijkt uit de documenten dat ik het nummer negen gekocht had."
                            },
                            {
                                "example_id": "00a000f7-fc83-4314-8756-8aeb6921a38f",
                                "sense_id": "cc9e41d6-a255-3001-b55d-8430c203cab9",
                                "text": "Terwijl een brand in haar appartementsblok woedde, had Michelle Dobyne even tijd voor een kort interview."
                            },
                            {
                                "example_id": "b1d74b6c-43e7-4d5a-a09b-c6f1478a6197",
                                "sense_id": "cc9e41d6-a255-3001-b55d-8430c203cab9",
                                "text": "Voor iedereen die het appartementsblok passeerden, waren de jongen en hun moeder een ware trekpleister. Er waren zelfs mensen dagelijks op post om het uilengezin te komen bewonderen."
                            }
                        ]
