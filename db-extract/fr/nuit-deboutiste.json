                        "glosses": [
                            "Relatif au mouvement social « Nuit debout », dont la première manifestation s’est tenue le 31 mars 2016 à Paris, sur la place de la République."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf683efe-42eb-4ac1-a114-b642b095089f",
                                "sense_id": "6c12672a-2c95-3259-a603-c6fdcc22c3b7",
                                "text": "Dans le jargon nuit-deboutiste, on compte à partir du 31 mars, jour de naissance du mouvement. Avec eux, nous avons partagé la nuit de jeudi à vendredi. Un 38 mars fait d’espoir, de ras-le-bol ou de la simple joie de faire corps."
                            }
                        ]
                    }
