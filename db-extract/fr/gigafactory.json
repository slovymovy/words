                        "cross_references": [
                            {
                                "target_word": "gigafactory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da148bdd-948d-3a29-a98f-4ecc0accb3e6",
                                        "entry_id": "ca4c6f8c-cb35-34b8-a5a9-50c784ed74ee",
                                        "glosses": [
                                            "A very large manufacturing facility."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b237bcc-1102-469b-b52a-ec16bc9c44c9",
                                                "sense_id": "da148bdd-948d-3a29-a98f-4ecc0accb3e6",
                                                "text": "The new AI “gigafactories” would be much larger, targeting what the commission called “moonshots”: significant innovations in healthcare, biotech, industry, robotics and scientific discovery. […] While the best-performing AI factories have supercomputers equipped with up to 25,000 advanced AI processors, a gigafactory would exceed 100,000 AI processors, the strategy document said. […] EU officials envisage three to five AI gigafactories in the EU at a cost of around €3-5bn each, compared with €600m for the biggest AI factory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "681f35b7-3b8f-3bae-8de2-1cfda25aa565",
                                        "entry_id": "ca4c6f8c-cb35-34b8-a5a9-50c784ed74ee",
                                        "glosses": [
                                            "A very large manufacturing facility.",
                                            "A factory producing electric batteries at a large scale."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26d7f707-b63f-4e61-a965-44b8e4488340",
                                                "sense_id": "681f35b7-3b8f-3bae-8de2-1cfda25aa565",
                                                "text": "“The main constraint on our production is really the cells,” Musk explained. “We are not quite ready to make a big announcement on the cell and battery giga factory, but we are exploring a lot of these options right now.”"
                                            },
                                            {
                                                "example_id": "36c2bb39-b290-4fa9-91dd-e51cf8ff94d3",
                                                "sense_id": "681f35b7-3b8f-3bae-8de2-1cfda25aa565",
                                                "text": "Tesla Motors has chosen Nevada for its proposed $5-billion gigafactory battery plant, which it says will drive down the cost of its cars."
                                            },
                                            {
                                                "example_id": "0df9c69b-5ba7-47a9-ab7f-946b1dc12fbf",
                                                "sense_id": "681f35b7-3b8f-3bae-8de2-1cfda25aa565",
                                                "text": "Tesla is building a massive gigafactory in northern Nevada."
                                            },
                                            {
                                                "example_id": "de2b7bc3-4672-46f4-95f2-8cefd8b996f7",
                                                "sense_id": "681f35b7-3b8f-3bae-8de2-1cfda25aa565",
                                                "text": "Koch thinks the gigafactory should be hiring more people from the community, whether there are incentives or not. But would the Nevadans compromise a bit on wages in order to at least have a job?"
                                            },
                                            {
                                                "example_id": "fa610805-0e99-46db-8a17-15ed95c5ce1c",
                                                "sense_id": "681f35b7-3b8f-3bae-8de2-1cfda25aa565",
                                                "text": "The factory marks the arrival of battery-making gigafactories in Europe that will challenge Tesla, which is building at a plant in Nevada, and opens the way for a quicker shift toward green power for both cars and utilities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
