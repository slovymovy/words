                ],
                "senses": [
                    {
                        "sense_id": "2a04a9c2-48f9-3f35-8f1e-7078805fa5f0",
                        "entry_id": "7f6ef106-ce88-3873-a295-f1f9f9a3461f",
                        "glosses": [
                            "dat je het niet kunt betalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f8a8831-339e-47ad-b905-38bc9eb97cc7",
                                "sense_id": "2a04a9c2-48f9-3f35-8f1e-7078805fa5f0",
                                "text": "Zijn bijdrage is van onschatbare waarde vandaar dat we hem ook eeuwig dankbaar zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69eaa8b1-fc5e-4192-b0cc-b77c0fa0ffd4",
                        "source_entry_id": "7f6ef106-ce88-3873-a295-f1f9f9a3461f",
                        "source_sense_id": "2a04a9c2-48f9-3f35-8f1e-7078805fa5f0",
                        "source_sense_description": "Onbetaalbaar",
                        "target_lang_word": "invaluable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "invaluable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c28e519a-3d5f-3ff3-a04a-62881e350c06",
                                        "entry_id": "70c6acce-ec04-3404-a0f4-a660f3190885",
                                        "glosses": [
                                            "Having great or incalculable value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6e73d14-ad1f-400a-a600-c6008e071cee",
                                                "sense_id": "c28e519a-3d5f-3ff3-a04a-62881e350c06",
                                                "text": "You are a very strange creature by way of a friend!—always wanting me to play and sing before anybody and everybody! If my vanity had taken a musical turn, you would have been invaluable; but as it is, I would really rather not sit down before those who must be in the habit of hearing the very best performers."
                                            },
                                            {
                                                "example_id": "95591788-c67b-40a2-84e8-e731f1a07548",
                                                "sense_id": "c28e519a-3d5f-3ff3-a04a-62881e350c06",
                                                "text": "Colonel Cathcart bewailed the miserable fate that had given him for an invaluable assistant someone as common as Colonel Korn. It was degrading to have to depend so thoroughly on a person who had been educated at a state university."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec5e1640-87a3-3480-ae9b-d3825962c635",
                                        "entry_id": "70c6acce-ec04-3404-a0f4-a660f3190885",
                                        "glosses": [
                                            "Not valuable; valueless; worthless."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f0f7836-fdbc-4da4-ada6-374eac015e69",
                                                "sense_id": "ec5e1640-87a3-3480-ae9b-d3825962c635",
                                                "text": "The money I have received is so invaluable a sum that I have forborne as yet to pay it in, and am heartily sorry that I cannot better advance His Majesty's service."
                                            },
                                            {
                                                "example_id": "c900daa0-08ed-437b-9826-5e1ca7b50b82",
                                                "sense_id": "ec5e1640-87a3-3480-ae9b-d3825962c635",
                                                "text": "It would be an interesting, and far from an invaluable labour, to trace the history of the murrains, or cattle diseases of former days, and there causes and effects."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4527be0-02fe-4698-92a1-ab7fdf6a0a75",
                        "source_entry_id": "7f6ef106-ce88-3873-a295-f1f9f9a3461f",
                        "source_sense_id": "2a04a9c2-48f9-3f35-8f1e-7078805fa5f0",
                        "source_sense_description": "Onbetaalbaar",
                        "target_lang_word": "inestimable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inestimable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40171517-f490-36c5-a807-c9f0a799dddc",
                                        "entry_id": "ac71586e-51f3-346f-a810-ab33a4d525d7",
                                        "glosses": [
                                            "Qu’on ne peut estimer à un assez haut prix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a774f408-f6cf-410b-8433-8ace9c84af7a",
                                                "sense_id": "40171517-f490-36c5-a807-c9f0a799dddc",
                                                "text": "– J’avais confiance en lui. Il m’a rendu des services inestimables."
                                            },
                                            {
                                                "example_id": "a7ed41a6-1950-4903-aeac-1074d17a5e07",
                                                "sense_id": "40171517-f490-36c5-a807-c9f0a799dddc",
                                                "text": "Nous disions crayon de papier, pour le distinguer du crayon d’ardoise ; mais en réalité le terme s’opposait dans nos esprits aux crayons de couleur, qui avaient l’avantage inestimable de s’écrire toujours au pluriel."
                                            },
                                            {
                                                "example_id": "68b98cce-f0c9-40f0-917e-4e9586d8b808",
                                                "sense_id": "40171517-f490-36c5-a807-c9f0a799dddc",
                                                "text": "Une fois dehors, tandis que l’enfant lavait ses pinceaux, Llouba insista pour payer son tableau le double du prix. Comme je refusai, elle haussa la voix et dit avec son fort accent que le travail de l’enfant était inestimable et que je n’aille pas lui casser les jambes une fois en trop avec mes scrupules."
                                            },
                                            {
                                                "example_id": "28f662a9-76b9-4c3c-abd5-0569913acd85",
                                                "sense_id": "40171517-f490-36c5-a807-c9f0a799dddc",
                                                "text": "Cette œuvre d’art est d’une valeur inestimable, d’un prix inestimable."
                                            },
                                            {
                                                "example_id": "06203776-4501-4e1a-b71d-a954324873dc",
                                                "sense_id": "40171517-f490-36c5-a807-c9f0a799dddc",
                                                "text": "Un tableau, un manuscrit inestimable."
                                            },
                                            {
                                                "example_id": "4d6fab4f-8885-4b4f-84d4-817a9f9d9c4c",
                                                "sense_id": "40171517-f490-36c5-a807-c9f0a799dddc",
                                                "text": "Votre amitié m’est un trésor inestimable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
