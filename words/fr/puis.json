{
    "word_family": [
        "depuis",
        "puisque"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2021e320-e3fb-3b37-b3f9-4bb696ab2fb0",
                    "sense_definition": "Marque la succession dans le temps d'actions ou d'événements.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il termine son travail, <w>puis</w> il rentre directement chez lui."
                        },
                        {
                            "text": "Nous irons d'abord à Paris, <w>puis</w> nous visiterons la ville de Lyon."
                        }
                    ],
                    "synonyms": [
                        "ensuite",
                        "après"
                    ]
                },
                {
                    "sense_id": "6876d31a-9fb5-3914-a22f-fc726323e023",
                    "sense_definition": "Sert à ajouter un élément dans une énumération ou un argument supplémentaire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je n'ai pas le temps, et <w>puis</w> ce projet ne m'intéresse pas."
                        },
                        {
                            "text": "Il faut acheter du pain, du lait et <w>puis</w> quelques fruits frais."
                        }
                    ],
                    "synonyms": [
                        "en outre",
                        "de plus"
                    ],
                    "common_phrases": [
                        "et puis"
                    ]
                },
                {
                    "sense_id": "ab19479a-3e7d-365d-880b-1e81df2f7088",
                    "sense_definition": "S'emploie de manière interrogative pour demander la suite des faits ou leurs conséquences.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "interrogation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu as obtenu ce rendez-vous important, et <w>puis</w>, que s'est-il passé ?"
                        },
                        {
                            "text": "Et <w>puis</w>, qu'est-ce que cela peut bien changer à notre situation ?"
                        }
                    ],
                    "synonyms": [
                        "après"
                    ],
                    "common_phrases": [
                        "et puis après"
                    ]
                },
                {
                    "sense_id": "59282faa-cfaa-3b64-a433-088d265f0df9",
                    "sense_definition": "Marque la succession dans l'espace d'un objet ou d'une personne à l'autre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au premier rang se trouvaient les enfants, <w>puis</w> leurs parents attentifs."
                        },
                        {
                            "text": "On aperçoit d'abord le clocher du village, <w>puis</w> les premières maisons en contrebas."
                        }
                    ],
                    "synonyms": [
                        "ensuite"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5301260f-2def-36d6-9d1e-0bb46edeebea",
                    "sense_definition": "Première personne du singulier de l'indicatif présent du verbe <w>pouvoir</w>, employée lors de l'inversion du sujet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Puis</w>-je vous aider à porter ces lourds paquets jusqu'à l'ascenseur ?"
                        },
                        {
                            "text": "<w>Puis</w>-je me permettre de vous poser une question personnelle ?"
                        }
                    ],
                    "common_phrases": [
                        "puis-je"
                    ]
                },
                {
                    "sense_id": "b4e6bc66-4b50-3628-b4c2-1585c2fc6947",
                    "sense_definition": "Variante soutenue de la première personne du singulier de l'indicatif présent du verbe <w>pouvoir</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si je <w>puis</w> me permettre une remarque, votre idée me paraît risquée."
                        },
                        {
                            "text": "Je ne <w>puis</w> accepter cette proposition dans de telles conditions."
                        }
                    ],
                    "common_phrases": [
                        "si je puis dire"
                    ]
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "177d1db9-b7f2-39b6-8ed6-a819aff36225",
                    "sense_definition": "Relie des mots ou des propositions pour coordonner une suite logique ou chronologique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a fermé les fenêtres, vérifié les lumières, <w>puis</w> il est parti se coucher."
                        },
                        {
                            "text": "Prenez cette rue à droite, <w>puis</w> avancez jusqu'au prochain carrefour."
                        }
                    ],
                    "synonyms": [
                        "ensuite"
                    ]
                },
                {
                    "sense_id": "12f98db1-31b8-3939-8e6e-bde55f111040",
                    "sense_definition": "Indique un lien de finalité ou de causalité entre deux propositions.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Qu'est-ce que tu as fait et <w>puis</w> la machine est en panne ?"
                        },
                        {
                            "text": "Qu'a-t-il mangé à midi et <w>puis</w> il a eu mal au ventre ?"
                        }
                    ],
                    "synonyms": [
                        "pour",
                        "pour que"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Afrique francophone"
                        }
                    ]
                }
            ]
        }
    ]
}