                ],
                "senses": [
                    {
                        "sense_id": "e55a4e43-f871-3086-9f75-30c0c6de0abc",
                        "entry_id": "e5a01dc1-8a6d-3519-aebe-2b291ed45333",
                        "glosses": [
                            "(bildliche) Vorstellung von etwas Zukünftigem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72b2bdec-4480-4eeb-9861-67c2a251159c",
                                "sense_id": "e55a4e43-f871-3086-9f75-30c0c6de0abc",
                                "text": "„Es war eine Sache, mit Kit in einer Londoner Stadtwohnung zu sitzen und sich Zukunftsfantasien hinzugeben, aber eine ganz andere, diese Fantasiewelt zu betreten und wahr werden zu lassen.“"
                            },
                            {
                                "example_id": "979b9b28-aa45-44ce-b9b7-7d69ec172bbe",
                                "sense_id": "e55a4e43-f871-3086-9f75-30c0c6de0abc",
                                "text": "„Bei diesen Aktien treiben oft Zukunftsfantasien den Preis.“"
                            },
                            {
                                "example_id": "4b65091e-e824-4dd0-86a1-bedf8a330870",
                                "sense_id": "e55a4e43-f871-3086-9f75-30c0c6de0abc",
                                "text": "„In der Regel ist es dann bereits zu spät, um noch einzusteigen, denn die Zukunftsfantasie ist längst in den aktuellen Börsenkursen enthalten.“"
                            },
                            {
                                "example_id": "965a8cb5-e90b-45b7-b177-f1375935277f",
                                "sense_id": "e55a4e43-f871-3086-9f75-30c0c6de0abc",
                                "text": "„Anstatt mich also länger mit irgendwelchen Zukunftsfantasien abzulenken, widmete ich mich lieber wieder der Arbeit.“"
                            },
                            {
                                "example_id": "cb00c586-210c-4b92-8d88-0a8fc464cb57",
                                "sense_id": "e55a4e43-f871-3086-9f75-30c0c6de0abc",
                                "text": "„Als ich jetzt mit Frida durch diese Straßen lief, wurde mir klar, wie altmodisch diese Zukunftsfantasie schon in den sechziger Jahren gewesen war.“"
                            },
                            {
                                "example_id": "e7fdbe8e-43d5-4400-825d-a0fe995105c8",
                                "sense_id": "e55a4e43-f871-3086-9f75-30c0c6de0abc",
                                "text": "„Die Verbindung von Kind und Kosmos sprach Hoffnungen auf Neubeginn und utopische Zukunftsfantasien an.“"
                            },
                            {
                                "example_id": "baca23ca-6dfe-4820-922e-344f1c4742af",
                                "sense_id": "e55a4e43-f871-3086-9f75-30c0c6de0abc",
                                "text": "„Diesen positiven Zukunftsfantasien, welche nicht gleichzusetzen sind mit der Positiven Psychologie, werden nun Hindernisse gegenübergestellt.“"
                            },
                            {
                                "example_id": "7b7c79a7-d339-45b4-a0d9-5b0dd0cea81d",
                                "sense_id": "e55a4e43-f871-3086-9f75-30c0c6de0abc",
                                "text": "„Sie arbeiteten, lachten, träumten und schwelgten in Zukunftsfantasien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
