                                    {
                                        "sense_id": "0bc9b92f-2358-30c8-9b04-31b4ffa749a2",
                                        "entry_id": "dbb4eb0c-7608-37b8-8a08-b1f290861e63",
                                        "glosses": [
                                            "Dont la fin, les bornes sont indéterminées ou ne peuvent pas être déterminées, vague, imprécis, indéterminé, incertain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2ad20da-6bb5-4d76-86e6-940bd86a4f66",
                                                "sense_id": "0bc9b92f-2358-30c8-9b04-31b4ffa749a2",
                                                "text": "L’économie productive faisait de grands progrès et ces progrès étaient tels que vers 1780 tout le monde croyait au dogme du progrès indéfini de l’homme."
                                            },
                                            {
                                                "example_id": "228bcc83-4706-4732-9a28-1f7ef8c826a7",
                                                "sense_id": "0bc9b92f-2358-30c8-9b04-31b4ffa749a2",
                                                "text": "Temps indéfini."
                                            },
                                            {
                                                "example_id": "f494e13d-394d-45af-a091-ee3021b49aba",
                                                "sense_id": "0bc9b92f-2358-30c8-9b04-31b4ffa749a2",
                                                "text": "Nombre indéfini."
                                            },
                                            {
                                                "example_id": "766e4af4-5e93-43b3-9a42-b0a4bff829b8",
                                                "sense_id": "0bc9b92f-2358-30c8-9b04-31b4ffa749a2",
                                                "text": "Ligne indéfinie."
                                            },
                                            {
                                                "example_id": "dc11333e-ba72-4883-85f0-24b3bd906786",
                                                "sense_id": "0bc9b92f-2358-30c8-9b04-31b4ffa749a2",
                                                "text": "Espace indéfini."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2d0644e-c725-39a5-ad7d-01789261b57a",
                                        "entry_id": "dbb4eb0c-7608-37b8-8a08-b1f290861e63",
                                        "glosses": [
                                            "Qui s’applique à un être ou à une chose qu’on ne veut pas ou qu’on ne peut pas déterminer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faaebb2c-4220-4dc7-bdae-3b0c76df7acc",
                                                "sense_id": "e2d0644e-c725-39a5-ad7d-01789261b57a",
                                                "text": "On, quelque, quiconque, sont des mots, des pronoms indéfinis."
                                            },
                                            {
                                                "example_id": "cec39adf-5a99-45e4-bffe-af533f0476a6",
                                                "sense_id": "e2d0644e-c725-39a5-ad7d-01789261b57a",
                                                "text": "Un, des, sont les formes de l’article indéfini."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eda824cc-9a26-3469-9303-d41e9672fb11",
                                        "entry_id": "dbb4eb0c-7608-37b8-8a08-b1f290861e63",
                                        "glosses": [
                                            "Qui n’est pas défini dans sa nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9da09c2d-73cb-4f6a-8543-3accca58857e",
                                                "sense_id": "eda824cc-9a26-3469-9303-d41e9672fb11",
                                                "text": "Un refus indéfini."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "indéfini",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "637c90c6-7d9f-34be-bf75-1c17e13da1cb",
                                        "entry_id": "f8105c3a-7b84-3329-9ffc-738ad99406d7",
                                        "glosses": [
                                            "Ce qui est indéterminé dans ses limites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bffe49e7-1e33-4b52-a988-18ef1d108da0",
                                                "sense_id": "637c90c6-7d9f-34be-bf75-1c17e13da1cb",
                                                "text": "L’indéfini n’est point l’infini."
                                            },
                                            {
                                                "example_id": "cc7f006c-1818-41b5-a780-9c6ce8547c7c",
                                                "sense_id": "637c90c6-7d9f-34be-bf75-1c17e13da1cb",
                                                "text": "Le fini, en tant qu’on peut toujours le diviser ou multiplier, c’est l’indéfini."
                                            }
                                        ]
                                    }
                                ]
