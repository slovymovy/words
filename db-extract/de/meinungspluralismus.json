                ],
                "senses": [
                    {
                        "sense_id": "5b887139-5ef8-3df3-ada0-0705dcb916b2",
                        "entry_id": "b9315de4-8426-392a-998a-46135f9b9573",
                        "glosses": [
                            "Fülle an verschiedenen Meinungen in einer Gesellschaft zu einem (meist politischen) Thema"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6481eaa7-185a-42fb-a379-48ec47a105f0",
                                "sense_id": "5b887139-5ef8-3df3-ada0-0705dcb916b2",
                                "text": "„Kritik am Transgender-Paradigma ist durch den Meinungspluralismus geschützt, urteilt ein britisches Arbeitsgericht. An der Humboldt-Universität muss sich diese Sicht erst noch durchsetzen.“"
                            },
                            {
                                "example_id": "aa4670e2-1961-425d-938a-713a0c127e3c",
                                "sense_id": "5b887139-5ef8-3df3-ada0-0705dcb916b2",
                                "text": "„Aber die Maßnahmen aus Kiew dürften ‚nicht als Vorwand dienen, um gegen die Opposition vorzugehen oder unabhängige Berichterstattung und Meinungspluralismus einzuschränken.‘“"
                            },
                            {
                                "example_id": "9c8a96f7-758e-412b-b967-0a41f35bf54d",
                                "sense_id": "5b887139-5ef8-3df3-ada0-0705dcb916b2",
                                "text": "„Es ist ein Verdienst abendländischer Gedankenleistung, dass Meinungspluralismus kein unbekömmlicher Störfaktor im Prozess gesellschaftlicher Konsensbildung ist, sondern ein nachgerade konstitutives Element der demokratischen Genetik.“"
                            },
                            {
                                "example_id": "6e0cc92c-cd80-4a30-b3aa-f5417deafae9",
                                "sense_id": "5b887139-5ef8-3df3-ada0-0705dcb916b2",
                                "text": "„Im Gespräch mit der ZEIT fordert Söder darüber hinaus mehr Meinungspluralismus bei den öffentlich-rechtlichen Sendern: ‚Als jemand, der sich liberal-konservativ fühlt, sehe ich nicht, dass sich das bürgerliche Spektrum ausreichend angesprochen fühlt.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
