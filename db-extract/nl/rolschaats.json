                                            {
                                                "example_id": "d864bb1f-b298-43cc-bc2c-293afd664338",
                                                "sense_id": "9d2f1df1-2680-3ac5-bb2b-f6f39a4bc88a",
                                                "text": "Er konnte bereits mit sieben Jahren Rollschuh fahren."
                                            },
                                            {
                                                "example_id": "5a2ab106-0e59-467e-b5db-53d34a640294",
                                                "sense_id": "9d2f1df1-2680-3ac5-bb2b-f6f39a4bc88a",
                                                "text": "Er steht ganz wackelig auf den Beinen, wenn er Rollschuhe an seinen Füßen trägt."
                                            },
                                            {
                                                "example_id": "e5d37b43-44ef-4b45-9487-4d4d40cd9468",
                                                "sense_id": "9d2f1df1-2680-3ac5-bb2b-f6f39a4bc88a",
                                                "text": "„Als Volker die Rollschuhe hergegeben und Papa sie kleiner gestellt hatte, rollte ich los, fiel um und schrammte mir die Knie auf.“"
                                            }
                                        ],
