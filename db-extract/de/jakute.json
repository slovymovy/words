                        "glosses": [
                            "Angehöriger eines Turkvolkes, das in Jakutien beheimatet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c2fac17-ede8-4575-b798-715d66ddd9d8",
                                "sense_id": "3f2ed99c-fb36-3577-96ac-6b1fc4ad29b2",
                                "text": "„Auf der Straße seien die Jakuten mit dicken Pelzen unterwegs, und dreifach verglaste Fenster sollten die Wärme besser in den Wohnungen halten, sagte Mestnikow nach Angaben der Agentur Itar-Tass.“"
                            }
                        ],
