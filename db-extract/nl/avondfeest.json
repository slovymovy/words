                        "examples": [
                            {
                                "example_id": "d3e782a6-f2b0-4cf4-a787-157c9ab14fb9",
                                "sense_id": "3fda5c63-d503-35e8-903e-c93c59d26341",
                                "text": "En wat gaat het bruidspaar verder doen deze dagen? „Morgen hebben wij een onderonsje met buitenlandse vrienden.” Zaterdag na de kerkdienst „een receptie en diner voor familie en vrienden en een avondfeest.” „Daarna gaan we -heel anoniem- op reis.” Om daarna in Amsterdam te gaan wonen."
                            },
                            {
                                "example_id": "86f0ae1e-b563-45dd-a24b-7bde1985ea41",
                                "sense_id": "3fda5c63-d503-35e8-903e-c93c59d26341",
                                "text": "De Utrechtse studentenvereniging UIT verwelkomt maandag 3800 nieuwe studenten, 200 meer dan vorig jaar. „Dit komt omdat we zijn overgestapt naar een grotere locatie voor de opening en avondfeesten. Ook bieden we dit jaar een breder programma en een groter aanbod aan”, zegt een woordvoerder."
                            }
                        ]
