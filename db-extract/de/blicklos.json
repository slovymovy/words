                ],
                "senses": [
                    {
                        "sense_id": "86a39814-90bb-399d-809b-2a90a56ae2bf",
                        "entry_id": "03429f65-a240-3551-a131-157294c56319",
                        "glosses": [
                            "mit offenen Augen, aber nichts wahrnehmend"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "9e8e4f16-a966-4354-84cd-fe1befd35ab6",
                                "sense_id": "86a39814-90bb-399d-809b-2a90a56ae2bf",
                                "text": "„Ein potenzieller Kunde geht blicklos vorbei.“"
                            },
                            {
                                "example_id": "6645a0c1-b0bb-4785-8ff2-f3c4676d6006",
                                "sense_id": "86a39814-90bb-399d-809b-2a90a56ae2bf",
                                "text": "„Gleich aber wird sie das blicklose Starren des Toten vergessen dürfen; denn dort sitzt das Kind – klein, rundlich und wohlerhalten, unter gestürzten Steinen, wie in einer Nische.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
