                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8c58332-bed7-43db-b03d-7553a217d558",
                        "source_entry_id": "c35650a8-f3ab-3b97-aac2-7be44804968b",
                        "source_sense_description": "fear, dislike, or hate of homosexuals",
                        "target_lang_word": "homophobie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
