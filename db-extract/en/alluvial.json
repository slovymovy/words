                    {
                        "translation_id": "c06fda57-72a1-40c8-bd96-2ca402dd18ae",
                        "source_entry_id": "6cbd0a1d-22f6-34d6-b33f-0706ae40ebab",
                        "source_sense_id": "5aebf6a4-fd7a-3fae-a520-dc53767c421c",
