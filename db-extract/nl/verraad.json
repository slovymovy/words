                                "sense_id": "d590050c-8a2b-31cb-a816-e900fdb97ab9",
                                "text": "Hij werd beschuldigd van verraad tegen het koninkrijk.",
                                "translation": "He was accused of treason against the kingdom.",
                                "english": "He was accused of treason against the kingdom."
                            },
                            {
                                "example_id": "630fa931-83f1-42da-8237-7f614174c3a9",
                                "sense_id": "d590050c-8a2b-31cb-a816-e900fdb97ab9",
                                "text": "Haar verraad deed hem diep pijn.",
                                "translation": "Her betrayal hurt him deeply.",
                                "english": "Her betrayal hurt him deeply."
                            },
                            {
                                "example_id": "532d2ed8-3dae-4612-8758-9278d5015d02",
                                "sense_id": "d590050c-8a2b-31cb-a816-e900fdb97ab9",
                                "text": "Ze kon niet geloven dat haar beste vriend zulk een verraad kon plegen.",
                                "translation": "She couldn't believe that her best friend could commit such betrayal.",
                                "english": "She couldn't believe that her best friend could commit such betrayal."
                            }
                        ]
                    }
