                "senses": [
                    {
                        "sense_id": "d5e2eb14-f2b6-3a46-932d-48a347c9b7a5",
                        "entry_id": "0b7e0f6f-f27c-3dd0-99fc-bcf264f14614",
                        "glosses": [
                            "Imperméable."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "2f9272c6-16c9-4afa-b569-3da6480e1900",
                                "sense_id": "d5e2eb14-f2b6-3a46-932d-48a347c9b7a5",
                                "text": "Il bondit sur ses pieds, attrapa son imper au vol dans le hall, et se précipita dehors en claquant la porte du pied."
                            },
                            {
                                "example_id": "1ab54469-b31d-4c9c-bf69-31026d67ddaf",
                                "sense_id": "d5e2eb14-f2b6-3a46-932d-48a347c9b7a5",
                                "text": "— Salut, ma poulette ! me lança-t-il en allant suspendre son imper.\n— Salut, papa."
                            },
                            {
                                "example_id": "57f03670-e949-4ec6-bc4e-709f0a772149",
                                "sense_id": "d5e2eb14-f2b6-3a46-932d-48a347c9b7a5",
                                "text": "Manu entre à son tour. Imper rosé, cheveux orange parce que la coloration n'a pas fonctionné comme prévu, rouge à lèvres rose nacré, fond de teint orangé en couche épaisse et Ricils bleu. Le style poufiasse lui va bien. Le vendeur lui décroche un sale coup d'oeil et ne répond pas à son bonjour. Il veut bien de la femme dans son magasin, mais pas de la morue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c040619-d552-4ee7-90d9-dda1cb64d772",
                        "source_entry_id": "0b7e0f6f-f27c-3dd0-99fc-bcf264f14614",
                        "source_sense_id": "d5e2eb14-f2b6-3a46-932d-48a347c9b7a5",
                        "target_lang_word": "raincoat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raincoat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec31933-7291-38e2-8782-e5c586b26ef7",
                                        "entry_id": "4d57246d-6685-344a-a271-467a26596d97",
                                        "glosses": [
                                            "A waterproof coat to be worn in the rain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53e66ecc-7f6a-4bc0-afe7-2567ae46f573",
                                                "sense_id": "6ec31933-7291-38e2-8782-e5c586b26ef7",
                                                "text": "After standing around in talk for a while, during which time Doris arrived with my hat and raincoat (left with her at the site) we made our way some two hundred strong, up the gracious stone stairway to the Hall of Christ Church, loaned by that College for the celebrationary lunch."
                                            },
                                            {
                                                "example_id": "8cf3af1b-f6ce-49ad-b2cb-7437ff3d73b7",
                                                "sense_id": "6ec31933-7291-38e2-8782-e5c586b26ef7",
                                                "text": "Speaking to a crowd of demonstrators, some of whom dressed in raincoats while others wore keffiyehs in solidarity with Palestinians amid Israel’s deadly war on Gaza, one demonstrator said: “Any president that has come to power has also let workers down.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "206eadb4-6c06-3ccb-b924-017680199880",
                                        "entry_id": "4d57246d-6685-344a-a271-467a26596d97",
                                        "glosses": [
                                            "A condom."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f16b69f-2249-4155-881c-54ca31ab9699",
                                                "sense_id": "206eadb4-6c06-3ccb-b924-017680199880",
                                                "text": "Moe said he'll go first, I said I'll take next / Here, take this raincoat and practice safe sex!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
