                "senses": [
                    {
                        "sense_id": "c950bf63-5d90-34a7-b487-57d1d9c13795",
                        "entry_id": "18571397-e92d-3e69-8969-0dcd49850980",
                        "glosses": [
                            "Qui peut être rectifié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66148e58-5d36-414c-af30-77c936c30931",
                                "sense_id": "c950bf63-5d90-34a7-b487-57d1d9c13795",
                                "text": "Selon l’auteur cité, l’erreur ne serait ainsi rectifiable que si le juge s’est trompé par inadvertance, négligence ou défaillance intellectuelle passagère."
                            },
                            {
                                "example_id": "e96ad7c6-c8a2-41e9-af5d-4699b9406ce3",
                                "sense_id": "c950bf63-5d90-34a7-b487-57d1d9c13795",
                                "text": "Bitcoin : une faille détectée sur le Lightning Network serait difficilement rectifiable"
                            }
                        ]
                    },
                    {
                        "sense_id": "77d10831-e3b5-30c9-9e9c-75be99f935f5",
                        "entry_id": "18571397-e92d-3e69-8969-0dcd49850980",
                        "glosses": [
                            "Qualifie un alcool améliorable par une seconde distillation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bc3a912-345f-4afa-b98a-4dc9e4cc1f09",
                                "sense_id": "77d10831-e3b5-30c9-9e9c-75be99f935f5",
                                "text": "Son alcool, en effet, n’est pas aisément rectifiable mais, imparfait pour la consommation, il serait excellent pour l’éclairage."
                            }
                        ]
                    },
                    {
                        "sense_id": "b71d66fe-fe61-3a8a-8bda-b94ee49fdd06",
                        "entry_id": "18571397-e92d-3e69-8969-0dcd49850980",
                        "glosses": [
                            "Qualifie une courbe dont on peut calculer la longueur d’un arc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b2cb62e-61fe-419e-9f1f-5078f9127e0b",
                                "sense_id": "b71d66fe-fe61-3a8a-8bda-b94ee49fdd06",
                                "text": "Ainsi, par exemple, si toutes les courbes conjuguées sont rectifiables, la courbe s sera rectifiable."
                            },
                            {
                                "example_id": "c0305985-1127-4702-844a-88d9569a59b9",
                                "sense_id": "b71d66fe-fe61-3a8a-8bda-b94ee49fdd06",
                                "text": "Dans l’exemple choisi, les compacts concernés sont ceux dont la frontière est une courbe rectifiable, c'est-à-dire essentiellement non fractale."
                            }
                        ]
                    }
                ],
