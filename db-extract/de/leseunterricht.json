                "senses": [
                    {
                        "sense_id": "4f86c35f-f093-3634-bdf2-274270df46a9",
                        "entry_id": "99310cd1-ec3a-39fc-a71b-e7a580ac0860",
                        "glosses": [
                            "Unterweisung mit dem Ziel, dass Leseschüler das Lesen erlernen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0290d876-3685-44cf-8d9b-af6d7c5c7bbe",
                                "sense_id": "4f86c35f-f093-3634-bdf2-274270df46a9",
                                "text": "„Das Schriftprinzip des Protestantismus machte den Leseunterricht zum notwendigen Bestandteil der katechetischen Unterweisung.“"
                            },
                            {
                                "example_id": "5f47b41d-dc53-46ba-a17b-fa1fbf95e216",
                                "sense_id": "4f86c35f-f093-3634-bdf2-274270df46a9",
                                "text": "„Beide, der offene Leseunterricht in einem anregenden Ambiente und das systematische Lesetraining, brauchen Zeit und Raum und insbesondere die umsichtige Begleitung durch die Lehrerinnen und Lehrer: Eine herausfordernde, aber – wie wir von den Kolleginnen und Kollegen in der Praxis erfahren – auch eine oft äusserst befriedigende Arbeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
