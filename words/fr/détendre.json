{
    "word_family": [
        "détente",
        "détendeur",
        "tendre",
        "tension",
        "distendre"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "690cc363-337e-3b44-9384-baca11f101cd",
                    "sense_definition": "Apaiser une tension nerveuse ou psychologique, calmer et faire décompresser.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "relaxation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette musique calme permet de <w>détendre</w> l'atmosphère après une longue journée de travail."
                        },
                        {
                            "text": "Un bon bain chaud <w>détend</w> les muscles fatigués par l'exercice physique."
                        }
                    ],
                    "synonyms": [
                        "apaiser",
                        "calmer",
                        "décontracter",
                        "délasser",
                        "relaxer",
                        "tranquilliser"
                    ],
                    "common_phrases": [
                        "détendre l'atmosphère",
                        "détendre les muscles"
                    ]
                },
                {
                    "sense_id": "13dd99d8-64bc-39c3-af7b-5237f3ea3b34",
                    "sense_definition": "Relâcher la tension physique ou mécanique de ce qui était raide ou étiré.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>détendre</w> une corde trop serrée pour éviter qu'elle ne casse."
                        },
                        {
                            "text": "Le tireur <w>détend</w> son arc dès qu'il a fini son entraînement."
                        }
                    ],
                    "common_phrases": [
                        "détendre une corde",
                        "détendre un ressort"
                    ]
                },
                {
                    "sense_id": "14c7455d-1412-3090-9bc8-abe9dfa441a4",
                    "sense_definition": "Fluidifier une préparation culinaire en y incorporant un liquide.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chef décide de <w>détendre</w> la sauce avec un filet de bouillon chaud."
                        },
                        {
                            "text": "Elle <w>détend</w> cette pâte compacte avec un peu de lait froid."
                        }
                    ],
                    "common_phrases": [
                        "détendre la sauce",
                        "détendre une pâte"
                    ]
                },
                {
                    "sense_id": "525dfe6c-3384-35bc-bb60-50ea4cb0b9b0",
                    "sense_definition": "Décrocher ou ôter ce qui était tendu ou suspendu, comme des tentures ou du linge.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decrochage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers viennent de <w>détendre</w> les rideaux pour pouvoir peindre la pièce."
                        },
                        {
                            "text": "Il <w>détend</w> les tentures du salon avant de commencer le grand nettoyage."
                        }
                    ],
                    "common_phrases": [
                        "détendre les rideaux"
                    ]
                }
            ]
        }
    ]
}