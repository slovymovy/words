                ],
                "senses": [
                    {
                        "sense_id": "44627952-82e1-3e4e-a532-61fae8b1f04a",
                        "entry_id": "bb86e6eb-2f65-3ab8-8616-b283e8e95601",
                        "glosses": [
                            "Stéthoscope."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "407625ed-e7b1-48e8-9e67-fb375a63ac11",
                                "sense_id": "44627952-82e1-3e4e-a532-61fae8b1f04a",
                                "text": "Um ihre Herztöne hören zu können, legte der Arzt ihr das Stethoskop auf die Brust.",
                                "translation": "Afin de pouvoir entendre son rythme cardiaque, le médecin lui a appliqué le stéthoscope sur la poitrine."
                            },
                            {
                                "example_id": "14bba5c1-5aac-4eb9-b3cd-a4fcc6ff35e1",
                                "sense_id": "44627952-82e1-3e4e-a532-61fae8b1f04a",
                                "text": "Als der Sanitäter meine Lunge mit dem Stethoskop abhörte, bat er mich, mehrmals ein- und auszuatmen.",
                                "translation": "Lorsque le secouriste a examiné mes poumons avec le stéthoscope, il m'a demandé d'inspirer et d'expirer plusieurs fois."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
