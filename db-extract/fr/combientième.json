                "senses": [
                    {
                        "sense_id": "9be0657a-46ce-3855-ad72-31587aac6c4e",
                        "entry_id": "dec49f75-ebc0-340b-81c8-ddf6da720bdf",
                        "glosses": [
                            "Celui qui est à quel rang, classement ou numéro d’ordre."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "afd49dae-1959-42e7-bac5-fedfd5f981fe",
                                "sense_id": "9be0657a-46ce-3855-ad72-31587aac6c4e",
                                "text": "Voilà que subitement je ne sais plus où j’en suis avec mes arbres, au combientième en étais-je ?"
                            },
                            {
                                "example_id": "1995c615-dddb-415e-a6e9-aa8a0e2a114b",
                                "sense_id": "9be0657a-46ce-3855-ad72-31587aac6c4e",
                                "text": "Je bois encore une coupe de champagne, la combientième ? Je commence à comprendre comment on devient alcoolique, drogué, quelles voies erratiques, souterraines on emprunte lorsque l’on sombre."
                            },
                            {
                                "example_id": "870c35c7-189c-4226-a063-4dbb7a10dfbd",
                                "sense_id": "9be0657a-46ce-3855-ad72-31587aac6c4e",
                                "text": "Un nouveau sevrage commence. Je ne sais même pas le combientième. Je suis probablement la championne du monde du sevrage."
                            }
                        ]
                    }
                ],
