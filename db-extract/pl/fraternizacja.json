                    {
                        "translation_id": "cd455ed0-acd0-4536-ab0a-5a088352fd1a",
                        "source_entry_id": "b3e928d8-0640-33f2-9f32-41fa0571633f",
                        "source_sense_id": "0194c9e6-ad46-3461-9150-3f307faa6bad",
                        "target_lang_word": "Fraternisation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "da3b2532-7291-4bd4-a4cc-56b09f448d1e",
                        "source_entry_id": "b3e928d8-0640-33f2-9f32-41fa0571633f",
                        "source_sense_id": "0194c9e6-ad46-3461-9150-3f307faa6bad",
                        "target_lang_word": "Verbrüderung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verbrüderung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1517a75-3209-3717-b304-7a60c13702d7",
                                        "entry_id": "a2112b3f-d5ba-3608-a300-4db2eb1c81b8",
                                        "glosses": [
                                            "Einigung/Vereinigung von Partnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "372a0304-79bf-48db-98a0-8200ec96e0c5",
                                                "sense_id": "e1517a75-3209-3717-b304-7a60c13702d7",
                                                "text": "„So ging das stundenlang, er säuberte die Welt, brachte den Augiasstall in Ordnung, bahnte den Weg für die Verbrüderung der Menschheit und das Reich der Gedankenfreiheit.“"
                                            },
                                            {
                                                "example_id": "14f360c0-fd12-488a-bb0d-1745562d25a9",
                                                "sense_id": "e1517a75-3209-3717-b304-7a60c13702d7",
                                                "text": "„Es war der Anblick dieser Überlegenheit, der allmählich den Stolz dieser Wilden, die sich natürlich als das stärkere Volk weit über die schwachen Oconees erhaben glaubten, auf seine gehörigen Grenzen zurückwies und den Weg zur freundschaftlichen Verbrüderung bahnte.“"
                                            },
                                            {
                                                "example_id": "4b0cad29-913c-4ee6-8f1a-ae1626a7f683",
                                                "sense_id": "e1517a75-3209-3717-b304-7a60c13702d7",
                                                "text": "„Dabei kam es nicht immer nur zur Verbrüderung der Bauern mit den Kämpfern, sondern Letztere schüchterten ein, warfen sich zu Richtern in lokalen Streitigkeiten auf und verlangten, von den Dorfbewohnern versorgt zu werden, sexuelle Dienste oft eingeschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
