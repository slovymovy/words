{
    "word_family": [
        "squabbler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "63eaec59-577a-3940-b3f6-aaa362cce4b5",
                    "sense_definition": "To participate in a minor fight or argument; to quarrel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "argument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brothers were always <w>squabbling</w> with each other over small things.",
                            "target_lang_translations": {
                                "zh": "兄弟俩总是为了琐事而<w>争吵</w>。"
                            }
                        },
                        {
                            "text": "They spent the entire afternoon <w>squabbling</w> about where to go for dinner.",
                            "target_lang_translations": {
                                "zh": "他们整个下午都在为去哪儿吃晚饭而<w>拌嘴</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bicker",
                        "quarrel",
                        "argue"
                    ],
                    "common_phrases": [
                        "squabble over"
                    ],
                    "target_lang_definitions": {
                        "zh": "指为琐事进行争吵或争论。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "争吵",
                                "target_lang_sense_clarification": "指因意见不合而大声争辩。"
                            },
                            {
                                "target_lang_word": "拌嘴",
                                "target_lang_sense_clarification": "指为小事进行口角，语气较轻。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b815eb7-42e0-3a30-911e-f7fafa876298",
                    "sense_definition": "To disarrange, so that the letters or lines stand awry and require readjustment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The printer accidentally <w>squabbled</w> the type while moving the heavy metal frame.",
                            "target_lang_translations": {
                                "zh": "印刷工在移动沉重的金属架时，不小心把铅字<w>弄乱</w>了。"
                            }
                        },
                        {
                            "text": "It is easy to <w>squabble</w> the lines of text if the tray is not handled carefully.",
                            "target_lang_translations": {
                                "zh": "如果托盘搬运不当，很容易把排好的文字<w>弄乱</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to traditional manual typesetting."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指在排版过程中将铅字弄乱，使其排列错乱。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "弄乱",
                                "target_lang_sense_clarification": "指使原本整齐的排版变得杂乱。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "51c8e3ef-c707-3b31-91ec-df98369c17e6",
                    "sense_definition": "A minor fight or argument.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "argument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children got into a <w>squabble</w> about who should sit in the front seat.",
                            "target_lang_translations": {
                                "zh": "孩子们为了谁该坐在前座而发生了一场<w>争吵</w>。"
                            }
                        },
                        {
                            "text": "They often have a silly <w>squabble</w> over which movie to watch on Friday nights.",
                            "target_lang_translations": {
                                "zh": "他们经常为了周五晚上看哪部电影而发生无谓的<w>口角</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quarrel",
                        "row",
                        "tiff"
                    ],
                    "common_phrases": [
                        "petty squabble"
                    ],
                    "target_lang_definitions": {
                        "zh": "指小规模的争吵或口角。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "争吵",
                                "target_lang_sense_clarification": "指因琐事引发的口头冲突。"
                            },
                            {
                                "target_lang_word": "口角",
                                "target_lang_sense_clarification": "指因小事而发生的争执。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}