                    },
                    {
                        "translation_id": "e6206261-8ae9-4998-b923-096f6f924dd7",
                        "source_entry_id": "f75ff9ac-c08d-33ce-917c-48fc94e14219",
                        "source_sense_description": "Filet de pêche",
                        "target_lang_word": "Kescher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kescher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42648eed-c8e7-39ab-9a0f-8a13e49a8d54",
                                        "entry_id": "891ab189-255e-33ea-adcf-7f677e700651",
                                        "glosses": [
                                            "bestielter, auf einen Kunststoff- oder Metallbügel aufgezogener Netzsack, der als Landungshilfe für den an der Angel befindlichen Fische dient"
                                        ],
                                        "tags": [
                                            "Angelfischerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac1cbbdc-4e0e-4809-afad-d1df03ac945c",
                                                "sense_id": "42648eed-c8e7-39ab-9a0f-8a13e49a8d54",
                                                "text": "Der Angler lenkte den gehakten Fisch mit der Angelrute über den Kescher. Er hob dann den ausgedrillten Fisch mit dem Kescher aus dem Wasser."
                                            },
                                            {
                                                "example_id": "bf22cb94-80fd-4f5a-b4e8-68973a5c11be",
                                                "sense_id": "42648eed-c8e7-39ab-9a0f-8a13e49a8d54",
                                                "text": "„Mama sagte, ich sei ein oller Quengelpott, aber dann kaufte sie mir auch einen Kescher, damit es nicht noch weiter böses Blut gab zwischen Volker und mir.“"
                                            },
                                            {
                                                "example_id": "5ccf5655-e2ef-4103-b98d-a789ad94832a",
                                                "sense_id": "42648eed-c8e7-39ab-9a0f-8a13e49a8d54",
                                                "text": "„An einem schönen Sommernachmittag hatten wir uns wieder am Weiher verabredet, und Niki hatte sogar einen Kescher mitgebracht, denn wir hätten den kapitalen Fisch niemals ans Ufer heben können.“"
                                            },
                                            {
                                                "example_id": "b46b9cfe-fb6e-4cb5-b27a-06b50f75e528",
                                                "sense_id": "42648eed-c8e7-39ab-9a0f-8a13e49a8d54",
                                                "text": "„Man muß, das ist die Technik, mit der Landschaft verschmelzen, warten und den Vogel dann mit einem großen Kescher fangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cca49eda-63cb-311d-8bc1-0c54428a2b55",
                                        "entry_id": "891ab189-255e-33ea-adcf-7f677e700651",
                                        "glosses": [
                                            "Geflecht, in dem Fische gehältert werden"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
