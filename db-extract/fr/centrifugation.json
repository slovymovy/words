                    {
                        "sense_id": "fa4cd09f-c660-3352-ba9c-c658108371a1",
                        "entry_id": "c965b2e3-08cb-30f3-9cd9-2cfe7f6bd989",
                        "glosses": [
                            "Action de centrifuger, technique utilisant la force centrifuge pour séparer des fluides de densités différentes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18d9a62d-fa88-4e61-a844-2f42f2a540c4",
                                "sense_id": "fa4cd09f-c660-3352-ba9c-c658108371a1",
                                "text": "Konopacka a appliqué systématiquement aux divers stades du développement de l’œuf de Grenouille une centrifugation faible (10 g) et une centrifugation violente (228 g)."
                            },
                            {
                                "example_id": "1ae74bf7-03ce-4e78-b36e-131f1e0464b4",
                                "sense_id": "fa4cd09f-c660-3352-ba9c-c658108371a1",
                                "text": "Quelques millimètres pesant quelques microgrammes de l’essence même de la vie. Obtenus après avoir lysé les globules blancs et séparé par centrifugation le précieux ADN du reste du matériel cellulaire."
                            },
                            {
                                "example_id": "ce60723d-3eb1-4261-84ee-aa10f2ee1ec9",
                                "sense_id": "fa4cd09f-c660-3352-ba9c-c658108371a1",
                                "text": "Ni les perméabilisants qui ne sont pas sélectifs, ni la filtration ou la centrifugation ne parviennent à les distinguer."
                            }
                        ]
                    }
                ],
