                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b5dd85a-7cb8-4d7d-bd38-1ed51352b529",
                                "sense_id": "96b53f4d-c9b1-3589-bb4f-d34c99dd16f9",
                                "text": "Ich sah im Traum ein wütendes Bullenauge."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "68a6965a-4df2-3ae9-a221-45216bfe12e6",
                        "entry_id": "5933f9be-90c6-3db7-9038-6e19e02a0cd1",
                        "glosses": [
                            "ein brauner Mokkalikör mit einem Schuss weißer Sahne"
                        ],
                        "tags": [
                            "meist unzählbar"
                        ],
                        "examples": [
                            {
                                "example_id": "2bd0f3e6-3e46-4e9b-8e1a-2c27c549602d",
                                "sense_id": "68a6965a-4df2-3ae9-a221-45216bfe12e6",
                                "text": "Bullenauge wird nur in Westfalen zur Kirmeszeit produziert und verkauft."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "523ffc19-a278-48f7-a828-d1f29b4c3838",
                        "source_entry_id": "5933f9be-90c6-3db7-9038-6e19e02a0cd1",
                        "source_sense_id": "96b53f4d-c9b1-3589-bb4f-d34c99dd16f9",
