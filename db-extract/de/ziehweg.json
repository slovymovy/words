                        "examples": [
                            {
                                "example_id": "25d4e034-9210-4173-84f5-37239bc31c40",
                                "sense_id": "998eefc0-5e8c-3c54-b70d-2b74cd08062d",
                                "text": "„Kurz vor der Einmündung in die Straße […] nehmen wir den Ziehweg empor zur Nordschulter des Burren und wandern auf der Wiesenspur vollends hinauf zum Gipfel […].“"
                            },
                            {
                                "example_id": "7d12940d-ba4c-4db8-ab97-5c64352f804b",
                                "sense_id": "998eefc0-5e8c-3c54-b70d-2b74cd08062d",
                                "text": "„Der Ziehweg stelle einen flachen Pistenteil dar, der auch von Anfängern benützt werde und dessen Ausgestaltung auf keinerlei Gefahrenquelle schließen lasse.“"
                            }
                        ],
