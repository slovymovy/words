{
    "word_family": [
        "deter",
        "deterrent"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ff831ca2-0546-34ca-b3a1-ac43428c4ef1",
                    "sense_definition": "The action of discouraging an action or event by instilling doubt or fear of the penalty or punishment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prevention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harsh prison sentences serve as a form of <w>deterrence</w> against future crimes.",
                            "target_lang_translations": {
                                "ru": "Суровые тюремные сроки служат формой <w>сдерживания</w> будущих преступлений."
                            }
                        },
                        {
                            "text": "The security cameras were installed primarily for <w>deterrence</w> to stop shoplifting.",
                            "target_lang_translations": {
                                "ru": "Камеры видеонаблюдения были установлены в первую очередь для <w>устрашения</w>, чтобы остановить кражи в магазинах."
                            }
                        }
                    ],
                    "synonyms": [
                        "dissuasion"
                    ],
                    "antonyms": [
                        "encouragement",
                        "incentive"
                    ],
                    "common_phrases": [
                        "effective deterrence",
                        "criminal deterrence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по предотвращению какого-либо поступка или события путем внушения сомнений или страха перед наказанием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдерживание",
                                "target_lang_sense_clarification": "предотвращение нежелательных действий"
                            },
                            {
                                "target_lang_word": "устрашение",
                                "target_lang_sense_clarification": "через внушение страха"
                            },
                            {
                                "target_lang_word": "предотвращение",
                                "target_lang_sense_clarification": "недопущение совершения чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22e3bd4c-c7a0-31ba-a910-af24b9baf6b5",
                    "sense_definition": "A military strategy where one power uses the threat of retaliation to preclude an attack from an adversary.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "military strategy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the Cold War, the policy of nuclear <w>deterrence</w> was central to global stability.",
                            "target_lang_translations": {
                                "ru": "В годы холодной войны политика ядерного <w>сдерживания</w> занимала центральное место в обеспечении глобальной стабильности."
                            }
                        },
                        {
                            "text": "The country maintains a strong navy as a means of <w>deterrence</w> against foreign invasion.",
                            "target_lang_translations": {
                                "ru": "Страна содержит мощный военно-морской флот как средство <w>сдерживания</w> иностранного вторжения."
                            }
                        }
                    ],
                    "synonyms": [
                        "intimidation"
                    ],
                    "common_phrases": [
                        "nuclear deterrence",
                        "military deterrence",
                        "policy of deterrence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Военная стратегия, при которой государство использует угрозу ответного удара для предотвращения нападения противника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдерживание",
                                "target_lang_sense_clarification": "стратегическое или военное"
                            },
                            {
                                "target_lang_word": "устрашение",
                                "target_lang_sense_clarification": "политика запугивания противника"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}