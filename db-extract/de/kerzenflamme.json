                                "example_id": "b993c707-28bd-4f7b-934f-6d3e210e2712",
                                "sense_id": "86b42189-3b9d-3fae-915d-18e52ba55385",
                                "text": "„Die Kerzenflamme wehte im Anhauch hereinschauernder Nebelkühle.“"
                            }
                        ],
