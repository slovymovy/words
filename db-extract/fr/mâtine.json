                ],
                "senses": [
                    {
                        "sense_id": "b89e2001-e751-391a-abae-4d5d62706b45",
                        "entry_id": "0bd8d8da-854f-3d2c-8c4d-e9ec54da866a",
                        "glosses": [
                            "Grosse chienne de garde."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3b0f94ef-fec4-3052-bdb9-4c990491cae6",
                        "entry_id": "0bd8d8da-854f-3d2c-8c4d-e9ec54da866a",
                        "glosses": [
                            "Femme qui a fait preuve de malice ou de hardiesse, coquine."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ad008baf-1eb4-44c2-8c79-99977df350eb",
                                "sense_id": "3b0f94ef-fec4-3052-bdb9-4c990491cae6",
                                "text": "— La mâtine, pensa Boiseriot, elle a de l’aplomb ! Je n’arriverai pas à connaître ses idées."
                            },
                            {
                                "example_id": "0e95482f-b1a7-4aa9-96d7-75062f915950",
                                "sense_id": "3b0f94ef-fec4-3052-bdb9-4c990491cae6",
                                "text": "Au théâtre, une mâtine d’actrice chantait comme un canari !"
                            },
                            {
                                "example_id": "e28f261d-3aee-4e6a-9977-c9d24439f6c9",
                                "sense_id": "3b0f94ef-fec4-3052-bdb9-4c990491cae6",
                                "text": "Ah ! la sacrée mâtine, lorsqu’elle s’est trompée, on la couperait en quatre, plutôt qu’elle avouât."
                            },
                            {
                                "example_id": "1082d0a4-e857-4dc7-a93d-c09345361224",
                                "sense_id": "3b0f94ef-fec4-3052-bdb9-4c990491cae6",
                                "text": "– Eh ! dit-il sur un petit ton égrillard, que dites-vous des grandes dames irlandaises ? Ah ! la mâtine !"
                            },
                            {
                                "example_id": "e5eae1f2-aa71-4fcb-901f-ca0661a05512",
                                "sense_id": "3b0f94ef-fec4-3052-bdb9-4c990491cae6",
                                "text": "Tu t’es encore mis cette nuit un papier à papillotes sur le front, hein, mâtine ? Enfin…\nElle lâchait ma rêne de cheveux, s’éloignait de moi pour me mieux voir."
                            },
                            {
                                "example_id": "3061b15b-f321-4d91-9114-04d805023722",
                                "sense_id": "3b0f94ef-fec4-3052-bdb9-4c990491cae6",
                                "text": "Elle est en train de se faire une beauté, la mâtine…"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
