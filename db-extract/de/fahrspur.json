                "senses": [
                    {
                        "sense_id": "7020e5ce-c166-3a54-ae38-2ccca3e64981",
                        "entry_id": "41d5d1e3-12b5-386a-b1e9-bf3e4cefecae",
                        "glosses": [
                            "markierter Streifen auf einer Straße, der für die Fahrt in eine festgelegte Richtung vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "634712c1-f5ec-4664-93ee-1afce43d8a14",
                                "sense_id": "7020e5ce-c166-3a54-ae38-2ccca3e64981",
                                "text": "In Deutschland ist wegen des Rechtsfahrgebots vorrangig immer die rechte Fahrspur zu benutzen."
                            },
                            {
                                "example_id": "e59a3173-6f29-4251-845b-b3b7ae2681be",
                                "sense_id": "7020e5ce-c166-3a54-ae38-2ccca3e64981",
                                "text": "„Es erstreckte sich von der Mitte der rechten Fahrspur, auf der sich der Truck befand, schräg nach vorne über die komplette Gegenfahrbahn und ragte dann links noch etwa fünf Meter frei über die Brücke hinaus.“"
                            },
                            {
                                "example_id": "baf8f54b-4d3d-4670-9ad2-1de8cef6c184",
                                "sense_id": "7020e5ce-c166-3a54-ae38-2ccca3e64981",
                                "text": "„Bei Fahrstreifen, die hauptsächlich Bussen vorbehalten sind, ist das Wort „Bus“ oder der Buchstabe „A“ auf der reservierten Fahrspur anzubringen, wann immer es notwendig ist, und insbesondere am Anfang des Fahrstreifens und nach Kreuzungen.“"
                            },
                            {
                                "example_id": "36c26dba-504a-45f7-b51a-913c6d8e99c4",
                                "sense_id": "7020e5ce-c166-3a54-ae38-2ccca3e64981",
                                "text": "„Ich fahre an Einars und Lóas Hof vorbei und muss kurz dahinter abbremsen, um auf einen Schotterweg abzubiegen und dann einer nicht sehr ausgeprägten Fahrspur zu dem kleinen Wohnwagen zu folgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
