                                                "example_id": "7c2039d6-b76e-4da5-a8a9-a3d997286b02",
                                                "sense_id": "3e7805a4-e7f8-3dc7-b77b-9a0b2f5586d2",
                                                "text": "He's got a beef with everyone in the room."
                                            },
                                            {
                                                "example_id": "6835215b-454c-4003-bc51-a1a3ff2150cf",
                                                "sense_id": "3e7805a4-e7f8-3dc7-b77b-9a0b2f5586d2",
                                                "text": "Remember what happened last fall? That's his beef with me."
                                            },
                                            {
                                                "example_id": "1ae30b16-7204-4107-9ad4-2c3ff38ed84d",
                                                "sense_id": "3e7805a4-e7f8-3dc7-b77b-9a0b2f5586d2",
                                                "text": "All I got is beef with those that violate me / I shall annihilate thee"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "305f3128-2c38-3756-a5e4-833184d7f901",
                                        "entry_id": "402a129e-d01a-37a2-a27e-209621e32625",
                                        "glosses": [
                                            "Fibrous calcite or limestone, especially when occurring in a jagged layer between shales in Dorset."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
