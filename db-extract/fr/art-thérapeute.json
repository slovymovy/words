                        "glosses": [
                            "Praticien de l’art-thérapie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ab7aea3-0e8a-4c44-b5f8-04f23540faac",
                                "sense_id": "4902ec16-5be1-3911-b997-522edfe72854",
                                "text": "La fenêtre d’un pavillon est ouverte au rez-de-chaussée : un homme initie ses patients à l’art de la mosaïque. Il est art-thérapeute."
                            },
                            {
                                "example_id": "bde7b295-5078-4fdd-90f4-3a47121f12e7",
                                "sense_id": "4902ec16-5be1-3911-b997-522edfe72854",
                                "text": "Habituellement, l’identité professionnelle des soignants se confond avec leur expertise et donc leurs études d’origine : médecins généralistes ou internistes, hépato-gastro-entérologues, psychiatres, psychologues, psychanalystes, assistantes sociales, éducateurs, art-thérapeutes, infirmiers, renforcée par la culture française qui veut que notre performance soit, en priorité, définie par la réputation de l’école qui nous a délivré le diplôme."
                            }
                        ]
                    }
