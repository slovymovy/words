                        "form": "den Zugvogel"
                    },
                    {
                        "form_id": "832d150d-a040-4efb-a6eb-c3dca29f9889",
                        "entry_id": "2f09ea1c-f00b-3bd6-b216-77d08aaf2e97",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zugvögel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "16e4faf1-f7c3-3976-947c-ed6ca4a93df4",
                        "entry_id": "2f09ea1c-f00b-3bd6-b216-77d08aaf2e97",
                        "glosses": [
                            "Vogel, der die kalte Jahreszeit in warmen, meist südlichen Regionen verbringt, in die er im Herbst zieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccb951bd-4895-4fe5-ba73-dd0dbd1c3b4b",
                                "sense_id": "16e4faf1-f7c3-3976-947c-ed6ca4a93df4",
                                "text": "Im Herbst kann man oft Zugvögel auf ihrem Weg in den Süden beobachten."
                            },
                            {
                                "example_id": "dd6fc166-eabb-4d66-a821-558b8b83dac8",
                                "sense_id": "16e4faf1-f7c3-3976-947c-ed6ca4a93df4",
                                "text": "„2002 wurde der Förderverein Waldrappteam mit dem Ziel gegründet, die Art wieder als Brutvogel im nördlichen Alpenvorland anzusiedeln und auch wieder als Zugvogel zu etablieren.“"
                            },
                            {
                                "example_id": "f1f35850-4a1f-4561-84cd-0b0e6699ee81",
                                "sense_id": "16e4faf1-f7c3-3976-947c-ed6ca4a93df4",
                                "text": "„Erst durch das Hinterfragen und Reflektieren, durch Werterkenntnis und Sinnzuweisung unterscheiden sich die Extremleistungen des Menschen wesentlich von denen der Lachse, Ameisen, Bergziegen oder Zugvögel.“"
                            },
                            {
                                "example_id": "d2266622-c9f0-454b-9563-19cc105530ec",
                                "sense_id": "16e4faf1-f7c3-3976-947c-ed6ca4a93df4",
                                "text": "„Bunte Fäden zogen übers Land wie Zugvögel, die vor dem Winter fliehen.“"
                            },
                            {
                                "example_id": "17975205-6e46-4b43-856d-c31fda74c392",
                                "sense_id": "16e4faf1-f7c3-3976-947c-ed6ca4a93df4",
                                "text": "„Inzwischen bleiben sogar einige Zugvögel im Winter hier, weil es in den Städten wärmer ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2b61bb4-ba75-4b5f-817d-1735b73875da",
                        "source_entry_id": "2f09ea1c-f00b-3bd6-b216-77d08aaf2e97",
                        "source_sense_id": "16e4faf1-f7c3-3976-947c-ed6ca4a93df4",
                        "source_sense_description": "Vogel, der in der kalten Jahreszeit in warme, meist südliche Regionen zieht",
                        "target_lang_word": "migrant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "migrant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7a720da-72d6-3564-9f8c-13a2d4f29f43",
                                        "entry_id": "30b23b6e-8f5d-30de-90c2-eaff777e32ed",
                                        "glosses": [
                                            "A migratory animal, in particular a migratory bird."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e44bff7d-fd74-4162-8c6e-967a1a2a7ec7",
                                                "sense_id": "e7a720da-72d6-3564-9f8c-13a2d4f29f43",
                                                "text": "Gilbert White writes, \"I have consulted a sportsman who tells me that […] often there are amongst them little parties of small blue doves which he calls rockiers. The food of these numberless migrants was beechmast and some acorns.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b68cf5c-191c-3db0-a9b4-4158d20e7889",
                                        "entry_id": "30b23b6e-8f5d-30de-90c2-eaff777e32ed",
                                        "glosses": [
                                            "Traveller or worker who moves from one region or country to another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06550740-ebea-3acf-b432-a28424c57ced",
                                        "entry_id": "30b23b6e-8f5d-30de-90c2-eaff777e32ed",
                                        "glosses": [
                                            "A person who leaves one place in order to permanently settle in another."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b905f24-a022-493c-85f2-f58c71a8481b",
                                                "sense_id": "06550740-ebea-3acf-b432-a28424c57ced",
                                                "text": "These first English migrants to Jamestown endured terrible disease and arrived during a period of drought and colder-than-normal winters. The migrants to Roanoke on the outer banks of Carolina, where the English had gone in the 1580s, disappeared. And a brief effort to settle the coast of Maine in 1607 and 1608 failed because of an unusually bitter winter."
                                            },
                                            {
                                                "example_id": "897de4b3-1c6b-4503-89e5-8b1e1c873aa5",
                                                "sense_id": "06550740-ebea-3acf-b432-a28424c57ced",
                                                "text": "“But once you lose everything— your home, your school, your clinic, your road, your church—then it’s an impossible situation. You become an environmental migrant because you have to find those facilities in some other place.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8810dbfe-8bd0-3edb-ae90-8423631360a9",
                                        "entry_id": "30b23b6e-8f5d-30de-90c2-eaff777e32ed",
                                        "glosses": [
                                            "Any of various pierid butterflies of the genus Catopsilia. Also called an emigrant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "migrant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af18e50f-a7b8-3ede-bf4d-480032abce33",
                                        "entry_id": "267bc2ed-eb91-398a-8481-82a98dcc265c",
                                        "glosses": [
