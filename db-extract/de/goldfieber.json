                "senses": [
                    {
                        "sense_id": "e01fe355-1268-36cd-9118-454ff0156e58",
                        "entry_id": "e2355027-6d78-3447-a6e2-ae4a66793064",
                        "glosses": [
                            "Besessenheit von dem Gedanken, nach Gold zu suchen; die Gier danach, Gold zu finden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b36bbeb3-b5b2-4e35-b3e4-84dba1d415e4",
                                "sense_id": "e01fe355-1268-36cd-9118-454ff0156e58",
                                "text": "„Selbst ruhige, besonnene Leute wurden angesteckt von dem Goldfieber. Wer wollte auch nicht mühelos reich werden?“"
                            },
                            {
                                "example_id": "70de5baf-66b6-47b7-9845-8a1408ed6534",
                                "sense_id": "e01fe355-1268-36cd-9118-454ff0156e58",
                                "text": "„Doch auch die anderen in Coro hatten sich jetzt mit dem Goldfieber angesteckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78f9642f-e084-4004-9993-69da043c0219",
                        "source_entry_id": "e2355027-6d78-3447-a6e2-ae4a66793064",
                        "source_sense_id": "e01fe355-1268-36cd-9118-454ff0156e58",
                        "source_sense_description": "Besessenheit von dem Gedanken, nach Gold zu suchen; die Gier danach, Gold zu finden",
                        "target_lang_word": "gold fever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gold fever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14b4a7f9-de90-35fd-8237-c0c354564842",
                                        "entry_id": "50e6d32e-bfca-3692-997e-57315f131c42",
                                        "glosses": [
                                            "A feverish obsession with seeking gold ore; an era (figuratively an epidemic) during which this obsession grips a large number of people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc70d66a-29b1-417f-ba1f-9b637b362d59",
                                                "sense_id": "14b4a7f9-de90-35fd-8237-c0c354564842",
                                                "text": "That was during the gold fever, when strangers descended on the town and all the shovels were plum sold out at the general store."
                                            },
                                            {
                                                "example_id": "7f86bd1a-2786-40fd-8eee-e3d8cbaf7e0f",
                                                "sense_id": "14b4a7f9-de90-35fd-8237-c0c354564842",
                                                "text": "He caught a real bad case of the gold fever that was going around at the time."
                                            },
                                            {
                                                "example_id": "88cebe5d-194a-4bb7-82d8-e37c2a567d82",
                                                "sense_id": "14b4a7f9-de90-35fd-8237-c0c354564842",
                                                "text": "It appears that a compositor had been engaged for the Northern Territory Times, and for a considerable time the editor seems to have led a comparatively unruffled existence; till in an evil hour the compositor was smitten with gold fever, and struck work."
                                            },
                                            {
                                                "example_id": "fab298c3-2152-4446-b313-a248102c2d90",
                                                "sense_id": "14b4a7f9-de90-35fd-8237-c0c354564842",
                                                "text": "Johns worked with the gold-fever in his veins and urged the camels on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02e13d53-86e1-345a-b457-8881bfb45e5a",
                                        "entry_id": "50e6d32e-bfca-3692-997e-57315f131c42",
                                        "glosses": [
                                            "An excessive craving for profit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b22da7b-44a9-42c0-b40e-79f9d9fc3c50",
                        "source_entry_id": "e2355027-6d78-3447-a6e2-ae4a66793064",
                        "source_sense_id": "e01fe355-1268-36cd-9118-454ff0156e58",
                        "source_sense_description": "Besessenheit von dem Gedanken, nach Gold zu suchen; die Gier danach, Gold zu finden",
                        "target_lang_word": "gold rush",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gold rush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94f32f9b-770a-3124-9645-13502ed6c22f",
                                        "entry_id": "ba471d08-c804-3e95-85b7-95d884302fb9",
                                        "glosses": [
                                            "Any period of feverish migration into an area in which gold has been discovered."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2ea5d35-6339-4e46-abb6-e196fb527f76",
                                                "sense_id": "94f32f9b-770a-3124-9645-13502ed6c22f",
                                                "text": "Here Grey Beaver stopped. A whisper of the gold-rush had reached his ears, and he had come with several bales of furs, and another of gut-sewn mittens and moccasins. He would not have ventured so long a trip had he not expected generous profits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19227aee-735f-3cce-8974-bf44e2fe08c9",
                                        "entry_id": "ba471d08-c804-3e95-85b7-95d884302fb9",
                                        "glosses": [
                                            "A feverish obsession with seeking profits, especially in new markets."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65178bd8-6796-4297-981d-72ab7c19a18a",
                                                "sense_id": "19227aee-735f-3cce-8974-bf44e2fe08c9",
                                                "text": "That’s because I’ve decided to enter the freewheeling world of nonfungible tokens, or NFTs, the newest frontier in the cryptocurrency gold rush."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e2be861-48d7-3c6d-8500-b3a3223e4677",
                                        "entry_id": "ba471d08-c804-3e95-85b7-95d884302fb9",
                                        "glosses": [
                                            "A cocktail made from bourbon, honey, and lemon juice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15ec654c-281b-4150-98fe-3b311bf2c0c1",
                                                "sense_id": "2e2be861-48d7-3c6d-8500-b3a3223e4677",
                                                "text": "The Gold Rush is one of my favorite cocktails, invented at Sasha Petraske's famed Milk & Honey bar and now served all over the world. Basically a cold toddy, it's a shaken drink with bourbon, fresh lemon, and honey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89e5f7bc-b858-37bb-8834-8bd967c45f6a",
                                        "entry_id": "ba471d08-c804-3e95-85b7-95d884302fb9",
                                        "glosses": [
                                            "The urge to win gold medals, as in the Olympic Games."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
