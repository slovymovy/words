                "senses": [
                    {
                        "sense_id": "bd82921d-8754-3f09-bde5-a3ed00569c9f",
                        "entry_id": "c135e9b3-e9c3-327f-815b-927130767fc6",
                        "glosses": [
                            "Donner une nature feldspathique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07c49e5a-45d9-4e89-a8ab-a76fd0fd8162",
                                "sense_id": "bd82921d-8754-3f09-bde5-a3ed00569c9f",
                                "text": "M. J. Delanoile n’admet pas que la soude et la potasse aient pu pénétrer dans les grès quartzeux pour les feldspathiser et les convertir en gneiss."
                            },
                            {
                                "example_id": "1d09a6ad-6acf-4ab7-ba6b-e806e3661afd",
                                "sense_id": "bd82921d-8754-3f09-bde5-a3ed00569c9f",
                                "text": "C’est grâce à la richesse en magnésie, jointe à la proportion d’alumine suffisante pour feldspathiser la plus grande partie de la chaux, que, malgré la richesse en ce dernier élément, les pyroxènes restent toujours essentiellement magnésiens."
                            }
                        ]
                    }
                ],
