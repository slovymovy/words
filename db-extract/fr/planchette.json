                                        "entry_id": "751f3c7e-5de7-3303-a882-98ff03a9597a",
                                        "glosses": [
                                            "One of the round colored dots pressed into paper money, used to distinguish authentic currency from counterfeit currency."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5faf8f01-5e36-4f92-9756-fe34d3a45b81",
                                                "sense_id": "3ac3444e-3fd8-3678-ba4d-4e9309c007c1",
                                                "text": "Some general security features to look for in both Canadian and American currency are . . .small green dots or \"planchettes\" randomly embedded throughout the paper that glow under ultraviolet light."
                                            }
