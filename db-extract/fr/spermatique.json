                            {
                                "example_id": "d63f6027-6055-457e-abc8-3fffcf943339",
                                "sense_id": "725d9ab6-168f-306e-a5fc-43b5cdc05bfe",
                                "text": "Après que la femelle a reçu le dépôt de la matière spermatique du mâle, elle se retire dans un terrier, […], et commence à pondre ses œufs."
                            },
                            {
                                "example_id": "7ac88539-5de7-42bb-becd-4a5da87e3288",
                                "sense_id": "725d9ab6-168f-306e-a5fc-43b5cdc05bfe",
                                "text": "Canal spermatique - Conduit spermatique."
                            }
