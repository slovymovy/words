                {
                    "sense_id": "1242ecc2-dcec-3a62-90ce-77dfa0af31f1",
                    "sense_definition": "Het voertuig (de trein) dat op het metronetwerk rijdt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport_vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>metro</w> kwam piepend tot stilstand op het perron.",
                            "target_lang_translations": {
                                "en": "The <w>metro</w> came to a squeaking halt at the platform.",
                                "ru": "<w>Поезд метро</w> со скрипом остановился у платформы.",
                                "de": "Die <w>U-Bahn</w> kam quietschend am Bahnsteig zum Stehen."
                            }
                        },
                        {
                            "text": "We moesten rennen omdat de <w>metro</w> er al aan kwam.",
                            "target_lang_translations": {
                                "en": "We had to run because the <w>subway</w> was already arriving.",
                                "ru": "Нам пришлось бежать, потому что <w>поезд метро</w> уже приближался.",
                                "de": "Wir mussten rennen, weil die <w>U-Bahn</w> schon einfuhr."
                            }
                        }
                    ],
