                "translations": [
                    {
                        "translation_id": "fad7f8b4-fed7-4709-954c-a424e0275928",
                        "source_entry_id": "767b90d5-08b9-3694-9908-a08b19cf6f85",
                        "source_sense_id": "3d398646-2715-3168-a9d1-05227d79097a",
                        "source_sense_description": "het glanzende mineraal dat de binnenzijde van bepaalde schelpen bedekt",
                        "target_lang_word": "Perlmutt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perlmutt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbcbc81c-3268-3f7f-bfad-04385980254e",
                                        "entry_id": "2e6ffe8a-b56f-3219-9d65-1c1e2674d2ee",
                                        "glosses": [
                                            "innerste, glänzende Schicht bestimmter Schalen bildender Mollusken, etwa Perlmuscheln und Seeschnecken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1e95857-d791-4308-b6b5-90d7737141cd",
                                                "sense_id": "dbcbc81c-3268-3f7f-bfad-04385980254e",
                                                "text": "Um das Perlmutt zu sehen, muss man die Muschel öffnen."
                                            },
                                            {
                                                "example_id": "34a8aa1a-7190-496f-940e-7f6bd00ff6a0",
                                                "sense_id": "dbcbc81c-3268-3f7f-bfad-04385980254e",
                                                "text": "Der Beitrag der Nanotechnik: Kunststoffe lassen sich durch Nanoplättchen aus Silikaten verstärken. Dieses Prinzip findet sich auch in der Natur, im Perlmutt."
                                            },
                                            {
                                                "example_id": "6798dd36-b3a7-45aa-8b1b-27659cfb0bbc",
                                                "sense_id": "dbcbc81c-3268-3f7f-bfad-04385980254e",
                                                "text": "Die großen, dunklen Perlen waren nie das Rückgrat der Perlenindustrie, das Perlmutt war weitaus wichtiger: Eine ganze Welt wollte versorgt sein mit Knöpfen und Accessoires."
                                            },
                                            {
                                                "example_id": "6651bd51-fead-4309-912b-15212e98fe7b",
                                                "sense_id": "dbcbc81c-3268-3f7f-bfad-04385980254e",
                                                "text": "Darum konnten die Textilhersteller ungestraft die Naturmaterialien wie Büffelhorn, Perlmutt oder Steinnuss durch Kunststoff ersetzen."
                                            },
                                            {
                                                "example_id": "667b2c07-a430-4bc8-bd9b-1f8878081029",
                                                "sense_id": "dbcbc81c-3268-3f7f-bfad-04385980254e",
                                                "text": "Die Flug-, Pardon Fahrgäste reisen bequem: Die Mahagonitäfelung der Passagierkabine ist mit Perlmutt eingelegt, Teppiche liegen in der Gondel unter der 127 Meter langen Zigarre aus Stoff und gasdichtem Rinderblinddarm."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36ec3e08-6238-447a-a295-a102f5005261",
