{
    "word_family": [
        "sincere",
        "sincerity",
        "insincere",
        "insincerity"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d15d750b-d3b6-38bf-90be-09657b0aa57d",
                    "sense_definition": "In a genuine, honest, and earnest way.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>sincerely</w> hope that you will feel better soon.",
                            "target_lang_translations": {
                                "ru": "Я <w>искренне</w> надеюсь, что вы скоро поправитесь.",
                                "zh": "我<w>真诚地</w>希望你能早日康复。",
                                "es": "Espero <w>sinceramente</w> que te sientas mejor pronto."
                            }
                        },
                        {
                            "text": "She <w>sincerely</w> believed that she was making the right choice.",
                            "target_lang_translations": {
                                "ru": "Она <w>искренне</w> верила, что делает правильный выбор.",
                                "zh": "她<w>真诚地</w>相信自己做出了正确的选择。",
                                "es": "Ella creía <w>sinceramente</w> que estaba tomando la decisión correcta."
                            }
                        }
                    ],
                    "synonyms": [
                        "honestly",
                        "genuinely",
                        "truthfully",
                        "earnestly"
                    ],
                    "common_phrases": [
                        "sincerely hope",
                        "sincerely appreciate",
                        "sincerely apologize",
                        "sincerely believe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искренним, честным и серьезным образом.",
                        "zh": "以真诚、诚实和认真的方式。",
                        "es": "De una manera genuina, honesta y seria."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искренне",
                                "target_lang_sense_clarification": "честно, от всего сердца"
                            },
                            {
                                "target_lang_word": "от души",
                                "target_lang_sense_clarification": "с глубоким чувством"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "真诚地",
                                "target_lang_sense_clarification": "表示态度诚恳、不虚伪"
                            },
                            {
                                "target_lang_word": "诚挚地",
                                "target_lang_sense_clarification": "用于表达深切的诚意"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "sinceramente",
                                "target_lang_sense_clarification": "de forma honesta y sin engaños"
                            },
                            {
                                "target_lang_word": "de todo corazón",
                                "target_lang_sense_clarification": "con sentimientos profundos y verdaderos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3c33a4b-87cc-3bfb-ad15-6eda138ae2c3",
                    "sense_definition": "A conventional formula used to end a formal letter or email, typically when the recipient is addressed by name.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "closing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Sincerely</w>, John Smith.",
                            "target_lang_translations": {
                                "ru": "<w>С уважением</w>, Джон Смит.",
                                "zh": "<w>此致</w>，约翰·史密斯。",
                                "es": "<w>Atentamente</w>, John Smith."
                            }
                        },
                        {
                            "text": "<w>Sincerely</w>, Jane Doe.",
                            "target_lang_translations": {
                                "ru": "<w>С уважением</w>, Джейн Доу.",
                                "zh": "<w>此致</w>，简·多伊。",
                                "es": "<w>Atentamente</w>, Jane Doe."
                            }
                        }
                    ],
                    "synonyms": [
                        "yours sincerely",
                        "sincerely yours",
                        "yours truly",
                        "best regards",
                        "regards"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандартная формула вежливости для завершения официального письма или электронного сообщения.",
                        "zh": "用于正式信函或电子邮件结尾的礼貌用语。",
                        "es": "Fórmula convencional utilizada para cerrar una carta o correo electrónico formal."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "С уважением",
                                "target_lang_sense_clarification": "стандартная подпись в деловой переписке"
                            },
                            {
                                "target_lang_word": "Искренне Ваш",
                                "target_lang_sense_clarification": "более формальный или устаревший вариант"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "此致",
                                "target_lang_sense_clarification": "正式信函结尾的常用语"
                            },
                            {
                                "target_lang_word": "谨上",
                                "target_lang_sense_clarification": "表示恭敬的结尾用语"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Atentamente",
                                "target_lang_sense_clarification": "la forma más común y estándar en español para cerrar cartas formales"
                            },
                            {
                                "target_lang_word": "Cordialmente",
                                "target_lang_sense_clarification": "una alternativa formal y amable para cerrar correspondencia"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}