                        "examples": [
                            {
                                "example_id": "536f5423-f8a3-4860-b0f5-9096736d98c3",
                                "sense_id": "dd94a533-322e-3571-8639-d089854a4b1e",
                                "text": "У нас ведь о детях ― молчат ― не то что у англичан или американ."
                            },
                            {
                                "example_id": "65903aa6-ce30-4d45-9438-29a100c1db6f",
                                "sense_id": "dd94a533-322e-3571-8639-d089854a4b1e",
                                "text": "― Разве вы не в курсе, что две особы императорской фамилии вышли замуж за американов..?"
                            }
                        ]
                    }
