                                "target_senses": [
                                    {
                                        "sense_id": "2aeba2d7-df1f-33d8-b5e8-162cf3d67014",
                                        "entry_id": "b4a07103-1a93-357f-b91d-12cfd0323f4c",
                                        "glosses": [
                                            "To fear greatly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc69e44a-2516-3cc7-b2b4-d6ecd7a7d248",
                                        "entry_id": "b4a07103-1a93-357f-b91d-12cfd0323f4c",
                                        "glosses": [
                                            "To anticipate with fear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb863cd0-374e-4aa9-92cf-cd0423d15293",
                                                "sense_id": "cc69e44a-2516-3cc7-b2b4-d6ecd7a7d248",
                                                "text": "I'm dreading getting the results of the test, as it could decide my whole life."
                                            },
                                            {
                                                "example_id": "28b5984b-7868-48fd-a094-fd235caf9398",
                                                "sense_id": "cc69e44a-2516-3cc7-b2b4-d6ecd7a7d248",
                                                "text": "Day by day, hole by hole our bearing reins were shortened, and instead of looking forward with pleasure to having my harness put on as I used to do, I began to dread it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa8bc422-4930-37a0-93e9-3e70ba6e4e86",
                                        "entry_id": "b4a07103-1a93-357f-b91d-12cfd0323f4c",
                                        "glosses": [
                                            "To be in dread, or great fear."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e96afc2b-0e2f-4d45-b74d-400819be48bc",
                                                "sense_id": "aa8bc422-4930-37a0-93e9-3e70ba6e4e86",
                                                "text": "Dread not, neither be afraid of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45feee9c-ff0a-37c7-9310-dee1aba5f3fa",
                                        "entry_id": "b4a07103-1a93-357f-b91d-12cfd0323f4c",
                                        "glosses": [
                                            "To style (the hair) into dreadlocks."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dread",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e73b8e52-6aa0-3fca-a8ab-040392767267",
                                        "entry_id": "343013bc-c35a-375e-b729-1e83efd0a06c",
                                        "glosses": [
                                            "Great fear in view of impending evil; fearful apprehension of danger; anticipatory terror."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1c32b5f-0df7-4f6d-9b62-937c9e2ff4ae",
                                                "sense_id": "e73b8e52-6aa0-3fca-a8ab-040392767267",
                                                "text": "My visit to the doctor is filling me with dread."
                                            },
                                            {
                                                "example_id": "548a1e20-079d-4abb-9bfa-17b9f5d45c8b",
                                                "sense_id": "e73b8e52-6aa0-3fca-a8ab-040392767267",
                                                "text": "the secret dread of divine displeasure"
                                            },
                                            {
                                                "example_id": "d5d3caa7-dffb-4259-87d8-c6b234ce3426",
                                                "sense_id": "e73b8e52-6aa0-3fca-a8ab-040392767267",
                                                "text": "the dread of something after death"
                                            },
                                            {
                                                "example_id": "f63bbce7-5b54-4336-a29a-3a0952e4a2ac",
                                                "sense_id": "e73b8e52-6aa0-3fca-a8ab-040392767267",
                                                "text": "They shared a common dread that he would begin moaning."
                                            },
                                            {
                                                "example_id": "69db66bc-dbb3-4368-841c-38b3a8eb1f7b",
                                                "sense_id": "e73b8e52-6aa0-3fca-a8ab-040392767267",
                                                "text": "In 1928 [Martin] Heidegger succeeded [Edmund] Husserl to take a chair at Freiburg and in his inaugural lecture made a pronouncement that earned him a reputation as an archetypal metaphysician with his claim that our awareness of people as a whole depends on our experience of dread in the face of nothingness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b15d4e4-6264-309b-be9b-ef9e016a339a",
                                        "entry_id": "343013bc-c35a-375e-b729-1e83efd0a06c",
                                        "glosses": [
                                            "Reverential or respectful fear; awe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b92753b-4b96-465e-8e64-f3fd7cbdca56",
                                                "sense_id": "7b15d4e4-6264-309b-be9b-ef9e016a339a",
                                                "text": "The fear of you, and the dread of you, shall be upon every beast of the earth."
                                            },
                                            {
                                                "example_id": "3e150b7d-1c4f-4154-b14f-3c3fa0cdc6b3",
                                                "sense_id": "7b15d4e4-6264-309b-be9b-ef9e016a339a",
                                                "text": "His sceptre shows the force of temporal power, / The attribute to awe and majesty, / Wherein doth sit the dread and fear of kings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd520968-563d-333d-915e-8ac6a851544f",
                                        "entry_id": "343013bc-c35a-375e-b729-1e83efd0a06c",
                                        "glosses": [
                                            "Somebody or something dreaded."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9203fc6-de7a-3bb0-8f39-65761daba22d",
                                        "entry_id": "343013bc-c35a-375e-b729-1e83efd0a06c",
                                        "glosses": [
                                            "A person highly revered."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99f070a1-c294-45d7-8c03-e33bb2c0dbba",
                                                "sense_id": "f9203fc6-de7a-3bb0-8f39-65761daba22d",
                                                "text": "Una, his dear dread"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9feb361d-3c94-377c-b9ff-797075201826",
                                        "entry_id": "343013bc-c35a-375e-b729-1e83efd0a06c",
                                        "glosses": [
                                            "Fury; dreadfulness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67cbe359-62a9-40b5-bad3-aac73333a0af",
                                                "sense_id": "9feb361d-3c94-377c-b9ff-797075201826",
                                                "text": "The mightie ones, affrayd of every chaunges dread"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95428f17-5059-3367-9506-0b92c9017ae5",
                                        "entry_id": "343013bc-c35a-375e-b729-1e83efd0a06c",
                                        "glosses": [
                                            "A Rastafarian."
                                        ],
                                        "tags": [
