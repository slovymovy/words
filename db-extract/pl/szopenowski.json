                        "entry_id": "ddb8b682-46cf-3535-96b4-dfbf33bd0121",
                        "glosses": [
                            "dotyczący życia i muzyki Fryderyka Chopina, charakterystyczny, typowy dla Chopina lub jego muzyki, taki jak u Chopina"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e9c8948-7f57-4e01-a060-87d87422ac3a",
                                "sense_id": "c759cbde-9564-3ac1-9e69-3b22970b16c8",
                                "text": "Już wiedzieli, że klapa, z Radia Santiago, które nie nadało zatem beethovenowskiej Symfonii heroicznej ani poloneza szopenowskiego, przygotowanych przez zamachowców na Dzień Triumfu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
