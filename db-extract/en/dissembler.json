        "de-extract.jsonl": [
            {
                "entry_id": "9318387b-86a9-30ef-b41a-9d87288f8390",
                "word": "dissembler",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3f1d09c0-bc38-39c0-8ac1-3b2ce645f367",
                        "entry_id": "9318387b-86a9-30ef-b41a-9d87288f8390",
                        "glosses": [
                            "Heuchler; jemand, der vorgibt bestimmte Ansichten oder Meinungen zu haben, die er in Wirklichkeit gar nich teilt"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a4fe64e3-c013-3c7c-bb04-b1733769bae2",
                        "entry_id": "9318387b-86a9-30ef-b41a-9d87288f8390",
                        "glosses": [
                            "Simulant"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7549fe80-ef39-4e2d-9aae-3e3deb5df396",
                        "source_entry_id": "9318387b-86a9-30ef-b41a-9d87288f8390",
                        "source_sense_id": "3f1d09c0-bc38-39c0-8ac1-3b2ce645f367",
                        "source_sense_description": "sdü",
                        "target_lang_word": "Heuchler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heuchler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de69744c-d6d1-38f1-8f36-307c211625c2",
                                        "entry_id": "62ed3894-baa9-3039-999c-46667f04241c",
                                        "glosses": [
                                            "jemand, der eine Meinung oder Einstellung nur vortäuscht, aber nicht wirklich vertritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b528b38-ec16-49a8-b216-34fcd117e7fc",
                                                "sense_id": "de69744c-d6d1-38f1-8f36-307c211625c2",
                                                "text": "Er schwor seinen Kameraden Treue, am nächsten Tag verriet er sie. Welch ein Heuchler!"
                                            },
                                            {
                                                "example_id": "3753a1fb-7692-4b82-9aa5-7ea3cf3026c2",
                                                "sense_id": "de69744c-d6d1-38f1-8f36-307c211625c2",
                                                "text": "„Darüber hinaus schufen sie zahlreiche satirische Romane und Komödien auf Jiddisch, in deren Handlung chassidische Figuren als frömmelnde Fanatiker, Heuchler und intrigante Betrüger dargestellt und entlarvt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa3b2e53-f049-417f-bb26-2f48e1aaa64a",
                        "source_entry_id": "9318387b-86a9-30ef-b41a-9d87288f8390",
                        "source_sense_id": "a4fe64e3-c013-3c7c-bb04-b1733769bae2",
                        "source_sense_description": "sdü",
                        "target_lang_word": "Simulant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Simulant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                        "entry_id": "98f4f61f-3251-36ff-9288-5d2601d29520",
                                        "glosses": [
                                            "(männliche^☆) Person, die etwas, meist eine Krankheit, vortäuscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81a5c931-64ed-422a-bd46-716e2eb8cbc6",
                                                "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                                "text": "Wissentlich falsche Auskünfte gibt der Simulant, der einen Hörschaden vortäuschen will, während bei der Aggravation ein Hörverlust vorliegt, der aber größer als vorhanden angegeben wird."
                                            },
                                            {
                                                "example_id": "cf31064e-9af0-4b90-8062-571609a6049b",
                                                "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                                "text": "Ein dritter Typus sind die operativen Hektiker: Sie sind entweder unorganisiert und verzetteln sich ständig oder sie geben sich als Simulant, der sich bewusst emsig gibt."
                                            },
                                            {
                                                "example_id": "23748db3-5a43-4522-8c60-3c004555f81a",
                                                "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                                "text": "Wer nach dem Zweiten Weltkrieg als Überlebender der Gräuel in Lagern und Haftanstalten materielle Entschädigung suchte, galt oft noch als Simulant und stand im Verdacht, sich Leistungen erschleichen zu wollen."
                                            },
                                            {
                                                "example_id": "b9fac62b-f587-4a1a-9db4-3a27bb75718c",
                                                "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                                "text": "Ihr Anwalt Walter Rubach warf dem Mediziner vor, auf einen Simulanten hereingefallen zu sein."
                                            },
                                            {
                                                "example_id": "1f789029-467b-4c3e-9d74-3f5940af3b34",
                                                "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                                "text": "An oberster Stelle der Forderungen stünden „mehr Verständnis und Akzeptanz“, man wolle nicht als Simulant oder Psycho-Patient betrachtet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
