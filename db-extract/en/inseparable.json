                                    {
                                        "sense_id": "ac46e3da-3230-3aa8-9120-befabc1748e5",
                                        "entry_id": "e8dcc280-35b8-34ec-8818-07d3d31d331d",
                                        "glosses": [
                                            "Qui ne peut pas être séparé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e20c56eb-a17e-4a10-b634-007d21a1117a",
                                                "sense_id": "ac46e3da-3230-3aa8-9120-befabc1748e5",
                                                "text": "Les noms sont inséparables des choses."
                                            },
                                            {
                                                "example_id": "2e7c6b29-acf2-4d33-ab7b-16cad9f23d9b",
                                                "sense_id": "ac46e3da-3230-3aa8-9120-befabc1748e5",
                                                "text": "Certains devoirs sont inséparables de certaines fonctions."
                                            },
                                            {
                                                "example_id": "3e58bfd0-1b4e-41e9-9295-ad1f3de1d463",
                                                "sense_id": "ac46e3da-3230-3aa8-9120-befabc1748e5",
                                                "text": "Il se forme dans l’esprit humain une association inséparable entre certaines idées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae21672b-7bff-367b-8ae8-6c72016a04ff",
                                        "entry_id": "e8dcc280-35b8-34ec-8818-07d3d31d331d",
                                        "glosses": [
                                            "Que l'on ne rencontre pas les uns sans les autres ; qui vont toujours ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d7c8e5e-260a-4890-82f4-36c4a5b585b9",
                                                "sense_id": "ae21672b-7bff-367b-8ae8-6c72016a04ff",
                                                "text": "Ces récits de braconnage sont inséparables de l'exagération si bien que beaucoup d'entre eux se sont mués en hâbleries, en contes de mensonge, invraisemblables et burlesques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "539d4d1d-4d89-30b6-a6a2-c782230cee24",
                                        "entry_id": "e8dcc280-35b8-34ec-8818-07d3d31d331d",
                                        "glosses": [
                                            "Qui ne se quittent presque jamais ou qui sont très souvent ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd0ee7f5-9538-4320-9aea-e9c169c3c403",
                                                "sense_id": "539d4d1d-4d89-30b6-a6a2-c782230cee24",
                                                "text": "Deux amis inséparables."
                                            },
                                            {
                                                "example_id": "0376fbb7-4b53-414b-880c-cdf61f2e8aad",
                                                "sense_id": "539d4d1d-4d89-30b6-a6a2-c782230cee24",
                                                "text": "Ils sont devenus inséparables."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inséparable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f7f7736-0d66-398c-bb64-f6477c85dfc5",
                                        "entry_id": "fdee2e34-c22d-3b73-b065-687fe4483d5d",
                                        "glosses": [
                                            "Une des personnes inséparables."
                                        ],
