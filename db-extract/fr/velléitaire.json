                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "891bf736-4697-486c-a019-086c21aeeb09",
                                                "sense_id": "3c5b323f-2745-31d7-bcbb-b1d37214e6fc",
                                                "text": "Het grote debat over de biografie - over de toelaatbaarheid en het nut van het gebruik van biografische gegevens bij de analyse van het werk en andersom - was nog onbeslist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71e8112f-8c19-3160-860b-f90cf7fa52c2",
                                        "entry_id": "8e6217ac-c77e-3ba1-8687-33c9e84a5982",
                                        "glosses": [
                                            "zonder winnaar of verliezer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae71010e-d9db-4cd0-8209-3947e80db186",
                                                "sense_id": "71e8112f-8c19-3160-860b-f90cf7fa52c2",
                                                "text": "Het werd een strijd met povere resultaten, met een slag op de Doggersbank in augustus 1781 met admiraal Zoutman, een slag die gevierd werd als overwinning, maar in werkelijkheid onbeslist was en veel materiële schade opleverde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d5b7119-f2fd-3ef5-83e7-d1ce92e664c3",
                                        "entry_id": "8e6217ac-c77e-3ba1-8687-33c9e84a5982",
                                        "glosses": [
                                            "zonder winnaar of verliezer",
                                            "in gelijkspel, remise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed5d899b-a79e-4c1d-8a51-d56b24bb9462",
                                                "sense_id": "4d5b7119-f2fd-3ef5-83e7-d1ce92e664c3",
                                                "text": "Het werd een strijd met povere resultaten, met een slag op de Doggersbank in augustus 1781 met admiraal Zoutman, een slag die gevierd werd als overwinning, maar in werkelijkheid onbeslist was en veel materiële schade opleverde."
                                            },
                                            {
                                                "example_id": "131800ec-184d-4cf8-9675-4ddcc7be69b2",
                                                "sense_id": "4d5b7119-f2fd-3ef5-83e7-d1ce92e664c3",
                                                "text": "De Brabantse derby tussen RKC en NAC eindigde na een leuk duel onbeslist, 2-2."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e1d7063-f48a-316d-b3e5-1aa9ac743265",
                                        "entry_id": "8e6217ac-c77e-3ba1-8687-33c9e84a5982",
