                ],
                "word_linkages": []
            },
            {
                "entry_id": "8c86740a-1588-316f-88d3-7132b6367a45",
                "word": "trimoteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "78099f98-6cd8-4dce-908e-578f831c6c80",
                        "entry_id": "8c86740a-1588-316f-88d3-7132b6367a45",
                        "tags": [
