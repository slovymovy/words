{
    "word_family": [
        "jetliner",
        "turbojet",
        "ramjet",
        "jet-black",
        "jet-setter",
        "jettison"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f63b393e-61ac-36b4-a1de-4d022c69e8d7",
                    "sense_definition": "A fast airplane powered by jet engines rather than propellers.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aviation_vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy businessman flew his private <w>jet</w> to the island for a meeting.",
                            "target_lang_translations": {
                                "ru": "Богатый бизнесмен полетел на своем частном <w>джете</w> на остров на встречу.",
                                "zh": "那位富有的商人乘他的私人<w>喷气式飞机</w>去岛上开会。"
                            }
                        },
                        {
                            "text": "We watched the military fighter <w>jet</w> fly quickly across the blue sky.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как военный <w>реактивный самолёт</w> быстро летел по голубому небу.",
                                "zh": "我们看着那架军用<w>喷气式战斗机</w>迅速飞过蓝天。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fighter jet",
                        "private jet",
                        "jumbo jet",
                        "corporate jet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый самолет, приводимый в движение реактивными двигателями, а не пропеллерами.",
                        "zh": "一种由喷气发动机而非螺旋桨驱动的快速飞机。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реактивный самолёт",
                                "target_lang_sense_clarification": "стандартный термин"
                            },
                            {
                                "target_lang_word": "джет",
                                "target_lang_sense_clarification": "часто о частных самолетах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喷气式飞机",
                                "target_lang_sense_clarification": "标准术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2015cc8a-a93a-37cf-bc65-4e939595c343",
                    "sense_definition": "A strong, narrow stream of liquid, gas, or steam that is forced out of a small opening.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fluid_stream",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A powerful <w>jet</w> of water shot out from the broken pipe in the street.",
                            "target_lang_translations": {
                                "ru": "Мощная <w>струя</w> воды вырвалась из сломанной трубы на улице.",
                                "zh": "一股强劲的<w>射流</w>从街上破裂的管道中喷涌而出。"
                            }
                        },
                        {
                            "text": "The fountain pumps a high <w>jet</w> of water into the air every hour.",
                            "target_lang_translations": {
                                "ru": "Фонтан выбрасывает высокую <w>струю</w> воды в воздух каждый час.",
                                "zh": "喷泉每小时都会向空中喷出一股高高的<w>水柱</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jet of water",
                        "gas jet",
                        "steam jet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильная, узкая струя жидкости, газа или пара, вырывающаяся из небольшого отверстия.",
                        "zh": "从狭窄开口中喷出的强劲液体、气体或蒸汽流。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "струя",
                                "target_lang_sense_clarification": "поток жидкости или газа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "射流",
                                "target_lang_sense_clarification": "流体流"
                            },
                            {
                                "target_lang_word": "喷流",
                                "target_lang_sense_clarification": "喷出的流体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a325af4d-00ab-3c61-9d6d-9cd11cddb8e8",
                    "sense_definition": "An engine that pushes a vehicle forward by forcing a stream of fluid or gas backward.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "aviation_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanics spent all night repairing the <w>jet</w> before the morning flight.",
                            "target_lang_translations": {
                                "ru": "Механики всю ночь ремонтировали <w>реактивный двигатель</w> перед утренним рейсом.",
                                "zh": "机械师们整晚都在为早班航班维修<w>喷气发动机</w>。"
                            }
                        },
                        {
                            "text": "Modern aircraft rely on powerful <w>jet</w> propulsion to reach high speeds.",
                            "target_lang_translations": {
                                "ru": "Современные самолеты полагаются на мощную <w>реактивную</w> тягу для достижения высоких скоростей.",
                                "zh": "现代飞机依靠强大的<w>喷气</w>推进力来达到高速。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jet engine",
                        "jet propulsion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигатель, толкающий транспортное средство вперед путем выброса потока жидкости или газа назад.",
                        "zh": "通过向后喷射流体或气体来推动交通工具前进的发动机。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реактивный двигатель",
                                "target_lang_sense_clarification": "тип двигателя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喷气发动机",
                                "target_lang_sense_clarification": "发动机类型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b1c3e8d-7a46-3b47-b897-13ed89f01ade",
                    "sense_definition": "A small nozzle or opening through which a stream of liquid or gas is released.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fluid_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The printer was not working because the ink <w>jet</w> was clogged with dried ink.",
                            "target_lang_translations": {
                                "ru": "Принтер не работал, потому что <w>сопло</w> было забито засохшими чернилами.",
                                "zh": "打印机无法工作，因为<w>喷嘴</w>被干涸的墨水堵住了。"
                            }
                        },
                        {
                            "text": "You need to clean the fuel <w>jet</w> to ensure the engine runs smoothly.",
                            "target_lang_translations": {
                                "ru": "Нужно прочистить топливный <w>жиклёр</w>, чтобы двигатель работал ровно.",
                                "zh": "你需要清理<w>喷油嘴</w>以确保发动机平稳运行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ink jet",
                        "fuel jet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое сопло или отверстие, через которое выпускается струя жидкости или газа.",
                        "zh": "用于释放液体或气体流的小型喷嘴或开口。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "форсунка",
                                "target_lang_sense_clarification": "техническое устройство"
                            },
                            {
                                "target_lang_word": "жиклёр",
                                "target_lang_sense_clarification": "калиброванное отверстие"
                            },
                            {
                                "target_lang_word": "сопло",
                                "target_lang_sense_clarification": "отверстие для выброса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喷嘴",
                                "target_lang_sense_clarification": "技术部件"
                            },
                            {
                                "target_lang_word": "喷油嘴",
                                "target_lang_sense_clarification": "燃油系统部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2bea630b-a96c-3ae3-830f-651ff1bd595d",
                    "sense_definition": "A hard, black stone (a form of coal) that is polished and used to make jewellery.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mineral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a beautiful necklace made of black <w>jet</w> beads to the party.",
                            "target_lang_translations": {
                                "ru": "Она надела на вечеринку красивое ожерелье из бусин черного <w>гагата</w>.",
                                "zh": "她戴着一条由黑色<w>黑玉</w>珠子制成的精美项链参加了聚会。"
                            }
                        },
                        {
                            "text": "The antique brooch was carved from <w>jet</w> and set in silver.",
                            "target_lang_translations": {
                                "ru": "Старинная брошь была вырезана из <w>гагата</w> и оправлена в серебро.",
                                "zh": "这枚古董胸针是用<w>黑玉</w>雕刻而成，并镶嵌在银饰中。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jet beads",
                        "whitby jet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердый черный камень (разновидность угля), который полируют и используют для изготовления украшений.",
                        "zh": "一种坚硬的黑色矿物（煤的一种），经抛光后用于制作首饰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гагат",
                                "target_lang_sense_clarification": "минерал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黑玉",
                                "target_lang_sense_clarification": "矿物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "049fc991-e0e4-314c-8df4-839f40ca778f",
                    "sense_definition": "To travel somewhere by airplane, especially quickly or for pleasure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They plan to <w>jet</w> off to a tropical island for their summer vacation.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>улететь</w> на тропический остров в летний отпуск.",
                                "zh": "他们计划<w>乘飞机</w>去热带岛屿度假。"
                            }
                        },
                        {
                            "text": "The famous actor is always <w>jetting</w> around the world for movie premieres.",
                            "target_lang_translations": {
                                "ru": "Известный актер постоянно <w>летает</w> по всему миру на кинопремьеры.",
                                "zh": "这位著名演员总是为了电影首映式而在世界各地<w>飞来飞去</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jet off",
                        "jet around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествовать куда-либо на самолете, особенно быстро или ради удовольствия.",
                        "zh": "乘飞机旅行，尤指快速或为了享乐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "летать",
                                "target_lang_sense_clarification": "путешествовать по воздуху"
                            },
                            {
                                "target_lang_word": "улетать",
                                "target_lang_sense_clarification": "отправляться в полет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乘飞机旅行",
                                "target_lang_sense_clarification": "空中交通"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd98fbd4-983d-365c-964c-54828214ae16",
                    "sense_definition": "To leave a place quickly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am running late for my appointment, so I have to <w>jet</w>.",
                            "target_lang_translations": {
                                "ru": "Я опаздываю на встречу, так что мне пора <w>бежать</w>.",
                                "zh": "我赴约要迟到了，所以我得<w>赶紧走</w>。"
                            }
                        },
                        {
                            "text": "Let's <w>jet</w> from this boring party and go somewhere more fun.",
                            "target_lang_translations": {
                                "ru": "Давай <w>свалим</w> с этой скучной вечеринки и пойдем куда-нибудь, где веселее.",
                                "zh": "我们从这个无聊的派对<w>溜走</w>，去个更有趣的地方吧。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gotta jet"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in informal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро покинуть место.",
                        "zh": "迅速离开某地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смываться",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "бежать",
                                "target_lang_sense_clarification": "спешно уходить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "溜走",
                                "target_lang_sense_clarification": "口语"
                            },
                            {
                                "target_lang_word": "赶紧走",
                                "target_lang_sense_clarification": "匆忙离开"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac000941-99ee-3ea5-8bab-3f44ae79a675",
                    "sense_definition": "To come out of a container or opening in a strong stream.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fluid_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water <w>jetted</w> from the hose when he turned the tap on fully.",
                            "target_lang_translations": {
                                "ru": "Вода <w>била струёй</w> из шланга, когда он полностью открыл кран.",
                                "zh": "当他完全打开水龙头时，水从软管中<w>喷射</w>出来。"
                            }
                        },
                        {
                            "text": "Steam <w>jetted</w> out of the kettle as soon as the water boiled.",
                            "target_lang_translations": {
                                "ru": "Пар <w>вырвался</w> из чайника, как только вода закипела.",
                                "zh": "水一烧开，蒸汽就从水壶里<w>喷射</w>出来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jet out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выходить из емкости или отверстия сильной струей.",
                        "zh": "从容器或开口中强力喷出。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бить струёй",
                                "target_lang_sense_clarification": "сильно вытекать"
                            },
                            {
                                "target_lang_word": "вырываться",
                                "target_lang_sense_clarification": "о паре или газе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喷射",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d93f1722-8061-384f-8b01-efeba97b3d92",
                    "sense_definition": "Propelled by or related to a jet engine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aviation_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>jet</w> plane broke the sound barrier during the test flight.",
                            "target_lang_translations": {
                                "ru": "<w>Реактивный</w> самолет преодолел звуковой барьер во время испытательного полета.",
                                "zh": "这架<w>喷气式</w>飞机在试飞期间突破了音障。"
                            }
                        },
                        {
                            "text": "They are developing new <w>jet</w> fuel that is more environmentally friendly.",
                            "target_lang_translations": {
                                "ru": "Они разрабатывают новое <w>реактивное</w> топливо, которое более экологично.",
                                "zh": "他们正在开发一种更环保的新型<w>喷气式</w>燃料。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jet plane",
                        "jet fuel",
                        "jet age"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводимый в движение или относящийся к реактивному двигателю.",
                        "zh": "由喷气发动机驱动或与喷气发动机相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реактивный",
                                "target_lang_sense_clarification": "относящийся к тяге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喷气式",
                                "target_lang_sense_clarification": "形容词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae59050d-1049-3e41-80fa-55a9511ff03d",
                    "sense_definition": "Of a very dark, deep black colour.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat had <w>jet</w> fur that looked shiny and smooth in the sunlight.",
                            "target_lang_translations": {
                                "ru": "У кошки была <w>угольно-чёрная</w> шерсть, которая выглядела блестящей и гладкой на солнце.",
                                "zh": "这只猫有着<w>乌黑</w>的皮毛，在阳光下看起来闪亮而顺滑。"
                            }
                        },
                        {
                            "text": "Her hair was <w>jet</w> and contrasted sharply with her pale skin.",
                            "target_lang_translations": {
                                "ru": "Её волосы были <w>чёрными как смоль</w> и резко контрастировали с её бледной кожей.",
                                "zh": "她的头发<w>漆黑</w>，与她苍白的皮肤形成了鲜明的对比。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jet-black"
                    ],
                    "common_phrases": [
                        "jet black"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень темного, глубокого черного цвета.",
                        "zh": "非常深沉的黑色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угольно-чёрный",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "чёрный как смоль",
                                "target_lang_sense_clarification": "идиома"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乌黑",
                                "target_lang_sense_clarification": "颜色"
                            },
                            {
                                "target_lang_word": "漆黑",
                                "target_lang_sense_clarification": "极黑"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "579d8b72-082f-397b-b523-95edb19319d3",
                    "sense_definition": "A male given name.",
                    "learner_level": "A1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Jet</w> is coming over to play video games later.",
                            "target_lang_translations": {
                                "ru": "Мой друг <w>Джет</w> придет позже поиграть в видеоигры.",
                                "zh": "我的朋友<w>杰特</w>待会儿要过来玩电子游戏。"
                            }
                        },
                        {
                            "text": "I introduced myself to <w>Jet</w> on the first day of school.",
                            "target_lang_translations": {
                                "ru": "Я представился <w>Джету</w> в первый день в школе.",
                                "zh": "我在开学第一天向<w>杰特</w>做了自我介绍。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя.",
                        "zh": "男性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джет",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杰特",
                                "target_lang_sense_clarification": "人名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}