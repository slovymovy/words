                            {
                                "example_id": "9aeac270-55e3-4bcb-836f-8560b059791b",
                                "sense_id": "063dba54-82eb-39fb-b212-2d2ba462dbd0",
                                "text": "Les langues sémitiques ne connaissent pas le voussoiement."
                            },
                            {
                                "example_id": "9d64a4b1-ea19-4f45-ba82-4cc6a37a6c76",
                                "sense_id": "063dba54-82eb-39fb-b212-2d2ba462dbd0",
                                "text": "Oublie le voussoiement de nos familles et appelle-moi par mon prénom."
                            },
                            {
                                "example_id": "6cf9f7f3-bfa7-4748-a1ed-4c439618f23b",
                                "sense_id": "063dba54-82eb-39fb-b212-2d2ba462dbd0",
                                "text": "Simon, dit-elle, réveille-toi … Réveillez-vous, corrigea-t-elle (car elle trouvait très élégant ce voussoiement entre amants, dont le premier exemple lui avait été donné dans un film de série B qui retraçait les amours de Lady Hamilton avec l'amiral Nelson, et Simon, pour lui plaire, s'y essayait aussi)."
                            },
                            {
                                "example_id": "de0fd8e0-c549-4855-8c77-5d4a2f838ac7",
                                "sense_id": "063dba54-82eb-39fb-b212-2d2ba462dbd0",
                                "text": "« Je ne m’adressais pas à vous, monsieur.\n– Je sais, ne vous inquiétez pas. »\nLe voussoiement était, à présent, de rigueur."
                            }
                        ]
