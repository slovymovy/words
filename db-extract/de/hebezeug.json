                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70552679-e216-35bd-992b-49d1081e3a2a",
                                        "entry_id": "5d080dd2-37ba-3450-ab17-35e795389703",
                                        "glosses": [
                                            "Any member of certain classes of devices that hoist things."
                                        ],
