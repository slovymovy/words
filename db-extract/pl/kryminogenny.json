                        "source_sense_id": "d07ae322-4ed9-375d-9c14-0ae4d701a58e",
                        "target_lang_word": "criminogène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "criminogène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1054824-e537-34a7-aa64-155a3f60ea3a",
                                        "entry_id": "96df8800-f6f1-3deb-bb7e-61bfcefba731",
                                        "glosses": [
                                            "[En parlant d’un environnement, d’un facteur, d’une situation] Qui génère de la criminalité, qui en favorise le développement, l’extension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b0a92a-96cd-4e80-9bd4-278e4bd5743f",
                                                "sense_id": "f1054824-e537-34a7-aa64-155a3f60ea3a",
                                                "text": "C’est oublier que, pendant la Révolution, la plupart des mouvements populaires étaient pacifistes. Cette criminalité quotidienne est un fantasme contemporain qu’on projette sur une ville qui n’était pas tant criminogène."
                                            },
                                            {
                                                "example_id": "3263d86c-46b0-419d-af78-56ef82d67cec",
                                                "sense_id": "f1054824-e537-34a7-aa64-155a3f60ea3a",
                                                "text": "Il reste une redoutable propension de l'architecte à penser la cité radieuse et à produire des Alphaville criminogènes."
                                            },
                                            {
                                                "example_id": "fd62ce4a-c13e-465d-9432-ae7b51ad7973",
                                                "sense_id": "f1054824-e537-34a7-aa64-155a3f60ea3a",
                                                "text": "« Le problème n'est pas le Panama, ce sont les sociétés écrans qui sont des outils criminogènes puisque leur seule vocation est de permettre d'échapper à tout contrôle. »(Véronique Cutajar-Universitaire)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
