                        "sense_id": "008815e1-0796-3231-9f8f-0ed7ac9b55bf",
                        "entry_id": "70619691-e97a-3677-84eb-25d119b311b1",
                        "glosses": [
                            "De la planète (de fiction) Krypton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be84fe38-4b4e-4554-9157-81abdd37ee4b",
                                "sense_id": "008815e1-0796-3231-9f8f-0ed7ac9b55bf",
                                "text": "Malgré la paternité de ses auteurs, le brillant Larry Davis, alias Funnyman, n'a pas eu le destin de son grand frère kryptonien."
                            },
                            {
                                "example_id": "bd5dc62c-9305-43a4-a3ed-3a821416b98a",
                                "sense_id": "008815e1-0796-3231-9f8f-0ed7ac9b55bf",
                                "text": "Lorsque Kal-El – c’est le nom kryptonien de Superman – arrive sur notre planète il est déjà unique et possède en acte ou en puissance tous les pouvoirs."
                            },
                            {
                                "example_id": "f0fc612d-f9f2-46c2-8b27-2cb21d22897f",
                                "sense_id": "008815e1-0796-3231-9f8f-0ed7ac9b55bf",
                                "text": "Ce qu’elle ne nous dit pas, c’est qu’en même temps ils ont aussi lancé un autre vaisseau dans lequel on avait déposé les archives kryptoniennes, qui contenaient tout le savoir impressionnant de cette civilisation avancée."
                            }
                        ]
                    }
