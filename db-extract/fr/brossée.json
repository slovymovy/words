                    {
                        "sense_id": "36acdc9d-6281-34e1-ba3e-d7e380ee4793",
                        "entry_id": "7620db57-9a9e-3eb9-9e63-f041618c44cb",
                        "glosses": [
                            "Volée de coups."
                        ],
