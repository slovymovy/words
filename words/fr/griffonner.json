    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b9470822-ef2e-3e88-a654-b9e4ca0f20e0",
                    "sense_definition": "Rédiger ou écrire quelque chose rapidement et sans grand soin.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ecriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>griffonna</w> rapidement quelques lignes sur un morceau de papier avant de partir."
                        },
                        {
                            "text": "Pendant la réunion, elle <w>griffonne</w> une note rapide dans son carnet pour ne rien oublier."
                        }
                    ],
                    "common_phrases": [
                        "griffonner quelques lignes",
                        "griffonner un mot"
                    ]
                },
                {
                    "sense_id": "19204daa-d921-3587-b346-31e862bed392",
                    "sense_definition": "Écrire en traçant des caractères très mal formés et presque illisibles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ecriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a <w>griffonné</w> une ordonnance que le pharmacien a eu beaucoup de peine à déchiffrer."
                        },
                        {
                            "text": "Avec ce vieux stylo défectueux, il ne fait que <w>griffonner</w> des lettres informes et incompréhensibles."
                        }
                    ],
                    "synonyms": [
                        "gribouiller"
                    ],
                    "common_phrases": [
                        "griffonner une ordonnance"
                    ]
                }
            ]
        }
    ]
