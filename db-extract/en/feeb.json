                "senses": [
                    {
                        "sense_id": "0bc865e3-9bd3-371e-a39d-99c944da1788",
                        "entry_id": "c2c3d317-2a4e-38d5-a82e-d4fcfb930951",
                        "glosses": [
                            "Alternative form of Feeb (“FBI agent”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6f6ab8c7-da89-41a3-8216-606dd9a4854f",
                                "sense_id": "0bc865e3-9bd3-371e-a39d-99c944da1788",
                                "text": "I ignored the bait until she said she couldn't understand why Harley had wanted to be a drug agent instead of \"a feeb.\""
                            },
                            {
                                "example_id": "f2de10e9-89b9-4b4a-a514-00fcfb0e2fd7",
                                "sense_id": "0bc865e3-9bd3-371e-a39d-99c944da1788",
                                "text": "When Lance was introduced, he held out his hand toward the feeb and said, “Hi, I'm current occupant:” The FBI agent was so nervous about the chopper flight he never noticed."
                            },
                            {
                                "example_id": "8aff9270-6bfb-4354-afd7-51aa882feba4",
                                "sense_id": "0bc865e3-9bd3-371e-a39d-99c944da1788",
                                "text": "“Surrender, feeb! Only I can save her!” Kegan boasted, firing short bursts from his weapon about randomly."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "563df41b-779e-3dc0-b352-774026098a60",
                "word": "Feeb",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "86fb5f83-00ef-4c6b-b9b2-2e24182f9155",
                        "entry_id": "563df41b-779e-3dc0-b352-774026098a60",
                        "tags": [
                            "plural"
