                            {
                                "target_word": "swig",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfb5017d-ddd5-35fd-8c19-f1181477d9b6",
                                        "entry_id": "089dc298-16e1-3b22-bebd-8b6cb2f34a32",
                                        "glosses": [
                                            "Drink, liquor."
                                        ],
