                    "semantic_group_id": "imprimerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après le tirage, l'ouvrier typographe devait patiemment <w>distribuer</w> les caractères en plomb."
                        },
                        {
                            "text": "L'apprenti imprimeur <w>distribuait</w> chaque lettre dans son cassetin approprié."
                        }
