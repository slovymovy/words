                ],
                "translations": [
                    {
                        "translation_id": "36dd8b8a-56fe-4066-a12e-a7ddcaa45246",
                        "source_entry_id": "dc1e9bb1-68e0-3b61-961c-41a4adbfd338",
                        "target_lang_word": "piétiner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piétiner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ddbef17-c124-33fe-b1f4-c73cb52b45b6",
                                        "entry_id": "748d5c77-6584-3cf9-b1cd-ed8bfbca0220",
                                        "glosses": [
                                            "Remuer fréquemment et vivement les pieds, s’agiter sur place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b84e10c2-8daf-43ae-9079-5c4d609ca696",
                                                "sense_id": "5ddbef17-c124-33fe-b1f4-c73cb52b45b6",
                                                "text": "Les chevaux, en piaffant, piétinèrent dans les flaques sanglantes. C'était le sacrifice de bienvenue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0364e176-763e-389b-b55f-dc303d23a36a",
                                        "entry_id": "748d5c77-6584-3cf9-b1cd-ed8bfbca0220",
                                        "glosses": [
                                            "Ne faire aucun progrès."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be0a862d-4df7-4c4e-b58c-f4c9e39e1a1f",
                                                "sense_id": "0364e176-763e-389b-b55f-dc303d23a36a",
                                                "text": "[Titre] La réforme de la justice piétine à l’Assemblée"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "785cf5b7-92de-3697-b310-8f3ab453bc56",
                                        "entry_id": "748d5c77-6584-3cf9-b1cd-ed8bfbca0220",
                                        "glosses": [
                                            "Fouler avec les pieds."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc90c11e-9f30-4d9e-9382-7feca84461c3",
                                                "sense_id": "785cf5b7-92de-3697-b310-8f3ab453bc56",
                                                "text": "Dans ma tente même, aux endroits qui ne sont pas constamment piétinés, sous mon lit, dans les coins, il y a maintenant tout un jardinet d'herbes vertes et de fleurettes multicolores."
                                            },
                                            {
                                                "example_id": "abc717e0-eba8-4e00-895c-77c26b3c52ff",
                                                "sense_id": "785cf5b7-92de-3697-b310-8f3ab453bc56",
                                                "text": "Son petit chapeau du dimanche, pour aller à l'église, son petit tambourin noir, elle l'arrache et le jette devant elle, sur la route. Et puis elle le piétine, avec ses chaussures du dimanche, elle piétine le satin noir dans la poussière de la route."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40cfc2c5-c84c-3126-9139-50c165875bcc",
                                        "entry_id": "748d5c77-6584-3cf9-b1cd-ed8bfbca0220",
                                        "glosses": [
                                            "Vaincre, mettre en pièces, écraser."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58da0c11-5f9c-457d-b071-3944c5ed8f5f",
                                                "sense_id": "40cfc2c5-c84c-3126-9139-50c165875bcc",
                                                "text": "On me défendait autrefois de jouer avec les petites filles que je ne connaissais pas et je me plaisais à piétiner les vieux tabous."
                                            },
                                            {
                                                "example_id": "7cf02ede-9f75-4afe-97ae-4e8b2aa096c6",
                                                "sense_id": "40cfc2c5-c84c-3126-9139-50c165875bcc",
                                                "text": "Selon eux, « Amazon a wokisé le “Seigneur des anneaux” » ou « cette série piétine un chef-d’œuvre de la fantasy »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa9fb889-4230-47b7-9017-657cfbcee194",
                        "source_entry_id": "dc1e9bb1-68e0-3b61-961c-41a4adbfd338",
                        "target_lang_word": "fouler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fouler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43ce2840-8001-3c98-bec2-a61d2827dcd5",
                                        "entry_id": "63bf163f-0510-3b84-aff9-0f0a452f8ba9",
                                        "glosses": [
                                            "Presser quelque chose qui cède, avec les pieds, les mains ou à l’aide d’un mécanisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "176f2f20-0a7e-4af6-a690-7e998e5afcd8",
                                                "sense_id": "43ce2840-8001-3c98-bec2-a61d2827dcd5",
                                                "text": "Les raisins cueillis sont transportés dans de grandes cuves en bois où des hommes les foulent avec les pieds ; la pulpe étant brisée, les diverses matières constitutives sont ainsi mises en contact intime."
                                            },
                                            {
                                                "example_id": "60191950-95ab-4b0c-adfb-63b987ad25ea",
                                                "sense_id": "43ce2840-8001-3c98-bec2-a61d2827dcd5",
                                                "text": "Cette industrie du drap est en effet l'une des plus complexes, et le nombre des opérations nécessaires pour transformer la laine brute en produit fini est très élevé. Il fallait trier la laine, la teindre, la mélanger, la carder, la filer, la tisser, dégraisser le tissu, le fouler, le lainer, le tondre, l'épinceter, et enfin lui donner de l'éclat en le pressant."
                                            },
                                            {
                                                "example_id": "00cb915b-7126-4930-bd5b-85e7a53b11c6",
                                                "sense_id": "43ce2840-8001-3c98-bec2-a61d2827dcd5",
                                                "text": "Fouler la vendange. — Fouler une cuve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd7f0bd3-9e69-34c7-ab70-f85210538c94",
                                        "entry_id": "63bf163f-0510-3b84-aff9-0f0a452f8ba9",
                                        "glosses": [
                                            "Faire battre ou parcourir un bois par la meute."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "230c012e-daf4-3654-8649-6480f8db6448",
                                        "entry_id": "63bf163f-0510-3b84-aff9-0f0a452f8ba9",
                                        "glosses": [
                                            "Presser sur les feuilles qui reçoivent l’impression."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ea864b8-c197-4856-9407-82d3257655a9",
                                                "sense_id": "230c012e-daf4-3654-8649-6480f8db6448",
                                                "text": "Cette presse foule bien, foule également, régulièrement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad772e1d-8ae4-3ed7-81a8-3167da006fb8",
                                        "entry_id": "63bf163f-0510-3b84-aff9-0f0a452f8ba9",
                                        "glosses": [
                                            "Marcher sur."
                                        ],
                                        "tags": [
                                            "formal",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5a1174a-eaff-434e-9eb0-1a7ff7cce880",
                                                "sense_id": "ad772e1d-8ae4-3ed7-81a8-3167da006fb8",
                                                "text": "À Dixmont, au sud-est de Sens, une belle église gothique est entourée d'une espèce de prairie que peu de pieds ont foulée."
                                            },
                                            {
                                                "example_id": "cc120bce-ff71-4a06-8000-e2f34252bc33",
                                                "sense_id": "ad772e1d-8ae4-3ed7-81a8-3167da006fb8",
                                                "text": "Tu croyais fouler le sol ferme, une piste — une pissate — te fier à son gazon honnête, il branle au même instant, la vase qu'il dissimule fait irruption à la surface, gargouille, emplit ta chaussure de sa rouille putride."
                                            },
                                            {
                                                "example_id": "00bef6d6-ba0e-4c0a-87ce-5402d2b7ea5f",
                                                "sense_id": "ad772e1d-8ae4-3ed7-81a8-3167da006fb8",
                                                "text": "On arpente les moquettes de la first classe, puis le linoléum de la classe touriste pour, enfin, fouler le caoutchouc merdâtre de la zone migrateuse."
                                            },
                                            {
                                                "example_id": "4117a86d-2fc9-40c1-8580-e0166a0c1c3d",
                                                "sense_id": "ad772e1d-8ae4-3ed7-81a8-3167da006fb8",
                                                "text": "Les paysans se réjouissent que la procession foule leurs champs, ce qui en accroît la fécondité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a476350a-aeb2-3647-92dc-70eb932ebb40",
                                        "entry_id": "63bf163f-0510-3b84-aff9-0f0a452f8ba9",
                                        "glosses": [
                                            "Opprimer par des exactions, surcharger d’impôts."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73b63315-36b5-4347-b7ae-c51def0380de",
                                                "sense_id": "a476350a-aeb2-3647-92dc-70eb932ebb40",
                                                "text": "Une province foulée par l’ennemi."
                                            },
                                            {
                                                "example_id": "981cef2f-c344-4d20-8136-ea76701268fc",
                                                "sense_id": "a476350a-aeb2-3647-92dc-70eb932ebb40",
                                                "text": "Hélas ! la guerre foulait maintenant tout le royaume du nord au midi, du couchant au levant, suivie de ses deux compagnes assidues, la peste et la famine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7aa8b4c-12a4-36a2-9431-61c4f0efb1d4",
                                        "entry_id": "63bf163f-0510-3b84-aff9-0f0a452f8ba9",
                                        "glosses": [
                                            "ou Blesser en frappant ou en pressant fortement."
                                        ],
                                        "tags": [
                                            "pronominal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e794301-dc67-4752-92f1-18a1d6808718",
                                                "sense_id": "c7aa8b4c-12a4-36a2-9431-61c4f0efb1d4",
                                                "text": "— Eh bien, tu vois, moi aussi, tout de suite après t'avoir quitté hier, j'ai fait une faute de carre, en pleine vitesse, je ne sais pas comment c'est arrivé, je me suis un peu foulé le poignet."
                                            },
                                            {
                                                "example_id": "5db4d93f-dab7-452c-9822-f2d3189334b7",
                                                "sense_id": "c7aa8b4c-12a4-36a2-9431-61c4f0efb1d4",
                                                "text": "Dans cette chute, mon poignet s’est foulé."
                                            },
                                            {
                                                "example_id": "234e0a83-0631-4433-aa1d-440409779f99",
                                                "sense_id": "c7aa8b4c-12a4-36a2-9431-61c4f0efb1d4",
                                                "text": "Les selles neuves foulent souvent les chevaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
