                        "glosses": [
                            "het probleem dat veel veel mensen veel spellingfouten maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "254da88d-b40b-41e1-836f-7d2430748313",
                                "sense_id": "85007ba9-5032-3597-898b-217eaf682a0e",
                                "text": "Het hardnekkige spellingprobleem werd als een hete aardappel doorgerold naar steeds hogere onderwijsniveaus, die de laag eronder nalatigheid verwijten. Hbo’s en universiteiten nemen hun eerstejaars spellingtoetsen af, en leren ze op bijspijkercursussen wat een 8-jarige kan begrijpen: dat het ‘hij loop-t’ is, dus ook ‘hij word-t’ en ‘hij bedoel-t’. Daarvoor is hogeronderwijsgeld niet bedoeld. Maar ja, íemand moet het doen."
                            },
                            {
                                "example_id": "9e015ef1-4bd5-49ee-8df4-7c60b2669150",
                                "sense_id": "85007ba9-5032-3597-898b-217eaf682a0e",
                                "text": "Met hen voor ogen heeft de Taaladviesdienst van Het Genootschap Onze Taal – een vereniging van taalliefhebbers – het boekje De Dikke Drieduizend Dicteewoorden samengesteld. Zoals de titel al doet vermoeden, bestaat de hoofdmoot uit ruim drieduizend woorden die een spellingprobleem kunnen opleveren, met bij ieder woord een korte toelichting over wat de valkuilen zijn van dit woord."
                            }
                        ]
                    }
