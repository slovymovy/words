                "senses": [
                    {
                        "sense_id": "2d5d5699-7385-338c-9298-d0eaa5f4fdd1",
                        "entry_id": "7212db86-7538-3bfa-b59b-e67f2b6340c2",
                        "glosses": [
                            "Mesure de capacité utilisée dans les cafés ou restaurants suisses pour désigner une consommation d’un, deux ou trois décilitres, en général de vin."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "e2209df5-acda-42e2-8bc6-3f5332473161",
                                "sense_id": "2d5d5699-7385-338c-9298-d0eaa5f4fdd1",
                                "text": "Je commandai trois décis, ce qui me fis trois verres, que je vidai coup sur coup; puis cognant sur la table, je commandai trois nouveaux décis."
                            },
                            {
                                "example_id": "b5d89824-ad55-4ac2-bea5-d189a442b150",
                                "sense_id": "2d5d5699-7385-338c-9298-d0eaa5f4fdd1",
                                "text": "L’Auberge du Portalet, où j’ai coutume d’aller lire mon courrier en buvant deux décis de fendant, avait été restaurée avec goût, et l’ami de Paris que j’y ai mené s’est émerveillé de trouver, dans un si petit village, un café si pimpant et si propre."
                            }
                        ]
                    }
