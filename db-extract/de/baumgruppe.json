                ],
                "senses": [
                    {
                        "sense_id": "b076df6f-5819-3399-be6e-1fa3af312a7b",
                        "entry_id": "2b4428b8-e056-3ac5-b00c-38c9d10897f0",
                        "glosses": [
                            "eine Anzahl zusammenstehender Bäume"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad6897a0-2e3b-4c1a-80ef-0afd65e442b6",
                                "sense_id": "b076df6f-5819-3399-be6e-1fa3af312a7b",
                                "text": "Diese ganze Baumgruppe soll abgeholzt werden."
                            },
                            {
                                "example_id": "42ebe860-f705-4a16-8b7f-db4a4f3f5812",
                                "sense_id": "b076df6f-5819-3399-be6e-1fa3af312a7b",
                                "text": "„Sie hatten sich etwas abseits in den Schatten einer Baumgruppe gesetzt und hörten dem Leutnant zu.“"
                            },
                            {
                                "example_id": "c76fcf0a-a185-4563-93d7-65b52ed9bac4",
                                "sense_id": "b076df6f-5819-3399-be6e-1fa3af312a7b",
                                "text": "„Unter einer Baumgruppe saß eine Gruppe Moslems im Schatten.“"
                            },
                            {
                                "example_id": "142c6649-2b6c-4130-bb89-17f7a635d636",
                                "sense_id": "b076df6f-5819-3399-be6e-1fa3af312a7b",
                                "text": "„Im Schatten der einzelnen, in der Lichtung stehengelassenen Baumgruppen lagerten sie dann gemeinschaftlich, teils ihren Plan für den Abend zu bereden, teils der Ruhe zu pflegen und mit Sonnenuntergang zu neuen Anstrengungen gestärkt und gekräftigt zu sein.“"
                            },
                            {
                                "example_id": "e94c2b19-32fc-4954-b1e0-1cb167091def",
                                "sense_id": "b076df6f-5819-3399-be6e-1fa3af312a7b",
                                "text": "„Abends kehrte er dann in ein Zimmer zurück, dessen einziges Fenster keinen Ausblick auf Felder und Baumgruppen bot, sondern auf einen düsteren Hof, auf den andere Fenster in trüber Verzweiflung starrten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
