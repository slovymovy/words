{
    "word_family": [
        "catcall"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1d73615c-b4d3-382e-9928-c71564d89104",
                    "sense_definition": "The act of shouting or whistling at someone in a public place, often in a sexual or harassing way.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "harassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many women feel unsafe walking alone at night due to the constant threat of <w>catcalling</w>.",
                            "target_lang_translations": {
                                "zh": "许多女性因为时刻面临<w>街头骚扰</w>的威胁，晚上不敢独自走路。"
                            }
                        },
                        {
                            "text": "Public awareness campaigns are working to stop street <w>catcalling</w> in major cities.",
                            "target_lang_translations": {
                                "zh": "各大城市正在开展公众意识活动，以制止<w>街头骚扰</w>行为。"
                            }
                        }
                    ],
                    "synonyms": [
                        "street harassment"
                    ],
                    "common_phrases": [
                        "street catcalling"
                    ],
                    "target_lang_definitions": {
                        "zh": "在公共场合对他人进行带有性骚扰性质的呼喊或吹口哨的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "街头骚扰",
                                "target_lang_sense_clarification": "指在公共场所对陌生人进行的言语或行为骚扰。"
                            },
                            {
                                "target_lang_word": "言语骚扰",
                                "target_lang_sense_clarification": "指通过言语对他人进行冒犯或骚扰。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "defd8162-88c6-37f5-9af2-662d800ac6a7",
                    "sense_definition": "The present participle and gerund of <w>catcall</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "harassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>catcalling</w> at the women walking past the construction site.",
                            "target_lang_translations": {
                                "zh": "他对着路过建筑工地的女性<w>吹口哨骚扰</w>。"
                            }
                        },
                        {
                            "text": "The group was <w>catcalling</w> during the performance to show their disapproval.",
                            "target_lang_translations": {
                                "zh": "那群人在演出期间不断<w>起哄</w>以表示不满。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is the present participle and gerund form of the verb."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指在公共场合对他人进行带有性骚扰性质的呼喊或吹口哨，或者在演出中发出嘘声以表示不满。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吹口哨骚扰",
                                "target_lang_sense_clarification": "特指通过吹口哨等方式进行骚扰。"
                            },
                            {
                                "target_lang_word": "起哄",
                                "target_lang_sense_clarification": "指在公共场合大声喧哗或发出嘘声以表示不满或嘲弄。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}