                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "7847b61d-ef7b-4f46-b670-452dcf27f676",
                        "entry_id": "198ba098-5597-3bbb-b0f2-f3feaa6b73e3",
                        "tags": [
