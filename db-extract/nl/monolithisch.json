                    {
                        "form_id": "8e5efe8b-5776-4fb9-aae2-82fc7883ab1a",
                        "entry_id": "de58e1f1-e501-306d-aca6-b7220264502d",
                        "tags": [],
                        "form": "monolitisch",
                        "note": "officiële spelling van 1955 tot 1996"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "733484b0-51dc-325f-9efc-c6cf3c5f61de",
                        "entry_id": "de58e1f1-e501-306d-aca6-b7220264502d",
                        "glosses": [
                            "gevormd uit één stuk steen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "330e5146-1cc8-3960-8a4b-3b4fa18be75e",
                        "entry_id": "de58e1f1-e501-306d-aca6-b7220264502d",
                        "glosses": [
                            "van iets dat het kolossaal groot is en uit één massief brok bestaat, één geheel vormend, geïntegreerd, homogeen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ae36bdeb-dbc9-48c9-8a73-b9a49e5f96df",
                                "sense_id": "330e5146-1cc8-3960-8a4b-3b4fa18be75e",
                                "text": "Van de nog niet jarige meester zelf klonk …miserere…. Daarin laat Andriessen, knipogend naar Gregorio Allegri’s beroemde psalmzetting, barokkerige tweestemmigheid ontaarden in monolithische tutti’s en een prachtig geharmoniseerde slotsectie. Jammer dat de vioolaanzetten aanvankelijk wat glibberig waren."
                            },
                            {
                                "example_id": "17055bde-be9f-4661-ab44-990d637c4d3d",
                                "sense_id": "330e5146-1cc8-3960-8a4b-3b4fa18be75e",
                                "text": "“We zijn hetzelfde bedrijf. We hebben niet opeens drieduizend mensen aangenomen. We zijn geen grote monolithisch rijk waar beslissingen worden genomen in een torentje. We werken nog steeds graag samen met andere partijen. We hebben nog steeds hetzelfde respect en waardering voor talent als we altijd al deden.”"
                            },
                            {
                                "example_id": "2d92b9cb-fde4-4f07-9072-ee233455e231",
                                "sense_id": "330e5146-1cc8-3960-8a4b-3b4fa18be75e",
                                "text": "Een ander groot complex dat in aanmerking komt voor verplaatsing is De Nederlandsche Bank op het Frederiksplein. Moet dit monstrum er niet met zachte dwang toe worden gebracht zich ten langen leste te voegen bij zijn monolithische vrienden op de Zuidas? Op deze plek kan het glorieuze Paleis voor Volksvlijt worden herbouwd of een ander toegankelijk centrum dat de druk op de overbelaste binnenstad zal verminderen."
                            }
                        ]
                    },
                    {
                        "sense_id": "06bf9e55-19f8-3f89-b1f2-453859a689a6",
                        "entry_id": "de58e1f1-e501-306d-aca6-b7220264502d",
                        "glosses": [
                            "opererend onder één merknaam"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa3688da-81f7-42ba-8498-8970a22393a0",
                        "source_entry_id": "de58e1f1-e501-306d-aca6-b7220264502d",
                        "source_sense_id": "330e5146-1cc8-3960-8a4b-3b4fa18be75e",
