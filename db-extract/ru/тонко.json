                                "target_senses": [
                                    {
                                        "sense_id": "67807764-2b4e-3bc4-a6af-672dead4b2bc",
                                        "entry_id": "6ed529b2-9ac1-3923-91b7-d3b36cda87ec",
                                        "glosses": [
                                            "To make thin or thinner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86bac7c9-4562-4e41-a3f6-dcb144515663",
                                                "sense_id": "67807764-2b4e-3bc4-a6af-672dead4b2bc",
                                                "text": "Exhausted fathers thinned the blood,\nYou curse the legacy of pain;\nDarling of an infected brood,\nYou feel disaster climb the vein."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e61e97c7-d1c7-3fe7-88d4-8e08e64c7d1c",
                                        "entry_id": "6ed529b2-9ac1-3923-91b7-d3b36cda87ec",
                                        "glosses": [
                                            "To become thin or thinner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f0e1240-16fd-40e5-8bd1-a4a9abfaed13",
                                                "sense_id": "e61e97c7-d1c7-3fe7-88d4-8e08e64c7d1c",
                                                "text": "The crowds thinned after the procession had passed: there was nothing more to see."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4ba3e4b-6864-3093-a550-5559b6dadd5d",
                                        "entry_id": "6ed529b2-9ac1-3923-91b7-d3b36cda87ec",
                                        "glosses": [
                                            "To dilute."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd1688a4-046f-3022-a26f-29642c917ead",
                                        "entry_id": "6ed529b2-9ac1-3923-91b7-d3b36cda87ec",
                                        "glosses": [
                                            "To remove some plants or parts of plants in order to improve the growth of what remains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e218ae3f-b0e2-4567-b0f7-7c4f0a392f56",
                                                "sense_id": "cd1688a4-046f-3022-a26f-29642c917ead",
                                                "text": "So floriferous are Asian pears, and the tree so laden with young fruit, that as the tree approaches maturity it is worth considering thinning the fruit (I can't quite bring myself to thin the flowers) so as to neither overburden the tree for this year nor tire it for the next. Thinning early in the season, while the fruit is small, is ideal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12098920-afde-32a9-aafd-ca9dbbc34dfe",
                                        "entry_id": "b12977ec-9363-3dfe-8cc7-2ade9fd074fd",
                                        "glosses": [
                                            "Not thickly or closely; in a scattered state."
                                        ],
