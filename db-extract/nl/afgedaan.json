            {
                "entry_id": "02e0c46c-5b59-3740-870f-c952061379bc",
                "word": "afgedaan",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "33ac9441-d0fd-34f5-b2a0-b96ebb5bf116",
                        "entry_id": "02e0c46c-5b59-3740-870f-c952061379bc",
                        "glosses": [
                            "voltooid deelwoord van afdoen"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c0efa168-f9d5-4bee-9673-1b60402f0cf3",
                                "sense_id": "33ac9441-d0fd-34f5-b2a0-b96ebb5bf116",
                                "text": "Wat als een formaliteit werd afgedaan was in werkelijkheid de eigenlijke reden van het gesprek."
                            },
                            {
                                "example_id": "c9adf94c-5505-4e59-b640-7431ae8bcf5e",
                                "sense_id": "33ac9441-d0fd-34f5-b2a0-b96ebb5bf116",
                                "text": "Deze goedbedoelde interventies hadden niets afgedaan aan Rafaels weemoed, de zeven slapers konden hem niet geruststellen, en troosten evenmin, want er was een stem in zijn hoofd die hem op momenten van onbehoedzaamheid bezocht, de stem van een in een hoek vergroeide snuisterijenventer, die hem als een ijskoude wind influisterde dat hij Mina Stitou allang kwijt was, omdat ze niets zocht, ook niet in hem, en niets verlangde."
                            }
                        ]
                    }
