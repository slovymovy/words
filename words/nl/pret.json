                                "ru": "Дети вовсю <w>веселились</w> на свежем снегу.",
                                "tr": "Çocuklar taze karda çok <w>eğlendi</w>.",
                                "pl": "Dzieci miały mnóstwo <w>zabawy</w> w świeżym śniegu.",
                                "de": "Die Kinder hatten einen riesigen <w>Spaß</w> im frischen Schnee.",
                                "fr": "Les enfants se sont beaucoup <w>amusés</w> dans la neige fraîche.",
                                "it": "I bambini si sono <w>divertiti</w> un mondo nella neve fresca.",
                                "cs": "Děti si v čerstvém sněhu užívaly velkou <w>legraci</w>.",
                                "es": "Los niños se <w>divirtieron</w> mucho en la nieve fresca.",
                                "zh": "孩子们在新鲜的雪地里玩得非常<w>开心</w>。"
                            }
                        },
                        {
                            "text": "We maken altijd veel <w>pret</w> als we samen op vakantie gaan.",
                            "target_lang_translations": {
                                "en": "We always have a lot of <w>fun</w> when we go on vacation together.",
                                "ru": "Мы всегда очень <w>веселимся</w>, когда вместе едем в отпуск.",
                                "tr": "Birlikte tatile gittiğimizde her zaman çok <w>eğleniriz</w>.",
                                "pl": "Zawsze mamy dużo <w>radości</w>, kiedy jedziemy razem na wakacje.",
                                "de": "Wir haben immer viel <w>Spaß</w>, wenn wir zusammen in den Urlaub fahren.",
                                "fr": "Nous avons toujours beaucoup de <w>plaisir</w> quand nous partons en vacances ensemble.",
                                "it": "Ci <w>divertiamo</w> sempre molto quando andiamo in vacanza insieme.",
                                "cs": "Když jedeme společně na dovolenou, vždycky si užijeme spoustu <w>zábavy</w>.",
                                "es": "Siempre nos <w>divertimos</w> mucho cuando nos vamos de vacaciones juntos.",
                                "zh": "我们一起去度假时总是充满<w>乐趣</w>。"
