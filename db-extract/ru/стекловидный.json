                ],
                "senses": [
                    {
                        "sense_id": "0e4c4bc1-a9b3-334f-8917-198d7c5b648d",
                        "entry_id": "53461ddf-20ac-3c1e-a195-fcf6286e0778",
                        "glosses": [
                            "сходный со стеклом, видом похожий на стекло"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f887bbe6-4b84-4ba1-8787-4f9c2dec5f3e",
                                "sense_id": "0e4c4bc1-a9b3-334f-8917-198d7c5b648d",
                                "text": "Стекловидный камень. Стекловидное тело в глазу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b327029b-e113-4188-9d77-da405ed6eb90",
                        "source_entry_id": "53461ddf-20ac-3c1e-a195-fcf6286e0778",
                        "source_sense_id": "0e4c4bc1-a9b3-334f-8917-198d7c5b648d",
                        "target_lang_word": "glasig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glasig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "264525e2-97dc-329e-83c0-a56cfe2417a1",
                                        "entry_id": "dc5f1794-7639-3f6e-bc0e-8d3678186576",
                                        "glosses": [
                                            "wie Glas, eine Eigenschaft von Glas aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef93402d-fc8b-4fab-8096-e5e5bce3dbfb",
                                                "sense_id": "264525e2-97dc-329e-83c0-a56cfe2417a1",
                                                "text": "Die Zwiebeln werden in Butter angeschwitzt, bis sie glasig sind."
                                            },
                                            {
                                                "example_id": "614bc40b-68e6-48ee-af96-e1b65b85d538",
                                                "sense_id": "264525e2-97dc-329e-83c0-a56cfe2417a1",
                                                "text": "Sie starrte ihn mit glasigem Blick an."
                                            },
                                            {
                                                "example_id": "b138a5e0-6cc6-4d75-906a-0d2c2b5a20bd",
                                                "sense_id": "264525e2-97dc-329e-83c0-a56cfe2417a1",
                                                "text": "„Mit glasigen Augen, nicht begreifend, was sich vor seinen Augen abspielt, wankt er zu seinen Genossen, umarmt einige von ihnen, schmatzt ein paar Bruderküsse auf ihre Wangen und winkt allen freundlich zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
