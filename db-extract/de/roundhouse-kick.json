                "senses": [
                    {
                        "sense_id": "33af23a6-a257-396c-b941-6c3bad6413db",
                        "entry_id": "2064a6b2-e9d4-3d6d-bed9-4f1f803b5121",
                        "glosses": [
                            "kreisförmig ausgeführte Fußtechnik bei Kampfsportarten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e40ffded-9f60-4870-9e90-5c74a74e320a",
                                "sense_id": "33af23a6-a257-396c-b941-6c3bad6413db",
                                "text": "„Treffer sind etwas Seltsames, denn jeder von ihnen ist anders. Es gibt Uppercuts, Haken, kurze Geraden, Roundhouse-Kicks, Schwinger und Genickschläge, um nur einige zu nennen.“"
                            },
                            {
                                "example_id": "7dfe7dc7-b4a4-4a57-9410-f78ed6dbed68",
                                "sense_id": "33af23a6-a257-396c-b941-6c3bad6413db",
                                "text": "„Dewey sah, wie sein Gegner den Oberkörper drehte, um zu einem Roundhouse-Kick anzusetzen.“"
                            },
                            {
                                "example_id": "f75a4439-c134-4eee-b2fa-2445b44e0f56",
                                "sense_id": "33af23a6-a257-396c-b941-6c3bad6413db",
                                "text": "„Der zweite Wachmann sprang Gray Man in den Rücken, aber mit einem rechten Ellbogenstoß schüttelte er ihn wieder ab, und ein Roundhouse-Kick mitten ins Gesicht besorgte den Rest - der Mann klappte zusammen, ein Häufchen Elend im Schnee.“"
                            },
                            {
                                "example_id": "76fc24c9-2c71-4ac2-92e7-7072432a7e5a",
                                "sense_id": "33af23a6-a257-396c-b941-6c3bad6413db",
                                "text": "„Der Kerl fuhr hoch und versetzte ihm einen wilden Roundhouse-Kick, der den Kopf des Sergeant streifte, worauf ihn Landsman nach Strich und Faden zusammenschlug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
