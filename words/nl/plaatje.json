                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ce18c03-b450-3089-8bc4-6f579498da65",
                    "sense_definition": "Verkleinwoord van <w>plaat</w>.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een klein metalen voorwerp kun je aanduiden als een <w>plaatje</w>.",
                            "target_lang_translations": {
                                "en": "A small metal object can be referred to as a <w>small plate</w>.",
                                "ru": "Небольшой металлический предмет можно назвать <w>пластинкой</w>.",
                                "de": "Einen kleinen Metallgegenstand kann man als ein <w>Plättchen</w> bezeichnen."
                            }
                        },
                        {
                            "text": "Het <w>plaatje</w> op de deur geeft aan wie er woont.",
                            "target_lang_translations": {
                                "en": "The <w>plaque</w> on the door indicates who lives there.",
                                "ru": "<w>Табличка</w> на двери указывает, кто здесь живет.",
                                "de": "Das <w>Schildchen</w> an der Tür zeigt an, wer dort wohnt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "diminutief"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Diminutive of 'plaat' (plate/sheet); often refers to a small metal or plastic plate.",
                        "ru": "Уменьшительная форма слова 'plaat' (пластина, плита).",
                        "de": "Verkleinerungsform von 'plaat' (Platte); bezieht sich oft auf eine kleine Metall- oder Kunststoffplatte."
                    },
