    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "818e7805-fb83-35c5-95f5-aedb2d7645ec",
                    "sense_definition": "Занятие для развлечения, отдыха или соревнования, проводящееся по определённым правилам.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дети придумали весёлую <w>игру</w> во дворе дома.",
                            "target_lang_translations": {
                                "en": "The children came up with a fun <w>game</w> in the courtyard.",
                                "zh": "孩子们在院子里想出了一个有趣的<w>游戏</w>。"
                            }
                        },
                        {
                            "text": "Футбол — это самая популярная командная <w>игра</w> в мире.",
                            "target_lang_translations": {
                                "en": "Football is the most popular team <w>game</w> in the world.",
                                "zh": "足球是世界上最受欢迎的团队<w>运动</w>。"
                            }
                        },
                        {
                            "text": "Мы должны соблюдать правила <w>игры</w>, чтобы всё было честно.",
                            "target_lang_translations": {
                                "en": "We must follow the rules of the <w>game</w> to keep everything fair.",
                                "zh": "为了公平起见，我们必须遵守<w>游戏</w>规则。"
                            }
                        }
                    ],
                    "synonyms": [
                        "забава",
                        "матч",
                        "соревнование"
                    ],
                    "antonyms": [
                        "работа",
                        "труд"
                    ],
                    "common_phrases": [
                        "правила игры",
                        "азартная игра",
                        "детская игра",
                        "командная игра",
                        "олимпийские игры"
                    ],
                    "target_lang_definitions": {
                        "en": "An activity for entertainment, relaxation, or competition, conducted according to specific rules.",
                        "zh": "为娱乐、休息或比赛而进行的活动，遵循特定的规则。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "game",
                                "target_lang_sense_clarification": "activity for amusement"
                            }
                        ],
                        "zh": [
