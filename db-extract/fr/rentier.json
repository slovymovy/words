                    },
                    {
                        "form_id": "1a59100a-b229-462b-b682-a3f9a6f2840a",
                        "entry_id": "e0064f5f-1c22-3832-b6fc-0c2e84c8a7da",
                        "tags": [
                            "feminine"
                        ],
                        "form": "rentière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1aae5a36-09bb-333b-b77e-ea5d63cba8f6",
                        "entry_id": "e0064f5f-1c22-3832-b6fc-0c2e84c8a7da",
                        "glosses": [
                            "Personne qui a des rentes constituées sur l’État ou sur des particuliers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f701aa4-6f66-4505-9e8f-1fb724bf8cf9",
                                "sense_id": "1aae5a36-09bb-333b-b77e-ea5d63cba8f6",
                                "text": "Les rentiers sont payés par trimestre, par semestre ou par année."
                            }
                        ]
                    },
                    {
                        "sense_id": "97423844-2dad-3ff7-8f71-3a3829e38b06",
                        "entry_id": "e0064f5f-1c22-3832-b6fc-0c2e84c8a7da",
                        "glosses": [
                            "Bourgeois qui vit de son revenu, sans négoce ni industrie, ni fonction quelconque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4c19543-9bf1-42b2-8d5b-de4ea5c399a5",
                                "sense_id": "97423844-2dad-3ff7-8f71-3a3829e38b06",
                                "text": "Mener une existence de rentier."
                            },
                            {
                                "example_id": "eda1dcbe-198a-4f5b-a06b-b63ad4b2228f",
                                "sense_id": "97423844-2dad-3ff7-8f71-3a3829e38b06",
                                "text": "La crise actuelle atteint surtout les petits rentiers."
                            },
                            {
                                "example_id": "b03e6d33-1f4c-4f29-95a0-03b070bc9d83",
                                "sense_id": "97423844-2dad-3ff7-8f71-3a3829e38b06",
                                "text": "Le rentier était un personnage des romans jusqu’à la fin du XIXᵉ siècle, mais aussi une réalité sociale jusqu’à la Seconde Guerre mondiale."
                            },
                            {
                                "example_id": "4f11d6fb-e438-474a-91ef-ebe8681573af",
                                "sense_id": "97423844-2dad-3ff7-8f71-3a3829e38b06",
                                "text": "Les maigres rentiers qui l’habitent ne doivent pas avoir l’air plus nul, plus modeste et plus bête."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff6cf710-010b-4583-8af8-9da2d9baec02",
                        "source_entry_id": "e0064f5f-1c22-3832-b6fc-0c2e84c8a7da",
                        "source_sense_description": "personne qui perçoit des rentes",
                        "target_lang_word": "Rentier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rentier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f19048fb-d612-3b76-8c1e-871d24c2a264",
                                        "entry_id": "0699fd56-668d-3a54-969a-1243d8fcb444",
                                        "glosses": [
                                            "nordische Hirschart, die von den nordischen Hirtenvölkern halbzahm gehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "896ef1e9-1c2a-4da7-9f11-9895b89e5c45",
                                                "sense_id": "f19048fb-d612-3b76-8c1e-871d24c2a264",
                                                "text": "Nur bei den Rentieren trägt auch das Weibchen ein Geweih."
                                            },
                                            {
                                                "example_id": "f3939b46-16ba-4a21-bfbb-c9d0880f72bd",
                                                "sense_id": "f19048fb-d612-3b76-8c1e-871d24c2a264",
                                                "text": "„Jakob und ich bestaunen die erhabene Erscheinung dieser Troika wie kleine Jungs den Auftritt eines Weihnachtsmanns samt Rentieren.“"
                                            },
                                            {
                                                "example_id": "2bec7aad-1217-40b3-980f-d3e1683f7fe3",
                                                "sense_id": "f19048fb-d612-3b76-8c1e-871d24c2a264",
                                                "text": "„Die Skandinavier bauen Gerste und Hafer an, doch sie fischen auch und gehen auf die Jagd - im Norden zählen etwa Elche und Rentiere zu ihrer Beute.“"
                                            },
                                            {
                                                "example_id": "d3c234b7-ee23-41da-84a4-39a4faca324a",
                                                "sense_id": "f19048fb-d612-3b76-8c1e-871d24c2a264",
                                                "text": "„Die Rentiere laufen dort frei und wo sie wollen.“"
                                            },
                                            {
                                                "example_id": "3aa3828e-0083-40b2-965a-9e39fa0c555f",
                                                "sense_id": "f19048fb-d612-3b76-8c1e-871d24c2a264",
                                                "text": "„Und dann, am vierten Tag, begegneten uns endlich Rentiere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Rentier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "411cf53a-53ae-3ae0-9732-53420a96d968",
                                        "entry_id": "aca0c426-e133-39aa-9e63-b912ca5a842b",
                                        "glosses": [
                                            "jemand, der von regelmäßigen Zahlungen aus angelegtem Kapital (Renten²) lebt"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1cf6c77-024a-4d31-999b-d868971b9fb8",
                                                "sense_id": "411cf53a-53ae-3ae0-9732-53420a96d968",
                                                "text": "„Überlässt zum Beispiel ein Rentier seinem Staat Geld gegen Zinszahlungen, dann handelt es sich zunächst um eine Form des zinstragenden Kapitals.“"
                                            },
                                            {
                                                "example_id": "2b6b22a5-d752-40b8-80f3-e06bf5b7fa9c",
                                                "sense_id": "411cf53a-53ae-3ae0-9732-53420a96d968",
                                                "text": "„Daß der Zins vom Kapital in demselben Maße abnimmt, wie Masse und Zahl des Kapitals zunimmt, wie das Kapital anwächst, daß daher der kleine Rentier nicht mehr von seiner Rente leben kann, also sich auf die Industrie werfen muß, also die Reihen der kleinen Industriellen und damit die Kandidaten für das Proletariat vermehren hilft, alles das bedarf wohl keiner weiteren Auseinandersetzung.“"
                                            },
                                            {
                                                "example_id": "47a01ebb-e19c-4848-90b0-703a234fe718",
                                                "sense_id": "411cf53a-53ae-3ae0-9732-53420a96d968",
                                                "text": "„Rentiers können sich gegen kapitalistische Unternehmer dann nicht behaupten, wenn und weil in Produktionsanlagen investierende Kapitalisten aus ihren Investitionen auch in der Folgezeit Einkommen erzielen. Rentiers vergeuden dagegen im Regelfall den auf sie entfallenden Überschuss unproduktiv.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "86851411-f8d2-373a-89ac-368562d2d137",
                                        "entry_id": "aca0c426-e133-39aa-9e63-b912ca5a842b",
                                        "glosses": [
                                            "Rentner"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32cdfb6b-8a50-4155-815c-8c868c2e2f39",
                                                "sense_id": "86851411-f8d2-373a-89ac-368562d2d137",
                                                "text": "„Wahrscheinlich ist, daß Kohl den Gedanken an den Ruhestand nicht ertrug. Rosenzucht in Oggersheim? Gott bewahre. Rasen mähen, Fische gucken im Aquarium, den ganzen Tag? Politik ist sein Leben, was soll er als Rentier?“"
                                            },
                                            {
                                                "example_id": "d55938c7-6d31-4895-92e3-c7b7af880a92",
                                                "sense_id": "86851411-f8d2-373a-89ac-368562d2d137",
                                                "text": "„Man hat so seine Sorgen, wenn man auch ein Rentier ist mit vierhundert Mark, mit über vierhundert Mark noch in der Brieftasche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a755d83-a2d4-40d9-a964-c02db75e3f05",
                        "source_entry_id": "e0064f5f-1c22-3832-b6fc-0c2e84c8a7da",
                        "source_sense_description": "personne qui perçoit des rentes",
                        "target_lang_word": "Privatmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Privatmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "caf07677-6b4c-3bb1-9e91-19440c2d03e2",
                                        "entry_id": "7e76e456-e13a-35e5-8dfc-bcc0fdcfe9e5",
                                        "glosses": [
                                            "(männliche) Person in ihrem eigenen, persönlichen Bereich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2caf6763-f771-43b8-8ef9-4311fc34c8a9",
                                                "sense_id": "caf07677-6b4c-3bb1-9e91-19440c2d03e2",
                                                "text": "„Das Thema des Doppelgängers betrifft nicht nur den Privatmann, sondern erstreckt sich auch auf die soziale Ebene: denn fast alle Gestalten Hoffmanns verfügen über einen Personenstand, einen Beruf, ein Herkunftsland, mögen sie auch Funktionen als Salamander, Vampir, Zauberer undsoweiter gleichzeitig üben.“"
                                            },
                                            {
                                                "example_id": "9bc8d99b-18ec-430b-b9a4-e136a4de48a1",
                                                "sense_id": "caf07677-6b4c-3bb1-9e91-19440c2d03e2",
                                                "text": "„Ich hatte ein kleines Haus gemietet, wo ich eine Pharaobank unter Halbpart-Beteiligung eines Berufsspielers auflegte, der mich vor den Betrügereien gewisser überheblicher Aristokraten schützte, denen gegenüber ein einfacher Privatmann in meinem lieben Vaterland immer unrecht hat.“"
                                            },
                                            {
                                                "example_id": "3d65553c-2e32-4739-8491-7426960fbe98",
                                                "sense_id": "caf07677-6b4c-3bb1-9e91-19440c2d03e2",
                                                "text": "„Zugleich begann er als Privatmann früh, sich mit der altamerikanischen Lebenswelt zu befassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff3be471-834c-35d5-9a69-ae3db34bc2ec",
                                        "entry_id": "7e76e456-e13a-35e5-8dfc-bcc0fdcfe9e5",
                                        "glosses": [
                                            "(männliche) Person, die von ihrer Altersversorgung oder ihrem eigenen Vermögen lebt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd9d9a78-3816-4ce7-b65b-829ab5f7801a",
                        "source_entry_id": "e0064f5f-1c22-3832-b6fc-0c2e84c8a7da",
