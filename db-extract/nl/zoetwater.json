                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freshwater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97c05331-f3ae-315f-b567-37272548d7a1",
                                        "entry_id": "5e70dbbc-a53c-3628-bdcc-09fbd72a06ce",
                                        "glosses": [
                                            "Living in fresh water."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1321521-c25b-420e-9f90-1d86b5a7878c",
                                                "sense_id": "97c05331-f3ae-315f-b567-37272548d7a1",
                                                "text": "The trout is a freshwater fish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "453d532a-aa2a-35f1-bab0-edfbaea9ea98",
                                        "entry_id": "5e70dbbc-a53c-3628-bdcc-09fbd72a06ce",
                                        "glosses": [
                                            "Consisting of fresh water."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2351de21-68b9-4581-ab19-1c90e401898f",
                                                "sense_id": "453d532a-aa2a-35f1-bab0-edfbaea9ea98",
                                                "text": "Lake Baikal is the world's largest freshwater lake in terms of volume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eb334cf-cfdd-3616-8a3e-0756897bea80",
                                        "entry_id": "5e70dbbc-a53c-3628-bdcc-09fbd72a06ce",
                                        "glosses": [
                                            "Unskilled as a seaman."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74985db7-4e38-432d-97e7-efea23ecb490",
                                                "sense_id": "9eb334cf-cfdd-3616-8a3e-0756897bea80",
                                                "text": "“Mate,” said the captain in a low voice, “you talk like a fresh-water sailor. I can only attribute this shyness to some strange delusion, for surely,”—his voice assumed a slightly sneering tone as he said this—“surely I am not to suppose that you have become soft-hearted! […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d5dc22a-ee88-3e2a-912f-687b1e4ea618",
                                        "entry_id": "5e70dbbc-a53c-3628-bdcc-09fbd72a06ce",
                                        "glosses": [
                                            "neoclassical, in reference to U.S. macroeconomics and economics departments near the Great Lakes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63e95b66-91ee-4d9a-aca2-4698f597bb11",
                                                "sense_id": "7d5dc22a-ee88-3e2a-912f-687b1e4ea618",
                                                "text": "2012, John Quiggin, Zombie Economics: How Dead Ideas Still Walk Among Us, Princeton University Press (expanded paperback ed., 1st ed. from 2010), →ISBN, page 86.\nMeanwhile, the freshwater side of the dispute rapidly reverted to arguments from the nineteenth century, which had been debunked by Keynes and Irving Fisher."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "freshwater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a6fa618-0ac4-3492-82b5-a671aae61da0",
                                        "entry_id": "62133f73-cd62-38db-82f7-5c043b4642d7",
                                        "glosses": [
                                            "A body of fresh water"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74f20015-3fd6-4ebf-bf29-4be608e82e14",
                                                "sense_id": "6a6fa618-0ac4-3492-82b5-a671aae61da0",
                                                "text": "Fossils with low Sr/Ca ratios indicating origin in a freshwater of a type which has a low Sr/Ca ratio: […]"
                                            },
                                            {
                                                "example_id": "122b19ae-b471-42cc-9e3f-1bd02f4194d0",
                                                "sense_id": "6a6fa618-0ac4-3492-82b5-a671aae61da0",
                                                "text": "Smith (1958) found that N. limnicola in Lake Merced, virtually a freshwater, had no paragnaths or at the most one on section I against the \"normal\" 1–2."
                                            },
                                            {
                                                "example_id": "60531192-2ca8-4879-acec-af9d5dcebd73",
                                                "sense_id": "6a6fa618-0ac4-3492-82b5-a671aae61da0",
                                                "text": "The chances of long-term preservation of fossils in freshwaters are minimal, for freshwaters are readily disturbed and destroyed by drought on the land masses."
                                            },
                                            {
                                                "example_id": "8e8e87f5-d937-43bd-aa6f-de5859305f40",
                                                "sense_id": "6a6fa618-0ac4-3492-82b5-a671aae61da0",
                                                "text": "Freshwaters are portrayed in many artforms, including books such as Kenneth Grahame's childrens'^([sic]) story Wind in the Willows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b98cd679-0498-3a4f-8fc3-e35f1c562595",
                                        "entry_id": "62133f73-cd62-38db-82f7-5c043b4642d7",
                                        "glosses": [
                                            "Alternative spelling of fresh water."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be84f026-bc25-42c3-9efb-1946b9a79ccd",
                                                "sense_id": "b98cd679-0498-3a4f-8fc3-e35f1c562595",
                                                "text": "Schematic diagram of the viscosity effect during the injection of freshwater."
                                            },
                                            {
                                                "example_id": "62f8ddf8-7463-42bd-81b8-f01508f5903f",
                                                "sense_id": "b98cd679-0498-3a4f-8fc3-e35f1c562595",
                                                "text": "Above 200m, high-salinity water was being carried southward out of the Arabian Sea. This implies that most of the freshwater was imported into the Arabian Sea in the upper layer."
                                            },
                                            {
                                                "example_id": "8c47a784-6a43-44f2-bb78-7a142b3a98c4",
                                                "sense_id": "b98cd679-0498-3a4f-8fc3-e35f1c562595",
                                                "text": "Actual field data of Cl distribution in soil after irrigation with TWW and freshwater were obtained in a field experiment in Israel (Feigin et al., 2005; Fine et al. 2007)."
                                            },
                                            {
                                                "example_id": "7c1f1e09-175c-4435-b651-5d4ea1acb5f7",
                                                "sense_id": "b98cd679-0498-3a4f-8fc3-e35f1c562595",
                                                "text": "Alewives are anadromous fish: Born in freshwater, they spend their lives in the ocean, returning annually to their birthplaces to spawn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "643efa05-b272-489a-884c-341557ae9c37",
                        "source_entry_id": "9b18ce49-8fea-33b5-8bf1-170be516de7d",
                        "source_sense_id": "de6f039b-092f-3211-9d90-144452b75bd1",
                        "source_sense_description": "zoetwater",
                        "target_lang_word": "eau douce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eau douce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33584dd4-1d71-307c-9816-342330f5bc83",
                                        "entry_id": "82b25e4f-4cb1-31ba-8ac1-88b281a60221",
                                        "glosses": [
                                            "Eau non salée, de lacs et de cours d’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f2e1643-3b6b-48e2-bc3c-98245a90bcef",
                                                "sense_id": "33584dd4-1d71-307c-9816-342330f5bc83",
                                                "text": "[…], j’apprenais à goûter l’exquise saveur des chevrettes d’eau douce enveloppées dans des feuilles d’hibiscus et rôties sur des pierres rougies au feu, un mets digne des dieux."
                                            },
                                            {
                                                "example_id": "a4dd2912-962b-4a87-a675-454845297c57",
                                                "sense_id": "33584dd4-1d71-307c-9816-342330f5bc83",
                                                "text": "De l’œuf sort une larve nageante, le miracidium, qui pénètre dans un mollusque gastéropode d’eau douce."
                                            },
                                            {
                                                "example_id": "fc68360a-30ef-41b4-92a8-d8c5343f0560",
                                                "sense_id": "33584dd4-1d71-307c-9816-342330f5bc83",
                                                "text": "Les terrains d'origine organique sont phytogènes: exemples, les forêts submergées dans les eaux douces ou salées, les tourbes, l’humus; ou zoogènes, comme les terrains de polypiers, de madrépores, de coraux."
                                            },
                                            {
                                                "example_id": "57cbe87b-d9d3-4cce-9bef-89436390f922",
                                                "sense_id": "33584dd4-1d71-307c-9816-342330f5bc83",
                                                "text": "C’étaient des poissonnières ; l’aînée était superbe ; la petite, qui vendait du poisson d’eau douce, ressemblait à une vierge de Murillo, toute blonde, pieds et orteils nus au milieu de ses carpes et de ses anguilles."
                                            },
                                            {
                                                "example_id": "0e33238d-3ee8-40b9-baed-229d9763cdbf",
                                                "sense_id": "33584dd4-1d71-307c-9816-342330f5bc83",
                                                "text": "Le manque d’eau douce multiplierait les ravages de l’alcoolisme ; l’eau de pluie, recueillie dans des citernes, ne suffirait pas aux besoins de la population. L’inondation ne fertiliserait plus le sol. Elle n’envahirait plus Paris. On ne pourrait plus espérer revoir, comme au beau temps de 1910, le facteur distribuer le courrier en périssoire dans les boîtes de la rue Jacob."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acdf38d0-f9bb-3b79-8aa3-95b22b21562c",
                                        "entry_id": "82b25e4f-4cb1-31ba-8ac1-88b281a60221",
                                        "glosses": [
                                            "Ensemble des lacs, étangs, ruisseaux, fleuves, qui contiennent cette eau."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "320000e2-0aac-42a2-b07e-114eaacea6ba",
                                                "sense_id": "acdf38d0-f9bb-3b79-8aa3-95b22b21562c",
                                                "text": "D’un autre côté, Réaumur et ses émules interrogèrent les eaux douces, et les bryozoaires de nos étangs, les planaires et les nais de nos ruisseaux, les vers de terre eux-mêmes se montrèrent à divers degrés insensibles à des mutilations qui ne faisaient que les multiplier."
                                            },
                                            {
                                                "example_id": "b0dcea09-e722-4089-bf7f-5843dd1bee41",
                                                "sense_id": "acdf38d0-f9bb-3b79-8aa3-95b22b21562c",
                                                "text": "Comme type biologique, les Palétuviers, peuplant les eaux saumâtres à salinité variable au cours de la journée, sont exactement comparables à l’hélophytie, ou hélostadion des eaux douces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeeca679-002a-38d5-91ae-10303df31381",
                                        "entry_id": "82b25e4f-4cb1-31ba-8ac1-88b281a60221",
                                        "glosses": [
                                            "Eau contenant peu d’ions calcium et magnésium, en particulier dont le titre hydrotimétrique est compris entre 10 et 20°f."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7136ebea-b981-4592-95aa-b26a92d1b51e",
                                                "sense_id": "aeeca679-002a-38d5-91ae-10303df31381",
                                                "text": "L’eau douce, au contact du savon donne au toucher une impression onctueuse, tandis que l’eau dure est rêche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
