                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "ввяза́вшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "375c2ea1-5790-31ef-9c4d-894ac2c6bfe6",
                        "entry_id": "a2ab4a36-62a8-361b-9e45-746f7116c1f3",
                        "glosses": [
                            "вязанием соединиться с чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa247da5-8f3d-40f0-ae31-27e4ea2aa75a",
                                "sense_id": "375c2ea1-5790-31ef-9c4d-894ac2c6bfe6",
                                "text": "Для оригинальности в носок ввязалась красная полоска."
                            }
                        ]
                    },
                    {
                        "sense_id": "578947fc-f9e5-3e81-b31e-82f0a4260ef1",
                        "entry_id": "a2ab4a36-62a8-361b-9e45-746f7116c1f3",
                        "glosses": [
                            "перен., разг. вмешаться, впутаться во что-либо (обычно предосудительное или нежелательное) намеренно или помимо своего желания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35b2f4e1-d646-4b30-83fd-77eca982661c",
                                "sense_id": "578947fc-f9e5-3e81-b31e-82f0a4260ef1",
                                "text": "Диомид поехал не из-за денег, для него всё равно, что четыре, что восемь рублей, но, чтобы ввязаться в разговор, он считает нужным поддакнуть."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae7e283f-9071-4ca7-9467-78c863122219",
                        "source_entry_id": "a2ab4a36-62a8-361b-9e45-746f7116c1f3",
                        "source_sense_description": "вмешаться, впутаться",
                        "target_lang_word": "se mêler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se mêler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d245fb95-e4ac-355f-a245-679646d6e6f9",
                                        "entry_id": "399719c3-cb7e-33f5-aa65-f8843db186dd",
                                        "glosses": [
                                            "Devenir moins pur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db8d6c2-cd8f-4666-8a79-bd0107d2edd6",
                                                "sense_id": "d245fb95-e4ac-355f-a245-679646d6e6f9",
                                                "text": "Cette race s’était mêlée et avait perdu beaucoup de sa pureté."
                                            },
                                            {
                                                "example_id": "b9472e33-2299-47d8-8578-93ff4c2e84fa",
                                                "sense_id": "d245fb95-e4ac-355f-a245-679646d6e6f9",
                                                "text": "Les étrangers envahissaient le Sénat ; le sang romain se mêlait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10566951-bfc6-3d9a-bf3b-8535bd8bfb2b",
                                        "entry_id": "399719c3-cb7e-33f5-aa65-f8843db186dd",
                                        "glosses": [
                                            "Participer à une chose, intervenir dans une affaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf0f63b7-eaa0-45f2-919f-024f06a79a4d",
                                                "sense_id": "10566951-bfc6-3d9a-bf3b-8535bd8bfb2b",
                                                "text": "Il a réussi dans toutes les choses dont il s’est mêlé."
                                            },
                                            {
                                                "example_id": "96a98250-8641-43bc-ace2-f80547b530c3",
                                                "sense_id": "10566951-bfc6-3d9a-bf3b-8535bd8bfb2b",
                                                "text": "Mais comment dire à qui vient de vous sauver la vie qu’il se veuille mêler de ce qui le regarde ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc16af89-cce0-30f0-a015-f2a05e8c3261",
                                        "entry_id": "399719c3-cb7e-33f5-aa65-f8843db186dd",
                                        "glosses": [
                                            ","
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "534049db-f81d-4603-b594-9b7d9a3fee11",
                                                "sense_id": "fc16af89-cce0-30f0-a015-f2a05e8c3261",
                                                "text": "Il se mêle de politique et n’y entend rien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1978d232-7872-3917-9d05-6553897aeee6",
                                        "entry_id": "399719c3-cb7e-33f5-aa65-f8843db186dd",
                                        "glosses": [
                                            "…"
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "057d9680-be7e-4095-a95a-f089304e1115",
                                                "sense_id": "1978d232-7872-3917-9d05-6553897aeee6",
                                                "text": "Cette affaire se fera, à moins que le diable ne s’ en mêle, si le diable ne s’ en mêle : Cette affaire se fera malgré tous les obstacles."
                                            },
                                            {
                                                "example_id": "d1e4cbc6-e0c9-410b-ab3b-94cc7b4ff74b",
                                                "sense_id": "1978d232-7872-3917-9d05-6553897aeee6",
                                                "text": "Cette affaire ne se fera pas, à moins, etc., Il est presque impossible que cette affaire réussisse."
                                            },
                                            {
                                                "example_id": "5752a1ef-7dc1-4362-b912-0e5783918d6f",
                                                "sense_id": "1978d232-7872-3917-9d05-6553897aeee6",
                                                "text": "Se mêler d’une chose : S’occuper d’une chose étrangère à sa profession, à ses habitudes, à ses talents, à ses affaires."
                                            },
                                            {
                                                "example_id": "b7d90e18-ad2c-40e0-b95a-b7aac395a35e",
                                                "sense_id": "1978d232-7872-3917-9d05-6553897aeee6",
                                                "text": "Il est médecin, et il se mêle d’astronomie."
                                            },
                                            {
                                                "example_id": "6e23cc21-0862-4669-b8b2-ef4a4ed315b7",
                                                "sense_id": "1978d232-7872-3917-9d05-6553897aeee6",
                                                "text": "C’est un littérateur, et il se mêle de donner des conseils aux généraux."
                                            },
                                            {
                                                "example_id": "03ab5319-f496-47ba-90cb-06c2daa10677",
                                                "sense_id": "1978d232-7872-3917-9d05-6553897aeee6",
                                                "text": "Quand ce bon homme se mêle de railler, il est plus malin que personne."
                                            },
                                            {
                                                "example_id": "54bbc015-2564-40d1-9910-6707dde53dcf",
                                                "sense_id": "1978d232-7872-3917-9d05-6553897aeee6",
