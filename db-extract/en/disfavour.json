                "word": "disfavour",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "af91b47a-6889-4982-b4ac-c5b02beb0f17",
                        "entry_id": "6d32e33b-e63d-3f2a-a84e-70f44df89602",
                        "tags": [
                            "plural"
                        ],
                        "form": "disfavours"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "698a1ae5-c25c-31c1-bb5b-66193f507560",
                        "entry_id": "6d32e33b-e63d-3f2a-a84e-70f44df89602",
                        "glosses": [
                            "Lack of favour; displeasure."
                        ],
                        "tags": [
                            "UK",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6d782e84-f118-4b05-9db3-dd38d835332a",
                                "sense_id": "698a1ae5-c25c-31c1-bb5b-66193f507560",
                                "text": "His lateness for the appointment incurred her disfavour."
                            },
                            {
                                "example_id": "73f9ac81-6607-4b62-8fbe-a982c700ecf0",
                                "sense_id": "698a1ae5-c25c-31c1-bb5b-66193f507560",
                                "text": "These same misdeeds have raised a strong sentiment of disfavour against its ally."
                            },
                            {
                                "example_id": "d1c8e073-85de-4821-bbc1-58dc6ea0ca3c",
                                "sense_id": "698a1ae5-c25c-31c1-bb5b-66193f507560",
                                "text": "The ground-breaking work that lesbians and gay men have done in breaking down traditional roles for men and women in couples is given little attention [in this book] and creative sexual arrangements are looked at with subtle disfavor."
                            }
                        ]
                    },
                    {
                        "sense_id": "f05f1e6b-4357-38e6-a623-d350e1c2603a",
                        "entry_id": "6d32e33b-e63d-3f2a-a84e-70f44df89602",
                        "glosses": [
                            "An unkindness; a disobliging act."
                        ],
                        "tags": [
                            "UK",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8a58501a-80c5-485f-b29d-6661bbcbbfd8",
                                "sense_id": "f05f1e6b-4357-38e6-a623-d350e1c2603a",
                                "text": "He might dispense favours and disfavours according to his own election."
                            }
                        ]
                    },
                    {
                        "sense_id": "37af8256-fbbe-31c9-8399-77f8e9648aa6",
                        "entry_id": "6d32e33b-e63d-3f2a-a84e-70f44df89602",
                        "glosses": [
                            "A state of being out of favour."
                        ],
                        "tags": [
                            "UK",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2eada750-815d-4a05-8402-65866840b0e1",
                                "sense_id": "37af8256-fbbe-31c9-8399-77f8e9648aa6",
                                "text": "The term “insane asylum” fell into disfavour long ago, but asylum is what some mentally ill people need."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d91675b-b50c-4566-8632-e120efb84b89",
                        "source_entry_id": "6d32e33b-e63d-3f2a-a84e-70f44df89602",
                        "source_sense_description": "the state of being out of favour",
                        "target_lang_word": "défaveur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "défaveur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "728078b8-0a28-316f-a1cf-8f8bd9a0d990",
                                        "entry_id": "2cc36fd4-a0da-307c-9c22-ee16af1fc902",
                                        "glosses": [
                                            "Cessation de faveur, disgrâce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a831ba61-b3d4-42fe-99c5-8674ab2336e3",
                                                "sense_id": "728078b8-0a28-316f-a1cf-8f8bd9a0d990",
                                                "text": "Il est tombé dans une cruelle défaveur."
                                            },
                                            {
                                                "example_id": "f9a2937d-f955-467f-bfb0-ed52eb665acc",
                                                "sense_id": "728078b8-0a28-316f-a1cf-8f8bd9a0d990",
                                                "text": "Il est en défaveur."
                                            },
                                            {
                                                "example_id": "05d9ed40-e509-40ce-b140-5acf3812e4e2",
                                                "sense_id": "728078b8-0a28-316f-a1cf-8f8bd9a0d990",
                                                "text": "Plus des deux tiers ne dépassèrent pas cinquante dollars, témoignant avec une vigueur manifeste de la défaveur dans laquelle ce genre de peinture était tombé depuis le début du siècle."
                                            },
                                            {
                                                "example_id": "a6fe05b4-3301-480c-90aa-c2480d0c9143",
                                                "sense_id": "728078b8-0a28-316f-a1cf-8f8bd9a0d990",
                                                "text": "Or il se produit quelque chose qui se produit généralement dans toutes les armées du monde, c’est le piston, pas en ma faveur, mais en ma défaveur, et cette défaveur va me faire rester en Algérie."
                                            },
                                            {
                                                "example_id": "1d1c5dd4-7bd0-4b94-95fe-fb35ccfc73cc",
                                                "sense_id": "728078b8-0a28-316f-a1cf-8f8bd9a0d990",
                                                "text": "La balance du pouvoir au sein du Parti conservateur du Canada (PCC) penchera dorénavant en défaveur des provinces comme le Québec, quand viendra le temps de choisir le prochain chef."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2daea4be-f734-43bc-afe7-46bf5d75c712",
                        "source_entry_id": "6d32e33b-e63d-3f2a-a84e-70f44df89602",
