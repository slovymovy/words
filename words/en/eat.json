                    "sense_definition": "To perform exceptionally well; to be very impressive or successful.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your outfit for the party tonight absolutely <w>eats</w>!",
