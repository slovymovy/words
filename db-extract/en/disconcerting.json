                                            {
                                                "example_id": "326dfee7-f783-417a-b7c9-94f2e612cf0c",
                                                "sense_id": "10f89554-ed17-3661-b2c0-618360ea8da9",
                                                "text": "Une atmosphère pesante et troublante régnait encore entre les murs aux boiseries sévères, sous le plafond à écussons […]."
                                            },
                                            {
                                                "example_id": "3416b20b-ce9a-4f11-97af-2b10ee0dd802",
                                                "sense_id": "10f89554-ed17-3661-b2c0-618360ea8da9",
                                                "text": "— Je le sentais inquiet, troublé. Donzac dit que je suis troublant au sens absolu. Pas toujours. Mais je l’étais ce jour-là."
                                            },
                                            {
                                                "example_id": "45d03593-0bb0-4f5b-9ff4-b955bbdbbfde",
                                                "sense_id": "10f89554-ed17-3661-b2c0-618360ea8da9",
                                                "text": "Certaines thèses avancées par les théoriciens du complot font appel à de nombreux faits troublants que seules de laborieuses analyses poussées pourraient clairement réfuter."
                                            }
                                        ]
                                    }
                                ]
                            },
