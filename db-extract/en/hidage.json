                            {
                                "example_id": "e634e63f-556f-44eb-bd90-45377549be4a",
                                "sense_id": "0547eead-dbce-34a2-b7ad-14bc8644d5ce",
                                "text": "1898, Hannis Taylor, The Origin and Growth of the English Constitution, Part 2: The After-growth of the Constitution,\nIn the case of the towns, to which the reckoning by hides could not be applied, the Danegeld or hidage was probably compounded for, and such composition represents no doubt the later talliage.⁴ In the ninth year of Henry II. the Danegeld as such finally disappeared from the Rolls, but only to reappear as aid or hidage, and in the reign of Richard I. as carucage."
                            },
                            {
                                "example_id": "ff4e37c7-3568-4c7f-8869-f6d1dda3db05",
                                "sense_id": "0547eead-dbce-34a2-b7ad-14bc8644d5ce",
                                "text": "What seems to have been a still later addition gives the hidages of Worcestershire and Warwickshire."
                            },
                            {
                                "example_id": "c720db15-80bb-4926-a98e-f3a1b5016aaf",
                                "sense_id": "0547eead-dbce-34a2-b7ad-14bc8644d5ce",
                                "text": "The moment has now come when we may tender in evidence an ancient document which professes to state the hidage of certain districts."
                            }
                        ]
                    },
                    {
