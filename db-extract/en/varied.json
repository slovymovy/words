                "translations": [
                    {
                        "translation_id": "ba234aee-d4fa-4194-a8f8-1f7005cb93ad",
                        "source_entry_id": "ad5cd6d2-31e6-3267-9081-acce787b01fa",
                        "source_sense_description": "diverse or miscellaneous",
                        "target_lang_word": "vielfältig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vielfältig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bac3c0b6-7b99-3d41-865c-30a8d7618f44",
                                        "entry_id": "4703e92f-ce1e-30a3-8eab-4b0eca99d9f3",
                                        "glosses": [
                                            "in verschiedenen Arten und Weisen, mit vielen Seiten, vielen Aspekten, vielen Facetten, vielen Varianten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "239f24ca-944c-4af8-a85d-56a30add9c13",
                                                "sense_id": "bac3c0b6-7b99-3d41-865c-30a8d7618f44",
                                                "text": "„Ganztagsschulen, in denen Kinder vielfältige Lernerfahrungen sammeln, Phasen der An- und Entspannung erleben, mit ihren Mitschüler sozial interagieren können, seien eine geeignete Form, die Folgen der demografischen Entwicklung abzufedern.“"
                                            },
                                            {
                                                "example_id": "1d406064-bba8-44a4-9ef3-676d237ea847",
                                                "sense_id": "bac3c0b6-7b99-3d41-865c-30a8d7618f44",
                                                "text": "„Das Material erlaubt aber in jedem Falle mehr als eine Deutung oder enthält mehr als ein Bewertungskriterium, ist also mehrdimensional und mehrperspektivisch angelegt und enthält eindeutige aber vielfältige Schlussfolgerungen.“"
                                            },
                                            {
                                                "example_id": "fc5d667f-09db-4e14-aa0a-068076fb956d",
                                                "sense_id": "bac3c0b6-7b99-3d41-865c-30a8d7618f44",
                                                "text": "„Bergerlebnisse im Zillertal lassen sich auf vielfältige Weise zelebrieren. Beispielsweise beim Klettern, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edd1c503-674e-4f05-898f-7bc40e3c33d8",
                        "source_entry_id": "ad5cd6d2-31e6-3267-9081-acce787b01fa",
                        "source_sense_description": "diverse or miscellaneous",
                        "target_lang_word": "abwechslungsreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abwechslungsreich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53ae7c7f-d228-33ce-882b-6de2683a7ba4",
                                        "entry_id": "a55d0f7e-39ba-3f45-8d28-ae23e0dace6b",
                                        "glosses": [
                                            "durch Abwechslung gekennzeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "008349ad-df90-42c6-a364-f03627f21edb",
                                                "sense_id": "53ae7c7f-d228-33ce-882b-6de2683a7ba4",
                                                "text": "Er hat ein abwechslungsreiches Leben geführt."
                                            },
                                            {
                                                "example_id": "fef69553-feae-48ca-86ab-2a2bb872ab6b",
                                                "sense_id": "53ae7c7f-d228-33ce-882b-6de2683a7ba4",
                                                "text": "Der Arzt riet ihm eine abwechslungsreiche Ernährung."
                                            },
                                            {
                                                "example_id": "1d9da67f-b268-4805-b80f-decef4876796",
                                                "sense_id": "53ae7c7f-d228-33ce-882b-6de2683a7ba4",
                                                "text": "Das Fußballspiel verlief sehr abwechslungsreich."
                                            },
                                            {
                                                "example_id": "94d3c988-550b-4756-ad0f-2be8b2050395",
                                                "sense_id": "53ae7c7f-d228-33ce-882b-6de2683a7ba4",
                                                "text": "„Seine Musik ist so abwechslungsreich und ausdrucksstark,“ sagt Assistant Principal Hornist Bennert Ohlson."
                                            },
                                            {
                                                "example_id": "bba2df77-c7bc-44bb-ac03-814e613abded",
                                                "sense_id": "53ae7c7f-d228-33ce-882b-6de2683a7ba4",
                                                "text": "In seinem wunderbar abwechslungsreich illustrierten Jugendbuch vermittelt der Welterklärer Richard Dawkins den aktuellen Wissensstand über den Urknall, den Aufbau der Materie sowie die Entstehung der Arten."
                                            },
                                            {
                                                "example_id": "0925691b-9d81-4db3-982f-3085ca5d9f9a",
                                                "sense_id": "53ae7c7f-d228-33ce-882b-6de2683a7ba4",
                                                "text": "„Die Luft war herrlich, die Landschaft abwechslungsreich, nirgendwo konnte Otto sich die drei Jahre Gefangenschaft besser aus dem Leib laufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
