                        "entry_id": "671acc71-8c18-356b-a6f5-e965c613da68",
                        "glosses": [
                            "Modular object-oriented dynamic learning environment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af22be5f-cee8-439a-9783-ab8ea6ec7118",
                                "sense_id": "59bd8dbd-2b80-35b3-aecc-bed4cd25f1f7",
                                "text": "Many Moodles exist throughout the education sector."
                            },
                            {
                                "example_id": "15154715-7043-4eab-b26e-94af270412c6",
                                "sense_id": "59bd8dbd-2b80-35b3-aecc-bed4cd25f1f7",
                                "text": "Moodles are relatively new Web 2.0 tools, thus there is not an abundance of empirical research regarding them."
                            },
                            {
                                "example_id": "96912fba-9bf6-4f0c-b7bc-83b22c55e002",
                                "sense_id": "59bd8dbd-2b80-35b3-aecc-bed4cd25f1f7",
                                "text": "Interviewee C did a one-hour lecture to introduce the DGBL topic using Moodles – a blind learning approach."
                            }
                        ]
                    }
                ],
