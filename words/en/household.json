                        ],
                        "tr": [
                            {
                                "target_lang_word": "herkesçe bilinen",
                                "target_lang_sense_clarification": "herkes tarafından tanınan"
                            },
                            {
                                "target_lang_word": "yaygın bilinen",
                                "target_lang_sense_clarification": "bilinen, tanınan isim veya marka"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "家喻户晓",
                                "target_lang_sense_clarification": "形容人或事物非常出名"
                            }
                        ]
                    }
                }
            ]
        },
