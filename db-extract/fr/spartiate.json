            {
                "entry_id": "e58fa536-f3fa-3d47-a58d-eebe65b1b006",
                "word": "Spartiate",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ea754366-4a73-4dd4-818f-0403bacb10f9",
                        "entry_id": "e58fa536-f3fa-3d47-a58d-eebe65b1b006",
