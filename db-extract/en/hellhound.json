                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a7220561-b804-4733-99f4-ed4fec65519a",
                        "entry_id": "3cf7d431-2c1d-38ad-ae69-d9385590151e",
                        "tags": [
                            "plural"
                        ],
                        "form": "hellhounds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "477cc231-d568-3e73-9a80-36faf6a26832",
                        "entry_id": "3cf7d431-2c1d-38ad-ae69-d9385590151e",
                        "glosses": [
                            "A demonic dog of hell, typically of unnatural size, strength or speed, with black fur, glowing eyes, and ghostly or phantom characteristics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48d72651-b471-4172-b984-b3b209c0c648",
                                "sense_id": "477cc231-d568-3e73-9a80-36faf6a26832",
                                "text": "From forth the kennell of thy wombe hath crept / A Hell-hound that doth hunt vs all to death:"
                            },
                            {
                                "example_id": "1bbed472-6cac-4479-872f-214f21dedd9e",
                                "sense_id": "477cc231-d568-3e73-9a80-36faf6a26832",
                                "text": "Barricading serves not: fly fast, ye Bodyguards; rabid Insurrection, like the hellhound Chase, uproaring at your heels!"
                            }
                        ]
                    },
                    {
                        "sense_id": "f52b4271-bd80-39ce-a512-5f2989200760",
                        "entry_id": "3cf7d431-2c1d-38ad-ae69-d9385590151e",
                        "glosses": [
                            "An evil or otherwise unpleasant person."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e35b48d8-9348-41d4-b058-db035cb96369",
                        "source_entry_id": "3cf7d431-2c1d-38ad-ae69-d9385590151e",
                        "source_sense_description": "dog of hell",
                        "target_lang_word": "Höllenhund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Höllenhund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                        "entry_id": "2e64fb50-de8b-3e84-a13a-2f0b08f3727d",
                                        "glosses": [
                                            "bösartiger, höllischer Hund"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e1bbc76-af9a-496e-b642-567bda7a01a2",
                                                "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                                "text": "„Unter meiner Obhut verwandelte sich der Höllenhund, der er vorher war, in einen kleinen Welpen.“"
                                            },
                                            {
                                                "example_id": "e27641bd-d8c8-4d4d-aca2-25aab4dba8ef",
                                                "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                                "text": "„Sie kletterten abwärts; der runzlige Hexenmeister, der Höllenhund und der Mann Gottes stiegen in die Schwärze des Lochs hinab.“"
                                            },
                                            {
                                                "example_id": "5cc70fd9-a270-481d-9495-7239ce7cbcad",
                                                "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                                "text": "„›Und Madison wusste, wenn sie ihre teuflische Mission totaler Verdammnis nicht konsequent zum Abschluss brächte, würden Satans Höllenhunde demnächst ihr hilfloses Kätzchen aufspüren und an seiner Haut Verträglichkeitstests für ein neues Damenhygienespray vornehmen!‹“"
                                            },
                                            {
                                                "example_id": "6d9e6a0a-174d-4a98-b9b4-d006dd91e012",
                                                "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                                "text": "„Aber die Höllenhunde passen auch durch das Öhr eines Rings.“"
                                            },
                                            {
                                                "example_id": "66ff04d0-45ac-44bc-96fd-8c3cfd2e9d23",
                                                "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                                "text": "„Sie sehen wie echte Höllenhunde aus, die niemand streicheln will.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
