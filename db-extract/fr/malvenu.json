                        ]
                    },
                    {
                        "sense_id": "8fad9cdc-9286-38eb-9ab8-fa965bcfbcb8",
                        "entry_id": "414e489f-6534-34c3-83e8-8d31c29fb7a1",
                        "glosses": [
                            "Qui n’a pas de motif pour faire une chose."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9011c2f8-15c4-480c-9720-963a3838fcd8",
                                "sense_id": "8fad9cdc-9286-38eb-9ab8-fa965bcfbcb8",
                                "text": "Il est malvenu à se plaindre."
                            },
                            {
                                "example_id": "b385d9e7-86ae-49ac-99c6-973ca18f620e",
                                "sense_id": "8fad9cdc-9286-38eb-9ab8-fa965bcfbcb8",
                                "text": "Il est mal venu à lui reprocher cette action quand c’est lui-même qui la lui a conseillée."
                            }
                        ]
                    },
                    {
                        "sense_id": "b81f59c2-fd6a-31f4-904e-ee0d0ff0c14b",
                        "entry_id": "414e489f-6534-34c3-83e8-8d31c29fb7a1",
                        "glosses": [
                            "Qui n’a pas de raison d’être."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2dcc841e-3cab-457a-9841-e8690595b6cb",
                                "sense_id": "b81f59c2-fd6a-31f4-904e-ee0d0ff0c14b",
                                "text": "Cette proposition a été jugée malvenue."
                            }
                        ]
                    },
                    {
                        "sense_id": "01b43638-27ea-3c97-9739-26a99d4ebe00",
                        "entry_id": "414e489f-6534-34c3-83e8-8d31c29fb7a1",
                        "glosses": [
                            "Qui vient mal à propos."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "7f3b05c7-b55d-4158-aef7-f2dc63762120",
                                "sense_id": "01b43638-27ea-3c97-9739-26a99d4ebe00",
                                "text": "Dans le sillage de celui du blé, le cours du maïs est resté positif, soutenu aussi par des pluies malvenues dans l’Ouest qui ont ralenti quelque peu la récolte dans la région."
                            }
                        ]
                    }
