                            {
                                "example_id": "090501fb-9a19-48b5-ba5e-4b1b4b15a06f",
                                "sense_id": "ec590f6c-44cf-3088-bb4b-27303cc286e6",
                                "text": "Niet een Vlaamse stad, maar een foto van Amsterdam prijkt op de cover van een brochure van de Vlaamse overheid. Op het voorblad van de publicatie ’Vlaanderen in cijfers’ zijn fietsers in de hoofdstedelijke Runstraat afgebeeld."
                            }
                        ]
                    },
