                    {
                        "translation_id": "ec1136c8-7ffb-4c0f-a77e-f72857234cc5",
                        "source_entry_id": "f7d40d9f-f69f-3f19-a059-07eb6b3bac63",
                        "source_sense_id": "64afcca3-477b-3b1e-85e2-df57974965c6",
                        "source_sense_description": "kurzes Computerspiel innerhalb eines anderen Spiels",
                        "target_lang_word": "subgame",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subgame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbb4b719-c74d-3e93-9331-c66e727b3aa2",
                                        "entry_id": "8f1d1b02-4702-35b1-8b2f-a7c563ee5883",
                                        "glosses": [
                                            "A subset of a game that can be considered a game in its own right."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "970f29f8-aa48-4951-95d7-2b88120652b9",
                                                "sense_id": "bbb4b719-c74d-3e93-9331-c66e727b3aa2",
                                                "text": "A subgame is a piece of a game—the piece that remains to be played beginning at any point at which the complete history of the game thus far is common knowledge among the players."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e974c0a-ebda-3756-b74c-1749bcc9b4c1",
                                        "entry_id": "8f1d1b02-4702-35b1-8b2f-a7c563ee5883",
                                        "glosses": [
                                            "A minor or incidental game within a larger video game; a minigame."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "813c6e73-5d27-4940-bc0a-91446c955200",
                                                "sense_id": "5e974c0a-ebda-3756-b74c-1749bcc9b4c1",
                                                "text": "There was a subgame that was very well-recieved ^([sic]) in the previous Paper Mario RPG [Paper Mario: The Thousand-Year Door], where you would play through this side-scrolling stage as a gigantic Bowser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ed48554-45f1-43fd-94e2-1569a6445922",
                        "source_entry_id": "f7d40d9f-f69f-3f19-a059-07eb6b3bac63",
                        "source_sense_id": "64afcca3-477b-3b1e-85e2-df57974965c6",
                        "source_sense_description": "kurzes Computerspiel innerhalb eines anderen Spiels",
                        "target_lang_word": "mini-jeu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mini-jeu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bcb9e186-eacb-340c-bd13-c3dffdd8ae44",
                                        "entry_id": "db7cb20c-b91e-3020-8436-0b8db44a7785",
                                        "glosses": [
                                            "Petite activité ludique ou sportive durant un événement ou festival plus important."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51b0dac9-4fef-4356-93f6-e463ec3f2e27",
                                                "sense_id": "bcb9e186-eacb-340c-bd13-c3dffdd8ae44",
                                                "text": "Ce sont les élèves de l’école hôtesse qui mettent sur pied des mini-jeux franco-ontariens dans les écoles primaires locales pour promouvoir le festival et contribuer à l’animation culturelle chez les plus jeunes."
                                            },
                                            {
                                                "example_id": "bfc560bc-44f0-4248-93ac-1e30b8687065",
                                                "sense_id": "bcb9e186-eacb-340c-bd13-c3dffdd8ae44",
                                                "text": "Le chamboule-tout est un des mini-jeux favori des enfants durant la kermesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a87919c-8e15-33ed-b652-8daaeaa77432",
                                        "entry_id": "db7cb20c-b91e-3020-8436-0b8db44a7785",
                                        "glosses": [
                                            "Jeu annexe très bref ou accessoire inclut dans la quête principale d’un jeu vidéo."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5831d910-2f6a-4d77-95e3-28a28794336a",
                                                "sense_id": "8a87919c-8e15-33ed-b652-8daaeaa77432",
                                                "text": "Il est important d’agrémenter la quête principale d’épreuves ou de mini-jeux facultatifs."
                                            },
                                            {
                                                "example_id": "8352450e-e4ca-4a8e-ad32-24843470b563",
                                                "sense_id": "8a87919c-8e15-33ed-b652-8daaeaa77432",
                                                "text": "Il n’est pas rare qu’un jeu vidéo standard inclut deux ou trois mini-jeux en son sein."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf70daed-f827-3476-8244-8f2c8df1a7b5",
                                        "entry_id": "db7cb20c-b91e-3020-8436-0b8db44a7785",
                                        "glosses": [
                                            "Divers jeux très brefs sans récits et sans quêtes principales se caractérisant par une succession de partie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0694c837-5cf8-4883-8cea-487f01d904d9",
                                                "sense_id": "cf70daed-f827-3476-8244-8f2c8df1a7b5",
                                                "text": "Dans les jeux de puzzle, les énigmes multipliées prennent la plupart du temps la forme d’une suite de mini-jeux."
                                            },
                                            {
                                                "example_id": "6ea7891f-0c4b-488e-a6c6-be0252689c6c",
                                                "sense_id": "cf70daed-f827-3476-8244-8f2c8df1a7b5",
                                                "text": "Avec le succès d’internet et des smartphones le nombre de mini-jeux s’est fortement accrus depuis leur apparition."
                                            },
                                            {
                                                "example_id": "1d9fefbe-f2e0-4009-a217-83c0c4c5efaa",
                                                "sense_id": "cf70daed-f827-3476-8244-8f2c8df1a7b5",
                                                "text": "Sur TikTok, une créatrice spécialisée en réalité augmentée a conçu, il y a quelques jours, un mini-jeu permettant de soutenir discrètement la Palestine, relate le HuffPost."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b4f2930-3f91-4f29-a9dc-6712dd61fc6c",
                        "source_entry_id": "f7d40d9f-f69f-3f19-a059-07eb6b3bac63",
