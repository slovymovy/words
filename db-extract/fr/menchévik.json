                ],
                "senses": [
                    {
                        "sense_id": "2e43d412-8151-3b71-9734-daba16c612ac",
                        "entry_id": "165d3d52-619f-35e7-9089-d40b4f7b172c",
                        "glosses": [
                            "Membre de la fraction modérée du Parti social-démocrate russe, peu avant la révolution de 1917."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c173e349-0a22-404e-a340-ff0a2d57afd2",
                                "sense_id": "2e43d412-8151-3b71-9734-daba16c612ac",
                                "text": "Au IIᵉ Congrès du Parti social-démocrate russe, la scission venait de se marquer nettement, sur l’initiative de Lénine, entre bolchéviks et menchéviks."
                            },
                            {
                                "example_id": "1710fbb3-adce-415a-9c94-c95512744493",
                                "sense_id": "2e43d412-8151-3b71-9734-daba16c612ac",
                                "text": "[…] 1903 marque une date historique : celle de la scission du parti socialdémocrate russe en bolchéviks (majoritaires) et menchéviks (minoritaires) à son IIᵉ congrès qui débuta à Bruxelles puis siégea longuement à Londres, dans l’atmosphère d’une fin d’empire."
                            },
                            {
                                "example_id": "e73718f0-bf54-47ef-8489-b8b03da8d89c",
                                "sense_id": "2e43d412-8151-3b71-9734-daba16c612ac",
                                "text": "Probablement un menchévik, suggéra le maillot bleu. Avec l’âge, ils deviennent tous gâteux. Ils lisent le journal et ils se figurent que c’est d’eux qu’on y parle."
                            }
                        ]
                    }
