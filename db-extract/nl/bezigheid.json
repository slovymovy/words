                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bca0fd0c-3879-4b1d-8ad5-0923b8b919ac",
                                "sense_id": "bf555bf6-81a2-3514-95db-f3e4507b8d75",
                                "text": "De dokter stopte met zijn bezigheden toen hij plotseling het alarm hoorde afgaan."
                            },
                            {
                                "example_id": "b869077c-bd95-4621-b36f-4312e8268fc9",
                                "sense_id": "bf555bf6-81a2-3514-95db-f3e4507b8d75",
                                "text": "Vanzelfsprekend was dat niet de verstandigste bezigheid op een hoogte van 4000 meter, vol in de zon, maar er was maar één dag per jaar om net zo naakt als Adam door het paradijs te wandelen en dat wilde ik niet missen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ef51ed6-5aab-4dc0-b360-ee4104e2421e",
                        "source_entry_id": "76a2e7f0-89ee-3333-8240-721bcd3a5019",
                        "source_sense_id": "bf555bf6-81a2-3514-95db-f3e4507b8d75",
                        "source_sense_description": "iets waarmee men bezig is",
                        "target_lang_word": "Aktivität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
