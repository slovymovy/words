                "senses": [
                    {
                        "sense_id": "d59bab40-60cf-3e54-b0db-6041221372bd",
                        "entry_id": "d248be07-b57f-3730-b8cb-7b2b07b5a26f",
                        "glosses": [
                            "To carry offspring in the uterus from conception to delivery."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0bda6696-a412-4761-95a8-840881717835",
                                "sense_id": "d59bab40-60cf-3e54-b0db-6041221372bd",
                                "text": "In the early 1960s, a study was conducted in which gestating rats were given diets containing the same mineral content of mineral salts or amino acid chelates."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f64ba1c-7310-310c-a9f0-eaa6ca57f801",
                        "entry_id": "d248be07-b57f-3730-b8cb-7b2b07b5a26f",
                        "glosses": [
                            "To develop an idea."
                        ],
                        "tags": [
                            "broadly",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1a6cc299-003a-4f77-9a74-76f1ea373be8",
                                "sense_id": "1f64ba1c-7310-310c-a9f0-eaa6ca57f801",
                                "text": "Philip wondered at that five-year gap. Perhaps it simply proved that a work of genius takes longer to gestate than a work of mere competent brilliance."
                            },
                            {
                                "example_id": "fa23c448-0311-41ff-be4e-a8ea0b2a72e9",
                                "sense_id": "1f64ba1c-7310-310c-a9f0-eaa6ca57f801",
                                "text": "Barnett is not currently working on a novel. \"Something is gestating in my head,\" he says, \"but I am not yet sure if I have one character or two.\""
                            }
                        ]
                    }
                ],
                "translations": [
