                ],
                "senses": [
                    {
                        "sense_id": "700460b0-e9f2-311d-bff7-74ca446636b9",
                        "entry_id": "5c113f8e-1cbf-3b21-ae29-504debdade4b",
                        "glosses": [
                            "Blatt einer Birke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98e9b72c-aeb9-4ad7-a786-fc2a4262413f",
                                "sense_id": "700460b0-e9f2-311d-bff7-74ca446636b9",
                                "text": "Die Raupe verspeist das grüne Birkenblatt genüsslich."
                            },
                            {
                                "example_id": "3823b75e-bbd6-4998-93c0-db30f0eb3955",
                                "sense_id": "700460b0-e9f2-311d-bff7-74ca446636b9",
                                "text": "„Endlich im Herbst sammelt man die trockenen Blätter abermals, um die Betten und Polster damit zu stopfen, denn Birkenblätter bilden das einzige Polster, worauf die Letten ruhen.“"
                            },
                            {
                                "example_id": "04a55d23-7271-436f-a9ea-acf46ab09d97",
                                "sense_id": "700460b0-e9f2-311d-bff7-74ca446636b9",
                                "text": "„Birkenblätter enthalten Flavonoide, die die Harnmenge erhöhen und die Durchströmung der Harnwege steigern, sodass es zu einer vermehrten Wasserausscheidung (Aquarese) kommt.“"
                            },
                            {
                                "example_id": "ab55f7c7-61db-4ad9-83f4-96c6e2e5ea1c",
                                "sense_id": "700460b0-e9f2-311d-bff7-74ca446636b9",
                                "text": "„Die tagaktiven Tiere ernähren sich sowohl von Eichen-, Hasel- und Birkenblättern, als auch von Kirsch- und Rosenblüten.“"
                            },
                            {
                                "example_id": "d3bb5593-e7a1-455f-8f8e-021191200690",
                                "sense_id": "700460b0-e9f2-311d-bff7-74ca446636b9",
                                "text": "„Birkenblätter beispielsweise können hervorragend zum Vorbeugen und Behandeln von Schorf bei Obstbäumen eingesetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c804d788-51c9-3876-9c1d-f00d1efbc115",
                        "entry_id": "5c113f8e-1cbf-3b21-ae29-504debdade4b",
                        "glosses": [
                            "Aerophon, das aus dem Bast unter der Birkenrinde hergestellt wird"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "5fafd883-f4f6-4797-8af9-875e80ec011b",
                                "sense_id": "c804d788-51c9-3876-9c1d-f00d1efbc115",
                                "text": "„Bernard zog ein Birkenblatt aus der Tasche und pfiff darauf so laut, daß der schneidende Ton kreischend durch das Thal hinlief und sechsfach wiederhallte.“"
                            },
                            {
                                "example_id": "6795b6c9-3915-4ead-81b0-a0e92a61baea",
                                "sense_id": "c804d788-51c9-3876-9c1d-f00d1efbc115",
                                "text": "„Das Birkenblatt im Munde, ein fröhliches Stückchen darauf spielen…“"
                            },
                            {
                                "example_id": "648ad7a5-3ce7-40d1-9fc0-1741fb47ccd9",
                                "sense_id": "c804d788-51c9-3876-9c1d-f00d1efbc115",
                                "text": "„Das Birkenblatt gehört daher nach der von-Hornborstel-Sachsschen Systematik nicht zu den 'eigentlichen Blasinstrumenten', sondern zu den 'freien Aerophonen'. Innerhalb dieser Gruppe hat es aufgrund der Natur und der Art des Schwingungserregers seinen Platz in den selbstklingenden Unterbrechungsaerophonen mit aufschlagender Zunge einzunehmen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
