                                        "entry_id": "9c9f04a9-7df7-35be-8c9f-e0c7a07130b2",
                                        "glosses": [
                                            "schreibmaschinenähnliches Gerät zur Übermittlung von Textnachrichten mittels elektrischer Signale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42c183e6-09f2-4f9b-8153-6ca0ccc885cd",
                                                "sense_id": "e78599cb-7d6b-377b-8465-88bd4242067f",
                                                "text": "Fernschreiber bestehen aus einer Sendeeinheit und einem Druckwerk."
                                            },
                                            {
                                                "example_id": "44eb830d-d56e-40de-9117-93caf0268d36",
                                                "sense_id": "e78599cb-7d6b-377b-8465-88bd4242067f",
                                                "text": "„Wenn etwas sehr dringend war, gab es ja immer noch den Fernschreiber.“"
                                            },
                                            {
                                                "example_id": "584080a3-5478-4367-970f-3a4def072165",
                                                "sense_id": "e78599cb-7d6b-377b-8465-88bd4242067f",
                                                "text": "„Im aufrichtigen Bemühen, seinem verrückten Sonderführer das Leben zu retten, hatte Oberst Werthe über Fernschreiber einen langen Bericht an Admiral Canaris gesandt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65058713-5f99-3e80-891b-50a4edbbde5a",
                                        "entry_id": "9c9f04a9-7df7-35be-8c9f-e0c7a07130b2",
                                        "glosses": [
                                            "Person, die ein Fernschreibgerät bedient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7550e95b-0933-4400-bcff-d379341f0b70",
                                                "sense_id": "65058713-5f99-3e80-891b-50a4edbbde5a",
                                                "text": "Der Fernschreiber holte neues Papier für seine Maschine."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d852284-cd38-46f2-a18e-94c0489b1b36",
