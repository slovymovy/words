            {
                "entry_id": "658b0c04-a265-3f76-aca7-fcbfa3a27225",
                "word": "non-op",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b7ef243b-3a7f-3989-bbff-26fe71822dbf",
                        "entry_id": "658b0c04-a265-3f76-aca7-fcbfa3a27225",
                        "glosses": [
                            "Personne trans qui n’a pas subi d’opération de réattribution sexuelle."
