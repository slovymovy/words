                ],
                "senses": [
                    {
                        "sense_id": "cde55e5a-cceb-32ed-a25a-562b471f0a97",
                        "entry_id": "2e8fcc63-30e8-3729-87f9-a72304712bd9",
                        "glosses": [
                            "To emit (sweat or perspiration) through the skin's pores."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e63aa9f0-27d4-4418-8bb2-1f4b847bddfa",
                                "sense_id": "cde55e5a-cceb-32ed-a25a-562b471f0a97",
                                "text": "I was perspiring freely after running the marathon."
                            },
                            {
                                "example_id": "1a8f9cce-6656-4038-938f-c594c80aa988",
                                "sense_id": "cde55e5a-cceb-32ed-a25a-562b471f0a97",
                                "text": "He lists forty reasons, mainly metaphorical, why Christ perspired blood, and his peroration takes twenty-two pages in print."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b21f02e-5ace-33f2-b84e-d2def9d1784d",
                        "entry_id": "2e8fcc63-30e8-3729-87f9-a72304712bd9",
                        "glosses": [
                            "To be evacuated or excreted, or to exude, through the pores of the skin."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4cc4bb0a-e548-4ff4-bc81-23d996bf1ad7",
                                "sense_id": "1b21f02e-5ace-33f2-b84e-d2def9d1784d",
                                "text": "A fluid perspires."
                            }
                        ]
                    },
                    {
                        "sense_id": "9453984f-11b7-3a96-84d5-545ce2c81ae7",
                        "entry_id": "2e8fcc63-30e8-3729-87f9-a72304712bd9",
                        "glosses": [
                            "To cause (someone) to sweat."
                        ],
                        "tags": [
                            "ambitransitive",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6a9ff228-ebbb-48d7-83b1-945f42c7874b",
                                "sense_id": "9453984f-11b7-3a96-84d5-545ce2c81ae7",
                                "text": "Outside his window a long, humid summer, the first hot season of the third millennium, baked and perspired."
                            },
                            {
                                "example_id": "45d5128e-f843-4677-b8ea-b20bd8155b0b",
                                "sense_id": "9453984f-11b7-3a96-84d5-545ce2c81ae7",
                                "text": "We shook hands, he looked surprised to see me topless. I stimulated his mind. ¶ “Nice to meet you. My workout jogging perspired me a lot, so I removed the T-shirt.”"
                            }
                        ]
                    }
                ],
