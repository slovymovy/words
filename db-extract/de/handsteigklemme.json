                ],
                "senses": [
                    {
                        "sense_id": "5040cc3e-2c87-3e54-9241-5ef6c13651e1",
                        "entry_id": "028ba5f6-a7b5-3690-8793-40c0965f4884",
                        "glosses": [
                            "in einem Seil eingebautes, per Hand zu bedienendes, in eine Richtung mitlaufendes Gerät für den Klettersport"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7bc2529-90e1-4b89-b84d-44a156819c63",
                                "sense_id": "5040cc3e-2c87-3e54-9241-5ef6c13651e1",
                                "text": "„Die für den Aufstieg am Seil konzipierte ASCENSION -Handsteigklemme verfügt über einen ergonomisch geformten Griff, um den Komfort zu erhöhen und die Effizienz beim Ziehen mit einer oder mit beiden Händen zu verbessern.“"
                            },
                            {
                                "example_id": "3243e15a-c305-4fe0-8fdf-748c0c4eef7a",
                                "sense_id": "5040cc3e-2c87-3e54-9241-5ef6c13651e1",
                                "text": "„Frankreich, 10. März 2006 Beim Aufstieg in einem Schacht, sichert sich der Höhlenforscher auf einer schrägen, rutschigen Fläche nur mittels einer Handsteigklemme.“"
                            },
                            {
                                "example_id": "bcdd8d29-edd1-4008-8262-e60c063f41f9",
                                "sense_id": "5040cc3e-2c87-3e54-9241-5ef6c13651e1",
                                "text": "„Viele Kletterer, die inzwischen Handsteigklemmen am stehenden Seil einsetzen, benutzen diese auch unterstützend für längere Aufstiege am umlaufenden Klettersystem.“"
                            },
                            {
                                "example_id": "d6f20e46-59e2-4d0f-98c7-c077a002f7ac",
                                "sense_id": "5040cc3e-2c87-3e54-9241-5ef6c13651e1",
                                "text": "„Wird zur Sicherung die Handsteigklemme verwendet (z.B. bei Zustiegen mit starkem Gefälle oder bei Quergängen), muss das Seil auch in den Karabiner der Handsteigklemme eingehängt werden (siehe Abbildung: Sichern mit Handsteigklemme), um im Falle eines Sturzes ein Verdrehen der Klemme im Seil zu verhindern.“"
                            },
                            {
                                "example_id": "35a83722-3ae6-469b-8241-d08669c7e070",
                                "sense_id": "5040cc3e-2c87-3e54-9241-5ef6c13651e1",
                                "text": "„Bei der Handsteigklemme handelt es sich um eine Steigklemme mit Griff, an der eine Fußschlinge befestigt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
