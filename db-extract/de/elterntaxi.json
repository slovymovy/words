                ],
                "senses": [
                    {
                        "sense_id": "e008f754-2765-386d-99ef-11348ea8ec89",
                        "entry_id": "18e9d291-3b22-325b-b6bd-687dfb9dfe74",
                        "glosses": [
                            "Fahrzeug, mit dem Eltern ihre Kinder zu Bestimmungsorten transportieren beziehungsweise Fahrt als bequemer Elterntransport"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "803a17ca-3b5c-4a5c-94d4-1ddd0ebf4f06",
                                "sense_id": "e008f754-2765-386d-99ef-11348ea8ec89",
                                "text": "„Vor Deutschlands Schulen jeden Morgen das gleiche Bild: Von den Rückbänken der Elterntaxis stolpern müde Kinder mit großen Rucksäcken und trotten Richtung Klassenzimmer. Erst im Unterricht wachen viele richtig auf.“"
                            },
                            {
                                "example_id": "af7030a1-d618-4980-a3a4-4a87b5922865",
                                "sense_id": "e008f754-2765-386d-99ef-11348ea8ec89",
                                "text": "„Auf dem Weg zu einer eigenständigen und verantwortungsvollen Mobilität ist es daher nicht sinnvoll, Kinder mit dem Elterntaxi zur Schule zu bringen.“"
                            },
                            {
                                "example_id": "e8e1ef8b-e558-4f16-aee0-5f939db107a6",
                                "sense_id": "e008f754-2765-386d-99ef-11348ea8ec89",
                                "text": "„Wenn Kinder auf Alltagswegen zu Fuß gehen, Roller fahren oder mit dem Rad unterwegs sind, statt im Elterntaxi zu sitzen, ist das gut für ihre Gesundheit und gut für die Luft.“"
                            },
                            {
                                "example_id": "d0110e0a-9201-49ad-8cd7-a7f2be6d9036",
                                "sense_id": "e008f754-2765-386d-99ef-11348ea8ec89",
                                "text": "„Die meisten Unfälle davon sind Unfälle im Auto ihrer Eltern - in den sogenannten Elterntaxis, sagte Sprecherin Sabine Longerich. Elterntaxis vermittelten nur eine trügerische Sicherheit.“"
                            },
                            {
                                "example_id": "22cb592a-cb0b-4108-af27-55e649ba8025",
                                "sense_id": "e008f754-2765-386d-99ef-11348ea8ec89",
                                "text": "„Ob nun zu Fuß, mit dem Roller oder auf dem Fahrrad - bis zum 28. September wollen bundesweit 60 000 Kinder aus mehr als 2000 Schulklassen bei den Aktionstagen bewusst ohne Elterntaxi zur Schule kommen, teilten die Organisatoren mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
