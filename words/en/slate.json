{
    "word_family": [
        "slater",
        "slaty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6a48b90-18ec-3dad-ae23-8a70dd41aae1",
                    "sense_definition": "A fine-grained grey rock formed from clay or ash that splits easily into thin layers, often used for roofing tiles.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old cottage has a roof made of heavy grey <w>slate</w>.",
                            "target_lang_translations": {
                                "ru": "У старого коттеджа крыша сделана из тяжелого серого <w>сланца</w>.",
                                "zh": "这座老农舍的屋顶是用沉重的灰色<w>板岩</w>铺成的。"
                            }
                        },
                        {
                            "text": "Geologists found a large deposit of <w>slate</w> near the quarry.",
                            "target_lang_translations": {
                                "ru": "Геологи обнаружили крупное месторождение <w>сланца</w> возле карьера.",
                                "zh": "地质学家在采石场附近发现了一个巨大的<w>板岩</w>矿床。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slate roof",
                        "slate quarry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелкозернистая серая горная порода, образованная из глины или пепла, которая легко расслаивается на тонкие пластины; часто используется для кровельной черепицы.",
                        "zh": "一种细粒灰色岩石，由粘土或火山灰形成，易于分裂成薄片，常用于屋顶瓦片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сланец",
                                "target_lang_sense_clarification": "горная порода"
                            },
                            {
                                "target_lang_word": "шифер",
                                "target_lang_sense_clarification": "кровельный материал"
                            },
                            {
                                "target_lang_word": "аспидный сланец",
                                "target_lang_sense_clarification": "геологический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "板岩",
                                "target_lang_sense_clarification": "地质学上的岩石"
                            },
                            {
                                "target_lang_word": "石板",
                                "target_lang_sense_clarification": "建筑材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0967b976-e01a-35be-b4d5-3fea6586acef",
                    "sense_definition": "A list of candidates proposed by a political party for an election.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "list_schedule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party announced its full <w>slate</w> of candidates for the upcoming election.",
                            "target_lang_translations": {
                                "ru": "Партия объявила свой полный <w>список</w> кандидатов на предстоящие выборы.",
                                "zh": "该党公布了即将到来的选举的完整<w>候选人名单</w>。"
                            }
                        },
                        {
                            "text": "Voters can choose to support the entire <w>slate</w> or pick individual nominees.",
                            "target_lang_translations": {
                                "ru": "Избиратели могут поддержать весь <w>список</w> или выбрать отдельных кандидатов.",
                                "zh": "选民可以选择支持整个<w>候选人名单</w>，也可以挑选个别提名人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "party slate",
                        "candidate slate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Список кандидатов, выдвинутых политической партией на выборы.",
                        "zh": "政党为选举提出的候选人名单。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "список кандидатов",
                                "target_lang_sense_clarification": "политический"
                            },
                            {
                                "target_lang_word": "список",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "候选人名单",
                                "target_lang_sense_clarification": "政治选举"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ef0b0ee-5f85-3334-9e1d-d4d5a5e0cc4b",
                    "sense_definition": "A schedule or list of events, projects, or works.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "list_schedule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The film studio has a busy <w>slate</w> of releases planned for this year.",
                            "target_lang_translations": {
                                "ru": "У киностудии на этот год запланирован плотный <w>график</w> релизов.",
                                "zh": "电影制片厂今年有密集的发行<w>计划</w>。"
                            }
                        },
                        {
                            "text": "We have a full <w>slate</w> of meetings scheduled for tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "У нас на завтрашнее утро запланировано полное <w>расписание</w> встреч.",
                                "zh": "我们明天上午有排满的会议<w>日程</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "full slate",
                        "blank slate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расписание или перечень событий, проектов или работ.",
                        "zh": "活动、项目或工作的日程安排或清单。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "план",
                                "target_lang_sense_clarification": "намеченные действия"
                            },
                            {
                                "target_lang_word": "график",
                                "target_lang_sense_clarification": "расписание"
                            },
                            {
                                "target_lang_word": "список",
                                "target_lang_sense_clarification": "перечень"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "计划",
                                "target_lang_sense_clarification": "预定事项"
                            },
                            {
                                "target_lang_word": "日程",
                                "target_lang_sense_clarification": "时间表"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "009d3348-8e94-3e5e-8de6-9cdb78020b25",
                    "sense_definition": "A dark grey board or sheet of stone used for writing on with chalk, formerly common in schools.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "writing_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student wiped the chalk numbers off his <w>slate</w> with a cloth.",
                            "target_lang_translations": {
                                "ru": "Ученик стер меловые цифры со своей <w>грифельной доски</w> тряпкой.",
                                "zh": "学生用布擦掉了<w>石板</w>上的粉笔数字。"
                            }
                        },
                        {
                            "text": "In the nineteenth century, children learned to write using a <w>slate</w> and pencil.",
                            "target_lang_translations": {
                                "ru": "В девятнадцатом веке дети учились писать, используя <w>грифельную доску</w> и грифель.",
                                "zh": "在十九世纪，孩子们学习写字时使用的是<w>石板</w>和石笔。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "clean slate",
                        "wipe the slate clean"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to historical school equipment"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Темно-серая доска или пластина из камня, используемая для письма мелом, ранее распространенная в школах.",
                        "zh": "一种深灰色石板，过去常用于学校，供学生用粉笔书写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грифельная доска",
                                "target_lang_sense_clarification": "для письма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "石板",
                                "target_lang_sense_clarification": "书写工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c56f41c4-e9cc-30b1-931b-cac98a99c08d",
                    "sense_definition": "A dark bluish-grey colour.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "colour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist painted the stormy sky in shades of <w>slate</w> and charcoal.",
                            "target_lang_translations": {
                                "ru": "Художник нарисовал грозовое небо в оттенках <w>грифельного</w> и угольного.",
                                "zh": "艺术家用<w>板岩色</w>和炭色描绘了暴风雨前的天空。"
                            }
                        },
                        {
                            "text": "She wore a dress in a deep <w>slate</w> colour that matched her eyes.",
                            "target_lang_translations": {
                                "ru": "На ней было платье глубокого <w>грифельного</w> цвета, подходившее к её глазам.",
                                "zh": "她穿了一件深<w>板岩色</w>的裙子，和她的眼睛很配。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slate blue",
                        "slate grey",
                        "slate gray"
                    ],
                    "target_lang_definitions": {
                        "ru": "Темный голубовато-серый цвет.",
                        "zh": "一种深蓝灰色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грифельный цвет",
                                "target_lang_sense_clarification": "оттенок серого"
                            },
                            {
                                "target_lang_word": "аспидный цвет",
                                "target_lang_sense_clarification": "черно-серый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "板岩色",
                                "target_lang_sense_clarification": "颜色名称"
                            },
                            {
                                "target_lang_word": "深灰蓝色",
                                "target_lang_sense_clarification": "描述性颜色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "993f1441-5983-3d85-a933-6fd1f9019189",
                    "sense_definition": "A tablet computer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He checked his emails on a digital <w>slate</w> while traveling on the train.",
                            "target_lang_translations": {
                                "ru": "Он проверял электронную почту на цифровом <w>планшете</w>, пока ехал в поезде.",
                                "zh": "他在火车上用数字<w>平板电脑</w>查看电子邮件。"
                            }
                        },
                        {
                            "text": "Modern <w>slates</w> are powerful enough to replace laptops for many tasks.",
                            "target_lang_translations": {
                                "ru": "Современные <w>планшеты</w> достаточно мощны, чтобы заменить ноутбуки во многих задачах.",
                                "zh": "现代<w>平板电脑</w>功能强大，足以在许多任务中取代笔记本电脑。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Планшетный компьютер.",
                        "zh": "平板电脑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "планшет",
                                "target_lang_sense_clarification": "гаджет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "平板电脑",
                                "target_lang_sense_clarification": "电子设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b21bf55-e1c3-3ce3-b3db-aaf12acb208c",
                    "sense_definition": "A record of money owed, especially at a bar or shop.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "debt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Put these drinks on my <w>slate</w> and I will pay you next week.",
                            "target_lang_translations": {
                                "ru": "Запиши эти напитки на мой <w>счёт</w>, и я заплачу тебе на следующей неделе.",
                                "zh": "先把这些酒水记在我的<w>赊账</w>上，我下周付钱。"
                            }
                        },
                        {
                            "text": "He decided to pay off his <w>slate</w> at the local pub before moving away.",
                            "target_lang_translations": {
                                "ru": "Он решил оплатить свой <w>долг</w> в местном пабе перед переездом.",
                                "zh": "他在搬走之前决定结清在当地酒吧的<w>赊账</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tab",
                        "bill",
                        "account"
                    ],
                    "common_phrases": [
                        "on the slate"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запись денежного долга, особенно в баре или магазине.",
                        "zh": "欠款记录，常见于酒吧或商店。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "счёт",
                                "target_lang_sense_clarification": "долговой"
                            },
                            {
                                "target_lang_word": "долговая книга",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赊账",
                                "target_lang_sense_clarification": "债务记录"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "15be6ae0-5268-3601-a19f-29e5d17827df",
                    "sense_definition": "To schedule or plan an event to happen at a specific time.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new software update is <w>slated</w> for release next month.",
                            "target_lang_translations": {
                                "ru": "Выпуск обновления программного обеспечения <w>запланирован</w> на следующий месяц.",
                                "zh": "新的软件更新<w>预定</w>在下个月发布。"
                            }
                        },
                        {
                            "text": "The committee meeting has been <w>slated</w> for Tuesday afternoon.",
                            "target_lang_translations": {
                                "ru": "Заседание комитета <w>назначено</w> на вторую половину дня вторника.",
                                "zh": "委员会会议已<w>预定</w>在周二下午举行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slated for",
                        "slated to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запланировать событие на определенное время.",
                        "zh": "将某事安排在特定时间发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намечать",
                                "target_lang_sense_clarification": "планировать"
                            },
                            {
                                "target_lang_word": "планировать",
                                "target_lang_sense_clarification": "составлять план"
                            },
                            {
                                "target_lang_word": "назначать",
                                "target_lang_sense_clarification": "устанавливать время"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预定",
                                "target_lang_sense_clarification": "安排时间"
                            },
                            {
                                "target_lang_word": "计划",
                                "target_lang_sense_clarification": "安排事项"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6e6de62-518e-30ec-be74-d18ca5494137",
                    "sense_definition": "To criticise someone or something severely.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critics <w>slated</w> the new play for its poor acting and weak script.",
                            "target_lang_translations": {
                                "ru": "Критики <w>раскритиковали</w> новую пьесу за плохую игру актеров и слабый сценарий.",
                                "zh": "评论家们因该剧表演拙劣、剧本薄弱而对其进行了<w>严厉批评</w>。"
                            }
                        },
                        {
                            "text": "His latest book was <w>slated</w> in the newspapers despite high sales.",
                            "target_lang_translations": {
                                "ru": "Его последнюю книгу <w>разнесли</w> в газетах, несмотря на высокие продажи.",
                                "zh": "尽管销量很高，但他的新书在报纸上还是遭到了<w>抨击</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сурово критиковать кого-либо или что-либо.",
                        "zh": "严厉地批评某人或某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскритиковать",
                                "target_lang_sense_clarification": "подвергнуть критике"
                            },
                            {
                                "target_lang_word": "разнести",
                                "target_lang_sense_clarification": "разг., сильно ругать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "严厉批评",
                                "target_lang_sense_clarification": "负面评价"
                            },
                            {
                                "target_lang_word": "抨击",
                                "target_lang_sense_clarification": "强烈指责"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4f9903e-3cef-3d75-8b44-f10bf505fb52",
                    "sense_definition": "To cover a roof with slate tiles.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The builders need to <w>slate</w> the roof before the rainy season begins.",
                            "target_lang_translations": {
                                "ru": "Строителям нужно <w>покрыть</w> крышу <w>шифером</w> до начала сезона дождей.",
                                "zh": "建筑工人们需要在雨季开始前完成屋顶的<w>铺设</w>工作。"
                            }
                        },
                        {
                            "text": "It takes a skilled craftsman to <w>slate</w> a historic building correctly.",
                            "target_lang_translations": {
                                "ru": "Нужен опытный мастер, чтобы правильно <w>покрыть сланцем</w> историческое здание.",
                                "zh": "需要熟练的工匠才能正确地为历史建筑<w>铺设</w>板岩瓦。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать крышу сланцевой черепицей.",
                        "zh": "用板岩瓦覆盖屋顶。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крыть шифером",
                                "target_lang_sense_clarification": "кровельные работы"
                            },
                            {
                                "target_lang_word": "крыть сланцем",
                                "target_lang_sense_clarification": "натуральным камнем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铺设",
                                "target_lang_sense_clarification": "屋顶施工"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "07641401-bc2b-3b2b-879e-f098ecd29609",
                    "sense_definition": "Having a bluish-grey colour.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "colour_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>slate</w> sky warned us that a heavy storm was approaching.",
                            "target_lang_translations": {
                                "ru": "<w>Свинцовое</w> небо предупреждало нас о приближении сильной бури.",
                                "zh": "那<w>板岩色</w>的天空预示着一场大暴风雨即将来临。"
                            }
                        },
                        {
                            "text": "He wore a <w>slate</w> suit to the formal business meeting.",
                            "target_lang_translations": {
                                "ru": "Он надел <w>грифельно-серый</w> костюм на официальную деловую встречу.",
                                "zh": "他穿着一套<w>板岩色</w>的西装参加了正式的商务会议。"
                            }
                        }
