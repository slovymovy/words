                ],
                "senses": [
                    {
                        "sense_id": "f14efbdd-f8bf-3ec5-a619-d6905a2b699a",
                        "entry_id": "dbdba675-11d7-33bc-8e02-792d03c15517",
                        "glosses": [
                            "Kartenspiel für (zumeist) eine Person, bei dem die Karten nach verschiedensten Regeln in bestimmten Folgen aufgebaut werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17ca6f42-dc64-41be-ac60-6e18a54e3675",
                                "sense_id": "f14efbdd-f8bf-3ec5-a619-d6905a2b699a",
                                "text": "„Wer ein wenig eingedrungen ist in den Wesenskern dieses Spieles, wird stets aufs Neue staunend der unbezwinglichen Logik, die auch in der einfachsten Patience steckt, gegenüberstehen.“"
                            },
                            {
                                "example_id": "eb7a5663-a5f1-409a-b355-08ace0540c96",
                                "sense_id": "f14efbdd-f8bf-3ec5-a619-d6905a2b699a",
                                "text": "„Betsy legte gerade eine Patience auf dem Schiebetischchen vor sich.“"
                            },
                            {
                                "example_id": "7567b944-e122-4ee0-a7b5-2261cc8f5738",
                                "sense_id": "f14efbdd-f8bf-3ec5-a619-d6905a2b699a",
                                "text": "„Sie würde gefasst aus der Portiersloge treten, um ein Frühstück bitten und um Kaffee, viel Kaffee, und dann Patiencen legen.“"
                            },
                            {
                                "example_id": "ba4194da-826a-4982-8456-b3ce8022031e",
                                "sense_id": "f14efbdd-f8bf-3ec5-a619-d6905a2b699a",
                                "text": "„Wir legen Patiencen oder spielen Sechsundsechzig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "203cef14-e68e-4b15-96a7-e20b12068f3f",
                        "source_entry_id": "dbdba675-11d7-33bc-8e02-792d03c15517",
                        "source_sense_id": "f14efbdd-f8bf-3ec5-a619-d6905a2b699a",
                        "target_lang_word": "solitaire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solitaire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ffad7f4-e47e-3825-b951-eac76058183e",
                                        "entry_id": "4679c0e0-3954-3bdc-88fd-131cbad8089f",
                                        "glosses": [
                                            "A person who lives alone; a recluse or hermit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "271115e9-7fc3-4ae5-af76-aadb432d5c3c",
                                                "sense_id": "7ffad7f4-e47e-3825-b951-eac76058183e",
                                                "text": "1722-1723, Alexander Pope, letter to a lady\n[…] he really wishes he had never beheld you, nor yours. You have spoiled him for a solitaire, and a book, all the days of his life; and put him into such a condition, that he thinks of nothing, and enquires of nothing but after a person who has nothing to say to him, and has left him for ever […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9e8859a-b3f3-3ada-bae5-375eda458a7a",
                                        "entry_id": "4679c0e0-3954-3bdc-88fd-131cbad8089f",
                                        "glosses": [
                                            "A game for one person, played on a board with pegs or balls, in which the object is, beginning with all the places filled except one, to remove all but one of the pieces by \\\"jumping\\\", as in draughts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c92d5652-9783-4e8a-ba75-cd83dedc7904",
                                                "sense_id": "b9e8859a-b3f3-3ada-bae5-375eda458a7a",
                                                "text": "The early French solitaire boards were marked with thirty-seven holes instead of the modern board's thirty-three; and the problems were more difficult."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6dd7924-5c79-3f5c-8cfe-c3cc4c6ea376",
                                        "entry_id": "4679c0e0-3954-3bdc-88fd-131cbad8089f",
                                        "glosses": [
                                            "Any of various card games that can be played by one person."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aec90251-c6fd-484b-ae8a-6542d101fe5a",
                                                "sense_id": "d6dd7924-5c79-3f5c-8cfe-c3cc4c6ea376",
                                                "text": "You like to sit high on a hill / Count the daisies in the field / It's your own way of playing solitaire / You won't answer no question / Or say where you've been / The last thing you think you need is a friend"
                                            },
                                            {
                                                "example_id": "099ef246-7428-45d3-988c-9a6132729473",
                                                "sense_id": "d6dd7924-5c79-3f5c-8cfe-c3cc4c6ea376",
                                                "text": "Mr. Greenwood said yesterday that he always finished his work in a timely fashion, and that he played solitaire only when there was nothing else left to do, usually a few times a week or during lunch breaks."
                                            },
                                            {
                                                "example_id": "95eb25ba-1644-4bc4-a151-d5fc825e627f",
                                                "sense_id": "d6dd7924-5c79-3f5c-8cfe-c3cc4c6ea376",
                                                "text": "I learned to play solitaire as a child. Its advantages over other games were obvious, even then. No need to persuade a friend to play or explain the boring rules, no hard feelings when someone won or lost, no lessons required, no costly equipment to badger my parents into buying. I could play whenever and wherever I wanted. All I needed was a deck of cards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c38f06a-9ddf-356e-b010-6dafbbb17f4b",
                                        "entry_id": "4679c0e0-3954-3bdc-88fd-131cbad8089f",
                                        "glosses": [
                                            "Ellipsis of Rodrigues solitaire (Pezophaps solitaria), an extinct bird related to the dodo."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81c7536e-4873-3db7-818f-fb69c336ac1d",
                                        "entry_id": "4679c0e0-3954-3bdc-88fd-131cbad8089f",
                                        "glosses": [
                                            "Ellipsis of Réunion solitaire (Raphus solitarius, now Threskiornis solitarius), an extinct bird formerly believed to be related to the dodo."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff89db86-47d7-3f6f-9f4f-f9f84393338a",
                                        "entry_id": "4679c0e0-3954-3bdc-88fd-131cbad8089f",
                                        "glosses": [
                                            "One of several American species of bird in the genus Myadestes in the thrush family."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76ebd2a1-300e-391e-85dd-c3131ac05b1a",
                                        "entry_id": "4679c0e0-3954-3bdc-88fd-131cbad8089f",
                                        "glosses": [
                                            "A single gem, usually a diamond, mounted in a piece of jewellery by itself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f61d13e4-83e1-46b2-9577-0af4dd94a571",
                                                "sense_id": "76ebd2a1-300e-391e-85dd-c3131ac05b1a",
                                                "text": "The Times reported ‘two pendant earrings formed of diamond solitaires of great splendor, supporting pear-shaped pearls of proportionate value, capped with brilliants.[…]’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bafe5fa9-1ccd-34cf-a6bf-f21ee450fb4c",
                                        "entry_id": "4679c0e0-3954-3bdc-88fd-131cbad8089f",
                                        "glosses": [
                                            "A black neck ribbon worn with a bag wig in the 18th century."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26cd5a59-0a92-40fe-8b92-a5439bacd351",
                                                "sense_id": "bafe5fa9-1ccd-34cf-a6bf-f21ee450fb4c",
                                                "text": "The fellow wears a ſolitaire, uſes paint, and takes rappee with all the grimace of a French marquis."
                                            }
                                        ]
                                    }
                                ]
                            },
