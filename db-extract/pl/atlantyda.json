                "senses": [
                    {
                        "sense_id": "7b9af7d3-fb5e-39c9-b49a-c4c04aa50c34",
                        "entry_id": "e78e6212-9114-3168-9db0-ea80b6375a98",
                        "glosses": [
                            "mityczna wyspa całkowicie zniszczona przez trzęsienie ziemi, leżąca według Platona na Oceanie Atlantyckim naprzeciw Słupów Heraklesa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b736a22d-a710-489c-a678-96ef88bd5224",
                                "sense_id": "7b9af7d3-fb5e-39c9-b49a-c4c04aa50c34",
                                "text": "Posejdonowi poświęcona była bajeczna wyspa Atlantyda, którą władali jego potomkowie"
                            },
                            {
                                "example_id": "4c90cf8e-bde9-4f9d-839e-0f718eac03cb",
                                "sense_id": "7b9af7d3-fb5e-39c9-b49a-c4c04aa50c34",
                                "text": "Fakty nie zaprzeczają istnieniu Atlantydy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d7dfb2e4-d497-3ec4-b5f4-b8531ea63bf1",
                        "entry_id": "e78e6212-9114-3168-9db0-ea80b6375a98",
                        "glosses": [
                            "każda z Hesperyd, Hiad i Plejad, córek Atlasa"
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0280e330-0559-4146-8dca-40d798f1a038",
                        "source_entry_id": "e78e6212-9114-3168-9db0-ea80b6375a98",
                        "source_sense_id": "7b9af7d3-fb5e-39c9-b49a-c4c04aa50c34",
                        "target_lang_word": "Atlantis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atlantis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2023dfba-e007-30c7-882c-8d725ee36e9e",
                                        "entry_id": "9a932dbc-b585-3e59-ba82-b834cf21f651",
                                        "glosses": [
                                            "A mythical country said to have sunk into the Atlantic Ocean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e74eefa-5118-497a-92ac-f496363ebcec",
                                                "sense_id": "2023dfba-e007-30c7-882c-8d725ee36e9e",
                                                "text": "How far, since then, the ocean streams / Have swept us from that land of dreams, / That land of fiction and of truth, / The lost Atlantis of our youth!"
                                            },
                                            {
                                                "example_id": "b9b299c5-fcb7-4bda-b6ac-b8bc22e08350",
                                                "sense_id": "2023dfba-e007-30c7-882c-8d725ee36e9e",
                                                "text": "I might have drifted on for my whole life as a psychical Researcher, showing a sympathetic, but more or less dilettante attitude towards the whole subject, as if we were arguing about some impersonal thing such as the existence of Atlantis or the Baconian controversy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad19d93b-bd2b-4e7e-8e16-4cff9c1896f8",
                        "source_entry_id": "e78e6212-9114-3168-9db0-ea80b6375a98",
