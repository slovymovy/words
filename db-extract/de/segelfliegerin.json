                "senses": [
                    {
                        "sense_id": "dad62225-e5d3-33dd-b104-8970b78d31c1",
                        "entry_id": "ea747daf-a3dc-3c02-be88-1ad5a69feb94",
                        "glosses": [
                            "weibliche Person, die das Fliegen mit Segelflugzeugen betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64e708bb-b0a2-415c-992c-ef6ab75d297a",
                                "sense_id": "dad62225-e5d3-33dd-b104-8970b78d31c1",
                                "text": "Claudia ist eine begeisterte Segelfliegerin."
                            },
                            {
                                "example_id": "6b136459-9957-4df5-9636-3c87d0928e81",
                                "sense_id": "dad62225-e5d3-33dd-b104-8970b78d31c1",
                                "text": "Zwei Segelfliegerinnen sind mit ihrem Segelflugzeug nahe Salzburg abgestürzt."
                            },
                            {
                                "example_id": "0e24a876-10c9-49df-9285-9afa19273ea7",
                                "sense_id": "dad62225-e5d3-33dd-b104-8970b78d31c1",
                                "text": "Das Segelfliegen liegt bei Mathilde in der Familie: Schon ihre Mutter und ihre Großmutter nahmen als Segelfliegerinnen an Kunstflugwettbewerben teil."
                            },
                            {
                                "example_id": "79b23a59-1794-4dc9-81c3-25f1a6cf8106",
                                "sense_id": "dad62225-e5d3-33dd-b104-8970b78d31c1",
                                "text": "Die Segelfliegerin landete ihr Flugzeug ohne Probleme."
                            },
                            {
                                "example_id": "0557aed2-b11a-46c2-ad91-ea1bd023d9ed",
                                "sense_id": "dad62225-e5d3-33dd-b104-8970b78d31c1",
                                "text": "Sie ist seit dreißig Jahren Segelfliegerin und hat immer noch nicht genug."
                            },
                            {
                                "example_id": "a924dfab-2895-4f91-82dd-22d1e4ba3956",
                                "sense_id": "dad62225-e5d3-33dd-b104-8970b78d31c1",
                                "text": "Bruno war fasziniert von dem Vortrag einer Segelfliegerin in seiner Schule."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
