            "senses": [
                {
                    "sense_id": "33885756-f101-3a55-a3f1-7cd4c705176a",
                    "sense_definition": "een lichaamsdeel of object zo ver mogelijk uitrekken of recht maken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysiek_uitrekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange dag op kantoor moet ik even mijn benen <w>strekken</w>.",
                            "target_lang_translations": {
                                "en": "After a long day at the office, I need to <w>stretch</w> my legs for a bit."
                            }
                        },
                        {
                            "text": "De atleet begon zijn armen te <w>strekken</w> voor de wedstrijd begon.",
                            "target_lang_translations": {
                                "en": "The athlete started to <w>stretch</w> his arms before the race began."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitstrekken",
                        "reiken"
                    ],
                    "antonyms": [
                        "buigen"
                    ],
                    "common_phrases": [
                        "de benen strekken",
                        "de armen strekken"
                    ],
                    "target_lang_definitions": {
                        "en": "To extend or straighten a body part or object as far as possible."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stretch",
                                "target_lang_sense_clarification": "to extend limbs or muscles"
                            },
                            {
                                "target_lang_word": "extend",
                                "target_lang_sense_clarification": "to straighten a limb"
                            },
                            {
                                "target_lang_word": "stretch out",
                                "target_lang_sense_clarification": "to fully extend a body part"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ac9a904-11bf-3f53-a6e1-8e02187377ff",
                    "sense_definition": "een bepaalde afstand beslaan of tot een bepaald punt reiken",
