                        "glosses": [
                            "Étendre de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37ea92f7-1013-4161-8e74-90a990d31795",
                                "sense_id": "8b5c6028-9da2-3e3a-a06c-ae7c55f3b73a",
                                "text": "Je dois réétendre les draps parce qu’ils ne sont pas encore secs."
