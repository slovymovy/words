                        "regard mélancolique"
                    ]
                },
                {
                    "sense_id": "05506c49-0716-30ff-ab75-56b66c4ddd91",
                    "sense_definition": "Qui éprouve un sentiment de tristesse vague, qui est enclin à la rêverie sombre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis le départ de son ami, elle reste souvent silencieuse et <w>mélancolique</w> dans son coin."
                        },
                        {
                            "text": "Cet auteur a toujours eu un tempérament <w>mélancolique</w> qui se reflète dans ses romans."
                        }
                    ],
                    "synonyms": [
                        "cafardeux",
                        "triste"
                    ],
                    "common_phrases": [
