                        "entry_id": "bec2d83e-8f7c-370d-9f04-6c3959db02a7",
                        "glosses": [
                            "samenkomst van mensen die een bloedband met elkaar hebben of door een huwelijk met elkaar verbonden zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f71a6703-acea-4a0f-a8dc-270be649a8aa",
                                "sense_id": "09df9576-2fa3-31d6-8afb-305484f1b93c",
                                "text": "Totdat Andreescu afgelopen zomer in aanloop naar de US Open het toernooi van Toronto won. \"We waren op een familiebijeenkomst en ik vroeg die oom: hé, is dat hetzelfde meisje? En ja, dat was ze. En nu wint ze opeens de US Open!\""
                            },
                            {
                                "example_id": "79a78de7-67d7-468d-8844-3868ee0ab77a",
                                "sense_id": "09df9576-2fa3-31d6-8afb-305484f1b93c",
                                "text": "Familiebijeenkomst: Volgende maand komt de familie bij elkaar om de filmpjes te bekijken. \"We willen weten wie er op de beelden staan. We gaan met de familie op zoek naar de namen van de mensen die we zien\", zegt Herrema."
                            }
                        ]
                    }
