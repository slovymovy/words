                        "entry_id": "8e2e972f-3d3e-390f-b95a-74a525cad86d",
                        "glosses": [
                            "Maronite (member of the Maronite Church, a Levantine, especially Lebanese, branch of the Roman Catholic Church)"
                        ],
                        "tags": [
                            "masculine",
                            "weak"
                        ],
                        "examples": [
                            {
                                "example_id": "8c1f0640-6fcd-45c6-abbe-eda51ccd19cd",
                                "sense_id": "9e48b83d-b4f2-3b7f-ac66-aa6eab0f7b69",
                                "text": "Die Maroniten verstatten ihren Weibern, mit ihnen zu essen, ja so gar sich vor Fremden sehen zu lassen, da hingegen die andern Christen nicht so gefällig sind. Ihre Weiber werden nicht viel besser angesehen, als das Gesinde [...].",
                                "translation": "The Maronites allow their women to eat with them, and even to show themselves in front of strangers, whereas the other [Middle Eastern] Christians are not so obliging. Their women are not much more esteemed than the servants ….",
                                "english": "The Maronites allow their women to eat with them, and even to show themselves in front of strangers, whereas the other [Middle Eastern] Christians are not so obliging. Their women are not much more esteemed than the servants …."
                            }
                        ]
                    }
