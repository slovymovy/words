                        "examples": [
                            {
                                "example_id": "c43f230a-6192-44a0-8c8a-37f22cc2101f",
                                "sense_id": "aa466673-7d6a-3b2b-92ce-634ec6a7dee7",
                                "text": "It is my Lady, O it is my Loue, O that ſhe knew ſhe were,\n She ſpeakes, yet ſhe ſayes nothing, what of that?"
                            },
                            {
                                "example_id": "ce803f9b-fd5f-44ee-b536-7e61614b3d15",
                                "sense_id": "aa466673-7d6a-3b2b-92ce-634ec6a7dee7",
                                "text": "And againe You ſaw that I ſpake to you from Heauen, therefore yee ſhall make no Gods of Golde nor ſiluer: as if he ſhould haue ſaide, my practiſe in ſpeakeing to you by voyce and not by Image ſhoulde teach you that by my word and not by image, I am be remembred."
                            }
                        ]
                    }
