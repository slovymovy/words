        "fr-extract.jsonl": [
            {
                "entry_id": "a19962d6-ed49-3cee-867a-e058a4d412f5",
                "word": "optimisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "92c8c4f3-5acb-4eb6-8d5e-e3c248fb6f7c",
                        "entry_id": "a19962d6-ed49-3cee-867a-e058a4d412f5",
                        "tags": [
                            "plural"
                        ],
                        "form": "optimismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "83b6a215-5b1a-3500-8f20-1676fb31e1e6",
                        "entry_id": "a19962d6-ed49-3cee-867a-e058a4d412f5",
                        "glosses": [
                            "Doctrine philosophique qui soutient que tout ce qui existe est le mieux possible."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1fab5d9a-4417-34f0-8e89-e47b5e8749e6",
                        "entry_id": "a19962d6-ed49-3cee-867a-e058a4d412f5",
                        "glosses": [
                            "Une certaine disposition à voir les choses en beau, à ne pas s’inquiéter des embarras présents et à bien augurer de l’avenir."
                        ],
                        "tags": [
                            "Ordinairement"
                        ],
                        "examples": [
                            {
                                "example_id": "ec0b7d4c-b6ac-4fb0-9f15-9cdbc8236b50",
                                "sense_id": "1fab5d9a-4417-34f0-8e89-e47b5e8749e6",
                                "text": "Ses ouvrages […] contiennent nombre de pensées inspirées par ce vaillant optimisme matérialiste et orientées contre l’agnosticisme, le relativisme et d'autres variétés d'idéalisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "e47363b7-aad8-329e-a072-61811fa3cbeb",
                        "entry_id": "a19962d6-ed49-3cee-867a-e058a4d412f5",
                        "glosses": [
                            "Impression qu’on a, dans une circonstance particulière, de voir les choses prendre bonne tournure."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "548fb1f1-58c7-444e-b713-8fed49e4e49a",
                                "sense_id": "e47363b7-aad8-329e-a072-61811fa3cbeb",
                                "text": "Je sens mes intestins qui ronronnent légèrement. La digestion sans heurts est le plus grand facteur d’activité. Le cerveau s’emplit avec le ventre et l’optimisme a sa source dans la béatitude des tripes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b486290-0750-419d-a2d2-af5f977d2b9b",
                        "source_entry_id": "a19962d6-ed49-3cee-867a-e058a4d412f5",
                        "target_lang_word": "Optimismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Optimismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee3ff86c-b322-3d06-8386-bafa0dd69ae7",
                                        "entry_id": "74d0fbb3-f366-3809-913e-95a1541eb115",
                                        "glosses": [
                                            "der Glaube, in der besten aller möglichen Welten zu leben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edb8d371-3445-4184-a56a-322cf35a22d1",
                                                "sense_id": "ee3ff86c-b322-3d06-8386-bafa0dd69ae7",
                                                "text": "In einem strengen Sinne \"ist der Begriff \"Optimismus\" nur auf die Systeme von Leipniz und Malebranche anzuwenden … Leibniz, der das Wort Optimismus selbst nicht gebraucht, arbeitet mit einem mathematischen Gleichnis: <>\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e929e041-474d-3f62-91e5-14a55a0d8b9f",
                                        "entry_id": "74d0fbb3-f366-3809-913e-95a1541eb115",
                                        "glosses": [
                                            "eine generell positive Erwartungshaltung beziehungsweise Weltsicht"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7be1e32-3947-4f40-91ff-ebee37256452",
                                                "sense_id": "e929e041-474d-3f62-91e5-14a55a0d8b9f",
                                                "text": "Ein bisschen Optimismus würde unserer Sache nicht schaden."
                                            },
                                            {
                                                "example_id": "871b372b-a794-4447-aa18-dc365ce56286",
                                                "sense_id": "e929e041-474d-3f62-91e5-14a55a0d8b9f",
                                                "text": "„Er konnte sich nicht erklären, warum ihn sein Optimismus und sein Humor verlassen hatten.“"
                                            },
                                            {
                                                "example_id": "4eba8452-df2b-434c-9b7f-03ecf64023c5",
                                                "sense_id": "e929e041-474d-3f62-91e5-14a55a0d8b9f",
                                                "text": "„Am Ende ihres Lebens hatten die Protagonisten allen Optimismus verloren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95b5965b-c9ce-4caf-a50e-1bdb03f4ae24",
                        "source_entry_id": "a19962d6-ed49-3cee-867a-e058a4d412f5",
