        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a5741761-d706-3155-8041-8b9f3084af80",
                "word": "diploid",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b93efc2d-fc42-3b0d-ac04-0778144349c2",
                        "entry_id": "a5741761-d706-3155-8041-8b9f3084af80",
                        "glosses": [
                            "Of a cell, having a pair of each type of chromosome, one of the pair being derived from the ovum and the other from the spermatozoon. Most somatic cells of higher organisms are diploid."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "807b2db5-0685-4eaa-a258-69a0c97d8de2",
                                "sense_id": "b93efc2d-fc42-3b0d-ac04-0778144349c2",
                                "text": "It has been shown, however, that triploid forms producing diploid gametes in one sex and haploid ones in the other sex can act as a stepping stone towards tetraploidization (triploid bridge; [ 93 – 95 ])."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7936372-23d1-317c-a2b9-2d8f96bac16f",
                        "entry_id": "a5741761-d706-3155-8041-8b9f3084af80",
                        "glosses": [
                            "Of an organism, having diploid cells."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
