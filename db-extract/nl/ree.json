                    {
                        "translation_id": "4587232d-459a-4f15-98bc-a0c82fccbbd8",
                        "source_entry_id": "70340afc-b253-36c2-b8ee-fc0770d29145",
                        "source_sense_id": "9fbb521a-c055-32b0-87c5-57721148522d",
                        "source_sense_description": "sierlijk slank hert, komt bijna in heel Europa voor",
                        "target_lang_word": "Reh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74ec5340-b24a-3952-97ce-ff4e8cb990fe",
                                        "entry_id": "ffe33777-385c-3454-9823-6e82dcb42485",
                                        "glosses": [
                                            "im Wald lebender Wiederkäuer aus der Familie der Hirsche oder Cervidae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e6b4bbb-8e84-49b6-9acb-ef39d20be6dd",
                                                "sense_id": "74ec5340-b24a-3952-97ce-ff4e8cb990fe",
                                                "text": "Die Rehe vermehren sich schneller, als die Jäger sie schießen können."
                                            },
                                            {
                                                "example_id": "cf653588-56aa-44a7-b1ca-70b46c505074",
                                                "sense_id": "74ec5340-b24a-3952-97ce-ff4e8cb990fe",
                                                "text": "„Zwei Rehe hatten sich auf einen komplett umzäunten und schneebedeckten Tennisplatz verirrt und fanden keinen Weg ins Freie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "152aa0e5-d5a7-4105-a897-129acd27d9d1",
                        "source_entry_id": "70340afc-b253-36c2-b8ee-fc0770d29145",
                        "source_sense_id": "9fbb521a-c055-32b0-87c5-57721148522d",
                        "source_sense_description": "sierlijk slank hert, komt bijna in heel Europa voor",
                        "target_lang_word": "roe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5144e93-d8a2-301c-b104-0b7e6f4947b5",
                                        "entry_id": "8eed9105-3178-3940-b076-33b39883969e",
                                        "glosses": [
                                            "Eggs of fish."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16e1b25d-4d0d-4f8f-aeb1-94f29dd0407e",
                                                "sense_id": "b5144e93-d8a2-301c-b104-0b7e6f4947b5",
                                                "text": "It was quite flavourless, except that, where its innards had been imperfectly removed, silver traces of roe gave it an unpleasant bitterness."
                                            },
                                            {
                                                "example_id": "0b69be73-e0b5-412f-a8c9-57155eacda27",
                                                "sense_id": "b5144e93-d8a2-301c-b104-0b7e6f4947b5",
                                                "text": "Today, some seafood experts say, the cheaper (though mushier) roe feeds 60 percent of the market."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d479b3e7-4698-3052-b6b0-86ac19cdf45e",
                                        "entry_id": "8eed9105-3178-3940-b076-33b39883969e",
                                        "glosses": [
                                            "Sperm of certain fish."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90602f6b-1276-374f-b927-ef461cbdd7a7",
                                        "entry_id": "8eed9105-3178-3940-b076-33b39883969e",
                                        "glosses": [
                                            "Ovaries of certain crustaceans."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "roe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aea0add8-2cc2-3aed-b849-bf41dbed4d44",
                                        "entry_id": "729119a0-0d94-3870-8cf6-f16abfa5e053",
                                        "glosses": [
                                            "Ellipsis of roe deer."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a55faab-aaf2-493e-a793-b5960124d30b",
                                                "sense_id": "aea0add8-2cc2-3aed-b849-bf41dbed4d44",
                                                "text": "And let his foes like flockes of feareful Roes,\nPurſude by hunters, flie his angry lookes,\nThat I may ſee him iſſue Conquerour."
                                            },
                                            {
                                                "example_id": "048b1300-d52e-4a04-832e-4917ae243f77",
                                                "sense_id": "aea0add8-2cc2-3aed-b849-bf41dbed4d44",
                                                "text": "The lofty mountains roſe faint to the ſight and loſt their foreheads in the diſtant ſkies: the little hills, cloathed in darker green and ſkirted with embroidered vales, diſcovered the ſecret haunts of kids and bounding roes."
                                            },
                                            {
                                                "example_id": "20fa44fd-2de3-4786-842a-046f49ec2790",
                                                "sense_id": "aea0add8-2cc2-3aed-b849-bf41dbed4d44",
                                                "text": "\"[...] and we may, God willing, meet with a roe. The roe, Captain Waverley, may be hunted at all times alike; for never being in what is called pride of grease, he is also never out of season, though it be a truth that his venison is not equal to that of either the red or fallow deer. But he will serve to show how my dogs run [...]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72aa5b43-8f60-3b2d-b988-272ccd81d2bd",
                                        "entry_id": "729119a0-0d94-3870-8cf6-f16abfa5e053",
                                        "glosses": [
                                            "A mottled appearance of light and shade in wood, especially in mahogany."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0fbc3a1-d061-42c1-8d73-795e59ec1958",
                        "source_entry_id": "70340afc-b253-36c2-b8ee-fc0770d29145",
                        "source_sense_id": "9fbb521a-c055-32b0-87c5-57721148522d",
                        "source_sense_description": "sierlijk slank hert, komt bijna in heel Europa voor",
                        "target_lang_word": "chevreuil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chevreuil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58588835-be2c-3084-8ba8-99000038cd8d",
                                        "entry_id": "d93ffb6f-0b1a-3ede-81ac-f032850525c2",
                                        "glosses": [
                                            "Une des espèces de cervidés, plus petits que les cerfs et dont la tête ressemble un peu à celle des chèvres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fa02dd7-c4ba-492d-b560-637ab0c50f19",
                                                "sense_id": "58588835-be2c-3084-8ba8-99000038cd8d",
                                                "text": "Faon de chevreuil."
                                            },
                                            {
                                                "example_id": "863f6511-7b73-4476-ab5e-159b2dfd888d",
                                                "sense_id": "58588835-be2c-3084-8ba8-99000038cd8d",
                                                "text": "Une observation minutieuse permet de constater que le chevreuil, particulièrement délicat, préfère les semis les plus grêles et dédaigne les dards vigoureux qui sont peut-être moins tendres."
                                            },
                                            {
                                                "example_id": "c4ef03a5-bd9f-4595-9ab7-4d4fa3fbe898",
                                                "sense_id": "58588835-be2c-3084-8ba8-99000038cd8d",
                                                "text": "Tous, d’après les archives fossiles, recolonisèrent les plaines d’Europe centrale et occidentale, accompagnés du cerf élaphe et du chevreuil, environ deux millénaires après la fin de la dernière période glaciaire, il y a près de 12 000 ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4e89028-f2f2-38fb-a89b-8e5355bbbeb9",
                                        "entry_id": "d93ffb6f-0b1a-3ede-81ac-f032850525c2",
                                        "glosses": [
                                            "Viande de cet animal."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6e91301-5e18-4681-add4-e4613e4536f3",
                                                "sense_id": "f4e89028-f2f2-38fb-a89b-8e5355bbbeb9",
                                                "text": "Des gigues de chevreuil, des quartiers de marcassin parvenaient dans leurs offices et les dames agréaient les honneurs du pied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa70b6de-798e-394a-b891-9ed0324c6ea9",
                                        "entry_id": "d93ffb6f-0b1a-3ede-81ac-f032850525c2",
                                        "glosses": [
                                            "Espèce de cervidés aussi connue sous le nom de cerf de Virginie, de nom scientifique Odocoileus virginianus"
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ade72538-c841-4577-8af7-9022e456ff5c",
                                                "sense_id": "aa70b6de-798e-394a-b891-9ed0324c6ea9",
                                                "text": "Bien qu'il soit impossible de faire un inventaire aérien précis et simultané à l'échelle provinciale, on estime qu'il y a environ 240,000 chevreuils dans la forêt québécoise, et ce, sans compter le cheptel d'Anticosti."
                                            },
                                            {
                                                "example_id": "e94d1a07-5546-40d2-91ee-ade3d93972ee",
                                                "sense_id": "aa70b6de-798e-394a-b891-9ed0324c6ea9",
                                                "text": "On reste là, paralysés, comme un chevreuil devant les phares d’une auto."
                                            },
                                            {
                                                "example_id": "ea30fbd6-e00f-403e-bed1-a805f969767c",
                                                "sense_id": "aa70b6de-798e-394a-b891-9ed0324c6ea9",
                                                "text": "Les chevreuils sont munis d’organes interdigitaux entre les sabots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fa219eb-a7a1-32ed-8701-cd7327659ea4",
                                        "entry_id": "d93ffb6f-0b1a-3ede-81ac-f032850525c2",
                                        "glosses": [
                                            "Meuble représentant l’animal du même nom dans les armoiries. Il se blasonne comme le cerf dont il se distingue par le fait qu'il ne porte que 2 cors et non une ramure. À rapprocher de biche, cerf, daim et élan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9882cd6b-ce06-4cbd-8271-cd96dac71463",
                                                "sense_id": "8fa219eb-a7a1-32ed-8701-cd7327659ea4",
                                                "text": "D’azur au chevreuil d’or ; au chef dentelé d’argent chargé d’une feuille de noyer de sinople, qui est de Les Noës."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
