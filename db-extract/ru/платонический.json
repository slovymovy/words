                ],
                "senses": [
                    {
                        "sense_id": "a135d29f-e3d2-3004-b391-e303e756abc6",
                        "entry_id": "360ca42b-b686-3513-877d-68a519b0cf6a",
                        "glosses": [
                            "истор., филос. относящийся к платонизму"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "471011f0-9f17-4cba-a2c1-42f9ec6d0f42",
                                "sense_id": "a135d29f-e3d2-3004-b391-e303e756abc6",
                                "text": "Что он такое, почему он есть и для чего, этого мы познавать не можем, и платоническая наука о сущности, основе и цели вещей невозможна."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ca5438d-89c6-375d-b13c-ae4bc04f01fa",
                        "entry_id": "360ca42b-b686-3513-877d-68a519b0cf6a",
                        "glosses": [
                            "перен. связанный с чисто духовной, душевной или рациональной стороной чего-либо (в противоположность физическому, телесному и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ef81cf5-7622-478d-82cd-e454011e764c",
                                "sense_id": "7ca5438d-89c6-375d-b13c-ae4bc04f01fa",
                                "text": "Русские барышни большею частью питаются только платонической любовью, не примешивая к ней мысли о замужестве; а платоническая любовь самая беспокойная."
                            }
                        ]
                    },
                    {
                        "sense_id": "8078b986-4688-3cdc-8c4d-6fa408b1fc51",
                        "entry_id": "360ca42b-b686-3513-877d-68a519b0cf6a",
                        "glosses": [
                            "не преследующий практических целей, отвлеченный"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21f012ab-45e0-4d25-b508-b69896db0bc7",
                        "source_entry_id": "360ca42b-b686-3513-877d-68a519b0cf6a",
                        "target_lang_word": "Platonic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Platonic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cb402e2-939a-33ba-becc-e4c9e115bf8b",
                                        "entry_id": "bc4af713-5bba-3964-bc3c-ae9f0e0c831b",
                                        "glosses": [
                                            "Of or relating to the ancient Greek philosopher Plato or his philosophies."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2da614af-ffb7-30be-88f3-437ae14a1d91",
                                        "entry_id": "bc4af713-5bba-3964-bc3c-ae9f0e0c831b",
                                        "glosses": [
                                            "Alternative letter-case form of platonic (non-sexual)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "765e16a3-ab9f-41a9-b373-00eb0855ac4d",
                                                "sense_id": "2da614af-ffb7-30be-88f3-437ae14a1d91",
                                                "text": "The homosexual dismisses heterosexual love as a distasteful bondage to normalcy and bourgeois domestication, but the Platonic lover of the soul is dismissing all sexuality as bondage to the physical world."
                                            }
                                        ]
                                    }
                                ]
