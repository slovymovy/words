                ],
                "senses": [
                    {
                        "sense_id": "897f691b-0ac5-3c20-877e-0854b10725ec",
                        "entry_id": "36b6c8b3-c417-3ef5-bf0e-2974f996610a",
                        "glosses": [
                            "Doter de mansardes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "555d9000-8dbb-47b7-9d4b-f87139ec4203",
                                "sense_id": "897f691b-0ac5-3c20-877e-0854b10725ec",
                                "text": "Je vend un terrain de 14600 m² plus la maison de 80 m² avec 3 pièces et possibilité de mansarder"
                            },
                            {
                                "example_id": "d66ded49-6980-4eaf-b56e-6a845d5c2759",
                                "sense_id": "897f691b-0ac5-3c20-877e-0854b10725ec",
                                "text": "De nombreuses terrasses mansardent la maison qui est agrémentée d'une piscine et d'un jardin paysager à l'abri de tout regard et au calme."
                            },
                            {
                                "example_id": "cb6a32b5-d0ad-4abb-a46d-b131ba898614",
                                "sense_id": "897f691b-0ac5-3c20-877e-0854b10725ec",
                                "text": "Les chambres dans le style classique parisien se mansardent au dernier étage et donnent sur les toits."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdfa8c40-7f67-3e69-a8ea-126a82b695f9",
                        "entry_id": "36b6c8b3-c417-3ef5-bf0e-2974f996610a",
                        "glosses": [
                            "Vivre dans une mansarde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2270de06-2eb4-47a9-b7cb-92638f811b9a",
                                "sense_id": "bdfa8c40-7f67-3e69-a8ea-126a82b695f9",
                                "text": "Elle s'y rendit, sûre d'elle, laissant son temps à la calèche qui l'amenait de Bordeaux où elle mansardait depuis des années."
                            }
                        ]
                    }
