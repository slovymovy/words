            "pos": "noun",
            "senses": [
                {
                    "sense_id": "22acb493-8192-3fd1-9c64-24436abb1e2f",
                    "sense_definition": "Sehr kleiner, abgegrenzter materieller Bestandteil; winziges Teilchen eines festen, flüssigen oder gasförmigen Stoffes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "teilchen_materie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spezielle Filter halten selbst mikroskopisch kleine <w>Partikel</w> zuverlässig aus der Atemluft zurück."
                        },
                        {
                            "text": "Der feine Sand besteht aus unzähligen winzigen <w>Partikeln</w>, die vom Wind getragen werden."
                        }
                    ],
                    "synonyms": [
                        "Teilchen"
                    ],
                    "antonyms": [
                        "Welle"
                    ],
                    "common_phrases": [
                        "feine Partikel",
                        "schwebende Partikel"
                    ]
                },
                {
                    "sense_id": "43db5be7-b835-35a9-998f-67b6aa5ad64e",
                    "sense_definition": "Nicht flektierbares Wort, das keine feste syntaktische Satzgliedfunktion hat und oft zur Nuancierung oder Strukturierung dient.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Deutschen erfüllen Wörter wie „ja“, „denn“ oder „doch“ oft die Funktion einer <w>Partikel</w>."
                        },
                        {
                            "text": "Eine grammatische <w>Partikel</w> behält im Satz immer ihre feste Grundform."
                        }
                    ],
                    "synonyms": [
                        "Redeteilchen"
                    ],
                    "common_phrases": [
                        "grammatische Partikel",
                        "deutsche Partikeln"
                    ]
                },
                {
                    "sense_id": "a4491257-3782-316a-ad11-de468557d7a3",
                    "sense_definition": "Kleiner abgebrochener Teil einer geweihten Hostie in der katholischen Liturgie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Während des Gottesdienstes brach der Priester vorsichtig eine kleine <w>Partikel</w> von der Hostie ab."
                        },
                        {
                            "text": "Auf dem Korporale blieb nach der Austeilung der Kommunion eine einzelne <w>Partikel</w> zurück."
                        }
                    ],
                    "common_phrases": [
                        "heilige Partikel"
                    ]
                },
                {
                    "sense_id": "a7523092-5996-3ae9-9204-71a429438b1a",
                    "sense_definition": "Kleiner Holzspan des Kreuzes Christi, der in der christlichen Tradition als Reliquie verehrt wird.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die alte Kathedrale bewahrt eine kostbare <w>Partikel</w> des Heiligen Kreuzes in einem goldenen Reliquiar auf."
                        },
                        {
                            "text": "Viele Pilger reisten in die Stadt, um die verehrte <w>Partikel</w> im Altar zu betrachten."
                        }
                    ],
                    "common_phrases": [
                        "verehrte Partikel"
                    ]
                }
            ]
        }
    ]
