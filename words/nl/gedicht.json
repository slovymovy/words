                                "zh": "他为女朋友写了一首浪漫的<w>诗</w>。"
                            }
                        },
                        {
                            "text": "Ze leest mijn laatst geschreven <w>gedicht</w>.",
                            "target_lang_translations": {
                                "en": "She is reading my latest written <w>poem</w>.",
                                "ru": "Она читает моё последнее написанное <w>стихотворение</w>.",
                                "pl": "Czyta mój ostatnio napisany <w>wiersz</w>.",
                                "de": "Sie liest mein zuletzt geschriebenes <w>Gedicht</w>.",
                                "fr": "Elle lit mon dernier <w>poème</w> écrit.",
                                "it": "Sta leggendo la mia ultima <w>poesia</w> scritta.",
                                "cs": "Čte mou naposledy napsanou <w>báseň</w>.",
