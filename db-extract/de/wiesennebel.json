                "senses": [
                    {
                        "sense_id": "33eca15d-0985-34d8-a628-3db3e2d00914",
                        "entry_id": "06c67207-3ce8-38aa-ad30-0077c1850aeb",
                        "glosses": [
                            "Nebel, der im Frühling oder Herbst vor allem über Wiesen und Feuchtgebieten entsteht und dort anzutreffen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4ef6a9a-f516-4f76-b6e5-239c7b165f1e",
                                "sense_id": "33eca15d-0985-34d8-a628-3db3e2d00914",
                                "text": "„Die Fernsicht ist ungewöhnlich gut, Dunstbildung unterbleibt völlig, und nur über kalten Mulden trifft man in den frühen Morgenstunden flache Wiesennebel an.“"
                            },
                            {
                                "example_id": "373a1158-a667-421c-b533-bfb3584f282b",
                                "sense_id": "33eca15d-0985-34d8-a628-3db3e2d00914",
                                "text": "„Plötzlich … er zuckte zusammen … wuchs vor ihm aus dem feuchten Wiesennebel die Vision einer Frau …“"
                            },
                            {
                                "example_id": "579f62ff-e1b1-4272-9547-4d7e796d82f9",
                                "sense_id": "33eca15d-0985-34d8-a628-3db3e2d00914",
                                "text": "Im Herbst sprechen die Meteorologen häufig von Wiesennebeln."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
