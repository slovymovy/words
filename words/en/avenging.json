{
    "word_family": [
        "avenge",
        "avenger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "85bcd821-0833-3f06-a4cf-fb643498ff8d",
                    "sense_definition": "present participle and gerund of <w>avenge</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vengeance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent years dedicated to <w>avenging</w> the tragic death of his brother.",
                            "target_lang_translations": {
                                "ru": "Он посвятил годы тому, чтобы <w>отомстить за</w> трагическую гибель своего брата."
                            }
                        },
                        {
                            "text": "She saw herself as an <w>avenging</w> spirit sent to punish wrongdoers.",
                            "target_lang_translations": {
                                "ru": "Она видела себя <w>карающим</w> духом, посланным наказать злодеев."
                            }
                        }
                    ],
                    "common_phrases": [
                        "avenging angel"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола avenge: мстящий, карающий, отмщение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мстящий",
                                "target_lang_sense_clarification": "причастие: тот, кто мстит"
                            },
                            {
                                "target_lang_word": "карающий",
                                "target_lang_sense_clarification": "причастие: несущий возмездие"
                            },
                            {
                                "target_lang_word": "мстя",
                                "target_lang_sense_clarification": "деепричастие: совершая месть"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d115fca1-2109-3f13-a133-81d6a0167c33",
                    "sense_definition": "The act of inflicting harm in return for an injury or wrong; the act of avenging someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vengeance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poem recounts the bitter <w>avenging</w> of ancient family rivalries.",
                            "target_lang_translations": {
                                "ru": "В поэме описывается жестокое <w>отмщение</w> за древнюю вражду между семьями."
                            }
                        },
                        {
                            "text": "He believed that the <w>avenging</w> of their defeat was necessary for honor.",
                            "target_lang_translations": {
                                "ru": "Он верил, что <w>отмщение</w> за их поражение было делом чести."
                            }
                        }
                    ],
                    "synonyms": [
                        "retaliation",
                        "revenge",
                        "vengeance"
                    ],
                    "antonyms": [
                        "forgiveness",
                        "pardon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по отмщению кому-либо; причинение вреда в ответ на обиду, возмездие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отмщение",
                                "target_lang_sense_clarification": "акт мести за кого-либо или что-либо"
                            },
                            {
                                "target_lang_word": "месть",
                                "target_lang_sense_clarification": "возмездие за причиненное зло"
                            },
                            {
                                "target_lang_word": "возмездие",
                                "target_lang_sense_clarification": "справедливая кара за проступок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}