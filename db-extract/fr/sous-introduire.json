                "senses": [
                    {
                        "sense_id": "ea8f501b-1d9d-3a4a-b6fb-1856e7f6c1d6",
                        "entry_id": "f1c507df-e75d-3f16-a47b-7975a6fb60f6",
                        "glosses": [
                            "Introduire de façon subordonnée à quelque chose d’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec0c3b8d-65dc-4d7f-8c50-ca479f2b9167",
                                "sense_id": "ea8f501b-1d9d-3a4a-b6fb-1856e7f6c1d6",
                                "text": "Un autre texte sous-introduit dans l’exorde donne en réalité le sujet et le partage du discours : Egredere de terra tuâ (Ire partie), de cognatione tuâ (IIe partie) et de domo tuâ (IIIe partie)."
                            },
                            {
                                "example_id": "97737112-55fb-4abe-b5bb-8191c7191c4d",
                                "sense_id": "ea8f501b-1d9d-3a4a-b6fb-1856e7f6c1d6",
                                "text": "Quant à l’hypothèse, sous-introduite au moyen âge, qui tendrait à faire de la guerre, à la façon de l’ordalie ou combat judiciaire, une manifestation de la volonté du ciel, il va sans dire que Grotius et ses successeurs la rejettent."
                            }
                        ]
                    }
