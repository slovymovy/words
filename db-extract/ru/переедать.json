                        "cross_references": [
                            {
                                "target_word": "overeat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ba881a0-44ea-302d-a8d9-47778c9305f3",
                                        "entry_id": "92e28c3b-f7f4-36fe-ae7b-1cb0f9d0a116",
                                        "glosses": [
                                            "To eat too much."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd2482ff-34ee-3128-8b3d-c1a82300fc4d",
                                        "entry_id": "92e28c3b-f7f4-36fe-ae7b-1cb0f9d0a116",
                                        "glosses": [
                                            "To eat too much of."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c19b5ee-fa3f-4028-ace1-1d3c3c9af965",
                                                "sense_id": "dd2482ff-34ee-3128-8b3d-c1a82300fc4d",
                                                "text": "Overeat meat and you will not be flipping the genetic switches to grow a new body; instead, you will be opting for an early death even as you tone and strengthen your muscles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b73122a6-fc60-30ff-920d-c161f569bea4",
                                        "entry_id": "92e28c3b-f7f4-36fe-ae7b-1cb0f9d0a116",
                                        "glosses": [
                                            "To surfeit with eating."
                                        ],
                                        "tags": [
                                            "dated",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca73513d-ba7a-4e06-b1a5-7c29dda5f3a6",
                                                "sense_id": "b73122a6-fc60-30ff-920d-c161f569bea4",
                                                "text": "Mr. Nollekens, when he dined out of late years, always over-ate himself, particularly with the pastry and dessert."
                                            },
                                            {
                                                "example_id": "d3d7b7b3-148a-44c5-b75e-08fb96887b5a",
                                                "sense_id": "b73122a6-fc60-30ff-920d-c161f569bea4",
                                                "text": "At breakfast they overate themselves with buttered toast, and \"had eaten so much that they could not learn with any pleasure,\" […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
