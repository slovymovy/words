                "translations": [
                    {
                        "translation_id": "c858d395-64c9-4c33-b562-e7275cd6428f",
                        "source_entry_id": "8e81e7cf-4f4d-3454-a088-07bdaa924529",
                        "source_sense_id": "89a80e81-11c9-3ee2-823b-fddae7e02742",
                        "target_lang_word": "cabotage",
