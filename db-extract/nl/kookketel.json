                "senses": [
                    {
                        "sense_id": "feefe8d4-e61b-31bb-867d-26bdf8491b59",
                        "entry_id": "ee91a254-aaca-3279-a591-859a3be5531d",
                        "glosses": [
                            "metalen vat waarin men een vloeistof kan verhitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e742f6b-fb54-461d-a5d8-ae65598ce94c",
                                "sense_id": "feefe8d4-e61b-31bb-867d-26bdf8491b59",
                                "text": "De waarheid was geen boek meer maar een machine; het ventiel van zijn lippen ging al weer open onder het begrip dat als sissende stoom naar buiten brak uit de kookketel van zijn geest."
                            },
                            {
                                "example_id": "8a50cce7-e3cc-4f4d-8557-67bf50f94e42",
                                "sense_id": "feefe8d4-e61b-31bb-867d-26bdf8491b59",
                                "text": "Agenten vielen ook binnen bij een garagebox in Groenekan, in Utrecht. Daar stonden jerrycans met duizenden liters chemicaliën en onder meer een grote kookketel die gebruikt wordt bij de productie van drugs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a190071-7982-4769-a5a7-8a29a9d9702e",
                        "source_entry_id": "ee91a254-aaca-3279-a591-859a3be5531d",
                        "source_sense_id": "feefe8d4-e61b-31bb-867d-26bdf8491b59",
                        "source_sense_description": "metalen vat waarin men een vloeistof kan verhitten",
                        "target_lang_word": "cauldron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cauldron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e2b6951-4107-3aca-962d-da5b32a55fe0",
                                        "entry_id": "119381df-7a44-3d40-9809-7ad7b64a5e85",
                                        "glosses": [
                                            "A large bowl-shaped pot used for boiling over an open flame."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65d22dea-8393-4196-9a3a-c7ac63b6bb1e",
                                                "sense_id": "3e2b6951-4107-3aca-962d-da5b32a55fe0",
                                                "text": "Double, double, toile and trouble; / Fire burne, and Cauldron bubble."
                                            },
                                            {
                                                "example_id": "f580938f-0ac6-4277-8bf9-efe4121b10c7",
                                                "sense_id": "3e2b6951-4107-3aca-962d-da5b32a55fe0",
                                                "text": "[…] I don't expect you will really understand the beauty of the softly simmering cauldron with its shimmering fumes, the delicate power of liquids that creep through human veins, bewitching the mind, ensnaring the senses … […]"
                                            },
                                            {
                                                "example_id": "2563dc12-2efb-4595-8927-b15caa2756b4",
                                                "sense_id": "3e2b6951-4107-3aca-962d-da5b32a55fe0",
                                                "text": "Large cauldrons are a little tricky to locate, but are well worth the search if you have a place to safely store and use one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af0fff1f-a43b-366c-8315-4e1f0f49f6ba",
                                        "entry_id": "119381df-7a44-3d40-9809-7ad7b64a5e85",
                                        "glosses": [
                                            "A strategic encirclement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19ec888d-15c4-492b-8ca9-dfdc93601a77",
                                                "sense_id": "af0fff1f-a43b-366c-8315-4e1f0f49f6ba",
                                                "text": "After having defended the constantly shrinking perimeter of their position for over two weeks, the encircled German units in the Cherkassy “cauldron” were ordered to break out."
                                            },
                                            {
                                                "example_id": "1d87678d-b89b-4e6f-b9bf-3f60ba203bf1",
                                                "sense_id": "af0fff1f-a43b-366c-8315-4e1f0f49f6ba",
                                                "text": "The cauldron had been formed, and some 2,000 Soviets had been encircled in it; the division estimated this quite a success."
                                            },
                                            {
                                                "example_id": "e10f8cc9-1f93-44d9-b78a-02dc9660f719",
                                                "sense_id": "af0fff1f-a43b-366c-8315-4e1f0f49f6ba",
                                                "text": "This could have been avoided had the Ukrainian Army either evacuated the troops in the southern cauldron once it became clear that their position was untenable or reinforced them substantially in order to reopen supply lines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d0b7706-8cd0-34a5-939d-f0f59d3f454a",
                                        "entry_id": "119381df-7a44-3d40-9809-7ad7b64a5e85",
                                        "glosses": [
                                            "An unsettled difficult situation or place."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e7f3075-9a8a-4b1a-8ad0-978c414815d4",
                                                "sense_id": "0d0b7706-8cd0-34a5-939d-f0f59d3f454a",
                                                "text": "a cauldron of discontent"
                                            },
                                            {
                                                "example_id": "1a080794-5dba-42e2-8e2e-d8f331ad0ce2",
                                                "sense_id": "0d0b7706-8cd0-34a5-939d-f0f59d3f454a",
                                                "text": "With Old Trafford a cauldron of noise, Kobbie Mainoo somehow kept his cool to curl an equaliser into the corner of the Lyon goal as the tie entered its final minute."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
