                        "entry_id": "d5ab6313-d97a-3a2b-a069-153338ffac9e",
                        "glosses": [
                            "Solutions simplistes et irréalistes car négligeant des obstacles majeurs."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "63cad168-379c-4ab5-9bb7-2597fb04b7a1",
                                "sense_id": "9ea73c23-b7cc-3daa-ac22-60c75495911b",
                                "text": "Au lieu de fuir et de tout rejeter en bloc, apprenez à renvoyer les sollicitations à leurs expéditeurs et aux rois du « yakafokon ». Répondez-leur plutôt : « Vous avez raison », ou « C’est une très bonne idée ». Ajoutez immédiatement : « Et si vous vous en occupiez ? » […]"
                            }
                        ]
                    }
                ],
                "translations": [
