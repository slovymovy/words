                    "sense_id": "9e789953-01d5-3060-ac0f-ca316b9157b5",
                    "sense_definition": "Qui éprouve une terreur intense, frappé d'une très grande frayeur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "peur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant <w>terrifié</w> se cachait sous la table pendant le violent orage.",
                            "target_lang_translations": {
                                "en": "The <w>terrified</w> child hid under the table during the violent storm.",
                                "ru": "<w>Испуганный</w> ребёнок прятался под столом во время сильной грозы.",
                                "nl": "Het <w>doodsbange</w> kind verstopte zich onder de tafel tijdens het hevige onweer.",
                                "de": "Das <w>verängstigte</w> Kind versteckte sich während des heftigen Gewitters unter dem Tisch.",
                                "pl": "<w>Przerażone</w> dziecko chowało się pod stołem podczas gwałtownej burzy.",
                                "it": "Il bambino <w>spaventato</w> si nascondeva sotto il tavolo durante il violento temporale.",
                                "cs": "<w>Vyděšené</w> dítě se schovávalo pod stolem během silné bouře.",
                                "tr": "Şiddetli fırtına sırasında <w>korkmuş</w> çocuk masanın altına saklanıyordu.",
                                "es": "El niño <w>aterrorizado</w> se escondía bajo la mesa durante la violenta tormenta.",
                                "zh": "那个<w>惊恐</w>的孩子在猛烈的暴风雨中躲在桌子底下。"
                            }
                        },
                        {
                            "text": "Elle avait l'air absolument <w>terrifié</w> après avoir entendu cet étrange bruit dans le grenier.",
                            "target_lang_translations": {
                                "en": "She looked absolutely <w>terrified</w> after hearing that strange noise in the attic.",
                                "ru": "Она выглядела совершенно <w>испуганной</w> после того, как услышала странный шум на чердаке.",
                                "nl": "Ze zag er volkomen <w>doodsbang</w> uit nadat ze dat vreemde geluid op zolder had gehoord.",
                                "de": "Sie sah völlig <w>verängstigt</w> aus, nachdem sie dieses seltsame Geräusch auf dem Dachboden gehört hatte.",
                                "pl": "Wyglądała na zupełnie <w>przerażoną</w> po tym, jak usłyszała ten dziwny hałas na strychu.",
                                "it": "Aveva l'aria completamente <w>spaventata</w> dopo aver sentito quello strano rumore in soffitta.",
                                "cs": "Vypadala naprosto <w>vyděšená</w>, poté co na půdě uslyšela ten podivný zvuk.",
                                "tr": "Tavan arasındaki o garip sesi duyduktan sonra tamamen <w>dehşete kapılmış</w> görünüyordu.",
                                "es": "Parecía completamente <w>aterrorizada</w> después de oír aquel extraño ruido en el desván.",
                                "zh": "她听到阁楼里传来的那阵奇怪声响后，看起来非常<w>害怕</w>。"
                            }
                        }
                    ],
