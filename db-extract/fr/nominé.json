                "senses": [
                    {
                        "sense_id": "193ecd36-38b2-3a92-9dbc-3f7eeffa83dd",
                        "entry_id": "f0b59d65-3a3a-35ea-b688-aa166a7fd6a9",
                        "glosses": [
                            "Candidat présélectionné pour un concours de cinéma, de télévision, ou par un parti politique."
                        ],
                        "tags": [
                            "Usage critiqué"
                        ],
                        "examples": [
                            {
                                "example_id": "c98107d8-0cf6-4b59-8591-0cf5ef91b611",
                                "sense_id": "193ecd36-38b2-3a92-9dbc-3f7eeffa83dd",
                                "text": "Un nominé à la cérémonie des Oscars."
                            },
                            {
                                "example_id": "3faf05ba-e4e5-4ccd-857d-de4db06bfa4b",
                                "sense_id": "193ecd36-38b2-3a92-9dbc-3f7eeffa83dd",
                                "text": "Cette grande Convention nationale est d’habitude l’occasion pour les anciens candidats de renouveler publiquement leur soutien pour le nominé, et ainsi pour le Parti d’afficher son unité."
                            },
                            {
                                "example_id": "0b449802-0384-40e6-b47e-7ef5405c6687",
                                "sense_id": "193ecd36-38b2-3a92-9dbc-3f7eeffa83dd",
                                "text": "J’invite les nominés à se rapprocher de la scène... Victoria Asting, Shirley Ray, Léna Reed, Alexia Baker... Dany Coopley, Jimmy Demetter, Adrian Smith, Jefferson Mac Cleenlay."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34c42718-81b8-4ddc-80b3-52df353c3274",
                        "source_entry_id": "f0b59d65-3a3a-35ea-b688-aa166a7fd6a9",
                        "source_sense_id": "193ecd36-38b2-3a92-9dbc-3f7eeffa83dd",
                        "target_lang_word": "nominee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nominee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6b72b46-f0f3-3cc4-b2b2-5f869915da6e",
                                        "entry_id": "1cbbd38d-a1eb-3992-a51f-12aedae4d6a2",
                                        "glosses": [
                                            "A person named, or designated, by another, to any office, duty, or position; one nominated, or proposed, by others for office or for election to office."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a869097-c365-33f9-96fd-7b0f8946531a",
                                        "entry_id": "1cbbd38d-a1eb-3992-a51f-12aedae4d6a2",
                                        "glosses": [
                                            "A person or organisation in whose name a security is registered though true ownership is held by another party, called nominator, especially for the purpose of concealing the identity of the nominator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b78c5de5-5244-4ce0-a705-3718ef7af470",
                                                "sense_id": "9a869097-c365-33f9-96fd-7b0f8946531a",
                                                "text": "The Supreme Court confiscated half of Thaksin Shinawatra's fortune after finding that, while being Prime Minister, he held shares in commercial companies through nominees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6e3a0a2-0a81-3f5a-aebd-65b7bd58c291",
                                        "entry_id": "1cbbd38d-a1eb-3992-a51f-12aedae4d6a2",
                                        "glosses": [
                                            "A person to whom the holder of a copyhold estate surrenders their interest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
