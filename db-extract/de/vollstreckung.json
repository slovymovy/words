                "senses": [
                    {
                        "sense_id": "cdb3c35d-211b-3a8b-88c0-6038ff6b237e",
                        "entry_id": "d147b0ad-e943-35ef-90b5-41acb286f578",
                        "glosses": [
                            "Umsetzung, Vollzug eines Urteils"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d11c5ad-9d41-4177-a45b-b85ec5b39c3b",
                                "sense_id": "cdb3c35d-211b-3a8b-88c0-6038ff6b237e",
                                "text": "Die Vollstreckung des Todesurteils blieb bis zuletzt umstritten."
                            },
                            {
                                "example_id": "b365bfd2-4c9f-4952-a385-7543ff7532ac",
                                "sense_id": "cdb3c35d-211b-3a8b-88c0-6038ff6b237e",
                                "text": "„Pierre begriff nicht, dass er gerettet war, dass man ihn und die übrigen nur hergeführt hatte, um sie der Vollstreckung der Todesurteile beiwohnen zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a45ec213-cd32-39f6-b7d0-6f7355fc066b",
                        "entry_id": "d147b0ad-e943-35ef-90b5-41acb286f578",
                        "glosses": [
                            "Vollzug eines Vorhabens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b518ee8-3fd8-4240-a733-e3a602fbcbab",
                                "sense_id": "a45ec213-cd32-39f6-b7d0-6f7355fc066b",
                                "text": "Bei der Vollstreckung der Vorstandsbeschlüsse gab es großen Widerstand."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55ff30b2-5306-45ea-8056-493fd4c8b44d",
                        "source_entry_id": "d147b0ad-e943-35ef-90b5-41acb286f578",
                        "source_sense_id": "cdb3c35d-211b-3a8b-88c0-6038ff6b237e",
