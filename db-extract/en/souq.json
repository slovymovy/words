                                "target_senses": [
                                    {
                                        "sense_id": "b151e56e-e45f-3073-b145-d044f91542d3",
                                        "entry_id": "6281514e-0535-33be-a6bb-bc2b9a4a3a89",
                                        "glosses": [
                                            "arabisches Wirtschaftsviertel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9150ef86-098f-4dac-b8c8-4164fd29e46e",
                                                "sense_id": "b151e56e-e45f-3073-b145-d044f91542d3",
                                                "text": "„Ich wich arabischen Matronen aus und den Karrenschiebern, den Arbeitsbienen der Souks.“"
                                            },
                                            {
                                                "example_id": "1d56881d-8b42-43ef-b536-ef7cd4cc3f1b",
                                                "sense_id": "b151e56e-e45f-3073-b145-d044f91542d3",
                                                "text": "„Amerika hatte im Irak ein Wespennest angestochen, und diese Wespen, die bereits durch sämtliche Souks und Moscheen der arabischen Welt schwirrten, fingen nun auch an, die Einkaufszentren und öffentlichen Verkehrsmittel westlicher Großstädte heimzusuchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
