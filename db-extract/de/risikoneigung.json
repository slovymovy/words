                "senses": [
                    {
                        "sense_id": "90fc1f7b-f234-388e-b9eb-82e0cc88bc5f",
                        "entry_id": "0b9d3eee-4931-36a2-bd63-a128dca29b32",
                        "glosses": [
                            "Bereitschaft, eine Gefahr/ein Risiko einzugehen"
                        ],
                        "tags": [
                            "Wirtschaftsjargon"
                        ],
                        "examples": [
                            {
                                "example_id": "435ecd3f-0d9d-4913-a99b-19bd34de4660",
                                "sense_id": "90fc1f7b-f234-388e-b9eb-82e0cc88bc5f",
                                "text": "„Die Partizipation an den Chancen erhöht seine Risikoneigung, die Partizipation an den Verlusten reduziert seine Risikoneigung.“"
                            },
                            {
                                "example_id": "91f12f47-f908-41b6-9a43-36bed506ff71",
                                "sense_id": "90fc1f7b-f234-388e-b9eb-82e0cc88bc5f",
                                "text": "„Ihre Strategie muss zu Ihrem Anlageziel, Ihrem Anlagehorizont, Ihrer Lebenssituation und Ihrer Risikoneigung passen.“"
                            },
                            {
                                "example_id": "2ed99ed9-ec50-494e-8cb7-29cb465451ba",
                                "sense_id": "90fc1f7b-f234-388e-b9eb-82e0cc88bc5f",
                                "text": "„Die Risikostrategie gibt Aufschluss über die gewünschte oder erwartete Risikoneigung des Unternehmens, die sich an den Unternehmenszielen ausrichtet.“"
                            },
                            {
                                "example_id": "326afc02-e841-44c2-892a-d47154646319",
                                "sense_id": "90fc1f7b-f234-388e-b9eb-82e0cc88bc5f",
                                "text": "„Zur Erhebung der Risikoneigung existieren sehr unterschiedliche Messmodelle.“"
                            },
                            {
                                "example_id": "6dbd8516-aa80-4430-b154-6cdc8a954d3c",
                                "sense_id": "90fc1f7b-f234-388e-b9eb-82e0cc88bc5f",
                                "text": "„1Die Risikoneigung kann durch eine Nutzenkurve dargestellt werden, wenn die Risikoaffinität des Anlegers bekannt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
