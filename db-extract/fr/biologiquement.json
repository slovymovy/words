                "senses": [
                    {
                        "sense_id": "6e1e340f-e303-3028-ab8f-de4578fb1a88",
                        "entry_id": "2c0a8433-b984-386e-8e10-85fb005dabd8",
                        "glosses": [
                            "Du point de vue biologique."
