                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betelgeuze",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ebfc53da-26ca-384a-9126-8b7b974d672a",
                                        "entry_id": "ca47831c-baf4-3575-8f7f-b226386d09bf",
                                        "glosses": [
                                            "de één na helderste ster in het sterrenbeeld Orion, na Rigel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "454bf173-cc1e-4af7-9d67-390f51bf77d3",
                                                "sense_id": "ebfc53da-26ca-384a-9126-8b7b974d672a",
                                                "text": "Betelgeuze is aan het eind van zijn leven, en kan op 'ieder moment' supernova worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40af63be-0cc7-43c2-947e-321b319b8a4b",
                        "source_entry_id": "8f809c90-9942-3017-a3ee-969fa9bc11f7",
