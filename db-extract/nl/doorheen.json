                    },
                    {
                        "sense_id": "94cf01a3-99fc-389c-ae59-e3e1e0fa9362",
                        "entry_id": "1ac890c4-0f4f-3135-adfe-45681615e129",
                        "glosses": [
                            "een ruimte helemaal doorkruisend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08e4de9a-48c2-4d4e-a586-9cbb8f87d89e",
                                "sense_id": "94cf01a3-99fc-389c-ae59-e3e1e0fa9362",
                                "text": "In een oud warenhuis loop je doorheen de geschiedenis van het beeldverhaal in Belgie"
                            },
                            {
                                "example_id": "0a40897f-91d6-4300-b7b1-e31a33651549",
                                "sense_id": "94cf01a3-99fc-389c-ae59-e3e1e0fa9362",
                                "text": "Ze voelde zich groter geworden, alsof er een lang verborgen deur in haar was opengegaan waarachter een kronkelige gang lag waar ze nu doorheen rende."
                            }
                        ]
                    }
                ],
