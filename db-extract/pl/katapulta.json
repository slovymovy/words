                                "target_senses": [
                                    {
                                        "sense_id": "7626e496-10d6-3d8c-b84a-538e2fc2a3b8",
                                        "entry_id": "e31b3c4c-907b-332d-9c25-e594dda892ff",
                                        "glosses": [
                                            "A device or weapon for throwing or launching large objects."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75a13f07-e67f-3e90-a575-66f66be18e5a",
                                        "entry_id": "e31b3c4c-907b-332d-9c25-e594dda892ff",
                                        "glosses": [
                                            "A mechanical aid on aircraft carriers designed to help airplanes take off from the flight deck."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2d40530-0644-3ce0-86d2-1fc885d55168",
                                        "entry_id": "e31b3c4c-907b-332d-9c25-e594dda892ff",
                                        "glosses": [
                                            "A slingshot."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb0b6aa1-e9e2-3268-a631-bfb0b8253bb2",
                                        "entry_id": "e31b3c4c-907b-332d-9c25-e594dda892ff",
                                        "glosses": [
                                            "An instance of firing a missile from a catapult."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81e9d55f-e430-39e8-8ab8-35a9e713ab53",
                                        "entry_id": "e31b3c4c-907b-332d-9c25-e594dda892ff",
                                        "glosses": [
                                            "An instance of firing something, as if from a catapult."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a18d882-f70b-4c72-9e39-f8ae0488f292",
                                                "sense_id": "81e9d55f-e430-39e8-8ab8-35a9e713ab53",
                                                "text": "The visitors were given notice of what was to come when Huth headed wide from a Rory Delap long throw but failed to heed the warning, allowing the German defender to rise unmarked to meet another Delap catapult and plant his header into the net after 12 minutes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "catapult",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85300e8f-1136-3536-bf45-c023471f94e2",
                                        "entry_id": "d2327ffa-37a2-3819-ad0a-07d6acadc38d",
                                        "glosses": [
                                            "To fire a missile from a catapult."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "193c1535-b935-3d52-8b08-70398886de06",
                                        "entry_id": "d2327ffa-37a2-3819-ad0a-07d6acadc38d",
                                        "glosses": [
                                            "To fire or launch something, as if from a catapult."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "935c75a1-80d2-3ee8-b4fe-dd54b4c44ac0",
                                        "entry_id": "d2327ffa-37a2-3819-ad0a-07d6acadc38d",
                                        "glosses": [
                                            "To increase the status of something rapidly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8e934d5-bfeb-4be4-b0e2-67dd1393e1a8",
                                                "sense_id": "935c75a1-80d2-3ee8-b4fe-dd54b4c44ac0",
                                                "text": "The candidate selection for running mate has catapulted her to the national scene."
                                            },
                                            {
                                                "example_id": "694465c1-2c56-4302-9029-a78f395a623e",
                                                "sense_id": "935c75a1-80d2-3ee8-b4fe-dd54b4c44ac0",
                                                "text": "I was catapulted without preparation into the most difficult job any mortal man can hold. My duties would not wait a week, or a day, or even an hour."
                                            },
                                            {
                                                "example_id": "9114b8b7-be50-4808-85a4-10422790fba1",
                                                "sense_id": "935c75a1-80d2-3ee8-b4fe-dd54b4c44ac0",
                                                "text": "England will not be catapulted among the favourites for Euro 2012 as a result of this win, but no victory against Spain is earned easily and it is right they take great heart from their efforts as they now prepare to play Sweden at Wembley on Tuesday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56397ffa-f6a8-34f2-94f4-de34082702ee",
                                        "entry_id": "d2327ffa-37a2-3819-ad0a-07d6acadc38d",
                                        "glosses": [
                                            "To be fired from a catapult or as if from a catapult."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d13ad9d-48cd-3183-ad9c-27e407f69ada",
                                        "entry_id": "d2327ffa-37a2-3819-ad0a-07d6acadc38d",
                                        "glosses": [
                                            "To have one's status increased rapidly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7959ca5-b875-40a5-8d3b-5aceaba7188d",
                                                "sense_id": "8d13ad9d-48cd-3183-ad9c-27e407f69ada",
                                                "text": "She catapulted to the national scene following her selection by the candidate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3205fef6-5c56-4428-8a1d-3f3094fff57b",
                        "source_entry_id": "b69dd501-25fe-373d-abeb-b231bb36c8e9",
                        "source_sense_id": "b6e5ea71-ac57-34f5-976a-434149aaf822",
                        "target_lang_word": "catapulte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catapulte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "550aef09-6d83-3460-8a11-08a00f398b03",
                                        "entry_id": "07d5239b-3719-378f-b7eb-901d27acd8b6",
                                        "glosses": [
                                            "Machine de guerre dont les anciens se servaient pour lancer des pierres ou des traits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32aa24cb-3332-4896-8223-30ba4dac40d9",
                                                "sense_id": "550aef09-6d83-3460-8a11-08a00f398b03",
                                                "text": "Le grand nombre de dondaines et demi-dondaines utilisées pour le siège, ne permet pas de supposer qu'il s'agisse, en l’espèce, de catapultes. Certains gros traits d'arbalète étaient aussi appelés dondaines ou flèches dondaines, dit le Dictionnaire de Godefroy."
                                            },
                                            {
                                                "example_id": "58760173-1133-499f-8927-d8bf12cbdc75",
                                                "sense_id": "550aef09-6d83-3460-8a11-08a00f398b03",
                                                "text": "Les assiégés opposent machines à machines, en se servant de balistes, de catapultes, de scorpions, d’arbalètes, et de différentes sortes de frondes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ea7d9a3-21a8-3aac-af55-6e623060013f",
                                        "entry_id": "07d5239b-3719-378f-b7eb-901d27acd8b6",
                                        "glosses": [
                                            "Appareil rappelant la forme de la catapulte et servant à lancer des objets divers."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5b693b5-d9f4-4b5d-ad83-4798e08bb8d0",
                                                "sense_id": "4ea7d9a3-21a8-3aac-af55-6e623060013f",
                                                "text": "Où est ta catapulte, petit? Ha! Ha! Ha!"
                                            },
                                            {
                                                "example_id": "fc768d2e-7d4f-447d-bc7b-d28530e56907",
                                                "sense_id": "4ea7d9a3-21a8-3aac-af55-6e623060013f",
                                                "text": "Sacs de chips suspendus à une corde à linge, bras robotisés, filet pour nettoyer la piscine, catapultes, pinces à BBQ, citrouille ornée du fameux « deux mètres »…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dfee05a-e2e2-30fb-b195-014f2a8b8660",
                                        "entry_id": "07d5239b-3719-378f-b7eb-901d27acd8b6",
                                        "glosses": [
                                            "Engin qui sert à lancer un avion, à partir d’un porte-avions ou d’un autre navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "246937e1-64e0-434e-8655-82b5c5a34647",
                                                "sense_id": "8dfee05a-e2e2-30fb-b195-014f2a8b8660",
                                                "text": "Le Norddeutsche Lloyd a fait installer sur le paquebot Bremen une catapulte destinée au lancement d’un hydravion à une distance d’environ 1.000 kilomètres des côtes, ceci dans le but de gagner du temps pour la distribution du courrier et la remise des papiers de douane."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "catapulte",
                                "target_lang_code": "fr",
                                "target_senses": [
