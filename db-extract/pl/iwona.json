                                    {
                                        "sense_id": "67c05d1a-aea1-30fc-81af-8792103a887c",
                                        "entry_id": "b5f7a3e2-0056-3f9c-8c22-52b44d729327",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c26e56b-1346-44bc-952b-920fa37dd66e",
                                                "sense_id": "67c05d1a-aea1-30fc-81af-8792103a887c",
                                                "text": "Les jeunes filles prenaient garde de demeurer des jeunes filles. Yvonne ayant négligé cette précaution, les amis de Robert, qui à tour de rôle avaient profité d’elle, avertirent obligeamment mon cousin et le mariage ne se fit pas."
                                            },
                                            {
                                                "example_id": "79d772f6-97f9-4d56-b07c-1c7509f381f2",
                                                "sense_id": "67c05d1a-aea1-30fc-81af-8792103a887c",
                                                "text": "’vous en faites pas, mademoiselle Yvonne, je veille au grain…"
                                            },
                                            {
                                                "example_id": "8142008e-14c5-4ae1-a969-e7e9bd983c2e",
                                                "sense_id": "67c05d1a-aea1-30fc-81af-8792103a887c",
                                                "text": "Il a travaillé deux ans avec Yvonne Loriod (1924-2010), célèbre pianiste classique française, seconde épouse d’Olivier Messiaen, compositrice souvent oubliée."
                                            }
                                        ]
                                    }
                                ]
