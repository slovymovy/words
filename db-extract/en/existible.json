                    {
                        "sense_id": "c05b8f64-a394-3ff2-9684-338ce09533cd",
                        "entry_id": "16a1a119-c8a6-33b4-81e6-9a1a877c451b",
                        "glosses": [
                            "Capable of existence."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "827073fa-b49b-4b31-9e01-31f216121934",
                                "sense_id": "c05b8f64-a394-3ff2-9684-338ce09533cd",
                                "text": "That all Corporeal and Sensible Perfections, are in some Analogous way, Existible, in the Humane Mind."
                            },
                            {
                                "example_id": "be07c23f-3307-49f7-9f49-47105ec31dd7",
                                "sense_id": "c05b8f64-a394-3ff2-9684-338ce09533cd",
                                "text": "Similarly, when we deal with Being, it might mean an actually existent thing; or it might mean simply whatever is capable of an existence, whatever presents an actualizable content, whatever is an existible; or lastly, it might mean existence in the abstract, as when we speak of the Bing that is given to some possible essence."
                            },
                            {
                                "example_id": "698c9a06-16a7-4a74-bdff-26d143127e5f",
                                "sense_id": "c05b8f64-a394-3ff2-9684-338ce09533cd",
                                "text": "A thing may be regarded in two ways: (1) as an existible reality, and (2) as an understandable reality."
                            }
                        ]
                    }
