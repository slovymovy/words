                "senses": [
                    {
                        "sense_id": "ed529ae6-4bef-311d-a7d6-512f74188a4c",
                        "entry_id": "c9b3a4b6-ecc2-3636-8683-209e201d0260",
                        "glosses": [
                            "(abgezogenes) Fell eines Hamsters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d262e011-907f-4f58-8221-532d68fdf389",
                                "sense_id": "ed529ae6-4bef-311d-a7d6-512f74188a4c",
                                "text": "„Ich tauschte mit einer Freundin meinen Persianermantel gegen einen schäbigen Innenpelz aus Hamsterfell.“"
                            },
                            {
                                "example_id": "7abfeb75-fb9f-4b84-97b1-dd677e71bd7d",
                                "sense_id": "ed529ae6-4bef-311d-a7d6-512f74188a4c",
                                "text": "„Immerhin gelten Hamsterfelle zu Beginn des 19. Jahrhunderts z.B. für die Herrschaft Gotha, aber auch andere Regionen Deutschlands als ein wichtiges Exportgut.“"
                            },
                            {
                                "example_id": "b17258dd-0a7d-4bb3-a85f-cb705ec7ac8a",
                                "sense_id": "ed529ae6-4bef-311d-a7d6-512f74188a4c",
                                "text": "„Das Edikt geht am 2.6.1724 an die Magdeburger Cammer und stößt bei den Untertanen sofort auf heftigen Widerstand. Die Landeskinder beschweren sich, daß die jetzt geforderte doppelte Zahl von Hamsterfellen eine unbillige Forderung sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
