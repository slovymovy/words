                    {
                        "translation_id": "22aa12b8-ce3a-40b6-a434-0bb8fecfb4a7",
                        "source_entry_id": "c06f53d3-9fba-3ada-a50c-ac6de08eab76",
                        "source_sense_id": "5d6a0795-df64-3ef7-923b-c54d44317535",
                        "target_lang_word": "секундант",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "секундант",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "986ed4a7-9055-3443-b56a-34fc8dda065d",
                                        "entry_id": "d463aa0a-8175-3513-a54c-a5e6a0f77804",
                                        "glosses": [
                                            "истор. свидетель и посредник, сопровождающий каждого из сражающихся на дуэли"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d2a557b-b245-4421-a78d-5ef753ff5944",
                                                "sense_id": "986ed4a7-9055-3443-b56a-34fc8dda065d",
                                                "text": "— Я принимаю ваш вызов. Извольте прислать ко мне вашего секунданта."
                                            },
                                            {
                                                "example_id": "85802520-b812-4589-8804-6da180057391",
                                                "sense_id": "986ed4a7-9055-3443-b56a-34fc8dda065d",
                                                "text": "Доктор согласился быть моим секундантом; я дал ему несколько наставлений насчёт условий поединка."
                                            },
                                            {
                                                "example_id": "f19351cc-8ab1-49fb-8a6e-9bb172009f0d",
                                                "sense_id": "986ed4a7-9055-3443-b56a-34fc8dda065d",
                                                "text": "Я обратился к секундантам, объявив, что нынче стрелять не намерен, и поединок тем и кончился."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d86c6de6-120d-325d-8907-3c19ad7f0007",
                                        "entry_id": "d463aa0a-8175-3513-a54c-a5e6a0f77804",
                                        "glosses": [
                                            "спорт. посредник и помощник участника спортивного состязания (в боксе, в шахматах и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c1cbbe8-4231-4823-af64-5c8eabe19a88",
                                                "sense_id": "d86c6de6-120d-325d-8907-3c19ad7f0007",
                                                "text": "Но тут Крамник расстался с одним из своих слонов, разменял пару легких фигур и нашел идею, его секунданту явно незнакомую."
                                            },
                                            {
                                                "example_id": "c564ef87-b771-45d0-b472-23e7f041bc0a",
                                                "sense_id": "d86c6de6-120d-325d-8907-3c19ad7f0007",
                                                "text": "Судье на ринге и секундантам боксера в данном случае виднее, имеет ли смысл продолжать бой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
