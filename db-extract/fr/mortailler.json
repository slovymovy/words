                "senses": [
                    {
                        "sense_id": "33e3f8f6-0464-38f4-9e44-eb7a7f434ee8",
                        "entry_id": "d63445d7-50b0-31fd-af42-fa118bb07bf7",
                        "glosses": [
                            "Soumettre au droit de mortaille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d7c2e6b-197b-4c46-b798-3bd130b7347f",
                                "sense_id": "33e3f8f6-0464-38f4-9e44-eb7a7f434ee8",
                                "text": "Mais nul seigneur ne peut et ne doit prendre aucune suite de gens serfs habitant et demeurant dedans les fins et limites de la ville et septaine de Bourges ni sur iceux exiger aucun droit à cause de la personne et du corsage d’iceux manans et habitants ni d’aucun d’eux, ni iceux mortailler ou prendre mortaille sur iceux ni aucun d’eux."
                            },
                            {
                                "example_id": "2ccd47e4-f172-4389-9d0b-a65ad33e64bb",
                                "sense_id": "33e3f8f6-0464-38f4-9e44-eb7a7f434ee8",
                                "text": "Ces braves gens devaient être merveilleusement incorporés à la glèbe, et notre ancienne noblesse n’éprouvait assurément que liesse et contentement à tailler et mortailler une nature aussi débonnairement serve."
                            }
                        ]
                    }
