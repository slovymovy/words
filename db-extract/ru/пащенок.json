                "senses": [
                    {
                        "sense_id": "b6c1fbc2-dd06-3e6b-8126-6966f869e3a5",
                        "entry_id": "fc0df4db-3df6-3806-8c6e-19ac173715fd",
                        "glosses": [
                            "прост., бран. испорченный малолеток; молокосос, щенок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a5c8188-c1d2-4145-b9a3-c64c7078b458",
                                "sense_id": "b6c1fbc2-dd06-3e6b-8126-6966f869e3a5",
                                "text": "― Да как ты смел, пащенок, холопский свой нос ко мне совать?.."
                            },
                            {
                                "example_id": "2da6f4c5-effc-4bfc-8722-444fc5745fed",
                                "sense_id": "b6c1fbc2-dd06-3e6b-8126-6966f869e3a5",
                                "text": "― Говорю ― мразь! Эко дрожит, пащенок, за свою жизненку."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab1e7164-65e3-4e34-abdf-c5b3655a8085",
                        "source_entry_id": "fc0df4db-3df6-3806-8c6e-19ac173715fd",
                        "source_sense_id": "b6c1fbc2-dd06-3e6b-8126-6966f869e3a5",
