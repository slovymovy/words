                    {
                        "sense_id": "5aa6f132-b2fb-3507-b3d9-aee3f61a923c",
                        "entry_id": "cc84a439-df0e-3b13-bd37-e284a10b4b70",
                        "glosses": [
                            "Ensemble des techniques de promotion d’un produit ou d’un service qui s’appuient sur Internet et ses outils (mailing, pub online, réseaux sociaux, e-shop…)."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "5d800df3-8039-4e27-8cef-ef0427cde320",
                                "sense_id": "5aa6f132-b2fb-3507-b3d9-aee3f61a923c",
                                "text": "Or, nous n’avons qu’un petit budget communication. Nous sommes donc occupés à repenser notre communication en l’orientant vers l’e-marketing."
                            },
                            {
                                "example_id": "434c033e-8769-46e7-80ff-4bae753dc6f2",
                                "sense_id": "5aa6f132-b2fb-3507-b3d9-aee3f61a923c",
                                "text": "En e-marketing, les entreprises tirent parti de différents canaux d’acquisitions tels que les moteurs de recherche, les médias sociaux, les courriels et les sites web d’autres organisations pour atteindre leur audience."
                            }
                        ]
                    }
