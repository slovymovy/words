                ],
                "senses": [
                    {
                        "sense_id": "10b1f784-a445-3528-8fe9-5a6fc45fbbfb",
                        "entry_id": "b6f2ff98-3e8c-3971-ae01-393fc3d7325f",
                        "glosses": [
                            "Se faire éclairer par la lune."
                        ],
                        "tags": [
                            "poetic",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "55406fb1-e0fa-4f6b-9651-8d8cd809ee6f",
                                "sense_id": "10b1f784-a445-3528-8fe9-5a6fc45fbbfb",
                                "text": "Quand, lavé des odeurs du jour, le jardinet\nDerrière la maison, en hiver, s’illunait,\nGisant au pied d’un mur, enterré dans la marne\nEt pour des visions écrasant son œil darne,\nIl écoutait grouiller les galeux espaliers."
                            },
                            {
                                "example_id": "e2ca76d9-c005-46d5-82e1-7100eaa18a18",
                                "sense_id": "10b1f784-a445-3528-8fe9-5a6fc45fbbfb",
                                "text": "Gigantesque boucan à la dérive, le village reculait dans les ténèbres tandis que s’illunait la voile lancée dans l’estuaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "ccdff361-81fd-3005-bc9d-8dabda611942",
                        "entry_id": "b6f2ff98-3e8c-3971-ae01-393fc3d7325f",
                        "glosses": [
                            "Former comme le croissant de la lune."
                        ],
                        "tags": [
                            "literary",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "64ba8f43-4fa7-43a7-b3d4-e3e99ec68e09",
                                "sense_id": "ccdff361-81fd-3005-bc9d-8dabda611942",
                                "text": "Quand elles passent près de lui, les pupilles siciliennes brasillent, les dents s’illunent. Elle hésite avant de lui accorder une danse seule à seul."
                            }
                        ]
                    }
                ],
