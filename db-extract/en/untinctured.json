                        "glosses": [
                            "Not tinctured; not tainted or coloured (with or by something)"
                        ],
                        "tags": [
                            "figuratively",
                            "not-comparable",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "df5f0d95-a1db-4334-85ce-b44819da8a40",
                                "sense_id": "d9a53e7f-80a8-35fc-ba74-4dce3712a929",
                                "text": "It is no wonder that the heart of a female, unimproved by reason, and untinctured with natural good sense, should flutter at the sight of such a gaudy thing […]"
                            },
                            {
                                "example_id": "ed8441d0-0099-4575-a535-441f9b2789c5",
                                "sense_id": "d9a53e7f-80a8-35fc-ba74-4dce3712a929",
                                "text": "[…] two or three little circumstances occurred ere they parted, which, in her anxious interpretation, denoted a recollection of Jane, not untinctured by tenderness, and a wish of saying more that might lead to the mention of her, had he dared."
                            },
                            {
                                "example_id": "6a21cf65-e9f1-4e87-946e-eef19682b15f",
                                "sense_id": "d9a53e7f-80a8-35fc-ba74-4dce3712a929",
                                "text": "Perhaps out of England such an intimacy could hardly have existed—an intimacy so utterly untinctured not only by passion itself but by the suspicion of it."
                            }
                        ]
                    }
