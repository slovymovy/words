                                    {
                                        "sense_id": "8394bbd1-5307-30a6-9ebc-f829f835226e",
                                        "entry_id": "421ff0ab-2599-3749-84ec-7641543b3057",
                                        "glosses": [
                                            "kobieta popularna, mająca duży wpływ na opinie i decyzje innych, zwykle twórczyni internetowa o znacznym rozgłosie posiadająca znaczne grono odbiorców"
                                        ],
                                        "tags": [
                                            "środ."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbab22fd-34c5-48d4-bb42-eb8f44b831cb",
                                                "sense_id": "8394bbd1-5307-30a6-9ebc-f829f835226e",
                                                "text": "Influencerki to osoby, które potrafią ze swojego hobby, zainteresowań bądź pomysłu na życie, stworzyć świetnie prosperujący interes, przynoszący niemałe zyski"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
