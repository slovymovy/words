                "senses": [
                    {
                        "sense_id": "64643d29-f08c-3732-a67a-d5ab13d05f05",
                        "entry_id": "be5c00a5-51bf-3784-9b48-f654c851ab4b",
                        "glosses": [
                            "Celui qui affronte, qui fait face."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "792de618-99b3-4007-91d0-f349021e55b1",
                                "sense_id": "64643d29-f08c-3732-a67a-d5ab13d05f05",
                                "text": "Personne en France ne se doute de l’incroyable puissance incessamment déployée par les Voyageurs, ces intrépides affronteurs de négations qui, dans la dernière bourgade, représentent le génie de la civilisation et les inventions parisiennes aux prises avec le bon sens, l’ignorance ou la routine des provinces."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae734798-c670-37f1-a211-f87d411fc0fc",
                        "entry_id": "be5c00a5-51bf-3784-9b48-f654c851ab4b",
                        "glosses": [
                            "Celui qui affronte par des insultes, des tromperies."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "dd0b10f4-bf8d-4a30-a0bd-d193faff942d",
                                "sense_id": "ae734798-c670-37f1-a211-f87d411fc0fc",
                                "text": "C’est un affronteur."
                            },
                            {
                                "example_id": "38f0dd22-ce08-4ec1-839c-c17820ea971e",
                                "sense_id": "ae734798-c670-37f1-a211-f87d411fc0fc",
                                "text": "Je hais les affronteurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "24d41d17-a389-33c6-b42c-3afb623e7889",
                        "entry_id": "be5c00a5-51bf-3784-9b48-f654c851ab4b",
                        "glosses": [
                            "Celui qui trompe."
                        ],
                        "tags": [],
                        "examples": [
                            {
