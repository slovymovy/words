                    "frequency": "High",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La vieille chaudière a soudainement <w>explosé</w> dans la cave pendant la nuit."
                        },
                        {
                            "text": "Les démineurs ont réussi à faire <w>exploser</w> le colis suspect sans blesser personne."
                        }
                    ],
                    "synonyms": [
                        "déflagrer"
                    ],
                    "antonyms": [
                        "imploser"
                    ],
                    "common_phrases": [
