                                        "sense_id": "768ad25c-be0c-31c1-8f19-9f4f6d118ca3",
                                        "entry_id": "22c0bbc5-badc-33e5-9614-8edaa1e7e5c3",
                                        "glosses": [
                                            "Infrastructure informatique."
                                        ],
