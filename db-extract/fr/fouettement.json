                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bf1082d5-17df-4ee9-a941-f3918f24b77c",
                        "entry_id": "90363967-9e86-3a43-9b37-918d36bcddbe",
                        "tags": [
                            "plural"
