                "senses": [
                    {
                        "sense_id": "4f6ccd57-a583-314d-a9c6-1f9553a61c9a",
                        "entry_id": "e9f6a5af-bc3e-3ee5-a6ca-e27e3ba27404",
                        "glosses": [
                            "stärkste Betonung eines Wortes im Satz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98dbed04-528e-4afe-b68a-98d6ea9fb4dd",
                                "sense_id": "4f6ccd57-a583-314d-a9c6-1f9553a61c9a",
                                "text": "Wenn man den Satzakzent unterschiedlich setzt, erhält der betreffende Satz verschiedene Bedeutungen. Z.B.: \"Péter ist heute gekommen\" (= nicht Inge oder sonst jemand) oder \"Peter ist héute gekommen\" (= nicht etwa schon gestern)."
                            },
                            {
                                "example_id": "69fbf876-f6a9-4da3-ba6d-2b1e3084a167",
                                "sense_id": "4f6ccd57-a583-314d-a9c6-1f9553a61c9a",
                                "text": "In schriftlichen Texten muss der Leser den Satzakzent in vielen Fällen durch Interpretation des betreffenden Satzes erschließen, während er in gesprochenen Texten durch den Sprecher vorgegeben ist."
                            },
                            {
                                "example_id": "7a6ccf73-e9f9-4674-9552-1c5aaa6ccf17",
                                "sense_id": "4f6ccd57-a583-314d-a9c6-1f9553a61c9a",
                                "text": "„Die einzelnen Morpheme mit ihren festen Wortakzenten können also frei beweglich, zusätzlich einen Satzakzent erhalten.“"
                            },
                            {
                                "example_id": "2fc70900-a076-4992-a96a-1751928e244c",
                                "sense_id": "4f6ccd57-a583-314d-a9c6-1f9553a61c9a",
                                "text": "„Auch der Satzakzent hebt eine Wortsilbe vor anderen heraus, aber der Bezugspunkt hat nun gewechselt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
