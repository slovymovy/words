{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "acab66f6-9162-3e04-9fe1-fc94f37801d5",
                    "sense_definition": "To tip or turn something over so that it is upside down or on its side.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>upended</w> the bucket to pour out all the sand.",
                            "target_lang_translations": {
                                "zh": "他把水桶<w>倒过来</w>，倒出了所有的沙子。"
                            }
                        },
                        {
                            "text": "The strong wind <w>upended</w> the small boat in the middle of the lake.",
                            "target_lang_translations": {
                                "zh": "强风把湖中央的小船<w>掀翻</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overturn",
                        "capsize",
                        "tip"
                    ],
                    "common_phrases": [
                        "upend a container"
                    ],
                    "target_lang_definitions": {
                        "zh": "将某物翻倒、倒转或侧翻"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "翻倒",
                                "target_lang_sense_clarification": "使倒下、翻过来"
                            },
                            {
                                "target_lang_word": "倒置",
                                "target_lang_sense_clarification": "使上下颠倒"
                            },
                            {
                                "target_lang_word": "掀翻",
                                "target_lang_sense_clarification": "用力翻转过来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cabfb24b-dd8c-33ab-aee7-dd60042c4e22",
                    "sense_definition": "To cause a major change or defeat by destroying or overthrowing an established system or idea.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "change_or_defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New evidence <w>upended</w> the long-held theory about the planet's origin.",
                            "target_lang_translations": {
                                "zh": "新证据<w>推翻</w>了长期以来关于该行星起源的理论。"
                            }
                        },
                        {
                            "text": "The political movement aimed to <w>upend</w> the corrupt government system.",
                            "target_lang_translations": {
                                "zh": "这场政治运动旨在<w>颠覆</w>腐败的政府体制。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overthrow",
                        "invalidate",
                        "subvert"
                    ],
                    "antonyms": [
                        "uphold",
                        "support"
                    ],
                    "target_lang_definitions": {
                        "zh": "颠覆、推翻（已确立的体制、理论或观念）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "颠覆",
                                "target_lang_sense_clarification": "推翻原有的体制、理论等"
                            },
                            {
                                "target_lang_word": "推翻",
                                "target_lang_sense_clarification": "彻底否定现存观念或政体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aabff59a-18b2-3bb8-9746-f9b8ec6feff4",
                    "sense_definition": "To cause a sudden and drastic disruption to someone's life or a situation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "change_or_defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden job loss <w>upended</w> their family's financial stability.",
                            "target_lang_translations": {
                                "zh": "突然失业<w>打破</w>了他们家庭的经济稳定。"
                            }
                        },
                        {
                            "text": "The global pandemic <w>upended</w> daily routines for millions of people.",
                            "target_lang_translations": {
                                "zh": "全球疫情<w>打乱</w>了数百万人原本的生活节奏。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disrupt",
                        "disturb",
                        "unsettle"
                    ],
                    "target_lang_definitions": {
                        "zh": "彻底打乱或扰乱（生活、局势等）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "打乱",
                                "target_lang_sense_clarification": "扰乱生活或计划"
                            },
                            {
                                "target_lang_word": "打破",
                                "target_lang_sense_clarification": "破坏原有的稳定或平静"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb75e078-380d-3f20-bde0-aba79e6b58ec",
                    "sense_definition": "To place an object so that it stands on its end.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>upend</w> the heavy logs to stack them more efficiently.",
                            "target_lang_translations": {
                                "zh": "你应该把那些沉重的原木<w>立起来</w>，以便更有效地堆放。"
                            }
                        },
                        {
                            "text": "The carpenter decided to <w>upend</w> the board to measure its height.",
                            "target_lang_translations": {
                                "zh": "木匠决定把木板<w>竖立</w>起来以测量它的高度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "upright"
                    ],
                    "target_lang_definitions": {
                        "zh": "将物体竖立起来，使其端头着地"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "竖立",
                                "target_lang_sense_clarification": "将物体垂直立起"
                            },
                            {
                                "target_lang_word": "立起",
                                "target_lang_sense_clarification": "使物体直立起来"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6ed9af4d-4d14-34fe-8876-ac3c79d3a75d",
                    "sense_definition": "A small village located in Cambridgeshire, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the quiet hamlet of <w>Upend</w> during their trip to the countryside.",
                            "target_lang_translations": {
                                "zh": "在乡村旅行期间，他们造访了宁静的<w>阿彭德</w>村。"
                            }
                        },
                        {
                            "text": "The historical records mention the small parish of <w>Upend</w> in East Cambridgeshire.",
                            "target_lang_translations": {
                                "zh": "历史文献中提到了位于东剑桥郡的<w>阿彭德</w>小堂区。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "英格兰剑桥郡的一个小村庄"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阿彭德",
                                "target_lang_sense_clarification": "地名，位于英格兰剑桥郡"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}