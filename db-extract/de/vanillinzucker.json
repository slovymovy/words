                        "entry_id": "4d2580f6-f2c5-380b-950e-e23b5c1e1bb8",
                        "glosses": [
                            "Mischung aus Kristallzucker und synthetisch hergestelltem Vanillin, die häufig zum Süßen von beispielsweise Backwaren oder Speiseeis verwendet wird, wobei der Vanillin-Anteil zwischen 1,6 % und 2,4 % (laut ISO 5565-2) beträgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f088f616-180c-4f02-a630-98996bf57a2b",
                                "sense_id": "4153ccc5-b563-3148-bf64-9ca827d37095",
                                "text": "Thomas hat verschiedene Vanillinzucker eingekauft."
                            },
                            {
                                "example_id": "5dead84f-7f6d-4183-aca9-814a01a172a7",
                                "sense_id": "4153ccc5-b563-3148-bf64-9ca827d37095",
                                "text": "In den Plätzchenteig müssen noch drei Päckchen Vanillinzucker."
                            },
                            {
                                "example_id": "aa9f7ada-a07f-4b70-89ba-2ff99087f39f",
                                "sense_id": "4153ccc5-b563-3148-bf64-9ca827d37095",
                                "text": "Wir haben gar keinen Vanillinzucker mehr im Haus."
                            }
                        ],
