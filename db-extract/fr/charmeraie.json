                        "glosses": [
                            "Lieu planté de charmes."
                        ],
                        "tags": [
                            "Ethnobiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "aa83ab57-e243-4bc7-b4c5-d97720818c96",
                                "sense_id": "b6a5b270-d8ac-3706-9352-fe17ac711f28",
                                "text": "Quand nous sommes ressortis, la grande roue du parc nous apparut au-dessus de la charmeraie, noire sur fond bleu, menaçante comme l’arc supérieur d’un gigantesque piège à mâchoires."
                            },
                            {
                                "example_id": "63b9ea02-42e4-4849-972a-08bcf5bf80c8",
                                "sense_id": "b6a5b270-d8ac-3706-9352-fe17ac711f28",
                                "text": "Ces chênaies, ces charmeraies sur les hanches des Causses, avec un cochon bien dressé, vous y récoltez les truffes. À condition d'être propriétaire, sinon ils tirent à vue."
                            }
                        ]
                    }
