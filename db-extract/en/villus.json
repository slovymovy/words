                        "entry_id": "a1e908a6-1258-3c74-bb44-1508e4ff5a81",
                        "glosses": [
                            "A small projection from a membrane, particularly those found in the mucous membranes of the intestines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f54d1f99-7a46-4c92-a535-dcefe7f5992b",
                                "sense_id": "ed884248-5787-3d56-858c-3e2ba4b6fc4f",
                                "text": "where a villus comes next to a gland the short cubical cells of the gland may be traced into the columnar cells of the villus , the hyaline border becoming more marked"
                            },
                            {
                                "example_id": "090004a6-7ffd-42d1-8baf-c3f3eb11d8c4",
                                "sense_id": "ed884248-5787-3d56-858c-3e2ba4b6fc4f",
                                "text": "Studies of the viable blood cells with phase contrast microscopy showed peculiar cells that had numerous short villi and were arbitrarily called “hairy cells.”"
                            }
                        ]
                    },
