                "senses": [
                    {
                        "sense_id": "2743388b-24db-3afd-969d-7049ba81826b",
                        "entry_id": "9f2f9cc1-adb9-38d0-a55c-e8caf066063b",
                        "glosses": [
                            "Relatif à la peau humaine ou constitué de celle-ci. Ne semble être utilisé que dans le contexte de la bibliopégie anthropodermique, désignant la reliure de livres avec de la peau humaine."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "420880ec-ad14-43ba-9870-157b1678a11b",
                                "sense_id": "2743388b-24db-3afd-969d-7049ba81826b",
                                "text": "Une reliure anthropodermique, des livres anthropodermiques"
                            },
                            {
                                "example_id": "dd43b45b-f0ac-4466-84b9-9e4ab2dfb26c",
                                "sense_id": "2743388b-24db-3afd-969d-7049ba81826b",
                                "text": "L'exercice de la biblioplégie anthropodermique n'est, comme on peut le concevoir, pas très répandu, mais il a bien eu ses adeptes et ses usages, jusqu'à devenir une tradition à la peau dure."
                            },
                            {
                                "example_id": "4d828ef6-1bc9-4aa1-92a2-da6670d83208",
                                "sense_id": "2743388b-24db-3afd-969d-7049ba81826b",
                                "text": "Au milieu des quelque quinze mille livres stockés à la librairie de la prestigieuse université d'Harvard (Massachusetts) se nichent trois souvenirs macabres de la terrible mode de la bibliopégie anthropodermique."
                            }
                        ]
                    }
                ],
