                    "frequency": "High",
                    "semantic_group_id": "action_regarder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>regardant</w> par la fenêtre, il a aperçu son voisin qui rentrait du travail."
                        },
                        {
                            "text": "Elle marchait lentement dans la rue en <w>regardant</w> attentivement les vitrines des magasins."
                        }
                    ],
                    "common_phrases": [
