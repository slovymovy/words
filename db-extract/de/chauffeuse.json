                "senses": [
                    {
                        "sense_id": "96a7a333-ffed-362b-a8c5-65691cf4877d",
                        "entry_id": "bc2b7e1a-6ba3-3c92-883d-56f4710e37fa",
                        "glosses": [
                            "eine Frau, die (von Berufs wegen) Personen befördert"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "c8e07f9a-d55e-4cec-b9e7-ff61c9364be5",
                                "sense_id": "96a7a333-ffed-362b-a8c5-65691cf4877d",
                                "text": "Eine Chauffeuse holte die Gäste am Flughafen ab und brachte sie in ihr Hotel."
                            },
                            {
                                "example_id": "2ff3ae03-4dd9-45d2-bed0-05ffcca18868",
                                "sense_id": "96a7a333-ffed-362b-a8c5-65691cf4877d",
                                "text": "„In Zürich verweigert eine Tram-Chauffeuse die Weiterfahrt. Der Grund: Eine Frau isst Kebab – was man im ganzen Wagen riecht.“"
                            },
                            {
                                "example_id": "69101e78-0874-42f4-bc0e-0d3a91382486",
                                "sense_id": "96a7a333-ffed-362b-a8c5-65691cf4877d",
                                "text": "„In Basel hat ein Fahrgast einen Busunfall verhindert. Als die Chauffeuse die Herrschaft über ihr Fahrzeug verlor, brachte der 32-Jährige das Gefährt zum Stillstand.“"
                            },
                            {
                                "example_id": "00ec57d2-9edb-4742-83f1-89598484c827",
                                "sense_id": "96a7a333-ffed-362b-a8c5-65691cf4877d",
                                "text": "„Als Komplizin und Chauffeuse fungierte seine Freundin, eine heute 30-jährige Schweizerin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00a96524-a093-4eae-b3f1-0b98be0185ca",
                        "source_entry_id": "bc2b7e1a-6ba3-3c92-883d-56f4710e37fa",
                        "source_sense_id": "96a7a333-ffed-362b-a8c5-65691cf4877d",
