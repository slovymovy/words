                        "examples": [
                            {
                                "example_id": "d2fb6d16-a866-49bf-a3ab-10dc27724663",
                                "sense_id": "c1409456-ec16-3b75-9d15-d27966b5f922",
                                "text": "Fini le chipotage des vermicelles ! Mange ta soupe !"
                            },
                            {
                                "example_id": "7c5aa307-19c5-49db-883f-cea4af83b89b",
                                "sense_id": "c1409456-ec16-3b75-9d15-d27966b5f922",
                                "text": "De tout ce chipotage, il ne ressortit rien de positif."
                            },
                            {
                                "example_id": "7f1974ec-8e41-40c2-b43e-c69efbac6cc3",
                                "sense_id": "c1409456-ec16-3b75-9d15-d27966b5f922",
                                "text": "C’est aussi un homme de l’interne, Joe Biden. Un homme qui croit aux discussions de corridor, au chipotage avec ses adversaires et aux compromis douloureux."
                            }
                        ]
                    }
                ],
