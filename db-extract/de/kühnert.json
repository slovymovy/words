                ],
                "senses": [
                    {
                        "sense_id": "836e404f-ac9b-3a51-af76-0ce1f68ffcf4",
                        "entry_id": "29c92e2b-d25e-3198-961d-fcc8d94b536d",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0f29521-09da-40a1-82e5-457e54e7afb4",
                                "sense_id": "836e404f-ac9b-3a51-af76-0ce1f68ffcf4",
                                "text": "Frau Kühnert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a1709e49-66d2-4d7d-882b-1739c9647169",
                                "sense_id": "836e404f-ac9b-3a51-af76-0ce1f68ffcf4",
                                "text": "Herr Kühnert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "62972148-dcaf-497a-8e79-3234846840a9",
                                "sense_id": "836e404f-ac9b-3a51-af76-0ce1f68ffcf4",
                                "text": "Die Kühnerts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "be363700-7181-4a57-bd4a-9e05eb1d3838",
                                "sense_id": "836e404f-ac9b-3a51-af76-0ce1f68ffcf4",
                                "text": "Der Kühnert trägt nie die Schals, die die Kühnert ihm strickt."
                            },
                            {
                                "example_id": "9b193e59-5218-4b01-a60e-28559a7dc3f5",
                                "sense_id": "836e404f-ac9b-3a51-af76-0ce1f68ffcf4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kühnert kommt, geht der Herr Kühnert.“"
                            },
                            {
                                "example_id": "5e054e16-ee4c-4b40-be4f-e5eeff60dd17",
                                "sense_id": "836e404f-ac9b-3a51-af76-0ce1f68ffcf4",
                                "text": "Kühnert kommt und geht."
                            },
                            {
                                "example_id": "93b92d9c-155a-4bd0-92e0-ec270c0b06ac",
                                "sense_id": "836e404f-ac9b-3a51-af76-0ce1f68ffcf4",
                                "text": "Kühnerts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
