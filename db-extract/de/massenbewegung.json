                ],
                "senses": [
                    {
                        "sense_id": "8bf41c05-5e9b-3f1e-83ff-f912faa81214",
                        "entry_id": "4e71dd4e-7383-3618-b29c-84aaf4228fe4",
                        "glosses": [
                            "gleichgerichtete Aktivität großer Bevölkerungsteile, um eigene Ziele (politische, religiöse und so weiter) zu realisieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "234093a7-d4e0-4de9-88b6-7be65e871199",
                                "sense_id": "8bf41c05-5e9b-3f1e-83ff-f912faa81214",
                                "text": "„Binnen einer Woche hatten sich ab dem 8. März 1917 Hungerkrawalle in St. Petersburg zu einer Massenbewegung gleichermaßen im unteren und mittleren Bürgertum wie in der Arbeiterschaft ausgewachsen, die das absolutistische Regime von Nikolaus II. hinwegfegte.“"
                            },
                            {
                                "example_id": "28da2094-cb92-4c85-8131-7f90723c2396",
                                "sense_id": "8bf41c05-5e9b-3f1e-83ff-f912faa81214",
                                "text": "„Aber ihre Gegner bilden schnell eine Massenbewegung.“"
                            },
                            {
                                "example_id": "fd73416d-9eb7-484d-8ef6-34e39f77bfbe",
                                "sense_id": "8bf41c05-5e9b-3f1e-83ff-f912faa81214",
                                "text": "„Skepsis, Zynismus und der gesunde kulturelle und politische Verstand, der mich normalerweise von Massenbewegungen fern hielt, waren ein guter Schutzschild.“"
                            },
                            {
                                "example_id": "c7c127c5-2d34-4e6e-b0d5-3cf954951041",
                                "sense_id": "8bf41c05-5e9b-3f1e-83ff-f912faa81214",
                                "text": "„Art déco war im Gegensatz zum »Bauhaus« keine Massenbewegung, sondern erreichte vor allem elitäre und vermögende Schichten der Bevölkerung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
