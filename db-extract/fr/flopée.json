                                    },
                                    {
                                        "sense_id": "c43e9ea1-9f19-34c9-8d37-c3b7c9a03cb4",
                                        "entry_id": "4835e8a1-0750-3fa9-b3a1-20d9f823ada8",
                                        "glosses": [
                                            "To form a bunch."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e764f256-5fe7-482f-b13e-2aa8d231141f",
                                                "sense_id": "c43e9ea1-9f19-34c9-8d37-c3b7c9a03cb4",
                                                "text": "\"Permissive\" working allows more than one train to be in a block section at one time but trains must be run at low speed in order to stop on sight behind the train in front. Such working is often authorised to allow freight trains to \"bunch\" together to await a path through a bottleneck instead of being strung out over several block sections, as would be necessary if absolute working were in force."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31d80c13-d854-3349-9c8c-ebe62d9a9a46",
                                        "entry_id": "4835e8a1-0750-3fa9-b3a1-20d9f823ada8",
                                        "glosses": [
                                            "To be gathered together in folds"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab5aa78d-118b-38c9-b02f-e8196f5cd03e",
                                        "entry_id": "4835e8a1-0750-3fa9-b3a1-20d9f823ada8",
                                        "glosses": [
                                            "To protrude or swell"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f1f37e8-5c45-45ef-8799-5425467bd026",
                                                "sense_id": "ab5aa78d-118b-38c9-b02f-e8196f5cd03e",
                                                "text": "A very large ſparry Nodule externally of a brown Colour. It has ſomewhat of the reſemblance of a large Champignon before 'tis open'd, bunching out into a large round Knob at one end, the part proceeding from it being leſs, round, and not unlike a Stalk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
