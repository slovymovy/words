                "senses": [
                    {
                        "sense_id": "d21889cc-ac2f-3588-b29e-9a7f4b0ce982",
                        "entry_id": "2f5ab9bd-c029-3dab-a2d2-5c2dae537524",
                        "glosses": [
                            "zabawa polegająca na odgadywaniu przez jednego z jej uczestników, który z graczy jest autorem anonimowego klapsa w pośladek"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "ee123e33-00ff-4e45-9b94-f31e7e70e47d",
                                "sense_id": "d21889cc-ac2f-3588-b29e-9a7f4b0ce982",
                                "text": "Za przepierzeniem żołnierze z eskorty grali w „salonowca” i na wystawione zady spadały raz za razem mlaszczące i rzetelne klapsy"
                            },
                            {
                                "example_id": "06d5e0a2-9664-4e65-98a7-65fff8920aa9",
                                "sense_id": "d21889cc-ac2f-3588-b29e-9a7f4b0ce982",
                                "text": "Salonowiec to taka elegancka zabawa / Klaps, klaps, z lewa, z prawa / Argumenty spadają na część ciała intymną / A wokół bliźni, a wokół bliźni / Każdy szczerzy się z miną niewinną"
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    }
