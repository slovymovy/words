                ],
                "senses": [
                    {
                        "sense_id": "d586037c-604c-3f1d-b80f-f5c1414d3389",
                        "entry_id": "a8d17a10-b7f7-3925-85e8-e62a40a05893",
                        "glosses": [
                            "höchstrangige Entscheidungsperson in einer kriegerischen Auseinandersetzung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64dcced2-ffc0-41a7-978e-b152d3036275",
                                "sense_id": "d586037c-604c-3f1d-b80f-f5c1414d3389",
                                "text": "„Der mittlerweile zum Marschall beförderte Kriegsherr hat ein Machtvakuum erzeugt, das die weitere Anwesenheit französischer Truppen zwingend erforderlich macht.“"
                            },
                            {
                                "example_id": "a5ebe2cc-c26c-4bef-87bc-5d223c029055",
                                "sense_id": "d586037c-604c-3f1d-b80f-f5c1414d3389",
                                "text": "„Diese uns heute schändlich vorkommende Ehre kam auch Zeitgenossen schon schändlich vor. Jedenfalls denjenigen, die sich mit der Binnenmoral lokaler Kriegsherren nicht zufrieden geben wollten, gleich wie groß deren Ahnentafel war und wie viele Familienwappen in den Burgsälen hingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f0c7c58-507f-4879-ab55-40210d8b795a",
                        "source_entry_id": "a8d17a10-b7f7-3925-85e8-e62a40a05893",
                        "source_sense_id": "d586037c-604c-3f1d-b80f-f5c1414d3389",
                        "source_sense_description": "höchstrangige Entscheidungsperson in einer kriegerischen Auseinandersetzung",
                        "target_lang_word": "warlord",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warlord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ff8b9e0-be9d-3037-bc84-b11c7276cbbf",
                                        "entry_id": "d94f7de0-fd7e-33a9-90d6-72b34a09e956",
                                        "glosses": [
                                            "A military commander or bandit leader wielding civilian power in an area where the government is weak."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1399c902-6716-43f6-aed8-d9bb01b93a6b",
                                                "sense_id": "8ff8b9e0-be9d-3037-bc84-b11c7276cbbf",
                                                "text": "Afghanistan's first major battle of the post-Taliban era ended tonight when the soldiers of the warlord besieging this strategic city south of Kabul ran out of ammunition and fled the battlefront in clouds of dust, cursing the warlord to his face for his callousness in committing them to a fight they were doomed to lose."
                                            },
                                            {
                                                "example_id": "f69d5650-c5dd-4b4b-b87d-9602e665c393",
                                                "sense_id": "8ff8b9e0-be9d-3037-bc84-b11c7276cbbf",
                                                "text": "“I’m not a warlord … I’m a liberator of the people,” he said. That’s the problem: So are they all. More than four million people have died in Congo’s wars since 1998, making it the most lethal conflict since World War II."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc869be5-d3a9-4493-a5b4-4a261edf5b07",
