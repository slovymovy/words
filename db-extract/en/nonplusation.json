                        "glosses": [
                            "The quality of being nonplussed."
                        ],
                        "tags": [
                            "uncommon",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cb9e73e9-8c4b-4dd6-8d18-17399e963f26",
                                "sense_id": "aadc9a33-d00d-3b4f-b5f4-8bd653b6f99d",
                                "text": "When the voiture stopped in the village, there seemed to be a nonplusation, to coin a word for the nonce, between my friend and his sisters."
                            },
                            {
                                "example_id": "f320ff5f-62e9-4878-b87c-baaf2f22b34a",
                                "sense_id": "aadc9a33-d00d-3b4f-b5f4-8bd653b6f99d",
                                "text": "When William Rufus returned by moonlight to claim his prize, with Cervantist nonplusation he beheld Edith Matilda — dressed like a novice, kneeling before her altar, counting her beads, with candles burning."
                            },
                            {
                                "example_id": "d2d50585-3c7c-4b3c-9fe4-4a0ef09cda7e",
                                "sense_id": "aadc9a33-d00d-3b4f-b5f4-8bd653b6f99d",
                                "text": "They reside in a state of nonplusation more aware than reason, more trying than insanity."
                            }
                        ]
                    }
                ],
