                        "examples": []
                    },
                    {
                        "sense_id": "6275c58b-a7b7-3c21-ba6e-30a0eb746637",
                        "entry_id": "fc876822-c7ef-3533-9239-973722e0e216",
                        "glosses": [
                            "To say as an interruption or aside."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "25948eee-0fc9-42b3-bdbe-699767363920",
                                "sense_id": "6275c58b-a7b7-3c21-ba6e-30a0eb746637",
                                "text": "He roared with prodigious violence against George the Second. When he ceased, Moody interjected, in an Irish tone, and with a comick look, “Ah! poor George the Second.”"
                            },
                            {
                                "example_id": "1c4b0565-4f82-43da-8273-9581f85c69b6",
                                "sense_id": "6275c58b-a7b7-3c21-ba6e-30a0eb746637",
                                "text": "‘Please, sir, Richard says one of the horses has got a very bad cold, and he thinks, sir, if you could make it convenient to go the day after to-morrow, instead of to-morrow, he could physic it to-day, so as—’\n‘Confound his impudence!’ interjected the master."
                            },
                            {
                                "example_id": "5e54c891-186e-4b4d-a8a8-289848bd4ce1",
                                "sense_id": "6275c58b-a7b7-3c21-ba6e-30a0eb746637",
                                "text": "As I listened I interjected an occasional sentence of Japanese translation for our guests."
                            },
                            {
                                "example_id": "6d3b055f-8697-4cb1-9c28-b9d4b4c7c38f",
                                "sense_id": "6275c58b-a7b7-3c21-ba6e-30a0eb746637",
                                "text": "Virenque, in a panicky mishearing, replied, “Me a dealer? No, I am not a dealer.” […] Whereupon Virenque’s lawyer interjected, “No, Richard, the judge said leader. It’s not an offense to be a leader.”"
                            }
                        ]
                    },
