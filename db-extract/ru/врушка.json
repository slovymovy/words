                "senses": [
                    {
                        "sense_id": "4f67a4cb-86d4-36c0-a93a-8606767ac6cb",
                        "entry_id": "122acbe1-5b65-310f-ae7a-135259ded8a1",
                        "glosses": [
                            "разг. уменьш. к врун, врунья"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4922f1fa-e2f8-41bf-ada8-362e6ccbbd80",
                                "sense_id": "4f67a4cb-86d4-36c0-a93a-8606767ac6cb",
                                "text": "Мне врать нечего, я не врушка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e27708e6-6caa-41c0-b3f6-6fe898efd231",
                        "source_entry_id": "122acbe1-5b65-310f-ae7a-135259ded8a1",
                        "source_sense_id": "4f67a4cb-86d4-36c0-a93a-8606767ac6cb",
                        "target_lang_word": "liar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48ddd1cf-0bb5-3559-baeb-049aefa083b7",
                                        "entry_id": "0beb25d9-8f5a-3d24-8e96-c043c68a5b3f",
                                        "glosses": [
                                            "A person who frequently lies; someone who tells a lie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26315097-df91-4787-b96e-b10142725470",
                                                "sense_id": "48ddd1cf-0bb5-3559-baeb-049aefa083b7",
                                                "text": "She paused and took a defiant breath. ‘If you don't believe me, I can't help it. But I'm not a liar.’ ¶ ‘No,’ said Luke, grinning at her. ‘You're not dull enough![…]What about the kid's clothes? I don't suppose they were anything to write home about, but didn't you keep anything?[…]’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4877bce-a2bd-3c4d-b23f-2d125d063da4",
                                        "entry_id": "0beb25d9-8f5a-3d24-8e96-c043c68a5b3f",
                                        "glosses": [
                                            "A swabber responsible for cleaning the outside parts of the ship rather than the cabins, a role traditionally assigned to a person caught telling a lie the previous week."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74b14fb9-d5f1-4632-8d73-329ae21dfc9a",
                                                "sense_id": "a4877bce-a2bd-3c4d-b23f-2d125d063da4",
                                                "text": "The Swabber is to keep the Cabbins, and all the Rooms of the Ship clean within board, and the Liar to do the like without board. The Liar holds his Place but for a week; and he that is first taken with a Lie upon a Monday morning, […] for that week he is under the Swabber, and meddles not with making clean the Ship within board, but without."
                                            },
                                            {
                                                "example_id": "b14ac5f7-2b53-4beb-9e5e-b685328fa22c",
                                                "sense_id": "a4877bce-a2bd-3c4d-b23f-2d125d063da4",
                                                "text": "The swabber, perhaps the lowliest position on the ship, was responsible for cleaning the decks. By tradition, each Monday a new crewmember was appointed the liar—the first person caught telling a lie the previous week."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75fb44f0-6271-41b7-a739-36de9dfe05c5",
                        "source_entry_id": "122acbe1-5b65-310f-ae7a-135259ded8a1",
                        "source_sense_id": "4f67a4cb-86d4-36c0-a93a-8606767ac6cb",
                        "target_lang_word": "Lügner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lügner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d207c74c-9496-32a2-b7dc-726280b67664",
                                        "entry_id": "2493ba71-230a-3a29-a8a0-bd14f2466641",
                                        "glosses": [
                                            "jemand, der lügt, der die Unwahrheit spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8eb1e7b-023e-481b-8e1b-d6c2e77b645a",
                                                "sense_id": "d207c74c-9496-32a2-b7dc-726280b67664",
                                                "text": "Du bist mir schon so ein Lügner vor dem Herrn, kannst du nicht einfach mal so aus Spaß die Wahrheit sagen?"
                                            },
                                            {
                                                "example_id": "acfe68fc-966c-4803-8c05-ca256a24e14c",
                                                "sense_id": "d207c74c-9496-32a2-b7dc-726280b67664",
                                                "text": "Diesem Lügner würde ich nicht trauen."
                                            },
                                            {
                                                "example_id": "554e59f8-f6a3-4929-ac0d-b9ba8038c8f6",
                                                "sense_id": "d207c74c-9496-32a2-b7dc-726280b67664",
                                                "text": "Ihre Aussagen widersprechen sich. Wer ist hier jetzt der Lügner?"
                                            },
                                            {
                                                "example_id": "b271c868-47b8-4d53-89f0-f8f2bf46dff0",
                                                "sense_id": "d207c74c-9496-32a2-b7dc-726280b67664",
                                                "text": "„Das Volk hielt ihn für einen Lügner.“"
                                            },
                                            {
                                                "example_id": "8e6e0922-ac8d-4571-a32f-d9a34fd2e1e8",
                                                "sense_id": "d207c74c-9496-32a2-b7dc-726280b67664",
                                                "text": "„Ich sagte zu Uwe, daß er ein Lügner sei.“"
                                            },
                                            {
                                                "example_id": "a4c767c5-a27d-4085-abb9-cd3dd5aea3c9",
                                                "sense_id": "d207c74c-9496-32a2-b7dc-726280b67664",
                                                "text": "„Die Hyäne hatte gelogen und wußte das; sie wußte auch, daß ich in der Klemme saß, da ich ihn nicht als Lügner bezeichnen konnte, ohne sein Gebrüll hervorzurufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fabeca5d-bb23-457f-891d-eed97d133d42",
                        "source_entry_id": "122acbe1-5b65-310f-ae7a-135259ded8a1",
                        "source_sense_id": "4f67a4cb-86d4-36c0-a93a-8606767ac6cb",
