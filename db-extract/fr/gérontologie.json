        "fr-extract.jsonl": [
            {
                "entry_id": "ee2beb91-df8b-3609-84fa-c6e42cd3bff3",
                "word": "gérontologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e7002b13-c016-409c-9e14-2dea8bdf3cb5",
                        "entry_id": "ee2beb91-df8b-3609-84fa-c6e42cd3bff3",
                        "tags": [
