                        "translation_id": "fc687ca9-61aa-495a-bb93-1d2328b93b11",
                        "source_entry_id": "daeabaac-05ae-373d-9397-b54a93c8ec29",
                        "source_sense_id": "2afb26bb-3ef0-3d81-9e69-1e94ba0e5e8d",
                        "target_lang_word": "Überdruss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überdruss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                        "entry_id": "174b1932-d097-3884-9e8f-22550755cb74",
                                        "glosses": [
                                            "Widerwille, den jemand gegenüber jemandem oder etwas empfindet, weil er sich über eine lange Zeit damit hat befassen müssen, ohne dies zu wollen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3332f75c-495b-4748-a1b2-86a088821665",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "Auf einmal befiel ihn ein Überdruss an seiner ganzen Sammlung von Streichholzschachteln."
                                            },
                                            {
                                                "example_id": "98c5f145-9e3a-4f9b-b51f-cc315322a5d3",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "Aus unendlichem Überdruss am Leben stürzte Ottmar sich von den Klippen ins tosende Meer."
                                            },
                                            {
                                                "example_id": "c71a2905-48e7-410f-9093-4f54aad4ad62",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "Wir haben das Thema nun bis zum Überdruss diskutiert und trotzdem sind wir zu keinem Ergebnis gekommen."
                                            },
                                            {
                                                "example_id": "09fecfe3-853a-491d-8993-8596dad6b08c",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "„Und zu ihrem Überdruss sollten die weiteren Entwicklungen Sibylle auch noch recht geben.“"
                                            },
                                            {
                                                "example_id": "d2336b68-9bbe-4a17-9541-3fda75a74a9e",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "„Zwischen ihr und den Straussens hatte sich nach der langen gemeinsamen Zeit eine Trägheit eingestellt, ja, fast schon Überdruss.“"
                                            },
                                            {
                                                "example_id": "277fe3b5-fd75-4b54-b7d1-610c04ba5fc6",
                                                "sense_id": "923f7a50-4179-361c-808f-c0495238e150",
                                                "text": "„Doch ihr Überdruss am Dasein überwuchert alle Vorsätze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
