                "senses": [
                    {
                        "sense_id": "e79f0eda-6f0d-37fa-bf73-d6397029b2a5",
                        "entry_id": "534779b1-d2a8-3730-aa7d-6442c79b3a2f",
                        "glosses": [
                            "Qui agit contre les effets de l’âge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16a8ee67-7ccd-43e9-8ef1-3b42303f2f85",
                                "sense_id": "e79f0eda-6f0d-37fa-bf73-d6397029b2a5",
                                "text": "Autant d’inconforts qu’une bonne huile végétale saura apaiser, en remplacement de crèmes « anti-âge » généralement hors de prix et nettement moins naturelles."
                            },
                            {
                                "example_id": "d03fcbea-dfe8-4411-b7f5-0ea181132cf1",
                                "sense_id": "e79f0eda-6f0d-37fa-bf73-d6397029b2a5",
                                "text": "Je lui souriais, ravie de constater que tout l’argent investi depuis des années dans l’achat de crèmes repulpantes, de flacons anti-âges ou encore d’huiles aux vertus rajeunissantes servait peut-être enfin à quelque chose."
                            },
                            {
                                "example_id": "a1b57a58-79e8-43ff-b7ce-36ac0ddcf7c3",
                                "sense_id": "e79f0eda-6f0d-37fa-bf73-d6397029b2a5",
                                "text": "Que ce soit pour des vitamines, des pilules anti-âges, des anti-douleurs, des compléments alimentaires, la figure féminine est récurrente."
                            }
                        ]
                    }
                ],
