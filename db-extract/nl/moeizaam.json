                    {
                        "form_id": "0e432222-b469-49d2-81de-998633c5f2cf",
                        "entry_id": "5cf63ab8-ab7b-3af2-adee-dd7629b03a2a",
                        "tags": [
                            "partitive",
                            "comparative"
                        ],
