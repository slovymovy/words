                            },
                            {
                                "target_lang_word": "зев",
                                "target_lang_sense_clarification": "широко раскрытая пасть или глотка"
                            },
                            {
                                "target_lang_word": "жерло",
                                "target_lang_sense_clarification": "широкое отверстие или зев"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "960ac416-206d-3e08-acb0-6daf77206bed",
                    "sense_definition": "szczęka, kość szczękowa",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Myśliwy dokładnie obejrzał potężną <w>czeluść</w> upolowanego przed chwilą dzika.",
                            "target_lang_translations": {
                                "ru": "Охотник внимательно осмотрел мощную <w>челюсть</w> только что добытого кабана."
                            }
                        },
                        {
                            "text": "W dawnym języku dolną część twarzy zwano czasem <w>czeluścią</w>.",
                            "target_lang_translations": {
                                "ru": "В старинном языке нижнюю часть лица иногда называли <w>челюстью</w>."
                            }
                        }
                    ],
