                                        "entry_id": "e4b6b45f-6ab6-38b0-a1bd-b69320a3c544",
                                        "glosses": [
                                            "Brebaje espumoso preparado a partir de la raíz de esta planta."
                                        ],
                                        "tags": [
                                            "Bebidas"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
