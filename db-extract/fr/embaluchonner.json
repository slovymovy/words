                        "glosses": [
                            "Mettre dans un baluchon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "decbdcc2-1ea8-4ba8-86f7-1671bce31648",
                                "sense_id": "3cb962c6-65a7-370a-823f-dff51d551dba",
                                "text": "Je ralentis ; un homme embaluchonné dans un manteau s’approche de moi en toussant ."
                            },
                            {
                                "example_id": "c19a9d8e-570c-4dda-ab8d-d41e1697443b",
                                "sense_id": "3cb962c6-65a7-370a-823f-dff51d551dba",
                                "text": "Je vais tâcher de m'embaluchonner un seau d'eau."
                            }
                        ]
