                "senses": [
                    {
                        "sense_id": "ffbc15d7-2ab5-3d54-9c80-f755ce2513f5",
                        "entry_id": "8832b90b-dabd-3c02-b165-6472e0e7d918",
                        "glosses": [
                            "Epoche der Kunstgeschichte, in der der Barock vorherrschte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6319f5bb-f07c-450e-9ad3-7f0cb3ca0b86",
                                "sense_id": "ffbc15d7-2ab5-3d54-9c80-f755ce2513f5",
                                "text": "„Den Rollentausch der Shakespearezeit, wo Männer Frauen spielten, können wir seit der Barockzeit und dem Rokoko bis heute in der Oper nachvollziehen.“"
                            },
                            {
                                "example_id": "5610bee1-e12a-467b-821a-7f98111ce78e",
                                "sense_id": "ffbc15d7-2ab5-3d54-9c80-f755ce2513f5",
                                "text": "„Auch große Namen der Literatur verbinden sich seit Barockzeiten, seit Simon Dach und dem unsterblichen Ännchen von Tharau, mit der Stadt am Pregel.“"
                            },
                            {
                                "example_id": "13cd8ddd-2369-4e60-bb7b-562d538ac422",
                                "sense_id": "ffbc15d7-2ab5-3d54-9c80-f755ce2513f5",
                                "text": "„Das hat schon in der Barockzeit die Verteidiger der deutschen Sprache auf den Plan gerufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
