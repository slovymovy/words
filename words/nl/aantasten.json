{
    "word_family": [
        "tast",
        "tasten",
        "tastzin",
        "aantasting",
        "betasten",
        "ontasten"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aee2fd3c-96fe-3b26-bc8f-bfa88c38a92d",
                    "sense_definition": "op een negatieve manier beïnvloeden, beschadigen of chemisch inwerken op iets",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "beschadiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zure regen kan de oude standbeelden in het park ernstig <w>aantasten</w>.",
                            "target_lang_translations": {
                                "en": "Acid rain can seriously <w>damage</w> the old statues in the park."
                            }
                        },
                        {
                            "text": "Roken kan de gezondheid van je longen op de lange termijn <w>aantasten</w>.",
                            "target_lang_translations": {
                                "en": "Smoking can <w>affect</w> the health of your lungs in the long term."
                            }
                        }
                    ],
                    "synonyms": [
                        "ondermijnen"
                    ],
                    "antonyms": [
                        "herstellen",
                        "verbeteren"
                    ],
                    "common_phrases": [
                        "de gezondheid aantasten",
                        "het milieu aantasten"
                    ],
                    "target_lang_definitions": {
                        "en": "To influence in a negative way, damage, or chemically act upon something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "affect",
                                "target_lang_sense_clarification": "to influence or alter negatively"
                            },
                            {
                                "target_lang_word": "damage",
                                "target_lang_sense_clarification": "to cause physical or functional harm"
                            },
                            {
                                "target_lang_word": "undermine",
                                "target_lang_sense_clarification": "to weaken or wear away gradually"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3654f0ae-4d46-3b4a-9e53-e23cea105c67",
                    "sense_definition": "iets beschadigen of aantasten waardoor het uiterlijk of de kwaliteit verslechtert",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beschadiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het metaal werd langzaam <w>aangetast</w> door de zure neerslag.",
                            "target_lang_translations": {
                                "en": "The metal was slowly <w>corroded</w> by the acidic precipitation."
                            }
                        },
                        {
                            "text": "De wortels van de grote boom zullen op een dag de funderingen van het huis <w>aantasten</w>.",
                            "target_lang_translations": {
                                "en": "The roots of the large tree will one day <w>undermine</w> the foundations of the house."
                            }
                        }
                    ],
                    "synonyms": [
                        "ondermijnen"
                    ],
                    "common_phrases": [
                        "de fundering aantasten"
                    ],
                    "target_lang_definitions": {
                        "en": "To damage or wear away something, causing its appearance or quality to deteriorate."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "corrode",
                                "target_lang_sense_clarification": "to eat away bit by bit, especially by chemical action"
                            },
                            {
                                "target_lang_word": "erode",
                                "target_lang_sense_clarification": "to gradually wear away or destroy"
                            },
                            {
                                "target_lang_word": "affect",
                                "target_lang_sense_clarification": "to have a harmful effect on quality or structure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee525a46-957f-377a-bc34-ef143c9b10ca",
                    "sense_definition": "iets met de vingers vastpakken of aanraken",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fysiek contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij durfde het hete ijzer niet direct met zijn blote handen <w>aan</w> te <w>tasten</w>.",
                            "target_lang_translations": {
                                "en": "He did not dare to <w>touch</w> the hot iron directly with his bare hands."
                            }
                        },
                        {
                            "text": "In de oude tekst stond beschreven hoe men de relikwieën met eerbied moest <w>aantasten</w>.",
                            "target_lang_translations": {
                                "en": "The ancient text described how one should <w>handle</w> the relics with reverence."
                            }
                        }
                    ],
                    "synonyms": [
                        "ondermijnen"
                    ],
                    "common_phrases": [
                        "een heet hangijzer aantasten"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Deze betekenis is verouderd en wordt in modern Nederlands zelden gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To grasp or touch something with the fingers (archaic)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "touch",
                                "target_lang_sense_clarification": "to handle or come into contact with"
                            },
                            {
                                "target_lang_word": "handle",
                                "target_lang_sense_clarification": "to take up or hold with the hands"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}