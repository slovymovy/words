                "senses": [
                    {
                        "sense_id": "e6e48688-caa2-3297-a965-ef93ce0ae6f7",
                        "entry_id": "24d15f7a-1613-3f13-b5d7-e99034cdf0e3",
                        "glosses": [
                            "относящийся к кашубам, славянскому поморскому народу или их языку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f88fcda-314b-457b-b9ed-52cb29bdb186",
                                "sense_id": "e6e48688-caa2-3297-a965-ef93ce0ae6f7",
                                "text": "Ведь это был тяжёлый труд — сохранить кашубскую культуру, католическую веру, язык в том уголке мира."
                            },
                            {
                                "example_id": "16f71f45-ee07-46f1-84cc-b8f53402e346",
                                "sense_id": "e6e48688-caa2-3297-a965-ef93ce0ae6f7",
                                "text": "Я теперь бьюсь над кашубским и полабским ударением."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3beb484-6334-3128-8612-c4504142f0e1",
                        "entry_id": "24d15f7a-1613-3f13-b5d7-e99034cdf0e3",
                        "glosses": [
                            "субстантивир. то же, что кашубский язык"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df7e56b6-ab92-42a2-8d03-be22e07a777f",
                                "sense_id": "f3beb484-6334-3128-8612-c4504142f0e1",
                                "text": "Изучать кашубский."
                            }
                        ]
                    }
                ],
