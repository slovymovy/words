        "fr-extract.jsonl": [
            {
                "entry_id": "44c08ad5-3116-3d07-a314-275383cc20b1",
                "word": "ovation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d27fc2f7-9a79-4d5c-825d-a5f62121c5f4",
                        "entry_id": "44c08ad5-3116-3d07-a314-275383cc20b1",
                        "tags": [
                            "plural"
                        ],
                        "form": "ovations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d829745-ac2f-3e3c-91b8-6dbb0df5e3f2",
                        "entry_id": "44c08ad5-3116-3d07-a314-275383cc20b1",
                        "glosses": [
                            "Sorte de triomphe, où le triomphateur entrait dans la ville à pied ou à cheval et sacrifiait une brebis ; à la différence du grand triomphe, où le triomphateur était sur un char et sacrifiait un taureau."
                        ],
                        "tags": [
                            "Ancient-Roman"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b8d39fc2-35bd-3b84-a1a1-b3f13bbffe6d",
                        "entry_id": "44c08ad5-3116-3d07-a314-275383cc20b1",
                        "glosses": [
                            "Acclamations, des marques bruyantes d’enthousiasme qui accueillent un orateur ou tout autre personnage auquel on rend honneur, que l’on fête."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f3e9cd7a-3330-495e-a91a-d0934c63b276",
                                "sense_id": "b8d39fc2-35bd-3b84-a1a1-b3f13bbffe6d",
                                "text": "Hier les ovations des mineurs du Nord, aujourd'hui les acclamations des cultivateurs du Midi et des citoyens d'une ville, grande par son passé, …."
                            },
                            {
                                "example_id": "e6ea576c-7c54-4177-a110-0745a8c4de67",
                                "sense_id": "b8d39fc2-35bd-3b84-a1a1-b3f13bbffe6d",
                                "text": "Nous avons décrit ces ovations des congrès, prolongées un quart d'heure entier et dont on se demande comment elles finissent? Car quelqu'un doit cesser le premier de battre des mains en cadence et quel est celui qui se le permet dans cet environnement de servilité?"
                            },
                            {
                                "example_id": "08d0669e-976a-4d47-99d1-a71b10051793",
                                "sense_id": "b8d39fc2-35bd-3b84-a1a1-b3f13bbffe6d",
                                "text": "Les chanteurs sont supérieurs à ceux du même ordre entendus à Paris. La salle, bondée, les encourage par des ovations."
                            },
                            {
                                "example_id": "22966283-cbab-4a68-9e41-0e5f06ffb8f7",
                                "sense_id": "b8d39fc2-35bd-3b84-a1a1-b3f13bbffe6d",
                                "text": "Seul, Delcassé s'est rendu à l’Étoile en auto ouverte. Il espérait une ovation, mais la foule resta muette. Elle exprimait à son insu l’impopularité de cette guerre, et ses appréhensions."
                            },
                            {
                                "example_id": "02476669-a280-48b8-89af-50057446df69",
                                "sense_id": "b8d39fc2-35bd-3b84-a1a1-b3f13bbffe6d",
                                "text": "L'entrée de Kylian Mbappé sous les ovations du Santiago Bernabeu!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "996805d5-563a-4fca-912e-2ca496581b02",
                        "source_entry_id": "44c08ad5-3116-3d07-a314-275383cc20b1",
