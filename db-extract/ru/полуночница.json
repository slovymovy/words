                "senses": [
                    {
                        "sense_id": "67bd5891-e640-30c4-9cbc-42166289068f",
                        "entry_id": "6c0ec020-fdb7-3304-8259-5f1ee74d3b1e",
                        "glosses": [
                            "разг., церк. то же, что полу́нощница"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e30d7101-5237-4553-b010-5cf214c7a54b",
                                "sense_id": "67bd5891-e640-30c4-9cbc-42166289068f",
                                "text": "В двенадцать часов ночи все должны были вставать и идти к продолжительной полуночнице."
                            },
                            {
                                "example_id": "7a92c5a3-f2c9-4d1c-9935-e1f5b70efa42",
                                "sense_id": "67bd5891-e640-30c4-9cbc-42166289068f",
                                "text": "Часы бьют одиннадцать. ― Пора. Полуночницу начали! Все в доме начинает суетиться."
                            }
                        ]
                    }
