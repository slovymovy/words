        "fr-extract.jsonl": [
            {
                "entry_id": "eb540688-6f7c-34a8-9fab-e8672142b081",
                "word": "indocile",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f4d4409d-994c-4971-aa32-33f0feb8be69",
                        "entry_id": "eb540688-6f7c-34a8-9fab-e8672142b081",
                        "tags": [
                            "plural"
                        ],
                        "form": "indociles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d0bd8abe-dd65-3f1a-9d94-8aeaf20864d3",
                        "entry_id": "eb540688-6f7c-34a8-9fab-e8672142b081",
                        "glosses": [
                            "Qui n’est pas docile, qui est très difficile à instruire, à gouverner, à contrôler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d43645a8-c655-455a-a303-ee36cc5d07c6",
                                "sense_id": "d0bd8abe-dd65-3f1a-9d94-8aeaf20864d3",
                                "text": "En défendant ses règles de travail, son éthique personnelle, Pauline est devenue une femme indocile à faire rentrer dans le rang."
                            },
                            {
                                "example_id": "41585715-193f-446e-be60-ab0e56ace584",
                                "sense_id": "d0bd8abe-dd65-3f1a-9d94-8aeaf20864d3",
                                "text": "Elle n’arrivait pas pour autant à changer son caractère. Elle était indocile et ne pouvait amadouer ses idées."
                            },
                            {
                                "example_id": "d5efa465-86d2-4544-a993-6a7a8d424f35",
                                "sense_id": "d0bd8abe-dd65-3f1a-9d94-8aeaf20864d3",
                                "text": "Un caractère, un esprit indocile."
                            },
                            {
                                "example_id": "9a34aca8-26fa-488a-a548-7189afc7f86c",
                                "sense_id": "d0bd8abe-dd65-3f1a-9d94-8aeaf20864d3",
                                "text": "Un enfant indocile à la règle, aux leçons de ses maîtres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f556d63-2ad8-4045-921f-34fbed66f113",
                        "source_entry_id": "eb540688-6f7c-34a8-9fab-e8672142b081",
                        "source_sense_id": "d0bd8abe-dd65-3f1a-9d94-8aeaf20864d3",
                        "target_lang_word": "ungehorsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungehorsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f074158-b299-32fb-bf32-7a4bdb336fd4",
                                        "entry_id": "a2dc76a2-059e-3d7d-b6b4-332b6368f946",
                                        "glosses": [
                                            "nicht bereit, einem Befehl/einer Anordnung/einer Aufforderung zu folgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb959eb9-bf16-4a01-80ba-5e37bd4957ab",
                                                "sense_id": "3f074158-b299-32fb-bf32-7a4bdb336fd4",
                                                "text": "„Wenn Du weiter so ungehorsam bist, gibt’s eine Woche Fernsehvebot!“"
                                            },
                                            {
                                                "example_id": "b597c0f1-a7a4-4dca-a6bf-f773d7b94f2e",
                                                "sense_id": "3f074158-b299-32fb-bf32-7a4bdb336fd4",
                                                "text": "In seinem umstrittenen Buch [Struwwelpeter] erzählt [Heinrich] Hoffmann in mehreren kurzen Geschichten von ungehorsamen Kindern, die alle am Ende eine schlimme Strafe erwartet."
                                            },
                                            {
                                                "example_id": "7469d8fa-56ef-4c1f-aab5-30e57e67b515",
                                                "sense_id": "3f074158-b299-32fb-bf32-7a4bdb336fd4",
                                                "text": "Im Kloster soll früher jemand, der ungehorsam war, dadurch bestraft worden sein, dass er auf dem Fußboden oder an einem niedrigen Tisch, dem Katzentisch, sitzen musste."
                                            },
                                            {
                                                "example_id": "cd0bc88a-c27d-4cf9-9c51-b87f425a4c62",
                                                "sense_id": "3f074158-b299-32fb-bf32-7a4bdb336fd4",
                                                "text": "[Schlagzeile:] Ungehorsame Pfarrer wollen Reform - Geschiedene Katholiken, die wieder heiraten, sind laut römischem Kirchenrecht Ehebrecher. Pfarrern ist verboten, ihnen die Kommunion auszuteilen. Eine Freiburger Pfarrerinitiative opponiert gegen die Regel."
                                            },
                                            {
                                                "example_id": "7483cd98-01d8-475f-a489-0602cb298dd0",
                                                "sense_id": "3f074158-b299-32fb-bf32-7a4bdb336fd4",
                                                "text": "Weigert ihr euch aber und seid ungehorsam, so sollt ihr vom Schwert gefressen werden; […]"
                                            },
                                            {
                                                "example_id": "d33aed9d-a38d-457e-98b6-6a9dc94e4ff7",
                                                "sense_id": "3f074158-b299-32fb-bf32-7a4bdb336fd4",
                                                "text": "Er [Salafistenprediger Mohammed al Arifiaus aus Saudi-Arabien] propagiert etwa Körperstrafen für „ungehorsame“ Frauen oder Homosexuelle."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e771f2a1-dbb6-4bf9-8493-e2a7d9c6954a",
                        "source_entry_id": "eb540688-6f7c-34a8-9fab-e8672142b081",
                        "source_sense_id": "d0bd8abe-dd65-3f1a-9d94-8aeaf20864d3",
                        "target_lang_word": "widerspenstig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "widerspenstig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27fe8d3e-5844-3ba3-8258-68e307308711",
                                        "entry_id": "a6544330-4c7e-385d-9195-0d52f003d050",
                                        "glosses": [
                                            "sich sträubend, unbeugsam, sich nicht fügen wollend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab1488ea-20bf-4c62-8ba5-b78ee4e6b44e",
                                                "sense_id": "27fe8d3e-5844-3ba3-8258-68e307308711",
                                                "text": "Frau Müller hat eine widerspenstige Tochter, die mitten in der Pubertät steckt."
                                            },
                                            {
                                                "example_id": "d2a27e75-d92a-4540-88e2-aec8644be236",
                                                "sense_id": "27fe8d3e-5844-3ba3-8258-68e307308711",
                                                "text": "„Dabei konnte man Mirko keineswegs unwillig oder widerspenstig nennen. Er tat gehorsam, was man ihm gebot,“ […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24cb33c6-230d-4a15-8f4b-1ac744b3d1cb",
                        "source_entry_id": "eb540688-6f7c-34a8-9fab-e8672142b081",
                        "source_sense_id": "d0bd8abe-dd65-3f1a-9d94-8aeaf20864d3",
                        "target_lang_word": "uncontrollable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uncontrollable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12a2ef84-d31f-3603-82c4-84e691c6f632",
                                        "entry_id": "d17b6859-13cc-3f8f-a457-fe4ad7d905a8",
                                        "glosses": [
                                            "Not able to be controlled, contained or governed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e421b11f-1b27-4400-bc0d-870c954d2a85",
                                                "sense_id": "12a2ef84-d31f-3603-82c4-84e691c6f632",
                                                "text": "She got the uncontrollable urge for some chocolate."
                                            },
                                            {
                                                "example_id": "9d021233-6a9b-4d03-8cfb-d2c9c6babea2",
                                                "sense_id": "12a2ef84-d31f-3603-82c4-84e691c6f632",
                                                "text": "\"Ethel!\" exclaimed Norbourne, his strong and uncontrollable emotion betraying the power that her name still had over him: he tried to say something more, but the words died on his lips."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
