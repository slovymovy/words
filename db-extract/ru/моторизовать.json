                                        ]
                                    },
                                    {
                                        "sense_id": "2ef14048-8831-3279-96c3-c2b7445a5b72",
                                        "entry_id": "2c988459-b1dc-322a-aff5-5f0a084fd0a8",
                                        "glosses": [
                                            "To supply something or someone with motor vehicles."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a6a5fe4-4d40-4446-88bf-53bb64dbc1aa",
                                                "sense_id": "2ef14048-8831-3279-96c3-c2b7445a5b72",
                                                "text": "Once Jack decided to motorize his paper delivery route, he found he could reach far more subscribers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35bd8f2a-d878-3698-a9ea-7aa39841dbde",
                                        "entry_id": "2c988459-b1dc-322a-aff5-5f0a084fd0a8",
                                        "glosses": [
                                            "To supply armoured vehicles; to mechanize."
