                    }
                ],
                "translations": [
                    {
                        "translation_id": "1799d21f-cf5b-4c58-a2dd-fb1d0853e6d2",
                        "source_entry_id": "36c81149-c30b-3d5c-8e87-ec603cf5bd19",
                        "source_sense_description": "беспощадно",
                        "target_lang_word": "mercilessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mercilessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e4ff5b6-3abe-3463-bca6-49b69cd72310",
                                        "entry_id": "f53c48f5-6cb5-324a-9348-68c697344310",
                                        "glosses": [
                                            "In a merciless manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86cdad8b-d599-42cc-a4cc-0a12bdd4707c",
                                                "sense_id": "5e4ff5b6-3abe-3463-bca6-49b69cd72310",
                                                "text": "She mercilessly read off the list of his wrongs in front of their friends."
                                            },
                                            {
                                                "example_id": "540e48e1-cddf-4457-a689-e898d412485c",
                                                "sense_id": "5e4ff5b6-3abe-3463-bca6-49b69cd72310",
                                                "text": "Therefore he whacked the old nigger mercilessly, while a big crowd of his people watched him, thunderstruck[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f0d4c99-f345-4e09-bcd6-5f4ab4494461",
                        "source_entry_id": "36c81149-c30b-3d5c-8e87-ec603cf5bd19",
                        "source_sense_description": "беспощадно",
                        "target_lang_word": "sin piedad",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6f96817c-f95c-4eab-9801-d2a25c871880",
                        "source_entry_id": "36c81149-c30b-3d5c-8e87-ec603cf5bd19",
                        "source_sense_description": "беспощадно",
                        "target_lang_word": "despiadadamente",
                        "target_lang_code": "es",
