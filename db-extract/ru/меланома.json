                    {
                        "translation_id": "9abcee53-96e2-48ef-b7eb-a996d8a43bed",
                        "source_entry_id": "f0396e0a-88cb-37c1-a379-5906771e9e93",
                        "source_sense_id": "2c625433-3d0f-359e-892d-521d7d7fca76",
                        "target_lang_word": "mélanome",
                        "target_lang_code": "fr",
