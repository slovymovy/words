                    {
                        "sense_id": "9f6f5970-30df-3a9f-8fb9-87cee014fd27",
                        "entry_id": "fa5e79f7-9f45-307e-90e8-26dfe63d8b50",
                        "glosses": [
                            "Inheritance by the last-born child of the entirety of, or of a privileged position in, a parent’s wealth, estate, or office; ultimogeniture."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c7b9aaec-9b1a-41af-b51a-5d0612ac992f",
                                "sense_id": "9f6f5970-30df-3a9f-8fb9-87cee014fd27",
                                "text": "The general rule of the equal partition of property, without distinction of sex or primogeniture, suffers exception in the law of juveigneurie, or, as it may be called, postremogeniture, which confers, not on the eldest of children, but on the youngest, the paternal mansion."
                            }
                        ]
                    }
