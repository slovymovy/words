                                "target_word": "heuristisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98bb6f78-1ac1-3bd2-8e6d-246f9592d3e9",
                                        "entry_id": "1f29161e-1e90-38b8-92d2-ee79295195a4",
                                        "glosses": [
                                            "auf die Lehre der Auffindung von Erkenntnissen auf methodischem Weg (Heuristik) bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30cadaa5-d1cf-40d4-bc9b-0951bb8a8293",
                                                "sense_id": "98bb6f78-1ac1-3bd2-8e6d-246f9592d3e9",
                                                "text": "So sind heuristische Prinzipien Hilfsmittel beziehungsweise vorläufige Annahmen der Forschung, von denen man sich neue Erkenntnisse erhofft."
                                            },
                                            {
                                                "example_id": "79c24263-68b9-449e-87f1-9e1055e00cd7",
                                                "sense_id": "98bb6f78-1ac1-3bd2-8e6d-246f9592d3e9",
                                                "text": "„Der Bibliograph muß sich entscheiden, ob er positivistisch-konservierend oder durch seine hermeneutischen Vorentscheidungen heuristisch arbeiten will. “"
                                            },
                                            {
                                                "example_id": "30b0e594-870c-4faa-a674-c66dbad8fe7e",
                                                "sense_id": "98bb6f78-1ac1-3bd2-8e6d-246f9592d3e9",
                                                "text": "„Für die Frage, was Kooperation bei der Arbeit auszeichnet, ist eine heuristischere Herangehensweise notwendig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "89f659e9-a599-3a26-8f2f-65661946508f",
                                        "entry_id": "1f29161e-1e90-38b8-92d2-ee79295195a4",
                                        "glosses": [
                                            "unter geringem Aufwand kein optimales, aber ein meist brauchbares Ergebnis liefernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62f42ef0-742e-4e56-8d8a-7744d98562b8",
                                                "sense_id": "89f659e9-a599-3a26-8f2f-65661946508f",
                                                "text": "Das Ergebnis einer heuristischen Suche ist selten optimal, aber meistens ist es gut und wird in akzeptabler Zeit gefunden."
                                            },
                                            {
                                                "example_id": "d6297b51-6343-4a9d-ae51-67bd7668c678",
                                                "sense_id": "89f659e9-a599-3a26-8f2f-65661946508f",
                                                "text": "„Die Merkmale wurden rein heuristisch gefunden und sind nicht weiter optimiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
