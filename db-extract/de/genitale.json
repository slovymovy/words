                        "form": "die Genitalien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa53e0b8-1804-330f-9084-fefaa839e461",
                        "entry_id": "48ce9b99-d7f0-37b3-aed2-25ab705f217a",
                        "glosses": [
                            "diejenigen Organe beim Menschen und bei Tieren, die der Fortpflanzung dienen; häufig auch die äußeren Geschlechtsorgane"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "5b707c5e-5a56-48d5-bc50-14edae3193ba",
                                "sense_id": "fa53e0b8-1804-330f-9084-fefaa839e461",
                                "text": "Im Tierreich nehmen Genitalien oft überraschende Formen an."
                            },
                            {
                                "example_id": "0070a22b-14f2-4382-a104-e042f2819d8e",
                                "sense_id": "fa53e0b8-1804-330f-9084-fefaa839e461",
                                "text": "„Die Untersuchung des Genitales erfolgt bei jedem Neugeborenen zur Überprüfung von Anzeichen von Intersexualität (intersexuelle Stadien nach Prader S. 610) bzw. Fehlbildungen der ableitenden Harnwege und des Genitales (z.B. Hodenhochstand, Phimose u. a.).“"
                            },
                            {
                                "example_id": "883e706f-cf0f-4e1a-a65c-3a4bf959d973",
                                "sense_id": "fa53e0b8-1804-330f-9084-fefaa839e461",
                                "text": "„Der naturgemäße Gebrauch der Genitalien ist nun der Akt der Zeugung; da hierauf aber die Erhaltung der ganzen Gattung beruht, so ist es nicht wahrscheinlich, daß, wenn die Genitalien nur zu diesem Zwecke benutzt werden, in diese Benutzung ein Grund des Erkrankens von der Natur gelegt sein sollte.“"
                            },
                            {
                                "example_id": "c1419338-480b-437f-9d4a-c97e6dfd12e0",
                                "sense_id": "fa53e0b8-1804-330f-9084-fefaa839e461",
                                "text": "„Die Legende behauptet nämlich, dass der Oxyrhynchos die Genitalien des zerstückelten Gottes Osiris verschluckte und dadurch dessen Auferstehung gefährdete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
