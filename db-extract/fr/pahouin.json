                "senses": [
                    {
                        "sense_id": "0c30a278-1dab-3fdd-b5b6-4e39dff8cd55",
                        "entry_id": "61903b69-d151-329e-9fe5-0fb8999a0da5",
                        "glosses": [
                            "Membre d’un peuple présent dans plusieurs pays d’Afrique centrale, tels que le Gabon, le Cameroun, la Guinée équatoriale ou la République du Congo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59b6e399-d44b-41fb-a32a-aacc9bf737d6",
                                "sense_id": "0c30a278-1dab-3fdd-b5b6-4e39dff8cd55",
                                "text": "Elle appréhendait le retour du Pahouin, quand, soudain, il lui sembla reconnaître un morceau du vêtement du sorcier coincé entre deux des pierres du plafond."
                            },
                            {
                                "example_id": "71412d93-f652-4bb2-8f45-bf2fccfbe2bf",
                                "sense_id": "0c30a278-1dab-3fdd-b5b6-4e39dff8cd55",
                                "text": "Quand vous, par exemple, vous présentez un chat, si je réponds par un chien ; ou bien encore, si je m’approche, raffiné et courtois, et que je rencontre chez vous le sauvage, le Tartare ou le Pahouin (qui reviennent souvent), il est clair que l’entente ne sera pas bien cordiale."
                            }
                        ]
                    }
