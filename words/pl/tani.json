    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "50c6cea4-60dc-304b-8a1b-a5098ff9ec4a",
                    "sense_definition": "Mający niską cenę, niewymagający dużych nakładów finansowych.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "cena",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tym sklepie można kupić bardzo <w>tanie</w> owoce i warzywa.",
                            "target_lang_translations": {
                                "ru": "В этом магазине можно купить очень <w>дешёвые</w> овощи и фрукты.",
                                "en": "In this shop, you can buy very <w>cheap</w> fruit and vegetables.",
                                "de": "In diesem Laden kann man sehr <w>billiges</w> Obst und Gemüse kaufen."
                            }
                        },
                        {
                            "text": "Znalezienie <w>taniego</w> mieszkania w centrum miasta graniczy z cudem.",
                            "target_lang_translations": {
                                "ru": "Найти <w>недорогую</w> квартиру в центре города граничит с чудом.",
                                "en": "Finding an <w>inexpensive</w> apartment in the city center is next to a miracle.",
                                "de": "Eine <w>preiswerte</w> Wohnung im Stadtzentrum zu finden, grenzt an ein Wunder."
                            }
                        }
                    ],
                    "antonyms": [
                        "drogi",
                        "kosztowny"
                    ],
                    "common_phrases": [
                        "tani produkt",
                        "tanie bilety",
                        "tani koszt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий низкую цену, не требующий больших финансовых затрат.",
                        "en": "Having a low price, not requiring large financial outlays.",
                        "de": "Einen niedrigen Preis habend, nicht teuer."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дешёвый",
                                "target_lang_sense_clarification": "о цене"
                            },
                            {
                                "target_lang_word": "недорогой",
                                "target_lang_sense_clarification": "о цене"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "cheap",
                                "target_lang_sense_clarification": "low in price"
                            },
                            {
