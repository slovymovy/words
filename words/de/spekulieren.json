                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er übernahm freiwillig zusätzliche Aufgaben im Büro, weil er auf eine Beförderung <w>spekulierte</w>."
