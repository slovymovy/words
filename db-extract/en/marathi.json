                                "sense_id": "b2ede5b2-7b2f-3869-8145-99496699c535",
                                "text": "1882, R. V. Modak, History of the Native Churches Associated with the American Marathi Mission..., in Memorial Papers of the American Marathi Mission, 1813-1881, American Marathi Mission, page 11,\nIn March 1831, Moroba, a Marathi, was received to the church."
                            },
                            {
                                "example_id": "e029e1e1-8bfd-427a-971e-098ad38a184a",
                                "sense_id": "b2ede5b2-7b2f-3869-8145-99496699c535",
                                "text": "'These people want places reserved for Marathis in railways jobs, so they’re attacking candidates across the city … Bhai, this'll turn ugly before you know it.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6673ae36-55d9-49df-b308-750b486de863",
