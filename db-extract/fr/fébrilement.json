        "fr-extract.jsonl": [
            {
                "entry_id": "052937fa-d3f7-3a2e-b743-7416652fd1b1",
                "word": "fébrilement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5cb3297f-a22e-3234-b552-2af12a31ce22",
                        "entry_id": "052937fa-d3f7-3a2e-b743-7416652fd1b1",
                        "glosses": [
                            "D’une manière fébrile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20404202-e444-4714-978f-933f10bef244",
                                "sense_id": "5cb3297f-a22e-3234-b552-2af12a31ce22",
                                "text": "La saison des vide-greniers s'ouvre alors que le printemps pointe, pour la plus grande joie de tous leurs amateurs. Ceux-ci, vendeurs, « déballent » aux aurores sur des tréteaux branlants, ou « chineurs », farfouillent fébrilement dans les tas de vieilleries au charme désuet, en quête de la perle rare."
                            },
                            {
                                "example_id": "38ca81cb-d009-4f12-ac79-de39456ac15f",
                                "sense_id": "5cb3297f-a22e-3234-b552-2af12a31ce22",
                                "text": "J’avais cherché fébrilement de la monnaie dans mes poches pendant que les feux de détresse de la VW stationnée en double file clignotaient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70885ff2-3bf3-4863-a4d7-d77d4197647e",
                        "source_entry_id": "052937fa-d3f7-3a2e-b743-7416652fd1b1",
                        "source_sense_id": "5cb3297f-a22e-3234-b552-2af12a31ce22",
                        "target_lang_word": "feverishly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feverishly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94eab0fa-269c-3744-ac55-8917c531697d",
                                        "entry_id": "64dfd729-cbfe-3bc3-9b6b-a9fbfae4f8d8",
                                        "glosses": [
                                            "With excitement and determination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef799ae4-bc9b-4c4f-8d05-14cdc07e19f6",
                                                "sense_id": "94eab0fa-269c-3744-ac55-8917c531697d",
                                                "text": "The US believes Israel has significantly weakened Hezbollah in strikes over the last week but is still working feverishly behind the scenes to try to convince it not to escalate further and launch a ground incursion into Lebanon over concerns the intensified fighting could spark a broader conflict engulfing the wider Middle East, officials told CNN."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eedadb58-ccb7-38e8-9d90-9be822c7a77e",
                                        "entry_id": "64dfd729-cbfe-3bc3-9b6b-a9fbfae4f8d8",
                                        "glosses": [
                                            "With speed; rapidly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9a692c0-5395-459b-adc1-80c9ec540d67",
                                                "sense_id": "eedadb58-ccb7-38e8-9d90-9be822c7a77e",
                                                "text": "In the outer room the two women knitted black wool feverishly."
                                            },
                                            {
                                                "example_id": "ca064fea-5204-46f9-8611-f861f28784f9",
                                                "sense_id": "eedadb58-ccb7-38e8-9d90-9be822c7a77e",
                                                "text": "All the way to Styles, Mary talked fast and feverishly. It struck me that in some way she was nervous of Poirot’s eyes."
                                            },
                                            {
                                                "example_id": "2a3b089c-409c-424e-9c05-df8c29be78fc",
                                                "sense_id": "eedadb58-ccb7-38e8-9d90-9be822c7a77e",
                                                "text": "With nothing else to do, he carried the candle to the front room and began feverishly filling his pipe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83640023-46e3-4f91-b059-1280e00e88e6",
                        "source_entry_id": "052937fa-d3f7-3a2e-b743-7416652fd1b1",
