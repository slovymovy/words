                                    {
                                        "sense_id": "024ad327-b442-3f21-965e-a8d867bfd8d1",
                                        "entry_id": "b342f759-4574-3455-a893-7d9ea978487a",
                                        "glosses": [
                                            "Dicho de una serie de movimientos surgidos en los Estados Unidos destinados a erradicar la discriminación."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02dd4996-c683-3da2-bac1-2bc93f44820b",
                                        "entry_id": "b342f759-4574-3455-a893-7d9ea978487a",
                                        "glosses": [
                                            "Por extensión, cualquier movimiento progresista o de izquierda."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55023f96-6324-42b4-ab7c-ae9fa6f70e59",
                                                "sense_id": "02dd4996-c683-3da2-bac1-2bc93f44820b",
                                                "text": "Miren ustedes Disney (se hablaba recién de Disney). Disney viene a pérdida. Disney viene en crisis. Viene en caída libre, entre otras cosas, por el wokismo que ha alcanzado. Ahora bien, los accionistas en Disney, los pequeños accionistas están desesperados por cambiar a los directores. Pero ¿quién tiene la mayoría del paquete accionario de Disney? Dos firmas: BlackRock y Vanguard, que son las que bloquean permanentemente a los directores, porque esos son los directores woke."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
