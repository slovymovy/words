                        "glosses": [
                            "Faire quitter un brancard à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e5d1f5c-a964-43f1-8333-c488a5c5814a",
                                "sense_id": "9d370146-cc62-3733-980d-d36f8f42cc33",
                                "text": "Il est bien connu maintenant qu’un grand malheur s’est abattu sur cette jeunesse débrancardée."
                            },
                            {
                                "example_id": "b8ebbd5b-d0c1-4e6c-bb5e-20f659305974",
                                "sense_id": "9d370146-cc62-3733-980d-d36f8f42cc33",
                                "text": "J’ai dû rebrancher mon répondeur Connecté aux plombs de ma moquette En débrancardant un dépanneur. Qui venait chialer à la K-fette."
                            }
                        ]
                    }
