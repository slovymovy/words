                "senses": [
                    {
                        "sense_id": "408df38e-b206-3cca-b747-6e063de5ec1f",
                        "entry_id": "7b732836-2349-3549-9c5f-33d33643e361",
                        "glosses": [
                            "onderdeel van een voertuig waarmee de gebruiker richting en snelheid bepaalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f06b502-f3f6-4571-87ac-3f45ae8b9eb8",
                                "sense_id": "408df38e-b206-3cca-b747-6e063de5ec1f",
                                "text": "Net als in een vliegtuig zullen in een auto binnenkort geen fysieke verbindingen meer bestaan tussen de besturingsorganen (stuurwiel, gas- en rempedaal en versnellingspook) en de elementen die de vereiste manoeuvres uitvoeren."
                            },
                            {
                                "example_id": "04410708-b5b1-4c79-9b17-c43288b7a1da",
                                "sense_id": "408df38e-b206-3cca-b747-6e063de5ec1f",
                                "text": "Het sturen gebeurt met behulp van een klein stuurknuppeltje (joystick) op een van de armleuningen. Voor gehandicapten die hun armen of vingers slecht kunnen bewegen, worden andere besturingsorganen ontwikkeld."
                            },
                            {
                                "example_id": "82505ab0-3996-42eb-bad4-c432f7c89099",
                                "sense_id": "408df38e-b206-3cca-b747-6e063de5ec1f",
                                "text": "Hier vallen een besturingsorgaan voor pallettrucks, een zuurkast en een spreidtang in de prijzen."
                            }
                        ]
                    },
                    {
                        "sense_id": "40c4e904-4a26-3cf5-941d-7f69ed20a417",
                        "entry_id": "7b732836-2349-3549-9c5f-33d33643e361",
                        "glosses": [
                            "onderdeel van een apparaat waarmee de gebruiker de precieze werking daarvan kan bepalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84bb34f3-71d2-4874-8ebb-77f8e149a85a",
                                "sense_id": "40c4e904-4a26-3cf5-941d-7f69ed20a417",
                                "text": "Wat dat laatste betreft kunnen we denken aan het gebruik van computers als besturingsorgaan voor meet- en regelapparatuur in de tuinbouw (de kassen) en voor het opslaan van gegevens in de rundveehouderij."
                            },
                            {
                                "example_id": "dd4593e1-4902-4e2b-b5b5-a0471f9e66a8",
                                "sense_id": "40c4e904-4a26-3cf5-941d-7f69ed20a417",
                                "text": "Tenslotte nog wordt de richtspaak overgelegd, welke dienst doet als besturingsorgaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c28d451-1141-3656-a77e-22a30dcff523",
                        "entry_id": "7b732836-2349-3549-9c5f-33d33643e361",
                        "glosses": [
                            "onderdeel van een organisatie dat te behalen doelstellingen en te gebruiken werkwijzen bepaalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44cd4fda-f8a1-4e15-a25c-bfda6efefdd0",
                                "sense_id": "2c28d451-1141-3656-a77e-22a30dcff523",
                                "text": "Zo mag men niet verwachten onmiddellijk een definitieve oplossing te vinden, maar men moet leren werken met een besturingsorgaan dat telkens de aanpassing aan gewijzigde situaties en doelstellingen tot stand weet te brengen."
                            },
                            {
                                "example_id": "2f904603-d044-4918-8b9d-7971931d20ce",
                                "sense_id": "2c28d451-1141-3656-a77e-22a30dcff523",
                                "text": "In de leiding van de besturingsorganen van de gesocialiseerde bedrijven zouden vier belangengroepen steeds vertegenwoordigd zijn: arbeiders, technici en bedrijfsleiders, consumenten en de overheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "156dbdf3-0e2a-36b8-a330-e992c7057d34",
                        "entry_id": "7b732836-2349-3549-9c5f-33d33643e361",
                        "glosses": [
                            "middel om richting te geven aan een organisatie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c676be96-b6b2-48a1-a346-a9ed6459b596",
                                "sense_id": "156dbdf3-0e2a-36b8-a330-e992c7057d34",
                                "text": "Bij tal van ondernemingen begint men de ondernemingscultuur inmiddels te gebruiken als een subtiel besturingsorgaan dat doorwerkt in de officiële besluitvormings- en bestuursprocessen. Ze wordt tot het \"bindmiddel' dat de onderneming bijeenhoudt."
                            }
                        ]
                    }
