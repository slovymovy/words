                    {
                        "translation_id": "efb418fc-0752-408c-a73b-f108179f675f",
                        "source_entry_id": "0412e932-c306-3cb7-8d0e-39042f7c00bc",
                        "source_sense_id": "323db1ab-60ea-30f1-a8dd-0020c56a72b3",
                        "target_lang_word": "Eigenart",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eigenart",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a05df565-88dd-3c9c-a04f-428fbdfeeb1c",
                                        "entry_id": "57924595-acfb-3edc-ac26-cb6c74088b14",
                                        "glosses": [
                                            "eine einzelne, spezifische Besonderheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e72bd186-17f2-4643-bfb8-b7471d357471",
                                                "sense_id": "a05df565-88dd-3c9c-a04f-428fbdfeeb1c",
                                                "text": "Eine Eigenart der deutschen Sprache ist die anschauliche Wortprägung."
                                            },
                                            {
                                                "example_id": "da0da4c2-b547-4d4f-a91a-bce8ece70f97",
                                                "sense_id": "a05df565-88dd-3c9c-a04f-428fbdfeeb1c",
                                                "text": "„Es gibt in Polen diese wunderbare Eigenart, fremde Menschen nicht mit ihrem Nachnamen anzusprechen.“"
                                            },
                                            {
                                                "example_id": "1e638da6-3bef-4d2f-ae7c-d2e50714d500",
                                                "sense_id": "a05df565-88dd-3c9c-a04f-428fbdfeeb1c",
                                                "text": "Der Hund hat die Eigenart, immer im Kreis zu tanzen, sobald er seinen Fressnapf sieht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "78eab2ff-1227-35e0-935f-c09f7602f16c",
                                        "entry_id": "57924595-acfb-3edc-ac26-cb6c74088b14",
                                        "glosses": [
                                            "summierte Besonderheiten, die ein Charakteristikum ausmachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6de937bb-1fda-4b4f-9028-4155d9938dac",
                                                "sense_id": "78eab2ff-1227-35e0-935f-c09f7602f16c",
                                                "text": "Wenn Sie erst einmal die Eigenart unserer Firma kennengelernt haben, werden Sie sich sicher schnell hier sehr wohl fühlen."
                                            },
                                            {
                                                "example_id": "f93d34cd-f13a-4d11-83d2-e0778668b644",
                                                "sense_id": "78eab2ff-1227-35e0-935f-c09f7602f16c",
                                                "text": "„Eine andere und sozusagen berufsmäßige Eigenart Pauls bestand darin, daß seine ganze Teilnahme und Arbeitskraft nur den Verwundeten in seinem Lazarett galt, so daß der sterbende Brussaroff in Gurna ihn weniger interessierte als ein beliebiger Soldat, den er am Tag vorher operiert hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "188a1ed7-8431-46f0-921a-2f64638d24ad",
                        "source_entry_id": "0412e932-c306-3cb7-8d0e-39042f7c00bc",
                        "source_sense_id": "323db1ab-60ea-30f1-a8dd-0020c56a72b3",
                        "target_lang_word": "Eigenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eigenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e46f838d-e35d-32e3-b811-8050536aade1",
                                        "entry_id": "fad1a37e-70ee-3151-ac50-be22095b8c89",
                                        "glosses": [
                                            "Merkwürdigkeit, Auffälligkeit , die jemand oder etwas aufweist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0e17097-1aea-455a-b558-db4df3b42402",
                                                "sense_id": "e46f838d-e35d-32e3-b811-8050536aade1",
                                                "text": "Er weist sonderbare Eigenheiten auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "582e3529-2b70-49d7-9743-0ac85baaacbe",
                        "source_entry_id": "0412e932-c306-3cb7-8d0e-39042f7c00bc",
                        "source_sense_id": "323db1ab-60ea-30f1-a8dd-0020c56a72b3",
                        "target_lang_word": "Eigentümlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eigentümlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a0ec34d-cd32-3866-ba16-551c25c63dc9",
                                        "entry_id": "2e5363c8-5ff1-322c-aa66-9dc2b4305d94",
                                        "glosses": [
                                            "etwas, das vom Gewöhnlichen abweicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d5236f7-9947-4692-9fcf-2575d0c92b86",
                                                "sense_id": "3a0ec34d-cd32-3866-ba16-551c25c63dc9",
                                                "text": "„Martin Luther gründete seine sprachliche Leistung auf das Meißnische, die Verkehrssprache seiner Heimat, deren Wortschatz und lautliche Eigentümlichkeiten er gebrauchte und weitgehend bewahrte.“"
                                            },
                                            {
                                                "example_id": "48fd3e0c-8e74-4bb0-b2fe-d42df34dbfb2",
                                                "sense_id": "3a0ec34d-cd32-3866-ba16-551c25c63dc9",
                                                "text": "„Versprecher haben zwei Eigentümlichkeiten: Einerseits sind sie ganz alltägliche sprachliche Pannen, ungeplant und ugewollt.“"
                                            },
                                            {
                                                "example_id": "421c48d2-b490-4ae6-9db5-bfe964ee2b27",
                                                "sense_id": "3a0ec34d-cd32-3866-ba16-551c25c63dc9",
                                                "text": "„Und gerade diese Eigentümlichkeit der Speranskijschen Verstandeswelt zog den Fürsten Andrej so sehr an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
