                ],
                "senses": [
                    {
                        "sense_id": "ed418552-341b-3330-8eeb-de4009dd6c6a",
                        "entry_id": "b6eb6c5c-bb71-31eb-a353-4b4de3167d48",
                        "glosses": [
                            "alljährlich am Abend des 14. Nisan beginnendes, sieben Tage währendes Fest, an dem des Auszugs des jüdischen Volkes aus Ägypten gedacht wird"
                        ],
                        "tags": [
                            "jüdische Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "c32490ad-fd43-4f35-9de9-b8c449467123",
                                "sense_id": "ed418552-341b-3330-8eeb-de4009dd6c6a",
                                "text": "„Doch Ostern ist eine gute Zeit, sich zu vergegenwärtigen, dass das jüdische Passah, bevor es mit religiösem Inhalt erfüllt wurde, als Fest des alljährlichen ersten Gestenschnittes gefeiert wurde. (Das Wochenfest, bzw. Pfingsten markierte den ersten Weizenschnitt, das Laubhüttenfest die Obst- und Weinernte.) Nicht zufällig ist geboten, an Passah ungesäuertes Brot, \"das Brot des Elends\" (5. Mose 15.16) zu essen; nicht zufällig liegen vor Ostern die wichtigsten Fastenzeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9cd2a44e-1d54-334c-8797-051015728c61",
                        "entry_id": "b6eb6c5c-bb71-31eb-a353-4b4de3167d48",
                        "glosses": [
                            "jüdische Religion: Kurzform von hebräisch קרבן פסח (Korban Pessach) ^(→ he) („Pessachopfer“): Lamm, das in biblischen Zeiten anlässlich des unter [1] beschriebenen Fests am Sederabend verspeist wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f6bedcb-54bb-468f-87ec-b169f1eafcc6",
                                "sense_id": "9cd2a44e-1d54-334c-8797-051015728c61",
                                "text": "„Und du sollst für den HERRN, deinen Gott, das Passah schlachten, Schafe und Rinder, an der Stätte, die der HERR erwählen wird, um seinen Namen dort wohnen zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb4a4ff0-5937-4d6f-8dec-e1f61ebef847",
                        "source_entry_id": "b6eb6c5c-bb71-31eb-a353-4b4de3167d48",
                        "source_sense_id": "ed418552-341b-3330-8eeb-de4009dd6c6a",
                        "target_lang_word": "Passover",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Passover",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "238178f7-8645-3ac3-8aed-31f3182931cf",
                                        "entry_id": "dd4985cd-3db4-33d2-8b5f-cf98ca48661c",
                                        "glosses": [
                                            "The one-day Biblical feast or festival (not a holy day) that begins at twilight at the beginning of the fourteenth day of the first month (Abib 14 / Nisan 14), during which the first-born sons of the Israelites were passed over while those of the Egyptians were killed; this feast day is then immediately followed by the seven-day Feast of Unleavened Bread (Nisan 15 to 21; the first and seventh days are holy days or annual or yearly Sabbaths)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5205f96c-475e-4fb3-b089-fc4b224ea864",
                                                "sense_id": "238178f7-8645-3ac3-8aed-31f3182931cf",
                                                "text": "⁵ In the first month, on the fourteenth day of the month at twilight is the Lord's Passover. ⁶ Then on the fifteenth day of the same month there is the Feast of Unleavened Bread to the Lord; for seven days you shall eat unleavened bread. ⁷ On the first day you shall have a holy convocation; you shall not do any laborious work. ⁸ But for seven days you shall present an offering by fire to the Lord. On the seventh day is a holy convocation; you shall not do any laborious work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0d45b1f-fea0-3d46-9bc5-bdedda2237ec",
                                        "entry_id": "dd4985cd-3db4-33d2-8b5f-cf98ca48661c",
                                        "glosses": [
                                            "The seven-day (Reform Judaism) or eight-day (Orthodox and Conservative Judaism) Jewish festival of Pesach (also called the Feast of Unleavened Bread (מַצּוֹת (matsót)), commemorating the biblical story of the Exodus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
