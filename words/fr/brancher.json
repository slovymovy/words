                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "aborder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce garçon passe toute sa soirée à essayer de <w>brancher</w> des filles au bar."
                        },
                        {
                            "text": "Elle en a assez de se faire <w>brancher</w> dès qu'elle sort dans une fête."
                        }
                    ],
                    "common_phrases": [
