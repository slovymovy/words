                                                "sense_id": "a69e27c4-02ac-3d71-b7f5-00fd29bc8b65",
                                                "text": "Die Imago schlüpfte schon nach drei Tagen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f3593a72-9f90-31db-bf12-ff030af6740f",
                                        "entry_id": "0edf146e-8737-361a-83d9-fb7cbd5e185d",
                                        "glosses": [
                                            "unbewusstes Vorstellungsbild, Idealbild einer bestimmten Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7708d76-9103-4035-8dab-7ea2c50476b5",
                                                "sense_id": "f3593a72-9f90-31db-bf12-ff030af6740f",
                                                "text": "Ich habe eine schlechte Imago von dieser Person."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "277b9ff3-4c16-4944-a01d-84c667292e33",
                        "source_entry_id": "8228dcc7-99d6-3a58-a78f-f8da1d0bb3b2",
