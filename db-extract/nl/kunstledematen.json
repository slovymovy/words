                        "examples": [
                            {
                                "example_id": "235d951d-aaf5-4ae4-a5ed-abba97d23999",
                                "sense_id": "c9e63873-afd6-317e-a5e3-0338785a8ada",
                                "text": "Bergen bezittingen koffers, rugzakken, kisten, plunjezakken; pakjes; dekens; kinderwagens, rolstoelen, kunstledematen; borstels, kammen."
                            },
                            {
                                "example_id": "db9f0f73-7ed0-434e-9327-0693f32fc096",
                                "sense_id": "c9e63873-afd6-317e-a5e3-0338785a8ada",
                                "text": "De oorlog in Oekraïne zorgt voor een stroom aan gewonde soldaten. Dat betekent dat er steeds meer kunstledematen nodig zijn. Klinieken die protheses maken kunnen de vraag nu al niet bijbenen, en dat kan bij een tegenoffensief alleen nog maar erger worden."
                            }
                        ]
                    }
