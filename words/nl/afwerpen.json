                },
                {
                    "sense_id": "70f39125-9c39-3307-a4fa-b57d3c84be7f",
                    "sense_definition": "iets van zich afschudden, loslaten of zich ontdoen van een last of kledingstuk",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verwijderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij slaagden er na jaren van strijd in het juk van de bezetter <w>af</w> te <w>werpen</w>.",
                            "target_lang_translations": {
                                "en": "After years of struggle, they succeeded in <w>throwing off</w> the yoke of the occupier."
                            }
                        },
                        {
                            "text": "De hardloper moest zijn zware jas <w>afwerpen</w> om sneller te kunnen bewegen.",
                            "target_lang_translations": {
                                "en": "The runner had to <w>shed</w> his heavy coat to be able to move faster."
                            }
                        }
                    ],
                    "synonyms": [
                        "afschudden",
                        "ontdoen",
                        "afleggen"
                    ],
                    "antonyms": [
                        "aannemen",
                        "dragen"
                    ],
                    "common_phrases": [
                        "een juk afwerpen",
                        "van zich afwerpen"
                    ],
                    "target_lang_definitions": {
                        "en": "To shake off, cast off, or rid oneself of a burden, yoke, or piece of clothing"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "throw off",
                                "target_lang_sense_clarification": "to rid oneself of a burden or clothing"
                            },
                            {
                                "target_lang_word": "cast off",
                                "target_lang_sense_clarification": "to discard or shake off a yoke or constraint"
                            },
                            {
                                "target_lang_word": "shake off",
                                "target_lang_sense_clarification": "to free oneself from something restrictive"
                            }
                        ]
                    }
                }
