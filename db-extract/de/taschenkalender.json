                        "source_sense_id": "6d49ee9c-95ee-38fc-99e5-96daa8bad8a1",
                        "source_sense_description": "Kalender, den man in seiner Tasche mit sich führen kann",
                        "target_lang_word": "diary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diary",
