            "senses": [
                {
                    "sense_id": "8c999a64-19dd-3bf1-bacb-ed8ae5efb9fd",
                    "sense_definition": "Der Vorgang des Entleerens eines Behälters oder des Auszahlens von Finanzmitteln; substantivierte Form des Verbs <w>ausschütten</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim <w>Ausschütten</w> des heißen Wassers verbrannte er sich leicht an der Hand."
                        },
