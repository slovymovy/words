                    "frequency": "Middle",
                    "semantic_group_id": "auftauchen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ohne vorher anzuklopfen, <w>platzte</w> der Schüler mitten in den Unterricht."
