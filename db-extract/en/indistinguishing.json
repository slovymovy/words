                        "glosses": [
                            "Making no difference; indiscriminate; impartial."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5371bd8a-d66e-4c69-a498-393b3b92bcaa",
                                "sense_id": "7126616c-1f11-38bd-94dc-fcd33aa2ccf9",
                                "text": "indistinguishing liberalities"
                            },
                            {
                                "example_id": "62f4eb19-27d6-4fc4-a812-cba27a6b5645",
                                "sense_id": "7126616c-1f11-38bd-94dc-fcd33aa2ccf9",
                                "text": "It is from an attentive observation of his conduct, not from the exaggerated praise of the native or the indistinguishing censure of the foreign historians, that a true idea of his genius and abilities is to be collected."
                            }
                        ]
                    }
