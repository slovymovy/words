                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97d22691-3a95-4c7b-baf9-9634dd0b90b0",
                                                "sense_id": "6c451a4c-8f03-33af-b0f8-70ad0d50c3c9",
                                                "text": "Here's a cure for all your troubles\n Here's an end to all distress\n It's the old dope peddler\n With his powdered happiness"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05c93f35-e857-3126-a820-fc9f851d5bb9",
