                                                "sense_id": "e9f47825-5fab-3cc9-ae16-ca1b32aab5ee",
                                                "text": "My wife is on a two year maternity leave while she takes care of her newborn baby."
                                            },
                                            {
                                                "example_id": "ca12a19c-80cd-4374-8954-748558393aff",
                                                "sense_id": "e9f47825-5fab-3cc9-ae16-ca1b32aab5ee",
                                                "text": "I went on maternity leave in May 2022, so have been away for nearly 14 months."
                                            }
