                        "source_sense_id": "7be59dc6-f28d-3fa7-af5e-7f9c019e7bb6",
                        "target_lang_word": "litigious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "litigious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "333d53a5-f644-312e-a020-1b2d2fbf9ec3",
                                        "entry_id": "6cee95f7-492b-3437-99f6-b287105ac890",
                                        "glosses": [
                                            "Of or relating to litigation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faccacea-e6b0-4618-8729-9f99132cedb5",
                                                "sense_id": "333d53a5-f644-312e-a020-1b2d2fbf9ec3",
                                                "text": "This vvould of Neceſſity, breed an infinite Number of Brangles and litigious Suits in the Spiritual Courts, and put the vvretched Paſtor at perpetual Variance vvith his vvhole Pariſh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c551c430-8f59-3148-a225-32e7f768de2a",
                                        "entry_id": "6cee95f7-492b-3437-99f6-b287105ac890",
                                        "glosses": [
                                            "Inclined to engage in lawsuits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f4e2560-ac65-4aa3-b23d-7bf75d3336ac",
                                                "sense_id": "c551c430-8f59-3148-a225-32e7f768de2a",
                                                "text": "Tearing a page out of Monsanto's own playbook, the Public Patent Foundation (PUBPAT), an advocacy group whose mandate is to represent the public's interest in the patent system, filed suit (PDF) on behalf of 60 organic farmers, small farm organizations, and seed businesses this week against the litigious agrichemical and genetically modified (GM) seed giant."
                                            },
                                            {
                                                "example_id": "4771ebe2-792f-455e-8c3f-8a22bcb8ecaf",
                                                "sense_id": "c551c430-8f59-3148-a225-32e7f768de2a",
                                                "text": "The United States is a litigious society."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47796fc3-02d0-352c-96c0-d2c5d40df888",
                                        "entry_id": "6cee95f7-492b-3437-99f6-b287105ac890",
                                        "glosses": [
                                            "Argumentative or combative."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0339a6ab-51fc-49a3-9cbd-ed61b5a918f7",
                        "source_entry_id": "7974925b-b8bd-3ed8-b692-ac9ff629be31",
                        "source_sense_id": "7be59dc6-f28d-3fa7-af5e-7f9c019e7bb6",
                        "target_lang_word": "barrator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barrator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ae6c6eb-38aa-3e76-a69b-86ba6849a97c",
                                        "entry_id": "27893714-6193-35e3-a57e-ceb379cee77f",
                                        "glosses": [
                                            "One who is guilty of barratry, vexing others with frequent and often groundless lawsuits; a brangler and pettifogger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9fab468-0f17-43c7-a5b4-814a71edf607",
                                                "sense_id": "7ae6c6eb-38aa-3e76-a69b-86ba6849a97c",
                                                "text": "But by Hawk. P. C. bk. 1, c. 21, if such suits are merely groundless, and brought only with a design to oppress the defendants, such a man may as properly be called a barrator as if he had stirred up others to bring them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fce0796d-038d-38fc-bfdb-5e950282d0ff",
                                        "entry_id": "27893714-6193-35e3-a57e-ceb379cee77f",
                                        "glosses": [
                                            "One who abuses their office by dealing fraudulently.",
                                            "One who buys or sells political or ecclesiastic offices."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4428da1b-9a52-3412-a426-6b349d6b1410",
                                        "entry_id": "27893714-6193-35e3-a57e-ceb379cee77f",
                                        "glosses": [
                                            "One who abuses their office by dealing fraudulently.",
                                            "A judge who accepts bribes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6285b823-e461-3a72-ac86-cb44cc1c4e26",
                                        "entry_id": "27893714-6193-35e3-a57e-ceb379cee77f",
                                        "glosses": [
                                            "One who abuses their office by dealing fraudulently.",
                                            "A ship's master who commits gross fraud or barratry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df93e535-1514-3cc6-a727-45f6cded4d50",
                                        "entry_id": "27893714-6193-35e3-a57e-ceb379cee77f",
                                        "glosses": [
                                            "A quarrelsome person, one who fights, a bully."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "358519d1-d7f2-49a6-ae60-b92237503351",
                                                "sense_id": "df93e535-1514-3cc6-a727-45f6cded4d50",
                                                "text": "I care not though men call me impudent, / Smooth-tongu'd, audacious, petulant, abhominable, / Forger of vvords and lie, contentious Barretour, / Old, vvinding, bragging, teſty, crafty fox."
                                            }
                                        ]
                                    }
                                ]
                            }
