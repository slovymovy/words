    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c1c3ebf3-6443-316a-a813-b1f323faeafa",
                    "sense_definition": "zmniejszać bądź usuwać objawy bólu lub cierpienia",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "łagodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz przepisał silne tabletki, aby <w>uśmierzyć</w> ostry ból po operacji.",
                            "target_lang_translations": {
                                "ru": "Врач прописал сильные таблетки, чтобы <w>утолить</w> острую боль после операции."
                            }
                        },
                        {
                            "text": "Wypicie ciepłej herbaty z miodem może <w>uśmierzyć</w> ból gardła.",
                            "target_lang_translations": {
                                "ru": "Чашка теплого чая с медом может <w>облегчить</w> боль в горле."
                            }
                        }
                    ],
                    "synonyms": [
                        "koić",
                        "łagodzić"
                    ],
                    "common_phrases": [
                        "uśmierzać ból"
                    ],
                    "target_lang_definitions": {
                        "ru": "уменьшать или устранять симптомы боли или страдания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утолять",
                                "target_lang_sense_clarification": "обычно используется с болью, голодом или жаждой"
                            },
                            {
                                "target_lang_word": "облегчать",
                                "target_lang_sense_clarification": "делать боль или страдание менее интенсивными"
                            },
                            {
                                "target_lang_word": "снимать",
                                "target_lang_sense_clarification": "устранять болевые ощущения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a11c7de8-8eb0-3ee6-8c7f-9c3fafcb0bb8",
                    "sense_definition": "powodować ustępowanie lub zakończenie negatywnego stanu lub emocji",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "łagodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Policja przybyła na miejsce, aby <w>uśmierzyć</w> zamieszki w centrum miasta.",
                            "target_lang_translations": {
                                "ru": "Полиция прибыла на место, чтобы <w>подавить</w> беспорядки в центре города."
                            }
                        },
                        {
                            "text": "Próbowano <w>uśmierzyć</w> niepokój społeczny poprzez obietnice reform.",
                            "target_lang_translations": {
                                "ru": "Пытались <w>унять</w> общественное беспокойство с помощью обещаний реформ."
                            }
                        }
                    ],
                    "synonyms": [
                        "tłumić"
                    ],
                    "common_phrases": [
                        "uśmierzać niepokój",
                        "uśmierzać zamieszki"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывать прекращение или ослабление негативного состояния, эмоций или беспорядков"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавлять",
                                "target_lang_sense_clarification": "силовое прекращение беспорядков или восстаний"
                            },
                            {
                                "target_lang_word": "унимать",
                                "target_lang_sense_clarification": "успокаивать волнение или беспокойство"
                            },
                            {
                                "target_lang_word": "усмирять",
                                "target_lang_sense_clarification": "приводить к покорности или спокойствию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25da02b1-8226-3574-bfd0-1702928b3e46",
                    "sense_definition": "stawać się mniej dokuczliwym lub intensywnym",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "łagodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po kilku godzinach ulewa w końcu zaczęła się <w>uśmierzać</w>.",
                            "target_lang_translations": {
                                "ru": "Через несколько часов ливень наконец начал <w>стихать</w>."
                            }
                        },
                        {
                            "text": "Wiatr <w>uśmierza</w> się powoli, co pozwala na bezpieczny powrót do portu.",
                            "target_lang_translations": {
                                "ru": "Ветер медленно <w>утихает</w>, что позволяет безопасно вернуться в порт."
                            }
                        }
                    ],
                    "synonyms": [
                        "łagodnieć"
                    ],
                    "common_phrases": [
                        "wiatr uśmierza się"
                    ],
                    "target_lang_definitions": {
                        "ru": "становиться менее интенсивным или тягостным"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стихать",
                                "target_lang_sense_clarification": "о ветре, дожде или шуме"
                            },
                            {
                                "target_lang_word": "утихать",
                                "target_lang_sense_clarification": "о природных явлениях или сильных эмоциях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
