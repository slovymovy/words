                        "examples": [
                            {
                                "example_id": "375e0109-7200-4145-a019-4cc961b64369",
                                "sense_id": "aea19329-fef5-3b30-b19f-364044515f4c",
                                "text": "„Weitere Ethnien sind Araber, Kasaken, Tataren und Mogol in Nordafghanistan, Brahui und Jat in Südafghanistan, Gujar in Ostafghanistan sowie die bereits erwähnten Hindus und Sikhs, die in ost- und südafghanischen Städten leben.“"
                            },
                            {
                                "example_id": "2ebd2a66-9a96-46f8-9803-94251b80745e",
                                "sense_id": "aea19329-fef5-3b30-b19f-364044515f4c",
                                "text": "„Damit bewegte sich die Operation wieder im Zeitplan, nachdem das Einfliegen des Teams nach Ostafghanistan per Helikopter zuvor Verzögerungen verursacht hatte.“"
                            },
                            {
                                "example_id": "8dde045d-5b4a-460b-a561-eb3b1c11a912",
                                "sense_id": "aea19329-fef5-3b30-b19f-364044515f4c",
                                "text": "„Die Taliban waren auch gezwungen, zunehmend Männer aus den Ghilzai-Paschtunenstämmen aus Ostafghanistan und Pakistan zu rekrutieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
