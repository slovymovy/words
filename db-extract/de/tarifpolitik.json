                "senses": [
                    {
                        "sense_id": "dd0c0a64-b246-36c6-8b49-3e786ff99530",
                        "entry_id": "185c2d9f-dd90-3353-a69c-8dfbb611a6f6",
                        "glosses": [
                            "politisches Handeln und Gesamtheit der Fragen im Zusammenhang mit dem Aushandeln oder dem Abschluss von Tarifverträgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7a4bfc1-3e6f-4bcc-83d4-b45d9e51992f",
                                "sense_id": "dd0c0a64-b246-36c6-8b49-3e786ff99530",
                                "text": "„Nach mehreren Anläufen einigen sich die Tarifpartner unter der Vermittlung von Bundeskanzler Gerhard Schröder (SPD) auf einen Kompromiss, der ein früheres Ausscheiden aus dem Berufsleben mit einer längerfristig angelegten Tarifpolitik verknüpft.“"
                            },
                            {
                                "example_id": "38df4446-2909-4369-bdf7-3e2880b2559c",
                                "sense_id": "dd0c0a64-b246-36c6-8b49-3e786ff99530",
                                "text": "„Neben der Lohnpolitik umfasst die Tarifpolitik die Erhaltung bestehender Arbeitsplätze, die Ausgestaltung der Arbeitszeit und die Verbesserung der Arbeitsbedingungen (z. B. Grenzwerte für Temperaturen, Abgase oder Strahlenbelastung).“"
                            }
                        ],
