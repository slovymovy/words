                "translations": [
                    {
                        "translation_id": "d86eebbe-894b-4ee8-bc73-7814ecaff24c",
                        "source_entry_id": "ea23e1ee-de92-361a-8c7a-f949a462bf3b",
                        "source_sense_id": "82bf2087-0502-34a3-8ded-38bd087dd7f8",
                        "target_lang_word": "icor",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "icor",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "eedcafd8-abd8-38f0-8ccc-0b86dafd828c",
                                        "entry_id": "afd13e16-7df6-374d-aa56-520fa018e099",
                                        "glosses": [
                                            "Fluido claro que cumple la función de la sangre en los dioses, obtenido de la ambrosía y el néctar que estos consumen."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef9118c2-68a2-4a0d-8a3a-72194117f183",
                                                "sense_id": "eedcafd8-abd8-38f0-8ccc-0b86dafd828c",
                                                "text": "y derramó así el icor, la sangre inmortal que se agita en las venas de los bienaventurados dioses; pues ellos no comen del pan, ni beben del negro vino, y su sangre no es como la nuestra y son llamados inmortales."
                                            },
                                            {
                                                "example_id": "df9c548f-6824-4de8-bb68-d92a97de34ba",
                                                "sense_id": "eedcafd8-abd8-38f0-8ccc-0b86dafd828c",
                                                "text": "una sangre sutil y delicada y etérea, como el icor de las deidades del Olimpo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4d3a8b2-aa9c-3835-9dfb-39860e6332d1",
                                        "entry_id": "afd13e16-7df6-374d-aa56-520fa018e099",
                                        "glosses": [
                                            "Fluido similar al pus, de color claro y consistencia similar al suero, que los antiguos médicos identificaban como secreción de algunas lesiones ulcerosas de la piel."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d5c36a7-5735-4814-b6c4-cf053a590b2e",
                                                "sense_id": "c4d3a8b2-aa9c-3835-9dfb-39860e6332d1",
                                                "text": "Las afecciones crónicas dan más comunmente lugar á colecciones ó secreciones icorosas, lo que sucede en el cáncer, la gota, en el reumatismo y aun en las herpes. Este icor consiste en una serosidad inocente si está enquistada, corrosiva si es segregada en superficies libres, y aun inoculable y capaz de hacer el papel de vírus como en algunas enfermedades herpéticas y escrofulosas."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3f66408c-b63e-3be0-af16-96a9329e4ea2",
                                        "entry_id": "afd13e16-7df6-374d-aa56-520fa018e099",
                                        "glosses": [
                                            "Líquido amargo, de color amarillo verdoso, segregado por el hígado."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "51e66858-2322-3319-9692-e567bfaa8878",
                                        "entry_id": "afd13e16-7df6-374d-aa56-520fa018e099",
                                        "glosses": [
                                            "fluido similar a la sangre que se encuentra en diversos seres sobrenaturales, demoníacos o extraterrestres."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c20639b-9bae-4a16-9578-4ec91be9cebd",
                        "source_entry_id": "ea23e1ee-de92-361a-8c7a-f949a462bf3b",
                        "source_sense_id": "0e186abe-d1b4-3ee8-8450-2113b70678f5",
                        "target_lang_word": "Schweiß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schweiß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57a66535-377a-37a1-8857-4bf1fa53b8e6",
                                        "entry_id": "fd9e1c47-da8f-3f73-b3b3-8eb34c3f4208",
                                        "glosses": [
                                            "Sekret der Schweißdrüsen, das Menschen beim Schwitzen absondern"
                                        ],
                                        "tags": [
                                            "Physiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71f7f969-4f4f-4a27-89d9-ec183566e2e6",
                                                "sense_id": "57a66535-377a-37a1-8857-4bf1fa53b8e6",
                                                "text": "Schweiß dient der Kühlung des Körpers."
                                            },
                                            {
                                                "example_id": "bf4a6050-fd27-4e76-be47-0cdb5102fe0f",
                                                "sense_id": "57a66535-377a-37a1-8857-4bf1fa53b8e6",
                                                "text": "„Van Swieten und Sydenham benutzten ihn gegen die profusen Schweiße, die in der Rekonvaleszenz nach akuten Krankheiten auftreten, doch war ihnen auch die schweißfördernde Wirkung bekannt.“"
                                            },
                                            {
                                                "example_id": "6b731253-71bd-4dfb-94db-59f154215fc2",
                                                "sense_id": "57a66535-377a-37a1-8857-4bf1fa53b8e6",
                                                "text": "„Der Schweiß juckte jetzt am ganzen Körper.“"
                                            },
                                            {
                                                "example_id": "60c43a72-31a6-4b26-b916-2637aef8c827",
                                                "sense_id": "57a66535-377a-37a1-8857-4bf1fa53b8e6",
                                                "text": "„Der Schweiß glänzt auf ihren Gesichtern, während sie sich auf der Tanzfläche bewegen.“"
                                            },
                                            {
                                                "example_id": "4a8c5079-0c21-41d6-af7d-33efcef07021",
                                                "sense_id": "57a66535-377a-37a1-8857-4bf1fa53b8e6",
                                                "text": "„Ich wachte mehrmals auf, wischte mir den Schweiß ab, pustete, schnaufte und schlief wieder ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6cbab9d-97e2-33e1-a914-dc5d0f5c3391",
                                        "entry_id": "fd9e1c47-da8f-3f73-b3b3-8eb34c3f4208",
                                        "glosses": [
                                            "Blut vom Wild oder Jagdhund, das aus dessen Körper tritt"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
