                                            {
                                                "example_id": "17d64922-45a2-4602-9d65-087dbec0035b",
                                                "sense_id": "410ba22f-cbd2-3ff2-8690-ae897abf99aa",
                                                "text": "Son élève à Bordeaux, Louis Rolland, fait adopter les principales lois sur le service public entre 1930 et la Seconde Guerre mondiale."
                                            },
                                            {
                                                "example_id": "8f856f97-fda9-4c72-b75b-fb0055a62709",
                                                "sense_id": "410ba22f-cbd2-3ff2-8690-ae897abf99aa",
                                                "text": "Il remit le livre sur le rayon, à côté de l’essai de Romain Rolland sur Vivekananda."
                                            },
                                            {
                                                "example_id": "879b4212-af11-4abb-a311-c028f31d2885",
                                                "sense_id": "410ba22f-cbd2-3ff2-8690-ae897abf99aa",
                                                "text": "L’ancien arbitre irlandais Alain Rolland, de père français, pouvait ainsi expliquer dans leur langue, aux Bleus pourquoi il les sanctionnait."
                                            }
                                        ]
                                    }
