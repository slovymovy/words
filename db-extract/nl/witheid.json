                                        "examples": [
                                            {
                                                "example_id": "8d6beedd-8bdc-4fcf-8aba-714f10d3476d",
                                                "sense_id": "a2af1aac-1db7-3d88-9a04-2c1c1ce342d0",
                                                "text": "[Snow] may […] exchange its whiteness for yellowness, without losing its right to be called snow; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "accf296e-0b24-3ea9-90a1-c262be8cd023",
                                        "entry_id": "357c2a38-57d0-3939-b19b-131f97345b29",
                                        "glosses": [
                                            "The quality of being white (in the racial sense)."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "868fa912-b048-47f3-b1e5-314333758372",
                                                "sense_id": "accf296e-0b24-3ea9-90a1-c262be8cd023",
                                                "text": "As a white body, I have not had to face my whiteness; insofar as the world is oriented around whiteness, I rarely have to turn my attention back onto myself, as do the black and brown bodies that are “stopped” or “held up” for being out of place […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c593442d-2266-3130-bd5e-8f4adb15345f",
                                        "entry_id": "357c2a38-57d0-3939-b19b-131f97345b29",
                                        "glosses": [
                                            "The quality of being white noise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9cb47d7-6104-4e41-afd3-8918945af6d2",
                                                "sense_id": "c593442d-2266-3130-bd5e-8f4adb15345f",
                                                "text": "Despite this criticism, this check for whiteness of a time series enjoys much popularity as it is very easy to carry out."
                                            }
                                        ]
                                    }
