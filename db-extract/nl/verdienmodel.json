                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fabf79d-b048-46b0-b84e-a1ab3462a2b8",
                                "sense_id": "19a1d031-5067-369e-ac41-27e27d586ddd",
                                "text": "Trump is uit ander hout gesneden – eerder dat van keizer Nero. Zijn corruptie komt niet voort uit onmacht (Harding) of politieke paranoia (Nixon), het is een geloofsartikel. Trump maakt van het presidentschap zijn bezit, een merk – het ideale verdienmodel."
                            },
                            {
                                "example_id": "e2a88cd2-faf5-45e1-9b63-2d86259f4804",
                                "sense_id": "19a1d031-5067-369e-ac41-27e27d586ddd",
                                "text": "Barbara Baarsma, directeur Rabobank Amsterdam, schrijft in een advies aan de Tweede Kamer dat de lage stroomprijzen het verdienmodel van duurzame energieprojecten ondermijnen."
                            },
                            {
                                "example_id": "aab0e8c8-6936-4987-8a50-d6bab18ca7c2",
                                "sense_id": "19a1d031-5067-369e-ac41-27e27d586ddd",
                                "text": "Volgens hem zijn er in een paar weken tijd al zo'n tien nieuwe partijen bijgekomen, met ieder zo hun eigen verdienmodel."
                            }
                        ]
                    }
