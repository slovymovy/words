                        "glosses": [
                            "Respiration, breathing, seen as a life principle or life force."
                        ],
                        "tags": [
                            "Hinduism",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "98c2f22f-f18f-49ec-bd5c-bda86879d11a",
                                "sense_id": "c6373902-f2d2-3f57-a072-5e21496ded15",
                                "text": "He it is who sends the (in-coming) Prana (life-breath) upward and throws the (out-going) breath downward."
                            },
                            {
                                "example_id": "09e48806-4d13-4e66-bf21-4c73dbb3f85c",
                                "sense_id": "c6373902-f2d2-3f57-a072-5e21496ded15",
                                "text": "He who knows Aditi, who rises with Prana (the Life Principle), existent in all the Devas."
                            },
                            {
                                "example_id": "2e1968c3-ffda-4903-9d48-222b813f611f",
                                "sense_id": "c6373902-f2d2-3f57-a072-5e21496ded15",
                                "text": "May my limbs, speech, Prana (life-force), sight, hearing, strength and all my senses, gain in vigor."
                            }
                        ]
                    }
                ],
