                "senses": [
                    {
                        "sense_id": "143f47cb-2059-3dc6-8a76-e5a7c65c02e2",
                        "entry_id": "471e3116-03c0-3162-9b7b-c5115b71f343",
                        "glosses": [
                            "Faire passer aux confidences dans les émissions d’Oprah Winfrey."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd698fd1-6b98-4855-954b-7a831e65c74f",
                                "sense_id": "143f47cb-2059-3dc6-8a76-e5a7c65c02e2",
                                "text": "Ses conseillers et lui ont décidé de l’« Oprahiser » : le mettre, le 17 janvier, entre les douces mains expertes d’Oprah Winfrey, confesseur des stars à la télé américaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "85a6e5df-2b53-3985-828c-4df8c9d8c8e6",
                        "entry_id": "471e3116-03c0-3162-9b7b-c5115b71f343",
                        "glosses": [
                            "Ressembler de plus en plus à Oprah Winfrey ou à ses émissions."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "be0410ee-6e44-40ea-88fc-751a99f3184f",
                                "sense_id": "85a6e5df-2b53-3985-828c-4df8c9d8c8e6",
                                "text": "Mais c'est une autre émission qui ne correspond pas, selon moi, aux qualités des 5 fantastiques, qui pourraient au contraire, aller plus loin dans les itw confidences, les débats de société... et qui pourraient donc naturellement s'oprahiser..."
                            }
                        ]
                    }
