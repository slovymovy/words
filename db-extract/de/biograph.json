                ],
                "senses": [
                    {
                        "sense_id": "3cdbb3e1-84fd-3056-9405-e912e861254e",
                        "entry_id": "d7698219-e952-3ca2-9779-1b7047ea8b0e",
                        "glosses": [
                            "jemand, der die Lebensgeschichte einer Person, ihre Biographie, erarbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd100269-bc4c-40a0-a0b3-3e157728683c",
                                "sense_id": "3cdbb3e1-84fd-3056-9405-e912e861254e",
                                "text": "„Erstaunlicherweise hat keiner der vielen Biographen Pücklers auf diese andere, gleichsam patriotische Seite seines Verhaltens hingewiesen.“"
                            },
                            {
                                "example_id": "a4281376-f8c4-4bab-9b56-9d799113f4ed",
                                "sense_id": "3cdbb3e1-84fd-3056-9405-e912e861254e",
                                "text": "„Obwohl seine Bücher meist auf persönlichen Erlebnissen basieren, war er niemals daran interessiert, sich Biographen anzuvertrauen.“"
                            },
                            {
                                "example_id": "ec7e0e02-6bf8-424e-b758-f349fa5feef4",
                                "sense_id": "3cdbb3e1-84fd-3056-9405-e912e861254e",
                                "text": "„Für den Biographen ist das Fehlen der Tagebuchaufzeichnungen bedauerlich.“"
                            },
                            {
                                "example_id": "9736b37d-f065-4d41-be3b-220017e5fab0",
                                "sense_id": "3cdbb3e1-84fd-3056-9405-e912e861254e",
                                "text": "„Spätere Biographen der La Roche behaupten das ernstlich, aber es ist nur ein Scherz im Rahmen der permanenten Flirterei Wielands mit seiner Sophie gewesen, alles hat seine Grenzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
