                "senses": [
                    {
                        "sense_id": "c057453a-5dd0-3619-81f0-692ab624c7aa",
                        "entry_id": "b9ed10ba-5946-3701-a328-a8a7170e3cd2",
                        "glosses": [
                            "Variante rare de visiophoner (téléphoner en voyant son interlocuteur), utilisée en particulier dans des romans de science-fiction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff521557-7270-44b8-8343-8431f2b33e16",
                                "sense_id": "c057453a-5dd0-3619-81f0-692ab624c7aa",
                                "text": "Si Jos, après son travail, avait voulu visiphoner pour me dire qu’elle arrivait, ou si elle était simplement arrivée sans prévenir, comme elle le fait le plus souvent, elle serait déjà venue."
                            },
                            {
                                "example_id": "f23eedb0-d48a-45b1-ab2c-6f7db519ea5d",
                                "sense_id": "c057453a-5dd0-3619-81f0-692ab624c7aa",
                                "text": "Je sais, lança-t-elle en arrivant. Tu t’inquiétais et j’aurais pu visiphoner !"
                            },
                            {
                                "example_id": "869f168e-15b8-414b-a650-6e47982326fa",
                                "sense_id": "c057453a-5dd0-3619-81f0-692ab624c7aa",
                                "text": "Après avoir passé un appel hyperspatial depuis le Maraudeur, le businessman avait visiphoné au vieux savant à l’Hôtel du bout des mondes, puis essayé - en vain - de joindre Andy Sherwood."
                            }
                        ]
                    },
