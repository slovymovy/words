                        "examples": [
                            {
                                "example_id": "b3019031-7299-4a60-aa04-9c8e0e02d55d",
                                "sense_id": "e978353a-96ae-389a-bb3a-09c542f521ef",
                                "text": "Ik voldeed bijna slaafs aan Mirjams verzoek (of bevel) om die vrijdagavond mijn gezicht niet te vertonen in het stadsgedeelte waar zij met haar speciale verslaggever uit zou gaan."
                            },
                            {
                                "example_id": "36a7bc76-40f9-4850-82fc-4fde5b909d00",
                                "sense_id": "e978353a-96ae-389a-bb3a-09c542f521ef",
                                "text": "Tot aan gisteren had ik de calamiteiten in Syrië ervaren als headlines, verhalen van vrienden en beelden op tv. Het dagelijks leven ging gewoon door; niets was veranderd. Ook gisteren dacht ik uit eten te gaan in het oude stadsgedeelte van Damascus, alsof er niets aan de hand was."
                            }
                        ]
                    }
