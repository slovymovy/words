                        "sense_id": "57dbaaf4-2aa8-30e8-8780-fe39ed351e96",
                        "entry_id": "a4e9c016-6513-38bb-9487-2463b42675b3",
                        "glosses": [
                            "feines Gebäck, das aus einem dünnflüssigen Teig in Schichten über einem offenen Feuer auf einer Walze gebacken wird"
                        ],
                        "tags": [
                            "Gebäck"
                        ],
                        "examples": [
                            {
                                "example_id": "f32ef991-4773-4edc-968e-74d9d38ae0bb",
                                "sense_id": "57dbaaf4-2aa8-30e8-8780-fe39ed351e96",
                                "text": "Tante Jutta brachte zum Kaffeekränzchen einen Baumkuchen mit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
