                ],
                "senses": [
                    {
                        "sense_id": "205f1ba6-ea9f-33a6-9bfa-583cfdef69bc",
                        "entry_id": "794c2044-07fd-3467-8983-7a2b6d71e53f",
                        "glosses": [
                            "Gesamtheit der Bestimmungen, nach denen eine Institution/Organisation arbeiten soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ee3a61b-08b7-4f2a-964b-3817a0a28b19",
                                "sense_id": "205f1ba6-ea9f-33a6-9bfa-583cfdef69bc",
                                "text": "„Laut ihren Statuten hat die Europäische Zentralbank vor allem die Aufgabe, für stabile Preise zu sorgen.“"
                            },
                            {
                                "example_id": "a7fed0df-a9d9-4eed-8a20-28032ef1c4b2",
                                "sense_id": "205f1ba6-ea9f-33a6-9bfa-583cfdef69bc",
                                "text": "„Sicher ist, dass die NFL zwischen 1919 und 1922 von einem lockeren Klub von Gleichgesinnten zu einer Sportliga mit Statuten und daraus resultierenden Rechten und Pflichten für die Mitglieder avancierte.“"
                            },
                            {
                                "example_id": "c5184a49-d7fe-47c8-a76d-6981b90574ee",
                                "sense_id": "205f1ba6-ea9f-33a6-9bfa-583cfdef69bc",
                                "text": "„Die russische Regierung erließ 1804 für ihre jüdischen Untertanen ein Statut, das für jüdische Schulen im Ansiedlungsrayon allein die Unterrichtssprachen Deutsch, Polnisch oder Russisch vorsah, auch sollten alle offiziellen oder geschäftlichen Dokumente nur in einer der drei Sprachen verfasst sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16e4a6db-bb58-4652-bdc5-9106352edb58",
                        "source_entry_id": "794c2044-07fd-3467-8983-7a2b6d71e53f",
                        "source_sense_id": "205f1ba6-ea9f-33a6-9bfa-583cfdef69bc",
                        "source_sense_description": "Gesamtheit der Bestimmungen, nach denen eine Institution/Organisation arbeiten soll",
                        "target_lang_word": "statute",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "statute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ee3f4de-2614-3689-aabf-81bd42fbb8f2",
                                        "entry_id": "d35264b7-9507-3400-bcb0-46720ca56250",
                                        "glosses": [
                                            "A written law or ordinance passed by a legislative body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e3f15ff-a6f8-47a9-a368-74968a507d19",
                                                "sense_id": "9ee3f4de-2614-3689-aabf-81bd42fbb8f2",
                                                "text": "The new statute limited working hours."
                                            },
                                            {
                                                "example_id": "efa929ad-c3e0-4157-9bcc-05a51ee28b78",
                                                "sense_id": "9ee3f4de-2614-3689-aabf-81bd42fbb8f2",
                                                "text": "Parliament passed a statute on environmental protection."
                                            },
                                            {
                                                "example_id": "233019a4-720e-458c-8f7c-c21a1d0674d0",
                                                "sense_id": "9ee3f4de-2614-3689-aabf-81bd42fbb8f2",
                                                "text": "criminal statute"
                                            },
                                            {
                                                "example_id": "e190f692-819b-4356-b604-b11b106bd9b3",
                                                "sense_id": "9ee3f4de-2614-3689-aabf-81bd42fbb8f2",
                                                "text": "statute book"
                                            },
                                            {
                                                "example_id": "c220c1d6-8992-47e1-a9ea-de36342577d9",
                                                "sense_id": "9ee3f4de-2614-3689-aabf-81bd42fbb8f2",
                                                "text": "Despite criticisms which were made of the Railway Executive, it must be recalled that the general framework of the new railway set-up was established by statute, while this form of organisation was particularly well adapted for carrying out the unification of the railways—a very different thing from the purely political act of nationalisation, but an essential part of the objective of nationalisation."
                                            }
                                        ]
                                    },
