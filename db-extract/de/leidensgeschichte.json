                "senses": [
                    {
                        "sense_id": "043b845b-deed-344f-93b4-5c6502dec2c6",
                        "entry_id": "5269fbb4-1350-3957-b82e-f53b70f659a2",
                        "glosses": [
                            "Religion: Geschichte des Leidens Christi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f096a17a-d2e8-4838-9d34-a9c2f17c1004",
                                "sense_id": "043b845b-deed-344f-93b4-5c6502dec2c6",
                                "text": "„Tausende Menschen säumen den Weg des Prozessionszuges, der Szenen aus der Leidensgeschichte Christi darstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b09802b8-7484-3397-be5b-535d1251e64c",
                        "entry_id": "5269fbb4-1350-3957-b82e-f53b70f659a2",
                        "glosses": [
                            "Abfolge der erlebten Leiden eines Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b1dbeec-3616-448b-a01f-40bb5dbf7b0d",
                                "sense_id": "b09802b8-7484-3397-be5b-535d1251e64c",
                                "text": "Die Medien berichten immer wieder über die Leidensgeschichte von Flüchtlingen."
                            },
                            {
                                "example_id": "cfa8d391-63f9-4b63-8836-028935962b57",
                                "sense_id": "b09802b8-7484-3397-be5b-535d1251e64c",
                                "text": "„Einige Jahre nach Donatellos Relief malte er in der Eremitani-Kirche in Padua eine Reihe von Fresken, die die Leidensgeschichte des hl. Jakobus darstellen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
