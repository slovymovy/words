                ],
                "senses": [
                    {
                        "sense_id": "f0625a14-210a-3025-869a-c6397fe68c23",
                        "entry_id": "1727c55b-6267-33d1-995b-555465ea7878",
                        "glosses": [
                            "besonders ansteckende, weltweit vorkommende Infektionskrankheit, die überwiegend bei Kindern unter zehn Jahren auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f286884-d03c-4290-9f9c-70ecf27cbc54",
                                "sense_id": "f0625a14-210a-3025-869a-c6397fe68c23",
                                "text": "„Hand-Fuß-Mund-Krankheit heißt die Infektion daher, die vor allem kleine Kinder ereilt.“"
                            },
                            {
                                "example_id": "8b9525da-6d96-4e94-acda-203b2dd18f1b",
                                "sense_id": "f0625a14-210a-3025-869a-c6397fe68c23",
                                "text": "„Fieber, Appetitlosigkeit, schmerzhafte Bläschen im Mund und Ausschlag an Hand- und Fußrücken: Das sind typische Anzeichen der Hand-Fuß-Mund-Krankheit.“"
                            },
                            {
                                "example_id": "7ec034b1-59e3-4147-8cef-b59e39fa509d",
                                "sense_id": "f0625a14-210a-3025-869a-c6397fe68c23",
                                "text": "„Für den Mediziner ergänzen diese Informationen das Bild der Hautveränderungen: Es muss sich um die sogenannte Hand-Fuß-Mund-Krankheit handeln, die in den meisten Fällen durch Coxsackie-A-Viren ausgelöst wird.“"
                            },
                            {
                                "example_id": "2b255187-afc6-4cee-af2a-60829713d47d",
                                "sense_id": "f0625a14-210a-3025-869a-c6397fe68c23",
                                "text": "„Und auf ein Kind mit beispielsweise Hand-Fuß-Mund-Krankheit kommen drei völlig symptomfreie Kinder, die aber trotzdem ansteckend sind.“"
                            },
                            {
                                "example_id": "5275a4de-02f2-4633-88ec-6552e497d000",
                                "sense_id": "f0625a14-210a-3025-869a-c6397fe68c23",
                                "text": "„Dabei handelt es sich um den häufigsten Irrglauben in der Medizingeschichte von Kindergärten und Krabbelgruppen: Dass die Hand-Fuß-Mund-Krankheit, um diese Verwechslung ging es, so gefährlich sei wie die oben genannte Tierseuche.“"
                            },
                            {
                                "example_id": "effcc05f-84f9-4705-8214-4dd2f0b099e8",
                                "sense_id": "f0625a14-210a-3025-869a-c6397fe68c23",
                                "text": "„Pinks Ehemann Carey Hart, teilte auf Instagram mit, dass die sieben Jahre alte Willow unter 39 Grad Fieber leide und der einjährige Jameson habe die Hand-Fuß-Mund-Krankheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
