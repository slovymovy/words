                        "sense_id": "cff4aff5-eedc-3220-9db7-b750b89965d7",
                        "entry_id": "769198f8-c9ab-3ac1-bf3a-16c1888be559",
                        "glosses": [
                            "Rongeur herbivore de la famille des Ctenodactylidae, vivant dans les déserts rocheux dans le Nord de l’Afrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f74c91b1-db68-455f-86c2-df09131fab57",
                                "sense_id": "cff4aff5-eedc-3220-9db7-b750b89965d7",
                                "text": "Il découvre un nouveau parasite, le Toxoplasma gondii, dans le sang du gondi, un petit rongeur que l’on croise dans ces régions du sud."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9feec6d-ffe2-4fc6-9710-825701d37d5f",
                        "source_entry_id": "769198f8-c9ab-3ac1-bf3a-16c1888be559",
                        "source_sense_id": "cff4aff5-eedc-3220-9db7-b750b89965d7",
                        "target_lang_word": "gundi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gundi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c6eaae1-745a-38b2-9653-567577491fd8",
                                        "entry_id": "11762db2-a972-3e47-aa76-e4608270661f",
                                        "glosses": [
                                            "Any of the several North African rodents of the family Ctenodactylidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db7359be-e8ed-44e7-97d1-b304738976b5",
                                                "sense_id": "5c6eaae1-745a-38b2-9653-567577491fd8",
                                                "text": "The fact that specimens were collected and observed only in the higher portions of the gebel near Rumia is a direct result of my efforts having been concentrated there and does not indicate that gundis are most abundant at higher elevations or that they do not occur at lower elevations."
                                            },
                                            {
                                                "example_id": "d01bf28b-d517-414f-9813-bb291187d523",
                                                "sense_id": "5c6eaae1-745a-38b2-9653-567577491fd8",
                                                "text": "1999, Gundi, entry in Michael A. Mares (editor), Encyclopedia of Deserts, page 258,\nGundis occur over most of North Africa, including the western Sahara Desert and Sahel west of 15° east longitude, from Mauritania to Libya and Chad."
                                            },
                                            {
                                                "example_id": "dad83b5b-598f-4dfd-91bc-30f03b59efb2",
                                                "sense_id": "5c6eaae1-745a-38b2-9653-567577491fd8",
                                                "text": "2001, Gundis, entry in Peter Haggett (editor), Encyclopedia of World Geography, Volume 24, page 2220,\nSmall balls of soft fur scampering up vertical rock faces, trilling and chirping like flocks of birds: these are the gundis, a curious family of rock-dwelling rodents that are found only in northern Africa. Four species of gundi live in the Sahara, one in the Horn of Africa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
