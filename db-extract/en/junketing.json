                ],
                "senses": [
                    {
                        "sense_id": "af2e5905-3ad6-30ec-ae3f-28552dd9d805",
                        "entry_id": "4cd362a8-5c57-35bc-942f-36d6751f1522",
                        "glosses": [
                            "A celebratory feast or banquet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a57e8ff6-3087-4a3e-8796-578418602921",
                                "sense_id": "af2e5905-3ad6-30ec-ae3f-28552dd9d805",
                                "text": "Which things though not so substantially performed, are notwithstanding in some measure imitated by Witches and Magicians, I mean in their junketings; whose viands are observed to afford so little satisfaction to nature, that they leave oftentimes the partakers of them as weak and faint almost as if they had eaten nothing […]"
                            },
                            {
                                "example_id": "2271fe3b-769b-479e-a7e1-2533df84bc07",
                                "sense_id": "af2e5905-3ad6-30ec-ae3f-28552dd9d805",
                                "text": "I have already been invited to Two Christenings, and several Junketings, which I hope will be no Reflection upon my Character, having heard, that you your self, Sir, will take a chirping Cup upon Occasion."
                            },
                            {
                                "example_id": "336728aa-e755-4337-a980-4e2302b8cc6f",
                                "sense_id": "af2e5905-3ad6-30ec-ae3f-28552dd9d805",
                                "text": "[…] think o’ them poor women up i’ the villages there, as niver stir a hundred yards from home,—it ’ud be a pity for anybody to buy up their bargains. Lors, it’s as good as a junketing to ’em when they see me wi’ my pack, an’ I shall niver pick up such bargains for ’em again."
                            },
                            {
                                "example_id": "49ac7be1-8415-43f3-9338-35b39d4fbf1a",
                                "sense_id": "af2e5905-3ad6-30ec-ae3f-28552dd9d805",
                                "text": "1928, Virginia Woolf, letter to Vita Sackville-West dated 8 September, 1928, in Nigel Nicholson and Joanne Trautmann (eds.), The Letters of Virginia Woolf, New York: Harcourt Brace Jovanovich, 1978, p. 529,\nYou see, dearest Creature, being now in the pink and prime of health, I could sit up all night: we might go to moonlight ruins, café’s, dances, plays, junketings: converse for ever; sleep only while the moon covers herself for an instant with a thin veil […]"
                            },
                            {
                                "example_id": "7eb59fd0-8483-49ae-9a8e-a4d811477a21",
                                "sense_id": "af2e5905-3ad6-30ec-ae3f-28552dd9d805",
                                "text": "The usual junketings of the times attended the opening of the line."
                            }
                        ]
                    }
                ],
