                    },
                    {
                        "sense_id": "7a6df415-ed16-3ae2-9ba4-12fa4aa945f8",
                        "entry_id": "04996595-22cb-3d00-bf73-76b730ba08cd",
                        "glosses": [
                            "The Finnish language."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75ada0d8-3573-4103-9ced-cb448d3b957c",
                                "sense_id": "7a6df415-ed16-3ae2-9ba4-12fa4aa945f8",
                                "text": "Suomi occupies the greater part of Finland"
                            },
                            {
                                "example_id": "a4fbcb16-6f27-47b9-8576-1ba68eb7936d",
                                "sense_id": "7a6df415-ed16-3ae2-9ba4-12fa4aa945f8",
                                "text": "The Finnic languages show that the primitive people were clad only in the skins of animals since the skin or hide of an animal is kut in Wotiak, ked in Mordwin and kete in Suomi."
                            },
                            {
                                "example_id": "b7875258-2d80-4060-9b0a-b1f8625f8dbe",
                                "sense_id": "7a6df415-ed16-3ae2-9ba4-12fa4aa945f8",
                                "text": "\"I THOUGHT HIS SITE WAS ENTIRELY IN SUOMI.\" \"IF THAT MEANS IT'S GOT MORE DOTS OVER THE VOWELS THAN AN EIGHTIES HEAVY METAL ALBUM, I'LL TAKE YOUR WORD FOR IT.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "01eac138-068f-331f-8d30-093e5673215a",
                        "entry_id": "04996595-22cb-3d00-bf73-76b730ba08cd",
                        "glosses": [
                            "A surname from Finnish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64c4920f-c018-4776-a721-984523d7f33c",
                                "sense_id": "01eac138-068f-331f-8d30-093e5673215a",
                                "text": "What Suomi has that Harlow did not have is technology."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "425889c0-537b-3f94-8465-830ebdc91bd7",
                "word": "Suomi",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "edf735c9-5d85-3c00-8ffb-71024296616d",
                        "entry_id": "425889c0-537b-3f94-8465-830ebdc91bd7",
                        "glosses": [
                            "The Finns."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "6dd1a815-e92d-42c8-a5d9-052fbd4277c9",
                                "sense_id": "edf735c9-5d85-3c00-8ffb-71024296616d",
                                "text": "Over and above the 1,800,000 odd they number in Finland, the Suomi come in for about 250,000 more in the population of the adjacent Russian governments."
                            },
                            {
                                "example_id": "580388a4-fc85-46d2-8a05-1c7a73f1aad3",
                                "sense_id": "edf735c9-5d85-3c00-8ffb-71024296616d",
                                "text": "1963, Francis Peabody Magoun Jr. (trans.), The Kalevala: Or, Poems of the Kaleva District\nthe original homeland of the Suomi tribe (suomalaiset)."
                            },
                            {
                                "example_id": "c8b6e234-7f3e-4d59-9cde-f91f93707879",
                                "sense_id": "edf735c9-5d85-3c00-8ffb-71024296616d",
                                "text": "the mythology of the Finnic peoples (the Suomi and Karelians)"
                            },
                            {
                                "example_id": "f7534f71-1f47-4068-91df-05b38c9d73e0",
                                "sense_id": "edf735c9-5d85-3c00-8ffb-71024296616d",
                                "text": "1997, Eric Christiansen, The Northern Crusades,\nNevertheless, a community of Christians had been established among the Suomi (south-west Finns), and in 1215 there was a Finnish convert […] The motives of the Swedes who went into Suomi lands, and of the Suomi who accepted their faith and paid tithe to their bishop, can only be conjectured."
                            }
                        ]
                    }
