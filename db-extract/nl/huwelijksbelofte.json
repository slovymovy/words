                "senses": [
                    {
                        "sense_id": "b04b1279-06c4-3d3c-9948-dd0bda6b118f",
                        "entry_id": "7ceab960-3863-33fd-ba53-736af264dd20",
                        "glosses": [
                            "de belofte die beide huwelijkspartners elkaar doen tijdens de huwelijksvoltrekking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c771ded4-76af-45e5-89ca-44c1df2551d5",
                                "sense_id": "b04b1279-06c4-3d3c-9948-dd0bda6b118f",
                                "text": "Een paar keer zijn ze naar Las Vegas gereisd, waar de ouders geregeld hun huwelijksbeloftes gingen hernieuwen."
                            },
                            {
                                "example_id": "1cbfffc8-cc16-4a5f-aa49-013f1c3fbae9",
                                "sense_id": "b04b1279-06c4-3d3c-9948-dd0bda6b118f",
                                "text": "„Het is een zware tijd voor beiden geweest. Maar ik heb gehoord dat ze volgende zomer hun huwelijksbeloften opnieuw willen afleggen op Barbados. Dat is hun favoriete plek. Elk huwelijk kent zijn ups en downs, maar de Rooneys hebben hun deel nu wel gehad.”"
                            },
                            {
                                "example_id": "48f8df71-339b-4b9b-8d8f-ac32e470a9e7",
                                "sense_id": "b04b1279-06c4-3d3c-9948-dd0bda6b118f",
                                "text": "Op 11 november a.s. gaan Joep en Rick vervolgens weer terug naar de gemeente. Dan verklaren zij ten overstaan van de trouwambtenaar dat zij hun geregistreerd partnerschap willen omzetten in een huwelijk en wisselen ze dan hun huwelijksbeloften uit. Hierdoor zijn zij per 11 november a.s. met elkaar getrouwd, zoals ze ook wilden."
                            }
                        ]
                    }
