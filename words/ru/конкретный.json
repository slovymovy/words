                    "sense_definition": "Реально существующий, вещественный, предметный или точно определенный, в отличие от абстрактного.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "real_and_specific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для решения этой сложной проблемы нам нужен <w>конкретный</w> план действий, а не просто общие рассуждения.",
                            "target_lang_translations": {
                                "tr": "Bu karmaşık sorunu çözmek için sadece genel tartışmalara değil, <w>somut</w> bir eylem planına ihtiyacımız var."
                            }
                        },
                        {
                            "text": "Пожалуйста, приведите <w>конкретный</w> пример из вашей личной практики, чтобы всем стало понятно.",
                            "target_lang_translations": {
                                "tr": "Herkesin anlaması için lütfen kendi kişisel pratiğinizden <w>somut</w> bir örnek verin."
                            }
                        }
                    ],
                    "synonyms": [
                        "определённый"
                    ],
                    "antonyms": [
                        "абстрактный",
                        "неопределённый"
                    ],
                    "common_phrases": [
                        "конкретный пример",
                        "конкретный план",
                        "конкретный случай"
                    ],
                    "target_lang_definitions": {
                        "tr": "Soyut olanın aksine, gerçekte var olan, somut veya kesin olarak belirlenmiş olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "somut",
                                "target_lang_sense_clarification": "soyut olmayan, elle tutulur"
                            },
                            {
                                "target_lang_word": "belirli",
                                "target_lang_sense_clarification": "kesinleşmiş, net"
                            },
                            {
                                "target_lang_word": "net",
                                "target_lang_sense_clarification": "açık ve belirgin"
                            }
                        ]
