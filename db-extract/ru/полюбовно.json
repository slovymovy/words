                                    {
                                        "sense_id": "460b69bc-9731-315f-a4a0-8d76c5b53318",
                                        "entry_id": "bb8bdff4-ccff-3da9-acaa-6f4f4ffbbcd4",
                                        "glosses": [
                                            "ohne Streit, sich einigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "183f703f-c331-4933-b3b1-2163b9b4cccd",
                                                "sense_id": "460b69bc-9731-315f-a4a0-8d76c5b53318",
                                                "text": "Der vorsitzende Richter am Landgericht München warb in der Verhandlung für eine gütliche Einigung."
                                            },
                                            {
                                                "example_id": "4ef6e44f-4643-4876-80c8-9ec41f18cbf1",
                                                "sense_id": "460b69bc-9731-315f-a4a0-8d76c5b53318",
                                                "text": "Nach nur einer Stunde Verhandlung im Zivilprozess vor dem Landgericht Nürnberg-Fürth gab der Richter überraschend bekannt, dass sich die Parteien um eine gütliche Einigung bemühen wollen."
                                            },
                                            {
                                                "example_id": "d922f23d-220d-4941-b482-2bebc4c7bd6b",
                                                "sense_id": "460b69bc-9731-315f-a4a0-8d76c5b53318",
                                                "text": "Das Gericht hielt die Forderung des Ehemanns für überhöht und schlug eine gütliche Einigung in Höhe von 460.000 Euro vor."
                                            },
                                            {
                                                "example_id": "ba878963-6bbe-4cb9-a4cc-8d01373c96d2",
                                                "sense_id": "460b69bc-9731-315f-a4a0-8d76c5b53318",
                                                "text": "Wir sind guter Hoffnung, dass eine gütliche Lösung gefunden wird."
                                            },
                                            {
                                                "example_id": "e9fccac0-59d0-4916-ac09-293be2ab63ea",
                                                "sense_id": "460b69bc-9731-315f-a4a0-8d76c5b53318",
                                                "text": "Der Skandal um den Rauswurf zweier Afroamerikaner aus einer Starbucks-Filiale in Philadelphia nimmt ein gütliches Ende. Die beiden Betroffenen einigten sich mit der Stadt und dem Unternehmen zugunsten eines guten Zwecks."
                                            },
                                            {
                                                "example_id": "75cc7743-7ef6-4c4c-9547-fd692a292a39",
                                                "sense_id": "460b69bc-9731-315f-a4a0-8d76c5b53318",
                                                "text": "Die EU-Unterhändler haben die Fortschritte bei den Verhandlungen [zwischen Großbritannien und der Europäischen Union] wiederholt als unzureichend kritisiert und gewarnt, die Zeit für eine gütliche Trennung werde knapp."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "gütlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "510a1d6b-73ac-3046-b49f-74892156d03c",
                                        "entry_id": "d82b4696-d2d0-32a0-a127-df21dc01e200",
                                        "glosses": [
