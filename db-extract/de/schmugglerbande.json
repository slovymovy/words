                "senses": [
                    {
                        "sense_id": "d3a45c6f-cf03-3142-9cdc-98f0f67ca6c4",
                        "entry_id": "0153dc3a-f9b7-3fe7-85fe-6ea1a5421370",
                        "glosses": [
                            "kleine bis mittelgroße Gruppe von Schmugglern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13eb4023-3299-4200-bcb8-a0d652171338",
                                "sense_id": "d3a45c6f-cf03-3142-9cdc-98f0f67ca6c4",
                                "text": "„Letztes Frühjahr stoppte er in Tripolis eine Schmugglerbande, die zwei Eisenbahnwaggons voller Landminen nach Zentralafrika bringen wollte.“"
                            },
                            {
                                "example_id": "d91af781-e4e5-4bb5-922f-b945d76099e7",
                                "sense_id": "d3a45c6f-cf03-3142-9cdc-98f0f67ca6c4",
                                "text": "„Gurney war jetzt das Mitglied einer Schmugglerbande, und Paul durfte sich ihm deswegen nicht zeigen, weil es zu verhindern galt, dass der Mann ihm unwissentlich jene Leute auf die Spur hetzte, die schon seinen Vater auf dem Gewissen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
