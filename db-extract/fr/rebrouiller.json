                ],
                "senses": [
                    {
                        "sense_id": "3b93f10d-8a55-33cb-8eac-cfed48d483db",
                        "entry_id": "a380f318-db59-3ac8-afed-ec5789804eb9",
                        "glosses": [
                            "Mettre de nouveau pêle-mêle, brouiller à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be70b96f-671c-42d5-a140-d6243447f776",
                                "sense_id": "3b93f10d-8a55-33cb-8eac-cfed48d483db",
                                "text": "Puis, quand tout allait s’arranger, la bêtise de l’alcade a tout rebrouillé."
                            },
                            {
                                "example_id": "5af02e50-5cfb-42b0-9560-90479df533f8",
                                "sense_id": "3b93f10d-8a55-33cb-8eac-cfed48d483db",
                                "text": "La femme était prête à s’offenser de se voir soupçonnée d’une telle indiscrétion ; mais, pour ne pas rebrouiller les choses qui allaient à un bon accommodement, elle promit de parler et de se taire à propos"
                            }
                        ]
                    },
                    {
                        "sense_id": "44fcef44-62f8-37c5-ac16-b1fc80d107ea",
                        "entry_id": "a380f318-db59-3ac8-afed-ec5789804eb9",
                        "glosses": [
                            "Remuer le grain."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4bf3a43a-3f33-3dab-9d45-feb4a20e994e",
                        "entry_id": "a380f318-db59-3ac8-afed-ec5789804eb9",
                        "glosses": [
                            "Désunir de nouveau des personnes liées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e312f9e0-3161-434a-b19f-77ddc795a1fe",
                                "sense_id": "4bf3a43a-3f33-3dab-9d45-feb4a20e994e",
                                "text": "Il les rebrouillait le même jour qu’ils s’étaient raccommodés"
                            }
                        ]
                    },
                    {
                        "sense_id": "7e33afd1-9a02-3c8d-9491-bec913d11f3c",
                        "entry_id": "a380f318-db59-3ac8-afed-ec5789804eb9",
                        "glosses": [
                            "Entrer de nouveau en querelle."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "73941737-f245-4609-bced-90b71a8aecea",
                                "sense_id": "7e33afd1-9a02-3c8d-9491-bec913d11f3c",
                                "text": "Nous nous rebrouillâmes avec M. le Prince après sa liberté."
                            }
                        ]
                    }
