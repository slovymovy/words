                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis son enfance, elle rêve de faire du <w>ciné</w> et de devenir réalisatrice.",
                            "target_lang_translations": {
                                "en": "Since childhood, she has dreamed of working in <w>film</w> and becoming a director.",
                                "ru": "С детства она мечтает работать в <w>кино</w> и стать режиссёром.",
                                "nl": "Sinds haar jeugd droomt ze ervan in de <w>film</w> te werken en regisseuse te worden.",
                                "de": "Seit ihrer Kindheit träumt sie davon, beim <w>Film</w> zu arbeiten und Regisseurin zu werden.",
                                "pl": "Od dzieciństwa marzy o pracy w <w>kinie</w> i o tym, by zostać reżyserką.",
                                "it": "Fin dall'infanzia sogna di lavorare nel <w>cinema</w> e di diventare regista.",
                                "cs": "Už od dětství sní o tom, že bude pracovat ve <w>filmu</w> a stane se režisérkou.",
                                "tr": "Çocukluğundan beri <w>sinemada</w> çalışmayı ve yönetmen olmayı hayal ediyor.",
                                "es": "Desde su infancia sueña con dedicarse al <w>cine</w> y convertirse en directora.",
                                "zh": "她从小就梦想投身<w>电影业</w>，成为一名女导演。"
                            }
                        },
                        {
                            "text": "Cet acteur est très populaire dans le monde du <w>ciné</w> indépendant.",
                            "target_lang_translations": {
                                "en": "This actor is very popular in the independent <w>film</w> world.",
                                "ru": "Этот актёр очень популярен в мире независимого <w>кино</w>.",
                                "nl": "Deze acteur is erg populair in de wereld van de onafhankelijke <w>film</w>.",
                                "de": "Dieser Schauspieler ist in der Welt des unabhängigen <w>Films</w> sehr beliebt.",
                                "pl": "Ten aktor jest bardzo popularny w świecie niezależnego <w>kina</w>.",
                                "it": "Questo attore è molto popolare nel mondo del <w>cinema</w> indipendente.",
                                "cs": "Tento herec je velmi populární ve světě nezávislého <w>filmu</w>.",
                                "tr": "Bu oyuncu bağımsız <w>sinema</w> dünyasında çok popüler.",
                                "es": "Este actor es muy popular en el mundo del <w>cine</w> independiente.",
                                "zh": "这位演员在独立<w>电影</w>界非常受欢迎。"
                            }
                        }
