                "senses": [
                    {
                        "sense_id": "53770377-a625-3e07-af90-08d596e3bf28",
                        "entry_id": "982fe43d-1601-3718-a454-1c97bbefb751",
                        "glosses": [
                            "isolationistisches Verhalten/Einstellung gegenüber einer nicht vorhandenen oder nur sehr schwachen, aber als extrem stark wahrgenommenen Bedrohung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5aec5126-e302-4889-8287-dcc6511df716",
                                "sense_id": "53770377-a625-3e07-af90-08d596e3bf28",
                                "text": "„Ein jüngeres Beispiel für die gleiche Belagerungsmentalität sind die weißen Siedler in Südafrika während der Hochblüte der Apartheid.“"
                            },
                            {
                                "example_id": "b69e1823-c3aa-420d-8a43-b895a7dac4ae",
                                "sense_id": "53770377-a625-3e07-af90-08d596e3bf28",
                                "text": "„Gleichzeitig entwickelten die Menschen eine Belagerungsmentalität, wie sie auch in Takhis Tagebuch des Kommunelebens zum Ausdruck kam: Diejenigen, die dablieben, waren stark und gut; diejenigen, die weggingen, waren schwach.“"
                            },
                            {
                                "example_id": "914dcc13-15be-4a13-a450-36ca2da653ac",
                                "sense_id": "53770377-a625-3e07-af90-08d596e3bf28",
                                "text": "„Die ständige Bedrohung und die militärischen Auseinandersetzungen hatten indes zur Folge, dass das ressourcenarme Tlaxcala verarmte und eine Belagerungsmentalität entwickelte, die sich unter anderem im aufwendigen Ausbau der Grenzbefestigungen mit Gräben und Mauern niederschlug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
