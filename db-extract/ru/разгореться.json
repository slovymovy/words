                ],
                "translations": [
                    {
                        "translation_id": "4b151357-b1d4-4b0f-b5f6-a02d0dec8112",
                        "source_entry_id": "06fd6000-d12a-3ded-922e-d9b072440256",
                        "source_sense_description": "начать гореть",
                        "target_lang_word": "enflammer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enflammer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e0a2410-759f-3d2a-857a-6e7b833a4693",
                                        "entry_id": "2a694060-6bbc-3139-9a91-cc000bc6a5cc",
                                        "glosses": [
                                            "Mettre en flamme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7da1962d-da28-4c2a-8637-75c46a68b61b",
                                                "sense_id": "5e0a2410-759f-3d2a-857a-6e7b833a4693",
                                                "text": "En un instant, une nappe de feu se propage autour de la coque du paquebot. Ce bouillonnement provenait d’une source sous-marine de naphte, et il a suffi de ce fragment de cigare pour l’enflammer."
                                            },
                                            {
                                                "example_id": "276c0cdc-03e0-4f4e-a37f-3a71c905b369",
                                                "sense_id": "5e0a2410-759f-3d2a-857a-6e7b833a4693",
                                                "text": "François s'exécuta, puis, d'un coup de pouce, il enflamma son briquet d'amadou et le tendit, en silence, à la fille."
                                            },
                                            {
                                                "example_id": "7fc6d779-ad85-4057-8e04-ea38ff4587d4",
                                                "sense_id": "5e0a2410-759f-3d2a-857a-6e7b833a4693",
                                                "text": "Celui-ci enflammait des torches de papier toutes préparées et me chauffait la plante des pieds."
                                            },
                                            {
                                                "example_id": "dd1cbca4-985f-4299-b07f-1ca09d33700b",
                                                "sense_id": "5e0a2410-759f-3d2a-857a-6e7b833a4693",
                                                "text": "Donner la couleur des flammes."
                                            },
                                            {
                                                "example_id": "028148a2-10cf-402f-b34f-fe0d0cc26314",
                                                "sense_id": "5e0a2410-759f-3d2a-857a-6e7b833a4693",
                                                "text": "Une large couleur de pourpre enflammait le ciel à l’occident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "263b22dc-bf96-3b1d-9380-e0a6bf67ed91",
                                        "entry_id": "2a694060-6bbc-3139-9a91-cc000bc6a5cc",
                                        "glosses": [
                                            "Causer une inflammation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e520815c-3826-4df5-b8d0-ea8b07a0a541",
                                                "sense_id": "263b22dc-bf96-3b1d-9380-e0a6bf67ed91",
                                                "text": "Mais loin de son Plateau, Arsène André étouffait. L’air résineux lui manquait, les brouillards de la Meuse lui enflammaient la gorge."
                                            },
                                            {
                                                "example_id": "d047c717-3e6c-410f-8639-868d2344bc09",
                                                "sense_id": "263b22dc-bf96-3b1d-9380-e0a6bf67ed91",
                                                "text": "Le mal de dos prend souvent pour noms : « lumbago » (ou « tour de reins »), lié à un début de détérioration du disque intervertébral qui se fissure et s’enflamme à certains endroits, « hernie discale », résultant d’une dégénérescence d’un disque intervertébral, et « sciatique », conséquence de la hernie qui vient comprimer le nerf sciatique, à la jonction entre les deux dernières vertèbres lombaires et le sacrum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "138384f4-9c4d-311c-aaf4-85565e2f18d6",
                                        "entry_id": "2a694060-6bbc-3139-9a91-cc000bc6a5cc",
                                        "glosses": [
                                            "Animer d’une vive passion, particulièrement en parlant des effets de l’amour."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03f89ded-0649-4b68-90ed-d7a2eb97910a",
                                                "sense_id": "138384f4-9c4d-311c-aaf4-85565e2f18d6",
                                                "text": "Leurs chansons et les gestes de leur danse étaient d’une impudeur ardente qui enflammait peu à peu les spectateurs très nombreux ce soir-là."
                                            },
                                            {
                                                "example_id": "8fc10597-16dc-46d7-8ee6-2695ec455711",
                                                "sense_id": "138384f4-9c4d-311c-aaf4-85565e2f18d6",
                                                "text": "Quelques jeunes clubmen, dont l’imagination aventureuse s’était enflammée de patriotisme, s’entassèrent dans cinq ou six automobiles et partirent clandestinement pour Beacon Hill."
                                            },
                                            {
                                                "example_id": "934cbd9e-1785-4a73-b5a5-01ff2dd426a5",
                                                "sense_id": "138384f4-9c4d-311c-aaf4-85565e2f18d6",
                                                "text": "Une heure auparavant, j’avais cru que Mauricette serait l’héroïne de mon aventure… Sa mère m’enflammait dix fois davantage."
                                            },
                                            {
                                                "example_id": "76ba9352-7d47-4807-a1fb-a92a2e6fac92",
                                                "sense_id": "138384f4-9c4d-311c-aaf4-85565e2f18d6",
                                                "text": "Ce 4 mars, Hébert, hargneux, enflammait les tribunes du club des Cordeliers pleines à craquer de « bonnets rouges ». Comme ceux qui venaient de le précéder au perchoir, il désignait Robespierre et ses alliés sans les nommer, préférant employer le mot faction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f4dcc01-be60-40c7-b88f-8ac10a5096a8",
                        "source_entry_id": "06fd6000-d12a-3ded-922e-d9b072440256",
                        "source_sense_description": "начать гореть сильнее",
                        "target_lang_word": "raviver",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raviver",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebce09ad-2a69-3d4a-8a35-247587d05221",
                                        "entry_id": "e916ed84-115d-3bfb-8847-8ce282a6f13c",
                                        "glosses": [
                                            "Ramener à sa vivacité première."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c6ed4dd-4a26-4bb8-8108-00a8e03df05d",
                                                "sense_id": "ebce09ad-2a69-3d4a-8a35-247587d05221",
                                                "text": "La chaleur s’était installée tôt mais, égale et modérée, elle ravivait doucement les Québécois encore un peu engourdis par l’hiver."
                                            },
                                            {
                                                "example_id": "87199952-c29f-4f18-aaad-c284406c271a",
                                                "sense_id": "ebce09ad-2a69-3d4a-8a35-247587d05221",
                                                "text": "Jeter de l’eau sur le feu d’une forge pour le raviver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fb1e1a1-9c62-31db-82c6-30e00af5c62a",
                                        "entry_id": "e916ed84-115d-3bfb-8847-8ce282a6f13c",
                                        "glosses": [
                                            "Rendre l'éclat perdu, en parlant de couleurs, d'un tableau, d'un tissu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60dd17a3-5d44-46c1-9a8d-cf5c13afe2ca",
                                                "sense_id": "7fb1e1a1-9c62-31db-82c6-30e00af5c62a",
                                                "text": "Raviver un tableau."
                                            },
                                            {
                                                "example_id": "3a8cd13b-b9b8-4a16-9fff-99cd332acac4",
                                                "sense_id": "7fb1e1a1-9c62-31db-82c6-30e00af5c62a",
                                                "text": "Raviver des couleurs, de la dorure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "518a42f9-cccd-3e75-912a-40b585f5ab20",
                                        "entry_id": "e916ed84-115d-3bfb-8847-8ce282a6f13c",
                                        "glosses": [
                                            "Remettre à nu la chair vive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62ee5740-4cc1-448d-a408-a6827b5c52d1",
                                                "sense_id": "518a42f9-cccd-3e75-912a-40b585f5ab20",
                                                "text": "Raviver une plaie,"
                                            },
                                            {
                                                "example_id": "4b68cac9-82a1-44e8-b887-93df5125a31c",
                                                "sense_id": "518a42f9-cccd-3e75-912a-40b585f5ab20",
                                                "text": "Raviver les chairs d’une plaie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0c14380-fd1d-3254-a0dc-cf7811c9d548",
                                        "entry_id": "e916ed84-115d-3bfb-8847-8ce282a6f13c",
                                        "glosses": [
                                            "Ranimer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f4c01a4-af42-4113-b418-85882a3ccf28",
                                                "sense_id": "e0c14380-fd1d-3254-a0dc-cf7811c9d548",
                                                "text": "Les souvenirs d'enfance se ravivent quand on a atteint la moitié de la vie."
                                            },
                                            {
                                                "example_id": "6633df16-e4cf-4f0b-a1f9-50cb17d0b106",
                                                "sense_id": "e0c14380-fd1d-3254-a0dc-cf7811c9d548",
                                                "text": "À la rentrée 2009, le livre d’Antonin André et Karim Rissouli ravive les tensions entre les ex-rivales."
                                            },
                                            {
                                                "example_id": "80efc099-60f3-4e2d-8f25-a58a27263f10",
                                                "sense_id": "e0c14380-fd1d-3254-a0dc-cf7811c9d548",
                                                "text": "Sa douleur s’est ravivée à cette vue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
