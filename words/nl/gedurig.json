    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6182ef58-2da8-3d9b-b074-0ceb4a90ee4a",
                    "sense_definition": "Aanhoudend of met grote regelmaat plaatsvindend; vrijwel altijd.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>gedurige</w> regen van de afgelopen week heeft de straten doen onderlopen. Normally standard usage.",
                            "target_lang_translations": {
                                "en": "The <w>continual</w> rain of the past week caused the streets to flood.",
                                "es": "La lluvia <w>continua</w> de la última semana hizo que las calles se inundaran."
                            }
                        },
                        {
                            "text": "Zij ergerde zich aan zijn <w>gedurige</w> klachten over het weer.",
                            "target_lang_translations": {
                                "en": "She was annoyed by his <w>constant</w> complaints about the weather.",
                                "es": "A ella le molestaban sus <w>constantes</w> quejas sobre el tiempo."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanhoudend",
                        "voortdurend"
                    ],
                    "common_phrases": [
                        "gedurige regen",
                        "gedurige klachten"
                    ],
                    "target_lang_definitions": {
                        "en": "Continuous or occurring with great regularity; virtually always.",
                        "es": "Que ocurre de forma continua, incesante o con gran regularidad; casi siempre."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "continual",
                                "target_lang_sense_clarification": "occurring repeatedly or constantly without pause"
                            },
                            {
                                "target_lang_word": "constant",
                                "target_lang_sense_clarification": "persistent and unchanging"
                            },
                            {
                                "target_lang_word": "frequent",
                                "target_lang_sense_clarification": "occurring often"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "continuo",
                                "target_lang_sense_clarification": "que no cesa o se repite con frecuencia"
                            },
                            {
                                "target_lang_word": "constante",
                                "target_lang_sense_clarification": "que se mantiene en el tiempo"
                            },
                            {
                                "target_lang_word": "frecuente",
                                "target_lang_sense_clarification": "que ocurre a menudo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "6f026710-ec39-32ca-bec8-56ca22efba9a",
                    "sense_definition": "Keer op keer gebeurend; herhaaldelijk.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>gedurige</w> onderbrekingen maakten het moeilijk om de presentatie te volgen.",
                            "target_lang_translations": {
                                "en": "His <w>continual</w> interruptions made it difficult to follow the presentation.",
                                "es": "Sus <w>continuas</w> interrupciones hicieron difícil seguir la presentación."
                            }
                        },
                        {
                            "text": "We moeten reageren op de <w>gedurige</w> verzoeken van de klanten.",
                            "target_lang_translations": {
                                "en": "We must respond to the <w>frequent</w> requests from the customers.",
                                "es": "Debemos responder a las <w>constantes</w> solicitudes de los clientes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gedurige onderbrekingen"
                    ],
                    "target_lang_definitions": {
                        "en": "Happening time after time; repeatedly.",
                        "es": "Que ocurre una y otra vez; repetidamente."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "continually",
                                "target_lang_sense_clarification": "repeatedly or without interruption"
                            },
