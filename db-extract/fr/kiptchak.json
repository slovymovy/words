                ],
                "senses": [
                    {
                        "sense_id": "87726785-83e8-34c9-b46f-8d5f48631134",
                        "entry_id": "b8f37b73-aae5-33d5-aac2-1d7957828468",
                        "glosses": [
                            "Membre d'une confédération tribale turque nomade qui a envahi la steppe eurasienne (pour fonder l’empire du Kaptchak) au milieu du onzième siècle."
                        ],
                        "tags": [
                            "Ethnonymie"
                        ],
                        "examples": [
                            {
                                "example_id": "b601b7e2-2d1c-4312-8e51-6e3294bce752",
                                "sense_id": "87726785-83e8-34c9-b46f-8d5f48631134",
                                "text": "Le Ferganah n’est pas seulement peuplé de Sartes commerçans ou cultivateurs. Sa partie orientale est encore habitée actuellement par les Kiptchaks, race guerrière et nomade qui, à diverses époques, a joué un grand rôle dans l’histoire de l’Orient, et qui y a fondé plusieurs empires."
                            }
                        ]
                    }
                ],
