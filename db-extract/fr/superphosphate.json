                ],
                "senses": [
                    {
                        "sense_id": "5f68f928-fb7e-30c5-80cb-1414fe63fcdb",
                        "entry_id": "dabe66e9-37b1-3c3d-ab32-024029420d67",
                        "glosses": [
                            "Engrais pour les sols, composé de phosphate acide de calcium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a9a6356-14f1-4bad-b010-b7cedff15103",
                                "sense_id": "5f68f928-fb7e-30c5-80cb-1414fe63fcdb",
                                "text": "La plupart du temps, la publicité qu'on lit aux carrefours, dans les bourgs, concerne des calcimètres, des acidimètres, des vinoscopes, des glucomètres, des pèse-moûts, des vinomètres, des mustimètres, des ébullioscopes, […], des guanos, des superphosphates, des acides tartriques, des tannins, des adhésols, des tétracuprites, des pyralumnols...."
                            },
                            {
                                "example_id": "02b864a5-1f50-4a94-a3eb-6a78e20a9983",
                                "sense_id": "5f68f928-fb7e-30c5-80cb-1414fe63fcdb",
                                "text": "Le superphosphate triple de la SIAPE (ou TSP, ou encore super 45) offre de multiples avantages pour la réception en sacs […]."
                            },
                            {
                                "example_id": "e55ddabb-9d3e-45cf-a305-d0bbe84bf7b4",
                                "sense_id": "5f68f928-fb7e-30c5-80cb-1414fe63fcdb",
                                "text": "- les superphosphates (solubilité 50 g/l à pH 7) dosent 25 % P₂O₅ et 20 % CaO pour le super concentré ou 45 % P₂O₅ et 18 % CaO pour le super triple ; […]."
                            },
                            {
                                "example_id": "0d8dec09-146c-44b2-92d6-f8db50f3bf3c",
                                "sense_id": "5f68f928-fb7e-30c5-80cb-1414fe63fcdb",
                                "text": "Les doses d'engrais peuvent atteindre 200 à 400 kg d’ammonitrates à 30 ou 33% d'azote et 100 à 300 kg de superphosphates à 16% de P₂O₅ dans le cas de production intensive."
                            }
                        ]
                    }
                ],
