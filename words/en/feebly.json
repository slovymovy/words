{
    "word_family": [
        "feeble",
        "feebleness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8a165a6f-ce16-3187-b039-fe947388271c",
                    "sense_definition": "In a manner lacking physical strength, vigor, or force",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient waved <w>feebly</w> from the hospital bed as visitors walked into the room.",
                            "target_lang_translations": {
                                "ru": "Пациент <w>слабо</w> помахал рукой с больничной койки, когда в палату вошли посетители.",
                                "zh": "访客走进病房时，病人从病床上<w>虚弱地</w>挥了挥手。"
                            }
                        },
                        {
                            "text": "He tried <w>feebly</w> to protest the unfair decision, but no one listened to him.",
                            "target_lang_translations": {
                                "ru": "Он <w>вяло</w> попытался опротестовать несправедливое решение, но никто его не слушал.",
                                "zh": "他试图对这个不公正的决定进行<w>苍白无力地</w>抗议，但没有人听他的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "weakly",
                        "faintly"
                    ],
                    "antonyms": [
                        "strongly",
                        "vigorously",
                        "forcefully"
                    ],
                    "common_phrases": [
                        "smile feebly",
                        "protest feebly",
                        "wave feebly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабо, немощно, без физической силы, энергии или убедительности",
                        "zh": "虚弱地、无力地；缺乏精力或力量地"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабо",
                                "target_lang_sense_clarification": "без сил или энергии"
                            },
                            {
                                "target_lang_word": "немощно",
                                "target_lang_sense_clarification": "из-за болезни или старости"
                            },
                            {
                                "target_lang_word": "вяло",
                                "target_lang_sense_clarification": "без энтузиазма или упорства"
                            },
                            {
                                "target_lang_word": "едва слышно",
                                "target_lang_sense_clarification": "о звуках или протестах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虚弱地",
                                "target_lang_sense_clarification": "身体虚弱无力"
                            },
                            {
                                "target_lang_word": "无力地",
                                "target_lang_sense_clarification": "缺乏力量或气力"
                            },
                            {
                                "target_lang_word": "苍白无力地",
                                "target_lang_sense_clarification": "用于抗议、辩解等缺乏说服力或气势"
                            }
                        ]
                    }
                }
            ]
        }
