                "senses": [
                    {
                        "sense_id": "82d119a9-2952-3259-a3f5-dcfa66af2197",
                        "entry_id": "60a75d38-29b6-38be-9d46-a5b08215f03a",
                        "glosses": [
                            "pochodzący od zwierząt, spowodowany przez zwierzęta"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "972d8fc1-c3d5-4623-9f35-ef9758ae8641",
                                "sense_id": "82d119a9-2952-3259-a3f5-dcfa66af2197",
                                "text": "Salmonellozy u ludzi są chorobą odzwierzęcą, a głównym rezerwuarem zakażeń jest drób, jaja, w mniejszym stopniu bydło rzeźne"
                            },
                            {
                                "example_id": "4ba17eb3-dcc8-404d-94db-c42fea13ce03",
                                "sense_id": "82d119a9-2952-3259-a3f5-dcfa66af2197",
                                "text": "Składniki pochodzenia odzwierzęcego nie są częścią żadnego etapu tworzenia maltodekstryny, tak więc weganie i wegetarianie mogą odetchnąć z ulgą"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
