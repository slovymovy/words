                        "examples": [
                            {
                                "example_id": "a1fba390-ae0f-4197-9119-a0be7c7c722c",
                                "sense_id": "e006f307-b48f-3515-850f-a1d11667634d",
                                "text": "De stichting verwijt de gemeente Enschede dat die het zigeunervolk Roma over een kam scheert."
                            },
                            {
                                "example_id": "8ca3a538-2af6-4a1e-8d74-d441a6ff399e",
                                "sense_id": "e006f307-b48f-3515-850f-a1d11667634d",
                                "text": "Vaak brengen ouders hun kleintjes naar een weeshuis, omdat ze te arm zijn om voor hen te kunnen zorgen. Vooral bij de Roma, een zigeunervolk, komt dit veel voor."
                            },
                            {
                                "example_id": "1ce13fc1-ac39-4191-a8b2-347d88552dd5",
                                "sense_id": "e006f307-b48f-3515-850f-a1d11667634d",
                                "text": "Hij ging op pad met de waar van zijn vader en sprak de mensen aan over Jezus. Hij vertelde hun hoe hij de Zaligmaker gevonden had. Ook het lot van het zigeunervolk waartoe hij behoorde, trok hij zich aan."
                            }
                        ]
                    }
