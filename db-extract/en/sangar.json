                        "glosses": [
                            "A stone breastwork; a fortified niche or look-out post."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "c990ab66-21c0-423d-bbe1-c03310a692f1",
                                "sense_id": "a680c84f-bb59-351a-afd0-7ffe4c672336",
                                "text": "At the summits of these the enemy sharpshooters waited for them in sangars, or rock-built entrenchments, each of which had to be taken before the advance could safely continue."
                            },
                            {
                                "example_id": "af7c1a7c-b29f-4728-a52b-9b77a00947e5",
                                "sense_id": "a680c84f-bb59-351a-afd0-7ffe4c672336",
                                "text": "A sangar is a breastwork in the form of stonewalls built without bounding material. If stones are unavailable at or near the picket site sandbags are brought in to build the sangar."
                            },
                            {
                                "example_id": "d0f3d2f8-06eb-4486-a749-fa043b04aef9",
                                "sense_id": "a680c84f-bb59-351a-afd0-7ffe4c672336",
                                "text": "As the sun finally set, the rebels rushed the sangars, but were cut to pieces by the deadly accurate SAS fire."
                            },
                            {
                                "example_id": "ba5c0cb4-1b60-4695-a107-c90b533d54cb",
                                "sense_id": "a680c84f-bb59-351a-afd0-7ffe4c672336",
                                "text": "The game′s up, thought Piet as the Burghers returned fire and moved forward to attack the sangar."
                            }
                        ]
                    }
