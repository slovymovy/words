                        "sense_id": "00fb0db1-d456-388e-9ebb-4f1c58f63ca1",
                        "entry_id": "ed41d0ee-1727-3a45-a032-02c3985a0726",
                        "glosses": [
                            "meist kleinere Bibliothek, deren Einzugsbereich ein bestimmter Teil einer Stadt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aafd2a62-61cb-46a5-b24d-ee34b2e2e86c",
                                "sense_id": "00fb0db1-d456-388e-9ebb-4f1c58f63ca1",
                                "text": "„Außerdem schrieben sich Sophia und Eleni in der Stadtteilbücherei ein, um ihren Lesehunger zu stillen.“"
                            },
                            {
                                "example_id": "0d42102a-7480-4d35-abc2-c6e054c208a1",
                                "sense_id": "00fb0db1-d456-388e-9ebb-4f1c58f63ca1",
                                "text": "„Du weißt vielleicht noch, dass ich das letzte halbe Jahr in Frankfurt in der Stadtteilbücherei gearbeitet habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
