                ],
                "senses": [
                    {
                        "sense_id": "8f74f0e3-72d9-338d-9dfa-b91b1e476e31",
                        "entry_id": "f1f5cac0-8ad2-3d79-bdc8-a4c36dfc9770",
                        "glosses": [
                            "Enlever le filler de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec8301cb-1973-4135-8d8c-7cd29e4b2ccb",
                                "sense_id": "8f74f0e3-72d9-338d-9dfa-b91b1e476e31",
                                "text": "Toutefois, il ne faut pas négliger une possibilité intéressante qui consisterait à défilleriser les sables de concassage par lavage ou dépoussiérage."
                            },
                            {
                                "example_id": "36a2d81a-d0cc-4e42-9d18-e28403a2eb5f",
                                "sense_id": "8f74f0e3-72d9-338d-9dfa-b91b1e476e31",
                                "text": "La teneur en filler totale, sachant que le sable a été précédemment défillerisé par voie humide, et qu’on a rajouté ensuite du filler de même nature minéralogique que le reste de la formule granulométrique."
                            },
                            {
                                "example_id": "bac9630c-822a-4400-b927-4cb9aeef4a98",
                                "sense_id": "8f74f0e3-72d9-338d-9dfa-b91b1e476e31",
                                "text": "Avec la nouvelle usine, on peut \"défilleriser\". C’est-à-dire extraire les composants de plus petits calibres pour d’autres usages : l’alimentation animale."
                            }
                        ]
                    }
                ],
