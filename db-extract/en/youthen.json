                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6f9df7fa-416b-4e73-b901-ce38abb6dd49",
                                "sense_id": "bdb2ad22-ce4d-3793-a996-865cbd9863c2",
                                "text": "It youthened her, melted the stark, hungry grip about her mouth."
                            },
                            {
                                "example_id": "dbf2efe9-3a0e-450f-be15-cf119f637e4f",
                                "sense_id": "bdb2ad22-ce4d-3793-a996-865cbd9863c2",
                                "text": "Mr. Wilson can hardly be unaware that once a writer chooses to youthen or resurrect a word, it lives again..."
                            }
                        ]
                    },
                    {
                        "sense_id": "b248a962-80d3-339c-9c55-07ffe42119cd",
                        "entry_id": "d8e71d3d-f832-32bf-a5d8-a6c70051458c",
                        "glosses": [
                            "To become younger or more youthful."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b73ddf5f-520e-4ec3-aef6-558df9f56946",
                                "sense_id": "b248a962-80d3-339c-9c55-07ffe42119cd",
                                "text": "He nods, time traveling to a point when there were no central lines, no low blood counts, no immunosuppressive drugs. His face youthens momentarily as he bridges back to a point on a timeline that has none of this devastation on it."
