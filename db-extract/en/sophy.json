                    {
                        "sense_id": "5c015e6d-c4b8-3c94-a30b-e0c9d78cb386",
                        "entry_id": "69176624-523b-35c6-8236-d9655aadf7b2",
                        "glosses": [
                            "A diminutive of the female given name Sophia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21ea9437-1e8b-4f10-863e-20887cd38a26",
                                "sense_id": "5c015e6d-c4b8-3c94-a30b-e0c9d78cb386",
                                "text": "I knew Sophy was a good girl, and would not fall in love to make me angry."
                            }
                        ]
                    }
                ],
