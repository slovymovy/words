                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a33ef8d-7bca-486e-a9a9-57d3c05b36b7",
                                "sense_id": "aa5e721d-7e2a-3efd-b7bc-a7924d1e8c15",
                                "text": "Колониза́ция Ма́рса явля́ется ва́жным ша́гом для бу́дущего челове́чества.",
                                "translation": "火星殖民地化是人類未來的重要一步。"
                            }
                        ]
                    },
                    {
                        "sense_id": "3913dc84-b89c-3a98-8f41-303cd6fbc3ae",
                        "entry_id": "cb253cd3-a036-38ba-b751-638ec0500ecb",
                        "glosses": [
                            "奪取，佔用，沒收"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ab80fc8-d16a-4868-a83a-f4a4de6d9630",
                                "sense_id": "3913dc84-b89c-3a98-8f41-303cd6fbc3ae",
                                "text": "Со вре́мени вели́ких географи́ческих откры́тий европе́йская колониза́ция дре́вних райо́нов ми́ра сопровожда́лась наси́льственным подчине́нием ме́стного населе́ния.",
                                "translation": "自地理大發現以來，歐洲對世界上古老地區的殖民一直伴隨著對當地居民的強行征服。"
                            }
                        ]
                    }
