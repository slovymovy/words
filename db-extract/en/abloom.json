    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "885e9d16-35fe-30ee-aefa-c10ac13b88c9",
                "word": "abloom",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "46c576e4-e632-464e-ba14-91a213deb3b8",
                        "entry_id": "885e9d16-35fe-30ee-aefa-c10ac13b88c9",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more abloom"
                    },
                    {
                        "form_id": "4f9ec062-22f6-47a2-b47c-41484e4605bc",
                        "entry_id": "885e9d16-35fe-30ee-aefa-c10ac13b88c9",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most abloom"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6a1b12b-ba93-3260-b5f3-485eaabd3c83",
                        "entry_id": "885e9d16-35fe-30ee-aefa-c10ac13b88c9",
                        "glosses": [
                            "Blooming; covered in flowers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d8fcf49-4778-45a4-b555-0ce726836f82",
                                "sense_id": "e6a1b12b-ba93-3260-b5f3-485eaabd3c83",
                                "text": "[…] on summer nights when the tulips were abloom and the bees buzzing […]"
                            },
                            {
                                "example_id": "c97b09ce-d36d-477e-be76-d4e1b9cef12e",
                                "sense_id": "e6a1b12b-ba93-3260-b5f3-485eaabd3c83",
                                "text": "[Krazy Kat:] How can you tell spring is here, Offissa Pupp? / [Officer Pupp:] By the flower abloom in yon pot."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f6dfb22-c60a-3a35-9137-6b3f9f9e75d0",
                        "entry_id": "885e9d16-35fe-30ee-aefa-c10ac13b88c9",
                        "glosses": [
                            "Having something growing or grown."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8e42a7ba-32e9-488a-9262-0eec12cb8b87",
                                "sense_id": "9f6dfb22-c60a-3a35-9137-6b3f9f9e75d0",
                                "text": "He was abloom with heat and anxiety. The sweat underneath his arms had turned into an oily slick."
                            },
                            {
                                "example_id": "2c02d234-f619-4d44-904b-0982ec6b4329",
                                "sense_id": "9f6dfb22-c60a-3a35-9137-6b3f9f9e75d0",
                                "text": "For Santa Claus comes / With reindeer and sleigh / To fill up the stockings on glad Christmas Day. / And there in the library / Stands a great tree / With gifts all abloom, most lovely to see!"
                            },
                            {
                                "example_id": "4103b07d-adb0-46df-bfec-1d806a55d0d8",
                                "sense_id": "9f6dfb22-c60a-3a35-9137-6b3f9f9e75d0",
                                "text": "Who does not feel the passage of divine dreams over his troubled life when the infinite meadows of heaven are suddenly abloom with light?"
                            }
                        ]
                    },
                    {
                        "sense_id": "f8e3a01c-3fe5-30b9-94db-573b85946584",
                        "entry_id": "885e9d16-35fe-30ee-aefa-c10ac13b88c9",
                        "glosses": [
                            "Thriving in health, beauty, and vigor; exhibiting youth-like beauty."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60ea4eb7-c288-4995-ac84-bd8f3d54171e",
                                "sense_id": "f8e3a01c-3fe5-30b9-94db-573b85946584",
                                "text": "The Hollywood concept of clean-shaven, square-jawed young men and fragrant young ladies with cheeks abloom does not seem to square with the facts."
                            },
                            {
                                "example_id": "becd0027-e9c3-43ab-b913-56ee334d539a",
                                "sense_id": "f8e3a01c-3fe5-30b9-94db-573b85946584",
                                "text": "When they returned, Jade's cheeks were abloom, her eyes alight with anticipation."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
