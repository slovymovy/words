                                        "entry_id": "389e68fe-ba8b-3805-afb5-ad2d1c19c567",
                                        "glosses": [
                                            "Zuschreibung menschlicher Eigenschaften zu (einem) Gott"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aeb8b89-693f-49c5-9057-ea049d51d44c",
                                                "sense_id": "39dbfcdc-eeb5-3e76-ab02-53c3719a2da8",
                                                "text": "Philo argumentiert, dass die Schwäche der Analogie zwischen einem Hause und dem Universum so schwach sei, dass an Cleanthes Anthropomorphismus erhebliche Zweifel erwüchsen."
                                            }
