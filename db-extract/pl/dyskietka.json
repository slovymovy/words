                    },
                    {
                        "translation_id": "93dab446-09fb-449a-bd94-8616344f9e95",
                        "source_entry_id": "b0d44ec9-beb2-3498-9f2e-cffb5e46c5c9",
                        "source_sense_id": "d2d4a6e1-5b91-3cac-945e-ab53ca70dee7",
                        "target_lang_word": "floppy disk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "floppy disk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57a269d5-e237-348f-9816-b039b3079851",
                                        "entry_id": "da11aa49-fd42-3866-8626-12fd3b04db3f",
                                        "glosses": [
                                            "A removable disk used for storing digital data, measuring between 2 and 8 inches diagonally and storing between 80 KB and 240 MB."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "533be5f1-8cde-43b2-8b9f-72eaaa5fa221",
                                                "sense_id": "57a269d5-e237-348f-9816-b039b3079851",
                                                "text": "A hacker starts with nothing but a dream and a floppy disk and presently finds himself in a business that's doubled and trebled."
                                            },
                                            {
                                                "example_id": "6170c7a2-4094-4611-b386-32755da8b20a",
                                                "sense_id": "57a269d5-e237-348f-9816-b039b3079851",
                                                "text": "The floppy disk itself is a magnetically coated flexible plastic disk which is mounted in a protective envelope and can be used as a mass data storage medium."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74732771-0b9b-4286-bcb9-755c05d6b03f",
                        "source_entry_id": "b0d44ec9-beb2-3498-9f2e-cffb5e46c5c9",
                        "source_sense_id": "d2d4a6e1-5b91-3cac-945e-ab53ca70dee7",
                        "target_lang_word": "disketa",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disketa",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "bad50dbc-1daf-3029-97df-8cca0a66681c",
                                        "entry_id": "9acced21-605a-398e-93a7-8ebb53e78e82",
                                        "glosses": [
                                            "pružný plastový disk pro magnetický záznam dat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4a3ec6d-dcb5-4c81-b724-789c95ea0b24",
                                                "sense_id": "bad50dbc-1daf-3029-97df-8cca0a66681c",
                                                "text": "Výrobci přestávají vyrábět diskety a uživatelé přecházejí na optické disky a flash paměti. Diskety ale sehrály významnou roli při rozšiřování počítačů mezi uživatele."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f51c9531-3ab4-4db7-b63e-b6725a24d58b",
                        "source_entry_id": "b0d44ec9-beb2-3498-9f2e-cffb5e46c5c9",
                        "source_sense_id": "d2d4a6e1-5b91-3cac-945e-ab53ca70dee7",
                        "target_lang_word": "disquette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disquette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78090e30-27a8-3be5-85ad-1938eb20ebfa",
                                        "entry_id": "fd231cfd-6465-3d0b-b095-9512f42cb4fc",
                                        "glosses": [
                                            "Petit disque souple enfermé dans une enveloppe rigide, utilisé en informatique comme moyen amovible de stockage d’information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5d4b736-2769-43ee-9153-f99a4f8eea5c",
                                                "sense_id": "78090e30-27a8-3be5-85ad-1938eb20ebfa",
                                                "text": "En effet, il fonctionne à l’aide d’une disquette et d’un micro-ordinateur de marque Macintosh."
                                            },
                                            {
                                                "example_id": "0c4410ef-2ac9-4fa6-850d-e1bec91945a2",
                                                "sense_id": "78090e30-27a8-3be5-85ad-1938eb20ebfa",
                                                "text": "Il faut insérer une disquette, attendre que la machine bourdonne, en insérer une seconde puis retirer la première."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disquette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d58cf60-433c-3bb9-8dae-28dd66767b30",
                                        "entry_id": "bfae0ebe-b227-35b2-92df-0c69f4cbba5f",
                                        "glosses": [
                                            "Jeune fille attirante."
                                        ],
                                        "tags": [
                                            "Sénégal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aa9c88b-f333-41dd-8c08-8e0b5c83b216",
                                                "sense_id": "1d58cf60-433c-3bb9-8dae-28dd66767b30",
                                                "text": "— Et quand on vous dit disquette, ça vous fait rire ?\n— Surtout quand vous dites que vous allez enfiler la disquette… Chez moi, au Sénégal, une disquette ce n’est pas votre carré de plastique. Une disquette c’est ce que vous appelez une gisquette, une minette… Une petite femme attirante et facile…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disquette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1f68e81-0d5a-37b5-8645-ee4dd5d5ccb0",
                                        "entry_id": "8ae96298-b04b-388d-89c0-bd1f0ad3135f",
                                        "glosses": [
                                            "Baratin et, plus généralement, phrase d’accroche efficace pour séduire."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fc5f278-23aa-4526-88b0-78812e1ceceb",
                                                "sense_id": "e1f68e81-0d5a-37b5-8645-ee4dd5d5ccb0",
                                                "text": "Au début, c’est “wesh la miss”, j’te fais coucou ;\nAprès j’te mets une disquette pour te mettre mon coup-coup."
                                            },
                                            {
                                                "example_id": "2d275e99-44e8-45e3-bb57-9bc9fd5a56f0",
                                                "sense_id": "e1f68e81-0d5a-37b5-8645-ee4dd5d5ccb0",
                                                "text": "Si j’aborde une fille, j’ai peur qu’elle soit intimidée, parce qu’aujourd’hui, dans la rue, les meufs ne se sentent pas en sécurité. C’est normal : les mecs leur sortent des disquettes de merde [des répliques de drague toutes faites] : des “Hé mademoiselle ! T’es mignonne !”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0561b6c5-8b50-377e-bcf1-8ee60d025525",
                                        "entry_id": "8ae96298-b04b-388d-89c0-bd1f0ad3135f",
                                        "glosses": [
                                            "Mensonge."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
