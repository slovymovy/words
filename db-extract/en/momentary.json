                        "cross_references": []
                    },
                    {
                        "translation_id": "c3b4df15-4df7-4352-926f-89d2dcc94793",
                        "source_entry_id": "95f90049-8e16-306b-baf2-bc535a3b9c0d",
                        "source_sense_description": "lasting for only a moment",
                        "target_lang_word": "momentané",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "momentané",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0dd7ed15-7132-32d5-b225-1900a5b18dff",
                                        "entry_id": "0252ca4d-af8a-3f4f-9d0a-53105451ed05",
                                        "glosses": [
                                            "Qui ne dure qu’un moment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14a9f53d-d6c4-4c00-8baa-7d5bc88a546e",
                                                "sense_id": "0dd7ed15-7132-32d5-b225-1900a5b18dff",
                                                "text": "Mais les révolutions sont toujours des sacrifices que le temps fait à l'avenir, et qui nécessitent de la part des peuples par qui elles s'accomplissent un grand désintéressement momentané."
                                            },
                                            {
                                                "example_id": "8f542a06-d03b-4121-9c1c-4bbe882b3f1b",
                                                "sense_id": "0dd7ed15-7132-32d5-b225-1900a5b18dff",
                                                "text": "Les néologismes sont en effet des constructions momentanées, la plupart du temps non reprises, et qui rapidement disparaissent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0308ef98-c53a-4c3f-b9e7-b422de3f1b6a",
                        "source_entry_id": "95f90049-8e16-306b-baf2-bc535a3b9c0d",
                        "source_sense_description": "lasting for only a moment",
                        "target_lang_word": "vorübergehend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorübergehend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78283de3-d3a4-3eb4-b963-2c84900c14f1",
                                        "entry_id": "5b1f2839-1c82-3c06-b77d-02967594ff69",
                                        "glosses": [
                                            "nur kurze Zeit dauernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5ed13d5-4789-48a5-b89e-74f756810176",
                                                "sense_id": "78283de3-d3a4-3eb4-b963-2c84900c14f1",
                                                "text": "Die Linie 8 fährt nur vorübergehend nicht über die Eisenbahnstraße."
                                            },
                                            {
                                                "example_id": "92542e30-af61-4081-b246-00b7d8783d22",
                                                "sense_id": "78283de3-d3a4-3eb4-b963-2c84900c14f1",
                                                "text": "Das Übergrößengeschäft bleibt wegen Krankheit vorübergehend geschlossen."
                                            },
                                            {
                                                "example_id": "f802e993-750d-4fe5-9e76-d45b78e11c56",
                                                "sense_id": "78283de3-d3a4-3eb4-b963-2c84900c14f1",
                                                "text": "Die Überfüllung der Hörsäle ist nur ein vorübergehender Zustand während der Renovierung der Universitätsgebäude."
                                            },
                                            {
                                                "example_id": "a7077508-603a-44d7-8514-171d573c0e7d",
                                                "sense_id": "78283de3-d3a4-3eb4-b963-2c84900c14f1",
                                                "text": "„Er forderte von der Stadt eine vorübergehende Aufhebung des Fütterungsverbotes und neue Taubenschläge zur kontrollierten Haltung der Vögel, um deren \"Leid\" in den Griff zu bekommen.“"
                                            },
                                            {
                                                "example_id": "c52bf745-733d-4b7c-8160-5eb6ce7da418",
                                                "sense_id": "78283de3-d3a4-3eb4-b963-2c84900c14f1",
                                                "text": "[…] „Mal produzieren Wind und Sonne große Überschüsse, die das Netz überlasten; mal so wenig, dass wir vorübergehend zu wenig Strom zur Verfügung hätten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
