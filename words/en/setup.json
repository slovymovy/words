{
    "word_family": [
        "set",
        "upset",
        "reset",
        "preset",
        "offset",
        "setting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5ae11673-18d3-31b3-b284-988604462870",
                    "sense_definition": "The way in which something is organized, arranged, or structured.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "arrangement_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The classroom <w>setup</w> was simple and efficient.",
                            "target_lang_translations": {
                                "ru": "<w>Планировка</w> класса была простой и эффективной.",
                                "zh": "教室的<w>布局</w>既简单又高效。"
                            }
                        },
                        {
                            "text": "We need to discuss the <w>setup</w> of the conference room before the meeting starts.",
                            "target_lang_translations": {
                                "ru": "Нам нужно обсудить <w>организацию</w> конференц-зала до начала встречи.",
                                "zh": "会议开始前，我们需要讨论一下会议室的<w>布置</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "configuration",
                        "layout",
                        "arrangement",
                        "organization"
                    ],
                    "common_phrases": [
                        "room setup",
                        "organizational setup",
                        "initial setup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ организации, расположения или структурирования чего-либо.",
                        "zh": "指某事物的组织、安排或结构方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устройство",
                                "target_lang_sense_clarification": "способ организации или структура чего-либо"
                            },
                            {
                                "target_lang_word": "планировка",
                                "target_lang_sense_clarification": "расположение объектов в пространстве (комнате, здании)"
                            },
                            {
                                "target_lang_word": "организация",
                                "target_lang_sense_clarification": "процесс или результат налаживания чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "布局",
                                "target_lang_sense_clarification": "空间或结构上的安排"
                            },
                            {
                                "target_lang_word": "组织",
                                "target_lang_sense_clarification": "系统或结构的安排方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "727d668a-3006-3306-9d5e-7a224d4f1061",
                    "sense_definition": "A set of equipment or apparatus designed and arranged for a particular purpose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "arrangement_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory included an elaborate <w>setup</w> for measuring the energy.",
                            "target_lang_translations": {
                                "ru": "Лаборатория включала сложную <w>установку</w> для измерения энергии.",
                                "zh": "实验室里有一套用于测量能量的精密<w>装置</w>。"
                            }
                        },
                        {
                            "text": "He has a very expensive gaming <w>setup</w> with multiple monitors in his bedroom.",
                            "target_lang_translations": {
                                "ru": "У него в спальне очень дорогое игровое <w>оборудование</w> с несколькими мониторами.",
                                "zh": "他的卧室里有一套非常昂贵的、带有多个显示器的游戏<w>设备</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "apparatus",
                        "loadout"
                    ],
                    "common_phrases": [
                        "gaming setup",
                        "computer setup",
                        "elaborate setup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор оборудования или аппаратуры, предназначенный и настроенный для определенной цели.",
                        "zh": "为特定目的而设计和布置的一套设备或装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "установка",
                                "target_lang_sense_clarification": "техническое устройство или механизм"
                            },
                            {
                                "target_lang_word": "оборудование",
                                "target_lang_sense_clarification": "совокупность технических средств (компьютерное, игровое)"
                            },
                            {
                                "target_lang_word": "система",
                                "target_lang_sense_clarification": "комплекс устройств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装置",
                                "target_lang_sense_clarification": "为特定功能安装的设备组合"
                            },
                            {
                                "target_lang_word": "设备",
                                "target_lang_sense_clarification": "成套的硬件设施"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3488a74a-06dd-3edf-b2c2-44d2c7092497",
                    "sense_definition": "A dishonest plan or situation orchestrated to trick someone or make them appear guilty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trust me, that was a <w>setup</w>!",
                            "target_lang_translations": {
                                "ru": "Поверь мне, это была <w>подстава</w>!",
                                "zh": "相信我，那是个<w>圈套</w>！"
                            }
                        },
                        {
                            "text": "The criminal claimed the evidence was planted as part of a police <w>setup</w>.",
                            "target_lang_translations": {
                                "ru": "Преступник заявил, что улики были подброшены в рамках полицейской <w>провокации</w>.",
                                "zh": "罪犯声称这些证据是警方栽赃的，整件事就是一个<w>圈套</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "frameup",
                        "stitch-up"
                    ],
                    "common_phrases": [
                        "it was a setup",
                        "police setup"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in crime or mystery contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечестный план или ситуация, подстроенная с целью обмануть кого-то или выставить виновным.",
                        "zh": "为了欺骗某人或使其看起来有罪而精心策划的不诚实计划或局面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подстава",
                                "target_lang_sense_clarification": "разг. намеренно созданная ситуация для обвинения невиновного"
                            },
                            {
                                "target_lang_word": "ловушка",
                                "target_lang_sense_clarification": "ситуация, созданная для поимки или обмана"
                            },
                            {
                                "target_lang_word": "провокация",
                                "target_lang_sense_clarification": "подстрекательство или инсценировка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陷阱",
                                "target_lang_sense_clarification": "诱人入局的圈套"
                            },
                            {
                                "target_lang_word": "圈套",
                                "target_lang_sense_clarification": "蓄意设计的骗局"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdf71571-a710-396b-9aff-531ea8fad06f",
                    "sense_definition": "A software program or file used to install an application or operating system on a computer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You still have to run the <w>setup</w> and select the display driver after restarting.",
                            "target_lang_translations": {
                                "ru": "Вам все еще нужно запустить <w>программу установки</w> и выбрать драйвер дисплея после перезагрузки.",
                                "zh": "重启后，你还需要运行<w>安装程序</w>并选择显示驱动。"
                            }
                        },
                        {
                            "text": "Double-click the <w>setup</w> file to begin the installation process.",
                            "target_lang_translations": {
                                "ru": "Дважды щелкните файл <w>установщика</w>, чтобы начать процесс инсталляции.",
                                "zh": "双击<w>安装程序</w>以开始安装过程。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "run the setup",
                        "setup file",
                        "setup wizard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Программа или файл, используемые для установки приложения или операционной системы на компьютер.",
                        "zh": "用于在计算机上安装应用程序或操作系统的软件程序或文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "программа установки",
                                "target_lang_sense_clarification": "ПО для инсталляции"
                            },
                            {
                                "target_lang_word": "установщик",
                                "target_lang_sense_clarification": "исполняемый файл, запускающий процесс установки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安装程序",
                                "target_lang_sense_clarification": "执行软件安装的程序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d3a58b3-8b58-3dfb-a218-277023b15fcf",
                    "sense_definition": "The process of preparing a machine or arranging resources for a specific production run or operation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arrangement_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A simple <w>setup</w> on the bottling line involves reloading bottles and labels.",
                            "target_lang_translations": {
                                "ru": "Простая <w>наладка</w> на линии розлива включает загрузку бутылок и этикеток.",
                                "zh": "灌装线的简单<w>调试</w>包括重新装载瓶子和标签。"
                            }
                        },
                        {
                            "text": "The machine requires a lengthy <w>setup</w> before we can switch to the new product.",
                            "target_lang_translations": {
                                "ru": "Машина требует длительной <w>настройки</w>, прежде чем мы сможем переключиться на новый продукт.",
                                "zh": "在切换到新产品之前，这台机器需要进行长时间的<w>准备工作</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "make-ready",
                        "makeready"
                    ],
                    "common_phrases": [
                        "setup time",
                        "machine setup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс подготовки машины или организации ресурсов для конкретного производственного цикла или операции.",
                        "zh": "为特定的生产运行或操作准备机器或安排资源的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наладка",
                                "target_lang_sense_clarification": "подготовка механизма к работе"
                            },
                            {
                                "target_lang_word": "настройка",
                                "target_lang_sense_clarification": "регулировка параметров перед запуском"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调试",
                                "target_lang_sense_clarification": "机器运行前的参数调整"
                            },
                            {
                                "target_lang_word": "准备工作",
                                "target_lang_sense_clarification": "生产前的资源配置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92b34854-a00c-3049-aed9-e56b1265fc73",
                    "sense_definition": "A move or action in sports or fighting designed to create an opportunity for a subsequent attack or goal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jab is most commonly used as a <w>setup</w> for other strikes.",
                            "target_lang_translations": {
                                "ru": "Джеб чаще всего используется как <w>подготовка</w> для других ударов.",
                                "zh": "刺拳最常被用作其他攻击的<w>铺垫</w>。"
                            }
                        },
                        {
                            "text": "His pass was the perfect <w>setup</w> for the winning goal.",
                            "target_lang_translations": {
                                "ru": "Его пас стал идеальной <w>подготовкой</w> для победного гола.",
                                "zh": "他的传球为制胜一球做了完美的<w>铺垫</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "perfect setup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение или действие в спорте или борьбе, предназначенное для создания возможности для последующей атаки или гола.",
                        "zh": "体育或格斗中旨在为后续攻击或得分创造机会的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подготовка",
                                "target_lang_sense_clarification": "действия, предваряющие решающий удар или гол"
                            },
                            {
                                "target_lang_word": "комбинация",
                                "target_lang_sense_clarification": "серия приемов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铺垫",
                                "target_lang_sense_clarification": "为后续动作创造条件的准备动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c35ad78-09d3-33da-be1e-d8e35e2e8f1c",
                    "sense_definition": "The rise in water level at the downwind shore caused by persistent wind pushing the water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a strong wind <w>setup</w> at the south end of the lake after the storm.",
                            "target_lang_translations": {
                                "ru": "После шторма на южном конце озера наблюдался сильный ветровой <w>нагон</w>.",
                                "zh": "暴风雨过后，湖的南端出现了强烈的风力<w>增水</w>。"
                            }
                        },
                        {
                            "text": "Coastal flooding was exacerbated by the storm <w>setup</w> pushing water inland.",
                            "target_lang_translations": {
                                "ru": "Прибрежное наводнение усугубилось штормовым <w>нагоном</w>, толкающим воду вглубь суши.",
                                "zh": "风暴引起的<w>增水</w>将海水推向内陆，加剧了沿海地区的洪水。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wind setup",
                        "storm setup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повышение уровня воды у подветренного берега, вызванное устойчивым ветром, гонящим воду.",
                        "zh": "由持续风力推动水流导致背风岸水位上升的现象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагон",
                                "target_lang_sense_clarification": "гидрол. повышение уровня воды под действием ветра"
                            },
                            {
                                "target_lang_word": "нагон воды",
                                "target_lang_sense_clarification": "полный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "风暴潮",
                                "target_lang_sense_clarification": "风力引起的水位异常升高"
                            },
                            {
                                "target_lang_word": "增水",
                                "target_lang_sense_clarification": "水位因风力而上升"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}