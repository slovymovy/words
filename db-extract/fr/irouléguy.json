                "senses": [
                    {
                        "sense_id": "f058ff01-5168-3206-87d6-5d817c8840e8",
                        "entry_id": "4227e5d2-6f74-34da-8d49-b0c135175815",
                        "glosses": [
                            "Vin produit dans un vignoble du Pays basque français classé AOC (depuis 1970)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ca3e0f5-214b-4afe-b2a3-b6e122b31c1a",
                                "sense_id": "f058ff01-5168-3206-87d6-5d817c8840e8",
                                "text": "Les irouléguys rouges et rosés sont élaborés à base de tannat, cabernet franc et cabernet sauvignon, les blancs sont issus de courbu blanc, petit courbu B, petit manseng et gros manseng."
                            },
                            {
                                "example_id": "0caffb96-64be-40db-b354-6efd626b22b2",
                                "sense_id": "f058ff01-5168-3206-87d6-5d817c8840e8",
                                "text": "Un irouléguy rosé ou rouge rebondit comme une balle de pelote, en accord régionaliste ; le madiran et beaucoup de rouges assez fermes fraternisent virilement avec le plat."
                            },
                            {
                                "example_id": "d0498f7d-a2c5-482c-9462-e03379bb5857",
                                "sense_id": "f058ff01-5168-3206-87d6-5d817c8840e8",
                                "text": "Tous les vins, fruits de la vigne et du travail des hommes – irouléguy, rioja, buzet, madiran – sont dans Hautacam, prêts à réchauffer nos balèzes gosiers."
                            }
                        ]
                    }
                ],
