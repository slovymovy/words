                                "sense_id": "bf2d8556-d6cb-31da-8473-d3d77256e41a",
                                "text": "Maagdelijk ijskristal werd grauwe prut.",
                                "translation": "Virgin ice crystals turned into drab slush.",
                                "english": "Virgin ice crystals turned into drab slush."
                            }
                        ]
