                                        "entry_id": "cb1edc98-fe13-382a-b376-9b6434dfd055",
                                        "glosses": [
                                            "To ask progressively harder and ultimately unanswerable questions of a resident or medical student (said of a senior member of the medical staff)."
                                        ],
                                        "tags": [
