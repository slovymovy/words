                        "glosses": [
                            "Enveloppé dans quelque chose que l'on a tortillé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a34ce922-f66a-42f9-b539-9dd3b1276c7a",
                                "sense_id": "a83da1cc-e84b-3128-b51d-7450d9de7167",
                                "text": "Nous n’avions pas froid, parce que nous arrivions de France ; mais les Arabes qui passaient étaient entortillés dans leurs manteaux et tremblaient."
                            }
                        ]
                    },
                    {
                        "sense_id": "db05fa3f-ef5c-3301-8898-b1406d033133",
                        "entry_id": "67f0cfad-f178-3ab4-a4a8-b138d43da4f3",
                        "glosses": [
