    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "09f73f10-b09f-3823-8027-29aa94597a1f",
                "word": "axion",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e2cddf8a-e55b-467e-b0ff-4b51cf7eb2fe",
                        "entry_id": "09f73f10-b09f-3823-8027-29aa94597a1f",
                        "tags": [
                            "plural"
                        ],
                        "form": "axions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a88ce709-95f8-3952-ad7f-a2d4657d10ea",
                        "entry_id": "09f73f10-b09f-3823-8027-29aa94597a1f",
                        "glosses": [
                            "A hypothetical subatomic particle postulated to resolve certain symmetry problems concerning the strong nuclear force."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23f0eba4-fd52-4e9e-b6f9-6fb6dba45578",
                                "sense_id": "a88ce709-95f8-3952-ad7f-a2d4657d10ea",
                                "text": "2000 Summer/Fall, John Clarke, Superconductivity: A Macroscopic Quantum Phenomenon, Rene Donaldson, Bill Kirk (editors), Beam Line, Volume 30, Number 2, Stanford Linear Accelerator Center, page 47,\nThe axion is a candidate particle for the cold dark matter that constitutes a large fraction of the mass of the Universe."
                            },
                            {
                                "example_id": "c7fc86bb-2a1c-48c0-a803-ffd101b0954b",
                                "sense_id": "a88ce709-95f8-3952-ad7f-a2d4657d10ea",
                                "text": "In summary, the first version of gravity-mediated supersymmetry breaking has the advantage of giving an axion mass that is within cosmological bounds, while the second version has the advantage of giving the gauginos masses that are comparable to the masses of the squarks and sleptons."
                            },
                            {
                                "example_id": "feef0a7e-a1cd-4979-91bc-d89c59da0b7e",
                                "sense_id": "a88ce709-95f8-3952-ad7f-a2d4657d10ea",
                                "text": "Let us begin with a disclaimer: axions, a, have been conjectured to exist on theoretical grounds, but have not as yet been observed. They are supposed to be very light particles that interact very weakly with matter."
                            },
                            {
                                "example_id": "b1ee9f70-d8ef-40f0-b804-c668d0d8d5e3",
                                "sense_id": "a88ce709-95f8-3952-ad7f-a2d4657d10ea",
                                "text": "Theoretical considerations appear to indicate that the axion mass should be somewhere between the microelectron volt and millielectron volt range."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f21c77b1-0ce2-4bc8-ad1e-2c8a52c4d7e7",
                        "source_entry_id": "09f73f10-b09f-3823-8027-29aa94597a1f",
                        "source_sense_id": "a88ce709-95f8-3952-ad7f-a2d4657d10ea",
                        "source_sense_description": "hypothetical subatomic particle",
                        "target_lang_word": "axion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "axion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9854489a-5db9-3067-80da-681de84deea0",
                                        "entry_id": "6f121c5a-b44b-3541-91c7-75f68dc82801",
                                        "glosses": [
                                            "Particule théorique stable, neutre et de très faible masse (1 microélectron-volt), et qui serait la particule à la base de la matière noire."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51b16392-9002-4929-82a5-d57a23de5b54",
                                                "sense_id": "9854489a-5db9-3067-80da-681de84deea0",
                                                "text": "D’autres particules, beaucoup plus légères comme les axions, ou beaucoup plus lourdes, telles les hypothétiques wimpzillas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4df2c793-8a3d-4016-b26a-8e6e06391d72",
                        "source_entry_id": "09f73f10-b09f-3823-8027-29aa94597a1f",
