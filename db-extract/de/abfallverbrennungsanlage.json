                                "example_id": "c14c2a99-d4a0-4dd4-9cd3-ec4f36c71439",
                                "sense_id": "181808f7-7807-3533-9fee-9f0178b6caea",
                                "text": "„Wegen des Widerstands in der Bevölkerung gegen neue Deponien und Abfallverbrennungsanlagen drohte Ende der 1980er Jahre ein Entsorgungsengpass.“"
                            },
                            {
                                "example_id": "6e5c6a1e-f32b-43c4-b527-d240a8680f23",
                                "sense_id": "181808f7-7807-3533-9fee-9f0178b6caea",
                                "text": "„Trotz aller Bemühungen, Quecksilber in Abfällen zu vermeiden, war die Einhaltung der Grenzwerte in Abfallverbrennungsanlagen bislang ein kaum zu lösendes Problem.“"
                            }
                        ],
