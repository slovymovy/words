                "senses": [
                    {
                        "sense_id": "b31333f0-c5cd-3433-901d-9f885f45fb69",
                        "entry_id": "3a67302c-53f8-3025-b8df-3cdf67e05e70",
                        "glosses": [
                            "Envelopper quelque chose qui a déjà été emballé ou mis sous enveloppe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aa9970f-c6e3-4a0f-b17e-36da8016bf87",
                                "sense_id": "b31333f0-c5cd-3433-901d-9f885f45fb69",
                                "text": "Cette nouvelle machine universelle, de fabrication française permet de banderoler ou de surenvelopper automatiquement, sous pellicule cellulosique thermosoudable, tous conditionnements de forme rectangulaire ou approchante"
                            },
                            {
                                "example_id": "33952fc4-5d5e-4b22-9890-b5f85142aa0a",
                                "sense_id": "b31333f0-c5cd-3433-901d-9f885f45fb69",
                                "text": "Machines à monter les emballages, à former les caisses-carton, à surenvelopper sous carton ondulé."
                            },
                            {
                                "example_id": "50972113-9730-45f6-8f0b-6327ee622c84",
                                "sense_id": "b31333f0-c5cd-3433-901d-9f885f45fb69",
                                "text": "Dans le domaine de la confiserie, la machine 770 à envelopper des bonbons unitaires de forme carrée ou rectangulaire, à les grouper et à les surenvelopper en un stick unitaire de 6, 8 ou 10 bonbons."
                            }
                        ]
                    }
