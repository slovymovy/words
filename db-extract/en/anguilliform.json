                    },
                    {
                        "translation_id": "970334d4-b8ed-48fe-a9b6-2ef784491516",
                        "source_entry_id": "8ab62366-3743-33ba-9109-889491d615c6",
                        "source_sense_description": "shaped like an eel",
                        "target_lang_word": "aalförmig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aalförmig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e75e4a93-41be-32a6-8e1f-3d6bd2d971ba",
                                        "entry_id": "c350b6b4-3824-359f-800e-48ea1c2a3066",
                                        "glosses": [
                                            "in der Form eines Aals"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ce32ff6-4edd-4aa4-aa32-bd1ef1f7f417",
                                                "sense_id": "e75e4a93-41be-32a6-8e1f-3d6bd2d971ba",
                                                "text": "Manchmal steigt ein fremdartiges Wesen aus der Unterwelt auf: die Haut hell wie die eines Nordeuropäers, aalförmig mit vier Füßchen."
                                            },
                                            {
                                                "example_id": "39c98994-6fda-4bef-ae9d-15bcb5288e81",
                                                "sense_id": "e75e4a93-41be-32a6-8e1f-3d6bd2d971ba",
                                                "text": "„Armmolche haben einen aalförmig gestreckten, unscheinbar gefärbten, schleimig-glatten Körper mit einem kurzen Schwanz und reduziertem Knochenbau.“"
                                            },
                                            {
                                                "example_id": "308dc3ef-e110-473d-834e-7c47432ee9a5",
                                                "sense_id": "e75e4a93-41be-32a6-8e1f-3d6bd2d971ba",
                                                "text": "„Ein aalförmig Thierchen (Wasseraal) (g) läst sich ebenfalls zerstükken, ohne die Bewegung zu verlieren, wie man auch, nach des berümten Abraham Trembley Versuchen, von dem Polipus dieses überall eingesteht.“"
                                            },
                                            {
                                                "example_id": "ef1450f3-b9fb-44ee-9fa8-338aa0772ffd",
                                                "sense_id": "e75e4a93-41be-32a6-8e1f-3d6bd2d971ba",
                                                "text": "„Der Körper ist meist noch quappenartig, zuweilen aber lang gestreckt, abgerundet, aalförmig.“"
                                            },
                                            {
                                                "example_id": "36f4200f-7ef6-41a7-b5bf-1f5f5af3da7d",
                                                "sense_id": "e75e4a93-41be-32a6-8e1f-3d6bd2d971ba",
                                                "text": "„ Die Rüsselfische, Mastacemblus (eigentlich Mastac-embolus, Oberlippenschnabel) sind langgestreckte, fast aalförmige Fische, schleimig, mit sehr kleinen Schuppen, mit vielen freien Stacheln vor der niedrigen Rückenflosse und mit verhältnissmässig kleinem Kopf, dessen Oberlippe in einem weichen beweglichen Rüssel verlängert ist; ihre Färbung ist trüb braun oder grünlich, öfters mit einer bestimmten Zeichnung, Längsstreifen oder rundlichen Flecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
