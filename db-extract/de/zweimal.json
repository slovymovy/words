                "forms": [],
                "senses": [
                    {
                        "sense_id": "d912a0dc-c607-3198-9c27-4105251f0da0",
                        "entry_id": "016e6585-6eed-3131-8f3d-9684b398cc97",
                        "glosses": [
                            "Anzeige des Wiederholungsfaktors zwei; zweifach vorgekommen, durchgeführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61471c1a-6b06-463f-87ff-3efe97eea416",
                                "sense_id": "d912a0dc-c607-3198-9c27-4105251f0da0",
                                "text": "Ich habe jetzt schon zweimal vergeblich versucht, ihn zu erreichen."
                            },
                            {
                                "example_id": "8b28d490-d65e-4c9f-bd67-9d27940a1748",
                                "sense_id": "d912a0dc-c607-3198-9c27-4105251f0da0",
                                "text": "„Nur zweimal schaffte es die Sportstudentin nicht unter die besten Zehn.“"
                            },
                            {
                                "example_id": "7d38f461-68d4-4aa1-8d88-8759fc0eee35",
                                "sense_id": "d912a0dc-c607-3198-9c27-4105251f0da0",
                                "text": "„Franklin D. Roosevelt ist bis heute der einzige US-Präsident, der mehr als zweimal ins Weiße Haus gewählt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dba6cab8-08f9-4b6a-bf23-c8960002b2cd",
                        "source_entry_id": "016e6585-6eed-3131-8f3d-9684b398cc97",
                        "source_sense_id": "d912a0dc-c607-3198-9c27-4105251f0da0",
                        "source_sense_description": "Anzeige des Wiederholungsfaktors zwei; zweifach vorgekommen, durchgeführt",
                        "target_lang_word": "twice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d26237e-f102-3731-a282-5c49643b5ff1",
                                        "entry_id": "ff79fc4a-39fa-327e-9ebe-d1872e6e6af6",
                                        "glosses": [
                                            "Two times."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8da657b-121f-4dd9-934f-3f1de9d7ac22",
                                                "sense_id": "9d26237e-f102-3731-a282-5c49643b5ff1",
                                                "text": "You should brush your teeth twice a day."
                                            },
                                            {
                                                "example_id": "5095da03-4ccf-4c51-9ba6-669c7d8441a1",
                                                "sense_id": "9d26237e-f102-3731-a282-5c49643b5ff1",
                                                "text": "No person shall be elected to the office of the President more than twice, and no person who has held the office of President, or acted as President, for more than two years of a term to which some other person was elected President shall be elected to the office of the President more than once. (1947, Twenty-second Amendment to the United States Constitution, Section 1)"
                                            },
                                            {
                                                "example_id": "320c8ddc-3c1c-4975-a691-04b0f3e8f1ea",
                                                "sense_id": "9d26237e-f102-3731-a282-5c49643b5ff1",
                                                "text": "I've done with my tirade. The world was gone; / The twice two thousand, for whom earth was made, / Were vanish'd to be what they call alone"
                                            },
                                            {
                                                "example_id": "ca76f65d-4e2b-40df-8e88-24a90c2a2ec2",
                                                "sense_id": "9d26237e-f102-3731-a282-5c49643b5ff1",
                                                "text": "He could not be induced to remain permanently at Mohair because Miss Trevor was at Asquith, but he appropriated a Hempstead cart from the Mohair stables and made the trip sometimes twice in a day."
                                            },
                                            {
                                                "example_id": "13cc5844-7299-4d35-88ed-4107e248f6ec",
                                                "sense_id": "9d26237e-f102-3731-a282-5c49643b5ff1",
                                                "text": "Santa Claus is coming to town / He’s making a list, / And checking it twice, / He’s gonna find out who’s naughty or nice / Santa Claus is coming to town"
                                            },
                                            {
                                                "example_id": "7ec1ecf3-e932-4b6b-9266-e37eb5a02c8f",
                                                "sense_id": "9d26237e-f102-3731-a282-5c49643b5ff1",
                                                "text": "Malay is the lingua franca of several Southeast Asia countries and has been simplified by its use as a second language by non-native speakers.\nFor example, the Malay plural is formed by repeating a word twice – buku means book and buku-buku means books."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e567abf-dd3a-314c-a1c0-9ed7126434c7",
                                        "entry_id": "ff79fc4a-39fa-327e-9ebe-d1872e6e6af6",
                                        "glosses": [
                                            "Doubled in quantity, intensity, or degree."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d984408-2085-42fa-bc51-9df804220772",
                                                "sense_id": "2e567abf-dd3a-314c-a1c0-9ed7126434c7",
                                                "text": "Thus it appears that if the machine is turning twice as slow as before, there is more than twice the former quantity in the rising buckets; and more will be raised in a minute by the same expenditure of power."
                                            },
                                            {
                                                "example_id": "f7814a46-dcf2-4284-a563-8d7a4ff21807",
                                                "sense_id": "2e567abf-dd3a-314c-a1c0-9ed7126434c7",
                                                "text": "You can't get anything thinner than a spring shad, unless you take a couple of them, when, of course, they will be twice as thin."
                                            },
                                            {
                                                "example_id": "81c69797-9fe2-4235-a5a0-a03a1de1d413",
                                                "sense_id": "2e567abf-dd3a-314c-a1c0-9ed7126434c7",
                                                "text": "MARY: As you go from left to right, each example has twice as many twos; from right to left, twice as few."
                                            },
                                            {
                                                "example_id": "22d26cde-b0b8-43ff-a9c5-c5da29e99b00",
                                                "sense_id": "2e567abf-dd3a-314c-a1c0-9ed7126434c7",
                                                "text": "This was eventually absorbed in the enlarged Victoria Station which was brought into use at the end of March, 1884, providing twice as much platform accommodation as the old one."
                                            },
                                            {
                                                "example_id": "c6973a05-e8c7-4add-812b-63bb57ea39c1",
                                                "sense_id": "2e567abf-dd3a-314c-a1c0-9ed7126434c7",
                                                "text": "Both men and women with higher qualifications were twice as less likely to be unemployed than their less qualified counterparts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
