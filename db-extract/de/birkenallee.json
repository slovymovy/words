                "senses": [
                    {
                        "sense_id": "2172e164-cb7b-3e2b-a980-5d3767c7ae9c",
                        "entry_id": "372e5d6e-dc9f-3238-9ffd-87d9690e9cfb",
                        "glosses": [
                            "auf beiden Seiten von Birken begrenzte Straße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd2c5073-4759-4b07-8c68-d9776a277a40",
                                "sense_id": "2172e164-cb7b-3e2b-a980-5d3767c7ae9c",
                                "text": "„Wir wandern durch eine Birkenallee, die im ersten Sommergrün prangt.“"
                            },
                            {
                                "example_id": "62050944-a2a9-4623-b19f-b55efa54d88d",
                                "sense_id": "2172e164-cb7b-3e2b-a980-5d3767c7ae9c",
                                "text": "„Eine Birkenallee führte zu der verborgenen Villa.“"
                            },
                            {
                                "example_id": "a59b2f28-2eb5-49b7-8d68-e2b970274521",
                                "sense_id": "2172e164-cb7b-3e2b-a980-5d3767c7ae9c",
                                "text": "„Es war eine Birkenallee, die sich von dem Häuschen bis zum nahen nachbarlichen Dorf hinzog und in jedem Wetter und jeder Jahreszeit Schauspiel genug war.“"
                            },
                            {
                                "example_id": "0e7f7295-8ddd-4899-8bca-295c5534388b",
                                "sense_id": "2172e164-cb7b-3e2b-a980-5d3767c7ae9c",
                                "text": "„Graeber fand im Garten hinter der Birkenallee einen kleinen, halb erhaltenen Pavillon, von dem aus er den Stall übersehen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
