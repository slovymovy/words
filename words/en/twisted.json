            "senses": [
                {
                    "sense_id": "135811c6-98ba-3d15-a8fa-ee26c977ee3a",
                    "sense_definition": "Simple past and past participle of <w>twist</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>twisted</w> the cap off the bottle and took a long drink.",
                            "target_lang_translations": {
                                "ru": "Она <w>открутила</w> крышку с бутылки и сделала большой глоток.",
                                "fr": "Elle a <w>tordu</w> le bouchon pour l'enlever de la bouteille et a pris une longue gorgée.",
                                "tr": "Şişenin kapağını <w>çevirerek açtı</w> ve uzun bir yudum aldı."
                            }
                        },
                        {
                            "text": "He <w>twisted</w> his ankle while playing football in the park.",
                            "target_lang_translations": {
                                "ru": "Он <w>подвернул</w> лодыжку, когда играл в футбол в парке.",
                                "fr": "Il s'est <w>tordu</w> la cheville en jouant au football dans le parc.",
                                "tr": "Parkta futbol oynarken ayak bileğini <w>burktu</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола <w>twist</w>.",
                        "fr": "Participe passé ou forme conjuguée du verbe tordre.",
                        "tr": "<w>twist</w> fiilinin geçmiş zaman ve geçmiş zaman sıfat-fiil hali."
                    },
