                        "sense_id": "0b996aa3-1f56-3dd2-a316-e17ee02b653e",
                        "entry_id": "2aec7623-cadb-3e46-9052-f4800d2cd74e",
                        "glosses": [
                            "das Vorhandensein von zwei (meist gegensätzlichen) Sachen, Sachverhalt mit zwei verschiedenen Blickwinkeln; wechselseitige Zuordnung"
                        ],
                        "tags": [
                            "formal",
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "e36b7383-6f24-4f66-9458-bc9748bb6c91",
                                "sense_id": "0b996aa3-1f56-3dd2-a316-e17ee02b653e",
                                "text": "„So schuf er in der Dualität Licht und Liebe, denen Grenzen wurden auferlegt durch die menschlichen Gesetze, fern von Gott waren geprägt: Menschliche Liebe, Liebe begrenzt zu Wenigen nur, Liebe zu Idolen, hohlen Formen nur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "35de6a0c-8d0c-3536-a1c8-f8fff825a3d5",
                        "entry_id": "2aec7623-cadb-3e46-9052-f4800d2cd74e",
                        "glosses": [
                            "Eigenschaft, dass es zu einem Objekt ein weiteres dual ist"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "060c9688-815d-3bf5-b073-ecba0003e721",
                        "entry_id": "2aec7623-cadb-3e46-9052-f4800d2cd74e",
                        "glosses": [
                            "Eigenschaft, dass die Ecken, Kanten und Flächen zweier Polytope reziprok zueinander sind"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "055ebb36-17c8-417e-94d3-b8fdc1a5f400",
                                "sense_id": "060c9688-815d-3bf5-b073-ecba0003e721",
                                "text": "Jeder platonische Körper besitzt Dualität zu einem weiteren platonischen Körper."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
