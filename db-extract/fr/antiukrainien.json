                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cc34791-3cfa-412f-b356-d442e4720a7a",
                                "sense_id": "2b8678cb-62b2-3300-b0b8-a9bb4d012b9b",
                                "text": "Le site Internet de 20 Minutes a été cloné par des hackeurs afin de diffuser de la propagande prorusse et antiukrainienne, en faisant passer cela pour de l’information."
                            },
                            {
                                "example_id": "120238d0-ec55-44ea-9943-ed9b9d5a771b",
                                "sense_id": "2b8678cb-62b2-3300-b0b8-a9bb4d012b9b",
                                "text": "Par ailleurs, il n’omit pas de faire état des opinions défavorables des personnalités non ukrainiennes, apportant du même coup, sans le vouloir, l’explication quant aux origines des mythes antiukrainiens."
                            },
                            {
                                "example_id": "954f467c-3b25-4640-acd5-b9a36a71b7f2",
                                "sense_id": "2b8678cb-62b2-3300-b0b8-a9bb4d012b9b",
                                "text": "C’est pourquoi j’ai dit que le marché en Ukraine a des tendances antiukrainiennes, l’éditeur pensant, bien sûr, aux tirages."
                            }
                        ]
