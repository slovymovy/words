                "senses": [
                    {
                        "sense_id": "8496e813-acef-302a-8161-8468c7d23362",
                        "entry_id": "eab6952f-6d12-3e99-8148-ec60c98022fb",
                        "glosses": [
                            "mieszkaniec Bolonii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5a7a881-4cda-4a80-9d33-b78adb9539d8",
                                "sense_id": "8496e813-acef-302a-8161-8468c7d23362",
                                "text": "Ignazio jest bolończykiem."
                            },
                            {
                                "example_id": "ddd47883-6e54-4a0e-8a48-0f229dc57e0d",
                                "sense_id": "8496e813-acef-302a-8161-8468c7d23362",
                                "text": "Wkraczających żołnierzy polskich witały tłumy bolończyków"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d1e691a1-f9a3-3fcd-9af0-8a8a23170156",
                        "entry_id": "eab6952f-6d12-3e99-8148-ec60c98022fb",
                        "glosses": [
                            "absolwent, student albo profesor uniwersytetu w Bolonii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81ce3df4-37ec-4c66-af8f-c9ab4a42b4ee",
                                "sense_id": "d1e691a1-f9a3-3fcd-9af0-8a8a23170156",
                                "text": "Wystąpienie uczonych bolońskich było reakcją na palenie pism Wiklifa w Oksfordzie i Pradze. Bolończycy chociaż przyznawali, że niektóre poglądy Wiklifa są błędne, to jednak opowiadali się przeciwko paleniu jego pism"
                            },
                            {
                                "example_id": "acede6f6-72df-478a-9cb6-292f6657f2fc",
                                "sense_id": "d1e691a1-f9a3-3fcd-9af0-8a8a23170156",
                                "text": "Wśród wybitnych „bolończyków” tych czasów spotykamy znakomitego polskiego prawnika XV w. – Jana Ostroroga"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
