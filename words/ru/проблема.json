                },
                {
                    "sense_id": "d57a9063-c04e-30e8-9b84-288ca980196f",
                    "sense_definition": "Сложный теоретический или практический вопрос, требующий изучения и разрешения.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учёные всего мира обсуждают глобальную <w>проблему</w> изменения климата.",
                            "target_lang_translations": {
                                "en": "Scientists worldwide are discussing the global <w>problem</w> of climate change.",
                                "zh": "全世界的科学家都在讨论气候变化的全球性<w>问题</w>。"
                            }
                        },
                        {
                            "text": "Эта социальная <w>проблема</w> требует внимательного анализа и государственных мер.",
                            "target_lang_translations": {
                                "en": "This social <w>problem</w> requires careful analysis and government measures.",
                                "zh": "这个社会<w>问题</w>需要深入分析并采取政府措施。"
                            }
                        }
                    ],
                    "synonyms": [
                        "вопро́с",
                        "зада́ча"
                    ],
                    "common_phrases": [
                        "экологическая проблема",
                        "актуальная проблема",
                        "постановка проблемы",
                        "корень проблемы"
                    ],
                    "target_lang_definitions": {
                        "en": "A complex theoretical or practical question requiring study and resolution.",
                        "zh": "指需要研究和解决的复杂理论或实践课题。"
                    },
