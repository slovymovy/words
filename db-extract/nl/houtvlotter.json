                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "a81dc246-6d58-4048-9676-3af3e80bfcbb",
                                "sense_id": "998e6b2d-7683-3bb2-9524-be6044d97e13",
                                "text": "Niet dat zijn ambities nu zo ver reiken: hij wil de beste houtvlotter worden: een man die op de samengebonden boomstammen stroomafwaarts vaart, om de koopwaar daar bij de handelspartners af te leveren."
                            },
                            {
                                "example_id": "14d73c9d-db39-4451-aab3-9c770a1d2f77",
                                "sense_id": "998e6b2d-7683-3bb2-9524-be6044d97e13",
                                "text": "Rond Tilburg fotografeerde hij boeren op het land, moeders in de weer in boerenkeukens, wevers en likeurstokers in de fabriek. In Rotterdam waren het lantaarnschoonmakers, houtvlotters, bouwvakkers en dienstbodes."
                            }
                        ]
                    }
