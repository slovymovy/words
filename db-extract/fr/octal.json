                "senses": [
                    {
                        "sense_id": "e5b5a742-7ed4-3fba-aec6-7f753d5f76b7",
                        "entry_id": "04405439-504a-343e-9509-90c9df1d2d13",
                        "glosses": [
                            "Exprimé dans la base numérique huit (qui utilise les chiffres de 0 à 7) → voir octet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea83bc19-1f2d-43aa-9207-6766d8e8a51a",
                                "sense_id": "e5b5a742-7ed4-3fba-aec6-7f753d5f76b7",
                                "text": "Un chiffre octal permet de représenter trois bits en un seul caractère."
                            },
                            {
                                "example_id": "6cce8575-ee80-4f92-a4b3-0d6cd3cd41e9",
                                "sense_id": "e5b5a742-7ed4-3fba-aec6-7f753d5f76b7",
                                "text": "La représentation octale des nombres a longtemps été utilisée lorsque la longueur des mots des ordinateurs était multiple de trois."
                            },
                            {
                                "example_id": "05e26b63-509d-41b7-9f04-0ea3024108d4",
                                "sense_id": "e5b5a742-7ed4-3fba-aec6-7f753d5f76b7",
                                "text": "L'utilitaire qui permet d'afficher des données sous la forme la plus brute possible s'appelle toujours oct, d’après les trois premières lettres de octal, alors que, grâce à l'option -x, l'affichage s'effectue la plupart du temps en hexadécimal."
                            }
                        ]
                    }
