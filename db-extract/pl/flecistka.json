                    {
                        "translation_id": "dc51d3e6-0fb2-4675-b1c3-80a246c94c89",
                        "source_entry_id": "5344acad-3f5d-31e1-896d-3da350ebf281",
                        "source_sense_id": "9adf8adf-97bf-3368-82a6-a82f1b080b11",
                        "target_lang_word": "Flötenspielerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flötenspielerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c08f324-aa5b-3222-8ede-07bb35d76261",
                                        "entry_id": "b93d9fa6-404f-37a1-bf22-7bec87686feb",
                                        "glosses": [
                                            "weibliche Person, die (professionell) Flöte spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a752959-f96e-4ab7-821f-90ab48b791cb",
                                                "sense_id": "0c08f324-aa5b-3222-8ede-07bb35d76261",
                                                "text": "„Da meine Patientin eine begeisterte Flötenspielerin ist, hatte ich über einen Konzertbesuch nachgedacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44604c98-69aa-45be-a99a-46634fedfa5c",
                        "source_entry_id": "5344acad-3f5d-31e1-896d-3da350ebf281",
                        "source_sense_id": "9adf8adf-97bf-3368-82a6-a82f1b080b11",
                        "target_lang_word": "флейтистка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "флейтистка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "73ff34ed-1552-3040-a570-4b60e282f1e4",
                                        "entry_id": "39236670-4c8b-3dc6-a7a8-4c8bdfc91ed5",
                                        "glosses": [
                                            "муз. женск. к флейтист"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4ad5147-5e35-4f57-8fb9-f08b2a396a02",
                                                "sense_id": "73ff34ed-1552-3040-a570-4b60e282f1e4",
                                                "text": "Сонника сделала знак своему управителю, и спустя некоторое время .. раздались звуки флейт. // — Флейтистки! — воскликнули гости. // И в зал празднества вошли четыре стройные девочки .. Во рту они держали двойную флейту, по отверстиям которой перебегали их ловкие пальцы."
                                            },
                                            {
                                                "example_id": "0825f207-ee2a-4a3c-b215-0038c00d11b7",
                                                "sense_id": "73ff34ed-1552-3040-a570-4b60e282f1e4",
                                                "text": "Какая досада знать, что никогда не услышишь этой мелодии, которую наигрывают на двойных флейтах эти очаровательные флейтистки и под которую так изящно танцуют."
                                            },
                                            {
                                                "example_id": "4092d588-c4f4-48a3-b64a-de4d673d2ba7",
                                                "sense_id": "73ff34ed-1552-3040-a570-4b60e282f1e4",
                                                "text": "За много лет не прослушал по радио и телевидению столько серьёзной музыки, сколько вчера за один день. Особенно поразил Глюк: для флейты с оркестром — как играла какая-то неизвестная мне молодая флейтистка!"
                                            },
                                            {
                                                "example_id": "35104f89-7722-46e9-9ca7-b18c6c37086e",
                                                "sense_id": "73ff34ed-1552-3040-a570-4b60e282f1e4",
                                                "text": "Он выступил вместе со своей супругой — пианисткой Викторией Постниковой .., с сыном-скрипачом Александром, .. квартетом им. Шостаковича .., флейтисткой Марией Волковой (Соната для флейты и фортепиано) и сопрано Виталией Блинструбите (Австрия) .."
                                            },
                                            {
                                                "example_id": "629a171d-9458-4d53-9334-c7eba9c6222c",
                                                "sense_id": "73ff34ed-1552-3040-a570-4b60e282f1e4",
                                                "text": "Нарядные гости восседают парами .. и наслаждаются жизнью. Для них поют, отбивая ладонями такт, прекрасные вокалистки, играет флейтистка, танцуют юные нагие танцовщицы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
