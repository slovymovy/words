                                                "sense_id": "fc1b4591-1cd5-3ed6-88ac-cd8c7c87667e",
                                                "text": "The landscapers rolled sod onto the bare earth and made a presentable lawn by nightfall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7661db43-6ac8-3759-ab56-66234f17bcac",
                                        "entry_id": "8016e94a-57f0-3c60-8d5a-91e9a6fff4c3",
