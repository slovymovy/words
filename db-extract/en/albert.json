                                "target_senses": [
                                    {
                                        "sense_id": "81eb37a2-07d0-3b0e-b432-cd55a66dcbc4",
                                        "entry_id": "50c44e53-4b1c-3167-b59b-a9bdb8f4d15f",
                                        "glosses": [
                                            "jongensnaam"
                                        ],
                                        "tags": [
