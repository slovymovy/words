                        "translation_id": "bacb623b-9240-4105-bc4e-54ffec29b4b6",
                        "source_entry_id": "cc9589a3-9ad9-3fb4-8e6e-cba7a5e2151c",
                        "source_sense_id": "cee6ae3a-acac-34f8-b2b5-8f11df33e0d3",
