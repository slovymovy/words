                        "glosses": [
                            "Personne chargée du rôle de conseil technique au niveau national, dans une fédération sportive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7bf2170-87b1-4968-b972-09ef5b044b47",
                                "sense_id": "6d06f614-c679-3615-9a35-028cbf880c18",
                                "text": "On est plutôt passés du bon côté que du mauvais, estime Robin Pla, le Conseiller technique national (CTN) chargé de l’accompagnement technique scientifique de l’équipe de France."
                            },
                            {
                                "example_id": "90f06800-5a9f-4f48-8053-d03e0993ae38",
                                "sense_id": "6d06f614-c679-3615-9a35-028cbf880c18",
                                "text": "À ce moment-là, on m’a proposé de devenir exclusivement conseillère technique nationale (CTN) auprès de la discipline du para-dressage."
                            },
                            {
                                "example_id": "fd0f1bf3-3f4a-4c97-a5a2-e051155e302f",
                                "sense_id": "6d06f614-c679-3615-9a35-028cbf880c18",
                                "text": "À la demande de la Ligue, le président de la Fédération a accepté de déléguer son CTN chez nous, mais aussi en Guadeloupe, pour faire le point sur les écoles de golf et nous aider dans notre mission de valorisation de la discipline."
                            }
                        ]
                    }
