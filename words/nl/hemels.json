                    "sense_definition": "afkomstig van de hemel of betrekking hebbend op de hemel of het heelal",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religieus_astronomisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De astronoom bestudeert verschillende <w>hemelse</w> verschijnselen zoals kometen en sterren.",
                            "target_lang_translations": {
                                "en": "The astronomer studies various <w>celestial</w> phenomena such as comets and stars.",
                                "fr": "L'astronome étudie divers phénomènes <w>célestes</w> tels que les comètes et les étoiles."
                            }
                        },
                        {
                            "text": "In veel religies wordt de <w>hemelse</w> sfeer als de woonplaats van goden beschouwd.",
                            "target_lang_translations": {
                                "en": "In many religions, the <w>heavenly</w> sphere is considered the dwelling place of gods.",
                                "fr": "Dans de nombreuses religions, la sphère <w>céleste</w> est considérée comme la demeure des dieux."
                            }
