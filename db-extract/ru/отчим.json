                    {
                        "translation_id": "f013311c-cb74-4fa6-a6d2-f0d322eadf19",
                        "source_entry_id": "bb94a706-f10e-369d-8167-8c826c8eb8bc",
                        "source_sense_id": "c69f9d48-4b98-35bf-9f43-96734ed3add3",
                        "target_lang_word": "stepfather",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stepfather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "feda8f23-ba3c-3d41-bfca-5ed2dd672a28",
                                        "entry_id": "2f6bbf37-609a-3329-930a-717771739709",
                                        "glosses": [
                                            "The husband of one's biological mother after her initial marriage to or relationship with one's biological father."
                                        ],
                                        "tags": [
                                            "in the narrow sense"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23bc5c3c-5ba8-4112-9538-46f72f1f6e61",
                                                "sense_id": "feda8f23-ba3c-3d41-bfca-5ed2dd672a28",
                                                "text": "My stepfather loved me as much as he loved his own three sons. I knew how much he wanted to help me and how lacking in financial resources he was. Nothing could erase the image I gained of my real father that day: a carefree, well-to-do man who didn't really give a damn about the hopes and dreams of his firstborn son."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a471b32-11e2-35c7-8e77-b47596d492ae",
                                        "entry_id": "2f6bbf37-609a-3329-930a-717771739709",
                                        "glosses": [
                                            "The husband of one's parent distinct from one's biological father or person with a similar relationship."
                                        ],
                                        "tags": [
                                            "in the broad sense"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bed003b8-a3a2-4127-97fc-1d8d93cd7f5e",
                                                "sense_id": "8a471b32-11e2-35c7-8e77-b47596d492ae",
                                                "text": "In suboptimal cases the gynaecologist takes sperm from anonymous donors. In this case the husband can only be stepfather of the child."
                                            },
                                            {
                                                "example_id": "dc58998e-5279-4f2e-80cd-cb18a8e7897c",
                                                "sense_id": "8a471b32-11e2-35c7-8e77-b47596d492ae",
                                                "text": "Telegony or Inheritance from the Stepfather\nThe earliest reference to telegony ( which has no connection with the son of Odysseus ) is supposed to be in 1665 but the classical case is that described in the Philosophical Transactions of[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
