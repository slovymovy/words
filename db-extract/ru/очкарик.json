                    },
                    {
                        "translation_id": "8e226a9c-7ab9-4572-82fa-89feeddecf69",
                        "source_entry_id": "e8ccab83-dc6f-30fa-874a-8b18ea6613b2",
                        "source_sense_id": "db5fee1e-4ed9-35ba-9787-e9a9e6f78ad0",
                        "target_lang_word": "Brillenschlange",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brillenschlange",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79859a08-f68f-3415-b0eb-db0e9e8f2303",
                                        "entry_id": "5979ff75-a3a2-3050-8295-f06f414e7b8c",
                                        "glosses": [
                                            "Schlange aus der biologischen Gattung der Echten Kobras mit auf der Rückseite des verbreiterten Nackens befindlicher charakteristischer Zeichnung, die dem Aussehen einer Brille ohne Bügel ähnelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae6bef99-2bea-4cc6-b4c3-581ac2adf498",
                                                "sense_id": "79859a08-f68f-3415-b0eb-db0e9e8f2303",
                                                "text": "„In Indien sterben heute noch über tausend Menschen im Jahr am Biss der Kobra oder Brillenschlange.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b6dfa3a5-1263-3f9d-9f68-1b0548941588",
                                        "entry_id": "5979ff75-a3a2-3050-8295-f06f414e7b8c",
                                        "glosses": [
                                            "jemand, der eine Brille trägt, zum Sehen auf diese angewiesen ist"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d96aadc9-4765-4dee-a001-da1aaf709291",
                                                "sense_id": "b6dfa3a5-1263-3f9d-9f68-1b0548941588",
                                                "text": "„Brillenschlange! Brillenschlange!, hänselten die Kinder in der Schule und zeigten mit den Fingern auf irgendein kluges Mädchen mit Brille.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
