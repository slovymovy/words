                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8359d5a0-1162-4548-9933-6a4c942271a5",
                        "source_entry_id": "9d9fdf6e-b835-3648-a896-04dc483781a6",
                        "source_sense_id": "f5de5b07-196b-3416-bcac-48ea75b11bcc",
                        "source_sense_description": "pagina waarop de titel van een boek gedrukt is",
                        "target_lang_word": "title-page",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "title-page",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb97b9b2-8f2e-3203-8a23-75c652efb4cd",
                                        "entry_id": "daeb313a-5b62-3f21-a676-b6555875a413",
                                        "glosses": [
                                            "Alternative form of title page."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a202334a-0a30-4b0c-8655-51028023c1ae",
                                                "sense_id": "eb97b9b2-8f2e-3203-8a23-75c652efb4cd",
                                                "text": "A bibliognoste, from the Greek, is one knowing in title-pages and colophons, and in editions; the place and year when printed; the presses whence issued; and all the minutiæ of a book."
                                            },
                                            {
                                                "example_id": "f7adcbfd-c49a-4608-8e33-73c6bea957d5",
                                                "sense_id": "eb97b9b2-8f2e-3203-8a23-75c652efb4cd",
                                                "text": "But besides this imperfect beginningless story, entitled \"William Montgomery,\" we find in the volume another, of which the title-page gives no hint."
                                            },
                                            {
                                                "example_id": "28832566-6c32-413d-95fd-be3d02a28b19",
                                                "sense_id": "eb97b9b2-8f2e-3203-8a23-75c652efb4cd",
                                                "text": "[…] at a great book sale in London, which had congregated all the Fancy, on a copy occurring, not one of the company but ourself knew what the mystical title-page meant."
                                            },
                                            {
                                                "example_id": "d89340f6-ef78-4c3c-8b60-877d0c8208f1",
                                                "sense_id": "eb97b9b2-8f2e-3203-8a23-75c652efb4cd",
                                                "text": "He had gone through the work from the title-page to the finis at least forty times, and had just commenced it over again."
                                            },
                                            {
                                                "example_id": "22d92fcc-fc17-412d-a251-cee652778f3d",
                                                "sense_id": "eb97b9b2-8f2e-3203-8a23-75c652efb4cd",
                                                "text": "This little story before us is an amplification of that clever enigma, and though essentially a story for children, as its title-page tells us, would beguile many a one much older of a half-hour in the evening."
                                            },
                                            {
                                                "example_id": "501de418-6dcf-4951-b91e-da173bff6f15",
                                                "sense_id": "eb97b9b2-8f2e-3203-8a23-75c652efb4cd",
                                                "text": "The first Cambridge edition of the Authorised Version was printed by him in 1629, a fine book with an elaborately engraved title-page."
                                            },
                                            {
                                                "example_id": "bf2b09d2-0fed-4a93-9d02-049b64efeb57",
                                                "sense_id": "eb97b9b2-8f2e-3203-8a23-75c652efb4cd",
                                                "text": "So many copies have come down to us in which the title-page of the preliminaries is miscancelled, indeed, that it is surprising that we know of only one in which the earlier title-page is bound as printed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
