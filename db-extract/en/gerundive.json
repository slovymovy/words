                    {
                        "translation_id": "dab77f72-73e4-494b-b3ab-2a4fa657d62e",
                        "source_entry_id": "91ea0676-aaf2-3d8e-a437-eca3a0f246d7",
                        "source_sense_description": "Latin verbal adjective that describes obligation or necessity",
                        "target_lang_word": "Gerundivum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gerundivum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9fb96af9-e308-37c4-9689-e1a6d175c072",
                                        "entry_id": "35bbfa6a-0ea6-3032-9278-5b5f5bfdaf01",
                                        "glosses": [
                                            "Linguistik/Sprachwissenschaft, Grammatik: Partizip I in passivischer Bedeutung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dc60802-1289-47a1-99c1-b9c003bb0e60",
                                                "sense_id": "9fb96af9-e308-37c4-9689-e1a6d175c072",
                                                "text": "Das Gerundivum gleicht sich zum Unterschied vom Gerundium in Numerus und Genus wie ein Adjektiv an das Substantiv an."
                                            },
                                            {
                                                "example_id": "78b4d2b0-4d0b-4ca6-9eda-a53f3aba9f3d",
                                                "sense_id": "9fb96af9-e308-37c4-9689-e1a6d175c072",
                                                "text": "In dem Satz „Er nahm das zu korrigierende Heft in die Hand“ ist „zu korrigierende“ ein Gerundivum."
                                            },
                                            {
                                                "example_id": "23e8fdcd-ff0f-419f-80a2-a517fcfe6efc",
                                                "sense_id": "9fb96af9-e308-37c4-9689-e1a6d175c072",
                                                "text": "„In anderen Sprachen und in früheren Sprachzuständen gibt es außerdem noch ein Gerundiv(um), das sogenannte Participium necessitatis (Partizip der Notwendigkeit; Angabe, daß das im Verb Ausgedrückte getan werden muß) und das Gerundium, ein zugehöriges Verbalsubstantiv.“"
                                            },
                                            {
                                                "example_id": "971cb083-c321-451e-bfe6-267d3d76dc50",
                                                "sense_id": "9fb96af9-e308-37c4-9689-e1a6d175c072",
                                                "text": "„Dieses gemeiniglich genannte Participium Futuri Passivi oder das Gerundivum enthält keine bestimmte Zeit, sondern zeigt nur an, daß etwas geschieht oder geschehen soll, und wenn es mit einem Substantive in einem der obliquen Casus verbunden ist, und also ein anderes Verbum das Hauptverbum ist, so liegt nur die Dauer darin, während welcher etwas geschieht, geschehen ist, oder geschehen wird, so daß alle Zeiten darin liegen[.] […] Dieses Verbaladjectiv oder Participium kommt eigentlich nur bey denjenigen Verben vor, welche einen Accusativ bey sich haben[.]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
