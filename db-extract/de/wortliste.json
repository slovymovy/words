                                "target_senses": [
                                    {
                                        "sense_id": "17abbf6b-fc4c-3c09-ac9d-c1a5e53aedec",
                                        "entry_id": "ef2ac6b2-3894-37e0-8579-8b0ff82ceee7",
                                        "glosses": [
                                            "A written collection of all words derived from a particular source, or sharing some other characteristic."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e70d465b-df8f-4f60-bc67-da5d256b1905",
                                                "sense_id": "17abbf6b-fc4c-3c09-ac9d-c1a5e53aedec",
                                                "text": "This is an annotated wordlist of the Ayere language, spoken in Ayere village in Kwara State, Nigeria. The wordlist was written by Mr. E.O. Olumorin for the West African Languages Survey in November 1961. […] Comparative wordlists of two dialects of Yoruba with Igala."
                                            },
                                            {
                                                "example_id": "3f312cbe-3f57-4731-b721-ff79df6470c3",
                                                "sense_id": "17abbf6b-fc4c-3c09-ac9d-c1a5e53aedec",
                                                "text": "For example, the focus of most previous wordlists has been on general academic vocabulary or the discipline-specific vocabulary needed in tertiary education."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84e1611e-71cb-3339-a9c0-984d84083160",
                                        "entry_id": "ef2ac6b2-3894-37e0-8579-8b0ff82ceee7",
                                        "glosses": [
                                            "The section of a style guide that lists particular words and terms, arranged alphabetically, to show for each one the preferred orthographic styling (e.g., hyphenation, spelling variant), as well as any usage prescription to be enforced about its usage."
                                        ],
