                                "target_senses": [
                                    {
                                        "sense_id": "d2c789de-f8c1-384c-b441-02f78669efcd",
                                        "entry_id": "6c547d5a-5a25-3c6a-bb1c-c53d5233b88f",
                                        "glosses": [
                                            "aus niederländischen Dialekten entstandene Sprache der Buren und nichtweißer Volksgruppen in der Republik Südafrika und im heutigen Namibia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59d2e54-6628-4f4f-94bf-84b7de08020f",
                                                "sense_id": "d2c789de-f8c1-384c-b441-02f78669efcd",
                                                "text": "Sprechen Sie Afrikaans?"
                                            },
                                            {
                                                "example_id": "c0391402-1bcc-4d71-a8a9-6bd54453fabb",
                                                "sense_id": "d2c789de-f8c1-384c-b441-02f78669efcd",
                                                "text": "„Etwa 95 % des Wortschatzes des Afrikaans stammen aus dem Niederländischen.“"
                                            },
                                            {
                                                "example_id": "3dc98cf3-8e34-42b2-93f3-65862e3fb59c",
                                                "sense_id": "d2c789de-f8c1-384c-b441-02f78669efcd",
                                                "text": "„Dann stapfte ich weiter hinter einer Reihe kleiner, größtenteils nackter Männer und Frauen her, die schnellen Schrittes unter einem feurig goldgefleckten Himmel durch das dürre Buschland eilten, das auf Afrikaans einst einfach Boesmanland (Buschmannland) geheißen hatte und allgemein unter dem Namen Kaokoveld bekannt gewesen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
