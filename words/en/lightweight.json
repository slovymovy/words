{
    "word_family": [
        "heavyweight",
        "featherweight",
        "welterweight",
        "middleweight",
        "flyweight",
        "bantamweight"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7f8e3166-b337-378b-a841-8152f1de3dc0",
                    "sense_definition": "Having relatively little weight; not heavy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need a <w>lightweight</w> jacket for the cool summer evenings.",
                            "target_lang_translations": {
                                "ru": "Мне нужна <w>лёгкая</w> куртка для прохладных летних вечеров.",
                                "zh": "我需要一件<w>轻便</w>的夹克来应对凉爽的夏夜。"
                            }
                        },
                        {
                            "text": "The laptop is <w>lightweight</w> and easy to carry in a backpack.",
                            "target_lang_translations": {
                                "ru": "Этот ноутбук <w>лёгкий</w>, и его удобно носить в рюкзаке.",
                                "zh": "这台笔记本电脑很<w>轻</w>，放在背包里携带很方便。"
                            }
                        }
                    ],
                    "synonyms": [
                        "light"
                    ],
                    "antonyms": [
                        "heavy",
                        "heavyweight"
                    ],
                    "common_phrases": [
                        "lightweight material",
                        "lightweight design",
                        "lightweight fabric"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий сравнительно небольшой вес; не тяжёлый.",
                        "zh": "重量较轻；不沉重。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лёгкий",
                                "target_lang_sense_clarification": "о физическом весе"
                            },
                            {
                                "target_lang_word": "облегчённый",
                                "target_lang_sense_clarification": "сделанный из лёгкого материала"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻便",
                                "target_lang_sense_clarification": "指物品轻且方便使用"
                            },
                            {
                                "target_lang_word": "轻",
                                "target_lang_sense_clarification": "指物理重量小"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcc5efb1-2732-3b5e-ba21-83bdd8f7ec4e",
                    "sense_definition": "Designed to use very little computer memory or processing power.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This <w>lightweight</w> browser loads web pages much faster than the old one.",
                            "target_lang_translations": {
                                "ru": "Этот <w>легковесный</w> браузер загружает веб-страницы намного быстрее старого.",
                                "zh": "这款<w>轻量级</w>浏览器加载网页的速度比旧版快得多。"
                            }
                        },
                        {
                            "text": "Developers prefer <w>lightweight</w> code for mobile applications to save battery life.",
                            "target_lang_translations": {
                                "ru": "Разработчики предпочитают <w>легковесный</w> код для мобильных приложений, чтобы экономить заряд батареи.",
                                "zh": "开发者更倾向于为移动应用编写<w>轻量级</w>代码，以节省电量。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lightweight app",
                        "lightweight software"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разработанный для использования малого объема памяти или вычислительной мощности.",
                        "zh": "指软件设计上占用内存少或对处理器性能要求低。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легковесный",
                                "target_lang_sense_clarification": "о программном обеспечении"
                            },
                            {
                                "target_lang_word": "лёгкий",
                                "target_lang_sense_clarification": "нетребовательный к ресурсам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻量级",
                                "target_lang_sense_clarification": "计算机术语，指资源占用少"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a0dfcaa-2dfc-3b68-bd3c-cec37353ebe8",
                    "sense_definition": "Lacking deep meaning, seriousness, or influence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie was entertaining but a bit <w>lightweight</w> in its plot.",
                            "target_lang_translations": {
                                "ru": "Фильм был занимательным, но немного <w>поверхностным</w> в плане сюжета.",
                                "zh": "这部电影很有趣，但剧情显得有些<w>肤浅</w>。"
                            }
                        },
                        {
                            "text": "Critics dismissed his book as a <w>lightweight</w> analysis of the economic crisis.",
                            "target_lang_translations": {
                                "ru": "Критики отвергли его книгу как <w>легковесный</w> анализ экономического кризиса.",
                                "zh": "评论家认为他的书是对经济危机的一种<w>轻量级</w>分析。"
                            }
                        }
                    ],
                    "synonyms": [
                        "superficial",
                        "trivial",
                        "shallow"
                    ],
                    "antonyms": [
                        "profound",
                        "serious",
                        "heavyweight"
                    ],
                    "common_phrases": [
                        "lightweight argument",
                        "lightweight entertainment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишённый глубокого смысла, серьёзности или влияния.",
                        "zh": "缺乏深度、严肃性或影响力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поверхностный",
                                "target_lang_sense_clarification": "неглубокий"
                            },
                            {
                                "target_lang_word": "легковесный",
                                "target_lang_sense_clarification": "несерьёзный, малозначительный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肤浅",
                                "target_lang_sense_clarification": "指内容不深刻"
                            },
                            {
                                "target_lang_word": "轻量级",
                                "target_lang_sense_clarification": "比喻不重要或缺乏分量"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a26fcbf9-2c6f-3f0f-8f5e-d9280306e65d",
                    "sense_definition": "A boxer or other athlete in a weight class for lighter competitors, typically between featherweight and welterweight.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_category",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lightweight</w> knocked out his opponent in the third round.",
                            "target_lang_translations": {
                                "ru": "<w>Легковес</w> нокаутировал своего соперника в третьем раунде.",
                                "zh": "这位<w>轻量级</w>选手在第三回合击倒了对手。"
                            }
                        },
                        {
                            "text": "He decided to move down to the <w>lightweight</w> category to compete more effectively.",
                            "target_lang_translations": {
                                "ru": "Он решил перейти в категорию <w>лёгкого веса</w>, чтобы соревноваться эффективнее.",
                                "zh": "他决定降到<w>轻量级</w>以更有效地参加比赛。"
                            }
                        }
                    ],
                    "antonyms": [
                        "heavyweight"
                    ],
                    "common_phrases": [
                        "lightweight champion",
                        "lightweight division",
                        "lightweight title"
                    ],
                    "target_lang_definitions": {
                        "ru": "Боксёр или другой спортсмен, выступающий в лёгкой весовой категории.",
                        "zh": "拳击或其他运动中体重较轻的级别，通常介于羽量级和次中量级之间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легковес",
                                "target_lang_sense_clarification": "спортсмен лёгкого веса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻量级",
                                "target_lang_sense_clarification": "体育竞技中的体重级别"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b65ba3ee-c328-3541-9031-4a48b73ebaf1",
                    "sense_definition": "A person who becomes drunk after drinking only a small amount of alcohol.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't give him another beer; he is a total <w>lightweight</w>.",
                            "target_lang_translations": {
                                "ru": "Не давай ему больше пива, он совсем <w>слабак</w>.",
                                "zh": "别再给他啤酒了，他这人<w>酒量小</w>。"
                            }
                        },
                        {
                            "text": "I am a bit of a <w>lightweight</w>, so I will stick to water for the rest of the night.",
                            "target_lang_translations": {
                                "ru": "Я довольно <w>быстро пьянею</w>, так что остаток вечера буду пить воду.",
                                "zh": "我有点<w>酒量小</w>，所以今晚剩下的时间我只喝水。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "total lightweight",
                        "such a lightweight"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который пьянеет от небольшого количества алкоголя.",
                        "zh": "指酒量很小，喝一点就醉的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабак",
                                "target_lang_sense_clarification": "разговорное, о переносимости алкоголя"
                            },
                            {
                                "target_lang_word": "быстро пьянеющий",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酒量小",
                                "target_lang_sense_clarification": "描述一个人不胜酒力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ccf1076-c77b-3c73-875f-5e7f9ca4c4de",
                    "sense_definition": "A person who has little influence, power, or ability.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is considered a <w>lightweight</w> in the world of international finance.",
                            "target_lang_translations": {
                                "ru": "Его считают <w>легковесом</w> в мире международных финансов.",
                                "zh": "他在国际金融界被视为一个<w>小角色</w>。"
                            }
                        },
                        {
                            "text": "The candidate was dismissed as a political <w>lightweight</w> by the media.",
                            "target_lang_translations": {
                                "ru": "Кандидата отвергли как политического <w>легковеса</w> в СМИ.",
                                "zh": "媒体认为这位候选人是个政治上的<w>无足轻重的人</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nonentity",
                        "mediocrity"
                    ],
                    "antonyms": [
                        "heavyweight"
                    ],
                    "common_phrases": [
                        "political lightweight",
                        "intellectual lightweight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обладающий малым влиянием, властью или способностями.",
                        "zh": "指影响力、权势或能力不足的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легковес",
                                "target_lang_sense_clarification": "человек без авторитета"
                            },
                            {
                                "target_lang_word": "мелкая сошка",
                                "target_lang_sense_clarification": "незначительный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无足轻重的人",
                                "target_lang_sense_clarification": "指缺乏影响力的人"
                            },
                            {
                                "target_lang_word": "小角色",
                                "target_lang_sense_clarification": "指地位低或能力弱的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f426be5c-47d2-3a29-b688-f8a66fb9cc3f",
                    "sense_definition": "To make a product or material lighter in weight, often to improve efficiency.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers are trying to <w>lightweight</w> the new car model to save fuel.",
                            "target_lang_translations": {
                                "ru": "Инженеры пытаются <w>облегчить</w> новую модель автомобиля для экономии топлива.",
                                "zh": "工程师们正试图对新车型进行<w>轻量化</w>设计以节省燃料。"
                            }
                        },
                        {
                            "text": "The company plans to <w>lightweight</w> its packaging to reduce shipping costs.",
                            "target_lang_translations": {
                                "ru": "Компания планирует <w>уменьшить вес</w> своей упаковки, чтобы снизить расходы на доставку.",
                                "zh": "公司计划对其包装进行<w>轻量化</w>处理，以降低运输成本。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "manufacturing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать продукт или материал легче по весу, часто для повышения эффективности.",
                        "zh": "使产品或材料重量减轻，通常是为了提高效率。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облегчать",
                                "target_lang_sense_clarification": "снижать вес конструкции"
                            },
                            {
                                "target_lang_word": "уменьшать вес",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻量化",
                                "target_lang_sense_clarification": "工业设计中减轻重量的过程"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}