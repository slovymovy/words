                "senses": [
                    {
                        "sense_id": "2c3a1649-9051-3bd6-9f5b-cdadf5a5d796",
                        "entry_id": "585bc6f7-c8b5-368a-9683-84b1da74f65f",
                        "glosses": [
                            "Messgerät zur Messung der Stärke des elektrischen Stroms"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e748376e-54b6-42ee-b737-93e9dae697ae",
                                "sense_id": "2c3a1649-9051-3bd6-9f5b-cdadf5a5d796",
                                "text": "Für den Versuchsaufbau benötigte der Wissenschaftler mehrere Amperemeter."
                            },
                            {
                                "example_id": "17d19ab8-64d4-4b43-bd8d-9cd3ecb0b2d5",
                                "sense_id": "2c3a1649-9051-3bd6-9f5b-cdadf5a5d796",
                                "text": "„Der Wunderkammer-Charakter der Vitrinen, in denen Pokale, Porzellane, mit Rotwein gefüllte Schalen und alte Messgeräte wie Baro- und Amperemeter altarähnliche Kompositionen bilden, steigert das Empfinden von Staunen und Wundern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6096caa-39c8-4afc-a143-669c9da7ddba",
                        "source_entry_id": "585bc6f7-c8b5-368a-9683-84b1da74f65f",
                        "source_sense_id": "2c3a1649-9051-3bd6-9f5b-cdadf5a5d796",
                        "source_sense_description": "Messgerät zur Messung der Stärke des elektrischen Stroms",
                        "target_lang_word": "ammeter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ammeter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2292da64-0ccc-3aa9-94f5-59e223fdae2d",
                                        "entry_id": "492c796d-a092-3a36-a57f-92b1849227e0",
                                        "glosses": [
                                            "A device that measures the magnitude of an electric current, especially one calibrated in amperes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9b5eb31-8fc9-44de-b795-0261ec47aa44",
                                                "sense_id": "2292da64-0ccc-3aa9-94f5-59e223fdae2d",
                                                "text": "The controllers of these diesels do not move round in notches, so that the driver's only sure guide to the way in which he is working his locomotive is his ammeter, corresponding in a way to the steam-chest pressure gauge of a steam locomotive. When the diesel was being worked full out, the ammeter normally showed about 1,500-1,600 amps, with occasional surges of current at starting or up the steepest gradients to 1,700 or even 1,800 amps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1aa8438f-9111-4e64-b976-0c4090c89494",
                        "source_entry_id": "585bc6f7-c8b5-368a-9683-84b1da74f65f",
                        "source_sense_id": "2c3a1649-9051-3bd6-9f5b-cdadf5a5d796",
                        "source_sense_description": "Messgerät zur Messung der Stärke des elektrischen Stroms",
                        "target_lang_word": "ampèremètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ampèremètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "443bac23-07d7-35ef-89d0-44d5bad3116b",
                                        "entry_id": "b1c9e918-0df5-3870-b334-de2bc52d1fcf",
                                        "glosses": [
                                            "Instrument de mesure spécialisé dans la mesure de l'intensité des courants électriques. L'unité de mesure est l'ampère notée A."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9407740-0136-48f5-a5e2-9606d1e81548",
                                                "sense_id": "443bac23-07d7-35ef-89d0-44d5bad3116b",
                                                "text": "Cet ampèremètre, fort ingénieux, est fondé sur un principe tout différent."
                                            },
                                            {
                                                "example_id": "27b13ff5-3ebf-4731-be38-d9e17b45dd4b",
                                                "sense_id": "443bac23-07d7-35ef-89d0-44d5bad3116b",
                                                "text": "Lui, fixe des yeux l'ampèremètre où chaque décharge s'accuse."
                                            },
                                            {
                                                "example_id": "a10d8fa8-e4cc-4a4e-8c57-2325740e4b78",
                                                "sense_id": "443bac23-07d7-35ef-89d0-44d5bad3116b",
                                                "text": "L’aiguille de l’ampèremètre, éclairé au bout de la cigarette, ne réagit pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
