{
    "word_family": [
        "thumb",
        "nail",
        "thumbtack"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e7ca7bc4-9aba-371b-8598-6b0b42a75824",
                    "sense_definition": "A small version of a larger image used for easy browsing or as a preview.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "digital_media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The website displays a <w>thumbnail</w> of each photo in the gallery.",
                            "target_lang_translations": {
                                "ru": "На сайте отображается <w>миниатюра</w> каждой фотографии в галерее."
                            }
                        },
                        {
                            "text": "You can click on the <w>thumbnail</w> image to see the full-sized version.",
                            "target_lang_translations": {
                                "ru": "Вы можете нажать на <w>превью</w>, чтобы увидеть изображение в полном размере."
                            }
                        }
                    ],
                    "synonyms": [
                        "preview",
                        "miniature"
                    ],
                    "common_phrases": [
                        "thumbnail image",
                        "click the thumbnail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшенная копия изображения, используемая для удобного просмотра или предварительного ознакомления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миниатюра",
                                "target_lang_sense_clarification": "уменьшенная копия изображения"
                            },
                            {
                                "target_lang_word": "эскиз",
                                "target_lang_sense_clarification": "предварительное изображение"
                            },
                            {
                                "target_lang_word": "превью",
                                "target_lang_sense_clarification": "предварительный просмотр"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ef4d1ec-0d45-3b1b-8685-1cbb3fd2eca0",
                    "sense_definition": "A specific image used to represent a video or post on social media platforms to attract viewers.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "digital_media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The creator spent hours designing a catchy <w>thumbnail</w> for his new video.",
                            "target_lang_translations": {
                                "ru": "Автор потратил часы на создание броской <w>обложки</w> для своего нового видео."
                            }
                        },
                        {
                            "text": "A misleading <w>thumbnail</w> can often lead to a high bounce rate.",
                            "target_lang_translations": {
                                "ru": "Вводящий в заблуждение <w>значок</w> видео часто приводит к высокому проценту отказов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "video thumbnail",
                        "custom thumbnail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изображение, представляющее видео или пост в социальных сетях для привлечения внимания зрителей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обложка",
                                "target_lang_sense_clarification": "для видео или поста"
                            },
                            {
                                "target_lang_word": "превью",
                                "target_lang_sense_clarification": "изображение-анонс"
                            },
                            {
                                "target_lang_word": "значок",
                                "target_lang_sense_clarification": "видео"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfe10df0-ed71-3517-bcf7-4bcdd3af7296",
                    "sense_definition": "The hard, protective covering at the end of the thumb.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He accidentally hit his <w>thumbnail</w> with the hammer while fixing the fence.",
                            "target_lang_translations": {
                                "ru": "Он случайно ударил молотком по <w>ногтю большого пальца</w>, когда чинил забор."
                            }
                        },
                        {
                            "text": "She painted a small flower on her <w>thumbnail</w> for the party.",
                            "target_lang_translations": {
                                "ru": "Она нарисовала маленький цветок на <w>ногте большого пальца</w> для вечеринки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "left thumbnail",
                        "broken thumbnail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердое защитное покрытие на кончике большого пальца руки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ноготь большого пальца",
                                "target_lang_sense_clarification": "анатомия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bd44020-1bc9-333b-b36b-6bcc39a49033",
                    "sense_definition": "A very small, rough sketch or a brief summary of something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "art_and_summary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist drew several <w>thumbnail</w> sketches before starting the main painting.",
                            "target_lang_translations": {
                                "ru": "Художник сделал несколько маленьких <w>набросков</w>, прежде чем приступить к основной картине."
                            }
                        },
                        {
                            "text": "The report provides a <w>thumbnail</w> sketch of the current economic situation.",
                            "target_lang_translations": {
                                "ru": "В отчете представлено <w>краткое описание</w> текущей экономической ситуации."
                            }
                        }
                    ],
                    "synonyms": [
                        "sketch",
                        "outline",
                        "summary"
                    ],
                    "common_phrases": [
                        "thumbnail sketch",
                        "thumbnail description"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень маленький, черновой набросок или краткое описание чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набросок",
                                "target_lang_sense_clarification": "черновой рисунок"
                            },
                            {
                                "target_lang_word": "эскиз",
                                "target_lang_sense_clarification": "предварительный план"
                            },
                            {
                                "target_lang_word": "краткое описание",
                                "target_lang_sense_clarification": "суть в общих чертах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "77119660-3b0e-3174-8105-154d9c3cb6ef",
                    "sense_definition": "To create a smaller, preview version of a larger digital image.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "digital_processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software will automatically <w>thumbnail</w> all the uploaded photos for the gallery.",
                            "target_lang_translations": {
                                "ru": "Программа автоматически <w>создаст миниатюры</w> для всех загруженных фотографий в галерее."
                            }
                        },
                        {
                            "text": "We need to <w>thumbnail</w> these high-resolution files to save loading time.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>уменьшить</w> эти файлы высокого разрешения, чтобы сэкономить время загрузки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "automatically thumbnail",
                        "thumbnail images"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать уменьшенную версию цифрового изображения для предварительного просмотра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "создавать миниатюры",
                                "target_lang_sense_clarification": "для изображений"
                            },
                            {
                                "target_lang_word": "уменьшать",
                                "target_lang_sense_clarification": "до размера превью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6509f6c6-895f-310d-a3f6-b9971cc8a8b2",
                    "sense_definition": "To describe or summarize something in a very concise or brief manner.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author managed to <w>thumbnail</w> the complex history of the city in just one chapter.",
                            "target_lang_translations": {
                                "ru": "Автору удалось <w>кратко изложить</w> сложную историю города всего в одной главе."
                            }
                        },
                        {
                            "text": "It is difficult to <w>thumbnail</w> such a broad topic without losing important details.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>резюмировать</w> такую обширную тему, не упуская важных деталей."
                            }
                        }
                    ],
                    "synonyms": [
                        "summarize",
                        "outline"
                    ],
                    "antonyms": [
                        "elaborate"
                    ],
                    "common_phrases": [
                        "thumbnail the story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывать или резюмировать что-либо в очень краткой и сжатой форме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кратко излагать",
                                "target_lang_sense_clarification": "суть"
                            },
                            {
                                "target_lang_word": "резюмировать",
                                "target_lang_sense_clarification": "подводить итог"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}