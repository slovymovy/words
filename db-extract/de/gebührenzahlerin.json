                                        "glosses": [
                                            "Celui, celle qui contribue aux charges publiques en payant des impôts et des taxes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "923fae40-2569-40db-8fcb-2440e45d3cc3",
                                                "sense_id": "a6d33395-f601-3754-9d29-4869778a1e10",
                                                "text": "Nous avons dit que l'impôt sera odieux, quel qu’en soit le montant, tant qu’il prendra dans la bourse du contribuable, pour ne rien y rapporter."
                                            },
                                            {
                                                "example_id": "8611525a-ca32-4ddf-b23f-d2e446e9cb3d",
                                                "sense_id": "a6d33395-f601-3754-9d29-4869778a1e10",
                                                "text": "Il faut en demander plus à l'impôt et moins au contribuable."
                                            }
                                        ]
                                    }
