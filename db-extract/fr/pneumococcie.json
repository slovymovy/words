                        "glosses": [
                            "Infection due à un pneumocoque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e339a92-d411-4e88-bc53-6b193dd72ba1",
                                "sense_id": "1c737fcd-602c-3a75-a2e1-765839b5471a",
                                "text": "Ce type d'infection est appelé PI (pneumococcie invasive). Les pneumococcies invasives peuvent occasionner des lésions cérébrales, des bactériémies ou entraîner la mort."
                            },
                            {
                                "example_id": "2fcdb806-6266-43d8-9070-c3a40bf77b25",
                                "sense_id": "1c737fcd-602c-3a75-a2e1-765839b5471a",
                                "text": "Les symptômes de la pneumococcie dépendent de la partie du corps qui est atteinte. Pour poser le diagnostic, il faut trouver des pneumocoques dans le sang, les liquides organiques ou les tissus infectés."
                            },
                            {
                                "example_id": "a2d8fecd-0b58-4619-9500-9a9c4cd8e1ad",
                                "sense_id": "1c737fcd-602c-3a75-a2e1-765839b5471a",
                                "text": "Avant l’adoption du vaccin conjugué contre le pneumocoque en 2001, environ 500 000 cas de pneumococcie se déclaraient chaque année au Canada."
                            }
                        ]
                    }
