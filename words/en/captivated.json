    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e9ce40c5-427c-3fb6-8593-d0e993632bba",
                    "sense_definition": "Feeling very interested or attracted by something or someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience was <w>captivated</w> by the singer's beautiful voice.",
                            "target_lang_translations": {
                                "nl": "Het publiek werd <w>geboeid</w> door de prachtige stem van de zangeres.",
                                "ru": "Публика была <w>очарована</w> прекрасным голосом певицы."
                            }
                        },
                        {
                            "text": "She was completely <w>captivated</w> by the story he told.",
                            "target_lang_translations": {
                                "nl": "Ze was volledig <w>betoverd</w> door het verhaal dat hij vertelde.",
                                "ru": "Она была совершенно <w>заворожена</w> историей, которую он рассказал."
                            }
                        }
                    ],
                    "synonyms": [
                        "mesmerized",
                        "enchanted",
                        "fascinated",
                        "enthralled"
                    ],
                    "antonyms": [
                        "bored",
                        "uninterested"
                    ],
                    "common_phrases": [
                        "totally captivated",
                        "completely captivated"
                    ],
                    "target_lang_definitions": {
                        "nl": "Heel erg geïnteresseerd of aangetrokken door iets of iemand.",
                        "ru": "Испытывающий глубокий интерес, восхищение или очарование чем-либо или кем-либо."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geboeid",
                                "target_lang_sense_clarification": "sterke aandacht of interesse"
                            },
                            {
                                "target_lang_word": "betoverd",
                                "target_lang_sense_clarification": "gecharmeerd of onder de indruk"
                            },
                            {
                                "target_lang_word": "gefascineerd",
                                "target_lang_sense_clarification": "zeer geboeid door iets"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "очарованный",
                                "target_lang_sense_clarification": "пленившийся чьим-то обаянием или красотой"
                            },
                            {
                                "target_lang_word": "пленённый",
                                "target_lang_sense_clarification": "захваченный чувством восхищения"
                            },
                            {
                                "target_lang_word": "заворожённый",
                                "target_lang_sense_clarification": "прикованный вниманием, словно под гипнозом"
