                ],
                "senses": [
                    {
                        "sense_id": "f32dbfb2-0851-3094-b2be-0fd7e8066767",
                        "entry_id": "09cad01b-a2a0-3f7c-9865-6d316b0ab89b",
                        "glosses": [
                            "helemaal jezelf kunnen onderhouden zonder hulp van anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d35209d-b9aa-4765-848a-23e3d2a57b3d",
                                "sense_id": "f32dbfb2-0851-3094-b2be-0fd7e8066767",
                                "text": "Het Mozambikaanse eco-duikresort Nuarro Lodge is meer dan een toeristenverblijf. De Nederlandse eigenaren leiden de lokale bevolking op om zelfvoorzienend te zijn en een sterke economie op te bouwen."
                            },
                            {
                                "example_id": "f51e3900-da3a-4514-90fc-b9619109e36b",
                                "sense_id": "f32dbfb2-0851-3094-b2be-0fd7e8066767",
                                "text": "Weer anderen menen dat we zeer klein moeten gaan wonen waarbij het ultieme genot volgt als we volledig zelfvoorzienend zijn doordat bijvoorbeeld zonnepanelen op het kleine dak voldoende elektra opwekken en regenwater wordt opgevangen en (samen met het afvalwater) wordt gezuiverd tot drinkwater."
                            }
                        ]
                    },
                    {
                        "sense_id": "52a31784-c10c-348f-b3e7-ec56673cf67c",
                        "entry_id": "09cad01b-a2a0-3f7c-9865-6d316b0ab89b",
                        "glosses": [
                            "een land dat zo weinig mogelijk afhankelijk is van andere landen en een gesloten economie heeft (een economie met weinig buitenlandse handel)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d45ce059-1fee-4060-b71d-7a5e78f3f7c4",
                                "sense_id": "52a31784-c10c-348f-b3e7-ec56673cf67c",
                                "text": "De Nederlandse kaasexport ter waarde van €230 miljoen is nu geheel weggevallen. Het Russische bewind vond de boycot een mooi middel om versneld zelfvoorzienend te worden, maar Russische kaasmakers kunnen nog steeds niet voldoen aan de vraag naar goede kaas."
                            }
                        ]
                    }
