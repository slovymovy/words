                                        "glosses": [
                                            "Taberna o restaurante rústico de cocina tradicional."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d900e56-c965-403c-97fe-0c4e16c1a91c",
                                                "sense_id": "4aeb0ef7-2a2b-305d-8b16-abdfa8f2ab48",
                                                "text": "El lienzo otra vez alzaron\nY apareció un bodegón,\nAnde se armó una runión\nEn que algunos se mamaron."
