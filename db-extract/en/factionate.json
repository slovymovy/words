                                "example_id": "ee554b37-1073-4187-b140-fa85ca71eb14",
                                "sense_id": "f7953f9d-3856-3059-ba3a-3fde08354392",
                                "text": "However, the Council immediately began to factionate."
                            },
                            {
                                "example_id": "bc222b32-f7f7-4a92-b589-33730f734c01",
                                "sense_id": "f7953f9d-3856-3059-ba3a-3fde08354392",
                                "text": "I said I would feel more comfortable with a smaller ICBM on the U.S. side if I could be assured that the Soviet Union would not factionate beyond 10 reentry vehicles."
                            },
                            {
                                "example_id": "e46c850b-e7d7-41f8-b798-1b78fd30b586",
                                "sense_id": "f7953f9d-3856-3059-ba3a-3fde08354392",
                                "text": "They create situations that allow, even encourage, invidious social comparison, which tends to factionate people who might otherwise engage in fruitful social relationships."
                            }
                        ]
                    }
