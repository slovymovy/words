                                "target_senses": [
                                    {
                                        "sense_id": "8122d1ab-5e4b-3c0c-a050-685eb26b854e",
                                        "entry_id": "42fb8c19-a68c-346f-870e-e17e988a87e5",
                                        "glosses": [
                                            "opgewektheid en merkbaar gemak in het ervaren van genoegens als houding in iemands bestaan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b91a93-bbd6-4f31-8dfb-e8ac08366ead",
                                                "sense_id": "8122d1ab-5e4b-3c0c-a050-685eb26b854e",
                                                "text": "In de decennia die volgden stond Shi, die in 2010 op 59-jarige leeftijd aan een hersenbloeding overleed, bekend om zijn joie de vivre en schaterlach. „Als ik toch het leven heb gekozen, waarom zou ik dan lijdend leven?” zei hij in 2003 in een interview tijdens de SARS-pandemie, toen journalisten naar hem toekwamen voor levenslessen."
                                            }
                                        ]
