                "senses": [
                    {
                        "sense_id": "f1893c5a-8a01-32a5-bcb3-a967851aea19",
                        "entry_id": "8bc7afa6-8c1c-353f-a008-49a7f3cc2551",
                        "glosses": [
                            "Faire perdre ses globules à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "637613b1-8ac5-4d85-8faf-680a6422b9c0",
                                "sense_id": "f1893c5a-8a01-32a5-bcb3-a967851aea19",
                                "text": "mais comme elle ne peut être ajoutée à notre sang dans une proportion un peu forte sans altérer nos éléments figurés, il faudrait, si on l'employait, ne l'injecter qu'en petite quantité ou consentir à déglobuliser légèrement le malade."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4454943-f252-3c90-9130-17ab046a897e",
                        "entry_id": "8bc7afa6-8c1c-353f-a008-49a7f3cc2551",
                        "glosses": [
                            "Perdre ses globules."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "348f9e47-7b93-4369-96fe-40ec63f13fc7",
                                "sense_id": "c4454943-f252-3c90-9130-17ab046a897e",
                                "text": "Mais tous les malades que nous avons observés ont continué jusqu'à la mort, à se déglobuliser, malgré la persistance d'une réticulocytose notable."
                            }
                        ]
                    }
