                ],
                "senses": [
                    {
                        "sense_id": "ffcd4134-b403-3e54-9c2e-7105faa3040b",
                        "entry_id": "be7fed40-e85d-3fc6-bad7-474362d9261e",
                        "glosses": [
                            "Fait de passer avant les autres, en priorité."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b15e392c-62c7-39a7-8edd-7d14b3cbb419",
                        "entry_id": "be7fed40-e85d-3fc6-bad7-474362d9261e",
                        "glosses": [
                            "Priorité dont jouit un acheteur, soit par la loi, soit par convention des parties, pour se porter acquéreur d’un bien avant toute autre personne."
                        ],
                        "tags": [
                            "Droit de propriété"
                        ],
                        "examples": [
                            {
                                "example_id": "e149cd06-5586-4061-8784-f1cf81f19ae1",
                                "sense_id": "b15e392c-62c7-39a7-8edd-7d14b3cbb419",
                                "text": "Le propriétaire bailleur d’un fonds de terre ou d’un bien rural qui décide ou est contraint de l’aliéner à titre onéreux, sauf le cas d’expropriation pour cause d’utilité publique, ne peut procéder à cette aliénation qu’en tenant compte, conformément aux dispositions de la présente section, d’un droit de préemption au bénéfice de l’exploitant preneur en place."
                            },
                            {
                                "example_id": "6973e531-b043-4c85-ac57-63b4f5b574f6",
                                "sense_id": "b15e392c-62c7-39a7-8edd-7d14b3cbb419",
                                "text": "On peut, par exemple, imaginer, dans l’état actuel des structures politiques (et moyennant bien sûr les conditions de majorité appropriées), une disposition législative simple et peu coûteuse, qui établirait un droit de préemption des salariés sur leur entreprise en cas de dépôt de bilan, ou sur leur site en cas de fermeture."
                            }
                        ]
                    },
                    {
                        "sense_id": "f91901ff-bf4a-30ce-ad9c-b535f9a4ca13",
                        "entry_id": "be7fed40-e85d-3fc6-bad7-474362d9261e",
                        "glosses": [
                            "Droit reconnu à la douane d’acheter au prix déclaré une marchandise sous-évaluée."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4642825d-30f8-367c-9bdf-7569c237f8b7",
                        "entry_id": "be7fed40-e85d-3fc6-bad7-474362d9261e",
                        "glosses": [
                            "Action d’un noyau multi-tâche qui consiste à suspendre une tâche au profit d’une autre, de priorité supérieure."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86eb1ce8-0a10-4450-a299-148b2f5a9b60",
                        "source_entry_id": "be7fed40-e85d-3fc6-bad7-474362d9261e",
                        "target_lang_word": "Vorkauf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorkauf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a54d9ad2-856c-36a1-8564-199fabe2363b",
                                        "entry_id": "1368cbaa-df4a-3100-a10e-b030ee38a1dd",
                                        "glosses": [
                                            "Erwerb zu einem früheren Zeitpunkt, bei dem nicht alle Interessenten die gleichen Möglichkeiten zum Kauf hatten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8e206fc-f387-4820-af7e-efe7018217dc",
                                                "sense_id": "a54d9ad2-856c-36a1-8564-199fabe2363b",
                                                "text": "„Im December gleichen Jahres erließen sie auch eine Verordnung gegen wucherischen Vorkauf von Früchten.“ (1819)"
                                            },
                                            {
                                                "example_id": "7229d6ab-3de0-426f-b240-16102f1b21d0",
                                                "sense_id": "a54d9ad2-856c-36a1-8564-199fabe2363b",
                                                "text": "„Der Konsens der Erben, bzw. seine Erwähnung, beweist jedenfalls, dass ihnen das Gut zum Vorkauf angeboten worden war, oder dass sie auf ihr Vorkaufsrecht verzichtet hatten.“ (1878)"
                                            },
                                            {
                                                "example_id": "e8535d9e-1ee4-47e7-88f4-e78a9d405da3",
                                                "sense_id": "a54d9ad2-856c-36a1-8564-199fabe2363b",
                                                "text": "„Hier waren die Durchschnittspreise beim Konkurrenzkauf niedriger als bei den Produzentenkäufen und unter diesen erwies sich der Vorkauf als die kostspieligere Beschaffungsart, der Doppelzentner Hafer kostete bei Vorkauf um 0.18 Kronen mehr als beim Handkauf […].“ (1910)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
