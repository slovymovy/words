                        "entry_id": "c37ea2b6-f7c9-3478-9add-3e89d6071b3c",
                        "glosses": [
                            "jemand, der sich in der Mitte des vierten Jahrzehnts seines Lebens befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83663087-d09d-4537-b384-50263a8c5a67",
                                "sense_id": "1905fe80-05b9-315a-94f7-5ceb3b48a684",
                                "text": "Die Tür ging auf und der Mittdreißger kam herein."
                            },
                            {
                                "example_id": "36f26c3e-8e0e-42dd-9e8f-79c6f2837111",
                                "sense_id": "1905fe80-05b9-315a-94f7-5ceb3b48a684",
                                "text": "„Wie gesagt, das erzählte ein Achtzigjähriger einem Mittdreißiger (Zanuck/Wilder), der mir nun seine Geschichte erzählte, als er selbst achtzig war und ich dreißig Jahre jünger.“"
                            }
                        ],
