                                        "entry_id": "0c3419c4-b596-39b8-8eec-bbcee6a16b90",
                                        "glosses": [
                                            "um eine Oktave erhöhte Männerstimme, was durch eine besondere Gesangstechnik erreicht wird, bei der nur die Stimmlippenränder in Schwingungen versetzt werden"
                                        ],
                                        "tags": [
                                            "Musik",
                                            "Gesang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a3ec8af-20d3-4a82-bc5e-a918ac035adc",
                                                "sense_id": "d7dc985f-acdc-3fa6-a04e-9c129b90a01b",
                                                "text": "Die Bee Gees sangen viele ihrer Lieder im Falsett."
                                            },
                                            {
                                                "example_id": "d3e5162b-75b4-40ce-b4fa-8801f2084ab3",
                                                "sense_id": "d7dc985f-acdc-3fa6-a04e-9c129b90a01b",
                                                "text": "„Er sang sie in einem ganz hohen Falsett, es klang klar und fromm, und sogar Otto Quangel fühlte sich in seine Kindertage zurückversetzt, als solche Lieder ihm noch etwas bedeutet hatten, da er schlicht gläubig gewesen war.“"
                                            },
                                            {
                                                "example_id": "cbcb66cb-c21d-4fa7-92bf-393c56b412e8",
                                                "sense_id": "d7dc985f-acdc-3fa6-a04e-9c129b90a01b",
                                                "text": "„»Tag, Mr. Belane!« sagte er in einem hohen Falsett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
