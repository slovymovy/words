                                "example_id": "d8900e9a-52df-4cda-a647-e14724299d02",
                                "sense_id": "e64a4fdd-d8b8-35e2-9219-67269beec79f",
                                "text": "Tłumiki są to zwykle przewody konstruowane w ten sposób, by perymetr ich był możliwie największy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0a49d7f6-f212-39b8-8a28-c2b33025e2d1",
                        "entry_id": "14c4f684-c95a-323c-8e33-bf0f3e5243fd",
                        "glosses": [
                            "przyrząd do badania pola widzenia oka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eae0aab5-9f53-4442-9a7a-c00079e8847a",
                                "sense_id": "0a49d7f6-f212-39b8-8a28-c2b33025e2d1",
                                "text": "Badanie przeprowadzono przy pomocy perymetru Förstera w ciemni po uprzedniej 15-minutowej adaptacji badanego i badającego"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "0e34846c-ed23-3f88-aa87-30ec1160cf32",
                        "entry_id": "14c4f684-c95a-323c-8e33-bf0f3e5243fd",
                        "glosses": [
                            "pole widzenia żołnierzy od punktu obserwacji do najdalej wysuniętego punktu na horyzoncie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b85da51-abf9-4888-a912-851b77c378d5",
                                "sense_id": "0e34846c-ed23-3f88-aa87-30ec1160cf32",
                                "text": "Na południowym perymetrze, w przeciwległym krańcu lotniska, ustawiła się linia żołnierzy strzelających do dużej grupy nieprzyjaciół wychodzących z burzy na południowym zachodzie"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
