                ],
                "senses": [
                    {
                        "sense_id": "b889063b-647c-3354-aa77-3c8238184c59",
                        "entry_id": "06c0810f-0fe4-3109-a78e-34651b43a6c5",
                        "glosses": [
                            "ochota do działania"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11affcf3-e124-4a7c-b2b7-7002ad25b39a",
                                "sense_id": "b889063b-647c-3354-aa77-3c8238184c59",
                                "text": "Panna Florentyna aż drgnęła, a pan Tomasz z wielką werwą począł opowiadać […]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d0165ce-e455-4d91-93bf-524e01822fdc",
                        "source_entry_id": "06c0810f-0fe4-3109-a78e-34651b43a6c5",
                        "source_sense_id": "b889063b-647c-3354-aa77-3c8238184c59",
                        "target_lang_word": "Elan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78142803-08be-30ed-a0fc-73b1915d0e29",
                                        "entry_id": "814a5fdd-f990-3869-9a52-328bc299a1b2",
                                        "glosses": [
                                            "die Begeisterung oder der Schwung, womit man etwas macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf41312d-9885-4d9e-9507-cf90f6c99ad7",
                                                "sense_id": "78142803-08be-30ed-a0fc-73b1915d0e29",
                                                "text": "Er ist neu und steckt voller Elan."
                                            },
                                            {
                                                "example_id": "fc0fe105-9619-4c5a-8c61-2eb49675605b",
                                                "sense_id": "78142803-08be-30ed-a0fc-73b1915d0e29",
                                                "text": "„Leider berichtete ihre Mutter, die ganz begeistert von der Idee mit dem französischen Buchladen war und voller Elan in Manhattan nach einem passenden Ort suchte, dass sie kein Glück hatte.“"
                                            },
                                            {
                                                "example_id": "47511812-05b8-463e-98fd-d049af2e98b8",
                                                "sense_id": "78142803-08be-30ed-a0fc-73b1915d0e29",
                                                "text": "„Kristín füllte das ganze Zimmer mit ihrer Präsenz und dem Elan, den sie ausstrahlte, und sie redete so viel, dass Guđriđur kaum etwas zu sagen brauchte, im Grunde nichts, nur zuhören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7144617-2b7e-4807-a488-e17ef0653fba",
                        "source_entry_id": "06c0810f-0fe4-3109-a78e-34651b43a6c5",
                        "source_sense_id": "b889063b-647c-3354-aa77-3c8238184c59",
                        "target_lang_word": "огонь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "огонь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2c250b1f-f310-3865-8ec1-95d914236a80",
                                        "entry_id": "fc3716d9-99cb-3c83-b778-541f83283882",
                                        "glosses": [
                                            "выделяемые при горении раскалённые светящиеся газы и частицы твёрдого вещества, пламя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "781eea73-00c6-4269-a239-0d3508d890a7",
                                                "sense_id": "2c250b1f-f310-3865-8ec1-95d914236a80",
                                                "text": "Только к утру они немного успокоились, сели полукругом у печки и смотрели на огонь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61dea84e-e034-34a8-8d28-40722bc92c8c",
                                        "entry_id": "fc3716d9-99cb-3c83-b778-541f83283882",
                                        "glosses": [
                                            "свет, видимый в темноте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbbefaf8-40a4-45d6-b3ae-1e9df505f43f",
                                                "sense_id": "61dea84e-e034-34a8-8d28-40722bc92c8c",
                                                "text": "Давно стемнело, и огни светофоров отражались в мокром асфальте."
                                            },
                                            {
                                                "example_id": "acd9eb3a-32c0-4b0a-9614-cc49f20b1442",
                                                "sense_id": "61dea84e-e034-34a8-8d28-40722bc92c8c",
                                                "text": "Не внял поэт мольбам любимой дамы, иной раз пешком тащился по грязным болотным дорогам и торфяным рытвинам на манящие огни торфяного посёлка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ea581f6-15a7-3ebe-b77d-767142432e5f",
                                        "entry_id": "fc3716d9-99cb-3c83-b778-541f83283882",
                                        "glosses": [
                                            "процесс горения, как правило, искусственно вызванный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb9d3cdb-4a5e-4ae2-804c-048f617d2015",
                                                "sense_id": "8ea581f6-15a7-3ebe-b77d-767142432e5f",
                                                "text": "В печке ревел огонь, в окна хлестал дождь."
                                            },
                                            {
                                                "example_id": "fe99b85d-b43e-4c98-bac8-1bc78a00ad88",
                                                "sense_id": "8ea581f6-15a7-3ebe-b77d-767142432e5f",
                                                "text": "Вероятно, так же человек ещё в доисторические времена, впервые научившись поддерживать огонь, оберегал его днём и ночью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cfe2451-f9f1-3de0-a15b-1355908470a2",
                                        "entry_id": "fc3716d9-99cb-3c83-b778-541f83283882",
                                        "glosses": [
                                            "перен. душевный пыл, горячность, возбуждение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba1b9974-121e-487a-8431-e039bea527e8",
                                                "sense_id": "7cfe2451-f9f1-3de0-a15b-1355908470a2",
                                                "text": "Запрет на консультации вселял бы надежду на нулевой результат усилий майора, если бы Милий Алексеевич не предполагал в Озерецковском огонь честолюбия, присущего, по мнению Башуцкого, любому синему тюльпану."
                                            },
                                            {
                                                "example_id": "d2178ceb-2167-41c9-8ab2-e2c901d348a3",
                                                "sense_id": "7cfe2451-f9f1-3de0-a15b-1355908470a2",
                                                "text": "Региональные кланы раскололи общество и разожгли огонь гражданской войны."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2d83d64-9dce-3d3c-bb80-cb41c438d488",
                                        "entry_id": "fc3716d9-99cb-3c83-b778-541f83283882",
                                        "glosses": [
                                            "воен. стрельба из огнестрельного оружия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8e5132d-d239-4c55-b1c0-a573b14602ab",
                                                "sense_id": "a2d83d64-9dce-3d3c-bb80-cb41c438d488",
                                                "text": "Лейтенант, водивший канонерки // Под огнём неприятельских батарей, // Целую ночь над южным морем // Читал мне на память мои стихи."
                                            },
                                            {
                                                "example_id": "be7394e6-240d-4c53-a0b4-07cfc39dbd8b",
                                                "sense_id": "a2d83d64-9dce-3d3c-bb80-cb41c438d488",
                                                "text": "Постепенно огонь зениток переместился в другую часть города, и оттуда глухо доносились разрывы бомб."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd6bd0ac-348f-359a-9bcb-95c9e5a9c518",
                                        "entry_id": "fc3716d9-99cb-3c83-b778-541f83283882",
                                        "glosses": [
                                            "спец. источник света, устанавливаемый на транспортном средстве с целью сигнализации"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e32b79a6-5a99-4da8-b40d-ffed2b7b9515",
                                                "sense_id": "cd6bd0ac-348f-359a-9bcb-95c9e5a9c518",
                                                "text": "Скоро начался дождь, и огни встречных машин на лобовом стекле дробились в радужную крошку."
                                            },
                                            {
                                                "example_id": "dc89ac66-d1ef-4a6e-8666-11b2a0b8fc7e",
                                                "sense_id": "cd6bd0ac-348f-359a-9bcb-95c9e5a9c518",
                                                "text": "Перед выездом необходимо проверить работу указателей поворота, противотуманного заднего огня, габаритных огней, сигнала торможения."
                                            },
                                            {
                                                "example_id": "3e756ef5-f499-4ef7-9b7f-820bac2a4b4c",
                                                "sense_id": "cd6bd0ac-348f-359a-9bcb-95c9e5a9c518",
                                                "text": "Навигационные огни правого и левого борта имеют зелёный и красный цвет соответственно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfb679c1-b34b-3134-a80e-92b802f66e4d",
                                        "entry_id": "fc3716d9-99cb-3c83-b778-541f83283882",
                                        "glosses": [
                                            "перен. тепло от источника, используемого для термической обработки пищи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c20d851-68b4-4af1-a369-5997b76de798",
                                                "sense_id": "cfb679c1-b34b-3134-a80e-92b802f66e4d",
                                                "text": "Варите на слабом огне 10—15 минут."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "огонь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "864f46a6-5228-3a66-8812-e8f27a148a70",
                                        "entry_id": "a2f68d75-d0be-394a-b250-40e7a1d09eee",
                                        "glosses": [
                                            "воен. команда к стрельбе из огнестрельного оружия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2f7f9d1-f9d2-4eab-8a31-a4cdf8d82f02",
                                                "sense_id": "864f46a6-5228-3a66-8812-e8f27a148a70",
                                                "text": "Симонов скомандовал: «Огонь!», и по толпе загрохотали крепостные пушки."
                                            },
                                            {
                                                "example_id": "c289c4f6-2977-4184-8f87-5d3057186beb",
                                                "sense_id": "864f46a6-5228-3a66-8812-e8f27a148a70",
                                                "text": "Когда начальник связи пытался шагнуть вперёд, Батюк, гакая, кричал: «Огонь!» — и немец, как по заказу, пускал мину."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fb24aa4-c503-3827-b143-0460e612a7b7",
                                        "entry_id": "a2f68d75-d0be-394a-b250-40e7a1d09eee",
                                        "glosses": [
                                            "сленг"
