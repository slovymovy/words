                            },
                            {
                                "target_lang_word": "vergeuden",
                                "target_lang_sense_clarification": "Lebensmittel, Geld sinnlos verbrauchen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "malgastar",
                                "target_lang_sense_clarification": "dinero o bienes sin necesidad"
                            },
                            {
                                "target_lang_word": "despilfarrar",
                                "target_lang_sense_clarification": "grandes sumas sin provecho"
                            },
                            {
                                "target_lang_word": "derrochar",
                                "target_lang_sense_clarification": "dinero o recursos con prodigalidad"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浪费",
                                "target_lang_sense_clarification": "金钱、食物或物资"
                            },
                            {
                                "target_lang_word": "挥霍",
                                "target_lang_sense_clarification": "钱财，大手大脚地花费"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fed6f7e-27c5-32e2-a11a-b082e3a3b764",
                    "sense_definition": "Perdre ou employer mal une ressource abstraite telle que le temps, l'énergie ou un talent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ressources_immaterielles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrête de <w>gaspiller</w> ton temps sur les réseaux sociaux et commence à travailler.",
                            "target_lang_translations": {
                                "en": "Stop <w>wasting</w> your time on social media and start working.",
                                "ru": "Хватит <w>тратить</w> время на социальные сети и начинай работать.",
                                "de": "Hör auf, deine Zeit in sozialen Netzwerken zu <w>vergeuden</w>, und fang an zu arbeiten.",
                                "es": "Deja de <w>desperdiciar</w> tu tiempo en las redes sociales y empieza a trabajar.",
                                "zh": "别再把时间<w>浪费</w>在社交网络上了，快开始工作吧。"
                            }
                        },
                        {
                            "text": "Elle a l'impression de <w>gaspiller</w> son énergie pour des détails sans importance.",
                            "target_lang_translations": {
                                "en": "She feels as if she is <w>wasting</w> her energy on trivial details.",
                                "ru": "Ей кажется, что она <w>тратит</w> силы впустую на незначительные детали.",
                                "de": "Sie hat den Eindruck, ihre Energie für unwichtige Details zu <w>verschwenden</w>.",
                                "es": "Tiene la sensación de que <w>malgasta</w> su energía en detalles sin importancia.",
                                "zh": "她觉得自己是在为那些无关紧要的细节<w>浪费</w>精力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gâcher",
                        "perdre"
                    ],
                    "antonyms": [
                        "rentabiliser"
                    ],
                    "common_phrases": [
                        "gaspiller son temps",
                        "gaspiller son énergie"
                    ],
                    "target_lang_definitions": {
                        "en": "To lose or misuse an intangible resource such as time, energy, or talent.",
                        "ru": "Бесполезно терять или плохо использовать время, силы или способности.",
                        "de": "Eine immaterielle Ressource wie Zeit, Energie oder Talent verlieren oder schlecht nutzen.",
                        "es": "Perder o emplear mal un recurso abstracto, como el tiempo, la energía o el talento.",
                        "zh": "白白损失或不善于利用时间、精力、才能等抽象资源。"
                    },
