                        "entry_id": "2e6566bf-ffc3-3202-9e23-c348d9a50b9f",
                        "glosses": [
                            "Honest; reputable; respectable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3e35af3-9d47-4337-8dda-9bdc10790882",
                                "sense_id": "55625362-c320-3397-b70e-f67e9369364c",
                                "text": "An upstanding merchant will exchange a faulty product."
                            },
                            {
                                "example_id": "f3a8b950-dd77-4d7a-b5b6-ba8340227e06",
                                "sense_id": "55625362-c320-3397-b70e-f67e9369364c",
                                "text": "I don't even know her\nBut I feel a responsibility to do what's upstanding and right\nIt's kinda like a code, yeah\nAnd you've been getting closer and closer, and crossing so many lines"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b37b8717-7d19-4662-b173-2639db71b088",
                        "source_entry_id": "2e6566bf-ffc3-3202-9e23-c348d9a50b9f",
                        "source_sense_id": "55625362-c320-3397-b70e-f67e9369364c",
