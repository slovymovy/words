                                        "entry_id": "168e663a-4822-38b9-b8d2-ba462207e3ff",
                                        "glosses": [
                                            "Any of several species of small, nocturnal and arboreal African primates, of the family Galagidae, with a catlike head and very large, translucent eyes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "652eda0f-d36e-489b-87a3-f89bea947623",
                                                "sense_id": "a8776e3e-9c59-3e76-aa7b-7f491dbef5f6",
                                                "text": "From the trees comes the doleful cry of the black-faced dioch, and the weary rustle of galagos creeping back to their nests after a meticulous night's prowl."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
