                                        "sense_id": "9bc102ff-edc6-3d55-a4a6-347445a842f4",
                                        "entry_id": "591b1e87-cab2-35ea-a278-e9540e0c4799",
                                        "glosses": [
                                            "sporter die in een ijshockeyteam speelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c934f4b-8bd6-4576-b064-b0d0744dc8bc",
                                                "sense_id": "9bc102ff-edc6-3d55-a4a6-347445a842f4",
                                                "text": "Katerina woonde samen met haar vriend, een Tsjechische ijshockeyspeler. Hij speelde een wedstrijd in Rusland op het moment dat zijn vriendin dood werd gevonden."
                                            },
                                            {
                                                "example_id": "06e5a81f-fe3c-47e2-abbd-9949ef681b10",
                                                "sense_id": "9bc102ff-edc6-3d55-a4a6-347445a842f4",
                                                "text": "Door de jaren heen bouwde Petrescu een goede vriendschap op met Ion Tiriac, voormalig professioneel tennis- en ijshockeyspeler en huidig president van de Roemeense tennisfederatie. Zijn vermogen wordt op circa 1 miljard euro geschat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
