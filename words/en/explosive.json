{
    "word_family": [
        "explode",
        "explosion",
        "explosively",
        "explosiveness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "08f338ce-ffa0-3db9-99f1-7ac66240fd8d",
                    "sense_definition": "Able to, or likely to, explode.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "literal_explosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police safely detonated the <w>explosive</w> device found in the park.",
                            "target_lang_translations": {
                                "ru": "Полиция безопасно обезвредила <w>взрывное</w> устройство, найденное в парке.",
                                "zh": "警方安全引爆了在公园里发现的<w>爆炸性</w>装置。"
                            }
                        },
                        {
                            "text": "Workers must be extremely careful when handling <w>explosive</w> chemicals.",
                            "target_lang_translations": {
                                "ru": "Рабочие должны быть предельно осторожны при обращении со <w>взрывчатыми</w> химикатами.",
                                "zh": "工人在处理<w>易爆的</w>化学品时必须格外小心。"
                            }
                        }
                    ],
                    "antonyms": [
                        "inert",
                        "nonflammable"
                    ],
                    "common_phrases": [
                        "explosive device",
                        "explosive material",
                        "highly explosive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный взорваться или предназначенный для взрыва.",
                        "zh": "能够爆炸的，或很可能爆炸的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взрывной",
                                "target_lang_sense_clarification": "об устройствах или механизмах"
                            },
                            {
                                "target_lang_word": "взрывчатый",
                                "target_lang_sense_clarification": "о веществах и материалах"
                            },
                            {
                                "target_lang_word": "взрывоопасный",
                                "target_lang_sense_clarification": "представляющий угрозу взрыва"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爆炸性的",
                                "target_lang_sense_clarification": "可用于装置、物品等，表示会爆炸或用于爆炸"
                            },
                            {
                                "target_lang_word": "易爆的",
                                "target_lang_sense_clarification": "多用于化学品、气体、材料等，表示容易爆炸"
                            },
                            {
                                "target_lang_word": "有爆炸危险的",
                                "target_lang_sense_clarification": "强调有爆炸风险"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8ba2039-e8d0-3fbe-81c6-5f006637429d",
                    "sense_definition": "Rapidly accelerating or increasing with great force.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rapid_increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company experienced <w>explosive</w> growth in its first year of operation.",
                            "target_lang_translations": {
                                "ru": "Компания пережила <w>взрывной</w> рост в первый год своей работы.",
                                "zh": "这家公司在运营的第一年经历了<w>爆发式</w>增长。"
                            }
                        },
                        {
                            "text": "The sprinter is known for his <w>explosive</w> speed at the start of the race.",
                            "target_lang_translations": {
                                "ru": "Спринтер известен своей <w>взрывной</w> скоростью на старте гонки.",
                                "zh": "这名短跑运动员以起跑时<w>爆发性的</w>速度而闻名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "explosive growth",
                        "explosive power",
                        "explosive speed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стремительно ускоряющийся или увеличивающийся с большой силой.",
                        "zh": "以很强的力量迅速加速或增长的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взрывной",
                                "target_lang_sense_clarification": "о росте или силе"
                            },
                            {
                                "target_lang_word": "стремительный",
                                "target_lang_sense_clarification": "очень быстрый"
                            },
                            {
                                "target_lang_word": "бурный",
                                "target_lang_sense_clarification": "интенсивный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爆发式的",
                                "target_lang_sense_clarification": "多用于增长、发展等突然且迅猛的上升"
                            },
                            {
                                "target_lang_word": "爆发性的",
                                "target_lang_sense_clarification": "强调力量、速度或增长的强烈爆发感"
                            },
                            {
                                "target_lang_word": "猛增的",
                                "target_lang_sense_clarification": "强调增长或变化来得很猛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47267958-49dc-36f3-bb87-cbf681b2fed7",
                    "sense_definition": "Shocking, startling, or likely to cause a strong emotional or social reaction.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "volatile_situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journalist published an <w>explosive</w> report about corruption in the city council.",
                            "target_lang_translations": {
                                "ru": "Журналист опубликовал <w>скандальный</w> доклад о коррупции в городском совете.",
                                "zh": "那名记者发表了一篇关于市议会腐败的<w>爆炸性</w>报道。"
                            }
                        },
                        {
                            "text": "The meeting ended in an <w>explosive</w> argument between the two managers.",
                            "target_lang_translations": {
                                "ru": "Встреча закончилась <w>бурным</w> спором между двумя менеджерами.",
                                "zh": "会议最后以两位经理之间一场<w>激烈的</w>争论收场。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "explosive secrets",
                        "explosive interview",
                        "explosive situation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шокирующий, вызывающий сильную эмоциональную или общественную реакцию.",
                        "zh": "令人震惊的、耸人听闻的，或可能引发强烈情绪或社会反应的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скандальный",
                                "target_lang_sense_clarification": "вызывающий скандал"
                            },
                            {
                                "target_lang_word": "сенсационный",
                                "target_lang_sense_clarification": "производящий сенсацию"
                            },
                            {
                                "target_lang_word": "взрывоопасный",
                                "target_lang_sense_clarification": "о ситуации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爆炸性的",
                                "target_lang_sense_clarification": "多用于新闻、报道、消息等，表示引起轰动或强烈反应"
                            },
                            {
                                "target_lang_word": "激烈的",
                                "target_lang_sense_clarification": "多用于争论、冲突、反应等，表示非常强烈"
                            },
                            {
                                "target_lang_word": "一触即发的",
                                "target_lang_sense_clarification": "多用于局势、关系等，表示容易引发严重后果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e5f8ca9-22c7-3057-8241-bebe14f4be83",
                    "sense_definition": "Easily driven to anger; having a volatile personality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "volatile_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has an <w>explosive</w> temper that makes him difficult to work with.",
                            "target_lang_translations": {
                                "ru": "У него <w>вспыльчивый</w> характер, из-за чего с ним трудно работать.",
                                "zh": "他脾气<w>火爆</w>，所以很难与他共事。"
                            }
                        },
                        {
                            "text": "Her <w>explosive</w> reaction to the bad news surprised everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Её <w>бурная</w> реакция на плохие новости удивила всех в комнате.",
                                "zh": "她对这个坏消息的<w>激烈</w>反应让房间里的每个人都很吃惊。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "explosive temper",
                        "explosive personality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко выходящий из себя; обладающий неуравновешенным характером.",
                        "zh": "容易发怒的；性格冲动易爆的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вспыльчивый",
                                "target_lang_sense_clarification": "о характере"
                            },
                            {
                                "target_lang_word": "взрывной",
                                "target_lang_sense_clarification": "о темпераменте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "火爆的",
                                "target_lang_sense_clarification": "多用于脾气、性格，表示容易发火"
                            },
                            {
                                "target_lang_word": "易怒的",
                                "target_lang_sense_clarification": "强调很容易生气"
                            },
                            {
                                "target_lang_word": "暴躁的",
                                "target_lang_sense_clarification": "强调性情急躁、容易失控"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a082b87-c31b-34d1-af71-a27891c0b8c3",
                    "sense_definition": "Relating to a consonant sound produced by stopping the airflow completely and then releasing it suddenly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics_plosive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In English, the letters p, b, and t represent <w>explosive</w> consonants.",
                            "target_lang_translations": {
                                "ru": "В английском языке буквы p, b и t обозначают <w>взрывные</w> согласные.",
                                "zh": "在英语中，字母 p、b 和 t 代表<w>爆破性的</w>辅音。"
                            }
                        },
                        {
                            "text": "The student studied the difference between <w>explosive</w> and fricative sounds.",
                            "target_lang_translations": {
                                "ru": "Студент изучал разницу между <w>взрывными</w> и фрикативными звуками.",
                                "zh": "这名学生研究了<w>爆破性的</w>辅音和擦音之间的区别。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plosive"
                    ],
                    "antonyms": [
                        "implosive"
                    ],
                    "common_phrases": [
                        "explosive consonant",
                        "explosive sound"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к смычным согласным звукам, при произнесении которых происходит резкий выход воздуха.",
                        "zh": "指一种辅音，其发音方式是先完全阻断气流，再突然释放。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взрывной",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爆破性的",
                                "target_lang_sense_clarification": "语言学术语，指与爆破音有关的"
                            },
                            {
                                "target_lang_word": "塞音的",
                                "target_lang_sense_clarification": "语言学术语，也可指塞音性质的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c3726827-fbaa-3a22-858e-f9e0a940afb2",
                    "sense_definition": "A substance that can be made to explode.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "literal_explosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The demolition crew used powerful <w>explosives</w> to bring down the old bridge.",
                            "target_lang_translations": {
                                "ru": "Команда по сносу использовала мощную <w>взрывчатку</w>, чтобы обрушить старый мост.",
                                "zh": "拆除队用强力<w>炸药</w>炸塌了那座旧桥。"
                            }
                        },
                        {
                            "text": "Airport security is trained to detect hidden <w>explosives</w> in luggage.",
                            "target_lang_translations": {
                                "ru": "Служба безопасности аэропорта обучена обнаруживать спрятанную <w>взрывчатку</w> в багаже.",
                                "zh": "机场安检人员接受过识别行李中隐藏<w>爆炸物</w>的训练。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "high explosives",
                        "plastic explosives"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, которое может взорваться.",
                        "zh": "一种可以被引爆的物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взрывчатка",
                                "target_lang_sense_clarification": "разговорное, общее название"
                            },
                            {
                                "target_lang_word": "взрывчатое вещество",
                                "target_lang_sense_clarification": "официальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爆炸物",
                                "target_lang_sense_clarification": "常见说法，可泛指能引爆的物质或装置中的爆炸材料"
                            },
                            {
                                "target_lang_word": "炸药",
                                "target_lang_sense_clarification": "常用于工程、军事、拆除等语境"
                            },
                            {
                                "target_lang_word": "爆炸性物质",
                                "target_lang_sense_clarification": "较正式的技术或法律用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5d31735-2897-3375-a008-23d9657a9df8",
                    "sense_definition": "A consonant sound produced by stopping the airflow and then releasing it suddenly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics_plosive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The linguist analyzed the pronunciation of <w>explosives</w> in the local dialect.",
                            "target_lang_translations": {
                                "ru": "Лингвист проанализировал произношение <w>взрывных согласных</w> в местном диалекте.",
                                "zh": "那位语言学家分析了当地方言中<w>爆破音</w>的发音。"
                            }
                        },
                        {
                            "text": "Sounds like k and g are classified as <w>explosives</w>.",
                            "target_lang_translations": {
                                "ru": "Звуки, такие как к и г, классифицируются как <w>взрывные</w>.",
                                "zh": "像 k 和 g 这样的音被归类为<w>爆破音</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plosive"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Согласный звук, образуемый путем прерывания воздушного потока и его резкого высвобождения.",
                        "zh": "一种通过先阻断气流、再突然释放而发出的辅音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взрывной согласный",
                                "target_lang_sense_clarification": "фонетика"
                            },
                            {
                                "target_lang_word": "эксплозив",
                                "target_lang_sense_clarification": "специальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爆破音",
                                "target_lang_sense_clarification": "常见语言学术语"
                            },
                            {
                                "target_lang_word": "塞音",
                                "target_lang_sense_clarification": "较正式的语音学术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}