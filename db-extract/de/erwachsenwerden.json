                "senses": [
                    {
                        "sense_id": "00cd491a-f11e-3ae1-a63d-9d08880f8d11",
                        "entry_id": "97bce050-8c1e-3142-9cf4-7fb53d9205d0",
                        "glosses": [
                            "Vorgang der Entwicklung zum ausgewachsenen Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1472f2c-a3a7-4bd7-8b4b-e69102849211",
                                "sense_id": "00cd491a-f11e-3ae1-a63d-9d08880f8d11",
                                "text": "„Doch mit dem Erwachsenwerden werden die Ängste nicht weniger, im Gegenteil, auch sie wachsen.“"
                            },
                            {
                                "example_id": "b96543e2-7fbd-4931-be3e-5c7e8615b20b",
                                "sense_id": "00cd491a-f11e-3ae1-a63d-9d08880f8d11",
                                "text": "„Beim Erwachsenwerden müssen Jugendliche große Herausforderung meistern.“"
                            },
                            {
                                "example_id": "df7bda14-1558-433e-9e06-17be8f2a1360",
                                "sense_id": "00cd491a-f11e-3ae1-a63d-9d08880f8d11",
                                "text": "„Die katholische Kirche kennt nach der Erstkommunion noch die Firmung. Die Jugendweihe ist, etwas allgemeiner, eine Feier des Übergangs von der Kindheit zum Erwachsenwerden, ausdrücklich ohne religiösen Bezug.“"
                            },
                            {
                                "example_id": "29bb0f89-48c0-49e2-a74c-e2eb392afd41",
                                "sense_id": "00cd491a-f11e-3ae1-a63d-9d08880f8d11",
                                "text": "„Es war ja unvermeidlich, dass beim Erwachsenwerden die Unschuld verschwandt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
