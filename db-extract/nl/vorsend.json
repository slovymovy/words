        "nl-extract.jsonl": [
            {
                "entry_id": "ad512e7c-4fd7-3609-b1f6-5f409fa10c0b",
                "word": "vorsend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0508707e-4e2b-3f45-8b3f-efd48eb040d2",
                        "entry_id": "ad512e7c-4fd7-3609-b1f6-5f409fa10c0b",
                        "glosses": [
                            "bezig met iets te onderzoeken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84bf38cc-239d-466c-a4b8-0745384c4730",
                                "sense_id": "0508707e-4e2b-3f45-8b3f-efd48eb040d2",
                                "text": "Een vorsende blik onder borstelwenkbrauwen en een geprononceerde kin. Dat karakteriseert het beeld dat Harm Agteresch liet maken van de schrijver Belcampo. De grote vraag is: waar moet het staan?"
                            },
                            {
                                "example_id": "96e1f247-91e4-4135-81db-620e8b3e1565",
                                "sense_id": "0508707e-4e2b-3f45-8b3f-efd48eb040d2",
                                "text": "Angela Merkel leunt dominant naar voren, Donald Trump heeft in een defensieve houding zijn armen over elkaar, de Japanse premier Shinzo Abe kijkt vorsend toe en de Britse premier May komt er nauwelijks aan te pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eda7fbdc-8bb7-4fd0-b724-806a9ac9e737",
                        "source_entry_id": "ad512e7c-4fd7-3609-b1f6-5f409fa10c0b",
                        "source_sense_id": "0508707e-4e2b-3f45-8b3f-efd48eb040d2",
                        "source_sense_description": "bezig met iets te onderzoeken",
                        "target_lang_word": "searching",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "searching",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3463e3ea-d42d-386e-aaf6-bbd1babb92d5",
                                        "entry_id": "d0abd981-9b81-3a77-96e6-bfba35446e0b",
