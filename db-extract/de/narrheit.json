                ],
                "senses": [
                    {
                        "sense_id": "d376d3d5-7ec7-3f1d-8270-400d9d557e39",
                        "entry_id": "631aadef-cb37-3d1f-b229-8b137180e3e4",
                        "glosses": [
                            "Zustand des Unwissens; mangelnde Intelligenz"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "cff72642-6434-4df5-9fa1-b18cc93d6ceb",
                                "sense_id": "d376d3d5-7ec7-3f1d-8270-400d9d557e39",
                                "text": "Bei seiner Narrheit wundert mich die 6 in der Matheprüfung nicht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6bcc3180-c643-3923-a155-bcb6acb0531a",
                        "entry_id": "631aadef-cb37-3d1f-b229-8b137180e3e4",
                        "glosses": [
                            "unüberlegte, dumme, närrische Tat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57e5fda1-3e22-4f44-a35c-ca06aca7065c",
                                "sense_id": "6bcc3180-c643-3923-a155-bcb6acb0531a",
                                "text": "In manchen Ländern kommen Jungen ins Gefängnis für Dinge, die wir als kleine Narrheiten abtun würden."
                            },
                            {
                                "example_id": "cf9948cc-f3c8-44e2-9ad6-c10190274ef2",
                                "sense_id": "6bcc3180-c643-3923-a155-bcb6acb0531a",
                                "text": "„Nicht selten erschöpft er sich in Schilderungen von Situationskomik, Prügelszenen, Häufungen von Narrheiten und Ungeschicklichkeiten.“"
                            },
                            {
                                "example_id": "27b5e336-821f-490c-9532-6bc4a5378542",
                                "sense_id": "6bcc3180-c643-3923-a155-bcb6acb0531a",
                                "text": "„Ich blieb unnachgiebig; Madame d'Urfé ihrerseits lachte über die Narrheiten ihrer angeblichen Nichte und zeigt sich sehr erfreut, als sie mich ihr gegenüber und den Schützling des mächtigen Selenis neben sich sitzen sah.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6282af0f-25b5-48ba-a0eb-5e35c5108211",
                        "source_entry_id": "631aadef-cb37-3d1f-b229-8b137180e3e4",
                        "source_sense_id": "d376d3d5-7ec7-3f1d-8270-400d9d557e39",
                        "source_sense_description": "kein Plural: Zustand des Unwissens; mangelnde Intelligenz",
                        "target_lang_word": "follia",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "follia",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "4a6dbc43-bd33-35d6-8650-41e33fefae17",
                                        "entry_id": "86186acf-1e6c-3ab0-a752-054b2a191261",
                                        "glosses": [
                                            "acuta malattia psichica che conduce alla smarrimento della ragione"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3fa3d63-6906-4023-87f7-5b306a8a9a89",
                                                "sense_id": "4a6dbc43-bd33-35d6-8650-41e33fefae17",
                                                "text": "la follia differisce dal delirio ed ancor più dalla pazzia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "737757e4-f495-3c30-9158-b6522db45102",
                                        "entry_id": "86186acf-1e6c-3ab0-a752-054b2a191261",
                                        "glosses": [
                                            "\\\"annullamento\\\" per inconciliabilità di uno o più elementi, anche riguardanti la logica e/o la razionalità"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69a84d99-457e-4b33-b427-d8a22675decd",
                                                "sense_id": "737757e4-f495-3c30-9158-b6522db45102",
                                                "text": "incapace di fare male alcuno, mi vidi costretto a provare la follia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30dbe104-93a3-3a85-9169-2d52bd64ef42",
                                        "entry_id": "86186acf-1e6c-3ab0-a752-054b2a191261",
                                        "glosses": [
                                            "il confondere, in modo assiduo e spesso irrisolvibile, elementi senza inerenza e/o assumere comportamenti non conformi alla realtà etica, morale e/o civile; mancanza di discernimento; incapacità di cogliere il vero/la verità"
                                        ],
