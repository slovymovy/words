                "senses": [
                    {
                        "sense_id": "d21599d2-eaf0-33d8-a631-7e99be3060b5",
                        "entry_id": "370e346d-65e0-3829-a75e-a4328a1fc566",
                        "glosses": [
                            "Qui est doté de fortes hanches."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "853b7396-4dd9-48d7-8ef9-74891c3c71b5",
                                "sense_id": "d21599d2-eaf0-33d8-a631-7e99be3060b5",
                                "text": "Babette Manapoux devint en quelques années une énorme commère, démesurément hanchue et mamelue, aux bras craquelés par les lessives."
                            },
                            {
                                "example_id": "1c269b34-1b71-4626-ac8a-1162f5b81722",
                                "sense_id": "d21599d2-eaf0-33d8-a631-7e99be3060b5",
                                "text": "J'avoue l'ennui sans fond éprouvé devant ce conclave de mémères fessues, hanchues, cuissues et mamelues."
                            },
                            {
                                "example_id": "7682450f-fd9a-4216-b3db-fdd7fc70cbdf",
                                "sense_id": "d21599d2-eaf0-33d8-a631-7e99be3060b5",
                                "text": "La Française apparut bientôt, coiffée d'un véritable jardin d'agrément, corsetée comme une guêpe, hanchue comme une impératrice. L'idéal de la ligne féminine étant alors cet objet qu'on appelait diabolo, elle était parfaite."
                            }
                        ]
                    }
                ],
