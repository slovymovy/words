                "translations": [
                    {
                        "translation_id": "aa0e0d29-fe8b-4f55-9353-c23cfb211a3c",
                        "source_entry_id": "c032da1c-bd09-38ee-9d8a-bc75bc6b5ac9",
                        "source_sense_id": "14658248-fd64-3771-85f1-15c4a933dd8a",
                        "source_sense_description": "größeres Brandereignis in einem Gebiet, in dem vorwiegend niedrige Gehölze wachsen",
                        "target_lang_word": "brushfire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brushfire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "578cfccf-5c4c-382e-8079-1a4125c4ccf5",
                                        "entry_id": "1fbb5e34-cfec-369e-884e-de417cd82409",
                                        "glosses": [
                                            "A large fire in a scrubland or prairie, as opposed to a forest fire, which occurs in forests."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6959e3f-8732-35fe-8fe2-3d4045f0363c",
                                        "entry_id": "1fbb5e34-cfec-369e-884e-de417cd82409",
                                        "glosses": [
                                            "A war that arises suddenly and is limited in scope or area."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52a19d02-f7d5-4acb-8b99-e8d4d7604476",
                                                "sense_id": "e6959e3f-8732-35fe-8fe2-3d4045f0363c",
                                                "text": "It may be a brushfire operation or an operation on the scale of the Korean war; it will certainly not involve the home territories of the United States and Soviet Russia as theaters of hostilities."
                                            },
                                            {
                                                "example_id": "6628a3ce-7a11-4d36-9f90-b50330b919d2",
                                                "sense_id": "e6959e3f-8732-35fe-8fe2-3d4045f0363c",
                                                "text": "I grant you it may not be in the actual application of mechanical devices, but if you have the volume to have supremacy in a major war it is obvious you would have the volume to take care of a brushfire war."
                                            },
                                            {
                                                "example_id": "7f3aa3b2-5485-433c-be23-7dd63bafc1e8",
                                                "sense_id": "e6959e3f-8732-35fe-8fe2-3d4045f0363c",
                                                "text": "If a brushfire conflict does threaten superpower interests, or the general peace, a superpower may intervene in an unusual way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
