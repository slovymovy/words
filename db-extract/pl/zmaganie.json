                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3d17436-e6ee-432b-a10e-0e0a057ed1c0",
                        "source_entry_id": "aeec2043-a3d0-378b-80e9-169d57f0794c",
                        "source_sense_id": "072bcefa-72ac-3cbf-ab58-1eb26c9c402a",
                        "target_lang_word": "wrestle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wrestle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1768ad55-c358-35e4-a8c9-bec8df842ce8",
                                        "entry_id": "94a826e8-f44a-3857-9d54-0ad4200c01fc",
                                        "glosses": [
                                            "To take part in (a wrestling bout or match)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e9865fc-824c-4a5b-a294-0884d34eebe5",
                                                "sense_id": "1768ad55-c358-35e4-a8c9-bec8df842ce8",
                                                "text": "And novv Ptolemais being to vvreſtle her laſt fall, ſtripped her ſelf of all cumberſome clothes: vvomen, children, aged perſons, vveak folks […] vvere ſent avvay; […]"
                                            },
                                            {
                                                "example_id": "142272af-7485-4fdc-aea8-9b17b59e7364",
                                                "sense_id": "1768ad55-c358-35e4-a8c9-bec8df842ce8",
                                                "text": "Hark thee, friend, […] wilt thou wrestle a fall with me?"
                                            },
                                            {
                                                "example_id": "bd8c29df-b276-4033-9e6e-09fe39b664a6",
                                                "sense_id": "1768ad55-c358-35e4-a8c9-bec8df842ce8",
                                                "text": "Have we not wrestled a turn before now?"
                                            },
                                            {
                                                "example_id": "5c299905-9fd6-4e20-91e3-7d1874f309f3",
                                                "sense_id": "1768ad55-c358-35e4-a8c9-bec8df842ce8",
                                                "text": "Where is Kerkuon [Cercyon of Eleusis], the king of the city? I must wrestle a fall with him to-day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2581b958-0710-35d4-aef9-8bcb349ec87c",
                                        "entry_id": "94a826e8-f44a-3857-9d54-0ad4200c01fc",
                                        "glosses": [
                                            "Sometimes followed by down: to contend with or move (someone) into or out of a position by grappling; also, to overcome (someone) by grappling."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10591aef-02a7-4255-8d3a-505ad7731ecc",
                                                "sense_id": "2581b958-0710-35d4-aef9-8bcb349ec87c",
                                                "text": "My driver at the second station was a stout girl of twenty, strong enough to wrestle any man, but shy, modest, and gentle."
                                            },
                                            {
                                                "example_id": "457c6eef-7b09-45b1-9a1d-78ed7555aada",
                                                "sense_id": "2581b958-0710-35d4-aef9-8bcb349ec87c",
                                                "text": "Tunisia dug in to frustrate England in the second half but [Harry] Kane was the match-winner with a late header from Harry Maguire's flick, justice being done after referee Wilmar Roldan and the video assistant referee (VAR) had failed to spot him being wrestled to the ground twice in the penalty area."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dabd59ff-7a42-3ee8-af51-117bd217623b",
                                        "entry_id": "94a826e8-f44a-3857-9d54-0ad4200c01fc",
                                        "glosses": [
                                            "To move or manipulate (something) using physical effort, usually with some difficulty or opposition."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fb13664-2ca2-432f-b9fa-511f817fce35",
                                                "sense_id": "dabd59ff-7a42-3ee8-af51-117bd217623b",
                                                "text": "And, wrestling both his arms into a gown, / He paused and took a survey up and down."
                                            },
                                            {
                                                "example_id": "2644ae62-3d98-4375-85cc-b35779cdfd27",
                                                "sense_id": "dabd59ff-7a42-3ee8-af51-117bd217623b",
                                                "text": "And his brother, Robert, beat me to the ground along with Damon, I carried Damon down with me and when I got Damon to the floor I shot him and wrestled his pistol out of his hand and threw it in a corner and after that Robert wrestled my pistol out of my hand and held it on me and I asked what was going on here with you people, I said, 'You are crazy.'"
                                            },
                                            {
                                                "example_id": "0f9bd12c-e104-4f4e-aa94-9f1c4b6f07d5",
                                                "sense_id": "dabd59ff-7a42-3ee8-af51-117bd217623b",
                                                "text": "Federal Reserve officials raised interest rates to their highest level in 22 years and left the door open to further action as they continued their 16-month campaign to wrestle inflation lower by cooling the American economy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5fd6ef7-67bd-32a6-8986-bad5f7c83a94",
                                        "entry_id": "94a826e8-f44a-3857-9d54-0ad4200c01fc",
                                        "glosses": [
                                            "To engage in (a contest or struggle)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e761888f-fc24-326a-a727-5f07a383aba8",
                                        "entry_id": "94a826e8-f44a-3857-9d54-0ad4200c01fc",
                                        "glosses": [
                                            "To throw down (a calf or other livestock animal) for branding."
                                        ],
                                        "tags": [
                                            "US",
                                            "Western",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3dbe7a4a-0f8a-3a61-bea0-9683cca0fa2a",
                                        "entry_id": "94a826e8-f44a-3857-9d54-0ad4200c01fc",
                                        "glosses": [
                                            "To grapple or otherwise contend with an opponent in order to throw or force them to the ground, chiefly as a sport or in unarmed combat."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac4d8b48-2479-4ce8-b89b-e7a81e3e02cd",
                                                "sense_id": "3dbe7a4a-0f8a-3a61-bea0-9683cca0fa2a",
                                                "text": "Actiue they are in all things, whether it be to wraſtle in the games of Olympia, or to fight at Barriers in Paleſtra, able to cary as great burthens as Milo [of Croton], of ſthrength to throwe as bigge ſtones as Turnus, and what not, […]"
                                            },
                                            {
                                                "example_id": "3826d3f6-be0b-474b-98d6-7e70686b5c88",
                                                "sense_id": "3dbe7a4a-0f8a-3a61-bea0-9683cca0fa2a",
                                                "text": "[H]eere at the Pythique games, the manner is to bring in certeine champions at every ſeverall game or plaie: firſt boies to vvreſtle, and after them, men-vvreſtlers alſo; […]"
                                            },
                                            {
                                                "example_id": "19bfa2e1-7c5c-4b89-b10a-86529185b7c5",
                                                "sense_id": "3dbe7a4a-0f8a-3a61-bea0-9683cca0fa2a",
                                                "text": "Wreſtell nat with me for I wyll throwe the [thee] on thy backe […]"
                                            },
                                            {
                                                "example_id": "fd1f2ede-3ec2-44e6-93be-997bd6b5f967",
                                                "sense_id": "3dbe7a4a-0f8a-3a61-bea0-9683cca0fa2a",
                                                "text": "[Y]ee gaue their diligẽce [diligence] to lerne to fight, to wriſtle, to leape, to daunce, ⁊ to put at yͤ ſtone: […]"
                                            },
                                            {
                                                "example_id": "402ba8c2-43fe-482e-8c96-94a1dfc4c2de",
                                                "sense_id": "3dbe7a4a-0f8a-3a61-bea0-9683cca0fa2a",
                                                "text": "She [a manatee] woolde oftentymes play and wreſtle vppon the banke with the kynges chamberlens: And eſpecially with a younge man whom the kynge fauoured well, beinge alſo accuſtomed to feede her."
                                            },
                                            {
                                                "example_id": "7b431a34-150b-4f01-aa12-fe3e1b375dcd",
                                                "sense_id": "3dbe7a4a-0f8a-3a61-bea0-9683cca0fa2a",
                                                "text": "VVe vvraſtle not (after your Shepheards guiſe) / For painted Sheep-hooks, or ſuch pettie Prize, / Or for a Cage, a Lamb, or bread and cheeſe: / The Vanquiſht Head muſt be the Victors Fees."
                                            },
                                            {
                                                "example_id": "5dad8c7b-23f5-4b46-96f9-9c1cdad916bf",
                                                "sense_id": "3dbe7a4a-0f8a-3a61-bea0-9683cca0fa2a",
                                                "text": "And that you may be farther corroborated in your belief, conſider the manifold Stories of Apparitions, and hovv many Spectres have been ſeen or felt to vvraſtle, pull or tug vvith a man: vvhich, if they vvere a mere Congeries of Atomes, vvere impoſſible."
                                            },
                                            {
                                                "example_id": "6caae46b-982f-4321-9618-2de22003337b",
                                                "sense_id": "3dbe7a4a-0f8a-3a61-bea0-9683cca0fa2a",
                                                "text": "I am novv a laying in the fourth vveek, and I am ſtrong enough even to vvraſtle."
                                            },
                                            {
                                                "example_id": "5c1b9de7-d71b-4865-bcdb-2a9bbb03b594",
                                                "sense_id": "3dbe7a4a-0f8a-3a61-bea0-9683cca0fa2a",
                                                "text": "I am confident, were there a scene written, wherein Pinkethman should break his leg by wrestling with Bullock, and Dickey come in to set it, without one word said but what should be according to the exact rules of surgery in making this extension and binding up the leg, the whole house should be in a roar of applause at the dissembled anguish of the patient, the help given by him who threw him down, and the handy address and arch looks of the surgeon."
                                            },
                                            {
                                                "example_id": "ae4934d0-4fe9-470f-9899-466cc4b35f42",
                                                "sense_id": "3dbe7a4a-0f8a-3a61-bea0-9683cca0fa2a",
                                                "text": "He that vvreſtles vvith us ſtrengthens our nerves, and ſharpens our ſkill. Our antagoniſt is our helper."
                                            },
                                            {
                                                "example_id": "c05f2c9e-b2d4-4081-92c9-ea8687694a8b",
                                                "sense_id": "3dbe7a4a-0f8a-3a61-bea0-9683cca0fa2a",
                                                "text": "[H]e [Kerkuon or Cercyon of Eleusis] challenges all comers to wrestle with him, for he is the best wrestler in all Attica, and overthrows all who come; and those whom he overthrows he murders miserably, and his palace-court is full of their bones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7effec9-2b16-351a-81f6-9cfd22ae7267",
                                        "entry_id": "94a826e8-f44a-3857-9d54-0ad4200c01fc",
                                        "glosses": [
                                            "Followed by with: to move or manipulate something using physical effort, usually with some difficulty or opposition."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45bd6195-2c8a-4081-b440-d3524c2a34d0",
                                                "sense_id": "b7effec9-2b16-351a-81f6-9cfd22ae7267",
                                                "text": "It fits Ioues ſonne / VVraſtle vvith Lyons, and to tugge vvith Beares, / Grapple vvith Dragons, and incounter VVhales."
                                            },
                                            {
                                                "example_id": "19501738-a7e3-42e3-96e4-c0e4f2ce8514",
                                                "sense_id": "b7effec9-2b16-351a-81f6-9cfd22ae7267",
                                                "text": "But 'tis a thing of saintlier nature, / Amidst her friends of pigmy stature, / To see the maid in youth's fair bloom, / A guardian sister's charge assume, / […] / With her in mimick war they wrestle; / Beneath her twisted robe they nestle; […]"
                                            },
                                            {
                                                "example_id": "098e6f29-7454-4a4c-b9b1-f9a5dff4eeb5",
                                                "sense_id": "b7effec9-2b16-351a-81f6-9cfd22ae7267",
                                                "text": "I've spent this whole morning rassling with that dumb horse, Sam …"
                                            },
                                            {
                                                "example_id": "87390d6b-3472-44d2-8e02-a7ae24ee2366",
                                                "sense_id": "b7effec9-2b16-351a-81f6-9cfd22ae7267",
                                                "text": "Miss Reba turned to Boon again. \"What you been doing? wrassling with hogs?\" / \"We got in a mudhole back down the road. We drove up. The automobile's outside now.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26314bcf-56ba-366c-a959-a93a2aa9b134",
                                        "entry_id": "94a826e8-f44a-3857-9d54-0ad4200c01fc",
                                        "glosses": [
                                            "To make one's way or move with some difficulty or effort."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ff55540-f548-4ef1-9079-33eac3cec6ee",
                                                "sense_id": "26314bcf-56ba-366c-a959-a93a2aa9b134",
                                                "text": "[S]o great a ſtorme of vvind and raine beat vpon vs that vvee not only loſt our vvay, but our ſelues, and at length vvraſtled to Geer, hauing firſt paſt through the Straits of Mozendram."
                                            },
                                            {
                                                "example_id": "7146a94e-3709-4147-801f-26d26e23f294",
                                                "sense_id": "26314bcf-56ba-366c-a959-a93a2aa9b134",
                                                "text": "[T]hy Lips, […] their tvvo-leav'd Door / So cloſe they ſhut, that […] not Breath it ſelfe, has povver to bore / Its vvay, but forced is to goe about, / And through the Noſes Sluces vvreſtle out."
                                            },
                                            {
                                                "example_id": "0616de94-2953-4874-9112-657325ed6a04",
                                                "sense_id": "26314bcf-56ba-366c-a959-a93a2aa9b134",
                                                "text": "These fires are or were singularly destructive in villages—the flames running from thatch to thatch, and, as they express it, ‘wrastling’ across the intervening spaces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                        "entry_id": "94a826e8-f44a-3857-9d54-0ad4200c01fc",
                                        "glosses": [
                                            "Followed by against or with: to contend, to struggle; to exert effort, to strive."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85830fa7-27f4-4f43-b07e-5a2675ae508c",
                                                "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                                "text": "Put on the arms of our god⸝ that ye maye ſtonde ſtedfaſt agaynſt the crafty aſſautes off the devyll. For we wreſtle not agaynſt fleſſhe and bloud: but agaynſt ruele⸝ agaynſt power⸝ and agaynſt worldy ruelars of the darcknes of this worlde⸝ agaynſt ſpretuall wickednes in hevenly thyngꝭ [thyngis]."
                                            },
                                            {
                                                "example_id": "a85b618f-c24b-468f-bb53-72da371dda64",
                                                "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                                "text": "As to the mother, she spent the night like Jacob at Peniel. Till break of day, she wrestled with God in earnest prayer."
                                            },
                                            {
                                                "example_id": "1a1ecc28-2e2c-4e52-99d0-6f97f7b3d89f",
                                                "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                                "text": "For kyng Henry [VI], diſcended of the houſe of Lancaſtre, claymyng the croune from kyng Henry the .iiii. his graund father, firſt author of this diuiſion: and Rychard duke of Yorke, as heyre to Lionell, the third ſonne to kyng Edward the third: wreſteled for the game, and ſtroue for the wager."
                                            },
                                            {
                                                "example_id": "ca672b90-60d7-47ae-8872-286a8dbc1c19",
                                                "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                                "text": "And thus go theſe Prelates about to vvreſtle for honour, that it may be reported abroad, that vve breed hereſies againſt ourſelves."
                                            },
                                            {
                                                "example_id": "2a3b75f8-2305-4118-ae14-8eb95925d00d",
                                                "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                                "text": "[T]hey their ſhips in marble ſeas with ores dyd wraſtlyng towe."
                                            },
                                            {
                                                "example_id": "878f1fe5-850b-4733-90e6-6299feb8d31a",
                                                "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                                "text": "[I]f it be a difficult piece of vvorke to vvreſtle vvith the bellie, vvhich (as Cato [the Elder] vvas vvont to ſay) hath no eares; vve muſt vvorke another feat and device vvith it; namely, by obſerving the quality of the viands, to make the quantity more light and leſſe offenſive: […]"
                                            },
                                            {
                                                "example_id": "68da63c3-95b7-475a-9047-d8838932b09f",
                                                "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                                "text": "[…] I vvould haue the Reader to remember, that I haue in this vvorke vvraſtled vvith that envious and ravenous enemy, Time, […]"
                                            },
                                            {
                                                "example_id": "a98e7f69-0061-436c-a1c5-6d9894e0b818",
                                                "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                                "text": "Like errand Knights, our valiant vvits muſt vvraſtle / To free our Ladyes from the inchanted Caſtle."
                                            },
                                            {
                                                "example_id": "5a27422c-9c0b-4199-a4cd-655e1d627102",
                                                "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                                "text": "[H]e [the Earl of Essex] vvas to vvraſtle vvith a Queens declyning, or rather vvith her very ſetting Age (as vve may term it,) vvhich, beſides other reſpects, is commonly even of it ſelfe the more umbratious and apprehenſive, as for the moſt part all Horizons are charged vvith certain Vapours tovvards their Evening."
                                            },
                                            {
                                                "example_id": "a7ece177-57aa-4fab-8d54-f83861bc5565",
                                                "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                                "text": "Venice vvreſtleth vvith the Turk, and is like to loſe her Maidenhead unto him, unleſs other Chriſtian Princes look to it in time: […]"
                                            },
                                            {
                                                "example_id": "200f02e9-abd6-4ca9-bdf9-22fdd8db1aa9",
                                                "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                                "text": "[…] I look on yon unfortunate Iſland, as if one look upon a Ship toſs'd up and dovvn in diſtreſſe of vvind and vveather, by a furious tempeſt, vvhich the more ſhe tugs and vvraſtles vvith the foamie vvaves of the angry Ocean, the more the fury of the ſtorme encreaſeth, and puts her in danger of ſhipvvrack; […]"
                                            },
                                            {
                                                "example_id": "e6e91bae-9b26-4e5f-b827-0f19e3af2fa6",
                                                "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                                "text": "[W]e have prayed, and wrestled, and petitioned, for an offering to atone the sins of the congregation,, and, lo! the very head of the offence is delivered into our hand."
                                            },
                                            {
                                                "example_id": "08e367a4-9394-4163-9ae6-084690125179",
                                                "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                                "text": "You will find near this place, if you follow not too tardily, a dead hare; eat, and be refreshed. Come on, my enemy; we have yet to wrestle for our lives, but many hard and miserable hours must you endure, until that period shall arrive."
                                            },
                                            {
                                                "example_id": "75a5e2f9-6fff-4670-b675-bd9abaf03d46",
                                                "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                                "text": "Thou [Jesus] wilt feel all, that Thou may'st pity all; / And rather wouldst Thou wrestle with strong pain, / Than overcloud thy soul, / So clear in agony."
                                            },
                                            {
                                                "example_id": "fd453292-6a0e-4c30-b636-dbf14e9cdf9e",
                                                "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                                "text": "These martyr souls wrestle for the truth, which they have a forecast of; they suffer for the God whom they love, and their whole life is the school of eternity."
                                            },
                                            {
                                                "example_id": "821f5580-ed5f-404e-810e-89643b508a55",
                                                "sense_id": "d6463130-a38b-33af-9156-4effa152e3e3",
                                                "text": "I had to wrestle with my self-respect when I submitted to be drawn to you in spite of Mr. Wrayburn. You may imagine how low my self-respect lies now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff2aba79-8c86-3700-aad2-f85e1536938f",
                                        "entry_id": "94a826e8-f44a-3857-9d54-0ad4200c01fc",
                                        "glosses": [
                                            "To contend verbally; to argue, to debate, to dispute."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b239ce35-62f8-41f5-b51a-f91241690d80",
                                                "sense_id": "ff2aba79-8c86-3700-aad2-f85e1536938f",
                                                "text": "[B]ecause […] they were loath to wrestle with the people, or force them from dangerous customs, they came from that supine negligence, in tolerating prayer for the dead, to establish a doctrinal point of purgatory; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55464ae6-1409-3136-9e71-4422598dac27",
                                        "entry_id": "94a826e8-f44a-3857-9d54-0ad4200c01fc",
                                        "glosses": [
                                            "To twist or wriggle; to writhe."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d45e950-97db-4c81-8b97-0425edb5eb51",
                                                "sense_id": "55464ae6-1409-3136-9e71-4422598dac27",
                                                "text": "But God (vvhen pleaſeth him) doth giue this ſtrength to man, / VVhereby he ſtandeth ſtout; euen like a mightie rocke / Amid the mounting vvaues vvhen Eole [Aeolus] doth vnlocke / Sterne Auſters ſtormie gate, making the vvaters vvraſtle / And ruſh vvith vvrathfull rage againſt the ſturdie caſtle, […]"
                                            },
                                            {
                                                "example_id": "65708f14-f649-4048-a463-ebcbe6265082",
                                                "sense_id": "55464ae6-1409-3136-9e71-4422598dac27",
                                                "text": "He saw the glebe land guiltless of a furrow; / He saw the wild oats wrestle on the hill; / He saw the gopher working in his burrow; / He saw the squirrel scampering at his will;— […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebea325c-5a17-3697-b7ca-946b5a16f66f",
                                        "entry_id": "94a826e8-f44a-3857-9d54-0ad4200c01fc",
                                        "glosses": [
                                            "Followed by with: to concern or occupy oneself closely, or deal with, a task, etc."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6402f767-7205-4c03-94a1-9930e958b145",
                                                "sense_id": "ebea325c-5a17-3697-b7ca-946b5a16f66f",
                                                "text": "Our hope is, that the yong Studient, vvho heretofore meeting at the firſt, and vvraſtling vvith as difficult termes and matter, as in many yeares after, vvas at the firſt diſcouraged (as many haue bin) may be reading theſe Inſtitutes, haue the difficultie and darkeneſſe both of the Matter and of the Termes and VVords of Art in the beginnings of his Studie facilitated, and explained vnto him, to the end hee may proceed in his Studie cheerefully, and vvith delight; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wrestle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8ae3dfb-94e9-3bca-aaaf-df2b56cfc02e",
                                        "entry_id": "39bb0264-1a91-380c-a75b-023d4cab0bf7",
                                        "glosses": [
                                            "A fight or struggle between people during which they grapple or otherwise contend with each other in order to throw or force their opponent to the ground, chiefly as a sport or in unarmed combat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0acd23d9-1936-4ff8-a932-3f2095add354",
                                                "sense_id": "c8ae3dfb-94e9-3bca-aaaf-df2b56cfc02e",
                                                "text": "[I]n a VVreſtle the Giant [Gogmagog] catching aloft, vvith a terrible hugg broke three of his Ribs: nevertheleſs Corineus enrag'd, heaving him up by main force, and on his Shoulders bearing him to the next high Rock, threvv him headlong all ſhatter'd into the Sea, and left his name on the Cliff, call'd ever ſince Langoëmagog, vvhich is to ſay, the Giants leap."
                                            },
                                            {
                                                "example_id": "80e1bff8-89fe-4088-9459-3290cd5bcb9d",
                                                "sense_id": "c8ae3dfb-94e9-3bca-aaaf-df2b56cfc02e",
                                                "text": "Beyond the tilt-yard spread the larger space, / For the strong wrestle and the breathless race; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff981406-828d-3443-9b1a-654c777abda3",
                                        "entry_id": "39bb0264-1a91-380c-a75b-023d4cab0bf7",
                                        "glosses": [
                                            "A situation in which people compete with each other; a contest, a struggle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1ec1eba-a073-4a27-8af8-c0d4d6fb293f",
                                                "sense_id": "ff981406-828d-3443-9b1a-654c777abda3",
                                                "text": "Both parties in the wrestle professing earnest wishes of peace to us, what have we to do with it except answer earnestly, \"Peace, yes certainly,\" and mind our affairs elsewhere. The British Nation has no concern with that indispensable sorrowful and shameful wrestle now going on everywhere in foreign parts."
                                            },
                                            {
                                                "example_id": "7f375bde-6a60-48f2-8d52-8599e7f20b99",
                                                "sense_id": "ff981406-828d-3443-9b1a-654c777abda3",
                                                "text": "The body politic, which, while it remained in repose, had presented a superficial appearance of health and vigour, was not under the necessity of straining every nerve in a wrestle for life or death, and was immediately found to be unequal to the exertion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be60bf23-f70b-30d7-be57-6c64a18d75be",
                                        "entry_id": "39bb0264-1a91-380c-a75b-023d4cab0bf7",
                                        "glosses": [
                                            "The action of contending or struggling."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33e564c9-eacb-4567-b68c-4592c6e9f2e9",
                                                "sense_id": "be60bf23-f70b-30d7-be57-6c64a18d75be",
                                                "text": "War in Italy, universal spasm of wrestle there, being now the expectation of foolish mankind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
