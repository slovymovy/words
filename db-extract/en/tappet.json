                ],
                "senses": [
                    {
                        "sense_id": "136e845e-fcc4-38e3-9f7c-a8291c81ed45",
                        "entry_id": "08476b52-8259-34af-a1bc-390dd0cd5373",
                        "glosses": [
                            "A lever or projection which is moved by some other piece, as a cam, or intended to tap or touch something else, in order to produce change or regulate motion."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68800fd0-f406-441c-a74d-603efc2d0cc2",
                        "source_entry_id": "08476b52-8259-34af-a1bc-390dd0cd5373",
                        "source_sense_id": "136e845e-fcc4-38e3-9f7c-a8291c81ed45",
                        "source_sense_description": "lever or projection intended to tap or touch something",
                        "target_lang_word": "suiveur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suiveur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88f780f1-3eb8-350b-be42-edff0aa0da18",
                                        "entry_id": "caa83420-5954-3cda-abd0-57945367bbd9",
                                        "glosses": [
                                            "Qui suit, en parlant notamment d’un véhicule qui accompagne une course sur route."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f70fe39c-c9f1-42f6-9bb4-d2e1ffd7346a",
                                                "sense_id": "88f780f1-3eb8-350b-be42-edff0aa0da18",
                                                "text": "Une voiture suiveuse."
                                            },
                                            {
                                                "example_id": "67c73a7b-fb78-4ee3-af4a-607015214af5",
                                                "sense_id": "88f780f1-3eb8-350b-be42-edff0aa0da18",
                                                "text": "Il attendit que l’auto suiveuse se soit arrêtée derrière son taxi et qu’en soient sortis deux de ses agresseurs de la Montagnola, pour regrimper hâtivement dans la voiture qu’il venait d’abandonner et donner l’ordre au chauffeur de le conduire dans la via San Vitale, au domicile du comte Matuzzi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "suiveur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fada19e9-ebda-32fd-ab73-3fe09f13d86c",
                                        "entry_id": "b40eb8b6-fdb3-3abb-adbf-ccf7820cacd6",
                                        "glosses": [
                                            "Celui qui suit quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e9a55fd-486c-4faf-85d0-b5f7db714a9a",
                                                "sense_id": "fada19e9-ebda-32fd-ab73-3fe09f13d86c",
                                                "text": "On ne pouvait jamais savoir avec les suiveurs, si c’étaient des flics ou des galants…"
                                            },
                                            {
                                                "example_id": "2a53eca8-633a-4309-8ca1-80540df6f313",
                                                "sense_id": "fada19e9-ebda-32fd-ab73-3fe09f13d86c",
                                                "text": "Du côté des suiveurs des Boks, « on s’attend à affronter la France en quarts », comme Hendrik Cronjé, journaliste à l’hebdomadaire sud-africain Rapport."
                                            },
                                            {
                                                "example_id": "fe2f2726-9358-4237-8796-3da2a3717e73",
                                                "sense_id": "fada19e9-ebda-32fd-ab73-3fe09f13d86c",
                                                "text": "Guidé par un homme fort à la tête du navire, le coach Vincent Euvrard, Dender a proposé un joli spectacle aux suiveurs avec 12 buts inscrits mais aussi 8 encaissés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "417dece8-d8e7-3be5-bdd5-ad0e78b0894f",
                                        "entry_id": "b40eb8b6-fdb3-3abb-adbf-ccf7820cacd6",
                                        "glosses": [
                                            "Personne ou entreprise qui imite un produit, une technique ou un service considéré comme dominant sur le marché."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70ea477e-531f-3d6c-a62b-2c9ed29b0969",
                                        "entry_id": "b40eb8b6-fdb3-3abb-adbf-ccf7820cacd6",
                                        "glosses": [
                                            "Conducteur de dépanneuse payé par un atelier de réparation automobile pour y ramener des voitures endommagées, parfois les frais de l’atelier en question ne sont pas couvert par l’assurance automobile."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Criminologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "379f839f-2e52-4731-b1a2-aa7992804410",
                                                "sense_id": "70ea477e-531f-3d6c-a62b-2c9ed29b0969",
                                                "text": "De nombreux « suiveurs » travaillent pour des ateliers de réparation automobile ou sont contrôlés par eux. Les compagnies d’assurance peuvent décider de ne pas faire affaire avec ces ateliers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33281bf7-d68d-39a1-9c64-ba86e8625741",
                                        "entry_id": "b40eb8b6-fdb3-3abb-adbf-ccf7820cacd6",
                                        "glosses": [
                                            "Type d’amplificateur électronique dont le signal sur l’émetteur suit le signal d’entrée, suiveur de tension ou (plus rare) suiveur de courant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f22ea2fb-64a9-4aaa-a4b8-28a99ce26c30",
                                                "sense_id": "33281bf7-d68d-39a1-9c64-ba86e8625741",
                                                "text": "Un montage suiveur permet de conserver le signal, tout en le tamponnant vis-à-vis de l'impédance de la charge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae9ad1a6-a0d4-3fa6-96a3-58185caa3750",
                                        "entry_id": "b40eb8b6-fdb3-3abb-adbf-ccf7820cacd6",
                                        "glosses": [
                                            "Mécanisme mis en mouvement rectiligne par une came."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb2fbfc2-aff6-403d-bb80-47b758b62e0c",
                                                "sense_id": "ae9ad1a6-a0d4-3fa6-96a3-58185caa3750",
                                                "text": "La solution la plus répandue est constituée d'un cylindre de rayon variable entraîné en rotation par un arbre. La pièce en contact avec le profil de la came, le suiveur, est alors mis en mouvement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1fb0b18-e5e3-3fc3-8f48-2295c15da2ef",
                                        "entry_id": "b40eb8b6-fdb3-3abb-adbf-ccf7820cacd6",
                                        "glosses": [
                                            "Personne sans ambition ni imagination qui se contente de suivre les autres."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25a24c70-7470-4a63-9c93-a7d578736441",
                                                "sense_id": "c1fb0b18-e5e3-3fc3-8f48-2295c15da2ef",
                                                "text": "Enfin, s’il avait eu une paire de couilles digne de ce nom… Mais de couilles il n’avait point. Un veule. Rien qu’un fichu suiveur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
