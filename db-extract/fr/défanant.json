                        "glosses": [
                            "Substance phytosanitaire qui permet de défaner une culture ou une végétation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8de70ed8-07d2-4e5d-b702-0b71fef57acf",
                                "sense_id": "8b8bbfbc-b62a-3a14-98d8-cfa97a907e08",
                                "text": "Pour de nombreux cas, on peut utiliser la technique du faux semis, préparation du lit de semences trois semaines avant semis qui a lieu dans la levée des mauvaises herbes qui sont traitées avant l'émergence du semis avec un défanant."
                            },
                            {
                                "example_id": "5c3e799d-f700-404e-98b0-88bdfe20ec31",
                                "sense_id": "8b8bbfbc-b62a-3a14-98d8-cfa97a907e08",
                                "text": "Le défanant REGLONE n’a aucun effet sur la germination des graines des cultures dont on prévoit vendre les semences."
                            }
                        ]
                    }
