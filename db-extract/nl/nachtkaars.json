                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachtlicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9399912-b783-31ab-96c4-2ea2cf25c9c6",
                                        "entry_id": "43cc5833-28ff-3f5e-a02b-f456f396006f",
                                        "glosses": [
                                            "stark gedämpfte Lichtquelle, die nachts in Treppenhäusern oder Fluren der Orientierung in der Dunkelheit dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b5400e7-ca94-42e4-adfb-55da173d8963",
                                                "sense_id": "a9399912-b783-31ab-96c4-2ea2cf25c9c6",
                                                "text": "Dieses Nachtlicht ist mit einem Bewegungsmelder ausgestattet."
                                            },
                                            {
                                                "example_id": "b4645dea-801b-4262-aba9-df95d2f1a5c5",
                                                "sense_id": "a9399912-b783-31ab-96c4-2ea2cf25c9c6",
                                                "text": "„Sophie folgte mir auf den Korridor, wo vor einem von Tante Praskovias Heiligenbildern ein harmloses Nachtlicht ruhig weiterbrannte.“"
                                            },
                                            {
                                                "example_id": "3cf6ce9f-2bcf-4939-a204-d49017a65655",
                                                "sense_id": "a9399912-b783-31ab-96c4-2ea2cf25c9c6",
                                                "text": "„Als Mutter und Sohn den Fußstapfen ihres Vaters im bleichen glänzenden Nachtlichte eine lange Weile gefolgt waren, hörten sie das Todesröcheln des verwundeten Häuptlings.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7887948a-a111-41ae-b49a-28918517c1d4",
                        "source_entry_id": "5c4768d9-c7a3-322b-ac3e-4bda1b198fcf",
                        "source_sense_id": "6a65efe5-eb22-3d8b-b32c-3ec8d8521ebe",
                        "source_sense_description": "een kaars waarmee men naar bed gaat en die men laat opbranden",
                        "target_lang_word": "nightlight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nightlight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b2df461-b394-36ae-a09b-176bbf6e1b6f",
                                        "entry_id": "13a9d368-ff58-3c7a-aa14-0da2e672e859",
                                        "glosses": [
                                            "a small, dim light or lamp left on overnight"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bb567ff-3528-49fa-b75c-8ac8bc44b130",
                                                "sense_id": "5b2df461-b394-36ae-a09b-176bbf6e1b6f",
                                                "text": "She had brought in with her the night-light that had been burning outside her door. She blew it out."
                                            },
                                            {
                                                "example_id": "0ff3df5c-8a45-4474-9f98-9203bf353ac8",
                                                "sense_id": "5b2df461-b394-36ae-a09b-176bbf6e1b6f",
                                                "text": "They made you give up / your nightlight / and your teddy / and your thumb."
                                            },
                                            {
                                                "example_id": "bc2cd6c7-6571-487e-8926-91642a891562",
                                                "sense_id": "5b2df461-b394-36ae-a09b-176bbf6e1b6f",
                                                "text": "1988, Joseph Brodsky, \"Gorbunov and Gorchakov\" Canto 13 in In Urania, New York: Farrar, Straus and Giroux, p. 165,\nYour light cannot drive off the dark from me— / not any more than night-lights by the bed / drive off my dreams."
                                            },
                                            {
                                                "example_id": "847e1cee-03b1-4f8f-9a9f-ed5bb7014c50",
                                                "sense_id": "5b2df461-b394-36ae-a09b-176bbf6e1b6f",
                                                "text": "He put a small nightlight in the bathroom to find his way around in the dark."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5d79c56-20e2-3449-8a9a-574d4b8e6235",
                                        "entry_id": "13a9d368-ff58-3c7a-aa14-0da2e672e859",
                                        "glosses": [
                                            "light that shines at night such as moonlight, starlight, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed5090e0-9a1b-48e5-ac6b-414b9df5659a",
                                                "sense_id": "a5d79c56-20e2-3449-8a9a-574d4b8e6235",
                                                "text": "The floor-cloth deadened his footsteps as he moved in that direction through the obscurity, which was broken only by the faintest reflected night-light from without."
                                            },
                                            {
                                                "example_id": "57264872-2049-4593-8b34-dc08609b3aba",
                                                "sense_id": "a5d79c56-20e2-3449-8a9a-574d4b8e6235",
                                                "text": "[…] the man held up two small objects faintly twinkling in the nightlight;"
                                            },
                                            {
                                                "example_id": "87b317ce-b978-4b6a-8164-6189fe12ace3",
                                                "sense_id": "a5d79c56-20e2-3449-8a9a-574d4b8e6235",
                                                "text": "Their made-up faces were garish in the night-light and as they walked they stared fixedly ahead, afraid to make a sideways glance in case it should be called soliciting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
