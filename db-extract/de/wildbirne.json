                    {
                        "sense_id": "84519193-fbf5-39b0-af00-16edbe05dcc6",
                        "entry_id": "1617890f-06c3-3877-a13e-2d170dbf2a0c",
                        "glosses": [
                            "Eine Obstbaumart (wissenschaftlicher Name: Pyrus pyraster)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6292360e-2b47-4e83-8172-3e04875c3559",
                                "sense_id": "84519193-fbf5-39b0-af00-16edbe05dcc6",
                                "text": "Die Wildbirne ist ein vom Aussterben bedrohter Baum."
                            },
                            {
                                "example_id": "36bbe502-4d26-4e8d-b751-436085422378",
                                "sense_id": "84519193-fbf5-39b0-af00-16edbe05dcc6",
                                "text": "Der Baum des Jahres 1998 war die Wildbirne."
                            },
                            {
                                "example_id": "0b72d462-23b5-4e85-840a-64ccd0d03678",
                                "sense_id": "84519193-fbf5-39b0-af00-16edbe05dcc6",
                                "text": "Wegen des permanenten Kreuzungskontaktes der Wild- und Kulturformen stellt sich die Frage, ob es \"die\" Wildbirne überhaupt noch gibt oder nur noch wildnahe Formen."
                            }
                        ],
