                "senses": [
                    {
                        "sense_id": "cf7d63e7-80fa-3900-94ed-36b8cfd84075",
                        "entry_id": "15b144cc-4679-34b3-b260-a0945587ca61",
                        "glosses": [
                            "Spielgeschehen, das auf einem größeren Areal, einer einladenden Fläche stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d5abaf4-26e4-4a34-8d96-4c542c89a642",
                                "sense_id": "cf7d63e7-80fa-3900-94ed-36b8cfd84075",
                                "text": "„Vor der Einführung in sogenannte Geländespiele sollte das Gelände selbst den Spielpädagogen bekannt sein.“"
                            },
                            {
                                "example_id": "34e8d6fa-60c0-41bb-a35c-e6d891eb3780",
                                "sense_id": "cf7d63e7-80fa-3900-94ed-36b8cfd84075",
                                "text": "„Ich erwartete, daß dieses Spiel den Kindern besonders Spaß machen würde, denn sie hatten sich ein Geländespiel gewünscht.“"
                            },
                            {
                                "example_id": "86e9d74a-9cd3-47ef-a370-e4f5698f51a6",
                                "sense_id": "cf7d63e7-80fa-3900-94ed-36b8cfd84075",
                                "text": "„Geländespiele, Keilereien, Schlachten zwischen Gruppe und Gruppe, Bund und Bund wurden gerne durch Bilder aus einer romantischen Phantasiewelt überhöht."
                            },
                            {
                                "example_id": "7f62fcb4-cbec-4c24-b936-87923f0db349",
                                "sense_id": "cf7d63e7-80fa-3900-94ed-36b8cfd84075",
                                "text": "„Die Kesselschlacht ist ein Geländespiel.“"
                            },
                            {
                                "example_id": "37fe2ac9-1dde-4fe6-a898-723762c0c174",
                                "sense_id": "cf7d63e7-80fa-3900-94ed-36b8cfd84075",
                                "text": "„Aber wenn man dann angekommen war, am See, beim Geländespiel, an der Feuerstelle, am Sandhang, dann konnte man in aller Ruhe die eigenen Spiele erfinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
