                    {
                        "translation_id": "36bb984e-ac82-4072-8ae3-d6d79bb70851",
                        "source_entry_id": "96c88db2-55f4-344e-a415-35ef78ee14eb",
                        "source_sense_id": "b5065c08-811f-368b-8b46-a7e4622abc0c",
