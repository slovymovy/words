                ],
                "senses": [
                    {
                        "sense_id": "59a1c8a3-c511-35ad-9fc2-a41a5cfee2a9",
                        "entry_id": "df3c227c-0279-3280-9607-cb2bb539bd81",
                        "glosses": [
                            "gemakkelijke, losjes zittende broek met een elastieken band, om mee te kunnen joggen, e.d."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6ee29a9-e3c6-4f67-8569-1e40de98efce",
                                "sense_id": "59a1c8a3-c511-35ad-9fc2-a41a5cfee2a9",
                                "text": "Een joggingbroek zit lekker makkelijk en kan zeker in Almelo ook gedragen worden zonder dat met aan sport doet."
                            },
                            {
                                "example_id": "2e30d4bf-cccd-4225-8364-0a5f5d3aa886",
                                "sense_id": "59a1c8a3-c511-35ad-9fc2-a41a5cfee2a9",
                                "text": "Die hoefde ik alleen maar te vinden om haar te vinden, in verhuis-T-shirt en joggingbroek, haar lange donkere haar in een praktisch knotje en misschien met een lik verf op haar neus, zoals in televisiereclames voor jonge gelukkige stellen, tussen de dozen in een huis dat altijd zonnig zou zijn en waar het leven zou beginnen."
                            },
                            {
                                "example_id": "8b118735-9f0d-43de-a3f8-77591df3767a",
                                "sense_id": "59a1c8a3-c511-35ad-9fc2-a41a5cfee2a9",
                                "text": "Want laten we eerlijk zijn; niets zit comfortabeler dan een joggingbroek. Die G Star-spijkerbroek knijpt in het kruis en dat Agnès B-colbert kruipt in de oksel, maar de joggingbroek valt als gegoten om ieders bips."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a9454c4-3e7d-45ce-9924-8eb5a7ef2d04",
                        "source_entry_id": "df3c227c-0279-3280-9607-cb2bb539bd81",
                        "source_sense_id": "59a1c8a3-c511-35ad-9fc2-a41a5cfee2a9",
                        "target_lang_word": "Jogginghose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jogginghose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04a4e9a9-5575-38f4-9427-b4df022e087a",
                                        "entry_id": "d5724aae-14b8-300b-b1a1-1386ba752452",
                                        "glosses": [
                                            "bequeme, legere Hose, die in der Freizeit oder beim Sport getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c975b0e2-0e23-46ee-b9b6-af01516d2c40",
                                                "sense_id": "04a4e9a9-5575-38f4-9427-b4df022e087a",
                                                "text": "Er trägt sonntagabends immer Jogginghosen, weil sie sehr bequem sind."
                                            },
                                            {
                                                "example_id": "f5fee0cd-7b25-463b-a182-6ca6d9c77ac5",
                                                "sense_id": "04a4e9a9-5575-38f4-9427-b4df022e087a",
                                                "text": "„Sobald es dunkel wurde, zog Pit seine Jogginghose an und verschwand in den Gassen.“"
                                            },
                                            {
                                                "example_id": "23a205f4-3250-42b8-a234-403975993fa9",
                                                "sense_id": "04a4e9a9-5575-38f4-9427-b4df022e087a",
                                                "text": "„Dazu trug sie die Jogginghose aus rosa Frottee, mit der sie zu Bett gegangen war.“"
                                            },
                                            {
                                                "example_id": "4f41e2a9-f368-44c9-b87e-b765c376f714",
                                                "sense_id": "04a4e9a9-5575-38f4-9427-b4df022e087a",
                                                "text": "Karl Lagerfeld sagte einst: Wer eine Jogginghose trägt, hat die Kontrolle über sein Leben verloren."
                                            },
                                            {
                                                "example_id": "28d682ad-047d-4011-943e-c2c39f661fbe",
                                                "sense_id": "04a4e9a9-5575-38f4-9427-b4df022e087a",
                                                "text": "„Als ich in eine ihrer Jogginghosen, weiche Wollsocken und einen herrlich warmen Pulli gehüllt aus dem Bad kam, hatte sich die Matschspur jedoch von selbst beseitigt, der Boden war blitzblank gewischt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
