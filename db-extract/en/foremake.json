                "senses": [
                    {
                        "sense_id": "16f05aaa-aa78-3a36-9c8c-e114d8c760ae",
                        "entry_id": "cfbb9612-f25a-37f2-9a4f-c4ef86b162b9",
                        "glosses": [
                            "To make beforehand; make or create in advance; premake."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9a2e0a2d-8cb4-4267-8de2-60e0600f67a5",
                                "sense_id": "16f05aaa-aa78-3a36-9c8c-e114d8c760ae",
                                "text": "[...] that the uncomposed song (“ inconditum carmen”) sung by the Persians, was unpleasing to the ears of strangers: thus distinguishing between that and the condita carmina (foremade songs) which he or the Grecians had commonly heard."
                            },
                            {
                                "example_id": "665ec6d4-3da6-45ec-920f-5676c9896a26",
                                "sense_id": "16f05aaa-aa78-3a36-9c8c-e114d8c760ae",
                                "text": "That blessed mate he found for him, foremade, In the recesses of the wilderness."
                            },
                            {
                                "example_id": "4f58c039-8d0a-4359-a41a-1d8ecfcd2f13",
                                "sense_id": "16f05aaa-aa78-3a36-9c8c-e114d8c760ae",
                                "text": "Thus, while each fateful only is to himself, We can foretell our future; we foremake."
                            },
                            {
                                "example_id": "09a4c3df-1f18-423c-b38a-29c02802bea3",
                                "sense_id": "16f05aaa-aa78-3a36-9c8c-e114d8c760ae",
                                "text": "[...] but, rising abruptly northward, they prevented the passage of armies except at the far north, and subordinate ranges curtained and defended the intervening valleys as foremade runways for invasive operations northward, while opening into supply sections to the south."
                            },
                            {
                                "example_id": "4c5f84ab-eb3a-4a3c-a939-3ca4429b7055",
                                "sense_id": "16f05aaa-aa78-3a36-9c8c-e114d8c760ae",
                                "text": "It proposed to abolish anything definite and categorical and put in its place that which is no more than situational, contextual, and ephemeral. It foremakes objective factuality for relativized subjectivity."
                            }
                        ]
                    }
