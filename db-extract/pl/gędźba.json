                "senses": [
                    {
                        "sense_id": "2bb5dba1-6c14-3e0c-8ea5-3006579b20eb",
                        "entry_id": "c236bf3f-71a1-327d-ba6e-844f74c1a3e1",
                        "glosses": [
                            "dziś muzyka, gra na instrumencie; zob. też gędźba w Encyklopedii staropolskiej"
                        ],
                        "tags": [
                            "Old-Polish",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "ebf59792-9b0d-4827-b5eb-885da38f6801",
                                "sense_id": "2bb5dba1-6c14-3e0c-8ea5-3006579b20eb",
                                "text": "Cmentarz jakby się napełniał cieniami… tłumem widm… gąszczem mrocznych zarysów… gędźbą rozjęczonych a cichych głosów… […]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c4fb0bfb-14f0-3f4b-90b2-6d82d4df0ad7",
                        "entry_id": "c236bf3f-71a1-327d-ba6e-844f74c1a3e1",
                        "glosses": [
                            "zob. gęśle"
                        ],
                        "tags": [
                            "Old-Polish"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "1cf752dd-a209-3924-ba12-265fd16e881b",
                        "entry_id": "c236bf3f-71a1-327d-ba6e-844f74c1a3e1",
                        "glosses": [
                            "grajkowie, muzykanci"
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "12e9ef3c-9a54-4568-9eae-1d0bb5ff3442",
                                "sense_id": "1cf752dd-a209-3924-ba12-265fd16e881b",
                                "text": "A że w izbie miejsca wkrótce nie stało, chłopcy i dziewczęta koło wiedli w podwórku, gdzie i gędźba usiadła na przyzbie."
                            }
                        ],
