                "senses": [
                    {
                        "sense_id": "809f5e50-c8f6-3652-906d-9b765edde42b",
                        "entry_id": "df830d2b-47e9-31cf-809a-0842ec92ecb6",
                        "glosses": [
                            "A native or inhabitant of the west of a region (or of the world as a whole).",
                            "A native or inhabitant of the West, of the Western world—Europe and the Americas. (Also written capitalized as Westerner.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75fa9f97-4dc4-4e28-a705-1610e96de52f",
                                "sense_id": "809f5e50-c8f6-3652-906d-9b765edde42b",
                                "text": "The dispatches […] also exposed the blatant discrepancy between the west's professed values and actual foreign policies. Having lectured the Arab world about democracy for years, its collusion in suppressing freedom was undeniable as protesters were met by weaponry and tear gas made in the west, employed by a military trained by westerners."
                            }
                        ]
                    },
                    {
                        "sense_id": "1da34b2a-871e-3bef-8f9f-5ae629371c3d",
                        "entry_id": "df830d2b-47e9-31cf-809a-0842ec92ecb6",
                        "glosses": [
                            "A native or inhabitant of the west of a region (or of the world as a whole).",
                            "A native or inhabitant of the Wild West. (Also written capitalized as Westerner.)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf41a5bd-e60a-4857-a54d-cc563e01f702",
                        "source_entry_id": "df830d2b-47e9-31cf-809a-0842ec92ecb6",
                        "source_sense_description": "inhabitant of Europe and the Americas",
                        "target_lang_word": "westerling",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "westerling",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "70875a7a-1553-3d53-b5ae-08b20a32ca70",
                                        "entry_id": "051cf2ba-91fd-3f2b-b2f4-3e89ea260aaa",
                                        "glosses": [
                                            "iemand uit het westen van het land"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15b6daff-b6b9-43da-b4cc-e9a8bccf1c02",
                                                "sense_id": "70875a7a-1553-3d53-b5ae-08b20a32ca70",
                                                "text": "Voor haar afstuderen interviewde Leontien Twentenaren in Twente en Den Haag, westerlingen die in Twente zijn gaan wonen en rasechte Hagenezen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "119dcf78-9afd-3d8f-93f1-f19979237479",
                                        "entry_id": "051cf2ba-91fd-3f2b-b2f4-3e89ea260aaa",
                                        "glosses": [
                                            "iemand uit de westerse wereld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94216d67-c7f9-498d-92d4-5a12c2ec1153",
                                                "sense_id": "119dcf78-9afd-3d8f-93f1-f19979237479",
                                                "text": "Anton Geesink wist als eerste westerling de wereldtitel in de judoklasse alle categorieën te behalen."
                                            },
                                            {
                                                "example_id": "6b254adb-1af0-4469-926b-b401fafb612c",
                                                "sense_id": "119dcf78-9afd-3d8f-93f1-f19979237479",
                                                "text": "Dus misschien konden ze een eenvoudige ruil doen, zij liet hun de stad zien en zij vertelden over de westerse rechtstoepassing? Ze voegde er droog aan toe dat zo'n uitwisseling van diensten zelfs vroeger niet als crimineel beoordeeld zou zijn, niet eens als hooliganisme, hoewel dat over het algemeen alles wel omvatte wat er zou kunnen gebeuren in het gezelschap van westerlingen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e518dd6-36f9-313d-b1ce-56e5e71187fd",
                                        "entry_id": "051cf2ba-91fd-3f2b-b2f4-3e89ea260aaa",
                                        "glosses": [
                                            "iemand van Europese of blanke afkomst"
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02bf906d-59bc-4a8b-971f-28e6eb316965",
                        "source_entry_id": "df830d2b-47e9-31cf-809a-0842ec92ecb6",
                        "source_sense_description": "inhabitant of Europe and the Americas",
                        "target_lang_word": "Occidental",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Occidental",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84f68d13-5313-31a8-889f-323fa4ee6a4d",
                                        "entry_id": "2be3c3ca-e051-339e-ba0a-f05714d204d5",
                                        "glosses": [
                                            "Habitant d’un pays de culture occidentale, ce qui comprend grosso modo l'Europe et l'Amérique du Nord, bien que les délimitations peuvent être floues."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "536ba11f-e625-36b9-9e22-171dde59ba7a",
                                        "entry_id": "2be3c3ca-e051-339e-ba0a-f05714d204d5",
                                        "glosses": [
                                            "Habitant d’un pays de culture occidentale, par opposition à un pays asiatique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72e1a879-ffea-4126-9d6d-40f28f159368",
                                                "sense_id": "536ba11f-e625-36b9-9e22-171dde59ba7a",
                                                "text": "Peu de chefs religieux bénéficient d’une réputation aussi enviable que celle de Tenzin Gyatso […] Nombre d’Occidentaux voient en lui un modèle de sagesse et de spiritualité."
                                            },
                                            {
                                                "example_id": "52e17e26-eac6-454c-af4c-486dbcf96202",
                                                "sense_id": "536ba11f-e625-36b9-9e22-171dde59ba7a",
                                                "text": "Vu l’air du temps, particulièrement orageux ces jours-ci entre l’Iran et le reste du monde, mieux vaut ne pas être un Occidental aux mains des Gardiens de la révolution islamique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b34ea6c3-29e4-4fde-87c6-f1cdc07fa301",
                        "source_entry_id": "df830d2b-47e9-31cf-809a-0842ec92ecb6",
                        "source_sense_description": "inhabitant of Europe and the Americas",
                        "target_lang_word": "occidental",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "occidental",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b4ebee95-ba67-3804-9c58-ee1bc22e5054",
                                        "entry_id": "c60f2fbc-e311-340c-81a3-c42a500ddfb1",
                                        "glosses": [
                                            "Qui se trouve à l’ouest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba514d5f-3219-4c49-8fb0-1687cc056885",
                                                "sense_id": "b4ebee95-ba67-3804-9c58-ee1bc22e5054",
                                                "text": "Le régime xérique de la côte se prolonge sur le versant occidental des Andes moyennes, où s’étend une végétation plus ou moins steppique, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8670bb08-fd98-3ab0-8e38-5b36d6c45ebf",
                                        "entry_id": "c60f2fbc-e311-340c-81a3-c42a500ddfb1",
                                        "glosses": [
                                            "Relatif à l’Occident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b61b7d5-f0ad-414f-817e-4157944ada50",
                                                "sense_id": "8670bb08-fd98-3ab0-8e38-5b36d6c45ebf",
                                                "text": "Seuls les passagers des avions en provenance de l’ouest sont soumis au flytoxage. Les avions venant d’Extrême-Orient ne sont jamais désinfectés. Le Pakistan ne craint que les miasmes occidentaux."
                                            },
                                            {
                                                "example_id": "76314d53-a658-480b-b312-71dfad9fe917",
                                                "sense_id": "8670bb08-fd98-3ab0-8e38-5b36d6c45ebf",
                                                "text": "Mais personne n’ose dire que le facteur central de l’histoire des années 1920-1939 fut purement et simplement l’incompétence technique des classes dirigeantes et des gouvernements occidentaux. Leurs opposants préfèrent croire au machiavélisme."
                                            },
                                            {
                                                "example_id": "bce42189-90fb-491d-a6e7-e044197d07d3",
                                                "sense_id": "8670bb08-fd98-3ab0-8e38-5b36d6c45ebf",
                                                "text": "S'il est un domaine où les pays occidentaux doivent aussi se serrer les coudes, c'est celui de la lutte contre le terrorisme."
                                            },
                                            {
                                                "example_id": "4fef6f39-1231-4766-afa0-3b2d767376e1",
                                                "sense_id": "8670bb08-fd98-3ab0-8e38-5b36d6c45ebf",
                                                "text": "Nous avons pris soin d’apporter, dans la mesure du possible, des explications logiques à des phénomènes linguistiques différents de ceux des langues occidentales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44226ad2-5db2-307e-8787-4271344c1da6",
                                        "entry_id": "c60f2fbc-e311-340c-81a3-c42a500ddfb1",
                                        "glosses": [
                                            "Relatif au capitalisme américano-européen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cc1f61a-b8d3-4820-b085-e666748bd02a",
                                                "sense_id": "44226ad2-5db2-307e-8787-4271344c1da6",
                                                "text": "Au total, la Révolution n’est restée maîtresse du terrain qu’en Russie, après une lutte acharnée des Rouges contre les Blancs, ceux-ci soutenus par les puissances occidentales."
                                            },
                                            {
                                                "example_id": "ebaa52ff-3f04-433e-953e-63fbc4285f44",
                                                "sense_id": "44226ad2-5db2-307e-8787-4271344c1da6",
                                                "text": "Le courage civique a déserté non seulement le monde occidental dans son ensemble, mais même chacun des pays qui le composent, chacun de ses gouvernements, chacun de ses partis, ainsi que, bien entendu, l’Organisation des Nations unies."
                                            },
                                            {
                                                "example_id": "867b71f5-68c8-4b14-947a-4b038c6c715a",
                                                "sense_id": "44226ad2-5db2-307e-8787-4271344c1da6",
                                                "text": "Le livre de Gelber atteint le zénith du narcissisme occidental avec l’identification des mâles américains aux mâles néo-guinéens : « […] »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "503edf37-487a-4922-a2e8-31b8885fed02",
