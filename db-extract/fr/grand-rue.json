                "senses": [
                    {
                        "sense_id": "ff3b4b3c-dab6-3178-ae74-f3559af6b9de",
                        "entry_id": "e780c839-b3dc-3d00-a844-ed24b9b72cc7",
                        "glosses": [
                            "Rue principale d’un bourg."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3da8d244-ef23-40d1-8ac6-c94e426c960d",
                                "sense_id": "ff3b4b3c-dab6-3178-ae74-f3559af6b9de",
                                "text": "Il habite dans la grand-rue du village."
                            },
                            {
                                "example_id": "e89e430b-491f-4f8d-a640-6fde6e3f5e65",
                                "sense_id": "ff3b4b3c-dab6-3178-ae74-f3559af6b9de",
                                "text": "Arrivé sur le pont, je découvris enfin la grand-rue du village."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42f1631c-283b-4cc2-a2b1-cb4b34b402f8",
                        "source_entry_id": "e780c839-b3dc-3d00-a844-ed24b9b72cc7",
                        "source_sense_id": "ff3b4b3c-dab6-3178-ae74-f3559af6b9de",
                        "target_lang_word": "Hauptstraße",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hauptstraße",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f14492cc-5803-3075-b7be-b79ce6d8beb3",
                                        "entry_id": "254cb2b4-ff55-3e86-b661-f99078f3b8a9",
                                        "glosses": [
                                            "verkehrsreiche Straße"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18cb7f6e-6dd1-48bf-a587-ab3daf9de138",
                                                "sense_id": "f14492cc-5803-3075-b7be-b79ce6d8beb3",
                                                "text": "Die Hauptstraßen in fast allen großen Städten sind während des Berufsverkehrs staugefährdet."
                                            },
                                            {
                                                "example_id": "57e82c09-d78e-41fc-8f3d-b278ce8b026a",
                                                "sense_id": "f14492cc-5803-3075-b7be-b79ce6d8beb3",
                                                "text": "„Sie fuhren die Hauptstraße entlang, die ringförmig die Innenstadt umschloss.“"
                                            },
                                            {
                                                "example_id": "c01fda3e-7a7a-42cc-926f-d9311d189cf8",
                                                "sense_id": "f14492cc-5803-3075-b7be-b79ce6d8beb3",
                                                "text": "„Entlang der Hauptstraßen werden elektrische Laternen installiert, in alle Häuser, an denen Gäste vorüberkommen können, verlegen Arbeiter Stromleitungen.“"
                                            },
                                            {
                                                "example_id": "1fbb0f64-2183-4fd6-97aa-b7fe14dd25df",
                                                "sense_id": "f14492cc-5803-3075-b7be-b79ce6d8beb3",
                                                "text": "„Thomas ließ den Motor kurz aufheulen, dann sauste der Karmann lautstark auf dem Asphaltweg zur Hauptstraße hinauf.“"
                                            },
                                            {
                                                "example_id": "955f8da1-730f-4b99-9e3c-c4a2a423d2fe",
                                                "sense_id": "f14492cc-5803-3075-b7be-b79ce6d8beb3",
                                                "text": "„Beide Güter grenzten an die Alle, aber in Götzlack war der Fluss zu einem See aufgestaut, und über diesen ließ sich eine Abkürzung nehmen, mit der die überfüllten Hauptstraßen umgangen werden konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "515b3c5f-f10a-3c6e-96f4-61ea21c5e942",
                                        "entry_id": "254cb2b4-ff55-3e86-b661-f99078f3b8a9",
                                        "glosses": [
                                            "zentrale Straße in einem Ort mit vielen Geschäften, Einkaufsstraße"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "456d84b9-8375-4d2b-9e5a-ba4078f379bd",
                                                "sense_id": "515b3c5f-f10a-3c6e-96f4-61ea21c5e942",
                                                "text": "Einmal im Jahr wird in unserem Dorf die Hauptstraße gesperrt und es findet dort ein großes Straßenfest statt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b21ec08e-2212-36a8-b708-a5e051b1dd46",
                                        "entry_id": "254cb2b4-ff55-3e86-b661-f99078f3b8a9",
                                        "glosses": [
                                            "Straße mit Recht auf Vorfahrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20466656-62e2-47cf-ab3a-6e80893076b3",
                                                "sense_id": "b21ec08e-2212-36a8-b708-a5e051b1dd46",
                                                "text": "Fahr weiter, wir sind auf der Hauptstraße und haben Vorfahrt!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hauptstraße",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6c66879-010a-32e1-99e1-c823ff3078e9",
                                        "entry_id": "cb7ba146-abc1-3079-a25a-2ed0b179b5b4",
                                        "glosses": [
                                            "Eigenname von Straßen, häufigster Straßenname in Deutschland mit über 5.400 Vorkommen, in Österreich 71 Vorkommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d3e6a9c-30d7-4733-8cd6-d3cd702ab74d",
                                                "sense_id": "e6c66879-010a-32e1-99e1-c823ff3078e9",
                                                "text": "Die Hauptstraße ist einen halben Kilometer lang."
                                            },
                                            {
                                                "example_id": "89e1ebea-18e2-4652-ae6e-7b9ab0a23778",
                                                "sense_id": "e6c66879-010a-32e1-99e1-c823ff3078e9",
                                                "text": "Familie Mustermann wohnt in der Hauptstraße 66."
                                            },
                                            {
                                                "example_id": "a67d0216-97b0-45d5-bb23-0079b3e253de",
                                                "sense_id": "e6c66879-010a-32e1-99e1-c823ff3078e9",
                                                "text": "Die Hauptstraße ist wegen Bauarbeiten gesperrt."
                                            },
                                            {
                                                "example_id": "c1e55dfe-590b-45b5-a59a-c4d71e32efa1",
                                                "sense_id": "e6c66879-010a-32e1-99e1-c823ff3078e9",
                                                "text": "Wohnt dein Geliebter in der Hauptstraße 66?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98bd0aee-96f8-47f4-89b6-28ee682c5a19",
                        "source_entry_id": "e780c839-b3dc-3d00-a844-ed24b9b72cc7",
                        "source_sense_id": "ff3b4b3c-dab6-3178-ae74-f3559af6b9de",
                        "target_lang_word": "main street",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "main street",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "969413e7-9594-32a2-8b3c-6644996cf88b",
                                        "entry_id": "7ae3f3fd-23e0-32ca-b36b-57fb3a808335",
                                        "glosses": [
                                            "The principal street, or one of the several principal streets, of a town."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd4c6155-566e-4a57-ba16-d4f3ceb1c612",
                                                "sense_id": "969413e7-9594-32a2-8b3c-6644996cf88b",
                                                "text": "Invercargill in New Zealand has two main streets, Dee Street and Tay Street."
                                            },
                                            {
                                                "example_id": "28e6788d-7809-4e01-932e-a6f132f77214",
                                                "sense_id": "969413e7-9594-32a2-8b3c-6644996cf88b",
                                                "text": "\"The Chengtu revolutionaries were fantastically colourful in the Szechwanese manner—they costumed themselves as heroes of the stage and their energies were chiefly occupied in tying ropes across the main streets so that when Imperial officials rode by in their litters they would have to get down and crawl under, losing face."
                                            },
                                            {
                                                "example_id": "7acdc65a-2ad8-4116-85df-87faff3c9299",
                                                "sense_id": "969413e7-9594-32a2-8b3c-6644996cf88b",
                                                "text": "An almost 19th-century atmosphere has returned to Beetham since the M6 motorway drew away the traffic which used to roar along its main street."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3c8d361-30f5-41a0-a4d9-ea20c913ce93",
                        "source_entry_id": "e780c839-b3dc-3d00-a844-ed24b9b72cc7",
                        "source_sense_id": "ff3b4b3c-dab6-3178-ae74-f3559af6b9de",
                        "target_lang_word": "high street",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "high street",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3c9d405-dd15-3ec6-bdcd-643e4bc63b45",
                                        "entry_id": "93ef0cd0-d269-3582-b499-9b1ac0c98bf8",
                                        "glosses": [
                                            "The main street of any town."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa7433f7-d4cd-381c-b5ab-dda8a69e098a",
                                        "entry_id": "93ef0cd0-d269-3582-b499-9b1ac0c98bf8",
                                        "glosses": [
                                            "Mainstream shops, banks, etc. that can be found on such a street, in contrast to more specialist shops and services."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f14ade30-7fbf-41cd-a32b-2d082b6396a7",
                                                "sense_id": "aa7433f7-d4cd-381c-b5ab-dda8a69e098a",
                                                "text": "Woolworths has had a presence on the UK High Street for almost a century."
                                            },
                                            {
                                                "example_id": "db575c5e-6772-479a-afd9-b766e19d841f",
                                                "sense_id": "aa7433f7-d4cd-381c-b5ab-dda8a69e098a",
                                                "text": "The spending in and around local stations is creating micro-economies that are benefiting Great Britain's high streets, independent businesses and economic growth, both locally and on a national level."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a7f421d-8836-3aee-9b69-e742b70a0a39",
                                        "entry_id": "93ef0cd0-d269-3582-b499-9b1ac0c98bf8",
                                        "glosses": [
                                            "Physical, bricks and mortar shops, in contrast to Internet shops."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52b94dab-6bd9-48e3-bae4-4b7383c7614f",
                        "source_entry_id": "e780c839-b3dc-3d00-a844-ed24b9b72cc7",
                        "source_sense_id": "ff3b4b3c-dab6-3178-ae74-f3559af6b9de",
                        "target_lang_word": "thoroughfare",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thoroughfare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "461ac537-3440-3650-98ff-6e4dee1d0505",
                                        "entry_id": "2dc42725-6563-3481-b83e-28e03b3fc374",
                                        "glosses": [
                                            "A passage; a way through."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85548f13-aac6-4c03-b727-8e82c234d7fc",
                                                "sense_id": "461ac537-3440-3650-98ff-6e4dee1d0505",
                                                "text": "“I ask you,” cried Lloyd George in 1909. “Are we to have all the ways of reform, financial and social, blocked simply by a notice board: ‘No thoroughfare. By order of Nathanial Rothschild’?”"
                                            },
                                            {
                                                "example_id": "f3e16624-eadf-41cc-b64c-c21f09c811d2",
                                                "sense_id": "461ac537-3440-3650-98ff-6e4dee1d0505",
                                                "text": "In the scullery Smiley had once more checked his thoroughfare, shoved some deck-chairs aside, and pinned a string to the mangle to guide him because he saw badly in the dark."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b578cce-d887-3092-90f1-c8bf49f075d8",
                                        "entry_id": "2dc42725-6563-3481-b83e-28e03b3fc374",
                                        "glosses": [
                                            "A road open at both ends or connecting one area with another; a highway or main street."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6237927-c028-49c4-ac4e-d9e708155b09",
                                                "sense_id": "1b578cce-d887-3092-90f1-c8bf49f075d8",
                                                "text": "a dozen houses were quickly blazing, including those of Sir John Fielding and two other justices, and four in Holborn – one of the greatest thoroughfares in London – which were all burning at the same time, and burned until they went out of themselves, for the people cut the engine hose, and would not suffer the firemen to play upon the flames."
                                            },
                                            {
                                                "example_id": "e2cfc3db-79a8-4383-81d4-d702c0dbfeb5",
                                                "sense_id": "1b578cce-d887-3092-90f1-c8bf49f075d8",
                                                "text": "With some of it on the south and more of it on the north of the great main thoroughfare that connects Aldgate and the East India Docks, St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London."
                                            },
                                            {
                                                "example_id": "e558a47e-e660-4714-8b79-e606ddb53d2a",
                                                "sense_id": "1b578cce-d887-3092-90f1-c8bf49f075d8",
                                                "text": "East [Street] and West Street form a single thoroughfare running as a backbone through the village, flanked by neat, painted cottages of predominantly 18th-century brick."
                                            },
                                            {
                                                "example_id": "7c575266-48a8-43ad-868e-92cd7c545913",
                                                "sense_id": "1b578cce-d887-3092-90f1-c8bf49f075d8",
                                                "text": "Local art is now a viable industry, and hundreds of islanders make a living in it. The thoroughfare of Oneroa village is lined with shops and galleries full of their work."
                                            },
                                            {
                                                "example_id": "7e8e1bc3-4883-4819-b8d4-98a479c43b66",
                                                "sense_id": "1b578cce-d887-3092-90f1-c8bf49f075d8",
                                                "text": "Mr. Roscoe, on the contrary, has claimed none of the accorded privileges of talent. He has shut himself up in no garden of thought, no elysium of fancy; but has gone forth into the highways and thoroughfares of life; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f98fb01d-6151-37da-9b76-d500ee4877f3",
                                        "entry_id": "2dc42725-6563-3481-b83e-28e03b3fc374",
                                        "glosses": [
                                            "The act of going through; passage; travel, transit."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96b2a832-a942-4cfd-a6b8-b77e2f3c2554",
                                                "sense_id": "f98fb01d-6151-37da-9b76-d500ee4877f3",
                                                "text": "The sign leading to the other carriage reads: No thoroughfare."
                                            },
                                            {
                                                "example_id": "e2370b66-b348-47d4-8bc5-57b9ac273202",
                                                "sense_id": "f98fb01d-6151-37da-9b76-d500ee4877f3",
                                                "text": "and made one realm, / Hell and this world, one realm, one continent / Of easy thorough-fare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "725cce54-54c1-306a-a67f-1a231a2e765f",
                                        "entry_id": "2dc42725-6563-3481-b83e-28e03b3fc374",
                                        "glosses": [
                                            "An unobstructed waterway allowing passage for ships."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
