                    },
                    {
                        "translation_id": "d08c71f4-9ea8-4e3d-833b-197f02099016",
                        "source_entry_id": "e720cf62-f12a-3766-92ee-30976ef19686",
                        "source_sense_id": "08054158-b06e-3ef7-a4f6-74d33c375090",
