                        "examples": [
                            {
                                "example_id": "37fa7662-e3ae-4348-b3a8-de403ba2c6da",
                                "sense_id": "c9d0971c-b08d-32cb-8801-a28cd16cb2bb",
                                "text": "Das Entstehen von Gasansammlungen im Magen-Darm-Trakt wird begünstigt durch: (...) den Verzehr von Gemüse und Hülsenfrüchten wie Zwiebeln, Kohl, Bohnen, Erbsen oder Linsen,",
                                "translation": "La formation d'accumulations de gaz dans le tractus gastro-intestinal est favorisée par : (...) la consommation de légumes et de légumineuses tels que les oignons, le chou, les haricots, les pois ou les lentilles,"
                            }
                        ]
                    }
