            "senses": [
                {
                    "sense_id": "244b8c2a-e964-3b55-b0dd-28c46c4f2d24",
                    "sense_definition": "Amas visible de gouttelettes d'eau ou de cristaux de glace en suspension dans l'atmosphère.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "meteorologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ciel bleu s'est couvert de gros <w>nuages</w> sombres annonçant la pluie."
                        },
                        {
                            "text": "Un léger coup de vent a rapidement dissipé ce grand <w>nuage</w> blanc."
                        }
                    ],
                    "common_phrases": [
                        "ciel sans nuages",
                        "nuages de pluie"
                    ]
                },
                {
                    "sense_id": "8adf4d12-44dd-3fc9-8f51-c174f980aff5",
                    "sense_definition": "Masse dense de particules en suspension dans l'air ou petite quantité liquide qui se diffuse.",
