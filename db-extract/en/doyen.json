                        "target_lang_word": "Altmeister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altmeister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae02bdea-e09e-32a8-a232-1544dc57c923",
                                        "entry_id": "e0f4da21-cb23-3174-a798-535eb2a91c33",
                                        "glosses": [
                                            "jemand, der als vormaliger/bereits länger bewährter Meister eines Fachs, Metiers/einer Kunst anerkannt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76d703e3-48ec-4e8d-9ec6-f9a07cda163c",
                                                "sense_id": "ae02bdea-e09e-32a8-a232-1544dc57c923",
                                                "text": "„Er erwähnt nun Albertus Magnus, Lodovico Dolci und Galenus und kommt dann auf Joseph Gall, den er den Altmeister der Phrenologie nennt und sogar über sich selbst stellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf0536ea-af69-375e-82ca-1c93d4157711",
                                        "entry_id": "e0f4da21-cb23-3174-a798-535eb2a91c33",
                                        "glosses": [
                                            "jemand/Verein, der einst Meister geworden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "438750c1-7b85-4a3f-baf7-cc86ed217a32",
                                                "sense_id": "cf0536ea-af69-375e-82ca-1c93d4157711",
                                                "text": "„Sein schottischer Konkurrent Andy Murray hatte zuletzt mit Altmeister Ivan Lendl seinen persönlichen Erfolgsmacher gefunden. Einen, der selbst mal ganz oben stand.“"
                                            },
                                            {
                                                "example_id": "814afc28-d0ae-4da5-b2c8-8fbf37fce6bc",
                                                "sense_id": "cf0536ea-af69-375e-82ca-1c93d4157711",
                                                "text": "„Der VfL Gummersbach hat das Duell der kriselnden Altmeister in der Handball-Bundesliga gegen den TV Großwallstadt gewonnen und zurück in die Erfolgsspur gefunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6e0d8ac6-dde4-3eb6-bfee-8f3e06602e02",
                                        "entry_id": "e0f4da21-cb23-3174-a798-535eb2a91c33",
                                        "glosses": [
                                            "Meister einer Innung"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "974e8c59-4b19-4135-8233-5ed1af7472b8",
                                                "sense_id": "6e0d8ac6-dde4-3eb6-bfee-8f3e06602e02",
                                                "text": "„Plötzlich ward ich auf das Rathhaus gerufen, und bekam Befehl, meine Arbeit einzustellen. Ich fragte erstaunt: weswegen? Weil Ihr ein Pfuscher seyd, rief der Altmeister der Raschmacher, welches die stärkste Zunft in der Stadt war, weil Ihr keinen Lehrbrief vorzeigen könnt, und weil Ihr kein Meisterstück gemacht habt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
