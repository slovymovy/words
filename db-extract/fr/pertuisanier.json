                                            {
                                                "example_id": "6d268945-9664-4765-8a0d-e3f40f84d55a",
                                                "sense_id": "6929d014-0269-3099-b1e6-28d9a6a2eeae",
                                                "text": "\"Strong partisans of neither party, Indiana farmers failed to act as a block […]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06636497-1449-34ab-abe9-fcb556f7bd40",
                                        "entry_id": "38fd3878-9290-3e09-bc8b-d82fb9cb10a6",
                                        "glosses": [
                                            "A fervent, sometimes militant, supporter or proponent of a party, cause, faction, person, or idea."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b43b1cd-662a-3e5a-a427-766274edb2cb",
                                        "entry_id": "38fd3878-9290-3e09-bc8b-d82fb9cb10a6",
                                        "glosses": [
                                            "A member of a band of detached light, irregular troops acting behind occupying enemy lines in the ways of harassment or sabotage; a guerrilla fighter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8d3cda2-3388-3b9e-8450-b1719b531e62",
