                        "cross_references": [
                            {
                                "target_word": "shortly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58e96d1b-d2ac-3f52-98b2-2bfce69f0755",
                                        "entry_id": "309aabbf-7b96-3ee2-a610-737f95513877",
                                        "glosses": [
                                            "In a short or brief time or manner; quickly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3216b52-6d55-3594-bba5-c7294d70698d",
                                        "entry_id": "309aabbf-7b96-3ee2-a610-737f95513877",
                                        "glosses": [
                                            "In or after a short time; soon."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74cdfde1-a1fe-401c-8a76-a1876744cacb",
                                                "sense_id": "f3216b52-6d55-3594-bba5-c7294d70698d",
                                                "text": "The past perfect progressive is used for actions and situations which had continued up to a past moment or shortly before it."
                                            },
                                            {
                                                "example_id": "0a843fd0-d092-486c-9f48-9c39095db029",
                                                "sense_id": "f3216b52-6d55-3594-bba5-c7294d70698d",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or otherwise his man would be there with a message to say that his master would shortly join me if I would kindly wait."
                                            },
                                            {
                                                "example_id": "fa4e208a-c49a-4a39-b055-7da4dc69dffc",
                                                "sense_id": "f3216b52-6d55-3594-bba5-c7294d70698d",
                                                "text": "Kaplan-Miller said she first joined the Sisterhood of Salaam Shalom, an interfaith organization that was founded by a Muslim and a Jewish woman in suburban New Jersey, shortly after the 2016 election."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d2be974-36c7-3a31-901f-85c8fc83ddc5",
                                        "entry_id": "309aabbf-7b96-3ee2-a610-737f95513877",
                                        "glosses": [
                                            "In few words."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5044cfa5-c7f0-4f1d-b328-f9f5433c678e",
                                                "sense_id": "2d2be974-36c7-3a31-901f-85c8fc83ddc5",
                                                "text": "Ideas are generally expressed more shortly in verse than in prose"
                                            },
                                            {
                                                "example_id": "d285901c-b604-429c-b7ca-3a8752ef65ec",
                                                "sense_id": "2d2be974-36c7-3a31-901f-85c8fc83ddc5",
                                                "text": "We shall not describe this tragical scene too fully; but we thought ourselves obliged, by that historic integrity which we profess, shortly to hint a matter which we would otherwise have been glad to have spared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "986ede6f-1f20-3973-b55e-6fe8d7bd205a",
                                        "entry_id": "309aabbf-7b96-3ee2-a610-737f95513877",
                                        "glosses": [
                                            "In an irritable (\\\"short\\\") manner."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3262c24d-6606-4a33-abbd-d791ece6979e",
                                                "sense_id": "986ede6f-1f20-3973-b55e-6fe8d7bd205a",
                                                "text": "\"Stop interrupting me, will ya?\" she said shortly."
                                            },
                                            {
                                                "example_id": "e71ae46d-341c-463a-9e39-7167292de008",
                                                "sense_id": "986ede6f-1f20-3973-b55e-6fe8d7bd205a",
                                                "text": "'Well, I still think it was a rather off-hand way for you—for anyone—to behave,' he said shortly.\nSuddenly Melody felt trapped—and annoyed. And she didn't like being spoken to like a child, either."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77fcb599-c957-4770-b0d1-f8e50c7ad1e9",
                        "source_entry_id": "2fc5b6b7-d098-3615-997b-cff38c840e57",
                        "source_sense_id": "337f8fd1-7da4-3790-b94a-859ed82b9e81",
