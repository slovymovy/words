                "senses": [
                    {
                        "sense_id": "905c36b0-f0ce-3a3a-a110-123c29e652fc",
                        "entry_id": "fb46df73-ca56-3b04-a99d-fee4a8e2ae0b",
                        "glosses": [
                            "прост. с усилием поднимая, положить наверх что-либо; взвалить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9d950c7-9fdd-4ed3-922a-34c683d6dc3a",
                                "sense_id": "905c36b0-f0ce-3a3a-a110-123c29e652fc",
                                "text": "Петр Петрович взворотил на верстак огромный конец доски и начал строгать."
                            }
                        ]
                    },
                    {
                        "sense_id": "36ffdb9d-4eef-312e-945e-8f6f47a56eea",
                        "entry_id": "fb46df73-ca56-3b04-a99d-fee4a8e2ae0b",
                        "glosses": [
                            "прост. переворачивая, разрыть; вспахать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d45c53de-3f9d-4608-81c0-562f636ba62a",
                                "sense_id": "36ffdb9d-4eef-312e-945e-8f6f47a56eea",
                                "text": "В поле поехал отец и сохой взворотил десятину…"
                            }
                        ]
                    },
                    {
                        "sense_id": "cfb9ee7d-f021-39bf-8eb7-396ff69e706f",
                        "entry_id": "fb46df73-ca56-3b04-a99d-fee4a8e2ae0b",
                        "glosses": [
                            "прост. ворочая, привести в беспорядок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "221f28e3-7329-40c9-892b-ba03af700cce",
                                "sense_id": "cfb9ee7d-f021-39bf-8eb7-396ff69e706f",
                                "text": "Вялая, она переходила от сундука к кровати, невидящими глазами оглядывала взвороченный в сундуке ворох нарядов, мучительно что-то обдумывала, шепча губами."
                            }
                        ]
                    }
