                                            {
                                                "example_id": "4ccd5203-4b16-48b6-82ab-284e6b2e6c68",
                                                "sense_id": "b0782142-bb6c-30b5-8fb4-a393d787c4f9",
                                                "text": "Ouch! Her sunburn looks awful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32ae3358-fb2c-3475-946c-e6276658168d",
                                        "entry_id": "73ea1e7e-c78b-31ec-990f-2f8166cb7c44",
                                        "glosses": [
                                            "A reply to an insult seen as savage (frequently one that is tongue-in-cheek or joking)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39523b47-de0a-470a-9be1-98c05bef66cf",
                                                "sense_id": "32ae3358-fb2c-3475-946c-e6276658168d",
                                                "text": "Ouch. How could you say that?"
