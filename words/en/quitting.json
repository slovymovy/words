                    "frequency": "High",
                    "semantic_group_id": "stopping_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Quitting</w> smoking is one of the best things you can do for your health.",
                            "target_lang_translations": {
                                "ru": "<w>Отказ</w> от курения — это одна из лучших вещей, которые вы можете сделать для своего здоровья.",
