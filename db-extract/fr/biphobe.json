                                        "entry_id": "ac994085-fd64-3500-94c2-3a9966a10121",
                                        "glosses": [
                                            "Exhibiting or characteristic of biphobia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6c1aea3-c449-4432-87d1-00ca08036ba7",
                                                "sense_id": "79db3d52-8257-3132-a4b4-a33ca6443349",
                                                "text": "If counselors are homophobic or biphobic, they should refer clients facing those issues to a counselor who could be objective."
                                            },
                                            {
                                                "example_id": "dcb6b878-810a-40be-a5be-ccbc53dba04e",
                                                "sense_id": "79db3d52-8257-3132-a4b4-a33ca6443349",
                                                "text": "One such article appeared in the April 3rd issue of the New York Times: \"AIDS Specter for Women: The Bisexual Man,\" a nasty, biphobic piece of journalism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
