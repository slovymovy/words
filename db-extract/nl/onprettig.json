                "senses": [
                    {
                        "sense_id": "c359ae53-c304-3674-9fd4-f46726a7b0bc",
                        "entry_id": "9d6cada8-1d8f-3fc4-9ece-bf0ebd60ee8d",
                        "glosses": [
                            "onaangenaam voelend of aandoend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37e2e0f6-f99f-4302-88c1-eaabfdb96083",
                                "sense_id": "c359ae53-c304-3674-9fd4-f46726a7b0bc",
                                "text": "Dit was een onprettige gewaarwording."
                            },
                            {
                                "example_id": "465af55e-0049-4520-a9d7-d9c81fb0a25a",
                                "sense_id": "c359ae53-c304-3674-9fd4-f46726a7b0bc",
                                "text": "Als een verandering ook nog oncomfortabel wordt gevonden, is de weerstand nog groter, zegt Merkelbach. \"Je moet een fietshelm aanschaffen, het doet iets met je kapsel, en niemand anders draagt hem. Dat vinden mensen onprettig: we willen niet de odd one out zijn.\""
                            }
                        ]
                    }
                ],
