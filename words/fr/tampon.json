                    "common_phrases": [
                        "faire tampon",
                        "zone tampon",
                        "État tampon"
                    ]
                },
                {
                    "sense_id": "f1217bbb-13cd-3d8c-9565-b0640df2bea8",
                    "sense_definition": "Morceau de matière utilisé pour boucher une ouverture, un conduit ou une cavité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obturation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le plombier a retiré le <w>tampon</w> qui bloquait le tuyau d'évacuation."
                        },
                        {
                            "text": "L'ouvrier utilise un <w>tampon</w> de bois pour fermer hermétiquement le tonneau."
