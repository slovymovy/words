                        "source_entry_id": "37fbc6e8-cc0a-3282-9d03-38561551d8ed",
                        "source_sense_id": "d3972fa6-aec5-3cbb-94bb-52c07eece9d8",
                        "target_lang_word": "cæsium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cæsium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f47822c0-a67b-3d06-a95d-e51a52e577fe",
                                        "entry_id": "9c523ef0-59b3-3eee-8fa6-0b607e087447",
                                        "glosses": [
                                            "Variante orthographique de césium."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "662d42f1-c454-4f82-aa68-e27a24961978",
                                                "sense_id": "f47822c0-a67b-3d06-a95d-e51a52e577fe",
                                                "text": "Le sel double de cæsium et de tétroxyde de vanadium se prépare exactement de la même façon que celui de rubidium."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb90eee4-1a1f-496a-a722-13d7eb5ee840",
                        "source_entry_id": "37fbc6e8-cc0a-3282-9d03-38561551d8ed",
                        "source_sense_id": "d3972fa6-aec5-3cbb-94bb-52c07eece9d8",
                        "target_lang_word": "césium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "césium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bb41d57-5942-38d8-993e-2562389ae48f",
                                        "entry_id": "7bc3a50a-bc32-32c6-972d-d825f6c91420",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 55 et de symbole Cs qui fait partie de la série chimique des métaux alcalins."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7908e80-e395-43a8-934f-ad1886ff1d21",
                                                "sense_id": "7bb41d57-5942-38d8-993e-2562389ae48f",
                                                "text": "Le césium, Cs, de numéro atomique 55, est le 45ᵉ élément le plus abondant de la croûte terrestre, en moyenne 2,6 g par tonne métrique, (3 g dans l'écorce terrestre, 3 à 5 10⁻⁴g dans l’eau de mer). Il existe de manière dispersé dans les roches, les sols et les argiles."
                                            },
                                            {
                                                "example_id": "1c807da5-3bbc-4ed2-9ed0-eff35210bb45",
                                                "sense_id": "7bb41d57-5942-38d8-993e-2562389ae48f",
                                                "text": "Parmi les alcalins, il apparaît que le césium est l'élément le plus favorable pour la fabrication d’une horloge atomique."
                                            },
                                            {
                                                "example_id": "d6ba46e7-83a0-4c2a-8646-b4870d38f0b1",
                                                "sense_id": "7bb41d57-5942-38d8-993e-2562389ae48f",
                                                "text": "Le césium présente d’autres avantages. Bien qu’il possède 40 isotopes (nous verrons plus loin ce qu’est un isotope), seul un d’entre eux est stable et présent dans la nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5c826f7-fb19-3f9f-9934-02f707d663d6",
                                        "entry_id": "7bc3a50a-bc32-32c6-972d-d825f6c91420",
                                        "glosses": [
                                            "Corps simple de cet élément, alcalin argent-doré."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7aec7e81-a1b9-4f3f-8b99-c997977f41aa",
                                                "sense_id": "c5c826f7-fb19-3f9f-9934-02f707d663d6",
                                                "text": "On obtient le césium métallique par les mêmes procédés que le rubidium, c'est-à-dire en décomposant par la pile le chlorure fondu."
                                            },
                                            {
                                                "example_id": "408e9e29-63be-4599-8cc7-49b4f0c1c1d1",
                                                "sense_id": "c5c826f7-fb19-3f9f-9934-02f707d663d6",
                                                "text": "Le césium est un métal alcalin qui fond à 28,4 °C."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
