                ],
                "senses": [
                    {
                        "sense_id": "2a5a90fd-9cd0-3fdb-bac1-b47cc421b4f6",
                        "entry_id": "ece4e600-b3fc-3bea-a968-b6e8c8eb77bc",
                        "glosses": [
                            "To cease in either glacial advance or retreat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa5e96ae-085a-4c1c-ac43-7330dce20df5",
                                "sense_id": "2a5a90fd-9cd0-3fdb-bac1-b47cc421b4f6",
                                "text": "It is tempting in these circumstances to look for the 'smoking gun'-a mechanism whereby glaciers from both the local Cairngorm ice cap, and the much larger Scottish Ice Sheet could stillstand, or even readvance for a period of 1 kyr, during deglaciation."
                            },
                            {
                                "example_id": "4bdc6209-5ba5-4af1-9828-119862ab9e15",
                                "sense_id": "2a5a90fd-9cd0-3fdb-bac1-b47cc421b4f6",
                                "text": "The base of the stratigraphic successions consists of outwash fan deposits emplaced in the early deglaciation when ice margin stillstanded immediately beyond the depositional area."
                            },
                            {
                                "example_id": "4a2f997f-cd36-47fe-8fac-857b0792bd55",
                                "sense_id": "2a5a90fd-9cd0-3fdb-bac1-b47cc421b4f6",
                                "text": "Ice-contact depositional systems formed when the LIS was stillstanding along the Québec North Shore."
                            }
                        ]
                    }
                ],
