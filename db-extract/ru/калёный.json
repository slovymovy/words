                    {
                        "sense_id": "db8c1d24-8dd3-3270-8b64-bdb28eb940b3",
                        "entry_id": "982cd494-e01d-3abe-9bc2-9d98944c0ecb",
                        "glosses": [
                            "red-hot, tempered (of iron), made from tempered steel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b12a0db6-63f1-4827-b16e-85e30899a6ee",
                                "sense_id": "db8c1d24-8dd3-3270-8b64-bdb28eb940b3",
                                "text": "Ой, разы́пались калёныя стрѣ́лы / какъ по ма́тушкѣ сыро́й землѣ́.\"",
                                "translation": "Ah, the tempered arrows were scattered / as on damp mother earth.",
                                "english": "Ah, the tempered arrows were scattered / as on damp mother earth."
                            }
                        ]
