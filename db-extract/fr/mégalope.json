                        "glosses": [
                            "Nom donné au dernier stade larvaire ou au premier stade post-larvaire de certains crustacés décapodes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c3cc26c-631b-4f3c-ad89-cd1f496faa27",
                                "sense_id": "0d477908-edac-3cfd-89fc-d98aaad75547",
                                "text": "Dans les écloseries, les larves (zoé) sont stockées dans des bassins intérieurs et nourries jusqu’au stade post-larvaire (mégalope) avec un régime alimentaire composé de zooplancton, d’Artemia, de vitellus et de microalgues."
                            }
                        ]
                    }
