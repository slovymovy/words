                "senses": [
                    {
                        "sense_id": "aab62600-6b7d-3a2b-bf20-ab22e2d17da2",
                        "entry_id": "89a67219-0a5d-3413-8d72-2c43696f776b",
                        "glosses": [
                            "militärischer Großverband, der aus der Luft abgesetzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf37fc84-67a4-42b8-b476-90a4e96fe0ce",
                                "sense_id": "aab62600-6b7d-3a2b-bf20-ab22e2d17da2",
                                "text": "„Die Mitglieder der Sechsten Luftlandedivision trafen 1945 unter dem Oberbefehl von Generalmajor E.L. Bols in Palästina ein.“"
                            },
                            {
                                "example_id": "ecf54f47-7c03-4139-b75c-c3455d7314c9",
                                "sense_id": "aab62600-6b7d-3a2b-bf20-ab22e2d17da2",
                                "text": "„Er war der Armee beigetreten, wo man ihn der 82. Luftlandedivision in Fort Bragg in North Carolina zuwies.“"
                            },
                            {
                                "example_id": "c525bf45-12c5-4c06-ab79-e53456843f9d",
                                "sense_id": "aab62600-6b7d-3a2b-bf20-ab22e2d17da2",
                                "text": "„General Jonathan Hartwright, der frühere Befehlshaber der 82. Luftlandedivision und derzeitige Direktor der Defense Intelligence Agency, war per Video zugeschaltet und er wollte reden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
