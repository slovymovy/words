                "senses": [
                    {
                        "sense_id": "372301d5-9c8e-35bc-9e54-0889ca7565d7",
                        "entry_id": "ffe76760-67df-3108-ba87-c9d9982f5699",
                        "glosses": [
                            "Attacher un vaisseau avec des grappins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "174c0a76-70fb-4f3e-972e-d80cef2b3e17",
                                "sense_id": "372301d5-9c8e-35bc-9e54-0889ca7565d7",
                                "text": "Vaisseau grapinez fait alliance avec les Eskimeaux sur les glaces (voir illustration, notes)"
                            }
                        ]
                    },
                    {
                        "sense_id": "c6eec028-8054-382f-9839-b1844feb59dc",
                        "entry_id": "ffe76760-67df-3108-ba87-c9d9982f5699",
                        "glosses": [
                            "Nettoyer le verre en fusion."
                        ],
                        "tags": [
                            "Verrerie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "221d0a78-848c-3417-a1c7-07b2f9eb42b3",
                        "entry_id": "ffe76760-67df-3108-ba87-c9d9982f5699",
                        "glosses": [
                            "Prendre un poisson en plantant l’hameçon dans une autre partie que la bouche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08d63edd-00c0-41ae-9569-3e9376ee888b",
                                "sense_id": "221d0a78-848c-3417-a1c7-07b2f9eb42b3",
                                "text": "Grappiner : prendre un poisson en piquant l'hameçon ailleurs que dans la gueule, comme avec un grappin. Le grappinage peut être volontaire (braconnage) ou accidentel. On dit aussi \"harponner\" ou \"sabrer\"."
                            },
                            {
                                "example_id": "4eebc281-c52c-4061-a580-279aec69340f",
                                "sense_id": "221d0a78-848c-3417-a1c7-07b2f9eb42b3",
                                "text": "Alors que les pêcheurs à la mouche du secteur s’évertuent à préserver les ressources, des braconniers « viennent grappiner les poissons par le dos et quand ça ne va pas assez vite, ils prennent des filets » grogne Jean-Pierre Lorand, président d’honneur de la Gaule Antrainaise."
                            },
                            {
                                "example_id": "c4adafcc-e8e8-4379-9693-4cb13f89ab83",
                                "sense_id": "221d0a78-848c-3417-a1c7-07b2f9eb42b3",
                                "text": "Lors de la récente crue, il a surpris sur le chemin de halage qui mène à Roanne «trois gars en train de grappiner des poissons groggy»."
                            }
                        ]
                    }
                ],
