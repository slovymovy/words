                "senses": [
                    {
                        "sense_id": "d8fd75e7-587f-337b-91d5-f3270d012f29",
                        "entry_id": "73950749-2161-3101-989c-920e7ba0a548",
                        "glosses": [
                            "Qualité de ce qui est lavable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe171899-de88-4f61-94cd-066ec344369e",
                                "sense_id": "d8fd75e7-587f-337b-91d5-f3270d012f29",
                                "text": "Tel est le but des courbes de lavabilité des charbons imaginées par Hanappe, vers l'année 1912 et dont l'usage est devenu courant dans tous les lavoirs français et belges."
                            },
                            {
                                "example_id": "ec34fe8d-99cd-40a9-84fe-38c2fbbeeb70",
                                "sense_id": "d8fd75e7-587f-337b-91d5-f3270d012f29",
                                "text": "Le lavage du charbon est une opération mécanique ayant pour but d'éliminer de la houille traitée les particules d'une densité et d'une teneur en cendres plus élevées que le charbon pur. Toutefois, le degré de lavabilité d'un charbon brut est affecté par l'état physique et chimique, le poids spécifique des impuretés qu'il renferme."
                            },
                            {
                                "example_id": "49ccf338-c695-42a0-aea1-8bb0746a36f9",
                                "sense_id": "d8fd75e7-587f-337b-91d5-f3270d012f29",
                                "text": "[…] utilisé dans les émulsions, il procure une bonne lavabilité et une bonne pénétration dermique."
                            }
                        ]
                    }
                ],
