                "senses": [
                    {
                        "sense_id": "034505b8-1ce5-3b9e-8e1f-03b6d2a3e779",
                        "entry_id": "d75504ce-b776-3647-9a74-6685f49c009a",
                        "glosses": [
                            "Abdomen des chélicérates (araignées, etc.) résultant de la fusion du mésosome et du métasome et comprenant donc le cœur et l'appareil respiratoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcfdbe55-b558-4b45-b2d9-dcb4c58cdb1d",
                                "sense_id": "034505b8-1ce5-3b9e-8e1f-03b6d2a3e779",
                                "text": "Il faut souligner que la disparition des limites des métamères ou lipomérisme est surtout connue comme un phénomène de macroévolution; il se produit par exemple chez les Arachnides dont l’opisthosome a une segmentation visible chez les Scorpions et une segmentation cachée chez les Araignées."
                            },
                            {
                                "example_id": "6bc4bdd9-694f-42a9-ae1d-2a59e9024dd5",
                                "sense_id": "034505b8-1ce5-3b9e-8e1f-03b6d2a3e779",
                                "text": "Le corps, recouvert d’une cuticule, est divisé en deux tagmes : un prosome antérieur et un opisthosome postérieur."
                            }
                        ]
                    }
                ],
