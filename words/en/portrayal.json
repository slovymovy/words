    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3eb64d9d-70f3-3412-afc5-80b60284c16c",
                    "sense_definition": "A representation, description, or depiction of someone or something in art, literature, or performance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor won critical acclaim for his realistic <w>portrayal</w> of the troubled artist.",
                            "target_lang_translations": {
                                "zh": "这位演员因逼真地<w>刻画</w>了那位饱受困扰的艺术家而赢得了评论界的赞誉。"
                            }
                        },
                        {
                            "text": "The documentary offers an accurate <w>portrayal</w> of life in a small fishing community.",
                            "target_lang_translations": {
                                "zh": "这部纪录片对小渔村的生活进行了真实的<w>描绘</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "depiction",
                        "representation",
                        "characterization"
                    ],
                    "common_phrases": [
                        "accurate portrayal",
                        "realistic portrayal",
                        "sympathetic portrayal"
                    ],
                    "target_lang_definitions": {
                        "zh": "（艺术、文学作品或表演中对人或事物的）刻画，描绘，饰演"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "刻画",
                                "target_lang_sense_clarification": "对人物或形象的艺术描绘"
                            },
                            {
                                "target_lang_word": "扮演",
                                "target_lang_sense_clarification": "演员对角色的诠释或饰演"
                            },
                            {
                                "target_lang_word": "描写",
                                "target_lang_sense_clarification": "用文字或艺术形式表现出来的面貌"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be337732-0e81-3bf5-9f4f-a10239c5817f",
                    "sense_definition": "The act or process of depicting or representing someone or something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The media's <w>portrayal</w> of youth culture often relies on outdated stereotypes.",
                            "target_lang_translations": {
                                "zh": "媒体对青年文化的<w>报道</w>往往依赖于过时的刻板印象。"
                            }
                        },
                        {
                            "text": "She specialized in the <w>portrayal</w> of complex emotional states through dance.",
                            "target_lang_translations": {
                                "zh": "她擅长通过舞蹈来<w>表现</w>复杂的情感状态。"
                            }
                        }
                    ],
                    "synonyms": [
                        "depiction",
                        "representation"
                    ],
                    "common_phrases": [
                        "media portrayal"
                    ],
                    "target_lang_definitions": {
                        "zh": "描绘或表现某人、某事物的行为或过程"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "描绘",
                                "target_lang_sense_clarification": "表现或呈现某事物的行为"
                            },
                            {
                                "target_lang_word": "报道",
                                "target_lang_sense_clarification": "媒体对事物的呈现与描述"
                            },
                            {
                                "target_lang_word": "表现",
                                "target_lang_sense_clarification": "通过艺术等形式表达出某种状态或事物"
                            }
                        ]
