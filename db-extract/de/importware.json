                        "glosses": [
                            "Ware, die importiert wurde; die aus einem anderen Land eingeführt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fc98e61-83a5-4274-9ee4-4cbf44107b3b",
                                "sense_id": "5beec974-e83f-3d2a-a013-24a69be7aabc",
                                "text": "„Käse und Kartoffeln aus der Schweiz belasten die Umwelt weniger als Importware.“"
                            },
                            {
                                "example_id": "31de5299-8695-434f-b73c-2014ce184931",
                                "sense_id": "5beec974-e83f-3d2a-a013-24a69be7aabc",
                                "text": "„Auch die Importware anderer Sorten macht den Berufsfischern am Bodensee zu schaffen – beispielsweise der günstig verkaufte Pangasius aus Asien.“"
                            }
                        ],
