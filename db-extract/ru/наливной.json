                "senses": [
                    {
                        "sense_id": "b79115b7-ae54-30d5-9cf7-f3b793790605",
                        "entry_id": "f9c73d4c-eda1-308b-93d4-f4c0c6f278c6",
                        "glosses": [
                            "нар.-поэт. созревший, сочный (о плодах)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "620a1ffa-5269-4e0d-ab97-6ed39fa573db",
                                "sense_id": "b79115b7-ae54-30d5-9cf7-f3b793790605",
                                "text": "И к царевне наливное, молодое, золотое прямо яблочко летит."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd968508-d488-3b2b-86e6-558d23e1da28",
