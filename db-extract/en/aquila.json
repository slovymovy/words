                "forms": [],
                "senses": [
                    {
                        "sense_id": "d732d4f8-ea8b-30e0-9c90-1905ce7be3fd",
                        "entry_id": "f8350575-7637-3ea8-915f-650364c97c6a",
                        "glosses": [
                            "A summer constellation of the northern sky, said to resemble an eagle. It includes the star Altair."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7e6af22d-e824-367a-96b3-a90035e6d350",
                        "entry_id": "f8350575-7637-3ea8-915f-650364c97c6a",
                        "glosses": [
                            "An early Christian, the husband of Priscilla."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb4134e4-65a6-40d2-81bc-5a0281d74870",
                                "sense_id": "7e6af22d-e824-367a-96b3-a90035e6d350",
                                "text": "Salute Prisca and Aquila, and the household of Onesiphorus."
                            }
                        ]
                    }
                ],
