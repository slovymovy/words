                                                "sense_id": "4927c50f-ce85-3906-bb2b-175549060001",
                                                "text": "At this price, this car is a steal."
                                            },
                                            {
                                                "example_id": "d93f9f0d-a345-4387-82b9-92abcc8bde2c",
                                                "sense_id": "4927c50f-ce85-3906-bb2b-175549060001",
                                                "text": "He got that thing for just twenty bucks? What a steal!"
                                            },
