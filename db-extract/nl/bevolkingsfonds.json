                        "glosses": [
                            "organisatie die zich bezighoudt met de ontwikkeling van de bevolkingsgrootte en voortplanting van de mens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "696c0466-2380-451a-a707-14f8a438ad6b",
                                "sense_id": "0898b6aa-0ab4-3513-96f8-11e343150b61",
                                "text": "Het bevolkingsfonds UNFPA deed onderzoek onder vrouwen in 57 landen. Van hen blijkt ongeveer de helft zelf beslissingen te kunnen nemen over seks, anticonceptie en gezondheidszorg."
                            },
                            {
                                "example_id": "faf7d7d7-718a-4b48-8ed8-e65ad232ff8e",
                                "sense_id": "0898b6aa-0ab4-3513-96f8-11e343150b61",
                                "text": "De Verenigde Staten zijn definitief gestopt met de financiering van het Bevolkingsfonds van de VN (UNFPA). De maatregel was in januari al aangekondigd door president Trump. Het Bevolkingsfonds zet zich in voor gelijke kansen op een gezond leven."
                            },
                            {
                                "example_id": "62808e53-2a20-473d-8473-2080c46c8bd1",
                                "sense_id": "0898b6aa-0ab4-3513-96f8-11e343150b61",
                                "text": "Alle bevrijde meisjes en vrouwen zijn medisch onderzocht. Bij zeker 214 van hen is een zwangerschap vastgesteld. Volgens directeur Oshotimehin van het Bevolkingsfonds van de Verenigde Naties (UNFPA) worden alle zwangeren medisch begeleid."
                            }
                        ]
                    }
