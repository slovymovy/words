                "senses": [
                    {
                        "sense_id": "dbebe632-8e02-3b26-b124-b0eda2427aec",
                        "entry_id": "9f689b3b-a622-384f-86f8-7e70913d81db",
                        "glosses": [
                            "Nonsens-Maschine, die eine bestimmte Aufgabe absichtlich in zahlreichen unnötigen und komplizierten Einzelschritten ausführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55e2f79a-92d9-4a05-b04d-6bfcb7e12562",
                                "sense_id": "dbebe632-8e02-3b26-b124-b0eda2427aec",
                                "text": "„Eine Unterhaltung war wie eine dieser Rube-Goldberg-Maschinen, bei denen ein Vogel nach einem Korn pickt, das an einen Schalter geklebt ist, wodurch der Schalter gedrückt wird, der eine Diesellok aktiviert, die über 100 Meilen Schienen fährt, bis sie in eine Atombombe kracht, deren Explosion eine Maus in Neuseeland erschreckt, sodass sie einen Brocken Blauschimmelkäse auf eine Waage fallen lässt, wodurch die leere Waagschale angehoben wird, die einen Schalter umlegt, durch den ein Stolperdraht durchtrennt wird, woraufhin ein Hammer mit gerade genug Wucht herunterfällt, um die Schale einer Pistazie zu knacken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afcdefaa-a703-4fb6-8ea0-f08e6c60149d",
                        "source_entry_id": "9f689b3b-a622-384f-86f8-7e70913d81db",
                        "source_sense_id": "dbebe632-8e02-3b26-b124-b0eda2427aec",
                        "target_lang_word": "Rube Goldberg machine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rube Goldberg machine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f271d8e4-39dc-3157-9c09-e73855b1b038",
                                        "entry_id": "75879424-b0cf-3db4-a06b-78a7cf4ea113",
                                        "glosses": [
                                            "A comical, overcomplicated machine which performs a simple task."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d376f16-7ebb-3ed0-809f-93a13835de65",
                                        "entry_id": "75879424-b0cf-3db4-a06b-78a7cf4ea113",
                                        "glosses": [
                                            "Anything that is overly complicated."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2985fe40-75c1-4140-af8a-fd7a14d150ec",
                                                "sense_id": "8d376f16-7ebb-3ed0-809f-93a13835de65",
                                                "text": "To be overly cynical myself, that is still the macro view. Littlefinger’s execution and the white walkers passing through the rubble of the Wall are just two observations that this enormous Rube Goldberg machine is running on time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d944b39f-fab6-4907-a7d9-c59b35e8b37a",
                        "source_entry_id": "9f689b3b-a622-384f-86f8-7e70913d81db",
                        "source_sense_id": "dbebe632-8e02-3b26-b124-b0eda2427aec",
                        "target_lang_word": "machine de Rube Goldberg",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machine de Rube Goldberg",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4082e1dc-2fa2-3fb0-8093-0de0140deca2",
                                        "entry_id": "2d0e3cfd-c1a0-3ac5-8eb6-d541f5481363",
                                        "glosses": [
                                            "Machine qui réalise une tâche simple d’une manière délibérément complexifiée, le plus souvent à l’aide d’une réaction en chaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa9451bc-ff66-45f0-ac08-a52e53127ea5",
                                                "sense_id": "4082e1dc-2fa2-3fb0-8093-0de0140deca2",
                                                "text": "Une machine de Rube Goldberg effectue une tâche simple d’une manière complexe."
                                            },
                                            {
                                                "example_id": "3130686b-ad21-4f38-b89f-ce6ea1c00355",
                                                "sense_id": "4082e1dc-2fa2-3fb0-8093-0de0140deca2",
                                                "text": "Vous avez commencé avec une idée simple, et maintenant ça s’est transformé en une véritable machine de Rube Goldberg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
