                        "entry_id": "9416a030-31f9-32f2-88b1-7567aa7c153a",
                        "glosses": [
                            "ogród podmiejski będący miejscem rozrywki"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5da4e6be-fb88-45da-a3d7-fac64d89b76e",
                                "sense_id": "ce91fba2-4a90-32b9-82e6-6193cf1eafbb",
                                "text": "Nie tylko od święta, ale i w dni powszednie ulubionym miejscem spędzania czasu były liczne piwiarnie, kawiarniane ogródki i foksale."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
