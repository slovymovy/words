                ],
                "senses": [
                    {
                        "sense_id": "fb14be57-6db5-33d7-88be-cb3e2ae95862",
                        "entry_id": "e254c0c0-ed09-3fb3-8306-55bc28fd67cc",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0bf7ab8-02f5-4906-a176-e63bd46a2329",
                                "sense_id": "fb14be57-6db5-33d7-88be-cb3e2ae95862",
                                "text": "Frau Wackerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "38b86fc7-80aa-45f7-b1d8-5be71a03212b",
                                "sense_id": "fb14be57-6db5-33d7-88be-cb3e2ae95862",
                                "text": "Herr Wackerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dcbc0519-747a-4096-98f2-08a6fca51e8e",
                                "sense_id": "fb14be57-6db5-33d7-88be-cb3e2ae95862",
                                "text": "Die Wackerles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "17ab7de8-1bc7-4671-945d-9ed86211a75d",
                                "sense_id": "fb14be57-6db5-33d7-88be-cb3e2ae95862",
                                "text": "Der Wackerle trägt nie die Schals, die die Wackerle ihm strickt."
                            },
                            {
                                "example_id": "0f963520-b524-4d7a-9d87-14ed57dabc18",
                                "sense_id": "fb14be57-6db5-33d7-88be-cb3e2ae95862",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wackerle kommt, geht der Herr Wackerle.“"
                            },
                            {
                                "example_id": "a3d4f010-e60a-4a26-8faa-0c134072e70d",
                                "sense_id": "fb14be57-6db5-33d7-88be-cb3e2ae95862",
                                "text": "Wackerle kommt und geht."
                            },
                            {
                                "example_id": "276853a1-f04e-4806-93ff-abf57249d3ce",
                                "sense_id": "fb14be57-6db5-33d7-88be-cb3e2ae95862",
                                "text": "Wackerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
