                "senses": [
                    {
                        "sense_id": "c0c3e9a2-00bd-385d-8211-b41b8659d750",
                        "entry_id": "68743748-3655-3fa8-b313-272c3a86aefa",
                        "glosses": [
                            "eingedickter, konzentrierter Bratensaft oder starke, reduzierte (Fleisch-)Brühe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c4a4823-8035-4b40-8651-054e35adaa9f",
                                "sense_id": "c0c3e9a2-00bd-385d-8211-b41b8659d750",
                                "text": "„Aus dem gewonnenen Jus wird mit Fond ein einmaliger Hummerschaum geschlagen, der das Fleisch vorzüglich abrundet.“"
                            },
                            {
                                "example_id": "6cce878e-c36e-420f-ab3d-c198d561fbb7",
                                "sense_id": "c0c3e9a2-00bd-385d-8211-b41b8659d750",
                                "text": "„Während ich sonst gern Spareribs mit Röstkartoffelecken esse oder gebratene Schweinshaxe mit Jus, lade ich mir nun an der Salatbar geriebene Möhren und Feta auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
