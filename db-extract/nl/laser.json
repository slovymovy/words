                    {
                        "translation_id": "d731d5dd-ce68-4475-b9d5-b40585041fa7",
                        "source_entry_id": "9768e12a-8079-3595-a54d-f207ee5cc46c",
                        "source_sense_id": "7ccecd84-fd93-3927-bf28-ec70ff460b2e",
                        "source_sense_description": "lichtbron die uiterst intense lichtstraal van één kleur uitzendt",
                        "target_lang_word": "laser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c932e910-4af2-36bf-9377-a80360ca56e1",
                                        "entry_id": "91132b67-1e90-33f8-a9ac-4fea590e6b34",
                                        "glosses": [
                                            "Plante de la famille des ombellifères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cc8785c-5850-4d20-9e0f-8408476a68f1",
                                                "sense_id": "c932e910-4af2-36bf-9377-a80360ca56e1",
                                                "text": "Le laser à feuilles larges, à racine cylindrique, a des fleurs blanches disposées en ombelles larges et ouvertes."
                                            },
                                            {
                                                "example_id": "d6072cee-657d-4a1d-8ce3-0389bf390090",
                                                "sense_id": "c932e910-4af2-36bf-9377-a80360ca56e1",
                                                "text": "La liqueur de laser est âcre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65bcd3e9-9627-3c0e-9ebe-c00cc8042d28",
                                        "entry_id": "f1ce4c08-516c-36bd-8cd4-0c2a9c69f1a5",
                                        "glosses": [
                                            "Source de lumière (ou de rayonnement de même nature : infrarouge, ultraviolet, etc.) exploitant le phénomène très spécifique démission stimulée, qui permet d'obtenir un faisceau aux propriétés particulières : directivité, cohérence (utile en interférométrie), monochromaticité, densité énergétique, etc."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "973edaa3-6d1d-34bb-a0f5-1d0e95f79eb3",
                                        "entry_id": "f1ce4c08-516c-36bd-8cd4-0c2a9c69f1a5",
                                        "glosses": [
                                            "Dispositif qui amplifie la lumière (et plus généralement tout rayonnement électromagnétique)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de6a0dde-6636-45fd-b5e0-71d8c7270469",
                                                "sense_id": "973edaa3-6d1d-34bb-a0f5-1d0e95f79eb3",
                                                "text": "Le laser est utilisé en médecine comme moyen de microcoagulation (notamment en ophtalmologie et en hématologie), du fait de son effet calorifique très intense et nettement circonscrit."
                                            },
                                            {
                                                "example_id": "28f506ea-a4d1-4b30-961b-34e4dd73458f",
                                                "sense_id": "973edaa3-6d1d-34bb-a0f5-1d0e95f79eb3",
                                                "text": "Le laser produit une lumière spatialement et temporellement cohérente basée sur l’effet laser."
                                            },
                                            {
                                                "example_id": "40a4bc34-9997-45e9-b311-74de60683db7",
                                                "sense_id": "973edaa3-6d1d-34bb-a0f5-1d0e95f79eb3",
                                                "text": "Comment est-on arrivé à une telle ubiquité en 60 ans ? C’est curieux, car dans les premiers temps les lasers étaient dénigrés comme des dispositifs inutiles alors qu’aujourd’hui ils sont devenus indispensables. Les premiers lasers sont nés d’une idée que Charles Townes, assis dans un parc à Washington, eut en 1951 pour amplifier des microondes – comme celles des fours"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53cf89be-7a24-31a8-beb3-6ec99f4e56f7",
                                        "entry_id": "f1ce4c08-516c-36bd-8cd4-0c2a9c69f1a5",
                                        "glosses": [
                                            "Ellipse de disque laser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21ea1199-088c-4402-b3e2-a92190ec4c47",
                                                "sense_id": "53cf89be-7a24-31a8-beb3-6ec99f4e56f7",
                                                "text": "Dès mon arrivée, abandonnant dans la cuisine, sans les déballer, les provisions que j’avais apportées, nous faisions l’amour. Un laser était déjà glissé dans la chaîne, mis en route aussitôt que nous entrions dans la chambre, le plus souvent les Doors. À un moment, je cessais d’entendre la musique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f4caec2-587f-39af-9647-1be43b4702d6",
                                        "entry_id": "42c26a96-6888-3d66-a893-b52c7810c7db",
                                        "glosses": [
                                            "Dériveur monotype solitaire de série olympique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bffe341-1421-4e0d-9a60-f94966894f68",
                                                "sense_id": "3f4caec2-587f-39af-9647-1be43b4702d6",
                                                "text": "Cette régate a été très sympathique, le passage aux bouées voyait se battre pas moins de cinq lasers en même temps."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b5969c3-e900-3dc8-889b-7d5132bbd305",
                                        "entry_id": "701b32be-f52b-39d0-8fe8-6cc6d1790226",
                                        "glosses": [
                                            "(Par apposition) Qui concerne le laser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6abf66d-a4ca-4147-b19d-68f5e1bfe13b",
                                                "sense_id": "2b5969c3-e900-3dc8-889b-7d5132bbd305",
                                                "text": "Tels George Lucas sur la première trilogie Star War, ses producteurs se sont permis un lifting à coups d'effets spéciaux de synthèse pas très réussis, glissant des vaisseaux à rayons laser fluos ici, des kaméhaméhas translucides là, n'ajoutant qu'une couche de nanardise supplémentaire."
                                            },
                                            {
                                                "example_id": "d8d3aa0d-3145-4d8c-8d9f-3b33f5490cd0",
                                                "sense_id": "2b5969c3-e900-3dc8-889b-7d5132bbd305",
                                                "text": "L’appareil — un scanner — va émettre un signal infrarouge à une grande fréquence (500 MHz), une onde laser vers le sol. Et il va ensuite enregistrer le retour de cette onde ». En pratique, le rayon va taper une surface comme un bâtiment, un arbre, un pylône, puis revenir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bad29cd4-b30c-3f48-bf1b-84a87ccbc2cd",
                                        "entry_id": "2073b8d2-255a-3857-8455-1cdd3355a288",
                                        "glosses": [
                                            "Se dit d’un dispositif ou d’une substance qui se met à émettre des rayons laser."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0fa6d0a-053a-421e-a385-73265b053425",
                                                "sense_id": "bad29cd4-b30c-3f48-bf1b-84a87ccbc2cd",
                                                "text": "L’émission spontanée a peuplé simultanément et aléatoirement un certain nombre de modes de la cavité qui se mettent rapidement à laser. […] Ce faisant, la cavité va se mettre à laser ailleurs où les pertes sont moins élevées, c'est-à-dire là où le gain de la courbe d’émission est maximum avec l’ajout de l’effet Fabry-Perot."
                                            }
