{
    "word_family": [
        "deflation",
        "deflationary",
        "deflator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e2afc13b-9b3a-388c-bb8d-3928c8d16762",
                    "sense_definition": "To remove air or gas from an elastic container like a balloon or tire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>deflate</w> the tires before driving on the soft sand.",
                            "target_lang_translations": {
                                "zh": "在松软的沙地上行驶前，你需要给轮胎<w>放气</w>。"
                            }
                        },
                        {
                            "text": "It is easy to <w>deflate</w> a balloon by untying the knot.",
                            "target_lang_translations": {
                                "zh": "解开结就能很容易地给气球<w>放气</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "empty"
                    ],
                    "antonyms": [
                        "inflate"
                    ],
                    "common_phrases": [
                        "deflate a tire"
                    ],
                    "target_lang_definitions": {
                        "zh": "使充气物体（如气球或轮胎）中的气体排出。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "放气",
                                "target_lang_sense_clarification": "指主动排出容器内的气体。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8883a3dc-5c65-35f6-a32a-80ca22304cdb",
                    "sense_definition": "To lose air or gas and become smaller.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bouncy castle began to <w>deflate</w> as soon as the power was cut.",
                            "target_lang_translations": {
                                "zh": "电源一断，充气城堡就开始<w>瘪掉</w>了。"
                            }
                        },
                        {
                            "text": "Watch the pool <w>deflate</w> slowly after you open the valve.",
                            "target_lang_translations": {
                                "zh": "打开阀门后，看着游泳池慢慢<w>泄气</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "inflate"
                    ],
                    "target_lang_definitions": {
                        "zh": "指物体漏气而变瘪。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "瘪掉",
                                "target_lang_sense_clarification": "指物体因失去气体而塌陷。"
                            },
                            {
                                "target_lang_word": "泄气",
                                "target_lang_sense_clarification": "指物体因漏气而体积减小。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95b159e8-6f4b-3540-8165-4cc7690f7c4b",
                    "sense_definition": "To make someone feel less confident or proud.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His harsh criticism served to <w>deflate</w> her ego completely.",
                            "target_lang_translations": {
                                "zh": "他严厉的批评彻底<w>挫伤</w>了她的傲气。"
                            }
                        },
                        {
                            "text": "It was a <w>deflating</w> experience to lose the game in the final minute.",
                            "target_lang_translations": {
                                "zh": "在最后一分钟输掉比赛是一次令人<w>泄气</w>的经历。"
                            }
                        }
                    ],
                    "synonyms": [
                        "humble",
                        "dishearten"
                    ],
                    "common_phrases": [
                        "deflate someone's ego"
                    ],
                    "target_lang_definitions": {
                        "zh": "使某人感到泄气、自信心受挫或傲气减弱。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挫伤",
                                "target_lang_sense_clarification": "指打击某人的自信心或锐气。"
                            },
                            {
                                "target_lang_word": "泄气",
                                "target_lang_sense_clarification": "指使人失去信心或热情。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9310006-78fb-3499-9cc5-7622488ad054",
                    "sense_definition": "To cause something to shrink or decrease in size or importance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden news helped to <w>deflate</w> the excitement surrounding the event.",
                            "target_lang_translations": {
                                "zh": "突如其来的消息使围绕该活动的兴奋感有所<w>减弱</w>。"
                            }
                        },
                        {
                            "text": "Rising costs <w>deflate</w> the value of the company's assets.",
                            "target_lang_translations": {
                                "zh": "成本上升<w>缩减</w>了公司资产的价值。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shrink",
                        "diminish"
                    ],
                    "antonyms": [
                        "inflate"
                    ],
                    "target_lang_definitions": {
                        "zh": "使某事物缩小、减弱或重要性降低。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "减弱",
                                "target_lang_sense_clarification": "指程度或影响力的降低。"
                            },
                            {
                                "target_lang_word": "缩减",
                                "target_lang_sense_clarification": "指规模或价值的减少。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63357dab-5b54-3407-8622-43c94dcdfbe1",
                    "sense_definition": "To reduce the supply of money or credit in an economy to lower prices.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "economic_reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The central bank decided to <w>deflate</w> the economy to combat rising inflation.",
                            "target_lang_translations": {
                                "zh": "中央银行决定<w>紧缩</w>经济以应对日益严重的通货膨胀。"
                            }
                        },
                        {
                            "text": "Governments rarely choose to <w>deflate</w> the currency due to the risk of recession.",
                            "target_lang_translations": {
                                "zh": "由于存在经济衰退的风险，政府很少选择<w>紧缩</w>货币。"
                            }
                        }
                    ],
                    "antonyms": [
                        "inflate"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过减少货币供应或信贷来抑制通货膨胀。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "紧缩",
                                "target_lang_sense_clarification": "指经济政策上的紧缩货币。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73563a59-5edc-3431-a4ae-a806e4f256e3",
                    "sense_definition": "To compress digital data using a specific algorithm.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>deflate</w> the archive files to save storage space on the server.",
                            "target_lang_translations": {
                                "zh": "你必须<w>压缩</w>归档文件以节省服务器上的存储空间。"
                            }
                        },
                        {
                            "text": "The software is designed to <w>deflate</w> large datasets efficiently.",
                            "target_lang_translations": {
                                "zh": "该软件旨在高效地<w>压缩</w>大型数据集。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compress"
                    ],
                    "target_lang_definitions": {
                        "zh": "使用特定算法对数字数据进行压缩。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "压缩",
                                "target_lang_sense_clarification": "指计算机数据处理中的压缩技术。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dc8d04d-6a6e-39d4-aa8d-f8520d9d42aa",
                    "sense_definition": "To release gas from the bowels.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bodily_function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is considered impolite to <w>deflate</w> in a crowded room.",
                            "target_lang_translations": {
                                "zh": "在拥挤的房间里<w>放屁</w>被认为是不礼貌的。"
                            }
                        },
                        {
                            "text": "He tried to <w>deflate</w> quietly, but the sound was audible.",
                            "target_lang_translations": {
                                "zh": "他试图悄悄地<w>放屁</w>，但还是发出了声音。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fart"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Euphemistic usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指排气（委婉语）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "放屁",
                                "target_lang_sense_clarification": "指肠道排气。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}