                        "entry_id": "fb58a820-3db2-37ac-8b4d-90234ee5c5a6",
                        "glosses": [
                            "Action d’éveiller ou de s’éveiller."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "944cf746-3f01-3322-825e-c9e685fc8ccd",
                        "entry_id": "fb58a820-3db2-37ac-8b4d-90234ee5c5a6",
                        "glosses": [
                            "Alarme."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "16fa406e-c8ef-47c1-9f85-99b1dc0445ed",
                                "sense_id": "944cf746-3f01-3322-825e-c9e685fc8ccd",
                                "text": "Une fois l’éveil donné, tout le camp fut sur pied."
                            }
                        ]
                    },
                    {
                        "sense_id": "fae318d6-e7a0-3650-a528-f62243850163",
                        "entry_id": "fb58a820-3db2-37ac-8b4d-90234ee5c5a6",
                        "glosses": [
                            "Avertissement que l’on donne de bien veiller, d’être sur ses gardes."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3e22ffa4-515d-4096-bc7f-2d8a3aff84d6",
                                "sense_id": "fae318d6-e7a0-3650-a528-f62243850163",
                                "text": "Je n’en ai eu l’éveil que tout à l’heure."
                            },
                            {
                                "example_id": "e8dfa18b-644d-43fe-b086-06033b4cc271",
                                "sense_id": "fae318d6-e7a0-3650-a528-f62243850163",
                                "text": "Donner l’éveil."
                            }
                        ]
                    },
                    {
                        "sense_id": "07a92053-4a59-359f-8c42-e2573ab826c1",
                        "entry_id": "fb58a820-3db2-37ac-8b4d-90234ee5c5a6",
                        "glosses": [
                            "Action d'éveiller son esprit, son intelligence, sa pensée."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ef5bb5c1-022f-4536-ad39-80789aa19947",
                                "sense_id": "07a92053-4a59-359f-8c42-e2573ab826c1",
                                "text": "L’éveil de l’intelligence, de la sensibilité, des sens, de la nature."
                            },
                            {
                                "example_id": "c188e798-27fe-4403-93ea-a144fc5706a0",
                                "sense_id": "07a92053-4a59-359f-8c42-e2573ab826c1",
                                "text": "Ce qui s’auto-détermine, à savoir l’éveil à soi, doit se trouver derrière tout ce qui est pensé comme plan de la conscience."
                            },
                            {
                                "example_id": "354e1af1-eed1-4304-be84-49d5813f5011",
                                "sense_id": "07a92053-4a59-359f-8c42-e2573ab826c1",
                                "text": "L’éveil du Bouddha."
                            }
                        ]
                    }
                ],
