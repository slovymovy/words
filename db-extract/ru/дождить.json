                ],
                "senses": [
                    {
                        "sense_id": "30e9dd58-d2fd-398d-a0cd-5f3e1e654722",
                        "entry_id": "28409bc4-96be-3535-a9fd-036516853e1f",
                        "glosses": [
                            "неперех., устар. и книжн. испускать, проливать дождь"
                        ],
                        "tags": [
                            "что., чем., где., на кого., на что и без доп."
                        ],
                        "examples": [
                            {
                                "example_id": "b79aaf54-86e4-4de2-ac5f-8ee6b8b99ace",
                                "sense_id": "30e9dd58-d2fd-398d-a0cd-5f3e1e654722",
                                "text": "Ум тупеет, грудь устала, // Чувство стынет в этой мгле, // Что зари сиянье прячет, // И дождит, как будто плачет, // Расстилаясь по земле."
                            },
                            {
                                "example_id": "034ec6a9-4106-402b-a40a-1025de4abc20",
                                "sense_id": "30e9dd58-d2fd-398d-a0cd-5f3e1e654722",
                                "text": "На земле дождила пасмурная хмарь, и не верилось, что где-то может быть солнце."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6ee66a3-267e-3f9b-9b46-efaa271c4c2e",
                        "entry_id": "28409bc4-96be-3535-a9fd-036516853e1f",
                        "glosses": [
                            "перех. и неперех., устар. и книжн., перен. кропить, окроплять; дарить, одарять, осыпать, расточать [Даль]"
                        ],
                        "tags": [
                            "кто., что., кого., что., чем., где., на кого., на что и без доп."
                        ],
                        "examples": [
                            {
                                "example_id": "26a3b0f3-88be-4b2e-b8be-c40146d00056",
                                "sense_id": "a6ee66a3-267e-3f9b-9b46-efaa271c4c2e",
                                "text": "Поп дождит кропилом."
                            },
                            {
                                "example_id": "2777ae4f-6f9e-4f14-a2f6-51df847e2046",
                                "sense_id": "a6ee66a3-267e-3f9b-9b46-efaa271c4c2e",
                                "text": "Но просвещенных умны очи // Другой пророчеств видят знак: // Се облак восстает с полночи // И блеском гонит с тверди мрак; // Лучи распространя веселы // На все российские пределы, // Он златом и сребром дождит."
                            }
                        ]
                    }
                ],
