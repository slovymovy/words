                        "examples": [
                            {
                                "example_id": "77ada6fe-2b01-47b2-9805-8eeae5b98b94",
                                "sense_id": "ea215872-eecb-3fc5-b73e-951f9c65e000",
                                "text": "The necessity of contractual safeguardings in PPPs was emphasized by most interview partners."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6936d96-5049-3d51-a034-3e9f2eec8570",
                        "entry_id": "169af45d-2c83-349c-b67e-ac224ab4e8d8",
                        "glosses": [
                            "Policies and actions for the protection of children and vulnerable adults."
                        ],
                        "tags": [
                            "Ireland",
                            "UK",
                            "countable",
                            "formal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "85a6a7cd-e6d5-4b48-88a1-78475df6b193",
                                "sense_id": "e6936d96-5049-3d51-a034-3e9f2eec8570",
                                "text": "We cannot have a culture that sees safeguarding as a separate add-on. It needs to be part of our DNA, as an expression of our love for one another and our commitment to the Gospel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe2fbdca-0de4-4534-ade3-9ba78b6b89be",
                        "source_entry_id": "169af45d-2c83-349c-b67e-ac224ab4e8d8",
                        "source_sense_description": "protection",
                        "target_lang_word": "προστασία",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "προστασία",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "23f44cea-c605-3362-8f7a-e07bfeebb42a",
                                        "entry_id": "2cd25a1d-3df8-359d-8092-378731acc41e",
                                        "glosses": [
                                            "η φύλαξη ή απομάκρυνση από τον κίνδυνο"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c38484e4-a937-4659-ac32-2d1f1b137d5d",
                                                "sense_id": "23f44cea-c605-3362-8f7a-e07bfeebb42a",
                                                "text": "※ Στο Τμήμα Υδροοικονομίας υπάγονται οι αρμοδιότητες, που αφορούν κυρίως στην προστασία και τη διαχείριση υδάτων, όπως οι κατωτέρω: .. γ) Η έκδοση αποφάσεων του περιφερειάρχη για την επιβολή περιορισμών ή άλλων μέτρων για τη χρήση υδάτων και την εκτέλεση έργων αξιοποίησής τους. (Χρίστος Λαδιάς, Το σύγχρονο θεσμικό πλαίσιο της περιφερειακής ανάπτυξης στην Ελλάδα, εκδ. Παπαζήση, 2023, σελ. 71)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4de335d6-7215-447b-b27f-43cdd094e71a",
                        "source_entry_id": "169af45d-2c83-349c-b67e-ac224ab4e8d8",
                        "source_sense_description": "protection",
                        "target_lang_word": "εξασφάλιση",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "εξασφάλιση",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "9bbaf195-937c-3231-a2cf-0e3ad169efe1",
                                        "entry_id": "27e1e770-9a7b-3a6e-966c-cbf1d7fc9df8",
                                        "glosses": [
                                            "η διαδικασία ή το αποτέλεσμα του εξασφαλίζω"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "778142eb-f336-4eb2-9aaa-cdf0b3b8fdd1",
                                                "sense_id": "9bbaf195-937c-3231-a2cf-0e3ad169efe1",
                                                "text": "※ Ο Χομπς είναι υπέρ μιας απόλυτης εξουσίας, γιατί διαφορετικά δε θεωρεί ότι υπάρχει εγγύηση για μια σταθερή και ειρηνική ζωή. Δεν πρόκειται όμως για μια αυθαίρετη εξουσία που κάνει «ό,τι θέλει». Πρέπει να εγγυάται την αμερόληπτη απονομή δικαιοσύνης, ώστε να μην τιμωρούνται αθώοι, την επιβολή δίκαιης φορολογίας, την κατοχύρωση της ατομικής ιδιοκτησίας, την εκπαίδευση των πολιτών, την εξασφάλιση όχι μόνο της ζωής, αλλά και μιας άνετης ζωής. (Αχιλλέας Παπαθανασίου, Αρχαία Ελληνικά Ι - Ομάδα προσανατολισμού ανθρωπιστικών ανθρωπιστικών σπουδών - Γ΄ Λυκείου, εκδ. Μεταίχμιο, 2019, σελ. 314)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
