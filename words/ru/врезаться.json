{
    "word_family": [
        "резать",
        "врезка",
        "вырезать",
        "надрезать",
        "порезать",
        "срезать",
        "отрезать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e36cfa03-0c09-3ad9-a243-ce0c91e6634d",
                    "sense_definition": "Стремительно двигаясь, с силой наскочить или столкнуться с кем-либо или чем-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "столкновение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Автомобиль на скользкой дороге потерял управление и на полной скорости <w>врезался</w> в столб.",
                            "target_lang_translations": {
                                "en": "The car lost control on the icy road and <w>crashed into</w> a pole at full speed."
                            }
                        },
                        {
                            "text": "Мальчик бежал по коридору школы и случайно со всего размаху <w>врезался</w> в учителя.",
                            "target_lang_translations": {
                                "en": "The boy was running down the school corridor and accidentally <w>slammed into</w> the teacher at full speed."
                            }
                        }
                    ],
                    "synonyms": [
                        "наскочить",
                        "налететь"
                    ],
                    "common_phrases": [
                        "врезаться на скорости",
                        "врезаться в стену",
                        "врезаться в дерево"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление при описании столкновения"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To crash, collide violently, or run into someone or something while moving fast."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crash into",
                                "target_lang_sense_clarification": "vehicles or objects colliding with force"
                            },
                            {
                                "target_lang_word": "smash into",
                                "target_lang_sense_clarification": "violent impact"
                            },
                            {
                                "target_lang_word": "run into",
                                "target_lang_sense_clarification": "bumping into someone or something while running"
                            },
                            {
                                "target_lang_word": "plow into",
                                "target_lang_sense_clarification": "crashing into something at high speed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5b60f8b-30d4-329d-86d2-ad322937c592",
                    "sense_definition": "Глубоко запечатлеться, прочно и надолго сохраниться в памяти, сознании или душе.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "память",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его испуганный взгляд навсегда <w>врезался</w> в мою память.",
                            "target_lang_translations": {
                                "en": "His frightened look was forever <w>etched</w> in my memory."
                            }
                        },
                        {
                            "text": "Слова первой учительницы неожиданно глубоко <w>врезались</w> мне в душу.",
                            "target_lang_translations": {
                                "en": "The first teacher's words <w>cut deep into</w> my soul unexpectedly."
                            }
                        }
                    ],
                    "synonyms": [
                        "запечатлеться"
                    ],
                    "common_phrases": [
                        "врезаться в память",
                        "навсегда врезаться",
                        "глубоко врезаться в душу"
                    ],
                    "target_lang_definitions": {
                        "en": "To become firmly etched or engraved in one's memory, mind, or soul."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stick in one's mind",
                                "target_lang_sense_clarification": "remain vividly remembered"
                            },
                            {
                                "target_lang_word": "be etched in one's memory",
                                "target_lang_sense_clarification": "leave a lasting, unforgettable impression"
                            },
                            {
                                "target_lang_word": "sear into one's memory",
                                "target_lang_sense_clarification": "imprint deeply and painfully or intensely"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aae02993-b46f-3b64-a399-6d6d38cccb77",
                    "sense_definition": "Войти внутрь предмета режущей частью или глубоко вонзиться остриём во что-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "проникновение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Острый топор с глухим стуком глубоко <w>врезался</w> в сухую древесину.",
                            "target_lang_translations": {
                                "en": "The sharp axe <w>bit deep into</w> the dry wood with a dull thud."
                            }
                        },
                        {
                            "text": "Тонкая и тугая верёвка больно <w>врезалась</w> пленнику в запястья.",
                            "target_lang_translations": {
                                "en": "The thin, tight rope was painfully <w>digging into</w> the prisoner's wrists."
                            }
                        }
                    ],
                    "synonyms": [
                        "воткнуться",
                        "вонзиться"
                    ],
                    "common_phrases": [
                        "больно врезаться",
                        "глубоко врезаться"
                    ],
                    "target_lang_definitions": {
                        "en": "To cut, bite, or penetrate deeply into something with a sharp edge, tight strap, or point."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dig into",
                                "target_lang_sense_clarification": "a tight cord, strap, or blade pressing deeply into skin or material"
                            },
                            {
                                "target_lang_word": "cut into",
                                "target_lang_sense_clarification": "a sharp edge or tight band slicing into a surface"
                            },
                            {
                                "target_lang_word": "bite into",
                                "target_lang_sense_clarification": "an axe, blade, or tool penetrating deeply"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce4eb5f4-b6f2-370e-a5d0-db0a5b4c0ad6",
                    "sense_definition": "Вдаться узкой полосой, клином внутрь какого-либо пространства, территории.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "пространство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Длинный песчаный мыс далеко <w>врезался</w> в открытое море.",
                            "target_lang_translations": {
                                "en": "The long sand spit <w>jutted</w> far out into the open sea."
                            }
                        },
                        {
                            "text": "Густой сосновый лес узкой тёмной полосой <w>врезался</w> прямо в поле.",
                            "target_lang_translations": {
                                "en": "The dense pine forest <w>wedged</w> straight into the field in a narrow dark strip."
                            }
                        }
                    ],
                    "synonyms": [
                        "вдаться",
                        "вклиниться"
                    ],
                    "common_phrases": [
                        "врезаться в море",
                        "узким клином врезаться"
                    ],
                    "target_lang_definitions": {
                        "en": "To jut, project, or jut out like a wedge into an area or expanse."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jut into",
                                "target_lang_sense_clarification": "extend outward into a body of water or space"
                            },
                            {
                                "target_lang_word": "project into",
                                "target_lang_sense_clarification": "extend forward or stick out into"
                            },
                            {
                                "target_lang_word": "wedge into",
                                "target_lang_sense_clarification": "penetrate a landscape as a wedge or strip"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdca9486-88be-38c7-a80b-b6f110f362e0",
                    "sense_definition": "Стремительно проникнуть, стремительно ворваться внутрь массы людей, строя или группы.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "проникновение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Конный отряд неожиданным ударом стремительно <w>врезался</w> в ряды противника.",
                            "target_lang_translations": {
                                "en": "With a surprise strike, the cavalry unit swiftly <w>charged into</w> the enemy ranks."
                            }
                        },
                        {
                            "text": "Спешащий пассажир с огромным чемоданом буквально <w>врезался</w> в плотную толпу на перроне.",
                            "target_lang_translations": {
                                "en": "The hurried passenger with a huge suitcase literally <w>plowed into</w> the dense crowd on the platform."
                            }
                        }
                    ],
                    "synonyms": [
                        "ворваться",
                        "вклиниться"
                    ],
                    "common_phrases": [
                        "врезаться в толпу",
                        "врезаться в ряды"
                    ],
                    "target_lang_definitions": {
                        "en": "To charge, burst, or plunge rapidly into a crowd, formation, or group."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "charge into",
                                "target_lang_sense_clarification": "rush forcefully into enemy ranks or crowds"
                            },
                            {
                                "target_lang_word": "burst into",
                                "target_lang_sense_clarification": "suddenly penetrate a mass of people"
                            },
                            {
                                "target_lang_word": "plunge into",
                                "target_lang_sense_clarification": "dive or push abruptly into a crowd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53374cd2-fa8f-3a83-aff1-cf4242cc005c",
                    "sense_definition": "Сильно и внезапно влюбиться в кого-либо.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "чувства",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Парень совершенно потерял голову и без ума <w>врезался</w> в новую однокурсницу.",
                            "target_lang_translations": {
                                "en": "The guy completely lost his head and <w>fell head over heels for</w> his new classmate."
                            }
                        },
                        {
                            "text": "Он признался лучшему другу, что по уши <w>врезался</w> с первого взгляда.",
                            "target_lang_translations": {
                                "en": "He confessed to his best friend that he <w>had fallen hard</w> at first sight."
                            }
                        }
                    ],
                    "synonyms": [
                        "втюриться",
                        "влюбиться"
                    ],
                    "common_phrases": [
                        "по уши врезаться",
                        "без памяти врезаться"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "просторечное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To fall madly or suddenly in love with someone (slang/informal)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fall head over heels for",
                                "target_lang_sense_clarification": "fall deeply in love"
                            },
                            {
                                "target_lang_word": "get a massive crush on",
                                "target_lang_sense_clarification": "become infatuated"
                            },
                            {
                                "target_lang_word": "fall hard for",
                                "target_lang_sense_clarification": "fall passionately in love with someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28d4459b-7df2-3360-bc8b-743758d89b65",
                    "sense_definition": "Страдательный залог к <w>врезать</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "грамматика",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Новый надёжный замок успешно <w>врезался</w> мастером в старую дубовую дверь.",
                            "target_lang_translations": {
                                "en": "A new, reliable lock <w>was being mortised</w> into the old oak door by the craftsman."
                            }
                        },
                        {
                            "text": "Потайной ящик аккуратно <w>врезался</w> в массивную деревянную панель шкафа.",
                            "target_lang_translations": {
                                "en": "A secret drawer <w>was being</w> neatly <w>inset</w> into the wardrobe's solid wooden panel."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "страдательный залог"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Passive form of врезать; to be mortised, fitted, or inset into something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be mortised into",
                                "target_lang_sense_clarification": "a lock or fitting cut into wood"
                            },
                            {
                                "target_lang_word": "be inset into",
                                "target_lang_sense_clarification": "recessed or fitted into a surface"
                            },
                            {
                                "target_lang_word": "be fitted into",
                                "target_lang_sense_clarification": "installed by cutting into material"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}