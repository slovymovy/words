                ],
                "senses": [
                    {
                        "sense_id": "27adc86c-f4ed-3d0b-bfba-b4cbabab3d10",
                        "entry_id": "20992a90-5939-3454-868b-4e5d91b26127",
                        "glosses": [
                            "связанный с высоким доходом; обеспечивающий высокий доход"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce423f17-ec82-480d-9e3e-d0edaccbe459",
                                "sense_id": "27adc86c-f4ed-3d0b-bfba-b4cbabab3d10",
                                "text": "А профессиональный разговор показывает, что даже в относительно высокодоходный год ― такой, как 2002-й, например ― доход нефтяной отрасли был 1, 8 млрд. долларов: это ее нетто ― прибыль."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2828f35e-63fe-4954-83a6-d687b24005db",
                        "source_entry_id": "20992a90-5939-3454-868b-4e5d91b26127",
                        "source_sense_id": "27adc86c-f4ed-3d0b-bfba-b4cbabab3d10",
                        "target_lang_word": "highly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "highly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "972ec5d3-7ebc-3a4b-9e78-0d5b7281cd3f",
                                        "entry_id": "2c2101c1-929d-3a7f-b513-4289ad20c1af",
                                        "glosses": [
                                            "In a high or esteemed manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a9566f3-6e08-4ca7-9d55-708ca1b50b43",
                                                "sense_id": "972ec5d3-7ebc-3a4b-9e78-0d5b7281cd3f",
                                                "text": "He spoke highly of you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                        "entry_id": "2c2101c1-929d-3a7f-b513-4289ad20c1af",
                                        "glosses": [
                                            "Extremely; greatly; very much."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ee1f4e-b78e-4dc7-a387-9cf4039fb45e",
                                                "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                                "text": "He is in a highly visible job."
                                            },
                                            {
                                                "example_id": "5a0826b4-0abc-4585-b96c-9019b2698eb6",
                                                "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                                "text": "The book was highly controversial yet sold unbelievably well."
                                            },
                                            {
                                                "example_id": "337e5178-3406-45b2-a5a6-96edd439480b",
                                                "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                                "text": "There are those who value a seat sufficiently highly that they prefer to make their daily journeys by the Western Region Vine Street line."
                                            },
                                            {
                                                "example_id": "723f4fdf-51cb-4e27-9b38-cb754c8af5e5",
                                                "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                                "text": "Plant breeding is always a numbers game.[…]The wild species we use are rich in genetic variation, and individual plants are highly heterozygous and do not breed true. In addition, we are looking for rare alleles, so the more plants we try, the better."
                                            },
                                            {
                                                "example_id": "10075024-0d30-4850-ba81-5d58a7b4bc01",
                                                "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                                "text": "The highly anticipated all-American matchup between Taylor Fritz and Frances Tiafoe — marking the first US Open semifinals between two US men in nearly 20 years — will cost you quite a few Honey Deuces to attend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1de90f0-cafa-4e74-8a4d-6ef0dbd0773d",
                        "source_entry_id": "20992a90-5939-3454-868b-4e5d91b26127",
                        "source_sense_id": "27adc86c-f4ed-3d0b-bfba-b4cbabab3d10",
                        "target_lang_word": "upper-income",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "182dae7f-4933-4d7d-8377-012234b9a128",
                        "source_entry_id": "20992a90-5939-3454-868b-4e5d91b26127",
                        "source_sense_id": "27adc86c-f4ed-3d0b-bfba-b4cbabab3d10",
                        "target_lang_word": "high-yielding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ba9fb5e9-244c-42d0-9f9f-b18a6518a898",
                        "source_entry_id": "20992a90-5939-3454-868b-4e5d91b26127",
                        "source_sense_id": "27adc86c-f4ed-3d0b-bfba-b4cbabab3d10",
                        "target_lang_word": "upscale",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "upscale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9393884d-7b30-333a-be2a-d22af04249e3",
                                        "entry_id": "825e6564-3c50-3901-95b4-a2da8ef602bf",
                                        "glosses": [
                                            "Expensive and designed to appeal to affluent consumers."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3738bfd7-b9e8-43fe-84c0-9b1011b84f32",
                                                "sense_id": "9393884d-7b30-333a-be2a-d22af04249e3",
                                                "text": "For example, a good location for resale, such as an upscale suburb of new homes, will cost more money than a piece of land in an established neighborhood of small, postwar houses."
                                            },
                                            {
                                                "example_id": "3aa9acc0-c93e-4f7e-b1d8-7418e615f695",
                                                "sense_id": "9393884d-7b30-333a-be2a-d22af04249e3",
                                                "text": "In Rio de Janeiro, thousands protested in a gritty area far from the city’s upscale seaside districts. In other cities, demonstrators blocked roads, barged into City Council meetings or interrupted sessions of local lawmakers, clapping loudly and sometimes taking over the microphone."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "upscale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e884aa21-ee0c-3b5e-8f87-78c5a00d7da4",
                                        "entry_id": "9df33329-e08c-3e8a-ac23-8b943fd4272d",
                                        "glosses": [
                                            "To increase in size, to scale up."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
