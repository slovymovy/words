                    {
                        "sense_id": "36aaaf58-6cc2-3199-970b-43315511236e",
                        "entry_id": "e7ebc9c8-d801-31d2-8841-b7e01c89568c",
                        "glosses": [
                            "a person whose gender identity is not strictly male or female; a person outside the gender binary"
                        ],
                        "tags": [
                            "neologism",
                            "neuter",
                            "rare",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "5b453112-c3b3-4401-84e7-a7da61c30830",
                                "sense_id": "36aaaf58-6cc2-3199-970b-43315511236e",
                                "text": "Das Enby verwirrte die heteronormativ denkenden Gäste sehr.",
                                "translation": "The enby confused the guests with a heteronormative mindset a lot.",
                                "english": "The enby confused the guests with a heteronormative mindset a lot."
                            },
                            {
                                "example_id": "def35717-7df9-4972-94e3-ee3470695928",
                                "sense_id": "36aaaf58-6cc2-3199-970b-43315511236e",
                                "text": "Zwei Dutzend Leute, die sich nun in der Fahrzeugbaracke befinden, setzen sich ebenfalls, Enbys, Frauen, Männer.",
                                "translation": "Two dozen people who are now in the vehicle shed also take a seat, enbies, women, men.",
                                "english": "Two dozen people who are now in the vehicle shed also take a seat, enbies, women, men."
                            },
                            {
                                "example_id": "3635e492-08bf-4bc6-bf77-b125f5f6da16",
                                "sense_id": "36aaaf58-6cc2-3199-970b-43315511236e",
                                "text": "2020, Dirk Carolus, in: Dauzone.com, Stein: Es ist wie es eben ist,\nKurz und gut – das gesamte Portfolio um nur ein Produkt an den Mann, die Frau, das Enby zu bringen.\nIn a nutshell – the whole portfolio just to sell a man, a woman, an enby one single product."
                            },
                            {
                                "example_id": "34f46088-ef85-4aff-b9df-e1aab20b3564",
                                "sense_id": "36aaaf58-6cc2-3199-970b-43315511236e",
                                "text": "Sie erklären, was Enbys, genderqueere, genderbender, inbetween, postgender oder diverse bedeutet.",
                                "translation": "They explain the meaning of enbies, genderqueer, genderbender, inbetween, postgender or diverse.",
                                "english": "They explain the meaning of enbies, genderqueer, genderbender, inbetween, postgender or diverse."
                            }
                        ]
                    }
