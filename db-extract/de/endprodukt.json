                        "cross_references": []
                    },
                    {
                        "translation_id": "711d7303-1116-4479-acf9-6e9a5f057e6d",
                        "source_entry_id": "d7347309-19df-3950-98e7-538c065e2ea4",
                        "source_sense_id": "abec4b7b-9efa-3466-a74f-e87523ee0132",
                        "source_sense_description": "letztes Erzeugnis einer Produktion, welches nicht weiterverarbeitet wird",
                        "target_lang_word": "finished product",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finished product",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af4df5b4-180e-33d0-8094-14077147a887",
                                        "entry_id": "ffc2dc31-2922-363d-ad86-849fea131e90",
                                        "glosses": [
                                            "The final version of a product."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de9a5c2a-8bbe-486e-b460-0ecb3bea81b4",
                                                "sense_id": "af4df5b4-180e-33d0-8094-14077147a887",
                                                "text": "At the time of writing, I have not seen the finished product, but I nevertheless think this is a win-win situation for Network Rail, operators, Fabrik and, of course, others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35287546-d97d-3098-b4f7-d3f210288a92",
                                        "entry_id": "ffc2dc31-2922-363d-ad86-849fea131e90",
                                        "glosses": [
                                            "Synonym of finished article."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6026fb4f-1de1-4444-9970-55fb8328c622",
                                                "sense_id": "35287546-d97d-3098-b4f7-d3f210288a92",
                                                "text": "This, it must be stressed, is not to mark Arsenal out as potential Premier League winners or acclaim them as the finished product - there have been false dawns before, under both current manager Mikel Arteta and his predecessor Unai Emery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
