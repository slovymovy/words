                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jongeren stonden in het park een jonko te <w>klappen</w>.",
                            "target_lang_translations": {
                                "en": "The youths were standing in the park <w>smoking</w> a joint.",
                                "ru": "Молодежь стояла в парке и <w>курила</w> косяк.",
                                "fr": "Les jeunes étaient dans le parc en train de <w>fumer</w> un joint."
