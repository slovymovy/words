                },
                {
                    "sense_id": "60afb307-fd0a-3aa5-aaab-2b8f3720c721",
                    "sense_definition": "To provide money to someone before it is due or before work is completed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "financial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank agreed to <w>advance</w> the company the necessary funds for the project.",
                            "target_lang_translations": {
                                "ru": "Банк согласился <w>авансировать</w> компании необходимые средства для проекта.",
                                "pl": "Bank zgodził się <w>wypłacić zaliczkę</w> firmie na niezbędne fundusze na projekt."
                            }
                        },
                        {
                            "text": "Can you <w>advance</w> me fifty dollars until I get paid next week?",
                            "target_lang_translations": {
                                "ru": "Можешь <w>дать</w> мне <w>авансом</w> пятьдесят долларов, пока я не получу зарплату на следующей неделе?",
                                "pl": "Czy możesz dać mi <w>zaliczkę</w> w wysokości pięćdziesięciu dolarów, zanim dostanę wypłatę w przyszłym tygodniu?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "advance money",
                        "advance a loan",
                        "advance funds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять деньги кому-либо до наступления срока платежа или до завершения работы.",
                        "pl": "Przekazywać komuś pieniądze przed terminem płatności lub przed zakończeniem pracy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "авансировать",
                                "target_lang_sense_clarification": "финансировать заранее"
                            },
                            {
                                "target_lang_word": "выдавать аванс",
                                "target_lang_sense_clarification": "платить вперёд"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wypłacać zaliczkę",
                                "target_lang_sense_clarification": "płacić z góry"
                            },
                            {
                                "target_lang_word": "zaliczkować",
                                "target_lang_sense_clarification": "udzielać zaliczki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc18505d-4c2e-3b1a-9508-7cd8b5e70850",
                    "sense_definition": "To cause an event to happen at an earlier date or time than originally planned.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "time_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to <w>advance</w> the deadline by two days.",
                            "target_lang_translations": {
                                "ru": "Комитет решил <w>перенести</w> крайний срок на два дня раньше.",
                                "pl": "Komitet postanowił <w>przyspieszyć</w> termin o dwa dni."
                            }
                        },
                        {
                            "text": "We had to <w>advance</w> the meeting time to accommodate the director.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>перенести</w> время встречи на более раннее, чтобы подстроиться под директора.",
                                "pl": "Musieliśmy <w>przesunąć na wcześniejszą godzinę</w> spotkanie, aby dostosować się do dyrektora."
                            }
                        }
                    ],
                    "synonyms": [
                        "accelerate"
                    ],
                    "common_phrases": [
                        "advance the date",
                        "advance the schedule"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять событие происходить раньше запланированной даты или времени.",
                        "pl": "Przesuwać wydarzenie na wcześniejszy termin niż pierwotnie planowano."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переносить",
                                "target_lang_sense_clarification": "на более ранний срок"
                            },
                            {
                                "target_lang_word": "приближать",
                                "target_lang_sense_clarification": "дату или событие"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przyspieszać",
                                "target_lang_sense_clarification": "przesuwać na wcześniejszy termin"
                            },
                            {
                                "target_lang_word": "przenosić na wcześniejszy termin",
                                "target_lang_sense_clarification": "zmieniać datę na wcześniejszą"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "234737e4-29e0-301d-a827-6d3c553dcac5",
                    "sense_definition": "To raise someone to a higher rank or position.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "promotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general was <w>advanced</w> to the highest rank in the army.",
                            "target_lang_translations": {
                                "ru": "Генерала <w>повысили</w> до высшего звания в армии.",
                                "pl": "Generał został <w>awansowany</w> na najwyższy stopień w armii."
                            }
