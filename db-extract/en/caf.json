                                "target_senses": [
                                    {
                                        "sense_id": "5c1ffed4-f018-311c-9c56-e9de906edf79",
                                        "entry_id": "93031226-9e63-3196-9de7-efe99e7b1fba",
                                        "glosses": [
                                            "Agence du revenu du Canada, qui perçoit les impôts."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d069a847-0bc6-47c4-85a1-f9e676de080d",
                                                "sense_id": "5c1ffed4-f018-311c-9c56-e9de906edf79",
                                                "text": "Mais coup de théâtre, le PCC a retiré mardi son appui au projet de loi bloquiste, prétextant des « inquiétudes » suscitées par la perte potentielle d’emplois aux bureaux de l’ARC au Saguenay et à Shawinigan."
                                            },
                                            {
                                                "example_id": "338e0ae4-ff8e-4f1c-adec-5d463212081d",
                                                "sense_id": "5c1ffed4-f018-311c-9c56-e9de906edf79",
                                                "text": "Ainsi, l’ARC avait envoyé aux utilisateurs concernés, le 16 février dernier, un message les informant de la suppression de l’adresse courriel figurant à leur compte. Les personnes seront contactées par l’ARC et une marche à suivre pour la récupération de leurs informations leur sera fournie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
