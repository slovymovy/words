                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e08b90de-d787-42a6-8d88-7a337946a1c4",
                                "sense_id": "34f60bb2-3706-3f34-94ff-4b4eaa1b79ea",
                                "text": "„Er überlegt, ob es sich vielleicht nur um einen normalen Menschen handelt, der ein Kostüm aus Zuckerglasur trägt.“"
                            },
                            {
                                "example_id": "d7fb9d8b-252b-4044-8cd2-1eef5f5c4c18",
                                "sense_id": "34f60bb2-3706-3f34-94ff-4b4eaa1b79ea",
                                "text": "„Aus einer anderen Flasche schüttle ich zwei Dutzend Inazan heraus und lege sie mir unter die Zunge, bis ihre schwarze Zuckerglasur sich auflöst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
