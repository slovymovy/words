                "senses": [
                    {
                        "sense_id": "7a80ffc7-523b-30aa-82e6-afdd9d1051fe",
                        "entry_id": "093447ea-077b-3849-99fb-6ccae7c79efb",
                        "glosses": [
                            "mimowolny wytrysk nasienia u mężczyzn podczas snu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f1245d0-5755-4b5f-98e2-3afa54697948",
                                "sense_id": "7a80ffc7-523b-30aa-82e6-afdd9d1051fe",
                                "text": "Jasio miał polucję gdy śniła mu się nauczycielka."
