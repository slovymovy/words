                        "prévisions budgétaires"
                    ]
                },
                {
                    "sense_id": "c8184434-ea5e-3160-99ea-609becae6291",
                    "sense_definition": "Vue subjective, pressentiment ou conjecture concernant ce qui va advenir.",
