                "senses": [
                    {
                        "sense_id": "757a4b8e-4859-395f-8879-2d3b890dd915",
                        "entry_id": "e4dcb0e0-3e2d-31ac-b777-f343faa550f3",
                        "glosses": [
                            "разг., ласк. к лук (овощ)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a3e94f4-19c1-4213-b5fb-f597483689fa",
                                "sense_id": "757a4b8e-4859-395f-8879-2d3b890dd915",
                                "text": "Я завсегда с лучком котлеты делаю…"
                            },
                            {
                                "example_id": "8e0e21cb-9b4e-42d2-9187-79c910d5066d",
                                "sense_id": "757a4b8e-4859-395f-8879-2d3b890dd915",
                                "text": "― Войдёшь в квартиру, где постное готовят, ― и такой елей по всему телу разольётся. Лучком жареным пахнет, маслицем ― хорошо!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
