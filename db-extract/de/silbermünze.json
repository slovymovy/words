                ],
                "senses": [
                    {
                        "sense_id": "53e6053a-0ac2-38f2-8a8c-0086026bb343",
                        "entry_id": "93b16d76-8711-3766-babc-d73fbfe4ed91",
                        "glosses": [
                            "Münze, die aus Silber oder einer Legierung mit Silberanteil besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a76b9705-04b9-46fe-b32f-d574c998338c",
                                "sense_id": "53e6053a-0ac2-38f2-8a8c-0086026bb343",
                                "text": "Heutzutage werden nur noch wenige Silbermünzen geprägt."
                            },
                            {
                                "example_id": "e9f806d0-ab48-4722-bdff-cf7f446b23c5",
                                "sense_id": "53e6053a-0ac2-38f2-8a8c-0086026bb343",
                                "text": "„Erste Kirchen entstehen, und in Silbermünzen wird nun häufig auf beiden Seiten ein Kreuz geprägt.“"
                            },
                            {
                                "example_id": "4a2213c2-6b25-45c1-a9d1-7193ae6c6fbe",
                                "sense_id": "53e6053a-0ac2-38f2-8a8c-0086026bb343",
                                "text": "„Der Beamte, zu dem wir kamen, begnügte sich vielmehr, für Reddinger, Paul und mich je einen Fahrschein nach Marseille auszustellen, und schob jedem von uns als Zehrgeld für unterwegs eine Silbermünze zu.“"
                            },
                            {
                                "example_id": "70550cd1-9fb3-4418-9bfb-5735720693c0",
                                "sense_id": "53e6053a-0ac2-38f2-8a8c-0086026bb343",
                                "text": "„Oder wie ist es, wenn eine Frau zehn Silbermünzen hat und eine davon verliert? Zündet sie da nicht eine Lampe an, kehrt das ganze Haus und sucht in allen Ecken, bis sie die Münze gefunden hat?“"
                            },
                            {
                                "example_id": "b860be57-18e3-454a-8265-cdb0d9fec976",
                                "sense_id": "53e6053a-0ac2-38f2-8a8c-0086026bb343",
                                "text": "„Sie nahm eine Silbermünze aus ihrem Beutel und gab sie ihm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
