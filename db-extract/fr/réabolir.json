                "senses": [
                    {
                        "sense_id": "407b14f4-eae5-3ebb-9d01-e8614c181d2a",
                        "entry_id": "d90bbba5-7fcf-3c68-8dae-7095e4a9255e",
                        "glosses": [
                            "Supprimer de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4a55f62-92d6-49da-8a65-32c2a9b93170",
                                "sense_id": "407b14f4-eae5-3ebb-9d01-e8614c181d2a",
                                "text": "Témoignant d'une compétence, et de la nécessité donc de la beauté d'une fonction, ce balai vient réabolir hiérarchies, privilèges, et rétablir quelque chose du sens commun dans les rues envahies de cuistres de marketing en complet mastic qui signent et téléphonent."
                            },
                            {
                                "example_id": "1f7af058-1e3f-43f2-ba6c-8c022d57ba9c",
                                "sense_id": "407b14f4-eae5-3ebb-9d01-e8614c181d2a",
                                "text": "On s'est cru obligé en conscience de réabolir la messe, en 1559 ; le même devoir subsiste aujourd'hui."
                            }
                        ]
                    }
