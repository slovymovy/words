                                        "entry_id": "a27d6028-98e0-35c2-bd9b-d14e7bdab9c8",
                                        "glosses": [
                                            "Archipel de l’océan Indien, situé au nord de Madagascar."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebb0fc70-17ee-4733-9e5e-f7e71ed9e4d7",
                                                "sense_id": "5f5c8246-b18f-3577-9fc9-15b7e13b9d33",
                                                "text": "Le crassispina est connu habiter, hors l’Inde archipélagique, la Mer rouge, les côtes de Zanzibar, des Seychelles, de Madras, de Chine et de la Nouvelle-Hollande septentrionale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4b774f2-afa9-3c3d-b01b-e5620dcf2ae3",
                                        "entry_id": "a27d6028-98e0-35c2-bd9b-d14e7bdab9c8",
                                        "glosses": [
                                            "Pays occupant ces îles et ayant pour capitale Victoria."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6abe0cb9-654a-4dba-a99f-034e20aae58a",
                                                "sense_id": "e4b774f2-afa9-3c3d-b01b-e5620dcf2ae3",
                                                "text": "Aux Seychelles […] trois langues sont « nationales » : le créole, l’anglais et le français."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
