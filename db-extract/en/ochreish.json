                            {
                                "example_id": "9d4d9f8e-abd8-4b5d-9490-110541949e75",
                                "sense_id": "bbd9fb48-508f-38f4-b4d2-b83a9c18c71b",
                                "text": "The back and side of the hospital, the long barracks of the annex and the wall at the bottom enclosed a waste place of ochreish clay."
                            },
                            {
                                "example_id": "a5e7fe47-afad-461a-b71c-df65c91a2908",
                                "sense_id": "bbd9fb48-508f-38f4-b4d2-b83a9c18c71b",
                                "text": "Through the enormous dust cloud that the army raised the trees of the valley appeared as brown smudges against an ochreish sky."
                            },
                            {
                                "example_id": "42c7136b-a377-465f-9c18-f11e048f86b8",
                                "sense_id": "bbd9fb48-508f-38f4-b4d2-b83a9c18c71b",
                                "text": "One field was bare, its surface of an ochreish colour deeper than that of clay, broken and smoothed as perfectly as the surface of the most carefully tended flower-bed."
                            }
                        ]
