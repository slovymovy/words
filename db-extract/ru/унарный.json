                            },
                            {
                                "example_id": "c41229fa-8f85-4707-bf16-1d9c8a458d28",
                                "sense_id": "f962c374-3782-3d88-a6d9-fcd563ccabca",
                                "text": "Унарный код"
                            }
                        ]
                    },
                    {
                        "sense_id": "1ac8d2bb-353f-34f6-a11a-e46cbeece911",
                        "entry_id": "f4b33b20-22fd-3e2a-b69f-5975d2ec34e4",
                        "glosses": [
                            "филос. единосвязный, единосущий с автомодельной (петлевой, обращенной на себя самого) рефлексивной связью; устроенный по типу монады."
                        ],
                        "tags": [],
