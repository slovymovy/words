                ],
                "senses": [
                    {
                        "sense_id": "58fc099a-c8b4-3d85-a875-7631392275bf",
                        "entry_id": "281f7f13-3f9d-38dc-9438-3ab9da58a497",
                        "glosses": [
                            "Seele einer sündigen Person, die nach deren Tod einen lebenden Menschen befällt, um vor den Verfolgungen böser Geister (Dämonen) ewige Ruhe zu finden, was dazu führt, dass sie mitunter selbst als böser Geist wahrgenommen wird und der betreffende Mensch als „besessen“ erscheint"
                        ],
                        "tags": [
                            "Kabbalistik",
                            "jüdische Mythologie",
                            "jüdischer Volksglauben"
                        ],
                        "examples": [
                            {
                                "example_id": "7e336c41-497b-45d8-be28-aa60d4d33bbe",
                                "sense_id": "58fc099a-c8b4-3d85-a875-7631392275bf",
                                "text": "„Unter einem Dibbuk (von hebräisch dabók = sich anheften) versteht man den Geist eines Toten, von dem ein Lebender besessen ist.“"
                            },
                            {
                                "example_id": "e2a1348c-4d65-4957-9b5f-844ff825463b",
                                "sense_id": "58fc099a-c8b4-3d85-a875-7631392275bf",
                                "text": "„Ich drang ein in eine Welt, bevölkert von kleinen Leuten, armen Rabbis, Heiligen, Chassidim, Dämonen, Dibbuks, Huren, von Philosophen auf der Suche nach der Wahrheit, Mystikern auf der Suche nach Gott, Künstlern auf der Suche nach Ruhm, gebrochenen Schauspielern auf der Suche nach einer unerreichbaren Bühne, von Frommen und Gottlosen, Sinnlichen und Asketen.“"
                            },
                            {
                                "example_id": "33404913-47a2-4095-a7cd-e9a444b42a59",
                                "sense_id": "58fc099a-c8b4-3d85-a875-7631392275bf",
                                "text": "„Der Dibbuk ist in der jüdischen Tradition die Seele eines Toten, die einen Lebenden lenkt.“"
                            },
                            {
                                "example_id": "9a8ccdfb-aa2f-410a-8c97-b9dd21e77338",
                                "sense_id": "58fc099a-c8b4-3d85-a875-7631392275bf",
                                "text": "„Immerhin redet er im titelgebenden Prosastück von seiner ‚Seelenpension‘, wo Dibbuks hausen, Geister anderer Leute.“"
                            },
                            {
                                "example_id": "b688d47e-0b3d-4b67-b29f-f1d0005525e8",
                                "sense_id": "58fc099a-c8b4-3d85-a875-7631392275bf",
                                "text": "„Es war, als hätte ein Dibbuk in ihm gesprochen.“"
                            },
                            {
                                "example_id": "be2bb387-60c8-4851-aad1-18a58b460f73",
                                "sense_id": "58fc099a-c8b4-3d85-a875-7631392275bf",
                                "text": "„Kein Wunder, dass Adriana Altaras schon meint, Dibbuks reden zu hören: die dämonischen Geister der Verstorbenen!“"
                            },
                            {
                                "example_id": "7cb80bfb-dd8d-444d-8ebe-5fba3470febf",
                                "sense_id": "58fc099a-c8b4-3d85-a875-7631392275bf",
                                "text": "„Ich bin immer an derselben Stelle, du bist es, die sich plötzlich verändert hat, mit deiner neuen Spinnerei, schau dich doch an, eine schöne, kluge Frau mit einer gelungenen Familie, die plötzlich noch ein Kind aufziehen will, ausgerechnet in einem Alter, in dem man sich von den Kindern befreit, manchmal denke ich, es braucht einen Geisteraustreiber, um dich von diesem Dibbuk zu befreien.“"
                            },
                            {
                                "example_id": "89b8b970-a5d1-4745-9c4b-e8c6cad75c1c",
                                "sense_id": "58fc099a-c8b4-3d85-a875-7631392275bf",
                                "text": "„Von den Dibbuks, den Geistern der Toten, die den Lebenden keine Ruhe lassen, erzählte die Schauspielerin schon 1991 in dem Theaterstück ‚Jonteff‘ im Theater zum Westlichen Stadthirschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
