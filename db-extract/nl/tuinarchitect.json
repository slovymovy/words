                "senses": [
                    {
                        "sense_id": "cf1715dc-bc9a-318f-b571-83ac0a1f8ff4",
                        "entry_id": "a70c8a64-0625-393f-bbcf-5e2607cc37c6",
                        "glosses": [
                            "iemand die een tuin of park ontwerpt, het is een wettelijk beschermde titel"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "7e1d79d1-24ca-4258-aaa2-da7df5012f2d",
                                "sense_id": "cf1715dc-bc9a-318f-b571-83ac0a1f8ff4",
                                "text": "Verkenning van de kunstwijk Chelsea , bezoek aan de High Line, een oude vrachtspoorbaan die de Nederlandse tuinarchitect Piet Oudolf omtoverde tot een (beelden) park."
                            },
                            {
                                "example_id": "0eee8cd3-d8d4-4e49-a0ef-05164dc8a20b",
                                "sense_id": "cf1715dc-bc9a-318f-b571-83ac0a1f8ff4",
                                "text": "Ben je niet zo handig maar wil je wel graag meubels op maat in je tuin? Een hovenier of tuinarchitect kan je helpen bij de inrichting van je tuin of je advies geven over het creëren van extra opbergruimte."
                            },
                            {
                                "example_id": "3986fcea-f767-45b0-96a5-6765c96b0870",
                                "sense_id": "cf1715dc-bc9a-318f-b571-83ac0a1f8ff4",
                                "text": "Mous beschouwt tijdgenoot Mien Ruys (1904-1999), de bekende Nederlandse tuinarchitect en tijdgenoot van Le Roy, als zijn tegenpool. Want hij was juist géén tuinarchitect. „Hij wilde afzien van elke vorm van ontwerp. Hij werd daarom wel vergeleken met Antonio Gaudí, de bouwer van de Sagrada Família in Barcelona, de kathedraal waaraan nog altijd op een organische manier wordt gebouwd. Ook hij maakte van zijn tuinen een bouwwerk, waar mensen eeuwenlang aan werken, net als aan kathedralen.”"
                            }
                        ]
                    }
                ],
