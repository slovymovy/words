                ],
                "senses": [
                    {
                        "sense_id": "c1e52e64-f9d1-31f8-b54b-f7f8a9f47636",
                        "entry_id": "9c97b40d-bcd2-3d40-b454-5bbbe67a0b19",
                        "glosses": [
                            "ein Kunstwerk, in dem verschiedene Künste zu einem Werk vereint sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78dcc6dd-d049-431a-bdb0-4710ff63a3c9",
                                "sense_id": "c1e52e64-f9d1-31f8-b54b-f7f8a9f47636",
                                "text": "Die höchste Form der Kunst ist das Gesamtkunstwerk, in dem die Grenzen zwischen Kunst und Nichtkunst aufgehoben sind."
                            },
                            {
                                "example_id": "b2ec7b28-4b5d-48dc-b343-eb5e77047780",
                                "sense_id": "c1e52e64-f9d1-31f8-b54b-f7f8a9f47636",
                                "text": "„Also fange ich gar nicht erst an, sondern ermahne mich, Robert als Gesamtkunstwerk zu begreifen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9d09d91-df87-4a1c-ac2f-c607c9a30095",
                        "source_entry_id": "9c97b40d-bcd2-3d40-b454-5bbbe67a0b19",
                        "source_sense_id": "c1e52e64-f9d1-31f8-b54b-f7f8a9f47636",
                        "source_sense_description": "ein Kunstwerk, in dem verschiedene Künste zu einem Werk vereint sind",
                        "target_lang_word": "Gesamtkunstwerk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesamtkunstwerk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3035ea06-a51c-360d-94d4-128e152b90ff",
                                        "entry_id": "787e61f1-bd79-3524-a522-b4f7e20175a1",
                                        "glosses": [
                                            "Total artwork; an artistic creation such as an operatic performance that encompasses music, theatre and the visual arts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e339379-458a-4c25-8148-1c09692b7610",
                                                "sense_id": "3035ea06-a51c-360d-94d4-128e152b90ff",
                                                "text": "Andre Emmerich, Mr. Hockney's longtime New York dealer, said: \"There's a nice German word, gesamtkunstwerk. It means the entirety is a work of art.\""
                                            },
                                            {
                                                "example_id": "53d48984-1235-4821-ae3d-5c4e9873f1ef",
                                                "sense_id": "3035ea06-a51c-360d-94d4-128e152b90ff",
                                                "text": "References to the Gesamtkunstwerk, or total work of art, abound in modernist discourse in the disciplines of art and architectural history ..."
                                            },
                                            {
                                                "example_id": "279698b5-ec03-4ac4-be4a-1e53cc015969",
                                                "sense_id": "3035ea06-a51c-360d-94d4-128e152b90ff",
                                                "text": "The original PokéRap is no Gesamtkunstwerk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37bd19c4-d474-4a86-b902-147140ad0cd8",
