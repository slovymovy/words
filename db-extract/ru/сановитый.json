                "senses": [
                    {
                        "sense_id": "cc85833d-c7a0-3ef4-9e7a-a742b26e66bb",
                        "entry_id": "c2e8e079-1393-37bd-9465-53338b862bd4",
                        "glosses": [
                            "dignified, dignitary"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f33f73d-977c-46d7-bc7b-d341bacc1564",
                                "sense_id": "cc85833d-c7a0-3ef4-9e7a-a742b26e66bb",
                                "text": "Николай Васильевич Пахотин был очень красивый сановитый старик, с мягкими, почтенными сединами.",
                                "translation": "Nikolai Vasilyevich Pakhotin was a handsome and dignified elderly gentleman, with the kind of greying temples which lend that touch of distinction.",
                                "english": "Nikolai Vasilyevich Pakhotin was a handsome and dignified elderly gentleman, with the kind of greying temples which lend that touch of distinction."
                            },
                            {
                                "example_id": "ea8afc15-a8ae-4b33-bf15-0717b8497982",
                                "sense_id": "cc85833d-c7a0-3ef4-9e7a-a742b26e66bb",
                                "text": "Без сомнения, это был человек добрейший, очень сановитый и до того уже старый, что от него можно было вынести даже и сожаление.",
                                "translation": "He was undoubtedly a most kind man, a great dignitary, and so very old that one could even tolerate his pity.",
                                "english": "He was undoubtedly a most kind man, a great dignitary, and so very old that one could even tolerate his pity."
                            }
                        ]
                    }
                ],
