                    },
                    {
                        "translation_id": "354e1a2d-e14c-498f-9988-ffcb5f39dd8a",
                        "source_entry_id": "1edb0650-d3fc-3a99-8da7-4ed3f8937829",
                        "source_sense_id": "bb53119b-2cf5-3299-b7a6-dd5c19cf8e11",
