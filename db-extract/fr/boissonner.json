                ],
                "senses": [
                    {
                        "sense_id": "344f6474-8f72-3c22-b83e-8eb94a0479bc",
                        "entry_id": "39d0ec5f-8196-3822-8179-79fabcad5d02",
                        "glosses": [
                            "Boire trop d’alcool, se livrer à la boisson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6a3d9af-b94f-4ab1-b55c-da6b093262d0",
                                "sense_id": "344f6474-8f72-3c22-b83e-8eb94a0479bc",
                                "text": "Je t’ai amenée ici, tu piffres, tu boissonnes, tu fumes, c’est tout dans la vie, ça !"
                            },
                            {
                                "example_id": "46bdd1bd-a56b-4b93-be2d-4d447caed92d",
                                "sense_id": "344f6474-8f72-3c22-b83e-8eb94a0479bc",
                                "text": "Les ouvriers flânochent ou flânotent, on mange dans des gargotailles, on y boissonne."
                            },
                            {
                                "example_id": "00623e04-cdba-44a7-b7dd-d458458411c5",
                                "sense_id": "344f6474-8f72-3c22-b83e-8eb94a0479bc",
                                "text": "Il a fait un petit discours et il est tout de suite allé boissonner avec d'autres pochards au café, entouré de trois cents personnes."
                            }
                        ]
                    }
