                "senses": [
                    {
                        "sense_id": "40217e82-2df7-36f2-aec4-cb9f8f7c8c67",
                        "entry_id": "e7474d35-1408-3ac0-934b-7c18b96b2ca4",
                        "glosses": [
                            "To remove pollutants from; to purify."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5de12f5a-f213-4477-9bbe-67d6e35ccd3a",
                                "sense_id": "40217e82-2df7-36f2-aec4-cb9f8f7c8c67",
                                "text": "Suppose the President were to say (copying some language used once before) that, before the end of this decade, we shall unpollute the Great Lakes."
                            },
                            {
                                "example_id": "fac1f9fb-7f8e-4caf-bbb0-08ba4acc77a8",
                                "sense_id": "40217e82-2df7-36f2-aec4-cb9f8f7c8c67",
                                "text": "And it is now time for the industry to fully realize that it cannot escape its responsibility to unpollute the American drinking environment, just as other industries have found that they cannot escape their responsibility to unpollute the natural environment."
                            },
                            {
                                "example_id": "621f9833-dd59-45ce-bbc5-e74bf7a3a995",
                                "sense_id": "40217e82-2df7-36f2-aec4-cb9f8f7c8c67",
                                "text": "If he wants to unpollute something, let him unpollute the movies. All them nudies."
                            },
                            {
                                "example_id": "0fe22052-db61-4d5f-9434-7527998816f7",
                                "sense_id": "40217e82-2df7-36f2-aec4-cb9f8f7c8c67",
                                "text": "How can we throw off the mantle of ethical invisibility and, at the same time, unpollute the atmosphere and the environment, and, as one black poet wrote, \"clean out the world for virtue and love\"?"
                            },
                            {
                                "example_id": "0c30c1f4-3521-497a-87fa-d6f345d97a62",
                                "sense_id": "40217e82-2df7-36f2-aec4-cb9f8f7c8c67",
                                "text": "Let your departure unpollute our city."
                            }
                        ]
                    }
