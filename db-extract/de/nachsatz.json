                    {
                        "sense_id": "a57ef7bf-afe8-394b-9e09-3b41c80b4792",
                        "entry_id": "c6cb15db-c912-3c7a-92e5-6052f8025460",
                        "glosses": [
                            "nachgestellter Satz oder Teilsatz"
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "55770e6a-06de-4dac-ac67-b8faf7a71052",
                                "sense_id": "a57ef7bf-afe8-394b-9e09-3b41c80b4792",
                                "text": "Fleischer und andere klassifizieren Nebensätze in die drei Kategorien Vordersatz, Nachsatz und Zwischensatz."
                            },
                            {
                                "example_id": "10c8566c-6ac1-476f-9981-7d231b1d9646",
                                "sense_id": "a57ef7bf-afe8-394b-9e09-3b41c80b4792",
                                "text": "„Die mit wenn verbundene Aussage stellt den Vordersatz dar, die mit dann verbundene den Nachsatz.“"
                            },
                            {
                                "example_id": "1de1ac05-b30f-428b-adf0-92b74813c39c",
                                "sense_id": "a57ef7bf-afe8-394b-9e09-3b41c80b4792",
                                "text": "„Die Kausalsätze sind Vorder- oder Nachsätze.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
