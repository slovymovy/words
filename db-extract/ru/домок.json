                        ],
                        "examples": [
                            {
                                "example_id": "0aeabfd6-5470-4181-9249-764c7ee94079",
                                "sense_id": "004bd1e8-3fcb-3aca-b38b-43e4bd8a6baf",
                                "text": "Васили́са Его́ровна и на дела́ слу́жбы смотре́ла, как на свои́ хозя́йские, и управля́ла кре́постию так то́чно, как и свои́м домко́м.",
                                "translation": "Vassilissa Yegorovna assumed the direction of all matters connected with the service, as she did those of her household, and governed the fortress as she governed her own house.",
                                "english": "Vassilissa Yegorovna assumed the direction of all matters connected with the service, as she did those of her household, and governed the fortress as she governed her own house."
                            }
                        ]
