                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f048265a-e7e2-4eac-a3a0-7bc71bbb2798",
                                "sense_id": "fdadcded-32c8-3a01-89b6-6c0f121b5584",
                                "text": "Ceci viendrait gestualiser le processus psychique de séparation comme un bercement rituel (Stork, 1988)."
                            },
                            {
                                "example_id": "f67f8cf8-dd5e-48dd-a41e-86623249d473",
                                "sense_id": "fdadcded-32c8-3a01-89b6-6c0f121b5584",
                                "text": "Pour maîtriser cette pulsation et « gestualiser » ces puissantes déferlantes sonores, tout chef d'orchestre est obligé de reconsidérer la battue traditionnelle fondée, on le sait, sur une pulsation égale et sa démultiplication régulière."
                            }
                        ]
                    }
