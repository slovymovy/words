                                                "sense_id": "08de46c3-2689-3d45-a363-fbc155b406de",
                                                "text": "Flake after flake ran out of the tubs, until we were compelled to hand the end of our line to the second mate to splice his own on to."
                                            }
                                        ]
                                    }
                                ]
                            }
