                        "glosses": [
                            "Réduction chirurgicale du volume gastrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fc37af3-f030-4911-aab0-5e9cd44600c5",
                                "sense_id": "c2d40c89-f5d7-357c-ac29-b1e692757217",
                                "text": "La gastroplastie (ou anneau gastrique) consiste à mettre un anneau en silicone, dont le calibre est modifiable facilement, autour de la partie supérieure de l’estomac."
                            },
                            {
                                "example_id": "ba10a796-002b-49c3-8100-0a4fc565f7ee",
                                "sense_id": "c2d40c89-f5d7-357c-ac29-b1e692757217",
                                "text": "La gastroplastie repose sur une idée simple : on n’enlève rien et la muqueuse gastrique poursuit ses sécrétions en définitive fort utiles à la digestion et à la santé."
                            }
                        ]
                    }
