                        "glosses": [
                            "The act or practice of duping; the condition of being deceived."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c9c43196-dab5-4b8e-a99f-ab3ecca8d0af",
                                "sense_id": "6e9539b8-fc53-3cdd-aa47-731fc969722b",
                                "text": "Quackery and dupery do abound; in religions, above all in the more advanced decaying stages of religions."
                            },
                            {
                                "example_id": "d9f0fa8d-de52-427a-8b9c-71f4c1619bba",
                                "sense_id": "6e9539b8-fc53-3cdd-aa47-731fc969722b",
                                "text": "Far more widespread than ticket dupery is another form of \"misrepresentation\" also recently under fire."
                            },
                            {
                                "example_id": "39d0d23b-a2f3-4c65-ade9-4a0d627bf2c2",
                                "sense_id": "6e9539b8-fc53-3cdd-aa47-731fc969722b",
                                "text": "Mr. Abel, who lives in Westport, Conn., has earned his bread as a writer and lecturer on problem-solving tactics, and he has earned a reputation as a duke of dupery since 1959, when he masterminded the Society for Indecency to Naked Animals."
                            }
                        ]
                    }
