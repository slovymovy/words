                ],
                "senses": [
                    {
                        "sense_id": "9f229eae-ea6d-3a3e-8ac8-64e28cb8f46b",
                        "entry_id": "d3ae5f93-0837-394d-a6ac-e2137a8db080",
                        "glosses": [
                            "während der mexikanischen Revolution entstandene Kunstbewegung, die unmittelbar mit der Gründung der Künstlergruppe „Los Estridentistas“ verbunden steht; feststehender Begriff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3f83b72-ebe1-4bbd-9f86-4e220ef19ced",
                                "sense_id": "9f229eae-ea6d-3a3e-8ac8-64e28cb8f46b",
                                "text": "„Zu Beginn eine Imitation des Futurismus, mit Einflüssen des Dadaismus, entwickelt sich der Estridentismus durch den ideologischen Einfluß der mexikanischen Revolution hin zu einer Symbiose zwischen Phantasie und sozialer Theorie,…“"
                            },
                            {
                                "example_id": "59fb4282-0039-4129-b830-1dbb230e9bb2",
                                "sense_id": "9f229eae-ea6d-3a3e-8ac8-64e28cb8f46b",
                                "text": "„Die Autoren des literarischen Estridentismus wurden ua von der sich entwickelnden Wandmalerei (Rivera, Orozco, Siqueiros) sowie den kubistischen Bildern eines Alva de la Canal angeregt.“"
                            },
                            {
                                "example_id": "7c3d2a86-9599-4ed3-a2ab-36e18f3e5727",
                                "sense_id": "9f229eae-ea6d-3a3e-8ac8-64e28cb8f46b",
                                "text": "„Sie hätten sich nach dem Scheitern von Futurismus, Estridentismus und anderen Schulen um Innovationen durch andere Quellen bemüht und seien auf Góngora, die Präraffaeliten und den französischen Symbolismus verfallen; daraus bastelten sie ein Kauderwelsch aus Wörterwirrwarr, das weder originell sei noch von Dauer sein könne.“"
                            },
                            {
                                "example_id": "3be28b69-3e42-41d9-b04f-0908994f4001",
                                "sense_id": "9f229eae-ea6d-3a3e-8ac8-64e28cb8f46b",
                                "text": "„Überall in Lateinamerika bilden sich Avantgarde-Bewegungen (Vanguardias): der Ultraismus in Argentinien, der Creacionismus in Chile, der Modernismus in Brasilien, der Estridentismus in Mexico, der Afrocubanismus in Kuba.“"
                            },
                            {
                                "example_id": "a4f6b446-ecaa-46fc-b742-3b8bf0c2e9b4",
                                "sense_id": "9f229eae-ea6d-3a3e-8ac8-64e28cb8f46b",
                                "text": "„Verschiedene Einflüsse werden sichtbar, der mexikanische Estridentismus, eine interdisziplinär arbeitende mexikanische Künstlerbewegung, die nach Expression suchte, Neue Sachlichkeit, Realismus und Elemente aus dem Surrealismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
