                                "example_id": "79bc983a-ef2b-4e04-baf9-bad5710e7d1d",
                                "sense_id": "bd0bbfb7-7dde-36a7-ac36-1f07ad8bd1bd",
                                "text": "The uncommonness of the gem is what gives it its value."
                            },
                            {
                                "example_id": "6652184d-a277-4773-a11e-cd3da7c95c45",
                                "sense_id": "bd0bbfb7-7dde-36a7-ac36-1f07ad8bd1bd",
                                "text": "It is only when people refuse to admit the uncommonness of some persons and the circumstances surrounding them, that erroneous conceits are nourished, and their feelings pained."
                            }
                        ]
