                "senses": [
                    {
                        "sense_id": "b18b317c-8912-32ea-a31b-cb75727d1e3c",
                        "entry_id": "ddd65af8-d5bf-3909-9562-c620523b163a",
                        "glosses": [
                            "In der Regel Verbrennungsmotor, aber auch von anderer Antriebsart, zum Beispiel Elektromotor oder Hybrid-/Erdgasantrieb der einen Kraftwagen, ein Auto, antreibt. Selten auch für Schienenfahrzeuge"
                        ],
                        "tags": [
                            "Fahrzeugwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "3761ed68-6530-4d1f-a5e1-78537be2fde6",
                                "sense_id": "b18b317c-8912-32ea-a31b-cb75727d1e3c",
                                "text": "„Zu den Anforderungen an Fahrzeugmotoren gehören neben niedriger Leistungsmasse und geringem Raumbedarf hohe Hubraumleistung […] sowie niedriger Kraftstoffverbrauch, einfache Bedienung und hohe Zuverlässigkeit.“"
                            },
                            {
                                "example_id": "7424961d-72c1-48fb-a65b-532251ed625f",
                                "sense_id": "b18b317c-8912-32ea-a31b-cb75727d1e3c",
                                "text": "„Gleichzeitig mit den Fahrzeugmotoren (FM) gab es von Anfang an auch fast baugleiche \"Aggregatmotoren\" (AM) – auch \"Motoren für allgemeine Verwendung\" genannt […]. Sie dienten als stationärer bzw. mobiler Antrieb von Generatoren, Schiffen, Lokomotiven, Triebwagen und anderem.“"
                            },
                            {
                                "example_id": "e03e9b69-59cc-465c-b489-4593de6a5eb7",
                                "sense_id": "b18b317c-8912-32ea-a31b-cb75727d1e3c",
                                "text": "„Wer Fahrzeugmotoren unnötig laufen lässt, verstößt gegen § 30 Abs.1 der Straßenverkehrsordnung (StVO) und handelt ordnungswidrig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
