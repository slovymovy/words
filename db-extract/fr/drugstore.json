                "senses": [
                    {
                        "sense_id": "10e6e053-1579-339f-b658-54e232a98825",
                        "entry_id": "9c8705f5-8efc-30a6-8486-4822df1ecdf2",
                        "glosses": [
                            "Commerce de détail ouvert sur une large plage horaire et proposant un éventail de produit allant de l’alimentation à la pharmacie en passant par le débit de tabac et le kiosque de presse."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "af2a33ed-1e24-4777-8611-bb6cdd11bddb",
                                "sense_id": "10e6e053-1579-339f-b658-54e232a98825",
                                "text": "Allez faire un tour du côté du drugstore. Vous les trouverez toutes là."
                            },
                            {
                                "example_id": "307a95d4-db89-41b5-9c4b-6c4e00fc7a96",
                                "sense_id": "10e6e053-1579-339f-b658-54e232a98825",
                                "text": "Ce que l’on mangeait dans les drugstores, plus ou moins élégants, se ressemblait, tout comme le milk-of-magnesia ou l’aspirine, vendus par le pharmacien de l’autre comptoir, sont les mêmes dans toutes les pharmacies."
                            },
                            {
                                "example_id": "fa50aa42-0165-44aa-bf88-c0057901196c",
                                "sense_id": "10e6e053-1579-339f-b658-54e232a98825",
                                "text": "Par contre, il peut amener sa famille en ville pour visiter un zoo, faire des courses dans un magasin, un supermarché, un drugstore, où il se ravitaille dès lors comme tout client du monde."
                            }
                        ]
                    }
