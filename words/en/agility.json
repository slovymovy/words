    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f34e3a4-7a1f-3f7c-9c15-ee3be700d33b",
                    "sense_definition": "The ability to move quickly and easily.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_agility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His superior <w>agility</w> countered his lack of physical strength on the court.",
                            "target_lang_translations": {
                                "ru": "Его превосходная <w>ловкость</w> компенсировала недостаток физической силы на площадке."
                            }
                        },
                        {
                            "text": "Gymnasts require a remarkable level of flexibility, balance, and physical <w>agility</w>.",
                            "target_lang_translations": {
                                "ru": "Гимнастам необходим поразительный уровень гибкости, чувства равновесия и физической <w>ловкости</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "nimbleness"
                    ],
                    "antonyms": [
                        "clumsiness"
                    ],
                    "common_phrases": [
                        "physical agility",
                        "speed and agility"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность двигаться быстро, легко и координированно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловкость",
                                "target_lang_sense_clarification": "физическая сноровка и точность движений"
                            },
                            {
                                "target_lang_word": "подвижность",
                                "target_lang_sense_clarification": "быстрота и легкость движений"
                            },
                            {
                                "target_lang_word": "проворство",
                                "target_lang_sense_clarification": "быстрота и сноровистость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92f063a9-ef90-3808-99d2-09d43144f6cf",
                    "sense_definition": "The ability to think, understand, and adapt rapidly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_agility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The job requires mental <w>agility</w> to solve complex problems under pressure.",
                            "target_lang_translations": {
                                "ru": "Эта работа требует <w>гибкости</w> ума для решения сложных задач в условиях стресса."
                            }
                        },
                        {
                            "text": "Modern companies need business <w>agility</w> to respond quickly to market changes.",
                            "target_lang_translations": {
                                "ru": "Современным компаниям необходима <w>гибкость</w> бизнеса, чтобы быстро реагировать на изменения рынка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mental agility",
                        "business agility"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность быстро соображать, понимать и адаптироваться к меняющимся условиям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гибкость",
                                "target_lang_sense_clarification": "способность быстро перестраиваться и адаптироваться"
                            },
                            {
                                "target_lang_word": "быстрота",
                                "target_lang_sense_clarification": "скорость мышления и реакции"
                            },
                            {
                                "target_lang_word": "живость",
                                "target_lang_sense_clarification": "острота и подвижность ума"
                            }
                        ]
                    }
                }
            ]
        }
    ]
