                "senses": [
                    {
                        "sense_id": "3c25c304-9140-380d-89ed-db14f7366179",
                        "entry_id": "ffa33841-5944-3c6c-824d-e2fe3e329d90",
                        "glosses": [
                            "elektrisch wagentje waarmee de spelers van het golfspel zich kunnen laten vervoeren over de golfbaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "028b065a-52f6-48e4-9553-b17db2cf33d3",
                                "sense_id": "3c25c304-9140-380d-89ed-db14f7366179",
                                "text": "De Antwerpse fotograaf Marc Lagrange (58) is op Eerste Kerstdag met een golfkar verongelukt tijdens een vakantie op Tenerife. Lagrange stond vooral bekend om zijn glamourvolle naaktfoto’s. Zijn grote doorbraak kwam in 2006 met zijn tentoonstelling Chateau Lagrange in het Antwerpse Fotomuseum. Zijn boek Diamonds and Pearls (2013) werd gepubliceerd in meer dan 80 landen. Recent waren zijn foto’s nog door zijn Amsterdamse galerie getoond tijdens Art Miami en de Tefaf in Maastricht."
                            }
                        ]
                    },
                    {
                        "sense_id": "fde96c8b-4654-308e-8cb0-ba4b1aee8ab2",
                        "entry_id": "ffa33841-5944-3c6c-824d-e2fe3e329d90",
                        "glosses": [
                            "klein elektrisch wagentje voor personenvervoer op andere plaatsen dan de golfbaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b72bb7a-66ec-48ed-b0d1-af9264d34b4e",
                                "sense_id": "fde96c8b-4654-308e-8cb0-ba4b1aee8ab2",
                                "text": "Als je nu de camping nadert, dan denk je eerst dat daar de laatste rustplaats is van alle SRV-wagens die uit Nederland zijn verdwenen. Knipper met je ogen en je ziet dat het stacaravans zijn. Bij de receptie tikt een cheerleader je gegevens in en dan zoeft ze je in een golfkar naar het ‘chalet’ - een mens kan in zijn leven genoeg tent van binnen hebben gezien."
                            }
                        ]
                    }
