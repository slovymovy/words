                ],
                "senses": [
                    {
                        "sense_id": "52774bbf-4fb4-3ac0-b979-bc5a121fbe84",
                        "entry_id": "f6ab23a5-6fb6-369b-8651-3674422d2fe8",
                        "glosses": [
                            "Qui draine, permet l’écoulement de l’eau ou d’un autre liquide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "135e6443-ec79-4f5d-8395-95cff33cc245",
                                "sense_id": "52774bbf-4fb4-3ac0-b979-bc5a121fbe84",
                                "text": "Dans plusieurs appareils l’eau filtrée est collectée à la base du sable par une espèce de réseau de tuyaux drainants."
                            },
                            {
                                "example_id": "bd5e5322-4f59-4ba5-ac71-610cc23cf7e9",
                                "sense_id": "52774bbf-4fb4-3ac0-b979-bc5a121fbe84",
                                "text": "Les sols sablo-argileux drainants semblent les plus conseillés pour une alimentation minérale et hydrique régulière."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbe762d4-bdf9-398d-948d-011eebdfd2d0",
                        "entry_id": "f6ab23a5-6fb6-369b-8651-3674422d2fe8",
                        "glosses": [
                            "Diurétique, qui agit contre la rétention d’eau et favorise l’élimination des toxines du corps."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "d60992fb-2dd7-48e5-83fd-daf14dc319ff",
                                "sense_id": "fbe762d4-bdf9-398d-948d-011eebdfd2d0",
                                "text": "Les boissons drainantes que l’on trouve dans le commerce contiennent souvent, en plus des plantes diurétiques, des produits satiétants (qui réduisent l’appétit) et des plantes destinées à améliorer la circulation (vigne rouge, mélilot) pour oxygéner les tissus, faciliter les échanges et contribuer à l’élimination."
                            },
                            {
                                "example_id": "de8ae075-1438-4fab-9824-4e8f817cf5cc",
                                "sense_id": "fbe762d4-bdf9-398d-948d-011eebdfd2d0",
                                "text": "Les tisanes et pilules miracles, les briquettes à boire, les boissons drainantes et autres crèmes minceur tirent leur profit de notre faculté à être éternellement insatisfaits de notre corps."
                            }
                        ]
                    }
                ],
