                    {
                        "sense_id": "97b02403-27b3-3cf7-9ed8-1aca803a403d",
                        "entry_id": "9e90b75a-da13-3074-8c2d-9d7840a00196",
                        "glosses": [
                            "Not fastened with a bolt."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "cc646c72-a2ee-4338-a1b0-6545d138586a",
                                "sense_id": "97b02403-27b3-3cf7-9ed8-1aca803a403d",
                                "text": "[…] it seems not more reasonable to leave the right of printing unrestrained, because writers may afterwards be censured, than it would be to sleep with doors unbolted, because by our laws we can hang a thief."
                            }
                        ]
                    },
                    {
                        "sense_id": "12140bb9-fac5-3e0b-84ff-6019260a1fe8",
                        "entry_id": "9e90b75a-da13-3074-8c2d-9d7840a00196",
                        "glosses": [
                            "Not sifted."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "af4a0829-39af-4dc5-9868-ca88ba110c55",
                                "sense_id": "12140bb9-fac5-3e0b-84ff-6019260a1fe8",
                                "text": "unbolted flour"
                            },
                            {
                                "example_id": "b1bbfffe-1c8f-4853-8d69-b3db4ad8ef05",
                                "sense_id": "12140bb9-fac5-3e0b-84ff-6019260a1fe8",
                                "text": "[The slave] toils that another may reap the fruit; he is industrious that another may live in idleness; he eats unbolted meal that another may eat the bread of fine flour; he labors in chains at home, under a burning sun and biting lash, that another may ride in ease and splendor abroad […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "9e47edb6-ff46-3ea9-9cea-68cd125aa674",
                        "entry_id": "9e90b75a-da13-3074-8c2d-9d7840a00196",
                        "glosses": [
                            "Coarse, uncultured, vulgar."
                        ],
                        "tags": [
                            "figuratively",
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b3ed0643-bcb5-4f1d-9d69-1301ba27e4cf",
                                "sense_id": "9e47edb6-ff46-3ea9-9cea-68cd125aa674",
                                "text": "My lord, if you’ll give me leave, I will tread this unbolted villain into mortar and daub the walls of a jakes with him."
                            }
                        ]
                    }
