                "senses": [
                    {
                        "sense_id": "53575e17-5438-3c92-a2e7-56c5493e3e83",
                        "entry_id": "f47eb271-af61-3025-b425-636576e1eb0e",
                        "glosses": [
                            "Doctrine prônant une mondialisation autre que celle proposée par l’ultralibéralisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c441b976-6bed-4054-b802-152b1efbc972",
                                "sense_id": "53575e17-5438-3c92-a2e7-56c5493e3e83",
                                "text": "Les partisans de l’altermondialisme sont d’avis que l’ultralibéralisme, voire pour certains le libéralisme tout court, est responsable de la plupart des problèmes de la mondialisation."
                            },
                            {
                                "example_id": "14b209a5-9b3e-40cc-ac29-6c7edd08df97",
                                "sense_id": "53575e17-5438-3c92-a2e7-56c5493e3e83",
                                "text": "L’idée-force de l’altermondialisme est qu’un autre monde est possible."
                            }
                        ]
                    }
                ],
