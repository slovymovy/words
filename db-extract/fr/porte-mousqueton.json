        "fr-extract.jsonl": [
            {
                "entry_id": "0cec2fc8-a7a1-31de-ae66-569548cad95e",
                "word": "porte-mousqueton",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5e031d19-0934-43ce-bf6f-7517cd18a6c7",
                        "entry_id": "0cec2fc8-a7a1-31de-ae66-569548cad95e",
                        "tags": [
                            "plural"
                        ],
                        "form": "porte-mousquetons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "17f86083-c072-36bc-9ef1-b04220d135b0",
                        "entry_id": "0cec2fc8-a7a1-31de-ae66-569548cad95e",
                        "glosses": [
                            "Crochet ou agrafe qui est au bas de la bandoulière d’un cavalier et qui l’aide à porter son mousqueton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74206503-95fe-45db-bcb6-e09d95c68465",
                                "sense_id": "17f86083-c072-36bc-9ef1-b04220d135b0",
                                "text": "J’avais fait le choix d’un costume de travail approprié à la circonstance ; devant la poitrine deux sacs à sable, chacun contenant quatre grenades à manche, celles de gauche percutantes, celles de droite fusantes ; dans la poche gauche de la tunique, un pistolet suspendu par une longue courroie ; dans la poche droite du pantalon, un petit pistolet Mauser ; dans la poche gauche de la tunique, cinq grenades sphériques, dans celle du pantalon une boussole lumineuse et un sifflet à roulette ; au ceinturon un porte-mousqueton pour amorcer les grenades, un poignard, une cisaille à barbelés."
                            }
                        ]
                    },
                    {
                        "sense_id": "37e5a37c-e4dd-32c6-8c7f-895829da64cf",
                        "entry_id": "0cec2fc8-a7a1-31de-ae66-569548cad95e",
                        "glosses": [
                            "Agrafe à déclic placée au bout d’une chaîne ou d’un cordon pour y accrocher une montre, un sac, et qu’on peut ouvrir ou fermer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e940a5de-7c45-4f6c-8934-b4e6a7b8f984",
                                "sense_id": "37e5a37c-e4dd-32c6-8c7f-895829da64cf",
                                "text": "Nous prîmes notre parti et côte à côte, la main sur le porte-mousqueton de nos sacs, tâtant le terrain de nos bâtons, nous entrâmes dans l’eau jusqu'aux chevilles, jusqu’aux genoux, jusqu’au ventre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "428733c2-3831-4461-b3fe-cd93695bf332",
                        "source_entry_id": "0cec2fc8-a7a1-31de-ae66-569548cad95e",
                        "target_lang_word": "staple",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "staple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00c9f93e-acd3-34b2-811f-7ca82d1bae41",
                                        "entry_id": "fc04a496-fe36-3835-8df1-9e43fcc1afb6",
                                        "glosses": [
                                            "A town containing merchants who have exclusive right, under royal authority, to purchase or produce certain goods for export; also, the body of such merchants seen as a group."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea49a6bb-f998-41d7-a0db-6026d9321cd7",
                                                "sense_id": "00c9f93e-acd3-34b2-811f-7ca82d1bae41",
                                                "text": "The customs of Alexandria were very great, it having been the staple of the Indian trade."
                                            },
                                            {
                                                "example_id": "f7142857-174b-4b49-8087-65d5590395df",
                                                "sense_id": "00c9f93e-acd3-34b2-811f-7ca82d1bae41",
                                                "text": "For the increase of trade and the encouragement of the worthy burgesses of Woodstock, her majesty was minded to erect the town into a staple for wool."
                                            },
                                            {
                                                "example_id": "95fbc795-4e42-4523-b8b4-6410f6391f1d",
                                                "sense_id": "00c9f93e-acd3-34b2-811f-7ca82d1bae41",
                                                "text": "Calais was one of the ‘principal treasures’ of the crown, of both strategic and economic importance. It was home to the staple, the crown-controlled marketplace for England's lucrative textile trade, whose substantial customs and tax revenues flooded into Henry's coffers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d97bd4e9-0d72-36a1-8749-64d9eb46b1c2",
                                        "entry_id": "fc04a496-fe36-3835-8df1-9e43fcc1afb6",
                                        "glosses": [
                                            "Place of supply; source."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a191fb49-872f-4110-98b0-1e7ffc65d7b9",
                                                "sense_id": "d97bd4e9-0d72-36a1-8749-64d9eb46b1c2",
                                                "text": "Whitehall naturally became the chief staple of news. Whenever there was a rumour that anything important had happened or was about to happen, people hastened thither to obtain intelligence from the fountain head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55f3ab96-64cb-3bd8-ae44-9e0d217c40d2",
                                        "entry_id": "fc04a496-fe36-3835-8df1-9e43fcc1afb6",
                                        "glosses": [
                                            "The principal commodity produced in a town or region."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3bb9b07-97cc-4ee1-965b-edf48e199f28",
                                                "sense_id": "55f3ab96-64cb-3bd8-ae44-9e0d217c40d2",
                                                "text": "The old staple of coal is a declining traffic; and what remains tends to be hauled a shorter distance, as new power stations are sited closer to coalfields."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daffd003-37be-355f-842c-e2fe256fc92a",
                                        "entry_id": "fc04a496-fe36-3835-8df1-9e43fcc1afb6",
                                        "glosses": [
                                            "A basic or essential supply."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38763b24-f88d-4003-bea5-e5430d0a096b",
                                                "sense_id": "daffd003-37be-355f-842c-e2fe256fc92a",
                                                "text": "Rice is a staple in the diet of many cultures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a100a67e-d7fe-3e30-be20-9c21cdee28e8",
                                        "entry_id": "fc04a496-fe36-3835-8df1-9e43fcc1afb6",
                                        "glosses": [
                                            "A recurring topic or character."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8865048f-e813-4a75-b710-edc17fc85183",
                                                "sense_id": "a100a67e-d7fe-3e30-be20-9c21cdee28e8",
                                                "text": "In most countries, rubbish makes headlines only when it is not collected, and stinking sacks lie heaped on the streets. In Britain bins are a front-page staple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7bd2ca7-e6b3-360b-acf1-d97e58598c1c",
                                        "entry_id": "fc04a496-fe36-3835-8df1-9e43fcc1afb6",
                                        "glosses": [
                                            "Short fiber, as of cotton, sheep’s wool, or the like, which can be spun into yarn or thread."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25a52003-d2dd-4769-89b7-5ab7c3707529",
                                                "sense_id": "d7bd2ca7-e6b3-360b-acf1-d97e58598c1c",
                                                "text": "Tow is flax with short staple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2a438a7-6ef1-36e2-82ec-a918a3b98b31",
                                        "entry_id": "fc04a496-fe36-3835-8df1-9e43fcc1afb6",
                                        "glosses": [
                                            "Unmanufactured material; raw material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
