                        "entry_id": "9c964444-ce90-38de-b2b6-50ec5b4e3f1b",
                        "glosses": [
                            "A class of plant growth substance (often called phytohormones or plant hormones) which play an essential role in coordination of many growth and behavioral processes in the plant life cycle."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ec73c23c-0afa-465b-8e39-4079a9da7608",
                                "sense_id": "b40ef933-cd1d-3b90-82ee-476076ab3766",
                                "text": "In Arabidopsis roots, cold stress may reduce shootward auxin transport and alter the intracellular auxin gradient."
                            },
                            {
                                "example_id": "cdb1b9d9-cedd-4307-b49a-348613cfdb00",
                                "sense_id": "b40ef933-cd1d-3b90-82ee-476076ab3766",
                                "text": "SE onset depends on a complex network of interactions among plant growth regulators, mainly auxins and cytokinins, during the proembryogenic early stages, and ethylene and gibberellic and abscisic acids later in the development of somatic embryos."
                            }
                        ]
                    }
