                },
                {
                    "sense_id": "c8e44eb9-50b4-3223-aec1-27b313ee81a9",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>durven</w> (bij inversie)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Durf</w> je van die hoge duikplank in het water te springen?",
                            "target_lang_translations": {
                                "ru": "Ты <w>осмелишься</w> прыгнуть в воду с той высокой вышки?",
                                "en": "Do you <w>dare</w> to jump into the water from that high diving board?",
                                "de": "<w>Traust du dich</w>, von diesem hohen Sprungturm ins Wasser zu springen?"
                            }
                        },
                        {
                            "text": "Waarom <w>durf</w> je dat niet tegen hem te zeggen?",
                            "target_lang_translations": {
                                "ru": "Почему ты не <w>решаешься</w> сказать ему это?",
                                "en": "Why do you not <w>dare</w> to say that to him?",
                                "de": "Warum <w>traust du dich</w> nicht, ihm das zu sagen?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "durf je",
                        "durf jij"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "bij inversie"
                        }
                    ],
                    "target_lang_definitions": {
