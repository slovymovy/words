                            {
                                "example_id": "7429743b-7f07-477e-b45e-c4ea9dd9f755",
                                "sense_id": "a12d0cd5-dbb5-3d90-815c-58989d690ec2",
                                "text": "Some marine salvagers might be interested in these unusual mag hits."
                            },
                            {
                                "example_id": "4cb26639-1c14-43ae-b020-d58ff3145db0",
                                "sense_id": "a12d0cd5-dbb5-3d90-815c-58989d690ec2",
                                "text": "The policy is that all staff entering the Capitol are required to go through the mags whether or not they are with a Member of Congress."
                            },
                            {
                                "example_id": "11869770-5a23-4fb2-aed8-63f2de27bf60",
                                "sense_id": "a12d0cd5-dbb5-3d90-815c-58989d690ec2",
                                "text": "“Take the f-ing mags away. Let my people in. They can march to the Capitol from here.”"
                            }
                        ]
