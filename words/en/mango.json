                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The ship anchored off the coast of <w>Mango</w> during the expedition.",
                            "target_lang_translations": {
                                "ru": "Во время экспедиции корабль бросил якорь у берегов <w>Манго</w>."
                            }
                        },
                        {
                            "text": "He was born in <w>Mango</w>, a small township in the region.",
                            "target_lang_translations": {
                                "ru": "Он родился в <w>Манго</w>, небольшом поселении в этом регионе."
                            }
