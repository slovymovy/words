                ],
                "senses": [
                    {
                        "sense_id": "9350e7c7-fa26-3ddd-8901-16dead0c1501",
                        "entry_id": "817193a6-6a7b-350e-af52-7c2299b8f417",
                        "glosses": [
                            "aus Ziegenmilch hergestellter Käse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a3437f8-217d-4b2e-b0f0-6cb8004e2eb5",
                                "sense_id": "9350e7c7-fa26-3ddd-8901-16dead0c1501",
                                "text": "Für den einen ist Ziegenkäse eine Delikatesse, für den anderen etwas Ungenießbares."
                            },
                            {
                                "example_id": "8f45d5af-e24e-4117-bdcc-c14b26ba325c",
                                "sense_id": "9350e7c7-fa26-3ddd-8901-16dead0c1501",
                                "text": "„Ich war lange vor Skral aus dem Zimmer gegangen, hatte mich auf diese wackeligen Stühle gesetzt, mir einen starken Tee gekocht und aß Feigen und Ziegenkäse dazu.“"
                            },
                            {
                                "example_id": "314d3113-4397-420a-9342-1b5ef80b96bf",
                                "sense_id": "9350e7c7-fa26-3ddd-8901-16dead0c1501",
                                "text": "„Er setzte sich an einen leeren Tisch an der Avenue George V und bestellte boeuf à la mode, Salat, Ziegenkäse und eine Karaffe Vouvray.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4300191-402b-4a5a-a62a-94c4491d990b",
                        "source_entry_id": "817193a6-6a7b-350e-af52-7c2299b8f417",
                        "source_sense_id": "9350e7c7-fa26-3ddd-8901-16dead0c1501",
                        "source_sense_description": "aus Ziegenmilch hergestellter Käse",
                        "target_lang_word": "goat's cheese",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goat's cheese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8753d02f-a525-3809-8e38-2b21c96bbc95",
                                        "entry_id": "6f3f1589-a3cb-3389-a253-9a5f0e376767",
                                        "glosses": [
                                            "Alternative form of goat cheese."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7010e871-50e1-4975-a22e-a6d8c07034e8",
                                                "sense_id": "8753d02f-a525-3809-8e38-2b21c96bbc95",
                                                "text": "[…]it may easily become so to an enlarged extent when goat′s cheese shall be offered in our markets."
                                            },
                                            {
                                                "example_id": "81019cc5-c4b5-4f90-9fdc-b85fecbf0fe0",
                                                "sense_id": "8753d02f-a525-3809-8e38-2b21c96bbc95",
                                                "text": "2002, New Statesman, Volume 131, Issues 4577-4585, page 47,\nOn the other hand, goat′s cheeses made by the British equivalents of Mme Blondeau, though you feel you ought to like them, never seem as inspired as their French counterparts."
                                            },
                                            {
                                                "example_id": "b609f02e-840c-49fb-a4d8-2a36656de8e0",
                                                "sense_id": "8753d02f-a525-3809-8e38-2b21c96bbc95",
                                                "text": "Place goat′s cheese parcels alongsise the roast tomatoes"
                                            },
                                            {
                                                "example_id": "92583da5-0b67-4076-b8a1-9ceec5363bd8",
                                                "sense_id": "8753d02f-a525-3809-8e38-2b21c96bbc95",
                                                "text": "2010, Amelia Thomas, Michael Kohn, Miriam Raphael, Dan Savery Raz, Israel & the Palestinian Territories, Lonely Planet, page 164,\nShai Seltzer, Israel′s most famous goat′s cheese maker, emerged wearing a white frock and thick white beard, an arrangement that made him appear like Charlton Heston when he played Moses in The Ten Commandments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59c83441-78bd-4262-b80e-9e5dded75a97",
                        "source_entry_id": "817193a6-6a7b-350e-af52-7c2299b8f417",
                        "source_sense_id": "9350e7c7-fa26-3ddd-8901-16dead0c1501",
