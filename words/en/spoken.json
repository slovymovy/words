                                "target_lang_sense_clarification": "动词，用于交流或谈话"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "67b3c062-f46c-32d8-897a-dcf51bf197c2",
                    "sense_definition": "Expressed through speech rather than writing; produced by articulate sounds.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "English is a widely <w>spoken</w> language around the world.",
                            "target_lang_translations": {
                                "ru": "Английский — язык, на котором широко <w>говорят</w> во всём мире.",
                                "zh": "英语是世界上被广泛<w>使用</w>的语言。"
                            }
                        },
                        {
                            "text": "The <w>spoken</w> word can sometimes be more powerful than the written one.",
                            "target_lang_translations": {
                                "ru": "<w>Устное</w> слово иногда может быть сильнее письменного.",
                                "zh": "有时<w>口头</w>表达比书面文字更有力量。"
                            }
                        }
                    ],
                    "synonyms": [
