        "fr-extract.jsonl": [
            {
                "entry_id": "19744ab0-628a-3f3b-b9ff-c9a988a1fa56",
                "word": "alibi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "93288061-9b08-4f35-8620-00a2fe4d77a4",
                        "entry_id": "19744ab0-628a-3f3b-b9ff-c9a988a1fa56",
                        "tags": [
                            "plural"
                        ],
                        "form": "alibis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "24128f09-ccb3-31f9-8ecc-268997469ec2",
                        "entry_id": "19744ab0-628a-3f3b-b9ff-c9a988a1fa56",
                        "glosses": [
                            "Présence d’une personne dans un lieu autre que celui où a été commis le crime ou le délit dont on l’accuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4d657a0-354c-482a-b62d-874fdecb2606",
                                "sense_id": "24128f09-ccb3-31f9-8ecc-268997469ec2",
                                "text": "Les autres figurants et leur chef ont déclaré qu'il était resté en scène jusqu'à onze heures et qu'au moment où il est parti, la maison brûlait déjà. Il n'y eut jamais d’alibi mieux établi..."
                            },
                            {
                                "example_id": "4462d883-1ff4-4b9a-bf51-9fdbced54ff5",
                                "sense_id": "24128f09-ccb3-31f9-8ecc-268997469ec2",
                                "text": "Si on veut faire accuser quelquʼun, on sʼarrange pour quʼil nʼait pas dʼalibi."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ed778c7-3970-39fc-865e-69dede9ff141",
                        "entry_id": "19744ab0-628a-3f3b-b9ff-c9a988a1fa56",
                        "glosses": [
                            "Argument invoqué pour échapper à une accusation, même non juridique."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "56a003d4-a5f3-4cb6-9dab-2d392b7da17d",
                                "sense_id": "7ed778c7-3970-39fc-865e-69dede9ff141",
                                "text": "Cela demande à être pensé, surtout pour l'islam qui en est à son quinzième siècle. C'est une religion jeune, ce qui ne doit pas lui servir d'alibi ou de justification."
                            },
                            {
                                "example_id": "a3d10e11-0ffd-46b5-8bf7-7290ebdcc132",
                                "sense_id": "7ed778c7-3970-39fc-865e-69dede9ff141",
                                "text": "Un discours logique trouve toujours un alibi indiscutable pour motiver le meurtre de l’autre ou son asservissement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67dd8c5e-f3e3-47e9-9856-8d9033622630",
                        "source_entry_id": "19744ab0-628a-3f3b-b9ff-c9a988a1fa56",
                        "target_lang_word": "Alibi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alibi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8dc2164-5312-3684-bc84-56d28dd59af2",
                                        "entry_id": "9a56906c-254d-37bc-9e40-cc60c7b442b3",
                                        "glosses": [
                                            "Nachweis, nicht zum Zeitpunkt eines Verbrechens am Tatort gewesen zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e81b323-edee-4ca8-a6f9-ca253c596eff",
                                                "sense_id": "d8dc2164-5312-3684-bc84-56d28dd59af2",
                                                "text": "Er hat ein wasserdichtes Alibi."
                                            },
                                            {
                                                "example_id": "c71009ea-5373-4871-8e7a-e192d7c13729",
                                                "sense_id": "d8dc2164-5312-3684-bc84-56d28dd59af2",
                                                "text": "Die Zeugin verschaffte mir ein Alibi."
                                            },
                                            {
                                                "example_id": "db06c616-e0d1-4fc6-ae99-adf3b13d5cd2",
                                                "sense_id": "d8dc2164-5312-3684-bc84-56d28dd59af2",
                                                "text": "Das Alibi wurde von dem Zeugen nicht bestätigt."
                                            },
                                            {
                                                "example_id": "3562caeb-c879-494e-9950-44097c8e6eb7",
                                                "sense_id": "d8dc2164-5312-3684-bc84-56d28dd59af2",
                                                "text": "„Folgende Maßnahmen und Vorkehrungen traf ich, um meinen Haß gegen den Schurken zu befriedigen und mir ein ganz sicheres Alibi für den Fall zu verschaffen, daß ich ihn etwa umbrachte, wie ich es gern getan hätte.“"
                                            },
                                            {
                                                "example_id": "d4f92adf-6b7b-40eb-bb34-0597286bd578",
                                                "sense_id": "d8dc2164-5312-3684-bc84-56d28dd59af2",
                                                "text": "„Der alte Rosa sagte mir, man rede von nichts anderem als von dem Bravourstück meines Alibis, und da diese Berühmtheit nur auf der Gewißheit beruhen könne, daß es falsch sei, müsse ich eine Rache ähnlicher Art von Seiten Razzettas fürchten.“"
                                            },
                                            {
                                                "example_id": "1b0d5076-7555-4fc2-90de-0a3725d361f7",
                                                "sense_id": "d8dc2164-5312-3684-bc84-56d28dd59af2",
                                                "text": "„Ich war so taktvoll, nicht mit meinem eigenen Alibi zu prahlen, fand es aber angebracht, es ihm gegenüber zu erwähnen.“"
                                            },
                                            {
                                                "example_id": "cfd4b356-4682-4056-ba00-0921215a37fd",
                                                "sense_id": "d8dc2164-5312-3684-bc84-56d28dd59af2",
                                                "text": "„Die Kinder sind sein einziges Alibi, und die haben zu der Zeit wahrscheinlich geschlafen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "59973829-0080-3c76-81f4-b51d7d456464",
                                        "entry_id": "9a56906c-254d-37bc-9e40-cc60c7b442b3",
                                        "glosses": [
                                            "allgemein eine Ausrede oder Rechtfertigung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c94847ba-3889-4040-9976-504aaae69b04",
                                                "sense_id": "59973829-0080-3c76-81f4-b51d7d456464",
                                                "text": "„Der türkische Nationalspieler […] wird Hertha am Samstag bei Hannover 96 in jedem Fall fehlen. „Das soll aber kein Alibi sein“, sagt Trainer Falko Götz, „wir haben trotzdem die Möglichkeit, Hannover zu schlagen.““"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54235039-8fcd-43f5-93bf-809bf4a95b3d",
                        "source_entry_id": "19744ab0-628a-3f3b-b9ff-c9a988a1fa56",
                        "target_lang_word": "alibi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alibi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52a843d9-d356-3a4a-91f5-9bcc2c7ddc38",
                                        "entry_id": "49623d0d-89b1-37fb-9995-47bcba0b4621",
                                        "glosses": [
                                            "The plea or mode of defense under which a person on trial for a crime proves or attempts to prove being in another place when the alleged act was committed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7ec7236-50af-48eb-8f9d-3e334915663a",
                                                "sense_id": "52a843d9-d356-3a4a-91f5-9bcc2c7ddc38",
                                                "text": "to set up an alibi"
                                            },
                                            {
                                                "example_id": "c52139a3-b27d-49a9-b549-bcc60db6f687",
                                                "sense_id": "52a843d9-d356-3a4a-91f5-9bcc2c7ddc38",
                                                "text": "to prove an alibi"
                                            },
                                            {
                                                "example_id": "e911d2f5-fa5a-453e-96cc-c4185103a36d",
                                                "sense_id": "52a843d9-d356-3a4a-91f5-9bcc2c7ddc38",
                                                "text": "The judge said, “Son, what is your alibi? If you were somewhere else, then you won’t have to die.”"
                                            },
                                            {
                                                "example_id": "508ca4e5-4bb7-4c71-bda8-44815dd7c55a",
                                                "sense_id": "52a843d9-d356-3a4a-91f5-9bcc2c7ddc38",
                                                "text": "Alibi is different from all of the other defenses . . . it is based upon the premise that the defendant is truly innocent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a9edc19-95e5-3fb6-a700-e5fb380bb7c3",
                                        "entry_id": "49623d0d-89b1-37fb-9995-47bcba0b4621",
                                        "glosses": [
                                            "An excuse, especially one used to avoid responsibility or blame."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7860a19-41de-4356-997f-b43ae7e2b83d",
                                                "sense_id": "8a9edc19-95e5-3fb6-a700-e5fb380bb7c3",
                                                "text": "That day in September, I'm sure you can remember / That's when all the stuff hit the fan (the stuff hit the fan) / You told me a lie, and you didn't have an alibi / But baby, yet I still cared"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "alibi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e794dca7-b658-3cb6-bc47-046ea69971af",
                                        "entry_id": "ce01702d-7158-3ac7-8dbf-883719e46a5f",
                                        "glosses": [
