                                "target_senses": [
                                    {
                                        "sense_id": "b5188697-6c3b-3b69-94f2-2f27e44c9524",
                                        "entry_id": "59040444-1e83-34e2-aa27-2170f1d20e4b",
                                        "glosses": [
                                            "A situation in which two suitors vie or compete for the love of the same person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dd348b2-a70f-4495-a872-c8718b805272",
                                                "sense_id": "b5188697-6c3b-3b69-94f2-2f27e44c9524",
                                                "text": "La Battaglia di Legnano is a patriotic melodrama with a love triangle theme included."
                                            },
                                            {
                                                "example_id": "7c9c369b-1d08-4758-a364-a95e4c2cdcc8",
                                                "sense_id": "b5188697-6c3b-3b69-94f2-2f27e44c9524",
                                                "text": "By placing Max and Onno in a love triangle with Ada, Mr. Mulisch achieves an emotional depth that recalls Francois Truffaut's classic film “Jules and Jim.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a76777ef-c2c5-4a52-b591-8822586dbca1",
                        "source_entry_id": "095adffc-bc57-31d5-866e-1b7771fdeba1",
                        "source_sense_id": "a60a01e6-4814-31b0-ac0e-5a7fbed6d5ba",
                        "source_sense_description": "meist sexuelle Beziehung von drei Personen untereinander",
                        "target_lang_word": "ménage à trois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ménage à trois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f3cdb35-a270-3f0c-b8c7-0e8fcae7cf88",
                                        "entry_id": "995edc87-6fc7-3696-b444-960a22824220",
                                        "glosses": [
                                            "Couple qui accueille une troisième personne à la maison, souvent l’amant ou l’amante du mari ou de la femme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75a5257f-40e6-4965-ad0c-f7fef8a118da",
                                                "sense_id": "1f3cdb35-a270-3f0c-b8c7-0e8fcae7cf88",
                                                "text": "Claude Watelet donne des cours d'aquatinte à Marguerite Lecomte, pastelliste, qui a le même âge que lui (28 ans). De la naîtra un amour qui dura 40 ans.\nCela semble s'être fait sans heurt et ils formèrent un ménage à trois avec le mari."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4a3ba01-d09f-3e1d-b299-70e0cdba1c59",
                                        "entry_id": "995edc87-6fc7-3696-b444-960a22824220",
                                        "glosses": [
                                            "Trio."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff163568-9ef5-492f-a2db-c8ebf3f9d807",
                                                "sense_id": "d4a3ba01-d09f-3e1d-b299-70e0cdba1c59",
                                                "text": "Et leur machine, leur pauvre machine, la bonne amie si aimée de leur ménage à trois, qui était là sur le dos, à rendre tout le souffle de sa poitrine, par ses poumons crevés !"
                                            },
                                            {
                                                "example_id": "9810eaf0-f34a-4355-b889-da1736d48e58",
                                                "sense_id": "d4a3ba01-d09f-3e1d-b299-70e0cdba1c59",
                                                "text": "Comme on l’avait renvoyée de la chambre, en disant qu’on se passerait d’elle, pour les malles, elle était retournée dans sa cuisine, elle s’y livrait à ses besognes ordinaires, en ayant l’air d’ignorer la catastrophe qui bouleversait leur ménage à trois."
                                            },
                                            {
                                                "example_id": "1de43333-0eb1-41ae-bd29-42acd08d9315",
                                                "sense_id": "d4a3ba01-d09f-3e1d-b299-70e0cdba1c59",
                                                "text": "Frank Schleck sort victorieux d’un ménage à trois. Cerné par les deux frères Schleck, le maillot jaune Alberto Contador a parfaitement résisté dans l’étape-reine du Tour de France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52e3741c-b737-3272-aacc-d85eb771e103",
                                        "entry_id": "995edc87-6fc7-3696-b444-960a22824220",
                                        "glosses": [
                                            "Triolisme, pratique sexuelle impliquant trois personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c81aff4d-d687-42d2-916d-558b474b1a29",
                                                "sense_id": "52e3741c-b737-3272-aacc-d85eb771e103",
                                                "text": "Cappie veut improviser un ménage à trois pour prouver à ses frères qu’il n’est pas l’homme d’une seule femme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
