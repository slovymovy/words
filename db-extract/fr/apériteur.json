                    {
                        "sense_id": "fe2be194-bd31-31b7-b3cc-a635824f8ef6",
                        "entry_id": "1eb2f21e-85af-3df3-9835-b3e6638a4e60",
                        "glosses": [
                            "Qui prend la tête d'un groupement d’assurances et généralement négocie le contrat avec l’assuré lorsque les risques à couvrir sont jugés trop importants pour être supportés par un seul assureur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9129b3b1-dc1a-4c77-b07e-d362855ea8f3",
                                "sense_id": "fe2be194-bd31-31b7-b3cc-a635824f8ef6",
                                "text": "Assureur apériteur, compagnie, société apéritrice."
                            }
                        ]
                    }
                ],
