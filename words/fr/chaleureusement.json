    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1bab0d68-5fc2-3bf4-89a9-39d601a76922",
                    "sense_definition": "D'une manière cordiale, bienveillante et pleine d'affection.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cordialite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les villageois ont <w>chaleureusement</w> accueilli la famille venue s'installer chez eux."
                        },
                        {
                            "text": "Je tiens à remercier <w>chaleureusement</w> toutes les personnes présentes ce soir."
                        }
                    ],
                    "synonyms": [
                        "cordialement",
                        "affectueusement"
                    ],
                    "antonyms": [
                        "froidement"
                    ],
                    "common_phrases": [
                        "accueillir chaleureusement",
                        "remercier chaleureusement"
                    ]
                },
                {
                    "sense_id": "0313003c-602c-3d4a-84f3-0549788c67a8",
                    "sense_definition": "Formule de salutation bienveillante et amicale à la fin d'une lettre ou d'un courriel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "correspondance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a terminé son message en écrivant simplement : « <w>Chaleureusement</w>, Antoine »."
                        },
                        {
                            "text": "En attendant de vous revoir, je vous embrasse bien <w>chaleureusement</w>."
                        }
                    ],
                    "synonyms": [
                        "amicalement",
                        "cordialement"
                    ],
                    "common_phrases": [
                        "bien chaleureusement"
                    ]
                },
                {
                    "sense_id": "543e653d-01d0-3303-ae7b-93b864f3ab64",
                    "sense_definition": "Avec passion, ardeur ou vivacité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ardeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orateur a défendu <w>chaleureusement</w> son projet devant une assemblée attentive."
                        },
                        {
                            "text": "Le public a <w>chaleureusement</w> applaudi la troupe à la fin de la représentation."
                        }
                    ],
                    "synonyms": [
                        "ardemment",
                        "passionnément"
                    ],
                    "common_phrases": [
                        "défendre chaleureusement",
                        "applaudir chaleureusement"
                    ]
                }
            ]
        }
    ]
