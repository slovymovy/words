                        "examples": [
                            {
                                "example_id": "e6bea0a2-0332-416e-b5fc-7d896692759a",
                                "sense_id": "f2f06f1c-aeff-33d5-919b-196b944d84a4",
                                "text": "Léontine avait oublié de mettre ses fausses nattes."
                            },
                            {
                                "example_id": "b16a8e9a-bdf7-4214-8c49-d3d64492bd86",
                                "sense_id": "f2f06f1c-aeff-33d5-919b-196b944d84a4",
                                "text": "Cela dépend s’il s’agit de la digestion œsophagique, stomacale, intestinale ; inutile de vous donner des explications que vous ne comprendriez pas, puisque vous n’avez pas fait vos études de médecine. Allons, Léontine, en avant… harche, il est temps de partir."
                            }
                        ]
                    }
                ],
