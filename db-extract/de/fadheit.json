                                        "entry_id": "a851bb00-59c2-3e03-992c-c1cb828bb7ad",
                                        "glosses": [
                                            "A lack of distinctive, appealing, or energetic character; tastelessness; extreme blandness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a5f8bc8-23b2-406a-81e5-f39bd10209b0",
                                                "sense_id": "7f560a69-91f0-3fb1-8419-6ed9a688b8b2",
                                                "text": "As Jean Lurcat said, \"The art had died, killed by consumption, insipidness, lymphatism, and inversion.\""
                                            },
                                            {
                                                "example_id": "18072aa4-e7b5-4adf-8e24-45d837e7a941",
                                                "sense_id": "7f560a69-91f0-3fb1-8419-6ed9a688b8b2",
                                                "text": "This poem suffers from structural weakness, indeed insipidness."
                                            },
                                            {
                                                "example_id": "e2224c95-e4b7-439f-8340-47a355178c3b",
                                                "sense_id": "7f560a69-91f0-3fb1-8419-6ed9a688b8b2",
                                                "text": "His void spaces are a criticism of the insipidness of the overly materialistic modern way of life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
