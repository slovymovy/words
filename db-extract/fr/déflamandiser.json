                "senses": [
                    {
                        "sense_id": "0d9570f2-3014-32b0-8f22-988b69a21fc4",
                        "entry_id": "7783eaa7-7e8e-31d6-be71-b0d997c67b11",
                        "glosses": [
                            "Faire perdre son caractère flamand à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79711f1a-af3e-40a5-872b-5cd12f9dcad5",
                                "sense_id": "0d9570f2-3014-32b0-8f22-988b69a21fc4",
                                "text": "Ceux qui travaillent à déflamandiser la Flandre ou qui y prêtent la main concourent tout aussi sûrement à sa déchristianisation…"
                            },
                            {
                                "example_id": "afba77e3-586f-426c-ba4f-fe83915f7bc2",
                                "sense_id": "0d9570f2-3014-32b0-8f22-988b69a21fc4",
                                "text": "Je veux déflamandiser et dépolitiser l’entreprise."
                            },
                            {
                                "example_id": "a34cd164-d932-458f-8cb3-0094e41b8354",
                                "sense_id": "0d9570f2-3014-32b0-8f22-988b69a21fc4",
                                "text": "Dix-neuf communes à déflamandiser. Que ma tribu va décoloniser."
                            }
                        ]
                    }
