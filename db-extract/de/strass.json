                                    {
                                        "sense_id": "9ba0f6a5-f2c6-3d66-b664-83d308c6f05d",
                                        "entry_id": "8f34003f-6682-311b-a1b2-2ceb6d3bf411",
                                        "glosses": [
                                            "An artificial diamond, strass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f105bb2-6917-433e-8b73-675c46373073",
                                                "sense_id": "9ba0f6a5-f2c6-3d66-b664-83d308c6f05d",
                                                "text": "Lucinda sewed rhinestones into her scarf to add a bit of flair."
                                            }
