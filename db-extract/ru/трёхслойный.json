                ],
                "senses": [
                    {
                        "sense_id": "34d343cf-b891-3d9f-8e35-665bc848c5db",
                        "entry_id": "73309fdd-ac33-3fc7-b317-ff7b54a170ec",
                        "glosses": [
                            "состоящий из трёх слоёв, имеющий три слоя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c7b2482-9f59-4886-8ace-eaf88aa7e1ae",
                                "sense_id": "34d343cf-b891-3d9f-8e35-665bc848c5db",
                                "text": "Ветер сматывал с неба за горизонт грязно-серую хмарь, обнажая трёхслойные горы облаков."
                            },
                            {
                                "example_id": "4eb698dd-44a7-4eca-a887-96bfb0c9b428",
                                "sense_id": "34d343cf-b891-3d9f-8e35-665bc848c5db",
                                "text": "Иногда мембраны называют «трёхслойным пирогом», ибо под электронным микроскопом они выглядят как трёхполосные ленты: две тёмные (белки) по краям и между ними одна светлая (липиды)."
                            }
                        ]
                    }
