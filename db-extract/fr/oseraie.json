                            {
                                "example_id": "ea70bbf2-a4aa-41d5-abb4-8e72330c5e0a",
                                "sense_id": "22584073-e471-32a3-acbd-17238b452569",
                                "text": "Lorsqu'on veut qu'une oseraie profite, il faut nécessairement l'enfermer dans une clôture ; autrement les bestiaux y feront beaucoup de dégâts.",
                                "translation": "Als je wil dat een bos teenwilgen welig tiert, dan moet je het noodzakelijkerwijs omringen met een omheining; anders zal het ongedierte er veel schade aanrichten."
                            }
                        ]
                    }
