                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d3c032a-5377-3578-8a75-ed1833e814a4",
                                        "entry_id": "d8374f56-a897-3245-814b-f5ab3cd03773",
                                        "glosses": [
                                            "Technique, relatif aux arts et métiers."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2df9e37-c56d-4274-be66-51abe5a0edcd",
                                                "sense_id": "9d3c032a-5377-3578-8a75-ed1833e814a4",
                                                "text": "Les écrivains technologues, ceux qui écrivent sur les arts et métiers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "technologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45df7a6f-3bf6-3df8-a122-5ddbcdc66edf",
                                        "entry_id": "d283d1f6-0acb-302f-ad84-2e530d2bf07b",
                                        "glosses": [
                                            "Personne qui dans sa profession a une connaissance très pointue dans une technologie particulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51ca4700-1653-454f-b817-09427d3daa33",
                                                "sense_id": "45df7a6f-3bf6-3df8-a122-5ddbcdc66edf",
                                                "text": "Les technologues et les sociologues éclairent les manœuvres colonialistes et multiplient les études sur les « complexes » : complexe de frustration, complexe belliqueux, complexe de colonisabilité."
                                            },
                                            {
                                                "example_id": "009db437-0b64-4f1b-b79f-d9920bd08861",
                                                "sense_id": "45df7a6f-3bf6-3df8-a122-5ddbcdc66edf",
                                                "text": "Le test TZ est simple pour les besoins de la plupart des chercheurs en malherbologie, mais pour les technologues de semences le test peut être tout à fait complexe."
                                            }
                                        ]
                                    }
                                ]
                            }
