                ],
                "translations": [
                    {
                        "translation_id": "6b1355a0-540c-469e-a1a3-5d4e0ea4c2b5",
                        "source_entry_id": "53e99ba4-c2fd-359a-a0aa-870149ff1627",
                        "source_sense_id": "b6d4e38f-a91c-3ebe-9e39-f26178547436",
                        "target_lang_word": "seminary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seminary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f62aefd-e9ae-3f2b-87ff-b3815346c127",
                                        "entry_id": "0183a4ac-1edc-3545-9a56-3a4fa7e14cfd",
                                        "glosses": [
                                            "A theological school for the training of rabbis, priests, or ministers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65de9158-b343-39f3-90db-51c3180a9205",
                                        "entry_id": "0183a4ac-1edc-3545-9a56-3a4fa7e14cfd",
                                        "glosses": [
                                            "A private residential school for girls."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "659384fc-ef3f-4949-8f56-ce6b2ddd963d",
                                                "sense_id": "65de9158-b343-39f3-90db-51c3180a9205",
                                                "text": "Three little maids who, all unwary,\n Come from a ladies' seminary"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "546b982b-ac93-3020-a192-cf23a9bbd2ac",
                                        "entry_id": "0183a4ac-1edc-3545-9a56-3a4fa7e14cfd",
                                        "glosses": [
                                            "A class of religious education for youths ages 14–18 that accompanies normal secular education."
                                        ],
                                        "tags": [
                                            "Mormonism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "788b30cd-bb98-3501-b9df-a6d9c980a6cf",
                                        "entry_id": "0183a4ac-1edc-3545-9a56-3a4fa7e14cfd",
                                        "glosses": [
                                            "A piece of ground where seed is sown for producing plants for transplantation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4fcfe11-1481-4a9d-91bf-d817f755cf84",
                                                "sense_id": "788b30cd-bb98-3501-b9df-a6d9c980a6cf",
                                                "text": "I shall first begin with the Seminary and Nursery, as what is the first Work to be taken care of where you have not the opportunity of buying Trees"
                                            },
                                            {
                                                "example_id": "367a5f56-8ed6-44c4-8bb3-124220dc15ab",
                                                "sense_id": "788b30cd-bb98-3501-b9df-a6d9c980a6cf",
                                                "text": "[B]ut if you draw them [seedlings] only for the thinning of your Seminary, prick them into ſome empty Beds at one foot interval, leaving the reſt at two or three."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaff012c-f608-3ca7-a6b9-affdc70bd226",
                                        "entry_id": "0183a4ac-1edc-3545-9a56-3a4fa7e14cfd",
                                        "glosses": [
                                            "The place or original stock from which anything is brought or produced."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "136d2368-136b-4c86-8b5c-0316811d9103",
                                                "sense_id": "aaff012c-f608-3ca7-a6b9-affdc70bd226",
                                                "text": "Seeing then there is indeed a twofold Seminary or stock in nature, from whence are deriv’d the issues of love and hatred distinctly flowing through the whole masse of created things, and that Gods doing ever is to bring the due likenesses and harmonies of his workes together, except when out of two contraries met to their own destruction, he moulds a third existence, and that it is error, or some evil Angel which either blindly or maliciously hath drawn together in two persons ill imbarkt in wedlock the sleeping discords and enmities of nature lull’d on purpose with some false bait, that they may wake to agony and strife, later then prevention could have wisht, if from the bent of just and honest intentions beginning what was begun, and so continuing, all that is equall, all that is fair and possible hath been tri’d, and no accommodation likely to succeed, what folly is it still to stand combating and battering against invincible causes and effects, with evill upon evill, till either the best of our dayes be linger’d out, or ended with some speeding sorrow."
                                            },
                                            {
                                                "example_id": "dc3ace07-13b9-4bba-8040-9e1ccf978c7d",
                                                "sense_id": "aaff012c-f608-3ca7-a6b9-affdc70bd226",
                                                "text": "the Seminary or Promptuary that furnisheth forth Matter for the Formation and Increment of Animal and Vegetable Bodies"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31aac050-60ed-327c-b898-389bbad6f711",
                                        "entry_id": "0183a4ac-1edc-3545-9a56-3a4fa7e14cfd",
                                        "glosses": [
                                            "Seminal state or polity."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce8fb5b0-aa9c-438e-ae6b-89e3993005dd",
                                                "sense_id": "31aac050-60ed-327c-b898-389bbad6f711",
                                                "text": "The hand of God that first created the Earth, hath with variety disposed the principles of all things; wisely contriving them in their proper seminaries"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8df6d4f-cd20-3233-9cc5-cd3d4f86340c",
                                        "entry_id": "0183a4ac-1edc-3545-9a56-3a4fa7e14cfd",
                                        "glosses": [
                                            "A Roman Catholic priest educated in a foreign seminary; a seminarist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9afdf2d5-511f-4709-a14f-116fbacebd3a",
                                                "sense_id": "b8df6d4f-cd20-3233-9cc5-cd3d4f86340c",
                                                "text": "I shall not need to instance in the effects which this bull produced; the treason of Watson and Cleark, two English seminaries, are sufficiently known"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af68b465-4ade-3e56-b03f-ee28ac256299",
                                        "entry_id": "0183a4ac-1edc-3545-9a56-3a4fa7e14cfd",
                                        "glosses": [
                                            "An academic seminar."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
