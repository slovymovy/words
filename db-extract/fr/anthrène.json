                "senses": [
                    {
                        "sense_id": "15708c93-630d-38f8-a0d9-c74776943fbc",
                        "entry_id": "90015d6e-1c92-358f-b3c8-00284864e3cc",
                        "glosses": [
                            "Genre de petits coléoptères de la famille des dermestidés, dont la larve se nourrit de fibres organiques d’origine animale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ee00209-64b7-44fe-9837-9d045cf529bc",
                                "sense_id": "15708c93-630d-38f8-a0d9-c74776943fbc",
                                "text": "Les musées se méfient des anthrènes dont les larves dévorent tout se qui s’apparente à de la peau ou à du poil."
                            },
                            {
                                "example_id": "6d6a359b-e03c-4d03-9b17-a849663fd4d7",
                                "sense_id": "15708c93-630d-38f8-a0d9-c74776943fbc",
                                "text": "Une fois desséché et momifié, il héberge encore des exploitants : les larves des attagènes et des anthrènes, les chenilles d'Aglossa cuprealis et de Tineola bisselelia."
                            },
                            {
                                "example_id": "15ec4d86-704a-475d-bc7e-ab9446cfa79a",
                                "sense_id": "15708c93-630d-38f8-a0d9-c74776943fbc",
                                "text": "Qu’il soit des musées, du mobilier ou des tapis, ce sont les récepteurs olfactifs de l’anthrène qui le guident vers l’endroit où la nourriture sera abondante pour les larves qu’il va pondre."
                            }
                        ]
                    }
                ],
