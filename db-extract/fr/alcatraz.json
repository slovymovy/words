                        "examples": [
                            {
                                "example_id": "d9d017c1-e94f-4c9c-b24b-d645493c3f80",
                                "sense_id": "a1a6613f-b1d7-3e78-baa8-d089a792acbd",
                                "text": "Alcatraz, nommée l'île des pélicans par les premiers Espagnols qui y débarquèrent en 1770, devint, en 1850, un pénitencier installé dans les bâtiments d'une forteresse militaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "d354e890-3137-3380-b58d-06033068c529",
                        "entry_id": "f03c142d-2c05-3ea8-96d0-98c040bf4f3b",
                        "glosses": [
                            "Ancienne prison de haute sécurité située sur cette île."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "48ccc75d-fdc4-3817-a03c-2617cc4bd26c",
                        "entry_id": "f03c142d-2c05-3ea8-96d0-98c040bf4f3b",
                        "glosses": [
                            "Lieu ayant un aspect carcéral et dont il est difficile de s'éloigner."
                        ],
                        "tags": [
                            "analogy",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "18f08c62-240b-4225-9640-ff509f5097f7",
                                "sense_id": "48ccc75d-fdc4-3817-a03c-2617cc4bd26c",
                                "text": "Il m’apparut nettement que l’hôtel était un Alcatraz entouré d’eau, dont on ne s’évadait pas."
                            }
                        ]
                    }
