                "senses": [
                    {
                        "sense_id": "d34e43d5-35d7-399f-b363-814249b447fe",
                        "entry_id": "a6495495-11da-3248-8cb8-576cf71ceecd",
                        "glosses": [
                            "oberster Teil der Wirbelsäule im Bereich des Halses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9e20376-3d8b-446e-901a-4aadaaedd290",
                                "sense_id": "d34e43d5-35d7-399f-b363-814249b447fe",
                                "text": "„Kronprinz Frederik von Dänemark hat sich beim Trampolinspringen an der Halswirbelsäule verletzt.“"
                            },
                            {
                                "example_id": "1e792198-40a2-4984-925b-7e75310f31ef",
                                "sense_id": "d34e43d5-35d7-399f-b363-814249b447fe",
                                "text": "„Nach einem Doppelsalto über das Seitpferd schlug er mit dem Kopf auf den Boden auf. Er brach sich die Halswirbelsäule, seitdem sitzt er im Rollstuhl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
