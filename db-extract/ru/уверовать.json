                ],
                "senses": [
                    {
                        "sense_id": "4c07242c-bf8a-3a93-9c43-968f76970cb4",
                        "entry_id": "1ba94105-52e5-38c7-b54b-7757757b8e4a",
                        "glosses": [
                            "книжн. твёрдо, окончательно поверить в кого-либо, во что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "893bdb8b-0877-45d5-be18-c1480c9c179a",
                                "sense_id": "4c07242c-bf8a-3a93-9c43-968f76970cb4",
                                "text": "Многие же из слушавших слово уверовали; и было число таковых людей около пяти тысяч."
                            },
                            {
                                "example_id": "a30eec29-b7c1-47dd-bd07-68c9dc270064",
                                "sense_id": "4c07242c-bf8a-3a93-9c43-968f76970cb4",
                                "text": "Она его выдумала и в свою выдумку сама же первая и уверовала."
                            },
                            {
                                "example_id": "57af003e-b932-4820-8315-f776e9b2f14d",
                                "sense_id": "4c07242c-bf8a-3a93-9c43-968f76970cb4",
                                "text": "В другой раз он начал с того, что убеждал обывателей уверовать в богиню Разума, и кончил тем, что просил признать непогрешимость папы."
                            }
                        ]
                    }
