                    },
                    {
                        "translation_id": "fa5808fb-0bfd-4ba3-8d1a-c7daed62a5b3",
                        "source_entry_id": "321029dc-76d3-37c7-a8cf-e6f4d9595706",
                        "source_sense_id": "9e41a1f1-30cf-3ab8-b14f-a660c00babb9",
                        "target_lang_word": "snuggle up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snuggle up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b7f05a6-190e-3c7d-80f5-d374c5f27d12",
                                        "entry_id": "0858e688-220f-3792-8350-e71293c04fc0",
                                        "glosses": [
                                            "To lie or sit in a comfortable, relaxed position, holding someone or something else."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "855f66c3-45a9-42ce-92df-e843635c7241",
                                                "sense_id": "4b7f05a6-190e-3c7d-80f5-d374c5f27d12",
                                                "text": "I was snuggling up in bed with my blanket."
                                            },
                                            {
                                                "example_id": "726670c6-dff6-47cf-af94-5a39c1ffa8f7",
                                                "sense_id": "4b7f05a6-190e-3c7d-80f5-d374c5f27d12",
                                                "text": "She snuggled up with her boyfriend."
                                            },
                                            {
                                                "example_id": "3ea2cf7d-2714-4eb0-86aa-a0e24540d0c8",
                                                "sense_id": "4b7f05a6-190e-3c7d-80f5-d374c5f27d12",
                                                "text": "Gingernut was small and ginger too, though of course he didn’t wear braces. That smallness and gingerness was probably, deep down, why Zoe chose him out of the dozens of little balls of fluff snuggled up together behind the glass at the pet shop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97dd8ea6-0666-4ad3-94a4-83e4c2d97b35",
                        "source_entry_id": "321029dc-76d3-37c7-a8cf-e6f4d9595706",
                        "source_sense_id": "9e41a1f1-30cf-3ab8-b14f-a660c00babb9",
                        "target_lang_word": "cuddle up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuddle up",
