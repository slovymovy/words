                    },
                    {
                        "sense_id": "34fd404e-f122-3d20-9ad7-453031365020",
                        "entry_id": "6fe111ea-c480-3a4e-b2e4-822e6838866e",
                        "glosses": [
                            "ontbreken van regelmaat",
                            "toestand waarin regels ontbreken of niet worden nageleefd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ead1df8-8698-454d-be53-0f0c5c290f4d",
                                "sense_id": "34fd404e-f122-3d20-9ad7-453031365020",
                                "text": "Er heerst momenteel een wanorde in het verkeer."
                            }
                        ]
                    },
                    {
                        "sense_id": "2fc1f23b-3f99-326b-8870-866ff41445aa",
                        "entry_id": "6fe111ea-c480-3a4e-b2e4-822e6838866e",
                        "glosses": [
                            "ontbreken van regelmaat",
                            "onoverzichtelijkheid doordat iets niet stelselmatig tot stand komt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9060ec74-caa8-4da7-b02c-0fa9d88fdc54",
                                "sense_id": "2fc1f23b-3f99-326b-8870-866ff41445aa",
                                "text": "De boekhouding van dat bedrijf is verwaarloosd, het is daar een administratieve wanorde."
                            }
                        ]
                    },
                    {
                        "sense_id": "face89b7-0b2a-3946-afa7-bbe63da2e094",
                        "entry_id": "6fe111ea-c480-3a4e-b2e4-822e6838866e",
                        "glosses": [
                            "ontbreken van regelmaat",
                            "ontbreken van samenhang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f603a00b-ea1f-47f2-91cc-5622bee37cbe",
                                "sense_id": "face89b7-0b2a-3946-afa7-bbe63da2e094",
                                "text": "Door alle ruzies heerst er wanorde in het bestuur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a92b9a70-71ae-497b-af57-0fa9263fabe5",
                        "source_entry_id": "6fe111ea-c480-3a4e-b2e4-822e6838866e",
                        "source_sense_id": "43efd80d-8439-3d53-bd98-3de7d780df12",
                        "source_sense_description": "een ongeregelde toestand met gebrek aan orde",
                        "target_lang_word": "Unordnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unordnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a24ffdf2-0a58-3c2d-a2ac-e25c063e5d59",
                                        "entry_id": "95c484d8-8a39-3f61-9af9-e0906b9b9cfb",
                                        "glosses": [
                                            "eine Situation, die sich durch das Fehlen von Ordnung auszeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c55456a-6a84-4a6e-b29a-791e321575e7",
                                                "sense_id": "a24ffdf2-0a58-3c2d-a2ac-e25c063e5d59",
                                                "text": "Mach nicht soviel Unordnung!"
                                            },
                                            {
                                                "example_id": "5ce9f4ba-9228-4928-a5da-4e2395b8b097",
                                                "sense_id": "a24ffdf2-0a58-3c2d-a2ac-e25c063e5d59",
                                                "text": "„Sex ist das, was unser normalerweise geordnetes Leben in Unordnung bringt.“"
                                            },
                                            {
                                                "example_id": "f57fc518-cf6e-4208-8b6d-59981512ee34",
                                                "sense_id": "a24ffdf2-0a58-3c2d-a2ac-e25c063e5d59",
                                                "text": "„Es war schon ein kleiner Schreck, der Toms Gedanken für Momente in Unordnung brachte.“"
                                            },
                                            {
                                                "example_id": "03fe5094-06b8-4269-bcd4-3f337e457dd6",
                                                "sense_id": "a24ffdf2-0a58-3c2d-a2ac-e25c063e5d59",
                                                "text": "„Dieses Gesetz hat zur Folge, daß die Welt immer in Unordnung und Unwissenheit bleiben wird, denn auf hundert Leute kommt höchstens ein Kluger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19cf80a4-d08a-474f-bf5e-36beb949c262",
                        "source_entry_id": "6fe111ea-c480-3a4e-b2e4-822e6838866e",
                        "source_sense_id": "43efd80d-8439-3d53-bd98-3de7d780df12",
                        "source_sense_description": "een ongeregelde toestand met gebrek aan orde",
                        "target_lang_word": "disorder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disorder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a558fdf-cc99-3bed-9c68-12d3c3018fae",
                                        "entry_id": "f63c5c02-4966-3e0a-ab60-0261cd4bd4b9",
                                        "glosses": [
                                            "Absence of order; state of not being arranged in an orderly manner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "537cfc2c-5f3f-44aa-af1e-3b8cc743f11a",
                                                "sense_id": "7a558fdf-cc99-3bed-9c68-12d3c3018fae",
                                                "text": "After playing the children left the room in disorder."
                                            },
                                            {
                                                "example_id": "a3e3c519-b349-45f2-9502-38edc0cb664a",
                                                "sense_id": "7a558fdf-cc99-3bed-9c68-12d3c3018fae",
                                                "text": "It was a household in permanent and benevolent disorder, pervaded by the gentle thrill of religious persecution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40085675-362c-3f46-ae02-36719c9502b2",
                                        "entry_id": "f63c5c02-4966-3e0a-ab60-0261cd4bd4b9",
                                        "glosses": [
                                            "A disturbance of civic peace or of public order."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eebfd0c-cf3a-49ce-a2ba-8e1ca6adabac",
                                                "sense_id": "40085675-362c-3f46-ae02-36719c9502b2",
                                                "text": "The class was thrown into disorder when the teacher left the room"
                                            },
                                            {
                                                "example_id": "d742fd95-a8b9-49b9-b5c6-d29eb28b29b8",
                                                "sense_id": "40085675-362c-3f46-ae02-36719c9502b2",
                                                "text": "The army tried to prevent disorder when claims the elections had been rigged grew stronger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe077f4c-93a0-32bc-b485-da8f2fb8b342",
                                        "entry_id": "f63c5c02-4966-3e0a-ab60-0261cd4bd4b9",
                                        "glosses": [
                                            "A physical or mental malfunction."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2b401f1-7249-42d2-bc7a-bd2704b35045",
                                                "sense_id": "fe077f4c-93a0-32bc-b485-da8f2fb8b342",
                                                "text": "Bulimia is an eating disorder."
                                            },
                                            {
                                                "example_id": "13afa5e8-82f1-4827-96ae-b76201dd10f9",
                                                "sense_id": "fe077f4c-93a0-32bc-b485-da8f2fb8b342",
                                                "text": "A very rare polymorphism in the prion protein gene recently has been identified that appears to protect against prion disease; this finding, in addition to providing greater understanding of the prionlike mechanisms of neurodegenerative disorders, might lead to potential treatments."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disorder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "939f5ba3-54fd-3774-9f95-0a57d68b83fb",
                                        "entry_id": "8922cd39-a4af-3ffc-970f-ace54243ac3b",
                                        "glosses": [
                                            "To throw into a state of disorder."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c15a7095-3f75-37b2-a9a1-ad086798ac6f",
                                        "entry_id": "8922cd39-a4af-3ffc-970f-ace54243ac3b",
                                        "glosses": [
                                            "To knock out of order or sequence."
                                        ],
