                ],
                "translations": [
                    {
                        "translation_id": "a6d2e0fa-2e8a-4832-b280-ffe924c6e546",
                        "source_entry_id": "cc159aa0-56fb-30df-a879-44e8f3f52a44",
                        "source_sense_id": "744cafa4-67fb-3bdc-a9d4-9ff4fbb47f50",
                        "source_sense_description": "het proces van het weer gezond worden",
                        "target_lang_word": "Genesung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genesung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c172958-2274-3eaf-a119-084d8289699c",
                                        "entry_id": "76f60300-dff5-3036-9be4-6f7bccbe23ad",
                                        "glosses": [
                                            "Wiederherstellung der Gesundheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b19974b-2fdc-486e-9348-0b1ba0356088",
                                                "sense_id": "8c172958-2274-3eaf-a119-084d8289699c",
                                                "text": "„Die Genesung von einer seelischen Erkrankung verläuft anders als bei den meisten körperlichen Leiden, mühsamer - ein allmähliches Herantasten an das gewohnte Leben.“"
                                            },
                                            {
                                                "example_id": "81f1df6e-f9e9-4e2b-9f43-95ff9246ff5e",
                                                "sense_id": "8c172958-2274-3eaf-a119-084d8289699c",
                                                "text": "„Gleich nach ihrer Genesung kehrte sie nach Paris zurück und meldete sich beim Deuxième Bureau, dem Auslandsgeheimdienst des französischen Militärs, der jetzt Leute brauchte, die im besetzten Deutschland eingesetzt werden konnten.“"
                                            },
                                            {
                                                "example_id": "dc84f313-785e-47ef-a5a8-2e8213dfda61",
                                                "sense_id": "8c172958-2274-3eaf-a119-084d8289699c",
                                                "text": "„Die führten sie einem Veterinär vor und ließen ihn prüfen, ob eine schnelle Genesung zu erwarten sei.“"
                                            },
                                            {
                                                "example_id": "53784b11-c77d-4d74-bc06-fd00e000792a",
                                                "sense_id": "8c172958-2274-3eaf-a119-084d8289699c",
                                                "text": "„Nach ihrer Genesung besucht die Familie 1923 München.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
