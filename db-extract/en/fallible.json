                        "source_entry_id": "2c74cb90-ee2c-3bc8-a413-9d79c2a983a3",
                        "source_sense_id": "93083d07-9ba4-30ae-92a1-0ec21dfc9e33",
                        "source_sense_description": "capable of making mistakes or being wrong",
                        "target_lang_word": "faillible",
                        "target_lang_code": "fr",
