                        ]
                    },
                    {
                        "translation_id": "023b9702-247f-48e5-94c9-4b4bc35b9819",
                        "source_entry_id": "fcfdb867-9878-3559-8804-11f51c55bf3c",
                        "source_sense_id": "e9256824-e4e1-3439-a5f8-d216f4abb95e",
                        "target_lang_word": "Beinhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beinhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5cd003b4-a340-3224-871c-b37efe776f13",
                                        "entry_id": "ecc9dde0-8d0f-3f09-99bc-0635bbe16615",
                                        "glosses": [
                                            "ein kapellenartiger Bau auf Friedhöfen, in dem bei der Anlage von neuen Gräbern gefundene Gebeine untergebracht werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b72fadee-e23e-4531-a566-7d805b0796ff",
                                                "sense_id": "5cd003b4-a340-3224-871c-b37efe776f13",
                                                "text": "„Mit der Jahrhundertwende zum 20. Jahrhundert kamen Beinhäuser immer mehr aus der Mode. Viele wurden abgebrochen oder zweckentfremdet, …“"
                                            },
                                            {
                                                "example_id": "3ff32b47-a5fd-47b3-9bb5-c0cacc653f0a",
                                                "sense_id": "5cd003b4-a340-3224-871c-b37efe776f13",
                                                "text": "„In Süddeutschland versah man außerdem die im Beinhaus aufbewahrten Schädel mit Hausmarken.“"
                                            },
                                            {
                                                "example_id": "2b099146-80cc-42f0-baf6-3ad90317485a",
                                                "sense_id": "5cd003b4-a340-3224-871c-b37efe776f13",
                                                "text": "„Das erinnert an die gruseligen Schilderungen von Menschenopfern der römischen Autoren, man darf aber nicht vergessen, dass noch im Mittelalter Tote in vielen Gegenden Europas in Grüften und Beinhäusern, sogenannten Ossuarien, ausgestellt waren.“"
                                            },
                                            {
                                                "example_id": "ce8eb471-f3ba-4065-b3a5-3a5f86f95a4e",
                                                "sense_id": "5cd003b4-a340-3224-871c-b37efe776f13",
                                                "text": "„Warren schüttelte mir noch die Hand, schlang die Kabelrolle über die Schulter und verschwand in diesem unbeschreiblichen Beinhaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
