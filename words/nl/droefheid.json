    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7acc5286-4bd0-3de0-b700-62b3daa5e1ad",
                    "sense_definition": "Het gevoel van verdriet of neerslachtigheid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het horen van het slechte nieuws was de <w>droefheid</w> op haar gezicht duidelijk te lezen.",
                            "target_lang_translations": {
                                "en": "After hearing the bad news, the <w>sadness</w> on her face was plain to see."
                            }
                        },
                        {
                            "text": "Zij probeerde haar <w>diepe droefheid</w> te verbergen voor haar kinderen.",
                            "target_lang_translations": {
                                "en": "She tried to hide her <w>deep sorrow</w> from her children."
                            }
                        }
                    ],
                    "synonyms": [
                        "verdriet",
                        "treurigheid",
                        "neerslachtigheid",
                        "rouw"
                    ],
                    "antonyms": [
                        "vreugde",
                        "blijdschap"
                    ],
                    "common_phrases": [
                        "diepe droefheid",
                        "droefheid uiten"
                    ],
                    "target_lang_definitions": {
                        "en": "The feeling of sorrow, grief, or dejection"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sadness",
                                "target_lang_sense_clarification": "the state or emotion of being sad"
                            },
                            {
                                "target_lang_word": "sorrow",
                                "target_lang_sense_clarification": "deep distress caused by loss or disappointment"
                            },
                            {
                                "target_lang_word": "grief",
                                "target_lang_sense_clarification": "intense sorrow, especially caused by someone's death"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec46d59b-5a8d-3830-8bdc-093996fbe3ff",
                    "sense_definition": "De mate waarin iemand of iets droef of triest is",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>droefheid</w> was groot toen onze hond overleed.",
                            "target_lang_translations": {
                                "en": "The <w>grief</w> was great when our dog passed away."
                            }
                        },
                        {
                            "text": "De film bracht de <w>droefheid</w> van de oorlogssituatie heel realistisch in beeld.",
                            "target_lang_translations": {
                                "en": "The film portrayed the <w>sadness</w> of the war situation very realistically."
                            }
                        }
                    ],
                    "synonyms": [
                        "triestheid"
                    ],
                    "common_phrases": [
                        "grote droefheid"
                    ],
                    "target_lang_definitions": {
                        "en": "The degree to which someone or something is sad, sorrowful, or tragic"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sadness",
                                "target_lang_sense_clarification": "the quality of being sad or tragic"
                            },
                            {
                                "target_lang_word": "sorrow",
                                "target_lang_sense_clarification": "the feeling or expression of deep distress"
                            }
                        ]
                    }
                }
            ]
        }
    ]
