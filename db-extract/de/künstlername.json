                ],
                "senses": [
                    {
                        "sense_id": "aaeaded4-d14d-3d1c-a90e-f10586e70c39",
                        "entry_id": "cbccd25b-9ed5-3e5a-af4b-d14463483609",
                        "glosses": [
                            "das Pseudonym des Künstlers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09cfc877-4abc-46c3-8e08-de302f2b4c82",
                                "sense_id": "aaeaded4-d14d-3d1c-a90e-f10586e70c39",
                                "text": "Brasiliens ehemaliger Fußballstar Edson Arantes do Nascimento trägt den Künstlernamen Pelé."
                            },
                            {
                                "example_id": "cf8b7c01-921a-4299-b6c7-f79777bfd106",
                                "sense_id": "aaeaded4-d14d-3d1c-a90e-f10586e70c39",
                                "text": "„»Doda« ist einer ihrer Kosenamen, »Elektroda« ein Künstlername, so wie wenn ich mich »Steffek Elektryczek« nennen würde.“"
                            },
                            {
                                "example_id": "af7ccf4f-8a4d-4188-bd10-e806318323ce",
                                "sense_id": "aaeaded4-d14d-3d1c-a90e-f10586e70c39",
                                "text": "„Die Künstlernamen illustrieren in dieser Reihenfolge gleichsam die Exekution und deren Folgen.“"
                            },
                            {
                                "example_id": "8881bd78-2014-4927-a224-770b690ad43e",
                                "sense_id": "aaeaded4-d14d-3d1c-a90e-f10586e70c39",
                                "text": "„Es ist ein Künstlername.“"
                            },
                            {
                                "example_id": "a6a8ae71-095a-4258-93de-5897598f5752",
                                "sense_id": "aaeaded4-d14d-3d1c-a90e-f10586e70c39",
                                "text": "„Denn bei der Wahl von Künstlernamen oder Namen von Serienhelden und anderen werden oft sehr sorgfältig Moden berücksichtigt, die sich gerade anbahnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "719ec555-76c3-4e1c-b9c5-374095625cc9",
                        "source_entry_id": "cbccd25b-9ed5-3e5a-af4b-d14463483609",
                        "source_sense_id": "aaeaded4-d14d-3d1c-a90e-f10586e70c39",
                        "source_sense_description": "das Pseudonym des Künstlers",
                        "target_lang_word": "pseudonym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pseudonym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee000544-c4d8-3efa-8b19-e55bec58342c",
                                        "entry_id": "414b124c-0bcb-3770-8c3f-ae55be4647b7",
                                        "glosses": [
                                            "A fictitious name (more literally, a false name), as those used by writers and movie stars."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "491912de-1006-4448-8d97-dcf97b34b737",
                                                "sense_id": "ee000544-c4d8-3efa-8b19-e55bec58342c",
                                                "text": "The Reverend Charles Lutwidge Dodgson wrote \"Alice's Adventures in Wonderland\" under the pseudonym Lewis Carroll."
                                            },
                                            {
                                                "example_id": "0d266c7d-35d0-4900-9f40-a32afbbd9242",
                                                "sense_id": "ee000544-c4d8-3efa-8b19-e55bec58342c",
                                                "text": "I doubt, indeed, whether I should not abandon the struggle altogether—leave this sad world of ordinary life for which I am so ill fitted, abandon the name of Cummins for some professional pseudonym, complete my self-effacement, and—a thing of tricks and tatters, of posing and pretence—go upon the stage."
                                            },
                                            {
                                                "example_id": "f1ae4c3b-5bbf-4388-a45a-ca36e34fe9a5",
                                                "sense_id": "ee000544-c4d8-3efa-8b19-e55bec58342c",
                                                "text": "The best example of its literary use so far are the German novel The Golem, by Gustav Meyrink, and the drama The Dybbuk, by the jewish writer using the pseudonym \"Ansky\"."
                                            },
                                            {
                                                "example_id": "da18c90a-caff-4ff9-a2e6-853d264e5bfe",
                                                "sense_id": "ee000544-c4d8-3efa-8b19-e55bec58342c",
                                                "text": "“I, at first, tried to say, ‘Well, maybe it was an accident. Maybe it got stuck in a printer.’ That was my first thought,” Parker, who requested to go by a pseudonym due to fear of retaliation, tells Them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91d6d2fb-e746-482e-bbea-cbc6d7d42416",
                        "source_entry_id": "cbccd25b-9ed5-3e5a-af4b-d14463483609",
                        "source_sense_id": "aaeaded4-d14d-3d1c-a90e-f10586e70c39",
                        "source_sense_description": "das Pseudonym des Künstlers",
                        "target_lang_word": "pen name",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pen name",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77af6f9a-83f8-3b10-8f05-4a9e2e1ce217",
                                        "entry_id": "c0b53464-0a37-3677-bc5e-6c61d7ebd05a",
                                        "glosses": [
                                            "A fictitious name used by an author in place of their actual name; a writer's pseudonym."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70ef409d-4fdd-448b-865d-5977f421cda0",
                                                "sense_id": "77af6f9a-83f8-3b10-8f05-4a9e2e1ce217",
                                                "text": "Within a week of King's acknowledging the Bachman pen name, several sources —publishers, book dealers, readers, and fans—had mentioned a number of possible other pseudonyms; obviously, if King admitted to two pen names, John Swithen and Richard Bachmann, there might be others."
                                            },
                                            {
                                                "example_id": "f6ad9138-d10a-4fea-ad7d-42846e7b8166",
                                                "sense_id": "77af6f9a-83f8-3b10-8f05-4a9e2e1ce217",
                                                "text": "In their time, it was fashionable to sign letters using a pen name. These pen names were borrowed from characters in classical literature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bffa0e19-9950-4e69-bf60-2b53b0ebd49e",
                        "source_entry_id": "cbccd25b-9ed5-3e5a-af4b-d14463483609",
                        "source_sense_id": "aaeaded4-d14d-3d1c-a90e-f10586e70c39",
                        "source_sense_description": "das Pseudonym des Künstlers",
                        "target_lang_word": "pseudonyme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pseudonyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2cacf1fe-c751-30c1-bdea-6ef2c4ca0e9f",
                                        "entry_id": "23089e25-bbb7-39a6-8094-096d6a640118",
                                        "glosses": [
                                            "Qui publie des livres ou des écrits sous un nom supposé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "158ea840-e637-4f9e-865b-37efb23586c4",
                                                "sense_id": "2cacf1fe-c751-30c1-bdea-6ef2c4ca0e9f",
                                                "text": "Ainsi, l’auteur pseudonyme ou anonyme, qui actuellement est protégé comme tous les autres et dont le droit d'auteur n'expirera que cinquante ans post mortem, désormais ne sera plus protégé que pour cinquante ans à dater de la publication."
                                            },
                                            {
                                                "example_id": "0428ea81-9d57-4e34-be61-56d577aa349e",
                                                "sense_id": "2cacf1fe-c751-30c1-bdea-6ef2c4ca0e9f",
                                                "text": "Je débitais un à un le chapelet de pseudonymes sonores et grandiloquents, chargés d'exprimer tout ce que je ressentais, tout ce que je voulais lui offrir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14bddf48-f7bd-3450-b01c-76af2b18c794",
                                        "entry_id": "23089e25-bbb7-39a6-8094-096d6a640118",
                                        "glosses": [
                                            "Qui est publié sous un nom supposé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54f54028-9fbf-477f-903d-c2e96625b27a",
                                                "sense_id": "14bddf48-f7bd-3450-b01c-76af2b18c794",
                                                "text": "La lecture du livre de 1888, et d'autres brochures sur divers sujets signées Ed. Pellis, me convainquit aisément que cet auteur n'avait pas simplement « édité » l'ouvrage pseudonyme de 1884. Bon nombre d'idées et d'expressions révélaient qu'il avait dû, au minimum, y collaborer."
                                            },
                                            {
                                                "example_id": "6c111b09-d276-488c-ac2a-a021609dd590",
                                                "sense_id": "14bddf48-f7bd-3450-b01c-76af2b18c794",
                                                "text": "Car si l'auteur des œuvres pseudonymes est devenu assez rapidement familier, on ignore beaucoup plus celui des quatre-vingt-sept Discours édifiants, rédigés du 16 mai 1843 au 7 août 1851 et publiés sous le nom de Magister Kierkegaard."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pseudonyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c5e2958-b1e5-320b-9bb2-197ba9ff0053",
                                        "entry_id": "935421dc-2465-30b8-98cc-fdfcd7fbcdec",
                                        "glosses": [
                                            "Nom choisi spécialement pour signer des œuvres ou des travaux ; nom d’artiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f5ce841-022b-480a-b329-f84dea752136",
                                                "sense_id": "6c5e2958-b1e5-320b-9bb2-197ba9ff0053",
                                                "text": "[…] sa maîtresse Hannaïs Dunois, plus connue sous le pseudonyme de Nane"
                                            },
                                            {
                                                "example_id": "2b7e7c3d-dd0e-45e4-b607-dadede525ddf",
                                                "sense_id": "6c5e2958-b1e5-320b-9bb2-197ba9ff0053",
                                                "text": "Il avait officiellement cessé de boire, ne s’autorisant que quelques vermouths sous un pseudonyme."
                                            },
                                            {
                                                "example_id": "312d4502-086f-48d6-a7ba-24ff05ef40e0",
                                                "sense_id": "6c5e2958-b1e5-320b-9bb2-197ba9ff0053",
                                                "text": "Le nom se compose tout d’abord du nom de famille, ensuite du prénom et, enfin, de ce que l’on appelle les accessoires du nom, pseudonyme, surnom et titres nobiliaires."
                                            },
                                            {
                                                "example_id": "4284e19d-7707-4069-a583-fd90bef37441",
                                                "sense_id": "6c5e2958-b1e5-320b-9bb2-197ba9ff0053",
                                                "text": "Dans le sillage de Milton Friedman, les « économistes » américains, et pas seulement américains, ont élevé l’argent — sous le pseudonyme rabâché de « marché » — au rang d’une autorité suprême et consciente."
                                            },
                                            {
                                                "example_id": "ef33fc29-d202-4d07-8235-ba2dbbc5b03e",
                                                "sense_id": "6c5e2958-b1e5-320b-9bb2-197ba9ff0053",
                                                "text": "Lanabellia est son pseudonyme. Vendeuse dans un magasin de la zone piétonne à Charleville-Mézières, elle écrit la nuit. Depuis quelques jours, son activité d’écriture est devenue pour l’administration fiscale, sa première activité."
                                            },
                                            {
                                                "example_id": "b2352ba5-c5a9-48c5-adcf-ceb08c660f4a",
                                                "sense_id": "6c5e2958-b1e5-320b-9bb2-197ba9ff0053",
                                                "text": "« L’emploi de masse n’est pas une option politiquement viable […] en clair : ce dont ce pays a besoin, pour mater cette bande d’écervelés, c’est d’une bonne dépression », écrit au début des années 1970 un chroniqueur économique qui s’autorise d’autant plus la provocation qu’il signe ses textes d’un nom d’emprunt – un pseudonyme révélateur : « Adam Smith.»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
