                            },
                            {
                                "example_id": "b695ab16-4d5a-4cf2-8ee5-f1a1af144b62",
                                "sense_id": "26fe44aa-b5d1-3b3e-8e5d-39738c83082c",
                                "text": "Eine Seifenblase platzt, wenn das Wasser des Seifenwasserfilmes verdunstet.",
