            "senses": [
                {
                    "sense_id": "6272d90f-f2b0-3d65-8e50-8fcf2fca1d42",
                    "sense_definition": "A person who can endure pain or hardship without showing feelings or complaining.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather was a <w>stoic</w> who never complained about his injury.          "
                        },
                        {
                            "text": "He tried to act like a <w>stoic</w> during the painful treatment.          "
                        }
                    ],
                    "common_phrases": [
                        "true stoic",
                        "be a stoic"
                    ]
                },
                {
                    "sense_id": "daa812fd-920b-33cd-b1d5-511347bcbf2e",
                    "sense_definition": "A follower or adherent of Stoicism, the ancient Greek philosophy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>stoic</w> taught that we should focus only on what we can control.          "
                        },
                        {
                            "text": "Marcus Aurelius was a famous Roman <w>stoic</w>.          "
                        }
                    ],
                    "common_phrases": [
