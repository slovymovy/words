                        "glosses": [
                            "De caractère bonasse."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "76ac5d12-46d1-4977-a0a9-99bf80c60b4d",
                                "sense_id": "04e4bc60-265d-3469-bd83-f020b417382a",
                                "text": "Les ouvriers employés à dresser les bois de justice dans la nuit s'étonnèrent de voir travailler avec eux, au feu des torches, deux compagnons venus on ne sait d'où, l'un souple et fier comme un bâtard de prince, la barbe en fourche, des yeux de pierreries, l'autre déjà courbé, l'air bonasson et endormi, deux longues cicatrices en rigole sur ses joues fripées."
                            }
                        ]
                    }
