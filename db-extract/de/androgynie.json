                        "entry_id": "2c4f86df-910c-399c-8ff7-9af5fd8b9c87",
                        "glosses": [
                            "Körper, in dem sowohl männliche als auch weibliche Merkmale vorkommen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1359ad78-8b46-355a-91f1-49d06f2e3557",
                        "entry_id": "2c4f86df-910c-399c-8ff7-9af5fd8b9c87",
                        "glosses": [
                            "Vereinigung männlicher und weiblicher Eigenschaften in einer Person; geschlechtliche Ausstrahlung, die weder (ausschließlich) männlich noch weiblich ist"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "96d83f5e-d907-480f-976b-4e1a944ff0c9",
                                "sense_id": "1359ad78-8b46-355a-91f1-49d06f2e3557",
                                "text": "„Die Kollektion spielte mit Androgynie, sie vereinte sinnlich-weibliche Elemente mit männlich-kriegerischen und verlieh der femininen Silhouette bisweilen kühle Dominanz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f932670-cb09-4e3b-ae64-cf315daf8f21",
                        "source_entry_id": "2c4f86df-910c-399c-8ff7-9af5fd8b9c87",
                        "source_sense_id": "5e4948a3-4ffd-3528-a63c-379edb9fc489",
                        "source_sense_description": "Biologie: Körper, in dem sowohl männliche als auch weibliche Merkmale vorkommen",
                        "target_lang_word": "androgyny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "androgyny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f849b07-d02a-3937-abf6-0454b882a4e7",
                                        "entry_id": "67cb4cbe-56fe-38e6-9854-cde516240771",
                                        "glosses": [
                                            "Hermaphroditism."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a95930e-5550-35bc-bf4d-f59416158954",
                                        "entry_id": "67cb4cbe-56fe-38e6-9854-cde516240771",
                                        "glosses": [
                                            "The state of having traits of both male and female genders."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d15b02c3-499f-4ca8-93ec-1e500bda7165",
                                                "sense_id": "3a95930e-5550-35bc-bf4d-f59416158954",
                                                "text": "Now androgyny has come to mean the adoption of social behavior that is not strictly masculine or feminine according to the old role definitions. An attempt to escape from gender-identified role-playing, androgyny does not necessarily determine sexual behavior."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e2ffc32-c59b-3a5a-a801-045ea6f629cc",
                                        "entry_id": "67cb4cbe-56fe-38e6-9854-cde516240771",
                                        "glosses": [
                                            "The state of appearing to be neither feminine nor masculine."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6c13f8c-2fb4-46a6-86dd-d0035c1df6f8",
                                                "sense_id": "1e2ffc32-c59b-3a5a-a801-045ea6f629cc",
                                                "text": "The plot isn't the film's greatest asset, nor are its insights into Margaret, Larry and the brave new world of affectless androgyny that they inhabit."
                                            },
                                            {
                                                "example_id": "3959432b-ff89-49a7-8835-6bd479ad7df0",
                                                "sense_id": "1e2ffc32-c59b-3a5a-a801-045ea6f629cc",
                                                "text": "‘No, I like short hair on girls. I like that androgyny thing. Seriously.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bed16fc-5338-3b33-8b8c-e240ed8e5537",
                                        "entry_id": "67cb4cbe-56fe-38e6-9854-cde516240771",
                                        "glosses": [
                                            "The state or ability, of a connector or docking port, to connect with either male (plug) or female (socket) or other neutral connectors or ports."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "720f5ffd-214e-4aeb-9047-24cecb73bafb",
                                                "sense_id": "0bed16fc-5338-3b33-8b8c-e240ed8e5537",
                                                "text": "[…] it is obvious that the idea of androgyny of docking/berthing interfaces […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
