                            {
                                "example_id": "831fd278-5faa-4ad4-8cba-599d8ee52c20",
                                "sense_id": "549bf0e5-46b7-354e-83a4-e7d95b9cbcfc",
                                "text": "Er zeichnet sich durch eine besondere Menschenfreundlichkeit aus."
                            },
                            {
                                "example_id": "b470ad39-2593-452c-a492-59d5e4c4ed1c",
                                "sense_id": "549bf0e5-46b7-354e-83a4-e7d95b9cbcfc",
                                "text": "„In Graebendorf, unweit von Dobrow, bezog er bei einem weitläufigen Bekannten Quartier, dem Maurer Schiepan, den entweder die Aufklärung oder die Nächstenliebe zu dieser Menschenfreundlichkeit bewegte.“"
                            }
