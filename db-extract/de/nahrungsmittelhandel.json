                "senses": [
                    {
                        "sense_id": "5a2f52c1-313c-3154-aa1c-616337b8ce7b",
                        "entry_id": "28f371aa-ea3d-307b-84cd-2dca1dc2adbd",
                        "glosses": [
                            "Kauf oder Verkauf von Nahrungsmitteln (als Wirtschaftszweig)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2edb643-5d5b-4f73-8ebd-b37b8889935a",
                                "sense_id": "5a2f52c1-313c-3154-aa1c-616337b8ce7b",
                                "text": "„Der weltweite Nahrungsmittelhandel hat einen riesigen Markt für Fleisch geschaffen.“"
                            },
                            {
                                "example_id": "ab0b0532-354d-44b9-bb0a-91012f2b6ebf",
                                "sense_id": "5a2f52c1-313c-3154-aa1c-616337b8ce7b",
                                "text": "„Würde die Grenzschließung den Nahrungsmittelhandel einschränken, sodass Lebensmittelpreise nach oben schießen und es zu Unruhen kommen wird?“"
                            },
                            {
                                "example_id": "59d4b4da-2b84-4463-8c7f-538be868670e",
                                "sense_id": "5a2f52c1-313c-3154-aa1c-616337b8ce7b",
                                "text": "„Dies gilt besonders für den Nahrungsmittelhandel, der nach wie vor den stärksten Gewerbezweig innerhalb des Einzelhandels ausmachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
