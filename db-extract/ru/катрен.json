                    {
                        "translation_id": "18c7a96b-724f-4fa7-b19f-99b7ea5ec54b",
                        "source_entry_id": "b200f3c9-299e-32bf-b0f7-de0ab3a279ad",
                        "source_sense_id": "66fdbdb1-194e-3671-9410-c85e5536dd2e",
                        "target_lang_word": "quatrain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quatrain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab2e0b0b-d7c5-37a9-abef-24afa1f796ef",
                                        "entry_id": "8d36768d-522c-3226-84e9-cb82617f40e6",
                                        "glosses": [
                                            "Pièce de poésie qui contient quatre vers, dont les rimes sont ordinairement croisées."
                                        ],
                                        "tags": [
                                            "Versification"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95c30ea1-f6da-4c77-af6f-b97fafde0e25",
                                                "sense_id": "ab2e0b0b-d7c5-37a9-abef-24afa1f796ef",
                                                "text": "Les quatrains de Pibrac."
                                            },
                                            {
                                                "example_id": "bde7787a-1647-4f44-b182-3bb7660d2c4c",
                                                "sense_id": "ab2e0b0b-d7c5-37a9-abef-24afa1f796ef",
                                                "text": "Il avait même composé un quatrain pour l’écrire dessous en spirale, un quatrain didactique et moral. Il ne voulait plus écrire que dans le style des commandements de Dieu mis en vers français. Les quatre vers étaient de cette simple et bonne sorte."
                                            },
                                            {
                                                "example_id": "9468081d-4809-498b-a904-8baca7b944c4",
                                                "sense_id": "ab2e0b0b-d7c5-37a9-abef-24afa1f796ef",
                                                "text": "Je voulais faire un quatrain sur un mouton à cinq pattes... Mais j'avais toujours un pied de trop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2718aed2-4afe-3fa9-b848-bfafc18b0b94",
                                        "entry_id": "8d36768d-522c-3226-84e9-cb82617f40e6",
                                        "glosses": [
                                            "Quatre vers qui font partie d’un sonnet, d’une stance, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34fe3a18-04ac-4c5e-b6d5-4bd614e59911",
                                                "sense_id": "2718aed2-4afe-3fa9-b848-bfafc18b0b94",
                                                "text": "Le sonnet est composé de deux quatrains et de deux tercets."
                                            },
                                            {
                                                "example_id": "ff8a685d-cf23-4107-97e2-c97598134190",
                                                "sense_id": "2718aed2-4afe-3fa9-b848-bfafc18b0b94",
                                                "text": "Cette stance est formée d’un quatrain et de deux tercets."
                                            },
                                            {
                                                "example_id": "fb0e3738-3f92-41ee-b87a-501a0a97f958",
                                                "sense_id": "2718aed2-4afe-3fa9-b848-bfafc18b0b94",
                                                "text": "Cette ode est composée de quatrains."
                                            }
                                        ]
                                    }
                                ]
                            }
