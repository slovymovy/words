                ],
                "senses": [
                    {
                        "sense_id": "2a4c5297-8cb8-351a-ac98-7b775567cf50",
                        "entry_id": "70a1c1e9-7695-3246-940d-fcbccfc2a6bf",
                        "glosses": [
                            "Tragebehälter aus Plastik, in dem Wasserflaschen gekauft und transportiert werden, der mit (vollen) Wasserflaschen gefüllte Kasten"
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "da9fb9b0-59ac-4b5b-97f3-ed42ff684286",
                                "sense_id": "2a4c5297-8cb8-351a-ac98-7b775567cf50",
                                "text": "„Viele kaufen mehr Wasserkisten als sonst, so dass es in den Getränkemärkten in der Region bei bestimmten Marken zeitweise zu Engpässen kommt.“"
                            },
                            {
                                "example_id": "33ae01b0-bbdf-4343-8547-7f07c1d763da",
                                "sense_id": "2a4c5297-8cb8-351a-ac98-7b775567cf50",
                                "text": "„»Bringe die Wasserkiste vom Auto in den Keller«“"
                            },
                            {
                                "example_id": "6a3700ce-c69b-404b-b0bd-c6b82ef38474",
                                "sense_id": "2a4c5297-8cb8-351a-ac98-7b775567cf50",
                                "text": "„Eine Apfelsaftkiste hat folgende Maße: 29 cm × 22 cm × 34 cm; eine Wasserkiste misst 35 cm × 27 cm × 35 cm. Simons Eltern wollen einen Kofferraum voll Apfelsaft und einen Kofferraum voll Wasser besorgen.“"
                            },
                            {
                                "example_id": "da0221eb-079e-4a0b-a195-1490ef248da5",
                                "sense_id": "2a4c5297-8cb8-351a-ac98-7b775567cf50",
                                "text": "„Du holst jetzt noch die Wasserkisten aus dem Transporter und danach bleibst du hier um die Neulinge zu versorgen!“"
                            },
                            {
                                "example_id": "2275614a-8688-4e8b-b744-df2e212be3c7",
                                "sense_id": "2a4c5297-8cb8-351a-ac98-7b775567cf50",
                                "text": "„Wir haben ja schon festgestellt, dass die Häuser hier zwar sehr ansehnlich sind, der Platz drumherum aber doch sehr begrenzt ist. Und für jede Wasserkiste erst einmal die Straße langlaufen zu müssen, ist auch nicht gerade ein Vergnügen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
