                        "sense_id": "65bcc2b5-aa66-34e0-be24-04777e650845",
                        "entry_id": "a2f35c1a-d404-3b5d-99eb-360ae0760749",
                        "glosses": [
                            "Action de fouler du raisin soit avec les pieds, soit avec du matériel spécialisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7c5e685-d282-4cbc-beaf-028639b92edc",
                                "sense_id": "65bcc2b5-aa66-34e0-be24-04777e650845",
                                "text": "Les fouleries sont parfois trop froides, il faut les échauffer en y faisant du feu."
                            },
                            {
                                "example_id": "5861bb0d-d3aa-4b47-a6ca-d62ebe6e89a0",
                                "sense_id": "65bcc2b5-aa66-34e0-be24-04777e650845",
                                "text": "Il trouve l'effet de la foulerie parfait lorsque les cylindres sont placés dans un parallélisme exact et juste à la distance requise pour que les grains de raisins mûrs ne puissent passer sans être écrasés, tandis que la grappe elle même reste intacte."
                            }
                        ]
