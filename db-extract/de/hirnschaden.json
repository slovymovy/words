                "senses": [
                    {
                        "sense_id": "79c23670-0f33-3586-81f0-3812d14ba5b4",
                        "entry_id": "4ab687ad-0b3b-3dbd-9e7d-ae6d4370ce41",
                        "glosses": [
                            "funktionelle Einschränkung des Gehirns, diese kann ausgelöst werden durch verschiedene Ursachen, beispielsweise Gewalteinwirkung (wie bei einem Unfall), einer Krankheit (wie bei einem Schlaganfall, einem Herzinfarkt, einem Hirntumor), Ersticken, Ertrinken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e66e2d01-2a4d-4206-866b-d9518559f46f",
                                "sense_id": "79c23670-0f33-3586-81f0-3812d14ba5b4",
                                "text": "Demenz geht immer mit Hirnschäden einher."
                            },
                            {
                                "example_id": "558fb707-c27a-4af5-b16f-c650cfc51eb4",
                                "sense_id": "79c23670-0f33-3586-81f0-3812d14ba5b4",
                                "text": "Alkohol in der Schwangerschaft kann ein Grund für frühkindliche Hirnschäden sein."
                            },
                            {
                                "example_id": "84f56b12-3b09-4603-b3cf-70da7c3e62f5",
                                "sense_id": "79c23670-0f33-3586-81f0-3812d14ba5b4",
                                "text": "„Der Junge kam […] vor drei Jahren mit einem schweren Hirnschaden zur Welt.“"
                            },
                            {
                                "example_id": "0083f1ac-d489-40f3-b93e-687acc82e909",
                                "sense_id": "79c23670-0f33-3586-81f0-3812d14ba5b4",
                                "text": "Da das Gehirn keinen Zucker speichern kann, aber unbedingt darauf angewiesen ist, führen schon Störungen der Glucoszufuhr von wenigen Minuten zu schweren Hirnschäden."
                            },
                            {
                                "example_id": "7be55df4-bbe1-46fa-bc76-67d6e8be8820",
                                "sense_id": "79c23670-0f33-3586-81f0-3812d14ba5b4",
                                "text": "„[…] Blei aus den Auspuffgasen kann bei der Aufnahme durch den Menschen im schlimmsten Fall zu Hirnschäden führen.“"
                            },
                            {
                                "example_id": "702e7662-a450-4dc6-b2e5-fac62f972da6",
                                "sense_id": "79c23670-0f33-3586-81f0-3812d14ba5b4",
                                "text": "„[…] bei kleinen Kindern und Babys kann ein Vitamin-B-12-Mangel sogar zu bleibenden Hirnschäden führen.“"
                            },
                            {
                                "example_id": "0cab01e8-83bd-4256-a70a-a4765e480c1d",
                                "sense_id": "79c23670-0f33-3586-81f0-3812d14ba5b4",
                                "text": "„In einer Patientenverfügung wird festgelegt, was medizinisch unternommen werden soll, wenn sich der Betroffene nicht mehr äußern kann - wenn er im Koma liegt oder nach einem Schlaganfall einen Hirnschaden erlitten hat.“"
                            },
                            {
                                "example_id": "c5e58d1b-a7b6-44b9-9f0f-bbb469da7e51",
                                "sense_id": "79c23670-0f33-3586-81f0-3812d14ba5b4",
                                "text": "„[…] Bei einer Schlägerei […] rammt ein junger Mann seinem Gegner einen Schraubenzieher acht Zentimeter tief in den Kopf. Das Opfer erleidet einen Hirnschaden und wird sich nie mehr ganz davon erholen.“"
                            },
                            {
                                "example_id": "3ec159a6-555a-4afd-a759-705041fef2d6",
                                "sense_id": "79c23670-0f33-3586-81f0-3812d14ba5b4",
                                "text": "„Britische Neurologen haben jetzt schockierende Einzelheiten in der Zeitschrift \"Brain\" veröffentlicht, wonach SARS-CoV-2 selbst bei Patienten mit leichten Symptomen oder bei bereits Genesenen schwerwiegende Hirnschäden verursachen kann. […] Ähnliche Spätfolgen gab es laut Studie auch nach der verheerenden Spanischen Grippe 1918, bei der vermutlich bis zu einer Million Menschen Hirnschäden davon getragen haben.“"
                            },
                            {
                                "example_id": "6f160592-6c8f-4e81-9bd9-80c937bbb44f",
                                "sense_id": "79c23670-0f33-3586-81f0-3812d14ba5b4",
                                "text": "[Boxen:] „Dadaschew hatte am Freitag gegen Subriel Matias aus Puerto Rico schwere Treffer hinnehmen müssen, so dass sein Trainer zum Ende der 11. Runde das Handtuch zum Zeichen der Aufgabe warf. Danach wurde der Boxer auf einer Trage aus dem Ring gebracht. Bei ihm wurde ein schwerer Hirnschaden diagnostiziert.“"
                            },
                            {
                                "example_id": "6e514d0f-8340-4731-a53f-3d7e269b14fe",
                                "sense_id": "79c23670-0f33-3586-81f0-3812d14ba5b4",
                                "text": "[Fußball:] „Um mögliche Hirnschäden früher zu erkennen, müssen sich alle Profis der 36 Erst- und Zweitligaklubs zukünftig jährlich einem Gehirntest unterziehen.“"
                            },
                            {
                                "example_id": "e8031b2c-6b33-42ea-bb76-eff43319079c",
                                "sense_id": "79c23670-0f33-3586-81f0-3812d14ba5b4",
                                "text": "„Soll Charlie Gard weiterleben? Der britische Junge hat irreparable Hirnschäden. Ärzte und Gerichte wollen die Maschinen abstellen, die Eltern nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
