                    "sense_id": "90dfaa5b-1a49-3d64-97d3-3ae2f602718e",
                    "sense_definition": "To transform the outward appearance of something, often giving it a more spiritual, beautiful, or elevated form.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transform",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden smile seemed to <w>transfigure</w> her whole face, making her look years younger."
                        },
                        {
                            "text": "The golden morning light began to <w>transfigure</w> the quiet valley into a magical landscape."
                        }
                    ],
                    "synonyms": [
