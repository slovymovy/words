                        "examples": [
                            {
                                "example_id": "ce7babfd-66b2-4909-950e-387d45449a09",
                                "sense_id": "30561a33-9e15-30bf-8303-1d83054b3cfd",
                                "text": "„Das Schmerzmittel, die Blutkonserven und das Zuckerwasser brachten nicht nur seinen Körper auf Vordermann, sondern machten ihn auch optimistischer.“"
                            },
                            {
                                "example_id": "d57a8a2e-39c6-40a4-b2d3-6c4700630f3a",
                                "sense_id": "30561a33-9e15-30bf-8303-1d83054b3cfd",
                                "text": "„Er weckte ihn immer wieder, um ihm das Zuckerwasser einzuflößen, und die trockene Kehle des Jungen arbeitete heftig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
