                ],
                "senses": [
                    {
                        "sense_id": "2c77ae06-e105-3221-8af2-51dc1eeb90da",
                        "entry_id": "fd4616b9-c396-323b-b282-a71b22038c9b",
                        "glosses": [
                            "Paramètre de distribution a priori, dans les statistiques bayésiennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f11891ea-eb22-42dc-8d24-186644fcb5a1",
                                "sense_id": "2c77ae06-e105-3221-8af2-51dc1eeb90da",
                                "text": "Un hyperparamètre est un paramètre de l’algorithme d’apprentissage (et non du modèle): de ce fait, il n’est pas affecté par l’algorithme d’apprentissage lui-même, il doit être défini avant l’apprentissage et reste constant au cours de celui-ci."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d6533c3-92f3-444f-b996-c8d5867cb3a0",
                        "source_entry_id": "fd4616b9-c396-323b-b282-a71b22038c9b",
                        "source_sense_id": "2c77ae06-e105-3221-8af2-51dc1eeb90da",
                        "target_lang_word": "hyperparameter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperparameter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d08cd36-6233-3c7d-b504-7726d3882676",
                                        "entry_id": "3882656e-6bdb-373f-9bc3-b49a9db57612",
                                        "glosses": [
                                            "A parameter of a prior (as distinguished from inferred parameters of the model for the underlying system under analysis)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afa2034d-00b9-4493-a3cc-fe6eb0f89d71",
                                                "sense_id": "9d08cd36-6233-3c7d-b504-7726d3882676",
                                                "text": "this model has four hyperparameters"
                                            },
                                            {
                                                "example_id": "0801ade0-af8b-446e-b199-2bbb6bb6f918",
                                                "sense_id": "9d08cd36-6233-3c7d-b504-7726d3882676",
                                                "text": "The exact interpretation of these hyperparameters becomes clearer once you have seen their role in the posterior and, hence, we defer a deeper discussion of prior elicitation until the next section."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a77eedbe-2b17-399b-8c3a-8bdd035cb467",
                                        "entry_id": "3882656e-6bdb-373f-9bc3-b49a9db57612",
                                        "glosses": [
                                            "A parameter whose value is set before the learning process begins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bcfcf9c-239e-497c-8c26-1482dfba3ccb",
                                                "sense_id": "a77eedbe-2b17-399b-8c3a-8bdd035cb467",
                                                "text": "The ideal learning algorithm just takes a dataset and outputs a function, without requiring hand tuning of hyperparameters."
                                            },
                                            {
                                                "example_id": "6b5e07f1-903f-4b6a-a473-79b1c9e9bc22",
                                                "sense_id": "a77eedbe-2b17-399b-8c3a-8bdd035cb467",
                                                "text": "“Model behaviour is not determined by architecture, hyperparameters, or optimizer choices,” he said, referring to the technical difficulties of training a language model. “It’s determined by your dataset, nothing else. […]”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
