                    {
                        "sense_id": "29fdbd8a-e08a-3bd0-8d00-cdcc6e9d565e",
                        "entry_id": "b6509d87-54b1-3807-85e3-3e3e4977b660",
                        "glosses": [
                            "Qui contient de la codéine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73e0c78c-be9e-4a20-ae1e-b8a84ba3e4d1",
                                "sense_id": "29fdbd8a-e08a-3bd0-8d00-cdcc6e9d565e",
                                "text": "Le chien codéiné présente ses allures habituelles, tandis que le chien morphiné a la démarche hyénoïde, l'œil effaré ; il ne reconnaît personne."
                            },
                            {
                                "example_id": "23043504-877c-43a1-bbc0-51de4f5bfb3f",
                                "sense_id": "29fdbd8a-e08a-3bd0-8d00-cdcc6e9d565e",
                                "text": "Les opiacés comme le Migralgine, le Codoliprane, le Novacetol ou le Dafalgan codéiné - narcotiques qui contiennent un dérivé d'opium - sont en apparence des médicaments anodins."
                            },
                            {
                                "example_id": "5871b9a2-5b43-4211-be40-9b54a6a5649e",
                                "sense_id": "29fdbd8a-e08a-3bd0-8d00-cdcc6e9d565e",
                                "text": "La migraine se pointait, il devait réagir vite, sauter sur sa bonne vieille boîte codéinée sous peine de se retrouver en flaque d'huile sur son lit, bassine à portée de mains dans sa chambre close."
                            }
                        ]
                    }
