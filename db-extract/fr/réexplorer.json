                "senses": [
                    {
                        "sense_id": "9e6fb66a-f524-365d-9b2c-a02296dc5c67",
                        "entry_id": "6515ce4a-cb68-3404-b174-664d1ac78b8c",
                        "glosses": [
                            "Explorer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bf28409-37d2-4318-8b31-e3c05b2cb20c",
                                "sense_id": "9e6fb66a-f524-365d-9b2c-a02296dc5c67",
                                "text": "Mais tout est redite —les rapports humains ont été explorés, réexplorés, désexplorés, et pourtant nous réagissons toujours au grain de vérité que nous reconnaissons au cœur de ces situations lorsqu’elles nous sont présentées à l’écran."
                            },
                            {
                                "example_id": "8f86b19b-b92b-4c0a-b48d-934cf014cc6c",
                                "sense_id": "9e6fb66a-f524-365d-9b2c-a02296dc5c67",
                                "text": "En fait, dans ce paysage réexploré à rebours (« désexploré »), ne se présentaient que des confluents."
                            }
                        ]
                    }
