                "senses": [
                    {
                        "sense_id": "d8775ac7-c28f-3947-b033-5b4444da2ed3",
                        "entry_id": "253f2c1c-f1f6-3208-a5d4-298b3665d376",
                        "glosses": [
                            "Qui a la capacité de durcir et se solidifier sous certaines conditions, en parlant notamment de pâte ou pâte à modeler qui se solidifie après une exposition prolongée à l’air ambiant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98432d0d-7230-44ea-afb2-7d9fc57774fa",
                                "sense_id": "d8775ac7-c28f-3947-b033-5b4444da2ed3",
                                "text": "Depuis quelques années, une nouvelle formule d’argile de modelage dite « autodurcissante » est disponible. Il s’agit d’une argile rouge ou transparente et malléable ; en refroidissant, il redevient blanc et extrêmement dur et résistant."
                            },
                            {
                                "example_id": "8fb0fb58-c380-4b7f-82d6-51075fc42819",
                                "sense_id": "d8775ac7-c28f-3947-b033-5b4444da2ed3",
                                "text": "Si nous employons un composite, il est indiqué d’isoler la paroi pulpaire par un matériau autodurcissant dont la composition est à base d’hydroxyde de calcium."
                            }
                        ]
                    }
