                ],
                "senses": [
                    {
                        "sense_id": "203003c1-367e-3481-9d89-71d5bd4e1690",
                        "entry_id": "94ec3400-801b-3103-bf56-fa6c4e44b27d",
                        "glosses": [
                            "bekoorlijk door landelijke eenvoud en liefelijkheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "218cd19c-05af-42b2-bf8e-bedd7b92345a",
                                "sense_id": "203003c1-367e-3481-9d89-71d5bd4e1690",
                                "text": "Zie je dat idyllische plekje daar?"
                            },
                            {
                                "example_id": "218dcae8-4205-4e93-8281-8f9ba0e2ab3d",
                                "sense_id": "203003c1-367e-3481-9d89-71d5bd4e1690",
                                "text": "De rit van Mulhouse naar La Planche des Belles Filles is er een om naar uit te kijken. De naam van de finishplek klinkt idyllisch, maar het is een gemene beklimming van 7 kilometer met een gemiddeld stijgingspercentage van 8,7 procent, en op het einde een onverharde sectie. Het klassement zal worden opgeschud."
                            },
                            {
                                "example_id": "a4eb1ba3-1dc8-4bc1-a5f1-f03e73d15e27",
                                "sense_id": "203003c1-367e-3481-9d89-71d5bd4e1690",
                                "text": "Hoe idyllisch het ook was, ik werd gek genoeg na een aantal uur weer onrustig. Goldie keek me verbaasd aan toen ik mijn rugzak opdeed. ‘Waarom die haast?’ Daar had ik geen antwoord op, maar ik vertrok."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1933b8fd-c863-4905-9416-a69426b7751c",
                        "source_entry_id": "94ec3400-801b-3103-bf56-fa6c4e44b27d",
                        "source_sense_id": "203003c1-367e-3481-9d89-71d5bd4e1690",
                        "source_sense_description": "bekoorlijk door landelijke eenvoud en liefelijkheid",
                        "target_lang_word": "idyllisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idyllisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5d28bc6-4c05-3355-af61-d53c0c164b75",
                                        "entry_id": "08305d4f-68c5-3379-b3d1-45a6acd82820",
                                        "glosses": [
                                            "Eigenschaften eines Idylls aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05cefe97-99c4-4a02-9e4d-a2fa5f1dee2b",
                                                "sense_id": "b5d28bc6-4c05-3355-af61-d53c0c164b75",
                                                "text": "„Es ist ein idyllischer Ort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3cee008-834b-4e84-91a6-6d3d3e331745",
                        "source_entry_id": "94ec3400-801b-3103-bf56-fa6c4e44b27d",
                        "source_sense_id": "203003c1-367e-3481-9d89-71d5bd4e1690",
                        "source_sense_description": "bekoorlijk door landelijke eenvoud en liefelijkheid",
                        "target_lang_word": "idyllic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idyllic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdc73d3d-3f58-39f9-9617-4a4299219262",
                                        "entry_id": "c556fb6c-a160-3e71-98a1-d322b7f60980",
                                        "glosses": [
                                            "Of or pertaining to idylls."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ebacaa8-f752-3c62-93ff-0d08a528ed31",
                                        "entry_id": "c556fb6c-a160-3e71-98a1-d322b7f60980",
                                        "glosses": [
                                            "Extremely happy, peaceful, or picturesque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47539575-2343-4b84-9d6f-4dc40282ee66",
                                                "sense_id": "7ebacaa8-f752-3c62-93ff-0d08a528ed31",
                                                "text": "My fellow-creatures, from whom I was thus separated, began to assume idyllic virtue and beauty in my memory."
                                            },
                                            {
                                                "example_id": "d787ea77-c717-42dd-8400-18fc3e03f990",
                                                "sense_id": "7ebacaa8-f752-3c62-93ff-0d08a528ed31",
                                                "text": "The rest of the road was as idyllic as the start."
                                            },
                                            {
                                                "example_id": "f5bdadf6-80d6-40cd-a112-97fa841f31e5",
                                                "sense_id": "7ebacaa8-f752-3c62-93ff-0d08a528ed31",
                                                "text": "I think I learned more from my family than they did from me in the brief idyllic time we spent together. None of them much more than a mile from home, they carried the aura of a close-knit community as a shield against against the unknown."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "idyllic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d332074c-0ee5-3e8b-b48b-6872f2d39b1c",
                                        "entry_id": "d771e37b-44bc-313d-b86b-2ffb331b9173",
                                        "glosses": [
                                            "An idyllic state or situation. (A substantive use of the adjective)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "921ce62e-22e2-409e-ac90-94286dc03d0a",
                                                "sense_id": "d332074c-0ee5-3e8b-b48b-6872f2d39b1c",
                                                "text": "He could retire to the idyllic with the knowledge that he had not been wanting when Romance called."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fbeb3c5-9861-43fa-9bcd-f5a88d37aa8c",
                        "source_entry_id": "94ec3400-801b-3103-bf56-fa6c4e44b27d",
                        "source_sense_id": "203003c1-367e-3481-9d89-71d5bd4e1690",
                        "source_sense_description": "bekoorlijk door landelijke eenvoud en liefelijkheid",
                        "target_lang_word": "idyllique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idyllique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "321869ef-31fe-3e61-9b12-2f7e85dbafb2",
                                        "entry_id": "39a6e1c9-5d05-38c9-ae1d-c123fe40ff28",
                                        "glosses": [
                                            "Qui tient de l’idylle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29fa11db-bbad-4018-8a52-db590696891a",
                                                "sense_id": "321869ef-31fe-3e61-9b12-2f7e85dbafb2",
                                                "text": "En ce début d'automne 1793, on célèbre, à Genève, une fête simple et idyllique en l'honneur de Jean-Jacques Rousseau. Une blonde jeune fille représente Sophie et pose une couronne de roses sur le buste du grand homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acd277c8-976d-3db7-a079-aef9e04c65c0",
                                        "entry_id": "39a6e1c9-5d05-38c9-ae1d-c123fe40ff28",
                                        "glosses": [
                                            "Qui rappelle l’idylle par le décor champêtre, l’amour tendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c2bb273-ba00-4337-8376-f0d718310795",
                                                "sense_id": "acd277c8-976d-3db7-a079-aef9e04c65c0",
                                                "text": "Son vieux père se souvenait du Bun Hill comme d’un idyllique village."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecb68dbe-4ec8-35b0-8e47-97e8361b73f4",
                                        "entry_id": "39a6e1c9-5d05-38c9-ae1d-c123fe40ff28",
                                        "glosses": [
                                            "Qui relève du rêve."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6120447-23a7-48e4-a9a8-6e2ce00199f4",
                                                "sense_id": "ecb68dbe-4ec8-35b0-8e47-97e8361b73f4",
                                                "text": "L'abondante littérature idyllique des professeurs de rhétorique est évidem­ment une pure vanité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6080fa92-a5c6-3c08-b8c1-d2a7b2df985d",
                                        "entry_id": "39a6e1c9-5d05-38c9-ae1d-c123fe40ff28",
                                        "glosses": [
                                            "Idéal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bd9f7e6-b470-4cef-8cac-0057c9ff34b7",
                                                "sense_id": "6080fa92-a5c6-3c08-b8c1-d2a7b2df985d",
                                                "text": "Vous baignez dans un climat idyllique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
