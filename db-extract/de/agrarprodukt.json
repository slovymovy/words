                "senses": [
                    {
                        "sense_id": "a7e101b4-e254-3ae0-ba02-534608c703f0",
                        "entry_id": "4abdd808-bdd4-340b-a2b9-072d86352a83",
                        "glosses": [
                            "ein Erzeugnis, das von einem landwirtschaftlichen Betrieb produziert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d2e0db0-8475-4f96-914b-389a7b5dced9",
                                "sense_id": "a7e101b4-e254-3ae0-ba02-534608c703f0",
                                "text": "„Während die Inlandspreise für Agrarprodukte nicht einmal entsprechend der Peso-Inflation erhöht werden durften, blieb Argentinien den internationalen Wirtschafts-Organisationen fern, die Mangelgüter nach einem Preis verteilten, der auf dem USA-Heimatmarkt fußte.“"
                            },
                            {
                                "example_id": "b68c5be3-c871-4116-80e6-7299ff2ee077",
                                "sense_id": "a7e101b4-e254-3ae0-ba02-534608c703f0",
                                "text": "„Ein Agrarprodukt, dessen Anbau die EU vorher mit rund 500 Mill. Euro gefördert hat.“"
                            },
                            {
                                "example_id": "063fd2d9-b91e-4836-8835-b7b2597cbc22",
                                "sense_id": "a7e101b4-e254-3ae0-ba02-534608c703f0",
                                "text": "„Ohne Mexikos Agrarprodukte hätte Amerika nichts mehr zu essen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39028296-27b0-47f7-9827-fb5f20e0d103",
                        "source_entry_id": "4abdd808-bdd4-340b-a2b9-072d86352a83",
