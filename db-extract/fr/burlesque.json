            {
                "entry_id": "c53e3b22-3811-3c8c-8f6e-d947c2784923",
                "word": "burlesque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c7ec96a5-c1b2-4290-8528-45f56aea8823",
                        "entry_id": "c53e3b22-3811-3c8c-8f6e-d947c2784923",
                        "tags": [
                            "plural"
                        ],
                        "form": "burlesques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6c284619-0b2a-3ea6-b593-a30246d03060",
                        "entry_id": "c53e3b22-3811-3c8c-8f6e-d947c2784923",
                        "glosses": [
                            "Genre, style burlesque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76314a05-e59d-4858-b118-92abe98f5c89",
                                "sense_id": "6c284619-0b2a-3ea6-b593-a30246d03060",
                                "text": "Dans le domaine du spectacle, le burlesque recourt à tous les artifices pour provoquer le rire, jouant sur le décalage entre l'absurde et la réalité. La gestuelle est généralement mise à contribution."
                            },
                            {
                                "example_id": "6e736a39-9221-47bb-84f3-8737d9c5d390",
                                "sense_id": "6c284619-0b2a-3ea6-b593-a30246d03060",
                                "text": "Le burlesque c’est l’inconvenance, l’inadéquation, l’incongruité même, par définition."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e0e9a6d-950d-3293-8a73-d096ba065ee9",
                        "entry_id": "c53e3b22-3811-3c8c-8f6e-d947c2784923",
                        "glosses": [
                            "Décalage entre grandeur et petitesse."
                        ],
                        "tags": [
                            "Littérature française classique"
                        ],
                        "examples": [
                            {
                                "example_id": "93811c7e-8f82-418b-8a39-ff1b8c5948f2",
                                "sense_id": "1e0e9a6d-950d-3293-8a73-d096ba065ee9",
                                "text": "Le discours d'un personnage qui mèlera dans les mêmes tirades un champ lexical lyrique, passionné, tragique, etc. à des préoccupations triviales. Le théâtre de Molière recourt fréquemment au burlesque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba1f39d0-6830-4348-9c48-d79117547cc1",
                        "source_entry_id": "c53e3b22-3811-3c8c-8f6e-d947c2784923",
                        "target_lang_word": "Burleske",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Burleske",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77a1254e-8e79-3250-bf8e-7cd1d6b55ebd",
                                        "entry_id": "e9145441-1b9d-3705-8c96-2f45cb7eedbb",
                                        "glosses": [
                                            "eine derbe Komödie"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4157f33f-5103-4e14-b330-369900d500bb",
                                                "sense_id": "77a1254e-8e79-3250-bf8e-7cd1d6b55ebd",
                                                "text": "Ich habe die Geschichte in einer Burleske niedergeschrieben."
                                            },
                                            {
                                                "example_id": "2e2b57ea-fbdf-4a68-9996-3ef6b7a2b932",
                                                "sense_id": "77a1254e-8e79-3250-bf8e-7cd1d6b55ebd",
                                                "text": "„Die »Komischen Erzählungen«, die er dann schreibt, sind längere Verserzählungen, aber keine kleinen Epen.“"
                                            },
                                            {
                                                "example_id": "a01a3745-75ea-4e67-a62d-332769df103d",
                                                "sense_id": "77a1254e-8e79-3250-bf8e-7cd1d6b55ebd",
                                                "text": "„Lukian von Samosata (ca. 120–180 u. Z.) war derjenige, der damit anfing, die griechischen Mythen als Vorlage für kleine Burlesken zu nehmen.“"
                                            },
                                            {
                                                "example_id": "3edd5d22-0630-4a92-9a40-241bfe7adfeb",
                                                "sense_id": "77a1254e-8e79-3250-bf8e-7cd1d6b55ebd",
                                                "text": "„Ich wollte ein bißchen Grauen, denn ich hatte eine wundervolle Burleske in petto, die ich als Schluß zu verwenden gedachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d4fd7a39-cbff-34d6-8f4d-e7a6447fbb98",
                                        "entry_id": "e9145441-1b9d-3705-8c96-2f45cb7eedbb",
                                        "glosses": [
                                            "heiteres Instrumentalstück in der Musik"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f89dce1b-ccf2-4364-b68c-deb715689f63",
                                                "sense_id": "d4fd7a39-cbff-34d6-8f4d-e7a6447fbb98",
                                                "text": "Max Reger komponierte mit op. 58 sechs Burlesken für Klavier zu vier Händen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58f6a26f-85c3-4da1-a834-6e40c63c553f",
                        "source_entry_id": "c53e3b22-3811-3c8c-8f6e-d947c2784923",
                        "target_lang_word": "burlesque",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burlesque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d8964b1-b809-30ee-9c30-8492c23e5169",
                                        "entry_id": "0e3a556f-e719-32c7-9ce5-14a9748b1e2e",
                                        "glosses": [
                                            "Parodical; parodic"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3c04d11-ba85-42b8-8e09-160845b4c0d5",
                                                "sense_id": "4d8964b1-b809-30ee-9c30-8492c23e5169",
                                                "text": "It is a dispute among the critics, whether burlesque poetry runs best in heroic verse, like that of the Dispensary, or in doggerel, like that of Hudibras."
                                            },
                                            {
                                                "example_id": "f7fa0a84-1ba7-4ad8-b490-3d7d3b96253e",
                                                "sense_id": "4d8964b1-b809-30ee-9c30-8492c23e5169",
                                                "text": "Podunk. A term applied to an imaginary place in burlesque writing or speaking."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "burlesque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c0bb3f6-ae7c-3f51-871d-fe317b630caf",
                                        "entry_id": "5cd4c2fb-6f6b-30f8-8f7d-8fc27849d1e9",
                                        "glosses": [
                                            "A derisive art form that mocks by imitation; a parody."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef8be263-2272-4860-8a63-681a18f7622d",
                                                "sense_id": "7c0bb3f6-ae7c-3f51-871d-fe317b630caf",
                                                "text": "Burlesque is therefore of two kinds; the first represents mean persons in the accoutrements of heroes, the other describes great persons acting and speaking like the basest among the people."
                                            },
                                            {
                                                "example_id": "31554337-e642-4a9b-87c2-60e82546ed65",
                                                "sense_id": "7c0bb3f6-ae7c-3f51-871d-fe317b630caf",
                                                "text": "The dull burlesque appeared with impudence, / And pleased by novelty in spite of sense."
                                            },
                                            {
                                                "example_id": "95ea58db-5c06-452c-8a11-12c7ac9b48c7",
                                                "sense_id": "7c0bb3f6-ae7c-3f51-871d-fe317b630caf",
                                                "text": "“H'm !” he said, “so, so—it is a tragedy in a prologue and three acts. I am going down this afternoon to see the curtain fall for the third time on what […] will prove a good burlesque ; but it all began dramatically enough. It was last Saturday […] that two boys, playing in the little spinney just outside Wembley Park Station, came across three large parcels done up in American cloth. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f428c41-54d5-34ac-810a-9a50b6627950",
                                        "entry_id": "5cd4c2fb-6f6b-30f8-8f7d-8fc27849d1e9",
                                        "glosses": [
                                            "A variety adult entertainment show, usually including titillation such as striptease, most common from the 1880s to the 1930s."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92ab9658-89da-3953-bdff-dd35a3eee3bc",
                                        "entry_id": "5cd4c2fb-6f6b-30f8-8f7d-8fc27849d1e9",
                                        "glosses": [
                                            "A ludicrous imitation; a caricature; a travesty; a gross perversion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0784a531-af9d-4d02-907e-d53bddda2030",
                                                "sense_id": "92ab9658-89da-3953-bdff-dd35a3eee3bc",
                                                "text": "Who is it that admires, and from the heart is attached to, national representative assemblies, but must turn with horror and disgust from such a profane burlesque and abominable perversion of that sacred institute?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "burlesque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2050728-0b58-3694-ade9-55a1913c8a77",
                                        "entry_id": "2104e639-2fb3-30e9-839d-7d58ad687a46",
                                        "glosses": [
                                            "To make a burlesque parody of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e8b66ee-5b97-4367-85bb-16131028790a",
                                                "sense_id": "f2050728-0b58-3694-ade9-55a1913c8a77",
                                                "text": "When the venerable New York Times took my quote in which I described the neon elements as \"burlesquing the myth of male dominance\" and instead printed \"he prefers to describe them as . . . symbols of male dominance\" it became clear that dealing with journalists was going to be one long, rocky road."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82ad907d-2283-3d07-aacb-19919553d230",
                                        "entry_id": "2104e639-2fb3-30e9-839d-7d58ad687a46",
                                        "glosses": [
                                            "To ridicule, or to make ludicrous by grotesque representation in action or in language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28ddf52a-e77d-4f8e-986d-450c3e17ed6b",
                                                "sense_id": "82ad907d-2283-3d07-aacb-19919553d230",
                                                "text": "They burlesqued the prophet Jeremiah's words, and turned the expression he used into ridicule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
