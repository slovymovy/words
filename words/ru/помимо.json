{
    "word_family": [
        "мимо",
        "миновать"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "c7b667b8-8ae7-3104-ba02-3a1a5455d76a",
                    "sense_definition": "Вдобавок к чему-либо, наряду с чем-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я вспомнил, что <w>помимо</w> антрактов в театре бывают и долгие паузы.",
                            "target_lang_translations": {
                                "en": "I remembered that <w>besides</w> intermissions, there are also long pauses in the theater.",
                                "zh": "我记起来了，剧院里<w>除了</w>幕间休息，还有很长的停顿。"
                            }
                        },
                        {
                            "text": "<w>Помимо</w> основной работы, у него есть интересное хобби.",
                            "target_lang_translations": {
                                "en": "<w>In addition to</w> his main job, he has an interesting hobby.",
                                "zh": "<w>除了</w>主业，他还有一个有趣的爱好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сверх",
                        "наряду"
                    ],
                    "common_phrases": [
                        "помимо того",
                        "помимо прочего",
                        "помимо работы"
                    ],
                    "target_lang_definitions": {
                        "en": "In addition to something, along with something.",
                        "zh": "除了某事之外，还有其他事物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "besides",
                                "target_lang_sense_clarification": "in addition to"
                            },
                            {
                                "target_lang_word": "in addition to",
                                "target_lang_sense_clarification": "formal equivalent"
                            },
                            {
                                "target_lang_word": "apart from",
                                "target_lang_sense_clarification": "as well as"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "除了",
                                "target_lang_sense_clarification": "表示在某事物之外还有其他"
                            },
                            {
                                "target_lang_word": "此外",
                                "target_lang_sense_clarification": "表示另外还有"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f7a2b58-9c08-300c-bbcf-fd26b2c106c5",
                    "sense_definition": "За исключением кого-либо или чего-либо; кроме.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этой комнате никого не было <w>помимо</w> нас двоих.",
                            "target_lang_translations": {
                                "en": "There was no one in this room <w>besides</w> the two of us.",
                                "zh": "房间里<w>除了</w>我们俩，没有别人。"
                            }
                        },
                        {
                            "text": "Звон, стук и напор, но <w>помимо</w> этого ничего, чем можно защититься от беды.",
                            "target_lang_translations": {
                                "en": "Ringing, knocking, and pressure, but <w>apart from</w> that, nothing with which one can protect oneself from trouble.",
                                "zh": "叮当声、敲击声和压力，但<w>除了</w>这些，没有什么能用来抵御灾祸。"
                            }
                        }
                    ],
                    "synonyms": [
                        "кроме",
                        "за исключением"
                    ],
                    "common_phrases": [
                        "никого помимо",
                        "ничего помимо"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разг."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "With the exception of someone or something; except.",
                        "zh": "排除某人或某事；除……之外。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "apart from",
                                "target_lang_sense_clarification": "except for"
                            },
                            {
                                "target_lang_word": "except for",
                                "target_lang_sense_clarification": "excluding"
                            },
                            {
                                "target_lang_word": "other than",
                                "target_lang_sense_clarification": "different from"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "除了",
                                "target_lang_sense_clarification": "表示排除在外"
                            },
                            {
                                "target_lang_word": "除……之外",
                                "target_lang_sense_clarification": "表示不包括"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0ec8da3-2695-300c-906e-63c0f283c852",
                    "sense_definition": "Без ведома или участия кого-либо; вопреки чему-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bypassing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это важное решение было принято <w>помимо</w> директора.",
                            "target_lang_translations": {
                                "en": "This important decision was made <w>without the knowledge of</w> the director.",
                                "zh": "这个重要的决定是在<w>背着</w>经理的情况下做出的。"
                            }
                        },
                        {
                            "text": "Слёзы потекли из её глаз <w>помимо</w> её воли.",
                            "target_lang_translations": {
                                "en": "Tears flowed from her eyes <w>against</w> her will.",
                                "zh": "泪水<w>违背</w>她的意愿从眼中流了出来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "помимо воли",
                        "помимо желания"
                    ],
                    "target_lang_definitions": {
                        "en": "Without the knowledge or participation of someone; contrary to something.",
                        "zh": "在某人不知情或未参与的情况下；违背某事。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "without the knowledge of",
                                "target_lang_sense_clarification": "unknown to someone"
                            },
                            {
                                "target_lang_word": "against",
                                "target_lang_sense_clarification": "contrary to (e.g. against one's will)"
                            },
                            {
                                "target_lang_word": "bypassing",
                                "target_lang_sense_clarification": "ignoring authority"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "背着",
                                "target_lang_sense_clarification": "在某人不知情的情况下"
                            },
                            {
                                "target_lang_word": "违背",
                                "target_lang_sense_clarification": "与意愿相反"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}