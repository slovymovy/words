                    {
                        "sense_id": "0ef2ff5d-ee27-3bfd-aa61-eb6ca1fb36bf",
                        "entry_id": "2b1d26af-448a-3ee2-8fa6-c848b728f6f2",
                        "glosses": [
                            "Offrande, action par laquelle on offre quelque chose à Dieu."
                        ],
                        "tags": [
                            "Liturgie"
                        ],
                        "examples": [
                            {
                                "example_id": "a86f44c9-d654-446a-ad6b-3aabe7401e18",
                                "sense_id": "0ef2ff5d-ee27-3bfd-aa61-eb6ca1fb36bf",
                                "text": "On entendait par « autel » le droit de jouir des oblations et des revenus casuels d'une église."
                            }
                        ]
                    },
                    {
                        "sense_id": "d082fdd8-b311-33fd-bb3d-724593971789",
                        "entry_id": "2b1d26af-448a-3ee2-8fa6-c848b728f6f2",
                        "glosses": [
                            "Moment de la messe où se fait cette offrande."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "85918b65-59b9-32a9-91ec-1133a49810d1",
                        "entry_id": "2b1d26af-448a-3ee2-8fa6-c848b728f6f2",
                        "glosses": [
                            "Ce qu’on offre à Dieu."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "04780f8d-4b94-347a-869c-0fcd2373d136",
                        "entry_id": "2b1d26af-448a-3ee2-8fa6-c848b728f6f2",
                        "glosses": [
                            "Fait pour un seigneur de transférer volontairement une propriété à un autre seigneur dans le but de la recevoir immédiatement en fief de celui-ci."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a1911f8-3686-4af8-a693-4ce484c27f74",
