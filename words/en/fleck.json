    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "444355cf-5dc5-3010-a244-18b46106e679",
                    "sense_definition": "A small spot, mark, or streak on a surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The white paint was covered in tiny black <w>flecks</w> of dirt.",
                            "target_lang_translations": {
                                "cs": "Bílá barva byla pokryta drobnými černými <w>skvrnkami</w> špíny.",
                                "nl": "De witte verf zat onder de kleine zwarte <w>spikkels</w> vuil."
                            }
                        },
                        {
                            "text": "Her blue eyes had golden <w>flecks</w> in them.",
                            "target_lang_translations": {
                                "cs": "V jejích modrých očích byly zlaté <w>tečky</w>.",
                                "nl": "Haar blauwe ogen hadden gouden <w>spikkeltjes</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "speck",
                        "spot",
                        "dot"
                    ],
                    "common_phrases": [
                        "tiny flecks"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malá skvrna, značka nebo čára na povrchu.",
                        "nl": "Een kleine vlek, markering of streep op een oppervlak."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "skvrnka",
                                "target_lang_sense_clarification": "malá skvrna"
                            },
                            {
                                "target_lang_word": "flíček",
                                "target_lang_sense_clarification": "zdrobnělina pro malou skvrnu"
                            },
                            {
                                "target_lang_word": "tečka",
                                "target_lang_sense_clarification": "malý bod nebo skvrnka"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "spikkel",
                                "target_lang_sense_clarification": "klein plekje van een andere kleur"
                            },
                            {
                                "target_lang_word": "vlekje",
                                "target_lang_sense_clarification": "kleine vlek"
                            },
                            {
                                "target_lang_word": "stip",
                                "target_lang_sense_clarification": "klein rond puntje"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dff51834-4d7a-3da0-bca4-7517f76005dd",
                    "sense_definition": "A very small amount of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "small_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was not a <w>fleck</w> of evidence to support his claim.",
                            "target_lang_translations": {
                                "cs": "Nebyl ani <w>náznak</w> důkazu, který by podpořil jeho tvrzení.",
                                "nl": "Er was geen <w>spoor</w> van bewijs om zijn bewering te ondersteunen."
                            }
                        },
                        {
                            "text": "He showed a <w>fleck</w> of interest in the project after all.",
                            "target_lang_translations": {
                                "cs": "Nakonec projevil alespoň <w>špetku</w> zájmu o ten projekt.",
                                "nl": "Hij toonde uiteindelijk toch een <w>vleugje</w> interesse in het project."
                            }
                        }
                    ],
                    "synonyms": [
                        "trace",
                        "hint",
                        "bit"
                    ],
                    "target_lang_definitions": {
                        "cs": "Velmi malé množství něčeho.",
                        "nl": "Een zeer kleine hoeveelheid van iets."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "náznak",
                                "target_lang_sense_clarification": "velmi malé množství nebo stopa"
                            },
                            {
                                "target_lang_word": "špetka",
                                "target_lang_sense_clarification": "malé množství, často používané u abstraktních pojmů"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "spoor",
                                "target_lang_sense_clarification": "een heel klein beetje"
                            },
                            {
                                "target_lang_word": "beetje",
                                "target_lang_sense_clarification": "kleine hoeveelheid"
                            },
                            {
                                "target_lang_word": "vleugje",
                                "target_lang_sense_clarification": "kleine, subtiele hoeveelheid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18e35edf-cd01-3c28-985b-08c1cc64d9d0",
                    "sense_definition": "A small, thin piece or flake.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "small_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe calls for a few <w>flecks</w> of sea salt on top.",
                            "target_lang_translations": {
                                "cs": "Recept vyžaduje pár <w>šupinek</w> mořské soli navrch.",
                                "nl": "Het recept vraagt om een paar <w>schilfers</w> zeezout eroverheen."
                            }
                        },
                        {
                            "text": "I brushed the <w>flecks</w> of dry skin from my jacket.",
                            "target_lang_translations": {
                                "cs": "Oprášil jsem si ze saka <w>šupinky</w> suché kůže.",
                                "nl": "Ik borstelde de <w>schilfertjes</w> droge huid van mijn jas."
                            }
                        }
                    ],
                    "synonyms": [
                        "flake",
                        "particle"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malý, tenký kousek nebo šupinka.",
                        "nl": "Een klein, dun stukje of schilfertje."
                    },
                    "translations": {
