                        "entry_id": "a31a814e-7bfc-392d-be38-a1e74b6d1e54",
                        "glosses": [
                            "A cloak, worn in ancient times by the Gauls, early Germans, and Roman soldiers, made of a rectangular piece of (usually red) coarse cloth and fastened on the right shoulder."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c93d6ec7-901c-4023-8d06-91a37b9d5f17",
                        "source_entry_id": "a31a814e-7bfc-392d-be38-a1e74b6d1e54",
                        "source_sense_id": "521a77ce-8a70-3640-be0f-177a73061edc",
                        "source_sense_description": "cloak worn by Gallic, Germanic and Roman soldiers",
                        "target_lang_word": "sayon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sayon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a70ee77-5e0a-3955-9a42-b735c498bbe5",
                                        "entry_id": "480dc377-94cd-3090-b793-00f6fde5dd1a",
                                        "glosses": [
                                            "Sorte de casaque ouverte que portaient anciennement les paysans, les soldats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac5145ee-0793-45a5-b58d-c1bd112a3a74",
                                                "sense_id": "4a70ee77-5e0a-3955-9a42-b735c498bbe5",
                                                "text": "Une espèce de sayon en grosse toile rapiécée formait tout son vêtement et dessinait un corps maigre et nerveux, non sans élégance malgré toute cette misère."
                                            },
                                            {
                                                "example_id": "814c921c-3851-4b74-9545-261ab4c3c767",
                                                "sense_id": "4a70ee77-5e0a-3955-9a42-b735c498bbe5",
                                                "text": "Mais il est grand, sec, droit sous son sayon jaunâtre moins poilu que sa poitrine, et un peintre ne dédaignerait pas d’en saisir la silhouette, lorsque, coiffé d’un chapeau de sparterie, vrai bouchon de paille, il s’accote sur son bâton à bec de corbin, aussi immobile qu’un roc."
                                            },
                                            {
                                                "example_id": "82b3bf48-903d-44c2-803e-29f16cb94f00",
                                                "sense_id": "4a70ee77-5e0a-3955-9a42-b735c498bbe5",
                                                "text": "Protos sortit un papier de la poche intérieure de son sayon."
                                            },
                                            {
                                                "example_id": "f3d449c3-0eb1-4cc3-b92f-24d413a49c61",
                                                "sense_id": "4a70ee77-5e0a-3955-9a42-b735c498bbe5",
                                                "text": "Claude produisit quelque trois cent félins et autant d’ours, et c’est à l’occasion d’une de ces chasses que l’on vit un condamné se tirer d’affaire en jetant son sayon sur la tête du lion qui le chargeait."
                                            },
                                            {
                                                "example_id": "54f30fe2-e531-47ef-850d-7f472d16cf50",
                                                "sense_id": "4a70ee77-5e0a-3955-9a42-b735c498bbe5",
                                                "text": "«Des paysans à sayons de peau de bique, à cheveux longs, pressaient des bœufs maigres avec des cris aigus et marchaient à la queue d'une lourde charrue, comme des faunes labourant. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df18675a-4344-34be-b2f7-481eb9fecb8b",
                                        "entry_id": "480dc377-94cd-3090-b793-00f6fde5dd1a",
                                        "glosses": [
                                            "Casaque de guerre, portée par les soldats gaulois, puis par les romains."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "391b7917-810c-46a4-9f84-d2127fdac915",
                                                "sense_id": "df18675a-4344-34be-b2f7-481eb9fecb8b",
                                                "text": "On voyait se mêler, se confondre, sur une vaste étendue la robe bariolée des Égyptiens, le burnous des Arabes (…) les sayons et les braies écarlates des Barbares."
                                            },
                                            {
                                                "example_id": "033a9df6-9dcb-45c9-9eeb-0cfe7f344cc1",
                                                "sense_id": "df18675a-4344-34be-b2f7-481eb9fecb8b",
                                                "text": "Les Bardes sont debout dans leurs sayons rayés,\nAux harpes de granit les deux bras appuyés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sayon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7ef62ef-4231-3dc8-a675-c43d18180122",
                                        "entry_id": "e07b174a-17fa-344f-aaaa-191878564b2e",
                                        "glosses": [
                                            "Variante de sillon."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4546a1e-6a98-42ee-94a5-67fae5b6d814",
                                                "sense_id": "d7ef62ef-4231-3dc8-a675-c43d18180122",
                                                "text": "Pour sentir que j’étais bien à Combray, je montais le retrouver qui courait dans les sayons et me faisait courir à sa suite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
