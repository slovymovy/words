                                            {
                                                "example_id": "8e4331da-7527-4316-87d8-d887fea0b379",
                                                "sense_id": "11cc01dc-f239-3a5f-a1fb-93deaf036ad4",
                                                "text": "Take all idea of retribution and punishment out of the hearts and minds of men, and it would not be long before Brooklyn and New York and Boston and Charleston and Chicago became Sodoms."
                                            }
                                        ]
                                    }
                                ]
