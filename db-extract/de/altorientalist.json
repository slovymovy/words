                "senses": [
                    {
                        "sense_id": "9d6b35b0-8e5e-31e8-8770-9987c81d44ef",
                        "entry_id": "cad9ef65-8682-38e3-8992-8ef0f2f1ac04",
                        "glosses": [
                            "Person, die die Wissenschaft der Altorientalistik/Assyriologie ausübt (entspricht der traditionellen Bezeichnung Assyriologe, meint aber ausdrücklich auch den archäologisch/kunstgeschichtlich arbeitenden Forscher)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b437a2b5-813e-492d-9be1-848e8d1bf99c",
                                "sense_id": "9d6b35b0-8e5e-31e8-8770-9987c81d44ef",
                                "text": "„Das Thema ‚Art and Magic in the Ancient Near East‘ übt auf den Altorientalisten eine besondere Anziehungskraft aus — gleichgültig, ob er auf dem Gebiet der Kunstgeschichte, der Religionsgeschichte oder der Philologie arbeitet.“"
                            },
                            {
                                "example_id": "766d0783-f6e2-485c-bab8-20c3bb997d49",
                                "sense_id": "9d6b35b0-8e5e-31e8-8770-9987c81d44ef",
                                "text": "„Das Gilgamesch-Epos wird von den Altorientalisten als Beleg für die Existenz primitiver demokratischer Herrschaftsverhältnisse in Uruk herangezogen […].“"
                            },
                            {
                                "example_id": "8c60d548-c909-43fb-9b7a-8c0bab839b94",
                                "sense_id": "9d6b35b0-8e5e-31e8-8770-9987c81d44ef",
                                "text": "„Der Altorientalist Michael Jursa von der Philologisch-Kulturwissenschaftlichen Fakultät hat […] diese Tontafeln zum ersten Mal umfassend aufbereitet und anhand ihres Inhalts die Wirtschaftsgeschichte Babyloniens rekonstruiert.“"
                            },
                            {
                                "example_id": "726f06f4-12bf-4678-b557-7db47f0b21a5",
                                "sense_id": "9d6b35b0-8e5e-31e8-8770-9987c81d44ef",
                                "text": "„Markus Hilgert (* 1969) ist ein deutscher Altorientalist und Vorsitzender der Deutschen Orient-Gesellschaft (DOG). Hilgert studierte […] Altorientalistik, Semitistik, Vergleichende Religionswissenschaft und Vorderasiatische Archäologie […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
