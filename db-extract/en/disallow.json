                                                "sense_id": "9f3e6879-ae78-3f39-8406-221f9e256247",
                                                "text": "De zieke man werd door de bedrijfsarts afgekeurd voor zijn werk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c14fb33-4d1e-3030-b4b8-8001e599c59d",
                                        "entry_id": "fe3db3cf-1c29-328b-b7aa-6a9477a36b63",
                                        "glosses": [
                                            "iets niet goed vinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64854048-37ba-4ef3-ac7a-5ba649a7f22d",
                                                "sense_id": "6c14fb33-4d1e-3030-b4b8-8001e599c59d",
                                                "text": "Ik moet dit gedrag van jou afkeuren, ik kan het niet goedkeuren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e85083f8-9191-481f-a6e4-eaed481ffeb1",
