                                "sense_id": "a5f468f5-735f-3b7f-9f98-c0bdafeeae08",
                                "text": "Een piron met een ananas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "824abc92-6a2d-4a12-b0a7-9b155a9a4949",
                        "source_entry_id": "ffa77421-d3c5-3ea4-ae5d-25e693b81135",
                        "source_sense_id": "a5f468f5-735f-3b7f-9f98-c0bdafeeae08",
