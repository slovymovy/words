                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc476d78-fba5-41c4-9256-fda85fc8ad0e",
                                                "sense_id": "09374e14-b1e7-3b01-8874-76d8ddbb45fd",
                                                "text": "It is easy to see, however, that the same coefficients in nematics determine the adiabatic deformations also."
                                            },
                                            {
                                                "example_id": "6e44034f-a763-4a43-86a4-19f069993113",
                                                "sense_id": "09374e14-b1e7-3b01-8874-76d8ddbb45fd",
                                                "text": "For low-molecular-weight nematics, it has been known that the constitutive equation of nematics is entirely different from that for isotropic liquids."
                                            },
                                            {
                                                "example_id": "5bf5d364-e9d3-4d5d-b365-5aaad7956152",
                                                "sense_id": "09374e14-b1e7-3b01-8874-76d8ddbb45fd",
                                                "text": "Electrohydrodynamic instabilities in nematics could be classified according to the dependence of the threshold voltage (or field) on the physical parameters of the liquid crystal, cell geometry, field frequency, etc."
                                            }
                                        ]
                                    }
