                "senses": [
                    {
                        "sense_id": "fcfc8f6b-8259-3e3b-802d-586fd202ca12",
                        "entry_id": "09479989-df61-315c-9850-af5be626aa9e",
                        "glosses": [
                            "Lehrer, der zum Unterricht \\\"ins Haus\\\" kommt, also nicht in einer Schule unterrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77e765f4-d358-428b-aed5-3093b4c6af8f",
                                "sense_id": "fcfc8f6b-8259-3e3b-802d-586fd202ca12",
                                "text": "„Sie betätigten sich als Hauslehrer oder - wenn die Zahl ihrer Schüler groß genug war - mieteten Lokale, in denen sie täglichen Unterricht hielten.“"
                            },
                            {
                                "example_id": "f6b185de-e4dc-4241-8925-03c828491588",
                                "sense_id": "fcfc8f6b-8259-3e3b-802d-586fd202ca12",
                                "text": "„Normalerweise ist es an dem Fürsten (König, Herzog, was immer), den heranwachsenden Sohn, der bisher sein Leben mit Haus-, Fecht- und Tanzlehrern verbracht hat (und mit der Jagd), langsam an die Regierungsgeschäfte heranzuführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4143585d-0a88-42cb-aac8-2cb96b51eb53",
                        "source_entry_id": "09479989-df61-315c-9850-af5be626aa9e",
                        "source_sense_id": "fcfc8f6b-8259-3e3b-802d-586fd202ca12",
                        "target_lang_word": "précepteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "précepteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6ea7863-b5db-3b1b-b07f-afa6f356a481",
                                        "entry_id": "babc8e41-eb67-3eb1-8849-735d76d72f8d",
                                        "glosses": [
                                            "Celui qui est chargé de l’instruction et de l’éducation d’un enfant, d’un jeune homme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3267f7b-4151-41a9-8056-4ddfacd3bdf9",
                                                "sense_id": "d6ea7863-b5db-3b1b-b07f-afa6f356a481",
                                                "text": "Il avait été décidé, quelques mois auparavant, qu’on ne m’enverrait pas au collège et que j’aurais un précepteur."
                                            },
                                            {
                                                "example_id": "ffab2f4e-b546-486a-b828-89be1b9f3c79",
                                                "sense_id": "d6ea7863-b5db-3b1b-b07f-afa6f356a481",
                                                "text": "De vieux précepteurs, engagés au rabais, avaient tenté de lui inculquer quelques rudiments de calcul et d’orthographe."
                                            },
                                            {
                                                "example_id": "44c3d626-51de-4618-b7ec-236a4a0be382",
                                                "sense_id": "d6ea7863-b5db-3b1b-b07f-afa6f356a481",
                                                "text": "Pour le cocuage, c'est plus sérieux. Il s'agit, pour employer la langue moderne, d'un traumatisme. L'enfant a quinze ans, et s'aperçoit brutalement que sa mère couche avec son précepteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bfea35c-3573-3d7c-8414-8673d876e916",
                                        "entry_id": "babc8e41-eb67-3eb1-8849-735d76d72f8d",
                                        "glosses": [
                                            "Président d'une commanderie de templiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e692fd9-b8ae-4f17-ba17-22e165d2305e",
                                                "sense_id": "3bfea35c-3573-3d7c-8414-8673d876e916",
                                                "text": "Albert de Malvoisin, président ou, en langage de l’ordre, précepteur de l’établissement de Templestowe, était le frère de ce Philippe de Malvoisin […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
