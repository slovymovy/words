                    {
                        "sense_id": "3f2f31f2-b125-3a2a-a3ea-107dc3a53751",
                        "entry_id": "8226c1cb-53b5-3ab7-b676-79b2f8489d98",
                        "glosses": [
                            "A type of rough woollen cloth."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ed0246f9-e2ce-4a07-b30f-497818aa09f4",
                                "sense_id": "3f2f31f2-b125-3a2a-a3ea-107dc3a53751",
                                "text": "Hencefoorth my wooing minde ſhalbe expreſt / In ruſſet yeas, and honeſt kerſie noes."
                            },
                            {
                                "example_id": "8215ab7a-8dc5-4423-9cda-596e45a67290",
                                "sense_id": "3f2f31f2-b125-3a2a-a3ea-107dc3a53751",
                                "text": "[T]here was a Report, that one of our Ships having by Stealth delivered her Cargo, among which was ſome Bales of Engliſh Cloth, Cotton, Kerſyes, and ſuch like Goods, the Spaniards cauſed all the Goods to be burnt, and puniſhed the Men with Death who were concern'd in carrying them on Shore."
                            },
                            {
                                "example_id": "321306a0-bf7d-4aa8-8a02-a589fbd69d01",
                                "sense_id": "3f2f31f2-b125-3a2a-a3ea-107dc3a53751",
                                "text": "In Adirondac lakes, / At morn or noon, the guide rows bareheaded: / Shoes, flannel shirt, and kersey trousers make / His brief toilette […]"
                            }
                        ]
                    }
