{
    "word_family": [
        "quotation",
        "quotable",
        "misquote",
        "unquote"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2163d757-1e45-3c07-8295-38d524f39093",
                    "sense_definition": "To repeat the exact words spoken or written by someone else.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "text_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journalist <w>quoted</w> the mayor in her article about the new park.",
                            "target_lang_translations": {
                                "ru": "Журналистка <w>процитировала</w> мэра в своей статье о новом парке.",
                                "tr": "Gazeteci, yeni park hakkındaki yazısında belediye başkanından <w>alıntı yaptı</w>."
                            }
                        },
                        {
                            "text": "Please do not <w>quote</w> me on this, but I think the office is closing early.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>ссылайтесь</w> на меня, но я думаю, что офис закрывается рано.",
                                "tr": "Lütfen bu konuda beni <w>referans göstermeyin</w>, ama sanırım ofis erken kapanıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "cite",
                        "repeat"
                    ],
                    "common_phrases": [
                        "quote a source",
                        "quote me on that",
                        "quote from memory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторять точные слова, сказанные или написанные кем-то другим.",
                        "tr": "Başka birinin söylediği veya yazdığı kelimeleri aynen tekrarlamak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цитировать",
                                "target_lang_sense_clarification": "приводить чьи-то слова"
                            },
                            {
                                "target_lang_word": "ссылаться",
                                "target_lang_sense_clarification": "указывать на источник"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "alıntılamak",
                                "target_lang_sense_clarification": "birinin sözlerini aktarmak"
                            },
                            {
                                "target_lang_word": "alıntı yapmak",
                                "target_lang_sense_clarification": "başkasına ait sözü kullanmak"
                            },
                            {
                                "target_lang_word": "aktarmak",
                                "target_lang_sense_clarification": "sözü olduğu gibi iletmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbfee7c4-1379-3891-81f9-aca71ef944b9",
                    "sense_definition": "To tell a customer the estimated cost for a specific job or service.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commercial_price",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic <w>quoted</w> two hundred dollars for the car repair.",
                            "target_lang_translations": {
                                "ru": "Механик <w>назвал цену</w> в двести долларов за ремонт машины.",
                                "tr": "Tamirci, araba tamiri için iki yüz dolar <w>fiyat biçti</w>."
                            }
                        },
                        {
                            "text": "They <w>quoted</w> a very high price for the kitchen renovation.",
                            "target_lang_translations": {
                                "ru": "Они <w>запросили</w> очень высокую цену за ремонт кухни.",
                                "tr": "Mutfak tadilatı için çok yüksek bir fiyat <w>teklif ettiler</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quote a price",
                        "quote for the job"
                    ],
                    "target_lang_definitions": {
                        "ru": "Называть клиенту оценочную стоимость определенной работы или услуги.",
                        "tr": "Bir müşteri için belirli bir iş veya hizmetin tahmini maliyetini bildirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "назначать цену",
                                "target_lang_sense_clarification": "определять стоимость"
                            },
                            {
                                "target_lang_word": "оценивать",
                                "target_lang_sense_clarification": "давать оценку стоимости"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "fiyat teklif etmek",
                                "target_lang_sense_clarification": "bir iş için maliyet sunmak"
                            },
                            {
                                "target_lang_word": "fiyat biçmek",
                                "target_lang_sense_clarification": "hizmet bedeli belirlemek"
                            },
                            {
                                "target_lang_word": "fiyat vermek",
                                "target_lang_sense_clarification": "tahmini ücret bildirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca1f4454-79fb-31f0-a396-344c9bd66083",
                    "sense_definition": "To name the current market price of a financial security or commodity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "commercial_price",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The broker <w>quoted</w> the stock at fifty dollars per share.",
                            "target_lang_translations": {
                                "ru": "Брокер <w>котировал</w> акции по пятьдесят долларов за штуку.",
                                "tr": "Borsa simsarı, hisse senedini hisse başına elli dolar olarak <w>kote etti</w>."
                            }
                        },
                        {
                            "text": "Gold was <w>quoted</w> lower today than it was yesterday.",
                            "target_lang_translations": {
                                "ru": "Золото сегодня <w>котировалось</w> ниже, чем вчера.",
                                "tr": "Altın bugün dünkünden daha düşük fiyattan <w>işlem gördü</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объявлять текущую рыночную цену ценной бумаги или товара.",
                        "tr": "Bir finansal menkul kıymetin veya emtianın güncel piyasa fiyatını bildirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "котировать",
                                "target_lang_sense_clarification": "устанавливать курс на бирже"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kote etmek",
                                "target_lang_sense_clarification": "borsa fiyatını açıklamak"
                            },
                            {
                                "target_lang_word": "fiyatını bildirmek",
                                "target_lang_sense_clarification": "piyasa değerini belirtmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d185d1e9-558c-310e-bb7e-a8568b4017c9",
                    "sense_definition": "To observe or take note of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I fear that I had not <w>quoted</w> him with enough care and judgment.",
                            "target_lang_translations": {
                                "ru": "Боюсь, я не <w>отметил</w> его слова с достаточной тщательностью и рассудительностью.",
                                "tr": "Onu yeterince dikkat ve muhakeme ile <w>gözlemleyemediğimden</w> korkuyorum."
                            }
                        },
                        {
                            "text": "The observer stood by to <w>quote</w> every smile and gesture.",
                            "target_lang_translations": {
                                "ru": "Наблюдатель стоял рядом, чтобы <w>подмечать</w> каждую улыбку и жест.",
                                "tr": "Gözlemci, her gülümsemeyi ve hareketi <w>kaydetmek</w> üzere kenarda bekledi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наблюдать или принимать что-либо к сведению (устаревшее).",
                        "tr": "Bir şeyi gözlemlemek veya dikkate almak (eski kullanım)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замечать",
                                "target_lang_sense_clarification": "обращать внимание"
                            },
                            {
                                "target_lang_word": "отмечать",
                                "target_lang_sense_clarification": "фиксировать в уме"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dikkate almak",
                                "target_lang_sense_clarification": "göz önünde bulundurmak"
                            },
                            {
                                "target_lang_word": "gözlemlemek",
                                "target_lang_sense_clarification": "farkına varmak, izlemek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "647b5bad-8f67-33b7-9487-4192f7a9383b",
                    "sense_definition": "A sentence or phrase from a text or speech that is repeated by someone else.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "text_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She included a famous <w>quote</w> at the beginning of her essay.",
                            "target_lang_translations": {
                                "ru": "Она включила известную <w>цитату</w> в начало своего эссе.",
                                "tr": "Denemesinin başına ünlü bir <w>alıntı</w> ekledi."
                            }
                        },
                        {
                            "text": "This book is full of funny <w>quotes</w> about life and friendship.",
                            "target_lang_translations": {
                                "ru": "Эта книга полна забавных <w>цитат</w> о жизни и дружбе.",
                                "tr": "Bu kitap hayat ve dostluk hakkında komik <w>sözlerle</w> dolu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "famous quote",
                        "inspirational quote",
                        "direct quote"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предложение или фраза из текста или речи, повторяемая кем-то другим.",
                        "tr": "Bir metinden veya konuşmadan başkası tarafından tekrarlanan cümle veya ifade."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цитата",
                                "target_lang_sense_clarification": "выдержка из текста"
                            },
                            {
                                "target_lang_word": "выдержка",
                                "target_lang_sense_clarification": "отрывок"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "alıntı",
                                "target_lang_sense_clarification": "başka yerden alınan söz veya metin"
                            },
                            {
                                "target_lang_word": "özdeyiş",
                                "target_lang_sense_clarification": "anlamlı kısa söz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "956645d1-02f3-3200-b548-34522b82f3fd",
                    "sense_definition": "A punctuation mark used to indicate the beginning or end of spoken words or a citation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "text_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should put the title of the article in single <w>quotes</w>.",
                            "target_lang_translations": {
                                "ru": "Вам следует заключить название статьи в одинарные <w>кавычки</w>.",
                                "tr": "Makalenin başlığını tekli <w>tırnak işareti</w> içine almalısınız."
                            }
                        },
                        {
                            "text": "He made air <w>quotes</w> with his fingers when he said the word 'expert'.",
                            "target_lang_translations": {
                                "ru": "Он показал пальцами воздушные <w>кавычки</w>, когда произнес слово «эксперт».",
                                "tr": "'Uzman' kelimesini söylerken parmaklarıyla havada <w>tırnak işareti</w> yaptı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "double quotes",
                        "single quotes",
                        "air quotes",
                        "in quotes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знак препинания, используемый для обозначения начала или конца прямой речи или цитаты.",
                        "tr": "Konuşulan kelimelerin veya alıntının başlangıcını ve sonunu göstermek için kullanılan noktalama işareti."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кавычки",
                                "target_lang_sense_clarification": "знак препинания"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tırnak işareti",
                                "target_lang_sense_clarification": "noktalama işareti"
                            },
                            {
                                "target_lang_word": "tırnak",
                                "target_lang_sense_clarification": "kısaca tırnak işareti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f2a2c02-5c0a-3cc1-a134-7148c376fb86",
                    "sense_definition": "An estimated price for a job or service provided by a contractor or seller.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commercial_price",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We asked the builder for a <w>quote</w> on the new roof.",
                            "target_lang_translations": {
                                "ru": "Мы попросили строителя составить <w>смету</w> на новую крышу.",
                                "tr": "İnşaatçıdan yeni çatı için bir <w>fiyat teklifi</w> istedik."
                            }
                        },
                        {
                            "text": "After reviewing the <w>quotes</w>, we decided to hire the first company.",
                            "target_lang_translations": {
                                "ru": "Изучив <w>ценовые предложения</w>, мы решили нанять первую компанию.",
                                "tr": "<w>Fiyat tekliflerini</w> inceledikten sonra ilk şirketi tutmaya karar verdik."
                            }
                        }
                    ],
                    "common_phrases": [
                        "get a quote",
                        "give a quote",
                        "written quote"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оценочная стоимость работы или услуги, предоставляемая подрядчиком или продавцом.",
                        "tr": "Bir yüklenici veya satıcı tarafından sağlanan bir iş veya hizmet için tahmini fiyat."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смета",
                                "target_lang_sense_clarification": "расчет стоимости"
                            },
                            {
                                "target_lang_word": "расценка",
                                "target_lang_sense_clarification": "установленная цена"
                            },
                            {
                                "target_lang_word": "ценовое предложение",
                                "target_lang_sense_clarification": "коммерческое предложение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "fiyat teklifi",
                                "target_lang_sense_clarification": "hizmet için sunulan maliyet"
                            },
                            {
                                "target_lang_word": "teklif",
                                "target_lang_sense_clarification": "fiyat ve şartlar içeren öneri"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54d52400-c170-3954-b66d-6a600e176498",
                    "sense_definition": "A price set and offered for a financial security or commodity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "commercial_price",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest <w>quote</w> for the company's stock showed a slight increase.",
                            "target_lang_translations": {
                                "ru": "Последняя <w>котировка</w> акций компании показала небольшой рост.",
                                "tr": "Şirket hissesi için son <w>piyasa fiyatı</w> hafif bir artış gösterdi."
                            }
                        },
                        {
                            "text": "Traders watched the screen for the newest oil <w>quotes</w>.",
                            "target_lang_translations": {
                                "ru": "Трейдеры следили за экраном в ожидании новейших <w>котировок</w> нефти.",
                                "tr": "Tüccarlar en yeni petrol <w>fiyatlarını</w> görmek için ekranı izledi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stock quote"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Цена, установленная и предлагаемая для ценной бумаги или товара.",
                        "tr": "Bir finansal menkul kıymet veya emtia için belirlenen ve sunulan fiyat."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "котировка",
                                "target_lang_sense_clarification": "биржевой курс"
                            },
                            {
                                "target_lang_word": "курс",
                                "target_lang_sense_clarification": "рыночная стоимость"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kotasyon",
                                "target_lang_sense_clarification": "borsadaki değer fiyatı"
                            },
                            {
                                "target_lang_word": "piyasa fiyatı",
                                "target_lang_sense_clarification": "güncel borsa değeri"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "d779d0fe-8f14-3c31-81ba-3426b19b396e",
                    "sense_definition": "Used in speech to signal that the following words are a direct quotation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "text_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He said, <w>quote</w>, 'I will never resign,' and then he walked out.",
                            "target_lang_translations": {
                                "ru": "Он сказал: «<w>цитирую</w>, я никогда не уйду в отставку», а затем вышел.",
                                "tr": "<w>Aynen şöyle</w> 'Asla istifa etmeyeceğim' dedi ve sonra çıkıp gitti."
                            }
                        },
                        {
                            "text": "The rules are, <w>quote</w> unquote, mandatory for everyone in the club.",
                            "target_lang_translations": {
                                "ru": "Правила являются, <w>в кавычках</w>, обязательными для всех в клубе.",
                                "tr": "Kurallar, <w>tırnak içinde</w> söylemek gerekirse, kulüpteki herkes için zorunludur."
                            }
                        }
                    ],
                    "antonyms": [
                        "unquote",
                        "end quote"
                    ],
                    "common_phrases": [
                        "quote unquote"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется в речи, чтобы показать, что следующие слова являются прямой цитатой.",
                        "tr": "Konuşmada, sonraki kelimelerin doğrudan bir alıntı olduğunu belirtmek için kullanılır."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цитирую",
                                "target_lang_sense_clarification": "вводное слово перед цитатой"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tırnak içinde",
                                "target_lang_sense_clarification": "alıntı yapıldığını belirten ifade"
                            },
                            {
                                "target_lang_word": "aynen şöyle",
                                "target_lang_sense_clarification": "doğrudan aktarma ünlemi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}