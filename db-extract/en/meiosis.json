                "senses": [
                    {
                        "sense_id": "430b339d-c932-36bc-8b83-852ad4569f1b",
                        "entry_id": "a3c2a8f4-859f-375a-913f-b72e5de17246",
                        "glosses": [
                            "A figure of speech whereby something is made to seem smaller or less important than it actually is."
                        ],
                        "tags": [
                            "countable",
                            "rhetoric",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8fead9b3-4153-45d5-8afd-289b5d7f64a8",
                                "sense_id": "430b339d-c932-36bc-8b83-852ad4569f1b",
                                "text": "I knew, with one of those secret knowledges that can exist between two people, that her suicide was a direct result of my having told her of my own attempt – I had told it with a curt meiosis that was meant to conceal depths; and she had called my bluff one final time."
                            }
                        ]
                    },
                    {
                        "sense_id": "b745168d-75ce-334b-8050-fbe1073d5bbe",
                        "entry_id": "a3c2a8f4-859f-375a-913f-b72e5de17246",
                        "glosses": [
                            "Cell division of a diploid cell into four haploid cells, which develop to produce gametes."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
