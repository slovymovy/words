                "senses": [
                    {
                        "sense_id": "adbb8a7e-5e74-30cf-8b34-0bf3dac83430",
                        "entry_id": "c97b618d-11a5-3a51-be40-0c18364fe4fb",
                        "glosses": [
                            "standardisiertes Wohngebäude als Teil eines geplanten Wohngebietes, in der Regel mit Nutzgarten"
                        ],
                        "tags": [
                            "Wohnungsbau"
                        ],
                        "examples": [
                            {
                                "example_id": "a9c84108-b563-49cc-8d10-5d2d0bdc0cdc",
                                "sense_id": "adbb8a7e-5e74-30cf-8b34-0bf3dac83430",
                                "text": "„Der Vater war noch im Krieg, als die Familie in Leipzig Mockau ein Siedlungshaus bekam. […] Das Haus war von der Leipziger Baugenossenschaft.“"
                            },
                            {
                                "example_id": "2d082b40-be2c-4474-ae66-ef076b5885b2",
                                "sense_id": "adbb8a7e-5e74-30cf-8b34-0bf3dac83430",
                                "text": "(Kleinschreibung:) „Ein wasserklosett darf es im siedlungshaus nicht geben, denn die abfallstoffe des ganzen hauses samt den menschlichen fäkalien sind notwendig für die bodenbereitung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
