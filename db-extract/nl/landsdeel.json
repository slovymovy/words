                        "examples": [
                            {
                                "example_id": "73337beb-f261-4fa6-9840-0ae5be26043d",
                                "sense_id": "d24b5c98-c1f9-3fb9-bae8-327c5c8f4c1f",
                                "text": "Nederland heeft 4 landsdelen n.l Noord, Oost, Zuid en West"
                            },
                            {
                                "example_id": "d8bf1106-cc7c-4e68-a24f-34bd8e569002",
                                "sense_id": "d24b5c98-c1f9-3fb9-bae8-327c5c8f4c1f",
                                "text": "Ook in Twente is op enkele plekken sprake van een stijging van de WOZ-waarde van woningen, vergeleken met vorig jaar. Maar vergeleken met de WOZ-waarden van voor de crisis is het in het oostelijk landsdeel nog steeds een drama."
                            },
                            {
                                "example_id": "b66ac492-5a80-4291-9168-df95889e88e4",
                                "sense_id": "d24b5c98-c1f9-3fb9-bae8-327c5c8f4c1f",
                                "text": "Denk maar aan Radovan Karadzic. De politieke leider van de Bosnische Serviërs kreeg in maart 2016 veertig jaar gevangenisstraf voor genocide in Srebrenica en andere oorlogsmisdaden. Een week voor zijn veroordeling vernoemden autoriteiten in het Servische landsdeel een studentenflat naar hem."
                            }
                        ]
