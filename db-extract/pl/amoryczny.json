                    }
                ],
                "senses": [
                    {
                        "sense_id": "14d480c7-95f9-366c-9c8e-efcf8347266d",
                        "entry_id": "847f3780-169a-3480-855a-e7feba4ad23f",
                        "glosses": [
                            "sich auf Liebe/Liebschaften beziehend; Liebes-"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "084d3cad-f3a6-46c8-8cdf-c071d841ac0e",
                        "source_entry_id": "847f3780-169a-3480-855a-e7feba4ad23f",
                        "source_sense_id": "14d480c7-95f9-366c-9c8e-efcf8347266d",
                        "source_sense_description": "selten: sich auf Liebe/Liebschaften beziehend; Liebes-",
                        "target_lang_word": "Liebe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liebe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01a2de42-1818-3fcb-9759-dfabf1f1b70b",
                                        "entry_id": "98ba3e34-823f-3b1c-9944-96b49921ba6b",
                                        "glosses": [
                                            "inniges Gefühl der Zuneigung für jemanden oder für etwas"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93b498fe-d2d3-45bf-be66-afd291a01bc0",
                                                "sense_id": "01a2de42-1818-3fcb-9759-dfabf1f1b70b",
                                                "text": "Die Liebe überwindet alle Grenzen."
                                            },
                                            {
                                                "example_id": "25174092-f61b-4559-904f-6a5d5ca0bcc5",
                                                "sense_id": "01a2de42-1818-3fcb-9759-dfabf1f1b70b",
                                                "text": "„Die Liebe ist in der Literatur ausreichend dargestellt worden, ihren Schilderungen kann nichts Neues hinzugefügt werden.“"
                                            },
                                            {
                                                "example_id": "668f91f3-1ca0-4d2f-910d-d2df0acf49aa",
                                                "sense_id": "01a2de42-1818-3fcb-9759-dfabf1f1b70b",
                                                "text": "„Im Mittelpunkt stand die Liebe.“"
                                            },
                                            {
                                                "example_id": "b9a93dca-2558-4c8d-8424-97b5e2a16cd9",
                                                "sense_id": "01a2de42-1818-3fcb-9759-dfabf1f1b70b",
                                                "text": "„Die Gefühle, die sie durchströmen und tragen, sind Liebe, Schutzbedürfnis und Hingabe.“"
                                            },
                                            {
                                                "example_id": "11a8fc99-8c67-4540-ac27-1441f9466a69",
                                                "sense_id": "01a2de42-1818-3fcb-9759-dfabf1f1b70b",
                                                "text": "„Erst zu Beginn der Fastenzeit, nach Abreise der Schauspieler, begann ich, mich wieder ernsthaft mit meiner Liebe zu beschäftigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4b76f68-9a1f-349f-b519-470f97bb698a",
                                        "entry_id": "98ba3e34-823f-3b1c-9944-96b49921ba6b",
                                        "glosses": [
                                            "sexuell oder erotisch motivierte Neigung zu jemandem oder zu einer Sache"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7168b48-a94c-4e44-a9b9-c3a472ba1716",
                                                "sense_id": "e4b76f68-9a1f-349f-b519-470f97bb698a",
                                                "text": "homosexuelle Liebe, lesbische Liebe"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f06bab44-6e44-3535-b0f0-23355329ae54",
                                        "entry_id": "98ba3e34-823f-3b1c-9944-96b49921ba6b",
                                        "glosses": [
                                            "Geschlechtsakt; Akt der körperlichen Vereinigung in Folge von [2]"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df9aa3cd-3517-43db-ab23-cc53fa796325",
                                                "sense_id": "f06bab44-6e44-3535-b0f0-23355329ae54",
                                                "text": "Sie machten Liebe, ohne an die Konsequenzen zu denken."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "430659e7-9f4e-3413-94d8-03e1df11828f",
                                        "entry_id": "98ba3e34-823f-3b1c-9944-96b49921ba6b",
                                        "glosses": [
                                            "Liebschaft"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0c3fe36-c975-4449-b949-4700f6d867ba",
                                                "sense_id": "430659e7-9f4e-3413-94d8-03e1df11828f",
                                                "text": "Seine Lieben sind wohlbekannt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "ba701cf2-3279-3f93-afc5-69297e9567cd",
                                        "entry_id": "98ba3e34-823f-3b1c-9944-96b49921ba6b",
                                        "glosses": [
                                            "innige und gefühlsbetonte Beziehung zu einer Sache, einer Idee, einem Ziel oder Ähnlichem"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53022c93-b935-4589-950b-90c6bd355f8d",
                                                "sense_id": "ba701cf2-3279-3f93-afc5-69297e9567cd",
                                                "text": "Eberhards Liebe zu seiner Modelleisenbahn ist ungebrochen."
                                            },
                                            {
                                                "example_id": "85b73134-eb59-4c22-962c-8c1a844bbcc8",
                                                "sense_id": "ba701cf2-3279-3f93-afc5-69297e9567cd",
                                                "text": "„Es verstärkte ihre Liebe zum Mysterium.“"
                                            },
                                            {
                                                "example_id": "ce033a52-8dfd-4013-a197-427a2885bffb",
                                                "sense_id": "ba701cf2-3279-3f93-afc5-69297e9567cd",
                                                "text": "Mit viel Liebe zum Detail hat Irmi ihr Haus renoviert."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "f3518904-1cf2-390e-8b93-e28e11bba739",
                                        "entry_id": "98ba3e34-823f-3b1c-9944-96b49921ba6b",
                                        "glosses": [
                                            "unter Aufbietung großer Sorgfalt und Anteilnahme"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15bbb7a9-d284-494c-8b99-654df071ed88",
                                                "sense_id": "f3518904-1cf2-390e-8b93-e28e11bba739",
                                                "text": "Jeden Tag kümmert Gertrude sich mit viel Liebe um ihren Kräutergarten."
                                            },
                                            {
                                                "example_id": "31a07086-a7e9-43fd-b498-564a85f75a1a",
                                                "sense_id": "f3518904-1cf2-390e-8b93-e28e11bba739",
                                                "text": "„Der Einblattdruck ist mit viel Liebe zum grausamen Detail gestaltet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "a1fa9b50-7d8f-3856-b2af-dfd0b284c785",
                                        "entry_id": "98ba3e34-823f-3b1c-9944-96b49921ba6b",
                                        "glosses": [
                                            "Freundschaftsdienst, Gefälligkeit"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e904e2d5-6358-4b9e-9eb6-5bc7eeb1f6a5",
                                                "sense_id": "a1fa9b50-7d8f-3856-b2af-dfd0b284c785",
                                                "text": "Erweise mir die Liebe und kaufe für mich ein."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "151aa327-2a28-35a9-b02e-365975560877",
                                        "entry_id": "98ba3e34-823f-3b1c-9944-96b49921ba6b",
                                        "glosses": [
                                            "Mensch/Person, den man liebt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57a6d1ba-d522-4a2a-93e2-781aa96d9958",
                                                "sense_id": "151aa327-2a28-35a9-b02e-365975560877",
                                                "text": "Johannes war meine erste Liebe."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Liebe",
