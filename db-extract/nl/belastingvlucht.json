                                "example_id": "58968d53-e337-4aaf-b8ee-cee5bf86bd23",
                                "sense_id": "fbcc4fd2-9c16-3141-bf4d-f75320f42ff4",
                                "text": "VK:ook belastingvlucht bedrijven NL"
                            },
                            {
                                "example_id": "ddc7cd92-4134-45b7-8444-e57036ddf5f0",
                                "sense_id": "fbcc4fd2-9c16-3141-bf4d-f75320f42ff4",
                                "text": "\"Onze problemen zouden zijn opgelost als we de helft van dat bedrag konden innen,\" zei Lekkas. De belastingvlucht uit Griekenland komt neer op 12 à 15 procent van de hele Griekse economie."
                            }
                        ]
