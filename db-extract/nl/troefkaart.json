                                    },
                                    {
                                        "sense_id": "667a9580-730a-3eb6-9931-78084cf1937f",
                                        "entry_id": "1157147d-742a-3380-af4e-d0aabdfd755f",
                                        "glosses": [
                                            "To fart."
