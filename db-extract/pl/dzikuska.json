                "translations": [
                    {
                        "translation_id": "567f4f79-29bc-47cd-9d30-27a06d506a43",
                        "source_entry_id": "9498da78-99da-3df6-a606-eda85591cc9c",
                        "source_sense_id": "52a8898c-fa1f-34fe-aaa4-f8ca8f3500c3",
                        "target_lang_word": "дика́рка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дика́рка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f0869371-3c67-3dbb-9cf9-220aa0461ede",
                                        "entry_id": "921c5c74-9eb5-34ec-8487-2ec3dd8882db",
                                        "glosses": [
                                            "женск. к дикарь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4a20f1f-dde5-4de7-b432-08b94df27e10",
                                                "sense_id": "f0869371-3c67-3dbb-9cf9-220aa0461ede",
                                                "text": "Хозяин Джеймс Кларк работает слесарем в городке миль за тридцать, а Долли Кларк тут с хозяйством и ребятишками. ― Я дикарка. Выросла в этих местах, езжу на лошади, автомобиль вожу, трактор."
                                            },
                                            {
                                                "example_id": "78e59b18-27a0-4cbb-ba2a-ca11415baa3a",
                                                "sense_id": "f0869371-3c67-3dbb-9cf9-220aa0461ede",
                                                "text": "Там черноглазая, с серебряным огнем, дикарка проходит в умершей цапле, за которой уже охотится на том свете хитрый мертвый дикарь с копьем в мертвой руке; на улицах пасутся стада тонкорунных людей, и нигде так не мечтается о Хреновском заводе кровного человеководства, как здесь."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "596663e6-20cd-4e50-a135-2e91289a5f02",
                        "source_entry_id": "9498da78-99da-3df6-a606-eda85591cc9c",
                        "source_sense_id": "52a8898c-fa1f-34fe-aaa4-f8ca8f3500c3",
                        "target_lang_word": "ва́рварка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ва́рварка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7f4cd349-fbf5-31a4-ae46-7eed90037ede",
                                        "entry_id": "8c5a0c24-cf4b-3399-9a19-d86ec47c01ad",
                                        "glosses": [
                                            "устар. и прост. женск. к варвар"
                                        ],
