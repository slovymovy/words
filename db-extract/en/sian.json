                        "entry_id": "165801e8-ac3f-34d0-ab3c-a369b628e955",
                        "glosses": [
                            "Bored, weary or fed-up; tired (of something)."
                        ],
                        "tags": [
                            "Singapore",
                            "Singlish",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "341633cc-b166-4ca8-bcf1-757a41e8639f",
                                "sense_id": "f04511ce-89de-3e5b-8388-924759812f74",
                                "text": "[Y]ou know you’re not the only one around who is bored and sian and tired of being bored and sian."
                            },
                            {
                                "example_id": "b4ddbf08-470c-467e-a362-660391937196",
                                "sense_id": "f04511ce-89de-3e5b-8388-924759812f74",
                                "text": "“In a country where aspiration drives so much of who we are and what we want, it’s particularly sian to feel stuck,” he suggested."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b956feb-a97d-3014-9540-30dbfdd94ac0",
                        "entry_id": "165801e8-ac3f-34d0-ab3c-a369b628e955",
                        "glosses": [
                            "Repetitive and boring, wearisome."
                        ],
                        "tags": [
