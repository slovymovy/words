                ],
                "senses": [
                    {
                        "sense_id": "eae86760-5b5e-34bf-a17a-d86c248a7172",
                        "entry_id": "54a93c5c-533a-303a-9292-fb7b6c8e2dce",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7acf0c3-2007-45e7-befe-85c6c1d547e5",
                                "sense_id": "eae86760-5b5e-34bf-a17a-d86c248a7172",
                                "text": "Frau Bessel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c16d94c5-889c-4082-842e-084a3495c634",
                                "sense_id": "eae86760-5b5e-34bf-a17a-d86c248a7172",
                                "text": "Herr Bessel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b767bc4d-6b6d-4914-8f72-8ea43cc19118",
                                "sense_id": "eae86760-5b5e-34bf-a17a-d86c248a7172",
                                "text": "Die Bessels fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "230cb7a8-81e4-430a-805c-6d16865fbdbc",
                                "sense_id": "eae86760-5b5e-34bf-a17a-d86c248a7172",
                                "text": "Der Bessel trägt nie die Pullover, die die Bessel ihm strickt."
                            },
                            {
                                "example_id": "c710379a-1c75-449f-ab7a-9ea26eff8367",
                                "sense_id": "eae86760-5b5e-34bf-a17a-d86c248a7172",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bessel kommt, geht der Herr Bessel.“"
                            },
                            {
                                "example_id": "fe9bd2eb-474e-4ec0-b07a-29188b1687cf",
                                "sense_id": "eae86760-5b5e-34bf-a17a-d86c248a7172",
                                "text": "Bessel kommt und geht."
                            },
                            {
                                "example_id": "ac0136ba-e6e4-4eea-9777-771a1c04f44d",
                                "sense_id": "eae86760-5b5e-34bf-a17a-d86c248a7172",
                                "text": "Bessels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
