                                "target_senses": [
                                    {
                                        "sense_id": "e45e20be-9cf1-35f9-8b29-d79c1c76371b",
                                        "entry_id": "82964515-38b1-3d92-a753-3635bd15ee2a",
                                        "glosses": [
                                            "künstlich angelegte Wasserstraße, die die Landenge von Panama durchschneidet und dadurch den Atlantik mit dem Pazifik verbindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17d3f143-d5b3-415c-aa9e-d3c851bcfce7",
                                                "sense_id": "e45e20be-9cf1-35f9-8b29-d79c1c76371b",
                                                "text": "„Der Nord-Ostsee-Kanal ist die meistbefahrene künstliche Wasserstraße der Welt; ihn passieren mehr Schiffe als Panama- und Sueskanal zusammen.“"
                                            },
                                            {
                                                "example_id": "0dff3ec8-7336-499f-896a-54002a5d9e67",
                                                "sense_id": "e45e20be-9cf1-35f9-8b29-d79c1c76371b",
                                                "text": "„Die Vereinigten Staaten hatten sich eingemischt, weil sie fürchteten, die Unruhen könnten den Baubeginn des Panamakanals verzögern.“"
                                            },
                                            {
                                                "example_id": "0b4fdcb2-8f30-437a-b030-60fa3a08e4eb",
                                                "sense_id": "e45e20be-9cf1-35f9-8b29-d79c1c76371b",
                                                "text": "„Nach sechzehn Tagen, der Panamakanal lag hinter uns, liefen wir die große Hafenstadt Guayaquil in Ecuador an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
