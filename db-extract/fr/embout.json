                        "cross_references": [
                            {
                                "target_word": "dop",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "49d1cb70-85da-36b1-8472-60e9c90cdbc6",
                                        "entry_id": "6441bde1-28dc-39c1-b6f7-29d8ae1c7501",
                                        "glosses": [
                                            "een stevig omhulsel, ongeveer in de vorm van een halve bol"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef85ab8d-03fb-4ac7-bd74-ee228463d4d8",
                                                "sense_id": "49d1cb70-85da-36b1-8472-60e9c90cdbc6",
                                                "text": "Om een walnoot te eten, moet je eerst de dop kraken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e59ee38-dffb-3ff3-91f0-1711554d4015",
                                        "entry_id": "6441bde1-28dc-39c1-b6f7-29d8ae1c7501",
                                        "glosses": [
                                            "kapje ter afsluiting van iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2d4e9d9-ce34-4ca0-ad5f-620d2a0ce3e3",
                                                "sense_id": "7e59ee38-dffb-3ff3-91f0-1711554d4015",
                                                "text": "Doe even de dop op die fles!"
                                            },
                                            {
                                                "example_id": "9a04aac6-10b4-44ce-870d-499bf68afee8",
                                                "sense_id": "7e59ee38-dffb-3ff3-91f0-1711554d4015",
                                                "text": "Maar Quick pakte de gin van een tafel in de hoek, draaide de dop los en schonk twee glazen in."
                                            },
                                            {
                                                "example_id": "dfbd0630-0570-4e9b-a49e-7030cf610778",
                                                "sense_id": "7e59ee38-dffb-3ff3-91f0-1711554d4015",
                                                "text": "De fles was gelukkig groot genoeg en uiteindelijk kon ik met een zucht van verlichting de dop erop draaien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a1305b5-76d6-3abd-8d47-680ce740aac3",
                                        "entry_id": "6441bde1-28dc-39c1-b6f7-29d8ae1c7501",
                                        "glosses": [
                                            "oogleden"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f49bd2c1-95bb-4269-b71f-2d9638f90fcc",
                                                "sense_id": "4a1305b5-76d6-3abd-8d47-680ce740aac3",
                                                "text": "Kijk uit je doppen!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac8f6644-bf2a-3404-a8d9-6cd13c1bfd5a",
                                        "entry_id": "6441bde1-28dc-39c1-b6f7-29d8ae1c7501",
                                        "glosses": [
                                            "eierschaal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "346d55e3-5616-49bc-a859-68927f8bef89",
                                                "sense_id": "ac8f6644-bf2a-3404-a8d9-6cd13c1bfd5a",
                                                "text": "Beter een half ei dan een lege dop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ee1f5a7-50b0-3a3b-abeb-93980a1d7c26",
                                        "entry_id": "6441bde1-28dc-39c1-b6f7-29d8ae1c7501",
                                        "glosses": [
                                            "onderdeel van een dopsleutel dat rond een moer of boutkop sluit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22d87371-6b7f-4af7-8826-668b0d3e5ef0",
                                                "sense_id": "9ee1f5a7-50b0-3a3b-abeb-93980a1d7c26",
                                                "text": "In de auto ligt een kruisleutel met vier doppen."
                                            }
                                        ]
                                    }
                                ]
                            },
