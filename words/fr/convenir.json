                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois <w>convenir</w> que cette tâche est plus complexe que prévu.",
                            "target_lang_translations": {
                                "en": "I must <w>admit</w> that this task is more complex than expected.",
                                "ru": "Я должен <w>признать</w>, что эта задача сложнее, чем ожидалось.",
                                "nl": "Ik moet <w>toegeven</w> dat deze taak ingewikkelder is dan verwacht.",
                                "de": "Ich muss <w>zugeben</w>, dass diese Aufgabe komplexer ist als erwartet.",
                                "pl": "Muszę <w>przyznać</w>, że to zadanie jest bardziej złożone, niż przewidywano.",
                                "it": "Devo <w>ammettere</w> che questo compito è più complesso del previsto.",
                                "cs": "Musím <w>přiznat</w>, že tento úkol je složitější, než se čekalo.",
                                "tr": "Bu görevin beklenenden daha karmaşık olduğunu <w>kabul</w> <w>etmeliyim</w>.",
                                "es": "Debo <w>reconocer</w> que esta tarea es más compleja de lo previsto.",
                                "zh": "我必须<w>承认</w>，这项任务比预期的要复杂。"
                            }
                        },
                        {
                            "text": "Il a fini par en <w>convenir</w> après une longue discussion.",
                            "target_lang_translations": {
                                "en": "He finally <w>admitted</w> it after a long discussion.",
                                "ru": "В конце концов он <w>признал</w> это после долгого обсуждения.",
                                "nl": "Na een lange discussie heeft hij het uiteindelijk <w>toegegeven</w>.",
                                "de": "Nach einer langen Diskussion hat er es schließlich <w>zugegeben</w>.",
                                "pl": "Po długiej dyskusji w końcu to <w>przyznał</w>.",
                                "it": "Alla fine, dopo una lunga discussione, lo ha <w>ammesso</w>.",
                                "cs": "Po dlouhé diskusi to nakonec <w>přiznal</w>.",
                                "tr": "Uzun bir tartışmanın ardından sonunda bunu <w>kabul</w> <w>etti</w>.",
                                "es": "Después de una larga discusión, al final lo <w>admitió</w>.",
                                "zh": "经过长时间的讨论，他终于<w>承认</w>了。"
                            }
