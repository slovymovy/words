                {
                    "sense_id": "04586543-09d8-35cd-b176-fc94bad963ab",
                    "sense_definition": "По-прежнему не, так и не; указывает на то, что ожидаемое действие долго не происходит, несмотря на попытки.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "negation_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы всё <w>никак</w> не встретимся, хотя живём рядом.",
                            "target_lang_translations": {
                                "en": "We <w>still</w> haven't met, even though we live nearby.",
                                "zh": "虽然我们住得很近，但却<w>迟迟</w>没能见上一面。",
                                "nl": "We <w>lukken</w> er <w>maar niet</w> in om af te spreken, hoewel we dicht bij elkaar wonen.",
                                "pl": "Wciąż nie możemy się <w>spotkać</w>, chociaż mieszkamy blisko.",
                                "de": "Wir schaffen es <w>einfach</w> nicht, uns zu treffen, obwohl wir nah beieinander wohnen.",
                                "fr": "Nous n'arrivons <w>toujours pas</w> à nous rencontrer, bien que nous vivions à côté.",
                                "it": "Non riusciamo <w>ancora</w> a vederci, anche se viviamo vicini.",
                                "cs": "Pořád se <w>nijak</w> nemůžeme sejít, i když bydlíme blízko.",
                                "tr": "Yakın yaşamamıza rağmen <w>bir türlü</w> görüşemedik.",
                                "es": "Todavía no <w>hemos logrado</w> vernos, aunque vivimos cerca."
                            }
                        },
                        {
                            "text": "Дождь всё <w>никак</w> не прекращался.",
                            "target_lang_translations": {
                                "en": "The rain <w>just</w> wouldn't stop.",
                                "zh": "雨<w>一直没</w>停。",
                                "nl": "De regen <w>wilde maar niet</w> ophouden.",
                                "pl": "Deszcz wciąż nie chciał <w>przestać</w> padać.",
                                "de": "Der Regen wollte <w>einfach</w> nicht aufhören.",
                                "fr": "La pluie ne s'arrêtait <w>toujours pas</w>.",
                                "it": "La pioggia proprio <w>non</w> smetteva.",
                                "cs": "Déšť <w>pořád</w> neustával.",
                                "tr": "Yağmur <w>bir türlü</w> dinmiyordu.",
                                "es": "La lluvia <w>simplemente</w> no paraba."
                            }
                        }
                    ],
                    "synonyms": [
                        "так и не"
                    ],
                    "common_phrases": [
                        "всё никак",
                        "всё никак не"
                    ],
                    "target_lang_definitions": {
                        "en": "Still not, just not; indicates that an expected action has not happened for a long time despite attempts.",
                        "zh": "表示预期的动作经过很长时间仍未发生，意为一直没、迟迟不。",
                        "nl": "Nog steeds niet, maar niet; geeft aan dat een verwachte handeling ondanks pogingen lang uitblijft.",
                        "pl": "Wciąż nie, nadal nie; wskazuje na to, że oczekiwana czynność długo nie następuje mimo prób.",
                        "de": "Immer noch nicht; weist darauf hin, dass eine erwartete Handlung trotz Versuchen über längere Zeit nicht eintritt.",
                        "fr": "Toujours pas, ne pas encore ; indique qu'une action attendue ne se produit pas malgré le temps qui passe ou les tentatives.",
                        "it": "Ancora non, continua a non; indica che un'azione attesa non si verifica da molto tempo nonostante i tentativi.",
                        "cs": "Stále ne, pořád ne; vyjadřuje, že očekávaná událost navzdory snaze dlouho nenastává.",
                        "tr": "Hala değil, bir türlü; beklenen bir eylemin çabalara rağmen uzun süre gerçekleşmediğini belirtir.",
                        "es": "Todavía no, aún no; indica que una acción esperada no ocurre a pesar del paso del tiempo o los intentos."
                    },
                    "translations": {
