                                "fr": "Il fait <w>parfois</w> très froid ici en hiver.",
                                "it": "Qui in inverno <w>a volte</w> fa molto freddo.",
                                "cs": "V zimě je tu <w>někdy</w> velmi chladno.",
                                "tr": "Kışın burası <w>bazen</w> çok soğuk olur.",
                                "es": "<w>A veces</w> hace mucho frío aquí en el invierno."
                            }
