                                "target_senses": [
                                    {
                                        "sense_id": "16a140bc-4451-3dc9-95ea-ab2475e30679",
                                        "entry_id": "90342e25-db4c-3562-a1f6-0e1a1f4f446c",
                                        "glosses": [
                                            "Rupture, fracture."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b75c52f-d479-415f-939f-df597d668faa",
                                                "sense_id": "16a140bc-4451-3dc9-95ea-ab2475e30679",
                                                "text": "II paroît qu’à l’époque de la disruption des roches calcaires contre les roches schisteuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36902913-9b74-37a8-8a84-8765270ae22e",
                                        "entry_id": "90342e25-db4c-3562-a1f6-0e1a1f4f446c",
                                        "glosses": [
                                            "Interruption brutale du courant généré par le plasma thermonucléaire d’un tokamak."
                                        ],
                                        "tags": [
                                            "Fusion nucléaire",
                                            "Physique nucléaire",
                                            "magnétohydrodynamique",
                                            "physique des plasmas"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "090e514e-f6b2-4b8c-bcf9-48ef9de1d188",
                                                "sense_id": "36902913-9b74-37a8-8a84-8765270ae22e",
                                                "text": "Étude d'une méthode d'amortissement des disruptions d'un plasma de tokamak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2c53730-82d5-392a-b0be-1777c9838b51",
                                        "entry_id": "90342e25-db4c-3562-a1f6-0e1a1f4f446c",
                                        "glosses": [
                                            "Stratégie d’innovation par la remise en question des formes généralement pratiquées sur un marché, pour accoucher d’une « vision », créatrice de produits ou de services radicalement innovants."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11465044-18d8-4d01-8630-e8f20f2cf4fe",
                                                "sense_id": "c2c53730-82d5-392a-b0be-1777c9838b51",
                                                "text": "L’humanité vit désormais au rythme de la disruption. La disruption, c’est une innovation qui place son inventeur dans une situation de monopole quasi absolu du marché qu’il vient de créer - ce qui lui permet de rafler la mise, sans crainte de concurrent."
                                            },
                                            {
                                                "example_id": "a3d64dca-2f1d-4c9b-a474-60c3a9e6d43c",
                                                "sense_id": "c2c53730-82d5-392a-b0be-1777c9838b51",
                                                "text": "La disruption est une rupture, une innovation radicale qui rebat totalement les cartes d’un marché établi. Sa recette commence à être connue : un astucieux mélange d’esprit entrepreneurial et de nouvelles technologies « de rupture »."
                                            },
                                            {
                                                "example_id": "d94f6a32-9e2e-4f6e-9496-25b21d2305de",
                                                "sense_id": "c2c53730-82d5-392a-b0be-1777c9838b51",
                                                "text": "La colère des chauffeurs conventionnels et la chute du marché des licences de taxi illustrent les déboires de l'économie traditionnelle à lutter contre l'économie nouvelle. C’est ce que l’on qualifie dans le langage globish la disruption."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adf3452a-8cb2-34d1-8872-fdb68648d08a",
                                        "entry_id": "90342e25-db4c-3562-a1f6-0e1a1f4f446c",
                                        "glosses": [
                                            "Accélération de la société qui génère une perte de repères chez l’individu."
                                        ],
