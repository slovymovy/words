                "senses": [
                    {
                        "sense_id": "39397549-fc5f-305a-af9b-20d59dbf196e",
                        "entry_id": "44ed4697-3401-320b-abd5-cedb55a612ab",
                        "glosses": [
                            "Forme pronominale de apprêter : Se préparer, se mettre en état."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8328c085-be3e-4ff9-9a9c-57acff4aadd6",
                                "sense_id": "39397549-fc5f-305a-af9b-20d59dbf196e",
                                "text": "Fandor, déjà, s’apprêtait à resonner, soudain il eut un soupir de soulagement : une voix, à nouveau, lui parvenait, une voix familière, la voix de Juve !"
                            },
                            {
                                "example_id": "6a6537e5-4836-4b0b-b9ed-f74c895f3f8b",
                                "sense_id": "39397549-fc5f-305a-af9b-20d59dbf196e",
                                "text": "Je m’apprête à allumer la lampe. Je frotte une allumette. Elle ne prend pas, le phosphore s’écaille, elle se casse."
                            }
                        ]
                    }
                ],
                "translations": [
