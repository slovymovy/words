                ],
                "senses": [
                    {
                        "sense_id": "bdaf0c99-e705-35c2-9d2f-98dc64cdb6b2",
                        "entry_id": "f8e8685e-5d31-31f6-be95-356a1abc086a",
                        "glosses": [
                            "Tür zum Schlafzimmer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a649f7b-31f1-40ac-90a3-328ac6f165d2",
                                "sense_id": "bdaf0c99-e705-35c2-9d2f-98dc64cdb6b2",
                                "text": "„Er klopfte laut an der Schlafzimmertür, und einen Augenblick später erschien Hoffmanns hochgeschossene, wohlgepflegte Gestalt auf dem Balkon.“"
                            },
                            {
                                "example_id": "18cee8d3-69d0-4fcc-9523-49208bd68e33",
                                "sense_id": "bdaf0c99-e705-35c2-9d2f-98dc64cdb6b2",
                                "text": "„Sie weiß: im letzten Moment, bevor sie die Schlafzimmertür ins Schloß zieht, wird er einen wütenden Sturmlauf gegen die vordere Wand seiner Behausung unternehmen.“"
                            },
                            {
                                "example_id": "2bb3f09a-1f43-4e37-8d90-41f9914bc9be",
                                "sense_id": "bdaf0c99-e705-35c2-9d2f-98dc64cdb6b2",
                                "text": "„Er war lange im Zweifel gewesen, ob er die Schlafzimmertür offen lassen sollte.“"
                            },
                            {
                                "example_id": "9e8b85e5-fc93-45e9-b331-053bac0c6a3e",
                                "sense_id": "bdaf0c99-e705-35c2-9d2f-98dc64cdb6b2",
                                "text": "„Sie rissen die Schlafzimmertür auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
