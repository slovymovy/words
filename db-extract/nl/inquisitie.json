                "senses": [
                    {
                        "sense_id": "4af42242-eb70-385e-974f-5f7e0d91b3fe",
                        "entry_id": "31110e1b-6da1-3508-a07d-50f55e8420b8",
                        "glosses": [
                            "een rechtbank van de Rooms-Katholieke Kerk, die was belast met de opsporing, het onderzoek en het straffen van 'ketters' (niet-christenen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fab8397-1b52-4691-b6a8-96942f731fb0",
                                "sense_id": "4af42242-eb70-385e-974f-5f7e0d91b3fe",
                                "text": "veel joden en andersdenkenden zijn in de loop der eeuwen door de inquisitie op de brandstapel beland"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3038863-6fde-4ad7-a867-debaca79aca8",
                        "source_entry_id": "31110e1b-6da1-3508-a07d-50f55e8420b8",
                        "source_sense_id": "4af42242-eb70-385e-974f-5f7e0d91b3fe",
                        "source_sense_description": "een rechtbank van de Rooms-Katholieke Kerk, die was belast met de opsporing, het onderzoek en het opleggen van straffen van ketters",
                        "target_lang_word": "Inquisition",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inquisition",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                        "entry_id": "efc6103c-ee54-39da-ad1e-dfb6fc7bbe06",
                                        "glosses": [
                                            "Gericht der Kirche gegen Abtrünnige und solche, die Glaubenslehren ablehnten"
                                        ],
                                        "tags": [
                                            "zwischen dem 12. und dem 18. Jahrhundert"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21cc4acc-b459-4602-a22d-426ba73b8a9b",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "Anna Schwegelin wurde nicht durch die Inquisition, sondern durch ein weltliches Gericht zum Tode verurteilt."
                                            },
                                            {
                                                "example_id": "035b0f31-15e2-4cac-98ad-de2aff91c338",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "Giordano Bruno entging der Inquisition nicht."
                                            },
                                            {
                                                "example_id": "98329778-2ae6-4218-87db-b59d33847f08",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "„In manchen Kreisen hält sich hartnäckig das Gerücht, dies sei die moderne Variante der Inquisition.“"
                                            },
                                            {
                                                "example_id": "69a2836c-29f4-4773-9e22-412dd3034ea5",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "„Aber die Inquisition hatte zumindest keinen Hehl aus ihrem Tun gemacht.“"
                                            },
                                            {
                                                "example_id": "4a53ef48-b7e1-4ebf-956e-7973210e5fd3",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "„Ich wurde ein gewisses Angstgefühl der Inquisition gegenüber nicht los, und mir schien, als seien mir bereits einige Spitzel auf den Fersen.“"
                                            },
                                            {
                                                "example_id": "cb3474b3-0fd6-4336-ad67-3f1c57b72514",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "„Durch nichts hat das Christentum sich selbst, seiner eigenen Substanz nach so verraten und geschädigt wie mit den von der Inquisition entfesselten Verfolgungen, Folterungen und grausamen Hinrichtungen von Tausenden christlicher Menschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ceb8a1c-0cfc-4f44-ac59-59af1882f404",
                        "source_entry_id": "31110e1b-6da1-3508-a07d-50f55e8420b8",
                        "source_sense_id": "4af42242-eb70-385e-974f-5f7e0d91b3fe",
                        "source_sense_description": "een rechtbank van de Rooms-Katholieke Kerk, die was belast met de opsporing, het onderzoek en het opleggen van straffen van ketters",
                        "target_lang_word": "inquisition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inquisition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "767aa2a2-61ac-3496-aa0a-7d263ffd4e52",
                                        "entry_id": "8d796c5c-8a21-356b-9bf3-270ae3b229e8",
                                        "glosses": [
                                            "An inquiry or investigation into the truth of some matter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "624a449b-0b03-4717-85ca-83d97aa0b416",
                                                "sense_id": "767aa2a2-61ac-3496-aa0a-7d263ffd4e52",
                                                "text": "But as farrefoorth as I coulde learne, through earneſt inquiſition I thoughte in my conſcience the woman was not gilty, all the circumſtances well conſydered."
                                            },
                                            {
                                                "example_id": "f479d6f2-a30e-453a-be58-e98d8b0e1886",
                                                "sense_id": "767aa2a2-61ac-3496-aa0a-7d263ffd4e52",
                                                "text": "Let not search and inquisition quail / To bring again these foolish runaways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cd5e401-1b9c-3ee9-98b4-7035166ddeec",
                                        "entry_id": "8d796c5c-8a21-356b-9bf3-270ae3b229e8",
                                        "glosses": [
                                            "An inquiry or investigation into the truth of some matter.",
                                            "Such an investigation that is asserted to be persecutory by its adversaries."
                                        ],
                                        "tags": [
                                            "countable",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ea4e548-63a4-3175-a405-2f26dfa7dbdd",
                                        "entry_id": "8d796c5c-8a21-356b-9bf3-270ae3b229e8",
                                        "glosses": [
                                            "An inquest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "812cd0b3-8864-3a55-a22c-701d8f09b2e8",
                                        "entry_id": "8d796c5c-8a21-356b-9bf3-270ae3b229e8",
                                        "glosses": [
                                            "A questioning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "576757d4-dec6-3ef6-ae84-5c0c4561b693",
                                        "entry_id": "8d796c5c-8a21-356b-9bf3-270ae3b229e8",
                                        "glosses": [
                                            "The finding of a jury, especially such a finding under a writ of inquiry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9732746c-6865-4834-8d69-d03d5b96858b",
                                                "sense_id": "576757d4-dec6-3ef6-ae84-5c0c4561b693",
                                                "text": "The justices in eyre had it formerly in charge to make inquisition concerning them by a jury of the county."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inquisition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a523f927-38a5-3fee-952b-662b4097316c",
                                        "entry_id": "53071eae-c258-3e0b-bde7-52db66c5f334",
                                        "glosses": [
                                            "To make inquisition concerning; to inquire into."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d2caa29-b89d-465e-95f7-8a5512050d7f",
                                                "sense_id": "a523f927-38a5-3fee-952b-662b4097316c",
                                                "text": "And in their name I shall for neither friend nor foe conceal what the general murmur is ; that if it come to inquisitioning again"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e7818d7-c855-4322-9ad3-ea76aabf7d2b",
                        "source_entry_id": "31110e1b-6da1-3508-a07d-50f55e8420b8",
                        "source_sense_id": "4af42242-eb70-385e-974f-5f7e0d91b3fe",
                        "source_sense_description": "een rechtbank van de Rooms-Katholieke Kerk, die was belast met de opsporing, het onderzoek en het opleggen van straffen van ketters",
                        "target_lang_word": "inquisition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inquisition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c3f8c73-efdf-32f5-8be2-bca72cb7822f",
                                        "entry_id": "0fcb71ca-ce29-3881-b62f-279caefe6022",
                                        "glosses": [
                                            "Enquête, recherche."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29250760-f0ec-3fed-ae0d-6efb25aacfa6",
                                        "entry_id": "0fcb71ca-ce29-3881-b62f-279caefe6022",
                                        "glosses": [
                                            "Tribunal établi par l’Église, surtout à partir du XIIIᵉ siècle, en certains pays pour rechercher et punir ceux qui avaient des sentiments contraires à la foi catholique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ce6e38-992e-4dda-b5d3-e4b1a58b1ca8",
                                                "sense_id": "29250760-f0ec-3fed-ae0d-6efb25aacfa6",
                                                "text": "Peut-être faut-il attribuer cette froideur dans la pratique très-exacte, minutieuse même des devoirs religieux, à l’inquisition, qui a fait des chrétiens espagnols, des catholiques qui semblent ne l’être que tout juste autant qu’il faut pour ne pas être damnés."
                                            },
                                            {
                                                "example_id": "d68d9497-eb47-493b-8a7e-03ea021e589e",
                                                "sense_id": "29250760-f0ec-3fed-ae0d-6efb25aacfa6",
                                                "text": "On sent que s'il le pouvait il rétablirait l’inquisition et les autodafés, rien que pour se donner la joie âcre et cruelle de condamner les Juifs et de les voir rôtir à petit feu. Il en convient d'ailleurs sans peine."
                                            },
                                            {
                                                "example_id": "ddb10bd8-6571-4dc9-a2a9-1cfa2c71e9fd",
                                                "sense_id": "29250760-f0ec-3fed-ae0d-6efb25aacfa6",
                                                "text": "— Vous oubliez, répliqua M. Mazure, que le moyen âge a connu la philanthropie de l’espèce la plus abominable, la philanthropie spirituelle. Car c’est bien ce nom que mérite l’esprit de la sainte Inquisition. Ce tribunal livrait les hérétiques au bûcher par charité pure. Et, s’il sacrifiait le corps, c’était, disait-il, pour sauver l’âme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acf44b66-5af6-3b35-a301-a154504919f4",
                                        "entry_id": "0fcb71ca-ce29-3881-b62f-279caefe6022",
                                        "glosses": [
                                            "Ensemble des membres de cette juridiction."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27d52f58-551b-3d99-8939-1b83dcc77b55",
                                        "entry_id": "0fcb71ca-ce29-3881-b62f-279caefe6022",
                                        "glosses": [
                                            "Enquête, recherche où il se mêle de l’arbitraire et une curiosité souvent indiscrète."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b6d0a78-f8ba-44f7-b0af-99d5d4287c61",
                                                "sense_id": "27d52f58-551b-3d99-8939-1b83dcc77b55",
                                                "text": "Les transferts internationaux étant ultraréglementés, si vous envoyez de l’argent ou en recevez, attendez-vous à subir l’inquisition du banquier."
                                            },
                                            {
                                                "example_id": "921250a8-19ef-434d-b786-2a7a6a07eb17",
                                                "sense_id": "27d52f58-551b-3d99-8939-1b83dcc77b55",
                                                "text": "Sur le fond, les clivages entre les quatre principaux candidats (MM. George Bush et John McCain côté républicain, MM. Albert Gore et Bill Bradley côté démocrate) restent tout à fait modestes. Les premiers cherchent surtout à se distinguer du radicalisme ultra-réactionnaire qui a marqué — et pénalisé — le parti républicain depuis son triomphe électoral de novembre 1994 : alliance avec les extrémistes religieux, acharnement contre les pauvres, inquisition moralisatrice contre les transgressions morales et légales du président Clinton."
                                            },
                                            {
                                                "example_id": "3860f895-2968-4ba9-a9ff-156b2035394d",
                                                "sense_id": "27d52f58-551b-3d99-8939-1b83dcc77b55",
                                                "text": "N’importe quel Américain peut tomber à un moment ou à un autre sous les fourches caudines de cette inquisition démocratique. À la réprobation compréhensive de l’adultère en France répond sa condamnation outre-Atlantique : c'est plus qu’un faux pas, une faute qui mérite sanction judiciaire et rééducation psychiatrique."
                                            },
                                            {
                                                "example_id": "62443558-0df6-4ea5-b270-697c77bbc922",
                                                "sense_id": "27d52f58-551b-3d99-8939-1b83dcc77b55",
                                                "text": "D’aucuns dénoncent un tribunal populaire, un lynchage médiatique, une inquisition 2.0."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
