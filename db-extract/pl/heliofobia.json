                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "2412345d-ab15-48a9-ad06-a0e704c4888a",
                                "sense_id": "161d8adf-6a5d-3d2c-bed7-66360828ff4f",
                                "text": "Leczenie heliofobii często wymaga współpracy z psychoterapeutą."
                            },
                            {
                                "example_id": "c6c8c33b-2b7f-4d7a-951c-fec4b050c733",
                                "sense_id": "161d8adf-6a5d-3d2c-bed7-66360828ff4f",
                                "text": "Psycholog zaproponował terapię poznawczo-behawioralną, aby pomóc mi zwalczyć heliofobię."
                            },
                            {
                                "example_id": "a31f25c9-85a1-4be8-bbec-7bdfbc812f0f",
                                "sense_id": "161d8adf-6a5d-3d2c-bed7-66360828ff4f",
                                "text": "Na zajęciach z psychologii omawialiśmy przypadek osoby z zaawansowaną heliofobią."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
