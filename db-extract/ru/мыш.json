                "senses": [
                    {
                        "sense_id": "94835a27-7d93-3ca3-b58b-aa1f5db6b180",
                        "entry_id": "e172453a-0d74-38eb-aa96-492bf98a9785",
                        "glosses": [
                            "разг. шутл., комп. жарг. мышь (во всех значениях, особенно если надо подчеркнуть, что это самец мыши)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eedbaa3-dfd9-416d-9080-df3ee2d65493",
                                "sense_id": "94835a27-7d93-3ca3-b58b-aa1f5db6b180",
                                "text": "Представляешь, вчера в офисе мыша́ поймали."
                            },
                            {
                                "example_id": "8639ed7b-2b85-48b6-9ad5-fd1e42d3455c",
                                "sense_id": "94835a27-7d93-3ca3-b58b-aa1f5db6b180",
                                "text": "Кто ему на дно ковша бросил дохлого мыша́?"
                            },
                            {
                                "example_id": "e2078d5d-e0e4-489e-ad7d-cb71f5ea1016",
                                "sense_id": "94835a27-7d93-3ca3-b58b-aa1f5db6b180",
                                "text": "Мыш у нас пока только один — это Джерри."
                            }
                        ]
                    }
