    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "74ff6fe1-1624-3d9d-ad82-c3f6b8b1affc",
                    "sense_definition": "An organized series of special events, such as concerts, films, or plays, usually held in the same place once a year.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "celebration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought tickets for a famous music <w>festival</w> this summer.",
                            "target_lang_translations": {
                                "ru": "Этим летом мы купили билеты на известный музыкальный <w>фестиваль</w>.",
                                "zh": "今年夏天我们买了著名音乐<w>节</w>的票。"
                            }
                        },
                        {
                            "text": "The city hosts an international film <w>festival</w> every October.",
                            "target_lang_translations": {
                                "ru": "Каждый октябрь в городе проходит международный <w>фестиваль</w> кино.",
                                "zh": "这座城市每年十月都会举办国际电影<w>节</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "celebration",
                        "carnival",
                        "fair",
                        "gala",
                        "fiesta",
                        "jamboree",
                        "event"
                    ],
                    "common_phrases": [
                        "music festival",
                        "film festival",
                        "arts festival",
                        "summer festival",
                        "folk festival"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организованная серия культурных мероприятий, таких как концерты, фильмы или спектакли, обычно проводимая в одном месте раз в год.",
                        "zh": "一系列有组织的特别活动，如音乐会、电影或戏剧，通常每年在同一地点举办一次。"
                    },
                    "translations": {
                        "ru": [
                            {
