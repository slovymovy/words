                "translations": [
                    {
                        "translation_id": "06e04f14-4bbb-41a7-95fa-9ffd5cc5cc56",
                        "source_entry_id": "821f7e79-f569-3cbf-beec-af97346df419",
                        "source_sense_description": "действие",
                        "target_lang_word": "Erzeugnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzeugnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e4c3f63-a3f6-329d-92ee-ae6e3acdc22f",
                                        "entry_id": "69d9b3cb-1472-33e0-a7d5-d6874dd3b594",
                                        "glosses": [
                                            "Ergebnis eines Herstellungsprozesses (zum Beispiel eine Ware für den Handel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4362461-a84d-4568-b6a2-b5974ac9f734",
                                                "sense_id": "5e4c3f63-a3f6-329d-92ee-ae6e3acdc22f",
                                                "text": "Deutsche Erzeugnisse aus dem Bereich Maschinenbau erfreuen sich weltweit eines guten Rufes."
                                            },
                                            {
                                                "example_id": "33a2b1a4-0278-4d3e-8d8e-be9dd77089de",
                                                "sense_id": "5e4c3f63-a3f6-329d-92ee-ae6e3acdc22f",
                                                "text": "Das sind vor allem die Erlöse aus den Exporten landwirtschaftlicher Erzeugnisse, insbesondere Soja und Rindfleisch, deren Weltmarktpreise in den letzten Jahren kräftig anzogen."
                                            },
                                            {
                                                "example_id": "217910ca-23ca-4757-9835-8feaef0d2ffc",
                                                "sense_id": "5e4c3f63-a3f6-329d-92ee-ae6e3acdc22f",
                                                "text": "Insgesamt waren 42 Länder auf der Messe vertreten. 1.014 Aussteller präsentierten ihre Erzeugnisse."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9d39032-c65e-4c91-8741-6261e1aff2f2",
                        "source_entry_id": "821f7e79-f569-3cbf-beec-af97346df419",
                        "source_sense_description": "действие",
                        "target_lang_word": "Ausgeburt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausgeburt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6bfc730a-e377-3a2b-90d2-d7b3125183a5",
                                        "entry_id": "bd93c4e4-f4fa-34db-8232-c7b70607dc2c",
                                        "glosses": [
                                            "meist schlechtes (neues, junges) Erzeugnis von etwas"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "281dcefe-80b8-47d6-b7ec-47740b4da57f",
                                                "sense_id": "6bfc730a-e377-3a2b-90d2-d7b3125183a5",
                                                "text": "Niemand ahnt, dass die Frau eine Ausgeburt des Bösen gebären wird, die allen das Leben zur Hölle macht."
                                            },
                                            {
                                                "example_id": "4491b054-773e-4993-8daa-b253f93a7410",
                                                "sense_id": "6bfc730a-e377-3a2b-90d2-d7b3125183a5",
                                                "text": "„Jeder stillgelegte deutsche Kleinstadtbahnhof ist schöner als diese Ausgeburten einer verkrüppelten Phantasie, diese architektonischen Flughafen-Desaster in Köln oder Hamburg, Düsseldorf oder Hannover.“"
                                            },
                                            {
                                                "example_id": "27b0fd4b-b4d0-4b2a-a62c-ce903ad3732d",
                                                "sense_id": "6bfc730a-e377-3a2b-90d2-d7b3125183a5",
                                                "text": "„Wie oft hat er sich in Gedanken ausgemalt, was er mit Stalin anstellen würde, falls ihm diese Ausgeburt der Hölle in die Hände fiele.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
