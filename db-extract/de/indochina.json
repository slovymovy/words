                    {
                        "translation_id": "d8ba39ad-b35c-48c1-b093-ca8b5566ca08",
                        "source_entry_id": "742857f0-4178-335e-b851-9c87a47d0a77",
                        "source_sense_id": "9c95cfaf-4cdc-3e39-9ddc-8e5fbaf35ffd",
                        "source_sense_description": "Geographie: Indochinesische Halbinsel",
                        "target_lang_word": "Indochine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Indochine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97c6a50b-813f-356a-ab65-0611500ba8d7",
                                        "entry_id": "21833725-c691-334e-9379-9db169755783",
                                        "glosses": [
                                            "Péninsule du continent asiatique située au sud de la Chine et à l’est de l’Inde, comprenant la Birmanie, le Cambodge, le Laos, la Thaïlande et le Vietnam."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e13afa87-a8b5-43bc-8fb7-cbf1ed2907c1",
                                                "sense_id": "97c6a50b-813f-356a-ab65-0611500ba8d7",
                                                "text": "Certaines notions qui lui sont très familières aux siècles classiques — comme celles de l’hybris et de la némésis — se retrouvent chez des populations aussi peu évoluées que les tribus Moïs du sud de l’Indochine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16a08a22-5322-3b58-b59d-6f23d7c20c0e",
                                        "entry_id": "21833725-c691-334e-9379-9db169755783",
                                        "glosses": [
                                            "Indochine française."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba72eb8b-b8f4-4a1b-bd0f-5a11ecdd1fa4",
                                                "sense_id": "16a08a22-5322-3b58-b59d-6f23d7c20c0e",
                                                "text": "[…] il me touchait presque et hurlait: « Tu vas parler ! Tout le monde doit parler ici ! On a fait la guerre en Indochine, ça nous a servi pour vous connaître. Ici, c'est la Gestapo ! Tu connais la Gestapo ? »"
                                            },
                                            {
                                                "example_id": "5b6caf21-5a2a-444a-9e4c-457742582f61",
                                                "sense_id": "16a08a22-5322-3b58-b59d-6f23d7c20c0e",
                                                "text": "Je ne pense jamais au Siam sans évoquer le déjeuner que fit au Palais Royal le gouverneur de l’Indochine d’alors, M. Violette, accompagné de sa très digne épouse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91219ec9-a426-3c96-a453-9ca56d7e481e",
                                        "entry_id": "21833725-c691-334e-9379-9db169755783",
                                        "glosses": [
                                            "Guerre d’Indochine."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63a17f1f-d71e-4243-ae93-9bf32df9c635",
                                                "sense_id": "91219ec9-a426-3c96-a453-9ca56d7e481e",
                                                "text": "Je peux ajouter qu’un frère de Maria Soledad, qui avait aussi vécu la guerre d’Espagne, fit le coup de feu dans le maquis, puis s’engagea pendant cinq ans dans la Légion où il fit d’ailleurs l’Indochine…"
                                            },
                                            {
                                                "example_id": "aa249c47-684b-4917-9cf3-c39df5acd4a4",
                                                "sense_id": "91219ec9-a426-3c96-a453-9ca56d7e481e",
                                                "text": "J’avais un brigadier-chef qui avait fait l’Indochine, le parfait baroudeur, qui commençait à être violent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
