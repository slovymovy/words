    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ffd4387-a347-3e2b-b724-8768835bef28",
                    "sense_definition": "Great enthusiasm, enjoyment, or vigor in doing something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "enthusiasm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tackled the difficult project with great <w>gusto</w>.",
                            "target_lang_translations": {
                                "nl": "Ze pakte het moeilijke project met veel <w>enthousiasme</w> aan."
                            }
                        },
                        {
                            "text": "The children ate their dinner with <w>gusto</w> after playing outside all day.",
                            "target_lang_translations": {
                                "nl": "De kinderen aten hun avondeten met <w>smaak</w> op nadat ze de hele dag buiten hadden gespeeld."
                            }
                        }
                    ],
                    "synonyms": [
                        "enthusiasm",
                        "zest",
                        "vigor",
                        "enjoyment"
                    ],
                    "antonyms": [
                        "apathy",
                        "indifference"
                    ],
                    "common_phrases": [
                        "with gusto"
                    ],
                    "target_lang_definitions": {
                        "nl": "Grote geestdrift, enthousiasme of energie bij het uitvoeren van een activiteit."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "enthousiasme",
                                "target_lang_sense_clarification": "Algemene term voor geestdrift of bezieling."
                            },
                            {
                                "target_lang_word": "uitbundigheid",
                                "target_lang_sense_clarification": "Verwijst naar een energieke, levendige manier van doen."
                            },
                            {
                                "target_lang_word": "bezieling",
                                "target_lang_sense_clarification": "Duidt op een diepere, innerlijke gedrevenheid."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82d0cc0c-7591-391d-aa3d-4e3398ae5ab4",
                    "sense_definition": "The distinct flavor or savor of food.",
