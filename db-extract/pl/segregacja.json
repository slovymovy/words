                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d4b577d-2d72-3c06-a9e4-df57494ee1e7",
                                        "entry_id": "baa5cbb2-3577-3606-8211-4f9b41a1a053",
                                        "glosses": [
                                            "Separation for practical reasons, by necessity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4687f99-750a-4f35-bc18-ca888b3496be",
                                                "sense_id": "6d4b577d-2d72-3c06-a9e4-df57494ee1e7",
                                                "text": "It has long been recognised that complete segregation of control of the respective services provided by the two undertakings, and of the power supply, signalling, and tracks relating to each was desirable."
                                            }
