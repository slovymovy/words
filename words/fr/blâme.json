    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9bca0b17-aa8c-3abc-b83e-ab0913d41e1e",
                    "sense_definition": "Opinion défavorable ou désapprobation exprimée à propos des actes ou de la conduite de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "désapprobation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a dû porter tout le <w>blâme</w> pour les erreurs commises par son équipe."
                        },
                        {
                            "text": "Le directeur a préféré rejeter le <w>blâme</w> sur des circonstances extérieures imprévues."
                        }
                    ],
                    "synonyms": [
                        "critique",
                        "grief",
                        "reproche"
                    ],
                    "antonyms": [
                        "éloge"
                    ],
                    "common_phrases": [
                        "rejeter le blâme",
                        "porter le blâme",
                        "digne de blâme"
                    ]
                },
                {
                    "sense_id": "1d05af87-9b32-3da9-9dab-f6921ae38223",
                    "sense_definition": "Sanction disciplinaire ou réprimande officielle adressée à un fonctionnaire, un employé ou un élève.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sanction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs avertissements oraux, l'employé a finalement reçu un <w>blâme</w> écrit."
                        },
                        {
                            "text": "Le conseil de discipline a décidé d'infliger un simple <w>blâme</w> à cet étudiant."
                        }
                    ],
                    "synonyms": [
                        "réprimande"
                    ],
                    "common_phrases": [
                        "recevoir un blâme",
                        "infliger un blâme"
                    ]
                },
                {
                    "sense_id": "6c62ac50-de89-32e5-ac58-bad9a0b3f85c",
                    "sense_definition": "Réprimande solennelle prononcée par un tribunal ou un juge à l'encontre d'un justiciable.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sanction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans l'ancien droit, la sentence de <w>blâme</w> pouvait entacher l'honneur d'un citoyen."
                        },
                        {
                            "text": "Le magistrat prononça un <w>blâme</w> public contre l'accusé à l'issue du procès."
                        }
                    ],
                    "synonyms": [
                        "réprimande"
                    ],
                    "traits": [
                        {
