                    "sense_id": "0c96052f-4b91-3091-8b43-42e7677c1dfb",
                    "sense_definition": "een toestand van grote drukte, opwinding of publieke aandacht, vaak over iets onbeduidends",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er werd veel <w>ophef</w> gemaakt over de nieuwe regels op het kantoor.",
                            "target_lang_translations": {
                                "en": "A lot of <w>fuss</w> was made about the new rules at the office."
                            }
                        },
                        {
                            "text": "Waarom is er zoveel <w>ophef</w> over een simpele spelfout in de krant?",
                            "target_lang_translations": {
                                "en": "Why is there so much <w>commotion</w> over a simple spelling mistake in the newspaper?"
                            }
                        }
                    ],
