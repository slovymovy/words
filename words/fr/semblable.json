                    "frequency": "High",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux sœurs ont un visage très <w>semblable</w> mais des voix différentes."
                        },
                        {
                            "text": "Dans une situation <w>semblable</w>, il est recommandé de garder son calme."
                        }
                    ],
                    "synonyms": [
                        "similaire",
                        "analogue",
                        "pareil",
                        "équivalent",
                        "identique"
                    ],
                    "antonyms": [
                        "différent"
                    ],
                    "common_phrases": [
