                "senses": [
                    {
                        "sense_id": "4732cd7c-88b2-35f7-b697-0cb9d2032f90",
                        "entry_id": "8a025ab5-088a-35b6-baf0-e685e7964e96",
                        "glosses": [
                            "rolletje fijngekorven tabak in een omhulsel van speciaal papier, om daarin gerookt te worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4fe7a64-c608-456a-8928-21dc52a24165",
                                "sense_id": "4732cd7c-88b2-35f7-b697-0cb9d2032f90",
                                "text": "Sigaretten zijn slecht voor de gezondheid."
                            },
                            {
                                "example_id": "d58ec6cc-fa65-4e1d-b638-5dc5f09d8afa",
                                "sense_id": "4732cd7c-88b2-35f7-b697-0cb9d2032f90",
                                "text": "Hockney houdt zijn sigaret omhoog, de askegel valt op de grond. ‘Heeft iemand een asbak voor David?’"
                            },
                            {
                                "example_id": "bae1239c-ded0-4309-8a65-206d46077e99",
                                "sense_id": "4732cd7c-88b2-35f7-b697-0cb9d2032f90",
                                "text": "Hij had een sigaretje zitten roken."
                            },
                            {
                                "example_id": "0e6dce14-27de-4bc5-a68b-06bb8929ee5c",
                                "sense_id": "4732cd7c-88b2-35f7-b697-0cb9d2032f90",
                                "text": "Sarah prutste wat met het doosje op tafel en trok er een sigaret uit; haar polsen waren behangen met rammelende armbanden."
                            },
                            {
                                "example_id": "e1b33380-6f1b-4de1-aa51-2c6a059e28b8",
                                "sense_id": "4732cd7c-88b2-35f7-b697-0cb9d2032f90",
                                "text": "Isaac pakte de sigaret van haar aan en stak hem zelf op."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1d5903c-5ba2-45fd-b604-3ced6cd22444",
                        "source_entry_id": "8a025ab5-088a-35b6-baf0-e685e7964e96",
                        "source_sense_id": "4732cd7c-88b2-35f7-b697-0cb9d2032f90",
                        "source_sense_description": "in papier gerolde tabak",
                        "target_lang_word": "Zigarette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zigarette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4140977a-ba51-36eb-934a-4f0b7c3a0edc",
                                        "entry_id": "ed355d8d-6bf2-32cd-8d5c-59e631c5afc9",
                                        "glosses": [
                                            "rauchbares, in Papier gedrehtes Tabakprodukt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c2969f5-62af-4bf6-8db8-7e77086ed4cd",
                                                "sense_id": "4140977a-ba51-36eb-934a-4f0b7c3a0edc",
                                                "text": "Nach dem Essen rauche ich gerne eine Zigarette."
                                            },
                                            {
                                                "example_id": "9bafe3ad-2c35-4b76-ab3b-aa07b9c3e80f",
                                                "sense_id": "4140977a-ba51-36eb-934a-4f0b7c3a0edc",
                                                "text": "Haste mal ne Zigarette?"
                                            },
                                            {
                                                "example_id": "b36c7a13-c68f-4428-9e52-7d824ef7cfce",
                                                "sense_id": "4140977a-ba51-36eb-934a-4f0b7c3a0edc",
                                                "text": "„Für jeden zehn Zigarren, zwanzig Zigaretten und zwei Stück Kautabak, das ist sehr anständig.“"
                                            },
                                            {
                                                "example_id": "d743baf6-3591-4a89-898b-fc1d34338662",
                                                "sense_id": "4140977a-ba51-36eb-934a-4f0b7c3a0edc",
                                                "text": "„Fabian nahm eine Zigarette und strich das Zündholz so behutsam an, als fürchte er, der Reibfläche weh zu tun.“"
                                            },
                                            {
                                                "example_id": "34f88a51-ee01-4d82-bec4-29c9281b09d2",
                                                "sense_id": "4140977a-ba51-36eb-934a-4f0b7c3a0edc",
                                                "text": "„Juan rauchte gelangweilt eine Zigarette nach der anderen, wobei er die Stummel dann noch zu kauen schien.“"
                                            },
                                            {
                                                "example_id": "e3c788f5-f621-4b56-bc87-8b331fe0cf13",
                                                "sense_id": "4140977a-ba51-36eb-934a-4f0b7c3a0edc",
                                                "text": "„Der Stiefvater zündet sich eine Zigarette an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62b27962-f77c-45ab-aacd-8c1aacedc934",
                        "source_entry_id": "8a025ab5-088a-35b6-baf0-e685e7964e96",
                        "source_sense_id": "4732cd7c-88b2-35f7-b697-0cb9d2032f90",
                        "source_sense_description": "in papier gerolde tabak",
                        "target_lang_word": "cigarette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cigarette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39f0f96b-514c-3187-b52b-27b6250dd961",
                                        "entry_id": "57fa2e45-df1b-322c-ae27-ed03bb8bee83",
                                        "glosses": [
                                            "A small cigar consisting of tobacco or another substance, wrapped up in a thin roll with paper, intended for smoking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5555ad1-5a01-4290-a2cb-fc5a8f6a47ad",
                                                "sense_id": "39f0f96b-514c-3187-b52b-27b6250dd961",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or otherwise his man would be there with a message to say that his master would shortly join me if I would kindly wait."
                                            },
                                            {
                                                "example_id": "d5a6538b-8577-4998-8638-6cdf9b25066e",
                                                "sense_id": "39f0f96b-514c-3187-b52b-27b6250dd961",
                                                "text": "He rose to light my cigarette, then sank back into his wicker chair contentedly. The tea was weak, but not cold, thanks to the hot-plate."
                                            },
                                            {
                                                "example_id": "261a6cc7-99cb-4681-b044-3d30caf923ce",
                                                "sense_id": "39f0f96b-514c-3187-b52b-27b6250dd961",
                                                "text": "Tobacconist: Right. I want to try you on a course of these: one twenty times a day. Have you taken them before?\nPatient: Um, what is it?\nTobacconist: It's a simple nicotinal arsenous monoxid preparation taken bronchially as an infumation.\nPatient: Infumation?\nTobacconist: Yes, you just light the end and breathe it.\nPatient: What, like cigarettes?\nTobacconist: You know them then. Actually, it's a bit hard to admit but they're basically an herbal remedy... A leaf originally from the Americas, I believe, called tobacco.\nPatient: But medicated?\nTobacconist: Medicated? No.\nPatient: These are ordinary cigarettes?\nTobacconist: That's right.\nPatient: But they're terribly bad for you, aren't they?\nTobacconist: I hardly think I would be prescribing them if they were bad for you.\nPatient: Twenty a day?\nTobacconist: Yes, ideally moving on to about thirty or forty."
                                            },
                                            {
                                                "example_id": "cd8836ae-394e-418f-b169-5b715fb15c41",
                                                "sense_id": "39f0f96b-514c-3187-b52b-27b6250dd961",
                                                "text": "Grandma has an occasional cigarette, as well as Uncle Jimmy and Aunt Julie, and our kids give them crap about it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cigarette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c195951c-aa2a-3811-9b5a-b7c55f4b5948",
                                        "entry_id": "8dd3baa2-9c61-3b4f-b2ac-5294e19bdc43",
                                        "glosses": [
                                            "To give someone a cigarette, or to light one for them."
                                        ],
                                        "tags": [
                                            "rare",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c951b3ca-aa75-4ba5-9b3f-2d16fcfb6a09",
                                                "sense_id": "c195951c-aa2a-3811-9b5a-b7c55f4b5948",
                                                "text": "Could someone cigarette me?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7beec3a0-a726-4ee5-ad9e-0e846a24f323",
                        "source_entry_id": "8a025ab5-088a-35b6-baf0-e685e7964e96",
                        "source_sense_id": "4732cd7c-88b2-35f7-b697-0cb9d2032f90",
                        "source_sense_description": "in papier gerolde tabak",
                        "target_lang_word": "cigarette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cigarette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8587a8b-a507-3432-90e2-babec7fb5588",
                                        "entry_id": "8d86c965-75af-3bab-857a-163d8dcf76e7",
                                        "glosses": [
                                            "Petit cylindre de tabac finement haché entouré d'une feuille de papier fin, que l’on fume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ea03cc8-439d-4c50-98ab-06d0d631b6e4",
                                                "sense_id": "b8587a8b-a507-3432-90e2-babec7fb5588",
                                                "text": "[…] elle atteignit une cigarette sur la cheminée et l’alluma."
                                            },
                                            {
                                                "example_id": "45686717-9414-48f1-8369-a458d695fec9",
                                                "sense_id": "b8587a8b-a507-3432-90e2-babec7fb5588",
                                                "text": "— Qu’est donc devenu de Raittolbe ? fit Raoule, lançant au plafond la fumée d’une cigarette turque."
                                            },
                                            {
                                                "example_id": "4ec8d8c5-758c-469d-92c7-0253ec802f68",
                                                "sense_id": "b8587a8b-a507-3432-90e2-babec7fb5588",
                                                "text": "En attendant que le moment fût venu, ils n’hésitèrent pas à rouler une cigarette. Ils l’allumèrent avec certaines précautions, en tenant l’allumette entre leurs doigts, pour que n’on ne vît pas trop sa flamme ; puis, lorsqu’ils avaient tiré une bouffée, ils entouraient de leur main la cigarette, dont le bout brillant les eût dénoncés."
                                            },
                                            {
                                                "example_id": "08ec3bbe-0c74-48f9-9451-33c9ed342752",
                                                "sense_id": "b8587a8b-a507-3432-90e2-babec7fb5588",
                                                "text": "Bernard sourit, hocha la tête et, glorieux de son vêtement coupé dans une étoffe cannelle de mauvais goût, m'offrit une cigarette."
                                            },
                                            {
                                                "example_id": "87058cce-fc5e-4add-9d13-14a70adf7ccf",
                                                "sense_id": "b8587a8b-a507-3432-90e2-babec7fb5588",
                                                "text": "Elle alluma une cigarette, croisa les jambes et se renversa, languissante, dans son fauteuil."
                                            },
                                            {
                                                "example_id": "ca5607c2-9a13-4ad7-9ca1-0eafbdf7ca41",
                                                "sense_id": "b8587a8b-a507-3432-90e2-babec7fb5588",
                                                "text": "À travers les vitres des brasseries et des cafés, on distinguait confusément, un peu partout, la foule des consommateurs gesticulant parmi la fumée des cigarettes."
                                            },
                                            {
                                                "example_id": "961f1891-b921-4053-b345-bc2f5a95947d",
                                                "sense_id": "b8587a8b-a507-3432-90e2-babec7fb5588",
                                                "text": "« Tu veux une cigarette ? me dit-il changeant brusquement de tactique.\n— Non, je ne fume pas et je vous demande de me vouvoyer. »"
                                            },
                                            {
                                                "example_id": "aa2363cd-e1aa-49c2-9006-a353294b7f0d",
                                                "sense_id": "b8587a8b-a507-3432-90e2-babec7fb5588",
                                                "text": "La vente de cigarettes à l'unité ainsi que la vente par paquets de moins de 20 pièces est, en effet, très dangereuse car elle permet à des jeunes âgés parfois de 12 à 14 ans seulement de commencer à fumer."
                                            },
                                            {
                                                "example_id": "c9ac6d82-9e8d-414a-9030-8d270fb36a5e",
                                                "sense_id": "b8587a8b-a507-3432-90e2-babec7fb5588",
                                                "text": "La génération née après les années 2000 est la première à avoir grandi sous un régime légal interdisant la cigarette dans tous les espaces publics fermés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "343507e1-46c4-3fb6-ac1e-a8cfc714a923",
                                        "entry_id": "8d86c965-75af-3bab-857a-163d8dcf76e7",
                                        "glosses": [
                                            "Tout objet qui peut rappeler la forme d’une cigarette."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3994fcb-29a9-41e7-9149-96d10b52e7a2",
                                                "sense_id": "343507e1-46c4-3fb6-ac1e-a8cfc714a923",
                                                "text": "Il paraît que la nouvelle génération de hors-bord, appelés « cigarettes », a un moteur trop puissant pour la coque du bateau."
                                            }
                                        ]
                                    }
                                ]
                            },
