                        "entry_id": "1b2b3694-28a6-3ec6-989e-c41ac0f02762",
                        "glosses": [
                            "Partie qui est au milieu de deux choses avec lesquelles elle a relation ou contiguïté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06a34228-7637-432c-8f76-7a9f0b4f80ad",
                                "sense_id": "8188e6a6-c84a-3ec0-ab88-f1f4b898f0a6",
                                "text": "Elle se situe en un entredeux, en un intervalle fugace, insituable."
                            },
                            {
                                "example_id": "a9160186-0986-41b6-91f4-c9cdde2dfcdb",
                                "sense_id": "8188e6a6-c84a-3ec0-ab88-f1f4b898f0a6",
                                "text": "Ainsi, le poème décrit un entredeux qui permet la multiplication du sens et du temps."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5015d34-5442-3d16-ba5e-168e18923656",
                        "entry_id": "1b2b3694-28a6-3ec6-989e-c41ac0f02762",
                        "glosses": [
                            "Bande de dentelle, de tulle, de broderie qui sépare ou qui réunit les deux parties d’un tissu."
                        ],
                        "tags": [
                            "Lingerie"
                        ],
                        "examples": [
                            {
