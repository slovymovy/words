                    {
                        "sense_id": "9c124506-be3c-3622-b674-2333979274f7",
                        "entry_id": "d917e856-e8f6-31d6-9e36-155cdda1230e",
                        "glosses": [
                            "het bovenste, scherpe deel van een (kerk)toren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d2ee652-b77e-4e53-a3f6-6c40a2be6221",
                                "sense_id": "9c124506-be3c-3622-b674-2333979274f7",
                                "text": "De meeste gebouwen zijn realistisch geschilderd, maar met vaak een verrassend perspectief. Zo geeft Morsink zijn eigen draai aan de werkelijkheid door de keuze voor frisse kleuren of bijvoorbeeld door het ontbreken van een torenspits."
                            },
                            {
                                "example_id": "9e20ae9f-da5a-4ddf-9c04-bb753a4903a5",
                                "sense_id": "9c124506-be3c-3622-b674-2333979274f7",
                                "text": "‘Ook de torenspits werd hersteld, de leien werden vervangen en het fronton boven de hoofdingang werd vernieuwd.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07d5a315-556d-427b-a426-e0327bda2dce",
                        "source_entry_id": "d917e856-e8f6-31d6-9e36-155cdda1230e",
                        "source_sense_id": "9c124506-be3c-3622-b674-2333979274f7",
                        "source_sense_description": "hoogste punt van een toren",
