                        "source_sense_id": "3bee7c8d-fa6d-38b7-8f1b-80980bedb616",
                        "target_lang_word": "Sprachwandel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachwandel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7b3b250-899f-302f-9ef1-dea0d1e15aee",
                                        "entry_id": "9decf923-5f6a-3e9c-9228-854567b42efb",
                                        "glosses": [
                                            "Veränderung einer Sprache oder von Teilen der Sprache im Lauf der Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "469576e7-8ec1-4161-b1a3-fbffa43f927e",
                                                "sense_id": "b7b3b250-899f-302f-9ef1-dea0d1e15aee",
                                                "text": "Sprachwandel kann die ganze Sprache betreffen oder auch nur Teile von ihr. Ist die Grammatik von Veränderungen betroffen, handelt es sich bei dem Sprachwandel um grammatischen Wandel."
                                            },
                                            {
                                                "example_id": "ea2cb22f-6968-4702-b3b3-89a961a14fa3",
                                                "sense_id": "b7b3b250-899f-302f-9ef1-dea0d1e15aee",
                                                "text": "Ob ein Ausdruck von Sprachwandel betroffen ist, hängt auch von seiner funktionalen Belastung ab."
                                            },
                                            {
                                                "example_id": "031b7b0b-d12d-42ce-80dd-af2c64cc0ea2",
                                                "sense_id": "b7b3b250-899f-302f-9ef1-dea0d1e15aee",
                                                "text": "„Ein guter Teil des Sprachwandels besteht in dieser Abschleifung der Formen.“"
                                            },
                                            {
                                                "example_id": "50cd5786-d0a4-4dfd-8cee-4c17bcf92380",
                                                "sense_id": "b7b3b250-899f-302f-9ef1-dea0d1e15aee",
                                                "text": "„Kommunikationsbedürfnisse schaffen ständigen Sprachwandel.“"
                                            },
                                            {
                                                "example_id": "2a9e82ae-ef2c-4a89-b509-970636328749",
                                                "sense_id": "b7b3b250-899f-302f-9ef1-dea0d1e15aee",
                                                "text": "„Die Junggrammatiker ließen somit den Sprachwandel von zwei Kräften beherrscht werden, den mit Naturnotwendigkeit herrschenden Lautgesetzen und der durchkreuzend von der Seele her eingreifenden Analogie, die freilich nur auftreten konnte, nicht mußte.“"
                                            },
                                            {
                                                "example_id": "555fcf5c-645c-40d1-bb64-c08707e81174",
                                                "sense_id": "b7b3b250-899f-302f-9ef1-dea0d1e15aee",
                                                "text": "„Sprachwandelphänomene werden in der Folge vorschnell als Fehler, die es grundsätzlich zu vermeiden gelte, stigmatisiert, und der Sprachwandel insgesamt wird als bedrohlicher Verfallsprozess wahrgenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
