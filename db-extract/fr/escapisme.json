        "fr-extract.jsonl": [
            {
                "entry_id": "c3c94f62-b900-39d6-8e85-fae7cf93d883",
                "word": "escapisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dbe5702e-aa67-457c-b87d-ddb724946c17",
                        "entry_id": "c3c94f62-b900-39d6-8e85-fae7cf93d883",
                        "tags": [
                            "plural"
                        ],
                        "form": "escapismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e91c32f0-1270-3d55-a151-211601853b66",
                        "entry_id": "c3c94f62-b900-39d6-8e85-fae7cf93d883",
                        "glosses": [
                            "Attitude qui consiste à se retirer du monde et de la vie civique, par fuite ou désabusement, par opposition à la prise de parole ou à l’action individuelle ou sociale."
                        ],
                        "tags": [
                            "neologism",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7c5c1a9a-1393-43c3-8628-1204ca2ac7d3",
                                "sense_id": "e91c32f0-1270-3d55-a151-211601853b66",
                                "text": "Tous les morticoles du ciboulot font bloc autour de leur petit patient qui n’en peut mais : il souffre d’escapisme aigu, cette drôle d’attitude qui consiste à se retirer lentement du monde et de toute vie civique, par fuite, par désabusement, en opposition à la prise de décision publique et à toute action individuelle ou sociale."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c61e75a-04e3-384b-83ff-9eb9190ed817",
                        "entry_id": "c3c94f62-b900-39d6-8e85-fae7cf93d883",
                        "glosses": [
                            "Évasion de la réalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba7dc9cb-a66a-4005-a50c-c0617b0131d3",
                                "sense_id": "9c61e75a-04e3-384b-83ff-9eb9190ed817",
                                "text": "Du coup, du fait de la répétitivité de ces violences une forme d’indifférence ou d’escapisme s’était installée."
                            },
                            {
                                "example_id": "2215991f-7405-4c52-87f9-81657250041f",
                                "sense_id": "9c61e75a-04e3-384b-83ff-9eb9190ed817",
                                "text": "C'est une attitude de fuite qui se dégage de cette chanson [la Paloma], un escarpisme au goût du jour et dont le vrai nom serait : le refoulement du passé et du présent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ecc2385-bd70-495f-a586-65b717256226",
                        "source_entry_id": "c3c94f62-b900-39d6-8e85-fae7cf93d883",
                        "target_lang_word": "Eskapismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eskapismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc65bb45-46bb-3a1f-b16a-26efd16cbe0e",
                                        "entry_id": "afff6ef4-b8c0-343b-b9b7-05c4ad483297",
                                        "glosses": [
                                            "Flucht vor der realen Welt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "978b074d-dea7-42f6-a47b-7369d7ecb30d",
                                                "sense_id": "cc65bb45-46bb-3a1f-b16a-26efd16cbe0e",
                                                "text": "Diese Romane sind der reinste Eskapismus."
                                            },
                                            {
                                                "example_id": "fe94b612-826d-4115-870e-3c0ed989116f",
                                                "sense_id": "cc65bb45-46bb-3a1f-b16a-26efd16cbe0e",
                                                "text": "„Eskapismus aus dem als kalt empfundenen »real life« ist ein weit verbreitetes Muster, das auch Suchterkrankungen zugrundeliegt […].“"
                                            },
                                            {
                                                "example_id": "ecc1a192-91d9-48e0-9674-78c1645b6348",
                                                "sense_id": "cc65bb45-46bb-3a1f-b16a-26efd16cbe0e",
                                                "text": "„Das Schwelgen in ausgedachten Geschichten als Form des Eskapismus ist eine Sache.“"
                                            },
                                            {
                                                "example_id": "84ef8f9a-0e59-4db7-86c9-1fa80a4faeee",
                                                "sense_id": "cc65bb45-46bb-3a1f-b16a-26efd16cbe0e",
                                                "text": "„Der Pastor hielt seine ethnographischen Studien für Eskapismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
