                ],
                "senses": [
                    {
                        "sense_id": "89311355-607d-3622-a309-b659e93a57f2",
                        "entry_id": "5c9146e2-072d-3481-b41b-1c495bcda363",
                        "glosses": [
                            "modern en populair worden"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "1aa696d8-5d86-4b41-8628-cb8fe688fcaf",
                                "sense_id": "89311355-607d-3622-a309-b659e93a57f2",
                                "text": "De extreme metal is in de VS aardig aan het verhippen. Dat proces van muzikale gentrificatie voltrok zich al in de blackmetal bij bands als Deafheaven. Dankzij de band Full of Hell wordt de deathmetal nu ook hooggewaardeerd in veganistische hipsterkringen."
                            },
                            {
                                "example_id": "42ffb338-e24f-4a40-a1bc-576840c02674",
                                "sense_id": "89311355-607d-3622-a309-b659e93a57f2",
                                "text": "Ik woon in een snel verhippende wijk, de ene jonge ondernemer na de andere opent een zaakje, en alles cultureel, culinair of creatief."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ed4e22e-2469-3396-8749-99ba2071fae2",
                        "entry_id": "5c9146e2-072d-3481-b41b-1c495bcda363",
                        "glosses": [
                            "modieus maken, aantrekkelijk maken voor een jong of hedendaags publiek"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cded92d4-f77e-4a25-9577-c462ae712b00",
                                "sense_id": "2ed4e22e-2469-3396-8749-99ba2071fae2",
                                "text": "En hoe probeert Lodewijk Asscher zijn imago te verhippen?"
                            }
                        ]
                    },
                    {
                        "sense_id": "427b26ca-3daa-3d63-a2f5-ff09622b82bc",
                        "entry_id": "5c9146e2-072d-3481-b41b-1c495bcda363",
                        "glosses": [
                            "iets niet willen doen"
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2dd21509-162f-4777-82a4-dc6c9dae5592",
                                "sense_id": "427b26ca-3daa-3d63-a2f5-ff09622b82bc",
                                "text": "In de bijbel staat wel, dat je de man, die je op je linker wang slaat, ook de rechter moet toekeren, maar wij verhippen dat. Men hoeft niet alles te slikken."
                            }
                        ]
                    },
                    {
                        "sense_id": "97f0a05e-eaf1-3700-950a-b60f66d33826",
                        "entry_id": "5c9146e2-072d-3481-b41b-1c495bcda363",
                        "glosses": [
                            "weggaan omdat je aanwezigheid ongewenst is"
                        ],
                        "tags": [
                            "ergative",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "c6652171-afb3-4b4e-957b-8bda57c17b11",
                                "sense_id": "97f0a05e-eaf1-3700-950a-b60f66d33826",
                                "text": "Wij gaan samen weer op stap; de rest kan mij gestolen worden. Noes, Ban Hoei, Siti, Ma Nasra, Bin Said, Bogaard, Angenent. . . . verhippen kunnen ze, de hele bende!"
                            }
                        ]
                    },
                    {
                        "sense_id": "288cd894-4528-3f18-88da-faa59c8679be",
                        "entry_id": "5c9146e2-072d-3481-b41b-1c495bcda363",
                        "glosses": [
                            "met kleine sprongetjes bewegen"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "f5ab4295-ad6d-4005-8cd7-fbe0b25a7939",
                                "sense_id": "288cd894-4528-3f18-88da-faa59c8679be",
                                "text": "‘Komaan,’ zei Mussert, ‘en nu snel, want ik sta hier te verhippen van de kou.’"
                            },
                            {
                                "example_id": "0deb17c0-f472-44dc-b041-562c9f6cdae6",
                                "sense_id": "288cd894-4528-3f18-88da-faa59c8679be",
                                "text": "De overheid uit de provincie stond ook te verhippen, van de onverkwikkelijke wending van het gesprek, waarin hij nog steeds niet duidelijk wist welke houding hij moest aannemen."
                            }
                        ]
                    }
                ],
