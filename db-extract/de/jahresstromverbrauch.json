                "senses": [
                    {
                        "sense_id": "a36060db-ac7b-3f80-915d-0a0a80711b48",
                        "entry_id": "9a49bed7-ffb6-3938-8214-e21b813d715f",
                        "glosses": [
                            "auf den Zeitraum von einem Jahr bezogene Mengenangabe über den Verbrauch von elektrischer Energie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "747b7aeb-1069-4213-9594-a501518efe86",
                                "sense_id": "a36060db-ac7b-3f80-915d-0a0a80711b48",
                                "text": "„Die Wien Energie-Bürgerkraftwerke haben bisher über 27 Millionen Kilowattstunden Naturstrom erzeugt. Das entspricht dem Jahresstromverbrauch von 300.000 Kühlschränken bzw. einer Einsparung von 9.300 Tonnen CO2 seit dem Jahr 2012.“"
                            },
                            {
                                "example_id": "57f63e38-130b-4047-9037-0286816c5124",
                                "sense_id": "a36060db-ac7b-3f80-915d-0a0a80711b48",
                                "text": "„Als bisher einziges Kernkraftwerk der Schweiz hat das KKW Gösgen (Kanton Solothurn) mehr als 200 Milliarden Kilowattstunden (kWh) Strom produziert. Diese kumulierte Menge entspricht dem vierfachen Jahresstromverbrauch der Schweiz.“"
                            },
                            {
                                "example_id": "37de61fa-4099-444e-b237-0084e9d18772",
                                "sense_id": "a36060db-ac7b-3f80-915d-0a0a80711b48",
                                "text": "„Die Anlage verbrauche innerhalb von 38 Tagen eine Energiemenge, die dem Jahresstromverbrauch von fünf Familien entspreche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
