            {
                "entry_id": "36842b94-b452-3280-9925-ef921fab54e8",
                "word": "décapité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "050b0223-e60a-4240-8ca4-7329fffb52bf",
                        "entry_id": "36842b94-b452-3280-9925-ef921fab54e8",
                        "tags": [
