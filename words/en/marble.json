{
    "word_family": [
        "marbling",
        "marbleize",
        "marbler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "74b71f7e-91b2-3080-a4eb-6d6ddb6f310a",
                    "sense_definition": "A hard, crystalline metamorphic rock derived from limestone, typically white with colored streaks, used in sculpture and architecture.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitchen counter is made of polished white <w>marble</w>.",
                            "target_lang_translations": {
                                "ru": "Кухонная столешница сделана из полированного белого <w>мрамора</w>.",
                                "zh": "厨房台面是用抛光的白色<w>大理石</w>做的。"
                            }
                        },
                        {
                            "text": "Michelangelo carved the famous statue from a single block of <w>marble</w>.",
                            "target_lang_translations": {
                                "ru": "Микеланджело высек знаменитую статую из цельного блока <w>мрамора</w>.",
                                "zh": "米开朗基罗用一整块<w>大理石</w>雕刻了那座著名的雕像。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "white marble",
                        "marble floor",
                        "block of marble",
                        "marble statue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердая кристаллическая метаморфическая горная порода, обычно белая с цветными прожилками, используемая в скульптуре и архитектуре.",
                        "zh": "一种坚硬的结晶变质岩，源自石灰岩，通常为白色并带有彩色条纹，用于雕塑和建筑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мрамор",
                                "target_lang_sense_clarification": "горная порода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大理石",
                                "target_lang_sense_clarification": "岩石材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "baffe698-cf14-30c8-8f00-ef877fc041ee",
                    "sense_definition": "A small, hard ball, usually made of glass, used in children's games.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "toy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children sat on the rug to play with their glass <w>marbles</w>.",
                            "target_lang_translations": {
                                "ru": "Дети сидели на ковре и играли в свои стеклянные <w>шарики</w>.",
                                "zh": "孩子们坐在地毯上玩他们的玻璃<w>弹珠</w>。"
                            }
                        },
                        {
                            "text": "He keeps a colorful collection of <w>marbles</w> in a jar on his desk.",
                            "target_lang_translations": {
                                "ru": "Он хранит разноцветную коллекцию <w>шариков</w> в банке на своем столе.",
                                "zh": "他在桌上的罐子里收藏了各种颜色的<w>弹珠</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "play marbles",
                        "bag of marbles",
                        "glass marble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький твердый шарик, обычно стеклянный, используемый в детских играх.",
                        "zh": "一种小而坚硬的球体，通常由玻璃制成，用于儿童游戏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шарик",
                                "target_lang_sense_clarification": "игрушка"
                            },
                            {
                                "target_lang_word": "стеклянный шарик",
                                "target_lang_sense_clarification": "для игр"
                            },
                            {
                                "target_lang_word": "марбл",
                                "target_lang_sense_clarification": "название игры/шарика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弹珠",
                                "target_lang_sense_clarification": "玩具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1036c2b9-27f1-3c29-98b0-2c6afc67f422",
                    "sense_definition": "Statues or works of art created from marble stone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We visited the museum to see the ancient Greek <w>marbles</w>.",
                            "target_lang_translations": {
                                "ru": "Мы посетили музей, чтобы увидеть древнегреческие <w>мраморные скульптуры</w>.",
                                "zh": "我们参观了博物馆，欣赏了古希腊的<w>大理石雕塑</w>。"
                            }
                        },
                        {
                            "text": "The collection includes several fine <w>marbles</w> from the Roman era.",
                            "target_lang_translations": {
                                "ru": "Коллекция включает несколько прекрасных <w>изделий из мрамора</w> римской эпохи.",
                                "zh": "该收藏品包括几件精美的罗马时代<w>大理石雕塑</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Elgin Marbles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Статуи или произведения искусства, созданные из мрамора.",
                        "zh": "用大理石制成的雕像或艺术品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изделия из мрамора",
                                "target_lang_sense_clarification": "коллективное"
                            },
                            {
                                "target_lang_word": "мраморные скульптуры",
                                "target_lang_sense_clarification": "статуи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大理石雕塑",
                                "target_lang_sense_clarification": "艺术品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "10fd9830-cd5e-355c-9d4e-5cbb630c446f",
                    "sense_definition": "Made of marble, or having a streaked or swirled pattern resembling marble.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "description",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She baked a delicious <w>marble</w> cake with swirls of chocolate and vanilla.",
                            "target_lang_translations": {
                                "ru": "Она испекла вкусный <w>мраморный</w> кекс с завитками шоколада и ванили.",
                                "zh": "她烤了一个美味的<w>大理石纹</w>蛋糕，里面有巧克力和香草的漩涡花纹。"
                            }
                        },
                        {
                            "text": "The hotel lobby features impressive <w>marble</w> columns.",
                            "target_lang_translations": {
                                "ru": "В вестибюле отеля находятся впечатляющие <w>мраморные</w> колонны.",
                                "zh": "酒店大堂里有令人印象深刻的<w>大理石</w>柱子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "marble cake",
                        "marble column",
                        "marble arch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из мрамора или имеющий узор с прожилками, напоминающий мрамор.",
                        "zh": "由大理石制成的，或具有类似大理石的条纹或漩涡图案。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мраморный",
                                "target_lang_sense_clarification": "материал или узор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大理石的",
                                "target_lang_sense_clarification": "材质"
                            },
                            {
                                "target_lang_word": "大理石纹的",
                                "target_lang_sense_clarification": "图案"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e2ba295-00c7-3460-957a-78a3ffe0127e",
                    "sense_definition": "Cold, hard, or unfeeling in nature or appearance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stared at the prisoner with a cold, <w>marble</w> expression.",
                            "target_lang_translations": {
                                "ru": "Он смотрел на заключенного с холодным, <w>мраморным</w> выражением лица.",
                                "zh": "他用一种冰冷、<w>像大理石般</w>僵硬的表情盯着囚犯。"
                            }
                        },
                        {
                            "text": "Her <w>marble</w> heart showed no emotion despite the tragedy.",
                            "target_lang_translations": {
                                "ru": "Её <w>мраморное</w> сердце не выказало никаких эмоций, несмотря на трагедию.",
                                "zh": "尽管发生了悲剧，她那<w>铁石心肠</w>依然没有流露出一丝情感。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "marble heart"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary or poetic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Холодный, твердый или бесчувственный по характеру или внешнему виду.",
                        "zh": "性质或外表冷漠、坚硬或无情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мраморный",
                                "target_lang_sense_clarification": "метафора: холодный/бледный"
                            },
                            {
                                "target_lang_word": "каменный",
                                "target_lang_sense_clarification": "бесчувственный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冷漠的",
                                "target_lang_sense_clarification": "形容人"
                            },
                            {
                                "target_lang_word": "铁石心肠的",
                                "target_lang_sense_clarification": "形容心肠"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3041c056-9710-36ba-bee4-fbef52d862b3",
                    "sense_definition": "To give something a streaked or swirled appearance like that of marble.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "patterning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used special inks to <w>marble</w> the paper for the book cover.",
                            "target_lang_translations": {
                                "ru": "Художник использовал специальные чернила, чтобы <w>мраморировать</w> бумагу для обложки книги.",
                                "zh": "艺术家用特殊的墨水将书皮纸<w>做成大理石纹</w>。"
                            }
                        },
                        {
                            "text": "You can <w>marble</w> the icing by dragging a toothpick through the colors.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>создать мраморный узор</w> на глазури, проведя зубочисткой по цветам.",
                                "zh": "你可以用牙签在颜色间划过，把糖霜<w>做成大理石纹</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "marbleize"
                    ],
                    "common_phrases": [
                        "marble paper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать чему-либо вид мрамора с прожилками или разводами.",
                        "zh": "使某物呈现出像大理石一样的条纹或漩涡外观。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мраморировать",
                                "target_lang_sense_clarification": "техника окраски"
                            },
                            {
                                "target_lang_word": "отделывать под мрамор",
                                "target_lang_sense_clarification": "имитация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "做成大理石纹",
                                "target_lang_sense_clarification": "工艺"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbbd6c60-39fc-3a25-aeb5-44bce1048bff",
                    "sense_definition": "To become interlaced with fat (of meat), or to cause meat to have streaks of fat.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "culinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "High-quality beef tends to <w>marble</w> well when the cattle are fed grain.",
                            "target_lang_translations": {
                                "ru": "Высококачественная говядина, как правило, хорошо <w>становится мраморной</w>, когда скот кормят зерном.",
                                "zh": "当牛喂食谷物时，优质牛肉往往能<w>形成</w>良好的<w>大理石花纹</w>。"
                            }
                        },
                        {
                            "text": "The fat will <w>marble</w> the steak, making it tender and flavorful.",
                            "target_lang_translations": {
                                "ru": "Жир <w>сделает</w> стейк <w>мраморным</w>, придав ему нежность и аромат.",
                                "zh": "脂肪会使牛排<w>形成大理石花纹</w>，使其口感鲜嫩多汁。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Образовывать жировые прослойки (о мясе) или становиться похожим на мрамор.",
                        "zh": "指肉类中脂肪交织成纹理，或使肉类产生脂肪条纹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "становиться мраморным",
                                "target_lang_sense_clarification": "о мясе"
                            },
                            {
                                "target_lang_word": "образовывать прожилки",
                                "target_lang_sense_clarification": "о жире"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "形成大理石花纹",
                                "target_lang_sense_clarification": "肉类品质"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e7faa646-6b37-3064-92a0-2a7ec4047809",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Marble</w> has lived in this neighborhood for fifty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Марбл</w> живет в этом районе уже пятьдесят лет.",
                                "zh": "<w>马布尔</w>先生在这个社区已经住了五十年了。"
                            }
                        },
                        {
                            "text": "We are looking for a record of Alice <w>Marble</w> in the archives.",
                            "target_lang_translations": {
                                "ru": "Мы ищем записи об Элис <w>Марбл</w> в архивах.",
                                "zh": "我们正在档案中寻找爱丽丝·<w>马布尔</w>的记录。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Марбл",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马布尔",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7349314b-b460-30fd-a823-e7d7db1b8b2e",
                    "sense_definition": "A statutory town in Gunnison County, Colorado.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They planned a summer trip to visit <w>Marble</w>, Colorado.",
                            "target_lang_translations": {
                                "ru": "Они запланировали летнюю поездку, чтобы посетить <w>Марбл</w>, штат Колорадо.",
                                "zh": "他们计划夏天去科罗拉多州的<w>马布尔</w>旅行。"
                            }
                        },
                        {
                            "text": "The town of <w>Marble</w> is known for its historic quarry.",
                            "target_lang_translations": {
                                "ru": "Город <w>Марбл</w> известен своим историческим карьером.",
                                "zh": "<w>马布尔</w>镇以其历史悠久的采石场而闻名。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в округе Ганнисон, штат Колорадо.",
                        "zh": "位于科罗拉多州甘尼森县的一个法定城镇。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Марбл",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马布尔",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}