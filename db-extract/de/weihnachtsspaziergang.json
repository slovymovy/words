                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5d2cfe8-8a08-4a37-bf28-89c161b811ee",
                                "sense_id": "c78b4d6f-18f3-3b02-9531-b51db0f07de1",
                                "text": "Lass uns doch heute Abend einen Weihnachtsspaziergang machen."
                            },
                            {
                                "example_id": "1c7b1041-62a9-4563-8c97-2a5e101bd009",
                                "sense_id": "c78b4d6f-18f3-3b02-9531-b51db0f07de1",
                                "text": "„Na toll, richtig schöner Weihnachtsspaziergang heißt bei Mama stundenlanges Marschieren.“"
                            },
                            {
                                "example_id": "3cdcc929-0303-4801-8c7c-eecce2e27c68",
                                "sense_id": "c78b4d6f-18f3-3b02-9531-b51db0f07de1",
                                "text": "„Am ersten Weihnachtsfeiertag machte ich mit meinen Feldwebeln einen Weihnachtsspaziergang, leider fehlte der Schnee.“"
                            },
                            {
                                "example_id": "ede7a123-899c-4179-8778-f53c8c9fb886",
                                "sense_id": "c78b4d6f-18f3-3b02-9531-b51db0f07de1",
                                "text": "„Als sie fertig waren, flaute der Wind seltsamerweise plötzlich ab und wurde von einem leichten Schneefall ersetzt, der Summerfield an Weihnachtsspaziergänge in England denken ließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
