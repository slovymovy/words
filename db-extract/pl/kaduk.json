                                "target_senses": [
                                    {
                                        "sense_id": "3bdaa7e8-85d0-3ed0-b3b9-d29dcd28a775",
                                        "entry_id": "6255044b-16b3-3c22-b472-4838f84ebe91",
                                        "glosses": [
                                            "The return of property of a deceased person to the state (originally to a feudal lord) where there are no legal heirs or claimants."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d1b610c-7a9f-3cf0-9d06-2d31876bfc5a",
                                        "entry_id": "6255044b-16b3-3c22-b472-4838f84ebe91",
                                        "glosses": [
                                            "The property so reverted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cfe58000-cda4-334c-97a1-16dfd47f1c45",
                                        "entry_id": "6255044b-16b3-3c22-b472-4838f84ebe91",
                                        "glosses": [
                                            "Plunder, booty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51386286-fcc5-420e-b68c-9c9d030d7245",
                                                "sense_id": "cfe58000-cda4-334c-97a1-16dfd47f1c45",
                                                "text": "Approching, with bold words and bitter threat, / Bad that same boaster, as he mote, on high / To leaue to him that Lady for excheat, / Or bide him battell without further treat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b40db068-08ce-3121-8e8b-726db93d3ee8",
                                        "entry_id": "6255044b-16b3-3c22-b472-4838f84ebe91",
                                        "glosses": [
                                            "That which falls to one; a reversion or return."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9da4fe11-147a-408c-a5f9-c09ea465a3cc",
                                                "sense_id": "b40db068-08ce-3121-8e8b-726db93d3ee8",
                                                "text": "And by my ruines thinkes to make them great: / To make one great by others losse, is bad excheat"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "escheat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86c1d0a7-7d97-362c-9b6f-a580f6dfb1a2",
                                        "entry_id": "81e39bb2-e834-3411-81a9-c88cd1b07295",
                                        "glosses": [
                                            "To put (land, property) in escheat; to confiscate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7f65194-6b52-4a9c-8dec-e89d815ee1f5",
                                                "sense_id": "86c1d0a7-7d97-362c-9b6f-a580f6dfb1a2",
                                                "text": "Failure to perform duties opened the culprit to charges of ‘felony’ (felonia), providing grounds for the king to escheat the fief."
                                            },
                                            {
                                                "example_id": "ed76983c-23b6-4587-94bf-a2286b8a4657",
                                                "sense_id": "86c1d0a7-7d97-362c-9b6f-a580f6dfb1a2",
                                                "text": "Arms are very rigidly controlled in Scotland by the Lord Lyon King of Arms. […] Under an Act of 1592, Lyon King of Arms can escheat to the Sovereign all goods unlawfully displaying arms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9a21c76-31e1-346a-8ea8-23b64cb194c7",
                                        "entry_id": "81e39bb2-e834-3411-81a9-c88cd1b07295",
                                        "glosses": [
                                            "To revert to a state or lord because its previous owner died without an heir."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
