                ],
                "senses": [
                    {
                        "sense_id": "829d5bba-f332-3ca0-b154-9a07a7775a28",
                        "entry_id": "113622bc-db32-3d14-b01a-3fac891ff03e",
                        "glosses": [
                            "bedarfsabhängig gesteuerte, und an winterlichem Wetter orientierte, Lüftungstechnik für einen Raum oder ein Gebäude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "979c076a-549c-4b35-b057-f6c75f82944a",
                                "sense_id": "829d5bba-f332-3ca0-b154-9a07a7775a28",
                                "text": "„Aktivierung der Winterlüftung durch einfachen Handgriff ohne Werkzeug; einfache Nachrüstung; integrierte Zuschlagsicherung“"
                            },
                            {
                                "example_id": "ea839d25-7f43-43b1-8311-32e1f7a0823e",
                                "sense_id": "829d5bba-f332-3ca0-b154-9a07a7775a28",
                                "text": "„Je nach Jahreszeit oder Außentemperatur können Sie die Winterlüftung ohne Werkzeug aktivieren und somit die Kippöffnung begrenzen und gleichzeitig Energiekosten sparen.“"
                            },
                            {
                                "example_id": "257eafda-5ef0-421e-9853-d7d73905c746",
                                "sense_id": "829d5bba-f332-3ca0-b154-9a07a7775a28",
                                "text": "„Gegenüber der Winterlüftung, bei der wir nur so viel Luft in den Stall hineinlassen wie benötigt wird, um Wasser und Schadgase abzuführen, ist es im Sommer das vorderste Ziel, die Temperaturen im Stall so niedrig wie möglich zu halten.“"
                            },
                            {
                                "example_id": "48bbbfb5-2795-4d0d-9e55-099322065931",
                                "sense_id": "829d5bba-f332-3ca0-b154-9a07a7775a28",
                                "text": "„Während die Sommerlüftung mittlerweile selbstverständlich sei für Milchviehhalter, sei die richtige Winterlüftung noch nicht in den Köpfen angekommen.“"
                            },
                            {
                                "example_id": "d210f6d8-8874-4790-b2fd-498a4049cd28",
                                "sense_id": "829d5bba-f332-3ca0-b154-9a07a7775a28",
                                "text": "„Wissen Sie, ihr Lehrling oder ihr Mitarbeiter, welche Werte im Klimacomputer für die Winterlüftung einzugeben sind?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
