                    "frequency": "VeryLow",
                    "semantic_group_id": "admin_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local court met within the boundaries of the <w>hundred</w>.",
                            "target_lang_translations": {
                                "ru": "Местный суд заседал в границах <w>сотни</w>.",
                                "zh": "地方法院在<w>百户区</w>的范围内开庭。"
                            }
                        },
                        {
                            "text": "Residents of the <w>hundred</w> were responsible for maintaining law and order.",
                            "target_lang_translations": {
                                "ru": "Жители <w>сотни</w> отвечали за поддержание правопорядка.",
