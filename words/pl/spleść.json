    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "60441a6e-427e-34c8-b475-c41bd19b2676",
                    "sense_definition": "połączyć podłużne elementy, przekładając je przez siebie, lub wykonać coś tą techniką",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "łączenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziewczynka starannie <w>splotła</w> długie włosy w gruby warkocz przed wyjściem do szkoły.",
                            "target_lang_translations": {
                                "ru": "Перед уходом в школу девочка аккуратно <w>заплела</w> длинные волосы в толстую косу."
                            }
                        },
                        {
                            "text": "Rzemieślnik <w>splótł</w> elastyczne gałązki wierzby, aby stworzyć mocny i lekki kosz.",
                            "target_lang_translations": {
                                "ru": "Ремесленник <w>сплёл</w> гибкие ивовые прутья, чтобы сделать прочную и лёгкую корзину."
                            }
                        }
                    ],
                    "synonyms": [
                        "zapleść",
                        "powiązać"
                    ],
                    "antonyms": [
                        "rozpleść"
                    ],
                    "common_phrases": [
                        "spleść warkocz",
                        "spleść kosz"
                    ],
                    "target_lang_definitions": {
                        "ru": "соединить продолговатые элементы переплетением или изготовить что-либо таким способом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплести",
                                "target_lang_sense_clarification": "изготовить или соединить плетением (косу, корзину)"
                            },
                            {
                                "target_lang_word": "заплести",
                                "target_lang_sense_clarification": "о косах, волосах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33a43120-8cbc-386d-bc40-620fb2bff932",
                    "sense_definition": "złączyć ręce, palce lub ramiona w uścisku albo geście",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas wieczornego spaceru po parku <w>spletli</w> dłonie i rozmawiali o wspólnej przyszłości.",
                            "target_lang_translations": {
                                "ru": "Во время вечерней прогулки по парку они <w>переплели</w> пальцы и говорили об общем будущем."
                            }
                        },
                        {
                            "text": "Zdenerwowany świadek <w>splótł</w> palce na stole i czekał na kolejne trudne pytania.",
                            "target_lang_translations": {
                                "ru": "Нервничающий свидетель <w>сцепил</w> пальцы на столе и ждал следующих трудных вопросов."
                            }
                        }
                    ],
                    "synonyms": [
                        "skrzyżować",
                        "złożyć"
                    ],
                    "antonyms": [
                        "rozewrzeć"
                    ],
                    "common_phrases": [
                        "spleść dłonie",
                        "spleść palce",
                        "spleść ręce"
                    ],
                    "target_lang_definitions": {
                        "ru": "соединить руки, пальцы в рукопожатии или характерном жесте"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплести",
                                "target_lang_sense_clarification": "о руках, пальцах"
                            },
                            {
                                "target_lang_word": "скрестить",
                                "target_lang_sense_clarification": "о руках или пальцах"
                            },
                            {
                                "target_lang_word": "переплести",
                                "target_lang_sense_clarification": "пальцы, ладони"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10dcc4e5-ee19-3e20-9c28-4d4bba27ce10",
                    "sense_definition": "połączyć ze sobą różne wydarzenia, wątki lub ludzkie losy",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "łączenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Autor powieści zręcznie <w>splótł</w> losy kilku zupełnie obcych sobie osób w jedną historię.",
                            "target_lang_translations": {
                                "ru": "Автор романа ловко <w>переплёл</w> судьбы нескольких совершенно незнакомых людей в одну историю."
                            }
                        },
                        {
                            "text": "Przypadek nieoczekiwanie <w>splótł</w> ich drogi życiowe w najmniej spodziewanym momencie.",
                            "target_lang_translations": {
                                "ru": "Случай неожиданно <w>свёл</w> их жизненные пути в самый неподходящий момент."
                            }
                        }
                    ],
                    "synonyms": [
                        "połączyć",
                        "powiązać"
                    ],
                    "antonyms": [
                        "rozdzielić"
                    ],
                    "common_phrases": [
                        "spleść losy",
                        "spleść wątki"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "przenośnie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "тесно связать, соединить воедино события, сюжетные линии или человеческие судьбы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплести",
                                "target_lang_sense_clarification": "в переносном смысле: о судьбах, сюжетах"
                            },
                            {
                                "target_lang_word": "переплести",
                                "target_lang_sense_clarification": "о сюжетах, событиях, судьбах"
                            },
                            {
                                "target_lang_word": "связать",
                                "target_lang_sense_clarification": "воедино"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94124545-7590-3aa0-961e-f6ec94ff80c0",
                    "sense_definition": "ulec wzajemnemu złączeniu, powiązaniu ze sobą (często o gałęziach, przewodach lub wątkach)",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "łączenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W starym lesie korzenie drzew <w>splotły</w> się tak gęsto, że utrudniały przejście.",
                            "target_lang_translations": {
                                "ru": "В старом лесу корни деревьев <w>переплелись</w> так густо, что мешали пройти."
                            }
                        },
                        {
                            "text": "Przez lata ich wspólne interesy tak mocno się <w>splotły</w>, że trudno było je rozdzielić.",
                            "target_lang_translations": {
                                "ru": "За долгие годы их общие интересы настолько тесно <w>сплелись</w>, что разделить их было трудно."
                            }
                        }
                    ],
                    "synonyms": [
                        "poplątać się",
                        "związać się"
                    ],
                    "antonyms": [
                        "rozplątać się"
                    ],
                    "common_phrases": [
                        "spleść się ze sobą"
                    ],
                    "target_lang_definitions": {
                        "ru": "взаимно соединиться, переплестись друг с другом (о ветвях, проводах, интересах)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплестись",
                                "target_lang_sense_clarification": "соединиться вместе, перепутаться"
                            },
                            {
                                "target_lang_word": "переплестись",
                                "target_lang_sense_clarification": "о ветвях, корнях или интересах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}