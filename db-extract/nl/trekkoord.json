                    {
                        "translation_id": "d9b37f57-99e3-4402-bfc7-84ca9513c435",
                        "source_entry_id": "4339e31a-56dc-3505-8beb-9937d5f5c1ea",
                        "target_lang_word": "lanyard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lanyard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac0ff8c0-0a8a-3544-b283-234b617f3928",
                                        "entry_id": "8bddd6ad-34f1-33df-8f4a-a553516c7e69",
                                        "glosses": [
                                            "A short rope used for fastening rigging, as a handle, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0389f9a7-f2c2-4e04-80ce-496b30958947",
                                                "sense_id": "ac0ff8c0-0a8a-3544-b283-234b617f3928",
                                                "text": "\"Take ahold here, an' keep ringin' steady,\" said Dan, passing Harvey the lanyard of a bell that hung just behind the windlass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eb66bc7-aec2-3829-8eec-8b37aaee74da",
                                        "entry_id": "8bddd6ad-34f1-33df-8f4a-a553516c7e69",
                                        "glosses": [
                                            "A cord worn around the neck, shoulder, or wrist which is attached to a small object to be carried such as an identity card or security pass, key, knife, or whistle."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "507cdb8c-2122-4498-8094-4e3ba7efbeaa",
                                                "sense_id": "4eb66bc7-aec2-3829-8eec-8b37aaee74da",
                                                "text": "Aboard ship he carried his crutch by a lanyard round his neck, to have both hands as free as possible. [...] [H]e would hand himself from one place to another, now using the crutch, now trailing it alongside by the lanyard, as quickly as another man could walk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05ed63f8-3cac-3759-b8b4-b86367bb53d0",
                                        "entry_id": "8bddd6ad-34f1-33df-8f4a-a553516c7e69",
                                        "glosses": [
                                            "A craft activity done by intricately braiding thin colored plastic lines to make patterns, or the product of such a craft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e56fb9-c328-420c-a01b-8cd8c350fc9c",
                                                "sense_id": "05ed63f8-3cac-3759-b8b4-b86367bb53d0",
                                                "text": "It's lanyard. It's a camp tradition. You'll have about a million lanyard key chains by the time the summer is over."
                                            },
                                            {
                                                "example_id": "9088b7ff-3a83-4db9-9bbe-42245a4e2aa5",
                                                "sense_id": "05ed63f8-3cac-3759-b8b4-b86367bb53d0",
                                                "text": "A few lousy days at Camp Minnehaha spent extracting oar splinters from your palms and taking group lanyard lessons under the full noonday sun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40a3ae2f-1126-39af-8099-8ea5932469fb",
                                        "entry_id": "8bddd6ad-34f1-33df-8f4a-a553516c7e69",
                                        "glosses": [
                                            "A cord with a hook which is secured to an artillery piece, and pulled to fire the weapon."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
