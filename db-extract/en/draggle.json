                "senses": [
                    {
                        "sense_id": "113efe25-d541-3a7e-a4de-b9a1565ba856",
                        "entry_id": "ddb4d543-9cb5-3524-ae96-fef4fa7af3b2",
                        "glosses": [
                            "To make, or to become, wet and muddy by dragging along the ground."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a6ade33-f3d9-48a7-af70-b665729e77d9",
                                "sense_id": "113efe25-d541-3a7e-a4de-b9a1565ba856",
                                "text": "The rain drove into the bride and bridegroom's faces as they passed to the chariot. The postilions' favours draggled on their dripping jackets."
                            },
                            {
                                "example_id": "d3565fd0-b5d8-4d2b-97cc-6459637251d0",
                                "sense_id": "113efe25-d541-3a7e-a4de-b9a1565ba856",
                                "text": "[…] with draggled nets down-hanging to the tide […]"
                            },
                            {
                                "example_id": "bb4986f6-4a38-4921-8f72-eb21adafaf8b",
                                "sense_id": "113efe25-d541-3a7e-a4de-b9a1565ba856",
                                "text": "[If] it be too long it draggles on the ground and gets under foot and is very troublesome."
                            }
                        ]
                    }
                ],
