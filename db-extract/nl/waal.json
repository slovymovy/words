                ],
                "translations": [
                    {
                        "translation_id": "f8dc87c2-6daa-4cf3-a45c-48d6425a382e",
                        "source_entry_id": "e8148967-5249-30e5-afc5-d68867c6ebc8",
                        "source_sense_description": "(eigennaam) 1. brede zijrivier van de Rijn in Nederland",
                        "target_lang_word": "Waal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35aa833c-4356-3bef-a1b6-fc8bab47c556",
                                        "entry_id": "90d6cdee-348e-34cc-98d7-5d2204e1b18f",
                                        "glosses": [
                                            "häufig in Bergregionen (zum Beispiel in Südtirol) angelegter Bewässerungskanal, der das Wasser aus regenreichen Gebieten in trockenere landwirtschaftlich genutzte Zonen leitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c09740db-045c-4975-b4e6-3e7523d6f88d",
                                                "sense_id": "35aa833c-4356-3bef-a1b6-fc8bab47c556",
                                                "text": "„In steileren Hanglagen oder in erosionsgefährdetem Gelände werden der Boden und die Wände des Waales durch Verbauungen befestigt.“"
                                            },
                                            {
                                                "example_id": "1a88065f-394b-44ab-898e-0d9c45ffbdce",
                                                "sense_id": "35aa833c-4356-3bef-a1b6-fc8bab47c556",
                                                "text": "„Die tägliche Aufsicht über den Waal übt der Waaler aus. Er geht den Waal in seiner Länge mindestens einmal am Tag ab, kontrolliert Wasserstand, Schleusen und Rechen, behebt kleinere Schäden.“"
                                            },
                                            {
                                                "example_id": "8dc582bb-a19b-47e7-878c-7d33e82f5609",
                                                "sense_id": "35aa833c-4356-3bef-a1b6-fc8bab47c556",
                                                "text": "„Das Waalwasser wird am Talfluss oder Gebirgsbach eingeleitet, durchläuft den Haupt- und Tragwaal, fließt durch ein dicht verzweigtes Netz von Waalen, bis es zur genau festgelegten Zeit zum Feld gelangt, das von einem auch zeitlich festgelegenen Wasserrecht ausgestattet ist.“"
                                            },
                                            {
                                                "example_id": "1e8a376d-f4d0-4e14-b0ac-f9c72d0ae5a0",
                                                "sense_id": "35aa833c-4356-3bef-a1b6-fc8bab47c556",
                                                "text": "„Auf angenehm schattigen Pfaden entlang der Waale kommt man dort an Canyons, wildromantischen Schluchten, Seen und steilen Felswänden vorbei, bis hinein in die beeindruckende Landschaft des Naturparks Texelgruppe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Waal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e00c6368-f58e-366d-b8f0-348a6b3cc497",
                                        "entry_id": "51258258-cd99-331a-9dec-ca220f45f1f7",
                                        "glosses": [
                                            "Fluss in den Niederlanden, südlicher Mündungsarm des Rheins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c67980a2-3893-40c5-a70d-4a75982fd7da",
                                                "sense_id": "e00c6368-f58e-366d-b8f0-348a6b3cc497",
                                                "text": "„Die Waal wird von durchschnittlich fünfzehn Schiffen in der Stunde befahren. Jeder dritte Wassertransport ist umwelt- oder gar lebensgefährlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Waal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "261daea9-5242-3780-a9bc-a8d367158cb9",
                                        "entry_id": "a68a7974-4797-33f0-a4b2-fbcdbaeb13e0",
                                        "glosses": [
                                            "Ort (Markt) in Bayern (Landkreis Ostallgäu, Bezirk Schwaben)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1348b24b-3651-4992-ac12-9a992651e403",
                                                "sense_id": "261daea9-5242-3780-a9bc-a8d367158cb9",
                                                "text": "„Die Passions- und Volksschauspiele in Waal sind die ältesten in einer festen, bis heute betriebenen Einrichtung und ausschließlich von einheimischen Laien gespielten Aufführungen dieser Art in Bayerisch-Schwaben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
