                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a8171fe-fd17-4571-93b5-6c00fbe045e2",
                                "sense_id": "8f3d2c29-71b6-30e0-bba4-8d1a18b7f2c2",
                                "text": "„Sie brachte Fingerhütchen voll echten Kaffees.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "adea9cb8-b7b7-3bf4-9e63-9145d8f77618",
                        "entry_id": "63ce0215-f99c-36b5-88bd-06d9ceb2ef71",
                        "glosses": [
                            "kleine Fingerhutpflanze"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "93ef2e01-ae18-3765-b1d9-b57300351af6",
                        "entry_id": "63ce0215-f99c-36b5-88bd-06d9ceb2ef71",
                        "glosses": [
                            "Kunstfigur mit dem Namen Fingerhut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60ec143b-d89f-4035-8456-c731a75c5e1c",
                                "sense_id": "93ef2e01-ae18-3765-b1d9-b57300351af6",
                                "text": "„Conrad Ferdinand Meyer macht das Vollendungsbedürfnis in seiner Ballade Fingerhütchen sogar zum eigentlichen Thema.“"
                            },
                            {
                                "example_id": "73337cd4-970b-4904-9f9e-e777ef19bde9",
                                "sense_id": "93ef2e01-ae18-3765-b1d9-b57300351af6",
                                "text": "„Fingerhütchen lauert still auf der Töne Leiter, wie das Liedchen enden will, führt er leicht es weiter: \"Silberfähre, gleitest leise\" […]“"
                            },
                            {
                                "example_id": "6134be3e-adc3-4263-afba-63003728a25b",
                                "sense_id": "93ef2e01-ae18-3765-b1d9-b57300351af6",
                                "text": "„Da trat einer der Kleinen zu ihm hervor und sagte: „Fingerhut, Fingerhut! faß dir frischen Mut! lustig und munter, dein Höcker fällt herunter, siehst ihn liegen, 'dir geht gut, Fingerhut, Fingerhut!“ Kaum waren die Worte zu Ende, so fühlte sich das Fingerhütchen so leicht , so selig , daß es wohl in einem Satz über den Mond hinweg gesprungen wäre, wie die Kuh in dem Märchen von der Katze und der Geige.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
