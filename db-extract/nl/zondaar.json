                        "entry_id": "223f8440-ad67-3300-8c7f-07a281aa8b7c",
                        "glosses": [
                            "iemand die ongehoorzaam is aan Gods geboden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04f45dcd-0556-4893-a19f-e533d59908ac",
