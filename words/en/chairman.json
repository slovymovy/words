    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5ffb29ef-c674-3eb8-9e4a-345ffa3c0795",
                    "sense_definition": "The head of a corporate or governmental board of directors, a committee, or other formal entity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "leadership_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>chairman</w> of the board announced the new company strategy yesterday.",
                            "target_lang_translations": {
                                "ru": "<w>Председатель</w> совета директоров объявил вчера о новой стратегии компании.",
                                "zh": "董事会<w>主席</w>昨天宣布了公司的新战略。"
                            }
                        },
                        {
                            "text": "She served as <w>chairman</w> of the finance committee for three years.",
                            "target_lang_translations": {
                                "ru": "Она была <w>председателем</w> финансового комитета в течение трех лет.",
                                "zh": "她担任财务委员会<w>主席</w>已有三年了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chair",
                        "chairperson",
                        "president",
                        "head"
                    ],
                    "common_phrases": [
                        "board chairman",
                        "company chairman",
                        "vice chairman",
                        "founding chairman"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глава совета директоров компании, правительственного комитета или другой официальной организации.",
                        "zh": "公司董事会、政府委员会或其他正式机构的负责人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "председатель",
                                "target_lang_sense_clarification": "глава организации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "董事长",
                                "target_lang_sense_clarification": "公司董事会负责人"
                            },
                            {
                                "target_lang_word": "主席",
                                "target_lang_sense_clarification": "委员会或组织负责人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f694f5a-f0cb-3a32-83f1-c1819b732576",
                    "sense_definition": "A person presiding over a meeting.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "leadership_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please address all your questions directly to the <w>chairman</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, адресуйте все ваши вопросы непосредственно <w>председателю</w>.",
                                "zh": "请将所有问题直接向<w>主持人</w>提出。"
                            }
                        },
                        {
                            "text": "The <w>chairman</w> called the meeting to order at nine o'clock sharp.",
                            "target_lang_translations": {
                                "ru": "<w>Председатель</w> открыл собрание ровно в девять часов.",
                                "zh": "<w>主席</w>在九点整宣布会议开始。"
                            }
                        }
                    ],
                    "synonyms": [
                        "moderator",
                        "presider",
                        "chair",
                        "chairperson"
                    ],
                    "common_phrases": [
                        "meeting chairman",
                        "acting chairman",
                        "session chairman"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, ведущий собрание или заседание.",
                        "zh": "主持会议的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "председатель",
                                "target_lang_sense_clarification": "ведущий собрания"
                            },
                            {
                                "target_lang_word": "председательствующий",
                                "target_lang_sense_clarification": "ведущий заседания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主持人",
                                "target_lang_sense_clarification": "会议主持者"
                            },
                            {
                                "target_lang_word": "主席",
                                "target_lang_sense_clarification": "会议主持者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc1f81b7-e66c-376a-a872-d001430b336a",
                    "sense_definition": "Someone whose job is to carry people in a portable chair, sedan chair, or similar conveyance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy lady hired a <w>chairman</w> to transport her across the busy city.",
                            "target_lang_translations": {
                                "ru": "Богатая дама наняла <w>носильщика</w>, чтобы тот перенес её через оживленный город.",
                                "zh": "那位富有的女士雇了一名<w>轿夫</w>送她穿过繁忙的城市。"
                            }
                        },
                        {
                            "text": "Two strong <w>chairmen</w> lifted the sedan chair and began their journey.",
                            "target_lang_translations": {
                                "ru": "Два сильных <w>носильщика</w> подняли портшез и отправились в путь.",
                                "zh": "两名强壮的<w>轿夫</w>抬起轿子，开始了行程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bearer",
                        "carrier"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "refers to a historical occupation involving sedan chairs"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, чья работа заключалась в переноске людей в портшезе или паланкине.",
                        "zh": "旧时负责抬轿子的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носильщик",
                                "target_lang_sense_clarification": "портшеза"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轿夫",
                                "target_lang_sense_clarification": "抬轿子的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f9adc5e-eb87-3d06-8fef-be9e34a6db69",
                    "sense_definition": "To serve as chairman.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was asked to <w>chairman</w> the discussion panel at the conference.",
                            "target_lang_translations": {
                                "ru": "Его попросили <w>председательствовать</w> на дискуссионной панели на конференции.",
                                "zh": "他被邀请在会议上<w>主持</w>讨论小组。"
                            }
                        },
                        {
                            "text": "She has <w>chairmanned</w> several successful committees in the past.",
                            "target_lang_translations": {
                                "ru": "В прошлом она <w>возглавляла</w> несколько успешных комитетов.",
                                "zh": "她过去曾<w>领导</w>过几个成功的委员会。"
                            }
                        }
