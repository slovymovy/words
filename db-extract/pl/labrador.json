                                "example_id": "b734ebb1-f804-4636-8c7e-3ec631cc4b2c",
                                "sense_id": "ae3f2068-b1e8-3e70-95fb-4d6815642963",
                                "text": "Labrador jest psem masywnym, grubokościstym i jak wszystkie rasy tego typu - skłonnym do dysplazji stawów biodrowych"
                            },
                            {
                                "example_id": "4e35a003-582a-4879-8c4b-735488f565e5",
                                "sense_id": "ae3f2068-b1e8-3e70-95fb-4d6815642963",
                                "text": "Co moda robi z rasą widać dobrze na przykładzie labradorów i goldenów"
                            }
