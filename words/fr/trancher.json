                    "frequency": "High",
                    "semantic_group_id": "decider",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal doit bientôt <w>trancher</w> le litige qui oppose les deux copropriétaires."
                        },
                        {
                            "text": "Après des heures de délibération, le comité a choisi de <w>trancher</w> la question."
