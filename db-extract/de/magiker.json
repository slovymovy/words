                "senses": [
                    {
                        "sense_id": "8be00843-3bc4-36ab-b070-11bcb1f816e1",
                        "entry_id": "5f7ea9bf-fea0-31fe-82f9-10935aa5637d",
                        "glosses": [
                            "jemand, der scheinbar übernatürliche Fähigkeiten besitzt und anwendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8473d7fa-329b-41d1-bd02-928541905793",
                                "sense_id": "8be00843-3bc4-36ab-b070-11bcb1f816e1",
                                "text": "„Der Dämon, welcher erschien, nannte sich nicht Mephistopheles, sondern Astaroth, ein Name, welcher ursprünglich vielleicht identisch ist mit dem Namen der Astarte, obgleich letztere in den Geheimschriften der Magiker für die Gattin des Astaroths gehalten wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5693c459-9d12-49d6-ad9e-27f456664c6d",
                        "source_entry_id": "5f7ea9bf-fea0-31fe-82f9-10935aa5637d",
                        "source_sense_id": "8be00843-3bc4-36ab-b070-11bcb1f816e1",
