                            {
                                "target_word": "fibrös",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "741fcdd1-660c-38e4-b7bf-fc4bc3c4ee5a",
                                        "entry_id": "0d8b14dd-ea08-3b2c-94a4-ca7399eaacd1",
                                        "glosses": [
                                            "aus Bindegewebe bestehend; zu Bindegewebe umgewandelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15c22666-c1b2-4b07-bb0a-c8793dc8721c",
                                                "sense_id": "741fcdd1-660c-38e4-b7bf-fc4bc3c4ee5a",
                                                "text": "Fibröse Läsionen des Knochens zeigen eine relative Häufigkeit mit einer hohen Dunkelziffer, da sie oftmals klinisch stumm verlaufen."
                                            },
                                            {
                                                "example_id": "f4b2a11d-5f86-4b9f-b95a-ab4d95d566ec",
                                                "sense_id": "741fcdd1-660c-38e4-b7bf-fc4bc3c4ee5a",
                                                "text": "Zu den häufigsten tumorähnlichen Veränderungen des Knochens überhaupt zählt das nichtossifizierende Fibrom sowie der fibröse Kortikalisdefekt."
                                            },
                                            {
                                                "example_id": "5cdd3805-9882-4238-8514-30fbdc9492c1",
                                                "sense_id": "741fcdd1-660c-38e4-b7bf-fc4bc3c4ee5a",
                                                "text": "Fibröse Papeln gehören zu den häufigsten benignen Hauttumoren und werden bei der Hautuntersuchung in der Regel ignoriert."
                                            },
                                            {
                                                "example_id": "c33fbaec-6e7d-4297-b724-1a0b1a895449",
                                                "sense_id": "741fcdd1-660c-38e4-b7bf-fc4bc3c4ee5a",
                                                "text": "In Zusammenarbeit mit mehreren Schweizerischen und ausländischen Spitälern werden Daten über solitäre fibröse Pleuratumore gesammelt."
                                            },
                                            {
                                                "example_id": "224e7e63-f745-4975-8c66-ed44c9e5f5e5",
                                                "sense_id": "741fcdd1-660c-38e4-b7bf-fc4bc3c4ee5a",
                                                "text": "Joberi beobachtete einen fibrösen Polypen an der Stelle, wo Blase und Scheide aneinander liegen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
