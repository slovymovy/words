                ],
                "translations": [
                    {
                        "translation_id": "b09493e7-d6f2-4b40-92aa-54a0645b60cf",
                        "source_entry_id": "59813c01-0e7c-3011-b5ff-dd16560bde71",
                        "source_sense_id": "d0a9389c-1f7f-3584-8414-b26aa2c33852",
                        "target_lang_word": "on one's own",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "on one's own",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09c25358-7736-3a18-83d7-50d3cb2e1dd0",
                                        "entry_id": "5e83ce94-5221-33e4-8da1-0370eeed0adf",
                                        "glosses": [
                                            "Unaided; without assistance or help from others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87c9b30b-28ae-4267-88b3-2a7263537db9",
                                                "sense_id": "09c25358-7736-3a18-83d7-50d3cb2e1dd0",
                                                "text": "Private operators, for the most part have done an admirable job of keeping these aging aircraft flying, but FAA has essentially said, “It’s public-use aircraft. You’re on your own.”"
                                            },
                                            {
                                                "example_id": "ca10ba25-28ae-42c4-aade-13c51eae9ebf",
                                                "sense_id": "09c25358-7736-3a18-83d7-50d3cb2e1dd0",
                                                "text": "They may adamantly reject help and insist that they can manage on their own."
                                            },
                                            {
                                                "example_id": "7e8198ec-caeb-4fe1-abe9-da211e37a253",
                                                "sense_id": "09c25358-7736-3a18-83d7-50d3cb2e1dd0",
                                                "text": "A seven-year-old can get dressed on his own, but it might take a long time."
                                            },
                                            {
                                                "example_id": "65571d1a-9328-4df7-a868-75f8aa1f3782",
                                                "sense_id": "09c25358-7736-3a18-83d7-50d3cb2e1dd0",
                                                "text": "1966, Vicki Wickham, Simon Napier-Bell (English lyrics), Dusty Springfield (vocalist), You Don't Have to Say You Love Me, 1965, Pino Donaggio, Vito Pallavicini, Io che non vivo (senza te),\nDon't you see / That now you've gone, / And I'm left here on my own, / I will have to follow you / And beg you to come home."
                                            },
                                            {
                                                "example_id": "649d1424-a15d-4b3f-876f-0fe542d9d5b5",
                                                "sense_id": "09c25358-7736-3a18-83d7-50d3cb2e1dd0",
                                                "text": "After Bridge of Orchy, the line climbs steeply into the wild country of Rannoch Moor. The railway builders chose a different route across the moor from the road - we are completely on our own up here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bd5a4c8-a445-368b-b971-9cfb17c07bdd",
                                        "entry_id": "5e83ce94-5221-33e4-8da1-0370eeed0adf",
                                        "glosses": [
                                            "Alone, without another's immediate company."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c3554b0-0558-4a42-b3bd-c8f732060d35",
                                                "sense_id": "9bd5a4c8-a445-368b-b971-9cfb17c07bdd",
                                                "text": "I love cheese on toast, but I won't eat cheese on its own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3276e63-6be2-49ed-9986-98f2a77f464c",
                        "source_entry_id": "59813c01-0e7c-3011-b5ff-dd16560bde71",
                        "source_sense_id": "d0a9389c-1f7f-3584-8414-b26aa2c33852",
