                "senses": [
                    {
                        "sense_id": "61148490-b1c5-3edc-94d5-c258edbdf848",
                        "entry_id": "7b46531f-44c1-359b-a6d2-0b8146d989d2",
                        "glosses": [
                            "political issue"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "900fc767-b9af-416d-9508-c08d47a3e274",
                                "sense_id": "61148490-b1c5-3edc-94d5-c258edbdf848",
                                "text": "Nur bei uns Juden sträuben sich noch manche ängstlich, in der Judenfrage ein Politikum zu sehen."
                            },
                            {
                                "example_id": "26b65ed0-28d0-4770-9c82-07bd0e3fc2e4",
                                "sense_id": "61148490-b1c5-3edc-94d5-c258edbdf848",
                                "text": "Das wertvolle Farmland ist in Namibia mehrheitlich in der Hand weißer Farmer, und das ist eines der großen Politika des Landes. Nur etwa 5 Prozent der namibischen Bevölkerung sind weiß."
                            },
                            {
                                "example_id": "d6037ff2-499e-4b35-bbaa-2e868061e869",
                                "sense_id": "61148490-b1c5-3edc-94d5-c258edbdf848",
                                "text": "Warum es zu dem Unfall kam, ist noch unbekannt. Doch unabhängig davon, ob Mensch oder Technik oder beide hier versagten – in der Branche ist jeder Unfall oder Beinahe-Unfall ein Politikum."
                            }
                        ]
                    }
