                "senses": [
                    {
                        "sense_id": "03eb0993-e95b-3c80-9230-c6090645a19e",
                        "entry_id": "bec00734-4ec5-33da-8b68-5e7f21342f31",
                        "glosses": [
                            "heel erg koud"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "014a848c-79e8-4652-b14b-6108640bd98f",
                                "sense_id": "03eb0993-e95b-3c80-9230-c6090645a19e",
                                "text": "Hij plaatst ze in de serre van een groot huis, de minst geschikte plek om zich hartje winter op te houden. Het is er steenkoud, de verwarming hapert, de familieleden kleumen. De lokatie is een psychologische metafoor: van diepgevroren emoties."
                            },
                            {
                                "example_id": "14e93833-60da-4323-bdd6-079c9f16193c",
                                "sense_id": "03eb0993-e95b-3c80-9230-c6090645a19e",
                                "text": "De nachten werden steenkoud waardoor ik met al mijn kleren aan moest slapen."
                            }
                        ]
                    },
                    {
                        "sense_id": "dae96236-4f7f-39e5-9e8f-fea14209707e",
                        "entry_id": "bec00734-4ec5-33da-8b68-5e7f21342f31",
                        "glosses": [
                            "zonder enig medegevoel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c8c878e-6c96-44ea-87b9-4348d8855141",
                                "sense_id": "dae96236-4f7f-39e5-9e8f-fea14209707e",
                                "text": "Bij die ouders en hun schare personeel groeide Juliana op in een soms steenkoud paleis. Daar ontwikkelde ze al snel het verlangen om ‘gewoon’ te zijn. Dat verlangen was voorstelbaar, de onmogelijkheid om het werkelijk te realiseren was evident."
                            }
                        ]
                    }
