                    {
                        "translation_id": "06d0b405-4612-4f56-a68b-ec6e211ec085",
                        "source_entry_id": "bc430f06-7fba-3a8b-abf1-cc3e70779da2",
                        "source_sense_id": "d5c5d806-afdf-3a55-8c4a-0b5553256043",
