                                                "sense_id": "d0427bbb-1e80-32f0-8996-873b32aa3b99",
                                                "text": "Pogłębiając wiarę w rzeczywistą obecność Chrystusa w Eucharystii, Kościół uświadomił sobie sens milczącej adoracji Chrystusa obecnego pod postaciami eucharystycznymi"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "acb8c79a-ccea-3290-b0a4-310ccd660ad8",
                                        "entry_id": "0c349625-0428-33e0-aeed-4d22522dec40",
                                        "glosses": [
                                            "porządek celebracji liturgicznej w chrześcijaństwie, inaczej msza"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50cb3b85-c0b5-4e6d-8a0d-901ab67c1a9a",
                                                "sense_id": "acb8c79a-ccea-3290-b0a4-310ccd660ad8",
                                                "text": "Tylko kapłani ważnie wyświęceni mogą przewodniczyć Eucharystii i konsekrować chleb i wino, aby stały się Ciałem i Krwią Pana"
                                            }
