                {
                    "sense_id": "ee0024a6-ca91-3ba0-8f2e-a038989c9fe9",
                    "sense_definition": "zichzelf of iemand anders van kleding voorzien",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kleding_dragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet me nog snel <w>kleden</w> voor het feestje vanavond.",
                            "target_lang_translations": {
                                "en": "I still need to <w>dress</w> quickly for the party tonight.",
                                "ru": "Мне нужно еще быстро <w>одеться</w> к сегодняшней вечеринке."
                            }
                        },
                        {
                            "text": "Zij helpt haar kleine broertje om zich warm te <w>kleden</w> tegen de kou.",
                            "target_lang_translations": {
                                "en": "She helps her little brother to <w>dress</w> warmly against the cold.",
                                "ru": "Она помогает своему младшему брату тепло <w>одеться</w>, чтобы не замерзнуть."
                            }
                        }
                    ],
                    "synonyms": [
                        "aankleedden"
                    ],
                    "antonyms": [
                        "uitkleden"
                    ],
                    "common_phrases": [
                        "zich warm kleden",
                        "zich netjes kleden"
                    ],
                    "target_lang_definitions": {
                        "en": "to provide oneself or someone else with clothing",
                        "ru": "обеспечивать себя или кого-то другого одеждой; надевать одежду"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dress",
                                "target_lang_sense_clarification": "to put clothes on oneself or another"
                            },
                            {
                                "target_lang_word": "clothe",
                                "target_lang_sense_clarification": "to provide with or cover in clothing"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "одеваться",
                                "target_lang_sense_clarification": "надевать одежду на себя"
                            },
                            {
                                "target_lang_word": "одевать",
                                "target_lang_sense_clarification": "снабжать одеждой другого человека"
                            }
                        ]
                    }
                },
                {
