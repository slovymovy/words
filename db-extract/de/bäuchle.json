                "senses": [
                    {
                        "sense_id": "9f54b9d5-4822-3930-932d-0a3b991b7f1c",
                        "entry_id": "aa47324e-3943-3743-9eec-a6746c923a5d",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c10f6aa-3ca3-4766-9285-790f494fd492",
                                "sense_id": "9f54b9d5-4822-3930-932d-0a3b991b7f1c",
                                "text": "Frau Bäuchle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "043e9d76-b472-46c1-ad98-dc8b6b70f1b8",
                                "sense_id": "9f54b9d5-4822-3930-932d-0a3b991b7f1c",
                                "text": "Herr Bäuchle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6d9e6a49-c006-4f1d-917e-d499f31b1548",
                                "sense_id": "9f54b9d5-4822-3930-932d-0a3b991b7f1c",
                                "text": "Die Bäuchles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "487f029b-2645-4436-9ce5-782d258b0c4a",
                                "sense_id": "9f54b9d5-4822-3930-932d-0a3b991b7f1c",
                                "text": "Der Bäuchle trägt nie die Pullover, die die Bäuchle ihm strickt."
                            },
                            {
                                "example_id": "21a58ea0-6487-406d-8d8c-61689bc5420c",
                                "sense_id": "9f54b9d5-4822-3930-932d-0a3b991b7f1c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bäuchle kommt, geht der Herr Bäuchle.“"
                            },
                            {
                                "example_id": "864e2198-40ed-4b9b-818b-40a3f046aa2f",
                                "sense_id": "9f54b9d5-4822-3930-932d-0a3b991b7f1c",
                                "text": "Bäuchle kommt und geht."
                            },
                            {
                                "example_id": "0fb2c890-d561-4e2d-86ab-e63ab3a62c9b",
                                "sense_id": "9f54b9d5-4822-3930-932d-0a3b991b7f1c",
                                "text": "Bäuchles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
