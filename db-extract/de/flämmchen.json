                ],
                "senses": [
                    {
                        "sense_id": "a379e31d-72bc-3ff8-8a2d-0dc194cb7224",
                        "entry_id": "b57ebf5d-2444-38e2-8ebc-bf8e926967c7",
                        "glosses": [
                            "kleine Flamme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d1e5e16-9315-475a-8c3c-2fb24da77a20",
                                "sense_id": "a379e31d-72bc-3ff8-8a2d-0dc194cb7224",
                                "text": "„All das wurde gesprochen, während beide heftig erregt über den Teppich hinschritten; das Flämmchen unter dem Wasserkessel brannte weiter, und der Dampf stieg in kleinen Säulen zwischen den beiden Bronzelampen in die Höh’.“"
                            },
                            {
                                "example_id": "3979e71e-b159-4dec-a19f-74e2cb20f6cc",
                                "sense_id": "a379e31d-72bc-3ff8-8a2d-0dc194cb7224",
                                "text": "„Der Spiritus war ein stinkender Ersatzspiritus, doch sein Flämmchen erfüllte unsere entleerten Herzen mit einem Ersatz von Heimat und Herd.“"
                            },
                            {
                                "example_id": "319f340b-6ef6-461b-b9c1-e2affcc51765",
                                "sense_id": "a379e31d-72bc-3ff8-8a2d-0dc194cb7224",
                                "text": "„Harbert hielt das Flämmchen vorsichtig an den Fidibus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
