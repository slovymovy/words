                    {
                        "translation_id": "f65fc29b-8fcf-4ece-a1dc-1dbbf6874c89",
                        "source_entry_id": "74a20aef-3042-3f6f-8aba-b7026919b91c",
                        "source_sense_id": "ae05d5c7-2085-3f34-ace4-8a372d7f2db9",
                        "source_sense_description": "historisch, Militär: kleinste Einheit der Kavallerie",
                        "target_lang_word": "escadron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escadron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b750aa93-7f40-3fab-863c-dbfce0b79cfe",
                                        "entry_id": "6979bfab-2573-3dd5-a54d-8d2ea4be7ee2",
                                        "glosses": [
                                            "Troupe, généralement de cavalerie, composée d’une ou de plusieurs compagnies, et, en général, de quatre au plus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4d347d0-7358-45c8-acff-fae07f692d3f",
                                                "sense_id": "b750aa93-7f40-3fab-863c-dbfce0b79cfe",
                                                "text": "On se bûchera ! reprit Soudry, c’est selon. Si le préfet et le général, qui sont ses amis, envoient un escadron de cavalerie, les paysans ne bûcheront rien…"
                                            },
                                            {
                                                "example_id": "819f642d-85b1-4af7-831d-a603df78a1c4",
                                                "sense_id": "b750aa93-7f40-3fab-863c-dbfce0b79cfe",
                                                "text": "Il s'avançait, précédé d'un escadron de mousquetaires Louis XIII, montés sur des chevaux de troupe, et suivi par un char monumental qui portait tous les dieux de l'Olympe, y compris le Temps, armé de la faux classique."
                                            },
                                            {
                                                "example_id": "32584aeb-c923-4bff-997b-ca38bcbac300",
                                                "sense_id": "b750aa93-7f40-3fab-863c-dbfce0b79cfe",
                                                "text": "Un escadron de cuirassiers, de chasseurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffd5af79-8cc7-3367-b312-fa811a681545",
                                        "entry_id": "6979bfab-2573-3dd5-a54d-8d2ea4be7ee2",
                                        "glosses": [
                                            "Unité d’avions de combat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78740056-ece1-4d9a-ab59-8a46848ee7e1",
                                                "sense_id": "ffd5af79-8cc7-3367-b312-fa811a681545",
                                                "text": "En novembre, un premier escadron de F-16V a été déployé par les forces aériennes taïwanaises."
                                            },
                                            {
