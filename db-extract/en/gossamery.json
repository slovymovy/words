                        "glosses": [
                            "Like gossamer; flimsy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53b2c9de-ce23-49ec-ac01-11436bfa7c5d",
                                "sense_id": "ae52d8da-3dc1-3ae8-a11b-d368c5d3ae7d",
                                "text": "The Italian poet, [Giambattista] Marino, had been reputed the greatest master of gossamery affectation in Europe."
                            },
                            {
                                "example_id": "3115b85e-ec9c-4e11-97cc-8c1c92cb1ecf",
                                "sense_id": "ae52d8da-3dc1-3ae8-a11b-d368c5d3ae7d",
                                "text": "She fluttered about him with her hair down in a thick brown braid across each shoulder, and in a gossamery, filmy, lacy “thing”—she had flung her gay-colored cloak upon a chair—that he was very much afraid was not quite a proper thing to wear before a young gentleman whom she had just met."
                            }
                        ]
                    }
