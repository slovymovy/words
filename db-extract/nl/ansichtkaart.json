                        ],
                        "form": "ansichtkaartje"
                    },
                    {
                        "form_id": "9e7ba4d6-e942-4951-8ba8-af500c4829c4",
                        "entry_id": "76f4e97b-9a5f-3acc-bfe2-037501815d00",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "ansichtkaartjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0ec1e6b2-fa4c-36b3-a701-957a0dda2fbb",
                        "entry_id": "76f4e97b-9a5f-3acc-bfe2-037501815d00",
                        "glosses": [
                            "een postkaart met een afbeelding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7d2724f-f14d-4927-a829-116debcc85d8",
                                "sense_id": "0ec1e6b2-fa4c-36b3-a701-957a0dda2fbb",
                                "text": "Zullen we de familie een ansichtkaart vanaf Griekenland sturen?"
                            },
                            {
                                "example_id": "c6d2e470-308a-4c9f-a1af-5384619a6861",
                                "sense_id": "0ec1e6b2-fa4c-36b3-a701-957a0dda2fbb",
                                "text": "Vanaf de brug had ik een uitzicht als een ansichtkaart met architectuur, water, gondels en klokkentorens."
                            },
                            {
                                "example_id": "6ba56c09-c980-44c5-b68b-8e4caeb31f73",
                                "sense_id": "0ec1e6b2-fa4c-36b3-a701-957a0dda2fbb",
                                "text": "Chantal zag dat er naast een stapeltje ansichtkaarten twee rode polsbandjes in het tasje lagen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "727d0d2e-11f2-4279-bf90-f58e3e13fdbe",
                        "source_entry_id": "76f4e97b-9a5f-3acc-bfe2-037501815d00",
                        "source_sense_id": "0ec1e6b2-fa4c-36b3-a701-957a0dda2fbb",
                        "source_sense_description": "een postkaart met een afbeelding",
                        "target_lang_word": "Ansichtskarte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ansichtskarte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                        "entry_id": "b731ff9e-ecdb-337c-9a38-8c121f67c4e1",
                                        "glosses": [
                                            "Postkarte mit der Abbildung eines Gebäudes, Ortes oder Ähnliches auf der Rückseite (Bildseite)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d98fe0d-b1fe-4e66-94c5-9fc0f91fa702",
                                                "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                                "text": "Schau, eine Ansichtskarte aus New York mit der Freiheitsstatue drauf!"
                                            },
                                            {
                                                "example_id": "6cf9da3c-6fe7-4274-a8d7-e9846a29d1e9",
                                                "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                                "text": "„Ich hatte weitere Ansichtskarten einstecken, damit sie sehen konnte, wie die jetzt kaputten Kirchen und Giebelhäuser früher ausgesehen hatten.“"
                                            },
                                            {
                                                "example_id": "c3d010c0-da7d-440f-9574-5665d1aa2272",
                                                "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                                "text": "„Oben in der Nähe der Brücke entdeckte ich einen Kiosk mit vielen Ansichtskarten von der Umgebung.“"
                                            },
                                            {
                                                "example_id": "476072b1-f46b-48a1-8f1a-ba108331dde4",
                                                "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                                "text": "„Nachhause schrieb ich eine Ansichtskarte mit dem Maschsee vornedrauf.“"
                                            },
                                            {
                                                "example_id": "829b5853-40e6-4edb-8646-9deaee470653",
                                                "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                                "text": "„Die Sammlung selbst umfaßt inzwischen mehr als 400 teils farbige Post- und Ansichtskarten des gesamten Eichsfeldes, von denen in diesem Bildband circa 130 auf Alt-Duderstadt bezogene Ansichtskarten veröffentlicht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e10ea6cd-8eb9-4784-976a-9aef6cb17f70",
                        "source_entry_id": "76f4e97b-9a5f-3acc-bfe2-037501815d00",
                        "source_sense_id": "0ec1e6b2-fa4c-36b3-a701-957a0dda2fbb",
                        "source_sense_description": "een postkaart met een afbeelding",
                        "target_lang_word": "Postkarte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Postkarte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d1e9227-0a22-3c13-9d8f-6ac0393741c7",
                                        "entry_id": "6f51f998-5928-3583-9652-f40238e8c796",
                                        "glosses": [
                                            "Karte, die auf der einen Seite zumeist mit einem Motiv – etwa einem Foto, einem Kunstwerk oder einer Collage –, sowie gegebenenfalls zum Motiv gehörigem Text bedruckt ist und auf der anderen Seite Platz für eine schriftliche Mitteilung sowie die Adressangabe und zum Aufkleben von Briefmarken bietet, so dass die Karte auch ohne Kuvert verschickt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b49cec5-8d90-4c45-9fc1-5918a78f62fc",
                                                "sense_id": "9d1e9227-0a22-3c13-9d8f-6ac0393741c7",
                                                "text": "Er versendete im Urlaub eine Postkarte an seine Schwester."
                                            },
                                            {
                                                "example_id": "dc9a94d9-4713-4cd6-92a8-46f819b0d095",
                                                "sense_id": "9d1e9227-0a22-3c13-9d8f-6ac0393741c7",
                                                "text": "„Auf den Schnee schien die Sonne, und der Kurort sah wie auf Postkarten aus.“"
                                            },
                                            {
                                                "example_id": "b3dad4e9-a95c-4566-b0af-b91bf1a62a1d",
                                                "sense_id": "9d1e9227-0a22-3c13-9d8f-6ac0393741c7",
                                                "text": "„Jetzt denkt er, wie er die Postkarte von dem verrückten Kerl rasch befördern kann und wie noch einen Moment rasch zu Cilly rauf, das Mädel wartet.“"
                                            },
                                            {
                                                "example_id": "1126c5b5-aa36-4a77-a367-197cac8bf024",
                                                "sense_id": "9d1e9227-0a22-3c13-9d8f-6ac0393741c7",
                                                "text": "„Ich verbrachte einige Zeit damit, die zweifelhaften Postkarten zu studieren, die in ungeheuren Mengen hinter den Schaufenstern aushingen.“"
                                            },
                                            {
                                                "example_id": "22074804-51bf-4cc9-bef1-a2efb484df70",
                                                "sense_id": "9d1e9227-0a22-3c13-9d8f-6ac0393741c7",
                                                "text": "„Eos tastet nach den Postkarten in ihrer Manteltasche.“"
                                            },
                                            {
                                                "example_id": "e1431680-0990-46a5-8413-e4fd6a9479b2",
                                                "sense_id": "9d1e9227-0a22-3c13-9d8f-6ac0393741c7",
                                                "text": "„Eingeführt im Jahr 1869, avancierten Postkarten schnell zum meist genutzten Nachrichtenträger, doch hatten sie den Nachteil, dass sie von jedermann gelesen werden konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3be99229-721a-4e6a-9a79-24f5d621752f",
                        "source_entry_id": "76f4e97b-9a5f-3acc-bfe2-037501815d00",
                        "source_sense_id": "0ec1e6b2-fa4c-36b3-a701-957a0dda2fbb",
                        "source_sense_description": "een postkaart met een afbeelding",
