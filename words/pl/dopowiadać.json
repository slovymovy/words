            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67d9c792-e406-3b78-a23a-feec695d2997",
                    "sense_definition": "dokończyć wypowiedź, powiedzieć coś do końca",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mówienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę <w>dopowiedzieć</w> tę historię do końca, bo jest bardzo ważna.",
                            "target_lang_translations": {
                                "ru": "Я должен <w>договорить</w> эту историю до конца, потому что она очень важна."
                            }
                        },
                        {
                            "text": "Pozwól mi <w>dopowiedzieć</w> moje zdanie, zanim zaczniesz mnie przerywać.",
                            "target_lang_translations": {
                                "ru": "Позволь мне <w>договорить</w> мою мысль, прежде чем начнешь меня перебивать."
                            }
                        }
                    ],
                    "synonyms": [
                        "dokańczać"
                    ],
                    "common_phrases": [
                        "dopowiedzieć do końca"
                    ],
                    "target_lang_definitions": {
                        "ru": "закончить высказывание, договорить до конца"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "договорить",
                                "target_lang_sense_clarification": "завершить начатую речь"
                            },
                            {
                                "target_lang_word": "закончить",
                                "target_lang_sense_clarification": "завершить высказывание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c41367ba-312f-3dda-96d0-dc67a5856c0a",
                    "sense_definition": "dodać coś do już wypowiedzianych słów, uzupełnić wypowiedź",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mówienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chciałbym jeszcze <w>dopowiedzieć</w> kilka słów na temat tego projektu.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы еще <w>добавить</w> несколько слов по поводу этого проекта."
                            }
                        },
                        {
                            "text": "W trakcie dyskusji każdy mógł <w>dopowiedzieć</w> swoje uwagi do raportu.",
                            "target_lang_translations": {
                                "ru": "В ходе дискуссии каждый мог <w>добавить</w> свои замечания к отчету."
                            }
                        }
                    ],
                    "synonyms": [
                        "domawiać"
                    ],
                    "common_phrases": [
                        "dopowiedzieć kilka słów"
                    ],
                    "target_lang_definitions": {
                        "ru": "добавить что-то к уже сказанному, дополнить высказывание"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добавить",
                                "target_lang_sense_clarification": "внести дополнение к сказанному"
                            },
                            {
                                "target_lang_word": "дополнить",
                                "target_lang_sense_clarification": "расширить сказанное новыми деталями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "facc1449-1a19-374b-800b-8a77a9bb4a30",
                    "sense_definition": "dać komuś wskazówkę, podpowiedzieć coś",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mówienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciel musiał mu <w>dopowiedzieć</w> odpowiedź, bo uczeń zapomniał definicji.",
                            "target_lang_translations": {
                                "ru": "Учителю пришлось <w>подсказать</w> ему ответ, потому что ученик забыл определение."
                            }
                        },
                        {
                            "text": "Nie chciałem mu <w>dopowiedzieć</w> rozwiązania, żeby sam mógł na nie wpaść.",
                            "target_lang_translations": {
                                "ru": "Я не хотел <w>подсказывать</w> ему решение, чтобы он сам мог до него додуматься."
                            }
                        }
                    ],
                    "synonyms": [
                        "podpowiadać"
                    ],
                    "target_lang_definitions": {
                        "ru": "дать кому-то подсказку, подсказать что-то"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсказать",
                                "target_lang_sense_clarification": "дать подсказку, помочь с ответом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
