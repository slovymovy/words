            "pos": "noun",
            "senses": [
                {
                    "sense_id": "df21fb43-1e15-3666-9c7a-368a4e1096c7",
                    "sense_definition": "Morceau détaché ou pendant d'une étoffe ou d'une matière souple qui a été déchirée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "morceau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir traversé les ronces, sa chemise était complètement en <w>lambeaux</w>."
                        },
                        {
                            "text": "Elle a retrouvé un <w>lambeau</w> d'étoffe rouge accroché à la clôture du jardin."
                        }
                    ],
                    "synonyms": [
                        "chiffon",
                        "guenille",
                        "haillon"
                    ],
                    "common_phrases": [
                        "en lambeaux",
                        "tomber en lambeaux"
                    ]
                },
                {
                    "sense_id": "8624998a-6330-34f0-b248-339ad03e2d97",
                    "sense_definition": "Fragment résiduel ou reste isolé de quelque chose de détruit, de dispersé ou d'interrompu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent soufflait fort et dispersait de pâles <w>lambeaux</w> de brume au-dessus de la vallée."
                        },
                        {
                            "text": "Nous n'avons réussi à entendre que quelques <w>lambeaux</w> de leur conversation animée."
                        }
                    ],
                    "synonyms": [
                        "débris",
                        "fragment",
                        "morceau"
                    ],
                    "antonyms": [
                        "totalité"
                    ],
                    "common_phrases": [
                        "lambeaux de brume",
                        "lambeaux de phrases"
                    ]
                },
                {
                    "sense_id": "ac817e15-1981-3c03-8ce2-c54dc633b4c7",
                    "sense_definition": "Morceau de chair ou de peau arraché, ou segment de tissu prélevé pour une greffe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "morceau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'animal blessé a laissé un <w>lambeau</w> de chair sanglante sur les barbelés."
                        },
                        {
                            "text": "Le chirurgien a prélevé un <w>lambeau</w> cutané pour réparer les tissus endommagés du bras."
                        }
                    ],
                    "common_phrases": [
                        "lambeau cutané",
                        "lambeau de chair"
                    ]
                }
            ]
        }
