                                "example_id": "c3c952ba-41c3-4519-93cf-25401b6340dc",
                                "sense_id": "dbe913cc-d3ab-338d-b700-1806102bf133",
                                "text": "19th c., James Russell Lowell, The Heritage\nWhat doth the poor man's son inherit?\nWishes o'erjoyed with humble things,\nA rank adjudged by toil-won merit,\nContent that from employment springs"
                            }
                        ]
                    },
                    {
                        "sense_id": "9a08831e-3905-389b-8fda-4d855a93f626",
                        "entry_id": "4d7f59ae-dd1b-3b12-97ca-526a4d2b8881",
