                    "sense_id": "66abfdbb-7230-38a9-9ce8-0ebf7a4ed4f5",
                    "sense_definition": "de uiterlijke vorm of verschijning van een menselijk lichaam",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de verte zag ik een <w>gestalte</w> door de mist lopen.",
                            "target_lang_translations": {
                                "en": "In the distance, I saw a <w>figure</w> walking through the mist."
                            }
                        },
                        {
                            "text": "Er verscheen plotseling een rijzige <w>gestalte</w> op de heuvel.",
                            "target_lang_translations": {
                                "en": "Suddenly, a tall <w>figure</w> appeared on the hill."
                            }
