                "senses": [
                    {
                        "sense_id": "a311ea85-c653-3ae9-8801-7f363e1af449",
                        "entry_id": "2c7ad22f-2b3d-33fd-a554-93b40f1740c6",
                        "glosses": [
                            "Störung der Schreibfähigkeit, leichte Form der Agraphie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84ab0876-ce9f-4363-8576-aaf745efe029",
                                "sense_id": "a311ea85-c653-3ae9-8801-7f363e1af449",
                                "text": "„Der Begriff Dysgraphie (lat. dys = etwas schlecht können; graphia = auf den Schreibpromss bezogen) beschreibt die durch Probleme bei der neurologischen Verarbeitung bedingte Schwierigkeit, Buchstaben, Wörter oder Zahlen mit Leichtigkeit zu schreiben.“"
                            },
                            {
                                "example_id": "89a9f9bc-f86d-4cba-8a6f-e8688aa5343e",
                                "sense_id": "a311ea85-c653-3ae9-8801-7f363e1af449",
                                "text": "„Eine Dysgraphie bezeichnet die Unfähigkeit, Wörter und Texte zu schreiben, obgleich die dafür notwendige Handmotorik und die dafür notwendige Intelligenz vorhanden sind.“"
                            },
                            {
                                "example_id": "72a96c64-c0e7-47af-9413-f410cfa371bf",
                                "sense_id": "a311ea85-c653-3ae9-8801-7f363e1af449",
                                "text": "„Die Übungsbehandlung der Dysgraphie erfolgt meist zusammen mit der Dyslexietherapie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
