{
    "word_family": [
        "welk"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "199b4b26-9268-36b5-96c5-416af76e1b3a",
                    "sense_definition": "Vragend voornaamwoord dat vraagt naar een keuze uit een beperkt aantal mogelijkheden.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interrogative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb drie verschillende boeken, <w>welke</w> wil je graag lezen?",
                            "target_lang_translations": {
                                "en": "I have three different books, <w>which</w> would you like to read?",
                                "ru": "У меня есть три разные книги, <w>какую</w> ты хочешь почитать?"
                            }
                        },
                        {
                            "text": "Er staan veel auto's op de parkeerplaats, <w>welke</w> is van jou?",
                            "target_lang_translations": {
                                "en": "There are many cars in the parking lot, <w>which one</w> is yours?",
                                "ru": "На парковке много машин, <w>какая</w> из них твоя?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "welke van de twee",
                        "welke kleur"
                    ],
                    "target_lang_definitions": {
                        "en": "Interrogative pronoun used to ask for a choice from a limited number of possibilities.",
                        "ru": "Вопросительное местоимение, используемое для выбора из ограниченного числа вариантов."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "which",
                                "target_lang_sense_clarification": "interrogative pronoun for selection"
                            },
                            {
                                "target_lang_word": "which one",
                                "target_lang_sense_clarification": "specific choice from a group"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "какой",
                                "target_lang_sense_clarification": "выбор из нескольких"
                            },
                            {
                                "target_lang_word": "который",
                                "target_lang_sense_clarification": "который из"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e81497b-8825-33b1-8497-3a4c49eccc32",
                    "sense_definition": "Betrekkelijk voornaamwoord dat verwijst naar een eerder genoemd de-woord of meervoud.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De beslissing <w>welke</w> hij gisteren nam, heeft grote gevolgen voor het bedrijf.",
                            "target_lang_translations": {
                                "en": "The decision <w>which</w> he made yesterday has major consequences for the company.",
                                "ru": "Решение, <w>которое</w> он принял вчера, имеет большие последствия для компании."
                            }
                        },
                        {
                            "text": "Doordat de sneeuw het pad bedekte, was het niet altijd duidelijk <w>welke</w> richting we op moesten.",
                            "target_lang_translations": {
                                "en": "Because the snow covered the path, it wasn't always clear <w>which</w> direction we had to go.",
                                "ru": "Из-за того, что снег засыпал тропинку, не всегда было ясно, в <w>каком</w> направлении нам нужно идти."
                            }
                        }
                    ],
                    "synonyms": [
                        "die"
                    ],
                    "common_phrases": [
                        "de manier welke",
                        "de reden welke"
                    ],
                    "target_lang_definitions": {
                        "en": "Relative pronoun referring back to a previously mentioned 'de-word' (common gender noun) or plural noun.",
                        "ru": "Относительное местоимение, относящееся к ранее упомянутому существительному общего рода (de-woord) или множественному числу."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "which",
                                "target_lang_sense_clarification": "relative pronoun for things"
                            },
                            {
                                "target_lang_word": "that",
                                "target_lang_sense_clarification": "relative pronoun used in restrictive clauses"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "который",
                                "target_lang_sense_clarification": "относящийся к объекту"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "adc72a57-f876-3579-8037-af6d3df10528",
                    "sense_definition": "Verbogen vorm van <w>welk</w> gebruikt als bepaling bij een zelfstandig naamwoord.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "inflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In <w>welke</w> stad woon je tegenwoordig?",
                            "target_lang_translations": {
                                "en": "In <w>which</w> city do you live these days?",
                                "ru": "В <w>каком</w> городе ты сейчас живешь?"
                            }
                        },
                        {
                            "text": "Ik weet niet <w>welke</w> schoenen ik vandaag moet aantrekken.",
                            "target_lang_translations": {
                                "en": "I don't know <w>which</w> shoes I should put on today.",
                                "ru": "Я не знаю, <w>какие</w> туфли мне сегодня надеть."
                            }
                        }
                    ],
                    "common_phrases": [
                        "welke dag",
                        "welke kant"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "attributive form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Inflected form of 'welk' used as a determiner before a noun.",
                        "ru": "Склоняемая форма слова 'welk', используемая как определение перед существительным."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "which",
                                "target_lang_sense_clarification": "determiner used before a noun"
                            },
                            {
                                "target_lang_word": "what",
                                "target_lang_sense_clarification": "used in some contexts like 'what day'"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "какой",
                                "target_lang_sense_clarification": "перед существительным"
                            },
                            {
                                "target_lang_word": "какая",
                                "target_lang_sense_clarification": "женский род"
                            },
                            {
                                "target_lang_word": "какие",
                                "target_lang_sense_clarification": "множественное число"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5e21df86-c798-337c-acd4-14cbf083666d",
                    "sense_definition": "Aanvoegende wijs van <w>welken</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Men vreesde dat de bloem spoedig <w>welke</w> door de felle zon.",
                            "target_lang_translations": {
                                "en": "It was feared that the flower might soon <w>wither</w> due to the bright sun.",
                                "ru": "Люди боялись, что цветок вскоре <w>завянет</w> от палящего солнца."
                            }
                        },
                        {
                            "text": "Het zij zo dat de schoonheid <w>welke</w> voor de tijd.",
                            "target_lang_translations": {
                                "en": "So be it that beauty <w>fades</w> before time.",
                                "ru": "Пусть будет так, чтобы красота <w>увяла</w> перед временем."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "subjunctive mood of welken (to wither)"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Subjunctive mood of the archaic verb 'welken' (to wither or fade).",
                        "ru": "Форма сослагательного наклонения архаичного глагола 'welken' (вянуть)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wither",
                                "target_lang_sense_clarification": "subjunctive form of to fade or dry up"
                            },
                            {
                                "target_lang_word": "fade",
                                "target_lang_sense_clarification": "to lose freshness or vitality"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "завяла бы",
                                "target_lang_sense_clarification": "сослагательное наклонение, архаизм"
                            },
                            {
                                "target_lang_word": "увяла бы",
                                "target_lang_sense_clarification": "о растениях или красоте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}