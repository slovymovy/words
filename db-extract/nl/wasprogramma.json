                "senses": [
                    {
                        "sense_id": "7d4b3619-cd66-331d-bbd2-450b3ad60e6d",
                        "entry_id": "eef45bf3-9984-35f6-adb0-641cf7a74104",
                        "glosses": [
                            "serie van op elkaar afgestelde handelingen die er voor zorgen dat iets met water en zeep wordt schoongemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d28ee20e-fb12-4212-8850-eefbcec47854",
                                "sense_id": "7d4b3619-cd66-331d-bbd2-450b3ad60e6d",
                                "text": "Een autobestuurder stond gisteren raar te kijken toen hij zijn voertuig in Harderwijk in een automatische wasstraat had geplaatst. Na afloop van het wasprogramma vond hij zijn Opel Astra namelijk niet meer terug, meldde de politie vandaag."
                            },
                            {
                                "example_id": "a893c2c4-dffa-4b8e-952c-7275c5e20354",
                                "sense_id": "7d4b3619-cd66-331d-bbd2-450b3ad60e6d",
                                "text": "Maar het baasje kan ook gewoon kiezen voor een Nederlandse - onbekende - stem bij het kiezen van het wasprogramma. Douchen met of zonder shampoo of conditioner. Wel of geen behandeling met anti-vlooienmiddel. En na de wasbeurt kan de hond lekker worden droog gefohnd."
                            },
                            {
                                "example_id": "c903d348-66c9-43b8-9b2b-7b7529ae7077",
                                "sense_id": "7d4b3619-cd66-331d-bbd2-450b3ad60e6d",
                                "text": "Je knipt waslabels uit je kleding en twijfelt later wat voor stof het is. De Siemens X-Spect herkent stoffen, ook als deze uit meerdere materialen bestaan. Ook analyseert hij vlekken en stuurt hij het juiste wasprogramma naar de wasmachine."
                            }
                        ]
                    }
