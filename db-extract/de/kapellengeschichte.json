                "senses": [
                    {
                        "sense_id": "a0045247-02f2-3923-96dc-8a51027aab01",
                        "entry_id": "a5d067c1-4b36-3537-a9b7-1625b5dee876",
                        "glosses": [
                            "Vergangenheit von Kapellen als Entwicklung und Anpassung an den gesellschaftlichen Bedarf"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3ba8647f-d73c-453d-8c51-088a6a8d626f",
                                "sense_id": "a0045247-02f2-3923-96dc-8a51027aab01",
                                "text": "„Selbecke kann auf eine über 425-jährige Kapellengeschichte zurück blicken.“"
                            },
                            {
                                "example_id": "c90271dc-0399-4127-a24c-a0c486437b13",
                                "sense_id": "a0045247-02f2-3923-96dc-8a51027aab01",
                                "text": "„Zur früheren Kapellengeschichte ist daher lediglich eine “bruchstückhafte” Aufzeichnung einiger historischer Daten möglich.“"
                            },
                            {
                                "example_id": "31ba0a90-abd8-45dd-8980-68a6d32634d0",
                                "sense_id": "a0045247-02f2-3923-96dc-8a51027aab01",
                                "text": "„Für unsere Sötenicher Kapellengeschichte sind diese Jahresabschnitte bedeutsam.“"
                            },
                            {
                                "example_id": "522d2363-f9f3-40c0-9075-199df631c5e2",
                                "sense_id": "a0045247-02f2-3923-96dc-8a51027aab01",
                                "text": "„Stolz stellte Verfasser Konrad Schreiner sein in knapp bemessener Zeit, aber vielen Stunden, geschaffenes Werk vor und ging auf so manches interessante Detail der 25-jährigen Kapellengeschichte und die Bemühungen der Pinzinger vor 1990 ein.“"
                            },
                            {
                                "example_id": "c2bca4e7-6423-43cf-92cb-e5d977cec6f1",
                                "sense_id": "a0045247-02f2-3923-96dc-8a51027aab01",
                                "text": "„Eng verbunden mit der Rahmer und der Rahmer Kapellengeschichte ist die seit 1429 bestehende Antonius Bruderschaft.“"
                            },
                            {
                                "example_id": "05e5ba7b-b9b8-4869-894a-66a0200340a8",
                                "sense_id": "a0045247-02f2-3923-96dc-8a51027aab01",
                                "text": "„Wöchentlich sollen nun ein bis zwei Kapellengeschichten folgen.“"
                            },
                            {
                                "example_id": "6b0a9638-ea2d-447d-a198-4e2912f18318",
                                "sense_id": "a0045247-02f2-3923-96dc-8a51027aab01",
                                "text": "„Auch aus der Kapellengeschichte gab es Anekdoten zu hören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3443f0d0-a9db-317f-a8ee-dbc6988519b6",
                        "entry_id": "a5d067c1-4b36-3537-a9b7-1625b5dee876",
                        "glosses": [
                            "eine mündliche oder schriftliche Erzählung oder Überlieferung über Ereignisse im Zusammenhang mit einer Kapelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26645b33-56bc-4c83-91f4-37068b6faaaa",
                                "sense_id": "3443f0d0-a9db-317f-a8ee-dbc6988519b6",
                                "text": "„Wöchentlich sollen nun ein bis zwei Kapellengeschichten folgen.“"
                            },
                            {
                                "example_id": "c6eb384b-d60a-4188-b9e7-b7f3f7aa2555",
                                "sense_id": "3443f0d0-a9db-317f-a8ee-dbc6988519b6",
                                "text": "„Auch aus der Kapellengeschichte gab es Anekdoten zu hören.“"
                            },
                            {
                                "example_id": "56aa0016-c3f2-4747-a333-b1d785a0857c",
                                "sense_id": "3443f0d0-a9db-317f-a8ee-dbc6988519b6",
                                "text": "„Nach Renovierung der St. Anna-Kapelle setzten zu Weihnachten 1993 einige Mitglieder des Rommersdorf Bondorfer Bürgervereins die Jahrzehnte alte Krippentradition fort und bauten zum erstenmal in der Kapellengeschichte eine Naturwurzel-Krippe mit großem Umfeld.“"
                            },
                            {
                                "example_id": "878f72ab-758d-4a58-b420-86632b0c503a",
                                "sense_id": "3443f0d0-a9db-317f-a8ee-dbc6988519b6",
                                "text": "„Ein Paukenschlag in der Kapellengeschichte“ sei laut Frei dann das Jahr 1972 gewesen.“"
                            },
                            {
                                "example_id": "de359fe0-3a3a-4f56-916e-c4fd0dfbec52",
                                "sense_id": "3443f0d0-a9db-317f-a8ee-dbc6988519b6",
                                "text": "„Mag. Konrad Maritschnik hat unter Mitarbeit von Prof. MMag. Gert Christian in Pfarrchroniken, im Diözesanarchiv und in der Steiermärkischen Landesbibliothek in mühevoller Kleinarbeit nach Kapellengeschichten geforscht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
