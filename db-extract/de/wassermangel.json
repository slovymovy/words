                    }
                ],
                "senses": [
                    {
                        "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                        "entry_id": "37807fd1-6eaf-300d-bba6-b7bb3605e6e3",
                        "glosses": [
                            "Mangel an Wasser; Wasser ist nicht in ausreichender Menge verfügbar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "604a5e81-aa8d-4781-a2a3-90a6672e6349",
                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                "text": "Die Expeditionsteilnehmer starben durch den Wassermangel."
                            },
                            {
                                "example_id": "a94e5ef9-32f1-46dc-ae15-0aecc90d6ba2",
                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                "text": "„Der Wassermangel führte zu Ernteeinbußen in der Landwirtschaft.“"
                            },
                            {
                                "example_id": "d272bf68-531b-472e-a117-ae706f064df7",
                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                "text": "„Die UNO hat Ägypten mit seinem Bevölkerungswachstum von fast zwei Millionen Menschen pro Jahr schon für 2025 Wassermangel bescheinigt.“"
                            },
                            {
                                "example_id": "6e0fcece-c47c-4c65-b224-ad016164cfb1",
                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                "text": "„Auch die Weltorganisation für Meteorologie (⁠WMO⁠) kommt in einer 2022 veröffentlichten Analyse (externer Link) zu dem Schluss, dass der fortschreitende Klimawandel den Wassermangel verschärft.“"
                            },
                            {
                                "example_id": "de1261e0-ba62-4fab-873a-6f6a1b56f56f",
                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                "text": "„Weltweit sind bereits ein Viertel aller Städte von Wasserstress betroffen und leiden unter dauerhaftem Wassermangel.“"
                            },
                            {
                                "example_id": "f99d66e7-37a8-418c-b950-9fd6684ac7b4",
                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                "text": "„Bundesweit gibt es bislang keinen flächendeckenden Wassermangel, jedoch deutliche regionale Defizite.“"
                            },
                            {
                                "example_id": "ef9dc879-c9a0-4704-8155-2946de25f613",
                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                "text": "[Schlagzeile:] „Der Wassermangel in Europa ist ein Desaster mit Ansage“"
                            },
                            {
                                "example_id": "2188c738-8f73-40e8-a71b-5db8c19227da",
                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                "text": "„Wassermangel und Dürre bedrohen Europas Umwelt und Wirtschaft nicht nur sporadisch, sondern auf Dauer.“"
                            },
                            {
                                "example_id": "67e42c67-93bd-4603-a35a-a67ed75bea54",
                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                "text": "„Mehr als ein Viertel des EU-Territoriums ist laut der Europäischen Dürrebeobachtungsstelle (European Drought Observatory – EDO) von Wassermangel betroffen.“"
                            },
                            {
                                "example_id": "70dbe6c8-cd08-4715-8342-37000014eb1a",
                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                "text": "„Der Wassermangel war ein wichtiger Grund dafür, dass die Invasionstruppen schnell weiter aufs Festland zogen, wo auch die Hafenstadt Valona – heute Vlora – besetzt wurde.“"
                            },
                            {
                                "example_id": "4a1dd916-1f1c-4ee8-9cfa-eb4165c887b8",
                                "sense_id": "34532727-94a2-39d0-9415-9c17a7504548",
                                "text": "„Bei akutem Wassermangel hilft oft nur, Trinkwasser zu rationieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd3b0710-8606-430b-817f-29c86c54c061",
