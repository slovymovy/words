{
    "word_family": [
        "war",
        "warfare",
        "warlike",
        "warrior-like"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63cca0dd-1a30-3318-884e-9a86be96f547",
                    "sense_definition": "A person who is actively engaged in battle, conflict, or warfare; a soldier or combatant.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "combatant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>warrior</w> carried a heavy shield and a sharp spear into the battle.",
                            "target_lang_translations": {
                                "ru": "Древний <w>воин</w> нес в бой тяжелый щит и острое копье."
                            }
                        },
                        {
                            "text": "Every brave <w>warrior</w> in the tribe was ready to defend their land from the invaders.",
                            "target_lang_translations": {
                                "ru": "Каждый храбрый <w>воин</w> племени был готов защищать свою землю от захватчиков."
                            }
                        }
                    ],
                    "synonyms": [
                        "soldier",
                        "combatant",
                        "fighter"
                    ],
                    "antonyms": [
                        "pacifist",
                        "civilian"
                    ],
                    "common_phrases": [
                        "brave warrior",
                        "ancient warrior",
                        "tribal warrior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, активно участвующий в сражениях, конфликтах или войне; солдат или боец."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воин",
                                "target_lang_sense_clarification": "человек, сражающийся с врагом"
                            },
                            {
                                "target_lang_word": "боец",
                                "target_lang_sense_clarification": "участник боя или сражения"
                            },
                            {
                                "target_lang_word": "солдат",
                                "target_lang_sense_clarification": "военнослужащий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "434aba44-e3e8-341b-99d0-8ffeb7a152d9",
                    "sense_definition": "A person who is aggressively, courageously, or energetically involved in an activity, such as athletics or a social cause.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_fighter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a true weekend <w>warrior</w> who spends every Saturday competing in marathons.",
                            "target_lang_translations": {
                                "ru": "Она настоящий «<w>боец</w> выходного дня» и каждую субботу участвует в марафонах."
                            }
                        },
                        {
                            "text": "The environmental <w>warrior</w> spent her life fighting for the protection of the rainforest.",
                            "target_lang_translations": {
                                "ru": "Эта <w>защитница</w> окружающей среды посвятила жизнь борьбе за спасение тропических лесов."
                            }
                        }
                    ],
                    "synonyms": [
                        "champion",
                        "crusader",
                        "advocate"
                    ],
                    "common_phrases": [
                        "weekend warrior",
                        "eco warrior",
                        "social justice warrior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который настойчиво, мужественно или энергично занимается какой-либо деятельностью, например спортом или общественным делом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "борец",
                                "target_lang_sense_clarification": "человек, сражающийся за идею или дело"
                            },
                            {
                                "target_lang_word": "боец",
                                "target_lang_sense_clarification": "человек с сильным характером и волей к победе"
                            },
                            {
                                "target_lang_word": "активист",
                                "target_lang_sense_clarification": "энергичный защитник общественных интересов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d6564050-466a-384b-99e7-84806e0d3a94",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after Mr. <w>Warrior</w> who donated his entire book collection.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь мистера <w>Уорриора</w>, который пожертвовал всю свою коллекцию книг."
                            }
                        },
                        {
                            "text": "We are looking for a student named James <w>Warrior</w> to receive this academic award.",
                            "target_lang_translations": {
                                "ru": "Мы ищем студента по имени Джеймс <w>Уорриор</w> для вручения этой академической награды."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "used as a family name"
                        }
                    ],
