                                                "sense_id": "0c4cec21-59e2-3600-ab0e-a6bfc15891a7",
                                                "text": "Object-oriented C++ code is easier to understand for a human than C code."
                                            },
                                            {
                                                "example_id": "8de4f4ca-4bbf-456d-bdcc-b04a3d8f0349",
                                                "sense_id": "0c4cec21-59e2-3600-ab0e-a6bfc15891a7",
