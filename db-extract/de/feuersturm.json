                        ],
                        "examples": [
                            {
                                "example_id": "9cae8cdb-9593-4a64-8b8f-0a1c726c8769",
                                "sense_id": "9946da89-cb43-3295-a0a5-b45d61289781",
                                "text": "Vor 80 Jahren, im Juli 1943, sollten die Deutschen den Sturm ernten, seinen Feuersturm. Hamburg war die erste große Stadt, die mit solch zielgerichteter Grausamkeit und solcher Gründlichkeit vernichtet wurde."
                            }
