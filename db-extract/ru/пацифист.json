                    {
                        "translation_id": "4b2014df-9a49-4369-aaf2-a7466262e4ba",
                        "source_entry_id": "6f12464c-b489-3023-b95f-61f900f37262",
                        "source_sense_id": "6f41fd20-a707-300d-8d4b-41866988e1b9",
                        "target_lang_word": "Pazifist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pazifist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f848474e-5625-3481-b40f-536be1e5c718",
                                        "entry_id": "75f9cd79-bcfe-3f59-bb32-575b66390d57",
                                        "glosses": [
                                            "Anhänger des Pazifismus; Person, die den Krieg und die Gewalt ablehnt und sich für den Frieden einsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06f360a2-b413-477e-93b8-3067aefa2c9b",
                                                "sense_id": "f848474e-5625-3481-b40f-536be1e5c718",
                                                "text": "Albert Einstein war ein bekennender Pazifist."
                                            },
                                            {
                                                "example_id": "39867d39-73b5-4a27-b727-bc44f3a116ea",
                                                "sense_id": "f848474e-5625-3481-b40f-536be1e5c718",
                                                "text": "„Er untersucht mich, man müsse alle Pazifisten an die Wand stellen, sagt er, dann verschreibt er Aspirin und verweigert dem Fiebernden eine zweite Decke.“"
                                            },
                                            {
                                                "example_id": "6e52e71e-7a08-45f3-b5fd-1973b84502eb",
                                                "sense_id": "f848474e-5625-3481-b40f-536be1e5c718",
                                                "text": "„Kein Pazifist hätte sie besser formulieren können, und jetzt, während Benjamin plötzlich ganz anders redet, enthüllt die Satire ihren tiefsten Sinn.“"
                                            },
                                            {
                                                "example_id": "f1ddb13b-5075-492d-9ea1-d9a5e1e3e7b6",
                                                "sense_id": "f848474e-5625-3481-b40f-536be1e5c718",
                                                "text": "„Natürlich entspricht eine solche autoritäre Haltung nicht einmal im Ansatz der Intention des Pazifisten Remarque.“"
                                            },
                                            {
                                                "example_id": "9bad4c57-2593-462c-a5e4-61227d56739e",
                                                "sense_id": "f848474e-5625-3481-b40f-536be1e5c718",
                                                "text": "„Wenn die Gegenseite Krieg will, hilft Friedensliebe wenig. Pazifisten gelten heute als Träumer, Populisten oder Putin-Versteher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
