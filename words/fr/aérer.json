                        "s'aérer la tête"
                    ]
                },
                {
                    "sense_id": "bd6d9eb6-c61b-3c44-9a20-97dbc6db992e",
                    "sense_definition": "Faire sortir une personne pour qu'elle respire du grand air, souvent pour sa santé.",
