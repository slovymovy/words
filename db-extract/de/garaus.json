                ],
                "senses": [
                    {
                        "sense_id": "7846bd2f-9e2a-3dfb-9f11-0b7025f06df0",
                        "entry_id": "484877d0-a1a4-39f1-b3de-41b5a28c6737",
                        "glosses": [
                            "jemandem den Garaus machen – ermorden, töten, umbringen"
                        ],
                        "tags": [
                            "in der Wendung"
                        ],
                        "examples": [
                            {
                                "example_id": "b18d41de-051a-481d-b4c4-5a5e372f06ba",
                                "sense_id": "7846bd2f-9e2a-3dfb-9f11-0b7025f06df0",
                                "text": "Wer macht wem den Garaus? Ihm wurde der Garaus gemacht."
                            },
                            {
                                "example_id": "687a2668-bebd-44a5-919c-551097957262",
                                "sense_id": "7846bd2f-9e2a-3dfb-9f11-0b7025f06df0",
                                "text": "„Nach dem mühsam erkämpften Sieg machten die Römer dann dem mittelitalischen Föderalismus den Garaus.“"
                            },
                            {
                                "example_id": "60f59ef2-f5ca-41cf-9ed3-60a155128250",
                                "sense_id": "7846bd2f-9e2a-3dfb-9f11-0b7025f06df0",
                                "text": "„Wie die meisten, die mit ihm auf dem Ku'damm promenieren, weiß der achtundzwanzigjährige Paul Falkenberg von den großen politischen Auseinandersetzungen, die der ersten deutschen Demokratie den Garaus zu machen drohen, nur aus zweiter Hand.“"
                            },
                            {
                                "example_id": "a89ffd8e-eed8-429e-b3ff-3c2ca45ea1c5",
                                "sense_id": "7846bd2f-9e2a-3dfb-9f11-0b7025f06df0",
                                "text": "„Wir vermuten, daß Napoleon aus Frankreich eine Hexe hatte kommen lassen, die Walewska den Garaus machte.“"
                            },
                            {
                                "example_id": "ca4c8cfc-4cfc-4c38-8354-9444a090ec8a",
                                "sense_id": "7846bd2f-9e2a-3dfb-9f11-0b7025f06df0",
                                "text": "„Von einem späteren Zwischenspiel abgesehen, machte der Tonfilm Alf Bertini als Musiker ein für allemal den Garaus, unwiderruflich und schrecklich endgültig.“"
                            },
                            {
                                "example_id": "3b337ebf-bcf6-4df4-bc25-1c72afc7ccf4",
                                "sense_id": "7846bd2f-9e2a-3dfb-9f11-0b7025f06df0",
                                "text": "„Landwirte wollen [mit Neonicotinoiden] Schädlinge wie Läusen den Garaus machen.“ [Anmerkung: es heißt 'jemandem den Garaus machen', jemandem ist Dativ, korrekt wäre also 'Schädlingen' gewesen]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c54d6ad2-5276-32cf-8940-207d5c0ad6ab",
                        "entry_id": "484877d0-a1a4-39f1-b3de-41b5a28c6737",
                        "glosses": [
