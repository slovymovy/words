                {
                    "sense_id": "ad27a0cc-3acc-30be-98b8-fa2edcf3b510",
                    "sense_definition": "The theory that the income levels of poorer economies will eventually catch up to richer ones.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "economics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Economists debate whether global <w>convergence</w> is actually happening in the current market.",
                            "target_lang_translations": {
                                "ru": "Экономисты спорят о том, происходит ли на самом деле глобальная <w>конвергенция</w> на современном рынке."
                            }
