                ],
                "senses": [
                    {
                        "sense_id": "945c9fe7-59a7-362b-9e50-639ba92e783a",
                        "entry_id": "7e471ef5-af3a-342d-80df-9718f4004d31",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "960ee2d2-f246-481e-9532-488003f1e928",
                                "sense_id": "945c9fe7-59a7-362b-9e50-639ba92e783a",
                                "text": "Frau Willy ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3cf36784-7e53-4af5-8cc3-97cf279fe70f",
                                "sense_id": "945c9fe7-59a7-362b-9e50-639ba92e783a",
                                "text": "Herr Willy wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a35480af-dee0-48fa-bc64-3dd023babc36",
                                "sense_id": "945c9fe7-59a7-362b-9e50-639ba92e783a",
                                "text": "Die Willys fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7a0302d9-7bc6-4fee-8c95-731a9f93bc64",
                                "sense_id": "945c9fe7-59a7-362b-9e50-639ba92e783a",
                                "text": "Der Willy trägt nie die Schals, die die Willy ihm strickt."
                            },
                            {
                                "example_id": "ea70e351-09af-4215-b8a7-6146361445cf",
                                "sense_id": "945c9fe7-59a7-362b-9e50-639ba92e783a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Willy kommt, geht der Herr Willy.“"
                            },
                            {
                                "example_id": "c6bec479-0091-429b-a324-95be6d72d6ef",
                                "sense_id": "945c9fe7-59a7-362b-9e50-639ba92e783a",
                                "text": "Willy kommt und geht."
                            },
                            {
                                "example_id": "393439fb-9433-4046-82b5-67dece6a5afa",
                                "sense_id": "945c9fe7-59a7-362b-9e50-639ba92e783a",
                                "text": "Willys kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
