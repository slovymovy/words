{
    "word_family": [
        "batonnet"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "195af7b5-9a67-3c76-8550-f7a16d4890b2",
                    "sense_definition": "A short stick or tube passed from one runner to another in a relay race.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The second runner dropped the <w>baton</w> during the handoff, costing the team the race.",
                            "target_lang_translations": {
                                "ru": "Второй бегун уронил <w>эстафетную палочку</w> во время передачи, что стоило команде победы в гонке."
                            }
                        },
                        {
                            "text": "She practiced passing the <w>baton</w> smoothly with her teammates for hours.",
                            "target_lang_translations": {
                                "ru": "Она часами тренировалась плавно передавать <w>палочку</w> своим товарищам по команде."
                            }
                        }
                    ],
                    "synonyms": [
                        "rod"
                    ],
                    "common_phrases": [
                        "pass the baton"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая палочка или трубка, передаваемая от одного бегуна другому в эстафете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эстафетная палочка",
                                "target_lang_sense_clarification": "спортивный инвентарь"
                            },
                            {
                                "target_lang_word": "палочка",
                                "target_lang_sense_clarification": "в контексте эстафеты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2f38e0a-d5a9-3eda-ba0f-fb411c3da7d2",
                    "sense_definition": "A thin stick used by a conductor to direct an orchestra or choir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music_instruments",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conductor raised his <w>baton</w> and the orchestra fell silent.",
                            "target_lang_translations": {
                                "ru": "Дирижёр поднял свою <w>палочку</w>, и оркестр затих."
                            }
                        },
                        {
                            "text": "With a swift movement of her <w>baton</w>, she signaled the brass section to play louder.",
                            "target_lang_translations": {
                                "ru": "Быстрым движением своей <w>дирижёрской палочки</w> она дала знак медным духовым играть громче."
                            }
                        }
                    ],
                    "synonyms": [
                        "wand",
                        "rod"
                    ],
                    "common_phrases": [
                        "conductors baton"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая палочка, используемая дирижёром для управления оркестром или хором."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дирижёрская палочка",
                                "target_lang_sense_clarification": "для управления оркестром"
                            },
                            {
                                "target_lang_word": "палочка",
                                "target_lang_sense_clarification": "дирижёра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4324565-8b11-3793-b1da-ebec0d8e2718",
                    "sense_definition": "A short, heavy club carried as a weapon by a police officer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weapons",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer carried a <w>baton</w> for self-defense while patrolling the streets.",
                            "target_lang_translations": {
                                "ru": "Полицейский носил с собой <w>дубинку</w> для самообороны во время патрулирования улиц."
                            }
                        },
                        {
                            "text": "He tapped his expandable <w>baton</w> against his palm to ensure it was locked in place.",
                            "target_lang_translations": {
                                "ru": "Он постучал своей телескопической <w>дубинкой</w> по ладони, чтобы убедиться, что она зафиксирована."
                            }
                        }
                    ],
                    "synonyms": [
                        "billy club",
                        "nightstick",
                        "truncheon",
                        "club"
                    ],
                    "common_phrases": [
                        "police baton"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая тяжелая дубинка, используемая сотрудником полиции в качестве оружия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полицейская дубинка",
                                "target_lang_sense_clarification": "спецсредство полиции"
                            },
                            {
                                "target_lang_word": "дубинка",
                                "target_lang_sense_clarification": "резиновая или телескопическая"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b87b1414-8ecb-3269-a0cd-9a086f88161a",
                    "sense_definition": "A metal rod with weighted ends that is twirled by a drum major or majorette.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "performance_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lead majorette threw her <w>baton</w> high into the air and caught it perfectly.",
                            "target_lang_translations": {
                                "ru": "Ведущая мажоретка подбросила свой <w>жезл</w> высоко в воздух и безупречно поймала его."
                            }
                        },
                        {
                            "text": "Learning to twirl a <w>baton</w> requires excellent hand-eye coordination.",
                            "target_lang_translations": {
                                "ru": "Обучение вращению <w>жезла</w> требует отличной зрительно-моторной координации."
                            }
                        }
                    ],
                    "synonyms": [
                        "rod"
                    ],
                    "common_phrases": [
                        "baton twirling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлический стержень с утяжеленными концами, которым жонглирует мажоретка или тамбурмажор."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жезл",
                                "target_lang_sense_clarification": "для жонглирования и мажореток"
                            },
                            {
                                "target_lang_word": "палочка",
                                "target_lang_sense_clarification": "для мажореток"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd225e58-6107-3cce-acb1-b96bd2ee70b6",
                    "sense_definition": "A ceremonial staff used as a symbol of office by a field marshal or other high-ranking military officer.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ceremonial_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general was formally presented with his marshal's <w>baton</w> by the president.",
                            "target_lang_translations": {
                                "ru": "Президент официально вручил генералу его маршальский <w>жезл</w>."
                            }
                        },
                        {
                            "text": "The historic <w>baton</w> was decorated with gold stars and velvet.",
                            "target_lang_translations": {
                                "ru": "Исторический <w>жезл</w> был украшен золотыми звездами и бархатом."
                            }
                        }
                    ],
                    "synonyms": [
                        "rod"
                    ],
                    "common_phrases": [
                        "marshals baton"
                    ],
                    "target_lang_definitions": {
                        "ru": "Церемониальный жезл, используемый в качестве символа власти фельдмаршалом или другим высокопоставленным военным чином."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маршальский жезл",
                                "target_lang_sense_clarification": "символ власти военачальника"
                            },
                            {
                                "target_lang_word": "жезл",
                                "target_lang_sense_clarification": "церемониальный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cb9f83a-5d98-35ca-9d4b-13e16efe15cc",
                    "sense_definition": "A vegetable cut into a small, medium-sized stick shape, thicker than a julienne.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "culinary_cuts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef instructed the apprentice to cut the carrots into neat <w>batons</w>.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар поручил ученику нарезать морковь аккуратными <w>брусочками</w>."
                            }
                        },
                        {
                            "text": "For this recipe, potatoes should be sliced into uniform <w>batons</w> before frying.",
                            "target_lang_translations": {
                                "ru": "Для этого рецепта картофель перед жаркой следует нарезать одинаковыми <w>брусочками</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cut into batons"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly British culinary terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ нарезки овощей в форме небольших брусочков, которые толще, чем соломка (жюльен)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брусочки",
                                "target_lang_sense_clarification": "форма нарезки овощей"
                            },
                            {
                                "target_lang_word": "батоне",
                                "target_lang_sense_clarification": "кулинарный термин нарезки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "639bd197-0348-3379-a602-e4f3fa0d75a6",
                    "sense_definition": "To strike or beat someone with a baton.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rioters were <w>batoned</w> by the police when they tried to breach the barricade.",
                            "target_lang_translations": {
                                "ru": "Полиция <w>избила дубинками</w> бунтовщиков, когда те попытались прорвать баррикаду."
                            }
                        },
                        {
                            "text": "He claimed that the guards had <w>batoned</w> him during the prison protest.",
                            "target_lang_translations": {
                                "ru": "Он утверждал, что охранники <w>били</w> его <w>дубинками</w> во время протеста в тюрьме."
                            }
                        }
                    ],
                    "synonyms": [
                        "club"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить или избить кого-либо дубинкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бить дубинкой",
                                "target_lang_sense_clarification": "наносить удары спецсредством"
                            },
                            {
                                "target_lang_word": "избивать дубинками",
                                "target_lang_sense_clarification": "о действиях полиции"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}