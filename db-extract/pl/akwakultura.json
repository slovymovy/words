                "senses": [
                    {
                        "sense_id": "64f0563f-06a0-37da-8805-d94f7b8766fe",
                        "entry_id": "9b6fb403-c7f5-31ae-a89e-756d5ed9d3f2",
                        "glosses": [
                            "forma gospodarki ludzkiej, mająca na celu zwiększenie pozyskiwania żywności (rzadziej innych produktów) ze środowiska wodnego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0e26ed6-6af6-4ae5-87e8-96b1725057ee",
                                "sense_id": "64f0563f-06a0-37da-8805-d94f7b8766fe",
                                "text": "W związku z niebezpieczeństwem przełowienia licznych populacji organizmów użytkowych, zwłaszcza morskich, akwakultura postrzegana jest jako alternatywa dla tradycyjnego rybołówstwa"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e241cc2-01ab-413e-a82f-77f2dfc92fc2",
                        "source_entry_id": "9b6fb403-c7f5-31ae-a89e-756d5ed9d3f2",
                        "source_sense_id": "64f0563f-06a0-37da-8805-d94f7b8766fe",
                        "target_lang_word": "aquaculture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aquaculture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f6ba07b-af75-31e1-b007-b2fa5138cf8e",
                                        "entry_id": "1e8905fa-f220-37b6-bf55-4f2b41edf1e9",
                                        "glosses": [
                                            "The cultivation of aquatic produce such as aquatic plants, fish, and other aquatic animals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c19a39f4-2cc8-481d-a48e-6e9b0cc30de4",
                                                "sense_id": "6f6ba07b-af75-31e1-b007-b2fa5138cf8e",
                                                "text": "The indigenous species used in aquaculture are: B. gonionotus, Jullien carp (Probarbus jullieni), Jullien's mud carp (Cirrhinus jullieni), soldier-river barb (Cyclocheilichthys enoplos), Leptobarbus hoevenii, Catlocarpio siamensis and Osteochilus hasseltii."
                                            },
                                            {
                                                "example_id": "018e7685-185c-4128-8d00-4b3fb7ed717b",
                                                "sense_id": "6f6ba07b-af75-31e1-b007-b2fa5138cf8e",
                                                "text": "Finally, sturgeon aquaculture would create a sustainable industry […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4acea47f-2a66-4d7c-8a96-c33ea5d99f95",
                        "source_entry_id": "9b6fb403-c7f5-31ae-a89e-756d5ed9d3f2",
                        "source_sense_id": "64f0563f-06a0-37da-8805-d94f7b8766fe",
                        "target_lang_word": "aquaculture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aquaculture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "310207a6-1eba-3e1b-94a1-b95a9efabcca",
                                        "entry_id": "05314698-c00e-3a58-9ae4-1b46636ad8cf",
                                        "glosses": [
                                            "Élevage animal ou culture végétale en milieu aquatique."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fd1d783-daa0-4cac-9fbc-f954a2e8a19e",
                                                "sense_id": "310207a6-1eba-3e1b-94a1-b95a9efabcca",
                                                "text": "L’aquaculture fournit 60 % des poissons d’eau douce, 40 % des mollusques, 30 % des crevettes et 5 % des poissons d’eau de mer."
                                            },
                                            {
                                                "example_id": "b76b4a99-d72e-4252-9325-57ea96f8deae",
                                                "sense_id": "310207a6-1eba-3e1b-94a1-b95a9efabcca",
                                                "text": "Les activités aquacoles et agricoles sont anciennes, mais l’aquaculture ne s’est pas développée au même rythme, les surfaces exploitées en agriculture étant plus accessibles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d8c541b-fed1-46fc-8fcf-0d0279bc39da",
                        "source_entry_id": "9b6fb403-c7f5-31ae-a89e-756d5ed9d3f2",
                        "source_sense_id": "64f0563f-06a0-37da-8805-d94f7b8766fe",
                        "target_lang_word": "acuicultura",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acuicultura",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "ba9d8849-0847-329a-93a3-b5b1636808ae",
                                        "entry_id": "dce3a528-afdb-39aa-9439-c9c9d9780e50",
                                        "glosses": [
                                            "La actividad y rubro comercial productivo, de la crianza de recursos hidrobiológicos, conocidos también como peces, moluscos, crustáceos y vegetación acuática, en ambientes físicos controlados, con el fin de reemplazar y mejorar las condiciones que estos organismos encuentran en ambientes naturales."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b933796-2e75-4d59-bfc7-35257264a5f6",
                        "source_entry_id": "9b6fb403-c7f5-31ae-a89e-756d5ed9d3f2",
                        "source_sense_id": "64f0563f-06a0-37da-8805-d94f7b8766fe",
                        "target_lang_word": "Aquakultur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aquakultur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0707be0b-9f91-3910-82c6-7af86dff0376",
                                        "entry_id": "2077a5d4-c94d-3cd7-a460-c836763d3eb3",
                                        "glosses": [
                                            "„systematische Bewirtschaftung des Meeres“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9da12a9d-a9be-4c77-836d-6ec2a36b061b",
                                                "sense_id": "0707be0b-9f91-3910-82c6-7af86dff0376",
                                                "text": "„Zuchtperlen aus Japan zählen zu den bekanntesten Produkten der Aquakultur.“"
                                            },
                                            {
                                                "example_id": "3bbf3040-ac21-45d5-95b3-c569e2cfeee2",
                                                "sense_id": "0707be0b-9f91-3910-82c6-7af86dff0376",
                                                "text": "„Die weltweit zunehmende Aquakultur kann zu einem Rückgang wild lebender Fischarten führen.“"
                                            },
                                            {
                                                "example_id": "8c915169-75ca-4ffd-88dc-1b4788f67128",
                                                "sense_id": "0707be0b-9f91-3910-82c6-7af86dff0376",
                                                "text": "„Für jedes Kilogramm Fisch aus Aquakultur würden schätzungsweise zwei Kilogramm Futterfisch benötigt.“"
                                            },
                                            {
                                                "example_id": "f14c7a89-8b5f-45c8-8460-4e20017fe326",
                                                "sense_id": "0707be0b-9f91-3910-82c6-7af86dff0376",
                                                "text": "„Andererseits leiste Aquakultur einen wichtigen Beitrag für die Ernährung der Weltbevölkerung, betonten die Wissenschaftler.“"
                                            },
                                            {
                                                "example_id": "fe6667d9-02e7-4f55-bd01-b7c1bd0760a3",
                                                "sense_id": "0707be0b-9f91-3910-82c6-7af86dff0376",
                                                "text": "„Mit einem jährlichen Wachstum von elf Prozent gehört die Aquakultur zum bedeutendsten Sektor der Nahrungsmittelindustrie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f8d731b-3b54-3ed4-bf32-88f3b7179a88",
                                        "entry_id": "2077a5d4-c94d-3cd7-a460-c836763d3eb3",
                                        "glosses": [
                                            "„Anlage zur Fischzüchtung und Fischproduktion“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4b0ee04-788d-44b2-b510-e0ad3d523529",
                                                "sense_id": "0f8d731b-3b54-3ed4-bf32-88f3b7179a88",
                                                "text": "„Die Intensivierung der Aquakulturen birgt auch Gefahren: So verschmutzt die Massenhaltung in erheblichem Maße die Umgebung und greift in das natürliche marine Gleichgewicht ein.“"
                                            },
                                            {
                                                "example_id": "2dc84813-aefe-4bf0-a878-c0be988e47b2",
                                                "sense_id": "0f8d731b-3b54-3ed4-bf32-88f3b7179a88",
                                                "text": "„In den Tropen werden für Aquakulturen vielerorts die Mangrovenwälder der Küste, ein wichtiger Schutz vor Überschwemmungen, zerstört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
