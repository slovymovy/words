                "senses": [
                    {
                        "sense_id": "3ae1b183-7041-3ed6-8e6a-52a7b238d5af",
                        "entry_id": "75471774-3118-3fb5-8e5b-f1df3c419cc5",
                        "glosses": [
                            "auf dem Bildschirm angezeigte Darstellung eines Computerprogramms, die als Schnittstelle zwischen Benutzer und Anwendung dient"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "2ea1e8af-afb2-4b8f-b9ab-17a8caacca03",
                                "sense_id": "3ae1b183-7041-3ed6-8e6a-52a7b238d5af",
                                "text": "„Als letzten Schritt der Konzeption werden wir nun eine Skizze der Benutzeroberfläche anfertigen.“"
                            },
                            {
                                "example_id": "a77f75cc-b0d6-4c3b-91ee-c9c40670bf54",
                                "sense_id": "3ae1b183-7041-3ed6-8e6a-52a7b238d5af",
                                "text": "„Eine Benutzeroberfläche besteht aus einem Oberflächendesign und optional aus damit verknüpfter Funktionalität.“"
                            },
                            {
                                "example_id": "0d22318e-88d6-46b4-90be-6ed99d26c2f9",
                                "sense_id": "3ae1b183-7041-3ed6-8e6a-52a7b238d5af",
                                "text": "„In den folgenden Abschnitten lernen wir die Benutzeroberfläche und die grundlegenden Funktionen kennen.“"
                            },
                            {
                                "example_id": "5096fb63-984a-46c0-a4f8-8800ccb35b87",
                                "sense_id": "3ae1b183-7041-3ed6-8e6a-52a7b238d5af",
                                "text": "„Eine klassische Vorgehensweise bei der App-Programmierung ist, dass ein Kernel und eine Benutzeroberfläche genutzt werden.“"
                            },
                            {
                                "example_id": "aff25019-971a-48fc-af57-6dc3f5f46a4d",
                                "sense_id": "3ae1b183-7041-3ed6-8e6a-52a7b238d5af",
                                "text": "„Die Benutzeroberfläche zeigt zudem an, welchen Umsatz ein Produzent erzielt, wenn er seine gesamte Produktion verkauft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
