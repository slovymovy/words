                {
                    "sense_id": "308b005c-9d5b-3f82-9d71-0328fb91e05a",
                    "sense_definition": "The primary participant in a crime.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "law_crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Police arrested the <w>principal</w> while the accomplices managed to escape.",
                            "target_lang_translations": {
                                "ru": "Поли́ция арестова́ла <w>исполни́теля преступле́ния</w>, в то вре́мя как посо́бникам удало́сь скры́ться.",
                                "nl": "De politie arresteerde de <w>hoofdverdachte</w> terwijl de medeplichtigen wisten te ontsnappen.",
                                "de": "Die Polizei verhaftete den <w>Haupttäter</w>, während die Komplizen entkommen konnten."
                            }
                        },
                        {
                            "text": "He was charged as a <w>principal</w> in the robbery case.",
                            "target_lang_translations": {
                                "ru": "Ему́ предъяви́ли обвине́ние как <w>гла́вному уча́стнику</w> в де́ле об ограбле́нии.",
                                "nl": "Hij werd aangeklaagd als <w>hoofdverdachte</w> in de overvalzaak.",
                                "de": "Er wurde als <w>Haupttäter</w> im Raubfall angeklagt."
                            }
                        }
                    ],
                    "synonyms": [
                        "ringleader"
                    ],
                    "antonyms": [
                        "accessory"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Главный участник преступления (исполнитель).",
                        "nl": "De voornaamste dader van een misdrijf.",
