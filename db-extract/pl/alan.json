                                "target_senses": [
                                    {
                                        "sense_id": "0bb95d96-13d8-39ce-b327-f4683657a2ae",
                                        "entry_id": "b282297f-aff6-368b-ae83-020272300dd2",
                                        "glosses": [
                                            "A male given name from the Celtic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93ed8d42-0483-4a90-ade6-bc2e9fffd660",
                                                "sense_id": "0bb95d96-13d8-39ce-b327-f4683657a2ae",
                                                "text": "He grabbed at Alan by his Adam's apple,\nAnd Alan grabbed him back in furious grapple\nAnd clenched his fist and bashed him on the nose."
                                            },
                                            {
                                                "example_id": "4f5d3277-db78-483c-979b-ddaacdf8cae3",
                                                "sense_id": "0bb95d96-13d8-39ce-b327-f4683657a2ae",
                                                "text": "I could pose as an artist all right; so I took the studio. Also the name of Alan Beverley. My own is Bill Bates. I had often wondered what it would feel like to be called by some name like Alan Beverley or Cyril Trevelyan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ef61aad-bad4-3dc0-b0e8-4f52ec886325",
                                        "entry_id": "b282297f-aff6-368b-ae83-020272300dd2",
                                        "glosses": [
                                            "A surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
