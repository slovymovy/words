                        "examples": [
                            {
                                "example_id": "97258008-dce3-42f4-a276-5304b5b70475",
                                "sense_id": "affa7a40-c207-3468-985d-901828a48740",
                                "text": "„Bei der Explosion würde die glühende Urankugel zweitausend Mal stärker leuchten als die Sonne.“"
                            },
                            {
                                "example_id": "7184bb17-e46d-4c3c-ac01-e7d261783533",
                                "sense_id": "affa7a40-c207-3468-985d-901828a48740",
                                "text": "„Teilt man eine Urankugel mit überkritischer Masse, die eigentlich sofort explodieren müsste, in zwei Hälften, lässt sich die Explosion planmäßig als Atombombe auslösen.“"
                            }
