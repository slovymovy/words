                ],
                "senses": [
                    {
                        "sense_id": "d0c0563a-8a39-3609-b40e-78530b6e1812",
                        "entry_id": "80bdac4e-4a79-3df1-a2ef-66497b6da942",
                        "glosses": [
                            "het heel doortastend zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd038868-c1ee-4404-b7a3-cb58c9976d49",
                                "sense_id": "d0c0563a-8a39-3609-b40e-78530b6e1812",
                                "text": "De band raakte elke noot met een kordaatheid en frisheid die je niet verwacht als je een nummer al zo vaak hebt gespeeld."
                            },
                            {
                                "example_id": "b3d62553-7b14-4091-a49e-4b540f6eb183",
                                "sense_id": "d0c0563a-8a39-3609-b40e-78530b6e1812",
                                "text": "\"Haar kordaatheid en stoutmoedigheid is laakbaar en stemt de rechtbank niet tot mildheid\", citeert De Standaard de rechter. De advocaat van de vrouw had gevraagd om een geestelijk onderzoek. Dit werd door de rechter afgewezen. \"Ze komt naar voren als een pientere dame die zich tot op zeer hoge leeftijd inliet met fiscale spitstechnologie\", tekent VTM Nieuws op."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8a7027e-23d7-3145-a1f8-5836e483f133",
                        "entry_id": "80bdac4e-4a79-3df1-a2ef-66497b6da942",
                        "glosses": [
                            "iets dat getuigt van grote doortastendheid"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bfdb56d-2668-4026-b136-d335185510c9",
                        "source_entry_id": "80bdac4e-4a79-3df1-a2ef-66497b6da942",
                        "source_sense_id": "d0c0563a-8a39-3609-b40e-78530b6e1812",
                        "source_sense_description": "het heel doortastend zijn",
                        "target_lang_word": "firmness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "firmness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed6acb92-d354-3ebe-8b72-36f1d75814a4",
                                        "entry_id": "025066c8-1347-37a1-912f-49009a18d464",
                                        "glosses": [
                                            "The state of being firm",
                                            "security; steadfastness; good grip"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc42e7a4-f2a9-38e5-80a9-f7e1a19261f3",
                                        "entry_id": "025066c8-1347-37a1-912f-49009a18d464",
                                        "glosses": [
                                            "The state of being firm",
                                            "strictness; mental strength"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b43f91b0-f6af-4c1b-a18b-7ff2a8580269",
                                                "sense_id": "bc42e7a4-f2a9-38e5-80a9-f7e1a19261f3",
                                                "text": "But many a man who would have stood within a home dismantled, strong in his passion and design of vengeance, has had the firmness of his nature conquered by the razing of an air–built castle."
                                            },
                                            {
                                                "example_id": "94e09148-1546-482f-9a7e-4e27affbba98",
                                                "sense_id": "bc42e7a4-f2a9-38e5-80a9-f7e1a19261f3",
                                                "text": "France, for the first time since the death of Charlemagne, was governed by a prince of great firmness and ability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4dec340-61d0-372c-b25b-15db254e1e26",
                                        "entry_id": "025066c8-1347-37a1-912f-49009a18d464",
                                        "glosses": [
                                            "The state of being firm",
                                            "physical durability; rigidness (of material)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fff0e66-1b43-4409-9851-4e246816a645",
                        "source_entry_id": "80bdac4e-4a79-3df1-a2ef-66497b6da942",
                        "source_sense_id": "d0c0563a-8a39-3609-b40e-78530b6e1812",
