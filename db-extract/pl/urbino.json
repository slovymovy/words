                "senses": [
                    {
                        "sense_id": "44e2ad2b-fb7e-3dd2-8d17-37081c9f3db3",
                        "entry_id": "88909ebc-fc42-3ef8-b4fc-8bc0d983ebf5",
                        "glosses": [
                            "miejscowość i gmina w środkowych Włoszech, w regionie Marche, położona u podnóża Apeninu Umbryjsko-Marchijskiego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c10da265-8864-4417-9a27-ea06de1a36ed",
                                "sense_id": "44e2ad2b-fb7e-3dd2-8d17-37081c9f3db3",
                                "text": "Rafael Santi urodził się w Urbino (środkowe Włochy) i już w wieku dziecięcym mógł korzystać z nauk i wskazówek ojca, malarza, także poety"
                            },
                            {
                                "example_id": "81ef0547-f012-4804-9fdc-a347132f06ed",
                                "sense_id": "44e2ad2b-fb7e-3dd2-8d17-37081c9f3db3",
                                "text": "Urbino jest miastem zamurowanym. Nie ma otwartych przestrzeni. Place przykryto lepiej lub gorzej skleconymi dachami, żeby nie dopuszczać słonecznego światła. Centrum miasta stało się jakby jednym wielkim zamkniętym budynkiem"
                            },
                            {
                                "example_id": "ef509b2f-7b2c-49bf-a402-5a4dfb6481ac",
                                "sense_id": "44e2ad2b-fb7e-3dd2-8d17-37081c9f3db3",
                                "text": "Baldassare Castiglione : (…) W 1503 wstąpił na służby do margrabiego Francesca Gonzagi, wkrótce jednak opuścił Mantuę i przeniósł się do Urbina na słynący jako ośrodek kultury renesansowej dwór księcia Guidobalda Montefeltro"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
