            "senses": [
                {
                    "sense_id": "ee62d6ea-01d6-3652-806c-8d7ec6167faa",
                    "sense_definition": "een onderdeel van een fiets waar je je voet op zet om vooruit te komen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fietsonderdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn linker <w>trapper</w> is gisteren afgebroken tijdens het fietsen naar school.",
                            "target_lang_translations": {
                                "en": "My left <w>pedal</w> broke off yesterday while cycling to school."
                            }
                        },
                        {
                            "text": "Je moet harder op de <w>trappers</w> staan als je de heuvel op fietst.",
                            "target_lang_translations": {
                                "en": "You have to stand harder on the <w>pedals</w> when you cycle up the hill."
                            }
                        }
                    ],
                    "synonyms": [
                        "pedaal"
                    ],
                    "common_phrases": [
                        "op de trappers staan"
                    ],
                    "target_lang_definitions": {
                        "en": "a part of a bicycle where you place your foot to move forward"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pedal",
                                "target_lang_sense_clarification": "of a bicycle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a12a417-6dd3-318f-ad53-f3b5f6f8d846",
                    "sense_definition": "een uitsteeksel aan een toestel of voertuig bedoeld om met de voet op te trappen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanische onderdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude naaimachine wordt aangedreven door een grote <w>trapper</w> onder de tafel.",
                            "target_lang_translations": {
                                "en": "The old sewing machine is driven by a large <w>treadle</w> under the table."
                            }
                        },
                        {
                            "text": "Hij duwde krachtig op de <w>trapper</w> om het mechanisme in beweging te zetten.",
                            "target_lang_translations": {
                                "en": "He pushed powerfully on the <w>pedal</w> to set the mechanism in motion."
                            }
                        }
                    ],
                    "synonyms": [
                        "pedaal"
                    ],
                    "target_lang_definitions": {
                        "en": "a protrusion on a device or vehicle intended to be stepped on with the foot"
                    },
