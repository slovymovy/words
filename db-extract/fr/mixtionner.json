                ],
                "senses": [
                    {
                        "sense_id": "95b9595c-2c7d-357a-9ca6-3a46fc1bc698",
                        "entry_id": "2e34b02c-3aa5-3fc7-b7c6-58f7ec079c2f",
                        "glosses": [
                            "Faire une mixtion, presque toujours avec le sens de mélange mauvais, dangereux."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7cb9c8b0-39ee-4591-acd1-c7b5ed320d41",
                                "sense_id": "95b9595c-2c7d-357a-9ca6-3a46fc1bc698",
                                "text": "Mixtionner un breuvage."
                            },
                            {
                                "example_id": "d9920f7e-5d19-476f-8869-06b2a4b808b1",
                                "sense_id": "95b9595c-2c7d-357a-9ca6-3a46fc1bc698",
                                "text": "Telle oeuvre entendre ne saurons, Comme de proportionner Elemens et mixtionner."
                            },
                            {
                                "example_id": "82599b15-ec43-4e59-9dfb-0d3d657b1d46",
                                "sense_id": "95b9595c-2c7d-357a-9ca6-3a46fc1bc698",
                                "text": "Beuvans de l’eaue pure, ou mistionnée avecques le vin."
                            },
                            {
                                "example_id": "7d17006a-cb64-4d7a-acba-b88c663138b9",
                                "sense_id": "95b9595c-2c7d-357a-9ca6-3a46fc1bc698",
                                "text": "[Au reste ces qualités sont] si bien mixtionnées [dans les quatre éléments], qu’il ne demeure rien simple ou pur."
                            },
                            {
                                "example_id": "5c41b7a2-829b-4472-bda9-4faf5538c4c1",
                                "sense_id": "95b9595c-2c7d-357a-9ca6-3a46fc1bc698",
                                "text": "On voit le vin passer au travers de l’eau, et l’eau au travers du vin, sans se mixtionner ensemble."
                            }
                        ]
                    }
                ],
