                "senses": [
                    {
                        "sense_id": "40ffd425-0485-3a35-a5e9-5ceba36a9e8a",
                        "entry_id": "f9b3c193-f50e-3df5-91c7-e930739bafb2",
                        "glosses": [
                            "Variante orthographique de contremarche."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "2eaa3282-dcb3-42ca-b205-99025758c881",
                                "sense_id": "40ffd425-0485-3a35-a5e9-5ceba36a9e8a",
                                "text": "Une fois arrivés, les trois amis aperçurent dans une des plus vieilles maisons de cette rue un escalier à marches palpitantes, à contre-marches en boue raboteuse, qui les mena dans le demi-jour et par une puanteur particulière aux maisons à allée jusqu’au troisième étage à une porte que le dessin seul peut rendre, la littérature y devant perdre trop de nuits pour la peindre convenablement."
                            },
                            {
                                "example_id": "167ba530-87ec-4b1d-acf9-d6413ec3724b",
                                "sense_id": "40ffd425-0485-3a35-a5e9-5ceba36a9e8a",
                                "text": "La fusillade, le tocsin, les marches et les contre-marches des gardes nationaux, leurs armes qu’ils traînaient comme des gourdins, leurs appels effarés dans l’ombre, faisaient un vacarme assourdissant de ville prise d’assaut et livrée au pillage."
                            },
                            {
                                "example_id": "1b88f35a-9922-4799-b40b-f8e2797337ea",
                                "sense_id": "40ffd425-0485-3a35-a5e9-5ceba36a9e8a",
                                "text": "[…] quelle campagne ! […] des marches, des contre-marches, une descente en Crimée, une bataille à Alma […]."
                            },
                            {
                                "example_id": "0c584b83-5c47-44d6-9870-d76cc449a8a2",
                                "sense_id": "40ffd425-0485-3a35-a5e9-5ceba36a9e8a",
                                "text": "Il n’est pas un lecteur à qui ce livre ne tomberait des mains si l’on tentait d’y retracer par le menu ce que furent, au cours des nuits qui suivirent, les marches et contre-marches de cette troupe fantôme."
                            },
                            {
                                "example_id": "67e15346-b246-4bb6-9427-d48a1607073c",
                                "sense_id": "40ffd425-0485-3a35-a5e9-5ceba36a9e8a",
                                "text": "De nombreuses expériences nous ont appris qu’en montagne il est bon de saisir l’occasion aux cheveux, faute de quoi les courtes vacances s’écoulent en contre-marches, et l’on rentre chez soi bredouille."
                            }
                        ]
                    }
