                ],
                "senses": [
                    {
                        "sense_id": "3402615f-0da6-36c0-989f-588d8bc3a759",
                        "entry_id": "9ebc9226-1ff1-3505-99df-72a19bd42107",
                        "glosses": [
                            "Fachgebiet der Technik, das sich mit der Konstruktion empfindlicher (Mess-)Geräte beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1ce534d-c761-4329-85e7-b2f4ed27500d",
                                "sense_id": "3402615f-0da6-36c0-989f-588d8bc3a759",
                                "text": "„Der Body aus Metall ist teilweise mit schwarzem Kunststoff überzogen, das Akkufach ist gegen unbeabsichtigtes Öffnen durch einen Riegel geschützt, und der abermals verbesserte Schiebeschalter, der auf Rollen gleitet, darf als Meisterstück der Feinmechanik gelten.“"
                            },
                            {
                                "example_id": "983b7f23-a79b-4a9e-9299-10200315a385",
                                "sense_id": "3402615f-0da6-36c0-989f-588d8bc3a759",
                                "text": "„Die neue Firmenzentrale liegt im ‚Leitz-Park‘, wo sich zwei weitere Firmen aus der Sparte Optik und Feinmechanik angesiedelt haben.“"
                            },
                            {
                                "example_id": "8fd5b056-b066-4683-96e9-da504c59b348",
                                "sense_id": "3402615f-0da6-36c0-989f-588d8bc3a759",
                                "text": "„Wir sind Marktführer in Präzisionsgeräten, Maschinenbau und Feinmechanik.“"
                            },
                            {
                                "example_id": "717ad6e0-773d-47cd-907d-dc0e3c6cf573",
                                "sense_id": "3402615f-0da6-36c0-989f-588d8bc3a759",
                                "text": "„Die Spieluhr entstand im ersten Jahrzehnt des 16. Jahrhunderts, in einer Epoche, als Nürnberg das deutsche und europäische Zentrum der Feinmechanik war und Peter Henlein seine Taschenuhren montierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
