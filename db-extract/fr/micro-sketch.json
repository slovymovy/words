                                "example_id": "7a9e9aa9-b71b-424e-9643-59bd4c72a70a",
                                "sense_id": "55334143-34f9-372e-ae2f-2094c37bc801",
                                "text": "Sur son mur Facebook, il diffuse des vidéos intitulées \"Hey\", sorte de micro-sketchs hilarants où il met en scène un humoriste décadent."
                            },
                            {
                                "example_id": "f5356554-d591-44f8-b7b8-96387a623ead",
                                "sense_id": "55334143-34f9-372e-ae2f-2094c37bc801",
                                "text": "C’est arrivé le 16 mars 2011, quelques jours seulement après la catastrophe nucléaire de Fukushima, et ce micro-sketch a été très mal pris par les Japonais."
                            },
                            {
                                "example_id": "8396ac0a-36a9-436d-9535-41d601bd303f",
                                "sense_id": "55334143-34f9-372e-ae2f-2094c37bc801",
                                "text": "Comme c’est le week-end et qu’il faut bien se détendre, voici quelques vidéos d’une série de « micro-sketchs » proposée par Strobosketch."
                            }
                        ]
                    }
