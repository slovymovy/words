                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "45bd17d0-647f-455b-ad4c-56dea7120148",
                        "source_entry_id": "7a059664-6d53-3ad3-981d-8fc9c5e90312",
                        "source_sense_id": "51f167a3-e17c-3429-8040-87e1fb7035f8",
                        "source_sense_description": "fijne spijsolie verkregen door persing uit olijven",
                        "target_lang_word": "λάδι",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "λάδι",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "35a6e195-6338-3de8-94e6-86224305475f",
                                        "entry_id": "1ab41614-d3f3-3cca-965e-c9d070101ca8",
                                        "glosses": [
                                            "το έλαιο που παράγεται από τη σύνθλιψη των καρπών ή σπόρων"
                                        ],
                                        "tags": [
                                            "τρόφιμο"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95095f3d-c67f-482f-96ed-6f4cdf916e0f",
                                                "sense_id": "35a6e195-6338-3de8-94e6-86224305475f",
                                                "text": "※ Αναφέρεται επίσης ότι οι στρεμματικές αποδόσεις σε κρασί και λάδι είναι μικρότερες από τις συνήθεις. Υπάρχει βέβαια η πιθανότητα της κακής σοδειάς (ειδικά για το λάδι, μια που οι ελιές παράγουν κάθε δεύτερο χρόνο) (Δημήτρης Ψυχογιός, Προίκες, φόροι, σταφίδα και ψωμί, εκδ. ΕΚΚΕ, 1987, σελ. 33)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc21efa3-ed33-3e3a-8ec8-e50c9db34775",
                                        "entry_id": "1ab41614-d3f3-3cca-965e-c9d070101ca8",
                                        "glosses": [
                                            "το ορυκτέλαιο"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeaea823-e93b-4a29-905b-4c999f9ea24d",
                                                "sense_id": "bc21efa3-ed33-3e3a-8ec8-e50c9db34775",
                                                "text": "Πρέπει ν' αλλάξω λάδια στη μηχανή."
                                            },
                                            {
                                                "example_id": "94e8e998-b3c6-48c1-883b-70f3e0074303",
                                                "sense_id": "bc21efa3-ed33-3e3a-8ec8-e50c9db34775",
                                                "text": "Ο κινητήρας καίει λάδια, πρέπει να του κάνω ρεκτιφιέ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19edecf8-c197-3536-b16f-8912f29de1cd",
                                        "entry_id": "1ab41614-d3f3-3cca-965e-c9d070101ca8",
                                        "glosses": [
                                            "υγρό για την επάλειψη του δέρματος, όπως το αντιηλιακό λάδι"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c64b964-6371-4fa4-8c9d-0a9492751690",
                                                "sense_id": "19edecf8-c197-3536-b16f-8912f29de1cd",
                                                "text": "※ Όχι μονάχα είναι οι πιο δημοφιλείς ονειροκρίτες, αλλά και οι πιο εχέγγυοι για την πραγμάτωση του ονείρου. Οι διαφημίσεις το μαρτυρούν. Ποιός θ' αγόραζε ποτέ ένα αντιηλιακό λάδι αν στη θέση της εξωτικής Χαβανέζας είχε τον χημικό του τύπο και τις ενδεχόμενες καρκινογόνες ουσίες του χρωστικού; (Περικλής Κοροβέσης, Εμπορία ειδήσεων, εκδ. Γνώση, 1990, σελ. 162)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "000bd1f5-8aaf-3986-91b1-543ffa852950",
                                        "entry_id": "1ab41614-d3f3-3cca-965e-c9d070101ca8",
                                        "glosses": [
                                            "υγρό για την επάλειψη επιφανειών"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "654ac715-02ac-38e7-9020-5ef6144fa850",
                                        "entry_id": "1ab41614-d3f3-3cca-965e-c9d070101ca8",
                                        "glosses": [
                                            "η λαδομπογιά"
                                        ],
                                        "tags": [
                                            "ζωγραφική"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "796f44b6-16b0-402d-89a5-4b9afb6b7926",
                                                "sense_id": "654ac715-02ac-38e7-9020-5ef6144fa850",
                                                "text": "※ Αντίθετα με τα αφηγηματικά έργα, στις προσωπογραφίες, το υλικό είναι σχεδόν πάντα το λάδι, και οι πρόγονοί τους πρέπει να αναζητηθούν στη ζωγραφική της Ευρώπης, από τον Εμπρεσιονισμό και μετά, σε συνδυασμό με ορισμένα στοιχεία ανατολίζοντα, που οφείλονται στο Φαγιούμ και στο Βυζάντιο. (Ειρήνη Φλώρου, Γιάννης Τσαρούχης: Η ζωγραφική και η εποχή του, Νέα Σύνορα, εκδοτικός οργανισμός Λιβάνη, 1999, σελ. 73)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a103e6f-e912-3666-89ba-66d555911cac",
                                        "entry_id": "1ab41614-d3f3-3cca-965e-c9d070101ca8",
                                        "glosses": [
                                            "πίνακας που έχει ζωγραφιστεί με λαδομπογιές"
                                        ],
                                        "tags": [
                                            "ζωγραφική"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51b0a117-f62f-4408-b361-2f4b2f5f1bd7",
                                                "sense_id": "1a103e6f-e912-3666-89ba-66d555911cac",
                                                "text": "≈ συνώνυμα: ελαιογραφία"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13bd7df2-8fdd-3b66-8df9-5734ddcc8e61",
                                        "entry_id": "1ab41614-d3f3-3cca-965e-c9d070101ca8",
                                        "glosses": [
                                            "χρηματισμός, δωροδοκία (κυρίως το ποσό)"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "022099b0-dfc0-47d2-8f7f-e7e40589b527",
                                                "sense_id": "13bd7df2-8fdd-3b66-8df9-5734ddcc8e61",
                                                "text": "※ Κάθε μηχανισμός για να πάρει μπροστά χρειάζεται λάδι και μίζα. Η μίζα κινεί την παραοικονομία, η οποία κινεί την οικονομία. Οι Τούρκοι την έλεγαν μπαξίσι, αλλά εμείς τους έχουμε ξεπεράσει (Νίκος Γ. Δήμου, Ειρωνικό Νεοελληνικό Λεξικό, Ένατη ανανεωμένη έκδοση, εκδ. Πατάκης, 2013)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26670aeb-7418-49cc-8d6f-53acf75a469c",
                        "source_entry_id": "7a059664-6d53-3ad3-981d-8fc9c5e90312",
                        "source_sense_id": "51f167a3-e17c-3429-8040-87e1fb7035f8",
                        "source_sense_description": "fijne spijsolie verkregen door persing uit olijven",
                        "target_lang_word": "ελαιόλαδο",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ελαιόλαδο",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "0f6087a8-f3b0-30ae-b601-14da68f1551f",
                                        "entry_id": "232d714c-9187-3385-963a-df9fda7eca37",
                                        "glosses": [
                                            "λάδι ελιάς"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c719ae4-39bc-4a6e-9ffa-884cbfb24ba7",
                                                "sense_id": "0f6087a8-f3b0-30ae-b601-14da68f1551f",
                                                "text": "※ Σκοπός της διαδικασίας είναι η κατασκευή μαγειρικών λιπών, για τα οποία τα στερεά πλέον λινέλαια και ιχθυέλαια αναμειγνύονται με ελαιόλαδο και βαμβακέλαιο. Τη σχετική παραγωγή ο Ελαιοφοίνιξ άρχισε το 1931. Ως τότε στην Ελλάδα χρησιμοποιούνται εισαγόμενα μαγειρικά λίπη από τη Βόρεια Ευρώπη (συνήθως με πρώτη ύλη το ιχθυέλαιο) (Ευάγγελος Α. Χεκίμογλου, Η ιστορία της βιομηχανίας τροφίμων, εκδόσεις Κέρκυρα, 2006, σελ. 101)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
