                    {
                        "sense_id": "8deb5c2b-d5c0-3332-a781-c13be4b153c1",
                        "entry_id": "d2276f17-ad4c-313e-8ed8-d223774815ec",
                        "glosses": [
                            "Abkürzung für Lingua Tertii Imperii „Sprache des Dritten Reichs“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e43193e-ae60-427d-beea-647aebc6651a",
                                "sense_id": "8deb5c2b-d5c0-3332-a781-c13be4b153c1",
                                "text": "„Als parodierende Spielerei zuerst, gleich darauf als ein flüchtiger Notbehelf des Erinnerns, als eine Art Knoten im Taschentuch, und sehr bald und nun für all die Elendsjahre als eine Notwehr, als ein an mich selbst gerichteter SOS-Ruf steht das Zeichen LTI in meinem Tagebuch… LTI: Lingua Tertii Imperii, Sprache des Reichs.“"
                            },
                            {
                                "example_id": "3f588bbe-8e6d-49bd-9634-a80642bee1d4",
                                "sense_id": "8deb5c2b-d5c0-3332-a781-c13be4b153c1",
                                "text": "„Selbst unsere Sprache ist noch durchsetzt von Wendungen, die nur aus der LTI, der Victor Klemperer nachgegangen ist, der Lingua Tertii Imperii, übrig geblieben sein können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
