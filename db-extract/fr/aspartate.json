                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f70654e-8c72-4f25-a7b1-07c0f1f3e0a1",
                                "sense_id": "de362e65-39dd-3ace-8ba3-e35a1f2d48ca",
                                "text": "L’acide aspartique se combine avec les bases et constitue un nouveau genre de sels qui doit prendre la dénomination d’aspartate."
                            },
                            {
