                "senses": [
                    {
                        "sense_id": "5472d0b1-3e08-33dd-912c-e703991bf9ce",
                        "entry_id": "761fea67-b843-3ab6-8c57-f334bae0401c",
                        "glosses": [
                            "энтомол. бабочка семейства Древоточцы (Cossus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e57f3eb-4d29-4d4e-9261-c47fc83bd291",
                                "sense_id": "5472d0b1-3e08-33dd-912c-e703991bf9ce",
                                "text": "Периодические несчастья — ураган, нашествие древоточца, повышенье грунтовых вод — приостанавливали эту безмолвную, почти неукротимую гонку к солнцу, вечную гонку живых соков земли!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68c3a99a-77d9-406c-a197-702443e3e5ac",
                        "source_entry_id": "761fea67-b843-3ab6-8c57-f334bae0401c",
                        "source_sense_id": "5472d0b1-3e08-33dd-912c-e703991bf9ce",
