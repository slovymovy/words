                    },
                    {
                        "translation_id": "1de75bad-4725-4b4d-8e28-b5205985494c",
                        "source_entry_id": "1902f445-2a8b-3294-b934-9037fb4ade0c",
                        "source_sense_id": "a4abc404-0da5-35b9-aef4-9d7ab03dcc4f",
                        "target_lang_word": "exagérer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exagérer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "460e531d-20ca-35d4-95cf-cb254f60d5ce",
                                        "entry_id": "1b9a690c-b84d-3804-adf2-bdf9ceea535d",
                                        "glosses": [
                                            "Donner à une chose plus d’importance qu’elle n’en a en réalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8a1beba-52ca-42a5-bc14-cb2f090774a4",
                                                "sense_id": "460e531d-20ca-35d4-95cf-cb254f60d5ce",
                                                "text": "Le caricaturiste exagère les traits les plus marquants de son modèle."
                                            },
                                            {
                                                "example_id": "8522e2d5-b94e-4d0b-87e6-9dcdea55182b",
                                                "sense_id": "460e531d-20ca-35d4-95cf-cb254f60d5ce",
                                                "text": "Un comique outre sur la scène ses personnages ; un poète charge ses descriptions ; un peintre qui fait d’après nature force et exagère une passion, un contraste, des attitudes."
                                            },
                                            {
                                                "example_id": "032df44d-67f4-480a-83c2-04bef88fec36",
                                                "sense_id": "460e531d-20ca-35d4-95cf-cb254f60d5ce",
                                                "text": "Vous n’avez pas le sens de la mesure, vous exagérez toujours tout !"
                                            },
                                            {
                                                "example_id": "59a9e15f-a31d-45e4-9163-2d67a5622813",
                                                "sense_id": "460e531d-20ca-35d4-95cf-cb254f60d5ce",
                                                "text": "La cravache ou la gaule est aussi nécessaire pour le travail de la haute école que pour celui du dressage, car elle doit servir à exagérer la puissance de l’écuyer pour stimuler le cheval […]."
                                            },
                                            {
                                                "example_id": "66de5f11-34ba-43f7-bdd3-410a5f2792e0",
                                                "sense_id": "460e531d-20ca-35d4-95cf-cb254f60d5ce",
                                                "text": "Sa chevelure, relevée par un peigne, exagérait la longueur de son front."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "815b02a3-7efd-3ff4-9556-6c8bf05f30d8",
                                        "entry_id": "1b9a690c-b84d-3804-adf2-bdf9ceea535d",
                                        "glosses": [
                                            "Faire valoir, faire ressortir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36b2fae4-d691-4ebc-ada7-a493a9bec5ff",
                                                "sense_id": "815b02a3-7efd-3ff4-9556-6c8bf05f30d8",
                                                "text": "J’ai beau lui exagérer le sacrifice que je lui ai fait, il se met à rire, et me soutient qu’il m’a trouvée très-profane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f50328e9-c9c6-308b-a095-e0b3d0e32972",
                                        "entry_id": "1b9a690c-b84d-3804-adf2-bdf9ceea535d",
                                        "glosses": [
                                            "Dépasser la juste mesure dans ses propos ou ses actes."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59ce1b67-1eb9-40a2-acf6-e8f289d9e8c6",
                                                "sense_id": "f50328e9-c9c6-308b-a095-e0b3d0e32972",
                                                "text": "N’exagère pas ou je vais me fâcher !"
                                            },
                                            {
                                                "example_id": "41eca1ca-a77a-4a77-aba1-d9890fc85946",
                                                "sense_id": "f50328e9-c9c6-308b-a095-e0b3d0e32972",
                                                "text": "Je ne crois pas exagérer en disant qu’il faisait au moins deux mètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61632b63-ea0e-3310-a83b-d938d3b268bc",
                                        "entry_id": "1b9a690c-b84d-3804-adf2-bdf9ceea535d",
                                        "glosses": [
                                            "Se faire de quelque chose une idée excessive."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cecb0c45-dd4b-448f-bd67-2f5f41461023",
                                                "sense_id": "61632b63-ea0e-3310-a83b-d938d3b268bc",
                                                "text": "Dans l’obscurité, elle s’était exagéré la hauteur de l’obstacle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cac8a1e-9f0c-43e3-9116-749e1b4bc80b",
                        "source_entry_id": "1902f445-2a8b-3294-b934-9037fb4ade0c",
                        "source_sense_id": "a4abc404-0da5-35b9-aef4-9d7ab03dcc4f",
                        "target_lang_word": "aller trop loin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aller trop loin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7933a396-2167-3b69-98b0-a8fa985afc3a",
                                        "entry_id": "8d951e88-631f-38ad-b5a4-de41e077aea7",
                                        "glosses": [
                                            "Abuser, exagérer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "882222cf-1344-3b02-92c9-38a918a034ae",
                                        "entry_id": "8d951e88-631f-38ad-b5a4-de41e077aea7",
                                        "glosses": [
                                            "Franchir une limite."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "876d1b8e-2420-4a05-b6c0-650b5a75eb7a",
                                                "sense_id": "882222cf-1344-3b02-92c9-38a918a034ae",
                                                "text": "Je suis persuadé que, dans quatre-vingt quinze pour cent des cas, les gens qui se sont suicidés sont morts parce qu’ils n’ont pas su jusqu’où on peut aller trop loin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8db039cc-e53c-3824-98e5-4a42424bd923",
                                        "entry_id": "8d951e88-631f-38ad-b5a4-de41e077aea7",
                                        "glosses": [
                                            "Dans le domaine des relations sexuelles, dépasser trop tôt les bornes permises par les conventions morales."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5386ea91-cd11-4220-9788-38c23676fe8c",
                                                "sense_id": "8db039cc-e53c-3824-98e5-4a42424bd923",
                                                "text": "Tante Simone insinuait qu’avec son fiancé elle avait « été trop loin » ; maman la défendait ; je jugeais ce débat oiseux ; mariés ou non, les étreintes de ces beaux jeunes gens ne me choquaient pas : ils s’aimaient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffa9ba18-2338-4f74-a456-2409f01f4436",
                        "source_entry_id": "1902f445-2a8b-3294-b934-9037fb4ade0c",
                        "source_sense_id": "a4abc404-0da5-35b9-aef4-9d7ab03dcc4f",
                        "target_lang_word": "dépasser les bornes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépasser les bornes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80b1378d-f91a-3e05-8c68-e471f2b5d11d",
                                        "entry_id": "1a2772cc-4f32-35b1-b10f-cba53d7462e5",
                                        "glosses": [
                                            "Aller trop loin dans ses réactions, aller au-delà du raisonnable, en faire trop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8c9c878-f434-4779-8c3d-00c4562896fa",
                                                "sense_id": "80b1378d-f91a-3e05-8c68-e471f2b5d11d",
                                                "text": "vous voulez m'en témoigner votre reconnaissance d'une manière qui dépasse les bornes de la discrétion, de la fierté nationale, du sentiment d'estime que vous devez nourrir et afficher pour vous-mêmes, pour votre nationalité et pour vos nationaux."
                                            },
                                            {
                                                "example_id": "3c8897f3-9063-4065-bbba-2154cc6a59b2",
                                                "sense_id": "80b1378d-f91a-3e05-8c68-e471f2b5d11d",
                                                "text": "Que telle étudiante ait retrouvé son équilibre, on doit s'en réjouir. Mais il y en a beaucoup d'autres qui restent marquées par un bizutage qui effectivement dépasse les bornes de ce qui doit être normalement admis."
                                            },
                                            {
                                                "example_id": "c8f6beb7-0a71-47d0-bf17-5904ce17cfab",
                                                "sense_id": "80b1378d-f91a-3e05-8c68-e471f2b5d11d",
                                                "text": "Le conseil d’administration n’estime pas que c’est une censure. Mais avec les outils numériques, il est facile de dépasser les bornes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
