                    },
                    {
                        "form_id": "f979d1c1-c7ba-4e03-bdc4-44fa6dbc2ef1",
                        "entry_id": "9a51c2f1-4931-3393-9429-7fdf3afae879",
                        "tags": [
                            "masculine"
                        ],
                        "form": "policier"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c40077c4-1f50-3a83-a402-2e3177d9e1bc",
                        "entry_id": "9a51c2f1-4931-3393-9429-7fdf3afae879",
                        "glosses": [
                            "Fonctionnaire employée dans la police."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "19adc047-23e8-4448-b112-be3786c1ddcb",
                                "sense_id": "c40077c4-1f50-3a83-a402-2e3177d9e1bc",
                                "text": "Dans la matinée, il avait attaqué une policière avec un couteau, la blessant, avant d’être tué par d’autres policiers."
                            },
                            {
                                "example_id": "0bb2fbda-fabe-4886-bdc7-b410c64f51ba",
                                "sense_id": "c40077c4-1f50-3a83-a402-2e3177d9e1bc",
                                "text": "Très grièvement blessée, la policière a été admise pour un polytraumatisme à la clinique de la Dorcas à Tournai."
                            },
                            {
                                "example_id": "f5d3dc38-be87-46bb-97f2-59de9bd9f0d0",
                                "sense_id": "c40077c4-1f50-3a83-a402-2e3177d9e1bc",
                                "text": "Il existe maintenant des policières, des soldates et forcément des officières, y’a pas de raison !"
                            },
                            {
                                "example_id": "43619700-4a1a-47ca-b772-589e62a45d10",
                                "sense_id": "c40077c4-1f50-3a83-a402-2e3177d9e1bc",
                                "text": "Dans tous ces récits des victimes apparaissent des figures protectrices, celles qui ont dit « je te crois » et qui ont agi en conséquence : une mère ou un parent, un enseignant, une policière ou un gendarme, l’avocat général à l’audience malgré l’acquittement, une psychologue ou un médecin, un éducateur, la littérature, une émission, un article dans un journal, le témoignage d’une autre victime, un groupe de parole sur l’inceste, un film, la description des troubles de stress post-traumatique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "792bf2a5-556f-42f4-9937-07fbb2b056a7",
                        "source_entry_id": "9a51c2f1-4931-3393-9429-7fdf3afae879",
                        "source_sense_id": "c40077c4-1f50-3a83-a402-2e3177d9e1bc",
                        "target_lang_word": "Polizistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polizistin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7626fc4-3f71-375d-b3bb-ae93631dd093",
                                        "entry_id": "f8aefc09-95a0-3756-b9e9-df4f5bfc5c0d",
                                        "glosses": [
                                            "Angehörige der Polizei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc01815c-bdec-4816-88d8-e202ff817860",
                                                "sense_id": "d7626fc4-3f71-375d-b3bb-ae93631dd093",
                                                "text": "Die Polizistin verhaftete den Dieb und führte ihn ab."
                                            },
                                            {
                                                "example_id": "6d97e38d-cece-4322-8661-a12b6570cb7a",
                                                "sense_id": "d7626fc4-3f71-375d-b3bb-ae93631dd093",
                                                "text": "„Mein Anliegen ist es daher, auf Missstände hinzuweisen, die mir als Polizistin und auch ganz normale Bürgerin immer stärker auffallen, die mich stören und beunruhigen.“"
                                            },
                                            {
                                                "example_id": "dc74a30d-a261-4f34-9985-94103d5a935c",
                                                "sense_id": "d7626fc4-3f71-375d-b3bb-ae93631dd093",
                                                "text": "„In den letzten fünf Jahren hat die Tokioter Polizei begonnen, verstärkt Polizistinnen einzusetzen, wenn es um Sexualdelikte geht.“"
                                            },
                                            {
                                                "example_id": "a595e08e-f18a-4e44-a127-21ba732b0ac4",
                                                "sense_id": "d7626fc4-3f71-375d-b3bb-ae93631dd093",
                                                "text": "„Die Frau hieß Begga und war Polizistin, sie hatten sich vorhin schon kennengelernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
