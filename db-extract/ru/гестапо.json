                            {
                                "example_id": "c838da85-3936-4a29-926c-32435c150113",
                                "sense_id": "092069cf-1d74-3dd8-ac1a-5f20ba6e0416",
                                "text": "Казалось, уже годы прошли в блоке, где содержались особо интересные для гестапо заключённые."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c055d1f7-1fe8-435f-95f4-ddcaa356d6c4",
