                                        "sense_id": "e3e5bc01-c417-387d-a98f-f093ac6fc308",
                                        "entry_id": "0578d044-1dbc-314b-9357-9d926db030bb",
                                        "glosses": [
                                            "ein Stift, dessen Spitze aus Filz besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba6f7ee7-e68d-4456-87bf-115fc7fba971",
                                                "sense_id": "e3e5bc01-c417-387d-a98f-f093ac6fc308",
                                                "text": "Ich habe neue Filzstifte."
                                            },
                                            {
                                                "example_id": "44e4ffc4-2a20-467b-91e1-744123e50644",
                                                "sense_id": "e3e5bc01-c417-387d-a98f-f093ac6fc308",
                                                "text": "„Thomas ist im Wohnzimmer verschwunden und kommt mit Papier und einem Filzstift zurück.“"
                                            },
                                            {
                                                "example_id": "8dcff417-ecc9-47b4-9dd0-a9213275f551",
                                                "sense_id": "e3e5bc01-c417-387d-a98f-f093ac6fc308",
                                                "text": "„Auf jeden hatte ich mit Filzstift den Inhalt notiert: Fotoalben, alte Dias, Kleidungsstücke, die ich behalten wollte, für die ich im Koffer aber keinen Platz hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
