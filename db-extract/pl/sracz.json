                                "target_senses": [
                                    {
                                        "sense_id": "7dff930e-12d2-3827-acd3-d8bf17fb987a",
                                        "entry_id": "d2c3e991-6b45-34dd-965f-aba30d9e2fc1",
                                        "glosses": [
                                            "One who defecates."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eef665fa-7cf5-4641-bf75-e761136d4f61",
                                                "sense_id": "7dff930e-12d2-3827-acd3-d8bf17fb987a",
                                                "text": "Either I'm a fast killer, he thought, or that boy's a slow shitter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01da1867-28ee-3d77-b3b2-a47fdbfe8c0a",
                                        "entry_id": "d2c3e991-6b45-34dd-965f-aba30d9e2fc1",
                                        "glosses": [
                                            "A toilet or lavatory; an outhouse."
                                        ],
                                        "tags": [
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b8129be-bcc5-4c11-a9e8-f8cf6e02c8d0",
                                                "sense_id": "01da1867-28ee-3d77-b3b2-a47fdbfe8c0a",
                                                "text": "Hold on, I gotta use the shitter."
                                            },
                                            {
                                                "example_id": "b5da45dc-9051-4d4a-b768-627b10d4844c",
                                                "sense_id": "01da1867-28ee-3d77-b3b2-a47fdbfe8c0a",
                                                "text": "But if she had murdered two children, I'd gladly see her spend her final years on earth in a cell with an iron-hard bed and an overflowing shitter in the corner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bc75977-e217-35b5-8506-02f0eb9f8d22",
                                        "entry_id": "d2c3e991-6b45-34dd-965f-aba30d9e2fc1",
                                        "glosses": [
                                            "The anus."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de5816b8-d391-437c-938b-e8befc081249",
                                                "sense_id": "3bc75977-e217-35b5-8506-02f0eb9f8d22",
                                                "text": "Dave commented on the statue that had grabbed the pair's attention when they'd arrived, saying how quaint it looked, then capped off his comment with, “D'you reckon that receptionist takes it up the shitter?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7559d39-ddcb-33bd-8adb-07a453dcfe46",
                                        "entry_id": "d2c3e991-6b45-34dd-965f-aba30d9e2fc1",
                                        "glosses": [
                                            "A contemptible person or thing."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2579dbd-7a26-4fe3-9aa9-f930520dbb33",
                                                "sense_id": "c7559d39-ddcb-33bd-8adb-07a453dcfe46",
                                                "text": "Blood, guts, and hair were soon spread on the floor, and the dog was cut to pieces. Nat was muttering, “There, that'll teach you, you shitter,” as he sat down and looked at the bloodied remains of the animal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feaac4fa-9897-30d3-81de-6898fec1ef23",
                                        "entry_id": "d2c3e991-6b45-34dd-965f-aba30d9e2fc1",
                                        "glosses": [
                                            "Someone lacking skill, especially in a video game."
                                        ],
                                        "tags": [
                                            "especially",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shitter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a68852d8-c4ad-3124-af86-ec0a9456eae1",
                                        "entry_id": "982efd49-f04e-3aac-acfa-0d4459b79a5e",
                                        "glosses": [
                                            "comparative form of shit: more shit; shittier"
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31bd943e-9c13-4610-8c89-eb71f93d535b",
                                                "sense_id": "a68852d8-c4ad-3124-af86-ec0a9456eae1",
                                                "text": "Text sex is even shitter."
                                            },
                                            {
                                                "example_id": "1ec52ae2-0386-482e-8820-40e6c47a3063",
                                                "sense_id": "a68852d8-c4ad-3124-af86-ec0a9456eae1",
                                                "text": "Even shitter!"
                                            },
                                            {
                                                "example_id": "a89d7774-9469-4f92-bb3c-e9447923d599",
                                                "sense_id": "a68852d8-c4ad-3124-af86-ec0a9456eae1",
                                                "text": "Our university may have been shit on University Challenge, and even shitter at any kind of sport, but for a good political bit of head kicking we were unbeatable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "103b84f3-e416-499e-864d-662c6feb2b85",
                        "source_entry_id": "070098f7-306f-3c87-9f34-ca35941836d2",
                        "source_sense_id": "ebeccbec-5b1a-3c13-93e5-b926065a696f",
