                        "glosses": [
                            "относящийся к статусу (статусам), определяющий статус и т. п."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "01b800b4-3ce9-36c7-9eac-05b491c58996",
                        "entry_id": "41433765-9c25-311f-b507-89cc0a030cdc",
                        "glosses": [
                            "подчёркивающий статус своего владельца"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03cca9a2-5592-4249-91b7-1a1c9aefcdb2",
                                "sense_id": "01b800b4-3ce9-36c7-9eac-05b491c58996",
                                "text": "В некоторых африканских племенах обыкновенные очки – очень статусная вещь, символ мудрости и авторитета человека."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5bd1d7b-3cba-41ff-bcbc-7d4d5ed0e29b",
                        "source_entry_id": "41433765-9c25-311f-b507-89cc0a030cdc",
                        "source_sense_description": "относящийся к статусу (статусам), определяющий статус и т. п.",
                        "target_lang_word": "status",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "status",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "befb06a6-6ee9-3eaf-8610-c4c33ce5c705",
                                        "entry_id": "39b82ca4-5c3c-39c1-81d5-1a4efbf6e258",
                                        "glosses": [
                                            "A person’s condition, position or standing relative to that of others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16c0b595-87cd-45c4-ba2f-e0e8d1b39557",
                                                "sense_id": "befb06a6-6ee9-3eaf-8610-c4c33ce5c705",
                                                "text": "Superstition is highly correlated with economic status."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34745c92-37c2-38d3-b82a-43c06afb097f",
                                        "entry_id": "39b82ca4-5c3c-39c1-81d5-1a4efbf6e258",
                                        "glosses": [
                                            "Prestige or high standing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a9c152e-f437-4d95-b2b5-ddeeea7b14af",
                                                "sense_id": "34745c92-37c2-38d3-b82a-43c06afb097f",
                                                "text": "The king has status in his kingdom, and the pauper has status within his immediate group of peers."
                                            },
                                            {
                                                "example_id": "698a7c71-8132-4711-a929-f0a5fdad4a2c",
                                                "sense_id": "34745c92-37c2-38d3-b82a-43c06afb097f",
                                                "text": "It is no secret that the military was a bastion of racism and sexism keeping blacks and women in the housekeeping and other non-status jobs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaf8152a-0cb2-386d-9e2c-3e46b02cc944",
                                        "entry_id": "39b82ca4-5c3c-39c1-81d5-1a4efbf6e258",
                                        "glosses": [
                                            "A situation or state of affairs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8454ae2a-4233-48e5-8ccb-155f8a83bba2",
                                                "sense_id": "aaf8152a-0cb2-386d-9e2c-3e46b02cc944",
                                                "text": "What's the status of the investigation?"
                                            },
                                            {
                                                "example_id": "3be9508a-5b49-4ba8-a3ea-0ed875bc79ca",
                                                "sense_id": "aaf8152a-0cb2-386d-9e2c-3e46b02cc944",
                                                "text": "New York is known for its status as a financial center."
                                            },
                                            {
                                                "example_id": "a84f8af6-403c-4cdb-a504-1543a9d2353f",
                                                "sense_id": "aaf8152a-0cb2-386d-9e2c-3e46b02cc944",
                                                "text": "If the takeover is approved, Comcast would control 20 of the top 25 cable markets, […]. Antitrust officials will need to consider Comcast's status as a monopsony (a buyer with disproportionate power), when it comes to negotiations with programmers, whose channels it pays to carry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "550643c2-6522-34dd-a689-ff341fa94a08",
                                        "entry_id": "39b82ca4-5c3c-39c1-81d5-1a4efbf6e258",
                                        "glosses": [
                                            "The legal condition of a person or thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "feda1605-4b24-3b7d-aa73-558352e580b8",
                                        "entry_id": "39b82ca4-5c3c-39c1-81d5-1a4efbf6e258",
                                        "glosses": [
                                            "The legal condition of a person or thing.",
                                            "The state (of a Canadian First Nations person) of being registered under the Indian Act."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82cc9dea-8010-49a6-a5d3-f06cf924281a",
                                                "sense_id": "feda1605-4b24-3b7d-aa73-558352e580b8",
                                                "text": "He is a status Indian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b778d263-4f7e-3181-931b-dbe1c2a59608",
                                        "entry_id": "39b82ca4-5c3c-39c1-81d5-1a4efbf6e258",
                                        "glosses": [
                                            "A function of some instant messaging applications, whereby a user may post a message that appears automatically to other users, if they attempt to make contact."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b193c322-f633-4388-980d-f507275ba884",
                                                "sense_id": "b778d263-4f7e-3181-931b-dbe1c2a59608",
                                                "text": "I'm just about to update my status to \"busy\"."
                                            },
                                            {
                                                "example_id": "0787a785-ab63-4816-90b2-f1ee34e9fd13",
                                                "sense_id": "b778d263-4f7e-3181-931b-dbe1c2a59608",
                                                "text": "I read your status last night / You posted that someone else was holding you tight"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96ad3aa8-47eb-34c8-964f-d2773257a6b4",
                                        "entry_id": "39b82ca4-5c3c-39c1-81d5-1a4efbf6e258",
                                        "glosses": [
                                            "Short for status epilepticus or status asthmaticus."
                                        ],
