{
    "word_family": [
        "Juckreiz",
        "Juckpulver",
        "juckig"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9fc19ebe-a687-3693-981a-fa63222a683b",
                    "sense_definition": "einen unangenehmen Reiz auf der Haut verursachen oder verspüren, der das Verlangen auslöst, sich zu kratzen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "koerpergefuehl",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem langen Spaziergang im Wald begann meine Haut am ganzen Körper zu <w>jucken</w>."
                        },
                        {
                            "text": "Wenn du von einer Mücke gestochen wirst, <w>juckt</w> die Einstichstelle meistens sehr stark."
                        }
                    ],
                    "common_phrases": [
                        "am ganzen Körper jucken",
                        "furchtbar jucken"
                    ]
                },
                {
                    "sense_id": "e46dc9d8-be81-3b4f-9c4b-3ca9efab65b4",
                    "sense_definition": "jemanden interessieren oder kümmern, vor allem in verneinten oder abwertenden Aussagen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "interesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seine ständigen Ausreden <w>jucken</w> im Büro schon lange niemanden mehr."
                        },
                        {
                            "text": "Ob er zu der Feier kommt oder nicht, <w>juckt</w> mich überhaupt nicht."
                        }
                    ],
                    "synonyms": [
                        "interessieren"
                    ],
                    "common_phrases": [
                        "überhaupt nicht jucken",
                        "keinen jucken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "überwiegend umgangssprachlich gebraucht"
                        }
                    ]
                },
                {
                    "sense_id": "646d6fd9-90a1-31e9-adef-4a552718c02c",
                    "sense_definition": "einen Drang oder das Verlangen in jemandem hervorrufen, etwas Bestimmtes zu tun",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Es <w>juckte</w> sie schon den ganzen Tag, ihm das Geheimnis endlich zu verraten."
                        },
                        {
                            "text": "Als er das neue Instrument sah, <w>juckte</w> es ihn in den Fingern."
                        }
                    ],
                    "synonyms": [
                        "reizen"
                    ],
                    "common_phrases": [
                        "in den Fingern jucken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "meist unpersönlich mit es gebraucht"
                        }
                    ]
                },
                {
                    "sense_id": "76b0bffd-2058-38f7-bc1d-97a4a637f9f0",
                    "sense_definition": "eine juckende Körperstelle kratzen oder reiben, um den Reiz zu lindern",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kratzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kannst du mich bitte kurz am Rücken <w>jucken</w>, weil ich selbst nicht herankomme?"
                        },
                        {
                            "text": "Das kleine Kind <w>juckte</w> sich so lange an der Wange, bis die Haut ganz rot war."
                        }
                    ],
                    "synonyms": [
                        "kratzen"
                    ],
                    "common_phrases": [
                        "am Rücken jucken"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "regional und umgangssprachlich statt kratzen"
                        }
                    ]
                },
                {
                    "sense_id": "64e584b3-a83c-3b3f-ba5d-bc679bc20921",
                    "sense_definition": "sich hüpfend oder mit Sprüngen fortbewegen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der kleine Frosch <w>juckte</w> schnell über den nassen Weg in das dichte Gras."
                        },
                        {
                            "text": "Die Kinder beobachteten begeistert, wie ein Reh über das weite Feld <w>juckte</w>."
                        }
                    ],
                    "synonyms": [
                        "hopsen",
                        "hüpfen",
                        "springen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "oberdeutsch"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f99625dd-a4c5-3bfd-b18a-b8d8f4e881da",
                    "sense_definition": "das unangenehme, reizende Gefühl auf der Haut, das zum Kratzen verleitet",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "koerpergefuehl",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eine kühlende Salbe kann das unangenehme <w>Jucken</w> nach einem Insektenstich schnell lindern."
                        },
                        {
                            "text": "Der Patient klagte beim Arzt über ein ständiges <w>Jucken</w> an beiden Armen."
                        }
                    ],
                    "common_phrases": [
                        "das Jucken lindern",
                        "unangenehmes Jucken"
                    ],
                    "synonyms": [
                        "Juckreiz"
                    ]
                }
            ]
        }
    ]
}