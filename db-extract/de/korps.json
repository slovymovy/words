                ],
                "senses": [
                    {
                        "sense_id": "b5d2b822-3827-3767-a688-ead6b8d80301",
                        "entry_id": "ea6e4eff-61c1-339e-82ad-5fdd33730527",
                        "glosses": [
                            "Großverband, dem oft mehrere Divisionen unterstehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb27a6a7-68ea-4ae7-b428-4f0038249d65",
                                "sense_id": "b5d2b822-3827-3767-a688-ead6b8d80301",
                                "text": "Wir haben ein Korps zu wenig, um die Front zu halten."
                            },
                            {
                                "example_id": "60a11e47-5b64-4a25-b6fe-280336563954",
                                "sense_id": "b5d2b822-3827-3767-a688-ead6b8d80301",
                                "text": "„Drinnen ging es lustig zu: Man hatte das Gepäck der englischen Offiziere durchwühlt, und eine Gruppe des Korps stolzierte nun in Uniformröcken und Federn umher.“"
                            },
                            {
                                "example_id": "b850dd17-3e0c-4f3e-9aa0-7f8a5903dca8",
                                "sense_id": "b5d2b822-3827-3767-a688-ead6b8d80301",
                                "text": "„Przebyszewski hatte mit seinem Korps die Waffen gestreckt.“"
                            },
                            {
                                "example_id": "1afb3820-4e13-47d8-bbe6-f1a6977115af",
                                "sense_id": "b5d2b822-3827-3767-a688-ead6b8d80301",
                                "text": "„Ein anderes Korps hatte als Feldmusik einen Geiger, der, wütend auf seinen zwei Saiten streichend, stolz neben dem zeitweilig geschaffenen Kapitän einherschritt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3b0a959b-58cd-384b-83ed-5b2a19d31dfb",
                        "entry_id": "ea6e4eff-61c1-339e-82ad-5fdd33730527",
                        "glosses": [
                            "Organisationsform von Studenten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8b2a151-c5a3-4c8f-9110-b98949dec425",
                                "sense_id": "3b0a959b-58cd-384b-83ed-5b2a19d31dfb",
                                "text": "„Ich gehörte auf der Schule zu einem Trifolium von Freunden, die sich einigen ihnen angefreundeten Studenten und sich selbst verpflichtet hatten, künftig in deren Korps eintreten zu wollen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3859c9fc-ac7c-4669-88f0-9c976079b834",
                        "source_entry_id": "ea6e4eff-61c1-339e-82ad-5fdd33730527",
                        "source_sense_id": "b5d2b822-3827-3767-a688-ead6b8d80301",
