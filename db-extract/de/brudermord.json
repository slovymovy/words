                            "vorsätzliche Tötung des eigenen Bruders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c294fc2-f5c4-4d6c-aade-fd7f7d28aecc",
                                "sense_id": "576bdbea-c681-3c50-98b6-a551ccc0d0ae",
