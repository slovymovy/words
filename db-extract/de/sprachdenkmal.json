                ],
                "senses": [
                    {
                        "sense_id": "164a2f5b-9f9b-3fa9-9c44-b5607092590f",
                        "entry_id": "1b419cb9-3edc-30e4-a10b-d3c865228633",
                        "glosses": [
                            "Texte/Fragmente, vor allem aus älteren Zeiten, die als aufschlussreich für die Entwicklung der Sprache und Literatur angesehen werden"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "ca29abf7-4257-4a3e-83dc-f8982be7036c",
                                "sense_id": "164a2f5b-9f9b-3fa9-9c44-b5607092590f",
                                "text": "„Die okkasionellen Bedeutungen entnimmt Paul den überlieferten Sprachdenkmälern, von denen er etliche selbst exzerpierte oder exzerpieren ließ.“"
                            },
                            {
                                "example_id": "0a544533-8502-42e4-9cb0-354fe845b9f5",
                                "sense_id": "164a2f5b-9f9b-3fa9-9c44-b5607092590f",
                                "text": "„Inhaltlich hat sich Kudrjavskij mit der Häufigkeit von Tempus-Formen (insbesondere des Aorist) in unterschiedlichen russischen und altrussischen Sprachdenkmälern beschäftigt, anhand derer er versucht, diachron verlaufende Prozesse empirisch zu fundieren.“"
                            },
                            {
                                "example_id": "81f83f7d-0cd4-4d2a-a23d-4a7437a218b3",
                                "sense_id": "164a2f5b-9f9b-3fa9-9c44-b5607092590f",
                                "text": "„Als sprachgeschichtliche Quellen sind sie dagegen von unschätzbarem Wert, da sie ja die ältesten Sprachdenkmale der Germanen bilden.“"
                            },
                            {
                                "example_id": "e70c7a7f-c544-45e2-a7a4-9f7c019bbf56",
                                "sense_id": "164a2f5b-9f9b-3fa9-9c44-b5607092590f",
                                "text": "„Insofern ist Luthers Bibel unbedingt ein Sprachdenkmal.“"
                            },
                            {
                                "example_id": "05b7a6c7-67ac-4dfa-85e9-1b27d8e1fce8",
                                "sense_id": "164a2f5b-9f9b-3fa9-9c44-b5607092590f",
                                "text": "„Der Segenswunsch von 1272 ist nicht das älteste erhaltene Sprachdenkmal des Jiddischen überhaupt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
