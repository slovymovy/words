                "senses": [
                    {
                        "sense_id": "b4dda3af-8a98-357a-bdf7-ba9e905c48ba",
                        "entry_id": "cce064c1-75a2-31c2-babf-7700ba60faca",
                        "glosses": [
                            "Débarrasser des accents circonflexes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c3f5346-4298-47f7-a8dd-64755a3fcb0d",
                                "sense_id": "b4dda3af-8a98-357a-bdf7-ba9e905c48ba",
                                "text": "Et si les sots l'emportent devra-t-on réécrire Tous les auteurs classiques victimes du complot Et \"décirconflexer\" Chateaubriand, Hugo, Pour plaire aux m’as-tu-vu nous préparant au pire."
                            },
                            {
                                "example_id": "72d5f3ce-3b2f-4629-a010-0cc76970fdfc",
                                "sense_id": "b4dda3af-8a98-357a-bdf7-ba9e905c48ba",
                                "text": "Elle a certainement fait un rêve, la pauvre bientôt elle hissera les voiles et pour se donner bonne conscience de sa grosse retraite elle aura au moins décirconflexé les français."
                            },
                            {
                                "example_id": "1e5babc0-96a3-47bd-9d95-4d2fc35a1da2",
                                "sense_id": "b4dda3af-8a98-357a-bdf7-ba9e905c48ba",
                                "text": "Militance décirconflexée."
                            }
                        ]
                    }
