                        },
                        {
                            "text": "Je kunt je bestelling morgen in de winkel <w>ophalen</w>.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>забрать</w> свой заказ завтра в магазине.",
                                "en": "You can <w>pick up</w> your order at the store tomorrow.",
                                "it": "Puoi <w>ritirare</w> il tuo ordine in negozio domani.",
                                "pl": "Możesz <w>odebrać</w> swoje zamówienie w sklepie jutro.",
                                "de": "Du kannst deine Bestellung morgen im Laden <w>abholen</w>.",
                                "fr": "Vous pouvez <w>récupérer</w> votre commande au magasin demain.",
                                "cs": "Svou objednávku si můžete zítra v obchodě <w>vyzvednout</w>.",
                                "tr": "Siparişinizi yarın mağazadan <w>alabilirsiniz</w>.",
                                "es": "Puedes <w>recoger</w> tu pedido en la tienda mañana.",
                                "zh": "你明天可以去店里把你的订单<w>取</w>走。"
                            }
