                                            {
                                                "example_id": "7a8cf658-3134-4b2f-803c-da98f33c90b8",
                                                "sense_id": "46d8c167-bf88-30fa-b832-df5e4a51e0a8",
                                                "text": "Pielgrzymi z Polski ofiarowali Janowi Pawłowi II monstrancję, która trafi do jednego z afrykańskich kościołów."
                                            },
                                            {
                                                "example_id": "1134109a-6839-4d94-9442-66dff036d3c1",
                                                "sense_id": "46d8c167-bf88-30fa-b832-df5e4a51e0a8",
                                                "text": "Gloria wokół monstrancji była wulkanicznego, szarego koloru."
                                            },
                                            {
                                                "example_id": "124cd0c8-b7fe-4b41-81f5-c09b4c9ed676",
                                                "sense_id": "46d8c167-bf88-30fa-b832-df5e4a51e0a8",
                                                "text": "Diakon miał problem, melchizedek nie pasował do monstrancji."
                                            }
