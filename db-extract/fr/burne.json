        "fr-extract.jsonl": [
            {
                "entry_id": "8e03cf6d-d715-3344-a329-31c11fec276b",
                "word": "burne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5b6d0ceb-6deb-42ff-9a56-7cea818f1fbc",
                        "entry_id": "8e03cf6d-d715-3344-a329-31c11fec276b",
                        "tags": [
                            "plural"
                        ],
                        "form": "burnes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "04165d97-0075-34e1-9ac6-82979fca4e53",
                        "entry_id": "8e03cf6d-d715-3344-a329-31c11fec276b",
                        "glosses": [
                            "Testicule."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "7ea4043f-4b3c-4c7d-9229-9c87a2e0a2f8",
                                "sense_id": "04165d97-0075-34e1-9ac6-82979fca4e53",
                                "text": "Ça me casse les burnes."
                            },
                            {
                                "example_id": "fca99e77-ded4-485f-b82b-044c04e24900",
                                "sense_id": "04165d97-0075-34e1-9ac6-82979fca4e53",
                                "text": "Nous avions l’impression qu’à nous deux, nous allions arrêter l’avance allemande. Nous avons eu cet élan viscéral, venu du fond des burnes, sans doute ce qu’on appelle le patriotisme."
                            },
                            {
                                "example_id": "cfad4edc-708d-4e54-8f9f-8b540bd3f282",
                                "sense_id": "04165d97-0075-34e1-9ac6-82979fca4e53",
                                "text": "Il faut absolument que leur mâle assure un minimum de revenu, sinon, vous pensez bien que ça ne vaut pas la peine de s’encombrer d’un mec qui a perdu une burne sur deux."
                            }
                        ]
                    },
                    {
                        "sense_id": "f049b5de-a944-3986-b7ae-7e4c36f3843b",
                        "entry_id": "8e03cf6d-d715-3344-a329-31c11fec276b",
                        "glosses": [
                            "Bon à rien, incapable."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "d19f0bc9-06b7-4fe5-9ba4-6bab79164183",
                                "sense_id": "f049b5de-a944-3986-b7ae-7e4c36f3843b",
                                "text": "Vous n’avez même pas été foutus de réussir cette épreuve, pourtant très facile. Vous êtes des burnes !"
                            }
                        ]
                    }
                ],
