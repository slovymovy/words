                        "examples": [
                            {
                                "example_id": "c66975b4-e064-48ee-9a83-88cc07ce26f9",
                                "sense_id": "52dd4812-f81d-39fe-bf5c-056e57a7b4ed",
                                "text": "„Im Dezember 1988 ging Arafat zudem auf die Bedingungen für einen Dialog mit den USA ein: Explizit erkannte er die UN-Resolutionen 242 und 338 sowie Israels Existenzrecht an und distanzierte sich vom Terrorismus.“"
                            },
                            {
                                "example_id": "faffbc5c-48ec-4a17-bc3c-a2545416d45d",
                                "sense_id": "52dd4812-f81d-39fe-bf5c-056e57a7b4ed",
                                "text": "„Der Dämon fragt ohne Pause weiter: ›Hat der zionistische Staat Israel ein Existenzrecht?‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
