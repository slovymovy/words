                        "sense_id": "45a78f26-e59e-3230-b3b5-f3045f84c66a",
                        "entry_id": "8040c6b1-b5ed-3c7d-b0fc-39f93e1da0a6",
                        "glosses": [
                            "dem Justizministerium der Vereinigten Staaten unterstellte Bundespolizeibehörde, die für die Durchsetzung bundesstaatlicher Gesetze in Bezug auf Schusswaffen, Sprengstoffe, Brandstiftung sowie Alkohol- und Tabakprodukte zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f80cdacf-c148-4ee5-8f8c-b365b7c5b04e",
                                "sense_id": "45a78f26-e59e-3230-b3b5-f3045f84c66a",
                                "text": "„›Das ATF und die Börsenaufsicht sind auch hinter ihnen her, soweit ich weiß.‹“"
                            },
                            {
                                "example_id": "6cb8adb4-827c-4b30-9d6c-a03060c4e087",
                                "sense_id": "45a78f26-e59e-3230-b3b5-f3045f84c66a",
                                "text": "„›Der Mann, der als Zeuge über die Flaschenabfüllung aussagen wird, hat berichtet, dass 1992 und dann erneut 1997 Nachfragen wegen Champagnerfälschung vom amerikanischen ATF, dem Bureau for Alcohol, Tobacco, Firearms and Explosives, kamen und dass eine südafrikanische Zeitung darüber berichtet hat.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
