                    }
                ],
                "translations": [
                    {
                        "translation_id": "46a20bd5-411a-4ddb-af24-67e03459c90c",
                        "source_entry_id": "7f8dd1d1-900c-335d-a529-6377c262b207",
                        "source_sense_id": "e348595e-4594-3559-a946-2cd22e80373b",
                        "source_sense_description": "gerechtelijk ambtenaar die exploten en executien doet, dagvaardingen uitbrengt en beslagen legt",
                        "target_lang_word": "Gerichtsvollzieher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gerichtsvollzieher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ffa92b6a-69c5-3df5-8dfa-6ccd00483796",
                                        "entry_id": "6c657882-f8ad-3ce0-a838-d0af95087952",
                                        "glosses": [
                                            "Beamter, dessen Aufgabe es ist, richterliche Urteile und andere Vollstreckungstitel gegebenenfalls zwangsweise zu vollstrecken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee65dbea-d9fe-4dc7-8e34-4da989b37a36",
                                                "sense_id": "ffa92b6a-69c5-3df5-8dfa-6ccd00483796",
                                                "text": "Der Gerichtsvollzieher kann eine Wohnung zwangsweise räumen, Gegenstände austauschen und Dokumente amtlich zustellen."
                                            },
                                            {
                                                "example_id": "129c1172-565c-425f-b254-563cb86d4969",
                                                "sense_id": "ffa92b6a-69c5-3df5-8dfa-6ccd00483796",
                                                "text": "„Sie hielten ihn offenbar für einen Gerichtsvollzieher.“"
                                            },
                                            {
                                                "example_id": "3bc2e1c6-1738-4c51-9076-f30e63e5de49",
                                                "sense_id": "ffa92b6a-69c5-3df5-8dfa-6ccd00483796",
                                                "text": "„Beinahe wöchentlich stand der Gerichtsvollzieher vor der Tür, um etwas zu pfänden, immer wieder drohte der Rauswurf aus den Wohnungen – vielleicht mit ein Grund, warum mein Vater zeitlebens so erpicht darauf war, Reichtümer anzuhäufen und dennoch lebte wie ein Geizhals, der sich nur das Nötigste gönnte.“"
                                            },
                                            {
                                                "example_id": "27a071a0-437e-4220-a6c1-707e817e017b",
                                                "sense_id": "ffa92b6a-69c5-3df5-8dfa-6ccd00483796",
                                                "text": "„Mit fünfzehn Jahren hatte man ihn aus dem Internat genommen und bei einem Gerichtsvollzieher untergebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
