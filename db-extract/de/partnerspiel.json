                "senses": [
                    {
                        "sense_id": "7a09d72d-7719-393e-8333-45d795b97c2d",
                        "entry_id": "f7322cb8-90ac-35cd-9e87-1e2cd89c50b2",
                        "glosses": [
                            "Spiel, bei dem die Spieler sich paarweise organisieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63dd4063-fa32-40ee-ae69-b70f887f4c98",
                                "sense_id": "7a09d72d-7719-393e-8333-45d795b97c2d",
                                "text": "„In den Partnerspielen wird angestrebt, daß Kinder vor allem ihre Motorik aufeinander einstellen lernen, eine Vorübung für kooperatives Handeln.“"
                            },
                            {
                                "example_id": "14266ce1-2575-4baf-b8c2-82467008f5ab",
                                "sense_id": "7a09d72d-7719-393e-8333-45d795b97c2d",
                                "text": "„Das Partnerspiel lebt aus dem Wechselspiel zwischen zwei sich gegenüberstehenden Partnern (Paaren).“"
                            },
                            {
                                "example_id": "e0d2e68d-ae1c-43a7-8d61-e7094e8d72e6",
                                "sense_id": "7a09d72d-7719-393e-8333-45d795b97c2d",
                                "text": "„Dabei gilt allerdings auch für die Partnerspiele der Grundsatz: Vielseitige Spielerfahrungen in kleinen und mittleren Gruppen bilden die Voraussetzung für eine Spezialisierung.“"
                            },
                            {
                                "example_id": "3132d254-b217-4242-a8e9-31b3ec23117e",
                                "sense_id": "7a09d72d-7719-393e-8333-45d795b97c2d",
                                "text": "„Wenn eine besondere Neigung zu Aggressionen besteht, empfiehlt es sich, eine Zeitlang Spiele zu bevorzugen, die mehr das Miteinander als das Gegeneinander fordern, statt Konkurrenzspiele also mehr Partnerspiele zu praktizieren.“"
                            },
                            {
                                "example_id": "d8e6d914-6af5-4637-b98e-bc7cdd5639e2",
                                "sense_id": "7a09d72d-7719-393e-8333-45d795b97c2d",
                                "text": "„Spiele ohne Sieger“, auch Partnerspiele genannt, sind auch bei uns nicht ganz unbekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a333cf79-d0b7-363b-b031-427cb4f02d97",
                        "entry_id": "f7322cb8-90ac-35cd-9e87-1e2cd89c50b2",
                        "glosses": [
                            "Flirt, Liebesspiel"
                        ],
                        "tags": [
                            "Erotik"
                        ],
                        "examples": [
                            {
                                "example_id": "1f4d71f4-903a-4f5c-a08d-fefae3b112fc",
                                "sense_id": "a333cf79-d0b7-363b-b031-427cb4f02d97",
                                "text": "„Im Mai 1969, Flower-Power stand voll im Saft, startete Sinalco Kola ein Partnerspiel.“"
                            },
                            {
                                "example_id": "26c86837-796d-476c-a498-4546deed7ae9",
                                "sense_id": "a333cf79-d0b7-363b-b031-427cb4f02d97",
                                "text": "„Verrückte Partnerspiele, Live-Musik, Disko-Tanz und Filmnacht sorgen für Stimmung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
