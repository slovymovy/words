                    }
                ],
                "senses": [
                    {
                        "sense_id": "854bd81a-38f0-3b18-88d8-2b8d2388bf93",
                        "entry_id": "eb41cd3a-3aa6-322c-b3bd-d49f1dde9a56",
                        "glosses": [
                            "iemand uit Frankrijk"
                        ],
                        "tags": [],
