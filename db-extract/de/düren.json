                "senses": [
                    {
                        "sense_id": "76944fdd-7349-3186-9124-f00ad8cf8ae1",
                        "entry_id": "4e52a710-3629-3e35-a42d-e0187a5426c1",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5571ffda-0b36-45ac-94a1-6bf1e7fe5478",
                                "sense_id": "76944fdd-7349-3186-9124-f00ad8cf8ae1",
                                "text": "Frau Düren ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "91145dee-945c-4e79-83ac-e4776a7f05fc",
                                "sense_id": "76944fdd-7349-3186-9124-f00ad8cf8ae1",
                                "text": "Herr Düren wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9b61205a-f327-42eb-be8d-ae8d7e125fca",
                                "sense_id": "76944fdd-7349-3186-9124-f00ad8cf8ae1",
                                "text": "Die Dürens fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "a13da03e-f324-4d81-a940-8c41b099d863",
                                "sense_id": "76944fdd-7349-3186-9124-f00ad8cf8ae1",
                                "text": "Der Düren trägt nie die Pullover, die die Düren ihm strickt."
                            },
                            {
                                "example_id": "bf4da8e3-1c01-4b37-9e60-6f135d3af149",
                                "sense_id": "76944fdd-7349-3186-9124-f00ad8cf8ae1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Düren kommt, geht der Herr Düren.“"
                            },
                            {
                                "example_id": "21f9ab37-2e55-4651-99f4-b5b28e942401",
                                "sense_id": "76944fdd-7349-3186-9124-f00ad8cf8ae1",
                                "text": "Düren kommt und geht."
                            },
                            {
                                "example_id": "75a86a0d-fe90-49e8-b124-a1d178876586",
                                "sense_id": "76944fdd-7349-3186-9124-f00ad8cf8ae1",
                                "text": "Dürens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
