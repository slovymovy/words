{
    "word_family": [
        "courteous",
        "courteously",
        "curtsey"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "31b4b823-0ef3-34e2-8249-bccbc5947595",
                    "sense_definition": "Polite behavior or good manners.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known for his kindness and <w>courtesy</w> to everyone he met.",
                            "target_lang_translations": {
                                "ru": "Он был известен своей добротой и <w>вежливостью</w> ко всем, кого встречал.",
                                "zh": "他以对每个人都友善且<w>有礼貌</w>而闻名。"
                            }
                        },
                        {
                            "text": "It is common <w>courtesy</w> to hold the door open for the person behind you.",
                            "target_lang_translations": {
                                "ru": "Придержать дверь для идущего сзади — это элементарная <w>вежливость</w>.",
                                "zh": "为身后的人扶住门是基本的<w>礼貌</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "common courtesy",
                        "treat with courtesy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливое поведение или хорошие манеры.",
                        "zh": "礼貌的行为或良好的教养。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вежливость",
                                "target_lang_sense_clarification": "основное значение; соблюдение правил приличия"
                            },
                            {
                                "target_lang_word": "учтивость",
                                "target_lang_sense_clarification": "подчеркнутая, почтительная вежливость"
                            },
                            {
                                "target_lang_word": "обходительность",
                                "target_lang_sense_clarification": "вежливость в общении, любезность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "礼貌",
                                "target_lang_sense_clarification": "指言谈举止合乎礼节"
                            },
                            {
                                "target_lang_word": "客气",
                                "target_lang_sense_clarification": "指对人谦逊、有礼貌"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00242e77-3609-3cb3-9736-7991c7dff120",
                    "sense_definition": "Willingness or generosity in providing something, often used to credit the source of a gift or permission.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The images appear in the article <w>courtesy</w> of the museum.",
                            "target_lang_translations": {
                                "ru": "Изображения в статье опубликованы с <w>любезного разрешения</w> музея.",
                                "zh": "文中的图片<w>承蒙</w>博物馆提供。"
                            }
                        },
                        {
                            "text": "We received free tickets to the concert <w>courtesy</w> of the radio station.",
                            "target_lang_translations": {
                                "ru": "Мы получили бесплатные билеты на концерт <w>благодаря любезности</w> радиостанции.",
                                "zh": "我们<w>承蒙</w>广播电台的好意，收到了免费的音乐会门票。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "courtesy of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовность или щедрость в предоставлении чего-либо; часто используется для указания источника подарка или разрешения.",
                        "zh": "指提供某物时的慷慨或好意，常用于说明礼物或许可的来源。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любезность",
                                "target_lang_sense_clarification": "услуга или одолжение"
                            },
                            {
                                "target_lang_word": "разрешение",
                                "target_lang_sense_clarification": "в контексте 'courtesy of' — с разрешения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "承蒙……提供",
                                "target_lang_sense_clarification": "用于说明物品或信息的来源"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62e6a8c7-dd4e-3b57-a08f-b143e4ae36aa",
                    "sense_definition": "A specific polite action, gesture, or remark.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I offered them a ride home simply as a <w>courtesy</w>.",
                            "target_lang_translations": {
                                "ru": "Я предложил подвезти их домой просто из <w>любезности</w>.",
                                "zh": "我主动提出送他们回家，纯粹是出于<w>礼貌</w>。"
                            }
                        },
                        {
                            "text": "They exchanged small <w>courtesies</w> before starting the business meeting.",
                            "target_lang_translations": {
                                "ru": "Они обменялись мелкими <w>любезностями</w> перед началом деловой встречи.",
                                "zh": "在开始商务会议之前，他们交换了一些<w>客套话</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "as a courtesy",
                        "extend a courtesy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное вежливое действие, жест или замечание.",
                        "zh": "具体的礼貌行为、姿态或言语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любезность",
                                "target_lang_sense_clarification": "отдельный акт вежливости, комплимент"
                            },
                            {
                                "target_lang_word": "знак внимания",
                                "target_lang_sense_clarification": "вежливый жест"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "客套",
                                "target_lang_sense_clarification": "指礼节性的言语或行为"
                            },
                            {
                                "target_lang_word": "礼节",
                                "target_lang_sense_clarification": "指具体的礼貌举动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "377c0e6e-2b00-3418-a6fe-2e82885439c6",
                    "sense_definition": "Consent, agreement, or indulgence granted in spite of strict facts or rules.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He holds the title of captain by <w>courtesy</w> only, as he is actually retired.",
                            "target_lang_translations": {
                                "ru": "Он носит звание капитана лишь <w>из вежливости</w>, так как на самом деле он в отставке.",
                                "zh": "他只是<w>名义上</w>保留着船长的头衔，因为他实际上已经退休了。"
                            }
                        },
                        {
                            "text": "They call this small pond a lake by <w>courtesy</w>.",
                            "target_lang_translations": {
                                "ru": "Они называют этот маленький пруд озером лишь <w>условно</w>.",
                                "zh": "他们只是<w>客气地</w>把这个小池塘称为湖。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "by courtesy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Согласие или уступка, допущенные вопреки строгим фактам или правилам.",
                        "zh": "尽管不符合严格的事实或规则，但出于礼貌而给予的认可或称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снисхождение",
                                "target_lang_sense_clarification": "уступка, отсутствие строгости"
                            },
                            {
                                "target_lang_word": "условность",
                                "target_lang_sense_clarification": "признание статуса без фактических оснований"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "名义上的",
                                "target_lang_sense_clarification": "指仅在称呼上给予的尊重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd5dd16c-e874-3c2e-9d4e-27b50d444207",
                    "sense_definition": "A formal gesture of respect made by bending the knees; an alternative spelling of curtsey.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gesture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lady dropped a low <w>courtesy</w> to the queen.",
                            "target_lang_translations": {
                                "ru": "Дама сделала глубокий <w>реверанс</w> королеве.",
                                "zh": "那位女士向女王行了一个深<w>屈膝礼</w>。"
                            }
                        },
                        {
                            "text": "She practiced her <w>courtesy</w> in front of the mirror before the ball.",
                            "target_lang_translations": {
                                "ru": "Она репетировала свой <w>реверанс</w> перед зеркалом перед балом.",
                                "zh": "舞会前，她在镜子前练习行<w>屈膝礼</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling of curtsey"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "now usually spelled curtsey"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальный жест уважения с преклонением колен; альтернативное написание слова curtsey.",
                        "zh": "一种通过屈膝表示尊重的正式礼仪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реверанс",
                                "target_lang_sense_clarification": "женский поклон с приседанием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屈膝礼",
                                "target_lang_sense_clarification": "女性行的一种礼节"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "43e529b7-7119-36f1-8235-15d15c7f787d",
                    "sense_definition": "Supplied free of charge, often as a service to customers.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "free",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel offers a <w>courtesy</w> bus to take guests to the airport.",
                            "target_lang_translations": {
                                "ru": "Отель предлагает <w>бесплатный</w> автобус, чтобы отвезти гостей в аэропорт.",
                                "zh": "酒店提供<w>免费</w>巴士接送客人前往机场。"
                            }
                        },
                        {
                            "text": "We were given <w>courtesy</w> tickets for the evening performance.",
                            "target_lang_translations": {
                                "ru": "Нам дали <w>бесплатные</w> билеты на вечернее представление.",
                                "zh": "我们收到了晚间演出的<w>免费</w>票。"
                            }
                        }
                    ],
                    "synonyms": [
                        "complimentary",
                        "free of charge",
                        "gratis"
                    ],
                    "common_phrases": [
                        "courtesy car",
                        "courtesy bus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставляемый бесплатно, часто как услуга для клиентов.",
                        "zh": "免费提供的，通常作为对客户的一种服务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бесплатный",
                                "target_lang_sense_clarification": "не требующий оплаты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "免费的",
                                "target_lang_sense_clarification": "不收取费用的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ed1e769-2b92-37c3-825a-a5e673bb2ba0",
                    "sense_definition": "Given or done as a polite gesture or formality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "polite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ambassador paid a <w>courtesy</w> visit to the new president.",
                            "target_lang_translations": {
                                "ru": "Посол нанес <w>визит вежливости</w> новому президенту.",
                                "zh": "大使对新任总统进行了<w>礼节性</w>访问。"
                            }
                        },
                        {
                            "text": "It was just a <w>courtesy</w> call to ensure everything was running smoothly.",
                            "target_lang_translations": {
                                "ru": "Это был просто <w>звонок вежливости</w>, чтобы убедиться, что все идет гладко.",
                                "zh": "这只是一个确保一切运行顺利的<w>礼节性</w>电话。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "courtesy call",
                        "courtesy visit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный как вежливый жест или формальность.",
                        "zh": "作为礼貌姿态或形式而进行的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вежливости",
                                "target_lang_sense_clarification": "в словосочетаниях типа 'визит вежливости'"
                            },
                            {
                                "target_lang_word": "этикетный",
                                "target_lang_sense_clarification": "сделанный ради соблюдения этикета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "礼节性的",
                                "target_lang_sense_clarification": "指为了符合礼仪而进行的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "81237c12-1702-377b-83b0-3b5230bd83c9",
                    "sense_definition": "To perform a formal gesture of respect by bending the knees; alternative form of curtsey.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gesture_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>courtesied</w> deeply when the monarch entered the room.",
                            "target_lang_translations": {
                                "ru": "Она глубоко <w>присела в реверансе</w>, когда монарх вошел в комнату.",
                                "zh": "当君主走进房间时，她深深地<w>行了屈膝礼</w>。"
                            }
                        },
                        {
                            "text": "The dancers <w>courtesied</w> to the audience at the end of the show.",
                            "target_lang_translations": {
                                "ru": "Танцоры <w>сделали реверанс</w> зрителям в конце шоу.",
                                "zh": "演出结束时，舞者们向观众<w>行了屈膝礼</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling of curtsey"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "now usually spelled curtsey"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять формальный жест уважения с преклонением колен; альтернативная форма глагола curtsey.",
                        "zh": "通过屈膝来行正式的尊重礼仪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать реверанс",
                                "target_lang_sense_clarification": "приседать в знак уважения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "行屈膝礼",
                                "target_lang_sense_clarification": "指做出屈膝的动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}