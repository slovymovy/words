    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c1c77285-bf6c-38fe-af7d-2931aa729365",
                    "sense_definition": "The area located by and around the sea, typically including the beach, promenade, or cliffs.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "coastal_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many families enjoy spending their summer holidays at the <w>seaside</w>.",
                            "target_lang_translations": {
                                "ru": "Многие семьи любят проводить летние отпуска на <w>побере́жье</w>."
                            }
                        },
                        {
                            "text": "We walked along the <w>seaside</w> promenade to enjoy the fresh ocean air.",
                            "target_lang_translations": {
                                "ru": "Мы гуляли по <w>примо́рской</w> набережной, наслаждаясь свежим океанским воздухом."
                            }
                        }
                    ],
                    "synonyms": [
                        "coast",
                        "beach",
                        "seashore"
                    ],
                    "common_phrases": [
                        "seaside town",
                        "seaside resort",
                        "seaside holiday"
                    ],
                    "target_lang_definitions": {
                        "ru": "Местность, расположенная у моря, включая пляж, набережную или прибрежную зону."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "побере́жье",
                                "target_lang_sense_clarification": "общий термин для местности вдоль берега моря"
                            },
                            {
                                "target_lang_word": "взмо́рье",
                                "target_lang_sense_clarification": "прибрежная часть моря или приморский район"
                            },
                            {
                                "target_lang_word": "бе́рег мо́ря",
                                "target_lang_sense_clarification": "непосредственно береговая линия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8a468d29-a05c-35af-8510-5835951426ba",
                    "sense_definition": "Relating to or located by the sea.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "coastal_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They stayed in a small <w>seaside</w> hotel overlooking the water.",
                            "target_lang_translations": {
                                "ru": "Они остановились в небольшом <w>примо́рском</w> отеле с видом на воду."
                            }
                        },
                        {
                            "text": "The town is famous for its beautiful <w>seaside</w> views.",
                            "target_lang_translations": {
                                "ru": "Город славится своими красивыми <w>примо́рскими</w> пейзажами."
                            }
                        }
                    ],
                    "synonyms": [
                        "coastal",
                        "maritime"
                    ],
                    "common_phrases": [
                        "seaside village",
                        "seaside cottage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к морю или расположенный у моря."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "примо́рский",
                                "target_lang_sense_clarification": "находящийся у моря или связанный с морем"
                            }
                        ]
                    }
                }
            ]
        },
        {
