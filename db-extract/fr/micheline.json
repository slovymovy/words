                    {
                        "form_id": "6fc9c3c5-ae21-47a9-a459-7493fedac22c",
                        "entry_id": "1938bcf1-3751-3e03-a3b3-9370bb7ba961",
                        "tags": [],
                        "form": "Micheline"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9cae6af3-5d9f-36ee-8b66-4a6212f5d7b8",
                        "entry_id": "1938bcf1-3751-3e03-a3b3-9370bb7ba961",
                        "glosses": [
                            "Autorail léger équipé de pneumatiques, mis au point par la société Michelin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd7590fd-e8fe-47a9-92de-1f67d684cc62",
                                "sense_id": "9cae6af3-5d9f-36ee-8b66-4a6212f5d7b8",
                                "text": "Le premier prototype de micheline fut présenté aux compagnies ferroviaires en 1931."
                            }
                        ]
                    },
                    {
                        "sense_id": "0220fd03-f158-3fdd-b6d6-22c30448efcd",
                        "entry_id": "1938bcf1-3751-3e03-a3b3-9370bb7ba961",
                        "glosses": [
                            "Autorail, en général."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "eb544151-7b8d-418e-b147-dde582cd0c78",
                                "sense_id": "0220fd03-f158-3fdd-b6d6-22c30448efcd",
                                "text": "En 2005, les 500 michelines encore en vie auront disparu. La change de look et la régionalisation ferroviaire s'incarne aussi dans la modernisation des équipements."
                            },
                            {
                                "example_id": "d3225914-c381-4c5e-8929-ca25ab53d780",
                                "sense_id": "0220fd03-f158-3fdd-b6d6-22c30448efcd",
                                "text": "Sa femme et leurs trois enfants avaient réussi à prendre la micheline pour arriver à Brazzaville, d’où ils avaient traversé le fleuve Congo et s’étaient exilés dans l’autre Congo."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
