                    "sense_id": "8e5c3c79-fa2d-321e-993b-3b079bbcf6d4",
                    "sense_definition": "zich naar achteren of naar binnen verplaatsen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten moesten langzaam <w>terugwijken</w> toen de vijand met zware artillerie begon aan te vallen.",
                            "target_lang_translations": {
                                "fr": "Les soldats ont dû lentement <w>reculer</w> lorsque l'ennemi a commencé à attaquer avec de l'artillerie lourde."
                            }
                        },
                        {
                            "text": "De menigte <w>week</w> geschrokken <w>terug</w> toen de gevaarlijke hond begon te blaffen.",
                            "target_lang_translations": {
                                "fr": "Effrayée, la foule a <w>reculé</w> lorsque le chien dangereux s'est mis à aboyer."
                            }
                        }
                    ],
                    "synonyms": [
                        "achteruitwijken",
                        "teruggaan"
                    ],
                    "common_phrases": [
                        "langzaam terugwijken",
                        "voor de vijand terugwijken"
                    ],
                    "target_lang_definitions": {
                        "fr": "Se déplacer vers l'arrière, reculer face à une pression ou un danger"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "reculer",
                                "target_lang_sense_clarification": "faire des pas en arrière"
                            },
                            {
                                "target_lang_word": "battre en retraite",
                                "target_lang_sense_clarification": "militaire"
                            },
                            {
                                "target_lang_word": "plier",
                                "target_lang_sense_clarification": "céder du terrain sous la pression"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4787b7a-9aeb-3877-a0fe-7b67d7a6f476",
                    "sense_definition": "zich terugtrekken, opgeven of bang worden van iets",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politicus beloofde dat hij voor geen enkele bedreiging zou <w>terugwijken</w>.",
                            "target_lang_translations": {
                                "fr": "L'homme politique a promis qu'il ne <w>reculerait devant</w> aucune menace."
                            }
                        },
                        {
                            "text": "Hij <w>week</w> niet <w>terug</w> voor de zware uitdaging en zette zijn plannen door.",
                            "target_lang_translations": {
                                "fr": "Il n'a pas <w>reculé</w> devant le défi difficile et a poursuivi ses projets."
                            }
                        }
                    ],
                    "synonyms": [
                        "terugdeinzen",
                        "vluchten"
                    ],
                    "common_phrases": [
                        "niet terugwijken voor"
                    ],
                    "target_lang_definitions": {
                        "fr": "Renoncer, hésiter ou céder face à une difficulté ou une menace"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "reculer devant",
