                                "sense_id": "3ebce1f4-e5d9-30b4-b0d0-26b00c2a8613",
                                "text": "Woran kann man Tiger erkennen?"
                            },
                            {
                                "example_id": "67afa81f-3cb6-410a-af8f-2512180bcb51",
                                "sense_id": "3ebce1f4-e5d9-30b4-b0d0-26b00c2a8613",
                                "text": "Und woran ist sie dann erstickt? An einer Gräte?"
                            },
                            {
                                "example_id": "b7ad28ab-1970-4f1e-a56c-22871a387fd4",
                                "sense_id": "3ebce1f4-e5d9-30b4-b0d0-26b00c2a8613",
                                "text": "Woran machst du die Lüge eigentlich fest?"
                            },
                            {
                                "example_id": "093de77c-d6d1-40c3-91f9-d78f63e70765",
                                "sense_id": "3ebce1f4-e5d9-30b4-b0d0-26b00c2a8613",
                                "text": "Woran wollen sie denn das festmachen?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c629913b-cfdc-3228-87fa-511f4ee8203f",
                        "entry_id": "38a39a93-3d54-3890-8668-1170620ff197",
                        "glosses": [
