                "senses": [
                    {
                        "sense_id": "c14c44bd-5e98-3018-a16d-95068ecac078",
                        "entry_id": "df2f1273-e214-3747-8be8-dc6be62c99e4",
                        "glosses": [
                            "État, position d’une chose qui s’emboîte dans une autre, de deux choses qui s’emboîtent l’une dans l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40b1e494-40ac-4ae7-9341-2223f633d860",
                                "sense_id": "c14c44bd-5e98-3018-a16d-95068ecac078",
                                "text": "Le calorifère consiste en un fourneau cylindrique a en fonte ayant 3m,30 de hauteur et 0m,50 de diamètre. Les quatre pièces dont il se compose sont assemblées à emboîtement et lutées avec soin, […]."
                            },
                            {
                                "example_id": "69c8e684-07b5-4476-aadf-dafa661003b0",
                                "sense_id": "c14c44bd-5e98-3018-a16d-95068ecac078",
                                "text": "La terre et la nuit étaient étroitement ajustées. Les maisons, les rues de la ville, leurs saillies et leurs creux semblaient n’être que les tenons et les mortaises de cet emboîtement."
                            },
                            {
                                "example_id": "f22e422a-ac9e-48c7-a41d-230fd93e29ec",
                                "sense_id": "c14c44bd-5e98-3018-a16d-95068ecac078",
                                "text": "Je définirais volontiers cet espace – appelé d’ailleurs Grand Centre – comme une addition, voire un emboîtement, de concentrations massives, qui ensemble créent une animation considérable durant la journée et un désert le soir."
                            },
                            {
                                "example_id": "0b047438-feb9-4eb2-8d49-4a9c2c7a35a7",
                                "sense_id": "c14c44bd-5e98-3018-a16d-95068ecac078",
                                "text": "L’emboîtement des os, d’un os dans un autre."
                            }
                        ]
                    }
                ],
