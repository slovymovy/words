                        "examples": [
                            {
                                "example_id": "1b232738-8f3b-415d-988e-78445381475a",
                                "sense_id": "bd65ca03-30c2-319c-897c-439f3df1ecf0",
                                "text": "„Als er die Augen aufschlug, stand Jonas an seinem Bett, und die Türe war weit offen.“"
                            },
                            {
                                "example_id": "dba08452-2015-4e32-824f-cdd371992a9c",
                                "sense_id": "bd65ca03-30c2-319c-897c-439f3df1ecf0",
                                "text": "„Für einen Türsensor, der die Türe des Fahrzeugs ohne Berührung aufschwingen lässt, sprechen aber weitere Gründe. Der Wichtigste ist die Hindernisfreiheit.“"
                            }
                        ],
