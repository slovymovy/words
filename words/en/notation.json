{
    "word_family": [
        "notate",
        "notational",
        "notate",
        "note"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e876ede9-8dac-347c-aae8-98926ba38b63",
                    "sense_definition": "A system of characters, symbols, or abbreviated expressions used in an art, science, mathematics, or logic to express technical facts or quantities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "symbolic_systems",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This section lists all algebraic <w>notation</w> used in this book.",
                            "target_lang_translations": {
                                "ru": "В этом разделе перечислены все алгебраические <w>нотации</w>, используемые в этой книге."
                            }
                        },
                        {
                            "text": "The <w>notations</w> used in the two books differed significantly.",
                            "target_lang_translations": {
                                "ru": "Используемые в этих двух книгах <w>системы записи</w> значительно различались."
                            }
                        }
                    ],
                    "synonyms": [
                        "symbology"
                    ],
                    "common_phrases": [
                        "algebraic notation",
                        "musical notation",
                        "scientific notation",
                        "standard notation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система символов, знаков или сокращений, используемая в искусстве, науке или математике для выражения технических фактов или величин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нотация",
                                "target_lang_sense_clarification": "система условных обозначений"
                            },
                            {
                                "target_lang_word": "система записи",
                                "target_lang_sense_clarification": "способ фиксирования данных"
                            },
                            {
                                "target_lang_word": "обозначение",
                                "target_lang_sense_clarification": "символическое представление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "587588b1-695b-3b90-8a44-ff5b959fb317",
                    "sense_definition": "A specific note or piece of information written down, often briefly or in the margin of a document.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "written_notes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She made a small <w>notation</w> in the margin of the book.",
                            "target_lang_translations": {
                                "ru": "Она сделала небольшую <w>пометку</w> на полях книги."
                            }
                        },
                        {
                            "text": "The teacher left a brief <w>notation</w> regarding the student's progress.",
                            "target_lang_translations": {
                                "ru": "Учитель оставил краткую <w>запись</w> об успехах ученика."
                            }
                        }
                    ],
                    "synonyms": [
                        "note",
                        "annotation",
                        "comment",
                        "entry"
                    ],
                    "common_phrases": [
                        "brief notation",
                        "marginal notation",
                        "make a notation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткая заметка или запись информации, часто сделанная на полях документа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запись",
                                "target_lang_sense_clarification": "краткая пометка"
                            },
                            {
                                "target_lang_word": "примечание",
                                "target_lang_sense_clarification": "пояснение к тексту"
                            },
                            {
                                "target_lang_word": "пометка",
                                "target_lang_sense_clarification": "небольшая запись на полях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1bf97e9-694d-3260-9168-d65801fa859f",
                    "sense_definition": "The act, process, or method of representing information by a system of marks, signs, or characters.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "symbolic_systems",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>notation</w> of complex chemical structures requires a specialized set of symbols.",
                            "target_lang_translations": {
                                "ru": "<w>Запись</w> сложных химических структур требует специального набора символов."
                            }
                        },
                        {
                            "text": "Standardized <w>notation</w> of data allows scientists to share results more effectively.",
                            "target_lang_translations": {
                                "ru": "Стандартизированное <w>представление</w> данных позволяет ученым более эффективно обмениваться результатами."
                            }
                        }
                    ],
                    "synonyms": [
                        "representation",
                        "transcription",
                        "coding"
                    ],
                    "common_phrases": [
                        "system of notation",
                        "method of notation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт, процесс или метод представления информации с помощью системы знаков или символов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запись",
                                "target_lang_sense_clarification": "процесс фиксирования"
                            },
                            {
                                "target_lang_word": "записывание",
                                "target_lang_sense_clarification": "действие по сохранению информации"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "способ отображения данных"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
