                            {
                                "example_id": "bfc5edfe-6be4-46f0-9512-fb4bdc18c5b0",
                                "sense_id": "7c6c75a3-6a8a-3454-a210-740fb19559bf",
                                "text": "Beaucoup de ceux-ci étaient devenus amis des Vietnamiens jusque dans la lutte et on les appela, dès la fin du XIXᵉ siècle, des « annamitophiles »."
                            },
                            {
                                "example_id": "5c09ed26-7dbd-438b-8ead-314179410b9d",
                                "sense_id": "7c6c75a3-6a8a-3454-a210-740fb19559bf",
                                "text": "Comme Pennequin en rupture de ban avec son milieu, Pouvourville, annamitophile convaincu, qui fut plus tard le conseiller discret mais influent d'Albert Sarraut, brosse ici un tableau plein d'admiration pour la personnalité de son chef."
                            }
                        ]
