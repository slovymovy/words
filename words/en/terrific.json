    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f15d8877-7f94-3b13-a965-f45b1ebe2cf5",
                    "sense_definition": "Extremely good, excellent, or amazing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "positive_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You look absolutely <w>terrific</w> in that new dress.",
                            "target_lang_translations": {
                                "ru": "Ты выглядишь просто <w>потрясающе</w> в этом новом платье.",
                                "zh": "你穿那件新裙子看起来真是<w>棒极了</w>。"
                            }
                        },
                        {
                            "text": "They did a <w>terrific</w> job renovating the old house.",
                            "target_lang_translations": {
                                "ru": "Они проделали <w>отличную</w> работу по ремонту старого дома.",
                                "zh": "他们在翻修老房子这件事上做得<w>非常出色</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brilliant",
                        "wonderful",
                        "fantastic",
                        "great",
                        "excellent",
                        "amazing"
                    ],
                    "antonyms": [
                        "terrible",
                        "awful",
                        "bad"
                    ],
                    "common_phrases": [
                        "look terrific",
                        "feel terrific",
                        "a terrific job",
                        "terrific news"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно хороший, отличный или удивительный.",
                        "zh": "非常好、极好或令人惊叹的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрясающий",
                                "target_lang_sense_clarification": "производящий сильное впечатление"
                            },
                            {
                                "target_lang_word": "великолепный",
                                "target_lang_sense_clarification": "превосходный, очень хороший"
                            },
                            {
                                "target_lang_word": "отличный",
                                "target_lang_sense_clarification": "очень хорошего качества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极好的",
                                "target_lang_sense_clarification": "形容质量非常高"
                            },
                            {
