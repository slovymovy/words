{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17bccad0-ef1b-3cc8-a336-9b72ac7075e7",
                    "sense_definition": "Fragments of a bomb, shell, or other object thrown out by an explosion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "explosion_fragments",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier was injured by flying <w>shrapnel</w> during the attack.",
                            "target_lang_translations": {
                                "ru": "Солдат был ранен летящими <w>осколками</w> во время атаки."
                            }
                        },
                        {
                            "text": "Doctors carefully removed pieces of <w>shrapnel</w> from the victim's leg.",
                            "target_lang_translations": {
                                "ru": "Врачи осторожно извлекли <w>осколки</w> из ноги пострадавшего."
                            }
                        }
                    ],
                    "synonyms": [
                        "fragments",
                        "splinters"
                    ],
                    "common_phrases": [
                        "flying shrapnel",
                        "pieces of shrapnel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осколки бомбы, снаряда или другого предмета, разлетающиеся при взрыве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осколки",
                                "target_lang_sense_clarification": "при взрыве бомбы или снаряда"
                            },
                            {
                                "target_lang_word": "шрапнель",
                                "target_lang_sense_clarification": "осколки снаряда или бомбы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a458c67-c57d-3f93-a79a-3559be4f4179",
                    "sense_definition": "Scattered fragments or debris from destroyed objects.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "debris",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the dropped glass shattered, sharp <w>shrapnel</w> covered the kitchen floor.",
                            "target_lang_translations": {
                                "ru": "После того как упавший стакан разбился, острые <w>осколки</w> покрыли весь пол кухни."
                            }
                        },
                        {
                            "text": "The dog shredded the box, leaving cardboard <w>shrapnel</w> all over the room.",
                            "target_lang_translations": {
                                "ru": "Собака растерзала коробку, оставив картонные <w>ошмётки</w> по всей комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "debris",
                        "remnants"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used humorously or casually for everyday shattered fragments"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разлетевшиеся мелкие осколки, обломки или мусор от разбитого или разрушенного предмета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осколки",
                                "target_lang_sense_clarification": "разбитого стекла, предметов"
                            },
                            {
                                "target_lang_word": "обрезки",
                                "target_lang_sense_clarification": "мелкие клочки, ошметки"
                            },
                            {
                                "target_lang_word": "ошмётки",
                                "target_lang_sense_clarification": "разорванного материала, картона"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6e44871-c9ce-3327-ab1f-14f1eaa9f5b8",
                    "sense_definition": "Small denomination coins; loose change.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dug through his pockets looking for enough <w>shrapnel</w> to pay for the bus.",
                            "target_lang_translations": {
                                "ru": "Он пошарил по карманам в поисках нужной суммы <w>мелочью</w>, чтобы оплатить проезд на автобусе."
                            }
                        },
                        {
                            "text": "I do not carry cash anymore, just a little <w>shrapnel</w> for the parking meter.",
                            "target_lang_translations": {
                                "ru": "Я больше не ношу с собой наличные, только немного <w>мелочи</w> для паркомата."
                            }
                        }
                    ],
                    "synonyms": [
                        "loose change",
                        "small change"
                    ],
                    "common_phrases": [
                        "pocket shrapnel"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal slang for loose change"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Монеты мелкого достоинства; мелочь в кармане."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мелочь",
                                "target_lang_sense_clarification": "монеты"
                            },
                            {
                                "target_lang_word": "медя́ки",
                                "target_lang_sense_clarification": "мелкие монеты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c761b16-8221-3152-91c0-4389785e2fce",
                    "sense_definition": "A type of artillery shell containing numerous small pellets ejected before impact.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "artillery_shell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Original <w>shrapnel</w> shells were designed to burst in midair over enemy troops.",
                            "target_lang_translations": {
                                "ru": "Оригинальные <w>шрапнельные</w> снаряды были разработаны для разрыва в воздухе над войсками противника."
                            }
                        },
                        {
                            "text": "The army relied heavily on <w>shrapnel</w> artillery during the early months of the conflict.",
                            "target_lang_translations": {
                                "ru": "В первые месяцы конфликта армия активно использовала <w>шрапнельную</w> артиллерию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shrapnel shell"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical military term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Артиллерийский снаряд, содержащий множество мелких пуль (картечин), выбрасываемых в воздухе до удара о землю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шрапнель",
                                "target_lang_sense_clarification": "артиллерийский снаряд"
                            },
                            {
                                "target_lang_word": "шрапнельный снаряд",
                                "target_lang_sense_clarification": "вид снаряда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10899308-814d-30d5-a0b9-912683e32345",
                    "sense_definition": "The small lead or steel balls discharged from an anti-personnel artillery shell.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "artillery_shell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The projectile burst overhead, spraying lead <w>shrapnel</w> across the trench.",
                            "target_lang_translations": {
                                "ru": "Снаряд разорвался над головой, осыпав окоп свинцовой <w>шрапнелью</w>."
                            }
                        },
                        {
                            "text": "Historical accounts described how the <w>shrapnel</w> descended on unprotected infantry.",
                            "target_lang_translations": {
                                "ru": "Исторические свидетельства описывали, как <w>шрапнель</w> обрушивалась на незащищённую пехоту."
                            }
                        }
                    ],
                    "synonyms": [
                        "pellets",
                        "musket balls"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical military term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелкие свинцовые или стальные пули, вылетающие из шрапнельного снаряда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шрапнель",
                                "target_lang_sense_clarification": "пули из шрапнельного снаряда"
                            },
                            {
                                "target_lang_word": "картечь",
                                "target_lang_sense_clarification": "мелкие круглые пули"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "95703254-8685-3280-a018-a6ea66b1510d",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The invention was named after General Henry <w>Shrapnel</w>, who designed the munition.",
                            "target_lang_translations": {
                                "ru": "Изобретение было названо в честь генерала Генри <w>Шрапнеля</w>, который разработал этот боеприпас."
                            }
                        },
                        {
                            "text": "Records indicate that the <w>Shrapnel</w> family resided in Wiltshire for centuries.",
                            "target_lang_translations": {
                                "ru": "Записи свидетельствуют о том, что семья <w>Шрапнель</w> веками проживала в Уилтшире."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "An English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Шрапнель",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}