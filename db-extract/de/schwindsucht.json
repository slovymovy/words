                "senses": [
                    {
                        "sense_id": "d317f204-c341-3d2a-87bf-1376674fe249",
                        "entry_id": "f4b57dd4-30cf-34dd-89e1-b673ecd8ec97",
                        "glosses": [
                            "Lungentuberkulose"
                        ],
                        "tags": [
                            "colloquial",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "20ad0f92-cf21-47e7-a9c9-c852be2f68d2",
                                "sense_id": "d317f204-c341-3d2a-87bf-1376674fe249",
                                "text": "Giuseppe Verdi lässt seine Titelheldin Violetta in der Oper „La Traviata“ an Schwindsucht leiden und sterben."
                            },
                            {
                                "example_id": "4cdd7496-f25d-4a0f-ac3b-3a555a5cd7cb",
                                "sense_id": "d317f204-c341-3d2a-87bf-1376674fe249",
                                "text": "„Denk mal pausenlos daran, daß schon Millionen Menschen an der Schwindsucht gestorben sind.“"
                            },
                            {
                                "example_id": "72be1b81-5782-4945-8b78-565e3e5bd6bb",
                                "sense_id": "d317f204-c341-3d2a-87bf-1376674fe249",
                                "text": "„Sieben Kinder sind ihm an der Schwindsucht gestorben und zum Schluß auch die Frau Hanne, nur meine Mutter blieb übrig, und die war noch nicht ein Jahr alt, als die Großmutter starb.“"
                            },
                            {
                                "example_id": "85331482-0ba6-436a-bc77-6d9af6e151e2",
                                "sense_id": "d317f204-c341-3d2a-87bf-1376674fe249",
                                "text": "„Auch Kafka habe versucht, hier seine Schwindsucht zu heilen, im Frühjahr 1920.“"
                            },
                            {
                                "example_id": "5661eddf-6348-4e06-9136-fcc285a769b4",
                                "sense_id": "d317f204-c341-3d2a-87bf-1376674fe249",
                                "text": "„Zehn Jahre darauf starb sie an Schwindsucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
