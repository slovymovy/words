                "senses": [
                    {
                        "sense_id": "0643360b-1693-3ff8-b590-564a8053fae2",
                        "entry_id": "0a032314-90e9-309e-86f0-8f2a0c3e0cc9",
                        "glosses": [
                            "An ungainly, dull, or stupid person; someone who is lazy, disrespectful, and/or whose beliefs and philosophies clash with those of another."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d0d41cac-0fc3-309e-9e73-107701cd9a90",
                        "entry_id": "0a032314-90e9-309e-86f0-8f2a0c3e0cc9",
                        "glosses": [
                            "A large, muscular, stupid man, especially an athlete."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6acdc800-9586-4b9b-8f71-73fbb4bf3dc3",
                                "sense_id": "d0d41cac-0fc3-309e-9e73-107701cd9a90",
                                "text": "Gary was a hulking meathead who, when he wasn't playing football, was either hunting, fishing or getting drunk and rowdy in some topless bar."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ed5f4f9-f6ea-3be9-9105-4f84e198bb9b",
                        "entry_id": "0a032314-90e9-309e-86f0-8f2a0c3e0cc9",
                        "glosses": [
                            "A member of the Canadian Forces Military Police."
                        ],
                        "tags": [
                            "Canada",
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a98c398-907c-49f5-bf0e-89c45fcfc0c4",
                        "source_entry_id": "0a032314-90e9-309e-86f0-8f2a0c3e0cc9",
                        "source_sense_description": "stupid person",
                        "target_lang_word": "바보",
                        "target_lang_code": "ko",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "바보",
                                "target_lang_code": "ko",
                                "target_senses": [
                                    {
                                        "sense_id": "84f034ab-8fd7-31a4-a479-fe7b0b8f43cf",
                                        "entry_id": "d401da1b-a101-3e9a-ac02-69aa5ea68edf",
                                        "glosses": [
                                            "무엇을 제대로 알지 못하여 보통 사람보다 어리석은 사람을 낮잡아 이르는 말. 흔히 꾸짖거나 또는 친구 사이에 농담으로 쓰이기도 한다."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46f7a161-5899-45a4-86fc-46f08db30ccf",
                                                "sense_id": "84f034ab-8fd7-31a4-a479-fe7b0b8f43cf",
                                                "text": "바보가 따로 있는 것이 아니라 제 할 일을 제대로 챙기지 못하는 사람은 바보라고 한다."
                                            },
                                            {
                                                "example_id": "7f6e3006-118d-44fa-bf25-ff3ff61eb0db",
                                                "sense_id": "84f034ab-8fd7-31a4-a479-fe7b0b8f43cf",
                                                "text": "바보처럼 길거리에서 실실 웃다."
                                            },
                                            {
                                                "example_id": "f4ef110a-1245-4b07-a428-2a103527d117",
                                                "sense_id": "84f034ab-8fd7-31a4-a479-fe7b0b8f43cf",
                                                "text": "그는 친구들 사이에 바보 취급을 당하였다."
                                            },
                                            {
                                                "example_id": "6d30476e-2654-4e94-ac86-9ddc0d4efe8a",
                                                "sense_id": "84f034ab-8fd7-31a4-a479-fe7b0b8f43cf",
                                                "text": "가뜩이나 말 한마디 톡톡히 못한다고 바라보는데 매까지 잠자코 맞는 걸 보면 짜장 바보로 알 게 아닌가."
                                            },
                                            {
                                                "example_id": "fc3706a1-b91e-47d2-91fb-3f28be4ba982",
                                                "sense_id": "84f034ab-8fd7-31a4-a479-fe7b0b8f43cf",
                                                "text": "아까 바위를 기어서 이곳까지 올라오느라고 애쓰던 그런 맹랑한 노력을 하여본 바보가 여 이외에 몇 사람이나 있었을까."
                                            },
                                            {
                                                "example_id": "924879dc-5b34-4e81-8f89-fef2e35eb41f",
                                                "sense_id": "84f034ab-8fd7-31a4-a479-fe7b0b8f43cf",
                                                "text": "이 바보 개들은 복날 개장국을 끓여 먹기 위하여 촌민의 희생이 된다."
                                            },
                                            {
                                                "example_id": "80a5d278-05ec-458d-800a-104e646e8c4a",
                                                "sense_id": "84f034ab-8fd7-31a4-a479-fe7b0b8f43cf",
                                                "text": "그러니 나는 자연히 기운이 죽고 바보같이 되더라."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
