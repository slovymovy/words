                                    {
                                        "sense_id": "b5b0795f-3e77-3ad2-a6a7-1922488d5af9",
                                        "entry_id": "7869950c-f992-3382-bf7f-5eeca1b83292",
                                        "glosses": [
                                            "A pupil who lives at school during term time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fb434f9-d8d4-447e-bc0e-674c821ea1c8",
                                                "sense_id": "b5b0795f-3e77-3ad2-a6a7-1922488d5af9",
                                                "text": "The student body consisted primarily of boarders, except for a few children belonging to the school staff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cb33ecf-e395-3acd-be80-b5693efb2cb2",
                                        "entry_id": "7869950c-f992-3382-bf7f-5eeca1b83292",
                                        "glosses": [
                                            "Someone who pays for meals and lodging in a house rather than a hotel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95069143-e120-4acf-8ba3-91670ad5f0e2",
                                                "sense_id": "4cb33ecf-e395-3acd-be80-b5693efb2cb2",
                                                "text": "When I left for college, my parents took on a boarder in my old room to help defray expenses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcb216d0-53d9-356a-ab16-7b46efc8e735",
                                        "entry_id": "7869950c-f992-3382-bf7f-5eeca1b83292",
                                        "glosses": [
                                            "One who boards a vehicle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9451a631-c138-4a2a-a309-aa217baebd93",
                                                "sense_id": "fcb216d0-53d9-356a-ab16-7b46efc8e735",
                                                "text": "\"Calls to set down only\" sounds more exciting. What station or train staff has the specific duty of repelling would-be boarders? Are the occupants of the train of such exalted main-line status that suburban interlopers are personae non gratae?"
                                            },
                                            {
                                                "example_id": "89d4fa10-38ad-4ae2-ab7b-a0a843b17dab",
                                                "sense_id": "fcb216d0-53d9-356a-ab16-7b46efc8e735",
                                                "text": "I have found holding all doors open solves much of this problem, as late boarders can enter the rear and tag in rather than wait the time it takes to get to the front, particularly if the bus shelter or some other obstacle hinders vision and boarding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdbe5096-f31a-3ea2-8211-071cb365fba9",
                                        "entry_id": "7869950c-f992-3382-bf7f-5eeca1b83292",
                                        "glosses": [
                                            "A sailor attacking an enemy ship by boarding her, or one repelling such attempts by an enemy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c002c81-1b9d-47db-a892-c947ad897c09",
                                                "sense_id": "cdbe5096-f31a-3ea2-8211-071cb365fba9",
                                                "text": "The captain shouted at the crew to grab arms and repel boarders."
                                            },
                                            {
                                                "example_id": "6941358b-5b2a-4c9e-91ab-8b26721bee31",
                                                "sense_id": "cdbe5096-f31a-3ea2-8211-071cb365fba9",
                                                "text": "Sensors show inbound Covenant boarding craft. Stand by to repel boarders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14d40719-add5-3284-a6f3-2a5a49ee9c05",
                                        "entry_id": "7869950c-f992-3382-bf7f-5eeca1b83292",
                                        "glosses": [
                                            "Someone who takes part in a boardsport, such as surfing or snowboarding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60447e5d-d102-4dd9-87a4-824d5088c3ae",
                                                "sense_id": "14d40719-add5-3284-a6f3-2a5a49ee9c05",
                                                "text": "A group of boarders swept past us as we climbed the side of the ski run."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bb19937-cfea-36fa-a750-ba352521ec85",
                                        "entry_id": "7869950c-f992-3382-bf7f-5eeca1b83292",
                                        "glosses": [
                                            "Someone who takes part in a boardsport, such as surfing or snowboarding.",
                                            "Clipping of skateboarder."
                                        ],
                                        "tags": [
