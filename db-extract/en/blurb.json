                        "entry_id": "03989261-3cb9-3c28-a8f5-7a3c38be9a6c",
                        "glosses": [
                            "A short description of a book, film, or other work, written and used for promotional purposes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf327bf4-bf78-4189-8489-63f9b7ebd815",
                                "sense_id": "23e34656-5ada-3524-881f-3c29c3f1a802",
                                "text": "In a few weeks, blurbs would come back; a few, or many, depending on the book. There were certain writers we knew were always good for a blurb: Louis Untermeyer would always come through — poetry, fiction, humor — whatever, he'd send a well‐turned commendation."
                            }
                        ]
                    }
