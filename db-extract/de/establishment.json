                    },
                    {
                        "form_id": "377ad48b-8ccf-4ab2-82aa-10ae9a667c0b",
                        "entry_id": "93baa4e5-99fe-37a9-8d3e-05450938b932",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Establishments"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3f39039-c308-3e90-b240-0815a45a171a",
                        "entry_id": "93baa4e5-99fe-37a9-8d3e-05450938b932",
                        "glosses": [
                            "soziale Schicht der Gesellschaft, die gut situiert/etabliert ist und in vielen Bereichen Einfluss hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2adc3285-b893-4a04-b0b8-7c72478aba50",
                                "sense_id": "a3f39039-c308-3e90-b240-0815a45a171a",
                                "text": "„In Zeiten des triumphierenden Populismus und der Angriffe auf das politische Establishment macht man sich lieber ganz klein, wenn es ums Essen geht.“"
                            },
                            {
                                "example_id": "0e09d75b-ef8d-4213-b365-a03d80e6e3b7",
                                "sense_id": "a3f39039-c308-3e90-b240-0815a45a171a",
                                "text": "„Protest gehörte nun zum guten Ton, bis hinein ins sogenannte Establishment, Opern- und Theaterpublikum.“"
                            },
                            {
                                "example_id": "e7a21f2d-3ab1-49f4-a087-dfbc5ebbf041",
                                "sense_id": "a3f39039-c308-3e90-b240-0815a45a171a",
                                "text": "„Die Beschäftigung der Bhuttos und Sharifs mit dem jeweils anderen Clan und mit dem militärischen Establishment führte zu politischer Stagnation und wirtschaftlichem Niedergang.“"
                            },
                            {
                                "example_id": "9643954c-14de-4400-81b4-b390c2f20dcd",
                                "sense_id": "a3f39039-c308-3e90-b240-0815a45a171a",
                                "text": "„Seine sorgsam gepflegten Beziehungen zum britischen Establishment ermöglichten es ihm, einen ebenso gewagten wie visionären Plan in die Tat umzusetzen, mit dem er die Macht des Empire in die Gebiete nördlich des Limpopo ausdehnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
