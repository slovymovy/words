                "senses": [
                    {
                        "sense_id": "7e55e968-4bd3-3c46-8374-bd4b1ec3257b",
                        "entry_id": "84367715-6108-39e1-88bb-97d51d925b6c",
                        "glosses": [
                            "Geflecht/Gitter aus metallenem Draht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8815deb8-9ef3-4f8b-8317-a02201319751",
                                "sense_id": "7e55e968-4bd3-3c46-8374-bd4b1ec3257b",
                                "text": "Experten raten, in Hochbeete unten zum Schutz gegen Wühlmäuse ein Drahtgitter einzulegen."
                            },
                            {
                                "example_id": "4088740f-dab6-46e9-b926-8cfa574707ea",
                                "sense_id": "7e55e968-4bd3-3c46-8374-bd4b1ec3257b",
                                "text": "[Gärtnern:] „Damit unerwünschte Eindringlinge wie Wühlmäuse und Maulwürfe keinen Schaden im Hochbeet anrichten, sollte der Boden mit engmaschigem Drahtgitter ausgelegt werden.“"
                            },
                            {
                                "example_id": "60ca287b-bace-4f02-9fe0-9a546a73cf03",
                                "sense_id": "7e55e968-4bd3-3c46-8374-bd4b1ec3257b",
                                "text": "[Gärtnern: Frostschutz für empfindliche Stauden] „Laub lässt sich zusätzlich auch als Schutz für kälteempfindliche Stauden einsetzen. Um die Pflanze herum vier Haltestäbe in den Boden rammen und an den Stäben ein Drahtgeflecht befestigen. Der Zwischenraum zwischen Staude und Drahtgitter wird mit Laub befüllt.“"
                            },
                            {
                                "example_id": "2be3bf79-49f1-49d7-8299-e7a28f4f0435",
                                "sense_id": "7e55e968-4bd3-3c46-8374-bd4b1ec3257b",
                                "text": "[Gärtnern:] „[…] die Kletterpflanze [braucht] eine Rankhilfe mit dünnen Drähten oder ein Drahtgitter, da sie sich nur mit ihren zarten Blattranken festhalten und nach oben wachsen kann.“"
                            },
                            {
                                "example_id": "d7558bfa-b97e-4833-8ff9-87f852ff91e0",
                                "sense_id": "7e55e968-4bd3-3c46-8374-bd4b1ec3257b",
                                "text": "[Irakisches Gefängnis:] „Die Mauern waren schätzungsweise 15 Meter hoch, zwischen ihnen war Drahtgitter gespannt.“"
                            },
                            {
                                "example_id": "4ea58ad5-6823-42fe-9e19-6386986a4b23",
                                "sense_id": "7e55e968-4bd3-3c46-8374-bd4b1ec3257b",
                                "text": "„Die beiden Buben bauen in der Werkstatt des Steigerwaldzentrums ein Insektenhotel. Auf eine Holzscheibe packen sie Moos, Schafwolle, Tannenzapfen und kleine Hölzchen. Dann nageln sie ein Drahtgitter darüber.“"
                            },
                            {
                                "example_id": "8486ef4e-ce77-4d1a-bb55-3a55cd1434d5",
                                "sense_id": "7e55e968-4bd3-3c46-8374-bd4b1ec3257b",
                                "text": "[Insektenhotel:] Um die Insekten vor Vögeln zu schützen, bespannen Sie Ihr Insektenhotel mit einem Drahtgitter."
                            },
                            {
                                "example_id": "45b395f1-d230-4e56-8f63-f65b258200f2",
                                "sense_id": "7e55e968-4bd3-3c46-8374-bd4b1ec3257b",
                                "text": "„Weiter Egau aufwärts am Härtsfeldsee mussten die Hochwasserschutzdämme mit Drahtgittern geschützt werden, damit sich der Biber nicht durch sie hindurch gräbt.“"
                            },
                            {
                                "example_id": "3b4f8bfd-d0da-4500-bd61-911af13a4074",
                                "sense_id": "7e55e968-4bd3-3c46-8374-bd4b1ec3257b",
                                "text": "„Alarmplane macht Lkw sicherer – Planenschlitzer machen Spediteuren zu schaffen. Dagegen hat sich Student Andreas Gießler etwas einfallen lassen. Er hat die Lkw-Plane mit einem Drahtgitter versehen. Wird es verletzt, geht der Alarm los.“"
                            },
                            {
                                "example_id": "60ad5509-398a-401b-8b4b-ed6028534c7d",
                                "sense_id": "7e55e968-4bd3-3c46-8374-bd4b1ec3257b",
                                "text": "[Grenzzäune in Ceuta und Melilla:] „Ein dritter, wiederum sechs Meter hoher Zaun verfügt über ein Antikletter-System aus dreizehn mal dreizehn Millimeter großen Maschen, die ein Festhalten unmöglich machen sollen. Die Drahtgitter sind mit einem Alarm gekoppelt […].“"
                            },
                            {
                                "example_id": "7c4f7e52-04ef-40c0-9671-f40719dd4008",
                                "sense_id": "7e55e968-4bd3-3c46-8374-bd4b1ec3257b",
                                "text": "„Shiva-Höhlentempel liegen direkt im Felsen nebenan. Sie weisen gut erhaltene Felsreliefs auf. Leider sind sie in der Regel abgesperrt, so dass man durch das enge Drahtgitter schauen muss.“"
                            },
                            {
                                "example_id": "f20c9f5f-8df3-457b-a08c-838e9d2f9c7b",
                                "sense_id": "7e55e968-4bd3-3c46-8374-bd4b1ec3257b",
                                "text": "[Mikrowelle:] „Die Metallwände des Gehäuses und ein Drahtgitter in der Tür sorgen dafür, dass die erzeugte Strahlung im Inneren bleibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
