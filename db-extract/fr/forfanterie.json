                    },
                    {
                        "translation_id": "354c7dab-b3ec-42ba-b5f6-48da301ee2f9",
                        "source_entry_id": "956c3fb3-4376-3550-ae89-9bcffed1b4b1",
                        "source_sense_id": "a9805aae-9b02-3bd6-9f71-c995190daf43",
                        "source_sense_description": "Propension à étaler ses vertus",
                        "target_lang_word": "opschepperij",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opschepperij",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ca3fee19-7f0a-3267-9c90-fb6d5385de0d",
                                        "entry_id": "2364e749-5d10-3f18-9a67-c73bc7e31e75",
                                        "glosses": [
                                            "je beter voordoen dan je eigenlijk bent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d598130-959a-4071-a19c-68721a08abe7",
                                                "sense_id": "ca3fee19-7f0a-3267-9c90-fb6d5385de0d",
                                                "text": "Al zijn geweldige praatjes waren niets meer dan opschepperij."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8866559-ea3f-4b82-a06c-3ce026f5d3ce",
                        "source_entry_id": "956c3fb3-4376-3550-ae89-9bcffed1b4b1",
                        "source_sense_id": "a9805aae-9b02-3bd6-9f71-c995190daf43",
                        "source_sense_description": "Propension à étaler ses vertus",
                        "target_lang_word": "snoeverij",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snoeverij",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fa7c7963-f9f1-33cd-b112-e14ddfce6f7c",
                                        "entry_id": "3d8af12a-6427-3c8b-8ff2-aee0e5579689",
                                        "glosses": [
                                            "je beter, groter of sterker voordoen dan je eigenlijk bent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a18036c-404a-42e3-9b2b-064a2c449d78",
                                                "sense_id": "fa7c7963-f9f1-33cd-b112-e14ddfce6f7c",
                                                "text": "Hij liet zich weer niet verleiden tot gedurfde uitspraken. Fred Rutten houdt niet van bluffen. Snoeverij is hem vreemd, maar de 2-1 overwinning op achtervolger SC Heerenveen bracht zijn ploeg weer op een hoger plan in de pikorde van de eredivisie."
                                            },
                                            {
                                                "example_id": "9dc13230-78cb-4ad6-821c-e29c3a2d05da",
                                                "sense_id": "fa7c7963-f9f1-33cd-b112-e14ddfce6f7c",
                                                "text": "Ik zag eerste ontmoetingen voor me, schuchterheid en snoeverij, eenzaamheid en verlangen, lange levens met heel wat tegenslagen. HP de Tijd 0/06"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "854b2a2a-a169-498a-bc8d-c608e52a29bb",
                        "source_entry_id": "956c3fb3-4376-3550-ae89-9bcffed1b4b1",
                        "source_sense_id": "a9805aae-9b02-3bd6-9f71-c995190daf43",
                        "source_sense_description": "Propension à étaler ses vertus",
                        "target_lang_word": "grootspraak",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grootspraak",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c21e5fa4-789c-3b68-8587-bc9818894c38",
                                        "entry_id": "f279a662-d9d6-3526-b62f-0c8416c49ff6",
                                        "glosses": [
                                            "opschepperij, bluf, dikdoenerij, jezelf belangrijker maken dan je bent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b26c476-82f0-4c8d-a624-3814aeabac15",
                                                "sense_id": "c21e5fa4-789c-3b68-8587-bc9818894c38",
                                                "text": "De visser vertelde in beeldende taal over zijn gevangen vis van meer dan 1 meter lengte maar het bleek alleen maar grootspraak te zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1f73453-df0a-4d00-a987-b8f0561776f4",
                        "source_entry_id": "956c3fb3-4376-3550-ae89-9bcffed1b4b1",
                        "source_sense_id": "a9805aae-9b02-3bd6-9f71-c995190daf43",
                        "source_sense_description": "Propension à étaler ses vertus",
                        "target_lang_word": "dikdoenerij",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dikdoenerij",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f4d0630f-ab8a-3669-a0cf-be97f0e95970",
                                        "entry_id": "3f11c222-ac6a-3272-95d3-d27d893ab36e",
                                        "glosses": [
                                            "op een manier praten of handelen waarbij je jezelf belangrijker voordoet dan je eigenlijk bent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67d1b525-e479-449b-bc11-4cf2fe6d773d",
                                                "sense_id": "f4d0630f-ab8a-3669-a0cf-be97f0e95970",
                                                "text": "Het is Bouwmeester ten voeten uit. Ze zit het liefst op het water in haar bootje, ver weg van alle drukte en dikdoenerij. Trainen, racen, wedstrijden winnen. 'Ik wil de wereld domineren', zo luidt haar motto."
                                            },
                                            {
                                                "example_id": "76f7ff1c-0caf-4e0b-95b5-878ad981c5c1",
                                                "sense_id": "f4d0630f-ab8a-3669-a0cf-be97f0e95970",
                                                "text": "De Venezolaanse president insinueert al langer dat de VS van plan zijn hem uit zijn macht te ontzetten, maar tot dusver gingen zijn beschuldigingen niet verder dan de gebruikelijke grootspraak en dikdoenerij."
                                            },
                                            {
                                                "example_id": "32701a79-8574-454f-a29a-57c08495d5d2",
                                                "sense_id": "f4d0630f-ab8a-3669-a0cf-be97f0e95970",
                                                "text": "Parra, die zichzelf een ’antipoëet’ noemde om afstand te nemen van literaire dikdoenerij, geldt als een van de belangrijkste dichters van de 20e eeuw in Zuid-Amerika."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
