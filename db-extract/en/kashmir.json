                    {
                        "translation_id": "f854a135-9220-4860-b0a2-d842d98eccbd",
                        "source_entry_id": "19cba338-da0f-3b8e-859e-98d9c75ce418",
                        "source_sense_description": "region",
                        "target_lang_word": "Kaschmir",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaschmir",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4bb510a-a336-32a5-8b77-f8120beeae57",
                                        "entry_id": "7a0f2254-70ee-3880-8628-2015a8371751",
                                        "glosses": [
                                            "aus Ziegenhaar gewonnene Wolle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2306d142-5b69-46c0-9fc5-7ccb61db66b5",
                                                "sense_id": "b4bb510a-a336-32a5-8b77-f8120beeae57",
                                                "text": "Der Pullover ist aus Kaschmir."
                                            },
                                            {
                                                "example_id": "5f1d7e96-2816-4426-8137-16b4747b1dab",
                                                "sense_id": "b4bb510a-a336-32a5-8b77-f8120beeae57",
                                                "text": "„Denn Kaschmir ist unendlich weich, leicht, schmeichelt der Haut und ist wie eine sanfte Umarmung, weswegen manche Frauen Kaschmirschals bei Abwesenheit des Liebsten auch gerne als Streichelersatz nutzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kaschmir",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96f1e51a-3a7c-318f-b869-a64067b7a3c9",
                                        "entry_id": "892f8363-c9e4-34f5-b988-d0bb21d103d3",
                                        "glosses": [
                                            "Region im Grenzgebiet von Indien und Pakistan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15c250e7-a368-4d3e-bdd5-99a317e1cc1f",
                                                "sense_id": "96f1e51a-3a7c-318f-b869-a64067b7a3c9",
                                                "text": "„Eine Sonderstellung nahmen auf dem Gebiet des heutigen Pakistan die Kleinreiche ein, denen die Briten ihre interne Autonomie beließen: In erster Linie ist hier Kaschmir zu nennen, dessen Bevölkerung zu über 90 Prozent muslimisch ist, das aber von einem hinduistischen Maharadscha beherrscht wurde.“"
                                            },
                                            {
                                                "example_id": "7134164f-264f-4e0c-b309-0224ebc570c7",
                                                "sense_id": "96f1e51a-3a7c-318f-b869-a64067b7a3c9",
                                                "text": "„Im letzten Moment beschloss Neschkow, mit uns nach Kaschmir und Tadschikistan zu kommen.“"
                                            },
                                            {
                                                "example_id": "a54ac574-7222-4d27-a3c4-60d631cc3039",
                                                "sense_id": "96f1e51a-3a7c-318f-b869-a64067b7a3c9",
                                                "text": "„Wahrscheinlich ist er hellhätug und führt seine Herkunft auf Zentralasien über Kaschmir zurück.“"
                                            },
                                            {
                                                "example_id": "c7ff4fd7-aadf-4bd5-bbfa-59fcd3d40df8",
                                                "sense_id": "96f1e51a-3a7c-318f-b869-a64067b7a3c9",
                                                "text": "„Das Einzige, was ihm in Amerika wirklich gefallen hatte, waren die Rocky Mountains gewesen, deren schroffe Gipfel in dünner Luft ihn an seine Heimat in den Bergen von Kaschmir erinnert hatten.“"
                                            },
                                            {
                                                "example_id": "6501b0ed-bf98-42e4-bc4e-879f8e4b631a",
                                                "sense_id": "96f1e51a-3a7c-318f-b869-a64067b7a3c9",
                                                "text": "„Um 1761 besiegte Ahmed Schah Durrani die Hindu Mahrattas, eroberte den Thron in Delhi und Kaschmir und schuf damit das erste afghanische Reich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6956ab79-f3b9-46ca-b9e6-26f02f6569b0",
