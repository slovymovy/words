                        "glosses": [
                            "Faire perdre son caractère axiomatique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb6caa51-998c-4931-9ae7-cc5a4ab2df51",
                                "sense_id": "f112ece0-e333-30a6-bdf4-b322e91cd08a",
                                "text": "Il faut désaxiomatiser la science dans l’enseignement."
                            },
                            {
                                "example_id": "189411eb-cd90-402e-966a-bc530cd56cd1",
                                "sense_id": "f112ece0-e333-30a6-bdf4-b322e91cd08a",
                                "text": "On pourrait désaxiomatiser cette seconde définition de la manière suivante : la différentielle d’une fonction est la plus simple fonction de l’accroissement de la variable qui puisse représenter, approximativement, l’accroissement de la fonction."
                            }
                        ]
