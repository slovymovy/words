                "senses": [
                    {
                        "sense_id": "ebc6c329-fcf2-3872-9298-94a99f1d973c",
                        "entry_id": "c39e04a4-f63b-3fed-a67a-65229df949ac",
                        "glosses": [
                            "Any fly of the taxonomic order Diptera."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9e5911e-c4e3-4405-ae9a-a274ca86dbf8",
                                "sense_id": "ebc6c329-fcf2-3872-9298-94a99f1d973c",
                                "text": "The next species of Diptera are two female specimens of Trichomyia, bred about the end of May, following which is a dipteron new to the British list, Brachycoma erratica, Mgn., of the family Tachinidæ, kindly identified with the other Diptera of our cherry stump, by Dr. Meade, of Bradford, who has fully described this new species on page 110 in the May number of The Entomologists Monthly Magazine, 1894."
                            },
                            {
                                "example_id": "4cc26ac1-70e8-4342-90e8-1589e6760f82",
                                "sense_id": "ebc6c329-fcf2-3872-9298-94a99f1d973c",
                                "text": "A larval dipteron which has been interpreted as a roundworm."
                            },
                            {
                                "example_id": "e00dbb0b-37f1-466e-bd0a-6e4d76c961d8",
                                "sense_id": "ebc6c329-fcf2-3872-9298-94a99f1d973c",
                                "text": "This gall was brought to me ten years ago. From my notes I gather it was probably made by a dipteron, but I failed to rear the flies."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
