{
    "word_family": [
        "interest",
        "interesting",
        "interestingly",
        "disinterest",
        "disinterested",
        "uninteresting",
        "uninterested"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0b74b9f5-019a-389c-9768-afd4fe2cb343",
                    "sense_definition": "Having or showing curiosity or concern about something or someone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am very <w>interested</w> in learning how to cook Italian food.",
                            "target_lang_translations": {
                                "ru": "Я очень <w>заинтересован</w> в том, чтобы научиться готовить итальянские блюда.",
                                "zh": "我对学习如何烹饪意大利菜非常<w>感兴趣</w>。"
                            }
                        },
                        {
                            "text": "She was <w>interested</w> to know why the store was closed so early.",
                            "target_lang_translations": {
                                "ru": "Ей было <w>интересно</w> узнать, почему магазин закрылся так рано.",
                                "zh": "她很<w>想知道</w>为什么商店关门这么早。"
                            }
                        }
                    ],
                    "antonyms": [
                        "uninterested",
                        "indifferent"
                    ],
                    "common_phrases": [
                        "interested in",
                        "very interested",
                        "interested to know"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий интерес или любопытство к чему-либо или кому-либо.",
                        "zh": "对某人或某事感到好奇或关心。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заинтересованный",
                                "target_lang_sense_clarification": "проявляющий любопытство"
                            },
                            {
                                "target_lang_word": "увлечённый",
                                "target_lang_sense_clarification": "сильно интересующийся чем-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感兴趣",
                                "target_lang_sense_clarification": "对某事物有兴趣"
                            },
                            {
                                "target_lang_word": "有兴趣",
                                "target_lang_sense_clarification": "表示具有某种兴趣"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b19fe71-77fe-364e-a950-947a7309a1b2",
                    "sense_definition": "Having a financial stake or personal involvement in a matter, often implying a lack of impartiality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract must be signed by all <w>interested</w> parties before work can begin.",
                            "target_lang_translations": {
                                "ru": "Контракт должен быть подписан всеми <w>заинтересованными</w> сторонами до начала работ.",
                                "zh": "在工作开始前，合同必须由所有<w>利害相关</w>方签署。"
                            }
                        },
                        {
                            "text": "An <w>interested</w> observer cannot provide a truly unbiased opinion on the conflict.",
                            "target_lang_translations": {
                                "ru": "<w>Заинтересованный</w> наблюдатель не может высказать по-настоящему непредвзятое мнение о конфликте.",
                                "zh": "一个<w>利害相关</w>的观察者无法对这场冲突提供真正公正的意见。"
                            }
                        }
                    ],
                    "antonyms": [
                        "disinterested"
                    ],
                    "common_phrases": [
                        "interested party",
                        "interested parties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий личную выгоду, финансовую долю или иное участие в каком-либо деле.",
                        "zh": "在某事中拥有经济利益或个人牵连，通常暗示缺乏公正性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заинтересованный",
                                "target_lang_sense_clarification": "имеющий корыстный интерес или долю"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "利害相关",
                                "target_lang_sense_clarification": "指与某事有直接利益关系"
                            },
                            {
                                "target_lang_word": "相关",
                                "target_lang_sense_clarification": "指涉及特定利益的各方"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "267eb5a2-1e82-39a3-8075-49c19b23a9f1",
                    "sense_definition": "Simple past and past participle of <w>interest</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The history of the ancient castle <w>interested</w> the tourists greatly.",
                            "target_lang_translations": {
                                "ru": "История древнего замка очень <w>заинтересовала</w> туристов.",
                                "zh": "这座古城堡的历史极大地<w>吸引</w>了游客。"
                            }
                        },
                        {
                            "text": "Nothing on the menu <w>interested</w> him, so he just ordered a coffee.",
                            "target_lang_translations": {
                                "ru": "Ничто в меню его не <w>заинтересовало</w>, поэтому он просто заказал кофе.",
                                "zh": "菜单上的东西都没能<w>引起</w>他的兴趣，所以他只点了一杯咖啡。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола interest (интересовать).",
                        "zh": "使某人产生兴趣（动词 interest 的过去式或过去分词）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заинтересовал",
                                "target_lang_sense_clarification": "вызвал интерес (прошедшее время)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……感兴趣",
                                "target_lang_sense_clarification": "引起某人的兴趣"
                            },
                            {
                                "target_lang_word": "吸引",
                                "target_lang_sense_clarification": "引起注意或兴趣"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}