                ],
                "senses": [
                    {
                        "sense_id": "7e17603b-d353-366a-92ea-95059206c898",
                        "entry_id": "cc2ee5f6-706a-3644-b8b9-748176b77ec3",
                        "glosses": [
                            "Partie du vêtement de l’homme qui le couvre depuis la ceinture jusqu’aux genoux et qui était retenu par une ceinture."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2f3f7865-d2e1-411d-9418-673334c83db1",
                                "sense_id": "7e17603b-d353-366a-92ea-95059206c898",
                                "text": "Il portait un élégant pourpoint garni de zibeline, un haut-de-chausses très ample et des souliers fendus dans toute leur longueur."
                            },
                            {
                                "example_id": "2cca935b-f26e-4418-b501-baf7935ef112",
                                "sense_id": "7e17603b-d353-366a-92ea-95059206c898",
                                "text": "Le premier sur lequel tombait la lumière était un seigneur superbement vêtu d’un haut-de-chausses et d’un justaucorps écarlate rayé d’argent"
                            },
                            {
                                "example_id": "9fa5c62d-62d8-4847-9160-828c65957240",
                                "sense_id": "7e17603b-d353-366a-92ea-95059206c898",
                                "text": "Un haut-de-chausses large et flottant ne lui tombait qu’aux genoux, et son étoffe jaune et rayée de rouge était ornée en bas de rubans bleus."
                            }
                        ]
                    },
                    {
                        "sense_id": "6440c422-bf37-3f76-b9f0-45f36f26faa9",
                        "entry_id": "cc2ee5f6-706a-3644-b8b9-748176b77ec3",
                        "glosses": [
                            "Genre monospécifique d'oiseau-mouche de la sous-famille des trochilinés (e.g. colibris, etc.), commun dans les forêts tropicales andines clairsemées de tout le nord-ouest de l'Amérique du Sud, caractérisé par ses énormes \\\"jambières\\\", sortes de manchons ébouriffés de plumes blanches duveteuses qui lui recouvrent entièrement les cuisses, ainsi que par ses deux longues rectrices externes dépourvues de barbes sur presque toute leur longueur, à l'exception de leur extrémité distale, qui est rigide, pourvue de barbes, et forme ainsi une sorte de raquette."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21e50363-11c5-4fec-9c16-71f9f94efd76",
                        "source_entry_id": "cc2ee5f6-706a-3644-b8b9-748176b77ec3",
                        "source_sense_description": "vêtement",
                        "target_lang_word": "Breeches",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Breeches",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "65d42356-5a5a-37f0-b920-ac18cde17e76",
                                        "entry_id": "d9dc42b1-7773-32ba-8b85-9907cb484f0b",
                                        "glosses": [
                                            "nicht ganz lange Hose, oben weit geschnitten, vom Knie an eng anliegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bfe21ff-5672-4929-a77f-06c4314c9dba",
                                                "sense_id": "65d42356-5a5a-37f0-b920-ac18cde17e76",
                                                "text": "„Er stieg aus dem Bett, zog Breeches an und Schlappen und rasierte sich.“"
                                            },
                                            {
                                                "example_id": "29aaa4f4-93fe-4d2c-95df-66f9e4bc0ac5",
                                                "sense_id": "65d42356-5a5a-37f0-b920-ac18cde17e76",
                                                "text": "„Seine Breeches, seine weißen Leinenschuhe mit Gummisohlen und sein forsch über die Achsel geworfener Regenmantel drückten Jugendlichkeit aus.“"
                                            },
                                            {
                                                "example_id": "14afb38e-fb8a-4495-ac2a-1fbeda425fac",
                                                "sense_id": "65d42356-5a5a-37f0-b920-ac18cde17e76",
                                                "text": "„Beherzte Frauen gingen, prall in karierte Breeches gehüllt, vorüber, ohne Scham zu empfinden, aber desto mehr hinterlassend.“"
                                            },
                                            {
                                                "example_id": "8fd17866-8b1a-4b31-ae61-1b3260bd285f",
                                                "sense_id": "65d42356-5a5a-37f0-b920-ac18cde17e76",
                                                "text": "„Unter den vielen Blauuniformierten entdecke ich jetzt auch einen in feldgrauem Waffenrock und scharfen Breeches: kein Mann vom Heer, sondern einer mit einem silbernen Totenkopf an der Mütze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
