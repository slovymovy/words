                            {
                                "example_id": "9994582c-8cae-46f6-85a2-3e0a3cef14f6",
                                "sense_id": "188485c9-3224-3982-b7ce-b6b8a2ac3a69",
                                "text": "A trois heures et demie on apporte encore un potage aux herbes ; le mardi et le jeudi cette liqueur est remplacée par un platras de pommes de terre ou de haricots."
                            },
                            {
                                "example_id": "eabab622-604e-4e28-bc3f-26cbd0d67815",
                                "sense_id": "188485c9-3224-3982-b7ce-b6b8a2ac3a69",
                                "text": "Je jetai un coup d'œil à Angus, qui, parfaitement étranger à notre conversation, venait de se faire servir un plâtras ⁽ˢⁱᶜ⁾ de purée en plus de sa viande."
                            },
                            {
                                "example_id": "fa9a2ac7-ee72-4032-85ee-7b284b2f739c",
                                "sense_id": "188485c9-3224-3982-b7ce-b6b8a2ac3a69",
                                "text": "… et qui consistait en un plâtras ⁽ˢⁱᶜ⁾ de pommes de terre baignant dans une sauce pesante, à la limite de l'écœurement.,"
                            }
                        ]
                    }
