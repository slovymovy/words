                            },
                            {
                                "target_lang_word": "survival",
                                "target_lang_sense_clarification": "continued existence, especially in difficult conditions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93e1bae5-bb7c-3518-888f-e6d5caf572b4",
                    "sense_definition": "Odrębna jednostka, istota, przedmiot lub zjawisko, które istnieje samodzielnie (często w kontekście filozoficznym, prawnym lub fantastycznym).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "entity_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tej powieści fantasy występują magiczne <byty> o potężnych mocach.",
                            "target_lang_translations": {
                                "ru": "В этом фэнтезийном романе встречаются магические <сущности>, обладающие могущественными силами.",
                                "en": "In this fantasy novel, there are magical <w>beings</w> with powerful abilities."
                            }
                        },
                        {
                            "text": "Z punktu widzenia prawa spółka akcyjna jest traktowana jako odrębny <byt> prawny.",
                            "target_lang_translations": {
                                "ru": "С точки зрения закона акционерное общество рассматривается как отдельный правовой <субъект>.",
                                "en": "From a legal point of view, a joint-stock company is treated as a separate legal <w>entity</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "istota",
                        "twór",
                        "jednostka",
                        "podmiot"
                    ],
                    "common_phrases": [
                        "byt prawny",
                        "byt niezależny",
                        "byt absolutny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная единица, существо или явление, существующее самостоятельно (часто в философском, юридическом или фантастическом контексте).",
                        "en": "A distinct unit, being, object, or phenomenon that exists independently (often in philosophical, legal, or fantasy contexts)."
                    },
                    "translations": {
