                ],
                "senses": [
                    {
                        "sense_id": "a4a7c0ea-5bdf-3f2f-981c-5e6fedccfbd3",
                        "entry_id": "b56cf78d-3c7b-377b-a5a5-61473741d92a",
                        "glosses": [
                            "leichte, ärmellose Weste, die speziell fürs Laufen entwickelt wurde und entweder als funktionale Bekleidung oder als praktische Ausrüstung zum Transport kleiner Gegenstände (wie Trinkflaschen) dient"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "7955064d-9173-47da-a690-d8f49d03b51f",
                                "sense_id": "a4a7c0ea-5bdf-3f2f-981c-5e6fedccfbd3",
                                "text": "„Das hatte schon irgendwie ein super Timing, denn erstmals in diesem Jahr war ich wieder mit Kopftuch und eben der Laufweste unterwegs.“"
                            },
                            {
                                "example_id": "d0078d27-170a-437a-8f36-0fec49875c12",
                                "sense_id": "a4a7c0ea-5bdf-3f2f-981c-5e6fedccfbd3",
                                "text": "„Die Laufweste mit Nylon-Reißverschluss vorne ist für eine eng anliegende Passform konzipiert und verwendet superreflektierende Materialien, um Ihre Sicherheit im Dunkeln zu gewährleisten.“"
                            },
                            {
                                "example_id": "294394ce-5bcf-4c9c-9efc-6f035202a5e5",
                                "sense_id": "a4a7c0ea-5bdf-3f2f-981c-5e6fedccfbd3",
                                "text": "„Vom üblichen Laufrucksack mit Stauraum über spezielle Trinkrucksäcke bis zur leichten Laufweste, alle Modelle sind auch speziell in Damenausführung erhältlich.“"
                            },
                            {
                                "example_id": "63447211-0c32-4270-97dd-d580f4466bbf",
                                "sense_id": "a4a7c0ea-5bdf-3f2f-981c-5e6fedccfbd3",
                                "text": "„Zusätzlich wurde die warme Laufweste mit seitlichen Zippertaschen und reflektierenden Paspeln ausgestattet.“"
                            },
                            {
                                "example_id": "78f20e36-2673-4756-af2e-756599f04a46",
                                "sense_id": "a4a7c0ea-5bdf-3f2f-981c-5e6fedccfbd3",
                                "text": "„Besonders gern mag ich meine Laufweste von Gore Wear*, die nicht nur superleicht und dünn ist, sondern auch atmungsaktiv und eben windabweisend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
