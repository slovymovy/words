                        "examples": [
                            {
                                "example_id": "35917efc-a7a2-41a0-ac61-246de18b9ffe",
                                "sense_id": "2eb01b41-d833-326b-80d5-6187fa509689",
                                "text": "Pêcher à la traine."
                            },
                            {
                                "example_id": "db0b2fb5-0ce2-4c7f-95da-2f900fd2adc3",
                                "sense_id": "2eb01b41-d833-326b-80d5-6187fa509689",
                                "text": "Des perdreaux qui sont en traine, des perdreaux qui ne peuvent pas encore voler, ni se séparer de leur mère."
                            },
                            {
                                "example_id": "2caeb885-252f-4dc4-9254-f23153a3e5ff",
                                "sense_id": "2eb01b41-d833-326b-80d5-6187fa509689",
                                "text": "Un bateau qui est à la traine, un bateau amarré à l’arrière d’un bâtiment et que celui-ci traine dans sa marche."
                            }
                        ]
                    },
