                        "source_sense_id": "6d750d44-9c83-3fe2-8849-1e18a89a1e17",
                        "source_sense_description": "Arbeit, zu der man von jemandem unter Strafandrohung gezwungen wird",
                        "target_lang_word": "forced labor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forced labor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25cb36e3-cb39-3e67-9678-4c84c26ec92e",
                                        "entry_id": "bf2831af-89ba-3024-a044-57cb0d37d7a6",
                                        "glosses": [
                                            "Work which one is compelled to perform against one's will, especially in a condition of involuntary servitude as a prisoner or slave."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1780cf8e-2ccf-413a-bb63-a7935c6a8b3d",
                                                "sense_id": "25cb36e3-cb39-3e67-9678-4c84c26ec92e",
                                                "text": "The power which the government possesses, by means of forced labour, of at once opening good roads throughout the country, has been, I believe, one main cause of the early prosperity of this colony."
                                            },
                                            {
                                                "example_id": "efb5703e-e828-4a58-8bcc-9febb370440a",
                                                "sense_id": "25cb36e3-cb39-3e67-9678-4c84c26ec92e",
                                                "text": "Strategic sites in even the remotest regions of the kingdom were swiftly fortified using forced labour."
                                            },
                                            {
                                                "example_id": "4cca67e9-1a8b-4ab3-be3a-dddc49cf71ef",
                                                "sense_id": "25cb36e3-cb39-3e67-9678-4c84c26ec92e",
                                                "text": "The outcry over forced labor is a serious blow to the ruling Communist Party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
