                "senses": [
                    {
                        "sense_id": "7e5447ea-2ce5-344c-a8f1-fd08253d2123",
                        "entry_id": "cddb51b7-9312-37da-8646-8236aee24f45",
                        "glosses": [
                            "Qui questionne, qui interroge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad0fb706-9738-4b84-abf1-02715d8ba847",
                                "sense_id": "7e5447ea-2ce5-344c-a8f1-fd08253d2123",
                                "text": "Évidemment il y avait là quelque chose de significatif. Mais quoi ? Il était peu questionneur, il ne voulut pas l’interroger."
                            },
                            {
                                "example_id": "4fbf1a40-96ed-401a-af4f-cca08b1b9307",
                                "sense_id": "7e5447ea-2ce5-344c-a8f1-fd08253d2123",
                                "text": "Des prostituées pirouettaient à des coins de rue, avec de pauvres jupes et des yeux questionneurs : il ne les regardait même pas."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "f94675dc-6f4d-337f-ad49-4929db5894b7",
                "word": "questionneur",
