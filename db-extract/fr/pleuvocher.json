                "senses": [
                    {
                        "sense_id": "02bf1c48-30f2-380c-8bee-d8099ee6a15b",
                        "entry_id": "ef675221-54cb-3515-8efa-95d2f67b9b0f",
                        "glosses": [
                            "Pleuvoir un peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b5a0c04-a940-4738-ac20-9c184ed145b5",
                                "sense_id": "02bf1c48-30f2-380c-8bee-d8099ee6a15b",
                                "text": "Comble de malchance, le temps était gris et mou, il pleuvochait, une pellicule de boue grisâtre collait au trottoir, les passants avaient tous sans exception des gueules moches, ça puait le chien mouillé et l'essence, les autobus Madeleine-Bastille ébranlaient les vitres à chaque passage."
                            },
                            {
                                "example_id": "b89970a0-5ddd-4a92-9070-363bc5aabf95",
                                "sense_id": "02bf1c48-30f2-380c-8bee-d8099ee6a15b",
                                "text": "À six heures, ce matin, il pleuvotait, pleuvassait, pleuvochait ou pleuvinait et, feignant de craindre qu'il ne pleuve vraiment, je me suis recouché."
                            }
                        ]
                    }
