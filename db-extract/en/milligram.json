                "entry_id": "0877b394-a035-3d74-a819-e74cf1bebf8b",
                "word": "milligram",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3d40e72c-45e9-466d-a97e-4c955692e73f",
                        "entry_id": "0877b394-a035-3d74-a819-e74cf1bebf8b",
                        "tags": [
                            "plural"
                        ],
                        "form": "milligrams"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80699e41-c5fc-33b5-af29-5dc7223d0d5a",
                        "entry_id": "0877b394-a035-3d74-a819-e74cf1bebf8b",
                        "glosses": [
                            "An SI unit of mass equal to 10⁻³ grams. Symbol: mg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f86c50b4-725f-496f-b964-f9a1fd372774",
                                "sense_id": "80699e41-c5fc-33b5-af29-5dc7223d0d5a",
                                "text": "Holonyms: gram < kilogram < megagram < gigagram"
                            },
                            {
                                "example_id": "0d57ae65-4c29-4699-8525-8edf754aad09",
                                "sense_id": "80699e41-c5fc-33b5-af29-5dc7223d0d5a",
                                "text": "Meronyms: picogram < nanogram < microgram"
                            },
                            {
                                "example_id": "f8faa802-ea86-4348-af5b-c8ce16088eb8",
                                "sense_id": "80699e41-c5fc-33b5-af29-5dc7223d0d5a",
                                "text": "The US Food and Drug Administration defines this limit as anything more than 400 milligrams of caffeine daily for healthy adults. This is equivalent to four or five cups of coffee."
                            },
                            {
                                "example_id": "a4f4fe69-645c-4ba0-ad53-cff3ded58cc5",
                                "sense_id": "80699e41-c5fc-33b5-af29-5dc7223d0d5a",
                                "text": "Blue No. 1 and yellow No. 6 may also be toxic to some human cells. And as little as 1 milligram of yellow dye No. 5 may cause irritability, restlessness and sleep disturbances for sensitive children."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8c8feb2-5388-4694-9ea7-a9fb8933c7f4",
                        "source_entry_id": "0877b394-a035-3d74-a819-e74cf1bebf8b",
