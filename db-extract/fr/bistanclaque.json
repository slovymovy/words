                        "tags": [
                            "Lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "78974dd2-9801-4be6-824d-54d4a01d85cc",
                                "sense_id": "f762ed1a-73f3-3835-a7ea-28fa905963df",
                                "text": "Les uns après les autres, les bistanclaques s’arrêtent, au fond des antiques corridors, qui sentaient le chou aigre et le pipi de chat. Et le dernier d’entre eux a dû être porté au Musée des Tissus…"
                            },
                            {
                                "example_id": "3a69ed47-8821-420c-b1f0-05e56b00d6f9",
                                "sense_id": "f762ed1a-73f3-3835-a7ea-28fa905963df",
                                "text": "Le bistanclaque ne fait plus chanter les cours de la Croix-Rousse."
                            },
                            {
                                "example_id": "cdc1c70f-fa22-4480-bffa-774cc28f0a0c",
                                "sense_id": "f762ed1a-73f3-3835-a7ea-28fa905963df",
                                "text": "Cinquante bistanclaques cliquetaient."
                            }
                        ]
                    }
