                        "glosses": [
                            "Soldat régulier employé dans les casernes en temps de paix comme en temps de guerre."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "c2789391-3b52-406e-95bc-db70182c0c1b",
                                "sense_id": "c115b321-6345-3b2b-aa2b-464e96741c59",
                                "text": "Les morte-payes s’opposent aux réservistes qui ne sont appelés qu’en cas de besoin."
                            },
                            {
                                "example_id": "ca882a69-54a8-443a-b07a-00c84b0478f5",
                                "sense_id": "c115b321-6345-3b2b-aa2b-464e96741c59",
                                "text": "On entendoit par morte paye un soldat entretenu aux dépens de la Province, soit qu’il fût en garnisont, soit qu’il marchât. ^([1])"
                            }
                        ]
