                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba44b25b-262d-432b-a197-b7a6d34e3eea",
                        "source_entry_id": "6394247b-b54a-32a7-8960-9d5d78d365e3",
                        "source_sense_id": "cd40d524-682e-32f4-8e29-c962fb61afad",
                        "target_lang_word": "tangential",
