                    {
                        "translation_id": "d433e40a-988d-47ac-af8b-f8625f106423",
                        "source_entry_id": "ebd9370f-7503-363b-9b9f-95dd1ad42635",
                        "source_sense_id": "ec39c385-c4eb-3a1a-b86b-6e733a52c10e",
                        "source_sense_description": "prehistoric burial mound",
                        "target_lang_word": "kourgane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kourgane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "375570a0-3ace-34c0-b483-c3bb6a090723",
                                        "entry_id": "d276c120-962b-383b-b6d7-49e7e01d7338",
                                        "glosses": [
                                            "En Russie, sépulture préhistorique recouverte dʼun tumulus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26aa7be3-29c3-438c-b768-19c37598f471",
                                                "sense_id": "375570a0-3ace-34c0-b483-c3bb6a090723",
                                                "text": "Il s'agissait de visiter un kapas (c'est ainsi que les Lithuaniens appellent les tumulus auxquels les Russes donnent le nom de kourgâne) très célèbre dans le pays, parce qu'autrefois les poètes et les sorciers, c'était tout un, s'y réunissaient en certaines occasions solennelles."
                                            },
                                            {
                                                "example_id": "2bb883a4-8463-434c-b749-a2ea916522be",
                                                "sense_id": "375570a0-3ace-34c0-b483-c3bb6a090723",
                                                "text": "Le kourgane de base comprend la sépulture qui contient une grande quantité de mobilier varié, si elle nʼa pas été pillée."
                                            },
                                            {
                                                "example_id": "708d3300-bdd5-421a-969e-166d71a81fa0",
                                                "sense_id": "375570a0-3ace-34c0-b483-c3bb6a090723",
                                                "text": "Sur les rayonnages traînent une bible en langue afrikaner et un bocal de terre ramassée au kourgane Mamaïev."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2292f56d-f6c0-4036-be77-a14b6db636f1",
                        "source_entry_id": "ebd9370f-7503-363b-9b9f-95dd1ad42635",
                        "source_sense_id": "ec39c385-c4eb-3a1a-b86b-6e733a52c10e",
                        "source_sense_description": "prehistoric burial mound",
                        "target_lang_word": "Kurgan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kurgan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95bfea3b-9dbb-36ab-8d90-3f70e1f93139",
                                        "entry_id": "ceaa1817-8a23-3153-8cae-f403106507b7",
                                        "glosses": [
                                            "„Hügelgrab in Osteuropa“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "892b5df1-6145-48b2-822b-439bcef0e2aa",
                                                "sense_id": "95bfea3b-9dbb-36ab-8d90-3f70e1f93139",
                                                "text": "„Im Näherkommen erkannte ich ein langes Luftschiff, das über einem großen Kurgan schwebte.“"
                                            },
                                            {
                                                "example_id": "cd21d4f5-c721-49db-a762-07baf134347b",
                                                "sense_id": "95bfea3b-9dbb-36ab-8d90-3f70e1f93139",
                                                "text": "Beim Substantiv Kurgan sieht man den Einfluss der Tataren, die seit einigen Jahrhunderten im Gebiet des Russischen Reiches und heutigem Russland leben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kurgan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "229bbeca-8d6d-3841-babc-04a83bcdd444",
                                        "entry_id": "9d02d68f-c373-3ee2-b9f5-f11238362dc0",
                                        "glosses": [
                                            "am Fluss Tobol gelegene Stadt in Russland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24ad4133-b48f-405c-b9df-feb5341a4bbd",
                                                "sense_id": "229bbeca-8d6d-3841-babc-04a83bcdd444",
                                                "text": "„In Kurgan ist der Verkehr chaotisch. Die Stadt ist mehr als lebhaft, eher schon hypermobil.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
