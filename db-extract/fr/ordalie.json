        "fr-extract.jsonl": [
            {
                "entry_id": "a7c626e2-ab1e-3a7a-baf0-e3b322eeaa6f",
                "word": "ordalie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f56a4dd8-a73f-4955-a698-e8fc6fa3f892",
                        "entry_id": "a7c626e2-ab1e-3a7a-baf0-e3b322eeaa6f",
                        "tags": [
                            "plural"
                        ],
                        "form": "ordalies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "442dfcae-7741-36b2-9894-fbfd0f939132",
                        "entry_id": "a7c626e2-ab1e-3a7a-baf0-e3b322eeaa6f",
                        "glosses": [
                            "Épreuve, allant jusqu’à la torture, usitée au Moyen Âge comme preuve en justice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3daa8c24-b88c-46c6-8819-481a4452ba2a",
                                "sense_id": "442dfcae-7741-36b2-9894-fbfd0f939132",
                                "text": "Quant à l’hypothèse, sous-introduite au moyen âge, qui tendrait à faire de la guerre, à la façon de l’ordalie ou combat judiciaire, une manifestation de la volonté du ciel, il va sans dire que Grotius et ses successeurs la rejettent."
                            },
                            {
                                "example_id": "8e6ef478-2f7b-43f3-9ba3-63cbb696b630",
                                "sense_id": "442dfcae-7741-36b2-9894-fbfd0f939132",
                                "text": "Divination par l’entraille et le souffle et la palpitation du souffle ! Divination par l’eau du ciel et l’ordalie des fleuves…"
                            },
                            {
                                "example_id": "a4c52a0f-795f-4d38-9369-db3b83a285e3",
                                "sense_id": "442dfcae-7741-36b2-9894-fbfd0f939132",
                                "text": "On leur a enseigné les vertus des plantes et la manière de procéder à des ordalies, truquées ou non, le Jugement de Dieu ayant été d'abord le Jugement des Dieux."
                            },
                            {
                                "example_id": "70b187b6-4643-4129-b11f-bf9890257f5e",
                                "sense_id": "442dfcae-7741-36b2-9894-fbfd0f939132",
                                "text": "Grâce au tribunal de la Sainte Inquisition, la sorcière était soumise à l’ordalie qui pouvait l’innocenter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b19bf14c-bc67-4248-a594-89aa031e68a6",
                        "source_entry_id": "a7c626e2-ab1e-3a7a-baf0-e3b322eeaa6f",
                        "source_sense_id": "442dfcae-7741-36b2-9894-fbfd0f939132",
                        "source_sense_description": "épreuve",
                        "target_lang_word": "Urteil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urteil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7e0c3b8-97a2-37f6-99b4-ce30e8fcbb9b",
                                        "entry_id": "c87c4948-3d30-3637-94ff-68b2f8a09b85",
                                        "glosses": [
                                            "richterliche Entscheidung eines Gerichtes zur abschließenden Klärung eines Rechtsstreites"
                                        ],
                                        "tags": [
                                            "Rechtssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47f0d3f1-c42c-41d1-a09d-c7a2833b1012",
                                                "sense_id": "e7e0c3b8-97a2-37f6-99b4-ce30e8fcbb9b",
                                                "text": "Die Richter verkünden das Urteil um 10 Uhr."
                                            },
                                            {
                                                "example_id": "4cffa980-6fbb-4c87-baed-506763a69ac9",
                                                "sense_id": "e7e0c3b8-97a2-37f6-99b4-ce30e8fcbb9b",
                                                "text": "Oft werden politische Entscheidungen durch Urteile der Gerichte korrigiert."
                                            },
                                            {
                                                "example_id": "3226cbb8-367f-45a3-a5fc-56b4771fc3a5",
                                                "sense_id": "e7e0c3b8-97a2-37f6-99b4-ce30e8fcbb9b",
                                                "text": "„Mit umstrittenen Urteilen zum Waffenrecht, Klimaschutz und Abtreibungen war der US-Supreme Court in den Schlagzeilen.“"
                                            },
                                            {
                                                "example_id": "15893343-1236-41a0-ad3c-1e594907c80c",
                                                "sense_id": "e7e0c3b8-97a2-37f6-99b4-ce30e8fcbb9b",
                                                "text": "[…] „mit jedem Urteil, bei dem die Richter gemäß der Linie der Partei, die sie ernannt hat, abstimmen, erscheint der Supreme Court politischer und seine Glaubwürdigkeit sinkt.“"
                                            },
                                            {
                                                "example_id": "4894bb00-cf2e-4600-9490-22219b103d8d",
                                                "sense_id": "e7e0c3b8-97a2-37f6-99b4-ce30e8fcbb9b",
                                                "text": "„Am 11. September erhält dieses Urteil Rechtskraft, wird am Tage darauf in effigie vollzogen und ein dementsprechendes Protokoll angefertigt.“"
                                            },
                                            {
                                                "example_id": "ca62c11d-f613-43ec-95ee-8d314216cb12",
                                                "sense_id": "e7e0c3b8-97a2-37f6-99b4-ce30e8fcbb9b",
                                                "text": "„Das Oberverwaltungsgericht Berlin-Brandenburg bestätigte ein Urteil des Verwaltungsgerichts Berlin aus dem Jahr 2021, wonach die AfD eine hohe Strafzahlung wegen der Annahme der Spende leisten muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d8f7f9bb-81e0-3c88-9fd4-34e72070c7c1",
                                        "entry_id": "c87c4948-3d30-3637-94ff-68b2f8a09b85",
                                        "glosses": [
                                            "Eindruck einer Person gegenüber anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8b4cb53-afa6-4745-9410-dcff72579d1b",
                                                "sense_id": "d8f7f9bb-81e0-3c88-9fd4-34e72070c7c1",
                                                "text": "„Vorurteile werden manchmal als Urteile und Wertungen definiert, die nicht auf eigener Erfahrung beruhen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "325e4c2b-5a31-40ef-bec2-9e68c7e26204",
                        "source_entry_id": "a7c626e2-ab1e-3a7a-baf0-e3b322eeaa6f",
                        "source_sense_id": "442dfcae-7741-36b2-9894-fbfd0f939132",
