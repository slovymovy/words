                "senses": [
                    {
                        "sense_id": "2c8fb8f9-c9eb-3ac9-8eaa-024563f44fc6",
                        "entry_id": "a1cfad6a-b24c-3bf1-a045-462b2a14be76",
                        "glosses": [
                            "мед. воспаление соединительной оболочки глаза (конъюнктивы)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63b5d32d-a4b5-4498-9193-be9c7c178fa2",
                                "sense_id": "2c8fb8f9-c9eb-3ac9-8eaa-024563f44fc6",
                                "text": "Вирус вызывал конъюнктивит у обслуживающего персонала пораженных ферм."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca28f204-c2f4-3c29-b899-543d70e8d36e",
                        "entry_id": "a1cfad6a-b24c-3bf1-a045-462b2a14be76",
                        "glosses": [
                            "прост. любое заболевание или покраснение глаз"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5264869a-2131-4946-9825-94f4a644836a",
                                "sense_id": "ca28f204-c2f4-3c29-b899-543d70e8d36e",
                                "text": "Ходит мнение, что конъюнктивит — заболевание несерьезное, покраснел глаз, зудит, чешиться — якобы завтра само пройдет… Но это не так!"
                            }
                        ]
                    }
