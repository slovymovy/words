                "senses": [
                    {
                        "sense_id": "0a66f461-2f3b-34b6-b2b7-09fbae2f6a10",
                        "entry_id": "f942e4c7-092d-329c-9e30-47dc9903f809",
                        "glosses": [
                            "Person, die ihre Gesundheitskosten selbst zahlt beziehungsweise von einer dafür abgeschlossenen privaten Krankenversicherung zahlen lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5935d9ea-3a03-450c-b91f-02eeb62bc9e5",
                                "sense_id": "0a66f461-2f3b-34b6-b2b7-09fbae2f6a10",
                                "text": "Nur wenig mehr als 10% der Bundesbürger sind Privatpatienten."
                            },
                            {
                                "example_id": "c273bf1c-035a-417c-b6a6-8e6be5e7c60e",
                                "sense_id": "0a66f461-2f3b-34b6-b2b7-09fbae2f6a10",
                                "text": "„Die brauchen die Rezeptformulare für Privatpatienten so selten, daß sie sie meistens im Schreibtisch aufbewahren.“"
                            },
                            {
                                "example_id": "4eb01ffc-7f9e-41d7-a683-d61039727b81",
                                "sense_id": "0a66f461-2f3b-34b6-b2b7-09fbae2f6a10",
                                "text": "„Die Privatpatienten brauchen natürlich nicht zu arbeiten.“"
                            }
                        ],
