                        "source_entry_id": "d85b68c0-376f-3a9a-8555-9911466b90d5",
                        "source_sense_id": "d50eddd3-3051-3e56-a2c2-7d1657d2afae",
                        "source_sense_description": "Trainingsgerät (kugelförmiges Gewicht mit Griff)",
                        "target_lang_word": "kettlebell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kettlebell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "754d8a5d-a76f-3712-871a-26f1060632a5",
                                        "entry_id": "4e47bf45-9363-352a-b4f0-c4d463cd5103",
                                        "glosses": [
                                            "A weight consisting of a cast iron ball with a single handle for gripping the weight during exercise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e5a871b-1f88-4c1c-babc-d67fc00284b5",
                                                "sense_id": "754d8a5d-a76f-3712-871a-26f1060632a5",
                                                "text": "Also called kettlebell sport, this is a Russian national sport in which the girya (kettlebell) is used either in single or double form to accumulate as many repetitions as possible in 10 minutes in order to compare one lifter with the next in a sporting framework."
                                            },
                                            {
                                                "example_id": "17e9fab5-6d4d-48a4-a340-293003bbe03f",
                                                "sense_id": "754d8a5d-a76f-3712-871a-26f1060632a5",
                                                "text": "The rows of kettlebells, spotted with various colors of spray paint, fit in with the spartan surroundings. The kettlebell is intimidating in its simplicity: a ball with a handle, like a Biblical weapon or a giant bull’s testicle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46e75bd2-1764-4fce-849e-27b41a84fcdc",
                        "source_entry_id": "d85b68c0-376f-3a9a-8555-9911466b90d5",
                        "source_sense_id": "d50eddd3-3051-3e56-a2c2-7d1657d2afae",
                        "source_sense_description": "Trainingsgerät (kugelförmiges Gewicht mit Griff)",
                        "target_lang_word": "kettlebell",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kettlebell",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c3bb1ef-20c2-3cd6-867c-50110dbd9081",
                                        "entry_id": "40e29047-d75d-3ae1-b2de-bb92c30edbdb",
                                        "glosses": [
                                            "Poids constitué d’une boule de fer moulée avec une seule poignée pour prendre le poids pendant un exercice physique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "794c9896-9cff-4da7-a3ef-f14d3523611e",
                                                "sense_id": "0c3bb1ef-20c2-3cd6-867c-50110dbd9081",
                                                "text": "Les boulets étaient alors récupérés par les autochtones …. Des marchands russes eurent un jour l'idée de leur coller une poignée pour les déplacer plus facilement, puis s'en servirent dans divers tours de forces, où ils prirent le nom de « giryas ». A force de migrations, les giryas parvinrent aux Etats-Unis où ils reçurent le nom de kettlebells en raison de leur forme qui évoque vaguement celle d'une bouilloire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db82d62f-ffc3-3e6b-8e81-1d45dcebb2aa",
                                        "entry_id": "40e29047-d75d-3ae1-b2de-bb92c30edbdb",
                                        "glosses": [
                                            "Poids que l’on traîne avec soi."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "392f1910-e1af-4fd7-908f-ebb4f2a60db7",
                                                "sense_id": "db82d62f-ffc3-3e6b-8e81-1d45dcebb2aa",
                                                "text": "Mon amie Céline, qui me connaît mieux que je ne me connais moi-même, affirme que si la culpabilité était une discipline olympique je serais médaillée d’or, car je culpabilise comme d’autres nagent, courent ou font du crossfit – ma mauvaise conscience est ma kettlebell."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
