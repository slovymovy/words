                ],
                "senses": [
                    {
                        "sense_id": "38b75178-42fc-3091-8389-758d9eef292e",
                        "entry_id": "90bd57d1-27e1-302c-8169-750a2db35626",
                        "glosses": [
                            "naturgegebene Lust, Antrieb zu spielerischer Betätigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d5eca32-6c6e-441f-a313-c7580bc7fea7",
                                "sense_id": "38b75178-42fc-3091-8389-758d9eef292e",
                                "text": "„Ein dritter Impuls für die Befreiung des Spieltriebs ging von Berthold Otto aus.“"
                            },
                            {
                                "example_id": "9b5d14fd-5fcd-4e23-ae96-cc9dd8ee86f3",
                                "sense_id": "38b75178-42fc-3091-8389-758d9eef292e",
                                "text": "„So ist mit dem Spieltrieb das merkwürdige Faktum eines Triebes gegeben, der aus sich heraus keine Befriedigung will.“"
                            },
                            {
                                "example_id": "ad323e45-4852-47a5-a7df-0f53b9dcb75c",
                                "sense_id": "38b75178-42fc-3091-8389-758d9eef292e",
                                "text": "„Der Spieltrieb kann so mächtig werden, dass er Suchtform annimmt und zu Exzessen führt.“"
                            },
                            {
                                "example_id": "9a15e383-ca82-47a5-8d26-1569f7d97105",
                                "sense_id": "38b75178-42fc-3091-8389-758d9eef292e",
                                "text": "War es ein blind machender Spieltrieb, der die Banken ins Verderben getrieben hat?"
                            },
                            {
                                "example_id": "03cb8936-769e-4ad8-81b6-7209cdeb3e6d",
                                "sense_id": "38b75178-42fc-3091-8389-758d9eef292e",
                                "text": "„Viele Schulen haben die Minipropeller verboten, weil die Kinder ihren Spieltrieb nicht mehr im Griff hatten.“"
                            },
                            {
                                "example_id": "8de37a2c-e54f-4afe-8fe2-3edf98911d07",
                                "sense_id": "38b75178-42fc-3091-8389-758d9eef292e",
                                "text": "„Unternehmen wollen den Spieltrieb nun nutzen und die Aufmerksamkeit ihrer Mitarbeiter auf Tätigkeiten lenken, die Erträge einbringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
