                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05bb48d2-1473-439a-a933-346cb31e9086",
                                                "sense_id": "d84ba9aa-0b3a-3f36-9a25-978b72f84fc0",
                                                "text": "Rich Lee – one of the organisers of Grindfest, and the Transhumanist Party’s ‘bio-hacking adviser’ – estimates that there are around 3,000 grinders in the US, and many more bio-hackers."
                                            }
                                        ]
                                    },
