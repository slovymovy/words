                                                "example_id": "090a0fad-ea5a-4b30-a4ac-8903ce166c6b",
                                                "sense_id": "99454f53-06d2-3285-8afd-708b42d5794e",
                                                "text": "Ich wurde zu des Fürsten Kellner bestimmt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e27621e3-d3f4-3c8d-b8d4-8ee8d543a6c6",
