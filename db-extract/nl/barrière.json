                ],
                "senses": [
                    {
                        "sense_id": "7bb4e526-6cbc-32bb-8483-c741e70242e9",
                        "entry_id": "f1c5fd91-6fc5-3576-b53b-a65d12384f8f",
                        "glosses": [
                            "begrenzing, bescherming, belemmering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb11bc5e-3f1e-469f-890c-6354fb204305",
                                "sense_id": "7bb4e526-6cbc-32bb-8483-c741e70242e9",
                                "text": "Zijn lage opleiding vormde een barrière voor zijn verdere promotie."
                            },
                            {
                                "example_id": "c6d8ab97-a05f-48fd-88ec-7fc122d31352",
                                "sense_id": "7bb4e526-6cbc-32bb-8483-c741e70242e9",
                                "text": "Wij moesten stoppen want de brokstukken van het ongeluk vormde een barrière."
                            },
                            {
                                "example_id": "87c10c44-830a-444f-92f8-1317fabed23b",
                                "sense_id": "7bb4e526-6cbc-32bb-8483-c741e70242e9",
                                "text": "Ik legde mijn handen op de marmeren brugleuning en keek neer op het gewemel op het groenblauwe water, dat eerder een levensader was dan een barrière."
                            },
                            {
                                "example_id": "6a4f6219-8717-4092-962e-ddbad128b19d",
                                "sense_id": "7bb4e526-6cbc-32bb-8483-c741e70242e9",
                                "text": "Diep in hun hart wilden ze wel met elkaar praten, maar barrières van zelfverwijt en lethargie lieten dit niet toe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbbd02a9-9012-46b4-ae9a-ec8e94317601",
                        "source_entry_id": "f1c5fd91-6fc5-3576-b53b-a65d12384f8f",
                        "source_sense_id": "7bb4e526-6cbc-32bb-8483-c741e70242e9",
