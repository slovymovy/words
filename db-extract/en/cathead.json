    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e4eac308-832b-3788-93ab-07996887b7f5",
                "word": "cathead",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "91064ce2-81ec-4130-a285-37398fd79c28",
                        "entry_id": "e4eac308-832b-3788-93ab-07996887b7f5",
                        "tags": [
                            "plural"
                        ],
                        "form": "catheads"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "00a83a71-99b6-311d-8006-dda7c95ff743",
                        "entry_id": "e4eac308-832b-3788-93ab-07996887b7f5",
                        "glosses": [
                            "A heavy piece of timber projecting somewhat horizontally from each side of the bow of a ship on which an anchor is raised or lowered, and secured when not used, from its stock end."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b95d66c-e7d2-498f-99c2-049a0ff60155",
                                "sense_id": "00a83a71-99b6-311d-8006-dda7c95ff743",
                                "text": "\"Hurrah, for the last time,\" said the mate; and the anchor came to the cat-head to the tune of \"Time for us to go,\" with a loud chorus. Everything was done quick, as though it were for the last time."
                            },
                            {
                                "example_id": "2455ac7d-8cad-475f-a188-09719f0530ad",
                                "sense_id": "00a83a71-99b6-311d-8006-dda7c95ff743",
                                "text": "The cat-heads had burned away, and the two red-hot anchors had gone to the bottom, tearing out after them two hundred fathom of red-hot chain."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4c46a83-a82c-3014-9076-ea44e170161c",
                        "entry_id": "e4eac308-832b-3788-93ab-07996887b7f5",
                        "glosses": [
                            "A decorative element at the end of such a timber that often depicts a cat's head."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2106c64a-7466-3f4a-bf34-90d14440c00d",
                        "entry_id": "e4eac308-832b-3788-93ab-07996887b7f5",
                        "glosses": [
                            "A (small) capstan (“vertical cylindrical machine that revolves on a spindle, used to apply force to cables, ropes, etc.”) or windlass (“type of winch”) forming part of hoisting machinery."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "209008c6-bc3d-3585-9757-8680589a0993",
                        "entry_id": "e4eac308-832b-3788-93ab-07996887b7f5",
                        "glosses": [
                            "A nodule of ironstone containing fossil remains."
                        ],
                        "tags": [
                            "UK",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "eea9de41-8cfa-4f9f-9241-2f77c9172275",
                                "sense_id": "209008c6-bc3d-3585-9757-8680589a0993",
                                "text": "A piece of a ferruginous ſtoney Nodule having in it 3 Leaves of a capillary Plant […] Theſe Nodules, vvith Leaves in them, are called Catheads, and ſeem to conſiſt of a ſort of Iron-Stone, not unlike that vvhich is found very plentifully at Robinshood's-Bay in Yorkſhire, and in the Rocks near VVhitehaven in Cumberland: vvhere they there call 'em Cat-Scaups, and are frequently melted vvith the ſofter Iron-Ores."
                            }
                        ]
                    },
                    {
                        "sense_id": "96a2e0c0-d9ea-398e-8e5f-e814478113b5",
                        "entry_id": "e4eac308-832b-3788-93ab-07996887b7f5",
                        "glosses": [
                            "Ellipsis of cathead biscuit (“a large fluffy biscuit, typically served with gravy”)."
                        ],
                        "tags": [
                            "US",
                            "abbreviation",
                            "alt-of",
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "cdf70513-c5dc-4bab-8847-45402e29f162",
                                "sense_id": "96a2e0c0-d9ea-398e-8e5f-e814478113b5",
                                "text": "The trick to eating catheads was to get the butter on them before they got cold—then they were delicious. When, unluckily, they were allowed to get cold, they tended to a gooeyness, not unlike a wad of tired gum."
                            }
                        ]
                    }
                ],
