                "senses": [
                    {
                        "sense_id": "135ce6f3-a432-364c-81b5-9af573f90639",
                        "entry_id": "7f9e6e82-89a6-3449-ab34-e91a00f85a22",
                        "glosses": [
                            "eskimoski skafander wkładany przez głowę, wykonany z futra, płótna lub skóry"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6c376fcb-1dd7-38ac-89c8-26a3a32fe44c",
                        "entry_id": "7f9e6e82-89a6-3449-ab34-e91a00f85a22",
                        "glosses": [
                            "ciepła nieprzemakalna kurtka z kapturem uszyta na wzór anoraka (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5e909c3-5521-4152-86e4-73501f6f8698",
                                "sense_id": "6c376fcb-1dd7-38ac-89c8-26a3a32fe44c",
                                "text": "Danusia miała na sobie błękitny anorak przywieziony z obozu na Krymie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5763542b-2301-4d88-82b7-90527f2348c1",
                        "source_entry_id": "7f9e6e82-89a6-3449-ab34-e91a00f85a22",
                        "source_sense_id": "135ce6f3-a432-364c-81b5-9af573f90639",
                        "target_lang_word": "anorak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anorak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a8bac0d-d4c4-3b1e-8e33-ebf92ccbcfa6",
                                        "entry_id": "241cf256-c8fe-3c49-87b6-bbc6831c24a4",
                                        "glosses": [
                                            "A heavy weatherproof jacket with an attached hood; a parka or windcheater."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f7b868c-33e5-41ae-8b54-7d011e17cb60",
                                                "sense_id": "1a8bac0d-d4c4-3b1e-8e33-ebf92ccbcfa6",
                                                "text": "Don't ever use the hood on your anorak; and, if you do, for heaven's sake don't pull the string tight so that you peep out like a little baby in a siren suit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6214d1f-1008-3e90-b7ea-7bb85c71dc39",
                                        "entry_id": "241cf256-c8fe-3c49-87b6-bbc6831c24a4",
                                        "glosses": [
                                            "A person with an unusual or obsessive interest in a niche subject, especially trains."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "901b3cf1-3d84-429d-a42b-1d5eae9ea80f",
                                                "sense_id": "f6214d1f-1008-3e90-b7ea-7bb85c71dc39",
                                                "text": "He has described himself as the uber-geek, an anorak's anorak, a standard bearer for fellow Star Trekkies everywhere, and his air of bland, amiable bafflement has served him remarkably well in a string of TV and film roles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93b17935-a7bc-4a70-96fe-1eba00bfb475",
                        "source_entry_id": "7f9e6e82-89a6-3449-ab34-e91a00f85a22",
                        "source_sense_id": "135ce6f3-a432-364c-81b5-9af573f90639",
                        "target_lang_word": "anorak",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anorak",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06e8ffaf-6e2c-3c6e-8564-182af464a516",
                                        "entry_id": "f376a67d-ac51-34c5-99c2-3a2a61942f08",
                                        "glosses": [
                                            "Veste du vêtement traditionnel des populations inuits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "387b44ee-d785-4ea3-8b27-0b2568adcf31",
                                                "sense_id": "06e8ffaf-6e2c-3c6e-8564-182af464a516",
                                                "text": "[…] ils ont conservé cependant la forme esquimau, en particulier de l’anorak, sorte de veste à capuchon, très pratique pour les régions polaires ; nous l’utilisions dès 1903 dans nos expéditions."
                                            },
                                            {
                                                "example_id": "02944f5b-e01d-486a-94ea-c30d1b0c4ab7",
                                                "sense_id": "06e8ffaf-6e2c-3c6e-8564-182af464a516",
                                                "text": "Anorak et parka sont des mots utiles au Scrabble, ils nous viennent de l’inuit, quand le finnois ne nous en donna qu’un, sauna."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76d69f46-71da-3116-ba65-2df6afa42662",
                                        "entry_id": "f376a67d-ac51-34c5-99c2-3a2a61942f08",
                                        "glosses": [
                                            "Manteau ou veste d’hiver à capuche, matelassé et doublé, en textile synthétique, parfois bordé de fourrure, à l’imitation du vêtement inuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b8287a1-3ac1-4db7-9f91-32554b870bf9",
                                                "sense_id": "76d69f46-71da-3116-ba65-2df6afa42662",
                                                "text": "Les anoraks s’entassèrent dans une pièce voisine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
