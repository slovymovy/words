                ],
                "senses": [
                    {
                        "sense_id": "ec5ee119-89fb-3e52-a0f7-434fdeeabb04",
                        "entry_id": "cec3d394-b3ea-3a5b-a4c8-121f26513d4b",
                        "glosses": [
                            "Mixgetränk mit Milch als Basis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e67d99c-bc82-4aba-99a3-7072d07d89b4",
                                "sense_id": "ec5ee119-89fb-3e52-a0f7-434fdeeabb04",
                                "text": "Ich nehme einen Milchshake mit Erdbeere, bitte!"
                            },
                            {
                                "example_id": "3ef7f933-0520-4b63-b8ab-39cc59e525be",
                                "sense_id": "ec5ee119-89fb-3e52-a0f7-434fdeeabb04",
                                "text": "„Ich ließ alles in der Umkleidekabine hängen und ging zu Meyer, um mir einen Milchshake zu kaufen, den ich trank, während ich auf den Bus nach Hause wartete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7e5d37e-73f4-496a-b270-906f9e7859a0",
                        "source_entry_id": "cec3d394-b3ea-3a5b-a4c8-121f26513d4b",
                        "source_sense_id": "ec5ee119-89fb-3e52-a0f7-434fdeeabb04",
                        "source_sense_description": "Mixgetränk mit Milch als Basis",
                        "target_lang_word": "milkshake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "milkshake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1721b43d-8fba-3a75-aeb4-5df437117be8",
                                        "entry_id": "641725bf-6923-3b7a-8265-fc64bf6e0483",
                                        "glosses": [
                                            "A thick beverage consisting of milk and ice cream mixed together, often with fruit, chocolate, or other flavoring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c391eb97-b7d7-41c5-bebb-60c3ce14f93e",
                                                "sense_id": "1721b43d-8fba-3a75-aeb4-5df437117be8",
                                                "text": "On May 2, a Twitter user posted a video of Danyaal Mahmud throwing a milkshake over Robinson."
                                            },
                                            {
                                                "example_id": "4efdea6c-af29-47f5-9f62-995b8da31060",
                                                "sense_id": "1721b43d-8fba-3a75-aeb4-5df437117be8",
                                                "text": "McDonald’s has been forced to stop selling milkshakes and bottled drinks at nearly 1,300 restaurants in the United Kingdom as Brexit-related staff shortages and supply chain delays caused by the pandemic continue to slam companies."
                                            },
                                            {
                                                "example_id": "5220693a-75ce-49ae-8bf9-d5605fc7f78b",
                                                "sense_id": "1721b43d-8fba-3a75-aeb4-5df437117be8",
                                                "text": "It should come as no surprise that while the peasants are expected to eat fermented fungi, lab-grown meats and maggot milkshakes, the Controligarchs — with their private chefs — have no intention of doing the same,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb36d7be-4c57-3339-a41c-f61cb1e734d4",
                                        "entry_id": "641725bf-6923-3b7a-8265-fc64bf6e0483",
                                        "glosses": [
                                            "A thin beverage, similar to the above, but with no ice cream or significantly less of it."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-England",
                                            "New-Zealand"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57943048-01b4-3382-bb34-2e82637bba73",
                                        "entry_id": "641725bf-6923-3b7a-8265-fc64bf6e0483",
                                        "glosses": [
                                            "A beverage consisting of fruit juice, water, and some milk, as served in Southeast Asia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f331f84b-6a39-3400-b392-5b49535638cf",
                                        "entry_id": "641725bf-6923-3b7a-8265-fc64bf6e0483",
                                        "glosses": [
                                            "Accidental emulsion of oil and water in an engine."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6314724a-1c44-4687-9971-df3f8be6c6c6",
                                                "sense_id": "f331f84b-6a39-3400-b392-5b49535638cf",
                                                "text": "This milkshake under the oil cap, or on the dipstick, indicates a blown head gasket."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de7dec7f-20df-357b-b18e-b787bcd310b9",
                                        "entry_id": "641725bf-6923-3b7a-8265-fc64bf6e0483",
                                        "glosses": [
                                            "An alkaline supplement administered to a horse to improve its racing performance."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fa1bc34-178c-4b7b-9d8f-37ae43776c39",
                                                "sense_id": "de7dec7f-20df-357b-b18e-b787bcd310b9",
                                                "text": "It was the illegal administration by trainer Gregory Martin and subsequent positive test of a baking soda, sugar and water mixture – commonly known as a “milkshake” – prior to one of his runner’s 10 length romps in a $12,000 claiming race at Aqueduct on December 18, 2003 that initially helped to bring the $200 million in illegal wagers to light."
                                            },
                                            {
                                                "example_id": "1e29570c-dfb0-4095-86ed-a2dfb9a3c6e4",
                                                "sense_id": "de7dec7f-20df-357b-b18e-b787bcd310b9",
                                                "text": "In 1999, the trainer Bobby Frankel was rumored to have given a high-profile filly a \"milkshake\" — a high dose of baking soda intended to increase endurance — before a race in Kentucky."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "milkshake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ccd141d-43a1-3e18-b868-91399d2c4fa5",
                                        "entry_id": "f65b0663-df4b-3827-b4bd-8c5fda41b727",
                                        "glosses": [
                                            "To administer an alkaline supplement to (a horse) to improve its racing performance."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01de2880-8319-47ab-a9db-d98e6a040ec7",
                                                "sense_id": "2ccd141d-43a1-3e18-b868-91399d2c4fa5",
                                                "text": "The name of the horse who was milkshaked was A One Rocket.\nMartin would later go on to plead guilty to the milkshaking incident and ultimately to two federal charges of conspiracy to commit wire fraud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ada92879-b78e-3e3a-bca8-941f2d3bddd9",
                                        "entry_id": "f65b0663-df4b-3827-b4bd-8c5fda41b727",
                                        "glosses": [
                                            "To throw a milkshake at (a person)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "neologism",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1289bbb0-9d50-42ea-8029-b127c2b5e936",
                                                "sense_id": "ada92879-b78e-3e3a-bca8-941f2d3bddd9",
                                                "text": "A politician was milkshaked during the protest."
                                            },
                                            {
                                                "example_id": "d1b70c56-c879-4ebb-b44c-d5ceb516734b",
                                                "sense_id": "ada92879-b78e-3e3a-bca8-941f2d3bddd9",
                                                "text": "Carl Benjamin, another controversial candidate in the European elections, was milkshaked four times last week. […] The most recent milkshaking target is the former leader of Benjamin’s party, Nigel Farage, who left UKIP after it tried to admit Robinson as a member, claiming the party was fixated on Islam."
                                            },
                                            {
                                                "example_id": "0bf589e4-dd53-49cf-b60b-916980b8b0d3",
                                                "sense_id": "ada92879-b78e-3e3a-bca8-941f2d3bddd9",
