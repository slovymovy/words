                                "example_id": "43d24557-d336-4217-bcd1-8a690533ca3b",
                                "sense_id": "d3f419d2-a68e-3f63-aeae-237bff9b2e72",
                                "text": "'Waarom niet', zegt de zeisenman, 'een uurtje heb ik wel'..."
                            }
                        ]
