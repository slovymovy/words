                        "entry_id": "0bfe7493-53ac-3432-bfcb-1ff52fee5365",
                        "glosses": [
                            "A bone found in the penis of some placental mammals."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a466c569-1dc3-4b5f-88cc-cdad9bbeb224",
                                "sense_id": "42204b3c-c3af-3ab7-8e2d-eac1ed8711d9",
                                "text": "Bacula can be straight rods, s-shaped curves, or even bizarre, flared scoops."
                            }
                        ]
                    },
                    {
                        "sense_id": "284a6b9f-9798-3fbd-a626-f2558a3892bc",
                        "entry_id": "0bfe7493-53ac-3432-bfcb-1ff52fee5365",
                        "glosses": [
                            "A small rod-like structure found in spores and pollen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89e3d229-2569-4e60-b70f-ee1f474c29cc",
                                "sense_id": "284a6b9f-9798-3fbd-a626-f2558a3892bc",
                                "text": "The sexine usually consists of two main parts, a partially or wholly covering layer — the tectum (roof) and below that the rods or rod-like elements — the bacules (baculum, columella)."
                            }
                        ]
                    }
