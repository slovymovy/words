                        "examples": [
                            {
                                "example_id": "20dc27a3-6124-4e41-b9f9-f528c72161b5",
                                "sense_id": "1ba9b9de-f560-3476-9b01-28651591f13f",
                                "text": "Het was haar niet genoeg geweest om zich tussen de schone schijn van het leven van de Schlosses te bewegen, nee, ze had nog dichterbij willen komen, bij de littekens en de puistjes en de hete rode massa van hun hart."
                            },
                            {
                                "example_id": "e36c51c9-999d-4b0e-8da0-412360423243",
                                "sense_id": "1ba9b9de-f560-3476-9b01-28651591f13f",
                                "text": "Hoezo? Is er iets mee?' Ze liet haar duim over de hals glijden, een schone veeg door het stof."
                            }
                        ]
                    }
                ],
