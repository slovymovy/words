                        "glosses": [
                            "Cabane traditionnelle des propriétaires de bateau de Biarritz, localité française des Pyrénées-Atlantiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f15dce35-07c9-471e-869f-d1bad341186f",
                                "sense_id": "f4dd45f1-fd7d-3e1b-b198-94d1de48e29c",
                                "text": "Ces derniers avaient quasiment disparu, leurs pittoresques cabanes appelées « crampottes » se transformaient peu à peu en boutiques, et la principale activité du porte était la plaisance."
                            },
                            {
                                "example_id": "e5142cbc-bf5f-4f55-9f49-fb6fd7f8becf",
                                "sense_id": "f4dd45f1-fd7d-3e1b-b198-94d1de48e29c",
                                "text": "Bien plus qu’une simple cabane, la crampotte est un prolongement rudimentaire du véritable chez-soi."
                            },
                            {
                                "example_id": "02bd28ff-0308-4348-9086-bf1153af6e26",
                                "sense_id": "f4dd45f1-fd7d-3e1b-b198-94d1de48e29c",
                                "text": "Yves a patienté 19 ans avant de pouvoir poser son matériel de pêche dans \"sa\" crampotte."
                            }
                        ]
