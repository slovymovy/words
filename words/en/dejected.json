                            }
                        },
                        {
                            "text": "She sat in a corner with a <w>dejected</w> look on her face, refusing to speak to anyone.",
                            "target_lang_translations": {
                                "ru": "Она сидела в углу с <w>унылым</w> выражением лица, отказываясь с кем-либо разговаривать."
                            }
                        }
                    ],
