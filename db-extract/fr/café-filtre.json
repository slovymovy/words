                    {
                        "sense_id": "543704c6-848d-3a5a-adfb-c6c65dc74505",
                        "entry_id": "f9cb8052-390c-3e60-a2c5-51274b54eea9",
                        "glosses": [
                            "Sorte de café préparé par une lente lixiviation de grains de café moulus, à l’eau bouillante, à travers un filtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b09c1244-9380-43d6-90d1-7ac64c32f4ad",
                                "sense_id": "543704c6-848d-3a5a-adfb-c6c65dc74505",
                                "text": "Ils avaient terminé leur repas et sirotaient un café-filtre, en regardant de loin le mouvement de la rue."
                            },
                            {
                                "example_id": "674e7033-756c-4ae1-9ae4-c5ce4f7b8f5c",
                                "sense_id": "543704c6-848d-3a5a-adfb-c6c65dc74505",
                                "text": "Le temps qui, auprès d’elle s’écoulait si vite à l’accoutumée, passait à présent avec d’horripilantes lenteurs de café-filtre."
                            }
                        ]
                    }
                ],
