                        "fiche produit"
                    ]
                },
                {
                    "sense_id": "2551feb1-b07a-30d9-9bb7-708fcd08394e",
                    "sense_definition": "Plaquette de plastique, de bois ou d'ivoire servant de marque ou de jeton dans certains jeux.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque joueur reçoit dix jetons et une <w>fiche</w> au début de la partie."
                        },
                        {
                            "text": "Il a perdu toute sa mise et n'a plus une seule <w>fiche</w> sur le tapis."
                        }
                    ],
                    "synonyms": [
                        "jeton"
                    ],
                    "common_phrases": [
                        "fiche de consolation"
                    ]
                },
                {
                    "sense_id": "1a8e07e6-d1a7-395c-8914-ddb9768093e9",
                    "sense_definition": "Petite cheville ou tige métallique servant à suspendre un objet ou à relier des pièces de ferronnerie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quincaillerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan enfonce une petite <w>fiche</w> dans le mur pour y accrocher le tableau ancien."
                        },
                        {
                            "text": "La porte grince parce que sa <w>fiche</w> est légèrement tordue."
