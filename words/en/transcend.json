{
    "word_family": [
        "transcendence",
        "transcendent",
        "transcendental",
        "transcendentalism"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c1933073-69f7-3c4c-b5fc-2351f6db31b2",
                    "sense_definition": "To pass beyond the limits of something, such as a boundary, experience, or understanding.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beyond limits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beauty of the music seemed to <w>transcend</w> the boundaries of language and culture.",
                            "target_lang_translations": {
                                "ru": "Красота этой музыки, казалось, <w>переступала пределы</w> языковых и культурных границ."
                            }
                        },
                        {
                            "text": "Great art has the power to <w>transcend</w> time and remain relevant for centuries.",
                            "target_lang_translations": {
                                "ru": "Великое искусство обладает силой <w>преодолевать</w> время и оставаться актуальным на протяжении веков."
                            }
                        }
                    ],
                    "synonyms": [
                        "exceed",
                        "go beyond",
                        "surpass"
                    ],
                    "antonyms": [
                        "fall short of"
                    ],
                    "common_phrases": [
                        "transcend boundaries",
                        "transcend time",
                        "transcend understanding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выходить за рамки или границы чего-либо, например, опыта, понимания или культурных барьеров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переступать пределы",
                                "target_lang_sense_clarification": "выходить за границы чего-либо"
                            },
                            {
                                "target_lang_word": "преодолевать",
                                "target_lang_sense_clarification": "справляться с ограничениями или барьерами"
                            },
                            {
                                "target_lang_word": "выходить за рамки",
                                "target_lang_sense_clarification": "быть шире или масштабнее ограничений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "987f9d33-8746-3bcd-bc81-742a816cef4a",
                    "sense_definition": "To be better or greater than something else in intensity, power, or quality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "superiority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her dedication to the cause <w>transcends</w> all her other professional interests.",
                            "target_lang_translations": {
                                "ru": "Ее преданность делу <w>превосходит</w> все остальные профессиональные интересы."
                            }
                        },
                        {
                            "text": "The athlete's performance <w>transcended</w> all expectations and set a new world record.",
                            "target_lang_translations": {
                                "ru": "Выступление атлета <w>превзошло</w> все ожидания и установило новый мировой рекорд."
                            }
                        }
                    ],
                    "synonyms": [
                        "excel",
                        "surpass",
                        "better",
                        "outstrip"
                    ],
                    "common_phrases": [
                        "transcend expectations",
                        "transcend all others"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть лучше, сильнее или значимее чего-либо другого по качеству или интенсивности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "превосходить",
                                "target_lang_sense_clarification": "быть выше по качеству или силе"
                            },
                            {
                                "target_lang_word": "превышать",
                                "target_lang_sense_clarification": "быть больше определенных ожиданий или норм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cba417ed-398a-3d4d-8e66-d6a1dd21df4c",
                    "sense_definition": "To climb or mount upward; to rise above a physical height.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aircraft continued to <w>transcend</w> the thick layer of clouds until it reached the clear sky.",
                            "target_lang_translations": {
                                "ru": "Самолет продолжал <w>подниматься над</w> плотным слоем облаков, пока не достиг чистого неба."
                            }
                        },
                        {
                            "text": "In the poem, the soul is described as trying to <w>transcend</w> the earthly realm to reach the stars.",
                            "target_lang_translations": {
                                "ru": "В стихотворении душа описывается как пытающаяся <w>вознестись</w> над земным миром, чтобы достичь звезд."
                            }
                        }
                    ],
                    "synonyms": [
                        "ascend"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in a purely physical sense in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подниматься вверх или возвышаться над физической высотой или земным миром (часто в поэтическом контексте)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возноситься",
                                "target_lang_sense_clarification": "подниматься ввысь, часто духовно"
                            },
                            {
                                "target_lang_word": "превосходить",
                                "target_lang_sense_clarification": "в значении возвышения над чем-то материальным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}