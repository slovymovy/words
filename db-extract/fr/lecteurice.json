                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "A person employed by a publisher to read works submitted for publication and determine their merits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6132a608-40d5-452c-bc34-c343a1ddee9d",
                                                "sense_id": "a504213d-e729-35d3-a6b1-3d7dbeb7623e",
                                                "text": "They were dog-eared by the hands of many a publisher's-reader and postman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba0a2613-176a-3e62-9851-ac1f44786a8a",
                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "A position attached to aristocracy, or to the wealthy, with the task of reading aloud, often in a foreign language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ab8f335-1a01-4923-ab6c-9b814c4de7c6",
                                                "sense_id": "ba0a2613-176a-3e62-9851-ac1f44786a8a",
                                                "text": "\"I am commissioned by the Queen to offer you the place of Italian reader; and I assure you the offer was made with many kind expressions of interest. You will enter upon the duties, which are almost nominal, immediately.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6917c91e-f0e5-375d-a8a5-b3a18b9aff24",
                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "A university lecturer ranking below a professor."
