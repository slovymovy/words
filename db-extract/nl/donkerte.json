                "senses": [
                    {
                        "sense_id": "9df55f2e-b9df-36af-b87f-ee3574cf614b",
                        "entry_id": "a2f208ac-b8ad-327e-aca7-33a07904f7a3",
                        "glosses": [
                            "donkere plaats"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "12314d26-c9ed-3bb0-a78d-33c34bdb0acc",
                        "entry_id": "a2f208ac-b8ad-327e-aca7-33a07904f7a3",
                        "glosses": [
                            "duisternis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd544106-616b-4566-9aa3-98722a3cd359",
                                "sense_id": "12314d26-c9ed-3bb0-a78d-33c34bdb0acc",
                                "text": "Het stuk achteraan was een donkere functieloze plek, er kwam helemaal geen daglicht. Katleen vond het een onprettige ruimte: ‘Ik voelde de donkerte soms echt op me wegen.’"
                            },
                            {
                                "example_id": "d2221284-4f6c-4990-930d-c0b954da511b",
                                "sense_id": "12314d26-c9ed-3bb0-a78d-33c34bdb0acc",
                                "text": "Bij vervanging van straatlantaarns houdt de gemeente Losser nadrukkelijk rekening met veiligheid en beleving waarbij er ook aandacht is voor energie besparen, beperken van lichtvervuiling en bescherming van donkerte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de04279f-460a-40ee-94d3-202841bec869",
                        "source_entry_id": "a2f208ac-b8ad-327e-aca7-33a07904f7a3",
                        "source_sense_id": "9df55f2e-b9df-36af-b87f-ee3574cf614b",
                        "source_sense_description": "duister",
                        "target_lang_word": "darkness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "darkness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68cea15d-f709-3bed-a084-69d572d10413",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "The state of being dark; lack of light; the absolute or comparative absence of light."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cc5dd6d-0168-480b-a692-441bc0818d9f",
                                                "sense_id": "68cea15d-f709-3bed-a084-69d572d10413",
                                                "text": "The darkness of the room made it difficult to see."
                                            },
                                            {
                                                "example_id": "478bcd1c-8307-4a19-8bbe-6b8e190ba5bd",
                                                "sense_id": "68cea15d-f709-3bed-a084-69d572d10413",
                                                "text": "Over everything was darkness and thick silence, and the smell of dust and sunflowers."
                                            },
                                            {
                                                "example_id": "df021b4d-0341-418b-bef7-70fd35b6eedd",
                                                "sense_id": "68cea15d-f709-3bed-a084-69d572d10413",
                                                "text": "Turning back, then, toward the basement staircase, she began to grope her way through blinding darkness, but had taken only a few uncertain steps when, of a sudden, she stopped short and for a little stood like a stricken thing, quite motionless save that she quaked to her very marrow in the grasp of a great and enervating fear."
                                            },
                                            {
                                                "example_id": "b45c5c6d-9691-4d28-94f5-72e95b6861db",
                                                "sense_id": "68cea15d-f709-3bed-a084-69d572d10413",
                                                "text": "Darkness imprisoning me\n All that I see\n Absolute horror\n I cannot live\n I cannot die\n Trapped in myself\n Body my holding cell"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "747b7b69-32a7-368c-bb10-9e772f26a83f",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "The state or quality of reflecting little light, of tending to a blackish or brownish color."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1abdc95b-70e7-4e2f-b100-498424147bd7",
                                                "sense_id": "747b7b69-32a7-368c-bb10-9e772f26a83f",
                                                "text": "The darkness of her skin betrayed her Mediterranean heritage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6832ef4-ce1b-3c5f-aeff-d93397add0e4",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Any space that such colour pervades."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18de698d-1764-4bf2-b6d4-4b9f478ed08a",
                                                "sense_id": "c6832ef4-ce1b-3c5f-aeff-d93397add0e4",
                                                "text": "Out of the darkness came some flickers of light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdf2789d-7895-3a51-ac46-ff5be5a46ab7",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Gloom; gloominess; depression."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd9f8091-afe3-35e2-bb40-64f86dce0658",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "The product of being dark."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fe64d93-e6ea-3479-b33e-67a96ac5f23b",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Lack of understanding or compassion; spiritual or mental blindness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6f3857d-6d43-47c4-923b-56651316e284",
                                                "sense_id": "3fe64d93-e6ea-3479-b33e-67a96ac5f23b",
                                                "text": "And now, the prophecy. One will come, the voice from the outer world, bringing the holy war, the jihad, which will cleanse the universe and bring us out of darkness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cedf43a2-b62c-3ffc-9687-e7161d07a83a",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Secrecy; concealment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a25fbc61-fca7-3a86-b312-1c3008a08723",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Lack of knowledge; obscurity or meaning or intelligibility; the unknown."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "313628f3-a4a4-401f-babd-169003d81dda",
                                                "sense_id": "a25fbc61-fca7-3a86-b312-1c3008a08723",
                                                "text": "It was just robbery with violence, aggravated murder on a great scale, and men going at it blind - as is very proper for those who tackle a darkness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1e410a3-c7b7-3e4b-9abe-44384fd69c04",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Nothingness, vanity, emptiness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "771b2ff7-163c-4c9b-bef4-55b8a96d5bab",
                                                "sense_id": "f1e410a3-c7b7-3e4b-9abe-44384fd69c04",
                                                "text": "My own dim life should teach me this,\n⁠That life shall live for evermore,\n⁠Else earth is darkness at the core,\nAnd dust and ashes all that is; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d2169a6-41b0-3fbb-9583-f0a40f63c82c",
                                        "entry_id": "1e8d84dc-546c-3747-8bf5-4301cac7b09f",
                                        "glosses": [
                                            "Hell."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bec5df3-5a1c-448d-90c1-88099f242fef",
                                                "sense_id": "7d2169a6-41b0-3fbb-9583-f0a40f63c82c",
                                                "text": "Shepard: Can you tell me anything about the beacon?\nDr. Warren: It's some type of data module from a galaxy-wide communications network. Remarkably well-preserved. It could be the greatest scientific discovery of our lifetime!\nDr. Warren: Miraculous new technologies. Groundbreaking medical advances. Who knows what secrets are locked inside?\nDr. Manuel: We have unearthed the heart of evil. Awakened the beast. Unleashed the darkness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
