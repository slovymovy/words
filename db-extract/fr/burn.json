                        ],
                        "form": "burns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd0496ff-05da-3a76-9a05-b83f14f591cd",
                        "entry_id": "48694db2-19dc-3544-9e23-fde17587eb82",
                        "glosses": [
                            "Figure acrobatique consistant à faire patiner le ou les pneus arrières en accélérant à fond, tout en bloquant totalement ou partiellement la ou les roues avant."
                        ],
                        "tags": [
                            "Sport mécanique"
                        ],
                        "examples": [
                            {
                                "example_id": "55091fd2-63e9-4f33-857e-e93d63977ff4",
                                "sense_id": "cd0496ff-05da-3a76-9a05-b83f14f591cd",
                                "text": "Pas de burns, ces ronflements de moteur qui vous réveilleraient tout un quartier et dégagent des tombereaux de fumée."
                            },
                            {
                                "example_id": "72397927-6cc2-44b3-9cf4-31988205c8d6",
                                "sense_id": "cd0496ff-05da-3a76-9a05-b83f14f591cd",
                                "text": "Après un bref tour du propriétaire, les enfants du couple princier ont été invités à enfourcher la célèbre moto de Lewis Hamilton. La fameuse MV Agusta avec laquelle le Britannique a encore régalé les spectateurs de la fan zone d’un burn."
                            },
                            {
                                "example_id": "10c594cc-b4da-4ad2-99e7-158c33e45f2a",
                                "sense_id": "cd0496ff-05da-3a76-9a05-b83f14f591cd",
                                "text": "Alvaro redémarra aussi sec faisant fumer le caoutchouc en un copieux « burn » façon dragster, la Volvo resta collée au pare-choc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1527d9e7-3843-4c5c-8703-fdc36ba017bb",
                        "source_entry_id": "48694db2-19dc-3544-9e23-fde17587eb82",
                        "source_sense_id": "cd0496ff-05da-3a76-9a05-b83f14f591cd",
                        "target_lang_word": "burnout",
