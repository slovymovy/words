                                "sense_id": "580eaa3d-dede-3bb4-b0d3-eee9478471ed",
                                "text": "Die Neurochirurgie ist ein besonders anspruchsvoller Bereich der Medizin."
                            },
                            {
                                "example_id": "17e1c10a-dfce-4281-a294-13daedbc0941",
                                "sense_id": "580eaa3d-dede-3bb4-b0d3-eee9478471ed",
                                "text": "Paul Rother, Professor für Neurochirurgie, hält morgen einen Gastvortrag."
                            },
                            {
                                "example_id": "19e62e8c-a051-4e32-840d-ccb4d9aeef44",
                                "sense_id": "580eaa3d-dede-3bb4-b0d3-eee9478471ed",
                                "text": "Verbesserte Methoden der Neurochirurgie haben schon vielen Menschen das Leben gerettet."
                            }
                        ],
