{
    "word_family": [
        "dispense",
        "dispensable",
        "indispensable",
        "dispenser",
        "dispensary",
        "dispensational"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9fc07ffb-48ee-324a-b08c-5d42451e1df1",
                    "sense_definition": "An official exemption from a rule, law, or usual requirement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "exemption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student received a special <w>dispensation</w> to take the final examination late due to illness."
                        },
                        {
                            "text": "Officials decided to grant a <w>dispensation</w> from the standard building regulations for the historic site."
                        }
                    ],
                    "synonyms": [
                        "exemption",
                        "immunity",
                        "exception"
                    ],
                    "common_phrases": [
                        "special dispensation",
                        "grant a dispensation"
                    ]
                },
                {
                    "sense_id": "2aa3ae2a-483b-3994-8cb9-9b7bd45c1324",
                    "sense_definition": "The act of distributing or dealing something out to others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rapid <w>dispensation</w> of emergency medical supplies saved many lives after the earthquake."
                        },
                        {
                            "text": "Aid organizations supervised the careful <w>dispensation</w> of food and clean water in the refugee camp."
                        }
                    ],
                    "synonyms": [
                        "distribution",
                        "allocation",
                        "allotment"
                    ],
                    "common_phrases": [
                        "dispensation of justice"
                    ]
                },
                {
                    "sense_id": "13fdad76-2249-3d85-8688-0380b1a75c52",
                    "sense_definition": "An exemption granted by religious authority from an ecclesiastical law or vow.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "exemption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had to obtain a papal <w>dispensation</w> before they could be legally married in church."
                        },
                        {
                            "text": "The bishop granted a <w>dispensation</w> releasing the monk from his religious vows."
                        }
                    ],
                    "common_phrases": [
                        "papal dispensation"
                    ]
                },
                {
                    "sense_id": "e3eb903e-440c-334b-9bf3-a4da61378965",
                    "sense_definition": "A general state of things or an ordained religious order or system, especially one established by divine agency.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "theology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The theologian studied the historical transition from the Mosaic to the Christian <w>dispensation</w>."
                        },
                        {
                            "text": "Under the new economic <w>dispensation</w>, local communities gained greater control over their resources."
                        }
                    ],
                    "synonyms": [
                        "order",
                        "regime",
                        "system"
                    ],
                    "common_phrases": [
                        "new dispensation",
                        "Christian dispensation"
                    ]
                },
                {
                    "sense_id": "ef029fd3-a2ce-3998-8748-f098aaccc925",
                    "sense_definition": "The distribution or ordering of human events and fortunes by divine providence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elders regarded the prolonged drought as a mysterious <w>dispensation</w> of God's will."
                        },
                        {
                            "text": "Through every hardship, she accepted her fate as part of a divine <w>dispensation</w>."
                        }
                    ],
                    "synonyms": [
                        "providence"
                    ],
                    "common_phrases": [
                        "divine dispensation"
                    ]
                },
                {
                    "sense_id": "9c6db17c-e705-346a-a2e8-a873bd942f52",
                    "sense_definition": "Something that is dispensed, bestowed, or given out to a person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each survivor received a modest financial <w>dispensation</w> from the disaster recovery fund."
                        },
                        {
                            "text": "The committee reviewed every monetary <w>dispensation</w> given out during the last financial year."
                        }
                    ],
                    "synonyms": [
                        "allotment",
                        "grant"
                    ]
                }
            ]
        }
    ]
}