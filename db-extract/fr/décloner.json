                "senses": [
                    {
                        "sense_id": "45f7b92d-c121-3a58-ac74-8b22c9b298b6",
                        "entry_id": "9039c116-3c0a-3511-9ffb-ce24fc504d5b",
                        "glosses": [
                            "Faire perdre son caractère cloné à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dea8b3a-cb92-4470-a651-8296a0e36139",
                                "sense_id": "45f7b92d-c121-3a58-ac74-8b22c9b298b6",
                                "text": "Le monde est cloné. Seule la littérature, copie vraie de la réalité parallèle et apocryphe, peut le décloner."
                            },
                            {
                                "example_id": "0691719f-3c52-4359-ba36-29c2c32d9dc6",
                                "sense_id": "45f7b92d-c121-3a58-ac74-8b22c9b298b6",
                                "text": "Les trois amis pouvaient, en toute confiance, parler de ces moments où le stress oxydatif court-circuitait leur génome anti-I.D. en les faisant décloner."
                            }
                        ]
                    }
