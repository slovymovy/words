                        "examples": [
                            {
                                "example_id": "26aaac02-456a-42d8-a5b8-19d2b0a64951",
                                "sense_id": "2e03775a-27c6-3edf-b88a-1d0606dc43d6",
                                "text": "princely birth or character"
                            },
                            {
                                "example_id": "91048db5-b707-44cc-b128-8370b665a01d",
                                "sense_id": "2e03775a-27c6-3edf-b88a-1d0606dc43d6",
                                "text": "And when the princely Perſean Diadem,\nShall ouerweigh his wearie witleſſe head,\nAnd fall like mellowed fruit, with ſhakes of death,\nIn faire Perſea noble Tamburlain\nShall be my Regent, and remaine as King:"
                            }
                        ]
                    },
                    {
                        "sense_id": "924dc5e3-65d8-3df5-9e71-d20a8944fd30",
                        "entry_id": "9385031f-9fdc-3f17-a0d3-58c4dedb0ea3",
                        "glosses": [
                            "Similar or comparable to a prince."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5e1dff24-ff1f-371f-ab8c-66a726f7c040",
                        "entry_id": "9385031f-9fdc-3f17-a0d3-58c4dedb0ea3",
                        "glosses": [
                            "Befitting a prince."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ece7cf4f-b18a-4be0-b22b-cb009d8c5710",
                                "sense_id": "5e1dff24-ff1f-371f-ab8c-66a726f7c040",
                                "text": "a princely sum"
                            },
                            {
                                "example_id": "5258f5e9-d97d-4b1c-8b07-a00cf417bfc6",
                                "sense_id": "5e1dff24-ff1f-371f-ab8c-66a726f7c040",
                                "text": "No expense was spared in making it a princely residence."
                            }
                        ]
                    }
