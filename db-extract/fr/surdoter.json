                "senses": [
                    {
                        "sense_id": "583b7bdc-577b-3721-8337-90d4406537b8",
                        "entry_id": "79ecbb94-80ff-3685-a507-510bc2f8c932",
                        "glosses": [
                            "Doter de façon excessive, ou plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f204068d-f2b8-40ee-ba8c-225f63f40c54",
                                "sense_id": "583b7bdc-577b-3721-8337-90d4406537b8",
                                "text": "La gestion répond qu'il y a tellement de mouvement au niveau de la première ligne qu'ils peuvent se permettre de surdoter les postes en question."
                            },
                            {
                                "example_id": "25f60563-c8a6-4ef2-aa2d-56ffdaf2547b",
                                "sense_id": "583b7bdc-577b-3721-8337-90d4406537b8",
                                "text": "Surdoter un secteur se fait toujours au détriment d'un autre."
                            },
                            {
                                "example_id": "7f7b808f-829b-4ab7-bd77-45c323153b10",
                                "sense_id": "583b7bdc-577b-3721-8337-90d4406537b8",
                                "text": "Nous privilégions d'étendre nos dons à de nouvelles écoles plutôt qu'à surdoter nos 4 premières écoles."
                            }
                        ]
                    }
