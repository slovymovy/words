                                            {
                                                "example_id": "109b23a3-68e8-48c3-b3d5-fc736a775eb6",
                                                "sense_id": "3b77b78f-f560-3f67-9f59-7b4f00dd7a65",
                                                "text": "„Ins Basislager am Fuß des Bergs begleiteten ihn sein Bruder Vincent und sein Vater Alfred, der als junger Mann Touren im Himalaja unternommen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba7ccb7f-d4d8-41cd-8bb9-a6d658b27577",
                        "source_entry_id": "9d9c2895-3649-310d-a132-f7b8444d536c",
