                        "glosses": [
                            "Relatif au néopositivisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ade6a7c6-9270-4ead-aadd-4663317dd8a0",
                                "sense_id": "7eb1afd8-6aca-3479-8cd5-4d47deba78ef",
                                "text": "Bien que l’interprétation standard de la mécanique quantique par l’Ecole de Copenhague (N. Bohr) soit néopositiviste, orbitales moléculaires et surtout résonance constituent une approche platonicienne, par bien des points idéaliste, de la molécule."
                            }
                        ]
