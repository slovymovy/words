                "senses": [
                    {
                        "sense_id": "0acd8801-cc69-34d4-a720-2ad28abeed4d",
                        "entry_id": "0c8f73d8-7443-3cfc-8d65-5aaa9fca0f4f",
                        "glosses": [
                            "Muskel, der ein Körperglied streckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca8c5138-2dfd-45ea-b1a5-ec877752fa0b",
                                "sense_id": "0acd8801-cc69-34d4-a720-2ad28abeed4d",
                                "text": "„Andere Autoren meinen, die Extensoren seien weniger mit Blutgefässen versehen als die Flexoren und dieses Missverhältnis im Blutreichtum habe die raschere Atrophie der weniger genährten Muskeln zur Folge.“"
                            },
                            {
                                "example_id": "cfc6feea-19c9-4162-a2ae-34e33c74104f",
                                "sense_id": "0acd8801-cc69-34d4-a720-2ad28abeed4d",
                                "text": "„Der Extensor carpi ulnaris ist gelähmt, so daß die Hand bei der Streckung gegen Widerstand eine Radialkantung erfährt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
