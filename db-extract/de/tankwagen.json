                "senses": [
                    {
                        "sense_id": "c44f4ed7-c0c9-34eb-97e2-71ab7ce2ba40",
                        "entry_id": "cc58c8a0-b66b-3224-8cdb-b867b23827a2",
                        "glosses": [
                            "Lastkraftwagen und/oder Anhänger, die flüssige oder gasförmige Güter in einem Tank transportieren können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab76259e-c4d9-442d-93e5-b974e2ee620e",
                                "sense_id": "c44f4ed7-c0c9-34eb-97e2-71ab7ce2ba40",
                                "text": "„Womit täglich im Stundentakt die güllegefüllten Tankwagen über die Ringstraßen der Stadt donnern; was zu Protesten der lärm- und geruchsbelästigten Bevölkerung führt; weshalb Lukas Piontek für viele Leute zum Feindbild geworden ist.“"
                            },
                            {
                                "example_id": "f3cac57d-b97c-42c6-83f5-1661786ba837",
                                "sense_id": "c44f4ed7-c0c9-34eb-97e2-71ab7ce2ba40",
                                "text": "„Die Hockklosetts der alten Mietshäuser, eins auf jedem Treppenabsatz, mit zwei geriffelten, schuhgroßen Erhöhungen aus Zement links und rechts der Öffnung, damit der locataire nicht ausrutschte, entleerten sich in Senkgruben, deren Inhalt nachts in von Pferden gezogene Tankwagen gepumpt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85657a74-56e2-4dfa-888d-17d2b33aabc3",
                        "source_entry_id": "cc58c8a0-b66b-3224-8cdb-b867b23827a2",
                        "source_sense_id": "c44f4ed7-c0c9-34eb-97e2-71ab7ce2ba40",
                        "source_sense_description": "Fahrzeug, das mit flüssigen oder gasförmigen Stoffen beladen werden kann",
                        "target_lang_word": "camion-citerne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camion-citerne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e98962bd-3c4d-3e0f-bdc6-50aac30f1f4e",
                                        "entry_id": "9dbbf9a1-9c9a-3985-9751-3ed99c0c420c",
                                        "glosses": [
                                            "Camion dont la charge est constituée d’une citerne, utilisé pour le transport de liquides, de gaz ou de pulvérulents stockés en vrac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29e8b8f8-ef4b-40e4-82fb-7ca07985061c",
                                                "sense_id": "e98962bd-3c4d-3e0f-bdc6-50aac30f1f4e",
                                                "text": "Un grondement de tonnerre derrière eux. Le camion-citerne venait de passer au ras du pare-chocs de la Suzuki qui se mit à redescendre la pente trop forte pour elle."
                                            },
                                            {
                                                "example_id": "68ca47af-1135-4bc2-8940-69189e103186",
                                                "sense_id": "e98962bd-3c4d-3e0f-bdc6-50aac30f1f4e",
                                                "text": "Rynner voudrait bien voir revenir le second camion-citerne qui est parti, voilà déjà déjà un bon moment, pour faire le plein au riachuelo voisin."
                                            },
                                            {
                                                "example_id": "1cbe9422-8c93-4a06-94f7-7eca8760304e",
                                                "sense_id": "e98962bd-3c4d-3e0f-bdc6-50aac30f1f4e",
                                                "text": "Et c'est au Maroc qu'ils entendaient se rendre, dès qu'ils pourraient faire le plein de leurs avions, ce à quoi ils étaient résolus à parvenir, dussent-ils s'emparer pour cela du camion-citerne les armes à la main."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
