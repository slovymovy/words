                                "target_word": "mouterij",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "84049c9e-a44f-38dc-a93a-396b4d8befe4",
                                        "entry_id": "3328c0a2-9aa1-3849-862b-b2f3fe342e55",
                                        "glosses": [
                                            "fabriek waar van granen mout wordt gemaakt, door het in water te weken waardoor het onkiemt, en het daarna te drogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d76562ef-4237-42e9-8df6-ec73374f585e",
                                                "sense_id": "84049c9e-a44f-38dc-a93a-396b4d8befe4",
                                                "text": "Heineken heeft in totaal zes productiefaciliteiten in Egypte. Naast de twee brouwerijen zijn dat twee frisdrankfabrieken, een wijnmakerij en een mouterij."
                                            },
                                            {
                                                "example_id": "85598614-dbd1-441e-8ff0-e1e6d02baa89",
                                                "sense_id": "84049c9e-a44f-38dc-a93a-396b4d8befe4",
                                                "text": "Van de brouwerij bleven drie gebouwen over. In één daarvan, de lagerkelder, waar vroeger het bier stond te rijpen, brouwen wij nu ons bier. We hebben ook een mouterij. Daarboven zijn nu woningen."
                                            },
                                            {
                                                "example_id": "12bb6631-bc67-4a5a-b153-3382f1a30591",
                                                "sense_id": "84049c9e-a44f-38dc-a93a-396b4d8befe4",
                                                "text": "Het doel verwezenlijken, een eigen mouterij openen voor het ontkiemen en drogen van graan, bleek echter geen sinecure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
