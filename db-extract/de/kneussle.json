                "senses": [
                    {
                        "sense_id": "6d7c859a-ebb6-3df8-a9a9-22598a399248",
                        "entry_id": "b1184f1f-5dc1-3887-a87f-8a2b7da78176",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9101f095-7d76-42a4-b2d1-1df89fc1a02a",
                                "sense_id": "6d7c859a-ebb6-3df8-a9a9-22598a399248",
                                "text": "Frau Kneussle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "61a753c3-2a0c-4a8c-8f8c-476567abf37b",
                                "sense_id": "6d7c859a-ebb6-3df8-a9a9-22598a399248",
                                "text": "Herr Kneussle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d2a6afb5-b80c-42c2-94d3-cb1a99bbeb86",
                                "sense_id": "6d7c859a-ebb6-3df8-a9a9-22598a399248",
                                "text": "Die Kneussles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a8241684-1b02-4938-9865-a0608cfdfde2",
                                "sense_id": "6d7c859a-ebb6-3df8-a9a9-22598a399248",
                                "text": "Der Kneussle trägt nie die Schals, die die Kneussle ihm strickt."
                            },
                            {
                                "example_id": "9d893beb-ca04-40d5-9c96-65d213e771cc",
                                "sense_id": "6d7c859a-ebb6-3df8-a9a9-22598a399248",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kneussle kommt, geht der Herr Kneussle.“"
                            },
                            {
                                "example_id": "cfb0d4c5-b8cc-4f17-8d0e-68ffb275e502",
                                "sense_id": "6d7c859a-ebb6-3df8-a9a9-22598a399248",
                                "text": "Kneussle kommt und geht."
                            },
                            {
                                "example_id": "718c9ce9-4cde-41ba-8f64-29c2e7753951",
                                "sense_id": "6d7c859a-ebb6-3df8-a9a9-22598a399248",
                                "text": "Kneussles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
