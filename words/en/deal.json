                                "target_lang_word": "выгодная сделка",
                                "target_lang_sense_clarification": "удачная покупка"
                            },
                            {
                                "target_lang_word": "предложение",
                                "target_lang_sense_clarification": "акция, скидка"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "okazja",
                                "target_lang_sense_clarification": "korzystny zakup"
                            },
                            {
                                "target_lang_word": "świetny interes",
                                "target_lang_sense_clarification": "dobra cena"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86add35f-7ecb-301d-a71e-3a171fd95fef",
