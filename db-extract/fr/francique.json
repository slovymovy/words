            {
                "entry_id": "c7364e00-ad42-39ce-aa56-f7674fdced04",
                "word": "francique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "562a723e-60d1-4a01-8940-20f116e86da7",
                        "entry_id": "c7364e00-ad42-39ce-aa56-f7674fdced04",
                        "tags": [
                            "plural"
                        ],
                        "form": "franciques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50e32cf1-8980-3326-88c4-6175a7fd9c3a",
                        "entry_id": "c7364e00-ad42-39ce-aa56-f7674fdced04",
                        "glosses": [
                            "Langue des Francs ou des régions peuplées par les Francs."
                        ],
                        "tags": [],
                        "note": "Le terme exact est vieux-francique ou vieux bas francique (code ISO 639-3 frk), pour le distinguer des parlers franciques encore vivants",
                        "examples": [
                            {
                                "example_id": "8f309656-e686-4193-8bdd-626ba97ec8ec",
                                "sense_id": "50e32cf1-8980-3326-88c4-6175a7fd9c3a",
                                "text": "La limite entre le francique ripuaire et le roman (futur wallon, dialecte français) s'est établie sur le barrage naturel de la grande forêt d'Ardenne, qui isolait les deux groupes."
                            },
                            {
                                "example_id": "ea452396-27bf-4502-b110-1c0b121af17a",
                                "sense_id": "50e32cf1-8980-3326-88c4-6175a7fd9c3a",
                                "text": "Le vieux bas francique ne nous est transmis que très partiellement sous forme écrite : quelques mots dans la Lex Salica, la Loi salique, deux seulement chez Grégoire de Tours."
                            },
                            {
                                "example_id": "7140c3ac-48dc-49e9-8b03-bf150a200447",
                                "sense_id": "50e32cf1-8980-3326-88c4-6175a7fd9c3a",
                                "text": "Le vieux francique a formé l’une des langues souches du vieux-haut-allemand dont les écrits et les travaux de traduction des clercs copistes des grands scriptoria dans les monastères ont laissé quelques traces écrites."
                            }
                        ]
                    },
                    {
                        "sense_id": "89df1993-864e-3404-a0a2-5c959e1f6fa6",
                        "entry_id": "c7364e00-ad42-39ce-aa56-f7674fdced04",
                        "glosses": [
                            "Langue ou dialecte germanique parlés en Allemagne, au Luxembourg, en France et en Belgique."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8be1115b-6401-447e-91af-99826f97e5e6",
                        "source_entry_id": "c7364e00-ad42-39ce-aa56-f7674fdced04",
                        "target_lang_word": "Fränkisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fränkisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a42c9fb-2c81-32c5-a327-c05d2a926866",
                                        "entry_id": "16df1728-d798-3a10-9b8e-c4287a1bb258",
                                        "glosses": [
                                            "die Dialekte und Sprachen, die ihren Ursprung im Fränkischen Reich haben"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "762ce1f0-e59e-4bd9-9798-f9ad81ab7084",
                                                "sense_id": "7a42c9fb-2c81-32c5-a327-c05d2a926866",
                                                "text": "„Eine Besonderheit des Fränkischen ist, dass sich seine Dialekte über den gesamten nieder-, mittel- und oberdeutschen Sprachraum erstrecken[.]“"
                                            },
                                            {
                                                "example_id": "21a5d0ee-2247-4c84-b529-009ed11d8966",
                                                "sense_id": "7a42c9fb-2c81-32c5-a327-c05d2a926866",
                                                "text": "„Es gab ein frühes Fränkisch, Alemannisch oder Bairisch, aber es gab weder eine einheitliche Standardsprache noch eine einheitliche Schreibung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "62979357-c933-3d27-915b-6a79b60ed598",
                                        "entry_id": "16df1728-d798-3a10-9b8e-c4287a1bb258",
                                        "glosses": [
                                            "die oberdeutsche Mundart, die in Franken (Bayern) sowie Teilen Thüringens, Hessens und Baden-Württembergs gesprochen wird"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b68b1ab-b34e-410a-bbd8-c3d2b150d76b",
                                                "sense_id": "62979357-c933-3d27-915b-6a79b60ed598",
                                                "text": "„Und er ist des fränkischen Dialekts mächtig. Er weiß, dass Herzanfall auf Fränkisch Herzkaschber, tolerant dollerand, Croissant Budderhörnla und Halteverbot Haldeverbod heißt.“"
                                            },
                                            {
                                                "example_id": "df332d16-fa9a-4915-91a3-8c116ccfd26c",
                                                "sense_id": "62979357-c933-3d27-915b-6a79b60ed598",
                                                "text": "„Guttenberg hat die nach ihm benannte Bibel persönlich handkoloriert, spricht 64 Sprachen, u.a. Fränkisch und sieben Sanskrit-Dialekte, ist Unteroffizier der Reserve und AC/DC-Fan, hat einen IQ, der es jederzeit mit Stephen Hawkings Rollstuhl aufnehmen kann sowie eine Ur-Ur-Enkelin von Otto von Bismarck namens Stephanie geehelicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
