                "senses": [
                    {
                        "sense_id": "d3faef8f-f1c9-3696-852f-80904c69274d",
                        "entry_id": "80626982-a873-36ba-ac07-a99787c3b52a",
                        "glosses": [
                            "vindictiveness"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56f6e583-153a-4255-8345-598c6aa703ba",
                                "sense_id": "d3faef8f-f1c9-3696-852f-80904c69274d",
                                "text": "Жизнь интере́сна, и я люблю́ её за ту вели́кую та́йну, что в ней заключена́, я люблю́ её да́же за её жесто́кости, за свире́пую мсти́тельность и сатани́нски весёлую игру́ людьми́ и собы́тиями.",
                                "translation": "Life is interesting, and I love it for the grand mystery imprisoned within it; I love it even for its rigors, for its ferocious vindictiveness and its satanically-gay play with people and events.",
                                "english": "Life is interesting, and I love it for the grand mystery imprisoned within it; I love it even for its rigors, for its ferocious vindictiveness and its satanically-gay play with people and events."
                            }
                        ]
                    }
