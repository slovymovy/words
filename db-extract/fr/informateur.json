                    },
                    {
                        "form_id": "cf87ff2e-fe5e-4825-b57e-8b0226bcae53",
                        "entry_id": "ad5a1d6b-3fa3-3549-83f1-9a73b12954b2",
                        "tags": [
                            "feminine"
                        ],
                        "form": "informatrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f1c63e5a-066b-3ab5-80a1-2653a6e725ff",
                        "entry_id": "ad5a1d6b-3fa3-3549-83f1-9a73b12954b2",
                        "glosses": [
                            "Celui qui informe d’une nouvelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b35f582-c20a-4328-9e3b-504085955f7c",
                                "sense_id": "f1c63e5a-066b-3ab5-80a1-2653a6e725ff",
                                "text": "Nous avons reçu des renseignements d’un informateur très sûr."
                            },
                            {
                                "example_id": "3ae10856-82b6-4d5f-a7ec-b23d3fee988c",
                                "sense_id": "f1c63e5a-066b-3ab5-80a1-2653a6e725ff",
                                "text": "Entre alors en scène « Gorge profonde », un informateur venu du cœur même de l’équipe républicaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "b113d697-bd67-32b3-b3d0-39209031c246",
                        "entry_id": "ad5a1d6b-3fa3-3549-83f1-9a73b12954b2",
                        "glosses": [
                            "Personne chargée d’identifier les défis de l'État et d’explorer les possibilités et conditions nécessaires à la formation du gouvernement fédéral."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cdf5b607-315a-416c-acb0-1c9c3528851b",
                        "source_entry_id": "ad5a1d6b-3fa3-3549-83f1-9a73b12954b2",
                        "target_lang_word": "Informant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Informant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6f0fad3-73b4-3439-8971-0432d96f07d0",
                                        "entry_id": "61aec74d-7a43-355d-888f-de039bdd661b",
                                        "glosses": [
                                            "Person oder Institution/Organisation, die vertrauliche Informationen weitergibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd52203a-53ff-4fea-a8d7-4d1c09bf8bb6",
                                                "sense_id": "e6f0fad3-73b4-3439-8971-0432d96f07d0",
                                                "text": "„Die Mail endet mit dem Angebot, eine merkwürdige Geschichte über die Liaison von Informant und Redaktion könne exklusiv erworben werden.“"
                                            },
                                            {
                                                "example_id": "6f282535-ca12-4e27-bb09-ac325ef40b40",
                                                "sense_id": "e6f0fad3-73b4-3439-8971-0432d96f07d0",
                                                "text": "„Einen seiner besten Informanten rühmt de Sade namentlich im Roman, es ist jener Giuseppe Iberti, der ihn besonders mit römischem Material versorgte und das mit vier Monaten Untersuchungshaft bei der päpstlichen Inquisition zu büßen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acb858b9-1ee1-48f5-a4b9-f3146cb01d51",
                        "source_entry_id": "ad5a1d6b-3fa3-3549-83f1-9a73b12954b2",
                        "target_lang_word": "informant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "informant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f53a4079-f77d-3968-a911-4cae86da6366",
                                        "entry_id": "302dbfda-44d1-3020-9119-1ea7a9976fdf",
                                        "glosses": [
                                            "One who relays confidential information to someone, especially to the police; an informer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75ca2561-e6b4-4787-9d46-70fdace24098",
                                                "sense_id": "f53a4079-f77d-3968-a911-4cae86da6366",
                                                "text": "One of her chief informants is Alicent’s handmaiden Talya (Alexis Rabin), whose inside info runs so deep that she’s the first to catch wind of Viserys’ death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66fba02d-e116-338f-b37f-091fc7cd30e0",
                                        "entry_id": "302dbfda-44d1-3020-9119-1ea7a9976fdf",
                                        "glosses": [
                                            "A native speaker who acts as a linguistic reference for a language being studied. The informant demonstrates native pronunciation, provides grammaticality judgments regarding linguistic well-formedness, and may also explain cultural references and other important contextual information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "095f57e2-e6f4-46f8-bb56-fe70f763e126",
                                                "sense_id": "66fba02d-e116-338f-b37f-091fc7cd30e0",
                                                "text": "The only material the linguist has to begin with are the informant's grammatical utterances in the target language pronounced arbitrarily in a natural or assigned communicative situation or stimulated artificially by the investigator."
                                            },
                                            {
                                                "example_id": "6ec84dbd-cfb8-4378-9861-33c6b34c7a33",
                                                "sense_id": "66fba02d-e116-338f-b37f-091fc7cd30e0",
                                                "text": "The informant learns his language by formal training and, more importantly, by constant exposure to its use. He cannot repeat to the linguist what he has never seen or heard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15593e42-ab00-429e-a879-382bb3a7e49d",
                        "source_entry_id": "ad5a1d6b-3fa3-3549-83f1-9a73b12954b2",
                        "target_lang_word": "informer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "informer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db181c0a-4d11-304b-be3b-1388f4ded503",
                                        "entry_id": "47767531-84b8-38a7-b2f6-5474a77e223a",
                                        "glosses": [
                                            "One who informs someone else about something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ec8dec7-697c-3c14-a315-a951ced95397",
                                        "entry_id": "47767531-84b8-38a7-b2f6-5474a77e223a",
                                        "glosses": [
                                            "A person who tells authorities about improper or illegal activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b071e531-d399-4de0-af29-be4d470bb1cb",
                                                "sense_id": "6ec8dec7-697c-3c14-a315-a951ced95397",
                                                "text": "Being an informer often meant living in fear."
                                            },
                                            {
                                                "example_id": "67ec682d-553b-418f-b414-451e5adb63dc",
                                                "sense_id": "6ec8dec7-697c-3c14-a315-a951ced95397",
                                                "text": "The police relied on an informer to catch the gang."
                                            },
                                            {
                                                "example_id": "ae006e29-ea6f-4b46-a3e6-cf9d40bff675",
                                                "sense_id": "6ec8dec7-697c-3c14-a315-a951ced95397",
                                                "text": "He acted as an informer during the rebellion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "471ae915-8014-367b-977b-394d8f856bae",
                                        "entry_id": "47767531-84b8-38a7-b2f6-5474a77e223a",
                                        "glosses": [
                                            "One who informs, animates, or inspires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "586e092e-9a14-4fc2-aa2e-63f932ce1dd3",
                                                "sense_id": "471ae915-8014-367b-977b-394d8f856bae",
                                                "text": "1729, Alexander Pope, Prologue to Sophonisba (by James Thomson\nNature, informer of the poet's art."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
