                "translations": [
                    {
                        "translation_id": "fab2a4c6-f93a-45c1-9156-f16492e3d9ad",
                        "source_entry_id": "c8aa544b-fd07-3bad-8fcb-f9277ea2379e",
                        "source_sense_id": "1852cff0-dcff-368e-8af5-37fe553ae0df",
