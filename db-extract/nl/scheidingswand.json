                "senses": [
                    {
                        "sense_id": "ee54a33d-2482-3a40-b845-ecfbd6f8d343",
                        "entry_id": "ed8e54ce-5480-34d6-ba99-d0e034c11da7",
                        "glosses": [
                            "een muur die twee ruimtes in een gebouw van elkaar scheidt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc4d9e45-27a3-4827-ac90-a22d0da69fd1",
                                "sense_id": "ee54a33d-2482-3a40-b845-ecfbd6f8d343",
                                "text": "De balk zelf zat verstopt boven het plafond en nergens was vastgelegd dat de balk daar was aangelegd. Toen tijdens de verbouwing eerder dit jaar de houten scheidingswand werd weggehaald, hadden de bouwvakkers dan ook geen idee dat de wand een dragende functie had."
                            },
                            {
                                "example_id": "eb425f93-dccc-49c7-85e9-56a7cbd82988",
                                "sense_id": "ee54a33d-2482-3a40-b845-ecfbd6f8d343",
                                "text": "Op bewakingsbeelden is te zien hoe de drugsbaas achter een scheidingswand van zijn douche tevoorschijn komt. Daarna gaat hij op bed zitten en even later verdwijnt hij weer achter de wand, om niet meer terug te keren."
                            }
                        ]
                    },
                    {
                        "sense_id": "1262c046-297a-3872-bf8b-ce03eb38e511",
                        "entry_id": "ed8e54ce-5480-34d6-ba99-d0e034c11da7",
                        "glosses": [
                            "iets dat dient als afscheiding van twee ruimtes van elkaar maar geen muur is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3321608-6421-4206-bd8f-8bf1ad0ed13a",
                                "sense_id": "1262c046-297a-3872-bf8b-ce03eb38e511",
                                "text": "Volgens de politie vroeg de conducteur de vrouw ergens anders te gaan zitten. De Dordtse reageerde woest en duwde de spoorwegmedewerker tegen een glazen scheidingswand. Ook bedreigde ze de man en sloeg ze met beide vuisten in zijn gezicht."
                            }
                        ]
                    }
