                {
                    "sense_id": "da4d812f-abe5-331b-ac53-24239ddf1306",
                    "sense_definition": "Devenir plus clément, plus doux ou plus agréable, en particulier en parlant du climat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "climat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent est tombé et la température commence à s'<w>adoucir</w> en fin de journée.",
                            "target_lang_translations": {
                                "en": "The wind has dropped, and the temperature is beginning to <w>moderate</w> toward the end of the day.",
                                "ru": "Ветер утих, и к концу дня начинает <w>теплеть</w>.",
                                "de": "Der Wind hat sich gelegt, und gegen Ende des Tages wird es allmählich <w>milder</w>.",
                                "es": "El viento ha amainado y la temperatura empieza a <w>templarse</w> al final del día.",
                                "zh": "风已经停了，临近傍晚，气温开始<w>回暖</w>。"
                            }
                        },
                        {
                            "text": "Après plusieurs semaines de gelées sévères, le climat s'<w>adoucit</w> enfin.",
                            "target_lang_translations": {
                                "en": "After several weeks of severe frost, the weather finally <w>softens</w>.",
                                "ru": "После нескольких недель сильных морозов климат наконец <w>смягчается</w>.",
                                "de": "Nach mehreren Wochen mit strengem Frost wird das Klima endlich <w>milder</w>.",
                                "es": "Después de varias semanas de fuertes heladas, el clima por fin <w>se suaviza</w>.",
                                "zh": "经过好几周的严寒，天气终于<w>转暖</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "temps qui s'adoucit"
                    ],
                    "target_lang_definitions": {
                        "en": "To become milder or more pleasant, especially of the weather.",
                        "ru": "Становиться мягче или приятнее, особенно о погоде.",
                        "de": "Milder und angenehmer werden, besonders beim Wetter oder Klima.",
                        "es": "Volverse más benigno, suave o agradable, especialmente hablando del tiempo o del clima.",
                        "zh": "天气或气候变得更加温和宜人，尤指寒冷之后气温回升。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "soften",
                                "target_lang_sense_clarification": "weather or temperature becoming milder"
                            },
                            {
                                "target_lang_word": "moderate",
                                "target_lang_sense_clarification": "weather becoming less severe"
                            }
                        ],
                        "ru": [
