                ],
                "translations": [
                    {
                        "translation_id": "33155567-18ce-4eb7-b81b-736c5f04eb2c",
                        "source_entry_id": "c2e6bc6c-b7b0-3ff4-afce-4c8113866f6b",
                        "source_sense_id": "a52f55cc-b7ef-3f50-a4fb-c8379541f671",
                        "target_lang_word": "atheism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atheism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf4a6bd-0025-3365-b756-f6726cc0203d",
                                        "entry_id": "8d04ad8f-b384-34ae-9368-e04bd538c36a",
                                        "glosses": [
                                            "A non-belief in deities.",
                                            "Belief that no deities exist (sometimes including rejection of other religious beliefs)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9193557d-b3cc-4abe-8508-2854b492c4b9",
                                                "sense_id": "9cf4a6bd-0025-3365-b756-f6726cc0203d",
                                                "text": "Near-synonyms: antireligiousness, irreligion, irreligiousness"
                                            },
                                            {
                                                "example_id": "a26c3f65-46be-4d98-b14c-4ee454a89e35",
                                                "sense_id": "9cf4a6bd-0025-3365-b756-f6726cc0203d",
                                                "text": "For atheism to be rationally justified it is only necessary that it be more probable than not or at least more probable than theism. Certainty is no more required in the case of atheism than it is in the case of scientific theories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3946514d-82ee-3c6f-957a-a2b371179ce8",
                                        "entry_id": "8d04ad8f-b384-34ae-9368-e04bd538c36a",
                                        "glosses": [
                                            "A non-belief in deities.",
                                            "A lack of belief in deities, or a belief that there is insufficient evidence to believe in a god."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe49a398-6b8f-47aa-af63-3f145f23c592",
                                                "sense_id": "3946514d-82ee-3c6f-957a-a2b371179ce8",
                                                "text": "Near-synonyms: irreligion, irreligiousness, nonreligion, nonreligiousness"
                                            },
                                            {
                                                "example_id": "66be7a45-04ae-48f4-8385-6e2ff3738ed8",
                                                "sense_id": "3946514d-82ee-3c6f-957a-a2b371179ce8",
                                                "text": "The theory of Secularism is a form, not of dogmatic, but of skeptical, Atheism; it is dogmatic only in denying the sufficiency of the evidence for the being and perfections of God. It does not deny, it only does not believe, His existence."
                                            },
                                            {
                                                "example_id": "712dab06-60fd-4e81-9525-a9cc6848b3eb",
                                                "sense_id": "3946514d-82ee-3c6f-957a-a2b371179ce8",
                                                "text": "...but Atheism per se simply means, not denial, but rejection, in the sense of not accepting the Theistic theory of the universe which Mr. Lee has put forward tonight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abc5a2f2-a698-36ff-8089-9de5691421c3",
                                        "entry_id": "8d04ad8f-b384-34ae-9368-e04bd538c36a",
                                        "glosses": [
                                            "A non-belief in deities.",
                                            "Absence of belief that any deities exist (including absence of the concept of deities)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf91b50e-f9f5-4dd7-b059-19bbb54cb005",
                                                "sense_id": "abc5a2f2-a698-36ff-8089-9de5691421c3",
                                                "text": "What can parents do, and mothers more especially, […] with regard to the atheism that is natural to all the children of men?"
                                            },
                                            {
                                                "example_id": "25765766-a1b8-48ee-a089-66b5a2d3d34a",
                                                "sense_id": "abc5a2f2-a698-36ff-8089-9de5691421c3",
                                                "text": "Atheism, in its basic form, is not a belief; it is the absence of belief. An atheist is not primarily a person who believes that a god does not exist; rather, he does not believe in the existence of a god."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a80e8eb-761d-3b9c-9c88-9fb65d7c7324",
                                        "entry_id": "8d04ad8f-b384-34ae-9368-e04bd538c36a",
                                        "glosses": [
                                            "Absence of belief in a particular deity, pantheon, or religious doctrine (notwithstanding belief in other deities)."
                                        ],
                                        "tags": [
                                            "historical",
                                            "rare",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d60c58a8-f165-48b8-8948-1605dbbf3087",
                                                "sense_id": "7a80e8eb-761d-3b9c-9c88-9fb65d7c7324",
                                                "text": "Domitilla, Flavia, niece of the emperor Domitian (81-96). She and her husband, Flavius Clemens (consul in 95 and cousin of Domitian), were probably Christians; charged with atheism and adoption of Jewish ways, they were punished (95) with death (Clemens) and exile (Domitilla)."
                                            },
                                            {
                                                "example_id": "be18b112-9d0b-47ec-933e-4b0fbfa6124d",
                                                "sense_id": "7a80e8eb-761d-3b9c-9c88-9fb65d7c7324",
                                                "text": "Sacrificial religion becomes redundant – which is why Christianity did indeed have a reputation in the ancient world for atheism: it rejected the key duty humans are thought to owe to the gods, namely sacrifice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b903027f-e480-3e0c-98ef-34339166ab7b",
                                        "entry_id": "8d04ad8f-b384-34ae-9368-e04bd538c36a",
                                        "glosses": [
                                            "A rejection of all religions, even non-theistic ones."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "sometimes",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3770285-1b4c-4aa2-a12f-879af05ca6ff",
                                                "sense_id": "b903027f-e480-3e0c-98ef-34339166ab7b",
                                                "text": "Some worldviews are based in a belief in God; others are not. Buddhism, Taoism, atheism, Marxism, and existentialism are examples of worldviews that are nontheistic."
                                            },
                                            {
                                                "example_id": "e1d2519a-effa-4b82-ac63-38fb429ddb74",
                                                "sense_id": "b903027f-e480-3e0c-98ef-34339166ab7b",
                                                "text": "Buddhism and atheism do agree on the view that there is no God. But Buddhism and atheist materialism totally disagree on the points such as “What is life?”, “Is there any Super natural?” etc."
                                            },
                                            {
                                                "example_id": "ad4ecdd8-17d5-4378-8b76-d68f91fc24a5",
                                                "sense_id": "b903027f-e480-3e0c-98ef-34339166ab7b",
                                                "text": "Another reason why the transition between Buddhism and atheism seemed so easy, was my personal discomfort with the theory of reincarnation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
