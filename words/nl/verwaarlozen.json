                    "frequency": "Low",
                    "semantic_group_id": "wetenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze berekening kunnen we de luchtweerstand volledig <w>verwaarlozen</w>.",
                            "target_lang_translations": {
                                "en": "In this calculation, we can completely <w>neglect</w> air resistance."
