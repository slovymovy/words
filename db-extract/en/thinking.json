                        "target_lang_word": "Denken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Denken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4536227d-a232-30f3-8627-c5f927547f40",
                                        "entry_id": "1d050e9a-b1a1-3877-aa51-d9cc7be17d61",
                                        "glosses": [
                                            "Einstellung zu etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb0d7ff-bfc3-48da-8756-0360da5c8351",
                                                "sense_id": "4536227d-a232-30f3-8627-c5f927547f40",
                                                "text": "Rechtes Denken ist für viele längst gesellschaftsfähig."
                                            },
                                            {
                                                "example_id": "e7d98b1c-096e-4300-b54b-f08ce4aeb001",
                                                "sense_id": "4536227d-a232-30f3-8627-c5f927547f40",
                                                "text": "„Gegen Ende des 19. Jahrhunderts verbreitete sich das eugenische Denken in den fortgeschrittenen Industrienationen rasch, vor allem unter Ärzten, auch Psychiatern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "52c6e01f-357d-378f-9ac8-a1076a429faa",
                                        "entry_id": "1d050e9a-b1a1-3877-aa51-d9cc7be17d61",
                                        "glosses": [
                                            "zielgerichtete geistige Tätigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b0b91fe-fcb1-4e0f-aae6-dffbd863d625",
                                                "sense_id": "52c6e01f-357d-378f-9ac8-a1076a429faa",
                                                "text": "Hör mit dem Denken auf, wir müssen handeln!"
                                            },
                                            {
                                                "example_id": "658a6d12-2927-49f9-b124-77ca44bf482d",
                                                "sense_id": "52c6e01f-357d-378f-9ac8-a1076a429faa",
                                                "text": "Das Denken der Gedanken ist gedankenloses Denken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b15b0bc0-fe73-425a-a6c7-e6f1e803c954",
                        "source_entry_id": "75c0bf5b-d84c-3f8f-9d0d-6817c16987ef",
                        "source_sense_id": "46641358-fdb8-357a-b185-754c0ecffb4b",
