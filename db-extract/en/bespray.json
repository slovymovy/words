                        "glosses": [
                            "To spray on; spray all over; besprinkle, bespatter."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1be26235-657d-4209-a18f-beb3ac9f1a20",
                                "sense_id": "ccc394a8-0214-39d7-8052-002d591442fb",
                                "text": "In the heart of the rude Mountains shines the graceful seeming-boy, encircled with toppling cliffs, besprayed with cataracts, in the middle of a motley horde."
                            },
                            {
                                "example_id": "375ff76e-b8b5-44ea-a97d-66b3024c640d",
                                "sense_id": "ccc394a8-0214-39d7-8052-002d591442fb",
                                "text": "Her limbs are roseate, and a sparkling dew\nBesprays her symmetry, as from the sea […]"
                            },
                            {
                                "example_id": "4f60cfa9-04eb-4684-85ad-82ad62e31a41",
                                "sense_id": "ccc394a8-0214-39d7-8052-002d591442fb",
                                "text": "[…] the more voracious fellows disposing of the food before the feeder has time to dump all of it, and in the bargain perhaps liberally bespraying the man with mud or swill, […]"
                            }
                        ]
                    }
