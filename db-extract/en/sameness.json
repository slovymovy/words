    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7d55fb8b-09e9-39fc-9f50-b7712d0facaf",
                "word": "sameness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2b3bbbbe-a149-4dde-83b2-e95887f467b7",
                        "entry_id": "7d55fb8b-09e9-39fc-9f50-b7712d0facaf",
                        "tags": [
                            "plural"
                        ],
                        "form": "samenesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "84a08b9a-74d0-358e-ac9d-cbcc87cfbef8",
                        "entry_id": "7d55fb8b-09e9-39fc-9f50-b7712d0facaf",
                        "glosses": [
                            "The quality of being the same; identity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2094601-236c-41e8-a3d9-18230548bd8a",
                                "sense_id": "84a08b9a-74d0-358e-ac9d-cbcc87cfbef8",
                                "text": "All of them agreed that the working-classes must be kept in their place; and all of them perceived that American Democracy did not imply any equality of wealth, but did demand a wholesome sameness of thought, dress, painting, morals, and vocabulary."
                            },
                            {
                                "example_id": "d6597d81-9f9d-44bc-b136-cae395325090",
                                "sense_id": "84a08b9a-74d0-358e-ac9d-cbcc87cfbef8",
                                "text": "However strange it may sound, it always seemed to me […] that Adrian's laughter-filled friendship with Schildknapp had something to do with the sameness of their eye color"
                            }
                        ]
                    },
                    {
                        "sense_id": "f935939f-1b5d-32a3-ba55-0a95c1f849eb",
                        "entry_id": "7d55fb8b-09e9-39fc-9f50-b7712d0facaf",
                        "glosses": [
                            "The state of being equivalent; equality."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "42316c18-e7d2-32cd-aea4-79de995333c7",
                        "entry_id": "7d55fb8b-09e9-39fc-9f50-b7712d0facaf",
                        "glosses": [
                            "A tiring lack of variety; monotony."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7349474-3a82-4797-863b-c22c663fcf80",
                                "sense_id": "42316c18-e7d2-32cd-aea4-79de995333c7",
                                "text": "[…] in the time when day follows day in dull, unexpectant sameness, and trial is a dreary routine,—it is then that despair threatens […]"
                            },
                            {
                                "example_id": "c0acb8a2-9274-43ce-b1da-10e1cf980be0",
                                "sense_id": "42316c18-e7d2-32cd-aea4-79de995333c7",
                                "text": "O to sail to sea in a ship! / To leave this steady unendurable land, / To leave the tiresome sameness of the streets, the sidewalks and the houses, / To leave you O you solid motionless land, and entering a ship, / To sail and sail and sail!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
