{
    "word_family": [
        "barst",
        "uitbarsten",
        "openbarsten",
        "barsting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e8510d71-6a06-3e98-a06b-5cb0b1cb21bb",
                    "sense_definition": "Het gedeeltelijk breken of scheuren van een oppervlak zonder dat het object volledig in stukken valt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "breken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het ijs begint hier en daar te <w>barsten</w> door de dooi.",
                            "target_lang_translations": {
                                "en": "The ice is starting to <w>crack</w> here and there due to the thaw.",
                                "fr": "La glace commence à se <w>fissurer</w> çà et là à cause du dégel."
                            }
                        },
                        {
                            "text": "De oude muur vertoont diepe scheuren en kan elk moment <w>barsten</w>.",
                            "target_lang_translations": {
                                "en": "The old wall shows deep fissures and could <w>crack</w> at any moment.",
                                "fr": "Le vieux mur présente de profondes crevasses et peut se <w>lézarder</w> à tout moment."
                            }
                        }
                    ],
                    "synonyms": [
                        "breken",
                        "scheuren"
                    ],
                    "common_phrases": [
                        "beginnen te barsten"
                    ],
                    "target_lang_definitions": {
                        "en": "The partial breaking or tearing of a surface without the object falling completely into pieces.",
                        "fr": "Rupture ou fissure partielle d'une surface sans que l'objet ne se brise complètement en morceaux."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crack",
                                "target_lang_sense_clarification": "to form a thin line on a surface"
                            },
                            {
                                "target_lang_word": "fissure",
                                "target_lang_sense_clarification": "to develop a long, narrow opening"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "se fissurer",
                                "target_lang_sense_clarification": "développer une fissure ou fente superficielle"
                            },
                            {
                                "target_lang_word": "se craqueler",
                                "target_lang_sense_clarification": "se couvrir de petites fissures"
                            },
                            {
                                "target_lang_word": "se fendiller",
                                "target_lang_sense_clarification": "commencer à se fendre légèrement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8394f6f2-383c-3251-8ffc-fe100e5bcfd4",
                    "sense_definition": "Heftig breken of met kracht uiteenspatten, vaak door druk of temperatuurverschillen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "breken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het koude glas <w>barstte</w> toen er heet water in werd geschonken.",
                            "target_lang_translations": {
                                "en": "The cold glass <w>shattered</w> when hot water was poured into it.",
                                "fr": "Le verre froid a <w>éclaté</w> lorsqu'on y a versé de l'eau chaude."
                            }
                        },
                        {
                            "text": "De ballon zal <w>barsten</w> als je er te veel lucht in blaast.",
                            "target_lang_translations": {
                                "en": "The balloon will <w>burst</w> if you blow too much air into it.",
                                "fr": "Le ballon va <w>éclater</w> si tu y souffles trop d'air."
                            }
                        }
                    ],
                    "synonyms": [
                        "knappen",
                        "springen"
                    ],
                    "common_phrases": [
                        "uit elkaar barsten"
                    ],
                    "target_lang_definitions": {
                        "en": "To break violently or shatter with force, often due to pressure or temperature differences.",
                        "fr": "Se rompre violemment ou éclater sous l'effet de la pression ou d'un choc thermique."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "burst",
                                "target_lang_sense_clarification": "to break open from internal pressure"
                            },
                            {
                                "target_lang_word": "shatter",
                                "target_lang_sense_clarification": "to break into many small pieces"
                            },
                            {
                                "target_lang_word": "crack",
                                "target_lang_sense_clarification": "to break apart under stress"
                            },
                            {
                                "target_lang_word": "split",
                                "target_lang_sense_clarification": "to break along a line"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "éclater",
                                "target_lang_sense_clarification": "se briser avec violence sous l'effet de la pression"
                            },
                            {
                                "target_lang_word": "exploser",
                                "target_lang_sense_clarification": "voler en éclats"
                            },
                            {
                                "target_lang_word": "se briser",
                                "target_lang_sense_clarification": "se casser brusquement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd8fe0e2-7077-3c39-9110-30edfa758a48",
                    "sense_definition": "In grote mate aanwezig zijn; overvloedig voorkomen van iets.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "overvloed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit bos <w>barst</w> het van de muggen tijdens de zomer.",
                            "target_lang_translations": {
                                "en": "This forest is <w>teeming</w> with mosquitoes during the summer.",
                                "fr": "En été, cette forêt <w>grouille</w> de moustiques."
                            }
                        },
                        {
                            "text": "De stad <w>barst</w> van de toeristen tijdens het hoogseizoen.",
                            "target_lang_translations": {
                                "en": "The city is <w>bursting</w> with tourists during the high season.",
                                "fr": "La ville <w>regorge</w> de touristes pendant la haute saison."
                            }
                        }
                    ],
                    "synonyms": [
                        "wemelen",
                        "krioelen"
                    ],
                    "common_phrases": [
                        "barsten van"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt met het voorzetsel 'van'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be present in large numbers; to be teeming or overflowing with something.",
                        "fr": "Être présent en très grand nombre ; déborder ou regorger de quelque chose."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be teeming with",
                                "target_lang_sense_clarification": "to be full of living things"
                            },
                            {
                                "target_lang_word": "be crawling with",
                                "target_lang_sense_clarification": "to be full of something unpleasant"
                            },
                            {
                                "target_lang_word": "be bursting with",
                                "target_lang_sense_clarification": "to be completely full of something"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "regorger de",
                                "target_lang_sense_clarification": "être rempli à l'excès de"
                            },
                            {
                                "target_lang_word": "fourmiller de",
                                "target_lang_sense_clarification": "être plein d'êtres vivants en mouvement"
                            },
                            {
                                "target_lang_word": "grouiller de",
                                "target_lang_sense_clarification": "être rempli de façon grouillante"
                            },
                            {
                                "target_lang_word": "déborder de",
                                "target_lang_sense_clarification": "contenir en très grande abondance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2cad7c5-d992-3f6e-acf9-4e32e4790925",
                    "sense_definition": "Op het punt staan om een sterke emotie of fysieke reactie te uiten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij hield zijn tranen in, maar hij stond op <w>barsten</w>.",
                            "target_lang_translations": {
                                "en": "He held back his tears, but he was about to <w>burst</w>.",
                                "fr": "Il retenait ses larmes, mais il était sur le point de <w>craquer</w>."
                            }
                        },
                        {
                            "text": "Na die belediging leek de woedende man bijna uit elkaar te <w>barsten</w>.",
                            "target_lang_translations": {
                                "en": "After that insult, the angry man seemed almost ready to <w>explode</w>.",
                                "fr": "Après cet affront, l'homme furieux semblait sur le point d'<w>exploser</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op barsten staan"
                    ],
                    "target_lang_definitions": {
                        "en": "To be on the verge of expressing a strong emotion or physical reaction.",
                        "fr": "Être sur le point d'extérioriser une émotion forte ou d'exploser."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be about to burst",
                                "target_lang_sense_clarification": "unable to contain an emotion"
                            },
                            {
                                "target_lang_word": "crack",
                                "target_lang_sense_clarification": "to yield under psychological pressure"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "craquer",
                                "target_lang_sense_clarification": "céder sous la pression émotionnelle"
                            },
                            {
                                "target_lang_word": "éclater",
                                "target_lang_sense_clarification": "extérioriser brutalement une vive émotion"
                            },
                            {
                                "target_lang_word": "être sur le point d'éclater",
                                "target_lang_sense_clarification": "ne plus pouvoir contenir ses émotions"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa2dfc5b-ec14-3934-9842-674d996d84c8",
                    "sense_definition": "Meervoudsvorm van <w>barst</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zitten verschillende kleine <w>barsten</w> in het ruitje van de deur.",
                            "target_lang_translations": {
                                "en": "There are several small <w>cracks</w> in the window of the door.",
                                "fr": "Il y a plusieurs petites <w>fissures</w> dans la vitre de la porte."
                            }
                        },
                        {
                            "text": "De <w>barsten</w> in de droge grond werden steeds breder door de hitte.",
                            "target_lang_translations": {
                                "en": "The <w>fissures</w> in the dry ground became wider and wider due to the heat.",
                                "fr": "Les <w>crevasses</w> dans le sol desséché devenaient de plus en plus larges à cause de la chaleur."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of barst"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural form of 'crack' or 'fissure'.",
                        "fr": "Forme plurielle de fissure, fente ou craquelure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cracks",
                                "target_lang_sense_clarification": "multiple thin jagged spaces"
                            },
                            {
                                "target_lang_word": "fissures",
                                "target_lang_sense_clarification": "multiple long narrow openings"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "fissures",
                                "target_lang_sense_clarification": "fentes linéaires dans une matière solide"
                            },
                            {
                                "target_lang_word": "craquelures",
                                "target_lang_sense_clarification": "petites crevasses sur une surface"
                            },
                            {
                                "target_lang_word": "fentes",
                                "target_lang_sense_clarification": "ouvertures longitudinales et étroites"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}