{
    "word_family": [
        "resistance",
        "resistant",
        "resister",
        "resistible",
        "irresistible",
        "resistivity"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac3a7fae-0c95-328a-9642-f0897af221e0",
                    "sense_definition": "To actively oppose or refuse to accept something, such as a change, an idea, or a force.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many employees continue to <w>resist</w> change when new technology is introduced to the office.",
                            "target_lang_translations": {
                                "ru": "Многие сотрудники продолжают <w>сопротивляться</w> изменениям, когда в офисе внедряются новые технологии."
                            }
                        },
                        {
                            "text": "It is difficult to <w>resist</w> pressure from your peers when you want to fit in.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>противостоять</w> давлению со стороны сверстников, когда хочется вписаться в коллектив."
                            }
                        }
                    ],
                    "synonyms": [
                        "oppose"
                    ],
                    "antonyms": [
                        "submit",
                        "obey"
                    ],
                    "common_phrases": [
                        "resist change",
                        "resist pressure",
                        "resist arrest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Активно выступать против или отказываться принимать что-либо, например, изменения, идеи или силу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сопротивляться",
                                "target_lang_sense_clarification": "активно противодействовать"
                            },
                            {
                                "target_lang_word": "оказывать сопротивление",
                                "target_lang_sense_clarification": "предпринимать встречные действия"
                            },
                            {
                                "target_lang_word": "противиться",
                                "target_lang_sense_clarification": "выступать против чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0773fca0-a9aa-37e7-8004-95014568040a",
                    "sense_definition": "To stop yourself from doing something that you would very much like to do.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "self-control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I simply could not <w>resist</w> temptation when I saw the delicious chocolate cake on the table.",
                            "target_lang_translations": {
                                "ru": "Я просто не смог <w>устоять</w> перед искушением, когда увидел на столе вкусный шоколадный торт."
                            }
                        },
                        {
                            "text": "She tried to <w>resist</w> the urge to laugh during the serious meeting.",
                            "target_lang_translations": {
                                "ru": "Она пыталась <w>подавить</w> желание рассмеяться во время серьезного совещания."
                            }
                        }
                    ],
                    "common_phrases": [
                        "resist temptation",
                        "resist the urge",
                        "hard to resist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удерживать себя от совершения того, что очень хочется сделать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устоять",
                                "target_lang_sense_clarification": "перед соблазном или желанием"
                            },
                            {
                                "target_lang_word": "сопротивляться",
                                "target_lang_sense_clarification": "не поддаваться влечению"
                            },
                            {
                                "target_lang_word": "противостоять",
                                "target_lang_sense_clarification": "сдерживать порыв или искушение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8b7018f-f3c8-3cf1-a478-bea1e9a14138",
                    "sense_definition": "To remain undamaged or unaffected by something; to withstand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "durability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new material is specially designed to <w>resist</w> heat and chemical corrosion.",
                            "target_lang_translations": {
                                "ru": "Этот новый материал специально разработан, чтобы <w>противостоять</w> воздействию тепла и химической коррозии."
                            }
                        },
                        {
                            "text": "The old wooden door was treated with oil to help it <w>resist</w> water damage.",
                            "target_lang_translations": {
                                "ru": "Старую деревянную дверь обработали маслом, чтобы помочь ей <w>выдерживать</w> воздействие воды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "resist heat",
                        "resist water",
                        "resist infection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставаться неповрежденным или незатронутым чем-либо; выдерживать воздействие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противостоять",
                                "target_lang_sense_clarification": "внешнему физическому воздействию"
                            },
                            {
                                "target_lang_word": "быть устойчивым",
                                "target_lang_sense_clarification": "к повреждениям или коррозии"
                            },
                            {
                                "target_lang_word": "выдерживать",
                                "target_lang_sense_clarification": "нагрузку или влияние среды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ceef83d-73e5-375e-b53b-7f295dc105ce",
                    "sense_definition": "To be distasteful or deeply unpleasant to someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy, greasy food began to <w>resist</w> him after only a few bites.",
                            "target_lang_translations": {
                                "ru": "Тяжелая, жирная пища начала <w>претить</w> ему уже после нескольких кусочков."
                            }
                        },
                        {
                            "text": "Such crude manners <w>resist</w> my very nature and upbringing.",
                            "target_lang_translations": {
                                "ru": "Такие грубые манеры <w>противны</w> самой моей природе и воспитанию."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to describe distaste"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть неприятным или вызывать отвращение у кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "претить",
                                "target_lang_sense_clarification": "быть противным чьей-либо натуре"
                            },
                            {
                                "target_lang_word": "вызывать отвращение",
                                "target_lang_sense_clarification": "быть крайне неприятным"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0c419510-d68f-332e-96ce-e7c02d31609d",
                    "sense_definition": "A substance or coating applied to a surface to prevent another substance from affecting it, often used in art or industry.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "coating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist applied a wax <w>resist</w> to the paper before painting with watercolors.",
                            "target_lang_translations": {
                                "ru": "Художник нанес на бумагу восковой <w>резерваж</w> перед тем, как рисовать акварелью."
                            }
                        },
                        {
                            "text": "In circuit board manufacturing, a photo <w>resist</w> is used to define the wiring patterns.",
                            "target_lang_translations": {
                                "ru": "При производстве печатных плат используется <w>фоторезист</w> для формирования рисунка проводки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wax resist",
                        "photo resist"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in arts and manufacturing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество или покрытие, наносимое на поверхность для предотвращения воздействия другого вещества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резист",
                                "target_lang_sense_clarification": "защитный слой в технике или искусстве"
                            },
                            {
                                "target_lang_word": "резерваж",
                                "target_lang_sense_clarification": "состав для защиты участков поверхности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}