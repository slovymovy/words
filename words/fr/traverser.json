{
    "word_family": [
        "travers",
        "traversée",
        "traversable",
        "intraversable",
        "traversier",
        "traversin"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d04f24d5-c7c1-3f61-8fdd-f2d98dac62ca",
                    "sense_definition": "Passer d'un côté à l'autre d'un lieu, d'un espace ou d'un obstacle (ville, pays, mer, pont, etc.).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "traverser_un_espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour aller à l'école, nous <w>traversons</w> le parc tous les matins."
                        },
                        {
                            "text": "Il a <w>traversé</w> l'Atlantique en voilier en vingt-deux jours."
                        },
                        {
                            "text": "Les touristes ont <w>traversé</w> la ville à pied avant de visiter le musée."
                        }
                    ],
                    "synonyms": [
                        "franchir"
                    ],
                    "common_phrases": [
                        "traverser la frontière",
                        "traverser la ville",
                        "traverser un pont"
                    ]
                },
                {
                    "sense_id": "044cee68-a44d-34ec-8b76-20d457e32c3b",
                    "sense_definition": "Passer d'un côté à l'autre d'une rue ou d'une route, à pied ou en véhicule.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "traverser_un_espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Attention, ne <w>traverse</w> pas quand le feu est rouge !"
                        },
                        {
                            "text": "Les enfants doivent <w>traverser</w> la rue sur le passage pour piétons."
                        },
                        {
                            "text": "Je ne <w>traverse</w> jamais la route sans regarder des deux côtés."
                        }
                    ],
                    "common_phrases": [
                        "traverser la rue",
                        "traverser la route",
                        "traverser au feu rouge"
                    ]
                },
                {
                    "sense_id": "9f4735c5-29fb-36dc-b4fb-517b139f7436",
                    "sense_definition": "Pour une rivière, une route, une voie, etc., passer au milieu d'un lieu ou le couper d'un bout à l'autre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "traverser_un_espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette rivière <w>traverse</w> toute la région avant de se jeter dans la mer."
                        },
                        {
                            "text": "Une longue route <w>traverse</w> la plaine et rejoint les collines."
                        },
                        {
                            "text": "Le train <w>traverse</w> plusieurs tunnels avant d'arriver dans la vallée."
                        }
                    ],
                    "common_phrases": [
                        "traverser une région",
                        "traverser la ville"
                    ]
                },
                {
                    "sense_id": "adea8fc3-2f13-3438-ae8d-d7260547151b",
                    "sense_definition": "Percer de part en part, passer à travers une matière ou un corps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "percer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La pluie a <w>traversé</w> mon manteau et je suis trempé jusqu'aux os."
                        },
                        {
                            "text": "Une balle lui a <w>traversé</w> le bras sans toucher l'os."
                        },
                        {
                            "text": "L'humidité <w>traverse</w> les murs de cette vieille maison."
                        }
                    ],
                    "synonyms": [
                        "transpercer",
                        "percer"
                    ],
                    "common_phrases": [
                        "traverser de part en part"
                    ]
                },
                {
                    "sense_id": "c785bac6-ac49-39cd-a55a-332770d5ccb0",
                    "sense_definition": "Passer par un état, une épreuve ou une période ; en parlant d'une pensée, venir brièvement à l'esprit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "passer_par",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une idée étrange m'a <w>traversé</w> l'esprit pendant la réunion."
                        },
                        {
                            "text": "Le pays <w>traverse</w> une crise économique grave depuis deux ans."
                        },
                        {
                            "text": "Elle <w>traverse</w> une période difficile et a besoin du soutien de ses amis."
                        }
                    ],
                    "common_phrases": [
                        "traverser une crise",
                        "traverser une période difficile"
                    ]
                },
                {
                    "sense_id": "3bcee04f-89cf-3305-8259-ebd3b2cac955",
                    "sense_definition": "Susciter des obstacles pour empêcher la réussite d'un projet ou d'une entreprise.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contrecarrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa belle-mère <w>traversait</w> tous ses projets avec acharnement."
                        },
                        {
                            "text": "Il a <w>traversé</w> les desseins de son rival pour l'empêcher de réussir."
                        }
                    ],
                    "synonyms": [
                        "contrecarrer",
                        "entraver"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "emploi vieilli ou littéraire"
                        }
                    ]
                },
                {
                    "sense_id": "f8f4f389-1716-3394-852a-1f803454aba0",
                    "sense_definition": "En parlant d'un navire, présenter son flanc (le travers) au vent, aux vagues ou au courant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "de_travers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voilier <w>traverse</w> brusquement et présente son flanc aux vagues."
                        },
                        {
                            "text": "Sous la poussée du courant, le bateau a <w>traversé</w> et s'est mis en travers du chenal."
                        }
                    ]
                },
                {
                    "sense_id": "f9233a3e-2aca-3d55-b7ba-f2c49571114b",
                    "sense_definition": "En parlant d'un cheval, se placer de travers, avec les hanches ou les épaules qui ne suivent pas la même ligne.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "de_travers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune cheval se <w>traverse</w> dans le manège dès qu'il prend le galop."
                        },
                        {
                            "text": "Quand le cheval se <w>traverse</w> des hanches, le cavalier doit corriger sa position."
                        }
                    ]
                }
            ]
        }
    ]
}