            {
                "entry_id": "f09a195a-efe3-3081-a37c-1e3c5fa25330",
                "word": "tod",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dffd0a6c-a67c-4b05-bb43-73419963ae84",
                        "entry_id": "f09a195a-efe3-3081-a37c-1e3c5fa25330",
                        "tags": [
                            "plural"
                        ],
                        "form": "tods"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a353e7e9-6593-33a6-a870-275275aa0a6f",
                        "entry_id": "f09a195a-efe3-3081-a37c-1e3c5fa25330",
                        "glosses": [
                            "A bush, especially of ivy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2180856c-988f-44f5-93c8-a16264271e1b",
                                "sense_id": "a353e7e9-6593-33a6-a870-275275aa0a6f",
                                "text": "His head's yellow, / Hard-haired, and curled, thick-twined like ivy tods, / Not to undo with thunder."
                            },
                            {
                                "example_id": "59661c68-ff52-4dba-afcc-07c0357a5b79",
                                "sense_id": "a353e7e9-6593-33a6-a870-275275aa0a6f",
                                "text": "For birds in bushes tooting:\nAt length within the Ivy tod"
                            },
                            {
                                "example_id": "8b3351a1-9f28-4667-95b0-d7922c330bbc",
                                "sense_id": "a353e7e9-6593-33a6-a870-275275aa0a6f",
                                "text": "The ivy tod is heavy with snow."
                            }
                        ]
                    },
                    {
                        "sense_id": "1161990a-14b6-3e1e-a571-0a9ec05c3b9c",
                        "entry_id": "f09a195a-efe3-3081-a37c-1e3c5fa25330",
                        "glosses": [
                            "An old English measure of weight, usually of wool, containing two stone or 28 pounds (13 kg)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2829947c-3197-49bc-b00e-ff850af921e8",
                                "sense_id": "1161990a-14b6-3e1e-a571-0a9ec05c3b9c",
                                "text": "Seven pounds make a clove, 2 cloves a stone, 2 stone a tod, 6 1/2 tods a wey, 2 weys a sack, 12 sacks a last. [...] It is to be observed here that a sack is 13 tods, and a tod 28 pounds, so that the sack is 364 pounds."
                            },
                            {
                                "example_id": "149d2e82-1ba8-4a23-94e2-ea16ad9b61d5",
                                "sense_id": "1161990a-14b6-3e1e-a571-0a9ec05c3b9c",
                                "text": "Generally, however, the stone or petra, almost always of 14 lbs., is used, the tod of 28 lbs., and the sack of thirteen stone."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
