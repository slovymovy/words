                "senses": [
                    {
                        "sense_id": "b6f39a78-8115-3f72-b07a-0e96b75c794a",
                        "entry_id": "e8c6faab-e1fb-3737-acf1-38684d8e4cc8",
                        "glosses": [
                            "Caractérise une période de l’histoire, une situation, une région... où règne une forme de ségrégation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d91ad294-6fae-4f85-891e-8d92d67c95c9",
                                "sense_id": "b6f39a78-8115-3f72-b07a-0e96b75c794a",
                                "text": "« Si le mouvement Pentecôtiste, né dans un contexte historique encore ségrégué, se place au départ au dessus des différences raciales et de genre, il va petit à petit s'institutionnaliser et rétablir les anciennes barrières » indique Philippe Gonzalez, sociologue spécialiste de l'évangélisme et enseignant à l'université de Lausanne (Suisse)."
                            },
                            {
                                "example_id": "88cfc68e-976c-4a4c-ba3e-e966fa6a1473",
                                "sense_id": "b6f39a78-8115-3f72-b07a-0e96b75c794a",
                                "text": "Ces élèves sont de plus en plus ségrégués des autres élèves, que ce soit dans les écoles spécialisées ou dans des classes spécialisées dans les écoles régulières, sans que l’évaluation de leurs besoins, de leurs forces et de leurs compétences ait été faite."
                            }
                        ]
                    }
