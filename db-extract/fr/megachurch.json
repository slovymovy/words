                    {
                        "translation_id": "3b5a0950-5e99-4ad0-bb13-1287fd0e7edf",
                        "source_entry_id": "1be7bb93-0e1c-31c1-9201-6cb4022a6623",
                        "source_sense_id": "70d9afa6-ef40-3833-a62e-a42dba407a4d",
                        "target_lang_word": "megachurch",
