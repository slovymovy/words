                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50f4f86d-b755-3447-b58d-1fe01b2e0f2d",
                                        "entry_id": "f1ef4bd0-d748-35df-9637-1ec00775a8df",
