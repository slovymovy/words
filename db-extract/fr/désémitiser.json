                        "entry_id": "57af5da3-2c89-369d-8f1a-b3ca2970fa4e",
                        "glosses": [
                            "Ôter tout caractère sémitique."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ce0f941c-39bd-4347-beff-3c1c36950b16",
                                "sense_id": "b80cddbe-5aed-3c42-9e4f-3db4afef2b13",
                                "text": "Et Maurras s’efforçait aussi de désémitiser le christianisme pour en faire l’instrument de son nationalisme intégral."
                            },
                            {
                                "example_id": "d2c34525-6317-42c4-9d6b-cc426d5eb38b",
                                "sense_id": "b80cddbe-5aed-3c42-9e4f-3db4afef2b13",
                                "text": "En s’attaquant aux juifs et aux musulmans, elles cherchaient instinctivement à se « désémitiser, » à se « désafricaniser. »"
                            }
                        ]
                    }
