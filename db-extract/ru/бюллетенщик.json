                        "glosses": [
                            "разг. работник, который часто или подолгу болеет и находится на бюллетене (больничном)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aa32071-9c79-4ae5-aa3f-fdd0dd64c6fb",
                                "sense_id": "4838ec7b-2449-3322-9a07-fd7d54fbe810",
                                "text": "Симулянта-бюллетенщика с предприятия вон! / Нашу страхкассу обкрадывает он!"
                            },
                            {
                                "example_id": "f4727943-efeb-43b3-80c8-b039226b5a58",
                                "sense_id": "4838ec7b-2449-3322-9a07-fd7d54fbe810",
                                "text": "Штатные сотрудники вышли на трудовую вахту в полном составе, вплоть до бюллетенщиков и отпускников."
                            }
                        ]
                    }
