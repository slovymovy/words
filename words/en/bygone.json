{
    "word_family": [
        "bygone"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7903184f-ef7c-39e6-b84a-15d6ab85407f",
                    "sense_definition": "Having occurred or existed in the distant past.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He often reminisced about <w>bygone</w> days spent in his childhood village.",
                            "target_lang_translations": {
                                "zh": "他经常回忆起在童年村庄度过的<w>往昔</w>岁月。",
                                "de": "Er schwelgte oft in Erinnerungen an <w>vergangene</w> Tage, die er im Dorf seiner Kindheit verbracht hatte."
                            }
                        },
                        {
                            "text": "The museum displays tools from a <w>bygone</w> era of farming.",
                            "target_lang_translations": {
                                "zh": "博物馆展示了来自农业<w>过去</w>时代的工具。",
                                "de": "Das Museum stellt Werkzeuge aus einer <w>vergangenen</w> Epoche der Landwirtschaft aus."
                            }
                        }
                    ],
                    "synonyms": [
                        "past",
                        "historical"
                    ],
                    "common_phrases": [
                        "bygone days",
                        "bygone era"
                    ],
                    "target_lang_definitions": {
                        "zh": "指发生在遥远过去的，或属于过去时代的。",
                        "de": "In einer weit zurückliegenden Vergangenheit geschehen oder existierend."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "过去的",
                                "target_lang_sense_clarification": "指时间上已经发生的。"
                            },
                            {
                                "target_lang_word": "往昔的",
                                "target_lang_sense_clarification": "带有怀旧色彩，指代久远的岁月。"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "vergangen",
                                "target_lang_sense_clarification": "zeitlich zurückliegend"
                            },
                            {
                                "target_lang_word": "dahingegangen",
                                "target_lang_sense_clarification": "gehoben, poetisch für vergangen"
                            },
                            {
                                "target_lang_word": "einstig",
                                "target_lang_sense_clarification": "früher einmal existierend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1157acaf-36f6-3583-b736-484fd33a3960",
                    "sense_definition": "An event or situation that occurred in the past, often referring to past grievances or conflicts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to let <w>bygones</w> be <w>bygones</w> and move forward.",
                            "target_lang_translations": {
                                "zh": "他们决定让<w>往事</w>随风，继续向前看。",
                                "de": "Sie beschlossen, <w>Vergangenes auf sich beruhen zu lassen</w> und nach vorne zu blicken."
                            }
                        },
                        {
                            "text": "The old friends met to discuss their shared <w>bygones</w> over a quiet dinner.",
                            "target_lang_translations": {
                                "zh": "老朋友们在安静的晚餐中聚在一起讨论他们共同的<w>往事</w>。",
                                "de": "Die alten Freunde trafen sich, um bei einem ruhigen Abendessen über <w>Vergangenes</w> zu sprechen."
                            }
                        }
                    ],
                    "synonyms": [
                        "past"
                    ],
                    "common_phrases": [
                        "let bygones be bygones"
                    ],
                    "target_lang_definitions": {
                        "zh": "指过去发生的事情，常用于指代过去的恩怨或冲突。",
                        "de": "Ein Ereignis oder eine Situation aus der Vergangenheit, oft bezogen auf frühere Kränkungen, Streitereien oder Konflikte."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "往事",
                                "target_lang_sense_clarification": "指过去的事情。"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Vergangenes",
                                "target_lang_sense_clarification": "zurückliegende Ereignisse oder Konflikte"
                            },
                            {
                                "target_lang_word": "alte Geschichten",
                                "target_lang_sense_clarification": "meist im Plural, vergangene Streitigkeiten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "faa0bb59-bb3f-3ff6-b932-551e5a27039f",
                    "sense_definition": "An object or artifact originating from a previous time period.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique shop was filled with interesting <w>bygones</w> from the nineteenth century.",
                            "target_lang_translations": {
                                "zh": "这家古董店里摆满了十九世纪有趣的<w>古物</w>。",
                                "de": "Der Antiquitätenladen war voll von interessanten <w>Relikten</w> aus dem neunzehnten Jahrhundert."
                            }
                        },
                        {
                            "text": "Collectors often search for rare <w>bygones</w> at local estate sales.",
                            "target_lang_translations": {
                                "zh": "收藏家们经常在当地的遗产拍卖会上搜寻稀有的<w>古物</w>。",
                                "de": "Sammler suchen bei örtlichen Nachlassverkäufen oft nach seltenen <w>Erinnerungsstücken</w> aus früherer Zeit."
                            }
                        }
                    ],
                    "synonyms": [
                        "historical"
                    ],
                    "target_lang_definitions": {
                        "zh": "指来自过去时代的物品或文物。",
                        "de": "Ein Gegenstand oder Artefakt aus einer früheren Zeitepoche."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "古物",
                                "target_lang_sense_clarification": "指古代遗留下来的物品。"
                            },
                            {
                                "target_lang_word": "旧物",
                                "target_lang_sense_clarification": "指过去使用过的物品。"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Relikt",
                                "target_lang_sense_clarification": "Überbleibsel aus einer früheren Zeit"
                            },
                            {
                                "target_lang_word": "Überbleibsel",
                                "target_lang_sense_clarification": "etwas aus der Vergangenheit Erhaltenes"
                            },
                            {
                                "target_lang_word": "Erinnerungsstück",
                                "target_lang_sense_clarification": "Gegenstand aus vergangener Zeit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}