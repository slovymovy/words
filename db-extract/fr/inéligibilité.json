                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3394374-3f9b-4295-8aa7-65ee6456efee",
                                "sense_id": "5dd83b71-b744-3794-ac3b-5bb7b0c9a182",
                                "text": "La veille, la triple candidate à l'élection présidentielle a été condamnée en première instance à quatre ans de prison, dont deux ferme, et cinq ans d'inéligibilité avec exécution provisoire. Ce dispositif rend l'inéligibilité immédiate, dans l'attente du jugement en appel, prévu à l'été 2026."
                            }
                        ]
