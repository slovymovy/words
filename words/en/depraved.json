{
    "word_family": [
        "deprave",
        "depravity",
        "depravement",
        "depravedly",
        "depravedness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5c1b0fea-e0c6-32d9-8d05-684f8c8816e4",
                    "sense_definition": "Morally corrupt, wicked, or perverted.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "moral_corruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The serial killer was described by the judge as a completely <w>depraved</w> individual.",
                            "target_lang_translations": {
                                "ru": "Судья охарактеризовал серийного убийцу как совершенно <w>порочного</w> человека."
                            }
                        },
                        {
                            "text": "Only a deeply <w>depraved</w> mind could devise such a cruel and horrifying scheme.",
                            "target_lang_translations": {
                                "ru": "Только глубоко <w>извращённый</w> ум мог придумать столь жестокий и ужасающий план."
                            }
                        }
                    ],
                    "synonyms": [
                        "corrupt",
                        "perverted",
                        "wicked",
                        "immoral",
                        "debased"
                    ],
                    "antonyms": [
                        "virtuous",
                        "righteous",
                        "moral",
                        "pure"
                    ],
                    "common_phrases": [
                        "depraved mind",
                        "depraved indifference",
                        "depraved behavior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Морально разложившийся, порочный, испорченный или извращённый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порочный",
                                "target_lang_sense_clarification": "склонный к греху, злу или дурным наклонностям"
                            },
                            {
                                "target_lang_word": "развращённый",
                                "target_lang_sense_clarification": "морально падший, распущенный"
                            },
                            {
                                "target_lang_word": "испорченный",
                                "target_lang_sense_clarification": "морально растлённый, испорченный нравственно"
                            },
                            {
                                "target_lang_word": "извращённый",
                                "target_lang_sense_clarification": "грубо нарушающий нравственные нормы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ccc697b-9387-3c77-9894-dc32045e8a9e",
                    "sense_definition": "Distorted, perverted, or unnatural, especially of physical functions or appetites.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abnormal_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient suffered from a <w>depraved</w> appetite that caused her to crave non-nutritive substances.",
                            "target_lang_translations": {
                                "ru": "Пациентка страдала от <w>извращённого</w> аппетита, из-за которого ей хотелось есть несъедобные вещества."
                            }
                        },
                        {
                            "text": "Severe nutritional deficiencies can result in a strangely <w>depraved</w> sense of taste.",
                            "target_lang_translations": {
                                "ru": "Острая нехватка питательных веществ может приводить к странно <w>искажённому</w> вкусовому восприятию."
                            }
                        }
                    ],
                    "synonyms": [
                        "abnormal",
                        "distorted",
                        "perverted",
                        "unnatural"
                    ],
                    "antonyms": [
                        "normal",
                        "natural",
                        "healthy"
                    ],
                    "common_phrases": [
                        "depraved appetite"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically in medical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Искажённый, извращённый или неестественный (обычно о физиологических функциях, вкусах или аппетите)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извращённый",
                                "target_lang_sense_clarification": "неестественный, аномальный (о вкусе, аппетите)"
                            },
                            {
                                "target_lang_word": "аномальный",
                                "target_lang_sense_clarification": "патологически отклоняющийся от нормы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a65f3832-7f57-3c6a-b220-3bf74e1ca66f",
                    "sense_definition": "simple past and past participle of <w>deprave</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Unchecked corruption had gradually <w>depraved</w> the moral character of the entire institution.",
                            "target_lang_translations": {
                                "ru": "Бесконтрольная коррупция постепенно <w>разложила</w> моральный облик всего института."
                            }
                        },
                        {
                            "text": "He believed that exposure to violent crime deeply <w>depraved</w> innocent minds.",
                            "target_lang_translations": {
                                "ru": "Он считал, что столкновение с преступлениями, сопряжёнными с насилием, глубоко <w>растлевает</w> невинные души."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "inflected verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "прошедшее время и причастие прошедшего времени от deprave (развращать, растлевать, портить нравственно)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развратил",
                                "target_lang_sense_clarification": "форма прошедшего времени от глагола «развратить»"
                            },
                            {
                                "target_lang_word": "растлил",
                                "target_lang_sense_clarification": "форма прошедшего времени от глагола «растлить»"
                            },
                            {
                                "target_lang_word": "развращённый",
                                "target_lang_sense_clarification": "страдательное причастие прошедшего времени"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}