                "senses": [
                    {
                        "sense_id": "f7c2582e-2a30-34f3-9ce9-391ab62435ab",
                        "entry_id": "9c6cb149-0a7e-3048-885f-f26d236326ba",
                        "glosses": [
                            "zumeist längliche oder runde Vorrichtung mit mehreren Anschlüssen für Stromkabel zur gleichzeitigen Versorgung mehrerer elektrischer Geräte mit Energie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a4b0f26-dc3e-4595-9800-c4d969baa47c",
                                "sense_id": "f7c2582e-2a30-34f3-9ce9-391ab62435ab",
                                "text": "„Wenn sie an eine Mehrfachsteckdose viele andere Mehrfachsteckdosen hängen, überlasten sie die Leitung.“"
                            },
                            {
                                "example_id": "2823148f-767e-4298-9e8b-8bd21061d909",
                                "sense_id": "f7c2582e-2a30-34f3-9ce9-391ab62435ab",
                                "text": "„Wer jemals genauer auf das Ladegerät eines Handys, die Unterseite einer Computermaus oder eine Mehrfachsteckdose geschaut hat, findet dort meist eine Reihe von Zeichen.“"
                            },
                            {
                                "example_id": "aacfd958-2105-4336-a3e1-181d6dd59b4e",
                                "sense_id": "f7c2582e-2a30-34f3-9ce9-391ab62435ab",
                                "text": "„Das Leitungsnetz der Wohnung ist in der Regel längst nicht überlastet, wenn eine schlecht konstruierte Mehrfachsteckdose bereits schmort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
