                        "entry_id": "6fae035b-f8c0-32f8-95dd-fa8d6d4930d4",
                        "glosses": [
                            "groupuscule (small political group)"
                        ],
                        "tags": [
                            "derogatory",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "a8996232-5edf-47a4-ae0b-4e57f3532808",
                                "sense_id": "ab3daf5f-37ed-3761-93ac-171016bd00a5",
                                "text": "un groupuscule d'extrême droite",
                                "translation": "a small far-right group",
                                "english": "a small far-right group"
                            },
                            {
                                "example_id": "a0127e1e-400c-45dc-9a4b-65de5738f6ff",
                                "sense_id": "ab3daf5f-37ed-3761-93ac-171016bd00a5",
                                "text": "En France, même s’il n’est pas passé à l’action, on peut citer le groupuscule AFO (action des forces opérationnelles) démantelé cet été qui projetait de s’en prendre à des musulmans."
                            }
                        ]
                    }
