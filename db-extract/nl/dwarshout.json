                        "glosses": [
                            "langwerpig houten onderdeel dat haaks op de lengte of bewegingsrichting van een groter geheel is bevestigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b52fd5d4-d36a-4bfc-9507-cdb278dc0197",
                                "sense_id": "7ca12dd9-31f2-3ece-a552-d13ed7287ec6",
                                "text": "Ook het dwarshout van het kruis en de het ‘titulusbord’ zijn nog duidelijk herkenbaar."
                            },
                            {
                                "example_id": "9b60ba10-1ac6-47f7-b0cd-d111f6aa38a5",
                                "sense_id": "7ca12dd9-31f2-3ece-a552-d13ed7287ec6",
                                "text": "Degene die in dit voertuigje zit, houdt zijn voeten uitgestrekt voor zich en steunt ze tegen een dwarshout, en met in iedere hand een stok, die voorzien is van een vlijmscherpen stalen punt, prikt hij in het ijs en duwt zich op die manier vooruit."
                            }
                        ]
