                "senses": [
                    {
                        "sense_id": "c13bbb8e-466d-3581-85d5-f0972f10f0b4",
                        "entry_id": "bcdfaca1-0359-34dc-afa5-43f0b125f1f9",
                        "glosses": [
                            "der Entlassungsschein, den jemand bei seiner Entlassung vom Militär enthielt"
                        ],
                        "tags": [
                            "ursprünglich"
                        ],
                        "examples": [
                            {
                                "example_id": "fbce6b7d-e300-4e80-b687-2ef41f84c689",
                                "sense_id": "c13bbb8e-466d-3581-85d5-f0972f10f0b4",
                                "text": "Der Soldat erhielt den Laufpass, damit er zukünftig nicht als Deserteur behandelt werde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2733ef49-6439-3956-8f03-8fb3bad44873",
                        "entry_id": "bcdfaca1-0359-34dc-afa5-43f0b125f1f9",
                        "glosses": [
                            "jemandem den Laufpass geben, mit der Bedeutung: „sich von jemandem trennen“ oder den Laufpass bekommen, mit der Bedeutung „abgeschoben werden“"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "b82a0f22-9f05-460f-b699-7d4be96a7fb6",
                                "sense_id": "2733ef49-6439-3956-8f03-8fb3bad44873",
                                "text": "Er hatte vom Regierungsrat den Laufpass bekommen."
                            },
                            {
                                "example_id": "0afca8bb-808b-4dfb-aa37-42e369e1d285",
                                "sense_id": "2733ef49-6439-3956-8f03-8fb3bad44873",
                                "text": "„Vor zwei Wochen hatte Helen ihm den Laufpass gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
