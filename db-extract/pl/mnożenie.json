                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "602ac460-fca4-467e-b3fa-990e8385bc4b",
                                "sense_id": "c91b4412-2aa2-35eb-afbb-e36c253c778a",
                                "text": "Pierścień w którym mnożenie jest odwracalne (z wyjątkiem mnożenia przez zero) to ciało."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "3d939d88-b484-39cf-ade0-8b332f6f9f57",
