                                "example_id": "884fce1e-d648-45bd-9553-b6629ff43366",
                                "sense_id": "dda7a9e7-3572-3ce4-a600-2b3d60f379c7",
                                "text": "Ils le léchouillent, ils mordouillent, bavouillent, pissouillent."
                            }
                        ]
