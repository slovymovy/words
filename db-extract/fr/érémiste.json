                        "translation_id": "ea10df7e-7720-4cff-84dd-a02c7df7b501",
                        "source_entry_id": "e1dbc72c-abcd-36dc-b437-b94b37daef3b",
                        "source_sense_id": "b5d8c5ad-2e85-3bf7-9241-13e4856ae1d0",
                        "source_sense_description": "Verwaltung: Person, die ein staatliches Grundeinkommen für Mittellose empfängt; Sozialhilfeempfänger",
                        "target_lang_word": "Sozialhilfeempfänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sozialhilfeempfänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61a87c58-8ef3-3602-a4a6-ec0727cecedc",
                                        "entry_id": "3c5ebc4b-3670-32e1-b772-cb8742c5070b",
                                        "glosses": [
                                            "Person, die staatliche Unterstützungsleistungen (= Sozialhilfe) bezieht, da sie selbst zu wenig Einkommen für Miete, Essen, Kleidung hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "191fc78e-6f6c-4720-a3a1-68a4377b17b4",
                                                "sense_id": "61a87c58-8ef3-3602-a4a6-ec0727cecedc",
                                                "text": "Sozialhilfeempfänger in Deutschland sammeln oft Pfandflaschen, um ihre Sozialhilfe etwas aufzustocken."
                                            },
                                            {
                                                "example_id": "c6f9130c-f9d3-4a04-a83a-80cfaa4608ee",
                                                "sense_id": "61a87c58-8ef3-3602-a4a6-ec0727cecedc",
                                                "text": "[Großbritanien:] „Sozialhilfeempfänger sorgen sich um ihre Sozialleistungen.“"
                                            },
                                            {
                                                "example_id": "59b127e8-d2ce-433a-b0d1-8f3bb6b89e8d",
                                                "sense_id": "61a87c58-8ef3-3602-a4a6-ec0727cecedc",
                                                "text": "[Ungarn:] „Kommunale Arbeit ist für Sozialhilfeempfänger obligatorisch, wer nicht teilnimmt, verliert seinen Anspruch auf Sozialhilfe.“"
                                            },
                                            {
                                                "example_id": "ca4eda1a-e2a6-487c-ab7d-4c6ce208bb09",
                                                "sense_id": "61a87c58-8ef3-3602-a4a6-ec0727cecedc",
                                                "text": "[Großbritanien:] „»Vor allem die harten Strafen gegen Sozialhilfeempfänger, die eingeführt wurden, um die Sozialausgaben zu kürzen, hatten großen Einfluss auf den Anstieg der Obdachlosigkeit.«“"
                                            },
                                            {
                                                "example_id": "d6834d9c-11ee-4089-8f54-2236c89470ad",
                                                "sense_id": "61a87c58-8ef3-3602-a4a6-ec0727cecedc",
                                                "text": "[Coronapandemie in Deutschland 2022:] „Auch wenn nach dem Gesetz Sozialhilfeempfänger ihre Masken selbst bezahlen müssten, reiche das Geld nicht immer, um davon Schutzmasken zu kaufen.“"
                                            },
                                            {
                                                "example_id": "5ef14612-d1e3-4163-a264-eacc3df61474",
                                                "sense_id": "61a87c58-8ef3-3602-a4a6-ec0727cecedc",
                                                "text": "[Hallesche Wohnungsgesellschaft HWG:] „20 Prozent ihrer Wohnungen will die HGW Sozialhilfeempfängerinnen und Sozialhilfeempfängern zur Verfügung stellen.“"
                                            },
                                            {
                                                "example_id": "14e09be8-6f28-46f3-8cd3-2208a55e52f8",
                                                "sense_id": "61a87c58-8ef3-3602-a4a6-ec0727cecedc",
                                                "text": "[Deutschland:] „Zur Wahrheit gehört allerdings auch, dass die Zahl der Sozialhilfeempfänger unter arabischen und afrikanischen Flüchtlingen noch immer sehr hoch ist. Eine knappe Million lebt von den staatlichen Leistungen.“"
                                            },
                                            {
                                                "example_id": "26c31cb6-eb77-4488-8e12-6563c0c153b1",
                                                "sense_id": "61a87c58-8ef3-3602-a4a6-ec0727cecedc",
                                                "text": "„Die Arbeitslosigkeit und die Zahl der Sozialhilfeempfänger lagen schon zuvor über dem französischen Durchschnitt.“"
                                            },
                                            {
                                                "example_id": "84af9e8e-7e17-4863-b67d-59e00cdbcb5c",
                                                "sense_id": "61a87c58-8ef3-3602-a4a6-ec0727cecedc",
                                                "text": "„Die Möglichkeit, sich als Sozialhilfeempfänger in Härtefällen verschreibungspflichtige Verhütungsmittel rückerstatten zu lassen, gibt es auch jetzt schon.“"
                                            },
                                            {
                                                "example_id": "c98588fc-4861-4adb-b620-77a3f609a521",
                                                "sense_id": "61a87c58-8ef3-3602-a4a6-ec0727cecedc",
                                                "text": "„Die Jobcenter, meist als gemeinsame Einrichtungen von Kommunen und Arbeitsagentur, betreuen alle Hilfebedürftigen. Für viele Sozialhilfeempfänger sollte das Zugang zur Arbeitsvermittlung bedeuten,“ […]."
                                            },
                                            {
                                                "example_id": "bc4e08f0-e554-4398-990b-b7b1b794e10d",
                                                "sense_id": "61a87c58-8ef3-3602-a4a6-ec0727cecedc",
                                                "text": "„Als Limonow als Sozialhilfeempfänger in den USA den anderen, bettelarmen Migranten erzählt, dass zuhause Bildung und medizinische Fürsorge für jedermann umsonst sei, sind diese basserstaunt über diese paradiesischen Zustände und fragen Limonow, wie er dieses Land nur verlassen konnte.“"
                                            },
                                            {
                                                "example_id": "49ce186a-e2b8-44a4-a3ea-ce35044d27e0",
                                                "sense_id": "61a87c58-8ef3-3602-a4a6-ec0727cecedc",
                                                "text": "[Frankreich:] […] „Nehmen beschäftigungslose Sozialhilfeempfänger eine bezahlte Tätigkeit an, so dürfen sie 62 Prozent des Verdienstes zusätzlich zur Sozialleistung behalten, bis zu einer Obergrenze etwas über dem Mindestlohn von derzeit 1321 Euro.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
