                },
                {
                    "sense_id": "d705a0f1-047b-3179-b34d-3f821ed10f78",
                    "sense_definition": "D'une manière claire, précise et facile à distinguer par les sens ou l'esprit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Même de loin, on pouvait distinguer <w>nettement</w> la silhouette de la montagne.",
                            "target_lang_translations": {
                                "en": "Even from far away, you could <w>clearly</w> make out the outline of the mountain.",
                                "ru": "Даже издалека можно было <w>отчётливо</w> различить силуэт горы.",
                                "de": "Selbst aus der Ferne konnte man die Silhouette des Berges <w>deutlich</w> erkennen.",
                                "es": "Incluso desde lejos se podía distinguir <w>claramente</w> la silueta de la montaña.",
                                "zh": "即使从远处，也能<w>清楚</w>地看出山的轮廓。"
                            }
                        },
                        {
                            "text": "Le professeur parle à voix haute pour que chacun puisse l'entendre <w>nettement</w>.",
                            "target_lang_translations": {
                                "en": "The teacher speaks up so that everyone can hear them <w>clearly</w>.",
                                "ru": "Учитель говорит громко, чтобы каждый мог <w>отчётливо</w> его расслышать.",
                                "de": "Der Lehrer spricht laut, damit jeder ihn <w>deutlich</w> hören kann.",
                                "es": "El profesor habla en voz alta para que cada uno pueda oírlo <w>claramente</w>.",
                                "zh": "老师大声说话，好让每个人都能<w>清楚</w>地听见他的声音。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clairement",
                        "distinctement",
                        "précisément"
                    ],
                    "antonyms": [
                        "confusément",
                        "vaguement"
                    ],
                    "common_phrases": [
                        "distinguer nettement",
                        "entendre nettement",
                        "voir nettement"
                    ],
                    "target_lang_definitions": {
                        "en": "In a clear, precise way that is easy to perceive with the senses or the mind.",
                        "ru": "Ясно, отчётливо и так, что легко воспринять органами чувств или умом.",
                        "de": "Auf klare und genaue Weise, die mit den Sinnen oder dem Verstand leicht wahrzunehmen ist.",
                        "es": "De manera clara y precisa, fácil de percibir con los sentidos o con la mente.",
                        "zh": "清楚而准确，容易通过感官或头脑辨认。"
                    },
