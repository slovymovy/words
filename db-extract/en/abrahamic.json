    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1b84a5d3-2c6e-3d67-8b7e-b4d7204c3b9a",
                "word": "Abrahamic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "396d0fd7-341a-34fe-a67a-7a719970c93c",
                        "entry_id": "1b84a5d3-2c6e-3d67-8b7e-b4d7204c3b9a",
                        "glosses": [
                            "Pertaining to Abraham, the patriarch."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9f572faf-7138-4d5c-af7d-dd2eaa6d5720",
                                "sense_id": "396d0fd7-341a-34fe-a67a-7a719970c93c",
                                "text": "[T]he Noachic and Abrahamic churches are connected by Shem, and the other long-lived patriarchs, who existed before the apostasy of Noah's posterity, and survived it"
                            },
                            {
                                "example_id": "b8bd3ea6-88bd-4c5f-b119-2f3137cdf43a",
                                "sense_id": "396d0fd7-341a-34fe-a67a-7a719970c93c",
                                "text": "Paul's faith was at this crisis in his spiritual illumination more Abrahamic than Christlike in its character."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7dc4368-c31d-34b3-b8c1-b93a34977911",
                        "entry_id": "1b84a5d3-2c6e-3d67-8b7e-b4d7204c3b9a",
                        "glosses": [
                            "Descended from the religious tradition of Abraham."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "70393b8b-3ef6-40ae-9347-e74ed2b3c2ef",
                                "sense_id": "b7dc4368-c31d-34b3-b8c1-b93a34977911",
                                "text": "Judaism, Christianity, Islam and the Baháʼí Faith are all Abrahamic religions."
                            },
                            {
                                "example_id": "c8b30c17-b2fa-4dc9-83da-7a429a2dcb9e",
                                "sense_id": "b7dc4368-c31d-34b3-b8c1-b93a34977911",
                                "text": "[The messianic] does not belong properly to any Abrahamic religion (even if I may here continue “entre nous” for essential reasons of language and of place, of culture, and of provisional rhetorical and historical strategy of which I will speak later, to give to it names inscribed by the Abrahamic religions)."
                            },
                            {
                                "example_id": "5a5969cf-0ddb-4801-8e5d-683f219bf6e4",
                                "sense_id": "b7dc4368-c31d-34b3-b8c1-b93a34977911",
                                "text": "Most anthropologists, myself at the forefront, are doubtless incredibly naive about the nature of Christianity and provincial with respect to the depth and riches of Abrahamic-based theory for the analysis of religious phenomena more broadly no less than for philosophy."
                            },
                            {
                                "example_id": "c02a29e9-963b-4d58-a86e-140d028127ca",
                                "sense_id": "b7dc4368-c31d-34b3-b8c1-b93a34977911",
                                "text": "Christianity, not Islam, was the first of the Abrahamic cults to come to the Sudan."
                            }
                        ]
                    }
                ],
