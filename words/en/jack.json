    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "157f01c9-41e6-373f-b4dd-a083c0423311",
                    "sense_definition": "The playing card ranking between the ten and the queen, typically bearing a picture of a soldier or servant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He played the <w>jack</w> of hearts to win the trick.",
                            "target_lang_translations": {
                                "ru": "Он пошел с <w>валета</w> червей, чтобы выиграть взятку.",
                                "zh": "为了赢得这一墩，他打出了红桃<w>J</w>。"
                            }
                        },
                        {
                            "text": "You need a <w>jack</w> or higher to open the betting.",
                            "target_lang_translations": {
                                "ru": "Вам нужен <w>валет</w> или карта старше, чтобы открыть торги.",
                                "zh": "你得有一张<w>J</w>或更大的牌才能开叫。"
                            }
                        }
                    ],
                    "synonyms": [
                        "knave"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игральная карта, по старшинству находящаяся между десяткой и дамой, обычно с изображением солдата или слуги.",
                        "zh": "扑克牌中点数介于10和Q之间的那张牌，通常印有人物图像。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "валет",
                                "target_lang_sense_clarification": "игральная карта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "J",
                                "target_lang_sense_clarification": "扑克牌中的J"
                            },
                            {
                                "target_lang_word": "杰克",
                                "target_lang_sense_clarification": "纸牌名称，正式些"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ab89699-3336-306f-ab6d-55ed3ee81299",
                    "sense_definition": "A mechanical device used to lift heavy objects, especially to raise a vehicle to change a tire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a <w>jack</w> to lift the car and change the flat tire.",
                            "target_lang_translations": {
                                "ru": "Она использовала <w>домкрат</w>, чтобы поднять машину и заменить спущенное колесо.",
                                "zh": "她用<w>千斤顶</w>把车顶起来，换了漏气的轮胎。"
                            }
                        },
                        {
                            "text": "Make sure the <w>jack</w> is stable before you work under the vehicle.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что <w>домкрат</w> стоит устойчиво, прежде чем работать под автомобилем.",
                                "zh": "在车底下干活之前，一定要确保<w>千斤顶</w>放稳了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Механическое устройство, используемое для поднятия тяжелых предметов, особенно для поднятия автомобиля при смене колеса.",
                        "zh": "用来抬升重物的机械装置，尤其是换轮胎时顶起汽车的工具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "домкрат",
                                "target_lang_sense_clarification": "инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "千斤顶",
                                "target_lang_sense_clarification": "顶起汽车等重物的工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93b6d101-9bbf-32e5-be69-960dc6794d13",
                    "sense_definition": "A socket or connector used to connect a device to a circuit or network, such as for audio or telephone equipment.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please plug the headphones into the audio <w>jack</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, вставьте наушники в аудио<w>разъём</w>.",
                                "zh": "请把耳机插入音频<w>插孔</w>。"
                            }
                        },
                        {
                            "text": "The phone <w>jack</w> is located on the wall behind the desk.",
                            "target_lang_translations": {
                                "ru": "Телефонное <w>гнездо</w> находится на стене за столом.",
                                "zh": "电话<w>插口</w>在书桌后面的墙上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "socket"
                    ],
                    "antonyms": [
                        "plug"
                    ],
                    "common_phrases": [
                        "headphone jack",
                        "phone jack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гнездо или разъем, используемый для подключения устройства к цепи или сети, например, для аудио- или телефонного оборудования.",
                        "zh": "用于把设备连接到电路或网络的插接接口，例如音频或电话设备上的接口。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разъём",
                                "target_lang_sense_clarification": "соединитель"
                            },
                            {
                                "target_lang_word": "гнездо",
                                "target_lang_sense_clarification": "отверстие для штекера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "插孔",
                                "target_lang_sense_clarification": "电子设备上的接口孔"
                            },
                            {
                                "target_lang_word": "插口",
                                "target_lang_sense_clarification": "电话、音频等设备的连接口"
                            },
                            {
                                "target_lang_word": "接口",
                                "target_lang_sense_clarification": "较通用的技术说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad7ea1d7-6ef8-3ea9-89cc-3ec297e512f5",
                    "sense_definition": "Absolutely nothing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "slang_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not do <w>jack</w> to help us with the project.",
                            "target_lang_translations": {
                                "ru": "Он <w>ни черта</w> не сделал, чтобы помочь нам с проектом.",
                                "zh": "这个项目他一点<w>屁事</w>都没帮上。"
                            }
                        },
                        {
                            "text": "I know <w>jack</w> about fixing cars.",
                            "target_lang_translations": {
                                "ru": "Я <w>ни черта</w> не смыслю в ремонте машин.",
                                "zh": "我对修车<w>一窍不通</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jack shit"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Абсолютно ничего (грубый сленг).",
                        "zh": "绝对没有，什么也不是；粗俗俚语用法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ни черта",
                                "target_lang_sense_clarification": "разговорное, грубое"
                            },
                            {
                                "target_lang_word": "ни шиша",
                                "target_lang_sense_clarification": "просторечие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屁事",
                                "target_lang_sense_clarification": "粗俗俚语，表示完全没有"
                            },
                            {
                                "target_lang_word": "一点也没有",
                                "target_lang_sense_clarification": "表示什么都不懂、没有任何东西"
                            },
                            {
                                "target_lang_word": "一窍不通",
                                "target_lang_sense_clarification": "用于“知道、懂”一类语境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19f62eea-bf63-351a-9017-058217177b1c",
                    "sense_definition": "A generic term for a man or a fellow; often used to refer to an ordinary person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>jack</w> of all trades but master of none.",
                            "target_lang_translations": {
                                "ru": "Он <w>мастер</w> на все руки, но толком ничего не умеет.",
                                "zh": "他是个<w>万事通</w>，但样样都不精。"
                            }
                        },
                        {
                            "text": "They say that every <w>jack</w> has his Jill.",
                            "target_lang_translations": {
                                "ru": "Говорят, что у каждого <w>Ивана</w> есть своя Марья.",
                                "zh": "人们常说，每个<w>男人</w>都有与他相配的女人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jack of all trades"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общий термин для обозначения мужчины или парня; часто используется для обозначения обычного человека.",
                        "zh": "对男人、家伙的泛称，常指普通人；也见于固定说法中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парень",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "малый",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "男人",
                                "target_lang_sense_clarification": "泛指普通男人或家伙"
                            },
                            {
                                "target_lang_word": "家伙",
                                "target_lang_sense_clarification": "口语，指家伙、普通人"
                            },
                            {
                                "target_lang_word": "万事通",
                                "target_lang_sense_clarification": "如 jack of all trades 中常见译法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9e9406eb-da5f-3ed4-8d31-cadddcbfa09b",
                    "sense_definition": "A common unisex given name, often a pet form of John.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My brother <w>Jack</w> lives in London.",
                            "target_lang_translations": {
                                "ru": "Мой брат <w>Джек</w> живет в Лондоне.",
                                "zh": "我哥哥<w>杰克</w>住在伦敦。"
                            }
                        },
                        {
                            "text": "<w>Jack</w> and I went to school together.",
                            "target_lang_translations": {
                                "ru": "<w>Джек</w> и я ходили в школу вместе.",
                                "zh": "<w>杰克</w>和我以前一起上学。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенное мужское имя, часто уменьшительная форма от имени Джон.",
                        "zh": "常见的英文人名，通常是 John 的昵称形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джек",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杰克",
                                "target_lang_sense_clarification": "人名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77104f8b-d855-3dd0-86fa-ba296590ff53",
                    "sense_definition": "A brand of Tennessee whiskey.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "He ordered a glass of <w>Jack</w> and coke at the bar.",
                            "target_lang_translations": {
                                "ru": "Он заказал стакан <w>Джека</w> с колой в баре.",
                                "zh": "他在酒吧点了一杯<w>杰克丹尼</w>配可乐。"
                            }
                        },
                        {
                            "text": "We bought a bottle of <w>Jack</w> for the party.",
                            "target_lang_translations": {
                                "ru": "Мы купили бутылку <w>Джека</w> на вечеринку.",
                                "zh": "我们为聚会买了一瓶<w>杰克丹尼</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bottle of Jack"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Short for Jack Daniel's"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Марка теннессийского виски (сокращение от Jack Daniel's).",
                        "zh": "一种田纳西威士忌品牌，通常是 Jack Daniel's 的简称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джек",
                                "target_lang_sense_clarification": "разговорное название виски"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杰克丹尼",
                                "target_lang_sense_clarification": "威士忌品牌 Jack Daniel's 的简称"
                            },
                            {
                                "target_lang_word": "杰克丹尼威士忌",
                                "target_lang_sense_clarification": "更完整的品牌名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d932b36a-6305-3ea1-9fac-0b192934f1c9",
                    "sense_definition": "To raise or lift something heavy, especially a vehicle, using a mechanical device.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>jack</w> up the car to change the tire.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>поднять</w> машину <w>домкратом</w>, чтобы поменять колесо.",
                                "zh": "你得先把车<w>用千斤顶顶起来</w>，才能换轮胎。"
                            }
                        },
                        {
                            "text": "They <w>jacked</w> the house up to repair the foundation.",
                            "target_lang_translations": {
                                "ru": "Они <w>подняли</w> дом <w>домкратами</w>, чтобы отремонтировать фундамент.",
                                "zh": "为了修地基，他们把房子<w>用千斤顶顶了起来</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jack up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднимать что-либо тяжелое, особенно автомобиль, с помощью механического устройства.",
                        "zh": "用千斤顶把重物，尤其是车辆，顶起或抬起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать домкратом",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用千斤顶顶起来",
                                "target_lang_sense_clarification": "用千斤顶抬起重物或车辆"
                            },
                            {
                                "target_lang_word": "用千斤顶抬起",
                                "target_lang_sense_clarification": "较简洁的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "effb3e65-0b86-37bf-b6c3-3c57788006f4",
                    "sense_definition": "To steal something, typically a car.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Someone tried to <w>jack</w> his car from the parking lot.",
                            "target_lang_translations": {
                                "ru": "Кто-то пытался <w>угнать</w> его машину с парковки.",
                                "zh": "有人试图从停车场<w>偷走</w>他的车。"
                            }
                        },
                        {
                            "text": "He got <w>jacked</w> on his way home last night.",
                            "target_lang_translations": {
                                "ru": "Его <w>ограбили</w> по дороге домой прошлой ночью.",
                                "zh": "他昨晚回家路上被<w>抢劫</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украсть что-либо, обычно автомобиль.",
                        "zh": "偷走某物，通常指汽车；在某些语境中也可指抢劫别人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угнать",
                                "target_lang_sense_clarification": "об автомобиле"
                            },
                            {
                                "target_lang_word": "спереть",
                                "target_lang_sense_clarification": "украсть (сленг)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偷走",
                                "target_lang_sense_clarification": "偷走，常指车，也可泛指抢走"
                            },
                            {
                                "target_lang_word": "抢劫",
                                "target_lang_sense_clarification": "指对人实施抢劫"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9dcbf831-61a9-3f0a-beb9-1d5af6618e00",
                    "sense_definition": "Tired, disillusioned, or fed up with something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am completely <w>jack</w> of this rainy weather.",
                            "target_lang_translations": {
                                "ru": "Я <w>сыт по горло</w> этой дождливой погодой.",
                                "zh": "我真是对这种下雨天<w>烦透了</w>。"
                            }
                        },
                        {
                            "text": "She was <w>jack</w> of his constant complaining.",
                            "target_lang_translations": {
                                "ru": "Она была <w>сыта по горло</w> его постоянными жалобами.",
                                "zh": "她对他没完没了的抱怨已经<w>受够了</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fed up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Australian/New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уставший, разочарованный или сытый по горло чем-либо.",
                        "zh": "对某事感到厌倦、失望或受够了。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сыт по горло",
                                "target_lang_sense_clarification": "идиома"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烦透了",
                                "target_lang_sense_clarification": "口语，表示烦透了、受够了"
                            },
                            {
                                "target_lang_word": "受够了",
                                "target_lang_sense_clarification": "表示已经无法忍受"
                            },
                            {
                                "target_lang_word": "厌烦",
                                "target_lang_sense_clarification": "较书面"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}