                                "target_senses": [
                                    {
                                        "sense_id": "db8afad2-1f05-3f98-aab2-c99de45d1015",
                                        "entry_id": "de80bf36-352f-3bec-ac32-fb44f81d7f52",
                                        "glosses": [
