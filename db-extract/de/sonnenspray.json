                ],
                "senses": [
                    {
                        "sense_id": "0aeb922b-9c7d-3fa4-a964-92c1277cf7e0",
                        "entry_id": "784607d8-c7db-32a0-ae69-a475f0ce7d2c",
                        "glosses": [
                            "Spray zum Schutz der Haut gegen Sonnenstrahlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c68dcece-b30b-48b2-b8f6-bc88cf752a7f",
                                "sense_id": "0aeb922b-9c7d-3fa4-a964-92c1277cf7e0",
                                "text": "„Außerdem Wandersocken, zwei Pullis und eine Hose zum Wechseln, kurzärmliges Hemd und Sonnenspray, man kann nie wissen, vielleicht gibt es ja einen Sommerausbruch.“"
                            },
                            {
                                "example_id": "c574335a-74ca-4183-8b96-ea48f32f2769",
                                "sense_id": "0aeb922b-9c7d-3fa4-a964-92c1277cf7e0",
                                "text": "„Einige Gäste lassen sich in Eiscafés an der Uferpromenade nieder, andere nutzen die Gelegenheit, um Sonnenspray oder Bräunungsöl nachzukaufen.“"
                            },
                            {
                                "example_id": "846eb99e-0e27-4a30-80df-4d8a54bcf2c7",
                                "sense_id": "0aeb922b-9c7d-3fa4-a964-92c1277cf7e0",
                                "text": "„Trotz des frühen Startes und einer großen Menge Sonnenspray mit Lichtschutzfaktor 70, brannte uns die Haut wie Feuer und bildete auch hier und da schon einige stattliche Blasen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
