                "translations": [
                    {
                        "translation_id": "82ef56ab-dd62-4574-ae91-6859b2aed8a6",
                        "source_entry_id": "a469f63a-4cd5-3ff4-99ac-636c2f82bf10",
                        "source_sense_id": "0f7b2ae9-986c-38e3-ad2f-c0b3c0a08a5f",
                        "target_lang_word": "delivery room",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "delivery room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44861bff-c071-38f2-a8c5-3947e46552e7",
                                        "entry_id": "243cffd2-3e77-3cc0-bc1c-c80f71c15913",
                                        "glosses": [
                                            "An operating theatre or similar room in a hospital or other medical facility, furnished with suitable equipment and staffed by physicians, surgeons, or other medical workers, for the purpose of assisting mothers with the births of their babies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73c88cfd-09b2-4588-9086-f45729062942",
                                                "sense_id": "44861bff-c071-38f2-a8c5-3947e46552e7",
                                                "text": "Too many expectant mothers go to the delivery room terrified of what may be about to happen."
                                            },
                                            {
                                                "example_id": "787f9244-6228-4f3f-9049-de3f1e8ed92d",
                                                "sense_id": "44861bff-c071-38f2-a8c5-3947e46552e7",
                                                "text": "When the mothers and their babies are brought out of the delivery room, “the postpartum nurse greets them at the desk and starts the ‘oohs’ and ‘ahhs,’ and how lucky they were to have the nurse in the delivery,” Ms. Callahan said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ce9cc6a-b268-4848-81f8-ff6cbd0473b4",
                        "source_entry_id": "a469f63a-4cd5-3ff4-99ac-636c2f82bf10",
                        "source_sense_id": "0f7b2ae9-986c-38e3-ad2f-c0b3c0a08a5f",
                        "target_lang_word": "Entbindungsstation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entbindungsstation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1109dba-6e7b-3aaf-bc1a-8ce871079a62",
                                        "entry_id": "60b5590e-c587-33af-856b-ca0cf67e7b32",
                                        "glosses": [
                                            "Abteilung in einem Krankenhaus, in der Geburten betreut werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9b3ca32-3713-4007-988f-2b6b80770086",
                                                "sense_id": "e1109dba-6e7b-3aaf-bc1a-8ce871079a62",
                                                "text": "„Sehr nervös wartet ein Vater in der Entbindungsstation.“"
                                            },
                                            {
                                                "example_id": "dcd48a64-125a-496e-a944-185468a6e235",
                                                "sense_id": "e1109dba-6e7b-3aaf-bc1a-8ce871079a62",
                                                "text": "„Auch in den Entbindungsstationen wird heute zunehmend auf die Atmosphäre der Geburtsräume geachtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
