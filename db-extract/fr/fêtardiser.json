                "senses": [
                    {
                        "sense_id": "233ea50a-7247-3cf4-ae52-3d90cf01502d",
                        "entry_id": "0ce21b32-87c9-33dd-9f17-ffa9ccf7c055",
                        "glosses": [
                            "Faire la fête, comme le fait un fêtard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1efc763-04e7-43cb-8d30-c687fcb14784",
                                "sense_id": "233ea50a-7247-3cf4-ae52-3d90cf01502d",
                                "text": "Néanmoins, les bars sont souvent petits, peu de chaises, peu de tables, incitant donc le fêtard a^([sic]) fêtardiser sur la place publique."
                            },
                            {
                                "example_id": "e828e1f7-5623-443e-a095-e8f8b5a1751e",
                                "sense_id": "233ea50a-7247-3cf4-ae52-3d90cf01502d",
                                "text": "Si j'étais un loisir, boire, manger, fêtardiser..."
                            },
                            {
                                "example_id": "56d2eadf-61b9-4417-946d-a5d3498189cb",
                                "sense_id": "233ea50a-7247-3cf4-ae52-3d90cf01502d",
                                "text": "Cette minuscule et rigolarde affaire d'apéritif “saucisson pinard” est une bénédiction, puisqu'elle a donné l'occasion de ressortir la cravache à tous nos petits Pères Fêtards, qui n'ont jamais toléré que l'on puisse fêtardiser en dehors de leur contrôle, dans les angles morts de leurs miradors citoyens."
                            }
                        ]
                    }
                ],
