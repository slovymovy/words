                "senses": [
                    {
                        "sense_id": "e0ece1ef-edde-30e0-b0e8-a5d36fe94ac4",
                        "entry_id": "2d4b6ebb-a033-339a-9f86-c0aef8b97786",
                        "glosses": [
                            "eine Stehmöglichkeit für Personen, zum Beispiel in öffentlichen Verkehrsmitteln, bei Sportveranstaltungen oder in der Oper"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b3d5349-71ba-48e4-96be-99c48b274fd1",
                                "sense_id": "e0ece1ef-edde-30e0-b0e8-a5d36fe94ac4",
                                "text": "Ich kann mir bei Fußballspielen nur die günstigeren Karten für Stehplätze leisten."
                            },
                            {
                                "example_id": "3cb0af25-50dd-46c6-b126-c8f186ceaabc",
                                "sense_id": "e0ece1ef-edde-30e0-b0e8-a5d36fe94ac4",
                                "text": "„Es gelang uns schließlich, einen guten Stehplatz zu kriegen – nicht weit entfernt vom Altar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28b0d21d-502b-43bf-8b68-a3fdd823f3dc",
                        "source_entry_id": "2d4b6ebb-a033-339a-9f86-c0aef8b97786",
                        "source_sense_id": "e0ece1ef-edde-30e0-b0e8-a5d36fe94ac4",
