                "entry_id": "5119f163-5768-3a9b-9327-4c67768f69e3",
                "word": "tschüssikowski",
                "pos": "phrase",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4591179b-e956-321d-974a-c10506cf5931",
                        "entry_id": "5119f163-5768-3a9b-9327-4c67768f69e3",
                        "glosses": [
                            "informeller Abschiedsgruß"
                        ],
                        "tags": [
                            "casual",
                            "colloquial",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "1b705779-0752-4445-b727-463ac46c2319",
                                "sense_id": "4591179b-e956-321d-974a-c10506cf5931",
                                "text": "Sie sagte: „Bis morgen! Tschüssikowski!“ und verschwand im Hauseingang."
                            },
                            {
                                "example_id": "5a53dd57-05b6-4f19-89d4-0995924b0631",
                                "sense_id": "4591179b-e956-321d-974a-c10506cf5931",
                                "text": "„Könnte sein, daß ick meene Droschke bald vakoofe und als Schreiberling tschüssikowski sage.“"
                            },
                            {
                                "example_id": "2612817b-ad0d-45bd-8543-0242a77762ae",
                                "sense_id": "4591179b-e956-321d-974a-c10506cf5931",
                                "text": "„Noch ein Rotwein, und ich verabschiede mich. Ciao, adieu, arrivederci, adiós, tschüssikowski!“"
                            },
                            {
                                "example_id": "489e9389-41ab-48d4-9a99-e111d615f892",
                                "sense_id": "4591179b-e956-321d-974a-c10506cf5931",
                                "text": "„Ich denke, das reicht für heute. Und tschüssikowski.“"
                            },
                            {
                                "example_id": "adf65d88-3004-4a5a-a1cd-c7218e511a7a",
                                "sense_id": "4591179b-e956-321d-974a-c10506cf5931",
                                "text": "„Stehen Sie einmal auf der Marmolada, dem höchsten Berg der Dolomiten, 3343 Meter über dem Meer, und lassen irgendetwas unbefugt rumbaumeln, das ist aber so etwas von weg, sage ich Ihnen, flutsch durch die Südwand oder nördlich, glitsch, in die nächste Gletscherspalte, tschüssikowski!“"
                            },
                            {
                                "example_id": "b51eca79-056e-4c62-aff8-083b2645d5ee",
                                "sense_id": "4591179b-e956-321d-974a-c10506cf5931",
                                "text": "„Da zitieren wir lieber Victor Hugo: Vierzig Jahre sind das Alter der Jugend, fünfzig die Jugend des Alters. Also hat das Alter gerade erst begonnen. Und wenn es vorbei ist: Na dann, tschüssikowski!“"
                            },
                            {
                                "example_id": "337e4f90-244b-480c-b199-5866abdfb5cd",
                                "sense_id": "4591179b-e956-321d-974a-c10506cf5931",
                                "text": "„Macht’s gut, das war toll mit euch, Kinder, tschüssikowski, ich hab euch alle lieb!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
