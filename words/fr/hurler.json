                {
                    "sense_id": "66aeb191-f759-3507-aa1c-4cf065760353",
                    "sense_definition": "Produire un bruit violent, continu et strident, en parlant du vent ou d'un avertisseur sonore.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bruits_elements",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La tempête approchait et le vent <w>hurlait</w> avec force contre les volets de la maison.",
                            "target_lang_translations": {
                                "en": "The storm was approaching and the wind was <w>howling</w> fiercely against the house's shutters.",
                                "ru": "Приближалась буря, и ветер с силой <w>завывал</w> у ставней дома.",
                                "nl": "De storm naderde en de wind <w>huilde</w> hard tegen de luiken van het huis.",
                                "de": "Der Sturm kam näher, und der Wind <w>heulte</w> heftig gegen die Fensterläden des Hauses.",
                                "pl": "Burza się zbliżała, a wiatr z całej siły <w>wył</w> przy okiennicach domu.",
                                "it": "La tempesta si avvicinava e il vento <w>ululava</w> con forza contro le persiane della casa.",
                                "cs": "Bouře se blížila a vítr s plnou silou <w>vyl</w> proti okenicím domu.",
                                "tr": "Fırtına yaklaşıyordu ve rüzgâr evin panjurlarına karşı şiddetle <w>uluyordu</w>.",
                                "es": "La tormenta se acercaba y el viento <w>aullaba</w> con fuerza contra los postigos de la casa.",
                                "zh": "暴风雨即将来临，狂风<w>呼啸</w>着猛烈拍打屋子的百叶窗。"
                            }
                        },
                        {
                            "text": "Quand l'incendie s'est déclaré, nous avons entendu la sirène qui <w>hurlait</w> dans toute l'usine.",
                            "target_lang_translations": {
                                "en": "When the fire broke out, we heard the siren <w>wailing</w> throughout the factory.",
                                "ru": "Когда начался пожар, мы услышали, как по всему заводу <w>выла</w> сирена.",
                                "nl": "Toen de brand uitbrak, hoorden we de sirene door de hele fabriek <w>loeien</w>.",
                                "de": "Als der Brand ausbrach, hörten wir die Sirene durch die ganze Fabrik <w>heulen</w>.",
                                "pl": "Gdy wybuchł pożar, usłyszeliśmy, jak syrena <w>wyła</w> na całym terenie zakładu.",
                                "it": "Quando è scoppiato l'incendio, abbiamo sentito la sirena che <w>ululava</w> in tutta la fabbrica.",
                                "cs": "Když vypukl požár, slyšeli jsme sirénu, která <w>houkala</w> po celé továrně.",
                                "tr": "Yangın çıktığında fabrikanın her yerinde sirenin <w>öttüğünü</w> duyduk.",
                                "es": "Cuando estalló el incendio, oímos la sirena que <w>aullaba</w> por toda la fábrica.",
                                "zh": "火灾发生时，我们听到警笛在整个工厂里<w>呼啸</w>。"
                            }
                        }
