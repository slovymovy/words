                "senses": [
                    {
                        "sense_id": "1aa5bfc5-1bcc-3f74-8f9b-7fe2bbd2f314",
                        "entry_id": "30af836a-5776-3916-bf99-8b338b7e2d35",
                        "glosses": [
                            "slow train, local train"
                        ],
                        "tags": [
                            "colloquial",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "f9de2fbf-1ab2-42f3-9d80-24522ddf6a64",
                                "sense_id": "1aa5bfc5-1bcc-3f74-8f9b-7fe2bbd2f314",
                                "text": "Wenn Sie Lust haben, fuhr der Vikar fort, können wir das Kloster einmal besuchen. Das interessierte mich allerdings sehr und so war die Sache abgemacht. Acht Tage später dampften wir zu dritt mit dem Bummelzuge (Schnellzüge halten nicht auf der Strecke) nach Rath, von wo man noch 1/4 Stunde bis zur Karthause hat."
                            },
                            {
                                "example_id": "f920afa3-ba8a-477b-9954-5a688c9ffb3b",
                                "sense_id": "1aa5bfc5-1bcc-3f74-8f9b-7fe2bbd2f314",
                                "text": "Breitenwert hatte nur einen kleinen Bahnhof. Viele Züge hielten da nicht, und die großen Schnellzüge fuhren immer sehr hochmütig an dem Städtchen vorbei, und nur die Bummelzüge ruhten sich behaglich ein Weilchen aus, ehe sie weiterdampften."
                            }
                        ]
                    }
                ],
