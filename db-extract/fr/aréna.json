                                "target_senses": [
                                    {
                                        "sense_id": "7e27f179-00ad-3f3d-a104-d2759742bdb3",
                                        "entry_id": "a0ed8f9e-0ad1-3d92-a690-b37733e30890",
                                        "glosses": [
                                            "An enclosed area, often outdoor, for the presentation of sporting events (sports arena) or other spectacular events; earthen area, often oval, specifically for rodeos (North America) or circular area for bullfights (especially Hispanic America)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5ff0b7a-64ee-4a22-aceb-4feccf2e37c8",
                                                "sense_id": "7e27f179-00ad-3f3d-a104-d2759742bdb3",
                                                "text": "A large crowd filled the seats of the arena."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7554a8e7-6b6e-30a7-8528-fdd43d999087",
                                        "entry_id": "a0ed8f9e-0ad1-3d92-a690-b37733e30890",
                                        "glosses": [
                                            "The building housing such an area; specifically, a very large, often round building, often topped with a dome, designated for indoor sporting or other major events, such as concerts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40968dfa-a82a-4c3d-a567-e7e273021f2e",
                                                "sense_id": "7554a8e7-6b6e-30a7-8528-fdd43d999087",
                                                "text": "The arena is grey with white beams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beac34f1-55b5-3208-bc02-f98e8faa6d58",
                                        "entry_id": "a0ed8f9e-0ad1-3d92-a690-b37733e30890",
                                        "glosses": [
                                            "The sand-covered centre of an amphitheatre where contests were held in Ancient Rome."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58b88c0b-88f0-4c48-a466-99cb1b9f292d",
                                                "sense_id": "beac34f1-55b5-3208-bc02-f98e8faa6d58",
                                                "text": "The gladiators entered the arena."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9a441c8-3bfc-319f-8d93-2b9e98fb3e0e",
                                        "entry_id": "a0ed8f9e-0ad1-3d92-a690-b37733e30890",
                                        "glosses": [
                                            "A realm in which events take place; an area of interest, study, behaviour, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2fe36eb-87aa-4949-9c7d-415d709e6b5c",
                                                "sense_id": "c9a441c8-3bfc-319f-8d93-2b9e98fb3e0e",
                                                "text": "The company was a player in the maritime insurance arena."
                                            },
                                            {
                                                "example_id": "f09faa6d-f367-4e47-92c4-c7840908d89b",
                                                "sense_id": "c9a441c8-3bfc-319f-8d93-2b9e98fb3e0e",
                                                "text": "But transects have also been utilised in a large variety of arenas, including surveying the contents of Amerindian earthen mounds, determining levels of anti-rabies vaccinations in village dogs, and examining ecological factors under the canopy of trees growing in agricultural areas."
                                            },
                                            {
                                                "example_id": "b3013aa3-fd3c-41d0-9097-703d4bb8b541",
                                                "sense_id": "c9a441c8-3bfc-319f-8d93-2b9e98fb3e0e",
                                                "text": "To Musk, his vast fortune is a mere side effect of his ability not just to see but to do things others cannot, in arenas where the stakes are existential."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
