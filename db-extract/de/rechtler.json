                ],
                "senses": [
                    {
                        "sense_id": "5faa7a88-4598-3146-adeb-0ff83845384a",
                        "entry_id": "2fdb2524-f6e3-39de-92bb-c79eebd7f972",
                        "glosses": [
                            "zur gemeinsamen Nutzung berechtigter Einwohner, oft von Kronen-, Ast- und Unterholz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d25a579c-473a-44dc-a9f0-9ccdbf13dd6e",
                                "sense_id": "5faa7a88-4598-3146-adeb-0ff83845384a",
                                "text": "„An diesem Punkt kommen die Rechtler ins Spiel – einst um die 180, heute noch etwa 100 an der Zahl.“"
                            },
                            {
                                "example_id": "e03ea75b-b6cd-43cd-b716-e2f67fbe36f4",
                                "sense_id": "5faa7a88-4598-3146-adeb-0ff83845384a",
                                "text": "„Am Burkhardstag machen die Rechtler, aktuell haben 72 Kreuzwertheimer Eigentum im Achtherrnholz, eine Grenzbegehung, an deren Ende immer eine offene Gasthaustür steht.“"
                            },
                            {
                                "example_id": "64f5984a-e40f-40be-adfd-918d89683540",
                                "sense_id": "5faa7a88-4598-3146-adeb-0ff83845384a",
                                "text": "„Auf dem Symposium kamen die Rechtler ebenso wenig zur Sprache wie die in der Schweiz noch vielfach vorhandenen Allmendkorporationen.“"
                            },
                            {
                                "example_id": "a5279aa0-452a-41af-b6ce-d949f57d9dab",
                                "sense_id": "5faa7a88-4598-3146-adeb-0ff83845384a",
                                "text": "„Verpachte ein Rechtler sein Wiesennutzungsrecht langfristig – wie in Wipfeld – handle es sich um eine Übertragung.“"
                            },
                            {
                                "example_id": "f07e68b3-ad67-4fa0-8974-e42684de6726",
                                "sense_id": "5faa7a88-4598-3146-adeb-0ff83845384a",
                                "text": "„Die Ausübung der Rechte setze Holznutzung im Staatswald voraus, da nur so das Oberholz anfalle, dessen Nutzung den Rechtlern zusteht.“"
                            },
                            {
                                "example_id": "db1a0cda-35dd-453a-99fb-6dafa696470a",
                                "sense_id": "5faa7a88-4598-3146-adeb-0ff83845384a",
                                "text": "„Oberholz in geöffneten Hieben steht allen Rechtlern in gleichem Maße zu, jedoch nur bis zur Deckung des Eigenbedarfs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
