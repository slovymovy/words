                        "glosses": [
                            "The sixth month of the Babylonian calendar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "104e2a4c-8f02-454c-a5e1-131edb2c87b7",
                                "sense_id": "2ee2c729-8b41-3e5f-bab1-7011e8a9fd95",
                                "text": "In the Babylonian 19-year cycle, most of the leap years add a second Adaru, but in the 17ᵗʰ year of the cycle, they add a second Ululu."
