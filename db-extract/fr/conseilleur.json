                    },
                    {
                        "sense_id": "20c3bf7f-1778-3bb3-999f-319f4d68c933",
                        "entry_id": "b84acc8e-3720-3be7-9e3a-7765cdf2442c",
                        "glosses": [
                            "Celui qui donne des conseils hors de propos."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "2a5a41ab-6b86-42d7-9572-aee522fae611",
                                "sense_id": "20c3bf7f-1778-3bb3-999f-319f4d68c933",
                                "text": "Le Brun n’hésite pas, frappe juste à chaque coup ; les remaniements ne viennent que des conseilleurs."
                            },
                            {
                                "example_id": "c60064f3-4d0e-47fd-bda5-ef2f3535388f",
                                "sense_id": "20c3bf7f-1778-3bb3-999f-319f4d68c933",
                                "text": "C’est un ennuyeux conseilleur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b131531-1194-4e05-b2cc-5924a5bf0855",
                        "source_entry_id": "b84acc8e-3720-3be7-9e3a-7765cdf2442c",
                        "source_sense_id": "ab7bbb95-d466-3198-b1cc-579db339d762",
                        "source_sense_description": "Celui qui donne des conseils hors de propos",
                        "target_lang_word": "Ratgeber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ratgeber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99b94bc0-4d42-385b-ac4f-1645bb34132e",
                                        "entry_id": "56b9e0b3-ba48-305c-8139-394e7287c9ec",
                                        "glosses": [
                                            "Person, die eine beratende Funktion ausübt; jemand, der Ratschläge geben kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "364b77d5-0ba8-42e3-8e9b-fc3ed8f6f5bf",
                                                "sense_id": "99b94bc0-4d42-385b-ac4f-1645bb34132e",
                                                "text": "Die Ratgeber des Präsidenten schlugen verschiedene Optionen vor."
                                            },
                                            {
                                                "example_id": "2606f444-1f8b-4e21-ac8a-63fd5b7cadc4",
                                                "sense_id": "99b94bc0-4d42-385b-ac4f-1645bb34132e",
                                                "text": "„Auch wenn in manchen Ballungsgebieten das Wohnraum-Angebot knapp ist - beim Immobilienkauf ist Hektik kein guter Ratgeber.“"
                                            },
                                            {
                                                "example_id": "c2328415-13b6-46ed-b8e8-5640a9ec7a03",
                                                "sense_id": "99b94bc0-4d42-385b-ac4f-1645bb34132e",
                                                "text": "„Die lokalen Monarchen wurden schnell auf den erfolgreichen Tuchhändler aufmerksam und stellten ihn als geistigen Ratgeber in ihre Dienste.“"
                                            },
                                            {
                                                "example_id": "d8a04c2e-2dca-4c88-a4b7-62c49100e02b",
                                                "sense_id": "99b94bc0-4d42-385b-ac4f-1645bb34132e",
                                                "text": "„Unsere Crew war bis auf einen Mann, den Koch, desertiert, so wie es häufig in Charleston vorkommt, und wir zogen den Koch als Ratgeber ins Vertrauen.“"
                                            },
                                            {
                                                "example_id": "5fbad553-9b49-4393-b904-fd0ff5b15850",
                                                "sense_id": "99b94bc0-4d42-385b-ac4f-1645bb34132e",
                                                "text": "„Es war der einzige menschliche Rat, an meine Person ergangen, die längst aller Ratgeber ledig war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2c6d802d-8fdc-3483-bf68-9295ddea1c5a",
                                        "entry_id": "56b9e0b3-ba48-305c-8139-394e7287c9ec",
                                        "glosses": [
                                            "Schriftstück mit Tipps oder spezielles Nachschlagewerk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffdb2dde-466c-4701-a759-d7ce99c9dc00",
                                                "sense_id": "2c6d802d-8fdc-3483-bf68-9295ddea1c5a",
                                                "text": "Holen Sie sich den Ratgeber für Sportwetten und mehr!"
                                            },
                                            {
                                                "example_id": "67784507-adbe-4aef-9987-b57181ff3d00",
                                                "sense_id": "2c6d802d-8fdc-3483-bf68-9295ddea1c5a",
                                                "text": "„Ansonsten hat sich aber die sexuelle Aufklärung dank der zahllosen Illustriertenartikel, Talkshows, Ratgeber, Interessenvertretungen und Selbsthilfegruppen flächendeckend weit verbreitet.“"
                                            },
                                            {
                                                "example_id": "4f630161-d5ed-4f1c-b966-42e9725bfad6",
                                                "sense_id": "2c6d802d-8fdc-3483-bf68-9295ddea1c5a",
                                                "text": "„Noch wirkungsvoller als praktische Ratgeber und Bibelübersetzungen ließ sich vermutlich jiddische Unterhaltungsliteratur zur Verbreitung von aufgeklärten Ideen und allgemeiner Bildung einsetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
