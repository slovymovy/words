                {
                    "sense_id": "72162808-d174-398a-8fcb-2d2e33dd1af6",
                    "sense_definition": "Calmer l'irritation, apaiser une humeur agressive ou modérer une sévérité excessive.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attenuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a tenté d'<w>adoucir</w> le ton pour éviter une dispute inutile.",
                            "target_lang_translations": {
                                "en": "He tried to <w>soften</w> his tone to avoid a pointless argument.",
                                "ru": "Он попытался <w>смягчить</w> тон, чтобы избежать бессмысленной ссоры.",
                                "de": "Er versuchte, seinen Tonfall zu <w>mildern</w>, um einen unnötigen Streit zu vermeiden.",
                                "es": "Intentó <w>suavizar</w> el tono para evitar una discusión inútil.",
                                "zh": "他试图<w>缓和</w>语气，以免引起一场无谓的争吵。"
                            }
                        },
                        {
                            "text": "Le directeur a promis d'<w>adoucir</w> les sanctions prévues contre les grévistes.",
                            "target_lang_translations": {
                                "en": "The director promised to <w>soften</w> the penalties planned against the strikers.",
                                "ru": "Директор пообещал <w>смягчить</w> санкции, предусмотренные против забастовщиков.",
                                "de": "Der Direktor versprach, die gegen die Streikenden geplanten Strafen zu <w>mildern</w>.",
                                "es": "El director prometió <w>suavizar</w> las sanciones previstas contra los huelguistas.",
                                "zh": "主任承诺会<w>软化</w>针对罢工者的处罚措施。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "adoucir le ton",
                        "adoucir la colère"
                    ],
                    "target_lang_definitions": {
                        "en": "To calm irritation, soothe an aggressive mood, or moderate excessive severity.",
                        "ru": "Успокаивать раздражение, смягчать агрессивный настрой или излишнюю строгость.",
                        "de": "Ärger oder eine gereizte Stimmung beruhigen oder übertriebene Strenge abschwächen.",
                        "es": "Calmar el enfado, suavizar un ánimo agresivo o moderar una severidad excesiva.",
                        "zh": "平息愤怒或激动的情绪，缓和语气，或减轻过于严厉的处罚。"
                    },
                    "translations": {
                        "en": [
