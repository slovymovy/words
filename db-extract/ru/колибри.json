                            {
                                "example_id": "ce7e1696-cd97-452c-8a15-e53b58f328e3",
                                "sense_id": "2b7037c2-8ea7-3af0-bcf1-f56c24915ea2",
                                "text": "Коли́бри — еди́нственная пти́ца, спосо́бная лета́ть наза́д.",
                                "translation": "The hummingbird is the only bird capable of flying backwards.",
                                "english": "The hummingbird is the only bird capable of flying backwards."
                            },
                            {
                                "example_id": "3b2bcc23-e5aa-41d8-b91d-e5103e8075ee",
                                "sense_id": "2b7037c2-8ea7-3af0-bcf1-f56c24915ea2",
                                "text": "В состоя́нии поко́я се́рдце коли́бри бьётся с частото́й 500 (пятьсо́т) уда́ров в мину́ту, а во вре́мя физи́ческой акти́вности 1200 (ты́сяча две́сти) и бо́лее.",
                                "translation": "At rest, a hummingbird's heart beats at a frequency of 500 beats per minute, and 1200 or more during physical activity.",
                                "english": "At rest, a hummingbird's heart beats at a frequency of 500 beats per minute, and 1200 or more during physical activity."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
