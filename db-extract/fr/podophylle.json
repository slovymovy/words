                    }
                ],
                "senses": [
                    {
                        "sense_id": "1adf848e-adeb-3539-8697-01c30145dcca",
                        "entry_id": "8c4926c8-a197-3377-a7d7-2a0d3392afcb",
                        "glosses": [
                            "Genre de plantes Berbéridacées, au feuillage toxique, croissant en Asie ou, pour l’espèce la plus connue (Podophyllum peltatum), en Amérique du Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f11a5e8-ebdb-427f-9fd9-5d4f12e26c72",
                                "sense_id": "1adf848e-adeb-3539-8697-01c30145dcca",
                                "text": "La podophylline, résine de podophylle, est extraite des rhizomes et des racines de plantes vivaces du genre Podophyllum (famille des Podophyllaceae)."
                            },
                            {
                                "example_id": "f2244015-1baf-4dd7-a0f9-b6ff3592b91a",
                                "sense_id": "1adf848e-adeb-3539-8697-01c30145dcca",
                                "text": "Le Podophylle est une plante vivace à souche rhizomateuse. Neuf espèces de vivaces composent le genre …."
                            }
                        ]
                    },
                    {
                        "sense_id": "50c25d72-fdeb-3ea5-8f0e-0fa3ab10fa68",
                        "entry_id": "8c4926c8-a197-3377-a7d7-2a0d3392afcb",
                        "glosses": [
                            "La partie de la membrane kératogène qui soutient le sabot des ongulés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b9590ad-a41f-402f-8fb7-b826de653c33",
                                "sense_id": "50c25d72-fdeb-3ea5-8f0e-0fa3ab10fa68",
                                "text": "L’engrènement du podophylle et du kéraphylle, assure l’adhésion des structures internes du pied (os et tissus mous) avec la paroi du sabot, à la manière d’un velcro."
                            },
                            {
                                "example_id": "d87f5b21-452f-4bda-8754-1bfa7ddceea6",
                                "sense_id": "50c25d72-fdeb-3ea5-8f0e-0fa3ab10fa68",
                                "text": "Il s'agit d' une inflammation du podophylle (tissu charnu, vascularisé et innervé qui maintient la troisième phalange à la paroi du sabot)."
                            }
                        ]
                    }
                ],
