                ],
                "senses": [
                    {
                        "sense_id": "3cec5b32-c09f-3f90-bf17-4e3501ed3cbf",
                        "entry_id": "9dff491b-be88-3022-885f-750e7628b07c",
                        "glosses": [
                            "Knochenvorsprung unter den Augenhöhlen, der den Oberkiefer mit dem Schläfenbein verbindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4754d133-8a33-4b8f-ad75-6293e1bc95ae",
                                "sense_id": "3cec5b32-c09f-3f90-bf17-4e3501ed3cbf",
                                "text": "„Er hatte die gleichen herabhängenden Schultern und kräftigen Wangenknochen.“"
                            },
                            {
                                "example_id": "df0a267c-039e-4f82-a17b-0edbf333db0f",
                                "sense_id": "3cec5b32-c09f-3f90-bf17-4e3501ed3cbf",
                                "text": "„Ihre hohen Wangenknochen machten sie früher sexy, schätze ich, inzwischen lassen sie sie streng wirken.“"
                            },
                            {
                                "example_id": "d7604a3e-0cd8-4ab8-919c-11a851b97f9e",
                                "sense_id": "3cec5b32-c09f-3f90-bf17-4e3501ed3cbf",
                                "text": "„Der Bruch seines linken Wangenknochens war zwar vollständig verheilt, aber die Knochenteile waren schlecht zusammengewachsen.“"
                            },
                            {
                                "example_id": "8b8726ef-82ce-4fa5-b925-87df1cb8f0e2",
                                "sense_id": "3cec5b32-c09f-3f90-bf17-4e3501ed3cbf",
                                "text": "„Beide hatten wir aufgeschlagene Wangenknochen, und unsere Haut hatte das Gedächtnis verloren und vergessen, wohin sie sich zurückschieben musste, wenn wir getroffen wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c8da911-40bd-48c6-bc3c-04ba37aa0e4e",
                        "source_entry_id": "9dff491b-be88-3022-885f-750e7628b07c",
                        "source_sense_id": "3cec5b32-c09f-3f90-bf17-4e3501ed3cbf",
                        "source_sense_description": "Anatomie: Knochenvorsprung unter den Augenhöhlen, der den Oberkiefer mit dem Schläfenbein verbindet",
                        "target_lang_word": "cheekbone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheekbone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39d6244c-788e-3830-b469-07b69c790e27",
                                        "entry_id": "59a8acac-5ff5-3dff-8a4c-e83d864cbe4b",
                                        "glosses": [
                                            "The small prominent bone of the cheek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36e2128f-8d24-4acd-aa10-24aeea5b74de",
                                                "sense_id": "39d6244c-788e-3830-b469-07b69c790e27",
                                                "text": "She was like a Beardsley Salome, he had said. And indeed she had the narrow eyes and the high cheekbone of that creature, and as nearly the sinuosity as is compatible with human symmetry."
                                            },
                                            {
                                                "example_id": "269b4283-0650-47a4-915b-4213a6d835cf",
                                                "sense_id": "39d6244c-788e-3830-b469-07b69c790e27",
                                                "text": "A youngish-looking man came up to him, and aggressive-looking type with a hook mouth, a lantern nose, and small beady little cheekbones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0aca47be-30be-48ce-91a3-f8f73057c4b8",
                        "source_entry_id": "9dff491b-be88-3022-885f-750e7628b07c",
                        "source_sense_id": "3cec5b32-c09f-3f90-bf17-4e3501ed3cbf",
                        "source_sense_description": "Anatomie: Knochenvorsprung unter den Augenhöhlen, der den Oberkiefer mit dem Schläfenbein verbindet",
                        "target_lang_word": "pommette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pommette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c19bf583-cea6-323d-a948-e0ef659f984a",
                                        "entry_id": "3c1b2e90-f1d8-3db5-9515-1e5b1e3961e4",
                                        "glosses": [
                                            "Ornement de bois ou de métal, fait en forme de petites pommes ou boules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "448524a9-d018-4fad-960d-e01685523590",
                                                "sense_id": "c19bf583-cea6-323d-a948-e0ef659f984a",
                                                "text": "Pommette de bois, de cuivre, d’argent. - Ces chenêts sont ornés de vases terminés par des pommettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91e25d23-3a89-3ab3-86eb-005c869596ce",
                                        "entry_id": "3c1b2e90-f1d8-3db5-9515-1e5b1e3961e4",
                                        "glosses": [
                                            "Partie la plus saillante de la joue au-dessous de l’œil, en tirant vers l’angle extérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d75c1b9a-2270-4bdb-94a8-9f4c0e240fef",
                                                "sense_id": "91e25d23-3a89-3ab3-86eb-005c869596ce",
                                                "text": "Le vieillard appartenait aux modèles affectionnés par les mâles pinceaux de Schnetz ; c’était un visage brun dont les rides nombreuses paraissaient rudes au toucher, un nez droit, des pommettes saillantes et veinées de rouge comme une vieille feuille de vigne, de contours anguleux, tous les caractères de la force, même là où la force avait disparu ; ses mains calleuses, quoiqu'elles ne travaillassent plus, conservaient un poil blanc et rare ; son attitude d’homme vraiment libre faisait pressentir qu’en Italie il serait peut-être devenu brigand par amour pour sa précieuse liberté."
                                            },
                                            {
                                                "example_id": "188f69d7-4c1a-41d5-9de7-aaf97a92ba84",
                                                "sense_id": "91e25d23-3a89-3ab3-86eb-005c869596ce",
                                                "text": "[…] ; une rougeur fébrile colora les pommettes de ses joues, ses yeux presque éteints s’éclairèrent et brillèrent d’un vif éclat."
                                            },
                                            {
                                                "example_id": "0892a410-7f00-4966-9d04-e3e0b9d2c2f7",
                                                "sense_id": "91e25d23-3a89-3ab3-86eb-005c869596ce",
                                                "text": "Une jeune fille a été frappée d'un coup de baïonnette à la mâchoire gauche et l'arme est ressortie par la pommette droite."
                                            },
                                            {
                                                "example_id": "ec6a55c8-978a-46d7-a3e1-21b83a816162",
                                                "sense_id": "91e25d23-3a89-3ab3-86eb-005c869596ce",
                                                "text": "La bouche grasse, les pommettes rouges, les yeux injectés de bourgogne, Guillaume-Adolphe Porcellet célébra la grève, la sainte grève!…"
                                            },
                                            {
                                                "example_id": "e9bbd1a8-8c96-4deb-bd90-2498ec0a7805",
                                                "sense_id": "91e25d23-3a89-3ab3-86eb-005c869596ce",
                                                "text": "Sous leurs yeux, à la hauteur des pommettes, ils avaient tous la marque caractéristique de peinture goudronnée qu’on applique à la fois pour couper l’éclat du soleil et pour se donner une allure plus guerrière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9de52e9a-b180-38c5-bc88-2275851b9fb4",
                                        "entry_id": "3c1b2e90-f1d8-3db5-9515-1e5b1e3961e4",
                                        "glosses": [
                                            "Plaque arrondie qui termine la crosse d’un pistolet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00ed307f-a997-3322-a74a-9b01f2e0bddd",
                                        "entry_id": "3c1b2e90-f1d8-3db5-9515-1e5b1e3961e4",
                                        "glosses": [
