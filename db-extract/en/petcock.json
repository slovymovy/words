                                "example_id": "822cbdd9-75da-48db-973c-c7ca89ee26e9",
                                "sense_id": "575465d2-7cc6-37f2-9f40-6160f92e6913",
                                "text": "The doctor placed the rubber mask over her face and turned a dial and I watched Catherine breathing deeply and rapidly. Then she pushed the mask away. The doctor shut off the petcock."
                            },
