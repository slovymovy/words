                },
                {
                    "sense_id": "9cfd4bcc-fa67-38dc-8283-0f9fda33dee9",
                    "sense_definition": "Showing complete lack of pride or self-respect; servile or grovelling.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "servile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician offered an <w>abject</w> apology to the public after the scandal was revealed.",
                            "target_lang_translations": {
                                "ru": "Политик принёс общественности <w>нижайшие</w> извинения после того, как скандал вскрылся."
                            }
                        },
                        {
                            "text": "He was tired of the <w>abject</w> flattery that his employees showered upon him every day.",
                            "target_lang_translations": {
                                "ru": "Ему надоела <w>раболепная</w> лесть, которой сотрудники осыпали его каждый день."
                            }
                        }
                    ],
                    "synonyms": [
                        "cringing",
                        "slavish"
                    ],
                    "antonyms": [
                        "unabject"
                    ],
                    "common_phrases": [
                        "abject apology",
                        "abject flattery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий полное отсутствие самоуважения или гордости; подобострастный, раболепный."
