        "nl-extract.jsonl": [
            {
                "entry_id": "2302110c-fbe0-3067-8a80-56688cea18a7",
                "word": "sjaal",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "1958d28d-dad2-4780-b05f-1e4b0369a8fd",
                        "entry_id": "2302110c-fbe0-3067-8a80-56688cea18a7",
