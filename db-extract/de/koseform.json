                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa13fbfa-eeda-4ba7-bdf5-11c1c3c98af8",
                                "sense_id": "dc442efd-45d8-3e7a-a2ca-baec9f342324",
                                "text": "Die Koseform von Hans ist Hänschen oder Hansi."
                            },
                            {
                                "example_id": "af9ad967-8667-44b2-9d47-6ec1ea03a7ef",
                                "sense_id": "dc442efd-45d8-3e7a-a2ca-baec9f342324",
                                "text": "„Er hatte darauf bestanden, daß ich ihn ‚Lotsi‘ nannte, die Koseform seines Vornamens Laszlo.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
