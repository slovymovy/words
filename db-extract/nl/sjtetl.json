                                "target_senses": [
                                    {
                                        "sense_id": "2f02130e-38c9-3edc-8b74-feb4d8ab6a79",
                                        "entry_id": "132419e7-5582-360e-b18b-a2f6e3308919",
                                        "glosses": [
                                            "A Jewish village or small town, especially one in Eastern Europe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64314ff4-66f5-45f6-8aea-8c6b1e757b3b",
                                                "sense_id": "2f02130e-38c9-3edc-8b74-feb4d8ab6a79",
                                                "text": "However, you are right to suspect that there is some connection between my carefully considered opinion of the Hebrew people and this marvellous recital which your waxy ears, full of the cheesy gunk of the shtetl, have been so fortunate to hear."
                                            },
                                            {
                                                "example_id": "634313ba-79f2-4252-bb55-c9ed54a896da",
                                                "sense_id": "2f02130e-38c9-3edc-8b74-feb4d8ab6a79",
                                                "text": "Most of the second-generation immigrant kids of his neighborhood had been […] as desperate to go to college and become lawyers, doctors, businessmen, and leave the teeming city for the suburbs, as their parents had been to leave behind the shtetls of Russia."
                                            },
                                            {
                                                "example_id": "fb217718-2574-48ab-97f1-01fe59fcb67c",
                                                "sense_id": "2f02130e-38c9-3edc-8b74-feb4d8ab6a79",
                                                "text": "Albert Speer had a big vision for it during the Third Reich, with boulevards and gigantic monuments, and we definitely don't want that again. It's a collection of villages, of shtetls as we say in Yiddish."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
