                                "target_lang_word": "平静",
                                "target_lang_sense_clarification": "不湍急的"
                            },
                            {
                                "target_lang_word": "静止",
                                "target_lang_sense_clarification": "没有移动的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "9ac8abf9-44a5-36b2-945d-c4e28b69d5e4",
                    "sense_definition": "Призыв сохранять выдержку, не волноваться или соблюдать тишину",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "calmness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Спокойно</w>, мы скоро во всём разберёмся и найдём решение.",
                            "target_lang_translations": {
                                "en": "<w>Easy</w>, we will soon sort everything out and find a solution.",
                                "zh": "<w>冷静</w>点，我们很快就会理清一切并找到解决方案。"
                            }
                        },
                        {
                            "text": "<w>Спокойно</w>! Не нужно паниковать раньше времени.",
                            "target_lang_translations": {
                                "en": "<w>Calm down</w>! There is no need to panic prematurely.",
                                "zh": "<w>冷静</w>！没必要过早惊慌。"
                            }
                        }
                    ],
                    "synonyms": [
                        "тихо"
                    ],
                    "common_phrases": [
