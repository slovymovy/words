                "senses": [
                    {
                        "sense_id": "9c7bd55f-f64c-3a29-a02a-7f2ebf4129c6",
                        "entry_id": "34def5bf-2d9b-36f7-b58f-1d02a9c19ccc",
                        "glosses": [
                            "gewöhnlich vorherrschende oder eintreffende Situation oder Beurteilung der Lage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2748837-6c45-42af-aef8-5bce4ac0ce17",
                                "sense_id": "9c7bd55f-f64c-3a29-a02a-7f2ebf4129c6",
                                "text": "„Schlechtere Noten seitens der Rating-Agenturen bedeuten im Normalfall höhere Refinanzierungskosten für Banken.“"
                            },
                            {
                                "example_id": "ce792a83-639d-409f-b76d-daf83eff2d2a",
                                "sense_id": "9c7bd55f-f64c-3a29-a02a-7f2ebf4129c6",
                                "text": "Schwankende Einkommen sind der Normalfall."
                            },
                            {
                                "example_id": "7d824fb4-9c74-41fd-9c3a-403a7946e951",
                                "sense_id": "9c7bd55f-f64c-3a29-a02a-7f2ebf4129c6",
                                "text": "Im Gegensatz hierzu beobachtet man wiederum bei anderen Präparaten meist in allen Rindenschichten einen sehr starken Gehalt an doppelbrechenden Substanzen, die gegenüber den Normalfällen offensichtlich vermehrt sind."
                            },
                            {
                                "example_id": "30a59113-d067-4269-b94c-4274e307d7e5",
                                "sense_id": "9c7bd55f-f64c-3a29-a02a-7f2ebf4129c6",
                                "text": "Wir sprechen hier nicht von Normalfällen, sondern von Notfällen."
                            },
                            {
                                "example_id": "66a5f01e-1543-476e-b497-3ef15aeb5efd",
                                "sense_id": "9c7bd55f-f64c-3a29-a02a-7f2ebf4129c6",
                                "text": "„Dass ein afrikanischer Herrscher seine Souveränität abgibt, ist schließlich im vorangegangenen Jahrzehnt der Normalfall gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a06c2bf7-172a-4761-9bba-8354ab22a023",
                        "source_entry_id": "34def5bf-2d9b-36f7-b58f-1d02a9c19ccc",
                        "source_sense_id": "9c7bd55f-f64c-3a29-a02a-7f2ebf4129c6",
