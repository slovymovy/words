                "senses": [
                    {
                        "sense_id": "2bc4cba7-3985-31e4-b541-09b2b6678b70",
                        "entry_id": "f3439900-bdb9-3c6e-bf69-dd70c30a6444",
                        "glosses": [
                            "instrument met doorslaande tongen dat met de mond bespeeld wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06df6801-89e2-4b71-b194-3e5b9287f90d",
                                "sense_id": "2bc4cba7-3985-31e4-b541-09b2b6678b70",
                                "text": "Speelt u vaak op een mondharmonica?"
                            },
                            {
                                "example_id": "8d226a81-72f1-4b2c-8de4-d301caa61464",
                                "sense_id": "2bc4cba7-3985-31e4-b541-09b2b6678b70",
                                "text": "Je bespeelt de mondharmonica door op elke noot in of uit te ademen."
                            },
                            {
                                "example_id": "5b2be76b-4792-4c0a-a93c-ae886bd22c52",
                                "sense_id": "2bc4cba7-3985-31e4-b541-09b2b6678b70",
                                "text": "⧖ De grondtoon geleek den diepen bas des orgels, en werd geakkompagneerd door een hol keelgeluid, zwaarmoedige klok, toonen en den klank eener groote mondharmonica."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39de4169-a31d-481b-839a-f8512e0632f7",
                        "source_entry_id": "f3439900-bdb9-3c6e-bf69-dd70c30a6444",
                        "source_sense_id": "2bc4cba7-3985-31e4-b541-09b2b6678b70",
