    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "94e05cb0-10e1-333d-887b-fd24c2481b7b",
                    "sense_definition": "losjes heen en weer bewegend als de vleugels van een vlinder",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>fladderende</w> vlinder trok de aandacht van de spelende kinderen in de tuin.",
                            "target_lang_translations": {
                                "en": "The <w>fluttering</w> butterfly caught the attention of the children playing in the garden."
                            }
                        },
                        {
                            "text": "Zij droeg een jurk met <w>fladderende</w> mouwen die bewogen in de wind.",
                            "target_lang_translations": {
                                "en": "She wore a dress with <w>fluttering</w> sleeves that moved in the wind."
                            }
                        }
                    ],
                    "synonyms": [
                        "rondfladderend",
                        "wapperend"
                    ],
                    "common_phrases": [
                        "fladderende vlinder",
                        "fladderende mouwen",
                        "fladderende beweging"
                    ],
                    "target_lang_definitions": {
                        "en": "moving loosely back and forth like the wings of a butterfly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fluttering",
                                "target_lang_sense_clarification": "moving with light, quick motions"
                            },
                            {
                                "target_lang_word": "flapping",
                                "target_lang_sense_clarification": "moving up and down or to and fro"
                            },
                            {
                                "target_lang_word": "billowing",
                                "target_lang_sense_clarification": "moving in the wind, especially fabric"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3f7e8510-0d6f-3a31-93ac-09d14c250d69",
                    "sense_definition": "onvoltooid deelwoord van <w>fladderen</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vogel vloog <w>fladderend</w> weg toen hij de kat in de buurt zag.",
                            "target_lang_translations": {
                                "en": "The bird flew away <w>fluttering</w> its wings when it saw the cat nearby."
                            }
                        },
                        {
                            "text": "Met <w>fladderende</w> vleugels probeerde het jonge vogeltje voor het eerst uit het nest te vliegen.",
                            "target_lang_translations": {
                                "en": "With <w>flapping</w> wings, the young bird tried to fly out of the nest for the first time."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fladderend wegvliegen",
                        "met fladderende vleugels"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "onvoltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "present participle of 'to flutter' or 'to flap'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fluttering",
                                "target_lang_sense_clarification": "the action of moving wings quickly and lightly"
                            },
                            {
                                "target_lang_word": "flapping",
                                "target_lang_sense_clarification": "the action of moving wings or arms up and down"
                            }
                        ]
                    }
                }
            ]
        }
    ]
