                        "sense_id": "9567aa9f-6762-353b-a165-cdf85eecb73b",
                        "entry_id": "60f45777-aec8-3313-8b89-312e638ae5dc",
                        "glosses": [
                            "Führung der Kettfäden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35da9d20-589d-40de-8d98-337011cadb28",
                                "sense_id": "9567aa9f-6762-353b-a165-cdf85eecb73b",
                                "text": "Der Weberkamm dient als „Vorrichtung am Webstuhl mit kammartig eingesetzten Stäben zur Führung der Kettfäden […]“."
                            },
                            {
                                "example_id": "6a6deaa9-eafb-4217-937c-5e7f647ee372",
                                "sense_id": "9567aa9f-6762-353b-a165-cdf85eecb73b",
                                "text": "Ein Webstuhl ohne den Weberkamm ist in der Weberei undenkbar."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
