                                "sense_id": "c6c0bd5f-8363-311b-a86a-9f779fa65727",
                                "text": "„Men also vastly outnumber women when identifying problematic drinking behaviours, such as binge drinking.“",
                                "translation": "Männer sind gegenüber Frauen auch erheblich in der Überzahl, wenn es um problematisches Trinkverhalten geht, so zum Beispiel beim Rauschtrinken."
                            },
                            {
                                "example_id": "ffcfe3a4-45ff-442f-9244-0eeae560b00b",
                                "sense_id": "c6c0bd5f-8363-311b-a86a-9f779fa65727",
                                "text": "Men were outnumbered in the nursing program by almost three to one.",
                                "translation": "Im Ausbildungsprogramm für Krankenpflege waren Männer mit einem Verhältnis von fast drei zu eins in der Unterzahl."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
