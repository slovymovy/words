                        "sense_id": "93a2d2cf-89eb-3c26-917b-5f40a05089cb",
                        "entry_id": "652a872e-58a5-3682-bd77-910d8d4cb210",
                        "glosses": [
                            "A cloak."
                        ],
                        "tags": [
                            "archaic",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "558d2de3-7c4e-39fa-8cdf-30f61c3b025e",
                        "entry_id": "652a872e-58a5-3682-bd77-910d8d4cb210",
                        "glosses": [
                            "A coat."
                        ],
                        "tags": [
                            "archaic",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c0fcc721-8523-4a0a-af30-f085bc528d56",
                                "sense_id": "558d2de3-7c4e-39fa-8cdf-30f61c3b025e",
                                "text": "I have a rorty gal, also a knowing pal, / And merrily together we jog on, / I doesn't care a flatch, as long as I've a tach, / Some pannum for my chest, and a tog on."
                            }
                        ]
                    },
                    {
                        "sense_id": "93b83d9f-7848-3348-a431-de4dea56c83f",
                        "entry_id": "652a872e-58a5-3682-bd77-910d8d4cb210",
                        "glosses": [
                            "A unit of thermal resistance, being ten times the temperature difference (in °C) between the two surfaces of a material when the flow of heat is equal to one watt per square metre"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
