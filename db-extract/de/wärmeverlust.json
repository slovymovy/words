                ],
                "senses": [
                    {
                        "sense_id": "4844bdfa-a2eb-33ca-aa6d-ffccd493f1c3",
                        "entry_id": "510afc8d-8d2a-3877-adf3-6d1cbc568df9",
                        "glosses": [
                            "unerwünschtes Entweichen von Wärme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34482e28-8ae0-4da0-afce-ce7517a04ceb",
                                "sense_id": "4844bdfa-a2eb-33ca-aa6d-ffccd493f1c3",
                                "text": "Undichte Haustüren und schlecht schließende Fenster führen zu erheblichen Wärmeverlusten im Gebäude."
                            },
                            {
                                "example_id": "80493eec-efee-4dd3-ab6a-be1a8795beff",
                                "sense_id": "4844bdfa-a2eb-33ca-aa6d-ffccd493f1c3",
                                "text": "Den eigenen Wärmeverlust kann man im Winter, bei zu dünner Bekleidung, am eigenen Leib schmerzlich erfahren."
                            },
                            {
                                "example_id": "88af4ee3-c717-4f24-a6e2-e0783bcef4a3",
                                "sense_id": "4844bdfa-a2eb-33ca-aa6d-ffccd493f1c3",
                                "text": "Zu hohe Heizkosten lassen sich durch eine gute Gebäudeisolierung minimieren, denn diese mindern den Wärmeverlust durch Wand und Dach."
                            },
                            {
                                "example_id": "ad389f91-2bd3-490b-9085-1e49dba54b14",
                                "sense_id": "4844bdfa-a2eb-33ca-aa6d-ffccd493f1c3",
                                "text": "„Der Wärmeverlust wird mit der Einheit Watt beschrieben.“"
                            },
                            {
                                "example_id": "a258cf8c-1226-44a3-a607-bbb09dd2a646",
                                "sense_id": "4844bdfa-a2eb-33ca-aa6d-ffccd493f1c3",
                                "text": "„In der DIN EN 12831 werden die Wärmeverluste an das Erdreich nach EN ISO 13370 nach einer ausführlichen Berechnungsmethode oder einem vereinfachten Verfahren berechnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
