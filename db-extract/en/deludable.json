                        "glosses": [
                            "Capable of being deluded; gullible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d947987-f2c5-41c5-a89b-1ae96260e856",
                                "sense_id": "73f4a6c6-381c-3e8b-9f4d-5085bf52386a",
                                "text": "For well understanding the omniscience of his nature, he is not so ready to deceive himself, as to falsifie unto him whose cognition is no way deludable."
                            },
                            {
                                "example_id": "86969afd-9cac-4769-96b3-1864e193b48d",
                                "sense_id": "73f4a6c6-381c-3e8b-9f4d-5085bf52386a",
                                "text": "[That] is too absurd to be mentioned by the most malignant calumniator, or to be credited by the most deludable dupe."
                            },
                            {
                                "example_id": "5571eab0-2136-4741-b780-f9320011d1a1",
                                "sense_id": "73f4a6c6-381c-3e8b-9f4d-5085bf52386a",
                                "text": "One could simply stop the argument there, dismiss the resurrection as a lie, and declare belief in the risen Jesus to be the product of a deludable mind."
                            }
                        ]
                    }
                ],
