                "senses": [
                    {
                        "sense_id": "a678915b-58e0-38ab-a0be-b68b47f09f8b",
                        "entry_id": "21902e36-94e4-3bc6-90cf-191fb34b8493",
                        "glosses": [
                            "Stadt in der pakistanischen Provinz Khyber Pakhtunkhwa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6716d0eb-0b1f-4814-ada9-9650d9cdcaf2",
                                "sense_id": "a678915b-58e0-38ab-a0be-b68b47f09f8b",
                                "text": "„Wir sammelten uns in Hyderabad, von wo aus wir gen Norden nach Chitral aufbrachen, unserem eigentlichen Ausgangspunkt.“"
                            },
                            {
                                "example_id": "ae905404-e866-44eb-b98a-df3430ee2e58",
                                "sense_id": "a678915b-58e0-38ab-a0be-b68b47f09f8b",
                                "text": "„In einer der Hütten auf Dreiviertelhöhe eines Berges in Chitral lag ein Paar eng umschlungen auf einem Gurtbett.“"
                            },
                            {
                                "example_id": "8301af11-d717-483c-937a-24086d89353c",
                                "sense_id": "a678915b-58e0-38ab-a0be-b68b47f09f8b",
                                "text": "„Vor fünf Monaten haben Augenzeugen Eagle 01 oben in Chitral gesichtet.“"
                            },
                            {
                                "example_id": "2a70e66c-9c70-47a7-aea6-e38912eca35e",
                                "sense_id": "a678915b-58e0-38ab-a0be-b68b47f09f8b",
                                "text": "„Als Dr. Omar seinen Freunden in Islamabad erzählte, er würde auf Urlaub in die Berge fahren, glaubten sie, er wolle nach Gilgit oder Chitral, hoch oben im Norden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
