{
    "word_family": [
        "outward",
        "outwards",
        "outwardness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "13f4e58f-6f31-31d8-a4ae-977dcc33e2f8",
                    "sense_definition": "On the outside or in appearance, especially as contrasted with inner reality or character.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Although he was nervous before the presentation, he remained <w>outwardly</w> calm.",
                            "target_lang_translations": {
                                "es": "Aunque estaba nervioso antes de la presentación, permaneció <w>exteriormente</w> tranquilo."
                            }
                        },
                        {
                            "text": "The house was <w>outwardly</w> charming, but inside it needed significant repairs.",
                            "target_lang_translations": {
                                "es": "La casa era encantadora <w>por fuera</w>, pero por dentro necesitaba reparaciones importantes."
                            }
                        }
                    ],
                    "synonyms": [
                        "apparently",
                        "superficially",
                        "ostensibly"
                    ],
                    "antonyms": [
                        "inwardly"
                    ],
                    "common_phrases": [
                        "outwardly calm"
                    ],
                    "target_lang_definitions": {
                        "es": "En apariencia o por fuera, especialmente en contraste con la realidad o el interior."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "exteriormente",
                                "target_lang_sense_clarification": "en cuanto a la apariencia externa"
                            },
                            {
                                "target_lang_word": "por fuera",
                                "target_lang_sense_clarification": "en apariencia"
                            },
                            {
                                "target_lang_word": "aparentemente",
                                "target_lang_sense_clarification": "según parece a primera vista"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17d02fc2-88fc-3508-87ff-deed5c6e6d10",
                    "sense_definition": "In a direction toward the outside or exterior.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The emergency exit doors open <w>outwardly</w> to allow people to escape quickly.",
                            "target_lang_translations": {
                                "es": "Las puertas de salida de emergencia se abren <w>hacia afuera</w> para permitir que la gente escape rápidamente."
                            }
                        },
                        {
                            "text": "The branches of the old tree spread <w>outwardly</w> over the garden path.",
                            "target_lang_translations": {
                                "es": "Las ramas del viejo árbol se extendían <w>hacia el exterior</w> sobre el sendero del jardín."
                            }
                        }
                    ],
                    "antonyms": [
                        "inwardly"
                    ],
                    "common_phrases": [
                        "open outwardly"
                    ],
                    "target_lang_definitions": {
                        "es": "En dirección hacia el exterior o la parte de afuera."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "hacia afuera",
                                "target_lang_sense_clarification": "en dirección al exterior"
                            },
                            {
                                "target_lang_word": "hacia el exterior",
                                "target_lang_sense_clarification": "con orientación al exterior"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}