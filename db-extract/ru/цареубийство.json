                        "entry_id": "5b8ee858-fe31-3d92-a1a0-ebebe8cf4d3c",
                        "glosses": [
                            "книжн., устар. убийство царя, монарха"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4210b56-5170-4578-b6e2-16d048110a20",
                                "sense_id": "d0df3df7-7f6c-33c3-9e9e-807eb28df401",
                                "text": "Царь Фёдор был зверски убит стрельцами, в России совершается первое цареубийство."
                            },
                            {
                                "example_id": "ed289b02-d39d-46f5-9c05-20b882cc9766",
                                "sense_id": "d0df3df7-7f6c-33c3-9e9e-807eb28df401",
                                "text": "Это было сразу после цареубийства в 1881 году."
                            }
                        ]
                    }
                ],
