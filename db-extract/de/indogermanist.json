                "senses": [
                    {
                        "sense_id": "888f9031-11b7-3ac7-9c59-c5e47b42582e",
                        "entry_id": "27cc6d56-fa6a-34bb-bec6-893447538986",
                        "glosses": [
                            "Lehrer und/oder Wissenschaftler im Fach Indogermanistik, Sprachwissenschaftler im Bereich der indogermanischen (indoeuropäischen) Sprachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e425cbde-5f64-4571-aa79-639c0e7a012b",
                                "sense_id": "888f9031-11b7-3ac7-9c59-c5e47b42582e",
                                "text": "„Zu den ersten Linguisten, die in dieser frühesten Phase Beobachtungen über die kindliche Sprachentwicklung veröffentlichten, gehörten die Indogermanisten Schleicher und Jan Baudouin de Courtenay.“"
                            },
                            {
                                "example_id": "65e691e7-813c-48f7-91eb-f9793f58a496",
                                "sense_id": "888f9031-11b7-3ac7-9c59-c5e47b42582e",
                                "text": "„Der Indogermanist Bernfried Schlerath ist tot. Bernfried Schlerath, der lange Jahre an der Freien Universität Professor für Vergleichende und Indogermanische Sprachwissenschaft war, ist am Freitag in gestorben, wie erst jetzt bekannt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
