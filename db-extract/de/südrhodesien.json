                "senses": [
                    {
                        "sense_id": "83d5cca5-5953-37e2-8fbb-e6430f2cbe5a",
                        "entry_id": "5287edfc-8fea-3c50-98e0-919da69b3aa0",
                        "glosses": [
                            "ehemalige britische Kolonie, heute Simbabwe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c30dbb0-68fd-4da1-8c9c-02fd6340ae41",
                                "sense_id": "83d5cca5-5953-37e2-8fbb-e6430f2cbe5a",
                                "text": "„Von 1964 bis 1965 blieb Südrhodesien weiterhin britische Kolonie.“"
                            },
                            {
                                "example_id": "3d087c23-7fb6-4ba9-8263-5029781e5a04",
                                "sense_id": "83d5cca5-5953-37e2-8fbb-e6430f2cbe5a",
                                "text": "„Das Land, in dem er 1924 das Licht der Welt erblickte, war erst 1890 unter dem Namen «Südrhodesien» eine britische Kolonie geworden.“"
                            },
                            {
                                "example_id": "8f81c53f-260b-478e-88be-7a6f2ad34a10",
                                "sense_id": "83d5cca5-5953-37e2-8fbb-e6430f2cbe5a",
                                "text": "„Der aus Edinburgh stammende 58-jährige Offizier konnte auf 25 Jahre Kolonialdienst in Mauritius, Trinidad, Tobago und Südrhodesien zurückblicken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
