                ],
                "senses": [
                    {
                        "sense_id": "c24b9036-0a54-393a-915f-3c82d3f3aab6",
                        "entry_id": "525da474-43bf-308b-8d2f-552f2ca2da9f",
                        "glosses": [
                            "Roue de compresseur à basse pression d’un réacteur à double flux, généralement utilisée comme premier étage de compression et entraînée par une turbine indépendante."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fa37f95c-b916-3488-bc4a-8eb0d1567ad1",
                        "entry_id": "525da474-43bf-308b-8d2f-552f2ca2da9f",
                        "glosses": [
                            "Réprimande ; soufflon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d9272f3-3e90-4ac4-b2b8-16f9551258bc",
                                "sense_id": "fa37f95c-b916-3488-bc4a-8eb0d1567ad1",
                                "text": "Pression politique ? C’est ce que pense une partie de la rédaction, persuadée que Laurent Wauquiez a passé une soufflante à la direction."
                            },
                            {
                                "example_id": "d5aa7bfb-f7fa-4951-b9fb-7d4476003672",
                                "sense_id": "fa37f95c-b916-3488-bc4a-8eb0d1567ad1",
                                "text": "Il rappelle, plus agacé encore. « Madame de Closette », ainsi qu’il l’appelle en faisant claquer la dernière syllabe, comprend vite qu’il ne s’agit pas d’un coup de fil de courtoisie mais d’une soufflante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b402a215-12fd-4f87-813c-8b6e40b06abb",
                        "source_entry_id": "525da474-43bf-308b-8d2f-552f2ca2da9f",
                        "source_sense_id": "c24b9036-0a54-393a-915f-3c82d3f3aab6",
                        "source_sense_description": "Roue de compresseur à basse pression",
                        "target_lang_word": "fan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58e8b7f0-4b13-301b-9685-893d72bda65b",
                                        "entry_id": "956c9f65-db45-33d8-92ab-d38ddb836b35",
                                        "glosses": [
                                            "A hand-held device consisting of concertinaed material, or slats of material, gathered together at one end, that may be opened out into the shape of a sector of a circle and waved back and forth in order to move air towards oneself and cool oneself."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79ac9298-8882-3c83-94ac-2c2730e3d5b1",
                                        "entry_id": "956c9f65-db45-33d8-92ab-d38ddb836b35",
                                        "glosses": [
                                            "An electrical or mechanical device for moving air, used for cooling people, machinery, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c13943b-4b22-4a31-ad39-b7fdc9840820",
                                                "sense_id": "79ac9298-8882-3c83-94ac-2c2730e3d5b1",
                                                "text": "He didn't switch on the fan because the temperature was 15 degrees Celsius."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af1d999b-7d0f-34a3-a7af-81cb3836e0cc",
                                        "entry_id": "956c9f65-db45-33d8-92ab-d38ddb836b35",
                                        "glosses": [
                                            "The action of fanning; agitation of the air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47fec996-4735-415a-a4bb-20a869eeb336",
                                                "sense_id": "af1d999b-7d0f-34a3-a7af-81cb3836e0cc",
                                                "text": "\"If I cannot be of service, then I certainly don't wish to impose,\" said McGinty, with a quick fan of breeze that indicated a sweeping bow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82178458-85cf-348b-8c99-0fd3aa2f2418",
                                        "entry_id": "956c9f65-db45-33d8-92ab-d38ddb836b35",
                                        "glosses": [
                                            "Anything resembling a hand-held fan in shape, e.g., a peacock’s tail."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14bc9cf3-08ef-3bf2-87a9-d4c6a6f50de6",
                                        "entry_id": "956c9f65-db45-33d8-92ab-d38ddb836b35",
                                        "glosses": [
                                            "An instrument for winnowing grain, by moving which the grain is tossed and agitated, and the chaff is separated and blown away."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7679308-3e83-4173-aab7-30be1469a8bf",
                                                "sense_id": "14bc9cf3-08ef-3bf2-87a9-d4c6a6f50de6",
                                                "text": "The oxen likewise and the yong asses that eare the ground, shall eate cleane prouender which hath bene winnowed with the shouell and with the fanne."
                                            },
                                            {
                                                "example_id": "63cf2b28-e900-4f6a-8cc5-d100e0d611a8",
                                                "sense_id": "14bc9cf3-08ef-3bf2-87a9-d4c6a6f50de6",
                                                "text": "Whose fanne is in his hand, and he will throughly purge his floore, and gather his wheat into the garner: but wil burne vp the chaffe with vnquenchable fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "136afdb0-3d3c-3b6f-a12e-276a6677d689",
                                        "entry_id": "956c9f65-db45-33d8-92ab-d38ddb836b35",
                                        "glosses": [
                                            "A small vane or sail, used to keep the large sails of a smock mill always in the direction of the wind."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59bf9bdf-011f-3c38-b6c5-208da441b527",
                                        "entry_id": "956c9f65-db45-33d8-92ab-d38ddb836b35",
                                        "glosses": [
                                            "A section of a tree having a finite number of branches"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ae6dc79-bb06-3fe0-ad59-f220afc5851a",
                                        "entry_id": "89a8c206-ea52-336a-97e3-6f624549c233",
                                        "glosses": [
                                            "To blow air on (something) by means of a fan (hand-held, mechanical or electrical) or otherwise."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50ecde18-12ed-4101-943d-781b46b8a88b",
                                                "sense_id": "6ae6dc79-bb06-3fe0-ad59-f220afc5851a",
                                                "text": "We enjoyed standing at the edge of the cliff, being fanned by the wind."
                                            },
                                            {
                                                "example_id": "4720ce9e-a9ee-4e13-8226-94bc00287ffa",
                                                "sense_id": "6ae6dc79-bb06-3fe0-ad59-f220afc5851a",
                                                "text": "Alice took up the fan and gloves, and, as the hall was very hot, she kept fanning herself all the time she went on talking: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "454c6d0e-d1e9-3c3f-823c-b3b55eaec0f5",
                                        "entry_id": "89a8c206-ea52-336a-97e3-6f624549c233",
                                        "glosses": [
                                            "To slap (a behind, especially)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c058f01a-abce-4e60-bac5-3ff757e72211",
                                                "sense_id": "454c6d0e-d1e9-3c3f-823c-b3b55eaec0f5",
                                                "text": "Part of it was that as much as I respected filial devotion and as much as I liked Sarah Barstow, it would have been a real satisfaction to put her across my knees and pull up her skirts and giver^([sic]) her a swell fanning, for not taking a look at that driver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d29e5412-eb7c-38f0-b9e4-312d1fb90e81",
                                        "entry_id": "89a8c206-ea52-336a-97e3-6f624549c233",
                                        "glosses": [
                                            "To move or spread in multiple directions from one point, in the shape of a hand-held fan."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5aa8ff9c-9af8-3957-af16-86fb9e75a597",
                                        "entry_id": "89a8c206-ea52-336a-97e3-6f624549c233",
                                        "glosses": [
                                            "To dispel by waving a hand-held fan."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4f1e7c4-ee31-4b47-b711-b9e3ef212b8d",
                                                "sense_id": "5aa8ff9c-9af8-3957-af16-86fb9e75a597",
                                                "text": "I attempted to fan the disagreeable odour out of the room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4efb040-4ee9-3734-96c1-460316fe3579",
                                        "entry_id": "89a8c206-ea52-336a-97e3-6f624549c233",
                                        "glosses": [
                                            "To perform a maneuver that involves flicking the top rear of an old-style gun."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d54ed82-8b74-42d8-b45f-943499b4dca6",
                                                "sense_id": "b4efb040-4ee9-3734-96c1-460316fe3579",
                                                "text": "To fan a single action revolver, hold down the trigger and strike the hammer repeatedly with a free hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "505d866a-f04b-376e-ac23-c6eb0c1fb22f",
                                        "entry_id": "89a8c206-ea52-336a-97e3-6f624549c233",
                                        "glosses": [
                                            "To invigorate, like flames when fanned."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a260577-f10b-477b-9d40-4f050bf9f328",
                                                "sense_id": "505d866a-f04b-376e-ac23-c6eb0c1fb22f",
                                                "text": "She comes, to fan my ardour, She kills me with her kisses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b30931a4-75e6-3135-aafb-9037209f6bc6",
                                        "entry_id": "89a8c206-ea52-336a-97e3-6f624549c233",
                                        "glosses": [
                                            "To winnow grain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93e80155-6df7-4872-88b8-a4f79d93d179",
                                                "sense_id": "b30931a4-75e6-3135-aafb-9037209f6bc6",
                                                "text": "By the first article, these fanning mills were appointed to be sent to the proprietors of the mills of Sault-à-la puce, Petit-Pré, Beauport, Pointe de Lévy, St. Nicolas and Ste. Famille in the isle of Orleans \" to have all the wheat in general of whatever quality sent to these mills passed and fanned, before converting them into flour.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4523902d-fdb7-3825-841a-2026b9f8e1c2",
                                        "entry_id": "89a8c206-ea52-336a-97e3-6f624549c233",
                                        "glosses": [
                                            "To apply (the air brake) many times in rapid succession."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f66e4ab-8f30-42cf-890f-387dc2b7b36b",
                                                "sense_id": "4523902d-fdb7-3825-841a-2026b9f8e1c2",
                                                "text": "Fanning the brakes results in the gradual depletion of the pressure in the cars' brake reservoirs, which can eventually cause a loss of all braking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b665aae6-88c0-3291-893f-59bc2ee0274b",
                                        "entry_id": "89a8c206-ea52-336a-97e3-6f624549c233",
                                        "glosses": [
                                            "To strike out."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cff77b67-9fa3-392a-a2a4-632c2cab0fe8",
                                        "entry_id": "89a8c206-ea52-336a-97e3-6f624549c233",
                                        "glosses": [
                                            "To strike out (a batter)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
