                    {
                        "translation_id": "c524f66c-cd18-4618-be94-28415f2bb262",
                        "source_entry_id": "07841ee9-94e6-3dd3-883f-fbd74b4f7bb8",
                        "source_sense_id": "5a844856-39f3-39f3-bf7a-7afd5d4df329",
                        "source_sense_description": "Zierpflanze aus der Familie der Nelkengewächse",
                        "target_lang_word": "œillet de poète",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "œillet de poète",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c674c132-33a4-35c9-aef1-9022f1d3b329",
                                        "entry_id": "e9c91c3e-1e90-3e44-af29-4d7b508c85e6",
                                        "glosses": [
                                            "Plante ornementale (Dianthus barbatus), de la famille des Caryophyllacées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b3ef247-bd5c-485b-b0e9-ed8c4b818bea",
                                                "sense_id": "c674c132-33a4-35c9-aef1-9022f1d3b329",
                                                "text": "Le jardinier ne pourrait plus raconter aux gamins l’histoire merveilleuse des « œillets de poète », celle des « désespoirs du peintre » ou des « cœurs de Marie » […]"
                                            },
                                            {
                                                "example_id": "07bfc442-ade8-4d82-a7d8-d3437e5e7f82",
                                                "sense_id": "c674c132-33a4-35c9-aef1-9022f1d3b329",
                                                "text": "Vers huit ans, lors d’une visite chez une tante de ma mère, j’ai prélevé des semences d’œillet de poète et je les ai gardées au creux de ma main jusqu’à mon retour à la maison. Je les ai semées le long d’un petit sentier, dans le bosquet des cerisiers à grappes. L’année suivante, les plantes ont fleuri, à la surprise de mes sœurs et à mon enchantement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
