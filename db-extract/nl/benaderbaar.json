                    },
                    {
                        "translation_id": "569124f0-feac-4194-bcc9-b7ff8690a147",
                        "source_entry_id": "14a6b3be-97ce-388b-99b8-7f21bbe88dfc",
                        "source_sense_id": "ebf35e1d-f678-3f78-8859-f7b554fe7c2b",
                        "source_sense_description": "te benaderen, makkelijk mee te praten",
                        "target_lang_word": "approchable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "approchable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cbb5ed5f-2ce5-3248-9cdf-b179bfb82937",
                                        "entry_id": "fbb103bb-e75a-3520-91c4-c8b68a99b4db",
                                        "glosses": [
                                            "Que l’on peut approcher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b3996a2-84d9-499f-9683-d519e99a188b",
                                                "sense_id": "cbb5ed5f-2ce5-3248-9cdf-b179bfb82937",
                                                "text": "Car, je suis ton Pavois, dit l’Eternel à Abraham : l’Eternel, une essence infinie, une saincteté non approchable aux pecheurs, un feu consumant qui les devore …."
                                            },
                                            {
                                                "example_id": "f2966e2e-411f-4a4b-9e94-8fa1eb492a2f",
                                                "sense_id": "cbb5ed5f-2ce5-3248-9cdf-b179bfb82937",
                                                "text": "Que l'animal soit plus ou moins approchable, nous devons d’abord observer l’aspect général."
                                            },
                                            {
