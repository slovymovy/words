                                "target_senses": [
                                    {
                                        "sense_id": "0b51d4b1-3845-3af5-9df5-a36769f80871",
                                        "entry_id": "4b511aa6-3dd6-3eba-9e01-c9f6337e87a5",
                                        "glosses": [
                                            "Hydroxyde de sodium, utilisé entre autres pour déboucher les siphons et canalisations domestiques, commercialisé sous forme cristalline ou en solution aqueuse. Il s'agit d'un produit dangereux et extrêmement caustique pour les tissus vivants."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1867b7bb-286e-46a8-8528-8d9ec17461d3",
                                                "sense_id": "0b51d4b1-3845-3af5-9df5-a36769f80871",
                                                "text": "Hohoah! Un truc à déboucher les éviers…Moi, j’aime mieux ça que la soude caustique…"
                                            },
                                            {
                                                "example_id": "d0ab4589-a9c5-4052-8f5b-bd725462071d",
                                                "sense_id": "0b51d4b1-3845-3af5-9df5-a36769f80871",
                                                "text": "La masse pâteuse ainsi obtenue est ensuite mélangée avec de l’alcool éthylique, méthylique, butylique, amylique, de l’ammoniaque, de la soude caustique, de la potasse, du borax, des carbonates alcalins… — n’en jetez plus ! —, pour en faire une chouette gomme d’enrobage, de couleur orangée ou blond doré."
                                            }
                                        ]
                                    }
                                ]
                            }
