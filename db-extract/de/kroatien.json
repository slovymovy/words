                        "examples": [
                            {
                                "example_id": "0c761ccf-a5d2-492a-b2b9-6d1eb8a4aeaf",
                                "sense_id": "47a6ec84-7b2c-3381-a008-d8a85119610d",
                                "text": "Ich komme aus Kroatien."
                            },
                            {
                                "example_id": "123d1935-f87d-4ff8-b16e-ba74d56b1598",
                                "sense_id": "47a6ec84-7b2c-3381-a008-d8a85119610d",
                                "text": "Zagreb ist die Hauptstadt von Kroatien."
                            },
                            {
                                "example_id": "0a603872-613a-4e4b-8dde-9b6a6dfb5b8e",
                                "sense_id": "47a6ec84-7b2c-3381-a008-d8a85119610d",
                                "text": "Im Landesinneren Kroatiens herrscht kontinentales Klima vor."
                            },
                            {
                                "example_id": "c328f3c9-60c4-49fe-ab8b-28b680dd2a6c",
                                "sense_id": "47a6ec84-7b2c-3381-a008-d8a85119610d",
                                "text": "Seit Mitternacht ist Kroatien das 28. Mitglied der EU."
                            }
                        ],
