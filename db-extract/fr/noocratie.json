                "senses": [
                    {
                        "sense_id": "b7e62f9e-bf8f-3ebe-9d1d-f1039d352f6f",
                        "entry_id": "eb822f7b-b77b-367a-874b-45e1bf4135d1",
                        "glosses": [
                            "Domination de la raison pure en tant que faculté directrice de toutes les autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ca17214-1bb1-4771-a78a-1ba808d0fb9a",
                                "sense_id": "b7e62f9e-bf8f-3ebe-9d1d-f1039d352f6f",
                                "text": "Nous aurons un gouvernement de l'intelligence, des classes moyennes, des classes éclairées ; c'est au moins consolant. Et si la noocratie va mal, que deviendrons-nous ?"
                            },
                            {
                                "example_id": "22a17348-e4e2-4dfd-917b-0fae34f956b1",
                                "sense_id": "b7e62f9e-bf8f-3ebe-9d1d-f1039d352f6f",
                                "text": "Embrassons le progrès et la paix plutôt que la puissance et le profit. Et si le gouvernement du futur était une noocratie ?"
                            },
                            {
                                "example_id": "4a19f6ba-0867-4161-a765-7556c726af44",
                                "sense_id": "b7e62f9e-bf8f-3ebe-9d1d-f1039d352f6f",
                                "text": "Une véritable constitution se doit donc d'être une nomocratie (un gouvernement de la loi) et une noocratie (un gouvernement de l'intelligence)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
