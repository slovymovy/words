        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fcb46b2a-ff52-3dc5-985e-cb8d608328a1",
                "word": "Datong",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6039bcb1-bc35-3ab4-b481-45ccc89f72aa",
                        "entry_id": "fcb46b2a-ff52-3dc5-985e-cb8d608328a1",
                        "glosses": [
                            "A prefecture-level city of Shanxi, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85266ad3-99dd-4913-8117-ca8572467501",
                                "sense_id": "6039bcb1-bc35-3ab4-b481-45ccc89f72aa",
                                "text": "Mr. Xi began proclaiming his dream since taking power five years ago, though he focused much of his early efforts on battling corruption. In Shanxi, the province that includes Datong, investigators have arrested so many corrupt cadres that the national government has declared the region to be in a state of “implosive corruption.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "d752842f-0e4c-3090-a23c-dd33226d06bb",
                        "entry_id": "fcb46b2a-ff52-3dc5-985e-cb8d608328a1",
                        "glosses": [
                            "A Hui and Tu autonomous county in Xining, Qinghai, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab006bd6-4f36-418a-836c-68e2bc5c8eb8",
                                "sense_id": "d752842f-0e4c-3090-a23c-dd33226d06bb",
                                "text": "Heavy and sudden downpours in Datong Hui and Tu Autonomous County, population 403,368, of Qinghai province started late Wednesday, causing flooding on the mountains and triggered landslides, according to China's state broadcaster CCTV."
                            }
                        ]
                    },
                    {
                        "sense_id": "d85ef58a-5894-3f91-864b-3dd33b6358ad",
                        "entry_id": "fcb46b2a-ff52-3dc5-985e-cb8d608328a1",
                        "glosses": [
                            "A district of Taipei, Taiwan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caabe2c4-d39a-4b4a-aa2e-bb920cb2d2fd",
                                "sense_id": "d85ef58a-5894-3f91-864b-3dd33b6358ad",
                                "text": "A cross-dike platform is among the plans for an urban renewal project in Taipei’s Datong District (大同), officials from the Taipei City Government’s Department of Urban Development said yesterday."
                            },
                            {
                                "example_id": "f89ed3cc-6b20-471a-8931-7ead3c6f50d6",
                                "sense_id": "d85ef58a-5894-3f91-864b-3dd33b6358ad",
                                "text": "Over the past five years or so, the Datong District has been rewarding travellers looking for tea, herbal medicine or puppet shows on self-guided tours of low-rises built during the late 19th century and the occupation by Japan, which began in 1895.[…]\nSimilar architecture can be found elsewhere in Taipei, but in pockets rather than as whole neighbourhoods, as in Datong."
                            }
                        ]
                    },
                    {
                        "sense_id": "676f019d-ec55-3920-bc3c-6ef7d548175b",
                        "entry_id": "fcb46b2a-ff52-3dc5-985e-cb8d608328a1",
                        "glosses": [
                            "A mountain indigenous township in Yilan County, Taiwan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cf97eee-91e4-46f4-8d9f-7f50e9f85784",
                                "sense_id": "676f019d-ec55-3920-bc3c-6ef7d548175b",
                                "text": "Up north in Yilan, only the county's Sih-Ji Elementary School in Datong Township is suspended, for both the school's main and satellite campuses."
                            }
                        ]
                    },
                    {
                        "sense_id": "98e713ca-ce5c-3bd7-816e-68679e5fd42e",
                        "entry_id": "fcb46b2a-ff52-3dc5-985e-cb8d608328a1",
                        "glosses": [
                            "Synonym of Taedong (North Korea): the Mandarin Chinese-derived name."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c8dd526-9929-460d-affe-7431c62a418a",
                                "sense_id": "98e713ca-ce5c-3bd7-816e-68679e5fd42e",
                                "text": "The Han Great Wall ran throughout Kuche, Gansu, Ningxia, Hebei, Inner Mongolia, Liaoning and other provinces and autonomous regions, and ended to the north of DPRK’s Datong River estuary.",
                                "translation": "Jiangsu Science and Technology Publishing House",
                                "english": "Jiangsu Science and Technology Publishing House"
                            },
                            {
                                "example_id": "4e573510-4b27-438d-836b-44d05fb6431b",
                                "sense_id": "98e713ca-ce5c-3bd7-816e-68679e5fd42e",
                                "text": "The Yalu River was originally China's inland river. In 735 AD, during the Tang Dynasty, Emperor Xuanzong set the boundaries along the Datong River, the south belonged to Shilla while the north was the territory of Tang."
                            },
                            {
                                "example_id": "13cb1500-067c-4822-a938-5459e18ce869",
                                "sense_id": "98e713ca-ce5c-3bd7-816e-68679e5fd42e",
                                "text": "In the archaeological excavation, large numbers of Chinese coin, such as Half-Liang, Five Zhu, Huo Quan, Da Quan Fifty, Xiao Quan Zhi Yi, Huo Bu, etc., were unearthed from the original site of Lelang Prefecture (today's region of Qi Cheng Li on the South Bank of Datong River in Pyongyang, North Korea)."
                            }
                        ]
                    }
                ],
