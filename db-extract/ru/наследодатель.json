                    {
                        "translation_id": "e34029d2-8d25-45e4-af48-9e047517da37",
                        "source_entry_id": "6b1bee4f-7ef7-3faa-9df7-d5930c846373",
                        "source_sense_id": "59a6acb4-aeff-3d1a-9d58-63eece9ac03f",
                        "target_lang_word": "Erblasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erblasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                        "entry_id": "0c3c765f-2c46-300b-94c0-f8cca7a4faa4",
                                        "glosses": [
                                            "natürliche Person, die nach ihrem Tod ein Vermögen hinterlässt, das den gesetzlichen und testamentarisch bestimmten Erben zusteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c203631e-d42a-48fa-9bc1-1b8f6ef0746b",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Das Erbrecht tritt erst nach dem Tode des Erblassers ein. Stirbt ein vermeintlicher Erbe vor dem Erblasser; so hat er das noch nicht erlangte Erbrecht auch nicht auf seine Erben übertragen können.“"
                                            },
                                            {
                                                "example_id": "9aef8c25-f756-4b3d-b5ec-8d23336a105b",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Eine letztwillige Verfügung, durch die der Erblasser seinen Ehegatten bedacht hat, ist unwirksam, wenn die Ehe vor dem Tod des Erblassers aufgelöst worden ist.“"
                                            },
                                            {
                                                "example_id": "df78cb5a-a8a4-4130-bb65-2ac052a36b83",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Der Erblasser kann einem Abkömmling den Pflichtteil entziehen: 1. wenn der Abkömmling dem Erblasser, dem Ehegatten oder einem anderen Abkömmling des Erblassers nach dem Leben trachtet, …“"
                                            },
                                            {
                                                "example_id": "6b8b3ce3-9057-4189-8e53-8bd1fee4820a",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Sie sollen sie alle sehen und prüfen; jetzt aber lesen Sie zunächst einmal dieses Schreiben, welches der verwüstliche Erblasser damals aus Plauen erhalten hat!“"
                                            },
                                            {
                                                "example_id": "677a4d47-169f-4f7c-961d-ee8de496573d",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Man sagt, dass seitdem in Danzig in mannigfachen Fällen, insofern der Erblasser dem Genusse des Goldwassers ergeben war, von den Erben seine Sektion dringend gefordert wurde.“"
                                            },
                                            {
                                                "example_id": "5a6d08f2-fb97-43bf-9512-b1947793e998",
                                                "sense_id": "fd00528a-e58b-3714-b875-d2d7245f4d19",
                                                "text": "„Dann verlas er einige persönliche Zeilen des Erblassers: […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8cc7c5e-791f-47ff-bd8f-2dc8b633b181",
                        "source_entry_id": "6b1bee4f-7ef7-3faa-9df7-d5930c846373",
                        "source_sense_id": "59a6acb4-aeff-3d1a-9d58-63eece9ac03f",
                        "target_lang_word": "Nachlasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3151001c-97a0-4fe1-bea6-79b5b9b78799",
                        "source_entry_id": "6b1bee4f-7ef7-3faa-9df7-d5930c846373",
                        "source_sense_id": "59a6acb4-aeff-3d1a-9d58-63eece9ac03f",
                        "target_lang_word": "de cujus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de cujus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "480a25b4-7af7-3c7c-9f6b-e84595f324b8",
                                        "entry_id": "ad57e573-1f46-3ab5-94e0-96a3b3cab92d",
                                        "glosses": [
                                            "Personne dont la succession est ouverte."
                                        ],
                                        "tags": [
                                            "Latinisme en droit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79ac9906-959f-4380-89fc-013b8bd57fb5",
                                                "sense_id": "480a25b4-7af7-3c7c-9f6b-e84595f324b8",
                                                "text": "En Allemagne des difficultés, se sont présentées au sujet de l'application du décret bolchéviste du 27 avril 1918 par lequel le droit de succession est abrogé dans toute son étendue et toute la masse successorale devient la propriété de la république soviétique après le décès du de cujus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22c6b92a-ba51-393b-95c7-6944358d8dd4",
                                        "entry_id": "ad57e573-1f46-3ab5-94e0-96a3b3cab92d",
                                        "glosses": [
                                            "Défunt."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35ad0f3c-e54e-4707-9331-eb03b6093193",
                                                "sense_id": "22c6b92a-ba51-393b-95c7-6944358d8dd4",
                                                "text": "Du bout du pied il retourne le de cujus. Pourquoi ai-je l’impression brusquement, en avisant cette face pâle, de l’avoir déjà vu quelque part ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d325fc7d-25ed-3431-bdb7-a4a832e93371",
                                        "entry_id": "ad57e573-1f46-3ab5-94e0-96a3b3cab92d",
                                        "glosses": [
                                            "Personne dont on fait l’arbre généalogique."
                                        ],
                                        "tags": [
                                            "Généalogie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99c7667a-0f73-4b43-a504-906c637524c3",
                        "source_entry_id": "6b1bee4f-7ef7-3faa-9df7-d5930c846373",
                        "source_sense_id": "59a6acb4-aeff-3d1a-9d58-63eece9ac03f",
                        "target_lang_word": "défunt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "défunt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2375e8f2-d92b-32d4-a0ab-59a34ba40fd3",
                                        "entry_id": "22ad3f29-fdf3-3a8d-807e-cd683c744a9d",
                                        "glosses": [
                                            "Décédé ; mort ; feu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a97c742c-8732-4a52-8f65-2e64aa771dbf",
                                                "sense_id": "2375e8f2-d92b-32d4-a0ab-59a34ba40fd3",
                                                "text": "Cet enfant est lord Fermain Clancharlie, fils légitime unique de lord Linnœus Clancharlie, baron Clancharlie et Hunkerville, marquis de Corleone en Italie, pair du royaume d’Angleterre, défunt, et d’Ann Bradshaw, son épouse, défunte."
                                            },
                                            {
                                                "example_id": "5e2012ac-7113-484e-b69a-3fbbb6d60a00",
                                                "sense_id": "2375e8f2-d92b-32d4-a0ab-59a34ba40fd3",
                                                "text": "Le regard ankylosé par trop d’impérities, je cherchais un improbable mais tant espéré soutien au loin, partout et nulle part, peut-être vers le ciel où s'était machinalement orientée ma tête; ce ciel où avaient établi leurs pénates, mon défunt père et mes regrettées sœurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a55c194-7bf6-3c90-bd46-11eae9dec7c2",
                                        "entry_id": "22ad3f29-fdf3-3a8d-807e-cd683c744a9d",
                                        "glosses": [
                                            "Feu. (Note : se place devant un nom pour indiquer que la personne est morte, invariable dans ce cas)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b74e617b-af4d-41f4-9857-a81245461bbe",
                                                "sense_id": "9a55c194-7bf6-3c90-bd46-11eae9dec7c2",
                                                "text": "— Défunt ma mère servait un homme de justice à qui Cambremer a tout dit par ordre du prêtre qui ne lui a donné l’absolution qu’à cette condition-là, à entendre les gens du port."
                                            },
                                            {
                                                "example_id": "f9d3a060-ef86-4b83-8d9a-188f3fb00e0f",
                                                "sense_id": "9a55c194-7bf6-3c90-bd46-11eae9dec7c2",
                                                "text": "Chère enfant !… si défunt sa mère la voyait ne pas être ici la reine de la maison, elle en pleurerait dans son cercueil !"
                                            },
                                            {
                                                "example_id": "ff7d9aa9-f1cf-4a3c-93bf-afcc54f48aa8",
                                                "sense_id": "9a55c194-7bf6-3c90-bd46-11eae9dec7c2",
                                                "text": "— Barberin ! m’écriai-je.\n— Défunt, c’est défunt Barberin qu’il faut dire."
                                            },
                                            {
                                                "example_id": "4f85e5c4-7299-4c05-b5ea-48e4d2410f9b",
                                                "sense_id": "9a55c194-7bf6-3c90-bd46-11eae9dec7c2",
                                                "text": "Défunt ma grand’mère se rappelait du temps où les curés passaient dans les champs pour prendre la dîme, où les seigneurs avaient toute sorte de privilèges et de droits exorbitants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6a74174-6ba6-3c91-9e62-3ebf92bda691",
                                        "entry_id": "22ad3f29-fdf3-3a8d-807e-cd683c744a9d",
                                        "glosses": [
                                            "Détruit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "454d5b13-b829-4c3e-b351-2621fde570d6",
                                                "sense_id": "f6a74174-6ba6-3c91-9e62-3ebf92bda691",
                                                "text": "Figure mélancolique, il méditait profondément devant le monceau de ferraille et de cendres qui représentait sa défunte motocyclette."
                                            }
                                        ]
                                    }
                                ]
                            },
