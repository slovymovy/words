                        "glosses": [
                            "Person in ihrem privaten (nicht beruflichen oder öffentlichen) Umfeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e58d088-9e2b-4169-8eb6-d57e76780852",
                                "sense_id": "b0893c00-8356-3b66-9b23-58f4dddda9a7",
                                "text": "„Obwohl es Janosch als Privatmensch gelungen war, sich in seiner Einsiedelei zu verstecken, wurde er als Autor immer mehr zu einer Marke.“"
                            },
                            {
                                "example_id": "ae14cfb9-bb83-46e6-94eb-3c4af9450909",
                                "sense_id": "b0893c00-8356-3b66-9b23-58f4dddda9a7",
                                "text": "„Sie fungiert als Privatmensch oder steht für diese vermittelnde Aufgabe beispielsweise im Bereich des Coachings oder Scoutings in einem Arbeitsverhältnis.“"
                            }
                        ],
