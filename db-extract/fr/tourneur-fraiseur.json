                        "sense_id": "a6bbd96f-d71d-3836-a485-3a96c1cc6329",
                        "entry_id": "7a56f382-4dbb-38df-8fc4-f8c5e99b9bfe",
                        "glosses": [
                            "Ouvrier chargé de retirer de la matière avec des machines de coupe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "524f68be-3c65-4895-a7d6-93369257cbc4",
                                "sense_id": "a6bbd96f-d71d-3836-a485-3a96c1cc6329",
                                "text": "J’ai partagé mon pain avec un caporal, un tourneur-fraiseur originaire de Nanterre qui traînait dans le djebel depuis plus d’un an."
                            },
                            {
                                "example_id": "ea7890fa-ad5f-4763-8006-ce074b96f9ae",
                                "sense_id": "a6bbd96f-d71d-3836-a485-3a96c1cc6329",
                                "text": "Après tout, il pensait que s’il se fût présenté comme « tourneur-fraiseur », il eût sans doute provoqué un effet encore plus incongru."
                            },
                            {
                                "example_id": "56950916-10ae-42f6-82a6-bfb8f5867c1f",
                                "sense_id": "a6bbd96f-d71d-3836-a485-3a96c1cc6329",
                                "text": "L'école de tourneur-fraiseur où je suis admis ne séduit pas mon père, qui ne manque pas d'arguments."
                            }
                        ]
                    }
                ],
