{
    "word_family": [
        "Argyll"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b5944410-b43b-3a47-85e1-6b9005b036f2",
                    "sense_definition": "A pattern consisting of diamond-shaped areas on a solid background, often used in knitwear.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sweater featured a classic <w>argyle</w> pattern in shades of blue and grey.",
                            "target_lang_translations": {
                                "zh": "这件毛衣采用了经典的蓝色和灰色调<w>菱形格纹</w>。"
                            }
                        },
                        {
                            "text": "He wore a vest with a traditional <w>argyle</w> design to the golf tournament.",
                            "target_lang_translations": {
                                "zh": "他穿着一件带有传统<w>菱形格纹</w>设计的背心去参加高尔夫球赛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "argyle pattern",
                        "argyle sweater"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种由菱形图案组成的装饰花纹，常用于针织品。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "菱形格纹",
                                "target_lang_sense_clarification": "指代菱形交错的经典图案"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdda159b-7fae-3152-80cf-64256535e318",
                    "sense_definition": "A sock featuring a diamond-shaped pattern.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He paired his formal suit with a pair of colorful <w>argyles</w>.",
                            "target_lang_translations": {
                                "zh": "他穿着正式西装，搭配了一双色彩鲜艳的<w>菱形格纹袜</w>。"
                            }
                        },
                        {
                            "text": "The man pulled up his <w>argyles</w> before putting on his dress shoes.",
                            "target_lang_translations": {
                                "zh": "那个人在穿上正装皮鞋前，提了提他的<w>菱形格纹袜</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pair of argyles"
                    ],
                    "target_lang_definitions": {
                        "zh": "带有菱形图案的袜子。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "菱形格纹袜",
                                "target_lang_sense_clarification": "特指带有该图案的袜子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "926c0ffd-2f36-38e9-9580-0600d60e2e28",
                    "sense_definition": "A device used for keeping gravy warm.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "kitchenware",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique silver <w>argyle</w> sat on the table during the holiday dinner.",
                            "target_lang_translations": {
                                "zh": "节日晚餐时，桌上摆放着一个古董银制<w>肉汁保温器</w>。"
                            }
                        },
                        {
                            "text": "She used a small <w>argyle</w> to ensure the sauce remained at the perfect temperature.",
                            "target_lang_translations": {
                                "zh": "她用一个小型的<w>肉汁保温器</w>来确保酱汁保持在最佳温度。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种用于保持肉汁温度的餐具。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "肉汁保温器",
                                "target_lang_sense_clarification": "一种古董餐具"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "78f4bbbb-c5e0-3917-b0fd-bafd6cf79f23",
                    "sense_definition": "Alternative capitalization of <w>argyle</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This foot was covered with a blue and gray <w>Argyle</w> sock, and Mrs. Whatsit sat there, wriggling her toes, contentedly finishing her sandwich before scrambling to her feet.",
                            "target_lang_translations": {
                                "zh": "这只脚上穿着一只蓝灰色的<w>菱形格纹</w>袜，沃特西特太太坐在那儿，动了动脚趾，心满意足地吃完三明治，然后匆忙站了起来。"
                            }
                        },
                        {
                            "text": "The store sells many different styles of <w>Argyle</w> knitwear.",
                            "target_lang_translations": {
                                "zh": "这家店出售许多不同款式的<w>菱形格纹</w>针织品。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Capitalized variant"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "菱形格纹（首字母大写形式）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "菱形格纹",
                                "target_lang_sense_clarification": "同义词，拼写变体"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "be2adc00-86e6-379c-91ca-c7b1db682eab",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historical records mention a man named Mr. <w>Argyle</w> who lived in the village.",
                            "target_lang_translations": {
                                "zh": "历史记录中提到一位住在村里的<w>阿盖尔</w>先生。"
                            }
                        },
                        {
                            "text": "Professor <w>Argyle</w> gave an interesting lecture on local history yesterday.",
                            "target_lang_translations": {
                                "zh": "昨天，<w>阿盖尔</w>教授就当地历史做了一场有趣的讲座。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阿盖尔",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e37e5c11-ba4d-309b-b7ba-8d9b2c5f009b",
                    "sense_definition": "Alternative spelling of <w>Argyll</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The region is sometimes referred to as <w>Argyle</w> in older documents.",
                            "target_lang_translations": {
                                "zh": "在较旧的文件中，该地区有时被称为<w>阿盖尔</w>。"
                            }
                        },
                        {
                            "text": "He traveled through the beautiful hills of <w>Argyle</w> during his trip to Scotland.",
                            "target_lang_translations": {
                                "zh": "他在苏格兰旅行期间穿过了美丽的<w>阿盖尔</w>山区。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "地名（Argyll的拼写变体）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阿盖尔",
                                "target_lang_sense_clarification": "苏格兰地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}