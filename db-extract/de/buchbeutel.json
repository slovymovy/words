                        "examples": [
                            {
                                "example_id": "97ed4d05-2fd9-4955-9d28-9ade39db2de7",
                                "sense_id": "4153caeb-40d8-323a-b635-3af3c0f5fc68",
                                "text": "Hiller und Füssel führen unter dem Stichwort Buchbeutel aus: „Die Bezeichnung „Beutelbuch“ wäre passender, ist aber weniger gebräuchlich.“"
                            },
                            {
                                "example_id": "37b832f9-73b0-4146-a03a-e3e23abd247f",
                                "sense_id": "4153caeb-40d8-323a-b635-3af3c0f5fc68",
                                "text": "„Während das Beutelbuch erst im 14. Jahrhundert aufgekommen ist, hat es Buchbeutel und andere Formen des Schutzes für wertvolle Bücher schon Jahrhunderte früher gegeben.“"
                            }
                        ],
