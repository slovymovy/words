                                        "glosses": [
                                            "Action de corroder ou de se corroder; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6219ad2-751a-43e9-b29c-cd5489e6badf",
                                                "sense_id": "ec576297-e1cc-38dd-a0cc-77f817dd2053",
                                                "text": "Un appareil surdimensionné fonctionne le plus souvent au ralenti, tirage fermé. Il s’encrasse, ses émissions de polluants augmentent, et il est soumis à une forte corrosion."
                                            },
                                            {
                                                "example_id": "6181ec1a-e1a2-4325-9577-b1b74a7fb852",
                                                "sense_id": "ec576297-e1cc-38dd-a0cc-77f817dd2053",
                                                "text": "Le béton armé consiste en une association dans laquelle l’élément résistant à la compression (le béton) protège contre la corrosion l’élément résistant à la traction (l’acier)."
                                            }
                                        ]
                                    }
                                ]
                            }
