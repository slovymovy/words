                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Violett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fbfc1a8-101d-3c7c-ac38-c18c806c2a96",
                                        "entry_id": "4263afb8-6a5f-3bf3-9dfd-967ada53a9fa",
                                        "glosses": [
                                            "Name des violetten Farbtons, eines bestimmten Abschnitts des sichtbaren Lichts im Spektrum der elektromagnetischen Wellen, Malfarbe, Streichfarbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d624f693-d6b3-48d1-ad38-826fbcc09da3",
                                                "sense_id": "4fbfc1a8-101d-3c7c-ac38-c18c806c2a96",
                                                "text": "Die Gardinen sind in einem kräftigen Violett."
                                            },
                                            {
                                                "example_id": "3c6e5c2a-2fe9-4c19-9e85-4fcc7357b81b",
                                                "sense_id": "4fbfc1a8-101d-3c7c-ac38-c18c806c2a96",
                                                "text": "„Auf dem Boden ein Raster aus weißen Fliesen, die Zeitschriften liegen auf Kante auf den Tischen, und die Wollschals im Garderobenschrank sind wie eine Farbskala von Blau über Violett zu Dunkelrot und Rot sortiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
