                        "sense_id": "c494c804-9085-386c-b910-149cafad6572",
                        "entry_id": "a5a16908-dd9d-37a1-806d-451a7668dfcc",
                        "glosses": [
                            "A state of nervous excitement, confusion, or distress; a dither."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4c776f0c-4056-4526-9f5b-da0c4680256d",
                                "sense_id": "c494c804-9085-386c-b910-149cafad6572",
                                "text": "to be in a tizzy"
                            },
                            {
                                "example_id": "01538f13-c81f-4b26-bfa5-90fcf22062cf",
                                "sense_id": "c494c804-9085-386c-b910-149cafad6572",
                                "text": "That Todd Evergreen. The reclusive, twenty-two-year-old, overnight billionaire whose very existence has put us all in a tizzy."
                            },
                            {
                                "example_id": "32461a0c-4117-4958-992a-5a9765503eb7",
                                "sense_id": "c494c804-9085-386c-b910-149cafad6572",
                                "text": "The Chatbots Are Here, and the Internet Industry Is in a Tizzy [title]"
                            }
                        ]
                    },
                    {
                        "sense_id": "f8b2a211-acab-30a4-80fc-c3ddb80201b6",
                        "entry_id": "a5a16908-dd9d-37a1-806d-451a7668dfcc",
                        "glosses": [
                            "A sixpence; a tester."
                        ],
                        "tags": [
                            "UK",
                            "archaic",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "11893a68-6d2c-4803-9062-0290622bba72",
                                "sense_id": "f8b2a211-acab-30a4-80fc-c3ddb80201b6",
                                "text": "Down with the stumpy; a tizzy for a pot of half-and-half."
                            },
                            {
                                "example_id": "15222715-d8b1-47da-95c3-92e71b85f3fd",
                                "sense_id": "f8b2a211-acab-30a4-80fc-c3ddb80201b6",
                                "text": "Tadpole holds out, but between threats and cajoleries at length sells half for one shilling and sixpence — about a fifth of its fair market value; however, he is glad to realize anything, and, as he wisely remarks, \"Wanderer mayn't win, and the tizzy is safe anyhow.\""
                            }
                        ]
                    }
