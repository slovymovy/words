                        "sense_id": "70d08703-bc05-38dc-bc4f-1a0509cb6a0e",
                        "entry_id": "44e8a6c6-b44a-3cd4-917d-09c8ce071c93",
                        "glosses": [
                            "матем. числовой множитель в функциональной зависимости"
                        ],
                        "tags": [],
