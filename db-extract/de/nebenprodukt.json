                "senses": [
                    {
                        "sense_id": "d765b0c6-2863-3346-ac16-299f0f5ba61f",
                        "entry_id": "dc5cee96-cec3-323e-8673-cbb827d2ecd7",
                        "glosses": [
                            "etwas, das bei einem Herstellungs- oder Entwicklungsprozess nebenbei, zusätzlich entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daa27cc0-6e14-4afa-8a68-cc2189daf2ac",
                                "sense_id": "d765b0c6-2863-3346-ac16-299f0f5ba61f",
                                "text": "„Von den 210 bekannten Dioxin-Verbindungen, die als Nebenprodukte chemischer Prozesse entstehen, sind 17 dafür bekannt, dass sie sich im Fettgewebe von Mensch und Tier anreichern […] und so Gesundheitsschäden hervorrufen können.“"
                            },
                            {
                                "example_id": "77a24e7b-ba7d-4fec-a990-1353d58ecc32",
                                "sense_id": "d765b0c6-2863-3346-ac16-299f0f5ba61f",
                                "text": "„Wissenschaftler bezweifeln, dass Religion das Gerüst für die Moral bildet. Einige halten den Glauben eher für ein schädliches Nebenprodukt der Evolution.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "360bf071-4672-477b-a978-10b6d3f4a268",
                        "source_entry_id": "dc5cee96-cec3-323e-8673-cbb827d2ecd7",
                        "source_sense_id": "d765b0c6-2863-3346-ac16-299f0f5ba61f",
                        "source_sense_description": "etwas, das bei einem Herstellungs- oder Entwicklungsprozess nebenbei, zusätzlich entsteht",
                        "target_lang_word": "by-product",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "by-product",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc8f9429-ba6d-34b4-8d9f-84a34fd2c303",
                                        "entry_id": "003513f1-11b5-335d-8764-8c8a6eafd8f6",
                                        "glosses": [
                                            "Something made incidentally during the production of something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f68e12e-bb0d-4c40-963c-f44bfb37aa31",
                                                "sense_id": "bc8f9429-ba6d-34b4-8d9f-84a34fd2c303",
                                                "text": "It was about this time that the first experiments were made (in Germany) with basic slag, a material which had hitherto been regarded as a worthless by-product of steel manufacture. A year or two later field trials were begun in England, with the final result that basic slag has become recognized as a valuable source of phosphorus for growing crops, and is now in constant demand for application to the soil as a fertilizer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43e49f82-bf3c-3a41-ae9b-816216e98e6c",
                                        "entry_id": "003513f1-11b5-335d-8764-8c8a6eafd8f6",
                                        "glosses": [
                                            "A consequence, especially a side effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f910a4e-5aae-4441-831b-37c25dd7b9b6",
                                                "sense_id": "43e49f82-bf3c-3a41-ae9b-816216e98e6c",
                                                "text": "The many Indian restaurants all over Britain are a by-product of the large waves of immigration from the subcontinent."
                                            },
                                            {
                                                "example_id": "b77d43b7-bee5-4040-8447-35e329a06b05",
                                                "sense_id": "43e49f82-bf3c-3a41-ae9b-816216e98e6c",
                                                "text": "One of the most obvious results of the B.R. Modernisation Plan has been the increasing use of diesel and electric traction; a less obvious by-product is the increase in track damage possible with the new forms of traction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "344d164c-b60c-408d-ba01-60f20ca1246b",
                        "source_entry_id": "dc5cee96-cec3-323e-8673-cbb827d2ecd7",
                        "source_sense_id": "d765b0c6-2863-3346-ac16-299f0f5ba61f",
                        "source_sense_description": "etwas, das bei einem Herstellungs- oder Entwicklungsprozess nebenbei, zusätzlich entsteht",
                        "target_lang_word": "sous-produit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sous-produit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2067e27-cb57-3b79-93f1-cb37f597f27a",
                                        "entry_id": "cf6b8134-2ed8-3398-bec5-7f0424912a50",
                                        "glosses": [
                                            "Produit résidu qui apparaît durant la fabrication ou la distribution d’un produit fini."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f753f7c1-8d34-4271-85a8-ea45974503d4",
                                                "sense_id": "d2067e27-cb57-3b79-93f1-cb37f597f27a",
                                                "text": "Ces sous-produits sont de deux sortes: les uns proviennent du dessuintage […] et les autres viennent du dégraissage."
                                            },
                                            {
                                                "example_id": "9f99202b-fa13-4647-bd58-3d81807c627e",
                                                "sense_id": "d2067e27-cb57-3b79-93f1-cb37f597f27a",
                                                "text": "Les domestiques ont beau faire : une crasse tombée du ciel colle aux cadres dorés, embue la glace, englue le marbre noir de la cheminée, sale sous-produit des usines et des charbonnages tout proches."
                                            },
                                            {
                                                "example_id": "1325db6d-3296-4c59-a7c3-437c4d70dc66",
                                                "sense_id": "d2067e27-cb57-3b79-93f1-cb37f597f27a",
                                                "text": "Des sous-produits sont issus du lait entier et de la fabrication de la crème : à partir du lait entier, on récupère le petit lait, le babeurre et le fromage blanc ; en fabriquant la crème, on obtient le lait écrémé, le petit lait, le fromage blanc et le babeurre."
                                            },
                                            {
                                                "example_id": "f682e6ac-72c3-491a-997d-7d1d619fb713",
                                                "sense_id": "d2067e27-cb57-3b79-93f1-cb37f597f27a",
                                                "text": "Les polyoléfines entrent donc dans un marché très dynamique de produits de spécialité et de grande diffusion. De plus, à la différence du PVC, elles ne libèrent lors de leur combustion que des sous-produits inoffensifs (dioxyde de carbone et eau)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3eb8673-3fb5-307d-ab9d-fef98b146295",
                                        "entry_id": "cf6b8134-2ed8-3398-bec5-7f0424912a50",
                                        "glosses": [
                                            "Résultat non désiré d’une action."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ed8ba57-6f11-492a-9200-5f4881341cf9",
                                                "sense_id": "c3eb8673-3fb5-307d-ab9d-fef98b146295",
                                                "text": "Il doit être repris avec vigueur si nous voulons que le Québec de demain soit autre chose qu’un sous-produit de la culture américaine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sous-produit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d62ab4af-f80a-3f1b-b5c0-002d1440fc6e",
                                        "entry_id": "e177341a-39be-37dd-81f7-31012b03f3a4",
                                        "glosses": [
                                            "Participe passé masculin singulier de sous-produire."
                                        ],
