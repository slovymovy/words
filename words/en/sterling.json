                        "zh": [
                            {
                                "target_lang_word": "英镑",
                                "target_lang_sense_clarification": "指代货币属性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95c28e35-b7b0-3c95-83f1-de5f0c316b39",
                    "sense_definition": "Of the highest quality, value, or reputation; genuine and excellent.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The volunteer team did a <w>sterling</w> job organizing the charity event.",
                            "target_lang_translations": {
                                "ru": "Команда волонтеров проделала <w>безупречную</w> работу по организации благотворительного мероприятия.",
                                "zh": "志愿者团队在组织慈善活动方面做了<w>卓越的</w>工作。"
                            }
