                    {
                        "form_id": "ea4b7a44-d34d-4036-8ab1-cd3dca72669b",
                        "entry_id": "e4c56beb-60e8-3b5d-a7f9-f1d19adea5e1",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "wintermaandjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a76c8e96-a8cf-3ad6-9cc4-ec0b2678705f",
                        "entry_id": "e4c56beb-60e8-3b5d-a7f9-f1d19adea5e1",
                        "glosses": [
                            "de eerste, tweede of de twaalfde maand van het jaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2be67769-8edf-491b-8746-5d3f5b468a95",
                                "sense_id": "a76c8e96-a8cf-3ad6-9cc4-ec0b2678705f",
                                "text": "December, januari en februari zijn wintermaanden."
                            },
                            {
                                "example_id": "ca8f7c0c-718e-48a8-b852-913ccd6cbefb",
                                "sense_id": "a76c8e96-a8cf-3ad6-9cc4-ec0b2678705f",
                                "text": "In een groot deel van Nederland ging de oorlog nog een paar maanden door. Het waren uiterst moeilijke wintermaanden. Het was heel koud en er was bijna geen eten. Daarom heet deze winter van 1944 'de Hongerwinter'. Maar op 5 mei 1945 was de rest van Nederland ook bevrijd. Soldaten uit Canada, Amerika, Groot-Brittannië en Polen hebben Nederland bevrijd."
                            },
                            {
                                "example_id": "62218d2d-548a-46b1-9e24-0be23989a80d",
                                "sense_id": "a76c8e96-a8cf-3ad6-9cc4-ec0b2678705f",
                                "text": "Buiten de wintermaanden gebruiken honderden boeren langs de Maas de grond voor de verbouw van bijvoorbeeld aardappelen en maïs en voor gras- en hooiland. De boeren betogen dat er geen onderscheid gemaakt moet worden tussen schade binnen en buiten de dijk."
                            }
                        ]
                    },
                    {
                        "sense_id": "facd9954-770f-390e-8730-a4a13594566f",
                        "entry_id": "e4c56beb-60e8-3b5d-a7f9-f1d19adea5e1",
                        "glosses": [
                            "oude naam voor de twaalfde maand van het kalenderjaar"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd0ac5d0-c03b-4740-b372-0f874a0bc485",
                        "source_entry_id": "e4c56beb-60e8-3b5d-a7f9-f1d19adea5e1",
                        "source_sense_id": "a76c8e96-a8cf-3ad6-9cc4-ec0b2678705f",
                        "source_sense_description": "wintermaand",
                        "target_lang_word": "Wintermonat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wintermonat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc4eaa40-6619-395e-9bd1-614ae5a27f1d",
                                        "entry_id": "49a64bbd-f9ce-30df-bbb4-03676b20646c",
                                        "glosses": [
                                            "im Winter liegender Monat; genaue Abgrenzung unterschiedlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "093e4337-b2e3-49e3-85a8-0cbe05e1878c",
                                                "sense_id": "cc4eaa40-6619-395e-9bd1-614ae5a27f1d",
                                                "text": "Nicht nur in den Wintermonaten sind die Alpen ein beliebtes Urlaubsziel."
                                            },
                                            {
                                                "example_id": "75d9d305-9d34-46c9-8ae5-bd8c745371ae",
                                                "sense_id": "cc4eaa40-6619-395e-9bd1-614ae5a27f1d",
                                                "text": "„Trotz der nördlichen Lage ist es in den Wintermonaten verhältnismäßig warm.“"
                                            },
                                            {
                                                "example_id": "357f2b70-9303-460b-860a-748a26bb878f",
                                                "sense_id": "cc4eaa40-6619-395e-9bd1-614ae5a27f1d",
                                                "text": "„Die Wintermonate sind müde geworden.“"
                                            },
                                            {
                                                "example_id": "36842912-556f-4551-8e9c-06a19b21c36a",
                                                "sense_id": "cc4eaa40-6619-395e-9bd1-614ae5a27f1d",
                                                "text": "„Der Schnee, der in den Wintermonaten aufs flache Land gefallen war, suchte sich im Sommer als Schmelzwasser seinen Weg, bis im Herbst neuer Schnee fiel und sich das Spiel wiederholte.“"
                                            },
                                            {
                                                "example_id": "d85805ec-2042-44a4-89db-9777613a4b07",
                                                "sense_id": "cc4eaa40-6619-395e-9bd1-614ae5a27f1d",
                                                "text": "„In den Wintermonaten gingen die Geschäfte nicht so gut, und wenn er knapp bei Kasse war, drückte seine Vermieterin, die im Erdgeschoss wohnte, schon mal ein Auge zu.“"
                                            },
                                            {
                                                "example_id": "c5086723-5be9-4566-8b0c-4e51ced21ac3",
                                                "sense_id": "cc4eaa40-6619-395e-9bd1-614ae5a27f1d",
                                                "text": "„Erschwerend kommt hinzu, dass die Landwirtschaft das Wasser vor allem im Frühjahr und im Sommer benötigt, während die großen Wasserkraftwerke das ganze Jahr über, aber vor allem in den Wintermonaten aus den Stauseen Wasser ablassen, um für Strom zu sorgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cce4641d-8d6a-3928-a6c6-6ad6509d0a1f",
                                        "entry_id": "49a64bbd-f9ce-30df-bbb4-03676b20646c",
                                        "glosses": [
                                            "Dezember"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
