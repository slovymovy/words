                                        "examples": [
                                            {
                                                "example_id": "2660c33b-f46f-4260-a28e-1fe7c5b394da",
                                                "sense_id": "de9fd1fe-01cd-39d3-9f42-4f289384b5ef",
                                                "text": "Der Saturn ist bekannt für sein ausgeprägtes Ringsystem."
                                            }
                                        ],
