                                            {
                                                "example_id": "ceb2942f-a194-4f1a-a574-f79c2d272f73",
                                                "sense_id": "0295bdd7-a54a-36f3-8fc7-51a58927113b",
                                                "text": "Dnes je kandela definována jinak než svítivostí jedné přesně určené svíčky."
