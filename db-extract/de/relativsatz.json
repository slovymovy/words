                                                "sense_id": "30170670-29d0-3954-9a83-e23479d28170",
                                                "text": "Near-synonyms: (dated, deprecated) adjective clause, adjectival clause, attributive clause"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
