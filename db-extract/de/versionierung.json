                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d37aef4c-7862-4b78-8e70-d6c5a9582a98",
                                                "sense_id": "4d93ffd2-29ec-399e-b006-b2e2f8f99f00",
                                                "text": "There have been many proposals to incorporate versioning in object-oriented databases."
                                            },
                                            {
                                                "example_id": "041d972e-1743-40b7-9e3a-4906e33b0c90",
                                                "sense_id": "4d93ffd2-29ec-399e-b006-b2e2f8f99f00",
                                                "text": "2005, Longley et al, Geographic Information Systems and Science\nAn alternative to pessimistic locking is optimistic versioning."
                                            }
