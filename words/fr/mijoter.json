{
    "word_family": [
        "mijotage",
        "mijoteuse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "25ff6e12-160d-3455-bf06-26de19ccd444",
                    "sense_definition": "Cuire ou faire cuire doucement et lentement à feu doux dans un récipient fermé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut laisser <w>mijoter</w> la sauce à feu doux pendant au moins une heure."
                        },
                        {
                            "text": "Le bœuf bourguignon <w>mijote</w> tranquillement dans la cocotte depuis ce matin."
                        }
                    ],
                    "synonyms": [
                        "mitonner"
                    ],
                    "common_phrases": [
                        "laisser mijoter",
                        "faire mijoter"
                    ]
                },
                {
                    "sense_id": "cf39724d-0e9c-37f9-8ee3-fcc63311be99",
                    "sense_definition": "Préparer secrètement ou combiner lentement un projet ou une intrigue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "projet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mes collègues se taisent dès que j'arrive, je me demande ce qu'ils <w>mijotent</w>."
                        },
                        {
                            "text": "Depuis plusieurs jours, il semble <w>mijoter</w> un mauvais coup avec son frère."
                        }
                    ],
                    "synonyms": [
                        "manigancer"
                    ],
                    "common_phrases": [
                        "mijoter un mauvais coup"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier ou figuré"
                        }
                    ]
                },
                {
                    "sense_id": "d128aa23-dbeb-3bd1-903b-b04c920d9167",
                    "sense_definition": "Attendre longuement dans l'incertitude ou l'inquiétude ; patienter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le recruteur a préféré le laisser <w>mijoter</w> quelques jours avant de donner sa réponse définitive."
                        },
                        {
                            "text": "Ils sont restés à <w>mijoter</w> dans l'antichambre pendant des heures entières."
                        }
                    ],
                    "common_phrases": [
                        "laisser mijoter quelqu'un"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "94f2ea92-73ad-318f-9704-17e6639d9211",
                    "sense_definition": "Séjourner longuement dans un liquide, en parlant d'une matière en décomposition ; macérer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "maceration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les feuilles mortes <w>mijotent</w> au fond du bassin depuis le début de l'automne."
                        },
                        {
                            "text": "L'eau croupie dans laquelle <w>mijotait</w> cette carcasse dégageait une odeur infecte."
                        }
                    ]
                }
            ]
        }
    ]
