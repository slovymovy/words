                    {
                        "sense_id": "3ec8cfe9-25ef-3062-9b0e-1631d55a3c7c",
                        "entry_id": "97b05d1f-6c8c-3eef-a3b1-50f00c617a35",
                        "glosses": [
                            "An act of applying wax."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b0f718c7-4229-4ecd-922d-91ce315b0854",
                                "sense_id": "3ec8cfe9-25ef-3062-9b0e-1631d55a3c7c",
                                "text": "The wanings and waxings (of the sun and moon) occur according to the (twelve) pitch-pipes."
                            },
                            {
                                "example_id": "9f47297d-14e1-4c2f-97da-57ef254f37a2",
                                "sense_id": "3ec8cfe9-25ef-3062-9b0e-1631d55a3c7c",
                                "text": "The building interior was Gothic and finished by multiple waxings of the commercial coast woods, redwood, sugar pine, white pine, and Douglas fir."
                            },
                            {
                                "example_id": "304b8b80-e68f-4c25-857f-cdaa634c3f70",
                                "sense_id": "3ec8cfe9-25ef-3062-9b0e-1631d55a3c7c",
                                "text": "Are these metaphorical descriptions just the subjective waxings of the critic or are they aesthetic properties really (but metaphorically) true of the wine?"
                            }
                        ]
                    },
                    {
                        "sense_id": "9e978903-aeed-3147-826e-4f4192e22220",
                        "entry_id": "97b05d1f-6c8c-3eef-a3b1-50f00c617a35",
                        "glosses": [
                            "A cosmetic procedure in which hair is removed from the body by the application and removal of wax."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "72b086ac-9a8e-4391-944f-844d421b3a4e",
                                "sense_id": "9e978903-aeed-3147-826e-4f4192e22220",
                                "text": "Coordinate term: sugaring"
                            }
                        ]
                    },
                    {
                        "sense_id": "fd0a3a2c-752e-3e6d-9c42-fc604d4e9db7",
                        "entry_id": "97b05d1f-6c8c-3eef-a3b1-50f00c617a35",
                        "glosses": [
                            "A recording intended for a phonograph."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "20415dd6-8d6d-45a9-a30d-d0b7ce336e93",
                                "sense_id": "fd0a3a2c-752e-3e6d-9c42-fc604d4e9db7",
                                "text": "Except for \"Washing Machine Blues,\" a 1952 side for the King label, Carson's waxings went largely without notice."
                            }
                        ]
