                ],
                "senses": [
                    {
                        "sense_id": "38ca869c-ef1e-327b-8ed2-1e83ebfda03e",
                        "entry_id": "53f410d8-c09a-30f1-8985-de6da8103ec9",
                        "glosses": [
                            "Eigenschaft, eine Vielzahl von Lösungen, Bedeutungen, Funktionen oder Ähnliches zu haben"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "66261b43-7d45-4ada-9c07-306f4eee8e25",
                                "sense_id": "38ca869c-ef1e-327b-8ed2-1e83ebfda03e",
                                "text": "„Diese Vielfalt macht die ausgeprägte Multivalenz dieser Strömung besonders deutlich: Sie bedient gleichzeitig sehr unterschiedliche Bedürfnisse, zusammengehalten durch ein Netzwerk, dessen Mitglieder sich gegenseitig unterstützen.“"
                            },
                            {
                                "example_id": "a5c525e4-cdd3-45b7-a96a-2cebd7ea868b",
                                "sense_id": "38ca869c-ef1e-327b-8ed2-1e83ebfda03e",
                                "text": "„Es muss vielmehr die gesamte Komplexität des Faches, dessen Multivalenz, in den Blick genommen werden.“"
                            },
                            {
                                "example_id": "aa5aad5e-e6db-4104-ae68-d93aee946e8c",
                                "sense_id": "38ca869c-ef1e-327b-8ed2-1e83ebfda03e",
                                "text": "„Seine Eingangsargumentation dient dabei dem Nachweis, dass kein Wort in der Schrift überflüssig sei und eine exegetische Operation daher vor allem die Multivalenz einer sprachlichen Wendung aufzuzeigen habe.“"
                            },
                            {
                                "example_id": "8eb98f6a-ca0b-41ca-9632-e0d92d5d18b4",
                                "sense_id": "38ca869c-ef1e-327b-8ed2-1e83ebfda03e",
                                "text": "„Was man als Anregungen für einzelne Elemente und Figuren herausgefunden hat, demonstriert in Herkunft und Multivalenz Shakespeares zunehmendes Vermögen, heterogene Elemente zu einem Bedeutungsganzen zusammenzufügen.“"
                            },
                            {
                                "example_id": "6cd74bf2-c98d-49fc-8adb-3f39a985673c",
                                "sense_id": "38ca869c-ef1e-327b-8ed2-1e83ebfda03e",
                                "text": "„Mit der Multivalenz der poetischen Sprache, die bei jedem Kunstwerk von Rang vorauszusetzen ist, darf solche Vielschichtigkeit nicht verwechselt werden.“"
                            },
                            {
                                "example_id": "87c09975-d810-4ca4-a449-589d62d4f68e",
                                "sense_id": "38ca869c-ef1e-327b-8ed2-1e83ebfda03e",
                                "text": "„Sie ermöglicht einen kreativen, querdenkerischen Zugang und Umgang mit Gegensätzen und Multivalenzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0e80b115-7996-32ee-9973-487ad12819fd",
                        "entry_id": "53f410d8-c09a-30f1-8985-de6da8103ec9",
                        "glosses": [
                            "Eigenschaft, eine Wertigkeit von zwei oder größer zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2d93746-835c-4d17-983a-8e12fa40ad84",
                                "sense_id": "0e80b115-7996-32ee-9973-487ad12819fd",
                                "text": "„In den Verbindungen mit positiven Elementen verhalten sich die Halogene einwerthig – gegenüber dem negativen Sauerstoff aber können sie mehrwerthig auftreten; für das Jod ist die Multivalenz direct nachgewiesen worden.“"
                            },
                            {
                                "example_id": "f88feaf9-9bb9-4312-8732-ef7c50910d34",
                                "sense_id": "0e80b115-7996-32ee-9973-487ad12819fd",
                                "text": "„Die Eigenschaften der chemischen Elemente, ihr spezifisches Gewicht, ihre spezifische Wärme, ihre Stellung in der elektrischen Reihe, das Verhältnis ihrer chemischen Verwandtschaften, ihre Multivalenz, die Beständigkeit der Massverhältnisse bei den Verbindungen, die spektroskopische Zerlegung der von ihnen ausgehenden Lichtstrahlen und andere Erscheinungen, die alle miteinander in Beziehungen stehen, deuten darauf hin, dass Elemente gar keine Elemente sind, sondern gleichartigen Urelementen.“"
                            },
                            {
                                "example_id": "7fd48caa-9de5-407a-b2e3-dc55d716edc9",
                                "sense_id": "0e80b115-7996-32ee-9973-487ad12819fd",
                                "text": "„Nicht nur bei Fe, sondern auch bei Mn, Co, Ni und Cu ist die Multivalenz sehr ausgeprägt.“"
                            },
                            {
                                "example_id": "d500c57d-ecdc-4c02-893f-353c5bd9dfde",
                                "sense_id": "0e80b115-7996-32ee-9973-487ad12819fd",
                                "text": "„Die Effektivität der Abschirmung steigt mit der Multivalenz der eingesetzten Kationen an.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
