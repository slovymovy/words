                "senses": [
                    {
                        "sense_id": "c8fb6a5c-b424-33c3-a29f-c1f1d2ab935b",
                        "entry_id": "f34178a7-744d-354e-95cd-33986dcb7e30",
                        "glosses": [
                            "Unfall in einer kerntechnischen Anlage in deren atomarem Kernbereich, bei dem Radioaktivität freigesetzt wird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5845fd7-74be-43ec-b0dd-137f4393f75a",
                                "sense_id": "c8fb6a5c-b424-33c3-a29f-c1f1d2ab935b",
                                "text": "„Um Bürger bei Atomunfällen zu schützen, rüstet Nordrhein-Westfalen die Katastrophenschutzämter landesweit mit Millionen zusätzlicher Jodtabletten aus.“"
                            },
                            {
                                "example_id": "b55c8f4d-de05-4270-bd7e-b0caa2cc5f92",
                                "sense_id": "c8fb6a5c-b424-33c3-a29f-c1f1d2ab935b",
                                "text": "„Monate sind vergangen seit dem Atomunfall, seit die radioaktive Wolke übers Land zog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
