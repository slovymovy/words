                "senses": [
                    {
                        "sense_id": "cc4e4551-ee0b-3457-a16c-81c8b07fe4e2",
                        "entry_id": "c2c6108e-2c79-312f-b123-709206680644",
                        "glosses": [
                            "The fictional character Shadowheart from the video game Baldur's Gate 3."
                        ],
                        "tags": [
                            "derogatory",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "2727309d-122b-41db-bd64-345cef201caa",
                                "sense_id": "cc4e4551-ee0b-3457-a16c-81c8b07fe4e2",
                                "text": "They [BG3's female companions] aren't particularly evil, if you sided with the Goblins you can clearly tell that Shart isn't even evil, just very pragmatic about your Tadpole problem."
                            },
                            {
                                "example_id": "ccacc9d0-eeea-4eca-8065-49dcd65e9813",
                                "sense_id": "cc4e4551-ee0b-3457-a16c-81c8b07fe4e2",
                                "text": "I felt like Lae and Shart will have potential redemption arcs and will be trying for those."
                            },
                            {
                                "example_id": "db59f6b3-34c6-4e26-b6cf-57123b872ac9",
                                "sense_id": "cc4e4551-ee0b-3457-a16c-81c8b07fe4e2",
                                "text": "This build works equally well whatever you do with Shart, but obviously the whole stalking gloom thing is a better thematic fit for a Shar loyalist."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "24752ac6-5efb-454f-a54b-711de5c677c3",
                        "source_entry_id": "c2c6108e-2c79-312f-b123-709206680644",
                        "source_sense_ids": [
                            "cc4e4551-ee0b-3457-a16c-81c8b07fe4e2"
                        ],
                        "linkage_type": "synonyms",
                        "word": "Shadowbae"
                    }
                ]
            },
