                        ]
                    },
                    {
                        "translation_id": "ffd08530-aa5b-4057-b473-1b91da99bbcd",
                        "source_entry_id": "b66a9d89-ef64-3ec0-8d9b-ad2d14bbf0cb",
                        "source_sense_id": "96339912-ed6d-3d08-b28d-714638fffb10",
                        "source_sense_description": "de af te leggen of afgelegde weg van een voorwerp door de ruimte",
                        "target_lang_word": "Route",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Route",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7bc7d590-e387-3b23-90ea-07151aeef88f",
                                        "entry_id": "e79bb771-5ad3-35fc-b069-f3b3e56a1995",
                                        "glosses": [
                                            "festgelegter, bestimmter Weg"
                                        ],
                                        "tags": [
                                            "auch übertragen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5425a7b1-3eb6-46dc-924d-3c8f2284c273",
                                                "sense_id": "7bc7d590-e387-3b23-90ea-07151aeef88f",
                                                "text": "„Die Route führte durch unbekannte Gebiete und oft sehr unwegsames Gelände.“"
                                            },
                                            {
                                                "example_id": "217ad2d1-5546-465b-aabe-a0324cc00fb8",
                                                "sense_id": "7bc7d590-e387-3b23-90ea-07151aeef88f",
                                                "text": "„Bald kennen die Steuermänner die Strömungen und Gefahren auf der Fahrt zwischen Nordeuropa und Island besser, ist die Route weniger risikoreich als zuvor.“"
                                            },
                                            {
                                                "example_id": "bd767c72-4876-47e5-8dfd-5c6751d2fbe8",
                                                "sense_id": "7bc7d590-e387-3b23-90ea-07151aeef88f",
                                                "text": "„Wenn ich die Route geschafft habe, bin ich kurz glücklich, bald darauf aber traurig, weil ich einen Traum realisiert habe und dieser somit nicht mehr existiert, zitiert Zak den Freikletterer A. Albert.“"
                                            },
                                            {
                                                "example_id": "e838c9f8-44c3-40ed-9fa7-aa2aab40e172",
                                                "sense_id": "7bc7d590-e387-3b23-90ea-07151aeef88f",
                                                "text": "„Um unsere Route abzukürzen, beschloss ich, gleich nach der Kirche links in die Brunnenstraße abzubiegen.“"
                                            },
                                            {
                                                "example_id": "a9a98d53-b9ec-4664-9368-cf9a17c7517f",
                                                "sense_id": "7bc7d590-e387-3b23-90ea-07151aeef88f",
                                                "text": "„Die polizeilich genehmigte Demo-Route führt nun vom Hauptbahnhof über Glockengießerwall und Ballindamm zum Jungfernstieg."
                                            },
                                            {
                                                "example_id": "33b3c708-692f-484e-9b7a-25b297771280",
                                                "sense_id": "7bc7d590-e387-3b23-90ea-07151aeef88f",
                                                "text": "„Wenn unerfahrene Bergsportler die falsche Route wählen oder dem sicheren Weg das steile Gelände vorziehen, arbeitet der Leichtsinn der Technik entgegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "670aa8e5-6153-4d9a-991b-4ad6cc496420",
                        "source_entry_id": "b66a9d89-ef64-3ec0-8d9b-ad2d14bbf0cb",
                        "source_sense_id": "96339912-ed6d-3d08-b28d-714638fffb10",
                        "source_sense_description": "de af te leggen of afgelegde weg van een voorwerp door de ruimte",
                        "target_lang_word": "Strecke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strecke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95111e0c-8a2f-34a5-b078-d66aef8fe264",
                                        "entry_id": "c3123b70-a13e-3766-8f26-5f10fdfac377",
                                        "glosses": [
                                            "Stück eines Weges"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e05b0b62-f38f-41a4-939d-af9b30030126",
                                                "sense_id": "95111e0c-8a2f-34a5-b078-d66aef8fe264",
                                                "text": "Die Strecke, die wir heute zurücklegten, war sehr kurz."
                                            },
                                            {
                                                "example_id": "cdfe96db-cae7-4c21-bb62-eb2d041d7d0b",
                                                "sense_id": "95111e0c-8a2f-34a5-b078-d66aef8fe264",
                                                "text": "„Auf gerader Strecke stehen die Leitpfosten in einem Abstand von 50 Metern.“"
                                            },
                                            {
                                                "example_id": "ba7c3834-2504-4a85-beee-bc008bdc8e53",
                                                "sense_id": "95111e0c-8a2f-34a5-b078-d66aef8fe264",
                                                "text": "„Weite weizenfarbene Strecken wechseln mit grünem flachem Land, still und fruchtbar.“"
                                            },
                                            {
                                                "example_id": "0700190d-b52e-42d5-9f13-2e483c623fb2",
                                                "sense_id": "95111e0c-8a2f-34a5-b078-d66aef8fe264",
                                                "text": "„Eigentlich sind es sogar viel mehr Gipfel, dann der Seebuck und der Stübenwasen liegen direkt auf der Strecke, so dass sie letztlich zum Gipfelsammler werden.“"
                                            },
                                            {
                                                "example_id": "ea276a46-9518-476e-98cc-e2a9471905eb",
                                                "sense_id": "95111e0c-8a2f-34a5-b078-d66aef8fe264",
                                                "text": "„Wie immer auf diesem Teil der Strecke schaue ich aus dem Fenster der Zugtür.“"
                                            },
                                            {
