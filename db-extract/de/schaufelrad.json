                "senses": [
                    {
                        "sense_id": "0feac5a8-c7ff-3f76-8ed3-6ca1211586a7",
                        "entry_id": "6102e687-df4e-3615-a54f-d268b03a9d7f",
                        "glosses": [
                            "ein mit Schaufeln besetztes Rad in Wasserkraftmaschinen, Zentrifugalpumpen, Baggern, Dampf- und Gasturbinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff050dd3-1265-4fa0-a5e3-d45e9e5eb4da",
                                "sense_id": "0feac5a8-c7ff-3f76-8ed3-6ca1211586a7",
                                "text": "„Als modernes Fortbewegungsorgan an Schiffen haben Schaufelräder von einem Exzenter gesteuerte, in Gelenken bewegliche Schaufeln, so dass sie auf ihrem Weg durchs Wasser stets senkrecht bleiben.“"
                            },
                            {
                                "example_id": "c8c0693d-9fbd-4400-ab7d-c16416844b5a",
                                "sense_id": "0feac5a8-c7ff-3f76-8ed3-6ca1211586a7",
                                "text": "„Heute drehen sich die Schaufelräder wieder und durch den Salon im originalgetreuen Art-Deco-Stil drängen sich die Leute, um an Deck zu gelangen.“"
                            },
                            {
                                "example_id": "dd3f036a-0e85-45e9-b6d7-48ac861b34f4",
                                "sense_id": "0feac5a8-c7ff-3f76-8ed3-6ca1211586a7",
                                "text": "„Am 9. November gegen zwölf Uhr mittags mietete ein säuerlich blickender Herr mit Säbelbeinen bei einem Bootverleiher am Strand eine sogenannte »Gaivola«, einen altmodischen Wassertreter, der aus zwei Holzkufen, einer Art Liegestuhl mit Pedalen dazwischen, und einem Schaufelrad bestand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
