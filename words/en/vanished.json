            "senses": [
                {
                    "sense_id": "1d483e4b-593b-3867-8d9e-a688d2070c25",
                    "sense_definition": "Simple past and past participle of <w>vanish</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disappearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician <w>vanished</w> from the stage in a cloud of smoke.",
                            "target_lang_translations": {
                                "ru": "Фокусник <w>исчез</w> со сцены в облаке дыма."
                            }
                        },
                        {
                            "text": "All my hope <w>vanished</w> when I heard the bad news.",
                            "target_lang_translations": {
                                "ru": "Вся моя надежда <w>исчезла</w>, когда я услышал плохие новости."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form of the verb vanish."
                        }
                    ],
                    "target_lang_definitions": {
