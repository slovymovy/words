                                            "interrogativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b43d111-926a-430c-beb9-52bc9b16c1d9",
                                                "sense_id": "aa8c7e62-8929-36d9-8c8e-363a28389e00",
                                                "text": "Wovon sprichst du?"
                                            },
                                            {
                                                "example_id": "41ad1150-528d-49f1-9c70-d56a114eb48a",
                                                "sense_id": "aa8c7e62-8929-36d9-8c8e-363a28389e00",
                                                "text": "Wovon lebt sie eigentlich?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e606accd-0735-3518-bf03-59f3d70bd870",
                                        "entry_id": "8a50de16-6cfc-387a-a4d5-b61ae4640b31",
                                        "glosses": [
                                            "von dieser Sache/Angelegenheit (die gerade aktuell ist, von der wir sprechen)"
                                        ],
                                        "tags": [
                                            "relativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9808627a-654d-41c1-8697-cfc9dbed54e1",
                                                "sense_id": "e606accd-0735-3518-bf03-59f3d70bd870",
                                                "text": "Das ist exakt, wovon ich gerade gesprochen habe!"
                                            },
                                            {
                                                "example_id": "9892edfe-c165-4d1c-8971-01031f064977",
                                                "sense_id": "e606accd-0735-3518-bf03-59f3d70bd870",
                                                "text": "Das ist etwas, wovon ich träume."
                                            },
                                            {
                                                "example_id": "aacad0e8-19ee-46ee-a84f-c2b3b8f5d151",
                                                "sense_id": "e606accd-0735-3518-bf03-59f3d70bd870",
                                                "text": "„In römischer Zeit befand sich auf der Insel eine Rhetorikschule, wovon sich der Name („Schule“) herleitet.“"
                                            },
                                            {
                                                "example_id": "9209c686-51e8-4779-bd5f-dbada5c30047",
                                                "sense_id": "e606accd-0735-3518-bf03-59f3d70bd870",
                                                "text": "„Im Libanon lebten im Juli 2015 etwa 6,18 Millionen Menschen, wovon knapp die Hälfte auf die Hauptstadtregion Beirut entfällt.“"
                                            },
                                            {
                                                "example_id": "7ddec437-0568-48fe-b043-6b9d3d2b8a67",
                                                "sense_id": "e606accd-0735-3518-bf03-59f3d70bd870",
                                                "text": "„Mit etwa 250 Einwohnern ist Bermoll der kleinste Stadtteil mit einer Gesamtfläche von 430 ha, wovon 263 ha Wald sind.“"
                                            },
                                            {
                                                "example_id": "ebee2f9c-67ba-4366-a3bf-fa604753878c",
                                                "sense_id": "e606accd-0735-3518-bf03-59f3d70bd870",
                                                "text": "„Die Liste der Flugzeugträger der United States Navy umfasst derzeit insgesamt 80 Schiffe. Davon wurden 64 Träger während der letzten 85 Jahre in Dienst gestellt, wovon noch zehn Einheiten aktiv sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
