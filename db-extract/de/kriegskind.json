                "senses": [
                    {
                        "sense_id": "508c1130-b4f5-3d71-842c-d4bc864ff303",
                        "entry_id": "c9bf0a2c-2215-38d4-bfa5-14f7265233d1",
                        "glosses": [
                            "Person, deren Kindheit durch Kriegsgeschehen geprägt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17cac1eb-15c0-471b-a0bd-2a5ff5f254da",
                                "sense_id": "508c1130-b4f5-3d71-842c-d4bc864ff303",
                                "text": "„Seit 2004 kommen Menschen zu meinen Lesungen, weil sie Kriegskinder sind.“"
                            },
                            {
                                "example_id": "651c216e-674c-4dfd-85fa-b5fba0a0fc81",
                                "sense_id": "508c1130-b4f5-3d71-842c-d4bc864ff303",
                                "text": "„Erst durch diese Auseinandersetzung schien es möglich, auch das Leid der deutschen Kriegskinder ins Blickfeld zu nehmen.“"
                            },
                            {
                                "example_id": "3d36eca5-b3c3-4de9-af3f-1cd6748ca19e",
                                "sense_id": "508c1130-b4f5-3d71-842c-d4bc864ff303",
                                "text": "„Junglehrer, die der Krieg aus dem Osten nach Perleberg gespült hat, sind den Anforderungen des Unterrichts mit den teilweise verwahrlosten und hartgesottenen Kriegskindern kaum gewachsen.“"
                            },
                            {
                                "example_id": "979f75a3-0516-4e9b-99cb-9fd21f2a9d7a",
                                "sense_id": "508c1130-b4f5-3d71-842c-d4bc864ff303",
                                "text": "„Innerlich zittert sie schon, wie ein Kriegskind nur zittern kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
