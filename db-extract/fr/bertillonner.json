                "senses": [
                    {
                        "sense_id": "7435dd5b-5e67-3555-92b4-6c8ec4e6d4db",
                        "entry_id": "acbf0bf9-ba41-315b-bc94-355ef0a15ecb",
                        "glosses": [
                            "Mesurer, identifier, en utilisant les méthodes de Bertillon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cad3ebc7-7f2d-414d-ae31-57669e8263f8",
                                "sense_id": "7435dd5b-5e67-3555-92b4-6c8ec4e6d4db",
                                "text": "Tout Chinois qui arrive, serait-ce pour vingt-quatre heures seulement avec son maître, doit aller se faire toiser et bertillonner dans ses bureaux."
                            },
                            {
                                "example_id": "6eebfa0b-858d-4f7b-8f9f-ccda901ab346",
                                "sense_id": "7435dd5b-5e67-3555-92b4-6c8ec4e6d4db",
                                "text": "Bertillonner cette page est une simple affaire de mémoire."
                            },
                            {
                                "example_id": "87ae9752-0355-45d4-b229-66b70bde3382",
                                "sense_id": "7435dd5b-5e67-3555-92b4-6c8ec4e6d4db",
                                "text": "Le jour où l’on pourrait comparer les mains d’un prévenu avec ces photos bertillonnées, l’inculpé passerait assurément, sinon aux aveux, du moins un méchant quart d’heure…"
                            },
                            {
                                "example_id": "31f9722c-98f4-4a94-9d9c-513929f539ae",
                                "sense_id": "7435dd5b-5e67-3555-92b4-6c8ec4e6d4db",
                                "text": "– Ça donne quoi chez vous ?\n – Des nèfles ! À les entendre, tous des enfants de chœur ! Du coup, on bertillonne ! Ce sera toujours des archives pour l’identification !"
                            }
                        ]
                    }
