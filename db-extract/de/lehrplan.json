                "senses": [
                    {
                        "sense_id": "320ab7f2-a394-3f06-9cf3-26308c1cd6ff",
                        "entry_id": "90762007-eb3f-3036-9f22-78ff5fdf8202",
                        "glosses": [
                            "Entwurf, der Lehrziele, Lehrinhalte, didaktische und gestalterische Hinweise enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "161973ed-8670-4bb1-b00b-681b81373279",
                                "sense_id": "320ab7f2-a394-3f06-9cf3-26308c1cd6ff",
                                "text": "„Der Begriff Schulwissen bezeichnet jenes Wissen, das in Schulen nach Lehrplänen vermittelt wird.“"
                            },
                            {
                                "example_id": "de842f45-9c71-4e22-be5c-4f709bc5340b",
                                "sense_id": "320ab7f2-a394-3f06-9cf3-26308c1cd6ff",
                                "text": "„Ungehindert verwirklichen konnte er seine Lehrpläne aber erst an der Ritterakademie zu Halle, die unter seiner Mitwirkung dann 1694 zur Universität ausgebaut wurde.“"
                            },
                            {
                                "example_id": "78b086e5-9216-4714-af35-f351e6ce755f",
                                "sense_id": "320ab7f2-a394-3f06-9cf3-26308c1cd6ff",
                                "text": "„Nie hatte Alf jemals eine Frage über den Lehrplan gestellt - sie wußten bereits vieles, was er nicht wußte, er war nie zusammengekommen mit Aktiv und Passiv, Konditional und Gerundium, mit dem lateinischen Ablativus absolutus.“"
                            },
                            {
                                "example_id": "179ba089-4ec9-4ae2-9ba8-261e83055a35",
                                "sense_id": "320ab7f2-a394-3f06-9cf3-26308c1cd6ff",
                                "text": "„Als der Zweite Weltkrieg in meiner Oberschule auf dem Lehrplan stand, holte meine elsässische Großmutter einen Packen Schwarzweißfotos aus einer Schublade.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b1ac7c8-94a1-4318-a06a-b3382df5e854",
                        "source_entry_id": "90762007-eb3f-3036-9f22-78ff5fdf8202",
                        "source_sense_id": "320ab7f2-a394-3f06-9cf3-26308c1cd6ff",
                        "source_sense_description": "Entwurf, der Lehrziele, Lehrinhalte, didaktische und gestalterische Hinweise enthält",
                        "target_lang_word": "curriculum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curriculum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb38bf67-66f4-30eb-ac31-f6feaf5fcd1f",
                                        "entry_id": "c5a749ce-c100-327d-a87f-5c41b0a0d40b",
                                        "glosses": [
                                            "The set of courses, coursework, and content offered at a school or university."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9529b951-0844-4540-8438-7cc8532e7c9c",
                                                "sense_id": "bb38bf67-66f4-30eb-ac31-f6feaf5fcd1f",
                                                "text": "Perhaps someday my old US history teacher, and men like him, will use The Politically Incorrect Guide to the Great Depression in their courses to balance the many explicitly pro–New Deal and prointerventionist texts and presentations that dominate public-school curricula today."
                                            },
                                            {
                                                "example_id": "bc7a8701-8575-4540-ae70-791ef8e2711b",
                                                "sense_id": "bb38bf67-66f4-30eb-ac31-f6feaf5fcd1f",
                                                "text": "But as the effects of climate change have become more visible in recent years, and the breadth of the transformation needed to fight it has become clear, law schools, med schools, literature programs, economics departments and more are incorporating climate into their undergraduate curriculums, grappling with how climate will transform their fields and attempting to prepare students to face those transformations in the labor market."
                                            },
                                            {
                                                "example_id": "988d638a-344b-421a-8135-992437e63946",
                                                "sense_id": "bb38bf67-66f4-30eb-ac31-f6feaf5fcd1f",
                                                "text": "Bluebonnet Learning materials will be part of a menu of curriculums available for school districts to use. […] Staci Childs, a member of the board who voted against Bluebonnet, told CNN Friday that although the curriculum is optional, she expects most districts will adopt it given the “huge financial implications” of the incentive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b29a6f7f-847c-3538-9ff0-f53027c8bcd4",
                                        "entry_id": "c5a749ce-c100-327d-a87f-5c41b0a0d40b",
                                        "glosses": [
                                            "The set of standards schools are required to teach all students."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d226dde3-0bb5-47cc-af66-5e07d06485b0",
                                                "sense_id": "b29a6f7f-847c-3538-9ff0-f53027c8bcd4",
                                                "text": "Drawing on texts recommended in curricula and controlling for two countries with benchmarked curricula improves the external representativeness of the corpus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "849ca9a0-e404-31da-9259-bebd7a7f2cce",
                                        "entry_id": "c5a749ce-c100-327d-a87f-5c41b0a0d40b",
                                        "glosses": [
                                            "A racecourse; a place for running."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf6e0e3e-1f46-4c50-8f04-4937fa2f8bce",
                        "source_entry_id": "90762007-eb3f-3036-9f22-78ff5fdf8202",
                        "source_sense_id": "320ab7f2-a394-3f06-9cf3-26308c1cd6ff",
                        "source_sense_description": "Entwurf, der Lehrziele, Lehrinhalte, didaktische und gestalterische Hinweise enthält",
                        "target_lang_word": "syllabus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syllabus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9755b6db-38de-3967-9c57-2cf26ccef4c6",
                                        "entry_id": "ee2fe09f-ec7a-3e9c-a2ed-99747bafdaab",
                                        "glosses": [
                                            "A summary of topics which will be covered during an academic course, or a text or lecture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "671f89a8-9be2-4de8-baf4-3dea70e26aaf",
                                                "sense_id": "9755b6db-38de-3967-9c57-2cf26ccef4c6",
                                                "text": "In the first half of the year, teachers attended the training workshop for the new K-10 Chinese syllabus. In July, almost all the teachers attended the teacher training courses provided by OCAC."
                                            },
                                            {
                                                "example_id": "0b182b6d-efc0-4f1f-95ec-712178849b82",
                                                "sense_id": "9755b6db-38de-3967-9c57-2cf26ccef4c6",
                                                "text": "‘I checked online for a beginner syllabus,’ she say. ‘A syllabus is a plan for how we would work, what I can teach you.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccefea80-1ea2-39ec-b38b-b34e4ce8a4b0",
                                        "entry_id": "ee2fe09f-ec7a-3e9c-a2ed-99747bafdaab",
                                        "glosses": [
                                            "The headnote of a reported case; the brief statement of the points of law determined prefixed to a reported case."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63bd5e73-1928-4da4-86f3-f6be1042c44e",
                        "source_entry_id": "90762007-eb3f-3036-9f22-78ff5fdf8202",
                        "source_sense_id": "320ab7f2-a394-3f06-9cf3-26308c1cd6ff",
