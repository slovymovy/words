                        "entry_id": "439e0c6f-48d1-35d9-a77c-129fa7e4d5ff",
                        "glosses": [
                            "Personne très forte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4bfa641-bd6f-44cd-9f04-ee68423bf43a",
                                "sense_id": "6972869a-b090-331b-a985-2b48351d10e6",
                                "text": "C'est un homme bien fort, un homme robuste & vigoureux, un brisefer."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d7e21c4-cb9a-3086-b63f-f31e33c02584",
                        "entry_id": "439e0c6f-48d1-35d9-a77c-129fa7e4d5ff",
                        "glosses": [
                            "Personne qui par maladresse, étourderie, brutalité, manque de soins, brise les choses dont il se sert habituellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4cc6d85-48a5-482c-9a2f-5c742ae1ce8c",
                                "sense_id": "7d7e21c4-cb9a-3086-b63f-f31e33c02584",
                                "text": "Même avec un brisefer au volant, un synchro de boîte qui ne tient pas le temps d'une garantie est un synchro défectueux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9664c21d-a17f-4298-b031-f1861864eb7c",
                        "source_entry_id": "439e0c6f-48d1-35d9-a77c-129fa7e4d5ff",
                        "source_sense_description": "personne maladroite qui casse tout",
                        "target_lang_word": "klutz",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klutz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "617da9da-fe4b-3deb-90b7-83698624bc3e",
                                        "entry_id": "ec7b363e-d2f8-3e94-b702-2f2fafd2a15a",
                                        "glosses": [
                                            "A clumsy or stupid person."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04834226-9e42-40ef-ab20-1894e75174e7",
                                                "sense_id": "617da9da-fe4b-3deb-90b7-83698624bc3e",
                                                "text": "Well, that's all right, then, Brian. Sit down. Have a scone. Make yourself at home. You klutz!"
                                            },
                                            {
                                                "example_id": "511d282e-9010-41d3-97c4-5918287b7397",
                                                "sense_id": "617da9da-fe4b-3deb-90b7-83698624bc3e",
                                                "text": "\"Out of [one abortion doctor's] first six months of work, there are nine malpractice suits ... After it was apparent the guy was a klutz, they kept using him, and trying to cover for him, because they couldn't find another provider.\""
                                            },
                                            {
                                                "example_id": "1c014e89-0dda-48be-bb94-a863a1e6b945",
                                                "sense_id": "617da9da-fe4b-3deb-90b7-83698624bc3e",
                                                "text": "\"Mel, back home we'd call you a klutz.\" / Melissa: \"Use a lot of Yiddish back in Texas, do you?\""
                                            },
                                            {
                                                "example_id": "ef92b4f9-e2b9-42af-af9b-e5705015c3de",
                                                "sense_id": "617da9da-fe4b-3deb-90b7-83698624bc3e",
                                                "text": "I bumped into the coffee table. \"Sorry about that table. Don't worry, you should see me, Qanta. I am the klutz! I am always doing that!\" She giggled at her clumsiness while I giggled at a Saudi using idiomatic Yiddish."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
