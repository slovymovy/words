                    {
                        "sense_id": "67ced7d9-b754-39f1-9816-05784e5609fb",
                        "entry_id": "fa024779-1e18-356b-84d9-6b7022d07212",
                        "glosses": [
                            "Schuss, bei dem das Projektil den Bereich des Bauches trifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d10363d-f41d-4404-8ad3-de087096c15c",
                                "sense_id": "67ced7d9-b754-39f1-9816-05784e5609fb",
                                "text": "Beim Angriff der Terroristen erlitt der Soldat einen Bauchschuss."
                            },
                            {
                                "example_id": "cd3c03bf-3597-4862-bc74-0bb5a4901f6a",
                                "sense_id": "67ced7d9-b754-39f1-9816-05784e5609fb",
                                "text": "„Der 29-Jährige erlitt einen lebensgefährlichen Bauchschuss und wurde in ein Unfallkrankenhaus gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7db66b4c-73ac-4613-bb6d-9b7ef8e92849",
                        "source_entry_id": "fa024779-1e18-356b-84d9-6b7022d07212",
                        "source_sense_id": "67ced7d9-b754-39f1-9816-05784e5609fb",
