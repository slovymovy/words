        "onstandvastigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8d228628-d359-35b6-8712-29277ec05ea9",
                    "sense_definition": "Gemakkelijk veranderend of wisselend, met name gezegd van het weer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weersgesteldheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De meteoroloog voorspelt voor de komende week uiterst <w>onstandvastig</w> weer met veel regen.",
                            "target_lang_translations": {
                                "en": "The meteorologist predicts extremely <w>unsettled</w> weather with a lot of rain for the coming week."
                            }
                        },
                        {
                            "text": "Door het <w>onstandvastige</w> weer besloten we onze geplande wandeling in het bos uit te stellen.",
                            "target_lang_translations": {
                                "en": "Due to the <w>changeable</w> weather, we decided to postpone our planned walk in the forest."
                            }
                        }
                    ],
                    "synonyms": [
                        "wisselvallig",
                        "onbestendig",
                        "grillig"
                    ],
                    "common_phrases": [
                        "onstandvastig weer"
                    ],
                    "target_lang_definitions": {
                        "en": "Easily changing or variable, especially said of the weather."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unstable",
                                "target_lang_sense_clarification": "referring to weather conditions"
                            },
                            {
                                "target_lang_word": "changeable",
                                "target_lang_sense_clarification": "referring to weather conditions"
                            },
                            {
                                "target_lang_word": "unsettled",
                                "target_lang_sense_clarification": "referring to weather conditions"
                            },
                            {
                                "target_lang_word": "variable",
                                "target_lang_sense_clarification": "referring to weather conditions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23ca6e1c-3ec3-38c0-96aa-2b866a470b96",
                    "sense_definition": "Niet standvastig of standvastig van karakter; wispelturig, onzeker of besluiteloos in gedrag of overtuiging.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>onstandvastige</w> houding zorgde ervoor dat zijn collega's hem niet volledig vertrouwden.",
                            "target_lang_translations": {
                                "en": "His <w>fickle</w> attitude meant that his colleagues did not fully trust him."
                            }
                        },
                        {
                            "text": "Zij bleef erg <w>onstandvastig</w> in haar beslissingen, waardoor het project veel vertraging opliep.",
                            "target_lang_translations": {
                                "en": "She remained very <w>wavering</w> in her decisions, which caused the project to be delayed significantly."
                            }
                        }
                    ],
                    "synonyms": [
                        "onzeker",
                        "twijfelend",
                        "wankelmoedig",
                        "wijfelmoedig",
                        "halfslachtig",
                        "labiel",
                        "wispelturig",
                        "besluiteloos"
                    ],
                    "antonyms": [
                        "ferm"
                    ],
                    "common_phrases": [
                        "onstandvastig karakter"
                    ],
                    "target_lang_definitions": {
                        "en": "Not steadfast or firm in character; fickle, uncertain, or indecisive in behavior or conviction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fickle",
                                "target_lang_sense_clarification": "changing loyalties, interests, or decisions frequently"
                            },
                            {
                                "target_lang_word": "inconstant",
                                "target_lang_sense_clarification": "not faithful or dependable"
                            },
                            {
                                "target_lang_word": "unsteady",
                                "target_lang_sense_clarification": "not firm or stable in behavior or resolve"
                            },
                            {
                                "target_lang_word": "wavering",
                                "target_lang_sense_clarification": "hesitant or indecisive"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}