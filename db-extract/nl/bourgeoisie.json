                        "sense_id": "d2376f52-6706-38bd-8050-f2df489b8cb9",
                        "entry_id": "a93bb1f2-570e-39fe-a0ed-51ae6005f562",
                        "glosses": [
                            "gevestigde burgerij, een sociale klasse van mensen in de middenklasse en bovenklasse die hun macht of status ontlenen aan hun bezit, opleiding en werk"
                        ],
