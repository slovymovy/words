                "senses": [
                    {
                        "sense_id": "04bf0e23-1888-3d49-9412-cc3b435747f0",
                        "entry_id": "875d0466-3778-350f-9ac8-b1042471b1ac",
                        "glosses": [
                            "Clipping of tranquilizer."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "clipping",
                            "countable",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "fb66925c-cebc-47ce-bcaf-9850253b15bc",
                                "sense_id": "04bf0e23-1888-3d49-9412-cc3b435747f0",
                                "text": "\"I gave her a tranq,\" he said with anguish. \"She asked for one and I found this bottle in the medicine cabinet and gave it to her.\""
                            },
                            {
                                "example_id": "818c12d8-227b-4cb9-b99f-029c4fae0d03",
                                "sense_id": "04bf0e23-1888-3d49-9412-cc3b435747f0",
                                "text": "She needs you like she needs her tranqs / To tell her that the world is clean."
                            },
                            {
                                "example_id": "ba4287ca-0923-44be-8587-547cb98a2756",
                                "sense_id": "04bf0e23-1888-3d49-9412-cc3b435747f0",
                                "text": "The cops were forced to call in reinforcements to shoot the zebra with tranquilizer darts in an effort to calm him down. Unfortunately, the tranqs did the opposite, setting the zebra off in a panic, as it ran into a nearby lake."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f734889-bf95-3e77-93ee-d9bd737b985f",
                        "entry_id": "875d0466-3778-350f-9ac8-b1042471b1ac",
                        "glosses": [
                            "The veterinary analgesic drug xylazine, used as a street drug."
                        ],
                        "tags": [
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "099cf2b8-aa34-4156-90b3-2cc54e1be26c",
                                "sense_id": "5f734889-bf95-3e77-93ee-d9bd737b985f",
                                "text": "In viral videos uploaded to social channels such as TikTok, tranq users are filmed when they are in a physical state in which they are unlikely to be able to consent."
                            }
                        ]
                    }
                ],
