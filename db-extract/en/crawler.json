                        "entry_id": "7478b6eb-85e3-3b27-aeac-b486bab0cb1f",
                        "glosses": [
                            "A tractor crawler, a motorized vehicle that uses caterpillar tracks instead of wheels."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3adf8ef6-8b7a-3daf-bfab-db5d0e79bce1",
                        "entry_id": "7478b6eb-85e3-3b27-aeac-b486bab0cb1f",
                        "glosses": [
                            "A software bot that autonomously follows connected paths such as links between web pages."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "2fad46f4-bdc0-4ada-9314-d73b79725776",
                                "sense_id": "3adf8ef6-8b7a-3daf-bfab-db5d0e79bce1",
                                "text": "Crawler-based search engines have three major elements. The first is the spider, also called the crawler, which visits a web page, reads it, and then follows links to other pages within the site."
                            },
                            {
                                "example_id": "4c35ac3c-c36e-4faf-b093-4f66a9e5e947",
                                "sense_id": "3adf8ef6-8b7a-3daf-bfab-db5d0e79bce1",
                                "text": "These serve as an algorithmic way to judge the “mobileness” of a site, and similar algorithms are likely to be used by the search crawlers."
                            }
                        ]
                    },
                    {
                        "sense_id": "4786bc01-971d-34e0-8ca1-f89e4e1f6ec1",
                        "entry_id": "7478b6eb-85e3-3b27-aeac-b486bab0cb1f",
                        "glosses": [
                            "A mobile stage in the development of stationary hemipteran insects such as scale insects—generally the first instar."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4fa7a13a-a34e-3d5c-a77e-1acaef1fa5ba",
                        "entry_id": "7478b6eb-85e3-3b27-aeac-b486bab0cb1f",
                        "glosses": [
                            "A cab that is driven slowly along while its driver looks out for a fare."
