            {
                "entry_id": "1e250e5e-da04-3bcf-a959-34679c23242e",
                "word": "fluidité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "adf8b934-82b7-4a13-8967-e6805ef9b1f7",
                        "entry_id": "1e250e5e-da04-3bcf-a959-34679c23242e",
                        "tags": [
                            "plural"
                        ],
                        "form": "fluidités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "87fedecc-3959-32a5-80a5-d73fe2a5fe01",
                        "entry_id": "1e250e5e-da04-3bcf-a959-34679c23242e",
                        "glosses": [
                            "Qualité de ce qui est fluide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a59c5c1-5e39-4d43-b1ee-75874e0400a1",
                                "sense_id": "87fedecc-3959-32a5-80a5-d73fe2a5fe01",
                                "text": "La fluidité de l’eau, de l’air."
                            },
                            {
                                "example_id": "541d1c1a-1206-442d-b2ea-14b4c00c46f2",
                                "sense_id": "87fedecc-3959-32a5-80a5-d73fe2a5fe01",
                                "text": "La fluidité du sang, des humeurs."
                            },
                            {
                                "example_id": "0d5c5702-71d9-4336-93e8-b058179e74c1",
                                "sense_id": "87fedecc-3959-32a5-80a5-d73fe2a5fe01",
                                "text": "Les impressionnistes érigeront en théorie cette fluidité de la lumière et cette instabilité de la sensation optique."
                            },
                            {
                                "example_id": "6688ca73-5ae9-4be6-88b3-7c5e2feb6cbb",
                                "sense_id": "87fedecc-3959-32a5-80a5-d73fe2a5fe01",
                                "text": "Cette nouvelle route à deux voies aura des sorties prévues pour la 150e Rue et la 175e Rue. Il en résultera, pour les usagers, une sécurité accrue et une plus grande fluidité de la circulation sur le territoire de la ville, plus particulièrement à l'intersection des routes 173 et 204."
                            },
                            {
                                "example_id": "d181595d-78a3-4b24-8ac0-c63879318fd8",
                                "sense_id": "87fedecc-3959-32a5-80a5-d73fe2a5fe01",
                                "text": "On peut ainsi très bien utiliser les traitements de fluidité à leur maximum pour regarder du tennis ou du football mais les désactiver sur les films pour conserver un effet cinéma à l'écran, ou encore n'en conserver que quelques uns sur les jeux vidéos, pour éviter de réagir trop lentement lors des actions rapides."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21661c8d-6c06-4c38-8ee3-3e7d45f3661a",
                        "source_entry_id": "1e250e5e-da04-3bcf-a959-34679c23242e",
                        "source_sense_id": "87fedecc-3959-32a5-80a5-d73fe2a5fe01",
                        "target_lang_word": "fluidity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fluidity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "722db4c8-667d-3d3c-9619-44c0fd041804",
                                        "entry_id": "10fcd13a-64f9-30e7-aac9-d7d4ee474f71",
                                        "glosses": [
                                            "The state of being fluid rather than viscous"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e86e4495-531d-3810-9d2a-937303f9918b",
                                        "entry_id": "10fcd13a-64f9-30e7-aac9-d7d4ee474f71",
                                        "glosses": [
                                            "A measure of the extent to which something is fluid. The reciprocal of its viscosity."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95f5c774-d053-3980-b302-956e8217911b",
                                        "entry_id": "10fcd13a-64f9-30e7-aac9-d7d4ee474f71",
                                        "glosses": [
                                            "The quality of being fluid or free-flowing"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b165c842-d117-47a3-a0f7-64f67fb6a8a0",
                                                "sense_id": "95f5c774-d053-3980-b302-956e8217911b",
                                                "text": "In addition to all this, the fluidity of the steam itself was much increased by high superheat, usually achieved by means of the Houlet superheater."
                                            },
                                            {
                                                "example_id": "670d2c43-9de7-437d-b780-f1980d9e17d7",
                                                "sense_id": "95f5c774-d053-3980-b302-956e8217911b",
                                                "text": "Either side of Rooney's fluffed chance, it was a tale of Ukrainian domination as they attacked England down both flanks and showed the greater fluidity of the teams."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
