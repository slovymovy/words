                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4f915d2-6de9-42c8-9108-7acc7e0bfd67",
                                                "sense_id": "96af953e-6f6d-31d9-b520-68f2301bd2ed",
                                                "text": "В это время, со свистом рассекая воздух, пронёсся тяжёлый гарпун, брошенный уверенной рукой кормчего, и впился в толстый живот акулы."
                                            }
                                        ]
                                    }
                                ]
