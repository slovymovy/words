                "translations": [
                    {
                        "translation_id": "6558147e-61ed-48cb-b31e-cef350b36b1a",
                        "source_entry_id": "40065970-4492-38b9-a911-be5bfc66f4a1",
                        "source_sense_id": "096dcd3b-e77e-3497-ae3d-f083986c3f87",
                        "target_lang_word": "apprêter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apprêter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d12a034b-5025-3782-a14d-72b83ee203c8",
                                        "entry_id": "94e7e7d6-e95f-3236-9a97-9bfdfc5afa8b",
                                        "glosses": [
                                            "Préparer ; mettre en état."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df1f9054-e980-4d3a-ac88-56f169cfd700",
                                                "sense_id": "d12a034b-5025-3782-a14d-72b83ee203c8",
                                                "text": "La Belle se levait à quatre heures du matin, et se dépêchait de nettoyer la maison et d’apprêter à dîner pour la famille."
                                            },
                                            {
                                                "example_id": "8ed0ba12-9430-4a9e-a854-b44d4b27c944",
                                                "sense_id": "d12a034b-5025-3782-a14d-72b83ee203c8",
                                                "text": "Mais, ô malheur! le vent saute au sud-ouest et nous enveloppe d'un brouillard épais. Il ne pouvait rien survenir de plus vexatoire au moment où nous apprêtions nos lorgnettes pour jouir de la première apparition de cette Islande inconnue."
                                            },
                                            {
                                                "example_id": "eaf2b029-4f72-42d1-ab36-866b8e609b43",
                                                "sense_id": "d12a034b-5025-3782-a14d-72b83ee203c8",
                                                "text": "Apprêtez tout ce qu’il faut pour mon voyage."
                                            },
                                            {
                                                "example_id": "ce926fc1-f8f3-40ee-91d5-e3c120dd3bdc",
                                                "sense_id": "d12a034b-5025-3782-a14d-72b83ee203c8",
                                                "text": "Ce cuisinier apprête bien à manger, il assaisonne bien les mets."
                                            },
                                            {
                                                "example_id": "af3c9abb-dc46-4955-ad99-65ee2eda5a95",
                                                "sense_id": "d12a034b-5025-3782-a14d-72b83ee203c8",
                                                "text": "Le dîner s’acheva non sans grâce quand la jeune fille en tablier blanc, mince et droite, apporta le plat d’œufs à la neige qu’elle avait apprêté."
                                            },
                                            {
                                                "example_id": "5fd6103e-dd91-4fa6-a957-650bf4ec9418",
                                                "sense_id": "d12a034b-5025-3782-a14d-72b83ee203c8",
                                                "text": "J’admirais beaucoup mon oncle, le capitaine, tant parce qu’il avait brûlé la dernière cartouche française à Waterloo que parce qu’il apprêtait de ses propres mains, à la table de ma mère, des chapons à l’ail, qu’il mettait ensuite dans la salade de chicorée."
                                            },
                                            {
                                                "example_id": "31506fd2-4810-4899-b06b-39e1488f432e",
                                                "sense_id": "d12a034b-5025-3782-a14d-72b83ee203c8",
                                                "text": "Le visage d’Anne Desbaresdes manquait du soin qu’elle mettait d’habitude à l’apprêter avant de le montrer."
                                            },
                                            {
                                                "example_id": "3e38d605-b401-4200-88b0-dc413fac86d4",
                                                "sense_id": "d12a034b-5025-3782-a14d-72b83ee203c8",
                                                "text": "Apprêter des cartes, les arranger de façon à tromper le jeu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99582c4f-a39b-31b3-ae1e-d62e4c014d12",
                                        "entry_id": "94e7e7d6-e95f-3236-9a97-9bfdfc5afa8b",
                                        "glosses": [
                                            "Soumettre à un apprêt."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e1f41c7-24ff-481a-b533-e2b6a9a1e3ba",
                                                "sense_id": "99582c4f-a39b-31b3-ae1e-d62e4c014d12",
                                                "text": "Un peintre qui apprête des couleurs. Un corroyeur qui apprête des cuirs."
                                            },
                                            {
                                                "example_id": "7bf511ee-2ce4-41d1-9955-ca85e36d37c1",
                                                "sense_id": "99582c4f-a39b-31b3-ae1e-d62e4c014d12",
                                                "text": "Un chapelier qui apprête un chapeau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b95b870b-34ee-32d8-8aea-96bdded92a36",
                                        "entry_id": "94e7e7d6-e95f-3236-9a97-9bfdfc5afa8b",
                                        "glosses": [
                                            "Se préparer, se mettre en état."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2343d11a-6a47-4142-b15c-b6e8513a74ed",
                                                "sense_id": "b95b870b-34ee-32d8-8aea-96bdded92a36",
                                                "text": "Il s’apprête à partir."
                                            },
                                            {
                                                "example_id": "06ec2e1c-9f0c-4795-9db0-750db1c50019",
                                                "sense_id": "b95b870b-34ee-32d8-8aea-96bdded92a36",
                                                "text": "Je m’apprête à allumer la lampe. Je frotte une allumette. Elle ne prend pas, le phosphore s’écaille, elle se casse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6df735b1-2236-4be9-8b03-8b1d5d1acd53",
                        "source_entry_id": "40065970-4492-38b9-a911-be5bfc66f4a1",
                        "source_sense_id": "096dcd3b-e77e-3497-ae3d-f083986c3f87",
                        "target_lang_word": "encoller",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encoller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04f2d8f2-ee6a-33a4-8681-40b4b1779ece",
                                        "entry_id": "a7288a24-9e0d-3299-a894-1fbe2eeaf019",
                                        "glosses": [
                                            "Enduire d’un apprêt fait de colle, de gomme, ou de quelque autre matière semblable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "653dcc26-8317-4798-9dac-348c4188f94b",
                                                "sense_id": "04f2d8f2-ee6a-33a4-8681-40b4b1779ece",
                                                "text": "Encoller des moulures, des sculptures, avant de les dorer."
                                            },
                                            {
                                                "example_id": "1d3f0c7b-08cf-48e8-a23c-77bbc6402908",
                                                "sense_id": "04f2d8f2-ee6a-33a4-8681-40b4b1779ece",
                                                "text": "Encoller une toile sur laquelle on veut peindre."
                                            },
                                            {
                                                "example_id": "a9c17b3c-6ec7-48f6-8005-bd68150a2f1f",
                                                "sense_id": "04f2d8f2-ee6a-33a4-8681-40b4b1779ece",
                                                "text": "Encoller le dos d’un livre."
                                            },
                                            {
                                                "example_id": "f8b0309e-1060-48ac-a0dc-93c536cd7650",
                                                "sense_id": "04f2d8f2-ee6a-33a4-8681-40b4b1779ece",
                                                "text": "Sa tignasse brune, encollée de sueur, ses yeux brillants sous les longs cils, et son teint sombre, la font ressembler à une jeune bohémienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
