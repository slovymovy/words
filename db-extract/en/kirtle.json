                                        "sense_id": "53d90bc8-cf8d-3f2c-b73a-01af9929f363",
                                        "entry_id": "f2592721-cfcf-301b-863e-54f8fc844d69",
                                        "glosses": [
                                            "römisches Kleidungsstück, das unmittelbar auf dem Körper getragen wurde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ab87510-bf0e-44f4-9246-7d78ee0dfbf5",
                                                "sense_id": "53d90bc8-cf8d-3f2c-b73a-01af9929f363",
                                                "text": "Die Tunika bestand ursprünglich, wie der griechische Chiton, aus zwei rechteckigen Stoffstücken, von denen das hintere etwas länger war als das vordere, und wurde nur auf den Schultern mit Hilfe von Fibeln zusammengehalten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6204ca90-d9a3-34bd-81a0-4ca6eae60b43",
                                        "entry_id": "f2592721-cfcf-301b-863e-54f8fc844d69",
                                        "glosses": [
                                            "kurzer Damenrock, der in der Taille über dem Rock angenäht ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3acb78ee-b4fd-4026-988a-8dbb6170bf21",
                                                "sense_id": "6204ca90-d9a3-34bd-81a0-4ca6eae60b43",
                                                "text": "„Ihre Brille saß etwas weiter vorne auf der Nase, und sie trug eine luftige blaue Tunika.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88c1f682-7c20-4081-a2bd-5ac6d574d8c5",
                        "source_entry_id": "49c04dbb-84ab-3796-86eb-7255359ede2b",
                        "source_sense_description": "knee-length tunic",
                        "target_lang_word": "Rock",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c39a5e2e-aa27-33a5-8a24-8ac301236cd8",
                                        "entry_id": "bfc57de4-2821-37ab-a0fb-89e73461c677",
                                        "glosses": [
                                            "unten offenes Kleidungsstück, das den Unterleib und (wenigstens teilweise) die Beine bedeckt (meist für Frauen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1ac7db4-dc58-4ecb-831d-92c167dd17af",
                                                "sense_id": "c39a5e2e-aa27-33a5-8a24-8ac301236cd8",
                                                "text": "Wo sie Sechsundsechzig spielten / Mädchen unter Röcke schielten (Franz Josef Degenhardt)"
                                            },
                                            {
                                                "example_id": "486dbb8d-3add-4aec-935f-5764f38d3553",
                                                "sense_id": "c39a5e2e-aa27-33a5-8a24-8ac301236cd8",
                                                "text": "„Zitternd vor Kälte schlüpfte Nikki in einen schwarzen Rock, einen khakifarbenen Pullover und in ihre Wildlederstiefel.“"
                                            },
                                            {
                                                "example_id": "2ad46c18-24aa-43c2-a2e8-ef813481569e",
                                                "sense_id": "c39a5e2e-aa27-33a5-8a24-8ac301236cd8",
                                                "text": "„Sie nahm sich einen Stuhl, setzte sich, schlug die Beine übereinander, und ihr Rock rutschte hoch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "28c5acd4-8bf9-3d5e-9339-6957ffc7abb8",
                                        "entry_id": "bfc57de4-2821-37ab-a0fb-89e73461c677",
                                        "glosses": [
                                            "langes Jackett"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb83271c-56b5-4d98-aea1-4a58e24ffe91",
                                                "sense_id": "28c5acd4-8bf9-3d5e-9339-6957ffc7abb8",
                                                "text": "„Bei unserem Ausmarsche machte der Himmel zur Abwechslung ein recht freundliches Gesicht, weshalb wir uns in leichten Röcken und Strohhüten ohne Regenschirme auf den Weg begaben.“"
                                            },
                                            {
                                                "example_id": "d3b978c0-f2f0-46c3-b452-32f524d22732",
                                                "sense_id": "28c5acd4-8bf9-3d5e-9339-6957ffc7abb8",
                                                "text": "Er hatte Hut, Rock und Spazierstock in der Halle abgelegt."
                                            },
                                            {
                                                "example_id": "d8f9863f-1674-4e1a-a835-5b15d41264c4",
                                                "sense_id": "28c5acd4-8bf9-3d5e-9339-6957ffc7abb8",
                                                "text": "„Berg zog einen sehr sauberen Uniformrock an, auf dem nicht das kleinste Fleckchen oder Stäubchen zu entdecken war, strich sich vor dem Spiegel die Schläfenhaare nach oben, so wie der Kaiser Alexander Pawlowitsch sie trug, und verliess mit einem angenehmen Lächeln das Zimmer, nachdem er an dem Blick, den Rostow auf seinen Rock warf, festgestellt hatte, dass dieser Rock die nötige Beachtung gefunden hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Rock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cced6fee-60b9-34a9-bf9f-b82536113132",
                                        "entry_id": "62799e16-a36f-30ec-98c2-f895abce41a8",
                                        "glosses": [
                                            "populäre Musikrichtung, die Anfang der 1950er Jahre in den USA entstand"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26aa8602-c757-46e4-af78-05cc3c115173",
                                                "sense_id": "cced6fee-60b9-34a9-bf9f-b82536113132",
                                                "text": "Der Rock ist nicht totzukriegen."
                                            },
                                            {
                                                "example_id": "e6300a89-99c1-4087-b58c-60e76c86daee",
                                                "sense_id": "cced6fee-60b9-34a9-bf9f-b82536113132",
                                                "text": "„Filme und TV-Serien, Rock, Rap und Dancepop, die kreative Zitierkultur des Internets (Mashups, Meme und Co.) werden nicht für eine edle Elite, sondern für eine demokratische Massengesellschaft geschaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Rock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62baf6c2-24df-34c6-9e7f-6856354ba2a3",
                                        "entry_id": "99b396d4-3775-3adb-a990-17e4ba4dc8ec",
                                        "glosses": [
                                            "in arabischen Märchen: flugfähiger Vogel in der Größe eines Elefanten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92529bf0-e75e-44dc-ba90-2ceb0c7bf030",
                                                "sense_id": "62baf6c2-24df-34c6-9e7f-6856354ba2a3",
                                                "text": "Sindbad band sich, um seinem Schicksal auf einer abgelegenen Insel zu entkommen, an ein Bein des Vogels Rock."
                                            },
                                            {
                                                "example_id": "864250f0-130c-4f73-bf6c-1d05af0cfe48",
                                                "sense_id": "62baf6c2-24df-34c6-9e7f-6856354ba2a3",
                                                "text": "„Er erinnerte fich. daß ihm die Schiffer fchon längft vom Riefenvogel Rock erzählt hatten. der fo groß und ftark wäre. daß er einen Elefanten mit fich zu tragen imftande wäre.“ ()"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
