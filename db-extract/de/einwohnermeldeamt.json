                "senses": [
                    {
                        "sense_id": "a5489495-48fa-3a4d-b369-aca257aa14b5",
                        "entry_id": "89a0224a-7b3a-3e18-b06e-afa38e4b7faa",
                        "glosses": [
                            "Behörde bei einer Kommune, bei der man seinen Wohnsitz angeben soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9164c8dd-3924-47b0-89e2-ae20e062c58e",
                                "sense_id": "a5489495-48fa-3a4d-b369-aca257aa14b5",
                                "text": "Nach einem Umzug soll man zum Einwohnermeldeamt gehen und seinen neuen Wohnsitz anmelden."
                            },
                            {
                                "example_id": "d3167a6b-55f9-4fe2-8ea4-7aae31bd47e2",
                                "sense_id": "a5489495-48fa-3a4d-b369-aca257aa14b5",
                                "text": "„Selbst, als bekannt wurde, dass das Einwohnermeldeamt gewisse Privatdaten ganz legal an Firmen auf Anfrage herausgeben darf, dauerte es Monate, bis sich nennenswerter Protest regte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
