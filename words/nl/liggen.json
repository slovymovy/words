                                "es": "Mis llaves todavía <w>están</w> en la mesa de la cocina."
                            }
                        },
                        {
                            "text": "Amsterdam <w>ligt</w> in het westen van Nederland.",
                            "target_lang_translations": {
                                "ru": "Амстердам <w>находится</w> на западе Нидерландов.",
                                "en": "Amsterdam <w>lies</w> in the west of the Netherlands.",
                                "pl": "Amsterdam <w>leży</w> na zachodzie Holandii.",
                                "de": "Amsterdam <w>liegt</w> im Westen der Niederlande.",
                                "fr": "Amsterdam <w>se trouve</w> dans l'ouest des Pays-Bas.",
                                "it": "Amsterdam si <w>trova</w> nell'ovest dei Paesi Bassi.",
                                "cs": "Amsterdam <w>leží</w> na západě Nizozemska.",
                                "tr": "Amsterdam, Hollanda'nın batısında <w>yer alır</w>.",
                                "es": "Ámsterdam <w>está situada</w> en el oeste de los Países Bajos."
                            }
