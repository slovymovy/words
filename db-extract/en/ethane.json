                    {
                        "sense_id": "3cbdc3ea-385f-3795-b408-d1633a147621",
                        "entry_id": "62d58c67-a146-32ab-94fb-4a79a7de3a3e",
                        "glosses": [
                            "Ethan, C₆H₁₂"
