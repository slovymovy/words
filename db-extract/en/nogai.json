                                        "glosses": [
                                            "Membre d’un peuple de Transcaucasie, de Crimée et du cours inférieur du Dniepr."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81ae6567-771b-4ae2-8bc2-eb3168bbdcbe",
                                                "sense_id": "c1135fba-0035-3c8f-9cdd-009ba46673e8",
                                                "text": "Ayez donc appris […] que les diverses populations nomades des gouvernements de la Transcaucasie se décomposent ainsi par familles : Kalmouks, descendants des Éleuthes, quinze mille ; Kirghizes, d’origine musulmane, huit mille ; Tartares de Koundrof, onze cents ; Tartares de Sartof, cent douze ; Nogaïs, huit mille cinq cents ; Turkomans, près de quatre mille !"
                                            }
                                        ]
                                    }
                                ]
                            }
