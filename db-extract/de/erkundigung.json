                    {
                        "form_id": "a1915ad4-f196-4282-a31a-322a21c7e787",
                        "entry_id": "e892fc56-6ebc-3a8b-ad39-22e9ab465218",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Erkundigungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "25e608c1-c245-3dca-bd66-27dd7e4c2b81",
                        "entry_id": "e892fc56-6ebc-3a8b-ad39-22e9ab465218",
                        "glosses": [
                            "Nachforschung, Nachfrage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d2ec44c-4731-46d7-89ab-789dcbf6d342",
                                "sense_id": "25e608c1-c245-3dca-bd66-27dd7e4c2b81",
                                "text": "„Ich würde meinem Leser meine eignen Angelegenheiten nicht vortragen, hätten nicht viele Bürger meiner Stadt über meine Lebensart sehr eingehende Erkundigungen eingezogen, Erkundigungen, die manche aufdringlich nennen werden.“"
                            },
                            {
                                "example_id": "9160dc9e-abe4-453f-bc87-ceeebd4bde42",
                                "sense_id": "25e608c1-c245-3dca-bd66-27dd7e4c2b81",
                                "text": "„Sie empfindet seine Erkundigung als ungehörig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "569026bf-3af6-410e-a8cb-22bccaf786c7",
                        "source_entry_id": "e892fc56-6ebc-3a8b-ad39-22e9ab465218",
                        "source_sense_id": "25e608c1-c245-3dca-bd66-27dd7e4c2b81",
                        "source_sense_description": "Nachforschung, Nachfrage",
                        "target_lang_word": "information",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "information",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16a416b3-ade7-32c5-91e7-14ec86b8c014",
                                        "entry_id": "cfb52e29-aad0-3d8a-a3d8-baf6d8e6e51a",
                                        "glosses": [
                                            "Action d’informer autrui ou de s’informer soi-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bdc6e2b-e0e5-4e4c-9e8f-2eb876174d49",
                                                "sense_id": "16a416b3-ade7-32c5-91e7-14ec86b8c014",
                                                "text": "Il s'agit d'un système d’information transnational de crues mis en place dans les bassins de la Moselle, de la Nahe et, pour partie, de celui du Rhin (environ 55 000 km2)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60919920-c077-3834-98a7-4f4664cc9eb9",
                                        "entry_id": "cfb52e29-aad0-3d8a-a3d8-baf6d8e6e51a",
                                        "glosses": [
                                            "pluriel Ensemble de faits que l'on cherche à connaître ou dont on obtient la connaissance pour répondre à une interrogation."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2886f1c-48cb-4e97-bcc3-60d79a647569",
                                                "sense_id": "60919920-c077-3834-98a7-4f4664cc9eb9",
                                                "text": "[…], Mme Mirondeau avait commencé à s’émouvoir de cette absence prolongée ; ayant interrogé la route, et ne voyant rien venir, elle s’impatienta, et, inquiète, jetant un fichu sur ses épaules, partit aux informations."
                                            },
                                            {
                                                "example_id": "5be418ab-721a-4b88-8785-f1959c5906c1",
                                                "sense_id": "60919920-c077-3834-98a7-4f4664cc9eb9",
                                                "text": "Prendre des informations."
                                            },
                                            {
                                                "example_id": "74c75b78-ab9e-4915-aa6b-58a3a1f55e8d",
                                                "sense_id": "60919920-c077-3834-98a7-4f4664cc9eb9",
                                                "text": "Quand il fallut en venir aux informations."
                                            },
                                            {
                                                "example_id": "a1635329-7203-4504-a4a2-40291868b59d",
                                                "sense_id": "60919920-c077-3834-98a7-4f4664cc9eb9",
                                                "text": "Les informations que j’ai prises sur sa conduite ne sont pas fort satisfaisantes."
                                            },
                                            {
                                                "example_id": "5c39a3ca-2517-4e7b-be72-fac8487ef511",
                                                "sense_id": "60919920-c077-3834-98a7-4f4664cc9eb9",
                                                "text": "Service des informations dans un journal."
                                            },
                                            {
                                                "example_id": "c0dee2ea-07b6-47ca-94ea-c382712de2eb",
                                                "sense_id": "60919920-c077-3834-98a7-4f4664cc9eb9",
                                                "text": "Et à travers l’analyse de la presse, elle restitue les évolutions de l’opinion publique française qui, de manière constante, s’est dispensée de faire de la dette une priorité. Comment expliquer ce déni de la dette ? Selon Laure Quenouelle-Corre, “Tant qu’on n’est pas en face de la crise on a du mal à en percevoir les conséquences. Et puis il est possible que le déni de la dette, la mauvaise information, ait été entretenu par les pouvoirs publics. Les attentes de l’opinion publique sont aussi forgées par les politiques qui sont menées”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ac8f375-51b4-3f9e-beaf-4f6431a3e59c",
                                        "entry_id": "cfb52e29-aad0-3d8a-a3d8-baf6d8e6e51a",
                                        "glosses": [
                                            "Élément de connaissance contenu sur un support."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4132ed7-1dc3-4bf9-be30-d3a8b99e868e",
                                                "sense_id": "4ac8f375-51b4-3f9e-beaf-4f6431a3e59c",
                                                "text": "Ainsi, en dépit du fait que le logogramme chinois est souvent peu informatif quant à sa prononciation, l’information phonologique contenue dans l’écriture est exploitée pour prononcer les caractères rares."
                                            },
                                            {
                                                "example_id": "e86dc34b-d238-4da2-b001-6e200898babf",
                                                "sense_id": "4ac8f375-51b4-3f9e-beaf-4f6431a3e59c",
                                                "text": "Il faut lire les informations, sinon tu ne t’en sortira jamais avec l’installation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efc6078b-0c6f-3ec7-aacf-df8f7ba116d5",
                                        "entry_id": "cfb52e29-aad0-3d8a-a3d8-baf6d8e6e51a",
                                        "glosses": [
                                            "pluriel Journal télévisé ou journal radiodiffusé."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60eef144-4b3b-42c7-97cd-2c51e3368738",
                                                "sense_id": "efc6078b-0c6f-3ec7-aacf-df8f7ba116d5",
                                                "text": "Je l’ai entendu aux informations, hier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94ad7249-b693-31f4-a18a-215e50c59f2d",
                                        "entry_id": "cfb52e29-aad0-3d8a-a3d8-baf6d8e6e51a",
                                        "glosses": [
                                            "Concept capable d'être imaginé par l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a63cb597-2631-4068-8c65-19ed44555d23",
                                                "sense_id": "94ad7249-b693-31f4-a18a-215e50c59f2d",
                                                "text": "La meilleure situation dans la solution de problèmes est d’être capable d’utiliser une approche tout à fait vierge au problème, même si votre esprit est gorgé d'informations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50fbc417-d24b-3971-b4c5-6b466dadfb5e",
                                        "entry_id": "cfb52e29-aad0-3d8a-a3d8-baf6d8e6e51a",
                                        "glosses": [
                                            "Enquête faite, en matière criminelle, par les officiers de police, à l’occasion d’un crime, d’un délit. Il se dit aussi de l’ensemble de la procédure faite par le juge d’instruction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7a83fb4-9aa4-4cbe-8272-f5aa68081100",
                                                "sense_id": "50fbc417-d24b-3971-b4c5-6b466dadfb5e",
                                                "text": "Vous reprendrez votre nom de famille, parce qu’il est honnête, et qu’on fera tôt ou tard des informations dans votre province."
                                            },
                                            {
                                                "example_id": "28f06da7-4d92-47b8-ae19-5fa461b122db",
                                                "sense_id": "50fbc417-d24b-3971-b4c5-6b466dadfb5e",
                                                "text": "Procéder à une information judiciaire."
                                            },
                                            {
                                                "example_id": "b84ff504-a621-42fc-bdff-8f775c42a974",
                                                "sense_id": "50fbc417-d24b-3971-b4c5-6b466dadfb5e",
                                                "text": "Informations secrètes."
                                            },
                                            {
                                                "example_id": "d13c260a-87fc-40c9-b95a-67aa0278ce3e",
                                                "sense_id": "50fbc417-d24b-3971-b4c5-6b466dadfb5e",
                                                "text": "Dans les informations, toutes les ratures et surcharges doivent être approuvées."
                                            },
                                            {
                                                "example_id": "05c8a776-44a7-4dfe-a46a-dbfba35ae447",
                                                "sense_id": "50fbc417-d24b-3971-b4c5-6b466dadfb5e",
                                                "text": "information de commodo et incommodo, enquête administrative qui se fait pour connaître les avantages et les inconvénients de quelque mesure projetée, d’un établissement, etc."
                                            },
                                            {
                                                "example_id": "1240f570-b7ee-45fd-b1a6-7ee9add9e8b2",
                                                "sense_id": "50fbc417-d24b-3971-b4c5-6b466dadfb5e",
                                                "text": "C’est bon, j’ai toutes les informations qu’il me faut pour travailler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4b5ae51-d9bd-386e-a18d-670a218e6740",
                                        "entry_id": "cfb52e29-aad0-3d8a-a3d8-baf6d8e6e51a",
                                        "glosses": [
                                            "Moyen pour un individu de connaître son environnement, fait d'être informé, et forme intellectuelle que prend cette connaissance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfc00c60-8953-4814-8374-9927da824c9d",
                                                "sense_id": "a4b5ae51-d9bd-386e-a18d-670a218e6740",
                                                "text": "Sur le plan étymologique, le mot « information » (du latin informatio) signifie « action de façonner l'esprit »; selon le Littré : « Terme de philosophie. Action d'informer, de donner une forme. » On comprendra que l'information est donc le socle d'une personnalité bien formée. Celui ou celle qui porte l'information porte donc une responsabilité qui le dépasse."
                                            },
                                            {
                                                "example_id": "3a11be79-0e09-4130-9ebe-de9519238b75",
                                                "sense_id": "a4b5ae51-d9bd-386e-a18d-670a218e6740",
                                                "text": "Cette génération, née avec un smartphone dans les mains, entretient une relation avec l’information qui diffère de celles de ses parents ou même de ses grands-parents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e63abf2c-0133-33e2-9cf6-bb099c5e1cdb",
                                        "entry_id": "cfb52e29-aad0-3d8a-a3d8-baf6d8e6e51a",
                                        "glosses": [
                                            "Ensemble de connaissances réunies sur un sujet déterminé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0f842cc-dab8-4281-84e4-989615d3decb",
                                                "sense_id": "e63abf2c-0133-33e2-9cf6-bb099c5e1cdb",
                                                "text": "L'usage voulait, pour certaines correspondances véhiculant des informations confidentielles, que l'on cryptât celles-ci en recourant à des lettres ou à des chiffres qui s'apparentaient à des signes cabalistiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71b0ba6c-72ee-3540-baa2-e6b1d1d04d47",
                                        "entry_id": "cfb52e29-aad0-3d8a-a3d8-baf6d8e6e51a",
                                        "glosses": [
                                            "Toute connaissance, en tant qu’elle est stockée sur un support informatique."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ababa82-972a-44b0-b22c-cc12524ff4d6",
                                                "sense_id": "71b0ba6c-72ee-3540-baa2-e6b1d1d04d47",
                                                "text": "Un gigabit est une unité de mesure de quantité d’information numérique, valant 10⁹ bits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebeed0af-136b-3129-a978-7460ed2236a4",
                                        "entry_id": "cfb52e29-aad0-3d8a-a3d8-baf6d8e6e51a",
                                        "glosses": [
                                            "Source de connaissance sur un sujet donné, susceptible d’être représentée afin d’être conservée, traitée, communiquée"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a9c82ae-1939-420d-9f46-f5d93c7e020d",
                                                "sense_id": "ebeed0af-136b-3129-a978-7460ed2236a4",
                                                "text": "Le pourghère étant une plante dont l’utilisation énergétique est récente (en 1990 au Mali), les informations agronomiques et socio-économiques restent encore insuffisantes."
                                            },
                                            {
                                                "example_id": "847f5375-6a6f-4022-b25e-d5966a840dff",
                                                "sense_id": "ebeed0af-136b-3129-a978-7460ed2236a4",
                                                "text": "De nombreuses informations disponibles sur Internet ne sont pas sourcées. C’est ainsi que des informations fausses peuvent être dupliquées d’un site à l’autre, ce qui leur procure une forme de légitimité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d5d2dd2-4499-3bd3-92e9-8fae17eabe9d",
                                        "entry_id": "cfb52e29-aad0-3d8a-a3d8-baf6d8e6e51a",
                                        "glosses": [
                                            "Signification que l’être humain attribue à des données."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "518fd2f4-4122-4fec-8406-27eb9d26adee",
                        "source_entry_id": "e892fc56-6ebc-3a8b-ad39-22e9ab465218",
                        "source_sense_id": "25e608c1-c245-3dca-bd66-27dd7e4c2b81",
                        "source_sense_description": "Nachforschung, Nachfrage",
                        "target_lang_word": "renseignement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renseignement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4665882-cf5f-35b8-94aa-8dc7252221d1",
                                        "entry_id": "4b9d218a-ad9d-3e07-bcb1-1df969e36178",
                                        "glosses": [
                                            "Action de se renseigner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0589edfc-b96f-4afc-81fc-bbe0a7543d83",
                                                "sense_id": "f4665882-cf5f-35b8-94aa-8dc7252221d1",
                                                "text": "Si certains se targuèrent alors de rendre la chose plus « transparente » donc soi-disant plus saine, cela revenait tout de même à leur permettre de faire du renseignement législatif voire d'influencer nos élus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59482fe4-8c2b-3fff-9350-dfb7542aa27f",
                                        "entry_id": "4b9d218a-ad9d-3e07-bcb1-1df969e36178",
                                        "glosses": [
                                            "Indice qui nous aide à connaître certaines choses ou qui nous éclaire sur une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39dd6fa0-614d-4180-9a0e-d5041773b801",
                                                "sense_id": "59482fe4-8c2b-3fff-9350-dfb7542aa27f",
                                                "text": "Bien souvent d’ailleurs et très obligeamment, Bonati fils […] me procura d’intéressants renseignements sur la flore hygrophile de la vallée moyenne."
                                            },
                                            {
                                                "example_id": "4ebbc1a5-818c-4e4a-b39d-df3201af4247",
                                                "sense_id": "59482fe4-8c2b-3fff-9350-dfb7542aa27f",
                                                "text": "D'autre part, les renseignements recueillis sur la ménagère établissaient qu'elle radotait assez souvent et n'était pas capable, pour peu qu'on insistât, d'affirmer deux fois les mêmes choses."
                                            },
                                            {
                                                "example_id": "df075075-daea-4c30-a0f6-3dc7fa755acc",
                                                "sense_id": "59482fe4-8c2b-3fff-9350-dfb7542aa27f",
                                                "text": "Les réponses étaient variées, parfois malaimables et parfois sympathiques, mais, en résumé, elle n'avait jamais obtenu le moindre renseignement exploitable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ccfcd40-822c-328e-8f90-1d6f6b1229c2",
                                        "entry_id": "4b9d218a-ad9d-3e07-bcb1-1df969e36178",
                                        "glosses": [
                                            "Organe gouvernemental relié à la sécurité nationale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12460e9c-1f7e-4fad-998d-1aab03edfed9",
                                                "sense_id": "1ccfcd40-822c-328e-8f90-1d6f6b1229c2",
                                                "text": "\"Nous sommes parvenus à la conclusion que le prince héritier d'Arabie saoudite Mohammed ben Salmane a validé une opération à Istanbul, en Turquie, pour capturer ou tuer le journaliste saoudien Jamal Khashoggi\", écrit la direction du renseignement national dans un court rapport de quatre pages, déclassifié à la demande du président Joe Biden, alors que son prédécesseur Donald Trump l'avait gardé secret."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
