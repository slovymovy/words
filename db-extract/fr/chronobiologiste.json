                                "target_senses": [
                                    {
                                        "sense_id": "084f211c-b1bd-37b1-b287-c8da1cceb381",
                                        "entry_id": "60e488bd-9a28-31aa-ad82-912abc5ed76e",
                                        "glosses": [
                                            "A person who is involved in chronobiology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae6e3a80-e133-4b1c-89c8-7d84f1ae96a2",
                                                "sense_id": "084f211c-b1bd-37b1-b287-c8da1cceb381",
                                                "text": "This has been known for centuries, but it was only twenty years ago that the site of the biological clock (or, as chronobiologists usually call it, our circadian pacemaker) was identified."
                                            },
                                            {
                                                "example_id": "f275b2b0-9bb2-412f-bcd0-17e712b7d6a5",
                                                "sense_id": "084f211c-b1bd-37b1-b287-c8da1cceb381",
                                                "text": "In the view of chronobiologists, individual biological rhythms are always regulated in a similar manner."
                                            },
                                            {
                                                "example_id": "c6e45bfb-1859-4576-a5e2-75ab618f4373",
                                                "sense_id": "084f211c-b1bd-37b1-b287-c8da1cceb381",
                                                "text": "A chronobiologist studies the cycles in human organisms and what is communicated by these cycles.[…]A medical chronobiologist studies life cycles in an effort to improve diagnostic and treatment procedures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
