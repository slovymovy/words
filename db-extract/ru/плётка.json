                                        "sense_id": "f1b4e584-f9ed-3f62-baa9-2ef10e54bc74",
                                        "entry_id": "601b1186-c115-39b2-93da-b1e2ff19f470",
                                        "glosses": [
                                            "Used in phrasal verbs: lash back, lash out."
