        "fr-extract.jsonl": [
            {
                "entry_id": "4e61963b-e643-3540-a424-54d9bab4e14f",
                "word": "ogresse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ed834841-029c-4145-9c17-c02750e3e358",
                        "entry_id": "4e61963b-e643-3540-a424-54d9bab4e14f",
                        "tags": [
                            "plural"
                        ],
                        "form": "ogresses"
                    },
                    {
                        "form_id": "a52682d3-2ff4-4c5d-891e-49dd820c437e",
                        "entry_id": "4e61963b-e643-3540-a424-54d9bab4e14f",
                        "tags": [
                            "masculine"
                        ],
                        "form": "ogre"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "058895af-0b38-33bd-9320-0f20b2853eac",
                        "entry_id": "4e61963b-e643-3540-a424-54d9bab4e14f",
                        "glosses": [
                            "Ogre femelle."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "245b1051-4c94-489b-9a21-5e5931a1b0b6",
                                "sense_id": "058895af-0b38-33bd-9320-0f20b2853eac",
                                "text": "Ces petites Ogresses avoient toutes le tein fort beau"
                            },
                            {
                                "example_id": "d7d07573-2386-4323-bfed-c7ea55652832",
                                "sense_id": "058895af-0b38-33bd-9320-0f20b2853eac",
                                "text": "— Eh ! bien, colonel, nous causerons de tout cela sérieusement, dit Sylvie en lui jetant un regard qu’elle crut plein d’amour et qui ressemblait assez à celui d’une ogresse."
                            }
                        ]
                    },
                    {
                        "sense_id": "fea98918-80c5-33f1-81fc-12d6f6147c93",
                        "entry_id": "4e61963b-e643-3540-a424-54d9bab4e14f",
                        "glosses": [
                            "Femme avide de jeunes gens."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4260da30-4f30-4d58-aa68-97f4b5784e61",
                                "sense_id": "fea98918-80c5-33f1-81fc-12d6f6147c93",
                                "text": "— Oui, dis-je, mais selon Simon, elle le mange des yeux pendant que lui mange son « quatre-heures ». Peut-être qu’un jour ça ne lui suffira plus…\n— Qu’est-ce que tu veux insinuer ? Mais qui t’a appris…\n— C’est vrai, dit à mi-voix le Doyen, qu’il y a des ogresses…"
                            }
                        ]
                    },
                    {
                        "sense_id": "f81c3098-d127-33d8-85f2-f37a1f1b14bc",
                        "entry_id": "4e61963b-e643-3540-a424-54d9bab4e14f",
                        "glosses": [
                            "Femme qui louait aux prostituées tout ou partie de leur toilette."
                        ],
                        "tags": [
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d8c7af7f-09af-42e6-832d-2d114ddf3248",
                                "sense_id": "f81c3098-d127-33d8-85f2-f37a1f1b14bc",
                                "text": "Les filles publiques nomment ainsi les revendeuses qui leur louent la pièce qui manque à leur toilette, au besoin même la toilette tout entière ; elles ne pouvaient vraiment choisir un nom plus caractéristique, et qui exprimât mieux l’idée qu’elles voulaient rendre ; rien, en effet, ne peut être comparé aux ogresses …."
                            }
                        ]
                    },
                    {
                        "sense_id": "80ab24e2-6bb5-3fcc-8ce1-64b1ec572a18",
                        "entry_id": "4e61963b-e643-3540-a424-54d9bab4e14f",
                        "glosses": [
                            "Tenancière de tapis-franc ou de maison close ; femme proxénète, maquerelle."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "36460cb2-7b18-4063-bf5d-d9ebaa38b7a7",
                                "sense_id": "80ab24e2-6bb5-3fcc-8ce1-64b1ec572a18",
                                "text": "Les dispensés, les vieilles bêtes, les ogresses du trottoir et les femmes du monde sur le retour contemplent d’un œil béat ce spectacle nauséabond. Le départ de la classe fait baver d’aise les catins et les bistros."
                            },
                            {
                                "example_id": "d842e085-b7c6-4350-ad0e-692d0d7267d9",
                                "sense_id": "80ab24e2-6bb5-3fcc-8ce1-64b1ec572a18",
                                "text": "Un repris de justice, qui, dans cette langue immonde, s’appelle un ogre, ou une femme de même dégradation, qui s’appelle une ogresse, tiennent ordinairement ces tavernes, hantées par le rebut de la population parisienne ; forçats libérés, escrocs, voleurs, assassins y abondent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b1fb13b-cbd9-4724-ac8c-f3f5bb3c3f6d",
                        "source_entry_id": "4e61963b-e643-3540-a424-54d9bab4e14f",
                        "source_sense_description": "ogre femelle",
                        "target_lang_word": "Menschenfresserin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a53af459-957e-46ff-a1b0-bdd02e368fa0",
                        "source_entry_id": "4e61963b-e643-3540-a424-54d9bab4e14f",
                        "source_sense_description": "ogre femelle",
                        "target_lang_word": "ogress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ogress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dd9fc90-a132-3c6d-83cb-47c0afcfe502",
                                        "entry_id": "4c5e8d95-789a-3b47-ae22-b98e0cf3b6bc",
                                        "glosses": [
                                            "A female ogre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f72ec15f-fb62-4c68-a1a1-47c2d7712e0d",
                                                "sense_id": "0dd9fc90-a132-3c6d-83cb-47c0afcfe502",
                                                "text": "And in the seventh tale of the third day of the same collection, when Corvetto had hidden himself under the Ogre's bed to steal his quilt, \"he began to pull quite gently, when the Ogre awoke, and bid his wife not to pull the clothes that way, or she'd strip him, and he would get his death of cold.\" \"Why, it's you that are stripping me,\" replied the Ogress, \"and you have not left a stitch on me.\" \"Where the devil is the quilt?\" says the Ogre[.]"
                                            },
                                            {
                                                "example_id": "2511c416-0265-45c9-b9a6-076cc4ed9dd1",
                                                "sense_id": "0dd9fc90-a132-3c6d-83cb-47c0afcfe502",
                                                "text": "Dear me, Mimsey!. . . you are perfectly outrageous! Do you think I'm an ogress ready to eat her up? On the contrary, I mean to be a friend to her."
                                            },
                                            {
                                                "example_id": "10bf92a5-e0e8-4a06-a3cf-e223dd2df49a",
                                                "sense_id": "0dd9fc90-a132-3c6d-83cb-47c0afcfe502",
                                                "text": "This ogress too was begotten of the blood of Cain, whose brood had been doomed forever to the icy floods and freezing waters of the earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f95f470-8544-39ac-ad7e-78ea1f5ff05d",
                                        "entry_id": "4c5e8d95-789a-3b47-ae22-b98e0cf3b6bc",
                                        "glosses": [
                                            "A fierce, unfriendly woman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4003c38-e510-4fca-a3d1-0752ae130ae6",
                                                "sense_id": "6f95f470-8544-39ac-ad7e-78ea1f5ff05d",
                                                "text": "I remember being the fall guy for the family, having to take the rent down to the ogress of a landlady so that my parents wouldn't have to face her."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ogress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffcd1f77-fb6b-3b8b-a041-dfe8d6d7ccdd",
                                        "entry_id": "6b47c917-0ab2-36f5-b3ef-0c13db5997a2",
                                        "glosses": [
                                            "A roundel sable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2fa473b-fd0d-4f42-b495-55f636551e4d",
                                                "sense_id": "ffcd1f77-fb6b-3b8b-a041-dfe8d6d7ccdd",
                                                "text": "Beareth Verte, fiue Fermaulxz in Crosse D'Or, a Border d'Argent, charged with eight Ogresses: or, after the French blazon, 'Ogressée de huit pieces'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
