                ],
                "senses": [
                    {
                        "sense_id": "46a5fca1-4bdb-3709-b377-32d2679ef9ab",
                        "entry_id": "c30f47f5-ca3c-3135-a5aa-b17bc333acb5",
                        "glosses": [
                            "Meinung, die jemand zu einem Thema hat"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "dee1ddb3-0b31-4d9b-bfd7-07c7c247dc83",
                                "sense_id": "46a5fca1-4bdb-3709-b377-32d2679ef9ab",
                                "text": "„Also ist’s, meines Bedünkens, mit Brauch und Unflat, und daß die fromme Sitte uns schmecke, bleibe das Unterste nur hübsch zuunterst.“"
                            },
                            {
                                "example_id": "4b036586-bd8c-447e-b799-9df7f6c189e6",
                                "sense_id": "46a5fca1-4bdb-3709-b377-32d2679ef9ab",
                                "text": "„Dieser Große Ägyptens war ein edler und würdiger Mann von zarter Seele und gütig nach Josephs Bedünken; denn daß er es darauf anlegte, die Leute um ihn zittern zu lassen, mußte man seiner Verfassung als Opfer geistlicher Unbelehrtheit zugutehalten: Das Recht auf einige Bosheit, fand Joseph, war ihm wohl zuzubilligen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
