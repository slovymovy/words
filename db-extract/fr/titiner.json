                        ],
                        "examples": [
                            {
                                "example_id": "60f3f0b6-e1bf-4f0a-9ef4-b1e88f24cd7a",
                                "sense_id": "4eb415eb-2c9d-3a6d-8519-fdf615c011de",
                                "text": "Les ornithologues nomment « chants » l’ensemble des sons vocaux émis par les oiseaux en vue de communiquer, qu’ils roucoulent comme la colombe ou la tourterelle, piaulent comme l’albatros, tirelient ^([sic : tirelirent]) comme l’alouette, croassent, coucoulent, gloussent, jasent, titinent, zinzibulent, jabotent, pépient, sifflent, gazouillent, caracoulent, piaillent, jacassent, picassent, peupleutent, cacabent, ou caquettent !"
                            }
                        ]
                    }
