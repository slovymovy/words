                "senses": [
                    {
                        "sense_id": "bc2a4aef-9d31-3eee-b64a-a2e255462e90",
                        "entry_id": "941f0fe2-d5ad-3b69-844c-b77b764a0156",
                        "glosses": [
                            "Ort, an dem ein Rummel/ein Volksfest stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43ede755-4a54-4955-a088-85a6d39c6c2e",
                                "sense_id": "bc2a4aef-9d31-3eee-b64a-a2e255462e90",
                                "text": "„Hildegard war mit der Tante Wojtaszak befreundet, die auf dem Rummelplatz neben der Grube »Königin Luise« eine Schießbude besaß.“"
                            },
                            {
                                "example_id": "8ee306b4-d636-4a34-909d-1ef8c25ccc65",
                                "sense_id": "bc2a4aef-9d31-3eee-b64a-a2e255462e90",
                                "text": "„Er nennt den höchsten Gipfel der Erde einen banalen Berg, den Gipfel des Selbstbetrugs, Müllberg, Todeszone für Adrenalin-Freaks, Rummelplatz für Touristen, die überall schon gewesen sind.“"
                            },
                            {
                                "example_id": "4b229383-9dd5-47b4-b5dd-bbfe3ca219fc",
                                "sense_id": "bc2a4aef-9d31-3eee-b64a-a2e255462e90",
                                "text": "„Auf dem Weg in die Mitte des Rummelplatzes drängte sich ein junger Mann an mir vorbei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
