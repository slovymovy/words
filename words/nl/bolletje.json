            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6fdfb558-6ece-3ea3-aad4-52456841e8ae",
                    "sense_definition": "Een klein, rond en zacht broodje.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor de lunch eet ik meestal een <w>bolletje</w> met jonge kaas.",
                            "target_lang_translations": {
                                "en": "For lunch, I usually eat a <w>roll</w> with young cheese."
                            }
                        },
                        {
                            "text": "Hij kocht bij de bakker zes verse witte <w>bolletjes</w>.",
                            "target_lang_translations": {
                                "en": "He bought six fresh white <w>rolls</w> at the bakery."
                            }
                        }
                    ],
                    "synonyms": [
                        "kadet",
                        "kadetje"
                    ],
                    "common_phrases": [
                        "bolletje met kaas",
                        "witte bolletjes"
                    ],
                    "target_lang_definitions": {
                        "en": "A small, round, soft bread roll."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "roll",
                                "target_lang_sense_clarification": "small round bread"
                            },
                            {
                                "target_lang_word": "bread roll",
                                "target_lang_sense_clarification": "round soft bun"
                            },
                            {
                                "target_lang_word": "bun",
                                "target_lang_sense_clarification": "small round bread"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ffdfbc7-814a-30f1-9903-857df8f65d74",
                    "sense_definition": "Verkleinwoord van <w>bol</w>; een klein bolvormig voorwerp, zoals een schepje ijs of een kluwen wol.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mag ik alsjeblieft één <w>bolletje</w> aardbeienijs in een hoorntje?",
                            "target_lang_translations": {
                                "en": "May I please have one <w>scoop</w> of strawberry ice cream in a cone?"
                            }
                        },
                        {
                            "text": "De poes speelt graag met een klein <w>bolletje</w> wol.",
                            "target_lang_translations": {
                                "en": "The kitten likes to play with a small <w>ball</w> of wool."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bolletje ijs",
                        "bolletje wol"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verkleinwoord van bol"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Diminutive of 'bol'; a small spherical object, such as a scoop of ice cream or a ball of yarn."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scoop",
                                "target_lang_sense_clarification": "of ice cream"
                            },
                            {
                                "target_lang_word": "ball",
                                "target_lang_sense_clarification": "small spherical object, e.g. of wool"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a766c170-6829-3778-844a-4ce90f5f0856",
                    "sense_definition": "Een klein, ingepakt pakketje met verdovende middelen dat ingeslikt wordt om drugs te smokkelen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "smokkel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De douane op het vliegveld ontdekte tientallen <w>bolletjes</w> in zijn maag.",
                            "target_lang_translations": {
                                "en": "Customs at the airport discovered dozens of <w>pellets</w> in his stomach."
                            }
                        },
                        {
                            "text": "Het smokkelen van een <w>bolletje</w> brengt enorme gezondheidsrisico's met zich mee.",
                            "target_lang_translations": {
                                "en": "Smuggling a <w>drug pellet</w> involves enormous health risks."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bolletjes slikken"
                    ],
                    "target_lang_definitions": {
                        "en": "A small, wrapped packet of narcotics swallowed in order to smuggle drugs."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drug pellet",
                                "target_lang_sense_clarification": "swallowed package of narcotics"
                            },
                            {
                                "target_lang_word": "pellet",
                                "target_lang_sense_clarification": "small packet of smuggled drugs"
                            }
                        ]
                    }
                }
            ]
        }
    ]
