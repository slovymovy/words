{
    "word_family": [
        "solitary",
        "solitarily",
        "solitariness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03f2e843-b3f1-31c3-a08a-4e44132feaa9",
                    "sense_definition": "The state of being alone or away from other people, often by choice and for peaceful reasons.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state of being alone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long week of working in a busy office, she really enjoyed the <w>solitude</w> of her garden.",
                            "target_lang_translations": {
                                "ru": "После долгой недели работы в шумном офисе она по-настоящему наслаждалась <w>уединением</w> в своем саду."
                            }
                        },
                        {
                            "text": "The writer decided to seek <w>solitude</w> in the mountains to finish his new novel without any distractions.",
                            "target_lang_translations": {
                                "ru": "Писатель решил поискать <w>уединения</w> в горах, чтобы закончить свой новый роман, ни на что не отвлекаясь."
                            }
                        }
                    ],
                    "synonyms": [
                        "aloneness",
                        "seclusion",
                        "isolation",
                        "solitariness"
                    ],
                    "antonyms": [
                        "togetherness",
                        "closeness",
                        "intimacy"
                    ],
                    "common_phrases": [
                        "seek solitude",
                        "peaceful solitude",
                        "quiet solitude",
                        "enjoy solitude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние пребывания в одиночестве, часто по собственному желанию и ради спокойствия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уединение",
                                "target_lang_sense_clarification": "спокойное пребывание в одиночестве"
                            },
                            {
                                "target_lang_word": "одиночество",
                                "target_lang_sense_clarification": "состояние, когда человек один"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50003449-47aa-338d-b34e-0608070fbfd8",
                    "sense_definition": "A lonely, remote, or uninhabited place where one can be alone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lonely place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorer traveled across the vast <w>solitudes</w> of the Arctic tundra for several months.",
                            "target_lang_translations": {
                                "ru": "Исследователь несколько месяцев путешествовал по бескрайним <w>пустынным просторам</w> арктической тундры."
                            }
                        },
                        {
                            "text": "They built a small cabin in a distant <w>solitude</w> far away from the nearest village.",
                            "target_lang_translations": {
                                "ru": "Они построили небольшую хижину в дальнем <w>уединенном месте</w>, далеко от ближайшей деревни."
                            }
                        }
                    ],
                    "synonyms": [
                        "back of beyond",
                        "hermitage",
                        "seclusion"
                    ],
                    "common_phrases": [
                        "distant solitude",
                        "vast solitude",
                        "remote solitude"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одинокое, отдаленное или необитаемое место, где можно побыть одному."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уединенное место",
                                "target_lang_sense_clarification": "место вдали от людей"
                            },
                            {
                                "target_lang_word": "пустынные места",
                                "target_lang_sense_clarification": "необитаемые пространства"
                            },
                            {
                                "target_lang_word": "глушь",
                                "target_lang_sense_clarification": "отдаленное, тихое место"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}