                                        "sense_id": "812f9b55-e538-3c3f-b71a-f88c0d386242",
                                        "entry_id": "ee0865e6-9052-3fde-9e5a-2ad594dcc7b7",
                                        "glosses": [
                                            "iemand die de processen die zich afspelen in sterren en meer in het algemeen de processen die in het heelal waarneembaar zijn probeert te verklaren met natuurkundige wetten"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f696a3d-92f9-4d94-bd29-e9d3130986d6",
                                                "sense_id": "812f9b55-e538-3c3f-b71a-f88c0d386242",
                                                "text": "\"Zoiets als dit, waarbij de maan heel langzaam door de aardschaduw heengaat en precies door het midden, dat gebeurt maar eens in enkele tientallen jaren\", zegt astrofysicus Vincent Icke van het Anton Pannekoek Instituut in Amsterdam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8961eb87-556b-469e-bae2-3285e0186200",
                        "source_entry_id": "be9db5f6-097b-3fad-b675-22d9f70825e4",
                        "source_sense_id": "9a9ec56a-5900-3745-94b4-2e6f83f2f872",
                        "source_sense_description": "one who studies astrophysics",
                        "target_lang_word": "astrophysicien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astrophysicien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62eb25ff-a4e7-361b-b6c7-3f4bb557c5a7",
                                        "entry_id": "aab231cd-5fb9-3fc0-9da7-6e93c7831a9f",
                                        "glosses": [
                                            "Scientifique qui étudie l’astrophysique, l’étude de l’espace et des propriétés des objets de l’univers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdc8e8d6-9ebf-4eb7-b41e-1522195cf9c6",
                                                "sense_id": "62eb25ff-a4e7-361b-b6c7-3f4bb557c5a7",
                                                "text": "En effet, l’astrophysicien québécois Hubert Reeves fait partie des personnalités du monde scientifique que les ésotéristes ont kidnappées dans leurs rangs sans les consulter et, dans le cas précis d’Hubert Reeves, sans qu’il n’y ait aucun fondement à sa prétendue adhésion au monde de l’ésotérisme."
                                            },
                                            {
                                                "example_id": "c20926a1-89aa-423f-854c-abb7a95cd7c0",
                                                "sense_id": "62eb25ff-a4e7-361b-b6c7-3f4bb557c5a7",
                                                "text": "En 1995, Michel Mayor et Didier Queloz, deux astrophysiciens suisses, présentent au monde Bellérophon, nom officiel « 51 Pegasi b »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3db4ffdc-f164-446b-8cdf-cd42aaee40ea",
                        "source_entry_id": "be9db5f6-097b-3fad-b675-22d9f70825e4",
                        "source_sense_id": "9a9ec56a-5900-3745-94b4-2e6f83f2f872",
                        "source_sense_description": "one who studies astrophysics",
                        "target_lang_word": "astrophysicienne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astrophysicienne",
