                ],
                "senses": [
                    {
                        "sense_id": "90b25e49-6e19-3751-8d48-2c358e8592bc",
                        "entry_id": "d4c3fdaf-d92f-3b6f-8f55-677549238f91",
                        "glosses": [
                            "kleines Kissen aus Baumwolle oder auch Kunststoff, das mit pflegenden Stoffen getränkt ist und auf die geschlossenen Augen gelegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd7fa2a9-b40b-4e16-ab47-6fb866c7edac",
                                "sense_id": "90b25e49-6e19-3751-8d48-2c358e8592bc",
                                "text": "„Augenpatches lassen sich in ihren Wirkungen unterscheiden. Es gibt rückfettende, straffende, hydratisierende, abschwellende und reichhaltige Patches.“"
                            },
                            {
                                "example_id": "58ccb4cd-5825-43d8-9d2f-362ecac220b1",
                                "sense_id": "90b25e49-6e19-3751-8d48-2c358e8592bc",
                                "text": "„Jeder trägt sie, jeder schwört auf sie. Augenpatches wirken wahre Wunder bei müden Augen.“"
                            },
                            {
                                "example_id": "59531d8a-3cff-4eab-8395-8fccfadd7ff9",
                                "sense_id": "90b25e49-6e19-3751-8d48-2c358e8592bc",
                                "text": "„24K Gold Augenpatch für die empfindliche Haut unter den Augen. Trägt dazu bei, feine Linien, Falten und Krähenfüsse zu reduzieren.“"
                            },
                            {
                                "example_id": "97ce9d90-ca4a-4589-8f24-81d57e70ae95",
                                "sense_id": "90b25e49-6e19-3751-8d48-2c358e8592bc",
                                "text": "„Augenpatches zur halbmondförmigen Applikation unterhalb des Augenlids hergestellt und in einer Anwendungsstudie getestet.“"
                            },
                            {
                                "example_id": "85e106ab-4d57-482f-afb0-ceaa791a7516",
                                "sense_id": "90b25e49-6e19-3751-8d48-2c358e8592bc",
                                "text": "„Verwende den Augenpatch 2-3 Mal pro Woche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
