                    }
                ],
                "senses": [
                    {
                        "sense_id": "68552703-6825-33e9-b5a3-8622dd70d2e9",
                        "entry_id": "007be6f8-15da-3b29-a3e2-6946ca68472a",
                        "glosses": [
                            "Alternative spelling of Egyptologist."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "f13b4b50-f52e-491c-97a7-36a6346ddfe3",
                                "sense_id": "68552703-6825-33e9-b5a3-8622dd70d2e9",
                                "text": "The famous egyptologist, Prof. G. Maspero, is now having the third work of his Egyptian trilogy translated from the French by M. L. McClure"
                            },
                            {
                                "example_id": "a84f4da6-fab8-45f7-80ba-b8ababcaa720",
                                "sense_id": "68552703-6825-33e9-b5a3-8622dd70d2e9",
                                "text": "A. Rita Freed, an egyptologist at Memphis State University in Tennessee and the person who put the extra \"es\" in Ramesses for the Boston exhibition,"
                            },
                            {
                                "example_id": "bb94f3f9-57ae-4382-8d3e-6e7cb918fda7",
                                "sense_id": "68552703-6825-33e9-b5a3-8622dd70d2e9",
                                "text": ".. beautiful in the ancient burial ground of the Valley of the Queens and has been closed since its discovery by Italian egyptologist Ernesto Schiaparelli."
                            },
                            {
                                "example_id": "70f454d7-d642-444c-beec-fcb46171a3ca",
                                "sense_id": "68552703-6825-33e9-b5a3-8622dd70d2e9",
                                "text": "In 1924, Howard Carter, British egyptologist, found the sarcophagus of Tutankhamun in the Valley of the Kings near Luxor."
                            },
                            {
                                "example_id": "880b937b-ac90-4d43-896e-a678b117e5df",
                                "sense_id": "68552703-6825-33e9-b5a3-8622dd70d2e9",
                                "text": "The egyptologists believe that she is one of three mummies discovered in a secret chamber of a tomb in Egypt's Valley of the Kings in Luxor."
                            },
                            {
                                "example_id": "838e58a9-855c-4a2a-acff-cb63e6c24347",
                                "sense_id": "68552703-6825-33e9-b5a3-8622dd70d2e9",
                                "text": "According to Italian egyptologist Professor Sergio Donadoni the theories that have long surrounded Tutankhamen's death have always been produced by \"picturesque legends without any scientific basis\"."
                            },
                            {
                                "example_id": "ae748e90-6987-4a95-a709-5652051b5e96",
                                "sense_id": "68552703-6825-33e9-b5a3-8622dd70d2e9",
                                "text": "The first tomb discovered in Luxor's Valley of the Kings did not reveal its expected mummy, but egyptologists remained bent on cracking the mystery of \"KV 63.\""
                            },
                            {
                                "example_id": "0a559149-be3d-4d9a-8417-c9817e0d6f64",
                                "sense_id": "68552703-6825-33e9-b5a3-8622dd70d2e9",
                                "text": "Biomedical egyptologist Jacky Finch of the University of Manchester, UK, who is studying ancient Egyptian big toes, made of wood and leather"
                            },
                            {
                                "example_id": "ee80aacb-4584-4818-8464-1016fdac92e6",
                                "sense_id": "68552703-6825-33e9-b5a3-8622dd70d2e9",
                                "text": "According to egyptologist Christiane Zivie-Coche writing in the exhibition catalogue, the aim of Les Portes du ciel is to provide visitors with ...."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
