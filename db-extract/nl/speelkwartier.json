                                                "sense_id": "4bde920f-179a-3633-ba26-b7423e32ecd4",
                                                "text": "In der großen Pause lungern die meisten auf dem Hof herum."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b0a013ba-8f3f-3c1b-a0bc-0391ce4993a8",
                                        "entry_id": "9bfb74f9-8010-392a-af35-fe83d5de68fa",
                                        "glosses": [
                                            "kurze durch den Rhythmus des jeweiligen Musikstückes geprägte Unterbrechung der Musik"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
