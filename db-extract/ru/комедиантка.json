                        "form": "комедиа́нтке"
                    },
                    {
                        "form_id": "078d0562-2e76-4598-8c71-8ae680e757e7",
                        "entry_id": "304c0e8c-9746-3767-a13e-fae7492fe755",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "комедиа́нтках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2f417a82-5d3d-32ee-addb-76d81c560ad6",
                        "entry_id": "304c0e8c-9746-3767-a13e-fae7492fe755",
                        "glosses": [
                            "истор. в средневековой Европе — артистка бродячей труппы, исполнительница ролей в балаганных представлениях"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "00530ceb-212e-3d8b-b173-6e97e1356fe5",
                        "entry_id": "304c0e8c-9746-3767-a13e-fae7492fe755",
                        "glosses": [
                            "устар. то же что актриса"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "452aa58e-1041-4d8d-b183-1d2c62fc5b6d",
                                "sense_id": "00530ceb-212e-3d8b-b173-6e97e1356fe5",
                                "text": "И искусная комедиантка, всхлипывая, опустилась на колени перед великим герцогом."
                            }
                        ]
                    },
                    {
                        "sense_id": "5169e4e8-74da-3260-91a9-49775007ae88",
                        "entry_id": "304c0e8c-9746-3767-a13e-fae7492fe755",
                        "glosses": [
                            "перен. женщина, лицемерно разыгрывающая какую-нибудь роль, притворщица"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1501176e-f257-4fa3-844a-e74d01ee4fe7",
                                "sense_id": "5169e4e8-74da-3260-91a9-49775007ae88",
                                "text": "Удар был такой силы, что Олег Васильевич как будто качнулся и припал спиной к косяку двери, чтобы стоять прочней. Старуха, разумеется, комедиантка. Зачем ей это нужно?"
                            },
                            {
                                "example_id": "b7f7f001-9811-4bbd-a02c-cf4dc655ed4c",
                                "sense_id": "5169e4e8-74da-3260-91a9-49775007ae88",
                                "text": "Нет! она вся - ложь, она комедиантка, она позерка - она хочет, чтобы все ее обожали как красавицу и благоговели перед нею, как перед святою!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b86f9e45-d1ed-4210-8bd0-17e408c7890a",
                        "source_entry_id": "304c0e8c-9746-3767-a13e-fae7492fe755",
                        "source_sense_description": "~ бродячая артистка",
                        "target_lang_word": "comedian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comedian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16fb684d-c7e8-3b5e-b821-83c482b0013c",
                                        "entry_id": "41f3d3ae-4d65-3856-9336-5ae564725acf",
                                        "glosses": [
                                            "An entertainer who performs in a humorous manner, especially by telling jokes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42928892-85da-3a78-adfe-1cf5f01fdb7a",
                                        "entry_id": "41f3d3ae-4d65-3856-9336-5ae564725acf",
                                        "glosses": [
                                            "Any person who is humorous or amusing, either characteristically or on a particular occasion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8dc532c-fcf9-3d4f-8c39-cea6ad456cfe",
                                        "entry_id": "41f3d3ae-4d65-3856-9336-5ae564725acf",
                                        "glosses": [
                                            "A person who performs in theatrical plays."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5c90027-bade-4e2d-a51e-56630a7268c1",
                                                "sense_id": "c8dc532c-fcf9-3d4f-8c39-cea6ad456cfe",
                                                "text": "[…] the quick comedians\nExtemporally will stage us, and present\nOur Alexandrian revels;"
                                            },
                                            {
                                                "example_id": "0ac4201d-cbc1-42e7-a5a5-49be9ea6cfaa",
                                                "sense_id": "c8dc532c-fcf9-3d4f-8c39-cea6ad456cfe",
                                                "text": "1714, Susanna Centlivre, The Wonder, London: E. Curll and A. Bettesworth, Preface,\nI Don’t pretend to write a Preface, either to point out the Beauties, or to excuse the Errors, a judicious Reader may possibly discover in the following Scenes, but to give those excellent Comedians their Due, to whom, in some Measure the best Dramatick Writers are oblig’d."
                                            },
                                            {
                                                "example_id": "2d42fd73-6812-4fa0-8d31-4ed95dd4afda",
                                                "sense_id": "c8dc532c-fcf9-3d4f-8c39-cea6ad456cfe",
                                                "text": "When a Comedian, celebrated for his excellence in the part of Shylock, first undertook that character, he made daily visits to the center of business, the ’Change, and the adjacent Coffee-houses; that by a frequent intercourse and conversation with “the unforeskinn’d race,” he might habituate himself to their air and deportment."
                                            },
                                            {
                                                "example_id": "6f7fad39-43f0-45bf-98c2-ddfe4e968179",
                                                "sense_id": "c8dc532c-fcf9-3d4f-8c39-cea6ad456cfe",
                                                "text": "Becky, the nightingale, took the flowers which he threw to her and pressed them to her heart with the air of a consummate comedian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62b48c7b-6421-3bb0-98e3-6a25a1c62904",
                                        "entry_id": "41f3d3ae-4d65-3856-9336-5ae564725acf",
                                        "glosses": [
                                            "A writer of comedies."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d8a01d3-a63c-4a66-99c0-19b69f773126",
                                                "sense_id": "62b48c7b-6421-3bb0-98e3-6a25a1c62904",
                                                "text": "This doth the Comedy handle ſo in our priuate and domeſtical matters, as with hearing it, we get as it were an experience, what is to be looked for of a nigardly Demea: of a crafty Danus: of a flattering Gnato: of a vaine glorious Thraſo: and not onely to know what effects are to be expected, but to know who be ſuch, by the ſignifying badge giuen them by the Comedian."
                                            },
                                            {
                                                "example_id": "8225d852-27c0-477a-8fef-2b751b71ddba",
                                                "sense_id": "62b48c7b-6421-3bb0-98e3-6a25a1c62904",
                                                "text": "Neither is it recorded that the writings of those old Comedians were supprest, though the acting of them were forbid;"
                                            },
                                            {
                                                "example_id": "6bfc70eb-e262-4146-9829-2f1b248789ee",
                                                "sense_id": "62b48c7b-6421-3bb0-98e3-6a25a1c62904",
                                                "text": "1783, Hugh Blair, Lectures on Rhetoric and Belles Lettres, London: Whitestone et al., Volume 3, Lecture 47, p. 377,\n[…] the Dramatic Author, in whom the French glory most, and whom they justly place at the head of all their Comedians, is, the famous Moliere."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5737993-31e9-4c16-b3ab-6a1838f9c67c",
                        "source_entry_id": "304c0e8c-9746-3767-a13e-fae7492fe755",
                        "source_sense_description": "~ бродячая артистка",
                        "target_lang_word": "actress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                                        "entry_id": "00b17417-dd4d-3008-aaa8-0049e4b2270e",
                                        "glosses": [
                                            "A female who performs on the stage or in films."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a42363-81f1-4b8b-8ff9-879895a29601",
                                                "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                                                "text": "A while ago somewhere I don't know when / I was watchin' a movie with a friend / I fell in love with the actress / She was playin' a part that I could understand"
                                            },
                                            {
                                                "example_id": "9236a94e-d062-4f08-96f9-69f3c7b8f0f3",
                                                "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                                                "text": "\"I'm an actress -- actor, as we have to say these days.\""
                                            },
                                            {
                                                "example_id": "60c2368a-30ec-481c-a2a7-3b35351dec9c",
                                                "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                                                "text": "Court documents appear to show that Ian Edmondson, a senior News of the World journalist, had authorised Mr Mulcaire to hack phones belonging to Sienna Miller, an actress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23be3a93-71a9-3dd6-ae13-2fc3af4534b9",
                                        "entry_id": "00b17417-dd4d-3008-aaa8-0049e4b2270e",
                                        "glosses": [
                                            "A female doer or \\\"actor\\\" (in a general sense)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2d5f912-3c4c-474c-a16a-8248b2bdadab",
                                                "sense_id": "23be3a93-71a9-3dd6-ae13-2fc3af4534b9",
                                                "text": "My mental anguish, and the dreadful scenes in which I had been an actress, advanced the period of my labour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14255976-0da5-41ea-870f-b948d362d95c",
                        "source_entry_id": "304c0e8c-9746-3767-a13e-fae7492fe755",
                        "source_sense_description": "~ актриса",
