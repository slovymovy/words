                    {
                        "sense_id": "091bedb5-c00b-3045-888b-ff9ef0587d97",
                        "entry_id": "da50741f-d7e4-3e78-a0e6-8bbc68ceea2c",
                        "glosses": [
                            "eine weibliche Person, die Windeln wechselt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "593b52fd-2ce3-40ec-92a5-3f2820f5ec74",
                                "sense_id": "091bedb5-c00b-3045-888b-ff9ef0587d97",
                                "text": "„Ich will nicht nur die ‚Milchbar‘, die Windelwechslerin, die Mutti sein.“"
                            },
                            {
                                "example_id": "3cdf5240-fa90-4260-b766-c6f1ac218e75",
                                "sense_id": "091bedb5-c00b-3045-888b-ff9ef0587d97",
                                "text": "„Frau Friedan, mit Ihrem Buch ‚Der Weiblichkeitswahn‘ haben Sie vor 30 Jahren das dröge Dasein der Vorort-Hausfrau enthüllt, die ihr Leben als Puddingköchin und Windelwechslerin verschwendet.“"
                            },
                            {
                                "example_id": "2a83cafe-9c01-46d5-911f-d731e5d9128c",
                                "sense_id": "091bedb5-c00b-3045-888b-ff9ef0587d97",
                                "text": "„Sie sei bei drei Geburten dabei gewesen und ‹erprobte Windelwechslerin, Fläschchengeberin und Gutenachtgeschichten-Erzählerin›.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
