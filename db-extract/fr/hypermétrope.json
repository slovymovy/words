                    {
                        "translation_id": "699c9d5c-c923-45ad-ba2d-4824abc592bf",
                        "source_entry_id": "318fe00b-8427-3181-8c77-136202a962c5",
                        "source_sense_id": "1c91f3c7-07ce-30a8-b2c7-44f0addc85ef",
                        "source_sense_description": "voir presbyte",
                        "target_lang_word": "дальнозоркий",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дальнозоркий",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f4266e06-e76f-362e-86d5-e311f69fc833",
                                        "entry_id": "59e8d7ba-325b-3280-acf6-d0b158ffed1e",
                                        "glosses": [
                                            "обладающий острым зрением, способный хорошо видеть отдалённые предметы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fea57e8-6355-420c-9ad7-eb74f71cae2e",
                                                "sense_id": "f4266e06-e76f-362e-86d5-e311f69fc833",
                                                "text": "Разговаривая таким образом, они шли по дороге к Марьиной роще, и когда вышли в поле, то княгиня, которая была очень дальнозорка, начала внимательно глядеть на ехавшую им навстречу пролетку с дамой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab86b93e-2185-3e89-9943-a260d67c1846",
                                        "entry_id": "59e8d7ba-325b-3280-acf6-d0b158ffed1e",
                                        "glosses": [
                                            "перен. способный предвидеть последствия чего-либо; дальновидный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f6883fb-2414-4473-80ca-67ca9e5fa07d",
                                                "sense_id": "ab86b93e-2185-3e89-9943-a260d67c1846",
                                                "text": "В качестве государственного правителя, он не мог быть дальнозорким, понимал только ближайшие обстоятельства и пользоваться ими мог только для ближайших и преимущественно своекорыстных целей."
                                            },
                                            {
                                                "example_id": "62be1770-e99e-4645-8b2b-b5f0ac23e774",
                                                "sense_id": "ab86b93e-2185-3e89-9943-a260d67c1846",
                                                "text": "Как верно предугадал будущее дальнозоркий Тургенев — в этом Пушкин ежедневно все более и более убеждался и в то же время не мог преодолеть в себе тайного сочувствия к несчастному «стаду баранов», преследуемому нашим войском."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "271e9c3b-da42-3b16-9b9f-ecf8d9a84c82",
                                        "entry_id": "59e8d7ba-325b-3280-acf6-d0b158ffed1e",
                                        "glosses": [
                                            "мед. видящий отдалённые предметы яснее, чётче, чем близлежащие; плохо видящий на близком расстоянии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec600f79-94f8-47a8-8289-0366bd9c2dbc",
                                                "sense_id": "271e9c3b-da42-3b16-9b9f-ecf8d9a84c82",
                                                "text": "Генерал неторопливо отставил табличку на вытянутой руке ― он был немного дальнозорок."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
