                                            {
                                                "example_id": "00666da6-7079-42ef-a1ab-8ecc91c355cb",
                                                "sense_id": "3a9556df-f135-3d7b-a2c9-e045b77d64fb",
                                                "text": "Сейчас жанровое многообразие огромное, появляется множество подстилей, ответвлений и ручейков."
                                            }
                                        ]
                                    },
                                    {
