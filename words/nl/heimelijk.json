                    "frequency": "Middle",
                    "semantic_group_id": "geheimhouding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een <w>heimelijke</w> glimlach verraadde zijn intenties, maar niemand keek.",
                            "target_lang_translations": {
                                "en": "A <w>furtive</w> smile betrayed his intentions, but no one looked."
                            }
                        },
                        {
                            "text": "Zij wierp hem een <w>heimelijke</w> blik toe tijdens de vergadering.",
                            "target_lang_translations": {
                                "en": "She shot him a <w>secret</w> glance during the meeting."
                            }
                        }
                    ],
                    "synonyms": [
