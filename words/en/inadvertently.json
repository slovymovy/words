{
    "word_family": [
        "inadvertent",
        "inadvertence"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bcdf109b-3c07-37b6-81f0-4f94a508fd1c",
                    "sense_definition": "In a way that is not intentional or planned, often due to a mistake or lack of attention.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "unintentional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>inadvertently</w> deleted the important file while cleaning up my computer desktop.",
                            "target_lang_translations": {
                                "ru": "Я <w>случайно</w> удалил важный файл, когда наводил порядок на рабочем столе компьютера.",
                                "pl": "<w>Niechcący</w> usunąłem ważny plik podczas robienia porządków na pulpicie komputera.",
                                "zh": "我在清理电脑桌面时<w>不小心</w>删除了那个重要文件。"
                            }
                        },
                        {
                            "text": "She <w>inadvertently</w> offended her colleague by making a comment she did not realize was rude.",
                            "target_lang_translations": {
                                "ru": "Она <w>нечаянно</w> обидела коллегу, сделав замечание, грубости которого сама не осознавала.",
                                "pl": "<w>Nieumyślnie</w> obraziła kolegę z pracy, robiąc uwagę, z której niegrzeczności nie zdawała sobie sprawy.",
                                "zh": "她发表了一句自己没意识到失礼的评论，<w>无意中</w>冒犯了同事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unawares"
                    ],
                    "antonyms": [
                        "advertently"
                    ],
                    "common_phrases": [
                        "inadvertently caused",
                        "inadvertently revealed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непреднамеренно или ненамеренно, часто по ошибке или из-за невнимательности.",
                        "pl": "W sposób niezamierzony lub nieplanowany, często z powodu pomyłki, nieuwagi lub przez przypadek.",
                        "zh": "非故意地、非计划地，通常由于疏忽或粗心导致"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нечаянно",
                                "target_lang_sense_clarification": "без злого умысла или намерения, по неосторожности"
                            },
                            {
                                "target_lang_word": "случайно",
                                "target_lang_sense_clarification": "непреднамеренно, по стечению обстоятельств"
                            },
                            {
                                "target_lang_word": "неумышленно",
                                "target_lang_sense_clarification": "без заранее обдуманного плана или намерения"
                            },
                            {
                                "target_lang_word": "ненароком",
                                "target_lang_sense_clarification": "разговорное: случайно, нечаянно"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "nieumyślnie",
                                "target_lang_sense_clarification": "bez zamiaru zrobienia czegoś, zazwyczaj formalnie"
                            },
                            {
                                "target_lang_word": "niechcący",
                                "target_lang_sense_clarification": "przez pomyłkę lub nieuwagę, potoczniej"
                            },
                            {
                                "target_lang_word": "przypadkowo",
                                "target_lang_sense_clarification": "zbiegiem okoliczności, niecelowo"
                            },
                            {
                                "target_lang_word": "mimowolnie",
                                "target_lang_sense_clarification": "bez udziału woli, odruchowo lub bezwiednie"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不经意间",
                                "target_lang_sense_clarification": "未加留意、没有察觉地"
                            },
                            {
                                "target_lang_word": "无意中",
                                "target_lang_sense_clarification": "没有故意或预先打算地"
                            },
                            {
                                "target_lang_word": "不小心",
                                "target_lang_sense_clarification": "由于疏忽或大意"
                            },
                            {
                                "target_lang_word": "非故意地",
                                "target_lang_sense_clarification": "较为正式，指没有主观意图"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}