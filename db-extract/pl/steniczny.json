                        "translation_id": "7d8f2d15-43e1-48f9-8d83-5f0b4db52a3b",
                        "source_entry_id": "50eca2b0-fab7-3e77-a781-2dab84ac184e",
                        "source_sense_id": "42ac7635-75b1-33d3-9e95-00a903e0dec9",
                        "target_lang_word": "sthenic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sthenic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "951c477c-d5dc-35f0-b911-ca29871da312",
                                        "entry_id": "6665139e-a757-3233-98a7-95f08adda90a",
                                        "glosses": [
                                            "Characterized by nervous energy; robust, strong."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "098bdfcb-3e44-4a62-a183-e19659d95a79",
                                                "sense_id": "951c477c-d5dc-35f0-b911-ca29871da312",
                                                "text": "The resultant outcome of them is in any case what [Immanuel] Kant calls a ‘sthenic’ affection, an excitement of the cheerful, expansive, ‘dynamogenic’ order which, like any tonic, freshens our vital powers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
