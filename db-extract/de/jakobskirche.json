                "senses": [
                    {
                        "sense_id": "9fb3804c-1667-35e8-8766-0267b5ac86f5",
                        "entry_id": "be3b1fed-e06f-3f82-a779-12005574f142",
                        "glosses": [
                            "meistens dem Apostel Jakobus ^(→ WP)geweihtes Gotteshaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ae83bb8-fc95-4dda-a08f-463545928309",
                                "sense_id": "9fb3804c-1667-35e8-8766-0267b5ac86f5",
                                "text": "„Mit seinen Schülern schuf er Bilder für Ermländer Kirchen, u.a. das Altarbild und die Bilder der Apostel Petrus und Paulus in der Katharinenkirche in Rössel (1821) und das Mater-Dolorosa-Bild in der Jakobskirche in Allenstein.“"
                            },
                            {
                                "example_id": "ca88e1f4-31ac-4316-90b2-f5f74ef308a5",
                                "sense_id": "9fb3804c-1667-35e8-8766-0267b5ac86f5",
                                "text": "„Im Gegensatz zu den meisten Jakobskirchen, die dem Apostel Jakobus geweiht sind, ist die Bockenheimer Kirche nach dem Patriarchen Jakob benannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
