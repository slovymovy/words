                    "frequency": "High",
                    "semantic_group_id": "confident_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она <w>уверена</w> в своем успехе на экзамене."
                        },
                        {
                            "text": "Он был <w>уверен</w> в правильности своего решения."
                        }
                    ],
                    "synonyms": [
                        "решительный"
                    ],
                    "antonyms": [
                        "неуверенный"
                    ],
                    "common_phrases": [
