                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bult</w> die zakken nu maar op in de hoek.",
                            "target_lang_translations": {
                                "fr": "<w>Entasse</w> ces sacs dans le coin maintenant."
                            }
                        },
                        {
                            "text": "<w>Bult</w> het materiaal goed op voor transport.",
                            "target_lang_translations": {
                                "fr": "<w>Entasse</w> bien le matériau pour le transport."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Forme impérative du verbe signifiant entasser ou former un tas."
                    },
                    "translations": {
                        "fr": [
