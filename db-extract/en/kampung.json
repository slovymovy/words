                        "sense_id": "f931a63d-49c6-352f-be8a-497eaefa6e46",
                        "entry_id": "604c3d31-a376-3e37-96e2-3f7befd4193d",
                        "glosses": [
                            "A traditional village."
                        ],
                        "tags": [
                            "Brunei",
                            "Indonesia",
                            "Malaysia",
                            "Singapore"
                        ],
                        "examples": [
                            {
                                "example_id": "998f0780-4fb9-460b-8753-8cbbabf9c165",
                                "sense_id": "f931a63d-49c6-352f-be8a-497eaefa6e46",
                                "text": "They came from solitary huts in the wilderness, from populous campongs, from villages by the sea. At the call of an idea they had left their forests, their clearings, the protection of their rulers, their prosperity, their poverty, the surroundings of their youth and the graves of their fathers."
                            },
                            {
                                "example_id": "3d1f0da4-cbc6-4be7-9a3b-cd71586fa061",
                                "sense_id": "f931a63d-49c6-352f-be8a-497eaefa6e46",
                                "text": "Margio seldom saw his mother happy, and often thought of doing things to cheer her up. He would go back to their kampong and look for gifts for her."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebdb536f-60d9-3a20-8d1b-ea6072c6209f",
                        "entry_id": "604c3d31-a376-3e37-96e2-3f7befd4193d",
                        "glosses": [
                            "A district or suburb where a former village once stood."
                        ],
                        "tags": [
                            "Singapore"
                        ],
                        "examples": [
                            {
                                "example_id": "a60d4526-9a51-40dc-9af0-a564e6ddb207",
                                "sense_id": "ebdb536f-60d9-3a20-8d1b-ea6072c6209f",
                                "text": "Kampung Tanah Merah."
                            }
                        ]
                    }
