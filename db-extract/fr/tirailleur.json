            {
                "entry_id": "395c2050-390c-3e79-a51f-89dcd4055535",
                "word": "tirailleur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "df8b279a-3904-4850-8485-e245e587804a",
                        "entry_id": "395c2050-390c-3e79-a51f-89dcd4055535",
                        "tags": [
