                "senses": [
                    {
                        "sense_id": "ce05861d-10b0-3004-b7a0-3b66d05ef7b6",
                        "entry_id": "925dabdb-72b4-3e16-a5e7-ce7c0b17ccb5",
                        "glosses": [
                            "Action de recadrer, résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fe51962-4c09-41b8-8c62-1c6eb4de32b6",
                                "sense_id": "ce05861d-10b0-3004-b7a0-3b66d05ef7b6",
                                "text": "J’ai voulu faire un recadrage en carré pour renforcer le diagonale formé par les trois groupes."
                            },
                            {
                                "example_id": "2195495b-caf4-421e-b6ae-614276b0026c",
                                "sense_id": "ce05861d-10b0-3004-b7a0-3b66d05ef7b6",
                                "text": "Le chef de l’État assume, en revanche, le recadrage de l’adolescent qui l’avait appelé « Manu » le 18 juin au Mont-Valérien."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc2f0b9f-600a-3cb4-b1ca-5ab49d13abec",
                        "entry_id": "925dabdb-72b4-3e16-a5e7-ce7c0b17ccb5",
                        "glosses": [
                            "Action de recadrer, résultat de cette action.",
                            "Réorientation d’un projet, d’une politique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92ce8729-140d-4feb-add6-c86626ffd5c1",
                                "sense_id": "bc2f0b9f-600a-3cb4-b1ca-5ab49d13abec",
                                "text": "Le Premier ministre François Fillon a procédé jeudi à un recadrage en règle de la politique économique."
                            }
                        ]
                    },
                    {
                        "sense_id": "db305b01-fe9c-3e49-a860-0c49e0688427",
                        "entry_id": "925dabdb-72b4-3e16-a5e7-ce7c0b17ccb5",
                        "glosses": [
                            "Action de recadrer, résultat de cette action.",
                            "Fait de redonner un cadre à l’action d’une personne."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "98189d0c-5803-4d74-8360-ea73177a140f",
                                "sense_id": "db305b01-fe9c-3e49-a860-0c49e0688427",
                                "text": "Le recadrage a pris la forme d’une note interne adressée aux inspecteurs du travail et à leurs supérieurs hiérarchiques, le 30 mars, dans laquelle Yves Struillou, le directeur général du travail, rappelle que toutes les activités « peuvent légalement se poursuivre », à l’exception d’une liste d’activités explicitement interdites par le décret du 24 mars."
                            }
                        ]
                    },
                    {
                        "sense_id": "88206572-6ff7-37fb-a9a2-dddb155b0c21",
                        "entry_id": "925dabdb-72b4-3e16-a5e7-ce7c0b17ccb5",
                        "glosses": [
                            "Cadrage d’une photo ou d’une prise de vue après l’avoir prise, soit au développement ou, par découpage, sur la version papier."
                        ],
                        "tags": [],
                        "examples": []
                    }
