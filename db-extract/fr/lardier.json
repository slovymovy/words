                "senses": [
                    {
                        "sense_id": "22b6fea7-2493-35be-ac29-6383b72433c4",
                        "entry_id": "b64e96dc-22df-38f0-969f-0a7e4c7e1a18",
                        "glosses": [
                            "Marchand de lard."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3685a64c-0b8c-4f1d-9bf0-d0f74cdfff34",
                                "sense_id": "22b6fea7-2493-35be-ac29-6383b72433c4",
                                "text": "Les lardièrs charcutiers s'ingèrent de tuer des porcs depuis la Saint-Jean jusques à la Saint-Remy, au préjudice des défenses."
                            },
                            {
                                "example_id": "0d7a8327-2e04-49b3-bc5b-9c063ab91ea3",
                                "sense_id": "22b6fea7-2493-35be-ac29-6383b72433c4",
                                "text": "C'est un signe de promotion sociale que d'accepter, comme Pierre le fît, d'être parrain du fils d'un maître-picoteur, de l'enfant d'une lardière et du fils d'un palefrenier fût-il celui du seigneur de Carnavalet."
                            },
                            {
                                "example_id": "9e42ce24-779b-4397-b603-ded55773a656",
                                "sense_id": "22b6fea7-2493-35be-ac29-6383b72433c4",
                                "text": "Le chevalier Jean de Surlet , échevin et maître à temps de la cité l'an 1310 , s'étant mésallié en épousant la fille d'un riche bourgeois , boucher et marchand de lard, ne craignit point d'ajouter à son nom celui de lardier."
                            }
                        ]
                    }
