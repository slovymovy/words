                ],
                "senses": [
                    {
                        "sense_id": "2acad04d-2e06-3807-a0eb-cab26551e158",
                        "entry_id": "f94675dc-6f4d-337f-ad49-4929db5894b7",
                        "glosses": [
                            "Celui qui pose des questions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1baa383f-181f-48f4-8c00-88ce17af61dc",
                                "sense_id": "2acad04d-2e06-3807-a0eb-cab26551e158",
                                "text": "Pendant les heures des repas nous fîmes connaissance, et bien vite, il me prit en amitié ; j’étais questionneur enragé, il était causeur ; nous devînmes inséparables. Dans la mine, où généralement on parle peu, on nous appela les bavards."
                            },
                            {
                                "example_id": "702f6fd0-007f-4b97-89c1-5a2d41f26a5d",
                                "sense_id": "2acad04d-2e06-3807-a0eb-cab26551e158",
                                "text": "Son air de gamin vicieux intéressait le questionneur, qui mit une pièce dans le plateau."
                            }
                        ]
                    },
                    {
                        "sense_id": "b375dcbd-7eab-3edf-94ed-aab759cf5f50",
                        "entry_id": "f94675dc-6f4d-337f-ad49-4929db5894b7",
                        "glosses": [
                            "Utilisateur à l’origine d’une question particulière sur une page de discussion consacrée aux questions et réponses, en particulier sur la page Questions sur les mots."
                        ],
                        "tags": [
                            "Wikis"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "241b4237-cc73-4381-a95d-a0f44800114a",
                        "source_entry_id": "f94675dc-6f4d-337f-ad49-4929db5894b7",
                        "target_lang_word": "Frager",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frager",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "787863f0-2b82-3083-b01b-61891523b8df",
                                        "entry_id": "de1fac59-08a9-3ab1-8e70-035b7d45b20e",
                                        "glosses": [
                                            "Person, die eine Frage/Fragen stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0493d4a1-d498-4a9e-970f-2ea3032dca9e",
                                                "sense_id": "787863f0-2b82-3083-b01b-61891523b8df",
                                                "text": "„Und der Frager verstand, daß Helena den Sederabend mit ihrer Familie feiern würde.“"
                                            },
                                            {
                                                "example_id": "fecb3c32-177e-40c4-9c8f-491e668a8475",
                                                "sense_id": "787863f0-2b82-3083-b01b-61891523b8df",
                                                "text": "„Die Antwort klingt unbefangen, aber der Frager hat doch einen verstohlenen Blick bemerkt, den seine Gastfreunde wechselten, einen ganz kurzen nur, aber der hat sein Mißtrauen anwachsen lassen.“"
                                            },
                                            {
                                                "example_id": "da9d53e3-edde-4ef3-95e2-c8e58cd8478a",
                                                "sense_id": "787863f0-2b82-3083-b01b-61891523b8df",
                                                "text": "„Er richtet seine Augen ernst, mit mildem Vorwurf auf den Frager.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
