                    {
                        "sense_id": "ac0f1491-6f6e-38e1-a399-bafad71c78cf",
                        "entry_id": "a632a015-539c-3243-a234-75c7972827de",
                        "glosses": [
                            "Question partielle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c9690b4-07fb-4ced-b613-6413f360215a",
                                "sense_id": "ac0f1491-6f6e-38e1-a399-bafad71c78cf",
                                "text": "Die Frage “Wann gehen wir?” ist eine Ergänzungsfrage, die nach einer Zeitangabe fragt.",
                                "translation": "La question « Quand partons-nous ? » est une question partielle qui demande une indication de temps."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a3a204a-0da9-3dad-b6a4-e73885a99480",
                        "entry_id": "a632a015-539c-3243-a234-75c7972827de",
                        "glosses": [
                            "Question complémentaire : question demandant un complément d’information."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eeefa5d-df68-4a0f-b64b-3dd34f43025a",
                                "sense_id": "4a3a204a-0da9-3dad-b6a4-e73885a99480",
                                "text": "Meine Angaben reichten nicht aus; ich bekam noch viele Ergänzungsfragen.",
                                "translation": "Mes indications n’ont pas suffi ; j’ai reçu encore maintes questions complémentaires."
                            }
                        ]
                    }
                ],
