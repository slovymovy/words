                    "sense_id": "f60b7e79-e1d6-394a-bc2b-fb58575d6c73",
                    "sense_definition": "Nauka o zdrowiu i chorobach człowieka i zwierząt oraz sposobach zapobiegania i leczenia.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Współczesna <w>medycyna</w> potrafi wyleczyć wiele groźnych chorób.",
                            "target_lang_translations": {
                                "ru": "Современная <w>медицина</w> способна вылечить многие опасные болезни.",
                                "en": "Modern <w>medicine</w> can cure many dangerous diseases.",
                                "zh": "现代<w>医学</w>能够治愈许多危险的疾病。"
                            }
                        },
                        {
                            "text": "Istnieje wiele chorób, wobec których <w>medycyna</w> jest bezsilna.",
                            "target_lang_translations": {
                                "ru": "Существует много болезней, перед которыми <w>медицина</w> бессильна.",
                                "en": "There are many diseases against which <w>medicine</w> is powerless.",
                                "zh": "存在许多<w>医学</w>对其无能为力的疾病。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sztuka lekarska",
                        "lecznictwo"
                    ],
                    "common_phrases": [
                        "medycyna naturalna",
                        "medycyna sądowa",
                        "medycyna pracy",
                        "medycyna estetyczna"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наука о здоровье и болезнях человека и животных, а также способах их предотвращения и лечения.",
                        "en": "The science and practice of diagnosing, treating, and preventing disease in humans and animals.",
                        "zh": "关于人类和动物健康、疾病以及预防和治疗方法的科学；医学。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медицина",
                                "target_lang_sense_clarification": "наука и практика лечения"
