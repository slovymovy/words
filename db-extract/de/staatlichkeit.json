                "senses": [
                    {
                        "sense_id": "de0c9fb1-a481-303c-b7e2-860814a0fbc1",
                        "entry_id": "ca0697b5-1b85-33db-94ab-1731d38b1cbd",
                        "glosses": [
                            "Gesamtheit der Eigenschaften, welche einen Staat auszeichnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0675169-d414-4e57-98e8-1058d65c7a7a",
                                "sense_id": "de0c9fb1-a481-303c-b7e2-860814a0fbc1",
                                "text": "„Da dieses Reich jedoch nicht einmal Afghanistan genannt wurde und auch keine Institutionen der modernen Staatlichkeit hervorbrachte, kann in diesem Zeitpunkt kaum die Gründung eines modernen afghanischen Staats gesehen werden.“"
                            },
                            {
                                "example_id": "8de8014f-fffb-4390-b4e1-30dbd09f61fe",
                                "sense_id": "de0c9fb1-a481-303c-b7e2-860814a0fbc1",
                                "text": "„Begin und seine Nachfolger im Likud, Jitzchak Schamir, Ariel Scharon und dann Benjamin Netanjahu, stellten sich unerbittlich gegen eine pälastinensische Staatlichkeit, Souveränität oder Kontrolle des besetzten Westjordanlands und Ostjerusalems.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ec2054c-6819-40db-a21f-d6cd9cdda254",
                        "source_entry_id": "ca0697b5-1b85-33db-94ab-1731d38b1cbd",
                        "source_sense_id": "de0c9fb1-a481-303c-b7e2-860814a0fbc1",
                        "source_sense_description": "Gesamtheit der Eigenschaften, welche einen Staat auszeichnen",
                        "target_lang_word": "statehood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "statehood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b7f735-f87e-3dfc-8921-7227b5553249",
                                        "entry_id": "7f2c328e-1115-34a0-a01b-93194b6ff36d",
                                        "glosses": [
                                            "The property of being a state, an autonomous subdivision of a federal country."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afa9ef35-377b-4767-8aef-f6619837609e",
                                                "sense_id": "f9b7f735-f87e-3dfc-8921-7227b5553249",
                                                "text": "Alaska didn't attain statehood until 1959, when it became the 49th state of the United States."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5e53c0e-36f7-3d41-82eb-da58e0540b17",
                                        "entry_id": "7f2c328e-1115-34a0-a01b-93194b6ff36d",
                                        "glosses": [
                                            "The condition of being a country."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8786e3b-2190-4616-800d-6eaa2edf45af",
                                                "sense_id": "d5e53c0e-36f7-3d41-82eb-da58e0540b17",
                                                "text": "Medvedev cited these supposed “Western analysts” in order to propagate Russia’s colonial fantasy: envisioning Ukraine’s territory reduced to just the Kyiv region, while the remainder of Ukraine would be divided among Russia, Poland, Romania, and Hungary. Such a narrative recalls Putin’s February 2022 speech questioning Ukraine’s statehood and accompanies intensifying Russian calls to expand its “special military operation” to realize its imperial map."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a016f549-e92d-4cbb-9f44-ac8df9c8315e",
                        "source_entry_id": "ca0697b5-1b85-33db-94ab-1731d38b1cbd",
                        "source_sense_id": "de0c9fb1-a481-303c-b7e2-860814a0fbc1",
                        "source_sense_description": "Gesamtheit der Eigenschaften, welche einen Staat auszeichnen",
                        "target_lang_word": "étaticité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étaticité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8bef0223-4f20-3ba1-ae93-1ad2f745d041",
                                        "entry_id": "9669eb2c-1eb4-33ff-a52f-2913338246e5",
                                        "glosses": [
                                            "Qualité de ce qui constitue un État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee0e2ccc-dcb1-445a-b896-913c0175cd15",
                                                "sense_id": "8bef0223-4f20-3ba1-ae93-1ad2f745d041",
                                                "text": "Son chef revendique l'« étaticité » de son organisation terroriste (ainsi rendrons-nous l'anglais « Statehood » faute de mot français correspondant."
                                            },
                                            {
                                                "example_id": "d4776949-e822-4924-9234-961f19764888",
                                                "sense_id": "8bef0223-4f20-3ba1-ae93-1ad2f745d041",
                                                "text": "Dans cette optique, l’étaticité fragmentée du Saint-Empire et la faiblesse des institutions centrales se sont avérées néfastes pour la « défense » de l’ancienne Église"
                                            },
                                            {
                                                "example_id": "2fa12f21-d54d-43d2-9667-8f01d3cd6e19",
                                                "sense_id": "8bef0223-4f20-3ba1-ae93-1ad2f745d041",
                                                "text": "S’y ajoutent désormais d’autres concepts comme la limited statehood (qu’on pourrait traduire par étaticité limitée) qui se démarquent davantage d’une définition étroite de ce qu’est un Etat ou de ce qu’il devrait être"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
