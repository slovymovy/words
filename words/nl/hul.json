                    "frequency": "VeryLow",
                    "semantic_group_id": "natuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er groeide een klein <w>hul</w> met wilde bloemen aan de rand van het veld.",
                            "target_lang_translations": {
                                "en": "A small <w>patch</w> of wildflowers grew at the edge of the field."
                            }
                        },
                        {
                            "text": "De tuinman legde een nieuwe <w>hul</w> aan op de kale plek in het gazon.",
                            "target_lang_translations": {
                                "en": "The gardener laid a new <w>patch of sod</w> on the bare spot in the lawn."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Wordt in specifieke dialecten gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A small patch of vegetation or a piece of sod."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "patch",
