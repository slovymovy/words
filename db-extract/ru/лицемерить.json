                "translations": [
                    {
                        "translation_id": "89c17cbb-a2b9-4cbc-baea-c72d6fb4b783",
                        "source_entry_id": "07f751f8-48c3-3ec5-83c9-910f4cb7892e",
                        "source_sense_id": "c3186357-4682-345f-bd76-09bc1747ae4a",
                        "target_lang_word": "play the hypocrite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "207c6f7e-03a7-4242-8857-650304250dce",
                        "source_entry_id": "07f751f8-48c3-3ec5-83c9-910f4cb7892e",
                        "source_sense_id": "c3186357-4682-345f-bd76-09bc1747ae4a",
                        "target_lang_word": "dissemble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dissemble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e4f4103-4d3a-3de8-87f3-286af2f5b4be",
                                        "entry_id": "3565a295-7b0a-369c-aec6-be1ddd0ad624",
                                        "glosses": [
                                            "To disguise or conceal something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "831b3a94-b892-4699-952a-1b4f0908fd5f",
                                                "sense_id": "7e4f4103-4d3a-3de8-87f3-286af2f5b4be",
                                                "text": "Dissemble all your griefs and discontents."
                                            },
                                            {
                                                "example_id": "1be2ded9-41f4-457d-8d23-ae15fe656093",
                                                "sense_id": "7e4f4103-4d3a-3de8-87f3-286af2f5b4be",
                                                "text": "Dearly beloved brethren, the Scripture moveth us in ſundry places to acknowledge, and confeſs our manifold ſins and wickedneſs, and that we ſhould not diſſemble nor cloak them before the face of Almighty God our heavenly Father, […]"
                                            },
                                            {
                                                "example_id": "95719140-3470-4bbb-b5ee-0d52e4f9ad5d",
                                                "sense_id": "7e4f4103-4d3a-3de8-87f3-286af2f5b4be",
                                                "text": "Perhaps it was right to dissemble your love."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf1333a3-03da-3f5f-8b59-af94e0ae0eee",
                                        "entry_id": "3565a295-7b0a-369c-aec6-be1ddd0ad624",
                                        "glosses": [
                                            "To feign, dissimulate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f89e8f0c-58d5-43f7-a45e-2216b32923b0",
                                                "sense_id": "bf1333a3-03da-3f5f-8b59-af94e0ae0eee",
                                                "text": "And like a lion, slumb'ring in the way, / Or sleep-dissembling, while he waits his prey."
                                            },
                                            {
                                                "example_id": "b41fae68-a694-4e97-a96e-399a90151654",
                                                "sense_id": "bf1333a3-03da-3f5f-8b59-af94e0ae0eee",
                                                "text": "He soon dissembled a sleep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0c9b8ac-29c5-3281-90d1-1f0e2f059cde",
                                        "entry_id": "3565a295-7b0a-369c-aec6-be1ddd0ad624",
                                        "glosses": [
                                            "To deliberately ignore something; to pretend not to notice."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c8dc86d-655f-378a-a230-c24479b1cce3",
                                        "entry_id": "3565a295-7b0a-369c-aec6-be1ddd0ad624",
                                        "glosses": [
                                            "To falsely hide one's opinions or feelings."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9f83621-27c1-4f14-9220-33cacaeacef3",
                                                "sense_id": "0c8dc86d-655f-378a-a230-c24479b1cce3",
                                                "text": "VVhile to his Arms the bluſhing Bride he took; / To ſeeming Sadneſs ſhe compoſ'd her Look; / As if by Force ſubjected to his VVill, / Tho' pleaſ'd, diſſembling, and a VVoman ſtill."
                                            },
                                            {
                                                "example_id": "0407efdd-a5b5-4ade-8aed-2a5eda7d2925",
                                                "sense_id": "0c8dc86d-655f-378a-a230-c24479b1cce3",
                                                "text": "[…] She transferr'd the curs'd Advice, / That Monarchs ſhould their inward Soul diſguise, / Diſſemble, and command; be falſe, and wiſe; / By ignominous Arts for ſervile Ends / Should compliment their Foes, and ſhun their Friends."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
