                                        "entry_id": "cde3b0d7-0c79-3636-bd6f-fdbd07a4f871",
                                        "glosses": [
                                            "Lier quelqu’un avec une chaîne ou attacher quelqu’un avec des chaînes à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8774def-6c90-43fa-896a-17dcb34c2fe8",
                                                "sense_id": "07262d92-dd99-3ab9-9f49-47c4c5f39cde",
                                                "text": "Ils marchaient enchaînés les uns aux autres."
                                            },
                                            {
                                                "example_id": "a53901da-fb9a-4982-9e0f-2cbde696d519",
                                                "sense_id": "07262d92-dd99-3ab9-9f49-47c4c5f39cde",
                                                "text": "Enchaîner un chien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a10f1b0d-2a45-37d6-b41d-b0fa487751cb",
                                        "entry_id": "cde3b0d7-0c79-3636-bd6f-fdbd07a4f871",
                                        "glosses": [
                                            "Subjuguer ; asservir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f5f192c-6dfb-4384-8761-7ea640ff116b",
                                                "sense_id": "a10f1b0d-2a45-37d6-b41d-b0fa487751cb",
                                                "text": "Ne suis-je pas tombé victime sous les coups de ces ennemis de Dieu ? et le démon, qui les déchaînait contre moi, n'a-t-il pas triomphé en voyant qu'il avait vaincu, enchaîné, asservi l'âme d'un prêtre ?"
                                            },
                                            {
                                                "example_id": "f373217f-f84f-4188-980f-ebe6b075b6bb",
                                                "sense_id": "a10f1b0d-2a45-37d6-b41d-b0fa487751cb",
                                                "text": "Enchaîner un peuple."
                                            },
                                            {
                                                "example_id": "667989f0-fb69-43b6-a729-32f11cd8bd60",
                                                "sense_id": "a10f1b0d-2a45-37d6-b41d-b0fa487751cb",
                                                "text": "Enchaîner les cœurs par ses bienfaits."
                                            },
                                            {
                                                "example_id": "827c0bcb-4912-4935-99de-e6e882f28624",
                                                "sense_id": "a10f1b0d-2a45-37d6-b41d-b0fa487751cb",
                                                "text": "Cette coquette enchaîne tous ceux qui l’approchent."
                                            },
                                            {
                                                "example_id": "bcd94fa0-f70f-4f5c-a959-e0c78621b2a5",
                                                "sense_id": "a10f1b0d-2a45-37d6-b41d-b0fa487751cb",
                                                "text": "Enchaîner la Victoire à son char, en parlant d’un Vainqueur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "641f73c9-5dc5-380e-b472-1de75a889bd6",
                                        "entry_id": "cde3b0d7-0c79-3636-bd6f-fdbd07a4f871",
                                        "glosses": [
                                            "Retenir, contenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "116694ff-0e71-4ac4-8e82-c282144b389e",
                                                "sense_id": "641f73c9-5dc5-380e-b472-1de75a889bd6",
                                                "text": "Un serment enchaîne ma langue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "581240e2-4488-381b-bb58-80b88dc76001",
                                        "entry_id": "cde3b0d7-0c79-3636-bd6f-fdbd07a4f871",
                                        "glosses": [
                                            "Faire découler certaines choses les unes des autres par une dépendance, une relation mutuelle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac4288b9-0d4d-4b71-9e58-053757a4b0d6",
                                                "sense_id": "581240e2-4488-381b-bb58-80b88dc76001",
                                                "text": "Il a bien enchaîné toutes ces propositions."
                                            },
                                            {
                                                "example_id": "bfef32b1-2d71-4191-be82-9996d1f86bc1",
                                                "sense_id": "581240e2-4488-381b-bb58-80b88dc76001",
                                                "text": "Les causes naturelles sont enchaînées les unes avec les autres, les unes aux autres."
                                            },
                                            {
                                                "example_id": "39ae5121-c131-49e3-9e39-7cdc05c8341c",
                                                "sense_id": "581240e2-4488-381b-bb58-80b88dc76001",
                                                "text": "Les vérités, les principes de cette science s’enchaînent les uns aux autres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
