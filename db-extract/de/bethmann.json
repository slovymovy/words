                ],
                "senses": [
                    {
                        "sense_id": "2ff3578d-0e70-3cc9-8a89-f5f00c8c3079",
                        "entry_id": "3d9779c5-039f-39cb-9bae-bfb0c0a9e0b1",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78f7a1d0-ee74-4705-bfea-e7739feb5dc3",
                                "sense_id": "2ff3578d-0e70-3cc9-8a89-f5f00c8c3079",
                                "text": "Frau Bethmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d9dfe080-271e-4cb8-899f-96f453413eec",
                                "sense_id": "2ff3578d-0e70-3cc9-8a89-f5f00c8c3079",
                                "text": "Herr Bethmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bc221519-1468-4fa7-a121-ba915e9b86fe",
                                "sense_id": "2ff3578d-0e70-3cc9-8a89-f5f00c8c3079",
                                "text": "Die Bethmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "288df4a9-13ac-43ba-bacd-450c8be0c4ba",
                                "sense_id": "2ff3578d-0e70-3cc9-8a89-f5f00c8c3079",
                                "text": "Der Bethmann trägt nie die Schals, die die Bethmann ihm strickt."
                            },
                            {
                                "example_id": "efa13847-e267-49b2-876b-145d3f074fdf",
                                "sense_id": "2ff3578d-0e70-3cc9-8a89-f5f00c8c3079",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bethmann kommt, geht der Herr Bethmann.“"
                            },
                            {
                                "example_id": "34f50a18-d76f-41ad-8a68-8139f799f0f9",
                                "sense_id": "2ff3578d-0e70-3cc9-8a89-f5f00c8c3079",
                                "text": "Bethmann kommt und geht."
                            },
                            {
                                "example_id": "47ef956d-75ed-40d5-97ae-c94a974f0ad0",
                                "sense_id": "2ff3578d-0e70-3cc9-8a89-f5f00c8c3079",
                                "text": "Bethmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
