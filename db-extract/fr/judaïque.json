                    }
                ],
                "senses": [
                    {
                        "sense_id": "59ef0324-aa03-32cb-ac90-7fb1e32dd5e0",
                        "entry_id": "8cc7281e-606c-3c0b-be93-83de8c92bbd4",
                        "glosses": [
                            "Qui appartient aux juifs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "963bea95-7bf8-4083-b509-bd3c78abb67d",
                                "sense_id": "59ef0324-aa03-32cb-ac90-7fb1e32dd5e0",
                                "text": "La loi judaïque. Les antiquités judaïques. La religion judaïque."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b12997f-ce28-3cb5-a8c7-fe2836f8daf4",
                        "entry_id": "8cc7281e-606c-3c0b-be93-83de8c92bbd4",
                        "glosses": [
                            "Qualifiait un attachement à la lettre et non à l’esprit de certaines prescriptions religieuses."
                        ],
                        "tags": [
                            "dated",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "25919d10-046e-4237-bb79-3869a729c1b0",
                                "sense_id": "1b12997f-ce28-3cb5-a8c7-fe2836f8daf4",
                                "text": "Observances judaïques. Interprétation judaïque."
                            },
                            {
                                "example_id": "6658d7af-1605-4d91-8ec1-decc7c64e010",
                                "sense_id": "1b12997f-ce28-3cb5-a8c7-fe2836f8daf4",
                                "text": "Madame Martin, amusée, demanda ce qu’il y avait de réellement vrai dans cette histoire. Vence répondit qu’il ne fallait pas chercher à le savoir.\nIl avouait à demi qu’il était l’historien idéaliste du poète et qu’on ne devait pas prendre les aventures qu’il en contait au sens littéral et judaïque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "084c449f-c83a-4946-8801-20e0b2c9abd4",
                        "source_entry_id": "8cc7281e-606c-3c0b-be93-83de8c92bbd4",
                        "target_lang_word": "Judaic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Judaic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32eaa2a8-0aed-3f5a-a533-5863bab40430",
                                        "entry_id": "61df1dc2-a8b5-3f46-9202-6dbd661b26ce",
                                        "glosses": [
                                            "Pertaining to the Jews, their culture or their religion."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "452ad089-2a5b-48a9-bdc1-ff2660357a18",
                                                "sense_id": "32eaa2a8-0aed-3f5a-a533-5863bab40430",
                                                "text": "While many consider Chanukah a celebration of Judaic values over Greek values, this is an error. The Maccabees were fighting for the rights of all cultures to exist within the same empire."
                                            },
                                            {
                                                "example_id": "8077a848-ab94-4ab2-9ad9-814800ba6d3a",
                                                "sense_id": "32eaa2a8-0aed-3f5a-a533-5863bab40430",
                                                "text": "The gods' begettings in the Theogony are reminiscent of the biblical human begettings in the Old Testament and emphasize their being in nature, unlike the Judaic God outside of it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9602cd22-dcb5-466e-a91c-6904176a6058",
                        "source_entry_id": "8cc7281e-606c-3c0b-be93-83de8c92bbd4",
                        "target_lang_word": "Jewish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jewish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e4e192a-32fd-34ad-a08e-e1ccbd8bed10",
                                        "entry_id": "95f90170-ee61-313d-8345-ce5f4be84f9b",
                                        "glosses": [
                                            "Following the religion of Judaism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73d30e0e-3d1b-4dbe-9bcc-ca31abb63dd6",
                                                "sense_id": "0e4e192a-32fd-34ad-a08e-e1ccbd8bed10",
                                                "text": "There are many Jewish people in France."
                                            },
                                            {
                                                "example_id": "1a770cf6-2c2b-4320-833e-ce9a799d9698",
                                                "sense_id": "0e4e192a-32fd-34ad-a08e-e1ccbd8bed10",
                                                "text": "Kaplan-Miller said she first joined the Sisterhood of Salaam Shalom, an interfaith organization that was founded by a Muslim and a Jewish woman in suburban New Jersey, shortly after the 2016 election."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09549816-c638-3c46-8611-fa279915cabd",
                                        "entry_id": "95f90170-ee61-313d-8345-ce5f4be84f9b",
                                        "glosses": [
                                            "Of or relating to Jews, their ethnicities or cultures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22dbb038-2cc2-437e-ac5b-1abcbd1c3e93",
                                                "sense_id": "09549816-c638-3c46-8611-fa279915cabd",
                                                "text": "I tried some traditional Jewish food yesterday."
                                            },
                                            {
                                                "example_id": "2ca03ca3-466e-499f-ba86-cbb5ba275f92",
                                                "sense_id": "09549816-c638-3c46-8611-fa279915cabd",
                                                "text": "The notion of blood purity was first elaborated in Europe, where it was used to separate Old Christians from Spain’s New Christians—women and men of Jewish and Muslim origin whose ancestors had converted to Christianity."
                                            },
                                            {
                                                "example_id": "8b853036-a561-42b9-aa18-3353a6065f25",
                                                "sense_id": "09549816-c638-3c46-8611-fa279915cabd",
                                                "text": "As per the old Jewish joke “ask two Jews, get three opinions”, there’s room on this seven-strong bill (plus [Hannah] Gadsby) for at least that many different perspectives on gender – including some impish scepticism from Canadian comic DeAnne Smith, who complains about “getting they/them’d against my will since 2005”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80667540-6533-3c6d-970d-c82fad5eefe6",
                                        "entry_id": "95f90170-ee61-313d-8345-ce5f4be84f9b",
                                        "glosses": [
                                            "Greedy, miserly."
                                        ],
                                        "tags": [
                                            "dated",
                                            "derogatory",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb5b0890-73e5-45b4-97f5-4ff07c07dd58",
                                                "sense_id": "80667540-6533-3c6d-970d-c82fad5eefe6",
                                                "text": "\"Vanity!\" ſays ſhe, haughtily, \"What is vanity in you, ſir, is propriety in me. You aſk a Jewiſh price for it, Mr. Graves; but have it I will, if only to ſpite Mr. Eſmond.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da262307-10fc-3f52-bb98-8733e3504493",
                                        "entry_id": "95f90170-ee61-313d-8345-ce5f4be84f9b",
                                        "glosses": [
                                            "Yiddish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b0cea56-ec4c-4401-b8a5-f7e2cb927bff",
                                                "sense_id": "da262307-10fc-3f52-bb98-8733e3504493",
                                                "text": "The roots of American Jewry are not in the Middle East but in Europe—their Jewish style, their strong Jewish words, their strong nostalgia, their actual, weighable history, all this issues from their European origins. Grandpa did not hail from Haifa—he was a Jewish humanist, a spiritual, believing Jew, who complained not in an antique tongue called Hebrew but in colorful, rich, vernacular Yiddish."
                                            },
                                            {
                                                "example_id": "80890741-c9d3-436e-9b1e-e97a67a53153",
                                                "sense_id": "da262307-10fc-3f52-bb98-8733e3504493",
                                                "text": "Although I did know that my Jewish name was Yiddish, the rabbi who first taught me Hebrew in the 1960s insisted that we all have Hebrew and not Yiddish names"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Jewish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee0e99fb-c927-3b76-8303-3917acde89a4",
                                        "entry_id": "a407a039-4bf4-301c-92c8-285d58f6101d",
                                        "glosses": [
                                            "A Jew."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f06aee5-3c29-466c-9661-d46a78e04977",
                                                "sense_id": "ee0e99fb-c927-3b76-8303-3917acde89a4",
                                                "text": "The Statue of Liberty. A French gift with a poem made by a Jewish."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Jewish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b85b8669-96ac-3b2b-958c-67df53bb3da6",
                                        "entry_id": "0c63a818-fbbe-3c5f-83c2-da51c082e554",
                                        "glosses": [
                                            "The Hebrew language."
                                        ],
                                        "tags": [
                                            "informal",
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5797fc99-8af5-4a75-8665-56483a2279be",
                                                "sense_id": "b85b8669-96ac-3b2b-958c-67df53bb3da6",
                                                "text": "I can't speak Jewish; I can't even understand it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bb853c7-2ea2-3261-9b8d-9ff07f7b7d8b",
                                        "entry_id": "0c63a818-fbbe-3c5f-83c2-da51c082e554",
                                        "glosses": [
                                            "The Yiddish language."
                                        ],
                                        "tags": [
                                            "informal",
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "240a3279-a941-46e2-9ec3-bb38a6627c10",
                                                "sense_id": "7bb853c7-2ea2-3261-9b8d-9ff07f7b7d8b",
                                                "text": "We believe that although he speaks Jewish, he speaks Russian quite badly and pretentiously."
                                            },
                                            {
                                                "example_id": "dde60c6a-dbf9-43ba-82ca-edeebaf5404e",
                                                "sense_id": "7bb853c7-2ea2-3261-9b8d-9ff07f7b7d8b",
                                                "text": "After a day servicing commercial refrigeration through the five boroughs, Dad would bring home a story of a Chinese waiter on Second Avenue who “speaks Jewish like a Galitzianer,” or of a Mafioso in a Queens fruit market who “has such yiddisher taam, I call him Rabbi Zino.”"
                                            },
                                            {
                                                "example_id": "54adbb01-ae80-411a-ba68-be778492a94a",
                                                "sense_id": "7bb853c7-2ea2-3261-9b8d-9ff07f7b7d8b",
                                                "text": "A Jew wearing a cap with a visor and a red scarf around his neck is answering a Jewish woman who has addressed him in Polish: “One speaks Jewish aboard the Jewish tram”. Another butts in: “What about in Hebrew?” “In Hebrew as well”.\n[…] The Jews in Wereszczyn spoke Jewish amongst themselves, and Polish with us. They had their own Jewish accent, but they had a pretty good grasp of the Polish language."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
