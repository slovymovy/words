{
    "word_family": [
        "thick",
        "thickness",
        "thickener",
        "thickly",
        "thickening"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "86014e6b-82bb-3357-92e4-ed72b0f5e178",
                    "sense_definition": "To make a liquid or substance more dense or viscous.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "viscosity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can use a little cornstarch to <w>thicken</w> the sauce if it is too watery.",
                            "target_lang_translations": {
                                "ru": "Вы можете использовать немного кукурузного крахмала, чтобы <w>загустить</w> соус, если он слишком жидкий.",
                                "zh": "如果酱汁太稀，你可以加一点淀粉来<w>勾芡</w>。"
                            }
                        },
                        {
                            "text": "The chef decided to <w>thicken</w> the soup by adding some heavy cream at the end.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар решил <w>сгустить</w> суп, добавив в конце немного жирных сливок.",
                                "zh": "厨师决定在最后加些奶油来使汤<w>变稠</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "condense",
                        "inspissate"
                    ],
                    "antonyms": [
                        "dilute",
                        "thin",
                        "water down"
                    ],
                    "common_phrases": [
                        "thicken a sauce",
                        "thicken the soup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать жидкость или вещество более плотным или вязким.",
                        "zh": "使液体或物质变得更稠或更粘。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгущать",
                                "target_lang_sense_clarification": "делать более густым"
                            },
                            {
                                "target_lang_word": "загущать",
                                "target_lang_sense_clarification": "добавлять загуститель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……变稠",
                                "target_lang_sense_clarification": "改变液体浓度"
                            },
                            {
                                "target_lang_word": "勾芡",
                                "target_lang_sense_clarification": "烹饪中使汤汁变稠"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbe20bf5-45e7-3d33-be67-4309a1a3fa49",
                    "sense_definition": "To become more dense, viscous, or solid.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "viscosity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mixture will <w>thicken</w> as it cools down in the refrigerator.",
                            "target_lang_translations": {
                                "ru": "Смесь <w>загустеет</w>, когда остынет в холодильнике.",
                                "zh": "混合物在冰箱里冷却时会<w>变稠</w>。"
                            }
                        },
                        {
                            "text": "Wait for the custard to <w>thicken</w> before you pour it over the cake.",
                            "target_lang_translations": {
                                "ru": "Подождите, пока заварной крем <w>загустеет</w>, прежде чем поливать им торт.",
                                "zh": "等卡仕达酱<w>凝固</w>后再淋在蛋糕上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inspissate"
                    ],
                    "antonyms": [
                        "thin"
                    ],
                    "common_phrases": [
                        "thicken as it cools"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться более плотным, вязким или твердым.",
                        "zh": "变得更稠、更粘或更固体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгущаться",
                                "target_lang_sense_clarification": "становиться гуще"
                            },
                            {
                                "target_lang_word": "загустевать",
                                "target_lang_sense_clarification": "о консистенции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变稠",
                                "target_lang_sense_clarification": "指液体浓度增加"
                            },
                            {
                                "target_lang_word": "凝固",
                                "target_lang_sense_clarification": "指物质由液态变固态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cff2d67-deb1-3bcb-93c0-b3dc796ee280",
                    "sense_definition": "To make something wider or more substantial in dimension.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dimension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The builder had to <w>thicken</w> the walls to support the weight of the new roof.",
                            "target_lang_translations": {
                                "ru": "Строителю пришлось <w>утолстить</w> стены, чтобы они выдержали вес новой крыши.",
                                "zh": "建筑工必须把墙壁<w>加厚</w>，以支撑新屋顶的重量。"
                            }
                        },
                        {
                            "text": "You should <w>thicken</w> the lines on your drawing so they are easier to see.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>утолстить</w> линии на рисунке, чтобы их было лучше видно.",
                                "zh": "你应该把画上的线条<w>加粗</w>，这样更容易看清。"
                            }
                        }
                    ],
                    "synonyms": [
                        "broaden",
                        "widen"
                    ],
                    "antonyms": [
                        "thin"
                    ],
                    "common_phrases": [
                        "thicken the walls",
                        "thicken the lines"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо шире или массивнее в размерах.",
                        "zh": "使某物在尺寸上更宽或更厚实。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утолщать",
                                "target_lang_sense_clarification": "делать толще"
                            },
                            {
                                "target_lang_word": "увеличивать толщину",
                                "target_lang_sense_clarification": "о размерах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加厚",
                                "target_lang_sense_clarification": "增加物体的厚度"
                            },
                            {
                                "target_lang_word": "加粗",
                                "target_lang_sense_clarification": "增加线条的宽度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e1c185f-df69-3d4d-9da2-234a01b22f8c",
                    "sense_definition": "To become wider or more substantial in dimension.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dimension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As we age, the major arteries of our bodies frequently <w>thicken</w> with plaque.",
                            "target_lang_translations": {
                                "ru": "С возрастом основные артерии нашего тела часто <w>утолщаются</w> из-за бляшек.",
                                "zh": "随着年龄增长，我们体内的主要动脉常因斑块而<w>变厚</w>。"
                            }
                        },
                        {
                            "text": "The fog began to <w>thicken</w> as the sun went down, making it hard to drive.",
                            "target_lang_translations": {
                                "ru": "Туман начал <w>сгущаться</w> после захода солнца, что затруднило вождение.",
                                "zh": "太阳下山后雾气开始<w>变浓</w>，导致开车变得困难。"
                            }
                        }
                    ],
                    "synonyms": [
                        "widen"
                    ],
                    "antonyms": [
                        "thin"
                    ],
                    "common_phrases": [
                        "arteries thicken with plaque"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться шире или массивнее в размерах.",
                        "zh": "在尺寸上变得更宽或更厚实。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утолщаться",
                                "target_lang_sense_clarification": "становиться толще"
                            },
                            {
                                "target_lang_word": "сгущаться",
                                "target_lang_sense_clarification": "о тумане или темноте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变厚",
                                "target_lang_sense_clarification": "指物体厚度增加"
                            },
                            {
                                "target_lang_word": "变浓",
                                "target_lang_sense_clarification": "指雾气或烟雾变得浓重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "585d340d-632c-3270-88f0-3f6a6cf977a3",
                    "sense_definition": "To make a story, plot, or situation more complex or detailed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "complexity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plot began to <w>thicken</w> when a mysterious stranger arrived at the house.",
                            "target_lang_translations": {
                                "ru": "Сюжет начал <w>закручиваться</w>, когда в доме появился таинственный незнакомец.",
                                "zh": "当一个神秘陌生人来到屋子时，剧情开始<w>变得扑朔迷离</w>。"
                            }
                        },
                        {
                            "text": "The author decided to <w>thicken</w> the narrative by adding several subplots.",
                            "target_lang_translations": {
                                "ru": "Автор решил <w>усложнить</w> повествование, добавив несколько побочных сюжетных линий.",
                                "zh": "作者决定通过增加几条副线来<w>充实</w>叙事。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the plot thickens"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать историю, сюжет или ситуацию более сложной или детальной.",
                        "zh": "使故事、情节或情况变得更复杂或详细。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгущаться",
                                "target_lang_sense_clarification": "о красках или сюжете"
                            },
                            {
                                "target_lang_word": "усложняться",
                                "target_lang_sense_clarification": "о ситуации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变得扑朔迷离",
                                "target_lang_sense_clarification": "指情节变得复杂"
                            },
                            {
                                "target_lang_word": "使……复杂化",
                                "target_lang_sense_clarification": "增加细节或难度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4c7cc3f-cbb3-30f4-9821-4c5bf70f3006",
                    "sense_definition": "To strengthen or confirm something, such as an argument or proof.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "strengthen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New evidence emerged that helped to <w>thicken</w> the case against the suspect.",
                            "target_lang_translations": {
                                "ru": "Появились новые улики, которые помогли <w>подкрепить</w> дело против подозреваемого.",
                                "zh": "新的证据浮出水面，有助于<w>加强</w>针对嫌疑人的指控。"
                            }
                        },
                        {
                            "text": "These additional facts will <w>thicken</w> other proofs that demonstrate the theory.",
                            "target_lang_translations": {
                                "ru": "Эти дополнительные факты <w>усилят</w> другие доказательства, подтверждающие теорию.",
                                "zh": "这些额外的事实将<w>充实</w>其他证明该理论的证据。"
                            }
                        }
                    ],
                    "synonyms": [
                        "build up",
                        "reinforce",
                        "strengthen"
                    ],
                    "common_phrases": [
                        "thicken the proof"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to mean strengthen"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Укрепить или подтвердить что-либо, например, аргумент или доказательство.",
                        "zh": "加强或证实某事，如论点或证据。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подкреплять",
                                "target_lang_sense_clarification": "усиливать доказательства"
                            },
                            {
                                "target_lang_word": "усиливать",
                                "target_lang_sense_clarification": "делать весомее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加强",
                                "target_lang_sense_clarification": "使论点更有力"
                            },
                            {
                                "target_lang_word": "充实",
                                "target_lang_sense_clarification": "增加证据使内容更丰富"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf2fe96f-b6c9-3e99-8664-d7a916553700",
                    "sense_definition": "To make actions or events occur more frequently or in closer succession.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "frequency_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers began to <w>thicken</w> their blows as the battle reached its peak.",
                            "target_lang_translations": {
                                "ru": "Солдаты начали <w>учащать</w> удары, когда битва достигла своего пика.",
                                "zh": "战斗达到高潮时，士兵们开始<w>加快</w>攻击频率。"
                            }
                        },
                        {
                            "text": "As the storm grew worse, the raindrops started to <w>thicken</w> against the window.",
                            "target_lang_translations": {
                                "ru": "Когда шторм усилился, капли дождя стали <w>чаще</w> бить в окно.",
                                "zh": "随着风暴加剧，雨点开始<w>密集</w>地敲打着窗户。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "thicken blows"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English to describe frequency"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать действия или события более частыми или следующими друг за другом быстрее.",
                        "zh": "使动作或事件发生得更频繁或更紧凑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "учащать",
                                "target_lang_sense_clarification": "делать более частым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加快",
                                "target_lang_sense_clarification": "增加动作频率"
                            },
                            {
                                "target_lang_word": "密集",
                                "target_lang_sense_clarification": "使事件发生得更紧凑"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}