                    {
                        "form_id": "17b8c1fa-7c2d-44f5-b0b1-a4e64337ea16",
                        "entry_id": "cb98766c-8136-3afc-b726-40e05df20763",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "ahuries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e0f0937-e1ce-395e-b5c5-ded9f5791256",
                        "entry_id": "cb98766c-8136-3afc-b726-40e05df20763",
                        "glosses": [
                            "Qui est pantois, stupéfait, déconcerté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d650379f-b944-4b7e-9545-d24ff6675a14",
                                "sense_id": "3e0f0937-e1ce-395e-b5c5-ded9f5791256",
                                "text": "La société [de M. Genès] nous était devenue tout à fait intolérable. […] la mesure était comble, nous en étions ahuris, abrutis."
                            },
                            {
                                "example_id": "2fa4214b-0ade-4ba0-949e-845214c04f76",
                                "sense_id": "3e0f0937-e1ce-395e-b5c5-ded9f5791256",
                                "text": "“Sur ma foi, se dit Passepartout, un peu ahuri tout d’abord, j’ai connu chez Mme Tussaud des bonshommes aussi vivants que mon nouveau maîtr”"
                            }
                        ]
                    },
                    {
                        "sense_id": "39d7065e-ffd5-3b67-9c62-09407d0e202b",
                        "entry_id": "cb98766c-8136-3afc-b726-40e05df20763",
                        "glosses": [
                            "Qui est ou paraît stupide."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "0aea163c-9b5b-49c7-a5fa-d4342232760d",
                                "sense_id": "39d7065e-ffd5-3b67-9c62-09407d0e202b",
                                "text": "Il est complètement ahuri."
                            },
                            {
                                "example_id": "84782eaf-32a8-43e6-a704-738ec9a0029a",
                                "sense_id": "39d7065e-ffd5-3b67-9c62-09407d0e202b",
                                "text": "Ce roi ahuri représente le potentat africain cupide et sanguinaire, livrant ses sujets aux négriers venus du Nord."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
