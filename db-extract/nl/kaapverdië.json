                                    },
                                    {
                                        "sense_id": "9cb2d598-5a8d-36c3-bb43-d26254944783",
                                        "entry_id": "4683b7cf-c37c-3558-834a-cfe8c233dd13",
                                        "glosses": [
                                            "Archipel de l’océan Atlantique Nord, au large des côtes de la Sénégambie et de la Mauritanie."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2720b654-a370-44c8-a363-999bc6cb1ef1",
                                                "sense_id": "9cb2d598-5a8d-36c3-bb43-d26254944783",
                                                "text": "Chacun leur tour, les copilotes dirigent le bateau jusqu’aux Caraïbes, puis vers le Cap-Vert, avant de fendre l’Atlantique vers les Antilles."
                                            },
                                            {
                                                "example_id": "814816b0-f79e-4f0c-b1aa-8a8b777b7db2",
                                                "sense_id": "9cb2d598-5a8d-36c3-bb43-d26254944783",
                                                "text": "Le ciel, clair au départ de Saint-Louis, devient brumeux vers Dakar. Nous apercevons dans un trou le feu de la pointe du Cap-Vert, à 4 heures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05cc5545-fbf3-3d0d-ba0f-5ab6e8b85004",
                                        "entry_id": "4683b7cf-c37c-3558-834a-cfe8c233dd13",
                                        "glosses": [
                                            "Pays occupant cet archipel, ayant pour capitale Praia."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95087502-6dc6-4838-aec9-6ddbdf1cd332",
                                                "sense_id": "05cc5545-fbf3-3d0d-ba0f-5ab6e8b85004",
                                                "text": "Les montagnes volcaniques de l’île de Santiago cernaient la capitale du Cap-Vert, où régnait une chaleur humide et étouffante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
