                "translations": [
                    {
                        "translation_id": "fba82830-8e39-4424-ab38-80f938bf103b",
                        "source_entry_id": "ea11f096-d6e6-3993-bad7-42b687518b7d",
                        "source_sense_id": "ef94f3c9-4d0e-3359-b385-0f7a972e6b0b",
                        "target_lang_word": "wooden",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wooden",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3e17df2-fa9d-332d-a780-a792e24d0816",
                                        "entry_id": "7cec2318-1980-332d-b914-0ce91627383f",
                                        "glosses": [
                                            "Made of wood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c123c779-b92c-428a-85e6-1d9cdf3af628",
                                                "sense_id": "b3e17df2-fa9d-332d-a780-a792e24d0816",
                                                "text": "a wooden boat"
                                            },
                                            {
                                                "example_id": "9a334581-6d22-447d-9aeb-e24e2bf46cd2",
                                                "sense_id": "b3e17df2-fa9d-332d-a780-a792e24d0816",
                                                "text": "On a recent windy day, hundreds of visitors climbed wooden stairs to take pictures in front of the glacier."
                                            },
                                            {
                                                "example_id": "08ad9dbd-4f5d-41e2-abaa-7dc0d554c3e6",
                                                "sense_id": "b3e17df2-fa9d-332d-a780-a792e24d0816",
                                                "text": "There were many wooden chairs for the bulk of his visitors, and two wicker armchairs with red cloth cushions for superior people. From the packing-cases had emerged some Indian clubs,[…], and all these articles[…] made a scattered and untidy decoration that Mrs. Clough assiduously dusted and greatly cherished."
                                            },
                                            {
                                                "example_id": "4295deda-c2bc-4722-8fd0-d4d7196e5a43",
                                                "sense_id": "b3e17df2-fa9d-332d-a780-a792e24d0816",
                                                "text": "Using a tractor fan, shock absorbers, PVC pipes, a bicycle frame and anything else he could lay his hands on, he then built a rudimentary wooden tower, plonked his home-made generator on the top, and eventually got one, and then four bulbs to light up."
                                            },
                                            {
                                                "example_id": "a9497231-fb34-49fd-aa95-09d9a7118c1c",
                                                "sense_id": "b3e17df2-fa9d-332d-a780-a792e24d0816",
                                                "text": "The second and third quarters of the shield are indecipherable on the stone but clearer in two other representations of the arms, a painted wooden funeral hatchment for Mary Davie[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5271525-db74-39f9-ae3a-59cf6cc7cedb",
                                        "entry_id": "7cec2318-1980-332d-b914-0ce91627383f",
                                        "glosses": [
                                            "As if made of wood; moving awkwardly, or speaking with dull lack of emotion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "478d4b19-ff14-4f95-9b48-5f6f773402bc",
                                                "sense_id": "b5271525-db74-39f9-ae3a-59cf6cc7cedb",
                                                "text": "wooden acting"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
