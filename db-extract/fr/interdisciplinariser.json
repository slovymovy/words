                "senses": [
                    {
                        "sense_id": "6f80c26f-e472-3d86-ab96-2bdea6454481",
                        "entry_id": "16850363-ea82-38c2-bbf0-bdc8d8fb8c5e",
                        "glosses": [
                            "Donner un caractère interdisciplinaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "872b6805-21d2-43d5-b116-633ae3a2dc22",
                                "sense_id": "6f80c26f-e472-3d86-ab96-2bdea6454481",
                                "text": "Il y a deux types de changements : ceux internes à ma première phase (démocratiser, interdisciplinariser, intermédiatiser), qui sont ensuite “acquis”, et ceux qui opposent ma seconde phase à la première (révolution de 19861987) : pratique personnelle (abandon du modèle de l'autobiographie unitaire), sociale (APA, gourou), intellectuelle (empirisme)."
                            },
                            {
                                "example_id": "1a58780f-9932-4eb2-ac2d-0d89374c4bf8",
                                "sense_id": "6f80c26f-e472-3d86-ab96-2bdea6454481",
                                "text": "A force de s'interdisciplinariser (sic), les disciplines se noient."
                            },
                            {
                                "example_id": "5114aea3-f679-44ef-b00d-c7d999bc7ab2",
                                "sense_id": "6f80c26f-e472-3d86-ab96-2bdea6454481",
                                "text": "Deuxième idée-force, interdisciplinariser la recherche, et multiplier les partenariats."
                            }
                        ]
                    }
                ],
