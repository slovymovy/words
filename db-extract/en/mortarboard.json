                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3fba8d0-c8d2-418e-bfdf-cdd727766c71",
                        "source_entry_id": "3b538a2b-0f14-3dee-a9b9-4ad878b8ca6b",
                        "source_sense_description": "rectangular board with a handle",
                        "target_lang_word": "соко́л",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "соко́л",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "229e3f73-31fc-3e0c-920d-a1228cc4dc2b",
                                        "entry_id": "5388a54a-821e-3819-89e5-ce2b4f1f8175",
                                        "glosses": [
                                            "зоол., орнитол. хищная птица семейства соколиных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22492136-1bed-44e0-b2e1-20f7b1b67a95",
                                                "sense_id": "229e3f73-31fc-3e0c-920d-a1228cc4dc2b",
                                                "text": "То надобно соседей навестить, // То на охоту ехать с сокола́ми, // То на войну нелёгкая несёт, // Туда, сюда — а дома не сидится."
                                            },
                                            {
                                                "example_id": "374aea84-dd92-4e05-a0a7-ab7c92ded0a0",
                                                "sense_id": "229e3f73-31fc-3e0c-920d-a1228cc4dc2b",
                                                "text": "— Выпускала сокола́ из правого рукава. — Ты лети, лети, соко́л, высоко́ и далеко́."
                                            },
                                            {
                                                "example_id": "bb476a1d-4038-4cef-8410-5969f6bcf557",
                                                "sense_id": "229e3f73-31fc-3e0c-920d-a1228cc4dc2b",
                                                "text": "Благородные соколы, особенно кречет и чеглок, применяются в соколиной охоте."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7da19f52-7c3e-364a-82f5-e84a76ecaecb",
                                        "entry_id": "5388a54a-821e-3819-89e5-ce2b4f1f8175",
                                        "glosses": [
                                            "орнитол. название рода хищных птиц"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbc12244-dfbc-3911-9469-01c4fd4db9d5",
                                        "entry_id": "5388a54a-821e-3819-89e5-ce2b4f1f8175",
                                        "glosses": [
                                            "нар.-поэт., ласк., перен. ласковое обращение к кому-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "004feddc-0ded-4362-b3e1-014cab6372cd",
                                                "sense_id": "cbc12244-dfbc-3911-9469-01c4fd4db9d5",
                                                "text": "Что, говорю, сокол ты мой русый, // Вижу, мол, болит в тебе душа. // Али щи да каша не по вкусу? // Я ль не хороша?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6e036f3-0f40-3b74-8f30-9b165f486353",
                                        "entry_id": "5388a54a-821e-3819-89e5-ce2b4f1f8175",
                                        "glosses": [
                                            "нар.-поэт., ласк., перен. символическое обозначение молодого, удалого красавца"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "753ab361-134b-4216-b646-7a307efec391",
                                                "sense_id": "a6e036f3-0f40-3b74-8f30-9b165f486353",
                                                "text": "— Что ж это они не идут, соколы-то наши?.. Не сходить ли за ними?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "соко́л",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d38c70d3-c68c-30aa-b4a2-300f6a57c867",
                                        "entry_id": "10db73a8-1bc5-3ab6-bbbd-9f9952964355",
                                        "glosses": [
                                            "истор. тяжёлый и большой лом, раскачиваемый на цепях, используемый как стенобитное орудие"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96359d9a-a600-3235-807d-a2fce61f9fe5",
