                "senses": [
                    {
                        "sense_id": "3a2b9689-64da-3c52-bd6c-6459ee3c0401",
                        "entry_id": "0f035231-217d-37d9-b20b-82fdcaba358e",
                        "glosses": [
                            "Person, die in absoluter Abhängigkeit zum Arbeitgeber unter oft unzumutbaren Arbeitsverhältnissen seinen Lebensunterhalt verdient"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "f5211485-ee24-4c78-b6cc-8e6085675678",
                                "sense_id": "3a2b9689-64da-3c52-bd6c-6459ee3c0401",
                                "text": "„Warum Sie Ihren Job jederzeit kündigen können Wenn Sie es leid sind Ihr Dasein als Lohnsklave zu fristen, kündigen Sie noch heute, aber verraten Sie es noch nicht Ihrem Chef.“"
                            },
                            {
                                "example_id": "f2054687-7a39-46a1-ab5d-217265002e59",
                                "sense_id": "3a2b9689-64da-3c52-bd6c-6459ee3c0401",
                                "text": "„Marx wollte nicht als »Lohnsklave« arbeiten und ihm war klar, was das für seine Töchter bedeutete.“"
                            },
                            {
                                "example_id": "8f2c9e09-a185-4dc5-8eaa-8c44bdd83e43",
                                "sense_id": "3a2b9689-64da-3c52-bd6c-6459ee3c0401",
                                "text": "„Aber Lohnsklaven zu besitzen, wie das heute üblich ist, bedeutet praktisch nichts, außer Ärger.“"
                            },
                            {
                                "example_id": "14357c3b-9d1a-438f-911a-504a1a8d62d2",
                                "sense_id": "3a2b9689-64da-3c52-bd6c-6459ee3c0401",
                                "text": "„Der Lohnsklave darf kein Licht sehen, ist konterrevolutionäre Ideologie doch selbstredend Anleitung zum konterrevolutionären Handeln von volksfeindlichen Schmarotzern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
