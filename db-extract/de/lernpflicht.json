                "senses": [
                    {
                        "sense_id": "9bd89c42-c94a-3735-a0f6-2679ef1f2d36",
                        "entry_id": "c1c4d6a9-2630-3044-b717-7857b171abc3",
                        "glosses": [
                            "Vorschrift, nach der jemand bestimmte Dinge lernen muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49881af1-30ee-418c-86bd-245cd0812028",
                                "sense_id": "9bd89c42-c94a-3735-a0f6-2679ef1f2d36",
                                "text": "„In Finnland gibt es keine Schulpflicht, sondern eine Lernpflicht.“"
                            },
                            {
                                "example_id": "57823e17-204d-4b89-ba77-2328a4800a2d",
                                "sense_id": "9bd89c42-c94a-3735-a0f6-2679ef1f2d36",
                                "text": "„Die Pflicht zur Erlernung der jeweils anderen Landessprache ist ständiger Kritik vor allem aus den Reihen der Finnischsprachigen ausgesetzt, insbesondere von Seiten der von der Lernpflicht betroffenen Schüler und Studenten.“"
                            },
                            {
                                "example_id": "126b40a4-d269-4cfd-a55b-4dfb8c66e0aa",
                                "sense_id": "9bd89c42-c94a-3735-a0f6-2679ef1f2d36",
                                "text": "„In Finnland besteht seit 1921 eine allgemeine Lernpflicht.“"
                            },
                            {
                                "example_id": "7073e36d-bb3c-40ba-8ade-9cf2288abae7",
                                "sense_id": "9bd89c42-c94a-3735-a0f6-2679ef1f2d36",
                                "text": "„Die Lernpflicht ist zusätzlich auch noch eine Hauptpflicht des Auszubildenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
