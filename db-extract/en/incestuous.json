                    {
                        "translation_id": "c086c651-9951-4799-ab30-0bb6ac7c9aa9",
                        "source_entry_id": "e40d7074-8599-3db6-861c-6816925b7b0d",
                        "source_sense_description": "pertaining to or engaging in incest",
                        "target_lang_word": "incestueux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incestueux",
