                "senses": [
                    {
                        "sense_id": "348c2ea0-dadd-3f41-83cf-edf05a0f2c96",
                        "entry_id": "cf44f4f1-6efb-388b-bd8d-a6a4bda424cc",
                        "glosses": [
                            "gevoel van afkeer opwekkend"
                        ],
