{
    "word_family": [
        "whisk"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf664aee-ac89-3f15-8956-2d3a998bff61",
                    "sense_definition": "One of the long, stiff hairs growing near the mouth of a cat or other animal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat cleaned its long <w>whiskers</w> after eating.",
                            "target_lang_translations": {
                                "zh": "猫吃完东西后清理了它长长的<w>胡须</w>。"
                            }
                        },
                        {
                            "text": "The kitten twitched its <w>whiskers</w> when it smelled the food.",
                            "target_lang_translations": {
                                "zh": "小猫闻到食物时抖动了它的<w>胡须</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vibrissa"
                    ],
                    "common_phrases": [
                        "cat whiskers"
                    ],
                    "target_lang_definitions": {
                        "zh": "猫或其他动物嘴边长而硬的毛。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "胡须",
                                "target_lang_sense_clarification": "指动物嘴边的长毛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "803953b7-063a-3435-902a-26cde0227bb8",
                    "sense_definition": "Hair growing on the sides of a man's face or chin.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to shave off his <w>whiskers</w> before the interview.",
                            "target_lang_translations": {
                                "zh": "他决定在面试前刮掉他的<w>胡子</w>。"
                            }
                        },
                        {
                            "text": "The old man had grey <w>whiskers</w> on his chin.",
                            "target_lang_translations": {
                                "zh": "老人的下巴上长着灰白的<w>胡子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beard",
                        "stubble"
                    ],
                    "target_lang_definitions": {
                        "zh": "长在男人脸颊或下巴上的毛。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "胡子",
                                "target_lang_sense_clarification": "指人的面部毛发"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8d7ea9b-9a96-3125-8465-e8e2e0d4a1f4",
                    "sense_definition": "A very small distance or amount.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car missed the wall by a <w>whisker</w>.",
                            "target_lang_translations": {
                                "zh": "车子差<w>毫厘</w>就撞到了墙上。"
                            }
                        },
                        {
                            "text": "He came within a <w>whisker</w> of winning the race.",
                            "target_lang_translations": {
                                "zh": "他差<w>毫厘</w>就赢得了比赛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hairbreadth"
                    ],
                    "common_phrases": [
                        "within a whisker"
                    ],
                    "target_lang_definitions": {
                        "zh": "极小的距离或数量。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "毫厘",
                                "target_lang_sense_clarification": "形容极小的差距"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a59c1e9-e967-35b2-b02e-c348863fd390",
                    "sense_definition": "A line in a box plot indicating the range of data outside the central box.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "statistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>whiskers</w> on the box plot show the minimum and maximum values.",
                            "target_lang_translations": {
                                "zh": "箱线图上的<w>须</w>显示了最小值和最大值。"
                            }
                        },
                        {
                            "text": "The data points beyond the <w>whiskers</w> are considered outliers.",
                            "target_lang_translations": {
                                "zh": "超出<w>须</w>的数据点被视为异常值。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "box-and-whisker plot"
                    ],
                    "target_lang_definitions": {
                        "zh": "箱线图中表示数据范围的线条。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "须",
                                "target_lang_sense_clarification": "统计学中箱线图的组成部分"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6dd8f48e-6104-306a-85e5-8c93eb1b5022",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the article is named <w>Whiskers</w>.",
                            "target_lang_translations": {
                                "zh": "这篇文章的作者名叫<w>惠斯克斯</w>。"
                            }
                        },
                        {
                            "text": "Mr. <w>Whiskers</w> arrived at the meeting early.",
                            "target_lang_translations": {
                                "zh": "<w>惠斯克斯</w>先生很早就到了会场。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "惠斯克斯",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}