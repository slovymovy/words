                "senses": [
                    {
                        "sense_id": "f1178d21-60d9-3901-95e2-d5a8aee85de0",
                        "entry_id": "d4fc65cd-c26f-3422-8564-8bc19039f39a",
                        "glosses": [
                            "(meist informell organisierte) Gruppe von Freunden oder Gleichgesinnten, die regelmäßig gemeinsam laufen gehen oder sich im Laufsport engagieren"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1c72c4c5-05db-4896-8d6c-0f31fffb6f21",
                                "sense_id": "f1178d21-60d9-3901-95e2-d5a8aee85de0",
                                "text": "„Und wer sich beim Laufen gleich noch eine Medaille sichern will, kann sich auch bei den vielen Laufevents im Harz anmelden und sich mit den lokalen Laufcrews messen.“"
                            },
                            {
                                "example_id": "1efb27d4-90ea-46e4-b084-3274564950fe",
                                "sense_id": "f1178d21-60d9-3901-95e2-d5a8aee85de0",
                                "text": "„Da ist beispielsweise Júnior Negão, der mit seiner Laufcrew nachts durch die gefährlichen Favelas von Rio läuft und sich nicht einschüchtern lässt.“"
                            },
                            {
                                "example_id": "54be956e-2824-4d2a-8916-59decf4c0c97",
                                "sense_id": "f1178d21-60d9-3901-95e2-d5a8aee85de0",
                                "text": "„Verabrede dich mit deiner Laufcrew oder Laufpartner/-in und geht gemeinsam jeder auf seiner Strecke laufen.“"
                            },
                            {
                                "example_id": "33df4c59-bcb0-4000-9a2c-41ddb9a8e1f1",
                                "sense_id": "f1178d21-60d9-3901-95e2-d5a8aee85de0",
                                "text": "„Unzählige WhatsApp Messages meiner tollen Laufcrew, die uns aus München virtuell begleitet (um genau zu sein 228) motivieren uns während des gesamten Laufes.“"
                            },
                            {
                                "example_id": "072437c9-b09f-4227-80e0-6d5f54a45e06",
                                "sense_id": "f1178d21-60d9-3901-95e2-d5a8aee85de0",
                                "text": "„Daher wird der Global Running Day auch von unglaublich vielen Organisationen und Marken unterstützt, wie beispielsweise den sechs größten Marathons der Welt (Six Majors), vielen Laufcrews aus aller Welt, Marken wie New Balance und Brooks, aber auch kleinere Laufveranstaltungen, Strava und sogar Peloton sind mit unter den Unterstützern des Global Running Day.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
