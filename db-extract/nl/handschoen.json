                                    {
                                        "sense_id": "c517bdf2-110b-33bd-aea1-1f5e443547b2",
                                        "entry_id": "e1ebb98f-39f1-3fba-b7f7-2ba5116ce680",
                                        "glosses": [
                                            "An item of clothing, covering all or part of the hand and fingers, but usually allowing independent movement of the fingers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4ccb3d2-d6eb-4946-80fa-0aab3e930d48",
                                                "sense_id": "c517bdf2-110b-33bd-aea1-1f5e443547b2",
                                                "text": "I wore gloves to keep my hands warm."
                                            },
                                            {
                                                "example_id": "fd0e0a31-4624-4673-bbe7-e7b203ddbe7d",
                                                "sense_id": "c517bdf2-110b-33bd-aea1-1f5e443547b2",
                                                "text": "The boxing champ laced on his gloves before the big bout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "169d5442-2f77-398b-a3dd-dd7b99c35462",
                                        "entry_id": "e1ebb98f-39f1-3fba-b7f7-2ba5116ce680",
                                        "glosses": [
                                            "A baseball mitt."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a0adfb4-6870-3337-b8cc-d9d194d615c4",
                                        "entry_id": "e1ebb98f-39f1-3fba-b7f7-2ba5116ce680",
                                        "glosses": [
                                            "The ability to catch a hit ball."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8996457c-41b1-4616-894f-b105a6f393d9",
                                                "sense_id": "0a0adfb4-6870-3337-b8cc-d9d194d615c4",
                                                "text": "Frederico had a great glove, but he couldn't hit a curveball, so he never broke into the pros."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5185e7db-565e-33cb-9ab8-e0c33b315446",
                                        "entry_id": "e1ebb98f-39f1-3fba-b7f7-2ba5116ce680",
                                        "glosses": [
                                            "A condom."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "196b3534-bc5f-353d-9a48-4fb3717774b5",
                                        "entry_id": "e1ebb98f-39f1-3fba-b7f7-2ba5116ce680",
                                        "glosses": [
                                            "A challenge from one to another."
                                        ],
                                        "tags": [
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32ad293c-001b-462c-8038-099eb94759d9",
                                                "sense_id": "196b3534-bc5f-353d-9a48-4fb3717774b5",
                                                "text": "to throw down the glove, i.e. to offer a challenge; to take up the glove, to accept it"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "glove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b59afba-8e95-3a49-a4cc-7cce2aaf92af",
                                        "entry_id": "21b4ec14-91ac-3490-9a23-514bce0ac631",
                                        "glosses": [
                                            "To catch the ball in a baseball mitt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d5f24e7-b752-433e-97c2-661e49960216",
                                                "sense_id": "6b59afba-8e95-3a49-a4cc-7cce2aaf92af",
                                                "text": "He gloved the line drive for the third out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49042b25-01b9-32f5-bd4a-b60e43fdc541",
                                        "entry_id": "21b4ec14-91ac-3490-9a23-514bce0ac631",
                                        "glosses": [
                                            "To put a glove or gloves on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "420e8fa8-6857-4ef2-8626-a268ea241103",
                                                "sense_id": "49042b25-01b9-32f5-bd4a-b60e43fdc541",
                                                "text": "Maxwell gloved his hand so that he wouldn't leave fingerprints, then pulled the trigger."
                                            },
                                            {
                                                "example_id": "8554ca23-124d-4353-8976-33324cdcdd23",
                                                "sense_id": "49042b25-01b9-32f5-bd4a-b60e43fdc541",
                                                "text": "After the maids had hatted and gloved the girls, the carriage was summoned and I was carted around one church after another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "089c10dd-333a-3364-bb76-842b4af476c9",
                                        "entry_id": "21b4ec14-91ac-3490-9a23-514bce0ac631",
                                        "glosses": [
                                            "To touch (a delivery) with one's glove while the gloved hand is on the bat. Under the rules of cricket, the batsman is deemed to have hit the ball."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ccb53ed-ab25-46ab-ae71-1f1978843f10",
                        "source_entry_id": "56a40b2c-6e73-3475-9104-76f167a64db9",
                        "source_sense_id": "47c194b3-0830-3b4e-8da8-172f08b836c5",
                        "source_sense_description": "een handkledingstuk met aparte vingers",
                        "target_lang_word": "gant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7750be2f-fac9-3351-9fa2-80ab25b43002",
                                        "entry_id": "9fc0c4e3-3b31-3f16-b5f5-bbc908849f94",
                                        "glosses": [
                                            "Objet d’habillement, qui couvre la main et chaque doigt séparément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4ded5d5-efa7-44a8-8128-311d388f5eb3",
                                                "sense_id": "7750be2f-fac9-3351-9fa2-80ab25b43002",
                                                "text": "Les gants fourrés sont plus gros et plus chauds que les autres, parce qu'ils sont garnis au dedans de fourrures fines ou communes."
                                            },
                                            {
                                                "example_id": "5188ab09-a2c5-4da4-90ef-50e72c962335",
                                                "sense_id": "7750be2f-fac9-3351-9fa2-80ab25b43002",
                                                "text": "Une vieille ordonnance pour la création des chevaliers du Bain mentionne entre autres parties du vêtement une paire de gants blancs suspendue à un lacet de soie."
                                            },
                                            {
                                                "example_id": "e4176f28-d6d7-4a20-a36b-c83c3766430a",
                                                "sense_id": "7750be2f-fac9-3351-9fa2-80ab25b43002",
                                                "text": "— Un gant de cardinal en soie rouge avec monogramme du Christ brodé or, xvᵉ siècle.\n— Une paire de gants de haut dignitaire ecclésiastique en tricot de fil avec monogramme du Christ et broderies or et soies de couleur. xviᵉ siècle."
                                            },
                                            {
                                                "example_id": "a811e1c8-092a-4279-8ca1-c9ceb9bd6c8c",
                                                "sense_id": "7750be2f-fac9-3351-9fa2-80ab25b43002",
                                                "text": "L’accabler de pensums, lui tirer les oreilles, c’était se mettre mal avec la maman, une grande coquette qui arrivait au parloir avec une longue robe de soie qui criait et des gants à trois boutons, frais comme du beurre."
                                            },
                                            {
                                                "example_id": "15e5cb71-2f77-4174-8444-1fc9e9822be5",
                                                "sense_id": "7750be2f-fac9-3351-9fa2-80ab25b43002",
                                                "text": "Dans « Remarques sur le rapport de D. Lagache », Lacan donne à penser le corps comme un gant que l'on pourrait retourner, ce qui donne à la peau cette réversibilité à partir des anneaux orificiels : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "686507cf-55fb-39e5-986b-79cb260025d1",
                                        "entry_id": "9fc0c4e3-3b31-3f16-b5f5-bbc908849f94",
                                        "glosses": [
                                            "Objet qui protège la main."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42ac5089-1497-46ea-91ec-c87d90be9694",
                                                "sense_id": "686507cf-55fb-39e5-986b-79cb260025d1",
                                                "text": "Renaud leva ses bras maigres que les gants de six onces garnissaient comme deux paquets de pansement et sourit."
                                            },
                                            {
                                                "example_id": "a7286d19-a4dc-44f1-87b4-4473b1da4d89",
                                                "sense_id": "686507cf-55fb-39e5-986b-79cb260025d1",
                                                "text": "Les travailleurs chargés de l’oxycoupage et leurs aides découpent jour et nuit des plaques d’acier sans masques, vêtements, gants ou chaussures de protection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf14c32-ffa2-3f2b-8e2a-83e2c37d1329",
                                        "entry_id": "9fc0c4e3-3b31-3f16-b5f5-bbc908849f94",
                                        "glosses": [
                                            "Meuble représentant le vêtement du même nom dans les armoiries. Il est généralement représenté en main droite, vu de dessus (pouce à dextre), avec un léger rabat au niveau du poignet pour éviter la confusion avec la main (autre meuble héraldique). À rapprocher de gantelet, main, dextrochère et senestrochère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74ceb296-dcb8-4e66-abaa-ee8917e5017b",
                                                "sense_id": "9bf14c32-ffa2-3f2b-8e2a-83e2c37d1329",
                                                "text": "D’azur à une tour d’argent flanquée de deux gants d’or ; au franc quartier des villes de seconde classe qui est à dextre d’azur à un N d’or, surmonté d’une étoile rayonnante du même, qui est de la commune de Niort des Deux-Sèvres au Premier Empire → voir illustration « armoiries avec 2 gants »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
