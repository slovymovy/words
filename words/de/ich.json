                    "frequency": "Low",
                    "semantic_group_id": "psychologie_philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach Sigmund Freud muss das <w>Ich</w> ständig zwischen den Trieben und den moralischen Normen vermitteln."
                        },
                        {
                            "text": "Ein starkes <w>Ich</w> hilft dem Menschen dabei, innere Konflikte konstruktiv zu bewältigen."
