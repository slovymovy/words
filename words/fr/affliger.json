{
    "word_family": [
        "affliction",
        "affligeant",
        "affligé"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c8f0cdc7-1295-32b4-b025-26925b185528",
                    "sense_definition": "Causer une vive peine morale, attrister profondément quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chagrin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette terrible nouvelle vient d'<w>affliger</w> toute la famille réunie pour la fête."
                        },
                        {
                            "text": "Son départ précipité <w>afflige</w> profondément tous ses anciens collègues de travail."
                        }
                    ],
                    "synonyms": [
                        "attrister",
                        "chagriner",
                        "désoler"
                    ],
                    "antonyms": [
                        "réjouir",
                        "consoler"
                    ],
                    "common_phrases": [
                        "affliger profondément"
                    ]
                },
                {
                    "sense_id": "5a27e1e5-116c-322f-85c3-bdc8f391234a",
                    "sense_definition": "Éprouver un profond chagrin ou se désoler face à une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chagrin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas s'<w>affliger</w> sans raison face à de petits échecs quotidiens."
                        },
                        {
                            "text": "Le vieil homme s'<w>affligeait</w> de voir ses amis disparaître les uns après les autres."
                        }
                    ],
                    "synonyms": [
                        "s'attrister",
                        "se chagriner",
                        "se désoler"
                    ],
                    "antonyms": [
                        "se réjouir"
                    ]
                },
                {
                    "sense_id": "5b41d760-317a-387a-915f-821a2d0262fe",
                    "sense_definition": "Frapper un lieu ou une population de fléaux, de misères ou d'épidémies.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "calamite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une terrible sécheresse continue d'<w>affliger</w> cette région depuis plus de six mois."
                        },
                        {
                            "text": "Les guerres civiles <w>affligent</w> le pays et détruisent les récoltes des paysans."
                        }
                    ],
                    "synonyms": [
                        "accabler",
                        "frapper",
                        "ravager"
                    ],
                    "antonyms": [
                        "épargner"
                    ]
                },
                {
                    "sense_id": "428fe35a-25bf-3593-a1b8-fadb9689b36a",
                    "sense_definition": "Faire souffrir physiquement, mortifier le corps ou tourmenter par une infirmité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "souffrance_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le moine choisit d'<w>affliger</w> son corps par de longues privations et des jeûnes."
                        },
                        {
                            "text": "Ce patient est <w>affligé</w> d'une maladie rare qui paralyse peu à peu ses jambes."
                        }
                    ],
                    "synonyms": [
                        "mortifier",
                        "tourmenter"
                    ],
                    "antonyms": [
                        "soulager"
                    ],
                    "common_phrases": [
                        "affliger son corps",
                        "être affligé d'un mal"
                    ]
                }
            ]
        }
    ]
}