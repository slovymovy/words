                "senses": [
                    {
                        "sense_id": "a0c8ae73-9e7b-32d9-a89e-69ab54de1775",
                        "entry_id": "18d951f4-5bce-3cf1-a50d-b8654b93174d",
                        "glosses": [
                            "учение о почерке, исследование его с точки зрения отражающихся в нем психических состояний, характера и других индивидуальных особенностей пишущего"
                        ],
                        "tags": [],
