                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d12c17e4-3db0-3d6a-b228-1cf84637c8a5",
                        "entry_id": "e36d5a0c-602c-3524-b72e-82eeedad6267",
                        "glosses": [
                            "Schwätzer, Klatschweib, Plappermaul"
                        ],
                        "tags": [],
