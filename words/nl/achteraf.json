{
    "word_family": [
        "achter",
        "achterna",
        "achterop",
        "achteruit"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7aa5fc21-9aa8-305b-8585-3883f7263f9c",
                    "sense_definition": "na afloop van een gebeurtenis of met de kennis van later",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Achteraf</w> is het makkelijk praten over wat er fout is gegaan.",
                            "target_lang_translations": {
                                "en": "It is easy to talk about what went wrong <w>in hindsight</w>."
                            }
                        },
                        {
                            "text": "We dachten dat het zou regenen, maar <w>achteraf</w> bleek het een zonnige dag te zijn.",
                            "target_lang_translations": {
                                "en": "We thought it would rain, but <w>afterwards</w> it turned out to be a sunny day."
                            }
                        }
                    ],
                    "synonyms": [
                        "naderhand"
                    ],
                    "antonyms": [
                        "vooraf",
                        "van tevoren"
                    ],
                    "common_phrases": [
                        "achteraf praten",
                        "achteraf bekeken"
                    ],
                    "target_lang_definitions": {
                        "en": "after an event has occurred or with the benefit of hindsight"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "afterwards",
                                "target_lang_sense_clarification": "at a later time"
                            },
                            {
                                "target_lang_word": "in hindsight",
                                "target_lang_sense_clarification": "looking back on an event"
                            },
                            {
                                "target_lang_word": "after the fact",
                                "target_lang_sense_clarification": "after something has happened"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48dd79c3-140c-3d18-9d60-30a20ff45fa1",
                    "sense_definition": "op een afgelegen of onopvallende plaats, ver van het centrum of de groep",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "locatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verlegen man stond altijd wat <w>achteraf</w> de wereld te observeren.",
                            "target_lang_translations": {
                                "en": "The shy man always stood somewhat <w>in the background</w> observing the world."
                            }
                        },
                        {
                            "text": "Zij wonen in een klein huisje dat een beetje <w>achteraf</w> op het terrein staat.",
                            "target_lang_translations": {
                                "en": "They live in a small cottage that is situated a bit <w>out of the way</w> on the property."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wat achteraf staan",
                        "een beetje achteraf"
                    ],
                    "target_lang_definitions": {
                        "en": "in a remote, secluded, or inconspicuous place away from the center"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "out of the way",
                                "target_lang_sense_clarification": "remote or secluded"
                            },
                            {
                                "target_lang_word": "in the background",
                                "target_lang_sense_clarification": "not prominent or central"
                            },
                            {
                                "target_lang_word": "secluded",
                                "target_lang_sense_clarification": "hidden away from others"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}