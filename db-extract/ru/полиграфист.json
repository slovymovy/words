                        "sense_id": "ea4d50c6-e70f-3e3d-b78a-f839d4170a5f",
                        "entry_id": "b88c3ac4-0502-31e7-91ac-4ce69dd8f5bf",
                        "glosses": [
                            "специалист по полиграфии, тот, кто занимается полиграфией"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c260705c-8c12-47e1-a2cd-a0dbc560871c",
                                "sense_id": "ea4d50c6-e70f-3e3d-b78a-f839d4170a5f",
                                "text": "Улучшаются условия труда полиграфистов: нет свинца — нет и свинцового отравления."
                            },
                            {
                                "example_id": "67fac256-5f10-45ea-94d1-7e890b558e25",
                                "sense_id": "ea4d50c6-e70f-3e3d-b78a-f839d4170a5f",
                                "text": "Но, мне, полиграфисту по образованию, не составляет труда отличить высокую печать от любой плоской (именно её разновидности применяются для факсимильной печати)."
                            }
                        ]
                    }
