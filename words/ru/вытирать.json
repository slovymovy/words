{
    "word_family": [
        "вытереть",
        "вытирание",
        "вытираться",
        "тереть",
        "протирать",
        "обтирать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a9acfd5-4d4f-377b-bbc9-5f197859c8fd",
                    "sense_definition": "Проводя тканью или салфеткой по поверхности, делать её чистой или сухой.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "очищение_трением",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После мытья посуды брат аккуратно <w>вытирает</w> тарелки сухим полотенцем.",
                            "target_lang_translations": {
                                "it": "Dopo aver lavato i piatti, mio fratello <w>asciuga</w> con cura i piatti con un canovaccio asciutto."
                            }
                        },
                        {
                            "text": "Мальчик помыл руки с мылом и начал <w>вытирать</w> их салфеткой.",
                            "target_lang_translations": {
                                "it": "Il bambino si è lavato le mani con il sapone e ha iniziato ad <w>asciugarle</w> con un tovagliolo."
                            }
                        }
                    ],
                    "synonyms": [
                        "протирать",
                        "очищать"
                    ],
                    "antonyms": [
                        "загрязнять"
                    ],
                    "common_phrases": [
                        "вытирать руки",
                        "вытирать посуду",
                        "вытирать стол"
                    ],
                    "target_lang_definitions": {
                        "it": "Rendere pulita o asciutta una superficie passandovi sopra un panno, una salvietta o un asciugamano."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "asciugare",
                                "target_lang_sense_clarification": "togliere l'umidità con un panno o asciugamano"
                            },
                            {
                                "target_lang_word": "pulire",
                                "target_lang_sense_clarification": "rendere pulito strofinando"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7afc9f37-7e68-35b8-acce-ea228051dae6",
                    "sense_definition": "Удалять грязь, пыль, влагу или слёзы с какой-либо поверхности трением.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "очищение_трением",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждое утро мама тщательно <w>вытирает</w> пыль со всех полок в гостиной.",
                            "target_lang_translations": {
                                "it": "Ogni mattina la mamma <w>spolvera</w> con cura tutti i ripiani del soggiorno."
                            }
                        },
                        {
                            "text": "Девочка тихо плакала в углу и <w>вытирала</w> слёзы рукавом кофты.",
                            "target_lang_translations": {
                                "it": "La bambina piangeva in silenzio nell'angolo e si <w>asciugava</w> le lacrime con la manica della felpa."
                            }
                        }
                    ],
                    "synonyms": [
                        "стирать",
                        "протирать"
                    ],
                    "common_phrases": [
                        "вытирать пыль",
                        "вытирать слёзы",
                        "вытирать пот"
                    ],
                    "target_lang_definitions": {
                        "it": "Rimuovere polvere, sporco, umidità o lacrime mediante sfregamento."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "spolverare",
                                "target_lang_sense_clarification": "togliere la polvere"
                            },
                            {
                                "target_lang_word": "asciugare",
                                "target_lang_sense_clarification": "togliere lacrime, sudore o umidità"
                            },
                            {
                                "target_lang_word": "tergere",
                                "target_lang_sense_clarification": "pulire o asciugare con delicatezza (formale o letterario)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5771f3e-9964-3ede-9f4f-a6983f7e27e6",
                    "sense_definition": "Изнашивать ткань или одежду трением, делая её потёртой.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "износ",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он постоянно опирается на стол и тем самым <w>вытирает</w> рукава нового свитера.",
                            "target_lang_translations": {
                                "it": "Si appoggia costantemente al tavolo e in questo modo <w>consuma</w> le maniche del maglione nuovo."
                            }
                        },
                        {
                            "text": "Ребёнок часто ползает по ковру и быстро <w>вытирает</w> ткань на коленях брюк.",
                            "target_lang_translations": {
                                "it": "Il bambino gattona spesso sul tappeto e <w>logora</w> rapidamente il tessuto sulle ginocchia dei pantaloni."
                            }
                        }
                    ],
                    "synonyms": [
                        "протирать"
                    ],
                    "common_phrases": [
                        "вытирать локти",
                        "вытирать колени"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Consumare o logorare tessuti e vestiti a causa del continuo sfregamento."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "consumare",
                                "target_lang_sense_clarification": "logorare per attrito"
                            },
                            {
                                "target_lang_word": "logorare",
                                "target_lang_sense_clarification": "rovinare o consumare un tessuto sfregandolo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}