    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a66fa80a-ab8f-3718-8f87-202db70abb8b",
                    "sense_definition": "A metal object used to open or close a lock.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "locking_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot find my house <w>keys</w> anywhere in my bag.",
                            "target_lang_translations": {
                                "ru": "Я нигде в сумке не могу найти свои <w>ключи</w> от дома."
                            }
                        },
                        {
                            "text": "He turned the <w>key</w> in the lock and opened the heavy door.",
                            "target_lang_translations": {
                                "ru": "Он повернул <w>ключ</w> в замке и открыл тяжелую дверь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "car key",
                        "house key",
                        "spare key",
                        "bunch of keys"
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлический предмет, используемый для открывания или закрывания замка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ключ",
                                "target_lang_sense_clarification": "для замка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b27a0f7d-9c18-3d26-9392-211dfcc2f23d",
                    "sense_definition": "A button on a computer keyboard or typewriter.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "input_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Press the enter <w>key</w> to submit your information.",
                            "target_lang_translations": {
                                "ru": "Нажмите <w>клавишу</w> ввода, чтобы отправить информацию."
                            }
                        },
                        {
                            "text": "The escape <w>key</w> is located in the top left corner.",
                            "target_lang_translations": {
                                "ru": "<w>Клавиша</w> escape находится в верхнем левом углу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "arrow key",
                        "function key",
                        "press a key",
                        "escape key"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кнопка на клавиатуре компьютера или пишущей машинке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клавиша",
                                "target_lang_sense_clarification": "на клавиатуре"
                            },
                            {
                                "target_lang_word": "кнопка",
                                "target_lang_sense_clarification": "на устройстве ввода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01810dd6-1d7a-3a6b-8010-5569d1afa973",
                    "sense_definition": "A crucial step, requirement, or solution to a problem.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "abstract_solution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hard work is the <w>key</w> to success in any career.",
                            "target_lang_translations": {
                                "ru": "Упорный труд — это <w>залог</w> успеха в любой карьере."
                            }
                        },
                        {
                            "text": "The <w>key</w> to solving this mystery lies in the old diary.",
                            "target_lang_translations": {
                                "ru": "<w>Ключ</w> к разгадке этой тайны кроется в старом дневнике."
                            }
                        }
                    ],
                    "common_phrases": [
                        "key to success",
                        "key to happiness",
                        "the key factor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Решающий шаг, требование или решение проблемы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ключ",
                                "target_lang_sense_clarification": "к решению или успеху"
                            },
                            {
                                "target_lang_word": "залог",
                                "target_lang_sense_clarification": "успеха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3381569a-7198-38a8-b7fd-540531a41d00",
                    "sense_definition": "One of the levers on a piano or organ that is pressed to produce a sound.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "musical_interface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The piano has eighty-eight black and white <w>keys</w>.",
                            "target_lang_translations": {
                                "ru": "У пианино восемьдесят восемь черных и белых <w>клавиш</w>."
                            }
                        },
                        {
                            "text": "She gently pressed the piano <w>keys</w> to play a soft melody.",
                            "target_lang_translations": {
                                "ru": "Она мягко нажимала на <w>клавиши</w> пианино, играя нежную мелодию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "piano keys",
                        "black keys",
                        "white keys"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из рычагов на пианино или органе, на который нажимают для извлечения звука."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клавиша",
                                "target_lang_sense_clarification": "музыкального инструмента"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b961e444-e85e-33c7-9738-b71f6960943f",
                    "sense_definition": "A list of correct answers for a test or exercise.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reference_guide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher checked the answer <w>key</w> to grade the exams.",
                            "target_lang_translations": {
                                "ru": "Учитель сверился с <w>ключом</w> к ответам, чтобы проверить экзамены."
                            }
                        },
                        {
                            "text": "You can find the answer <w>key</w> at the back of the textbook.",
                            "target_lang_translations": {
                                "ru": "Вы можете найти <w>ответы</w> в конце учебника."
                            }
                        }
                    ],
                    "common_phrases": [
                        "answer key",
                        "test key"
                    ],
                    "target_lang_definitions": {
                        "ru": "Список правильных ответов к тесту или упражнению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ключ",
                                "target_lang_sense_clarification": "с ответами"
                            },
                            {
                                "target_lang_word": "ответы",
                                "target_lang_sense_clarification": "к заданиям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8581c471-d6d7-37fa-a25b-89b044743e54",
                    "sense_definition": "A system of notes based on a particular note, used as the basis of a musical piece.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "musical_theory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This symphony was written in the <w>key</w> of C major.",
                            "target_lang_translations": {
                                "ru": "Эта симфония была написана в <w>тональности</w> до мажор."
                            }
                        },
                        {
                            "text": "The singer asked the band to change the <w>key</w> to suit her voice.",
                            "target_lang_translations": {
                                "ru": "Певица попросила группу сменить <w>тональность</w>, чтобы она подходила под её голос."
                            }
                        }
                    ],
                    "common_phrases": [
                        "major key",
                        "minor key",
                        "in the key of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система нот, основанная на определенной ноте, используемая в качестве основы музыкального произведения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тональность",
                                "target_lang_sense_clarification": "музыкальная"
                            },
                            {
                                "target_lang_word": "лад",
                                "target_lang_sense_clarification": "строй музыки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6144c6a-6203-3a06-9b2d-9afe0653e5e0",
                    "sense_definition": "A list of symbols and their meanings, especially on a map.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reference_guide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Check the map <w>key</w> to see what the different colors represent.",
                            "target_lang_translations": {
                                "ru": "Посмотрите на <w>легенду</w> карты, чтобы узнать, что означают разные цвета."
                            }
                        },
                        {
                            "text": "The <w>key</w> explains that the dotted line indicates a hiking trail.",
                            "target_lang_translations": {
                                "ru": "В <w>условных обозначениях</w> поясняется, что пунктирная линия указывает на пешеходную тропу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "map key",
                        "legend key"
                    ],
                    "target_lang_definitions": {
                        "ru": "Список символов и их значений, особенно на карте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легенда",
                                "target_lang_sense_clarification": "карты или схемы"
                            },
                            {
                                "target_lang_word": "условные обозначения",
                                "target_lang_sense_clarification": "пояснение к карте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dde327f7-432e-32a4-87ed-929c2c9660c7",
                    "sense_definition": "A code or password used to encrypt or decrypt data.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "security",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need a digital <w>key</w> to access the encrypted files.",
                            "target_lang_translations": {
                                "ru": "Вам нужен цифровой <w>ключ</w> для доступа к зашифрованным файлам."
                            }
                        },
                        {
                            "text": "The software requires a unique product <w>key</w> for activation.",
                            "target_lang_translations": {
                                "ru": "Программному обеспечению требуется уникальный <w>ключ</w> продукта для активации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "encryption key",
                        "security key",
                        "product key"
                    ],
                    "target_lang_definitions": {
                        "ru": "Код или пароль, используемый для шифрования или дешифрования данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ключ",
                                "target_lang_sense_clarification": "шифрования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4abd68a3-cdea-33f0-8197-40a7aba60f64",
                    "sense_definition": "A small, low-lying island or reef, especially in the West Indies or Florida.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent our summer vacation exploring the Florida <w>Keys</w>.",
                            "target_lang_translations": {
                                "ru": "Мы провели летний отпуск, исследуя <w>острова</w> Флорида-Кис."
                            }
                        },
                        {
                            "text": "The boat sailed past several small <w>keys</w> in the turquoise water.",
                            "target_lang_translations": {
                                "ru": "Лодка проплыла мимо нескольких маленьких <w>островков</w> в бирюзовой воде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Florida Keys"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in the Caribbean and Florida"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой низменный остров или риф, особенно в Вест-Индии или Флориде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "риф",
                                "target_lang_sense_clarification": "коралловый остров"
                            },
                            {
                                "target_lang_word": "островок",
                                "target_lang_sense_clarification": "небольшой остров"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44acc6b3-b4f5-3cfa-9698-0f4b6b4f67b0",
                    "sense_definition": "A kilogram, specifically of an illegal drug.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police seized ten <w>keys</w> of cocaine during the raid.",
                            "target_lang_translations": {
                                "ru": "Во время рейда полиция изъяла десять <w>килограммов</w> кокаина."
                            }
                        },
                        {
                            "text": "He was caught trying to smuggle several <w>keys</w> across the border.",
                            "target_lang_translations": {
                                "ru": "Его поймали при попытке провезти несколько <w>кило</w> через границу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ten keys"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in criminal or drug-related contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Килограмм, обычно применительно к запрещенным веществам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кило",
                                "target_lang_sense_clarification": "сленг, килограмм"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "378faa52-e7db-3c7b-9810-e0440e411a97",
                    "sense_definition": "Extremely important or necessary.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Education is a <w>key</w> factor in reducing poverty worldwide.",
                            "target_lang_translations": {
                                "ru": "Образование является <w>ключевым</w> фактором в борьбе с бедностью во всем мире."
                            }
                        },
                        {
                            "text": "She made several <w>key</w> points during her presentation today.",
                            "target_lang_translations": {
                                "ru": "Сегодня во время своей презентации она отметила несколько <w>основных</w> моментов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "key player",
                        "key role",
                        "key element",
                        "key feature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно важный или необходимый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ключевой",
                                "target_lang_sense_clarification": "очень важный"
                            },
                            {
                                "target_lang_word": "основной",
                                "target_lang_sense_clarification": "главный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98f89879-bc44-36df-8e6f-e832f8f667f2",
                    "sense_definition": "Indispensable or supremely important.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is the <w>key</w> player on his soccer team this season.",
                            "target_lang_translations": {
                                "ru": "В этом сезоне он <w>ведущий</w> игрок в своей футбольной команде."
                            }
                        },
                        {
                            "text": "The enemy is moving troops through a <w>key</w> area of the forest.",
                            "target_lang_translations": {
                                "ru": "Противник перебрасывает войска через <w>важнейший</w> участок леса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "key position",
                        "key area",
                        "key attraction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незаменимый или в высшей степени важный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "важнейший",
                                "target_lang_sense_clarification": "первостепенный"
                            },
                            {
                                "target_lang_word": "ведущий",
                                "target_lang_sense_clarification": "главный в группе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "721f71ec-7b13-3346-a35e-3f517ae1d1c9",
                    "sense_definition": "To enter information into a computer using a keyboard.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "data_entry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>key</w> in your password to unlock the device.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>введите</w> свой пароль, чтобы разблокировать устройство."
                            }
                        },
                        {
                            "text": "The clerk had to <w>key</w> the data into the system manually.",
                            "target_lang_translations": {
                                "ru": "Клерку пришлось <w>вводить</w> данные в систему вручную."
                            }
                        }
                    ],
                    "common_phrases": [
                        "key in",
                        "key data"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вводить информацию в компьютер с помощью клавиатуры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вводить",
                                "target_lang_sense_clarification": "данные с клавиатуры"
                            },
                            {
                                "target_lang_word": "набирать",
                                "target_lang_sense_clarification": "текст или код"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "093dc7c1-9633-3911-b260-ac6afda6603e",
                    "sense_definition": "To scratch the paint of a car using a key as an act of vandalism.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vandalism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was furious when he found that someone had <w>keyed</w> his new car.",
                            "target_lang_translations": {
                                "ru": "Он был в ярости, когда обнаружил, что кто-то <w>поцарапал</w> его новую машину."
                            }
                        },
                        {
                            "text": "The teenager was caught trying to <w>key</w> the principal's vehicle.",
                            "target_lang_translations": {
                                "ru": "Подростка поймали, когда он пытался <w>поцарапать</w> машину директора."
                            }
                        }
                    ],
                    "common_phrases": [
                        "key a car"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поцарапать краску автомобиля ключом в качестве акта вандализма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "царапать",
                                "target_lang_sense_clarification": "ключом машину"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "fa45214f-b316-3e8e-9397-75088f142355",
                    "sense_definition": "A common English surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Francis Scott <w>Key</w> wrote the lyrics to the American national anthem.",
                            "target_lang_translations": {
                                "ru": "Фрэнсис Скотт <w>Ки</w> написал слова к американскому государственному гимну."
                            }
                        },
                        {
                            "text": "The professor introduced Dr. <w>Key</w> as the guest speaker.",
                            "target_lang_translations": {
                                "ru": "Профессор представил доктора <w>Ки</w> в качестве приглашенного докладчика."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ки",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}