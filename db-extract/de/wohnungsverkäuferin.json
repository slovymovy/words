                "senses": [
                    {
                        "sense_id": "9a7282b3-5e87-3e6f-b282-44ff3859bf0b",
                        "entry_id": "5de19a94-7faf-357e-9a9c-f7cb75806b2c",
                        "glosses": [
                            "weibliche Person oder Firma, die eine Wohnung verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02adb19e-b442-4fb1-a70e-90f250d4edd9",
                                "sense_id": "9a7282b3-5e87-3e6f-b282-44ff3859bf0b",
                                "text": "„Ansprüche des Wohnungskäufers wegen dieses Rechtsmangels können nicht mit der Begründung verneint werden, der Wohnungskäufer habe die Kausalität zwischen der behaupteten unterlassenen Aufklärung über die Sozialbindung durch die Wohnungsverkäuferin und seinem Kaufentschluss nicht dargelegt.“"
                            },
                            {
                                "example_id": "37eadfab-4d00-46e8-bdf2-8d8581e55bfe",
                                "sense_id": "9a7282b3-5e87-3e6f-b282-44ff3859bf0b",
                                "text": "„Der BGH-Anwalt der Wohnungsverkäuferin erwiderte, man müsse sich durch drei Anlagen kämpfen.“"
                            },
                            {
                                "example_id": "7091af54-9954-409d-8785-2a50f3284524",
                                "sense_id": "9a7282b3-5e87-3e6f-b282-44ff3859bf0b",
                                "text": "„Gesellschafter der GmbH waren der Gatte der Wohnungsverkäuferin sowie die Schwester und der Vater des Bw. Letzterer fungierte auch als Geschäftsführer der Gesellschaft.“"
                            },
                            {
                                "example_id": "a3356fd6-fc90-44cc-a465-15aa3137dea8",
                                "sense_id": "9a7282b3-5e87-3e6f-b282-44ff3859bf0b",
                                "text": "„Der Ehemann der Projektbetreiberin und Wohnungsverkäuferin arbeitet als Bauaufsicht bei der Stadt Schleswig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
