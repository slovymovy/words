                        "source_sense_id": "bd6930c4-10fe-3ca8-a518-f53ba7b1f5ef",
                        "source_sense_description": "umgangssprachlich: die Kanone, das Ass, der Knüller, der Leistungsträger",
                        "target_lang_word": "Kanone",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
