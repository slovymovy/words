                                            {
                                                "example_id": "02cbc5c1-7857-4d3b-99dd-a329e3cb6b6d",
                                                "sense_id": "4067395c-53bb-3453-a3f6-ff4e17cd0ade",
                                                "text": "Gerald's special mixture of laziness and ambition seemed to crystallize under the camera into brutal bumptiousness."
                                            }
                                        ]
