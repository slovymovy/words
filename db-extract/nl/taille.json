                                            "Cintura."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9ddd40f-2e48-43ef-a5b2-f1351c2f91c8",
                                                "sense_id": "3b7f61f7-36a7-3c11-ad5c-df7c78213443",
                                                "text": "Apenas si alcancé a oír el chapaleo de los cascos de un caballo cuando me sentí asida por el talle, arrebatada del suelo. Eras tú, Ricardo."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
