                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "submersion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fortes averses d'automne ont complètement <w>noyé</w> les champs voisins."
                        },
                        {
                            "text": "Elle avait les yeux <w>noyés</w> de larmes en apprenant cette terrible nouvelle."
                        }
                    ],
                    "synonyms": [
