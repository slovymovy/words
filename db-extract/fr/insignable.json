                        "sense_id": "67d1f91b-1b42-3859-8e72-8ae65f1965ea",
                        "entry_id": "e0e4aa20-3a2f-35ef-bcd4-8f9aed8d2bb1",
                        "glosses": [
                            "Que l’on ne peut pas ou que l’on ne doit pas signer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa17a5bf-6bff-40c9-83f1-e5cad825ad1b",
                                "sense_id": "67d1f91b-1b42-3859-8e72-8ae65f1965ea",
                                "text": "L’occasion pour les salariés de l’Afdaim de qualifier à nouveau l’accord d’«insignable, avec la conséquence de profonds déséquilibres pour les professionnels et un impact sur la prise en charge des usagers»."
                            },
                            {
                                "example_id": "cd7bf018-5d7c-4851-bc0e-7eddf462827c",
                                "sense_id": "67d1f91b-1b42-3859-8e72-8ae65f1965ea",
                                "text": "\"Cet appel, il était insignable pour nous, très clairement\", a déclaré pour sa part vendredi sur RTL le secrétaire général de la CFDT, Laurent Berger. \"Moi je ne signe jamais sans avoir lu.\""
                            },
                            {
                                "example_id": "2005a69c-8168-4b4f-99be-9ccb496259e0",
                                "sense_id": "67d1f91b-1b42-3859-8e72-8ae65f1965ea",
                                "text": "On va nous faire passer pour de mauvais bougres qui se lèvent de la table de négociation. Mais c’est insignable. D’ailleurs, une large majorité des fédérations n’a pas signé."
                            }
                        ]
                    }
