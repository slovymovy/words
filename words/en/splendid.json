            "senses": [
                {
                    "sense_id": "74366927-177e-34d0-beb8-101b5ac8f8d3",
                    "sense_definition": "Very good, excellent, or of a very high standard.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That is a <w>splendid</w> idea for our next holiday.",
                            "target_lang_translations": {
                                "ru": "Это <w>замечательная</w> идея для нашего следующего отпуска.",
                                "nl": "Dat is een <w>schitterend</w> idee voor onze volgende vakantie."
                            }
                        },
                        {
                            "text": "She did a <w>splendid</w> job organizing the charity event.",
                            "target_lang_translations": {
                                "ru": "Она проделала <w>превосходную</w> работу по организации благотворительного мероприятия.",
                                "nl": "Ze heeft <w>uitstekend</w> werk geleverd bij het organiseren van het liefdadigheidsevenement."
                            }
                        }
                    ],
                    "synonyms": [
