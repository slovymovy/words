                "senses": [
                    {
                        "sense_id": "ffce2bc4-73e4-3802-b303-6d24f7c0ae83",
                        "entry_id": "40475c38-2601-3c41-9a31-3ed433056141",
                        "glosses": [
                            "Donner un caractère gnostique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baa310e6-dd0a-4aca-ac9c-0c5b5337a1d5",
                                "sense_id": "ffce2bc4-73e4-3802-b303-6d24f7c0ae83",
                                "text": "Il s’agit de « gnosticiser » la doctrine d’Origène, pour en faire un repoussoir."
                            },
                            {
                                "example_id": "b01d7917-3897-4639-b1db-004587f113c5",
                                "sense_id": "ffce2bc4-73e4-3802-b303-6d24f7c0ae83",
                                "text": "Parmi tous les mouvements contemporains qui gnosticisent la figure de Jésus, mention particulière doit être faite de l'Association Métano’r’a, fondée en 1974 en vue d’approfondir et de promouvoir l’Evangile selon Thomas, exhumé trente ans plus tôt."
                            }
                        ]
                    }
