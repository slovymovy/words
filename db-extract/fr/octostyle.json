                        "glosses": [
                            "Qui a huit colonnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e19b54a6-d6c9-43bb-bf26-e0bf77bd89da",
                                "sense_id": "fa47e090-3310-3320-81df-4d33adae9cdc",
                                "text": "Temple, façade octostyle."
                            },
                            {
                                "example_id": "9f7375dd-fa2b-4ca0-b47c-a53cf048b307",
                                "sense_id": "fa47e090-3310-3320-81df-4d33adae9cdc",
                                "text": "Cette pièce représente à gauche un monument octostyle, dont les colonnes libres et les arceaux à plein cintre supportent un dôme étagé ; à droite, un groupe est formé par saint Pierre tenant les clefs de la main droite, et, devant lui, un personnage, vraisemblablement l’artisan du monument."
                            }
                        ]
                    }
                ],
