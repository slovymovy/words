                "senses": [
                    {
                        "sense_id": "c37f569f-70e6-3604-a8de-a1a0f8bbdd95",
                        "entry_id": "7ce484b5-15bd-38b0-8215-e8250bda050d",
                        "glosses": [
                            "to be exhausted (by), to break down (with), to grow faint (from)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8719f01a-be53-4022-aa1c-479571a603af",
                                "sense_id": "c37f569f-70e6-3604-a8de-a1a0f8bbdd95",
                                "text": "он изнемога́ет от жары́",
                                "translation": "the heat has exhausted him; he can't stand/bear the heat",
                                "english": "the heat has exhausted him; he can't stand/bear the heat"
                            },
                            {
                                "example_id": "aed49a2c-4750-4ac6-93e3-f964b3dddc16",
                                "sense_id": "c37f569f-70e6-3604-a8de-a1a0f8bbdd95",
                                "text": "он изнемога́ет от уста́лости",
                                "translation": "he is dead tired; he is dead beat",
                                "english": "he is dead tired; he is dead beat"
                            },
                            {
                                "example_id": "3d88a06f-a348-4226-b2b6-d2c928d31d78",
                                "sense_id": "c37f569f-70e6-3604-a8de-a1a0f8bbdd95",
                                "text": "изнемога́ть под тя́жестью",
                                "translation": "to grow faint under a weight",
                                "english": "to grow faint under a weight"
                            }
                        ]
                    }
                ],
