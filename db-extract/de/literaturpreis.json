                "senses": [
                    {
                        "sense_id": "e42e8755-7bc7-3240-b9fa-cacf284e6dee",
                        "entry_id": "7e1a0019-c04c-3fc5-a2fb-958b98597691",
                        "glosses": [
                            "Preis für besondere Leistungen auf dem Gebiet der Literatur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7530531a-e0f5-45bd-9ae9-5d35c561a516",
                                "sense_id": "e42e8755-7bc7-3240-b9fa-cacf284e6dee",
                                "text": "Der französische Schriftsteller Sully Prudhomme hatte als erster Franzose den Literaturpreis von der Nobelkommission übergeben bekommen."
                            },
                            {
                                "example_id": "775fe24a-4184-4147-a8f9-c5b2dc7ab891",
                                "sense_id": "e42e8755-7bc7-3240-b9fa-cacf284e6dee",
                                "text": "„Bekannte Autoren sind nützlich für das Prestige eines Literaturpreises und des Ortes, an dem er vergeben wird.“"
                            },
                            {
                                "example_id": "efd10238-97c1-4297-a547-d0b47195be57",
                                "sense_id": "e42e8755-7bc7-3240-b9fa-cacf284e6dee",
                                "text": "„Einen Literaturpreis hat das Volk der Dichter und Denker seinem international meistgelesenen lebenden Autor auch in seinen letzten Lebensjahren nicht gegönnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
