                                        "glosses": [
                                            "ботан. растение семейства тыквенных, бахчевая культура"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66ab6e0a-700a-49e4-ba1c-1a681ed7c931",
                                                "sense_id": "886db381-95a8-3986-ac91-79491c6aa42b",
                                                "text": "При выращивании рассады дыни и арбуза к каждому растению надо поставить опору в виде прутика длиной 50‒⁠60 см."
                                            }
                                        ]
                                    },
