                "translations": [
                    {
                        "translation_id": "d69ac27a-f00f-4743-9f94-e23e69d98945",
                        "source_entry_id": "f2e1778d-6736-3b1a-87d2-45ad97216a50",
                        "source_sense_id": "1e05e761-ba68-3006-a896-96bd2ae99e2b",
