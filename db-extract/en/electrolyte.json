                                        "sense_id": "f2d64d45-ab5b-3855-87c0-de21b131c33c",
                                        "entry_id": "a11517d3-2286-348f-9047-8b9e409c052b",
                                        "glosses": [
                                            "een stof of mengsel van stoffen gekenmerkt door het bezit van uitsluitend ionische geleidbaarheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21a46488-019b-49a2-a2ca-f16690369031",
                                                "sense_id": "f2d64d45-ab5b-3855-87c0-de21b131c33c",
                                                "text": "De vaste verbinding RbAg₄I₅ is een kristallijn elektrolyt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f54b36f6-d699-4b29-b2f3-3189c517a74e",
                        "source_entry_id": "5d88c287-6bf3-3675-b819-685cd495a402",
                        "source_sense_description": "substance that ionizes and conducts electricity",
                        "target_lang_word": "électrolyte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "électrolyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ade53add-d7ed-3b49-bb10-84fa75625b0e",
                                        "entry_id": "dae296f0-4cb6-33b5-9801-7bdc3595bd6e",
                                        "glosses": [
                                            "Milieu conducteur ionique."
                                        ],
                                        "tags": [
                                            "Électrochimie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a24d74ae-3939-4b91-814f-f90da3c6e50a",
                                                "sense_id": "ade53add-d7ed-3b49-bb10-84fa75625b0e",
                                                "text": "Quelle est au juste la nature du travail électrochimique qui se produit dans l’électrolyte, il est difficile de le dire, on en est réduit à des conjectures."
                                            },
                                            {
                                                "example_id": "a4e8fda9-e669-4f80-950f-f794f713d1a9",
                                                "sense_id": "ade53add-d7ed-3b49-bb10-84fa75625b0e",
                                                "text": "– Son régime alimentaire était devenu tout un truc. Il prononçait des mots comme électrolytes, indices glycémiques et acides aminés. Il fallait qu’elle lui fasse de la viande à tous les repas. C’était un gouffre, sa gonflette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0494e687-1482-4d1d-83f5-386a0e00484d",
                        "source_entry_id": "5d88c287-6bf3-3675-b819-685cd495a402",
                        "source_sense_description": "substance that ionizes and conducts electricity",
                        "target_lang_word": "Elektrolyt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elektrolyt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3cc1d7b8-7cd2-312b-9859-ade9464dc468",
                                        "entry_id": "d18bf0de-4e22-397d-87ca-c34b731ebbc8",
                                        "glosses": [
                                            "„chemische Verbindung, die im festen, flüssigen oder gelösten Zustand in Ionen dissoziiert ist und die sich unter dem Einfluss eines elektrischen Feldes gerichtet bewegt“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "562ca239-85a8-4433-bf15-def94ef9cda2",
                                                "sense_id": "3cc1d7b8-7cd2-312b-9859-ade9464dc468",
                                                "text": "Eine Forschungsgruppe hat einen Elektrolyten entwickelt, der den Bau von Magnesium-Schwefel-Batteriezellen ermöglicht."
                                            },
                                            {
                                                "example_id": "97c09e92-6752-482e-a2eb-4223c8019b13",
                                                "sense_id": "3cc1d7b8-7cd2-312b-9859-ade9464dc468",
                                                "text": "In der Zeitschrift „Advanced Energy Materials“ stellt die Forschungsgruppe den neuen Elektrolyten vor."
                                            },
                                            {
                                                "example_id": "da07f1cc-b3aa-4cb7-a301-41f6496d3ea0",
                                                "sense_id": "3cc1d7b8-7cd2-312b-9859-ade9464dc468",
                                                "text": "Der Körper kann Elektrolyte nicht selbst herstellen, daher muss er sie in ausreichender Menge über Getränke und Lebensmittel zu sich nehmen."
                                            },
                                            {
                                                "example_id": "3c740614-8f03-48cc-ad01-1ec14ae54fc9",
                                                "sense_id": "3cc1d7b8-7cd2-312b-9859-ade9464dc468",
                                                "text": "Hormone die im Gehirn, der Schilddrüse und der Nebenniere gebildet werden, regeln die Konzentration der Elektrolyte."
                                            },
                                            {
                                                "example_id": "1bcb44c1-2470-45c8-baae-2cfa9b6fcdf6",
                                                "sense_id": "3cc1d7b8-7cd2-312b-9859-ade9464dc468",
                                                "text": "Ein erhöhter Bedarf an Elektrolyten kann aber auch durch z. B. übermäßiges Schwitzen bei starker körperlicher Aktivität, Sport oder Hitzewallungen in den Wechseljahren entstehen. Auf eine ausreichende Zufuhr von Elektrolyten sollte also geachtet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
