                    {
                        "translation_id": "df074e29-0ea3-4114-b0b4-e5f2ccf59393",
                        "source_entry_id": "046c3e6f-6330-36b0-85df-87763b249a64",
                        "source_sense_description": "предварительное суждение, догадка о чём-либо",
                        "target_lang_word": "assumption",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assumption",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "708feb96-0a75-3057-ab2a-7ee40ffd92e6",
                                        "entry_id": "8ed82770-be05-34e7-979d-2a23ebc1b427",
                                        "glosses": [
                                            "The act of assuming, or taking to or upon oneself; the act of taking up or adopting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e5c4fb7-f05e-438a-9c6a-ecb6a5ab2cde",
                                                "sense_id": "708feb96-0a75-3057-ab2a-7ee40ffd92e6",
                                                "text": "His assumption of secretarial duties was timely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7029f88-14ed-3b20-858c-a3f86407efb7",
                                        "entry_id": "8ed82770-be05-34e7-979d-2a23ebc1b427",
                                        "glosses": [
                                            "The act of taking for granted, or supposing a thing without proof; a supposition; an unwarrantable claim."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32cd102b-771f-4725-a691-1ac0c7696e41",
                                                "sense_id": "b7029f88-14ed-3b20-858c-a3f86407efb7",
                                                "text": "Their assumption of his guilt disqualified them from jury duty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aedeaa8-205f-30ca-9dde-e23a9686a283",
                                        "entry_id": "8ed82770-be05-34e7-979d-2a23ebc1b427",
                                        "glosses": [
                                            "The thing supposed; a postulate, or proposition assumed; a supposition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c81435d-bee7-4cbd-a359-dd05de08a1a7",
                                                "sense_id": "6aedeaa8-205f-30ca-9dde-e23a9686a283",
                                                "text": "No doubt a finite evaluative argument must make some unargued evaluative assumptions, just as finite factual arguments must make some unargued factual assumptions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "133271ca-6cc1-3c61-845a-f9355fb5773a",
                                        "entry_id": "8ed82770-be05-34e7-979d-2a23ebc1b427",
                                        "glosses": [
                                            "The minor or second proposition in a categorical syllogism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44bb15ab-2a3e-3cf4-8139-f4e582d1fcf6",
                                        "entry_id": "8ed82770-be05-34e7-979d-2a23ebc1b427",
                                        "glosses": [
                                            "The taking of a person up into heaven."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b6efe08-fc88-43fa-ae75-fe031497d9ff",
                                                "sense_id": "44bb15ab-2a3e-3cf4-8139-f4e582d1fcf6",
                                                "text": "Of vvhat texte thou proveſt hell / vvill a nother prove purgatory / a nother lymbo patrum / and a nother the aſſumpcion of oure ladi: And a nother ſhall prove of the ſame texte that an Ape hath a tayle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceddb90a-f11a-3928-b514-c38d44f0cfb2",
                                        "entry_id": "8ed82770-be05-34e7-979d-2a23ebc1b427",
                                        "glosses": [
                                            "A festival in honor of the ascent of the Virgin Mary into heaven, celebrated on 15 August."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19571afe-4a2c-3799-a0a8-c22c0d8a7e78",
                                        "entry_id": "8ed82770-be05-34e7-979d-2a23ebc1b427",
                                        "glosses": [
                                            "Assumptio."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86c76187-5c26-4563-9250-9d006c1b3027",
                        "source_entry_id": "046c3e6f-6330-36b0-85df-87763b249a64",
                        "source_sense_description": "предварительное суждение, догадка о чём-либо",
                        "target_lang_word": "supposition",
