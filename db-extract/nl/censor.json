                ],
                "senses": [
                    {
                        "sense_id": "c734fb76-2588-340e-932f-b419bbd5ad87",
                        "entry_id": "088019bb-587d-3385-8cbb-cf4461575751",
                        "glosses": [
                            "een hoge ambtenaar met absolute macht in de Romeinse republiek"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "1529e714-2e35-4728-8c13-8ccfe016cdd5",
                                "sense_id": "c734fb76-2588-340e-932f-b419bbd5ad87",
                                "text": "Een censor hield onder meer toezicht op het zedelijk gedrag van de burgers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "109c397b-6fe3-4e06-a9b3-53117433e8da",
                        "source_entry_id": "088019bb-587d-3385-8cbb-cf4461575751",
                        "source_sense_id": "c734fb76-2588-340e-932f-b419bbd5ad87",
                        "source_sense_description": "hoge ambtenaar in de Romeinse republiek",
                        "target_lang_word": "Zensor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zensor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3df82a7f-b140-333f-ad4e-f34b16597f7d",
                                        "entry_id": "b5fc8f6c-376b-3316-9820-f3842bd7b186",
                                        "glosses": [
                                            "Person, die in staatlichem Auftrag Informationskontrolle (Zensur) ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf9b8e90-8f10-4586-83b0-545f05a936db",
                                                "sense_id": "3df82a7f-b140-333f-ad4e-f34b16597f7d",
                                                "text": "„Bot die Financial Times ihren Lesern eine Besprechung des Musicals Cabaret mit Foto, schwärzten Zensoren Beine und Arme der Tänzerinnen in jedem importierten Exemplar.“"
                                            },
                                            {
                                                "example_id": "f8a7c1f8-7195-4355-939d-da0281957c38",
                                                "sense_id": "3df82a7f-b140-333f-ad4e-f34b16597f7d",
                                                "text": "„Im Theater konnten Aufführungen schon allein aus dem Grunde verboten werden, weil ein aufmerksamer Zensor im Bühnenbild ein »Gartenbänkchen deutschen Typs« entdeckte.“"
                                            },
                                            {
                                                "example_id": "6dfa9093-4826-42cf-be4b-a667adb01629",
                                                "sense_id": "3df82a7f-b140-333f-ad4e-f34b16597f7d",
                                                "text": "„Obwohl der Text vom Berliner Zensor barbarisch verstümmelt worden war, verblieb ihm jene unverwüstliche Kraft, die die Inszenierung zur Sensation machte.“"
                                            },
                                            {
                                                "example_id": "d1bc1720-4df2-4405-b9d3-de47af9225e3",
                                                "sense_id": "3df82a7f-b140-333f-ad4e-f34b16597f7d",
                                                "text": "„Sie mußten den Zensor täuschen und trotzdem vom Leser »richtig« verstanden werden.“"
                                            },
                                            {
                                                "example_id": "63b46570-2156-4086-890e-5cdef081ef34",
                                                "sense_id": "3df82a7f-b140-333f-ad4e-f34b16597f7d",
                                                "text": "„Kein Wunder, dass eine derartige Möglichkeit die Zensoren zu Kriegszeiten erschreckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "590ef284-9bcc-3d9b-92cb-c560bf0916d8",
                                        "entry_id": "b5fc8f6c-376b-3316-9820-f3842bd7b186",
                                        "glosses": [
                                            "römisches Amt, das für Volks- und Vermögenszählung (Zensus) zuständig war sowie als Sittenwächter fungierte"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d71d372b-7486-4fcf-aca0-040e9f90af1b",
                                                "sense_id": "590ef284-9bcc-3d9b-92cb-c560bf0916d8",
                                                "text": "„Die römischen Zensoren erhoben die Daten, die erforderlich waren, um die Bürger in die Stimmkörper und militärischen Einheiten einzugruppieren, aber an einer weitergehenden statistischen Auswertung war niemand interessiert.“"
                                            },
                                            {
                                                "example_id": "ddfa1257-389f-4449-b0d4-9de47fb8e3f8",
                                                "sense_id": "590ef284-9bcc-3d9b-92cb-c560bf0916d8",
                                                "text": "„Der Prinzeps steht vorne und zitiert aus einer mehr als 100 Jahre alten Rede des einstigen Zensors Caecilius Metellus Macedonicus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d28e4207-57f2-4413-b2cb-22933e28c29d",
                        "source_entry_id": "088019bb-587d-3385-8cbb-cf4461575751",
                        "source_sense_id": "c734fb76-2588-340e-932f-b419bbd5ad87",
                        "source_sense_description": "hoge ambtenaar in de Romeinse republiek",
                        "target_lang_word": "censor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "censor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d81b0775-4167-3d1b-84d0-aa1f97e5b3e0",
                                        "entry_id": "b7bd1358-eeaf-3a1b-bbbf-9e4ad2210bc3",
                                        "glosses": [
                                            "One of the two magistrates who originally administered the census of citizens, and by Classical times (between the 8th century B.C.E. and the 6th century C.E.) was a high judge of public behaviour and morality."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46736314-ce35-4c2d-9ca9-0976e4eea1a0",
                                                "sense_id": "d81b0775-4167-3d1b-84d0-aa1f97e5b3e0",
                                                "text": "The Ancient Roman censors were part of the cursus honorum, a series of public offices held during a political career, like consuls and praetors."
                                            },
                                            {
                                                "example_id": "dae93169-6971-40eb-ac81-f33479ed3637",
                                                "sense_id": "d81b0775-4167-3d1b-84d0-aa1f97e5b3e0",
                                                "text": "And Nobly nam'd, ſo twice being Cenſor, / Was his great Anceſtor."
                                            },
                                            {
                                                "example_id": "32bfc0d1-7a8b-4a0c-ac66-33f71badc231",
                                                "sense_id": "d81b0775-4167-3d1b-84d0-aa1f97e5b3e0",
                                                "text": "Neither [the Segetes Lustrantur and the Oves Lustrantur] are in this place, to be underſtood the Luſtra, which were wont to be Celebrated at Rome by the Cenſors, after the Cenſus of Citizens was made by a Sacrifice of the Suovetaurilia; for they had ceaſed long ago, as appeareth by what Cenſorinus writeth in his Book de Die Natali; at which time the Office of Cenſors also ceaſed, which ſome endeavoured, though in vain, to re-eſtabliſh."
                                            },
                                            {
                                                "example_id": "fb3d28b4-bbeb-48f5-ad0e-4b6ab1231a54",
                                                "sense_id": "d81b0775-4167-3d1b-84d0-aa1f97e5b3e0",
                                                "text": "[page 110] [Justus] Lipſius divides the Duty of the Cenſors into two Heads; the Survey of the People, and the Cenſure of Manners. […] With respect to the latter part of their Office, they had the power to puniſh an Immorality in any Perſon, of what Order ſoever. […] [page 111] 'Tis very remarkable, that if one of the Cenſors died, no body was ſubſtituted in his room 'till the next Luſtrum, and his Partner was oblig'd to quit his Office; becauſe the Death of a Cenſor happen'd juſt before the ſacking of Rome by the Gauls, and was ever after accounted highly ominous and unfortunate."
                                            },
                                            {
                                                "example_id": "f8cbcefd-2d71-4aca-86e4-2224f49f8579",
                                                "sense_id": "d81b0775-4167-3d1b-84d0-aa1f97e5b3e0",
                                                "text": "At the head of his victorious legions, in his reign over the ſea and land, from the Nile and Euphrates to the Atlantic ocean, Auguſtus proclaimed himſelf the ſervant of the ſtate and the equal of his fellow-citizens. The conqueror of Rome and her provinces aſſumed the popular and legal form of a cenſor, a conſul, and a tribune."
                                            },
                                            {
                                                "example_id": "74284848-d6cc-41a8-94ab-98e41705076a",
                                                "sense_id": "d81b0775-4167-3d1b-84d0-aa1f97e5b3e0",
                                                "text": "The Censors were always two in number, and were originally chosen from the Patricians exclusively. In B.C. 351, we find for the first time a Plebeian Censor, G[aius] Marcius Rutilus. In B.C. 339, a Lex Publilia was passed by Q[uintus] Publilius Philo when Dictator, enacting that at least one of the Censors must be a Plebeian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "127bf48d-2dc2-3858-b4fb-5344ab2d249a",
                                        "entry_id": "b7bd1358-eeaf-3a1b-bbbf-9e4ad2210bc3",
                                        "glosses": [
                                            "A high-ranking official who was responsible for the supervision of subordinate government officials."
                                        ],
                                        "tags": [
                                            "Ancient-China",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69ad70ae-b835-3956-b2bd-f63637a78a6e",
                                        "entry_id": "b7bd1358-eeaf-3a1b-bbbf-9e4ad2210bc3",
                                        "glosses": [
                                            "An official responsible for the removal or suppression of objectionable material (for example, if obscene or likely to incite violence) or sensitive content in books, films, correspondence, and other media."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fdedfda-715e-4794-b02b-57c0758d178a",
                                                "sense_id": "69ad70ae-b835-3956-b2bd-f63637a78a6e",
                                                "text": "The headmaster was an even stricter censor of his boarding pupils’ correspondence than the enemy censors had been of his own when the country was occupied."
                                            },
                                            {
                                                "example_id": "9e789459-c65b-4607-bb8b-4895758d9e3d",
                                                "sense_id": "69ad70ae-b835-3956-b2bd-f63637a78a6e",
                                                "text": "There being a censor of public morals I will refrain from giving that worthy warrior's reply when he had digested this astounding piece of information; it is sufficient to say that it did not encourage further conversation, nor did it soothe our hero's nerves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8e78c43-d4e6-34f1-90a5-eecaae5e57a9",
                                        "entry_id": "b7bd1358-eeaf-3a1b-bbbf-9e4ad2210bc3",
                                        "glosses": [
                                            "A college or university official whose duties vary depending on the institution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afab5d8a-e1f9-48c9-bb3a-04ad1cd9eb7e",
                                                "sense_id": "d8e78c43-d4e6-34f1-90a5-eecaae5e57a9",
                                                "text": "During his [Theophilus Higgons's] reſidence in the ſaid houſe [Christ Church, Oxford], he was eſteemed a Perſon to be much ſtained with Puritaniſme, and to be violent againſt all ſuch that were ſuſpected to favour the Romiſh See. When he was Cenſor alſo, he was ſo zealous as to ſaw down a harmleſs maypole ſtanding within the precincts of the ſaid houſe, becauſe forſooth he thought it came out of a Romiſh Foreſt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68815c02-9501-35bd-932b-7162aa703bec",
                                        "entry_id": "b7bd1358-eeaf-3a1b-bbbf-9e4ad2210bc3",
                                        "glosses": [
                                            "One who censures or condemns."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86771f4a-6165-4b4f-9217-f712e7546f1d",
                                                "sense_id": "68815c02-9501-35bd-932b-7162aa703bec",
                                                "text": "Why that character [of the English Revolution] was so peculiar is sufficiently obvious, and yet seems not to have been always understood either by eulogists or by censors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f537036e-929b-3d8b-b0e3-8a6f659a1789",
                                        "entry_id": "b7bd1358-eeaf-3a1b-bbbf-9e4ad2210bc3",
                                        "glosses": [
                                            "An algorithm that approves or rejects something on grounds of taste or morality etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c4eda42-46bf-4f77-89d4-55e0d6828633",
                                                "sense_id": "f537036e-929b-3d8b-b0e3-8a6f659a1789",
                                                "text": "I tried using a dirty word as my user name for the online game, but the censor rejected it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "censor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cacf3440-0fb7-32ba-8d39-45f0d15b01aa",
                                        "entry_id": "943b41e9-c30f-323f-8e01-8bda277905c7",
                                        "glosses": [
                                            "To review for, and if necessary to remove or suppress, content from books, films, correspondence, and other media which is regarded as objectionable (for example, obscene, likely to incite violence, or sensitive)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bc4da18-0c88-4d43-91c4-a3dc0a7eb134",
                                                "sense_id": "cacf3440-0fb7-32ba-8d39-45f0d15b01aa",
                                                "text": "The people responsible for censoring films have seen some startling things in their time."
                                            },
                                            {
                                                "example_id": "1e6abbb0-b234-4392-bc3d-370c31e49418",
                                                "sense_id": "cacf3440-0fb7-32ba-8d39-45f0d15b01aa",
                                                "text": "Occupying powers typically censor anything reeking of resistance"
                                            },
                                            {
                                                "example_id": "9a7ff00f-5565-41a7-b0d8-dfb3b9323da5",
                                                "sense_id": "cacf3440-0fb7-32ba-8d39-45f0d15b01aa",
                                                "text": "Ganley is in hourly dread of every message that comes into your wireless-room. He insists on censoring anything that might betray him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5fa9f63-a37e-3014-a623-ab77bcc0c6c8",
                                        "entry_id": "943b41e9-c30f-323f-8e01-8bda277905c7",
                                        "glosses": [
                                            "To partially obscure an observation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47e32023-b5e4-4138-a1f6-097ca37092fc",
                                                "sense_id": "b5fa9f63-a37e-3014-a623-ab77bcc0c6c8",
                                                "text": "Early dropout is one cause of right-censoring."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "censor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2405f284-4d48-3adb-a0ec-3afc62dc17fb",
                                        "entry_id": "ff4c4061-019c-39be-bbc3-fadd3e2863c4",
                                        "glosses": [
                                            "A hypothetical subconscious agency which filters unacceptable thought before it reaches the conscious mind."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "266e4c22-6bcc-4244-972e-5d31b9c7abc2",
                        "source_entry_id": "088019bb-587d-3385-8cbb-cf4461575751",
                        "source_sense_id": "c734fb76-2588-340e-932f-b419bbd5ad87",
                        "source_sense_description": "hoge ambtenaar in de Romeinse republiek",
                        "target_lang_word": "censeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "censeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5b58153-eed5-3957-9e17-c2ddc16b130f",
                                        "entry_id": "5c087589-e8c2-3a8e-a4ae-bc4c118af100",
                                        "glosses": [
                                            "Magistrat romain chargé d’établir le cens, c’est-à-dire le recensement des citoyens, le contrôle de l’état de leur fortune, et la légitimité de leur appartenance à telle ou telle classe (sénatoriale ou équestre)."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dd78bd6-a6de-4d0b-a212-f61590b0b790",
                                                "sense_id": "e5b58153-eed5-3957-9e17-c2ddc16b130f",
                                                "text": "Caton le censeur était réputé pour sa rigueur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bad7018-4b32-34d1-b9fa-6eaeb7ff8ccd",
                                        "entry_id": "5c087589-e8c2-3a8e-a4ae-bc4c118af100",
                                        "glosses": [
                                            "Envieux qui reprend ou qui contrôle les actions d’autrui, sans pour autant être le moins du monde qualifié pour ça. Casse-pied qui trouve à redire à tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75d29d98-7957-4275-b5da-a6d76865fd40",
                                                "sense_id": "6bad7018-4b32-34d1-b9fa-6eaeb7ff8ccd",
                                                "text": "J'offre ici aux moralistes une occasion facile de triompher de moi. Mes censeurs s'apprêtent à montrer dans mon malheur les suites d'un égarement, le résultat d'un excès : il m'est d'autant plus difficile de les contredire que je vois mal en quoi consiste l'égarement, et où se situe l'excès. Je m'efforce de ramener mon crime, si c'en est un, à des proportions justes : […]."
                                            },
                                            {
                                                "example_id": "ab1b34f8-6fcd-4879-b13c-c4d3f03ace6d",
                                                "sense_id": "6bad7018-4b32-34d1-b9fa-6eaeb7ff8ccd",
                                                "text": "Un censeur doux et équitable est rare."
                                            },
                                            {
                                                "example_id": "847e3bf6-2b78-4aa5-a051-f6f732cf2f47",
                                                "sense_id": "6bad7018-4b32-34d1-b9fa-6eaeb7ff8ccd",
                                                "text": "Un censeur rigoureux, obtus, partial, illettré, incompétent, complaisant, complice."
                                            },
                                            {
                                                "example_id": "1df22785-6ce8-4748-b9b3-010a22625eec",
                                                "sense_id": "6bad7018-4b32-34d1-b9fa-6eaeb7ff8ccd",
                                                "text": "Le censeur des opinions ou du travail de quelqu’un."
                                            },
                                            {
                                                "example_id": "88fcaf5e-79ce-4c04-ae87-da16d7104a47",
                                                "sense_id": "6bad7018-4b32-34d1-b9fa-6eaeb7ff8ccd",
                                                "text": "Censeur rigoureux d’autrui, indulgent à soi-même."
                                            },
                                            {
                                                "example_id": "1a9cd503-d596-4c0b-bb0f-b62c77164da8",
                                                "sense_id": "6bad7018-4b32-34d1-b9fa-6eaeb7ff8ccd",
                                                "text": "Si l’on y songe bien, il n’est pas étonnant que l’ignorant se drape en censeur."
                                            },
                                            {
                                                "example_id": "8d9ee8c3-f0aa-4f07-a6ad-29242e71fc0c",
                                                "sense_id": "6bad7018-4b32-34d1-b9fa-6eaeb7ff8ccd",
                                                "text": "Ah ! quittez d’un censeur la triste diligence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2d05935-1a49-3685-825e-3835dc3eae48",
                                        "entry_id": "5c087589-e8c2-3a8e-a4ae-bc4c118af100",
                                        "glosses": [
                                            "Personne qu’un gouvernement prépose à l’examen des livres, des journaux, des pièces de théâtre, etc., avant d’en permettre la publication ou la représentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83df8cfa-7ccd-474a-800b-4a9f4b292cea",
                                                "sense_id": "b2d05935-1a49-3685-825e-3835dc3eae48",
                                                "text": "Sous l’ancien régime, avec l’approbation d’un censeur, — qu’il était permis de choisir, — on était sûr de pouvoir sans danger produire ses idées, et la liberté dont on jouissait était extraordinaire quelquefois."
                                            },
                                            {
                                                "example_id": "3740287f-ae39-4d09-a0ec-898c56b10cdc",
                                                "sense_id": "b2d05935-1a49-3685-825e-3835dc3eae48",
                                                "text": "Le censeur refusa son approbation."
                                            },
                                            {
                                                "example_id": "00c7df1b-6a23-4d11-8231-cebd6ceb5655",
                                                "sense_id": "b2d05935-1a49-3685-825e-3835dc3eae48",
                                                "text": "On lui donna un censeur très sévère."
                                            },
                                            {
                                                "example_id": "6c26dfc6-9826-4497-ba8c-12d9f2063d59",
                                                "sense_id": "b2d05935-1a49-3685-825e-3835dc3eae48",
                                                "text": "Censeur des pièces de théâtre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87773f89-5bca-370c-bde4-6ba01ca7bf83",
                                        "entry_id": "5c087589-e8c2-3a8e-a4ae-bc4c118af100",
                                        "glosses": [
                                            "Personne chargée de surveiller les études et de maintenir le bon ordre et la discipline dans un lycée en tant qu’adjoint du proviseur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4a876d2-6d2c-4722-a385-b6dea2941846",
                                                "sense_id": "87773f89-5bca-370c-bde4-6ba01ca7bf83",
                                                "text": "M. le censeur prétendait qu’ils s’exaltaient mutuellement. Cependant, si Frédéric travailla dans les hautes classes, ce fut par les exhortations de son ami ; []"
                                            },
                                            {
                                                "example_id": "f0b421e6-f0f8-40c8-a4dc-eda58383b85f",
                                                "sense_id": "87773f89-5bca-370c-bde4-6ba01ca7bf83",
                                                "text": "Le censeur de l’internat nous était mieux connu. Il n’avait pas de guêtres, et il était petit. De plus, pendant la récréation de midi et demi, c’est lui qui faisait appeler dans son cabinet les zéros de conduite, pour leur administrer une homélie, et tirer les conséquences pénitentiaires de ce fâcheux incident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "401c6036-c625-374f-a7f1-fe76fd0c30a7",
                                        "entry_id": "5c087589-e8c2-3a8e-a4ae-bc4c118af100",
                                        "glosses": [
                                            "Personne chargée de contrôler la partie financière de certains établissements ou de certaines sociétés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02150593-ed3e-4069-a917-ce42af3e51c0",
                                                "sense_id": "401c6036-c625-374f-a7f1-fe76fd0c30a7",
                                                "text": "Les censeurs de la Banque de France."
                                            },
                                            {
                                                "example_id": "b5de1f94-5443-4f1c-a613-53b50367554a",
                                                "sense_id": "401c6036-c625-374f-a7f1-fe76fd0c30a7",
                                                "text": "Cette société vient d’élire de nouveaux censeurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70f0889d-d8b5-3f78-ac18-66fd4f128b4a",
                                        "entry_id": "5c087589-e8c2-3a8e-a4ae-bc4c118af100",
                                        "glosses": [
                                            "Critique qui juge des œuvres littéraires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebd765cd-a60b-4677-9c7b-639495d5d121",
                                                "sense_id": "70f0889d-d8b5-3f78-ac18-66fd4f128b4a",
                                                "text": "Consulter un censeur éclairé avant de publier un recueil de poésie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
