                "senses": [
                    {
                        "sense_id": "c914762e-535a-3c56-a3c8-2c43ba621012",
                        "entry_id": "7bb1f8f7-f1ab-3c8f-9bb2-eaadea698bdb",
                        "glosses": [
                            "ultimate, ne plus ultra, the very best (of something)"
                        ],
                        "tags": [
                            "humorous",
                            "neuter",
