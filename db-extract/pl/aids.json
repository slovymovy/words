                                "target_senses": [
                                    {
                                        "sense_id": "2bd0f17e-d265-30bd-8010-4062a106dfda",
                                        "entry_id": "1030db30-8baf-3011-a8a7-3087a845a5ef",
                                        "glosses": [
                                            "aus einer Infektion mit dem HI-Virus resultierende Summe von Erkrankungen (sogenannte \\\"AIDS definierende Erkrankungen\\\"), die als \\\"AIDS Vollbild\\\" (umgangssprachlich kurz: AIDS) zusammengefasst werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7973785-71d1-451e-8cf9-b7012245de67",
                                                "sense_id": "2bd0f17e-d265-30bd-8010-4062a106dfda",
                                                "text": "Die unheilbare Krankheit AIDS hat schon unzählige Menschenleben gefordert, vor allem in Südafrika."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "642af528-d61d-4270-8b5c-e4869476ea72",
                        "source_entry_id": "7adac1af-c396-316c-bbfc-83ec175ab97d",
                        "source_sense_id": "288aec54-c55a-3d49-a27e-f28b93c1a85e",
                        "target_lang_word": "Aids",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aids",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b071aa03-7be1-3d73-9ebe-c66ef3ecf704",
                                        "entry_id": "02f1501b-d5ad-387a-a0f9-0905e13b39da",
                                        "glosses": [
                                            "Immunschwächekrankheit AIDS durch Infektion mit dem HI-Virus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d39fe3dc-96f1-4e58-b92e-adc3d68496a0",
                                                "sense_id": "b071aa03-7be1-3d73-9ebe-c66ef3ecf704",
                                                "text": "Aids ist eine weltweit verbreitete, unheilbare Krankheit, die jährlich viele Todesopfer fordert."
                                            },
                                            {
                                                "example_id": "6b388dc5-e85a-4b0f-8416-47d98db3020d",
                                                "sense_id": "b071aa03-7be1-3d73-9ebe-c66ef3ecf704",
                                                "text": "„Aids, da ist der Gottesmann sich sicher, ist die Pestilenz, mit der der allmächtige Herr all jene straft, die sich von ihm abgewandt haben.“"
                                            },
                                            {
                                                "example_id": "3cbdb69a-28d7-45f5-b2c6-7d8752639a11",
                                                "sense_id": "b071aa03-7be1-3d73-9ebe-c66ef3ecf704",
                                                "text": "„Allerdings hat es wahrscheinlich was mit Aids zu tun.“"
                                            },
                                            {
                                                "example_id": "b80b71ed-4e0e-43c9-be38-e4a5926dbcfd",
                                                "sense_id": "b071aa03-7be1-3d73-9ebe-c66ef3ecf704",
                                                "text": "„Dieser furchtbare Zustand wiederholte sich, als Aids als Krankheit bekannt wurde.“"
                                            },
                                            {
                                                "example_id": "bd8492ca-507f-4517-bb27-4652a91ee867",
                                                "sense_id": "b071aa03-7be1-3d73-9ebe-c66ef3ecf704",
                                                "text": "„Allerdings ist HIV medial nicht deswegen so ein großes Thema, weil so viele Menschen daran sterben, sondern weil viele Prominente an Aids erkranken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0afcadc-cc2e-4ab8-8d8c-1ab79f92743e",
                        "source_entry_id": "7adac1af-c396-316c-bbfc-83ec175ab97d",
                        "source_sense_id": "288aec54-c55a-3d49-a27e-f28b93c1a85e",
                        "target_lang_word": "СПИД",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "СПИД",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8461dc88-0a58-3992-ba0d-b7cb3fe8b64e",
                                        "entry_id": "90f634e9-369d-37a8-a937-deebb96b6bb7",
                                        "glosses": [
                                            "мед., сокр. от синдром приобретённого иммунодефицита"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5955e04-c536-44f0-9060-f0f322777a45",
                                                "sense_id": "8461dc88-0a58-3992-ba0d-b7cb3fe8b64e",
                                                "text": "Биологам известны мутации, которые позволяют отсрочить момент, когда ВИЧ вызовет в организме СПИД."
                                            },
                                            {
                                                "example_id": "09a4f5e9-dd1a-4506-8806-0128296a48c2",
                                                "sense_id": "8461dc88-0a58-3992-ba0d-b7cb3fe8b64e",
                                                "text": "В 1982 году у него появились признаки саркомы Капоши, часто встречающейся у больных СПИДом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cf53c73-f0f6-3f41-8de6-676cce797425",
                                        "entry_id": "90f634e9-369d-37a8-a937-deebb96b6bb7",
                                        "glosses": [
                                            "неправ. то же, что ВИЧ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fb0d39a-58c8-4290-afe9-4b8917856575",
                                                "sense_id": "2cf53c73-f0f6-3f41-8de6-676cce797425",
                                                "text": "Об инфицированных СПИДом снято множество фильмов, наших и зарубежных."
                                            },
                                            {
                                                "example_id": "6d1363f7-11fe-4fec-ac2d-445c0f2469b9",
                                                "sense_id": "2cf53c73-f0f6-3f41-8de6-676cce797425",
                                                "text": "Всем было начхать на опасность заражения СПИДом, гепатитами, ГЛПС и прочим."
                                            },
                                            {
                                                "example_id": "ff966219-1db0-4f0e-8b5f-2ddf07e165b0",
                                                "sense_id": "2cf53c73-f0f6-3f41-8de6-676cce797425",
                                                "text": "И не поленился сдать анализы на СПИД и другие опасные инфекции."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58b8b0b4-bcac-3916-9e24-ab5ab06d3b4b",
                                        "entry_id": "90f634e9-369d-37a8-a937-deebb96b6bb7",
                                        "glosses": [
                                            "перен., публиц. о том, что имеет необратимые разрушительные последствия"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
