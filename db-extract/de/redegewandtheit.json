                                                "sense_id": "13f25a0f-e640-3635-9502-155baa8cdfa4",
                                                "text": "Z czasem retoryka stała się autonomiczną dziedziną wiedzy i najważniejszym przedmiotem szkolnym kształcącym sprawność językową."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
