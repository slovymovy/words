                "senses": [
                    {
                        "sense_id": "a7da954d-616c-3c22-8876-4347f722b1c2",
                        "entry_id": "ac9e906c-636e-36a9-b5d0-915ede1b2bb4",
                        "glosses": [
                            "To start a motor vehicle with a discharged (\\\"dead\\\") battery by connecting it with jumper cables to an alternate source of electrical current, generally either the charged battery of another vehicle or a purpose-made device (\\\"hotshot\\\")."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "897d4c0e-592b-3121-8128-63b5c586e352",
                        "entry_id": "ac9e906c-636e-36a9-b5d0-915ede1b2bb4",
                        "glosses": [
                            "To reactivate or rejuvenate."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ad1ae3c8-0a72-4ab4-8f35-bfbb50924134",
                                "sense_id": "897d4c0e-592b-3121-8128-63b5c586e352",
                                "text": "Giving a really good speech at the convention could jump-start her political career."
                            },
                            {
                                "example_id": "cdf780c7-74a6-4962-b902-070269534f30",
                                "sense_id": "897d4c0e-592b-3121-8128-63b5c586e352",
                                "text": "‘That debt means we can’t access credit to jump-start the economy as needed.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc9667b6-f4b5-4472-8cae-864b0a47d55b",
                        "source_entry_id": "ac9e906c-636e-36a9-b5d0-915ede1b2bb4",
                        "source_sense_description": "Start a motor vehicle",
                        "target_lang_word": "ponter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ponter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd731421-094a-3958-b7eb-c1cc43e30ae5",
                                        "entry_id": "c91e8682-caf8-3cc8-ae4a-dedb06802b88",
                                        "glosses": [
                                            "Construire un pont, équiper d’un pont."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3d6aec4-67ec-4fb3-ac17-af066b13c34d",
                                                "sense_id": "dd731421-094a-3958-b7eb-c1cc43e30ae5",
                                                "text": "Le chevalet Birago , qu'on peut employer pour des profondeurs de près de 4m,00 d'eau, suffit pour ponter la plupart des rivières de largeur moyenne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a0fb612-e791-3897-89c4-f70c3cce4bdc",
                                        "entry_id": "c91e8682-caf8-3cc8-ae4a-dedb06802b88",
                                        "glosses": [
                                            "Faire un pontage chirurgical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d835de08-23bf-43fe-b83c-3a4deb75c833",
                                                "sense_id": "3a0fb612-e791-3897-89c4-f70c3cce4bdc",
                                                "text": "Il faudra prendre soin de retourner la veine destinée à ponter l’artère afin que les valvules soient orientées dans le sens du flux artériel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b72833a5-89cd-3e60-b93d-9195bbfb7241",
                                        "entry_id": "c91e8682-caf8-3cc8-ae4a-dedb06802b88",
                                        "glosses": [
                                            "Équiper d’un pont un navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe3ef9dd-8cc0-4193-820a-541227c8e58d",
                                                "sense_id": "b72833a5-89cd-3e60-b93d-9195bbfb7241",
                                                "text": "C’est un superbe navire Dantziquois, du port d’environ 350 tonneaux, chargé de planches propres à ponter les navires qui seront très utiles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ponter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65c4187a-3293-3979-a155-87a8847da0a7",
                                        "entry_id": "2ff56f47-dbd3-35a6-95d3-908baf5db4ff",
                                        "glosses": [
                                            "Être ponte, jouer, miser de l’argent contre le banquier."
                                        ],
                                        "tags": [
                                            "Jeu"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43eb0bc4-f93e-4a83-bde2-39781ea9eb16",
                                                "sense_id": "65c4187a-3293-3979-a155-87a8847da0a7",
                                                "text": "D’abord, ils gagnèrent trois mille francs, revinrent à cinq cents, regagnèrent trois mille sept cents francs ; puis ils retombèrent à cent sous, se retrouvèrent à deux mille francs, et les risquèrent sur pair, pour les doubler d’un seul coup ; pair n’avait pas passé depuis cinq coups, ils y pontèrent la somme."
                                            },
                                            {
                                                "example_id": "f6d25ae8-6676-40e9-b255-2d3c310dda74",
                                                "sense_id": "65c4187a-3293-3979-a155-87a8847da0a7",
                                                "text": "Le bonnetier, un peu pris de vin, s’approcha de la table, et se mit à ponter. Les commencemens furent heureux, et lui donnèrent bon courage ; il choisit les hautes cartes, et doubla sa mise. La fortune changea ... Le tour en vint à sa montre, qui, après quelques tours malheureux, se trouva aussi dans la poche du banquier."
                                            },
                                            {
                                                "example_id": "a908dfac-5a12-42df-81de-5660fb501279",
                                                "sense_id": "65c4187a-3293-3979-a155-87a8847da0a7",
                                                "text": "Une heure après, au cercle, Halim-Pacha ayant pris la banque, il ponta à l’aveuglette ses cinq derniers louis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
