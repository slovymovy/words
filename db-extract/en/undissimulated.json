                                "example_id": "182349ef-71b8-4162-8451-68645d842ada",
                                "sense_id": "908d1f17-9084-34c9-8c23-ef1231bcfb99",
                                "text": "And the women, as they listened to his tale, applauded the departure with undissimulated pleasure."
                            }
                        ]
