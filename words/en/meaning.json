{
    "word_family": [
        "mean",
        "meaningful",
        "meaningless",
        "meaningfully",
        "meaninglessness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bfe00aa4-2069-3a72-8a41-620caff3982d",
                    "sense_definition": "The idea, concept, or information that a word, expression, or symbol represents.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you explain the <w>meaning</w> of this word?",
                            "target_lang_translations": {
                                "ru": "Ты можешь объяснить <w>значение</w> этого слова?",
                                "de": "Kannst du die <w>Bedeutung</w> dieses Wortes erklären?"
                            }
                        },
                        {
                            "text": "The phrase has a literal <w>meaning</w> and a figurative one.",
                            "target_lang_translations": {
                                "ru": "У этой фразы есть буквальное <w>значение</w> и переносное.",
                                "de": "Die Redewendung hat eine wörtliche <w>Bedeutung</w> und eine übertragene."
                            }
                        }
                    ],
                    "synonyms": [
                        "definition",
                        "sense",
                        "significance"
                    ],
                    "common_phrases": [
                        "literal meaning",
                        "hidden meaning",
                        "double meaning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идея, понятие или информация, которую представляет собой слово, выражение или символ.",
                        "de": "Die Vorstellung, der Begriff oder der Informationsgehalt, den ein Wort, ein Ausdruck oder ein Symbol darstellt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "значение",
                                "target_lang_sense_clarification": "лексическое или символическое"
                            },
                            {
                                "target_lang_word": "смысл",
                                "target_lang_sense_clarification": "суть, внутреннее содержание"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Bedeutung",
                                "target_lang_sense_clarification": "sprachlich oder symbolisch"
                            },
                            {
                                "target_lang_word": "Sinn",
                                "target_lang_sense_clarification": "inhaltlicher Gehalt einer Aussage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92bab1f7-c3fe-3d28-97dc-8aefc90c2434",
                    "sense_definition": "The value, purpose, or significance of something beyond its simple existence.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent years searching for the <w>meaning</w> of life.",
                            "target_lang_translations": {
                                "ru": "Он потратил годы на поиски <w>смысла</w> жизни.",
                                "de": "Er verbrachte Jahre damit, nach dem <w>Sinn</w> des Lebens zu suchen."
                            }
                        },
                        {
                            "text": "The old photograph holds a special <w>meaning</w> for her.",
                            "target_lang_translations": {
                                "ru": "Эта старая фотография имеет для неё особое <w>значение</w>.",
                                "de": "Das alte Foto hat eine besondere <w>Bedeutung</w> für sie."
                            }
                        }
                    ],
                    "synonyms": [
                        "significance",
                        "purpose",
                        "import"
                    ],
                    "common_phrases": [
                        "meaning of life",
                        "true meaning",
                        "lose meaning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ценность, цель или значимость чего-либо, выходящая за рамки простого существования.",
                        "de": "Der Wert, Zweck oder die Wichtigkeit von etwas über die reine Existenz hinaus."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смысл",
                                "target_lang_sense_clarification": "цель, разумное основание (напр. смысл жизни)"
                            },
                            {
                                "target_lang_word": "значение",
                                "target_lang_sense_clarification": "важность, значимость"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Sinn",
                                "target_lang_sense_clarification": "Zweck oder Lebenssinn"
                            },
                            {
                                "target_lang_word": "Bedeutung",
                                "target_lang_sense_clarification": "Wichtigkeit oder Relevanz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ea43bc7-b82c-3aaf-b624-f6127631c984",
                    "sense_definition": "The implied or suggested idea associated with a word or action, rather than its direct definition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's speech had a subtle <w>meaning</w> that only a few understood.",
                            "target_lang_translations": {
                                "ru": "В речи политика был скрытый <w>смысл</w>, который поняли лишь немногие.",
                                "de": "Die Rede des Politikers hatte einen feinen <w>Hintersinn</w>, den nur wenige verstanden."
                            }
                        },
                        {
                            "text": "We must consider the underlying <w>meaning</w> of his behavior.",
                            "target_lang_translations": {
                                "ru": "Мы должны учитывать скрытый <w>смысл</w> его поведения.",
                                "de": "Wir müssen die zugrunde liegende <w>Bedeutung</w> seines Verhaltens berücksichtigen."
                            }
                        }
                    ],
                    "synonyms": [
                        "implication",
                        "insinuation"
                    ],
                    "common_phrases": [
                        "underlying meaning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подразумеваемая или скрытая идея, связанная со словом или действием, в отличие от прямого определения.",
                        "de": "Die angedeutete oder mitschwingende Aussage hinter einem Wort oder einer Handlung, die nicht direkt ausgesprochen wird."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтекст",
                                "target_lang_sense_clarification": "скрытый смысл"
                            },
                            {
                                "target_lang_word": "смысл",
                                "target_lang_sense_clarification": "глубинное или скрытое содержание"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Hintersinn",
                                "target_lang_sense_clarification": "versteckte Botschaft oder Bedeutung"
                            },
                            {
                                "target_lang_word": "Bedeutung",
                                "target_lang_sense_clarification": "übertragener oder impliziter Sinn"
                            },
                            {
                                "target_lang_word": "Subtext",
                                "target_lang_sense_clarification": "mitschwingender Zwischenton"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58248b57-8bf9-3164-8fd9-87a486636547",
                    "sense_definition": "What someone intends or plans to do.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was not my <w>meaning</w> to cause any offense.",
                            "target_lang_translations": {
                                "ru": "У меня не было <w>намерения</w> кого-либо обидеть.",
                                "de": "Es war nicht meine <w>Absicht</w>, jemanden zu kränken."
                            }
                        },
                        {
                            "text": "She made her <w>meaning</w> clear so that everyone understood the plan.",
                            "target_lang_translations": {
                                "ru": "Она ясно выразила свою <w>мысль</w>, чтобы все поняли план.",
                                "de": "Sie machte ihre <w>Absicht</w> deutlich, sodass jeder den Plan verstand."
                            }
                        }
                    ],
                    "synonyms": [
                        "intent",
                        "aim",
                        "goal",
                        "plan"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что кто-то намеревается или планирует сделать.",
                        "de": "Das, was jemand vorhat, beabsichtigt oder plant zu tun."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намерение",
                                "target_lang_sense_clarification": "замысел, план"
                            },
                            {
                                "target_lang_word": "цель",
                                "target_lang_sense_clarification": "то, к чему стремятся"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Absicht",
                                "target_lang_sense_clarification": "Intention oder Vorhaben"
                            },
                            {
                                "target_lang_word": "Intention",
                                "target_lang_sense_clarification": "geplante Handlungsabsicht"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "59677821-06be-3e7c-812a-6e9af940f615",
                    "sense_definition": "Present participle and gerund of <w>mean</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have been <w>meaning</w> to call you all week.",
                            "target_lang_translations": {
                                "ru": "Я всю неделю <w>собирался</w> тебе позвонить.",
                                "de": "Ich hatte die ganze Woche <w>vor</w>, dich anzurufen."
                            }
                        },
                        {
                            "text": "The word comes from Latin, <w>meaning</w> a vortex or whirlwind.",
                            "target_lang_translations": {
                                "ru": "Это слово происходит из латыни, <w>означая</w> вихрь или смерч.",
                                "de": "Das Wort stammt aus dem Lateinischen und <w>bedeutet</w> Strudel oder Wirbelwind."
                            }
                        }
                    ],
                    "common_phrases": [
                        "meaning to"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола mean.",
                        "de": "Partizip Präsens und Gerundium von mean."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "означающий",
                                "target_lang_sense_clarification": "причастие от 'означать'"
                            },
                            {
                                "target_lang_word": "намеревающийся",
                                "target_lang_sense_clarification": "причастие от 'намереваться'"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bedeutend",
                                "target_lang_sense_clarification": "Partizip von bedeuten"
                            },
                            {
                                "target_lang_word": "beabsichtigend",
                                "target_lang_sense_clarification": "Partizip von beabsichtigen / vorhaben"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d67a0d37-b9e9-3985-b971-7fdaff765210",
                    "sense_definition": "Having a specific intention; usually used in compounds.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a well-<w>meaning</w> person who sometimes makes mistakes.",
                            "target_lang_translations": {
                                "ru": "Он человек с добрыми <w>намерениями</w>, который иногда совершает ошибки.",
                                "de": "Er ist ein <w>gutmütiger</w> Mensch, der manchmal Fehler macht."
                            }
                        },
                        {
                            "text": "Despite being well-<w>meaning</w>, his advice was not helpful.",
                            "target_lang_translations": {
                                "ru": "Несмотря на его благие <w>намерения</w>, его совет не помог.",
                                "de": "Obwohl er es <w>gut meinte</w>, war sein Rat nicht hilfreich."
                            }
                        }
                    ],
                    "common_phrases": [
                        "well-meaning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий определенное намерение; обычно используется в сложных словах.",
                        "de": "Eine bestimmte Absicht habend; meist in Zusammensetzungen verwendet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намеренный",
                                "target_lang_sense_clarification": "в составе сложных слов (напр. благонамеренный)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gesinnt",
                                "target_lang_sense_clarification": "in Zusammensetzungen, z. B. wohlgesinnt"
                            },
                            {
                                "target_lang_word": "meinend",
                                "target_lang_sense_clarification": "in Zusammensetzungen, z. B. gutmeinend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1b01ba2-22c9-394d-8834-fc5152eae82d",
                    "sense_definition": "Expressing something significant or suggestive without using words.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave him a <w>meaning</w> look across the crowded room.",
                            "target_lang_translations": {
                                "ru": "Она бросила на него <w>многозначительный</w> взгляд через переполненную комнату.",
                                "de": "Sie warf ihm quer durch den überfüllten Raum einen <w>vielsagenden</w> Blick zu."
                            }
                        },
                        {
                            "text": "There was a <w>meaning</w> pause before he answered the question.",
                            "target_lang_translations": {
                                "ru": "Перед тем как он ответил на вопрос, повисла <w>многозначительная</w> пауза.",
                                "de": "Es gab eine <w>bedeutungsvolle</w> Pause, bevor er die Frage beantwortete."
                            }
                        }
                    ],
                    "common_phrases": [
                        "meaning look",
                        "meaning glance",
                        "meaning silence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий что-то значительное или намекающий на что-то без слов.",
                        "de": "Ohne Worte etwas Bedeutendes oder Andeutungsvolles ausdrückend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "многозначительный",
                                "target_lang_sense_clarification": "выразительный, содержащий намёк"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "vielsagend",
                                "target_lang_sense_clarification": "ausdrucksvoll, einen Hinweis enthaltend"
                            },
                            {
                                "target_lang_word": "bedeutungsvoll",
                                "target_lang_sense_clarification": "voller Bedeutung oder Andeutung"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}