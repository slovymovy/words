                "senses": [
                    {
                        "sense_id": "5b8149fe-6bcf-397c-8ed4-ac151d91fde8",
                        "entry_id": "fc4aade9-b2a3-3750-8400-38abe8bbb49d",
                        "glosses": [
                            "церк. один из высших монашеских чинов в Православной церкви (ниже епископа), соответствует протоиерею и протопресвитеру в белом духовенстве, а также лицо имеющее такой чин"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f26301a-3f12-44b1-8247-a28b4c8307ae",
                                "sense_id": "5b8149fe-6bcf-397c-8ed4-ac151d91fde8",
                                "text": "Благодарю за умение, за бестрепетность, — произнес архимандрит."
                            }
                        ]
                    },
                    {
                        "sense_id": "8eedff2d-a97d-3d4d-b3ea-a5f57eea4f7b",
                        "entry_id": "fc4aade9-b2a3-3750-8400-38abe8bbb49d",
                        "glosses": [
                            "церк. почётный титул настоятеля крупного мужского монастыря, наместника лавры, ректора духовной семинарии, а также лицо имеющее такой титул"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50a6bc1e-6129-4231-b0cb-6c39982f6180",
                        "source_entry_id": "fc4aade9-b2a3-3750-8400-38abe8bbb49d",
                        "target_lang_word": "archimandrite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archimandrite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50ab527d-a06c-3a23-a4a6-d55920754257",
                                        "entry_id": "2594cb23-472b-36ad-8fa1-cf6150cc01f2",
                                        "glosses": [
                                            "The superior of a large monastery, or group of monasteries, in the Orthodox Church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27f3c2b1-cb8e-4c8c-9ac5-9626d9f49bfb",
                                                "sense_id": "50ab527d-a06c-3a23-a4a6-d55920754257",
                                                "text": "My predecessors generally preferred to live and work in the monastery proper, but I like the solitude of the caves. I have been an archimandrite, here at Pskov, since 1915 and a humble monk for twenty years before that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb13177e-308e-3f61-8778-aa63bcf1738a",
                                        "entry_id": "2594cb23-472b-36ad-8fa1-cf6150cc01f2",
                                        "glosses": [
                                            "An honorary title sometimes given to a monastic priest."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
