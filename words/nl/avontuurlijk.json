    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1d37cdb0-5d3f-3eb6-94b5-d1a1c261b8fc",
                    "sense_definition": "graag avonturen willend en bereid zijn om risico's te nemen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "persoonlijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jij bent echt een <w>avontuurlijk</w> persoon die nergens bang voor is.",
                            "target_lang_translations": {
                                "en": "You are truly an <w>adventurous</w> person who is not afraid of anything."
                            }
                        },
                        {
                            "text": "Zij is een <w>avontuurlijke</w> levensgenieter die altijd op zoek is naar nieuwe ervaringen.",
                            "target_lang_translations": {
                                "en": "She is an <w>adventurous</w> epicurean who is always looking for new experiences."
                            }
                        }
                    ],
                    "antonyms": [
                        "voorzichtig",
                        "saai"
                    ],
                    "common_phrases": [
                        "avontuurlijk ingesteld",
                        "avontuurlijk persoon"
                    ],
                    "target_lang_definitions": {
                        "en": "desiring adventures and being willing to take risks"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "adventurous",
                                "target_lang_sense_clarification": "willing to take risks or try new experiences"
                            },
                            {
                                "target_lang_word": "daring",
                                "target_lang_sense_clarification": "brave and willing to take risks"
                            },
                            {
                                "target_lang_word": "bold",
                                "target_lang_sense_clarification": "showing an ability to take risks; confident and courageous"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae51bff3-0351-3c7a-bd07-c5c1eb45f3d3",
                    "sense_definition": "vol onverwachte, spannende en boeiende gebeurtenissen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ervaring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een <w>avontuurlijke</w> reis hebben we dit jaar door Azië gemaakt!",
                            "target_lang_translations": {
                                "en": "What an <w>adventurous</w> trip we took through Asia this year!"
                            }
                        },
                        {
                            "text": "Zij heeft een <w>avontuurlijke</w> baan in een dynamische stad die nooit slaapt.",
                            "target_lang_translations": {
                                "en": "She has an <w>adventurous</w> job in a dynamic city that never sleeps."
                            }
                        }
                    ],
                    "antonyms": [
                        "eentonig",
                        "voorspelbaar"
                    ],
                    "common_phrases": [
                        "avontuurlijke reis",
                        "avontuurlijke vakantie",
                        "avontuurlijk leven"
                    ],
                    "target_lang_definitions": {
                        "en": "full of unexpected, exciting, and engaging events"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "adventurous",
                                "target_lang_sense_clarification": "full of excitement and new experiences"
                            },
                            {
                                "target_lang_word": "eventful",
                                "target_lang_sense_clarification": "marked by interesting or exciting events"
                            },
                            {
                                "target_lang_word": "exciting",
                                "target_lang_sense_clarification": "causing great enthusiasm and eagerness"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "177dd852-01ef-3ec3-b3aa-4bee1ae71ae7",
                    "sense_definition": "met weinig zekerheid en gepaard gaand met gevaar of risico",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "risico",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het starten van een bedrijf zonder kapitaal is een <w>avontuurlijke</w> onderneming.",
                            "target_lang_translations": {
                                "en": "Starting a business without capital is a <w>risky</w> undertaking."
                            }
                        },
                        {
                            "text": "De investeerder vond het plan te <w>avontuurlijk</w> en trok zijn geld terug.",
                            "target_lang_translations": {
                                "en": "The investor found the plan too <w>risky</w> and withdrew his money."
                            }
                        }
                    ],
                    "synonyms": [
                        "gewaagd",
                        "riskant"
                    ],
                    "antonyms": [
                        "veilig",
                        "zeker"
                    ],
                    "common_phrases": [
                        "avontuurlijke onderneming"
                    ],
                    "target_lang_definitions": {
                        "en": "with little certainty and accompanied by danger or risk"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "risky",
                                "target_lang_sense_clarification": "involving a possibility of something bad happening"
                            },
                            {
                                "target_lang_word": "hazardous",
                                "target_lang_sense_clarification": "risky or dangerous"
                            },
                            {
                                "target_lang_word": "speculative",
                                "target_lang_sense_clarification": "involving a high risk of loss in the hope of gain"
                            }
                        ]
                    }
                }
            ]
        }
    ]
