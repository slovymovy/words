                "senses": [
                    {
                        "sense_id": "3ef7c41c-bb0b-35ce-8323-be4ccd9fcbab",
                        "entry_id": "379fbe4c-99f5-3165-b520-37a228bad983",
                        "glosses": [
                            "arabisches/ostafrikanisches Segelschiff mit trapezförmigen Segeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc51fc66-ee46-472b-b26b-91aadfc06db5",
                                "sense_id": "3ef7c41c-bb0b-35ce-8323-be4ccd9fcbab",
                                "text": "„Flotten von Daus mit dreieckigen Segeln verkehren zwischen der jemenitischen Region Hadramaut, dem Persischen Golf, der Westküste von Indien und den Häfen an Ostafrikas Küste.“"
                            },
                            {
                                "example_id": "b4f625b0-44ca-49f4-a648-ac40d39c49d1",
                                "sense_id": "3ef7c41c-bb0b-35ce-8323-be4ccd9fcbab",
                                "text": "„Die Daus mit ihren geflickten Segeln brachten die Tagesfänge der Fischer herein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db258e54-46f8-4e2a-9cfd-216b1c049813",
                        "source_entry_id": "379fbe4c-99f5-3165-b520-37a228bad983",
                        "source_sense_id": "3ef7c41c-bb0b-35ce-8323-be4ccd9fcbab",
                        "source_sense_description": "arabisches/ostafrikanisches Segelschiff mit trapezförmigen Segeln",
                        "target_lang_word": "dhow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dhow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00ae1617-d207-334f-a263-38ce2aa7b0a1",
                                        "entry_id": "5462c7a7-21f0-3d24-b845-fddc097d8768",
                                        "glosses": [
                                            "A traditional sailing vessel used along the coasts of Arabia, East Africa, and the Indian Ocean, generally having a single mast and a lateen sail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cafd970f-4663-4462-b914-82dd894341c0",
                                                "sense_id": "00ae1617-d207-334f-a263-38ce2aa7b0a1",
                                                "text": "I suppose I must have slept for seven or eight hours, getting the first real rest that I had had since the night before the loss of the dhow, for when I woke the sun was high in the heavens."
                                            },
                                            {
                                                "example_id": "8cdec33f-cad5-46ce-b2a9-d5cf470d1070",
                                                "sense_id": "00ae1617-d207-334f-a263-38ce2aa7b0a1",
                                                "text": "Joshua continued preparing breakfast, Bijan returned to piloting the dhow offshore and Pourghasem returned to his watch.[…]Several dhows were on the water and some fishermen were already at work."
                                            },
                                            {
                                                "example_id": "5acc36fd-c1a5-4c3e-b53b-c623312cde5b",
                                                "sense_id": "00ae1617-d207-334f-a263-38ce2aa7b0a1",
                                                "text": "The navy sometimes hired dhows for its patrols.[…]If a dhow was stopped, the slaves could not be counted on to make their presence known, having probably been told that the Europeans would kill them."
                                            },
                                            {
                                                "example_id": "0a54717a-c11c-4372-a151-2568d053fa5d",
                                                "sense_id": "00ae1617-d207-334f-a263-38ce2aa7b0a1",
                                                "text": "They took a dhow from Mombasa bound for Aden and planned to take a larger vessel to Suez and then overland to Cairo."
                                            },
                                            {
                                                "example_id": "22874ca9-8fe8-425f-98f4-5af7d122c0b3",
                                                "sense_id": "00ae1617-d207-334f-a263-38ce2aa7b0a1",
                                                "text": "In contemporary Anglophone usage, the term ‘dhow’ has come to refer generically and exonymically to traditional wooden vessels of the western Indian Ocean, whatever their particular forms or emic classification."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2517f6fd-f0a0-4fc4-9dae-c1e81f5df507",
                        "source_entry_id": "379fbe4c-99f5-3165-b520-37a228bad983",
