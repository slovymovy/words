                ],
                "senses": [
                    {
                        "sense_id": "10033175-9eef-33c3-ba3f-a594263f9694",
                        "entry_id": "fda54363-444b-3de0-b016-ce2bc0513623",
                        "glosses": [
                            "jemand, der zu einer Nachfolgegeneration gehört"
                        ],
                        "tags": [
                            "no-singulative"
                        ],
                        "examples": [
                            {
                                "example_id": "d95fb63a-32d7-44fa-89fe-967a1844e740",
                                "sense_id": "10033175-9eef-33c3-ba3f-a594263f9694",
                                "text": "„Seine Rechnung mag für Nachgeborene kleinlich wirken, eben eine Aufrechnung.“"
                            },
                            {
                                "example_id": "f383f3d0-749f-4e64-ae03-4911cae6a315",
                                "sense_id": "10033175-9eef-33c3-ba3f-a594263f9694",
                                "text": "„Uns, den Nachgeborenen, wurde viel verheimlicht, vieles erfuhren wir nur verdreht oder verfälscht, um bloß nicht den Zweifel aufkommen zu lassen, dass unsere Erzeuger möglicherweise etwas mit dieser schrecklichen Zeit zu tun oder gar sich mitschuldig gemacht hätten.“"
                            },
                            {
                                "example_id": "40692eb7-52d4-4858-9928-a0b0292c5d71",
                                "sense_id": "10033175-9eef-33c3-ba3f-a594263f9694",
                                "text": "„Uns Nachgeborenen, die wir keine Historiker sind und deren gesunder Menschenverstand sich bei Betrachtung dieses Geschehnisses von keiner Forscherbegeisterung umnebeln lässt, stellt sich für dieses Geschehnis eine unübersehbare Menge von Ursachen dar.“"
                            },
                            {
                                "example_id": "cb38438f-5681-48fe-82b8-62455c1f4f32",
                                "sense_id": "10033175-9eef-33c3-ba3f-a594263f9694",
                                "text": "„Für das Gros der Nachgeborenen wird das genügen, sie oder ihn literarisch und menschlich auf alle Fälle zu disqualifizieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fd622b2f-bfa2-3009-bae3-a73e19bafbc5",
                        "entry_id": "fda54363-444b-3de0-b016-ce2bc0513623",
                        "glosses": [
                            "männliches Kind, das längere Zeit nach seinen Geschwistern zur Welt kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a050d2e5-1b17-4235-9682-0e1e9eb0b701",
                                "sense_id": "fd622b2f-bfa2-3009-bae3-a73e19bafbc5",
                                "text": "„Wieder daheim auf der Trostburg, spitzte sich seine schwierige Lage als Nachgeborener gegenüber seinem Bruder Michael zu.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3d5379df-d0aa-3e3c-a3b4-8d28f0f84e0a",
                        "entry_id": "fda54363-444b-3de0-b016-ce2bc0513623",
                        "glosses": [
                            "männliches Kind, das nach dem Tod des Vaters oder nach der Scheidung der Eltern zur Welt kommt"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    },
                    {
