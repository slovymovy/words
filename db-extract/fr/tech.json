                    }
                ],
                "senses": [
                    {
                        "sense_id": "03f6fa0d-b4ba-380d-abc0-dd2cfac72345",
                        "entry_id": "17fee06e-9627-3d9a-97af-591b15a0e64b",
                        "glosses": [
                            "Technologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ee598cb-5136-4051-af7e-3f34cd82d16e",
                                "sense_id": "03f6fa0d-b4ba-380d-abc0-dd2cfac72345",
                                "text": "En explorant les nouvelles dynamiques des formations tech, il est clair que l'avenir de l'éducation aux métiers de la technologie est prometteur."
                            },
                            {
                                "example_id": "d38caafe-2bdd-4d0e-bb7c-c36fca544af7",
                                "sense_id": "03f6fa0d-b4ba-380d-abc0-dd2cfac72345",
                                "text": "La marche des affaires de l'industrie tech suisse (industrie des machines, des équipements électriques et des métaux, ainsi que des branches technologiques apparentées) reste difficile."
                            }
                        ]
                    }
                ],
