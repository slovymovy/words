                "senses": [
                    {
                        "sense_id": "0bdffdab-0979-3a7c-8746-61d0164e1baf",
                        "entry_id": "c3deac6a-ca55-35e0-8fd0-05776cfbfff6",
                        "glosses": [
                            "verschlüsselte Rune"
                        ],
                        "tags": [
                            "Germanistik",
                            "Skandinavistik"
                        ],
                        "examples": [
                            {
                                "example_id": "92d9f0c1-21e4-49db-ba5c-a2fb5bca9f18",
                                "sense_id": "0bdffdab-0979-3a7c-8746-61d0164e1baf",
                                "text": "„Solche Geheimrunen sind uns authentisch erst aus dem 8. Jahrhundert in England (…) sowie in nordischen Runeninschriften mit der 16typigen Reihe bekannt: das berühmteste Beispiel mit der Verwendung verschiedener Systeme von Geheimrunen ist der Runenstein von Rök…“"
                            },
                            {
                                "example_id": "7f5f84d6-a691-4981-b72c-64749c01ca71",
                                "sense_id": "0bdffdab-0979-3a7c-8746-61d0164e1baf",
                                "text": "„»Ich sah auf dem geglätteten Kiemen zehn Geheimrunen eingeritzt…«.“"
                            },
                            {
                                "example_id": "65bbe4ce-351c-497c-81e5-6ac89ed74eb2",
                                "sense_id": "0bdffdab-0979-3a7c-8746-61d0164e1baf",
                                "text": "„Im System der Geheimrunen wird eine bestimmte Rune indirekt angegeben, indem sie (wie bei einem Koordinatensystem) mit Hilfe zweier Angaben bezeichnet wird, und zwar a. die Gruppe und b. die Platzziffer innerhalb der Gruppe.“"
                            },
                            {
                                "example_id": "6c87a542-0fa8-4cc2-b5ae-b361c7821c52",
                                "sense_id": "0bdffdab-0979-3a7c-8746-61d0164e1baf",
                                "text": "„Um die mächtige Inschrift, die von seiten des Runenmeisters mit Geheimrunen, Zahlenmagie und anderen unentwirrbaren Spekulationen gespickt ist, entstand eine Literatur, gelehrt, spitzfindig und ohne Einigkeit unter den damit beschäftigten Forschern.“"
                            },
                            {
                                "example_id": "dcfbc6a1-fdb8-4ea2-adb1-81890251ff35",
                                "sense_id": "0bdffdab-0979-3a7c-8746-61d0164e1baf",
                                "text": "„Für die Zeile IIc mit den Geheimrunen ergibt sich keine auch nur annähernd sichere Deutung,…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
