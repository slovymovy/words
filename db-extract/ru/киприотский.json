                        "cross_references": [
                            {
                                "target_word": "zypriotisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eff6f3ef-db79-35c9-9ff0-14dbb11a46d9",
                                        "entry_id": "6e354b3c-3d22-3496-8e04-93fb991d15e4",
                                        "glosses": [
                                            "Zypern oder auch die Zyprer betreffend, aus Zypern kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6915062b-7654-490b-bb9b-1d5575c45d25",
                                                "sense_id": "eff6f3ef-db79-35c9-9ff0-14dbb11a46d9",
                                                "text": "Man hat zwar stets reges Interesse am Schicksal des zypriotschen Volks bekundet, darüber hinaus ist jedoch selten etwas Handfestes zustande gekommen."
                                            },
                                            {
                                                "example_id": "2ae03af8-ddbf-4fc9-b506-d9ed4ff67bda",
                                                "sense_id": "eff6f3ef-db79-35c9-9ff0-14dbb11a46d9",
                                                "text": "„Hani bestand darauf, dass ein zypriotischer Arzt geholt wurde und nach Ferris sah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
