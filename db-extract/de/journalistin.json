                ],
                "senses": [
                    {
                        "sense_id": "62db2549-6ad3-3753-9006-4acfa16ad9ce",
                        "entry_id": "50d89d1e-06b9-33c4-9b17-7d47a684b4ac",
                        "glosses": [
                            "Frau, die beruflich für Zeitungen, Zeitschriften oder andere Massenmedien arbeitet und Informationen beschafft und verbreitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eab1331-2220-46c5-b01d-7dbd322a7a6f",
                                "sense_id": "62db2549-6ad3-3753-9006-4acfa16ad9ce",
                                "text": "„Sie waren auf Englisch, und schon stellte ich mir eine Zukunft als internationale oder zumindest bilinguale Journalistin vor.“"
                            },
                            {
                                "example_id": "8f56643e-77fc-4ba3-8e36-63db00375f64",
                                "sense_id": "62db2549-6ad3-3753-9006-4acfa16ad9ce",
                                "text": "„Als zufällig die Journalistin vorbeikam, zögerte sie zwar, stimmte aber ihrer Bitte nicht ungern zu.“"
                            },
                            {
                                "example_id": "26ed9ed0-26b5-44a5-a7df-3f01fe1b2f7f",
                                "sense_id": "62db2549-6ad3-3753-9006-4acfa16ad9ce",
                                "text": "„Bei einer großen Verlagsweihnachtsfeier unterhalte ich mich mit einer befreundeten Journalistin, und sie kommt auf die Idee, in der Stadtzeitung einen Artikel über den Buchhandel als bedrohte Branche zu schreiben.“"
                            },
                            {
                                "example_id": "b9821177-c38a-4a8b-a0f1-5d68b6d3bd16",
                                "sense_id": "62db2549-6ad3-3753-9006-4acfa16ad9ce",
                                "text": "„Für mich als Journalistin waren es mit die schönsten Jahre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
