                "translations": [
                    {
                        "translation_id": "0b70ac6f-dab1-4335-94eb-335ced3da141",
                        "source_entry_id": "98db144b-221a-37af-aedc-c930ec4e2fbe",
                        "source_sense_description": "having no roots",
                        "target_lang_word": "wurzellos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wurzellos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee0bfa94-5370-3eba-a0b6-6152e8365a72",
                                        "entry_id": "f5d12231-5254-3f17-b416-d1d9198c8c8b",
                                        "glosses": [
                                            "ohne Wurzel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5191f36-1b40-4bd2-8040-0e2bd14c8821",
                                                "sense_id": "ee0bfa94-5370-3eba-a0b6-6152e8365a72",
                                                "text": "„Alle Zähne der Hasenartigen sind wurzellose Zähne.“"
                                            },
                                            {
                                                "example_id": "5fcc8bdf-ce5c-4782-aca7-ff6f542394d6",
                                                "sense_id": "ee0bfa94-5370-3eba-a0b6-6152e8365a72",
                                                "text": "[Wombats:] „Im Ober- und Unterkiefer befinden sich je ein Paar wurzellose Schneidezähne, die Backenzähne sind einfach gebaut und ebenfalls wurzellos.“"
                                            },
                                            {
                                                "example_id": "809b464f-3348-459b-9a68-df025d8269f7",
                                                "sense_id": "ee0bfa94-5370-3eba-a0b6-6152e8365a72",
                                                "text": "„Bei Haien wachsen die wurzellosen Zähne auf der Innenseite des Kiefers beständig nach, so dass hinter jedem vorderen Zahn im Zahnbogen mehrere Folgezähne (beim Bullenhai sieben) in verschiedenen Entwicklungsstadien stehen.“"
                                            },
                                            {
                                                "example_id": "ce49658a-a19f-46ad-81b2-bb781cb9b5b7",
                                                "sense_id": "ee0bfa94-5370-3eba-a0b6-6152e8365a72",
                                                "text": "„Auch bei einigen wurzellosen Samenpflanzen, zum Beispiel den Wasserschläuchen, kommen Rhizoide vor.“"
                                            },
                                            {
                                                "example_id": "22797513-d48a-40db-8b5c-5639348c2ed0",
                                                "sense_id": "ee0bfa94-5370-3eba-a0b6-6152e8365a72",
                                                "text": "„Auf dem Kongress in Montpellier stellte Heidi Pfeiffer den Fall eines nunmehr 19 Jahre zurückliegenden Mordes vor, den Polizei und Gerichtsmedizin mit den neuen Methoden wieder aufrollen wollten. Einzige Spur war ein einzelnes, wurzelloses Haar, von dem man sich Aufschluss erwartete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5206f21c-3f55-3df4-92fc-dd9f966951d9",
                                        "entry_id": "f5d12231-5254-3f17-b416-d1d9198c8c8b",
                                        "glosses": [
                                            "ohne Heimat; ohne Bindungen, ohne einen Ort und ohne Personen, an dem/bei denen man sich zu Hause fühlt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c80ec98-55c2-4574-af6e-5a62dbcceba5",
                                                "sense_id": "5206f21c-3f55-3df4-92fc-dd9f966951d9",
                                                "text": "„Shirin Neshat kann nicht mehr zurück in den Iran. Diese Zeit beschreibt sie als die \"traumatischste\" ihres Lebens. »Ich war wurzellos, fühlte mich fremd in der amerikanischen Kultur.«“"
                                            },
                                            {
                                                "example_id": "a7b616de-7673-4ac8-aaba-ce815a3dcc22",
                                                "sense_id": "5206f21c-3f55-3df4-92fc-dd9f966951d9",
                                                "text": "„Aufgrund ihrer frankoamerikanischen Herkunft zählt sie sich zu den »wurzellosen Leuten, die keine nationale Identität besitzen und in den Vereinigten Staaten nirgends hingehören«.“"
                                            },
                                            {
                                                "example_id": "dc8dcd96-724f-4dda-9b06-d932911cfa7f",
                                                "sense_id": "5206f21c-3f55-3df4-92fc-dd9f966951d9",
                                                "text": "[Zum Tod des britischen Literaturnobelpreisträgers V. S. Naipaul:] „Mithu Sanyal: »Ich glaube, was V.S. Naipaul wirklich absolut ausmacht, ist, dass er wirklich so wurzellos war.«“"
                                            },
                                            {
                                                "example_id": "6c1a1a00-c53e-498c-a538-357e54bf7a0c",
                                                "sense_id": "5206f21c-3f55-3df4-92fc-dd9f966951d9",
                                                "text": "„Wenn man keine Zuhause hat, keinen Mittelpunkt im Leben, dann wird man halt- und wurzellos. Denn zuhause steht für Wärme, Geborgenheit und Familie.“"
                                            },
                                            {
                                                "example_id": "189af19e-e565-4e93-8725-8bce3eca86ec",
                                                "sense_id": "5206f21c-3f55-3df4-92fc-dd9f966951d9",
                                                "text": "„In der Radiosendung wird in kurzen Einblendungen Zappas Biografie erzählt. Es werden die Umzüge in seiner Kindheit erwähnt, die ihn wurzellos machten,“ […]."
                                            },
                                            {
                                                "example_id": "db9a041f-0b60-4474-9d6f-422f30e82045",
                                                "sense_id": "5206f21c-3f55-3df4-92fc-dd9f966951d9",
                                                "text": "[Königin Margrethe von Dänemark:] „»Wir alle brauchen etwas, dass uns aufrecht hält, wie eine Boje im Wasser. Wir alle brauchen einen nationalen Bezug, ich möchte sagen, sogar Vaterlandliebe ist nötig in einer globalisierten Welt. Denn wer nicht weiß, wo er herkommt, ist wurzellos.«“"
                                            },
                                            {
                                                "example_id": "f4397407-379d-4313-9cf2-d8515bba8304",
                                                "sense_id": "5206f21c-3f55-3df4-92fc-dd9f966951d9",
                                                "text": "„Karl aber betont, dass Brennan sich dagegen verwehrte, als „irische Schriftstellerin“ gelesen zu werden. Sie schraffiert das Bild einer selbstbewussten, wurzellosen Kosmopolitin – nicht das einer unglücklichen „Heimatlosen“.“"
                                            },
                                            {
                                                "example_id": "694f08b2-004f-48ed-9744-0086ebe11916",
                                                "sense_id": "5206f21c-3f55-3df4-92fc-dd9f966951d9",
                                                "text": "„Eine zweite Säuberungswelle setzte zu Beginn des Jahres 1948 ein. Sie war hauptsächlich gegen Juden in der Sowjetunion gerichtet, die als »wurzellose Kosmopoliten« denunziert wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
