                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "1e0794be-5f7b-4fa6-8de5-40f2ddc74447",
                                "sense_id": "927cdb43-cc53-3fb2-990c-3345550c2fc4",
                                "text": "[T]hree of the boys, of whom Mr. Hector was sometimes one, used to come in the morning as his humble attendants, and carry him [Johnson] to school. […] The purfly, sand-blind lubber and blubber, with his open mouth, and face of bruised honeycomb; yet already dominant, imperial, irresistible!"
                            }
                        ]
                    },
