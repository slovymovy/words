                    ],
                    "synonyms": [
                        "berth",
                        "cot"
                    ],
                    "common_phrases": [
                        "top bunk",
                        "bottom bunk",
                        "bunk bed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкая кровать, часто одна из пары или серии, расположенных одна над другой.",
                        "zh": "一种窄床，通常指上下铺中的一张。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "койка",
