                ],
                "senses": [
                    {
                        "sense_id": "578541fe-929e-32af-9a41-c2b212347193",
                        "entry_id": "1bb0f58a-c6fc-3c38-8d90-d9b9a19e6364",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1c207e0-f8e2-423d-b658-e57eb79d96ec",
                                "sense_id": "578541fe-929e-32af-9a41-c2b212347193",
                                "text": "Frau Rösle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "964a730c-34df-4114-8404-e6a6eb1c3985",
                                "sense_id": "578541fe-929e-32af-9a41-c2b212347193",
                                "text": "Herr Rösle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ed59d9d1-d24d-46b7-9d56-8aa50d18bf9e",
                                "sense_id": "578541fe-929e-32af-9a41-c2b212347193",
                                "text": "Die Rösles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "7d068dee-3667-4a6a-92dc-83afeaa9123f",
                                "sense_id": "578541fe-929e-32af-9a41-c2b212347193",
                                "text": "Der Rösle trägt nie die Pullover, die die Rösle ihm strickt."
                            },
                            {
                                "example_id": "35c2457f-54c1-4604-a2d4-6e1470b7a3b6",
                                "sense_id": "578541fe-929e-32af-9a41-c2b212347193",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rösle kommt, geht der Herr Rösle.“"
                            },
                            {
                                "example_id": "c360f5f6-ad11-438f-a8c8-8155ba1875fb",
                                "sense_id": "578541fe-929e-32af-9a41-c2b212347193",
                                "text": "Rösle kommt und geht."
                            },
                            {
                                "example_id": "1da9ff95-d6b5-4d17-8fed-2f1707d22a14",
                                "sense_id": "578541fe-929e-32af-9a41-c2b212347193",
                                "text": "Rösles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
