        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ee52d1d0-2bdb-3ca8-b997-74121d626c86",
                "word": "isotropy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8e98c40f-fc7b-4655-9f69-39a8928c58ca",
                        "entry_id": "ee52d1d0-2bdb-3ca8-b997-74121d626c86",
                        "tags": [
                            "plural"
                        ],
                        "form": "isotropies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "953aa730-180f-32ce-a668-c00b5e101acb",
                        "entry_id": "ee52d1d0-2bdb-3ca8-b997-74121d626c86",
                        "glosses": [
                            "The property of being identical, or having the same physical properties, in all directions."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "66b130d8-43dc-4700-8aad-518fe1fe9afc",
                                "sense_id": "953aa730-180f-32ce-a668-c00b5e101acb",
                                "text": "down this road, as they watched, came a wagon, then a couple of riders, then a coach and another wagon, in daylight which slowly lost its stark isotropy and was flowed into by clouds and chimney smoke and even episodes of weather"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f801c60-14b6-4782-878d-d491832f5684",
                        "source_entry_id": "ee52d1d0-2bdb-3ca8-b997-74121d626c86",
                        "source_sense_id": "953aa730-180f-32ce-a668-c00b5e101acb",
                        "source_sense_description": "The property of being isotropic",
                        "target_lang_word": "isotropie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isotropie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d2e24e4-1d0d-3fa6-b36a-4e658ad97de8",
                                        "entry_id": "68a83032-3028-35c4-91c6-20c8e25e8607",
                                        "glosses": [
                                            "État d’un corps ou d’un matériau qui présente les mêmes propriétés dans toutes les directions."
                                        ],
                                        "tags": [
                                            "Chimie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e43ac9a-fadc-4777-946a-b4670d07c931",
                                                "sense_id": "0d2e24e4-1d0d-3fa6-b36a-4e658ad97de8",
                                                "text": "Il existe un seul moyen d’appréhender directement l’isotropie de l'espace dans notre environnement terrestre : par l’intermédiaire de la lumière, qui échappe à la tyrannie de la verticale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f39bfe8a-8c62-45d0-8a97-0b05e4ae660a",
                        "source_entry_id": "ee52d1d0-2bdb-3ca8-b997-74121d626c86",
                        "source_sense_id": "953aa730-180f-32ce-a668-c00b5e101acb",
                        "source_sense_description": "The property of being isotropic",
                        "target_lang_word": "Isotropie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Isotropie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6fb41ff4-0e6c-36c6-9c9f-03d5d0211ce6",
                                        "entry_id": "92d7ec82-97f1-376e-8954-faf08efc946e",
                                        "glosses": [
                                            "Eigenschaft (eines Stoffes, vor allem bei Kristallen), in alle Richtungen gleiche (physikalische und chemische) Eigenschaften zu besitzen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dd8ad54-9ad8-465a-afa8-711ff0801705",
                                                "sense_id": "6fb41ff4-0e6c-36c6-9c9f-03d5d0211ce6",
                                                "text": "„Die Isotropie von Protoplasma und Gelatine ist indessen keine unveränderliche Eigenschaft.“"
                                            },
                                            {
                                                "example_id": "bb0f6cc7-5d7a-4943-bb3c-f0ad249f8758",
                                                "sense_id": "6fb41ff4-0e6c-36c6-9c9f-03d5d0211ce6",
                                                "text": "„Dagegen ist die Isotropie eine reine Materialeigenschaft; sie bedeutet, dass im Material keine Richtung ausgezeichnet ist.“"
                                            },
                                            {
                                                "example_id": "7520d5b3-9ea1-426d-a6e3-60778d1db7f6",
                                                "sense_id": "6fb41ff4-0e6c-36c6-9c9f-03d5d0211ce6",
                                                "text": "„Wenden wir uns nun der Frage nach der Homogenität und Isotropie der Materieverteilung zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
