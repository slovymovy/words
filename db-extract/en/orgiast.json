                    {
                        "sense_id": "b65b00b7-1c2a-379b-86b9-4046274ee790",
                        "entry_id": "87fd8efd-daa4-390d-a29e-aaf11e95e674",
                        "glosses": [
                            "One who attends an orgy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdc81f04-0288-48b4-a6d5-e5f7a2a461e8",
                                "sense_id": "b65b00b7-1c2a-379b-86b9-4046274ee790",
                                "text": "The cult of Cybele, which for the first time formally organized as a mystic society in Rome, but the orgiast frenzy clung to it at all times."
                            },
                            {
                                "example_id": "bfb64a36-9be6-464c-b804-4007c8ce710a",
                                "sense_id": "b65b00b7-1c2a-379b-86b9-4046274ee790",
                                "text": "Rasputin became instrumental in the naming of ministers, men whose qualifications were that they were not going to interfere with the cushy double life he led — as sainted adviser to the royal family and as accomplished orgiast."
                            },
                            {
                                "example_id": "d034100a-ef53-4047-bb9c-3dc0277013e6",
                                "sense_id": "b65b00b7-1c2a-379b-86b9-4046274ee790",
                                "text": "The Sadean orgiast is intellectual and contortionist, a Laocoön entwined by his proliferating desires."
                            }
                        ]
                    },
                    {
                        "sense_id": "30372dbf-4bb8-3cc3-ac62-39fffa8dd17d",
                        "entry_id": "87fd8efd-daa4-390d-a29e-aaf11e95e674",
                        "glosses": [
                            "One who is prone to excessive indulgence."
                        ],
                        "tags": [
                            "idiomatic"
                        ],
                        "examples": []
                    }
