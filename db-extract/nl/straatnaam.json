                                "target_senses": [
                                    {
                                        "sense_id": "1f5b4413-8757-3f70-83af-9085d7595617",
                                        "entry_id": "6654b3af-4dd5-310d-a2b0-be13f6ff8543",
                                        "glosses": [
                                            "The slang term for a drug, as traded on the streets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a12d9dd5-e871-492f-9e07-bfc62b7f6537",
                                                "sense_id": "1f5b4413-8757-3f70-83af-9085d7595617",
                                                "text": "Ecstasy is the commercially inspired American street name of MDMA (3,4-methylenedioxymethylamphetamine), a unique psychostimulant drug with both stimulant and hallucinogenic effects."
                                            },
                                            {
                                                "example_id": "0bdfbd12-7345-4e83-a2b5-82fca80696b4",
                                                "sense_id": "1f5b4413-8757-3f70-83af-9085d7595617",
                                                "text": "2008 January 19, Peter Sagal (host), Wait, Wait...Don’t Tell Me!, National Public Radio\nPolice quickly determined that the street name for holy sand was “cocaine” and said that the man’s arrest has made them think twice about the holy tic tacs and holy parsley they’ve seen lately."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0260ad99-06e2-3b31-b00d-0af2cafb1ee8",
                                        "entry_id": "6654b3af-4dd5-310d-a2b0-be13f6ff8543",
                                        "glosses": [
                                            "A person’s nickname, such as a gangster or mafia name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bf50149-9a1d-4993-a170-841f174e044b",
                                                "sense_id": "0260ad99-06e2-3b31-b00d-0af2cafb1ee8",
                                                "text": "“May I start calling you Severo? Doesn't that sound slick? It could be your street name, your punk name.” She battered her eyelashes."
                                            },
                                            {
                                                "example_id": "905d8370-b16d-4979-b00c-09b6f22fce13",
                                                "sense_id": "0260ad99-06e2-3b31-b00d-0af2cafb1ee8",
                                                "text": "Boyd asked, “What is your street name?” Mark said, “I'm called Two Fingers Mark.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e33071f4-b74e-35a6-a9df-e6d7f5b5d8b5",
                                        "entry_id": "6654b3af-4dd5-310d-a2b0-be13f6ff8543",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see street, name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05b081cb-a507-4153-bea9-6a658d9c95e9",
                                                "sense_id": "e33071f4-b74e-35a6-a9df-e6d7f5b5d8b5",
                                                "text": "I know where Eric's house is, but I've forgotten the street name."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
