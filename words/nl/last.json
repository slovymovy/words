        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4cbd32d-989e-3a62-9499-184a84521b19",
                    "sense_definition": "tweede of derde persoon enkelvoud tegenwoordige tijd van <w>lassen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vakman <w>last</w> de twee metalen buizen stevig aan elkaar.",
                            "target_lang_translations": {
                                "en": "The craftsman <w>welds</w> the two metal pipes firmly together.",
                                "ru": "Мастер крепко <w>сваривает</w> две металлические трубы друг с другом.",
                                "pl": "Rzemieślnik solidnie <w>spawa</w> ze sobą dwie metalowe rury."
                            }
                        },
                        {
                            "text": "Jij <w>last</w> die onderdelen veel sneller dan de nieuwe leerling.",
                            "target_lang_translations": {
                                "en": "You <w>weld</w> those parts much faster than the new apprentice.",
                                "ru": "Ты <w>варишь</w> эти детали гораздо быстрее, чем новый ученик.",
                                "pl": "Ty <w>spawasz</w> te części o wiele szybciej niż nowy uczeń."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm van lassen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "second or third person singular present tense of 'to weld'",
                        "ru": "форма второго или третьего лица единственного числа настоящего времени глагола 'lassen' (сваривать)",
                        "pl": "forma 2. lub 3. osoby liczby pojedynczej czasu teraźniejszego od czasownika „lassen” = „spawać”"
                    },
                    "translations": {
                        "en": [
