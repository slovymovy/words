                        "examples": [
                            {
                                "example_id": "a83a1225-901a-4eff-bf05-da98e8c542a0",
                                "sense_id": "408b06cd-7e67-36df-a4f3-db315ff8cf9d",
                                "text": "BASKRON, PASCATIR, ou PASCHARTI, (Géog.) province de la Tartarie Moscovite, bornée à l’orient par les Kalmuks ; au midi par la grande Nogaia ; au couchant par la riviere de Kam, & au nord par la Permia Velchi, & par une partie de la Siberie."
                            },
                            {
                                "example_id": "1e35280c-2bd0-4564-9793-b961a88a4050",
                                "sense_id": "408b06cd-7e67-36df-a4f3-db315ff8cf9d",
                                "text": "Les historiens et les orientalistes qui ont parlé des Ouigours ont prouvé l’origine turque de ce peuple ; M. J.-J. Schmidt de Saint-Pétersbourg est le seul qui, sur ce point, a cru devoir être d’un avis différent. Ce savant estimable s’occupe, avec beaucoup de succès, de la littérature des Mongols et des Kalmuks."
                            }
                        ]
                    }
