                                        "entry_id": "c3662ee7-fa7d-3fb0-9ea7-e18ff0c4a824",
                                        "glosses": [
                                            "Angehöriger des gleichnamigen Volkes, das in Vorderasien lebte"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e3527d8-b71f-4f1b-b00f-5b0c60dddf3e",
                                                "sense_id": "51ecbf58-3cec-30d7-aad5-ce943f0fec5d",
                                                "text": "„Das sogenannte Königreich von Obermesopotamien war ein vom Amurriter Samsi-Addu […] begründeter Territorialstaat, der große Teile Nordmesopotamiens, das Haburgebiet und den Mittleren Euphra einschließlich Mari umfaßte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef363576-fe4f-4930-992d-549cb08659a5",
                        "source_entry_id": "fa7596dd-78f6-3bee-bf82-08bb2d59a1ea",
                        "source_sense_id": "4f7dc054-5167-3031-b3d1-b36f4ed10d9f",
