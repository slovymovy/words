                                "target_senses": [
                                    {
                                        "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                        "entry_id": "a3bbf6c4-2d54-30be-a763-33743ea4a83d",
                                        "glosses": [
                                            "ohne Gnade, ohne Wohlwollen gegenüber einem Schwächeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e5d193e-2ddc-4554-a13b-eeebb61eff46",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "Der König galt als gnadenlos, wenn es um die Verfolgung seiner Feinde ging."
                                            },
                                            {
                                                "example_id": "dd590e49-eb30-432b-8f0c-2ebdb159ee15",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "Wir beuten Tiere gnadenlos aus, man denke nur an die Massentierhaltung und unseren Fleischkonsum."
                                            },
                                            {
                                                "example_id": "9c8dbf01-50f7-4326-8d78-b04e6f68a169",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "In Italien, das mit großem Einsatz Migranten aufnimmt, werden dieselben Migranten gnadenlos ausgebeutet. Große Teile der Landwirtschaft leben von diesen Ausgebeuteten."
                                            },
                                            {
                                                "example_id": "347cd810-4213-4a05-8ed7-8d9ab67fd3b5",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "Syrische Kampfflugzeuge bombardieren die Rebellengebiete mit gnadenloser Härte."
                                            },
                                            {
                                                "example_id": "8c7cb036-beb9-41f9-95d2-7c5359285158",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "Oh, diese Vorstellung war wohl gnadenlos gut!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
