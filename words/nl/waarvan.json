    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7f89c736-fb0c-3ae7-86c7-d408b7e92a63",
                    "sense_definition": "Vragend voornaamwoordelijk bijwoord gebruikt om te vragen naar de oorzaak, herkomst of het materiaal: van wat?",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "interrogative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Waarvan</w> is deze tafel gemaakt?",
                            "target_lang_translations": {
                                "en": "<w>Of what</w> is this table made?",
                                "ru": "<w>Из чего</w> сделан этот стол?"
                            }
                        },
                        {
                            "text": "<w>Waarvan</w> ken ik jou ook alweer?",
                            "target_lang_translations": {
                                "en": "<w>Where from</w> do I know you again?",
                                "ru": "<w>Откуда</w> я тебя знаю?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "waarvan gemaakt",
                        "waarvan akte"
                    ],
                    "target_lang_definitions": {
                        "en": "Interrogative pronominal adverb used to ask about the cause, origin, or material: of what? or from what?",
                        "ru": "Вопросительное местоименное наречие, используемое для вопроса о причине, происхождении или материале: из чего? от чего?"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "of what",
                                "target_lang_sense_clarification": "referring to material or origin"
                            },
                            {
                                "target_lang_word": "from what",
                                "target_lang_sense_clarification": "referring to source or cause"
                            },
                            {
                                "target_lang_word": "where from",
                                "target_lang_sense_clarification": "referring to origin or acquaintance"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "из чего",
                                "target_lang_sense_clarification": "о материале или составе"
                            },
                            {
                                "target_lang_word": "от чего",
                                "target_lang_sense_clarification": "о причине или источнике"
                            },
                            {
                                "target_lang_word": "откуда",
                                "target_lang_sense_clarification": "о месте или источнике знакомства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76d71e79-f9fd-3d4c-b313-c9856c8bb3af",
                    "sense_definition": "Betrekkelijk voornaamwoordelijk bijwoord dat verwijst naar een eerder genoemd ding of een hele zin: van wat of van hetwelk.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat is het boek <w>waarvan</w> ik de titel steeds vergeet.",
                            "target_lang_translations": {
                                "en": "That is the book <w>of which</w> I always forget the title.",
                                "ru": "Это та книга, название <w>которой</w> я постоянно забываю."
                            }
                        },
                        {
                            "text": "Er waren tien gasten <w>waarvan</w> er drie te laat kwamen.",
                            "target_lang_translations": {
                                "en": "There were ten guests, <w>of whom</w> three arrived late.",
                                "ru": "Было десять гостей, трое <w>из которых</w> опоздали."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een deel waarvan"
                    ],
                    "target_lang_definitions": {
                        "en": "Relative pronominal adverb referring to a previously mentioned thing or a whole sentence: of which or of whom.",
                        "ru": "Относительное местоименное наречие, относящееся к ранее упомянутому предмету или целому предложению: которого, из которых."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "of which",
                                "target_lang_sense_clarification": "referring to an object or concept"
                            },
                            {
                                "target_lang_word": "of whom",
                                "target_lang_sense_clarification": "referring to people in a group"
                            },
                            {
                                "target_lang_word": "whose",
                                "target_lang_sense_clarification": "indicating possession or association"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "которого",
                                "target_lang_sense_clarification": "относящееся к предмету в ед. ч."
                            },
                            {
                                "target_lang_word": "из которых",
                                "target_lang_sense_clarification": "относящееся к части группы людей или предметов"
                            },
                            {
                                "target_lang_word": "чей",
                                "target_lang_sense_clarification": "указывающее на принадлежность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bcd282e-8b9d-34f5-81eb-32c01cfca25b",
                    "sense_definition": "Pronominale bijwoordelijke vorm van <w>van</w> + wat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit is het resultaat <w>waarvan</w> we droomden.",
                            "target_lang_translations": {
                                "en": "This is the result <w>of which</w> we dreamed.",
                                "ru": "Это результат, <w>о котором</w> мы мечтали."
                            }
                        },
                        {
                            "text": "De ingrediënten <w>waarvan</w> de soep is bereid zijn vers.",
                            "target_lang_translations": {
                                "en": "The ingredients <w>from which</w> the soup is prepared are fresh.",
                                "ru": "Ингредиенты, <w>из которых</w> приготовлен суп, свежие."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "pronominal adverb"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Pronominal adverbial form of 'van' + 'wat', often used in fixed verb-preposition combinations.",
                        "ru": "Местоименная форма сочетания предлога 'van' + 'wat', часто используемая в устойчивых комбинациях глагола с предлогом."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "of which",
                                "target_lang_sense_clarification": "general relative use"
                            },
                            {
                                "target_lang_word": "about which",
                                "target_lang_sense_clarification": "when used with verbs like dreaming or thinking"
                            },
                            {
                                "target_lang_word": "from which",
                                "target_lang_sense_clarification": "referring to components or origin"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "о котором",
                                "target_lang_sense_clarification": "с глаголами типа 'мечтать'"
                            },
                            {
                                "target_lang_word": "из которого",
                                "target_lang_sense_clarification": "о компонентах или происхождении"
                            },
                            {
                                "target_lang_word": "от которого",
                                "target_lang_sense_clarification": "в связке с глаголами, требующими предлога 'от'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
