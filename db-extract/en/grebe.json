                    {
                        "translation_id": "a3d7fcb8-e6ce-40d5-a5cb-8f6ed97bf948",
                        "source_entry_id": "3b97bd2f-f1c6-36d4-ade2-5fe49d560d42",
                        "source_sense_id": "efbbfb4d-5940-3f6f-b28e-93ed2cbf37c1",
