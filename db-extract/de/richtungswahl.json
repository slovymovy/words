                ],
                "senses": [
                    {
                        "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                        "entry_id": "7628b868-e199-3649-961a-70e6ab64c95a",
                        "glosses": [
                            "Wahl, bei der vom Benutzer des Wortes eine Vermutung über eine mögliche Festlegung der politischen Richtung durch die neu Regierenden geäußert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfc07033-c813-4bd5-b3a8-06879a0733f1",
                                "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                                "text": "[1986:] „Kommunal- und Landtagswahlen seien »Stimmungswahlen, machte Generalsekretär Geißler sich und seinen Leuten Mut, die Bundestagswahl hingegen sei eine »Richtungswahl«. Was aber, wenn den Benachteiligten die ganze Richtung nicht mehr paßt, die Umverteilung von unten nach oben nicht länger hingenommen wird?“"
                            },
                            {
                                "example_id": "4b4a29fa-7f09-4096-8750-5d772aa7c7e6",
                                "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                                "text": "[1990:] „Der nordrhein-westfälische CDU-Vorsitzende und Bonner Arbeitsminister Norbert Blüm hat die Landtagswahl am 13.Mai zur „Richtungswahl“ um Deutschland erklärt.“"
                            },
                            {
                                "example_id": "b2c6b321-1535-4ca2-998a-7b6110ad9886",
                                "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                                "text": "[1994:] „Der CDU-Vorstand verabschiedete außerdem eine Erklärung, in der die Bundestagswahl als „Richtungswahl yon weitreichender Bedeutung“ bezeichnet wird.“"
                            },
                            {
                                "example_id": "9204901c-7bce-4405-893c-d2d7add63a1b",
                                "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                                "text": "[1996:] „Die nächste Bundestagswahl wird eine Richtungswahl.“"
                            },
                            {
                                "example_id": "12fafb7c-686d-4057-abb8-5cdb702bedcd",
                                "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                                "text": "[2002:] „Drei Wochen vor dem zur Richtungswahl hochstilisierten Urnengang (\"Wer Stoiber als Bundeskanzler verhindern will, muss PDS wählen\") bemüht sich die Partei mit dem Alleinvertretungsanspruch auf eine pazifistische Grundhaltung um mehr Profil auf einem ihrer zentralen Politikfelder.“"
                            },
                            {
                                "example_id": "15974b2e-705b-4e47-a91d-44ef6da4fb10",
                                "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                                "text": "[2004:] „Doch kommenden Sonntag steht in Kiew viel auf dem Spiel, es geht um weit mehr als derzeit bei Wahlen in Moskau oder Minsk: nämlich darum, ob 13 Jahre nach Erlangen der Unabhängigkeit erstmals ein prowestlicher Oppositionspolitiker den Präsidentensessel besetzt. Der 31. Oktober ist eine Richtungswahl.“"
                            },
                            {
                                "example_id": "da0612cc-5835-4673-a91a-755abfa8fdc3",
                                "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                                "text": "[2005:] „Die Wahl am 18. September bezeichnete Schröder als eine Richtungswahl zwischen verschiedenen Politik- und Gesellschaftskonzepten.“"
                            },
                            {
                                "example_id": "b3212cc3-c4b1-461a-8e91-93f716ca0173",
                                "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                                "text": "[2005:] „Die Entscheidung über die neue Regierung wird wohl eher eine Impuls- als eine Richtungswahl, meint Stephan Grünewald vom Kölner Institut für Markt- und Medienanalysen.“"
                            },
                            {
                                "example_id": "5f51d6d8-7823-4903-bfca-c91f90532900",
                                "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                                "text": "[2006, Schlagzeile:] „Richtungswahl in Wetzikon“"
                            },
                            {
                                "example_id": "0ddb95ff-15be-44d5-8c65-468aff6ff96b",
                                "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                                "text": "[2009:] „Diese Wahl ist sehr wohl eine Richtungswahl, weil durch sie entschieden wird, welchen weiteren Weg unsere Gesellschaft beschreitet.“"
                            },
                            {
                                "example_id": "b94c496a-9a04-4f30-9623-963c0cfb2ab7",
                                "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                                "text": "[2010:] „Vor zahlreichen Spitzenfunktionären sprach Spitzenkandidatin Christine Marek von einer \"Richtungswahl\".“"
                            },
                            {
                                "example_id": "375c76f4-28ab-4a50-84dc-6c0cccf0f9cb",
                                "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                                "text": "[2012:] „CSU-Chef Horst Seehofer will die Bundestagswahl im Herbst 2013 zu einer Volksabstimmung über die Zukunft der Europäischen Union machen. \"Es geht um eine Richtungswahl\", sagte der bayerische Ministerpräsident der Welt am Sonntag.“"
                            },
                            {
                                "example_id": "8e8aa926-0e4a-435e-9588-1ffd1a3225b9",
                                "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                                "text": "[2015:] „Bilaterale, Energie, mehr oder weniger Staat: Es stehen Richtungsentscheide an für das Parlament, welches im Herbst neu gewählt wird. Parteipräsidenten von links bis rechts sprechen von der Richtungswahl.“"
                            },
                            {
                                "example_id": "559f79dc-55f4-43bf-b05a-c5ffefcca49e",
                                "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                                "text": "[2016:] „Die Warnungen vor einer blauen Republik – einer FPÖ-Republik – sind also auf fruchtbaren Boden gefallen. Es war eine Richtungswahl.“"
                            },
                            {
                                "example_id": "488ef805-de9b-4eb0-b957-4c0b20bf11eb",
                                "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                                "text": "[2020:] „Die Wahl des zukünftigen US-Präsidenten wird eine Richtungswahl werden.“"
                            },
                            {
                                "example_id": "c494dd71-7cb6-4a2a-85e3-7a15840adea0",
                                "sense_id": "650b5c88-c249-3dcc-9455-183d04b9d1c4",
                                "text": "[2021:] „FDP-Generalsekretär Wissing sieht die Bundestagswahl im Herbst als Richtungswahl für Deutschland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
