                "entry_id": "058ce0b1-f787-35ff-80e4-d80e017fc5da",
                "word": "blech",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "395b9940-7d93-3cad-a896-66ebcb1955ca",
                        "entry_id": "058ce0b1-f787-35ff-80e4-d80e017fc5da",
                        "glosses": [
                            "An imitation of the sound of gagging, used to express disgust or disdain."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5cac8f14-126c-4a8d-b142-7a2bde5402ef",
                                "sense_id": "395b9940-7d93-3cad-a896-66ebcb1955ca",
                                "text": "Blech! Look at all those maggots!"
                            },
                            {
                                "example_id": "8cfadc6b-a1ec-43b8-982a-8807c852890b",
                                "sense_id": "395b9940-7d93-3cad-a896-66ebcb1955ca",
                                "text": "Speaking of showering: after my dad’s passing, I realized I was more vested in my puppy’s grooming than my own. […] On more than one occasion, I had to ask myself if I brushed my teeth that day. Blech."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dda977a5-76f3-41b2-ab29-a9b59eb9aaf6",
                        "source_entry_id": "058ce0b1-f787-35ff-80e4-d80e017fc5da",
                        "source_sense_id": "395b9940-7d93-3cad-a896-66ebcb1955ca",
