                                    },
                                    {
                                        "sense_id": "b84f32e9-e042-3873-908b-16bba8c7871f",
                                        "entry_id": "12437ab3-38b1-3ecc-9583-47f586227115",
                                        "glosses": [
                                            "A soft moist mixture, in particular:",
                                            "One used as an adhesive, especially for putting up wallpapers, etc."
                                        ],
