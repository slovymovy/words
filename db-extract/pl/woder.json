                        "glosses": [
                            "długi, wodoszczelny but gumowy, sięgający po pachwinę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d11b2fc6-5314-49a2-922b-33386eda2302",
                                "sense_id": "2c274203-d7cd-33f9-85b2-f400d1ec1ec6",
                                "text": "Młodzi strażacy poruszają się po rzece łodziami i ręcznie wyławiają ryby. Obserwowaliśmy ich w niedzielę. Długie wodery sięgające pasa, grube rękawice po łokcie, maseczki z solidnym filtrem na twarzy i na dokładkę kamizelki asekuracyjne"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
