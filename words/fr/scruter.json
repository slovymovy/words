                    "frequency": "Middle",
                    "semantic_group_id": "examen_visuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le marin <w>scrute</w> l'horizon à la recherche d'une terre ou d'un autre navire."
