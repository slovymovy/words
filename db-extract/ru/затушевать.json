                "senses": [
                    {
                        "sense_id": "3771580e-9a3d-3b06-945e-84d7369a246f",
                        "entry_id": "14b59c26-58ad-3727-86fb-497771708430",
                        "glosses": [
                            "особым графическим способом устранить светлые места на рисунке, чертеже и т. п.; покрыть тушёвкой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59a28692-405a-4bcb-b6bf-af38bc8258b7",
                                "sense_id": "3771580e-9a3d-3b06-945e-84d7369a246f",
                                "text": "Посмотри, Генечка, он зачёркал и затушевал свой рисунок, так, что ничего не видно."
                            }
                        ]
                    },
                    {
                        "sense_id": "039964e6-7356-32cb-ba0a-7097e86d1e66",
                        "entry_id": "14b59c26-58ad-3727-86fb-497771708430",
                        "glosses": [
                            "перен. сделать что-либо менее заметным; сгладить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06e3c2d6-149a-4e93-a667-04a2628486b8",
                                "sense_id": "039964e6-7356-32cb-ba0a-7097e86d1e66",
                                "text": "Белоярцеву хотелось выйти с достоинством из этого спора и скорее затушевать его."
                            },
                            {
                                "example_id": "31c6f421-1dff-42d2-bc27-72f912574111",
                                "sense_id": "039964e6-7356-32cb-ba0a-7097e86d1e66",
                                "text": "В автобиографии все это надо было отчасти затушевать, отчасти представить в ином смысле."
                            }
                        ]
                    }
