                                        "entry_id": "9d97df87-d5df-3efc-ba11-970e50661ad0",
                                        "glosses": [
                                            "An elected head of a parish (also known as a connétable)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbf04803-bb45-3fa6-93fd-ec8f4da6fcbb",
