                "forms": [],
                "senses": [
                    {
                        "sense_id": "e808940d-1b39-30d2-be9a-53c0960f8fa7",
                        "entry_id": "4b35f4e4-5111-36af-97a3-54a478357304",
                        "glosses": [
                            "de bovenste laag kleding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edad3054-b60d-4f67-a9ba-f1a731ba7171",
                                "sense_id": "e808940d-1b39-30d2-be9a-53c0960f8fa7",
                                "text": "Wasserettes als deze, waar vreemde mensen elkaar ontmoetten en zwijgend het intieme ritueel uitvoerden van het in het openbaar wassen van onder- en bovengoed vormden een aspect van een wereld die voor een groot deel van de bevolking al aan het verdwijnen was, vervangen door wasmachines thuis of door wasserijen waar de rijkere mensen hun kleren afleverden en een paar dagen later weer ophaalden."
                            },
                            {
                                "example_id": "2fc1f09e-240e-49a4-b4e6-4d002e24a375",
                                "sense_id": "e808940d-1b39-30d2-be9a-53c0960f8fa7",
                                "text": "De liefhebbers kunnen bij Zara Enschede straks terecht voor mannen- en vrouwenkleding, onder- en bovengoed, schoenen en accessoires. Wellicht dat daar ook kinderkleding bij komt. „Het wordt een compleet aanbod”, verzekert Elizen. Hij sluit niet uit dat de kledinggigant, als het uitkomt, op de eerste verdieping ruimte gaat creëren voor woonaccessoires. „Maar het accent ligt op de mode.”"
                            }
                        ]
                    }
