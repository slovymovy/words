                                "target_senses": [
                                    {
                                        "sense_id": "b58e2c45-5ee9-3273-a75e-dfcc501054cb",
                                        "entry_id": "b8e173be-5e3a-39b5-9c8e-078491744051",
                                        "glosses": [
                                            "A small ball placed in a container to cast a vote; now, by extension, a piece of paper or card used for this purpose, or some other means used to signify a vote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4107395d-ce96-4b14-81cd-6136dd7eed1f",
                                                "sense_id": "b58e2c45-5ee9-3273-a75e-dfcc501054cb",
                                                "text": "Imagine if the outcome in Michigan is close, and 75% of Biden supporters vote absentee, yet 10% or more of those ballots are rejected."
                                            },
                                            {
                                                "example_id": "4d4d2d16-35f2-423f-b97c-796be95ef80d",
                                                "sense_id": "b58e2c45-5ee9-3273-a75e-dfcc501054cb",
                                                "text": "In Wyoming, a GOP state senator forwarded an FGA draft bill to Secretary of State Chuck Gray that would prohibit sending out unsolicited absentee ballot request forms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fa69bef-381f-37e8-ac35-c0bfd690d2ab",
                                        "entry_id": "b8e173be-5e3a-39b5-9c8e-078491744051",
                                        "glosses": [
                                            "The process of voting, especially in secret; a round of voting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55792c1b-2328-4d58-ae0d-8d2c29310e2e",
                                                "sense_id": "7fa69bef-381f-37e8-ac35-c0bfd690d2ab",
                                                "text": "July 1836, A. B. (initials of author), London and Westminster Review Article XI, Bribery and Intimidation at Elections\nthe insufficiency of the ballot"
                                            },
                                            {
                                                "example_id": "f6c2c896-6e57-4c03-843f-6c302006af1e",
                                                "sense_id": "7fa69bef-381f-37e8-ac35-c0bfd690d2ab",
                                                "text": "In the TSSA ballot, 80% of management grade and 60% of general grade members voted to accept, on an overall turnout of 57%."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9d5f131-25c1-3a87-8e02-1eca133a2b95",
