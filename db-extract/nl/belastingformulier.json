                                "sense_id": "9c95e56b-bdcc-3f0e-927e-a9c2678208a2",
                                "text": "Ik heb moeite met het invullen van mijn belastingformulier.",
                                "translation": "I have difficulty filling out my tax form.",
                                "english": "I have difficulty filling out my tax form."
                            },
                            {
                                "example_id": "1c2a2693-9b20-4a6f-88d6-198706503754",
                                "sense_id": "9c95e56b-bdcc-3f0e-927e-a9c2678208a2",
                                "text": "Je moet je belastingformulier voor april indienen.",
                                "translation": "You need to submit your tax form by April.",
                                "english": "You need to submit your tax form by April."
                            },
                            {
                                "example_id": "f56ebec7-062f-4a5a-813a-9d95f5cdb4c1",
                                "sense_id": "9c95e56b-bdcc-3f0e-927e-a9c2678208a2",
                                "text": "Waar kan ik het benodigde belastingformulier vinden?",
                                "translation": "Where can I find the required tax form?",
