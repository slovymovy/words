                "senses": [
                    {
                        "sense_id": "b62636fa-9869-3a07-975f-2565e448f3aa",
                        "entry_id": "65dc5c8e-d8ed-3efa-982b-07901bcd2c88",
                        "glosses": [
                            "etwas, das in Akten aufgezeichnet ist (beispielsweise in Vernehmungsprotokollen, Steuerunterlagen, Verträgen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6392702-522a-442a-9084-e06690e3c5ab",
                                "sense_id": "b62636fa-9869-3a07-975f-2565e448f3aa",
                                "text": "Nach derzeitiger Aktenlage könnte der Angeklagte schuldig sein."
                            },
                            {
                                "example_id": "546457c9-af8e-46ad-94ba-ba236ba81d04",
                                "sense_id": "b62636fa-9869-3a07-975f-2565e448f3aa",
                                "text": "[…] die Rentenkasse verlangte – gemäß dem Getto-Renten-Gesetz von 2002 – dass die Überlebenden weltweit mehrseitige deutsche Formulare ausfüllen und, bizarr, einstige Lohnzahlungen im Getto nachweisen. Klagten Betroffene dagegen, entschieden die Richter zumeist nach Aktenlage – ohne Anhörung."
                            },
                            {
                                "example_id": "43497204-dbd1-45b7-b72f-4457452dc585",
                                "sense_id": "b62636fa-9869-3a07-975f-2565e448f3aa",
                                "text": "Im Übrigen wurde der Pergamon-Altar nie offiziell von der Türkei zurückgefordert, weil man weiß, dass die Aktenlage eindeutig ist."
                            },
                            {
                                "example_id": "5eb5084b-3346-430b-9e80-42e9422b52a5",
                                "sense_id": "b62636fa-9869-3a07-975f-2565e448f3aa",
                                "text": "[…] es wurde deutlich bei der Pressekonferenz gestern in Hildesheim, dass auch die Aktenführung, die Aktenlage im Bistum Hildesheim, was die Personalie Peter R. angeht, unvollständig ist."
                            },
                            {
                                "example_id": "d17ae416-b93e-4dce-a6ea-7755fa714a7a",
                                "sense_id": "b62636fa-9869-3a07-975f-2565e448f3aa",
                                "text": "[Der SS-Obersturmbannführer Adolf Eichmann] hatte im Reichssicherheitshauptamt in Berlin die Aktenlage für die berüchtigte \"Wannsee-Konferenz\" am 20. Januar 1942 akribisch vorbereitet."
                            },
                            {
                                "example_id": "f4f5ad93-08c0-4eb4-a2d3-332fd1163039",
                                "sense_id": "b62636fa-9869-3a07-975f-2565e448f3aa",
                                "text": "In dem Gauck-Gutachten steht […], nach Aktenlage sei es nicht zu einer \"förmlichen Verpflichtung von Dr. Gysi als IM\" gekommen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
