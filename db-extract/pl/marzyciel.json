                                "target_senses": [
                                    {
                                        "sense_id": "f12e4543-2b13-30f2-bea4-53f44ae4df5d",
                                        "entry_id": "042f6571-8568-3dcb-b30e-cdb422e36cf2",
                                        "glosses": [
                                            "Rêveur, qui songe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14e965ce-d2ba-454e-84fa-6027a6efb127",
                                                "sense_id": "f12e4543-2b13-30f2-bea4-53f44ae4df5d",
                                                "text": "Un esprit songeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1942bd59-5bf8-3b9b-93d0-f9e93ae989e6",
                                        "entry_id": "042f6571-8568-3dcb-b30e-cdb422e36cf2",
                                        "glosses": [
                                            "Penseur, absorbé par une pensée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0adabb16-d9e1-4f90-a611-cf655977556a",
                                                "sense_id": "1942bd59-5bf8-3b9b-93d0-f9e93ae989e6",
                                                "text": "L’adolescent se tenait debout, son calot à la main. Il avait l’air songeur, préoccupé : une ride lui sillonnait douloureusement le front."
                                            },
                                            {
                                                "example_id": "4afe7450-092a-4a0f-b16c-aed79388b0b7",
                                                "sense_id": "1942bd59-5bf8-3b9b-93d0-f9e93ae989e6",
                                                "text": "Le paradoxe laisse songeur : pendant qu’architectes et gouvernants se demandent s’il ne faut pas rebâtir en métal ou en béton la charpente en chêne de Notre-Dame, la construction en bois connaît une brusque montée de sève."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "songeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33eacb21-0b5b-3616-aaf7-1fbb3316f09a",
                                        "entry_id": "a229e3da-a2d7-3f92-8d33-1729b2273b65",
                                        "glosses": [
                                            "Celui qui se laisse aller à la rêverie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19991bec-af06-412a-9980-ec038dbd055a",
                                                "sense_id": "33eacb21-0b5b-3616-aaf7-1fbb3316f09a",
                                                "text": "C’est un songeur perpétuel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc0088cd-20e8-4e1b-a1d4-a2c6a1a55641",
                        "source_entry_id": "fa9e8d95-adb9-319a-9a81-5f06d6b8ef94",
                        "source_sense_id": "3461d99a-4002-3220-b51d-8d9d7db840f0",
                        "target_lang_word": "soñador",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soñador",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "5fd91591-938f-3048-8740-b90deb39e6a2",
                                        "entry_id": "76759485-91f1-372a-a7a4-5f68d472c769",
                                        "glosses": [
                                            "Que sueña mucho."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3fb3e03e-648f-397f-9718-0bd4b8bf043c",
                                        "entry_id": "76759485-91f1-372a-a7a4-5f68d472c769",
                                        "glosses": [
                                            "Aquella persona que vive entre sueños y fantasías, alejada de la realidad."
                                        ],
                                        "tags": [
                                            "masculine",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67ec040f-0d79-467d-9520-ab1f9a123f88",
                                                "sense_id": "3fb3e03e-648f-397f-9718-0bd4b8bf043c",
                                                "text": "Sé que reinará el romance de verdad\nY aunque tenga un rostro horrible, soy un soñador sublime\nY como todos tengo un sueño ideal"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6d9e9dd0-1b5d-35a0-b388-9148be5aaf67",
                                        "entry_id": "76759485-91f1-372a-a7a4-5f68d472c769",
                                        "glosses": [
                                            "Que cuenta patrañas y ensueños o les da crédito fácilmente."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a56015b7-3ff1-4ba3-acae-2cbb4b4c42e1",
                        "source_entry_id": "fa9e8d95-adb9-319a-9a81-5f06d6b8ef94",
                        "source_sense_id": "3461d99a-4002-3220-b51d-8d9d7db840f0",
                        "target_lang_word": "Träumer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Träumer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c09e012-e091-31dd-ae39-83ca4a281985",
                                        "entry_id": "1b3e2f9d-1b0f-37c7-992f-772a23c2fadb",
                                        "glosses": [
                                            "Person, die im Schlaf träumt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27512e5f-df55-41bc-b365-110a683aef51",
                                                "sense_id": "5c09e012-e091-31dd-ae39-83ca4a281985",
                                                "text": "Am Morgen wird der Träumer gebeten, seinen Traum so detailreich wie möglich zu schildern."
                                            },
                                            {
                                                "example_id": "481a4300-89e3-4cb5-9ba5-6642ff2da6f3",
                                                "sense_id": "5c09e012-e091-31dd-ae39-83ca4a281985",
                                                "text": "Ein Träumer kann nur selten seinen Traum beeinflussen oder ihn beenden."
                                            },
                                            {
                                                "example_id": "cf40ce27-d834-4564-8f9f-b9d341e7e955",
                                                "sense_id": "5c09e012-e091-31dd-ae39-83ca4a281985",
                                                "text": "Er ist kein Träumer, jedenfalls kann er sich kaum einmal daran erinnern, im Schlaf geträumt zu haben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a9021f08-5741-39b6-8650-abd449777f3e",
                                        "entry_id": "1b3e2f9d-1b0f-37c7-992f-772a23c2fadb",
                                        "glosses": [
                                            "Person, die stark von ihren Traumvorstellungen (Wunschvorstellungen oder auch unrealistischen Vorstellungen über die Wirklichkeit) beeinflusst wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e40119d1-2f9e-4849-afd3-b1e1d584bdc4",
                                                "sense_id": "a9021f08-5741-39b6-8650-abd449777f3e",
                                                "text": "„Der Träumer war allerdings kein Weichling.“"
                                            },
                                            {
                                                "example_id": "06a6646d-ab45-40a7-ad1b-e86c61dbbc3a",
                                                "sense_id": "a9021f08-5741-39b6-8650-abd449777f3e",
                                                "text": "Du bist doch ein Träumer! Glaubst Du wirklich, dass er freiwillig nachgeben wird?"
                                            },
                                            {
                                                "example_id": "9d09ddcc-6da2-48a3-953b-e018b403c043",
                                                "sense_id": "a9021f08-5741-39b6-8650-abd449777f3e",
                                                "text": "Wir brauchen Träumer, die das vordenken, was andere später einmal realisieren werden."
                                            },
                                            {
                                                "example_id": "33d3ba78-bc9e-4049-844b-3779a7099a97",
                                                "sense_id": "a9021f08-5741-39b6-8650-abd449777f3e",
                                                "text": "„Ein solcher Träumer war Jakob Haringer, ein Träumer aus schierer Verzweiflung.“"
                                            },
                                            {
                                                "example_id": "e251068f-d87c-494a-8fbb-825dd6a8880a",
                                                "sense_id": "a9021f08-5741-39b6-8650-abd449777f3e",
                                                "text": "„Wenn die Gegenseite Krieg will, hilft Friedensliebe wenig. Pazifisten gelten heute als Träumer, Populisten oder Putin-Versteher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
