                        "entry_id": "c3583767-5256-3d17-bd3d-23eafe24b2fb",
                        "glosses": [
                            "A boy who sells sand."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9bcbb7b-c743-4eed-ad67-0ceefe76dcf2",
                                "sense_id": "42d245da-33dd-34ce-b9b6-c52d3e2b14b0",
                                "text": "Up and down the street not a child was to be seen. A sandboy with a donkey cart was the sole human arrangement in it."
                            }
                        ]
                    },
                    {
                        "sense_id": "7cab76f9-96fe-359e-ade9-83b36c95073a",
                        "entry_id": "c3583767-5256-3d17-bd3d-23eafe24b2fb",
                        "glosses": [
                            "A proverbially happy or jolly person."
                        ],
                        "tags": [
                            "in similes"
                        ],
                        "examples": [
                            {
                                "example_id": "2077f8e5-42e2-4418-b2a1-c1aaa1a6ecd6",
                                "sense_id": "7cab76f9-96fe-359e-ade9-83b36c95073a",
                                "text": "Drink always rubbed him the right way, and he would reach his rooms as jolly as a sandboy."
                            },
                            {
                                "example_id": "2f58f466-fad8-4f6b-b3c1-4831d98d195a",
                                "sense_id": "7cab76f9-96fe-359e-ade9-83b36c95073a",
                                "text": "Craw was happy as a sandboy, he reported: quite his former vile self, but a bit dazed to be bearded by Luke without warning."
                            }
                        ]
                    }
                ],
