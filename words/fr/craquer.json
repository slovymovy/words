                },
                {
                    "sense_id": "d7ecb2d5-023f-3b42-a630-c13d0784b8e0",
                    "sense_definition": "Émettre son cri caractéristique, en parlant de la cigogne ou de la grue.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cri_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au sommet du clocher de notre village, les cigognes <w>craquent</w> dès l'arrivée du printemps."
                        },
                        {
                            "text": "On entendait la grue <w>craquer</w> au loin au-dessus des marais brumeux."
