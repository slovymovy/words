                        "source_sense_id": "9defde55-6ad1-33f3-a36c-5618636d788b",
                        "target_lang_word": "Franse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Franse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8cad7fab-849e-3e29-8682-43e5674caf09",
                                        "entry_id": "aa40e3fc-1204-320a-9fcb-59e7dc8abbcd",
                                        "glosses": [
                                            "einer von mehreren am Rand eines Textilstücks zur Zierde herabhängenden Fäden"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12537c8a-e302-4015-beaf-57d9a0f6404b",
                                                "sense_id": "8cad7fab-849e-3e29-8682-43e5674caf09",
                                                "text": "„Nach Sitte der Hinterwäldler war er in ein baumwollenes Jagdhemd mit Fransen, Ledergamaschen, sogenannte Leggins, und grobe Schuhe gekleidet.“"
                                            },
                                            {
                                                "example_id": "c646d17b-8841-44cd-b5cb-2db48998be6b",
                                                "sense_id": "8cad7fab-849e-3e29-8682-43e5674caf09",
                                                "text": "„Ich spiele mit den Fransen der Tischdecke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9db58ca8-51e6-4395-8648-5c41a5b9d2d2",
                        "source_entry_id": "84fd06e9-5ab1-36e1-91e5-739bd3d9f1cd",
                        "source_sense_id": "9defde55-6ad1-33f3-a36c-5618636d788b",
                        "target_lang_word": "Staubwedel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Staubwedel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3bbbc99b-d029-3ccc-819e-5d70267e5932",
                                        "entry_id": "11ee6cb9-47ca-317f-bdcb-0c66ad72f7f1",
                                        "glosses": [
                                            "handliches Haushaltsgerät mit weichen, dünnen Borsten, Federn oder dergleichen zum Entfernen von Staub oder Schmutz, häufig an schwer erreichbaren Stellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0550794-de25-46a9-a8ff-dd3ca4f4dc94",
                                                "sense_id": "3bbbc99b-d029-3ccc-819e-5d70267e5932",
                                                "text": "„Sie war vor einer Abstellkammer stehengeblieben und reichte mir einen Staubwedel.“"
                                            },
                                            {
                                                "example_id": "c48fc2a4-d76a-4b2f-a4ab-5db862683b0e",
                                                "sense_id": "3bbbc99b-d029-3ccc-819e-5d70267e5932",
                                                "text": "Mit dem Staubwedel wischte sie den Schrank ab."
                                            },
                                            {
                                                "example_id": "f1931cc7-3922-413d-88bb-fd00f23c53a8",
                                                "sense_id": "3bbbc99b-d029-3ccc-819e-5d70267e5932",
                                                "text": "„Den Staubwedel brauche ich für meine Gemälde; sie dürfen nur mit diesem Staubwedel gereinigt werden.“"
                                            },
                                            {
                                                "example_id": "329ecf37-ce2a-4fb2-be4b-695cafdaa765",
                                                "sense_id": "3bbbc99b-d029-3ccc-819e-5d70267e5932",
                                                "text": "„Sobald sie ihre Arbeit begutachtet hatte, griff sie nach einem Staubwedel und führte ihn an der Tapete entlang.“"
                                            },
                                            {
                                                "example_id": "4cb52022-05cb-4fdf-a3d5-2b6322d98502",
                                                "sense_id": "3bbbc99b-d029-3ccc-819e-5d70267e5932",
                                                "text": "„Unsere Mönche benutzen nur vier Dinge: Besen, Scheuerlappen, Staubwedel und Eimer, mehr nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
