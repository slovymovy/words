                "senses": [
                    {
                        "sense_id": "721272bb-8000-339f-9372-129e853a2db3",
                        "entry_id": "67d7aa56-acb7-3244-bb03-9f3d6e198b5d",
                        "glosses": [
                            "rij voertuigen die de overleden persoon naar de begraafplaats of crematorium begeleidt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b42aef8-da6b-4544-b5b1-81cd4e3d8201",
                                "sense_id": "721272bb-8000-339f-9372-129e853a2db3",
                                "text": "Op de begrafenis van het vermoorde Britse parlementslid Jo Cox is het tot emotionele taferelen gekomen. Honderden mensen stonden langs de kant van de weg toen de rouwstoet met het lichaam van de pro-Europese politica vrijdag door Heckmondwike en andere oorden van haar kiesdistrict in West Yorkshire reed. Vele mensen gooiden bloemen op straat en applaudisseerden toen de lijkstoet voorbijtrok."
                            },
                            {
                                "example_id": "30689c62-8597-40f8-8bc4-c4e9d4ffbc61",
                                "sense_id": "721272bb-8000-339f-9372-129e853a2db3",
                                "text": "De klok van de oude St Bartholomew-kerk in Wootton Bassett begint te luiden, ten teken dat de lijkstoet met de honderdste gesneuvelde Britse militair van dit jaar in Afghanistan in aantocht is. Honderden mensen uit het plaatsje in het zuid-Engelse graafschap Wiltshire maar ook uit de wijde omgeving hebben de ijzige motregen getrotseerd om langs de hoofdstraat hun respect te betuigen. Op slag zwijgen ze eerbiedig."
                            }
                        ]
                    }
