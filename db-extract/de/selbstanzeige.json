                        "glosses": [
                            "Anzeige, die ein Täter gegen sich selbst zur Strafmilderung erstattet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fd92402-c431-425d-b2bd-7a1a8c2510a8",
                                "sense_id": "6d2234e8-cef7-3762-811c-d3e7a5e1586e",
                                "text": "„Damals verhängten die Bochumer Staatsanwälte gegen eine Liechtensteiner Bank eine Geldbuße von 44 Millionen Euro. Und schon zuvor brachte der Kauf von CDs mit Bankdaten aus Liechtenstein und der Schweiz den Staatskassen bundesweit Hunderte Millionen Euro ein - und viele Tausend Selbstanzeigen reuiger Steuerhinterzieher, die es mit der Angst bekamen.“"
                            }
                        ],
