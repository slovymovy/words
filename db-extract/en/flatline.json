                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9c4358a5-8a9c-40da-bd05-2c9bb87a5ff4",
                                "sense_id": "60d3d6d0-dd50-3d12-8fb7-33c766300384",
                                "text": "Thus, you hear words like \"flatline recession,\" \"improvement at a greatly reduced rate,\" \"economic hiccup,\" \"recessionette,\" \"rolling readjustment\" and \"the economy is double clutching.\""
                            }
                        ]
                    },
