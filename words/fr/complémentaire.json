    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a741fa37-0897-3774-9d98-8753764163cf",
                    "sense_definition": "Qui s'ajoute à une autre chose pour la compléter ou l'enrichir.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "complet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pourriez-vous nous fournir des informations <w>complémentaires</w> sur ce projet ?"
                        },
                        {
                            "text": "Ces deux collaborateurs possèdent des compétences parfaitement <w>complémentaires</w>."
                        }
                    ],
                    "synonyms": [
                        "additionnel",
                        "supplémentaire"
                    ],
                    "common_phrases": [
                        "information complémentaire",
                        "mesures complémentaires"
                    ]
                },
                {
                    "sense_id": "be3707ba-2518-3a12-87d5-e0a0637d2554",
                    "sense_definition": "Se dit de deux couleurs qui produisent du blanc en synthèse additive ou un ton neutre en synthèse soustractive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste associe des couleurs <w>complémentaires</w> pour faire vibrer sa toile."
                        },
                        {
                            "text": "Le rouge et le vert sont des teintes <w>complémentaires</w> très contrastées."
                        }
                    ],
                    "common_phrases": [
                        "couleurs complémentaires"
                    ]
                },
                {
                    "sense_id": "e254ee10-3aa1-34f1-81c9-c69d0df2bef6",
                    "sense_definition": "Se dit de deux angles dont la somme est égale à quatre-vingt-dix degrés.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geometrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans un triangle rectangle, les deux angles aigus sont <w>complémentaires</w>."
                        },
                        {
                            "text": "Le professeur demande de tracer deux angles <w>complémentaires</w> sur la feuille."
                        }
                    ],
                    "antonyms": [
                        "supplémentaire"
                    ],
                    "common_phrases": [
                        "angles complémentaires"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f0b58f9-1e83-3676-ae15-419f0617ae0b",
                    "sense_definition": "Ce qui complète un élément, en particulier la couleur qui en forme la contrepartie harmonieuse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vert est le <w>complémentaire</w> direct du rouge dans le cercle chromatique."
                        },
                        {
                            "text": "Chaque teinte vive est mise en valeur par son <w>complémentaire</w>."
                        }
                    ],
                    "synonyms": [
                        "complément"
                    ]
                },
                {
                    "sense_id": "a746cf51-db73-3a34-b2d2-7d448dbdc008",
                    "sense_definition": "Ensemble constitué de tous les éléments d'un ensemble de référence qui n'appartiennent pas à une partie donnée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On note souvent le <w>complémentaire</w> d'une partie avec la lettre C en exposant."
                        },
                        {
                            "text": "Le <w>complémentaire</w> de l'ensemble vide correspond à l'ensemble tout entier."
                        }
                    ]
                }
            ]
        }
    ]
