                "senses": [
                    {
                        "sense_id": "883998de-7077-3497-9360-bed7e59f37aa",
                        "entry_id": "773b7269-487a-38b6-aabd-ed17de33e325",
                        "glosses": [
                            "(vergleichende) Untersuchung eines aus Hopfen, Malz und Wasser gebrauten (meistens) alkoholischen Getränks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6853eef9-54a8-4718-929b-a0b9fa38c7a8",
                                "sense_id": "883998de-7077-3497-9360-bed7e59f37aa",
                                "text": "„Ariely führte mit seinen Kollegen noch ähnliche Versuche mit Kaffee durch und weitere Varianten des Biertests.“"
                            },
                            {
                                "example_id": "3372968f-eade-4516-8af3-28c9efa64005",
                                "sense_id": "883998de-7077-3497-9360-bed7e59f37aa",
                                "text": "„Allerdings kamen die Bierkieser oft aus den unteren Schichten und man konnte es ihnen kaum verübeln, wenn sie von den Brauern und Wirten Geld annahmen, so daß die Ergebnisse des Biertestes immer entsprechend ausfielen.“"
                            },
                            {
                                "example_id": "cf08989d-b5e1-4a22-942c-384beef7f38f",
                                "sense_id": "883998de-7077-3497-9360-bed7e59f37aa",
                                "text": "„Beim Biertest am Samstag liegt er dennoch einmal daneben.“"
                            },
                            {
                                "example_id": "2fee8d84-d924-41b3-88d0-acc8697d30a1",
                                "sense_id": "883998de-7077-3497-9360-bed7e59f37aa",
                                "text": "„Die an den Biertests beteiligten Schüler sind 18 Jahre und älter, betont [die] Lehrerin […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
