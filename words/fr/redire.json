                    "frequency": "Low",
                    "semantic_group_id": "indiscretion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je te confie ce secret mais promets-moi de ne rien <w>redire</w> à quiconque."
                        },
                        {
                            "text": "Il ne faut rien lui confier car il va immédiatement tout <w>redire</w> aux voisins."
