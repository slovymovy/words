                        "glosses": [
                            "Nom des membres d'une secte fondée en 1793 par les frères Bonjour, curés à Fareins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ea900a0-12f7-41b1-a51f-d34feb8f2a09",
                                "sense_id": "51c86a65-fa3f-3c60-a5e3-631d7ef05e48",
                                "text": "Les fareinistes ont disparu vers le début du xixᵉ siècle."
                            },
                            {
