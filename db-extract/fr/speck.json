                "senses": [
                    {
                        "sense_id": "d4cdbd41-abbd-36bb-8e42-e35c38c77393",
                        "entry_id": "4ac74c56-a1db-3d3c-b002-94474bc404d3",
                        "glosses": [
                            "Longe de porc fumée, spécialité du Tyrol italien (province autonome de Bolzano, majoritairement germanophone)."
                        ],
                        "tags": [
                            "Boucherie"
                        ],
                        "examples": [
                            {
                                "example_id": "896b61d1-9fb1-4ab8-a9cd-6c0ea18a53fa",
                                "sense_id": "d4cdbd41-abbd-36bb-8e42-e35c38c77393",
                                "text": "Aujourd’hui, Jérôme Nolin, du restaurant Avenio à Avignon, nous dévoile sa recette de velours de topinambours et châtaignes et tranches de speck, sur une poêlée de champignons et oignons."
                            },
                            {
                                "example_id": "c5a7b0c7-f14f-49ed-bc96-95df8e279914",
                                "sense_id": "d4cdbd41-abbd-36bb-8e42-e35c38c77393",
                                "text": "Faites griller la tranche de speck à la poêle 1 à 2 min de chaque côté pour qu’elle soit bien croustillante puis déposez-la sur un papier absorbant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1991cc14-66c5-400f-9e2c-ec6b81476df5",
                        "source_entry_id": "4ac74c56-a1db-3d3c-b002-94474bc404d3",
                        "source_sense_id": "d4cdbd41-abbd-36bb-8e42-e35c38c77393",
