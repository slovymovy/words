                "senses": [
                    {
                        "sense_id": "cf8e4b0f-61f6-3f12-a2ed-1dca722b5b96",
                        "entry_id": "01fac667-65ae-3ee8-96b7-3baf800bd6bc",
                        "glosses": [
                            "eine weiße Rebsorte, die fast ausschließlich im badischen Markgräflerland angebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd4efa16-3c80-498c-baac-c5630fddeb42",
                                "sense_id": "cf8e4b0f-61f6-3f12-a2ed-1dca722b5b96",
                                "text": "„Neben dem verhältnismäßig hohen manuellen Arbeitsaufwand benötigt der Nobling zum Erreichen hoher Mostgewichte auch gute bis sehr gute Lagen, anders als etwa die Sorte Müller-Thurgau, die deutlich weniger Ansprüche an die Lage stellt.“"
                            },
                            {
                                "example_id": "1812263f-d06b-491b-85ee-47d613bde291",
                                "sense_id": "cf8e4b0f-61f6-3f12-a2ed-1dca722b5b96",
                                "text": "Der Nobling ist eine Neuzüchtung aus den Sorten Gutedel und Silvaner."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "34568dca-da4c-3a68-8a78-139cf15a9f3e",
