                                    {
                                        "sense_id": "7f95be14-e64e-39a8-a536-8e5c98525a33",
                                        "entry_id": "a1fa3869-c8a5-33f6-a726-8844fb6b0a33",
                                        "glosses": [
                                            "Hard-working and persistent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae73af4a-5fc5-4dc4-a023-8277cc6b3df9",
                                                "sense_id": "7f95be14-e64e-39a8-a536-8e5c98525a33",
                                                "text": "She was a very industrious student at school."
                                            },
                                            {
                                                "example_id": "4dabaa21-3397-4a81-90f3-6c44a8c648b0",
                                                "sense_id": "7f95be14-e64e-39a8-a536-8e5c98525a33",
                                                "text": "The ant has made himself illustrious / Through constant industry industrious. / So what? / Would you be calm and placid / If you were full of formic acid?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12b1398f-3751-4271-a5dc-0095dcc2783b",
                        "source_entry_id": "bb1867f9-4e3a-3732-ba98-af62ad25ad9b",
                        "source_sense_id": "a361fe81-6a65-3b92-8fc5-f52cd4fba56e",
                        "target_lang_word": "hard-working",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hard-working",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68e23ec5-f575-3127-82d6-d8e54126d3a4",
                                        "entry_id": "e7e253ef-9ed9-3f7c-9632-43698d52265d",
                                        "glosses": [
                                            "Alternative form of hardworking."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ff1d2e9-de5e-4d06-8b5e-e630e323132a",
                                                "sense_id": "68e23ec5-f575-3127-82d6-d8e54126d3a4",
                                                "text": "Coal-eaters they may have been, but a more willing or harder working Atlantic engine was never designed."
                                            },
                                            {
                                                "example_id": "0c4d8ded-8810-4b60-b9b4-4cf03e1fcdb2",
                                                "sense_id": "68e23ec5-f575-3127-82d6-d8e54126d3a4",
                                                "text": "Observation of my elders and betters in other advertising agencies leads me to believe that many of them are more objective, better organized, more vigorous, and harder-working than their opposite numbers in legal practice, teaching, banking, and journalism."
                                            },
                                            {
                                                "example_id": "3e871a70-802a-4d5d-9b24-b0585b299360",
                                                "sense_id": "68e23ec5-f575-3127-82d6-d8e54126d3a4",
                                                "text": "‘I could say a million things about you, but the one thing I could never say is that you’re lazy. You’re one of the hardest-working men I’ve ever known.’"
                                            },
                                            {
                                                "example_id": "e3cc1c1a-3e43-4297-9ee7-2a799e99e287",
                                                "sense_id": "68e23ec5-f575-3127-82d6-d8e54126d3a4",
                                                "text": "One other thing: throughout all this, the railway has remained home for thousands of dedicated, hard-working people. They're out there in all conditions ensuring that 1.7 billion passenger journeys can be made per year."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
