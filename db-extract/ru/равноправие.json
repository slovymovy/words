                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c105f25-b987-3166-b130-d927de1d3e5f",
                                        "entry_id": "1d85a5f7-c266-3e9c-8b13-ffa7d07f88cc",
                                        "glosses": [
                                            "bedensel, ruhsal başkalıkları ne olursa olsun, insanlar arasında toplumsal ve siyasi haklar yönünden ayrım bulunmaması durumu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18ecdd38-6428-4f7b-ba64-5c0887afd978",
                                                "sense_id": "3c105f25-b987-3166-b130-d927de1d3e5f",
                                                "text": "Bunlar, eşitlikten yana olduklarını söyleseler de yaptıkları işler hep kendi ipliklerini boyamaya dayanır."
                                            }
                                        ]
                                    },
                                    {
