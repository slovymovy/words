{
    "word_family": [
        "cook",
        "cookery",
        "cooky"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94f6a9a8-6ddb-3aa3-9c0a-15bcde3ca81e",
                    "sense_definition": "A small, flat, baked sweet treat that is typically crisp or soft but firm.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "baked-goods",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like to eat a chocolate chip <w>cookie</w> with my glass of milk.",
                            "target_lang_translations": {
                                "ru": "Я бы хотел съесть <w>печенье</w> с шоколадной крошкой и выпить стакан молока."
                            }
                        },
                        {
                            "text": "She decided to <w>bake</w> <w>cookies</w> for the school bake sale this weekend.",
                            "target_lang_translations": {
                                "ru": "Она решила испечь <w>печенье</w> для школьной благотворительной ярмарки в эти выходные."
                            }
                        }
                    ],
                    "synonyms": [
                        "biscuit",
                        "bickie"
                    ],
                    "common_phrases": [
                        "bake cookies",
                        "chocolate chip cookie",
                        "oatmeal cookie",
                        "sugar cookie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое плоское выпеченное сладкое лакомство, обычно хрустящее или мягкое, но плотное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "печенье",
                                "target_lang_sense_clarification": "кондитерское изделие"
                            },
                            {
                                "target_lang_word": "печенька",
                                "target_lang_sense_clarification": "разговорное, уменьшительное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c076751-c920-3b3d-85d6-9eb1a3d7dc8f",
                    "sense_definition": "A small piece of data sent from a website and stored on the user's computer by the web browser.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This website uses a <w>cookie</w> to remember your login information for next time.",
                            "target_lang_translations": {
                                "ru": "Этот сайт использует <w>куки</w>, чтобы запомнить ваши данные для входа на следующий раз."
                            }
                        },
                        {
                            "text": "You can go into your browser settings to <w>clear</w> <w>cookies</w> and browsing history.",
                            "target_lang_translations": {
                                "ru": "Вы можете зайти в настройки браузера, чтобы очистить <w>куки</w> и историю посещений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clear cookies",
                        "browser cookie",
                        "accept cookies",
                        "third-party cookie"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой фрагмент данных, отправленный веб-сайтом и сохраненный на компьютере пользователя веб-браузером."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куки",
                                "target_lang_sense_clarification": "компьютерный термин"
                            },
                            {
                                "target_lang_word": "файлы cookie",
                                "target_lang_sense_clarification": "техническое название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4cadcd0-4506-378d-a2d4-8bc806649201",
                    "sense_definition": "One's stomach contents or eaten food, often used in the context of vomiting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bodily-functions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat ride was so rough that I almost <w>tossed</w> <w>my</w> <w>cookies</w> over the side.",
                            "target_lang_translations": {
                                "ru": "Прогулка на лодке была такой неспокойной, что меня чуть не <w>вырвало</w> за борт."
                            }
                        },
                        {
                            "text": "He felt extremely nauseous and thought he might <w>lose</w> <w>his</w> <w>cookies</w> at any moment.",
                            "target_lang_translations": {
                                "ru": "Его сильно тошнило, и он думал, что его вот-вот <w>вывернет</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "toss one's cookies",
                        "lose one's cookies"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal expression for vomiting"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержимое желудка или съеденная пища, часто используется в контексте рвоты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завтрак",
                                "target_lang_sense_clarification": "в идиоме «вывернуть завтрак»"
                            },
                            {
                                "target_lang_word": "обед",
                                "target_lang_sense_clarification": "в контексте тошноты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d6bd9e0-818d-32a7-9d29-972bc689cd16",
                    "sense_definition": "An attractive young woman.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old movie, the detective referred to the mysterious woman as a <w>smart</w> <w>cookie</w>.",
                            "target_lang_translations": {
                                "ru": "В старом фильме детектив назвал таинственную женщину <w>умницей</w>."
                            }
                        },
                        {
                            "text": "He thought she was quite a <w>cookie</w> when he first saw her at the dance.",
                            "target_lang_translations": {
                                "ru": "Он подумал, что она настоящая <w>красотка</w>, когда впервые увидел её на танцах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "smart cookie",
                        "tough cookie"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "somewhat old-fashioned usage"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекательная молодая женщина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красотка",
                                "target_lang_sense_clarification": "привлекательная девушка"
                            },
                            {
                                "target_lang_word": "штучка",
                                "target_lang_sense_clarification": "разговорное, о человеке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07ed8eed-d527-3b62-ae83-133fde23499a",
                    "sense_definition": "A slang term for the vulva.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book used the word <w>cookie</w> as a euphemism when discussing female anatomy.",
                            "target_lang_translations": {
                                "ru": "В книге слово «<w>печенька</w>» использовалось как эвфемизм при обсуждении женской анатомии."
                            }
                        },
                        {
                            "text": "She felt uncomfortable when the lyrics mentioned a <w>cookie</w> in a suggestive way.",
                            "target_lang_translations": {
                                "ru": "Ей стало неловко, когда в тексте песни двусмысленно упомянули «<w>печеньку</w>»."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal and potentially offensive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговый термин для обозначения вульвы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "печенька",
                                "target_lang_sense_clarification": "эвфемизм"
                            },
                            {
                                "target_lang_word": "вареник",
                                "target_lang_sense_clarification": "сленговый аналог"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "09484aa5-3b58-357b-ad77-1ee29e082e0a",
                    "sense_definition": "To send or store a digital cookie on a user's computer or browser.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing-action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marketing firm will <w>cookie</w> visitors to track which advertisements they click on.",
                            "target_lang_translations": {
                                "ru": "Маркетинговая фирма будет <w>помечать куками</w> посетителей, чтобы отслеживать, по каким объявлениям они кликают."
                            }
                        },
                        {
                            "text": "Many websites <w>cookie</w> you as soon as you land on their homepage.",
                            "target_lang_translations": {
                                "ru": "Многие сайты <w>сохраняют куки</w>, как только вы заходите на их главную страницу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cookie visitors",
                        "cookie users"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправлять или сохранять цифровой файл cookie на компьютере или в браузере пользователя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кукировать",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            },
                            {
                                "target_lang_word": "помечать куками",
                                "target_lang_sense_clarification": "техническое описание действия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "89bbbd8e-a5c8-3635-905f-3bb22e86beff",
                    "sense_definition": "An endearing or sometimes condescending nickname for a person.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nicknames",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The old man always called his granddaughter <w>Cookie</w> when she came to visit.",
                            "target_lang_translations": {
                                "ru": "Старик всегда называл свою внучку «<w>Крошка</w>», когда она приходила в гости."
                            }
                        },
                        {
                            "text": "Don't call me <w>Cookie</w> in front of my boss because it sounds unprofessional.",
                            "target_lang_translations": {
                                "ru": "Не называй меня «<w>Плюшка</w>» при начальнике, это звучит непрофессионально."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal address"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ласковое или иногда снисходительное прозвище для человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Крошка",
                                "target_lang_sense_clarification": "ласковое обращение"
                            },
                            {
                                "target_lang_word": "Плюшка",
                                "target_lang_sense_clarification": "милое прозвище"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}