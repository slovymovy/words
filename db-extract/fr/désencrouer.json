                "senses": [
                    {
                        "sense_id": "f19e5eb8-ffa0-3d80-b275-fd5c0b236e7f",
                        "entry_id": "d17fe54c-016f-395d-8228-6fdd48ba5063",
                        "glosses": [
                            "Faire tomber au sol un arbre qui s’est encroué."
                        ],
                        "tags": [
                            "Exploitation forestière"
                        ],
                        "examples": [
                            {
                                "example_id": "c021bdd6-5d83-4416-9116-b0771721f676",
                                "sense_id": "f19e5eb8-ffa0-3d80-b275-fd5c0b236e7f",
                                "text": "Alors, sous le prétexte de le désencrouer, le marchand abattoit l’arbre de dessous, qu’il obtenoit ensuite à vil prix."
                            },
                            {
                                "example_id": "295f10bf-b674-4059-955d-f3a4717471f4",
                                "sense_id": "f19e5eb8-ffa0-3d80-b275-fd5c0b236e7f",
                                "text": "Les consignes de sécurité veulent que, dans un tel cas, on attende le retour du tracteur de débardage qui viendra tirer l’arbre pour le désencrouer."
                            },
                            {
                                "example_id": "24b73c6a-1eb9-41d5-b1c5-7d2171dc5d46",
                                "sense_id": "f19e5eb8-ffa0-3d80-b275-fd5c0b236e7f",
                                "text": "Voici quelques moyens pour désencrouer un arbre:\n- le faire tourner sur lui-même en coupant une partie de sa charnière (du côté où il est en appui),…"
                            }
                        ]
                    }
