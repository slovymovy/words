                                            {
                                                "example_id": "4eb0b1f2-759a-409f-a9e1-3cb5967ac7be",
                                                "sense_id": "c6176005-3041-3361-8a75-bdb0f9cd3647",
                                                "text": "Several actors auditioned for the part."
                                            }
