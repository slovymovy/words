                ],
                "senses": [
                    {
                        "sense_id": "bfc64fa6-7db4-3a5e-b4b7-b895f0796fe4",
                        "entry_id": "59c5eb75-2cc6-3a32-bb6d-4ecd7d6f2478",
                        "glosses": [
                            "Glisser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b4f61ab-b37e-4e78-9ec0-80818175e0cb",
                                "sense_id": "bfc64fa6-7db4-3a5e-b4b7-b895f0796fe4",
                                "text": "La Seine, Qui, se jouant quatre fois, se rameine D’un vague ply retors et reglissant, Et quatre fois se remonstre au passant."
                            },
                            {
                                "example_id": "5034bb1c-2a75-4c6f-b58c-369ce6fe0888",
                                "sense_id": "bfc64fa6-7db4-3a5e-b4b7-b895f0796fe4",
                                "text": "Écrivez-moi si vous avez ouï dire que l’esprit de discorde se soit reglissé dans l’armée de M. le duc de Broglie."
                            },
                            {
                                "example_id": "1b79a9f7-4bec-405e-a98d-9c7d96859380",
                                "sense_id": "bfc64fa6-7db4-3a5e-b4b7-b895f0796fe4",
                                "text": "Son énergie épuisée, il reglissa au plus profond de ses couvertures, se repliant sur lui-même comme un animal battu."
                            }
                        ]
                    }
                ],
