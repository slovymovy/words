                                        "examples": [
                                            {
                                                "example_id": "dab9df52-941b-4b44-9835-118851895b6b",
                                                "sense_id": "874c233b-3545-368b-9ac0-a7178764693f",
                                                "text": "Que d’avortons pour un Antinoüs !"
                                            },
                                            {
                                                "example_id": "5b230994-6aa4-438d-becb-f86075d607da",
                                                "sense_id": "874c233b-3545-368b-9ac0-a7178764693f",
                                                "text": "Cet Antinoüs des faubourgs riait sans cesse, et montrait alors trente-deux dents irréprochables."
                                            },
                                            {
                                                "example_id": "12b16bbe-44cc-4c31-ab62-2c2ca1500c78",
                                                "sense_id": "874c233b-3545-368b-9ac0-a7178764693f",
                                                "text": "J’abandonne la partie, mademoiselle, ajouta-t-il, et me décharge au profit de qui voudra du soin dangereux de présenter ici l’Antinoüs du boulevard Montparnasse."
                                            },
                                            {
                                                "example_id": "bd37e6d7-90bb-4406-857e-63004311a4c5",
                                                "sense_id": "874c233b-3545-368b-9ac0-a7178764693f",
                                                "text": "Vous voulez dire que je ne suis pas un Antinoüs ?… Certainement non et heureusement non, je ne suis pas un Antinoüs."
                                            }
                                        ]
