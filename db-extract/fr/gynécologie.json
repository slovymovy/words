                    },
                    {
                        "form_id": "c649619a-60f3-4356-a2fe-28e2e9f2ba21",
                        "entry_id": "59edcdd1-b1b7-3efa-bf40-53911a943b5c",
                        "tags": [],
                        "form": "génycologie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f9981452-6f0d-3327-a329-c4eb5f7dc511",
                        "entry_id": "59edcdd1-b1b7-3efa-bf40-53911a943b5c",
                        "glosses": [
                            "Étude scientifique et pratique du fonctionnement du corps humain de sexe féminin ainsi que des maladies spécifiques aux femmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e6247f8-c520-4ba6-a871-81ce3f9d9833",
                                "sense_id": "f9981452-6f0d-3327-a329-c4eb5f7dc511",
                                "text": "1957 : l’ingénieur anglais Tom Brown et le gynécologue Ian Donald créent la première sonde échographique et l’utilisent en gynécologie."
                            },
                            {
                                "example_id": "501350c2-5fb0-4745-b41b-339b34b674ae",
                                "sense_id": "f9981452-6f0d-3327-a329-c4eb5f7dc511",
                                "text": "La gynécologie, médecine consacrée uniquement à la femme, semble à bien des égards être le fer de lance de cette conquête patriarcale sur le corps des femmes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35fc7ee8-15b8-4ac7-a013-a3ab69d12716",
                        "source_entry_id": "59edcdd1-b1b7-3efa-bf40-53911a943b5c",
                        "source_sense_id": "f9981452-6f0d-3327-a329-c4eb5f7dc511",
                        "target_lang_word": "Frauenheilkunde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frauenheilkunde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "358ae44f-7316-3287-932f-6a1b509f00fb",
                                        "entry_id": "c892aebb-71a2-3657-b698-f34b4492f17f",
                                        "glosses": [
                                            "Lehre vom Aufbau, der Funktion und den Krankheiten der weiblichen Sexual- und Fortpflanzungsorgane"
                                        ],
                                        "tags": [
                                            "Fachgebiet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2ebb12f-d449-4850-887e-c31535e002fb",
                                                "sense_id": "358ae44f-7316-3287-932f-6a1b509f00fb",
                                                "text": "Sie ließ sich in Frauenheilkunde und Geburtshilfe ausbilden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49d5715f-642a-4a09-a9f6-724350a8818d",
                        "source_entry_id": "59edcdd1-b1b7-3efa-bf40-53911a943b5c",
                        "source_sense_id": "f9981452-6f0d-3327-a329-c4eb5f7dc511",
                        "target_lang_word": "Gynäkologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gynäkologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf3e1fc2-189a-3238-b670-63473851538e",
                                        "entry_id": "45323c64-83b8-3b5c-b5e2-462769c4abfb",
                                        "glosses": [
                                            "Lehre vom Aufbau, der Funktion und den Krankheiten der weiblichen Sexual- und Fortpflanzungsorgane"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "482289ae-3700-4254-98fe-c5ffffcdb954",
                                                "sense_id": "bf3e1fc2-189a-3238-b670-63473851538e",
                                                "text": "Zu den Aufgaben der Gynäkologie zählt auch die Brustkrebsvorsorge."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "353b00ea-5067-3aba-8ab0-a6169717b536",
                                        "entry_id": "45323c64-83b8-3b5c-b5e2-462769c4abfb",
                                        "glosses": [
                                            "die gynäkologische Abteilung in Krankenhäusern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9ad63ef-50a9-4aa6-9260-d0d69b0d7a9b",
                                                "sense_id": "353b00ea-5067-3aba-8ab0-a6169717b536",
                                                "text": "In welchem Gebäude ist hier die Gynäkologie untergebracht?"
                                            },
                                            {
                                                "example_id": "a0ee1846-a56d-45d9-a4f7-c4e7091ea429",
                                                "sense_id": "353b00ea-5067-3aba-8ab0-a6169717b536",
                                                "text": "„Der ambulante OP-Tag der Gynäkologie im Krankenhaus Agatharied ist der Donnerstag.“"
                                            },
                                            {
                                                "example_id": "60bebb6e-b478-40fc-a611-ea04efe3b872",
                                                "sense_id": "353b00ea-5067-3aba-8ab0-a6169717b536",
                                                "text": "„Als im August Mitarbeiter in die Gynäkologie zu Besuch nach Kajaga kamen, erlebten sie eine Überraschung: nur wenige Minuten zuvor hat eine junge Frau ihr Kind zur Welt gebracht.“"
                                            },
                                            {
                                                "example_id": "f017b455-e794-41ea-a6a8-5f0fe864b542",
                                                "sense_id": "353b00ea-5067-3aba-8ab0-a6169717b536",
                                                "text": "„Mit den Worten „sofort in die Gynäkologie zum Ultraschall!“ schickte der Arzt die Frau zu weiteren Untersuchungen.“"
                                            },
                                            {
                                                "example_id": "20a5df49-f8a4-4943-b66a-992f38fc47b9",
                                                "sense_id": "353b00ea-5067-3aba-8ab0-a6169717b536",
                                                "text": "„Vor der Legalisierung in Südafrika waren fast die Hälfte aller Einweisungen in die Gynäkologie aufgrund selbstgemachter Abtreibung.“"
                                            },
                                            {
                                                "example_id": "d1a3d48c-9d90-4eab-8989-11186e331d4f",
                                                "sense_id": "353b00ea-5067-3aba-8ab0-a6169717b536",
                                                "text": "„Nach 2 jähriger unfallchirurgischer Ausbildung in einer großen Harburger Praxis wechselte Sie für 6 Jahre in die Gynäkologie des Kreiskrankenhauses Winsen an der Luhe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfd4044f-7abe-4ca3-831c-8c5752e33080",
                        "source_entry_id": "59edcdd1-b1b7-3efa-bf40-53911a943b5c",
