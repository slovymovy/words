{
    "word_family": [
        "shruggable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2142938d-4ec8-32a2-b5c3-5e2ab15f86d2",
                    "sense_definition": "To raise the shoulders to express uncertainty, lack of concern, or indifference.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shoulder movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When I asked him where the keys were, he just <w>shrugged</w> and walked away.",
                            "target_lang_translations": {
                                "ru": "Когда я спросил его, где ключи, он просто <w>пожал плечами</w> и ушел."
                            }
                        },
                        {
                            "text": "It is common to <w>shrug</w> shoulders when you do not know the answer to a question.",
                            "target_lang_translations": {
                                "ru": "Обычно люди <w>пожимают плечами</w>, когда не знают ответа на вопрос."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shrug shoulders",
                        "shrug in indifference",
                        "shrug dismissively"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднимать плечи, чтобы выразить неуверенность, отсутствие интереса или безразличие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пожимать плечами",
                                "target_lang_sense_clarification": "несовершенный вид"
                            },
                            {
                                "target_lang_word": "пожать плечами",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1d71dadb-c050-3965-a3ed-49a3dc536ee4",
                    "sense_definition": "A lifting of the shoulders to signal indifference or a casual lack of knowledge.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shoulder movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dismissed my comment with a <w>shrug</w> of his shoulders.",
                            "target_lang_translations": {
                                "ru": "Он проигнорировал моё замечание, ответив лишь <w>пожатием плеч</w>."
                            }
                        },
                        {
                            "text": "A simple <w>shrug</w> was his only response to the difficult question.",
                            "target_lang_translations": {
                                "ru": "Простое <w>пожимание плечами</w> было его единственным ответом на сложный вопрос."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slight shrug",
                        "dismissive shrug",
                        "shrug of indifference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение плечами вверх, сигнализирующее о безразличии или случайном отсутствии знаний."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пожимание плечами",
                                "target_lang_sense_clarification": "жест"
                            },
                            {
                                "target_lang_word": "пожатие плечами",
                                "target_lang_sense_clarification": "однократное движение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35444622-19df-3e52-8b51-00429e129e44",
                    "sense_definition": "A cropped, cardigan-like garment with short or long sleeves, typically knitted.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a knitted <w>shrug</w> over her sleeveless dress to stay warm.",
                            "target_lang_translations": {
                                "ru": "Она надела вязаный <w>шраг</w> поверх платья без рукавов, чтобы не замерзнуть."
                            }
                        },
                        {
                            "text": "This black <w>shrug</w> is perfect for covering your shoulders during the evening.",
                            "target_lang_translations": {
                                "ru": "Этот черный <w>шраг</w> идеально подходит, чтобы прикрыть плечи вечером."
                            }
                        }
                    ],
                    "synonyms": [
                        "bolero"
                    ],
                    "common_phrases": [
                        "knitted shrug",
                        "cropped shrug",
                        "lace shrug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая одежда, похожая на кардиган, с короткими или длинными рукавами, обычно вязаная."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шраг",
                                "target_lang_sense_clarification": "вид одежды"
                            },
                            {
                                "target_lang_word": "болеро",
                                "target_lang_sense_clarification": "похожий предмет одежды"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}