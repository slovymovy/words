                "senses": [
                    {
                        "sense_id": "ac76db87-6be7-391a-8712-70527e5539bb",
                        "entry_id": "8869012c-17ae-312d-ab10-0c9f2c5845e6",
                        "glosses": [
                            "Amener quelque part une atmosphère analogue à celle de la ville afghane de Kaboul."
                        ],
                        "tags": [
                            "Algérie"
                        ],
                        "examples": [
                            {
                                "example_id": "44284715-b974-4fe2-a4f1-7a725ffbb88e",
                                "sense_id": "ac76db87-6be7-391a-8712-70527e5539bb",
                                "text": "Notre société est ouverte, tolérante et respectueuse des différences, il n'est pas question de laisser le régime \"kabouliser\" la Kabylie."
                            },
                            {
                                "example_id": "e5ad79f3-d5a9-4262-8011-8f8223d6fee1",
                                "sense_id": "ac76db87-6be7-391a-8712-70527e5539bb",
                                "text": "Il usera de sa logique parcimonieuse et de son génie récupérateur pour remettre sur la table une énième fois encore, sa grande ambition, l’afghanistanisation de l'Algérie au prix de kabouliser Alger."
                            }
                        ]
                    }
                ],
