                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "72586fcd-b867-4d54-908d-213e80d7931a",
                                "sense_id": "89fd747b-fcd8-365f-9e9e-19a45f726c9d",
                                "text": "„Der Sprecher des südkoreanischen Wiedervereinigungsministeriums, Lim Byeong Chul, sagte, laut den nordkoreanischen Medien übe Kim seine Amtsaufgaben wie gewohnt aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
