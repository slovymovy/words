                    {
                        "sense_id": "43d4e051-366d-31dd-970d-b37a4ea4f075",
                        "entry_id": "db3b182b-537f-382e-9338-f38f2a6e2750",
                        "glosses": [
                            "locker sitzende Unterhose, die von der Hüfte bis zum mittleren Oberschenkel reicht (für beide Geschlechter angeboten, bei Männern deutlich verbreiteter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7472534-ff67-4dc4-bac5-963f3b6b780e",
                                "sense_id": "43d4e051-366d-31dd-970d-b37a4ea4f075",
                                "text": "Er schläft nur in Boxershorts."
                            },
                            {
                                "example_id": "937b6c6a-9d72-48ad-89bf-7ec69eda3a2e",
                                "sense_id": "43d4e051-366d-31dd-970d-b37a4ea4f075",
                                "text": "Er trägt ausschließlich Baggy Pants, sodass man seine Boxershorts sehen kann."
                            },
                            {
                                "example_id": "e698375e-853a-44f3-9ee4-abf3aea89f4a",
                                "sense_id": "43d4e051-366d-31dd-970d-b37a4ea4f075",
                                "text": "Seit ich meiner Freundin knallrote Boxershorts geschenkt habe, intensivierte sich unser Liebesleben."
                            },
                            {
                                "example_id": "fbd9317b-97f5-4165-8e38-d1a6bbe5ea30",
                                "sense_id": "43d4e051-366d-31dd-970d-b37a4ea4f075",
                                "text": "Es wird behauptet, dass Boxershorts für Männer gesünder sind als eng anliegende Slips."
                            },
                            {
                                "example_id": "2f29b29f-b66b-47e3-9f26-1ecff15fc901",
                                "sense_id": "43d4e051-366d-31dd-970d-b37a4ea4f075",
                                "text": "„Die Boxershorts aus blauer Seide bedeckten seinen Bauch komplett.“"
                            },
                            {
                                "example_id": "651badde-85b6-4243-a4da-4f9b948d165a",
                                "sense_id": "43d4e051-366d-31dd-970d-b37a4ea4f075",
                                "text": "„Ins Schlafzimmer zurückgekehrt, hob er seine Boxershorts vom Boden auf, schlüpfte hinein, ging ins Bad und schloss die Tür.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
