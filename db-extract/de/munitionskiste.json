                        "examples": [
                            {
                                "example_id": "e5360631-5c0f-4a72-80bd-315772958958",
                                "sense_id": "8d410be5-ae78-30f9-bf32-15afa1a2abc2",
                                "text": "Sie trugen die Munitionskiste zum Schießstand."
                            },
                            {
                                "example_id": "839ab5de-e576-44bf-a389-3fb5fedec7c1",
                                "sense_id": "8d410be5-ae78-30f9-bf32-15afa1a2abc2",
                                "text": "„Kaum sei der Zerstörerverband ohne Schäden nach Brest zurückgekehrt, erzählt Lothar-Günther Buchheim in dem Interview von 1995, hätte er sich an seine Erika-Schreibmaschine auf eine Munitionskiste gesetzt und mit vier Fingern einen Text getippt.“"
                            },
                            {
                                "example_id": "d1d28a8a-3008-481e-ae5e-2d5a885e03b6",
                                "sense_id": "8d410be5-ae78-30f9-bf32-15afa1a2abc2",
                                "text": "„Ein Trupp Russen zog vorbei, die Munitionskisten schleppten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
