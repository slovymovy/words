                "senses": [
                    {
                        "sense_id": "4dd8d582-367d-3cbf-a7f9-07ab927582bc",
                        "entry_id": "9bee7729-7a05-39e7-a7b5-f25223b43c76",
                        "glosses": [
                            "van een gezicht nog niet opgemaakt, zonder make up"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "303f54b6-db46-449e-a952-902248a1a39a",
                                "sense_id": "4dd8d582-367d-3cbf-a7f9-07ab927582bc",
                                "text": "Sybil hield van de manier waarop hij haar altijd begroette, alsof hij haar niet een halfuur geleden nog had gezien, gewikkeld in een handdoek, toen ze met nat haar en een nog onopgemaakt gezicht onder de douche vandaan kwam."
                            },
                            {
                                "example_id": "dd8522b7-e1c9-4b60-a70a-cf094c389c9d",
                                "sense_id": "4dd8d582-367d-3cbf-a7f9-07ab927582bc",
                                "text": "Ik kom er maar voor uit: ik zie er regelmatig net zo onopgemaakt uit als Anouk (#omg). Ik ga zelfs zo de deur uit. Ja, echt. Met een vlassig vlechtje, rode wangen en een zichtbare rimpel."
                            }
                        ]
                    },
                    {
                        "sense_id": "39bc2822-37c6-3717-b0e7-20984f6798df",
                        "entry_id": "9bee7729-7a05-39e7-a7b5-f25223b43c76",
                        "glosses": [
                            "van een bed dat het nog niet is opgemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44765544-9fff-467c-8129-56914abd0e84",
                                "sense_id": "39bc2822-37c6-3717-b0e7-20984f6798df",
                                "text": "Het kunstwerk My Bed van de Britse kunstenares Tracey Emin heeft dinsdag bij een veiling bij Christie's in Londen veel meer opgebracht dan verwacht. Het veilinghuis schatte de opbrengst op 800.000 tot 1,2 miljoen pond, maar het met afval omgeven onopgemaakte bed bracht meer dan 2,5 miljoen pond (ruim 3,1 miljoen euro) op."
                            }
                        ]
                    }
