                                "target_senses": [
                                    {
                                        "sense_id": "0b9ce796-faf0-3abb-8950-e16c20e29346",
                                        "entry_id": "93cc5632-531c-3e6c-9f73-3fcbdccfa9b0",
                                        "glosses": [
                                            "A country and archipelago of Polynesia in Oceania. Capital and largest city: Funafuti."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f468f98-24dd-4a89-a5e3-23ab44dcbf7c",
                                                "sense_id": "0b9ce796-faf0-3abb-8950-e16c20e29346",
                                                "text": "Tuvalu, a string of islands northwest of Australia, sold the rights to its suffix, “.tv,” to a Canadian entrepreneur for $50 million, and used the money to put electricity on the outer islands, create scholarships and finance the process to join the United Nations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c64021bb-b12a-4cee-a3e7-3085d3b534a5",
                        "source_entry_id": "95ce865d-2f69-3083-9ea9-ae8e86a48c10",
                        "source_sense_id": "34c68c99-e1db-31d0-8c01-cae581fbc33f",
                        "source_sense_description": "een land in Oceanië",
                        "target_lang_word": "Tuvalu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tuvalu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95aa4db8-634e-3b98-8c57-bf7ab87cff12",
                                        "entry_id": "f0ce5174-be25-3662-8475-54046f8d380a",
                                        "glosses": [
                                            "Petit pays polynésien, au centre de l’océan Pacifique, au sud de l’équateur et proche des Kiribati (ex-îles Gilbert, avec lesquelles ils formaient auparavant le protectorat britannique des îles-Gilbert-et-Ellice). La capitale est Vaiaku, sur l’atoll de Funafuti."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf98b59b-4585-43fd-9769-85c2fc62da16",
                                                "sense_id": "95aa4db8-634e-3b98-8c57-bf7ab87cff12",
                                                "text": "Les Tuvalu (ex groupe des Ellice) sont constituées de 3 îles […]"
                                            },
                                            {
                                                "example_id": "65e21afa-f40a-4298-9c82-f6f6e1390ebc",
                                                "sense_id": "95aa4db8-634e-3b98-8c57-bf7ab87cff12",
                                                "text": "La frontière nord-ouest entre l’aire de la filariose subpériodique et celle de la filariose périodique nocturne suit la ligne de BUXTON (1928) qui sépare les îles de la Loyauté, les Fiji [sic] et les Tuvalu des Nouvelles Hébrides [sic], des îles Santa Cruz et des Gilbert (Fig. 6)."
                                            },
                                            {
                                                "example_id": "cd2273f9-33c6-4579-a0c5-a6e974322d0c",
                                                "sense_id": "95aa4db8-634e-3b98-8c57-bf7ab87cff12",
                                                "text": "Cinq États de cette région ne constitutionnalisent pas le droit à la réparation : ce sont la Micronésie, les îles Marshall, Nauru, les îles Tonga et le Tuvalu."
                                            },
                                            {
                                                "example_id": "3234a185-9605-4723-bb38-c53549973b31",
                                                "sense_id": "95aa4db8-634e-3b98-8c57-bf7ab87cff12",
                                                "text": "Une recherche rapide permet de trouver 14 nations quasi indépendantes, de Belize à l'état des Tuvalu, où l'on retrouve un représentant de la reine Élisabeth, comme chef d'État."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
