                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52d01344-0821-47d0-aa1d-c06939fdcfb5",
                                "sense_id": "a8f1ad0c-d94b-3873-b190-60517298fb2f",
                                "text": "Prieur, ta fanfare du rappel a augmenté ta rançon de cinquante couronnes ; car tu as corrompu la simplicité et la vigueur des vieux sons de vénerie."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef345c49-d8f0-3e97-8471-2c222fe0f04f",
                        "entry_id": "4d8f3e47-d0e2-3113-aff7-3ff199e9db50",
                        "glosses": [
                            "Corps des officiers qui étaient attachés à ce service chez le roi."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "bea16fa7-b0ca-4ff6-a0b8-43980316b531",
                                "sense_id": "ef345c49-d8f0-3e97-8471-2c222fe0f04f",
                                "text": "La vénerie est logée en tel endroit. L’équipage de la vénerie."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1882451-9de3-3c9c-8877-cc868294e8cb",
