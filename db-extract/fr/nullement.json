        "fr-extract.jsonl": [
            {
                "entry_id": "8084b222-a155-3c87-88ac-cb802d501055",
                "word": "nullement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "caf47cbb-f73c-32b6-87bc-aff8de0d6909",
                        "entry_id": "8084b222-a155-3c87-88ac-cb802d501055",
                        "glosses": [
                            "En aucune manière ; pas du tout."
                        ],
                        "tags": [],
                        "note": "Souvent utilisé avec ne",
                        "examples": [
                            {
                                "example_id": "815b9c98-e210-44ad-a2f8-53589fac4da7",
                                "sense_id": "caf47cbb-f73c-32b6-87bc-aff8de0d6909",
                                "text": "La royauté, chez vous, n'a jamais poussé que de tristes racines ; votre sol républicain ne convient nullement à cet arbre-là."
                            },
                            {
                                "example_id": "91fe96b7-a892-4dd7-af20-1f2c57a1d72e",
                                "sense_id": "caf47cbb-f73c-32b6-87bc-aff8de0d6909",
                                "text": "En 1884, le gouvernement ne prévoyait nullement que les syndicats pussent participer à une grande agitation révolutionnaire […]."
                            },
                            {
                                "example_id": "c695d890-7f24-4254-9349-92b16214479e",
                                "sense_id": "caf47cbb-f73c-32b6-87bc-aff8de0d6909",
                                "text": "Après deux jours d'absence, nous revenions à Rockall ramenant une nuée de mouettes qui avaient quitté leur îlot pour nous accompagner ; nullement farouches, elles se tenaient à proximité chaque fois que nous stoppions."
                            },
                            {
                                "example_id": "14599ba8-563f-40f5-854f-daa71d0f1511",
                                "sense_id": "caf47cbb-f73c-32b6-87bc-aff8de0d6909",
                                "text": "Je descends le fanal dans le poste pour le rallumer, mais je ne me presse nullement, […]."
                            },
                            {
                                "example_id": "4194910b-ce72-4c6b-b5cc-e52322c3f18d",
                                "sense_id": "caf47cbb-f73c-32b6-87bc-aff8de0d6909",
                                "text": "Cela ne l'empêchait nullement de réclamer à Jim des entrées de faveur lorsqu’il jouait dans un music-hall à Paris, […]."
                            },
                            {
                                "example_id": "437a1d19-d253-44e8-8fd8-4210a687f26c",
                                "sense_id": "caf47cbb-f73c-32b6-87bc-aff8de0d6909",
                                "text": "Apportent-ils la preuve de cette assertion, […]? Nullement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b2a54ca-ecdc-456c-bd8d-7d195122ff80",
                        "source_entry_id": "8084b222-a155-3c87-88ac-cb802d501055",
                        "source_sense_id": "caf47cbb-f73c-32b6-87bc-aff8de0d6909",
                        "target_lang_word": "keineswegs",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "keineswegs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc984dc7-d065-367d-b9ee-811fb4903887",
                                        "entry_id": "e6f75dd1-9df5-3923-9721-bc0eeeff9249",
                                        "glosses": [
                                            "stärkere Form für „nicht“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c2b688a-1976-4e1e-baab-3415aec20147",
                                                "sense_id": "bc984dc7-d065-367d-b9ee-811fb4903887",
                                                "text": "Ich möchte Sie keineswegs stören, sondern nur helfen."
                                            },
                                            {
                                                "example_id": "ac32c033-cf40-4199-8b88-760c36ddf047",
                                                "sense_id": "bc984dc7-d065-367d-b9ee-811fb4903887",
                                                "text": "Ich halte die Resolution der Versammlung keineswegs für erledigt."
                                            },
                                            {
                                                "example_id": "783ee2ac-020e-4f46-b58d-c1ab4d7462c5",
                                                "sense_id": "bc984dc7-d065-367d-b9ee-811fb4903887",
                                                "text": "Dieser Film ist keineswegs so gut, wie du behauptetest."
                                            },
                                            {
                                                "example_id": "e0f396e5-3625-452d-bafd-979150539ea9",
                                                "sense_id": "bc984dc7-d065-367d-b9ee-811fb4903887",
                                                "text": "„Die Stämme leben also keineswegs isoliert, sondern schließen Allianzen miteinander und stellen große Armeen auf.“"
                                            },
                                            {
                                                "example_id": "4c319fc7-928f-452b-a742-1968d190cf9c",
                                                "sense_id": "bc984dc7-d065-367d-b9ee-811fb4903887",
                                                "text": "Dickere Menschen sind keineswegs häufiger krank."
                                            },
                                            {
                                                "example_id": "9c1efa47-dbcd-4b7b-aeda-f36ea01c487a",
                                                "sense_id": "bc984dc7-d065-367d-b9ee-811fb4903887",
                                                "text": "In Deutschland gibt es aber keineswegs nur deutsches Essen, denn hier leben über sieben Millionen Einwanderer. So gehören Pizza, Spaghetti, Döner, Gyros oder Sushi mittlerweile schon zum Speiseplan vieler Deutscher."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06575e43-3413-4970-88ad-1c7d3c6508af",
                        "source_entry_id": "8084b222-a155-3c87-88ac-cb802d501055",
                        "source_sense_id": "caf47cbb-f73c-32b6-87bc-aff8de0d6909",
