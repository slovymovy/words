{
    "word_family": [
        "spatten",
        "bespatten",
        "opspatten",
        "spatbord",
        "spatwater",
        "spatader"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "308919ef-5d0e-3753-b0b4-bfca35f7a1f9",
                    "sense_definition": "een kleine vlek of druppel van een vloeistof die ergens op terecht is gekomen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vlek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zit een kleine <w>spat</w> modder op je nieuwe witte broek.",
                            "target_lang_translations": {
                                "en": "There is a small <w>splatter</w> of mud on your new white pants."
                            }
                        },
                        {
                            "text": "Na het schilderen zag ik een <w>spat</w> verf op de vloer liggen.",
                            "target_lang_translations": {
                                "en": "After painting, I saw a <w>spot</w> of paint lying on the floor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geen spat veranderen",
                        "een spat modder"
                    ],
                    "target_lang_definitions": {
                        "en": "a small stain or drop of a liquid that has landed on something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "splatter",
                                "target_lang_sense_clarification": "an uneven shape or mess created by liquid dispersing on impact"
                            },
                            {
                                "target_lang_word": "splash",
                                "target_lang_sense_clarification": "a mark or stain made from a small amount of liquid"
                            },
                            {
                                "target_lang_word": "spot",
                                "target_lang_sense_clarification": "a small mark or stain"
                            },
                            {
                                "target_lang_word": "speck",
                                "target_lang_sense_clarification": "a very small spot or stain"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43080d55-da53-3019-b39f-88bd64225a90",
                    "sense_definition": "een wapen bestaande uit een buis waardoor men pijltjes of projectielen blaast",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wapen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In sommige culturen wordt de <w>spat</w> nog steeds gebruikt voor de jacht.",
                            "target_lang_translations": {
                                "en": "In some cultures, the <w>blowgun</w> is still used for hunting."
                            }
                        },
                        {
                            "text": "De jager richtte zijn <w>spat</w> op het kleine doelwit in de boom.",
                            "target_lang_translations": {
                                "en": "The hunter aimed his <w>blowpipe</w> at the small target in the tree."
                            }
                        }
                    ],
                    "synonyms": [
                        "blaaspijp",
                        "blaasroer"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in specifieke dialecten gebruikt voor blaaspijp"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a weapon consisting of a tube through which one blows arrows or projectiles"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blowgun",
                                "target_lang_sense_clarification": "a tube for blowing projectiles"
                            },
                            {
                                "target_lang_word": "blowpipe",
                                "target_lang_sense_clarification": "a tube used as a weapon to blow darts"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bc3a1d44-b56e-30fc-9dba-25df5e2a4156",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>spatten</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>spat</w> per ongeluk water over de hele badkamervloer.",
                            "target_lang_translations": {
                                "en": "I accidentally <w>splash</w> water all over the bathroom floor."
                            }
                        },
                        {
                            "text": "Als ik in de plas spring <w>spat</w> het water alle kanten op.",
                            "target_lang_translations": {
                                "en": "When I jump in the puddle, the water <w>splashes</w> in all directions."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first person singular present tense of 'spatten' (to splash)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "splash",
                                "target_lang_sense_clarification": "to hit or agitate liquid so it separates"
                            },
                            {
                                "target_lang_word": "splatter",
                                "target_lang_sense_clarification": "to scatter liquid in an uneven mess"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cbc1523-0e8a-3d6f-b724-5c95ae1b2148",
                    "sense_definition": "de gebiedende wijs van <w>spatten</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Spat</w> niet zo met dat water terwijl je de afwas doet!",
                            "target_lang_translations": {
                                "en": "Don't <w>splash</w> that water so much while you're doing the dishes!"
                            }
                        },
                        {
                            "text": "Pas op en <w>spat</w> geen modder op mijn schone kleren.",
                            "target_lang_translations": {
                                "en": "Watch out and don't <w>splatter</w> any mud on my clean clothes."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the imperative mood of 'spatten' (to splash)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "splash",
                                "target_lang_sense_clarification": "to hit or agitate liquid so it separates"
                            },
                            {
                                "target_lang_word": "splatter",
                                "target_lang_sense_clarification": "to scatter liquid in an uneven mess"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}