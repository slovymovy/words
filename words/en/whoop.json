{
    "word_family": [
        "whooping-cough"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33b5bc78-ac2b-37bd-9bdf-1473fb34bd09",
                    "sense_definition": "A loud, eager cry, usually of joy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd let out a loud <w>whoop</w> of joy when the team scored the winning goal.",
                            "target_lang_translations": {
                                "zh": "当球队踢进致胜一球时，人群发出了响亮的<w>欢呼</w>声。"
                            }
                        },
                        {
                            "text": "She gave a <w>whoop</w> of excitement upon hearing the good news.",
                            "target_lang_translations": {
                                "zh": "听到好消息时，她兴奋地<w>尖叫</w>了一声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shout",
                        "yell",
                        "cheer"
                    ],
                    "common_phrases": [
                        "whoop of joy"
                    ],
                    "target_lang_definitions": {
                        "zh": "通常指因喜悦而发出的响亮、急切的叫喊声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "欢呼",
                                "target_lang_sense_clarification": "指因高兴而发出的响亮叫喊。"
                            },
                            {
                                "target_lang_word": "尖叫",
                                "target_lang_sense_clarification": "指因兴奋而发出的高声尖叫。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2b3d850-3f55-3e73-a6f1-d66482d6435f",
                    "sense_definition": "A series of small, closely spaced bumps on a dirt track or trail.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rider struggled to maintain control while navigating the deep <w>whoops</w> on the track.",
                            "target_lang_translations": {
                                "zh": "骑手在赛道上通过深陷的<w>波浪路</w>时，努力保持平衡。"
                            }
                        },
                        {
                            "text": "He hit the <w>whoops</w> too fast and nearly lost his balance on the motorcycle.",
                            "target_lang_translations": {
                                "zh": "他冲过<w>波浪路</w>的速度太快，骑摩托车时差点失去平衡。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hit the whoops"
                    ],
                    "target_lang_definitions": {
                        "zh": "泥土路或越野赛道上连续排列的小土包。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "波浪路",
                                "target_lang_sense_clarification": "指赛道上连续起伏的障碍路段。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66437d6c-22f3-3892-af58-f143c93471e7",
                    "sense_definition": "A sharp, gasping sound made during a coughing fit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child let out a painful <w>whoop</w> after a long fit of coughing.",
                            "target_lang_translations": {
                                "zh": "孩子在长期的咳嗽发作后，发出了一声痛苦的<w>哮鸣</w>。"
                            }
                        },
                        {
                            "text": "The doctor listened for the characteristic <w>whoop</w> to diagnose the illness.",
                            "target_lang_translations": {
                                "zh": "医生仔细听是否有那种典型的<w>哮鸣音</w>，以便诊断病情。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "咳嗽发作时发出的一种尖锐的吸气声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "哮鸣音",
                                "target_lang_sense_clarification": "指咳嗽时伴随的尖锐呼吸声。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "392f617a-a2d2-31da-99b7-f6bc9b0620d5",
                    "sense_definition": "To shout or yell loudly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fans began to <w>whoop</w> and cheer as the concert started.",
                            "target_lang_translations": {
                                "zh": "演唱会开始时，粉丝们开始<w>欢呼</w>雀跃。"
                            }
                        },
                        {
                            "text": "They <w>whoop</w> with excitement whenever their favorite song plays.",
                            "target_lang_translations": {
                                "zh": "每当他们最喜欢的歌响起时，他们都会兴奋地<w>大喊</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shout",
                        "yell",
                        "holler"
                    ],
                    "common_phrases": [
                        "whoop with excitement"
                    ],
                    "target_lang_definitions": {
                        "zh": "大声喊叫或欢呼。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "欢呼",
                                "target_lang_sense_clarification": "指大声叫喊以表达兴奋。"
                            },
                            {
                                "target_lang_word": "大喊",
                                "target_lang_sense_clarification": "指发出响亮的叫声。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b21a725-2468-3cb8-b103-48d9a7584535",
                    "sense_definition": "To make a loud, high-pitched cry.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The owl began to <w>whoop</w> in the middle of the quiet forest night.",
                            "target_lang_translations": {
                                "zh": "猫头鹰在寂静的森林之夜开始<w>鸣叫</w>。"
                            }
                        },
                        {
                            "text": "We heard the birds <w>whoop</w> as they flew over the lake.",
                            "target_lang_translations": {
                                "zh": "我们听到鸟儿飞过湖面时发出的<w>鸣叫</w>声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cry",
                        "call"
                    ],
                    "target_lang_definitions": {
                        "zh": "发出响亮、尖锐的叫声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鸣叫",
                                "target_lang_sense_clarification": "指鸟类或动物发出的尖锐叫声。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c00fa07-b249-397c-9398-e880099ca989",
                    "sense_definition": "To defeat someone completely in a competition or fight.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our team managed to <w>whoop</w> the opponents in the final match.",
                            "target_lang_translations": {
                                "zh": "我们的队伍在决赛中成功<w>大败</w>了对手。"
                            }
                        },
                        {
                            "text": "They were <w>whooped</w> by a much stronger team yesterday.",
                            "target_lang_translations": {
                                "zh": "他们昨天被一支实力强劲得多的队伍<w>完胜</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crush",
                        "beat",
                        "thrash"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在比赛或竞争中彻底击败某人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大败",
                                "target_lang_sense_clarification": "指彻底击败对手。"
                            },
                            {
                                "target_lang_word": "完胜",
                                "target_lang_sense_clarification": "指以绝对优势获胜。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "899d0c25-e20d-3498-bbf7-f30adbfd0363",
                    "sense_definition": "To physically strike or beat someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bully threatened to <w>whoop</w> anyone who stood in his way.",
                            "target_lang_translations": {
                                "zh": "那个恶霸威胁说要<w>痛打</w>任何阻挡他的人。"
                            }
                        },
                        {
                            "text": "He was <w>whooped</w> during the fight behind the school.",
                            "target_lang_translations": {
                                "zh": "他在学校后面的打架中被<w>痛打</w>了一顿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beat",
                        "hit"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and aggressive"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "对某人进行身体上的殴打。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "痛打",
                                "target_lang_sense_clarification": "指暴力殴打某人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "674f93e3-59fd-313d-9760-87f64e82478d",
                    "sense_definition": "To cough with a loud, gasping sound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient started to <w>whoop</w> uncontrollably during the coughing fit.",
                            "target_lang_translations": {
                                "zh": "病人在咳嗽发作期间开始无法控制地<w>剧烈咳嗽</w>。"
                            }
                        },
                        {
                            "text": "It is difficult to breathe when you <w>whoop</w> like that.",
                            "target_lang_translations": {
                                "zh": "当你那样<w>剧烈咳嗽</w>时，呼吸会很困难。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "咳嗽时发出响亮、急促的吸气声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "剧烈咳嗽",
                                "target_lang_sense_clarification": "指伴有尖锐吸气声的咳嗽。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d28cff7-1e18-3423-880f-d165b787b08d",
                    "sense_definition": "To drive someone away by shouting or mocking them.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd began to <w>whoop</w> the speaker off the stage.",
                            "target_lang_translations": {
                                "zh": "人群开始<w>起哄赶走</w>台上的演讲者。"
                            }
                        },
                        {
                            "text": "They were <w>whooped</w> out of the town by the angry mob.",
                            "target_lang_translations": {
                                "zh": "愤怒的暴民<w>起哄赶走</w>了他们，把他们逼出了镇子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jeer",
                        "mock"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "通过大声喊叫或嘲笑将某人赶走。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "起哄赶走",
                                "target_lang_sense_clarification": "指通过嘲笑迫使某人离开。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}