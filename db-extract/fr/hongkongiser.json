                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4da09ca4-f388-47e8-91f8-1abb12a32b7e",
                                "sense_id": "eb968ce7-596e-3fbd-a5fc-14e7846965c4",
                                "text": "Ils partagent la formule du \"Monde\" : \"Hongkongiser Pékin pour ne pas pékiniser Hongkong\"."
                            },
                            {
                                "example_id": "5072a472-be23-4b3d-b0d8-aa833bb02684",
                                "sense_id": "eb968ce7-596e-3fbd-a5fc-14e7846965c4",
                                "text": "Souhaitant tout à la fois « hongkongiser » une société taiwanaise par trop convertie aux dangereuses vertus de la démocratie et améliorer sa position dans le bras de fer stratégico-commercial avec Washington, Pékin ne pouvait que durcir sa politique de réunification."
                            }
                        ]
