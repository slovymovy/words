                "senses": [
                    {
                        "sense_id": "a7ba79ec-0330-39a7-964d-f53b32d8a9fe",
                        "entry_id": "f63751fb-8000-3de8-bba4-3a10c1c8fdc2",
                        "glosses": [
                            "Die Nicht-Übereinstimmung zweier Objekte beziehungsweise Dinge im Geruch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f5f9636-061a-43e7-94db-4c02718c19a5",
                                "sense_id": "a7ba79ec-0330-39a7-964d-f53b32d8a9fe",
                                "text": "„Bei der Durchführung des Geruchstests kam es zu erstaunlichen Ergebnissen. Während es bei der Zuordnung des Körpergeruchs zum Alter im Bereich\" Jung\" und \"Mittelalt\" regelmäßig Fehleinschätzungen gab, weil der Geruchsunterschied in dieser Gruppe einfach nicht groß genug war, konnte eine breite Mehrheit den Körpergeruch der Altersklasse \"Alt\" eindeutig zuordnen.“"
                            },
                            {
                                "example_id": "aa87b9e7-cb8b-4eac-9741-62731adb317f",
                                "sense_id": "a7ba79ec-0330-39a7-964d-f53b32d8a9fe",
                                "text": "„Diesen Geruchsunterschied zwischen Spur und Umfeld erkennt der Hund und folgt ihr somit - und zwar im Idealfall mit tiefer Nase und hoch konzentriert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
