                    {
                        "translation_id": "e2cf77a7-4ecd-4331-a059-6a3a9f9f9103",
                        "source_entry_id": "c9fb59e7-f4d9-33cd-8c2e-ae83dda3182e",
                        "source_sense_id": "eebe2e74-b9c1-34e4-bad6-6fa6057a4ae2",
