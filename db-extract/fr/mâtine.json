                    },
                    {
                        "form_id": "233af7c6-9ab3-40ec-b599-4e46211b1ecc",
                        "entry_id": "0bd8d8da-854f-3d2c-8c4d-e9ec54da866a",
                        "tags": [
                            "masculine"
                        ],
                        "form": "mâtin"
