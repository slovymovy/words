                        ],
                        "form": "die Atemwege"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7cd0a85d-bbb4-3e6b-8e02-bf7cfed177d9",
                        "entry_id": "308cac44-f4ab-3a35-af42-b31e9012f1f3",
                        "glosses": [
                            "Bahn für die Atemluft innerhalb des Körpers (von der Nase über die Luftröhre zur Lunge)"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "5e5f5025-c557-4f1f-9964-fac40ef643d2",
                                "sense_id": "7cd0a85d-bbb4-3e6b-8e02-bf7cfed177d9",
                                "text": "„Die Schwierigkeit besteht darin, einen luftdichten Sitz der Maske am Gesicht des Patienten zu erreichen und gleichzeitig den Atemweg offen zu halten.“"
                            },
                            {
                                "example_id": "68df6554-1c51-4148-b83f-ccc32ae6ad72",
                                "sense_id": "7cd0a85d-bbb4-3e6b-8e02-bf7cfed177d9",
                                "text": "„Da die Substanz die Atemwege reizt, stellt sie vor allem für Asthmatiker und Allergiker ein Gesundheitsrisiko dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
