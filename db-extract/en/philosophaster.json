                                "target_senses": [
                                    {
                                        "sense_id": "8ce8ea13-5270-3a1b-a60b-050b2940e57b",
                                        "entry_id": "5eb975a3-d0a4-399e-8f4b-4934a902b746",
                                        "glosses": [
                                            "Mauvais philosophe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eac4ddf-f476-4633-98d6-a893f7927c16",
                                                "sense_id": "8ce8ea13-5270-3a1b-a60b-050b2940e57b",
                                                "text": "Arrivées devant le philosophâtre, elles le lui tendaient et il gribouillait je ne sais quelle amabilité sur la page de titre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df71b10a-43bf-4329-81c8-9221d82edb97",
                        "source_entry_id": "cdb0577e-ade9-376e-93c7-bc879e80d16f",
                        "source_sense_id": "52c6fc5b-5e44-350e-84af-e78b6e24e77c",
                        "source_sense_description": "a pretender to philosophy; a petty or charlatan philosopher",
                        "target_lang_word": "philosophard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "philosophard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "673fb6bc-79d7-3444-828f-e858ade4bc51",
                                        "entry_id": "ab40c532-2930-3dfa-8d7d-17baa7e24780",
                                        "glosses": [
                                            "Qui est tissu de piètres considérations philosophiques."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6c4280b-9d7a-44c8-a767-9a0853084e63",
                                                "sense_id": "673fb6bc-79d7-3444-828f-e858ade4bc51",
                                                "text": "Un ratiocinage philosophard."
                                            },
                                            {
                                                "example_id": "18c490cf-5d1d-417b-9352-0fad19a11603",
                                                "sense_id": "673fb6bc-79d7-3444-828f-e858ade4bc51",
                                                "text": "Deux ou trois titres, tous singulièrement philosophards, sautèrent aux yeux de Gabriel."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "philosophard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3248eccb-0c99-3d59-966f-8e703ae31fb2",
                                        "entry_id": "e8ec3e4d-b331-30e4-a134-8075acc5983b",
                                        "glosses": [
                                            "Mauvais philosophe ; celui qui fait laborieusement profession de philosophie sans posséder les qualités requises."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d21c850-285c-4255-9e92-1a149ff1db51",
                                                "sense_id": "3248eccb-0c99-3d59-966f-8e703ae31fb2",
                                                "text": "Mon Lyonnais n’est pas seulement un idiot, c’est en outre un philosophard de l’engeance disgracieuse des philosophards protestants, qui veut absolument voir un métaphysicien de son écurie dans le lamentable et naïf poète qu’il déshonore."
                                            },
                                            {
                                                "example_id": "cbf9f20f-b3cb-4078-8dc2-cbd95cf212cc",
                                                "sense_id": "3248eccb-0c99-3d59-966f-8e703ae31fb2",
                                                "text": "Lu Le Fantôme de Rémy de Gourmont. Peu de chose. Autant d’esprit ou de talent qu’on en peut avoir. Mais, obsession des philosophards allemands, imitation sensible de Villiers, tracas des idées charnelles et mauvais besoin d’ironie, allant jusqu’au bord du sacrilège."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47695349-4396-48e3-b517-b29144a3bb03",
                        "source_entry_id": "cdb0577e-ade9-376e-93c7-bc879e80d16f",
                        "source_sense_id": "52c6fc5b-5e44-350e-84af-e78b6e24e77c",
                        "source_sense_description": "a pretender to philosophy; a petty or charlatan philosopher",
                        "target_lang_word": "Philosophaster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Philosophaster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "681039df-74c5-39b0-848a-a2ede78ce273",
                                        "entry_id": "2d355659-0d71-3019-87ea-b0d5239058af",
                                        "glosses": [
                                            "ein scheinbarer Philosoph, ein unzuverlässiger Schwätzer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82ddd0a4-71b8-4b86-8592-8134d3582e29",
                                                "sense_id": "681039df-74c5-39b0-848a-a2ede78ce273",
                                                "text": "„Wenn diese Wunder vorbringen, so schwindeln sie; wie unsere Philosophaster schwindeln, wenn sie sich in \"Mystik\" tauchen.“"
                                            },
                                            {
                                                "example_id": "7c1c5c98-5bb7-4b6a-b65b-bbe1297c714f",
                                                "sense_id": "681039df-74c5-39b0-848a-a2ede78ce273",
                                                "text": "Manches bei Schopenhauer ist wie ein Museumsstück, das einen erfreut, weil es auch noch da ist: diese wunderbar belehrende und wortreiche Haltung, mit der Schopenhauer ja nicht immer nach einem polizeilichen Verbot ruft, sondern mit der er auch höchstpersönlich das Abstrafen auf sich nimmt: Philosophaster, Scharlatane, Dummköpfe, Windbeutel!"
                                            },
                                            {
                                                "example_id": "117372ea-7abb-423e-b9c9-3442012ff565",
                                                "sense_id": "681039df-74c5-39b0-848a-a2ede78ce273",
                                                "text": "Lacht also mit mir, meine Freunde, nicht nur über die armseligen Philosophaster, die behaupten, unsre Väter seien besser gewesen als wir, sondern auch über die Leimsieder von Philanthropaster, die den Satz verteidigen, daß die Menschen in der Vervollkommnung fortschritten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
