                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cfe2dbf-6d35-4309-9339-cdc537994133",
                        "source_entry_id": "f2328f50-4b16-3709-add3-4d45198d60d5",
                        "source_sense_id": "b44f8fe7-20c1-34d3-8e96-421c5e988a9e",
                        "target_lang_word": "rêver",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rêver",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71929c8d-4f30-3a1b-9a87-b0081928a21a",
                                        "entry_id": "79ae71ad-ad2b-38cc-9d00-5bcbe1376f51",
                                        "glosses": [
                                            "Faire des rêves en dormant."
                                        ],
                                        "tags": [],
                                        "note": "S’emploie absolument et intransitivement, ou transitivement en parlant de l’objet même du rêve",
                                        "examples": [
                                            {
                                                "example_id": "276bdad1-da83-4964-b033-1324db794c3f",
                                                "sense_id": "71929c8d-4f30-3a1b-9a87-b0081928a21a",
                                                "text": "Rêvé-je ? Est-ce que je sommeille ? Ai-je l’esprit troublé par des transports puissants ?\nNe sens-je pas bien que je veille ?\nNe suis-je pas dans mon bon sens ?"
                                            },
                                            {
                                                "example_id": "4f27ca4f-8ac7-41c4-8734-e7422cfb5d28",
                                                "sense_id": "71929c8d-4f30-3a1b-9a87-b0081928a21a",
                                                "text": "Et, allongé sur un lit d’ordures humides, un cochon tout rose, assoupi, grognait en rêvant."
                                            },
                                            {
                                                "example_id": "b0270860-b296-4859-b4d1-6e6d0bd2cc61",
                                                "sense_id": "71929c8d-4f30-3a1b-9a87-b0081928a21a",
                                                "text": "Je n’ai fait que rêver toute la nuit."
                                            },
                                            {
                                                "example_id": "9bbcb023-e645-497a-95fd-5c4c1c796bff",
                                                "sense_id": "71929c8d-4f30-3a1b-9a87-b0081928a21a",
                                                "text": "Rêver de combats, de naufrages, etc."
                                            },
                                            {
                                                "example_id": "65b19e8d-5810-4b3e-a1be-26c787883a49",
                                                "sense_id": "71929c8d-4f30-3a1b-9a87-b0081928a21a",
                                                "text": "J’ai rêvé une chute, un incendie."
                                            },
                                            {
                                                "example_id": "4816d5d9-3ed8-4f81-907a-392a333b4304",
                                                "sense_id": "71929c8d-4f30-3a1b-9a87-b0081928a21a",
                                                "text": "J’ai rêvé que…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca007083-fc94-3d46-84be-29c657b70e7c",
                                        "entry_id": "79ae71ad-ad2b-38cc-9d00-5bcbe1376f51",
                                        "glosses": [
                                            "Être en délire, délirer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de35b1d7-792c-4477-8e86-1ea3c5c5ce15",
                                                "sense_id": "ca007083-fc94-3d46-84be-29c657b70e7c",
                                                "text": "La fièvre monte, il commence à rêver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47a2155e-52f6-35d9-b587-c2a501e86916",
                                        "entry_id": "79ae71ad-ad2b-38cc-9d00-5bcbe1376f51",
                                        "glosses": [
                                            "Dire des choses déraisonnables, extravagantes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a18a9238-31f3-49f1-a843-57f405ef7039",
                                                "sense_id": "47a2155e-52f6-35d9-b587-c2a501e86916",
                                                "text": "Vous rêvez, quand vous dites telle chose."
                                            },
                                            {
                                                "example_id": "fad5f1b8-8efd-4d3c-ad34-2f6c258af7a1",
                                                "sense_id": "47a2155e-52f6-35d9-b587-c2a501e86916",
                                                "text": "Rêvez-vous de faire cette demande, cette proposition ?"
                                            },
                                            {
                                                "example_id": "3c3c8021-508d-4001-ae4e-c5b6905a91b6",
                                                "sense_id": "47a2155e-52f6-35d9-b587-c2a501e86916",
                                                "text": "Vous n’êtes pas en votre bon sens, vous rêvez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d968479c-0df5-3083-8ae2-b079999dea5f",
                                        "entry_id": "79ae71ad-ad2b-38cc-9d00-5bcbe1376f51",
                                        "glosses": [
                                            "Être distrait, laisser aller son imagination sur des choses vagues, sans aucun objet fixe et certain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19f62b43-92a7-40a1-8a85-df4fd09dbcea",
                                                "sense_id": "d968479c-0df5-3083-8ae2-b079999dea5f",
                                                "text": "Avait-elle rêvé ce qu'elle racontait d'un homme tombé au bout de la rue la Huchette et emporté sur une civière ?"
                                            },
                                            {
                                                "example_id": "2c2af3e5-6112-421c-b062-62e3e617d9ee",
                                                "sense_id": "d968479c-0df5-3083-8ae2-b079999dea5f",
                                                "text": "Il rêve toujours sans répondre à ce qu’on lui dit."
                                            },
                                            {
                                                "example_id": "6be5f70b-637e-4cc8-8545-097ac2088928",
                                                "sense_id": "d968479c-0df5-3083-8ae2-b079999dea5f",
                                                "text": "Il ne vous écoute pas, il ne fait que rêver."
                                            },
                                            {
                                                "example_id": "237bb6c8-8f7b-419d-b686-3798cb4b1a1b",
                                                "sense_id": "d968479c-0df5-3083-8ae2-b079999dea5f",
                                                "text": "Il est resté toute la soirée à rêver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81915af1-8bba-3016-b613-6650100ba7fd",
                                        "entry_id": "79ae71ad-ad2b-38cc-9d00-5bcbe1376f51",
                                        "glosses": [
                                            "Laisser aller librement son imagination, ses pensées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "808b6025-e073-4bc0-a52f-d0961639af8e",
                                                "sense_id": "81915af1-8bba-3016-b613-6650100ba7fd",
                                                "text": "Lorsqu’un seul homme rêve, ce n’est qu’un rêve, mais si beaucoup d’hommes rêvent ensemble, c’est le début d’une nouvelle réalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "616d0519-f534-30e0-9060-eec4c81da049",
                                        "entry_id": "79ae71ad-ad2b-38cc-9d00-5bcbe1376f51",
                                        "glosses": [
                                            "Se réfugier dans ses souvenirs, dans son fantasme, dans son imagination, dans ses projets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9c87e8b-a22f-4f2a-b360-127c781bd238",
                                                "sense_id": "616d0519-f534-30e0-9060-eec4c81da049",
                                                "text": "Lorsqu’il est fatigué de rêver à Marion et au bonheur qui sera le leur, il songe à ceux qui, au cours de ces dernières années, l’ont aidé."
                                            },
                                            {
                                                "example_id": "bcd38ea9-ec47-499b-9386-944e233d9493",
                                                "sense_id": "616d0519-f534-30e0-9060-eec4c81da049",
                                                "text": "Pauvre soldat, rêve, rêve, car demain peut-être, la mort impitoyable te prendra… Rêve à ces beaux jours passés pendant que l’on s'entretue…\nRêve, c’est tout ce qui te reste, à toi qui as tout perdu, famille, bonheur…\nPauvre soldat, toi qu’on appelle héros et qui souffre…\nRêve Petit Soldat…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f72f70dc-72e0-3764-b27c-19d6a23337cd",
                                        "entry_id": "79ae71ad-ad2b-38cc-9d00-5bcbe1376f51",
                                        "glosses": [
                                            "Espérer, désirer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b37de6e8-f899-4396-b709-ba86c6e57c69",
                                                "sense_id": "f72f70dc-72e0-3764-b27c-19d6a23337cd",
                                                "text": "La grande Clémence proposa du lapin ; mais on ne mangeait que de ça ; tout le monde en avait par-dessus la tête. Gervaise rêvait quelque chose de plus distingué."
                                            },
                                            {
                                                "example_id": "212281a2-2d95-4414-993d-b2d27c6d3d7c",
                                                "sense_id": "f72f70dc-72e0-3764-b27c-19d6a23337cd",
                                                "text": "Avec ça, je m’exhibe dans les boîtes de nuit et les grands restaurants la plus superbe poule qui se puisse rêver, ma dactylo, Suzanne, une enfant de dix-huit ans, fraîche, brune, émoustillante en diable, avec des yeux spirituels, dans une frimousse d’ingénue."
                                            },
                                            {
                                                "example_id": "f349b26e-abd5-43aa-b203-cab9564d46f7",
                                                "sense_id": "f72f70dc-72e0-3764-b27c-19d6a23337cd",
                                                "text": "Même s’ils en font rêver plus d’un, tout le monde n’investit pas des tracteurs high-tech. À tous ceux qui recherchent la simplicité et l’efficacité avant tout, cet essai est fait pour vous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "409892a3-d7ac-3838-b67b-f598797ab1e8",
                                        "entry_id": "79ae71ad-ad2b-38cc-9d00-5bcbe1376f51",
                                        "glosses": [
                                            "Penser, méditer profondément sur quelque chose."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcfd5094-dba0-4b94-a04c-e8d3dc55c589",
                                                "sense_id": "409892a3-d7ac-3838-b67b-f598797ab1e8",
                                                "text": "On vous demande la solution de tel problème, prenez du temps pour y rêver."
                                            },
                                            {
                                                "example_id": "74109fcd-1a66-43f2-9c4f-a9cc191d0419",
                                                "sense_id": "409892a3-d7ac-3838-b67b-f598797ab1e8",
                                                "text": "Cela donne à rêver."
                                            },
                                            {
                                                "example_id": "a1abec39-fa3b-44de-86c0-5d4ac61240e1",
                                                "sense_id": "409892a3-d7ac-3838-b67b-f598797ab1e8",
                                                "text": "J’ai rêvé longtemps sur cette affaire, à cette affaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43dcb8ff-19d8-3c1a-a4aa-d22bfa501e68",
                                        "entry_id": "79ae71ad-ad2b-38cc-9d00-5bcbe1376f51",
                                        "glosses": [
                                            "S’absorber dans un désir."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a99eabd-7e9f-4bff-8342-33d4cca1d56d",
                                                "sense_id": "43dcb8ff-19d8-3c1a-a4aa-d22bfa501e68",
                                                "text": "Loin du danger, il ne rêve qu’exploits héroïques, entreprises surhumaines et gigantesques ; mais, quand vient le péril, son imagination trop vive lui représente la douleur des blessures, le visage camard de la mort, et le cœur lui manque."
                                            },
                                            {
                                                "example_id": "e8e31073-9bbe-42ca-9018-8ad1e7502589",
                                                "sense_id": "43dcb8ff-19d8-3c1a-a4aa-d22bfa501e68",
                                                "text": "Il ne rêve que fortune."
                                            },
                                            {
                                                "example_id": "ed280ac3-53aa-4cfb-a3a5-8227aeea9b90",
                                                "sense_id": "43dcb8ff-19d8-3c1a-a4aa-d22bfa501e68",
                                                "text": "Il rêve des grandeurs, des dignités auxquelles il ne parviendra pas."
                                            },
                                            {
                                                "example_id": "5ccd6ddf-5938-4107-9fd6-5fa4c97785d5",
                                                "sense_id": "43dcb8ff-19d8-3c1a-a4aa-d22bfa501e68",
                                                "text": "Il rêvait la tiare, un chapeau de cardinal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "154bafc1-6c35-3de6-94fb-d1e028dc1056",
                                        "entry_id": "79ae71ad-ad2b-38cc-9d00-5bcbe1376f51",
                                        "glosses": [
                                            "S’imaginer être."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c4b2872-c7ee-4e72-bd53-d02067f0cb2a",
                                                "sense_id": "154bafc1-6c35-3de6-94fb-d1e028dc1056",
                                                "text": "Une faiblesse, cependant : son ambition démesurée, qui tourne à la mégalomanie. Il se rêve à la Chambre, au gouvernement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
