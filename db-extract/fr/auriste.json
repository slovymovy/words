                        "entry_id": "e5c6c7fc-efad-39b7-b1c0-105f1d26a871",
                        "glosses": [
                            "Médecin qui soigne les affections d’oreille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea487ec2-5e86-4dca-be6d-f10ceeee59fa",
                                "sense_id": "ad255a5a-48b0-3ba6-8718-7342b3c748ee",
                                "text": "Toutefois cette notion de fréquence est difficile à préciser : le pédiatre ne peut se faire escorter d’un auriste ; il ne peut, d’autre part, en admettant qu’il ait quelque pratique du spéculum auri, interpréter certaines images et établir un diagnostic difficile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2d27a7a-862c-4a81-a326-f83dd7a8735b",
                        "source_entry_id": "e5c6c7fc-efad-39b7-b1c0-105f1d26a871",
                        "source_sense_id": "ad255a5a-48b0-3ba6-8718-7342b3c748ee",
                        "target_lang_word": "otologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "otologist",
