                "senses": [
                    {
                        "sense_id": "62d46e4a-b0e1-369a-bcd0-decb0d254616",
                        "entry_id": "123c82d5-175f-3af2-9046-3ba48b25fda1",
                        "glosses": [
                            "Form eines Verbs, die als Adjektiv gebraucht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc39d962-5d88-474a-a606-c57a66346e17",
                                "sense_id": "62d46e4a-b0e1-369a-bcd0-decb0d254616",
                                "text": "In der Folge: 'die auf den Baum kletternde Katze' ist ›kletternde‹ ein Verbaladjektiv."
                            },
                            {
                                "example_id": "757f8b5d-d569-4823-ae69-77e91cd1bc5f",
                                "sense_id": "62d46e4a-b0e1-369a-bcd0-decb0d254616",
                                "text": "In der Folge: 'die gefütterte Katze' ist ›gefütterte‹ ein Verbaladjektiv."
                            },
                            {
                                "example_id": "6b04f7c0-a62f-4830-924a-3fa15489fa03",
                                "sense_id": "62d46e4a-b0e1-369a-bcd0-decb0d254616",
                                "text": "In der Folge: 'der anzuleinende Hund' ist ›anzuleinende‹ ein Verbaladjektiv."
                            },
                            {
                                "example_id": "be2dc4a0-6867-47d3-9601-b9ec6c3bd519",
                                "sense_id": "62d46e4a-b0e1-369a-bcd0-decb0d254616",
                                "text": "„Früher bestand zwischen dem Verbaladjektiv und dem Partizip Präsens kein Unterschied.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d6ea8c46-b06a-36dc-bbec-e16f3cb79674",
                        "entry_id": "123c82d5-175f-3af2-9046-3ba48b25fda1",
                        "glosses": [
                            "Adjektiv, das von einem Verb abgeleitet ist"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "252eb73e-edab-4d85-80b8-87c0a11da901",
                                "sense_id": "d6ea8c46-b06a-36dc-bbec-e16f3cb79674",
                                "text": "Die Adjektive fahrfähig, lachhaft und nachvollziehbar sind Verbaladjektive."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
