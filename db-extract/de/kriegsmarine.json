                ],
                "senses": [
                    {
                        "sense_id": "ba9b7c7f-5b4a-36b9-a283-0cba02472c70",
                        "entry_id": "3ec05241-3ef2-39e5-9172-03b63212403c",
                        "glosses": [
                            "Gesamtheit der bewaffneten Seestreitkräfte eines Staates; der Teil der Marine, der dem Krieg auf See dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2f1bd80-c474-45c8-8263-0c834d82c182",
                                "sense_id": "ba9b7c7f-5b4a-36b9-a283-0cba02472c70",
                                "text": "Die russische Kriegsmarine hatte das unter maltesischer Flagge fahrende Schiff Mitte August im Atlantik aufgebracht und seither auf offener See dessen Ladung untersucht - angeblich sei keinerlei verbotene Fracht an Bord gewesen."
                            },
                            {
                                "example_id": "1408fef4-ac91-40d8-a4db-b16ed1b02736",
                                "sense_id": "ba9b7c7f-5b4a-36b9-a283-0cba02472c70",
                                "text": "Ein Kolonialreich entstand (Philippinen, Guam) und der rasch forcierte Ausbau einer großen Kriegsmarine ermöglichte es, Druck in der eigenen Hemisphäre und bald auch darüber hinaus auszuüben."
                            },
                            {
                                "example_id": "0ce013e2-6be9-480f-a548-a3e5f4e64562",
                                "sense_id": "ba9b7c7f-5b4a-36b9-a283-0cba02472c70",
                                "text": "Das Atom-U-Boot „San Francisco“ der US-Navy, der amerikanischen Kriegsmarine, ist 560 Kilometer von der Pazifikinsel Guam entfernt auf Grund gelaufen."
                            },
                            {
                                "example_id": "f36e9b60-5272-4910-a1bc-b7f08a62f7c9",
                                "sense_id": "ba9b7c7f-5b4a-36b9-a283-0cba02472c70",
                                "text": "\"EnerSys und seine Vorgängerunternehmen liefern bereits seit mehr als 100 Jahren Batterien für den Einsatz in Unterseebooten\", sagte John Craig, Chairman, Präsident und Chief Executive Officer von EnerSys. \"Unsere U-Boot-Batterien sind für ihre Qualität und Betriebsleistung anerkannt und werden von Kriegsmarinen auf der ganzen Welt sowohl in dieselelektrisch als auch nuklear angetriebenen Unterseebooten eingesetzt. […]\"."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0843a0de-08a6-351f-b333-f1027b55d7ee",
                        "entry_id": "3ec05241-3ef2-39e5-9172-03b63212403c",
                        "glosses": [
                            "im engeren Sinne die Marine der Wehrmacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69a38ee8-8494-4267-8cf6-60f8aa5cac94",
                                "sense_id": "0843a0de-08a6-351f-b333-f1027b55d7ee",
                                "text": "Die Tradition des Unterganges mit wehender Flagge überlebte in der deutschen Kriegsmarine und kostete auch im Zweiten Weltkrieg, etwa beim Untergang der Bismarck, sinnlose Opfer."
                            },
                            {
                                "example_id": "664e6ede-a07d-4098-bf67-9d0365596b14",
                                "sense_id": "0843a0de-08a6-351f-b333-f1027b55d7ee",
                                "text": "„Hier kannte der brave Major Brenner einen Kapitänleutnant der Kriegsmarine.“"
                            },
                            {
                                "example_id": "5cc3377d-a055-4b32-b107-999a0cac3f13",
                                "sense_id": "0843a0de-08a6-351f-b333-f1027b55d7ee",
                                "text": "„So sahen auch ihre Vorstellungen von der Kriegsmarine aus.“"
                            },
                            {
                                "example_id": "e9a8da78-7634-4a81-87cc-1b71069070f1",
                                "sense_id": "0843a0de-08a6-351f-b333-f1027b55d7ee",
                                "text": "„Den Dienstgrad Maschinist (Feldwebel) gab es bei der Kriegsmarine äußerst selten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec86e703-2c0c-4911-9ba7-6133af99f06f",
                        "source_entry_id": "3ec05241-3ef2-39e5-9172-03b63212403c",
                        "source_sense_id": "ba9b7c7f-5b4a-36b9-a283-0cba02472c70",
