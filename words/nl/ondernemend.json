                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij is een zeer <w>ondernemende</w> vrouw die altijd nieuwe projecten start.",
                            "target_lang_translations": {
                                "de": "Sie ist eine sehr <w>unternehmungslustige</w> Frau, die immer neue Projekte startet."
                            }
                        },
                        {
                            "text": "De <w>ondernemende</w> studenten hebben een eigen bedrijf opgericht tijdens hun studie.",
                            "target_lang_translations": {
