                    }
                ],
                "translations": [
                    {
                        "translation_id": "01a2653b-2741-4081-ba1a-a7fd3fdbb8a2",
                        "source_entry_id": "e0acc719-a1da-3d50-aaaf-bb3b1de46058",
                        "source_sense_id": "e51c599e-9521-3a7c-b2bf-1c4c395d4f1a",
                        "source_sense_description": "meist abwertend, Film, Theater: Schauspielerin",
                        "target_lang_word": "Schauspielerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schauspielerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6dec8de4-640d-3ce0-be6b-af648227286e",
                                        "entry_id": "fea03eae-67df-30a7-a156-70e5e2247095",
                                        "glosses": [
                                            "weibliche Person, die nach entsprechender Ausbildung Darstellerin im Film oder beim Theater oder Fernsehen ist"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e6fbf54-8684-41ef-bc5c-d4a6bb4bd97a",
                                                "sense_id": "6dec8de4-640d-3ce0-be6b-af648227286e",
                                                "text": "Sie ist als Schauspielerin sehr erfolgreich und hat sogar einmal den Oscar gewonnen."
                                            },
                                            {
                                                "example_id": "8457a5c1-730d-4ea5-92ff-c5b08d4a2407",
                                                "sense_id": "6dec8de4-640d-3ce0-be6b-af648227286e",
                                                "text": "Schauspieler/in ist eine landesrechtlich geregelte, drei- bis vierjährige, schulische Ausbildung an Berufsfachschulen."
                                            },
                                            {
                                                "example_id": "31ba2d83-6127-4023-af2a-a3453930e1f6",
                                                "sense_id": "6dec8de4-640d-3ce0-be6b-af648227286e",
                                                "text": "„Sie hatte in Berlin Schauspielerin werden wollen und war in Jerusalem die Frau eines langweiligen Juristen geworden.“"
                                            },
                                            {
                                                "example_id": "67749b55-896a-4f45-8981-cef02a832282",
                                                "sense_id": "6dec8de4-640d-3ce0-be6b-af648227286e",
                                                "text": "„Jetzt bin ich nur noch Figurantin, aber früher war ich einmal Schauspielerin.“"
                                            },
                                            {
                                                "example_id": "219b1cd0-fb5e-4039-9583-f91c719a7367",
                                                "sense_id": "6dec8de4-640d-3ce0-be6b-af648227286e",
                                                "text": "„So muss sich eine Schauspielerin vor ihrem ersten großen Auftritt fühlen.“"
                                            },
                                            {
                                                "example_id": "b982138e-d41a-4b0b-b959-092bbe460485",
                                                "sense_id": "6dec8de4-640d-3ce0-be6b-af648227286e",
                                                "text": "„Man hätte sie für eine berühmte Schauspielerin halten können, doch in Fritze Grails Kneipe gegenüber dem Schlachthof verirrten sich keine Ufa-Stars.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "33096268-42ab-3989-8765-8b66df56cb30",
                                        "entry_id": "fea03eae-67df-30a7-a156-70e5e2247095",
                                        "glosses": [
                                            "weibliche Person, die im wirklichen Leben durch Schauspielerei ihr wahres Gesicht verbirgt und andere vielleicht sogar täuschen will"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375dd053-2776-4202-8389-95fb19489521",
                                                "sense_id": "33096268-42ab-3989-8765-8b66df56cb30",
                                                "text": "Schau dir diese Schauspielerin an, ich wette, da ist keine Träne echt."
                                            },
                                            {
                                                "example_id": "8d4e4573-5abc-4997-bf8c-becda95d4e4e",
                                                "sense_id": "33096268-42ab-3989-8765-8b66df56cb30",
                                                "text": "Um als Spitzel eine Überlebenschance zu haben, musste sie eine gute Schauspielerin sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
