                                "target_senses": [
                                    {
                                        "sense_id": "84d6e62d-a59e-395a-b02b-8ca2c1f8a09b",
                                        "entry_id": "e8057295-1552-3276-ba78-90d7d3a8844f",
                                        "glosses": [
                                            "ohne Vernunft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efa64c39-7222-4abe-82d8-b1058109a914",
                                                "sense_id": "84d6e62d-a59e-395a-b02b-8ca2c1f8a09b",
                                                "text": "„In Massen würden nach der Massenpsychologie von G. Le Bon Menschen durch emotionale Ansteckung irrational, hysterisch und führungsbedürftig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ab080f7d-c8bb-32de-af95-1c331db7155e",
                                        "entry_id": "e8057295-1552-3276-ba78-90d7d3a8844f",
                                        "glosses": [
                                            "nicht nachvollziehbar, nicht durch Überlegungen zu begreifen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70af9677-160e-416d-b57d-e8e5b3e70411",
                                                "sense_id": "ab080f7d-c8bb-32de-af95-1c331db7155e",
                                                "text": "Menschliches Herdenverhalten ist irrational, denn es lässt sich nicht zufriedenstellend erklären."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d5d0652b-a3d6-3b28-a4b0-fca92dddde96",
                                        "entry_id": "e8057295-1552-3276-ba78-90d7d3a8844f",
                                        "glosses": [
                                            "in keinem Verhältnis, nicht als Bruch darstellbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc0d2b6b-1fea-4e5c-85f0-d83edf0ffcc0",
                                                "sense_id": "d5d0652b-a3d6-3b28-a4b0-fca92dddde96",
                                                "text": "Eine irrationale Zahl ist eine reelle Zahl, die keine rationale Zahl ist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
