                    }
                ],
                "senses": [
                    {
                        "sense_id": "9821aad4-1bda-3868-a88e-794e378980ea",
                        "entry_id": "e102d082-f1a7-3f2c-ad0d-7b84a87d7318",
                        "glosses": [
                            "État d’une personne étourdie par un grand bruit."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0a87228d-e9b0-30e2-b8e3-7174f73966c1",
                        "entry_id": "e102d082-f1a7-3f2c-ad0d-7b84a87d7318",
                        "glosses": [
                            "Stupeur."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9c7d14e2-911b-4b1f-b7e2-abb293f18393",
                                "sense_id": "0a87228d-e9b0-30e2-b8e3-7174f73966c1",
                                "text": "[…] l’embarquement, le départ, tout cela confondu dans le tangage et l’abasourdissement des premiers jours de mer."
                            },
                            {
                                "example_id": "cb854ba2-bf44-4570-bb35-6c951d8182d8",
                                "sense_id": "0a87228d-e9b0-30e2-b8e3-7174f73966c1",
                                "text": "Alors, partagé entre l'abasourdissement et l'indignation, je commençai à dire quelques mots dans cette langue que je parle depuis l'enfance, et qui leur fut à peine plus familière que le latin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d1d57bd-f70c-4c19-915a-a2f2c1cc24c5",
                        "source_entry_id": "e102d082-f1a7-3f2c-ad0d-7b84a87d7318",
                        "target_lang_word": "bewilderment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bewilderment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dc754cd-0e4c-3000-988a-c8f974bf30d3",
                                        "entry_id": "849d71df-a885-3051-998a-794934852120",
                                        "glosses": [
                                            "The state of being bewildered."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14d03834-725b-41c1-b8ec-feee523e032f",
                                                "sense_id": "4dc754cd-0e4c-3000-988a-c8f974bf30d3",
                                                "text": "She looked around in bewilderment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de21c16d-8acf-37d9-b664-f4f282da8258",
                                        "entry_id": "849d71df-a885-3051-998a-794934852120",
                                        "glosses": [
                                            "A confusing or perplexing situation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5188807-a754-4b75-8183-d088f530af8a",
                        "source_entry_id": "e102d082-f1a7-3f2c-ad0d-7b84a87d7318",
                        "target_lang_word": "stupefaction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stupefaction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4253d22d-c72a-35c9-a144-86387b03c381",
                                        "entry_id": "585bde6a-2695-34a9-8702-7c08ea86b2a6",
                                        "glosses": [
                                            "The state of extreme shock or astonishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1632c6ff-dad1-34fa-99ed-3feae5fadce5",
                                        "entry_id": "585bde6a-2695-34a9-8702-7c08ea86b2a6",
                                        "glosses": [
                                            "A state of insensibility; stupor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34082c01-60d3-4b17-8239-27fea3a6d7a3",
                                                "sense_id": "1632c6ff-dad1-34fa-99ed-3feae5fadce5",
                                                "text": "Suddenly roused from the state of stupefaction to which fear had reduced her, the female filled the air with shrieks. Disengaging herself from the officers, and rushing towards her husband, she clung with all her strength to his arm, imploring him, with frantic violence, not to let them kill her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88a8bc5f-74df-48a3-843f-ed2fc0fbc32c",
                        "source_entry_id": "e102d082-f1a7-3f2c-ad0d-7b84a87d7318",
                        "target_lang_word": "amazement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amazement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a1a4ddb-5f60-3980-b5c6-054d00b9bb79",
                                        "entry_id": "f3e7f1aa-af3d-3d96-99d1-3d97f6013be4",
                                        "glosses": [
                                            "The condition of being amazed; a state of overwhelming wonder, as from surprise or sudden fear, horror, or admiration; astonishment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb1aca18-e6fd-4cd8-af91-dd355900b4af",
                                                "sense_id": "1a1a4ddb-5f60-3980-b5c6-054d00b9bb79",
                                                "text": "Eustace gaped at him in amazement. When his urbanity dropped away from him, as now, he had an innocence of expression which was almost infantile. It was as if the world had never touched him at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70865238-971e-3be6-b37c-d3a65870f95c",
                                        "entry_id": "f3e7f1aa-af3d-3d96-99d1-3d97f6013be4",
                                        "glosses": [
                                            "A particular feeling of wonder, surprise, fear, or horror."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6ad3701-74f3-41f1-abbb-4234044da53d",
                                                "sense_id": "70865238-971e-3be6-b37c-d3a65870f95c",
                                                "text": "Were believers thoroughly persuaded of what God meaneth, by these things, they would not be so liable to those frights and amazements which distract and disturb them."
                                            },
                                            {
                                                "example_id": "3baf89c6-b8d9-410e-8985-ab84bc6e9065",
                                                "sense_id": "70865238-971e-3be6-b37c-d3a65870f95c",
                                                "text": "In the midst of ill rumours and amazements, his countenance changeth not."
                                            },
                                            {
                                                "example_id": "efcbe5e6-a8d5-404d-935c-d47c75ffe983",
                                                "sense_id": "70865238-971e-3be6-b37c-d3a65870f95c",
                                                "text": "Certain points, crises, certain feelings, joys, griefs and amazements, when reviewed, must strike us as things wildered and whirling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "445f3833-0c66-39ef-8fbf-094d57fe5982",
                                        "entry_id": "f3e7f1aa-af3d-3d96-99d1-3d97f6013be4",
                                        "glosses": [
                                            "Something which amazes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2197393a-2afd-4a86-af34-39c710ea4bde",
                                                "sense_id": "445f3833-0c66-39ef-8fbf-094d57fe5982",
                                                "text": "So impossible did it seem that such an amazement of horse-flesh could ever be hers."
                                            },
                                            {
                                                "example_id": "42c2f54d-b899-4fb3-8d36-23da177274a0",
                                                "sense_id": "445f3833-0c66-39ef-8fbf-094d57fe5982",
                                                "text": "I believe the Urchin showed more enthusiasm over the stone and the robin than over any of the amazements that succeeded them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "580dcd62-5fba-3cbc-a91f-a0e0f5bf8013",
                                        "entry_id": "f3e7f1aa-af3d-3d96-99d1-3d97f6013be4",
                                        "glosses": [
                                            "Madness, frenzy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
