                                "example_id": "6fd7cb5d-2910-42ab-b5f6-821a66bcf2ad",
                                "sense_id": "ada7a55b-9d47-39bd-8048-d793a53dee71",
                                "text": "Pour le coup d'envoi du Festival de Beiteddine, une tentative d'« opératiser » la chanson arabe."
                            },
                            {
                                "example_id": "bd54c03d-b5cd-4891-a9e0-4c0e9be4e974",
                                "sense_id": "ada7a55b-9d47-39bd-8048-d793a53dee71",
                                "text": "Certains ont même tenté d' « opératiser » L'Allegro, il Penseroso ed il Moderato, comme James Darrah à Hawaï en 2012 et Los Angeles en 2014."
                            },
                            {
                                "example_id": "37655f15-272a-44f3-8bed-7da89b066be5",
                                "sense_id": "ada7a55b-9d47-39bd-8048-d793a53dee71",
                                "text": "J’ai choisi cette séquence car le compositeur a « opératisé » les dialogues."
                            }
                        ]
                    }
