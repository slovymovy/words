                    "frequency": "High",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau président a promis de <w>gouverner</w> le pays dans l'intérêt de tous les citoyens."
                        },
                        {
                            "text": "Il est souvent très difficile de <w>gouverner</w> efficacement en période de crise économique."
                        }
                    ],
                    "synonyms": [
