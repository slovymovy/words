                    "semantic_group_id": "freedom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzikie konie biegały <w>wolno</w> po szerokiej łące.",
                            "target_lang_translations": {
                                "ru": "Дикие лошади <w>свободно</w> бегали по широкому лугу.",
                                "en": "Wild horses were running <w>free</w> across the wide meadow.",
                                "nl": "Wilde paarden renden <w>vrij</w> over de uitgestrekte weide.",
                                "de": "Die Wildpferde liefen <w>frei</w> auf der weiten Wiese.",
                                "fr": "Les chevaux sauvages couraient <w>librement</w> dans le vaste pré.",
                                "it": "I cavalli selvaggi correvano <w>liberamente</w> per l'ampio prato.",
                                "cs": "Divocí koně běhali <w>svobodně</w> po široké louce.",
                                "tr": "Vahşi atlar geniş çayırda <w>serbestçe</w> koşuyordu.",
                                "es": "Los caballos salvajes corrían <w>libremente</w> por el prado ancho.",
                                "zh": "野马在宽阔的草地上<w>自由地</w>奔跑。"
                            }
                        },
                        {
                            "text": "Po przesłuchaniu policja puściła go <w>wolno</w> do domu.",
                            "target_lang_translations": {
                                "ru": "После допроса полиция отпустила его <w>на свободу</w> домой.",
                                "en": "After the interrogation, the police set him <w>free</w> to go home.",
                                "nl": "Na het verhoor liet de politie hem <w>vrij</w> naar huis gaan.",
                                "de": "Nach dem Verhör ließ ihn die Polizei <w>frei</w> nach Hause gehen.",
                                "fr": "Après l'interrogatoire, la police l'a <w>remis en liberté</w> pour qu'il rentre chez lui.",
                                "it": "Dopo l'interrogatorio la polizia lo ha lasciato <w>libero</w> di tornare a casa.",
                                "cs": "Po výslechu ho policie pustila <w>na svobodu</w> domů.",
                                "tr": "Sorgudan sonra polis onu <w>serbest</w> bıraktı ve evine gönderdi.",
                                "es": "Después del interrogatorio, la policía lo dejó <w>en libertad</w> para ir a casa.",
                                "zh": "审讯后，警察将他<w>释放</w>回家了。"
                            }
